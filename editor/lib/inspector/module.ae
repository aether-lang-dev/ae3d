// The inspector: a game object as its components, drawn from what each
// component's kind says it is made of (ae3d.component), as Unity's
// inspector draws a GameObject.
//
// Nothing here knows a kind. A panel a component: a header with its
// enable switch, its name and a menu (reset, remove, move up, move down),
// and a row a field, by the field's type -- a switch, a slider and a box
// for a bounded number, a box for an unbounded one, three boxes with axis
// letters for a vector, degrees about each axis for a rotation, a chip and
// a hex box for a colour, a row of choices for an enum, a box for text and
// a box with a picker for an asset. A kind the game adds is drawn the day
// it is registered, and so is every field added to one.
//
// Every edit goes through the registry, so a kind's validate runs and its
// version moves; the rows follow the version, so what a script, the agent
// or an undo changes shows as it happens. Every edit is handed to the
// editor (`on_change`) with the component's fields before and after, which
// is what undo records.

import ui
import std.list
import std.string
import std.json
import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (
    Inspector, InspectorPanel, InspectorBinding,
    inspector_new, inspector_free, show, refresh, shown, panel_count, binding_count,
    edit_float, edit_bool, edit_int, edit_vec3, edit_text, add_kind, remove_component,
    reset_component, move_component, set_enabled, bindings_of, binding_at, kinds_offered
)

const LABEL_W = 92
const FIELD_W = 78
const VECTOR_W = 60
const AXIS_W = 10
const READOUT_W = 58
const CHIP_W = 22

// What a row's control is.
const CONTROL_TOGGLE = 0
const CONTROL_SLIDER = 1           // a slider and a box
const CONTROL_FIELD = 2            // a box
const CONTROL_VECTOR = 3           // three boxes
const CONTROL_COLOR = 4            // a chip and a hex box
const CONTROL_CHOICES = 5          // a row of buttons
const CONTROL_TEXT = 6

struct InspectorBinding {
    component: ptr                 // *Component
    field: ptr                     // *ComponentField
    control: int
    handles: ptr                   // int[]: the row's widgets, by control
    handle_count: int
    version: int                   // the component's version the row last showed
    editing: bool                  // the row is being typed into or dragged: not echoed
}

struct InspectorPanel {
    component: ptr
    header: int
    body: int
    enabled_toggle: int
    open: bool
}

struct Inspector {
    root: int                      // the container the panels are built in
    object: ptr                    // *GameObject, or null
    panels: ptr                    // list of *InspectorPanel
    bindings: ptr                  // list of *InspectorBinding
    structure: int                 // the object's component count when built
    scene: bool                    // the object is the scene's root: its kinds are the scene's
    // Told of every edit: the object, the component's kind, its fields before
    // and after as JSON text. What the editor records for undo, and marks the
    // scene changed by.
    on_change: fn(ptr, ptr, string, string, string)
    // Told when a component is added or removed: the object, the kind, its
    // fields, and whether it was added.
    on_structure: fn(ptr, ptr, string, string, bool)
    host: ptr
}

inspector_new(root: int, host: ptr, on_change: fn(ptr, ptr, string, string, string),
              on_structure: fn(ptr, ptr, string, string, bool)) -> *Inspector {
    ins = heap.new(Inspector)
    ins.root = root
    ins.panels = list.new()
    ins.bindings = list.new()
    ins.host = host
    ins.on_change = on_change
    ins.on_structure = on_structure
    return ins
}

release_rows(ins: *Inspector) {
    count = list.size(ins.bindings)
    i = 0
    while i < count {
        b = list.get_raw(ins.bindings, i) as *InspectorBinding
        if b.handles != null { free(b.handles) }
        heap.free(b)
        i = i + 1
    }
    list.clear(ins.bindings)
    count = list.size(ins.panels)
    i = 0
    while i < count {
        heap.free(list.get_raw(ins.panels, i) as *InspectorPanel)
        i = i + 1
    }
    list.clear(ins.panels)
}

inspector_free(ins: *Inspector) {
    if ins == null { return }
    release_rows(ins)
    list.free(ins.bindings)
    list.free(ins.panels)
    heap.free(ins)
}

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

shown(ins: *Inspector) -> *GameObject { return ins.object as *GameObject }
panel_count(ins: *Inspector) -> int { return list.size(ins.panels) }
binding_count(ins: *Inspector) -> int { return list.size(ins.bindings) }
bindings_of(ins: *Inspector) -> ptr { return ins.bindings }
binding_at(ins: *Inspector, index: int) -> *InspectorBinding {
    if index < 0 || index >= list.size(ins.bindings) { return null }
    return list.get_raw(ins.bindings, index) as *InspectorBinding
}

// --- text in and out ---------------------------------------------------------------

// A number as a box shows it: rounded to two places, which is what a
// person edits, with its sign whatever the whole part is (-0.25 is not
// 0.25).
number_text(value: float) -> string {
    sign = ""
    magnitude = value
    if value < 0.0 {
        magnitude = 0.0 - value
    }
    hundredths = (magnitude * 100.0 + 0.5) as long
    if value < 0.0 && hundredths > 0 { sign = "-" }
    whole = hundredths / 100
    fraction = hundredths - whole * 100
    if fraction < 10 { return "${sign}${whole}.0${fraction}" }
    return "${sign}${whole}.${fraction}"
}

hex_digit(value: int) -> string {
    digits = "0123456789abcdef"
    return string.substring(digits, value, value + 1)
}

hex_of(channel: float) -> string {
    v = (channel * 255.0 + 0.5) as int
    if v < 0 { v = 0 }
    if v > 255 { v = 255 }
    return string.concat(hex_digit(v / 16), hex_digit(v % 16))
}

color_hex(c: Vec3) -> string {
    return "#${hex_of(c.x)}${hex_of(c.y)}${hex_of(c.z)}"
}

hex_value(ch: int) -> int {
    if ch >= 48 && ch <= 57 { return ch - 48 }
    if ch >= 97 && ch <= 102 { return ch - 87 }
    if ch >= 65 && ch <= 70 { return ch - 55 }
    return 0 - 1
}

// "#rrggbb" or "rrggbb" as a colour; its red is -1 when the text is not one.
parse_hex(text: string) -> Vec3 {
    bad = core.vec3(0.0 - 1.0, 0.0, 0.0)
    start = 0
    if string.starts_with(text, "#") == 1 { start = 1 }
    if string.length(text) - start != 6 { return bad }
    r = hex_pair(text, start)
    g = hex_pair(text, start + 2)
    b = hex_pair(text, start + 4)
    if r < 0 || g < 0 || b < 0 { return bad }
    return core.vec3(r as float / 255.0, g as float / 255.0, b as float / 255.0)
}

// The byte two hex digits at `at` spell, or -1.
hex_pair(text: string, at: int) -> int {
    hi = hex_value(string.char_at(text, at))
    lo = hex_value(string.char_at(text, at + 1))
    if hi < 0 || lo < 0 { return 0 - 1 }
    return hi * 16 + lo
}

// --- edits ---------------------------------------------------------------------

// Every edit is made the same way: the fields as they were, the write, the
// fields as they are, and the editor told.
begin_edit(c: *Component) -> string {
    before = component.to_json(c, false)
    text = json.stringify_raw(before)
    json.free(before)
    return text
}

end_edit(ins: *Inspector, c: *Component, before: string) {
    after = component.to_json(c, false)
    text = json.stringify_raw(after)
    json.free(after)
    if ins.on_change != null {
        changed = ins.on_change
        changed(ins.host, ins.object, component.kind_name(component.kind_of(c)), before, text)
    }
    string.free(text)
    string.free(before)
}

edit_float(ins: *Inspector, c: *Component, f: *ComponentField, value: float) {
    before = begin_edit(c)
    component.set_float(c, f, value)
    end_edit(ins, c, before)
}

edit_int(ins: *Inspector, c: *Component, f: *ComponentField, value: int) {
    before = begin_edit(c)
    component.set_int(c, f, value)
    end_edit(ins, c, before)
}

edit_bool(ins: *Inspector, c: *Component, f: *ComponentField, value: bool) {
    before = begin_edit(c)
    component.set_bool(c, f, value)
    end_edit(ins, c, before)
}

edit_vec3(ins: *Inspector, c: *Component, f: *ComponentField, value: Vec3) {
    before = begin_edit(c)
    if f.type == component.TYPE_ROTATION {
        component.set_rotation(c, f, core.quat_from_euler(core.deg_to_rad(value.x), core.deg_to_rad(value.y),
                                                          core.deg_to_rad(value.z)))
    } else {
        component.set_vec3(c, f, value)
    }
    end_edit(ins, c, before)
}

edit_text(ins: *Inspector, c: *Component, f: *ComponentField, value: string) {
    before = begin_edit(c)
    component.set_text(c, f, value)
    end_edit(ins, c, before)
}

// One axis of a vector, a colour channel or a rotation's angle, by its
// place: what one of three boxes writes.
edit_axis(ins: *Inspector, c: *Component, f: *ComponentField, axis: int, value: float) {
    v = vector_value(c, f)
    if axis == 0 { v.x = value }
    if axis == 1 { v.y = value }
    if axis == 2 { v.z = value }
    edit_vec3(ins, c, f, v)
}

// A vector field as its boxes show it: a rotation in degrees.
vector_value(c: *Component, f: *ComponentField) -> Vec3 {
    if f.type == component.TYPE_ROTATION {
        e = core.quat_to_euler(component.get_rotation(c, f))
        return core.vec3(core.rad_to_deg(e.x), core.rad_to_deg(e.y), core.rad_to_deg(e.z))
    }
    return component.get_vec3(c, f)
}

set_enabled(ins: *Inspector, c: *Component, on: bool) {
    before = begin_edit(c)
    behaviour.component_set_enabled(c, on)
    component.touch(c)
    end_edit(ins, c, before)
}

reset_component(ins: *Inspector, c: *Component) {
    before = begin_edit(c)
    component.reset(c)
    end_edit(ins, c, before)
}

// The kinds the object may be given: every registered kind of its side --
// the scene's for the scene's root, the rest for an object -- that it does
// not already carry if it may carry only one. In the registry's order,
// which is the order they were registered in: the engine's, then the
// game's.
kinds_offered(ins: *Inspector) -> ptr {
    offered = list.new()
    o = ins.object as *GameObject
    if o == null { return offered }
    count = component.kind_count()
    i = 0
    while i < count {
        k = component.kind_at(i)
        fits = k.scene == ins.scene
        if fits && k.unique && component.find(o, k) != null { fits = false }
        if fits && k.create == null { fits = false }
        if fits { list.add_raw(offered, k) }
        i = i + 1
    }
    return offered
}

add_kind(ins: *Inspector, k: *ComponentKind) -> *Component {
    o = ins.object as *GameObject
    c = component.add(o, k)
    if c == null { return null }
    fields = begin_edit(c)
    if ins.on_structure != null {
        told = ins.on_structure
        told(ins.host, ins.object, k.name, fields, true)
    }
    string.free(fields)
    show(ins, o, ins.scene)
    return c
}

remove_component(ins: *Inspector, c: *Component) {
    o = ins.object as *GameObject
    k = component.kind_of(c)
    if o == null || k == null { return }
    fields = begin_edit(c)
    name = string.copy(k.name)
    component.remove(o, c)
    if ins.on_structure != null {
        told = ins.on_structure
        told(ins.host, ins.object, name, fields, false)
    }
    string.free(name)
    string.free(fields)
    show(ins, o, ins.scene)
}

// A component one place up (-1) or down (+1) among the object's: the order
// the inspector draws them in and the phases run in.
move_component(ins: *Inspector, c: *Component, step: int) {
    o = ins.object as *GameObject
    if o == null { return }
    count = behaviour.object_component_count(o)
    at = 0 - 1
    i = 0
    while i < count {
        if behaviour.object_component(o, i) == c { at = i }
        i = i + 1
    }
    target = at + step
    if at < 0 || target < 0 || target >= count { return }
    other = behaviour.object_component(o, target)
    // The transform stays first, as in Unity: nothing moves above it.
    if component.kind_of(other) != null && string.equals(component.kind_name(component.kind_of(other)), "Transform") == 1 { return }
    list.set(o.components, target, c)
    list.set(o.components, at, other)
    show(ins, o, ins.scene)
}

// --- building ------------------------------------------------------------------

label_of(parent: int, name: string) -> int {
    caption = ui.text(parent, name)
    ui.add_css_class(caption, "label")
    ui.width(caption, LABEL_W)
    return caption
}

bind(ins: *Inspector, c: *Component, f: *ComponentField, control: int, count: int) -> *InspectorBinding {
    b = heap.new(InspectorBinding)
    b.component = c as ptr
    b.field = f as ptr
    b.control = control
    b.handles = calloc(count, 4)
    b.handle_count = count
    b.version = 0 - 1
    list.add_raw(ins.bindings, b)
    return b
}

handle_at(b: *InspectorBinding, index: int) -> int {
    handles = b.handles as int[]
    return handles[index]
}

set_handle(b: *InspectorBinding, index: int, handle: int) {
    handles = b.handles as int[]
    handles[index] = handle
}

// One choice of an enum: a button that picks it. Its own call, so the
// closure holds this choice and not the loop's last.
choice_button(ins: *Inspector, row: int, c: *Component, f: *ComponentField, pick: int) -> int {
    button = ui.btn(row, component.enum_choice(f, pick)) callback {
        edit_int(ins, c, f, pick)
    }
    ui.add_css_class(button, "action")
    ui.height(button, 22)
    ui.fill_width(button)
    return button
}

// One axis of a vector row: its coloured letter and its box.
axis_box(ins: *Inspector, row: int, b: *InspectorBinding, c: *Component, f: *ComponentField,
         axis: int, letter: string, style: string) -> int {
    mark = ui.text(row, letter)
    ui.add_css_class(mark, style)
    ui.width(mark, AXIS_W)
    box = ui.textfield(row, "0.00") callback |text: string| {
        if string.string_try_float(text) != 0 {
            b.editing = true
            edit_axis(ins, c, f, axis, string.string_get_float(text))
            b.editing = false
        }
    }
    ui.add_css_class(box, "field")
    ui.width(box, VECTOR_W)
    return box
}

// One entry of Add Component: the kind under its heading.
kind_entry(ins: *Inspector, menu: int, kind: *ComponentKind) {
    ui.menu_item(menu, "${kind.category} / ${kind.name}") callback { add_kind(ins, kind) }
}

row_for(ins: *Inspector, body: int, c: *Component, f: *ComponentField) {
    vector = f.type == component.TYPE_VEC3 || f.type == component.TYPE_ROTATION
    spacing = 8
    if vector { spacing = 4 }
    row = ui.hstack(body, spacing)
    ui.add_css_class(row, "row")
    if vector {
        // Three boxes and their letters take the width a slider row gives its
        // label column and slider: the caption takes what is left.
        caption = ui.text(row, f.name)
        ui.add_css_class(caption, "label")
    } else {
        label_of(row, f.name)
    }
    if f.tooltip != "" { ui.style_tooltip(row, f.tooltip) }
    readonly = (f.flags & component.FIELD_READONLY) != 0

    if f.type == component.TYPE_BOOL {
        b = bind(ins, c, f, CONTROL_TOGGLE, 1)
        ui.spacer(row)
        toggle = ui.toggle(row, "") callback |on: bool| {
            edit_bool(ins, c, f, on)
        }
        set_handle(b, 0, toggle)
    } else if f.type == component.TYPE_ENUM {
        b = bind(ins, c, f, CONTROL_CHOICES, component.enum_choice_count(f))
        choices = component.enum_choice_count(f)
        i = 0
        while i < choices {
            set_handle(b, i, choice_button(ins, row, c, f, i))
            i = i + 1
        }
    } else if (f.type == component.TYPE_FLOAT || f.type == component.TYPE_INT) && f.max > f.min {
        b = bind(ins, c, f, CONTROL_SLIDER, 2)
        slider = ui.slider(row, f.min, f.max, f.min) callback |value: float| {
            b.editing = true
            if f.type == component.TYPE_INT { edit_int(ins, c, f, value as int) } else { edit_float(ins, c, f, value) }
            b.editing = false
        }
        ui.height(slider, 16)
        ui.fill_width(slider)
        box = ui.textfield(row, "0.00") callback |text: string| {
            if string.string_try_float(text) != 0 {
                b.editing = true
                typed = string.string_get_float(text)
                if f.type == component.TYPE_INT { edit_int(ins, c, f, typed as int) } else { edit_float(ins, c, f, typed) }
                b.editing = false
            }
        }
        ui.add_css_class(box, "field")
        ui.width(box, READOUT_W)
        set_handle(b, 0, slider)
        set_handle(b, 1, box)
    } else if f.type == component.TYPE_FLOAT || f.type == component.TYPE_INT {
        b = bind(ins, c, f, CONTROL_FIELD, 1)
        ui.spacer(row)
        box = ui.textfield(row, "0.00") callback |text: string| {
            if string.string_try_float(text) != 0 {
                b.editing = true
                typed = string.string_get_float(text)
                if f.type == component.TYPE_INT { edit_int(ins, c, f, typed as int) } else { edit_float(ins, c, f, typed) }
                b.editing = false
            }
        }
        ui.add_css_class(box, "field")
        ui.width(box, FIELD_W)
        set_handle(b, 0, box)
    } else if f.type == component.TYPE_VEC3 || f.type == component.TYPE_ROTATION {
        b = bind(ins, c, f, CONTROL_VECTOR, 3)
        ui.spacer(row)
        set_handle(b, 0, axis_box(ins, row, b, c, f, 0, "X", "axis-x"))
        set_handle(b, 1, axis_box(ins, row, b, c, f, 1, "Y", "axis-y"))
        set_handle(b, 2, axis_box(ins, row, b, c, f, 2, "Z", "axis-z"))
    } else if f.type == component.TYPE_COLOR {
        b = bind(ins, c, f, CONTROL_COLOR, 2)
        ui.spacer(row)
        chip = ui.text(row, " ")
        ui.width(chip, CHIP_W)
        ui.height(chip, 18)
        box = ui.textfield(row, "#000000") callback |text: string| {
            colour = parse_hex(text)
            if colour.x >= 0.0 {
                b.editing = true
                edit_vec3(ins, c, f, colour)
                b.editing = false
            }
        }
        ui.add_css_class(box, "field")
        ui.width(box, FIELD_W)
        set_handle(b, 0, chip)
        set_handle(b, 1, box)
    } else {
        b = bind(ins, c, f, CONTROL_TEXT, 2)
        box = ui.textfield(row, "") callback |text: string| {
            b.editing = true
            edit_text(ins, c, f, text)
            b.editing = false
        }
        ui.add_css_class(box, "field")
        ui.fill_width(box)
        set_handle(b, 0, box)
        if f.type == component.TYPE_ASSET {
            browse = ui.btn(row, "...") callback {
                chosen = ui.open_file("Choose ${f.name}", "resources")
                if chosen != "" {
                    edit_text(ins, c, f, chosen)
                    refresh(ins)
                }
            }
            ui.add_css_class(browse, "action")
            ui.height(browse, 22)
            ui.width(browse, 28)
            set_handle(b, 1, browse)
        }
    }
    if readonly { ui.enabled(row, 0) }
}

panel_for(ins: *Inspector, c: *Component) {
    k = component.kind_of(c)
    p = heap.new(InspectorPanel)
    p.component = c as ptr
    p.open = true
    list.add_raw(ins.panels, p)

    header = ui.hstack(ins.root, 6)
    ui.add_css_class(header, "heading")
    ui.fill_width(header)
    p.header = header
    caret = ui.text(header, "▾")
    ui.add_css_class(caret, "caption")
    ui.width(caret, 10)
    enabled = ui.toggle(header, "") callback |on: bool| {
        set_enabled(ins, c, on)
    }
    ui.set_toggle(enabled, flag_of(behaviour.component_enabled(c)))
    p.enabled_toggle = enabled
    title = ui.text(header, k.name)
    ui.add_css_class(title, "caption")
    ui.spacer(header)
    menu_button = ui.btn(header, "⋮") callback {
        menu = ui.menu(k.name)
        ui.menu_item(menu, "Reset") callback { reset_component(ins, c) }
        ui.menu_item(menu, "Move Up") callback { move_component(ins, c, 0 - 1) }
        ui.menu_item(menu, "Move Down") callback { move_component(ins, c, 1) }
        // The transform is what places the object: as in Unity, it is not
        // removed, only reset.
        if string.equals(k.name, "Transform") != 1 {
            ui.menu_item(menu, "Remove Component") callback { remove_component(ins, c) }
        }
        ui.menu_popup(menu, header)
    }
    ui.add_css_class(menu_button, "action")
    ui.width(menu_button, 24)

    body = ui.vstack(ins.root, 6)
    ui.fill_width(body)
    p.body = body
    ui.on_click(caret) callback {
        p.open = !p.open
        ui.set_hidden(p.body, flag_of(!p.open))
        if p.open { ui.set_text(caret, "▾") } else { ui.set_text(caret, "▸") }
    }

    count = component.field_count(k)
    i = 0
    while i < count {
        f = component.field_at(k, i)
        if (f.flags & component.FIELD_HIDDEN) == 0 { row_for(ins, body, c, f) }
        i = i + 1
    }
}

flag_of(on: bool) -> int {
    if on { return 1 }
    return 0
}

// The panels for `o`, built again: its registry components, the transform
// first as in Unity, then the rest in the object's order; then Add
// Component. `scene` says the object is the scene's root, whose kinds are
// the scene's. Null clears the inspector.
show(ins: *Inspector, o: *GameObject, scene: bool) {
    ui.clear_children(ins.root)
    release_rows(ins)
    ins.object = o as ptr
    ins.scene = scene
    ins.structure = 0
    if o == null { return }
    count = behaviour.object_component_count(o)
    ins.structure = count
    transform = null as *Component
    i = 0
    while i < count {
        c = behaviour.object_component(o, i)
        k = component.kind_of(c)
        if k != null && string.equals(k.name, "Transform") == 1 { transform = c }
        i = i + 1
    }
    if transform != null { panel_for(ins, transform) }
    i = 0
    while i < count {
        c = behaviour.object_component(o, i)
        if c != transform && component.kind_of(c) != null { panel_for(ins, c) }
        i = i + 1
    }

    adder = ui.btn(ins.root, "Add Component") callback {
        offered = kinds_offered(ins)
        menu = ui.menu("Add Component")
        n = list.size(offered)
        j = 0
        while j < n {
            kind_entry(ins, menu, list.get_raw(offered, j) as *ComponentKind)
            j = j + 1
        }
        list.free(offered)
        ui.menu_popup(menu, ins.root)
    }
    ui.add_css_class(adder, "primary")
    ui.height(adder, 24)
    ui.fill_width(adder)
    refresh(ins)
}

// Every row brought to what its component holds now, where the component
// changed since the row last showed it and the row is not being edited:
// a script's own stores, the agent's writes and an undo show as they land.
// Rebuilt whole when the object's components were added to or taken from
// by something other than this inspector.
refresh(ins: *Inspector) {
    o = ins.object as *GameObject
    if o == null { return }
    if behaviour.object_component_count(o) != ins.structure {
        show(ins, o, ins.scene)
        return
    }
    count = list.size(ins.bindings)
    i = 0
    while i < count {
        b = list.get_raw(ins.bindings, i) as *InspectorBinding
        c = b.component as *Component
        if !b.editing && component.version(c) != b.version {
            show_value(b)
            b.version = component.version(c)
        }
        i = i + 1
    }
    count = list.size(ins.panels)
    i = 0
    while i < count {
        p = list.get_raw(ins.panels, i) as *InspectorPanel
        ui.set_toggle(p.enabled_toggle, flag_of(behaviour.component_enabled(p.component as *Component)))
        i = i + 1
    }
}

show_value(b: *InspectorBinding) {
    c = b.component as *Component
    f = b.field as *ComponentField
    if b.control == CONTROL_TOGGLE {
        ui.set_toggle(handle_at(b, 0), flag_of(component.get_bool(c, f)))
    } else if b.control == CONTROL_CHOICES {
        active = component.get_int(c, f)
        i = 0
        while i < b.handle_count {
            if i == active {
                ui.style_bg_color(handle_at(b, i), 0.184, 0.435, 0.922, 1.0)
            } else {
                ui.style_bg_color(handle_at(b, i), 0.173, 0.192, 0.227, 1.0)
            }
            i = i + 1
        }
    } else if b.control == CONTROL_SLIDER || b.control == CONTROL_FIELD {
        value = 0.0
        if f.type == component.TYPE_INT { value = component.get_int(c, f) as float } else { value = component.get_float(c, f) }
        if b.control == CONTROL_SLIDER {
            ui.set_slider(handle_at(b, 0), value)
            ui.set_text(handle_at(b, 1), number_text(value))
        } else {
            ui.set_text(handle_at(b, 0), number_text(value))
        }
    } else if b.control == CONTROL_VECTOR {
        v = vector_value(c, f)
        ui.set_text(handle_at(b, 0), number_text(v.x))
        ui.set_text(handle_at(b, 1), number_text(v.y))
        ui.set_text(handle_at(b, 2), number_text(v.z))
    } else if b.control == CONTROL_COLOR {
        colour = component.get_vec3(c, f)
        ui.style_bg_color(handle_at(b, 0), colour.x, colour.y, colour.z, 1.0)
        ui.set_text(handle_at(b, 1), color_hex(colour))
    } else {
        ui.set_text(handle_at(b, 0), component.get_text(c, f))
    }
}
