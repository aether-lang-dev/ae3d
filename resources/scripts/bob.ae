// Rise and fall on the spot.
//
// The height is integrated rather than assigned: moving by the derivative
// needs no memory of where the object started, so a script attached to
// something already in the air bobs around where it is rather than snapping
// to the middle of its own curve. The clock is each object's own, so two
// objects bobbing are two bobs, not one clock shared.

import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (Bob, create, destroy, fields, update)

struct Bob {
    rate: float                    // radians of the curve a second
    height: float                  // metres from the middle to the top
    clock: float                   // how far along the curve it is
}

create() -> ptr {
    b = heap.new(Bob)
    b.rate = 2.0
    b.height = 6.0
    return b as ptr
}

destroy(p: ptr) { heap.free(p as *Bob) }

fields(k: *ComponentKind) {
    component.float_field(k, "rate", offsetof(Bob, rate), 0.0, 20.0)
    component.float_field(k, "height", offsetof(Bob, height), 0.0, 100.0)
    component.float_field(k, "clock", offsetof(Bob, clock), 0.0, 0.0)
    // Where it is along the curve is what it works out, not a setting.
    component.set_flags(k, "clock", component.FIELD_TRANSIENT | component.FIELD_READONLY)
}

update(p: ptr, go: *GameObject, delta: float) {
    b = p as *Bob
    m = behaviour.object_model(go)
    b.clock = b.clock + delta
    step = core.cos_of(b.clock * b.rate) * b.height * b.rate * delta
    core.model_set_position(m, m.position.x, m.position.y + step, m.position.z)
}
