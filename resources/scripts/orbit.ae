// Circle the origin, or the object set as its centre, keeping height.
//
// The radius and the angle come from where the object already is when it
// starts, so attaching this does not teleport it: it goes round from its
// own place. An object at the centre has no radius to keep and takes the
// one set here.

import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (Orbit, create, destroy, fields, start, update)

struct Orbit {
    rate: float                    // radians a second
    radius: float                  // metres, for an object that starts at the centre
    angle: float                   // where it is round the circle
    reach: float                   // the radius it goes round at
    centre: int                    // the object it circles, by id; 0 for the origin
}

create() -> ptr {
    o = heap.new(Orbit)
    o.rate = 0.8
    o.radius = 60.0
    return o as ptr
}

destroy(p: ptr) { heap.free(p as *Orbit) }

fields(k: *ComponentKind) {
    component.float_field(k, "rate", offsetof(Orbit, rate), 0.0 - 10.0, 10.0)
    component.float_field(k, "radius", offsetof(Orbit, radius), 0.0, 0.0)
    component.float_field(k, "angle", offsetof(Orbit, angle), 0.0, 0.0)
    component.float_field(k, "reach", offsetof(Orbit, reach), 0.0, 0.0)
    component.object_field(k, "centre", offsetof(Orbit, centre))
    component.set_tooltip(k, "radius", "The circle's radius for an object that starts at the centre; one elsewhere keeps its own distance.")
    component.set_flags(k, "angle", component.FIELD_TRANSIENT | component.FIELD_READONLY)
    component.set_flags(k, "reach", component.FIELD_TRANSIENT | component.FIELD_READONLY)
}

// Where the circle is centred: the centre object, or the origin when there
// is none or it is gone.
centre_of(o: *Orbit, go: *GameObject) -> Vec3 {
    if o.centre != 0 {
        c = behaviour.scene_find_id(behaviour.object_scene(go), o.centre)
        if c != null { return behaviour.object_position(c) }
    }
    return core.vec3(0.0, 0.0, 0.0)
}

start(p: ptr, go: *GameObject) {
    o = p as *Orbit
    m = behaviour.object_model(go)
    c = centre_of(o, go)
    dx = m.position.x - c.x
    dz = m.position.z - c.z
    o.reach = core.sqrt_of(dx * dx + dz * dz)
    if o.reach < 1.0 {
        o.reach = o.radius
        o.angle = 0.0
    } else {
        o.angle = core.atan2_of(dz, dx)
    }
}

update(p: ptr, go: *GameObject, delta: float) {
    o = p as *Orbit
    m = behaviour.object_model(go)
    c = centre_of(o, go)
    o.angle = o.angle + o.rate * delta
    core.model_set_position(m, c.x + core.cos_of(o.angle) * o.reach, m.position.y, c.z + core.sin_of(o.angle) * o.reach)
}
