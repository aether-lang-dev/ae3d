// A health bar over the view, draining and filling: what a HUD script is.
// Attached to any object, it draws through the overlay its scene is drawn
// under every frame -- in a game, and in the editor's viewport, where that
// is the overlay of the engine over the viewport's renderer -- so a HUD is
// seen and tuned where the scene is built. A script reaches the overlay
// through its object (behaviour.object_overlay): it imports the overlay,
// not the engine and everything the engine draws with.
//
// The bar is anchored to the bottom-left corner in the overlay's pixels,
// so it holds its place whatever size the view is.

import ae3d.core
import ae3d.behaviour
import ae3d.hud

exports (update)

const RATE = 0.6
const LEFT = 20.0
const UP = 44.0
const WIDTH = 240.0
const HEIGHT = 18.0

var g_clock = 0.0

update(state: ptr, go: *GameObject, delta: float) {
    o = behaviour.object_overlay(go) as *Hud
    if o == null { return }
    g_clock = g_clock + delta
    health = 0.6 + 0.4 * core.sin_of(g_clock * RATE)
    bottom = (hud.frame_height(o) as float) - UP
    hud.rect(o, LEFT, bottom, WIDTH, HEIGHT, hud.rgba(0.05, 0.05, 0.07, 0.7))
    hud.rect(o, LEFT + 3.0, bottom + 3.0, (WIDTH - 6.0) * health, HEIGHT - 6.0,
             hud.rgba(0.9 - 0.7 * health, 0.25 + 0.6 * health, 0.15, 0.95))
    hud.rect_outline(o, LEFT, bottom, WIDTH, HEIGHT, 1.0, hud.rgba(1.0, 1.0, 1.0, 0.8))
}
