// Turn steadily about the up axis.
//
// A script is a component: a state of its own on every object it is on,
// the fields the inspector shows and the scene saves, and the phases it
// runs. Attaching it to something in the editor (Add Component, Scripts)
// is what makes it run, and nothing in the file says which object that is.

import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (Spin, create, destroy, fields, update)

struct Spin {
    speed: float                   // degrees a second
}

create() -> ptr {
    s = heap.new(Spin)
    s.speed = 60.0
    return s as ptr
}

destroy(p: ptr) { heap.free(p as *Spin) }

fields(k: *ComponentKind) {
    component.float_field(k, "speed", offsetof(Spin, speed), 0.0 - 720.0, 720.0)
    component.set_tooltip(k, "speed", "Degrees a second about the up axis; negative turns the other way.")
}

update(p: ptr, go: *GameObject, delta: float) {
    s = p as *Spin
    core.model_rotate(behaviour.object_model(go), 0.0, delta * s.speed, 0.0)
}
