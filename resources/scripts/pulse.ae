// Breathe: scale up and down about whatever size the object was given.
//
// The size to return to is read once, when the script starts, which is
// what start is for: a script that measured it every frame would be
// measuring its own last answer and would drift. It is each object's own:
// two objects breathing keep two sizes.

import ae3d.core
import ae3d.behaviour
import ae3d.component

@derive(schema)
struct Pulse {
    rate: float @range(0.0, 20.0) @default(2.4) @tooltip("Radians of the breath a second.")
    depth: float @range(0.0, 1.0) @default(0.12) @tooltip("How far from its size it breathes, as a share of it.")
    // What it works out as it runs, shown and not saved.
    base: float @default(1.0) @transient @readonly
    clock: float @transient @readonly
}

start(p: *Pulse, go: *GameObject) {
    p.base = behaviour.object_model(go).scale.x
    p.clock = 0.0
}

update(p: *Pulse, go: *GameObject, delta: float) {
    p.clock = p.clock + delta
    size = p.base * (1.0 + core.sin_of(p.clock * p.rate) * p.depth)
    core.model_set_scale(behaviour.object_model(go), size, size, size)
}
