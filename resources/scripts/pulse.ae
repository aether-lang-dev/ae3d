// Breathe: scale up and down about whatever size the object was given.
//
// The size to return to is read once, when the script starts, which is
// what start is for: a script that measured it every frame would be
// measuring its own last answer and would drift. It is each object's own:
// two objects breathing keep two sizes.

import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (Pulse, create, destroy, fields, start, update)

struct Pulse {
    rate: float                    // radians of the breath a second
    depth: float                   // how far from the size it breathes, as a share of it
    base: float                    // the size it breathes about
    clock: float
}

create() -> ptr {
    p = heap.new(Pulse)
    p.rate = 2.4
    p.depth = 0.12
    p.base = 1.0
    return p as ptr
}

destroy(p: ptr) { heap.free(p as *Pulse) }

fields(k: *ComponentKind) {
    component.float_field(k, "rate", offsetof(Pulse, rate), 0.0, 20.0)
    component.float_field(k, "depth", offsetof(Pulse, depth), 0.0, 1.0)
    component.float_field(k, "base", offsetof(Pulse, base), 0.0, 0.0)
    component.float_field(k, "clock", offsetof(Pulse, clock), 0.0, 0.0)
    component.set_flags(k, "base", component.FIELD_TRANSIENT | component.FIELD_READONLY)
    component.set_flags(k, "clock", component.FIELD_TRANSIENT | component.FIELD_READONLY)
}

start(p: ptr, go: *GameObject) {
    s = p as *Pulse
    s.base = behaviour.object_model(go).scale.x
    s.clock = 0.0
}

update(p: ptr, go: *GameObject, delta: float) {
    s = p as *Pulse
    s.clock = s.clock + delta
    size = s.base * (1.0 + core.sin_of(s.clock * s.rate) * s.depth)
    core.model_set_scale(behaviour.object_model(go), size, size, size)
}
