// A character walking across a person lying in the street (#654), held to
// numbers. The UE5 mannequin on 100STYLE's neutral gaits (ae3d.character),
// struck from behind at the chest and knocked down (character.knock, its
// bodies physanim's), falls on its front and lies there; a capsule (0.3 m
// by 1.8 m, stepping 0.35 m) walks across it at 1.5 m/s, over its back. No
// window.
//
//   - the lying body is there to cross: down (character.down), its bodies
//     up to 0.1 m over the ground at least, under the step height;
//   - the capsule's feet stay on the ground all the way across, never more
//     than 2 cm over it. Its ground ray took the bodies for ground, and a
//     walker whose way crossed a lying figure stood 0.3 to 0.4 m up on it
//     in the plaza;
//   - and it gets across.
//
// And a person walking with its own bodies on it (character.physical), the
// game wiring nothing between them: its capsule walks through its own
// bodies, at a walk the way it is asked, its bodies put on as it stands or
// while it walks. Pushed out of them, the box man's capsule was carried
// 16 m in 2 s against its input (#851).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.physanim
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const WALK = 1.5                       // m/s
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

world() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    return e
}

facing(o: *GameObject) -> Vec3 { return core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }

// A person walked 2 s ahead at 1.2 m/s with its bodies on it, put on as it
// stands (`at` 0) or `at` steps into the walk: how far its object went
// along the way and in all.
own_walk(at: int) -> (float, float) {
    e = world()
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    if at == 0 { _bodied = character.physical(c) }
    ahead = facing(o)
    start = behaviour.object_position(o)
    k = 0
    while k < 120 {
        if k == at && at > 0 { _put = character.physical(c) }
        character.move(c, core.v3_mul(ahead, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    now = behaviour.object_position(o)
    along = core.v3_dot(core.v3_sub(now, start), ahead)
    went = core.v3_len(core.vec3(now.x - start.x, 0.0, now.z - start.z))
    if character.physanim_of(c) == null { along = 0.0 - 1.0 }
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return along, went
}

main() {
    println("character_bodies: a character walking across a person lying in the street, and a walker through its own bodies (#851)")
    e = world()
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Man", MANNEQUIN, g)
    if c == null {
        println("  no person: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    _bodied = character.physical(c)
    pa = character.physanim_of(c)
    r = physanim.ragdoll_of(pa)
    way = facing(o)
    chest = physanim.bone_named(pa, "Chest")
    struck_at = behaviour.object_position(physics.ragdoll_bone(r, chest))
    knocked = character.knock(c, core.v3_mul(way, 3.25 * physanim.mass(pa)), struck_at, false, "Chest")
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Across its back: the line through its pelvis, square to the way it fell.
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, physanim.bone_named(pa, "Hips")))
    side = core.vec3(0.0 - way.z, 0.0, way.x)
    top = 0.0
    i = 0
    while i < physanim.bones(pa) {
        b = physics.ragdoll_bone(r, i)
        if b != null {
            y = behaviour.object_position(b).y
            if y > top { top = y }
        }
        i = i + 1
    }
    println("  knocked ${knocked}, down ${character.down(c)}: its bodies up to ${top} m over the ground, pelvis ${pelvis.y} m")
    check("the lying body is there to cross, 0.1 m high at least and under the step height", knocked && character.down(c) && top >= 0.1 && top < 0.35)
    walker = engine.object(e, "Walker", loader.cube(1.0))
    start = core.v3_sub(core.vec3(pelvis.x, 0.0, pelvis.z), core.v3_mul(side, 1.5))
    behaviour.object_set_position(walker, start)
    cc = physics.character_controller(walker, 0.3, 1.8)
    highest = 0.0
    k = 0
    while k < 120 {
        physics.character_move(cc, core.v3_mul(side, WALK), 0.0, STEP)
        engine.engine_update(e, STEP)
        at = behaviour.object_position(walker)
        if at.y > highest { highest = at.y }
        k = k + 1
    }
    at = behaviour.object_position(walker)
    across = core.v3_dot(core.v3_sub(at, start), side)
    println("  walker: feet up to ${highest * 100.0} cm over the ground, ${across} m across of 3")
    check("its feet stay on the ground over the body, never 2 cm up", highest < 0.02)
    check("it gets across", across > 2.5)
    physics.character_free(cc)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    first_along, first_went = own_walk(0)
    then_along, then_went = own_walk(30)
    println("  its own bodies on it, walked 2 s: its object went ${first_along} m ahead (${first_went} in all) with them put on standing, ${then_along} m (${then_went}) put on half a second into the walk")
    check("a person with its own bodies on it walks the way it is asked, at a walk (1 to 4 m in 2 s), its bodies put on as it stands", first_along > 1.0 && first_went < 4.0)
    check("and with its bodies put on while it walks", then_along > 1.0 && then_went < 4.0)
    if g_failures == 0 {
        println("character_bodies: all checks passed (${g_checks})")
        return
    }
    println("character_bodies: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
