// A character walking across a figure lying in the street (#654), held to
// numbers. The box man, POWERED and struck from behind at the chest, falls
// on its front and lies there; a character (0.3 m by 1.8 m, stepping 0.35
// m) walks across it at 1.5 m/s, over its back. No window.
//
//   - the lying body is there to cross: its bones up to 0.1 m over the
//     ground at least, under the step height;
//   - the character's feet stay on the ground all the way across, never
//     more than 2 cm over it. Its ground ray took the bodies for ground,
//     and a walker whose way crossed a lying figure stood 0.3 to 0.4 m up
//     on it in the plaza;
//   - and it gets across.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const WALK = 1.5                       // m/s

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

main() {
    println("character_bodies: a character walking across a figure lying in the street")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", "tests/fixtures/gltf/humanoid.glb")
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    motion.hit(m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), core.v3_mul(way, 3.25 * physics.ragdoll_mass(r)))
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Across its back: the line through its pelvis, square to the way it fell.
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    side = core.vec3(0.0 - way.z, 0.0, way.x)
    top = 0.0
    i = 0
    while i < human.BONE_COUNT {
        y = behaviour.object_position(physics.ragdoll_bone(r, i)).y
        if y > top { top = y }
        i = i + 1
    }
    println("  lying: mode ${motion.mode(m)}, its bones up to ${top} m over the ground, pelvis ${pelvis.y} m")
    check("the lying body is there to cross, 0.1 m high at least and under the step height", motion.lying(m) && top >= 0.1 && top < 0.35)
    walker = engine.object(e, "Walker", loader.cube(1.0))
    start = core.v3_sub(core.vec3(pelvis.x, 0.0, pelvis.z), core.v3_mul(side, 1.5))
    behaviour.object_set_position(walker, start)
    c = physics.character_controller(walker, 0.3, 1.8)
    highest = 0.0
    k = 0
    while k < 120 {
        physics.character_move(c, core.v3_mul(side, WALK), 0.0, STEP)
        engine.engine_update(e, STEP)
        at = behaviour.object_position(walker)
        if at.y > highest { highest = at.y }
        k = k + 1
    }
    at = behaviour.object_position(walker)
    across = core.v3_dot(core.v3_sub(at, start), side)
    println("  walker: feet up to ${highest * 100.0} cm over the ground, ${across} m across of 3")
    check("its feet stay on the ground over the body, never 2 cm up", highest < 0.02)
    check("it gets across", across > 2.5)
    engine.engine_free(e)
    motion.motion_free(m)
    if g_failures == 0 {
        println("character_bodies: all checks passed (${g_checks})")
        return
    }
    println("character_bodies: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
