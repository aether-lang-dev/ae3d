// Changing clip without a pop (#574), held to numbers on the Fox fixture
// (Walk, Run, Survey), no window: the figure stepped by hand at 60 Hz.
//
// What a pop is: how far a bone jumps in one frame -- its world position's
// step, and the angle its local rotation turns -- against how far the clips
// themselves ever move it in one frame.
//
//   - a cut from Walk to Run jumps by more than either clip ever moves a bone
//     in a frame (the number is printed: it is what the cut costs);
//   - an inertialized change over 0.3 s never steps a bone further than the
//     larger of the clips' own largest steps (a little over, for the decay
//     riding on top);
//   - once the blend time is over, the pose is the new clip's, to 1e-4;
//   - a layer over the bones under one bone poses those bones as its clip
//     does and leaves every other bone as the clip beneath; an additive layer
//     at weight 0 changes nothing, and at its own first frame changes
//     nothing; at weight 1 it moves the bones it animates.

import std.list
import ae3d.core
import ae3d.gltf
import ae3d.skin
import ae3d.figure

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

const FOX = "tests/fixtures/gltf/Fox.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
    fflush(null)
}

// Every bone's world position and local rotation, four floats... seven.
snapshot(f: *Figure, out: ptr) {
    sk = figure.skeleton(f)
    p = out as float[]
    i = 0
    while i < skin.skeleton_count(sk) {
        bone = skin.skeleton_bone(sk, i)
        core.model_sync_transform(bone)
        p[i * 7] = bone.world_position.x
        p[i * 7 + 1] = bone.world_position.y
        p[i * 7 + 2] = bone.world_position.z
        p[i * 7 + 3] = bone.rotation.x
        p[i * 7 + 4] = bone.rotation.y
        p[i * 7 + 5] = bone.rotation.z
        p[i * 7 + 6] = bone.rotation.w
        i = i + 1
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// The angle between two rotations, radians.
turn_between(a: float[], b: float[], at: int) -> float {
    d = a[at + 3] * b[at + 3] + a[at + 4] * b[at + 4] + a[at + 5] * b[at + 5] + a[at + 6] * b[at + 6]
    d = abs_of(d)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// The largest step any bone takes between two snapshots: metres, radians.
largest_step(f: *Figure, a: ptr, b: ptr) -> (float, float) {
    sk = figure.skeleton(f)
    pa = a as float[]
    pb = b as float[]
    worst_move = 0.0
    worst_turn = 0.0
    i = 0
    while i < skin.skeleton_count(sk) {
        at = i * 7
        dx = pa[at] - pb[at]
        dy = pa[at + 1] - pb[at + 1]
        dz = pa[at + 2] - pb[at + 2]
        move = core.sqrt_of(dx * dx + dy * dy + dz * dz)
        if move > worst_move { worst_move = move }
        t = turn_between(pa, pb, at)
        if t > worst_turn { worst_turn = t }
        i = i + 1
    }
    return worst_move, worst_turn
}

// The largest per-frame step a clip itself takes over its whole length.
clip_peak(f: *Figure, name: string) -> (float, float) {
    figure.play(f, name, 1.0, true)
    figure.advance(f, STEP)
    n = skin.skeleton_count(figure.skeleton(f))
    a = calloc(n * 7, 8)
    b = calloc(n * 7, 8)
    snapshot(f, a)
    move = 0.0
    turn = 0.0
    k = 0
    frames = (figure.duration(f) / STEP) as int + 2
    while k < frames {
        figure.advance(f, STEP)
        snapshot(f, b)
        m, t = largest_step(f, a, b)
        if m > move { move = m }
        if t > turn { turn = t }
        snapshot(f, a)
        k = k + 1
    }
    free(a)
    free(b)
    return move, turn
}

// Walk for half a second, then change to Run (cut or blended), and the
// largest step any bone takes in the eight frames around the change.
change_step(f: *Figure, blended: bool) -> (float, float) {
    figure.play(f, "Walk", 1.0, true)
    k = 0
    while k < 30 {
        figure.advance(f, STEP)
        k = k + 1
    }
    n = skin.skeleton_count(figure.skeleton(f))
    a = calloc(n * 7, 8)
    b = calloc(n * 7, 8)
    snapshot(f, a)
    if blended {
        figure.play_blended(f, "Run", 1.0, true, 0.3)
    } else {
        figure.play(f, "Run", 1.0, true)
    }
    move = 0.0
    turn = 0.0
    k = 0
    while k < 8 {
        figure.advance(f, STEP)
        snapshot(f, b)
        m, t = largest_step(f, a, b)
        if m > move { move = m }
        if t > turn { turn = t }
        snapshot(f, a)
        k = k + 1
    }
    free(a)
    free(b)
    return move, turn
}

main() {
    println("blend: changing clip without a pop (#574)")
    group = core.model_new()
    f = figure.figure_new(FOX, group)
    if f == null {
        println("blend: SKIP ${FOX} would not load")
        return
    }
    sk = figure.skeleton(f)
    n = skin.skeleton_count(sk)

    walk_move, walk_turn = clip_peak(f, "Walk")
    run_move, run_turn = clip_peak(f, "Run")
    own_move = walk_move
    if run_move > own_move { own_move = run_move }
    own_turn = walk_turn
    if run_turn > own_turn { own_turn = run_turn }
    cut_move, cut_turn = change_step(f, false)
    blend_move, blend_turn = change_step(f, true)
    // The fox is modelled in centimetres, a hundred units to its height.
    println("  the clips' own largest step a frame: ${own_move} units, ${own_turn * 57.29578} degrees")
    println("  Walk to Run, cut: ${cut_move} units, ${cut_turn * 57.29578} degrees; inertialized over 0.3 s: ${blend_move} units, ${blend_turn * 57.29578} degrees")
    check("a cut jumps a bone further than the clips ever move one in a frame", cut_move > own_move * 1.2 || cut_turn > own_turn * 1.2)
    check("an inertialized change never steps a bone further than the clips' own largest step (and a tenth)",
          blend_move <= own_move * 1.1 && blend_turn <= own_turn * 1.1)

    // After the blend, the new clip's own pose.
    figure.play(f, "Walk", 1.0, true)
    k = 0
    while k < 30 {
        figure.advance(f, STEP)
        k = k + 1
    }
    figure.play_blended(f, "Run", 1.0, true, 0.3)
    k = 0
    while k < 24 {
        figure.advance(f, STEP)
        k = k + 1
    }
    settled = !figure.blending(f)
    blended_pose = calloc(n * 7, 8)
    snapshot(f, blended_pose)
    at_time = figure.time(f)
    figure.play(f, "Run", 1.0, true)
    figure.set_time(f, at_time)
    clean = calloc(n * 7, 8)
    snapshot(f, clean)
    diff_move, diff_turn = largest_step(f, blended_pose, clean)
    println("  0.4 s after a 0.3 s change: ${diff_move} m and ${diff_turn} rad from Run's own pose")
    check("once the blend time is over, the pose is the new clip's (to 1e-4)", settled && diff_move < 0.0001 && diff_turn < 0.0001)
    free(blended_pose)
    free(clean)

    // Layers: Survey over the bones under one bone, the rest Walk.
    // The bone with the most bones under it short of the whole figure:
    // an upper body, as a mask is meant for.
    root = skin.skeleton_bone(sk, 0)
    under = 0
    c = 0
    while c < n {
        candidate = skin.skeleton_bone(sk, c)
        count = 0
        i = 0
        while i < n {
            if hangs_under(skin.skeleton_bone(sk, i), candidate) { count = count + 1 }
            i = i + 1
        }
        if count < n * 2 / 3 && count > under {
            under = count
            root = candidate
        }
        c = c + 1
    }
    figure.play(f, "Walk", 1.0, true)
    figure.set_time(f, 0.4)
    walk_pose = calloc(n * 7, 8)
    snapshot(f, walk_pose)
    figure.play(f, "Survey", 1.0, true)
    figure.set_time(f, 0.0)
    survey_pose = calloc(n * 7, 8)
    snapshot(f, survey_pose)
    figure.play(f, "Walk", 1.0, true)
    layer = figure.layer_play_under(f, "Survey", root, 1.0, false, true)
    figure.set_time(f, 0.4)
    layered = calloc(n * 7, 8)
    snapshot(f, layered)
    outside_off = 0.0
    inside_off = 0.0
    a = layered as float[]
    w = walk_pose as float[]
    sv = survey_pose as float[]
    i = 0
    while i < n {
        bone = skin.skeleton_bone(sk, i)
        if hangs_under(bone, root) {
            t = turn_between(a, sv, i * 7)
            if t > inside_off { inside_off = t }
        } else {
            t = turn_between(a, w, i * 7)
            if t > outside_off { outside_off = t }
        }
        i = i + 1
    }
    println("  a layer under ${core.text(root.name)} (${under} of ${n} bones): inside ${inside_off} rad from its clip, outside ${outside_off} rad from the clip beneath")
    check("a masked layer poses its bones as its clip does and leaves the rest to the clip beneath",
          layer == 0 && under > 0 && under < n && inside_off < 0.0001 && outside_off < 0.0001)
    figure.layer_stop(f, layer)

    // Additive.
    add = figure.layer_play_under(f, "Survey", null, 0.0, true, true)
    figure.set_time(f, 0.4)
    snapshot(f, layered)
    _zero_move, zero_turn = largest_step(f, layered, walk_pose)
    figure.layer_set_weight(f, add, 1.0)
    figure.set_time(f, 0.4)
    snapshot(f, layered)
    _first_move, first_turn = largest_step(f, layered, walk_pose)
    figure.advance(f, 0.5)
    figure.set_time(f, 0.4)
    snapshot(f, layered)
    _on_move, on_turn = largest_step(f, layered, walk_pose)
    println("  additive: at weight 0 ${zero_turn} rad off the clip beneath; at its first frame ${first_turn}; half a second in ${on_turn}")
    check("an additive layer at weight 0, or at its own first frame, changes nothing", zero_turn < 0.0001 && first_turn < 0.0001)
    check("and at weight 1, past its first frame, it moves the bones it animates", on_turn > 0.01)
    figure.layer_stop(f, add)
    free(walk_pose)
    free(survey_pose)
    free(layered)

    figure.figure_free(f)
    core.model_free(group)
    if g_failures == 0 {
        println("blend: all checks passed (${g_checks})")
    } else {
        println("blend: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}

hangs_under(m: *Model, root: *Model) -> bool {
    at = m
    while at != null {
        if at == root { return true }
        at = at.parent as *Model
    }
    return false
}
