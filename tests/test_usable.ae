// Usable objects (#908), held to numbers: kinds read from their data files
// (tests/fixtures/usable), objects placed in a world, slots found and held.
// No window.
//
//   - kinds: a log's two seats, a stool's four, a step's one and a bench's
//     tool slot read with their points, facings, approaches, tags, takes and
//     the part that lands; a file with no slots is refused, saying so;
//   - slots in the world: a slot's point, facing and approach go where its
//     object stands and turn as it faces, in metres whatever its scale;
//   - claims: a slot held by one figure is never found by or given to
//     another; let go, it is found again; let go by one that does not hold
//     it, it stays held; an object removed, its slots are never found;
//   - the search: over 1,000 objects (a log, a stool, a step or a bench each,
//     placed and turned at random over 200 m by 200 m), the nearest free slot
//     with a tag found from 2,000 places is the one a look at every slot
//     finds, every time; and how long the 2,000 take, against looking at
//     every slot, is printed and held faster.

import std.os
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.usable

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const KINDS = "tests/fixtures/usable/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

near(a: Vec3, b: Vec3) -> bool { return core.v3_len(core.v3_sub(a, b)) < 0.0001 }

// A number from 0 to 1, the same every run.
var g_seed = 12345

next_random() -> float {
    g_seed = (g_seed * 1103515245 + 12345) % 2147483647
    if g_seed < 0 { g_seed = 0 - g_seed }
    return (g_seed % 1000000) as float / 1000000.0
}

kinds() {
    log = usable.kind_read("${KINDS}log.usable")
    stool = usable.kind_read("${KINDS}stool.usable")
    step = usable.kind_read("${KINDS}step.usable")
    bench = usable.kind_read("${KINDS}bench.usable")
    read = log != null && stool != null && step != null && bench != null
    check("four kinds read from their files", read)
    if !read { return }
    check("the log has two seats, the stool four, the step one, the bench one", usable.kind_slots(log) == 2 && usable.kind_slots(stool) == 4 && usable.kind_slots(step) == 1 && usable.kind_slots(bench) == 1)
    e = engine.engine_new()
    o = engine.object(e, "Log", loader.cube(1.0))
    behaviour.object_set_position(o, core.vec3(10.0, 0.0, 5.0))
    behaviour.object_set_rotation(o, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    // Scaled to a log's size: its slots stay in metres where the file puts them.
    behaviour.object_set_scale(o, core.vec3(1.2, 0.4, 0.3))
    u = usable.usables_new(2.0)
    first = usable.add(u, o, log)
    // The log turned a quarter about up: its left seat (-0.35, 0.40, 0) is at
    // (0, 0.40, 0.35) off it, facing +x, approached from 0.55 m that way.
    at = usable.slot_at(u, first)
    facing = usable.slot_facing(u, first)
    approach = usable.slot_approach(u, first)
    println("  the log's left seat: at ${at.x}, ${at.y}, ${at.z}; facing ${facing.x}, ${facing.y}, ${facing.z}; approached from ${approach.x}, ${approach.y}, ${approach.z}")
    check("a slot's point, facing and approach go where its object stands and turn as it faces", near(at, core.vec3(10.0, 0.40, 5.35)) && near(facing, core.vec3(1.0, 0.0, 0.0)) && near(approach, core.vec3(10.55, 0.0, 5.35)))
    check("its tags, takes and the part that lands are the file's", usable.slot_tagged(u, first, "sit") && usable.slot_tagged(u, first, "rest") && !usable.slot_tagged(u, first, "work") && usable.slot_lands(u, first) == usable.LANDS_PELVIS && string.equals(usable.slot_enter(u, first), "Sitting_Enter") == 1 && string.equals(usable.slot_loop(u, first), "Sitting_Idle_Loop") == 1 && string.equals(usable.slot_exit(u, first), "Sitting_Exit") == 1)
    b = engine.object(e, "Bench", loader.cube(1.0))
    tool = usable.add(u, b, bench)
    check("the bench's tool slot is a right hand's, with no exit take", usable.slot_lands(u, tool) == usable.LANDS_HAND_R && usable.slot_tagged(u, tool, "work") && string.length(usable.slot_exit(u, tool)) == 0)
    usable.usables_free(u)
    usable.kind_free(log)
    usable.kind_free(stool)
    usable.kind_free(step)
    usable.kind_free(bench)
    engine.engine_free(e)
    missing = usable.kind_read("${KINDS}missing.usable")
    check("a file that is not there is refused, saying so", missing == null && string.equals(usable.kind_error(), "cannot read the file") == 1)
}

claims() {
    e = engine.engine_new()
    log = usable.kind_read("${KINDS}log.usable")
    o = engine.object(e, "Log", loader.cube(1.0))
    u = usable.usables_new(2.0)
    first = usable.add(u, o, log)
    anna = calloc(1, 8)
    ben = calloc(1, 8)
    // Both stand nearest the left seat; Anna takes it, so Ben is given the right.
    by_left = core.vec3(0.0 - 0.35, 0.0, 0.6)
    s = usable.find(u, by_left, 5.0, "sit", anna)
    took = usable.claim(u, s, anna)
    other = usable.find(u, by_left, 5.0, "sit", ben)
    stolen = usable.claim(u, s, ben)
    check("held by one, a slot is not found for another nor given to it", s == first && took && other == first + 1 && !stolen && usable.claimant(u, s) == anna)
    usable.release(u, s, ben)
    check("let go by one that does not hold it, it stays held", usable.claimant(u, s) == anna)
    usable.release(u, s, anna)
    check("let go, it is found again", usable.find(u, by_left, 5.0, "sit", ben) == first)
    usable.claim(u, first + 1, ben)
    usable.remove(u, o)
    check("its object removed, its slots are never found, and whoever held one lets go", usable.find(u, by_left, 5.0, "sit", anna) < 0 && usable.claimant(u, first + 1) == null && !usable.claim(u, first, anna))
    free(anna)
    free(ben)
    usable.usables_free(u)
    usable.kind_free(log)
    engine.engine_free(e)
}

search() {
    e = engine.engine_new()
    kinds = [usable.kind_read("${KINDS}log.usable"), usable.kind_read("${KINDS}stool.usable"),
             usable.kind_read("${KINDS}step.usable"), usable.kind_read("${KINDS}bench.usable")]
    u = usable.usables_new(4.0)
    keeper = calloc(1, 8)
    asker = calloc(1, 8)
    n = 0
    while n < 1000 {
        o = engine.object(e, "Thing", loader.cube(1.0))
        behaviour.object_set_position(o, core.vec3(next_random() * 200.0 - 100.0, 0.0, next_random() * 200.0 - 100.0))
        behaviour.object_set_rotation(o, core.quat_rotate(next_random() * 6.2831853, core.vec3(0.0, 1.0, 0.0)))
        usable.add(u, o, kinds[n % 4])
        n = n + 1
    }
    // Some held, so the search passes over them.
    i = 0
    while i < usable.slots(u) {
        if i % 7 == 0 { usable.claim(u, i, keeper) }
        i = i + 1
    }
    tags = ["sit", "work", "rest", ""]
    places = calloc(2000 * 3, 8) as float[]
    k = 0
    while k < 2000 {
        places[k * 3] = next_random() * 220.0 - 110.0
        places[k * 3 + 2] = next_random() * 220.0 - 110.0
        k = k + 1
    }
    differed = 0
    found = 0
    k = 0
    while k < 2000 {
        at = core.vec3(places[k * 3], 0.0, places[k * 3 + 2])
        a = usable.find(u, at, 12.0, tags[k % 4], asker)
        b = usable.find_every(u, at, 12.0, tags[k % 4], asker)
        if a != b { differed = differed + 1 }
        if a >= 0 { found = found + 1 }
        k = k + 1
    }
    fast = 1000000000.0
    slow = 1000000000.0
    run = 0
    while run < 5 {
        started = os.now_monotonic_ns()
        k = 0
        while k < 2000 {
            usable.find(u, core.vec3(places[k * 3], 0.0, places[k * 3 + 2]), 12.0, tags[k % 4], asker)
            k = k + 1
        }
        took = (os.now_monotonic_ns() - started) as float
        if took < fast { fast = took }
        started = os.now_monotonic_ns()
        k = 0
        while k < 2000 {
            usable.find_every(u, core.vec3(places[k * 3], 0.0, places[k * 3 + 2]), 12.0, tags[k % 4], asker)
            k = k + 1
        }
        took = (os.now_monotonic_ns() - started) as float
        if took < slow { slow = took }
        run = run + 1
    }
    println("  1,000 objects, ${usable.slots(u)} slots: 2,000 searches within 12 m found ${found} slots; ${fast / 1000000.0} ms, every slot looked at ${slow / 1000000.0} ms; ${differed} found another slot than looking at every one")
    check("over 1,000 objects, the search finds the slot a look at every slot does, every time, and faster", differed == 0 && found > 500 && fast < slow)
    free(places as ptr)
    free(keeper)
    free(asker)
    usable.usables_free(u)
    k = 0
    while k < 4 {
        usable.kind_free(kinds[k])
        k = k + 1
    }
    engine.engine_free(e)
}


main() {
    println("usable: kinds from files, slots found and held (#908)")
    kinds()
    claims()
    search()
    if g_failures == 0 {
        println("usable: all checks passed (${g_checks})")
        return
    }
    println("usable: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
