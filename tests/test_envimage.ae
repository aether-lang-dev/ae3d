// Environment-map files decoded to float images (#869): Radiance .hdr and
// OpenEXR, from the fixtures tools/make_env_fixtures.ae writes.
//
// The "coded" picture has a formula for every texel, exact in RGBE and in
// half floats, so each decode is held to it with no tolerance: the flat and
// run-length Radiance forms, the old run-length texels, the mirrored
// orientation, and EXR uncompressed, RLE, ZIPS and ZIP (the last two blocks,
// the second short), HALF and FLOAT, with and without alpha, with a depth
// channel to step over, lines last-first, and a data window off the origin.
// The gradient is held to its formula within the format's own rounding
// (RGBE keeps eight bits of mantissa, half floats eleven). Files that are not
// read -- PXR24, B44, DWAA, tiled, truncated, not a picture -- fail with a reason,
// and a file cut at every length or damaged at every byte never crashes the reader.
//
// PIZ files are the official OpenEXR library's: written by it
// (tools/exr_reference/exrref.cpp, tests/fixtures/env/PIZ.md) and held to what
// its own reader makes of them, bit for bit. A decode here is hashed over the
// bit patterns of its RGBA float texels, in order, by two polynomial hashes
// mod a prime, and the pair compared with the one the library's decode of the
// same file has (exrref dump prints it). A hash is no proof by itself, but a
// texel that differs by one bit changes it, and the pairs are 2^-60 apart by
// chance.

import std.string
import std.mem
import ae3d.hdrimage
import ae3d.envimage
import ae3d.openexr
import ae3d.blob

extern sin(x: float) -> float
extern exit(code: int)

const PI = 3.14159265358979323846
const DIR = "tests/fixtures/env"

var g_checks = 0
var g_failures = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

// The pictures' formulas, as tools/make_env_fixtures.ae states them.
value(which: int, x: int, y: int, c: int) -> float {
    if which == 0 {
        if c == 0 { return (x + 1) as float }
        if c == 1 { return (y + 1) as float }
        if c == 2 {
            if (x + y) % 2 == 0 { return 0.5 }
            return 2.0
        }
        return ((y % 4) + 1) as float * 0.25
    }
    if which == 4 {
        if c == 0 { return 0.5 }
        if c == 1 { return 0.75 }
        if c == 2 { return 0.25 }
        return 1.0
    }
    if which == 2 {
        if c == 0 { return (y + 1) as float }
        if c == 1 { return 1.0 }
        if c == 2 { return 0.5 }
        return 1.0
    }
    if c == 3 { return 1.0 }
    lat = (0.5 - ((y as float) + 0.5) / 32.0) * PI
    s = sin(lat)
    lon = 1.0 + 0.25 * sin(((x as float) + 0.5) / 64.0 * 2.0 * PI)
    if s >= 0.0 {
        if c == 0 { return (0.5 + 1.5 * s) * lon }
        if c == 1 { return (0.8 + 1.2 * s) * lon }
        return (1.0 + 3.0 * s) * lon
    }
    k = 1.0 + 0.5 * s
    if c == 0 { return 0.30 * k }
    if c == 1 { return 0.25 * k }
    return 0.20 * k
}

texel(img: ptr, x: int, y: int, c: int) -> float {
    p = hdrimage.pixels(img) as f32[]
    return p[(y * hdrimage.width(img) + x) * 4 + c] as float
}

// Every texel of `img` against the picture's formula; `relative` the
// tolerance as a share of the value (0 for exact), `alpha` whether channel 3
// is the picture's own (else 1).
worst_error(img: ptr, which: int, alpha: bool) -> float {
    worst = 0.0
    y = 0
    while y < hdrimage.height(img) {
        x = 0
        while x < hdrimage.width(img) {
            c = 0
            while c < 4 {
                want = value(which, x, y, c)
                if c == 3 && !alpha { want = 1.0 }
                got = texel(img, x, y, c)
                e = got - want
                if e < 0.0 { e = 0.0 - e }
                scale = want
                if scale < 0.0 { scale = 0.0 - scale }
                if scale < 1.0 { scale = 1.0 }
                if e / scale > worst { worst = e / scale }
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return worst
}

// The two hashes of a decode's texel bits, as exrref prints them.
hash_of(img: ptr, which: int) -> long {
    p = hdrimage.pixels(img)
    n = hdrimage.width(img) * hdrimage.height(img) * 4
    base = 31 as long
    modulus = 1000000007 as long
    if which == 1 {
        base = 131 as long
        modulus = 998244353 as long
    }
    h = 0 as long
    i = 0
    while i < n {
        h = (h * base + (mem.get_u32_le(p, i * 4) as long)) % modulus
        i = i + 1
    }
    return h
}

// A file that is the OpenEXR library's PIZ (or any) file, read here to the
// texels its own reader makes of it.
same_as_openexr(path: string, width: int, height: int, h1: long, h2: long) {
    img = envimage.load(path)
    check("${path}: loads (${envimage.error()})", img != null)
    if img == null { return }
    check("${path}: ${width} by ${height}", hdrimage.width(img) == width && hdrimage.height(img) == height)
    check("${path}: every texel is OpenEXR's, bit for bit", hash_of(img, 0) == h1 && hash_of(img, 1) == h2)
    hdrimage.dispose(img)
}

piz(name: string, width: int, height: int, h1: long, h2: long) {
    same_as_openexr("${DIR}/${name}", width, height, h1, h2)
}

loads(name: string, width: int, height: int) -> ptr {
    img = envimage.load("${DIR}/${name}")
    check("${name}: loads (${envimage.error()})", img != null)
    if img == null { return null }
    check("${name}: ${width} by ${height}", hdrimage.width(img) == width && hdrimage.height(img) == height)
    return img
}

exact(name: string, which: int, alpha: bool) {
    img = loads(name, 8, 20)
    if img == null { return }
    check("${name}: every texel is its formula exactly", worst_error(img, which, alpha) == 0.0)
    hdrimage.dispose(img)
}

exact_bands(name: string) {
    img = loads(name, 32, 4)
    if img == null { return }
    check("${name}: every texel is its formula exactly", worst_error(img, 2, false) == 0.0)
    hdrimage.dispose(img)
}

exact_wide(name: string) {
    img = loads(name, 600, 2)
    if img == null { return }
    check("${name}: every texel is its formula exactly", worst_error(img, 4, false) == 0.0)
    hdrimage.dispose(img)
}

refused(name: string, word: string) {
    img = envimage.load("${DIR}/${name}")
    check("${name}: refused", img == null)
    check("${name}: the reason names ${word} (${envimage.error()})", string.contains(envimage.error(), word) == 1)
    if img != null { hdrimage.dispose(img) }
}

// A file cut at every length, and with every byte changed in turn to a value
// from a fixed sequence: whatever the reader makes of them, it returns and
// never reads outside the bytes (the leaks tier and the sanitizers hold the
// rest).
survives(name: string) {
    data = blob.read("${DIR}/${name}")
    size = blob.last_size() as int
    if data == null { check("${name}: readable for the fuzz", false); return }
    cut = 0
    while cut < size {
        copy = malloc(cut + 8)
        mem.copy(copy, data, cut as long)
        img = envimage.from_memory(copy, cut)
        if img != null { hdrimage.dispose(img) }
        free(copy)
        cut = cut + 1
    }
    seed = 12345
    i = 0
    while i < size {
        copy = malloc(size + 8)
        mem.copy(copy, data, size as long)
        seed = (seed * 1103515245 + 12345) & 2147483647
        mem.set_uint8(copy, i, (seed >> 8) & 255)
        img = envimage.from_memory(copy, size)
        if img != null { hdrimage.dispose(img) }
        free(copy)
        i = i + 1
    }
    // And every byte to 0 and to 255 in turn: the extremes a length or a count takes.
    i = 0
    while i < size {
        v = 0
        while v <= 255 {
            copy = malloc(size + 8)
            mem.copy(copy, data, size as long)
            mem.set_uint8(copy, i, v)
            img = envimage.from_memory(copy, size)
            if img != null { hdrimage.dispose(img) }
            free(copy)
            v = v + 255
        }
        i = i + 1
    }
    check("${name}: cut at every length and damaged at every byte, the reader returns", true)
    blob.free_bytes(data)
}

// The byte of the first block's Huffman header, `field` bytes in (12 is the
// number of bits the stream has), of a PIZ file in `data`, or -1.
huffman_header(data: ptr, size: int) -> int {
    at = 8
    while at < size && mem.get_uint8(data, at) != 0 {
        while at < size && mem.get_uint8(data, at) != 0 { at = at + 1 }
        at = at + 1
        while at < size && mem.get_uint8(data, at) != 0 { at = at + 1 }
        at = at + 1
        if at + 4 > size { return 0 - 1 }
        at = at + 4 + (mem.get_u32_le(data, at) as int)
    }
    table = at + 1
    if table + 8 > size { return 0 - 1 }
    block = (mem.get_u32_le(data, table) as int) + 8
    if block + 4 > size { return 0 - 1 }
    low = mem.get_u16_le(data, block)
    high = mem.get_u16_le(data, block + 2)
    at = block + 4
    if low <= high { at = at + (high - low + 1) }
    return at + 4
}

// A PIZ file whose first block's Huffman stream is made to claim `fewer`
// bits less than its samples need, or more: refused, never filled out with
// zeros or read past its end.
wrong_bit_count(name: string, change: int) {
    data = blob.read("${DIR}/${name}")
    size = blob.last_size() as int
    if data == null { check("${name}: readable", false); return }
    at = huffman_header(data, size)
    copy = malloc(size + 8)
    mem.copy(copy, data, size as long)
    if at > 0 && at + 16 <= size {
        bits = mem.get_u32_le(copy, at + 12) as int
        mem.set_u32_le(copy, at + 12, bits + change)
        img = envimage.from_memory(copy, size)
        check("${name}: a Huffman stream with ${change} bits more is refused (${envimage.error()})", img == null && string.contains(envimage.error(), "PIZ") == 1)
        if img != null { hdrimage.dispose(img) }
    } else {
        check("${name}: finds its Huffman header", false)
    }
    free(copy)
    blob.free_bytes(data)
}

extern malloc(n: int) -> ptr
extern free(p: ptr)

main() {
    exact("coded_flat.hdr", 0, false)
    exact("coded_rle.hdr", 0, false)
    exact("coded_flip.hdr", 0, false)
    exact("coded_old_rle.hdr", 0, false)
    exact_bands("bands_flat.hdr")
    exact_bands("bands_rle.hdr")
    exact_bands("bands_old_rle.hdr")
    // A run of 599 repeats in the old form takes two digits, 87 and 2 shifted
    // up eight bits.
    exact_wide("wide_flat.hdr")
    exact_wide("wide_old_rle.hdr")
    exact("coded_none.exr", 0, false)
    exact("coded_rle.exr", 0, false)
    exact("coded_zips.exr", 0, false)
    exact("coded_zip.exr", 0, false)
    exact("coded_float_rgba.exr", 0, true)
    // Lines last-first, a data window from (-3, 5), a FLOAT depth channel
    // between the colour and the end of each line.
    exact("coded_extra.exr", 0, true)

    // PIZ: each file against the OpenEXR library's decode of it. HALF and
    // FLOAT, RGB, RGBA and grey, the 14-bit and the 16-bit wavelet, a height
    // not a multiple of 32 (and exactly 32 and 64), a single line and a
    // single column, flat and black pictures (a Huffman table of two symbols),
    // a data window off the origin, a file whose blocks the library stored
    // raw (PIZ gave no gain), and two real assets (Poly Haven, CC0).
    piz("piz_rgb_half_grad.exr", 37, 45, (110210915 as long), (460490683 as long))
    piz("piz_rgba_half_grad.exr", 100, 70, (314707591 as long), (453740317 as long))
    piz("piz_rgb_float_hgrad.exr", 53, 33, (122425574 as long), (371626628 as long))
    piz("piz_rgba_float_hgrad.exr", 90, 48, (804631360 as long), (266694480 as long))
    piz("piz_rgb_half_bitramp.exr", 600, 64, (856954338 as long), (359506288 as long))
    piz("piz_rgba_float_bitramp.exr", 600, 64, (745957011 as long), (57547744 as long))
    piz("piz_rgb_half_lowrange.exr", 91, 65, (56105964 as long), (322683782 as long))
    piz("piz_rgba_half_sparse.exr", 200, 40, (940542996 as long), (283374254 as long))
    piz("piz_rgb_half_ramp.exr", 64, 40, (224822029 as long), (857734435 as long))
    piz("piz_one_line.exr", 1000, 1, (444191373 as long), (557594896 as long))
    piz("piz_one_line_float.exr", 600, 1, (897462311 as long), (477736672 as long))
    piz("piz_one_column.exr", 1, 800, (975345282 as long), (574863949 as long))
    piz("piz_narrow.exr", 4, 600, (972460238 as long), (336164025 as long))
    piz("piz_flat.exr", 30, 20, (159307850 as long), (701639618 as long))
    piz("piz_black.exr", 30, 20, (367608414 as long), (22577309 as long))
    piz("piz_flat_float.exr", 31, 33, (29103356 as long), (352733039 as long))
    piz("piz_h32.exr", 40, 32, (425170560 as long), (907806262 as long))
    piz("piz_h33.exr", 200, 33, (659702081 as long), (903418877 as long))
    piz("piz_h64.exr", 40, 64, (328846284 as long), (132477499 as long))
    piz("piz_grey_half.exr", 100, 38, (652203960 as long), (323487434 as long))
    piz("piz_grey_float.exr", 200, 40, (394033597 as long), (288221650 as long))
    piz("piz_window.exr", 100, 36, (706450843 as long), (995552759 as long))
    piz("piz_wide.exr", 1000, 3, (549712128 as long), (976356790 as long))
    piz("piz_stored_raw.exr", 64, 64, (602071887 as long), (16851199 as long))
    piz("piz_fuzz_half.exr", 23, 35, (267182940 as long), (584422329 as long))
    same_as_openexr("${DIR}/polyhaven/abandoned_tank_farm_05_1k.exr", 1024, 512, (208339294 as long), (585496054 as long))
    same_as_openexr("${DIR}/polyhaven/aerodynamics_workshop_1k.exr", 1024, 512, (950403436 as long), (766530745 as long))

    hdr = loads("gradient.hdr", 64, 32)
    if hdr != null {
        e = worst_error(hdr, 1, false)
        // RGBE: the three mantissas share an exponent and are cut to eight
        // bits, so a channel is off by up to one step of the largest's, a
        // 128th of it (about 0.04 of the brightest texel's 5.5; the error
        // is measured against the value or 1, whichever is more).
        check("gradient.hdr: within RGBE's rounding of its formula (${e})", e < 0.02)
    }
    exr = loads("gradient.exr", 64, 32)
    if exr != null {
        e = worst_error(exr, 1, true)
        check("gradient.exr: within half-float rounding of its formula (${e})", e < 0.0011)
    }
    if hdr != null && exr != null {
        worst = 0.0
        y = 0
        while y < 32 {
            x = 0
            while x < 64 {
                c = 0
                while c < 3 {
                    d = texel(hdr, x, y, c) - texel(exr, x, y, c)
                    if d < 0.0 { d = 0.0 - d }
                    if d > worst { worst = d }
                    c = c + 1
                }
                x = x + 1
            }
            y = y + 1
        }
        check("the .hdr and the .exr of the gradient agree to 0.06 (${worst})", worst < 0.06)
    }
    if hdr != null { hdrimage.dispose(hdr) }
    if exr != null { hdrimage.dispose(exr) }

    // Half floats, binary16 by the bit.
    check("half 0x3C00 is 1", openexr.half_to_float(15360) == 1.0)
    check("half 0xC000 is -2", openexr.half_to_float(49152) == 0.0 - 2.0)
    check("half 0x7BFF is 65504", openexr.half_to_float(31743) == 65504.0)
    check("half 0x0400, the smallest normal, is 2^-14", openexr.half_to_float(1024) == 6.103515625e-5)
    check("half 0x0001, the smallest denormal, is 2^-24", openexr.half_to_float(1) == 5.960464477539063e-8)
    check("half 0x0000 and 0x8000 are zeros", openexr.half_to_float(0) == 0.0 && openexr.half_to_float(32768) == 0.0)
    check("half infinity is a finite float", openexr.half_to_float(31744) < 3.5e38 && openexr.half_to_float(31744) > 3.0e38)
    check("half NaN is zero", openexr.half_to_float(32256) == 0.0)

    refused("coded_pxr24.exr", "PXR24")
    refused("coded_b44.exr", "B44")
    refused("coded_dwaa.exr", "DWAA")
    refused("coded_tiled.exr", "tiled")
    refused("coded_short.exr", "OpenEXR")
    garbage = envimage.from_memory("this is not a picture at all", 28)
    check("a file that is neither format is refused", garbage == null && string.contains(envimage.error(), "Radiance") == 1)
    check("a missing file is refused", envimage.load("${DIR}/no_such.hdr") == null && string.contains(envimage.error(), "cannot read") == 1)

    wrong_bit_count("piz_rgb_half_ramp.exr", 0 - 24)
    wrong_bit_count("piz_rgb_half_ramp.exr", 0 - 9)
    wrong_bit_count("piz_rgb_half_ramp.exr", 40)
    wrong_bit_count("piz_rgb_half_grad.exr", 0 - 24)
    survives("coded_rle.hdr")
    survives("coded_old_rle.hdr")
    survives("coded_flat.hdr")
    survives("coded_rle.exr")
    survives("coded_zips.exr")
    survives("coded_zip.exr")
    survives("coded_extra.exr")
    survives("piz_fuzz_half.exr")
    survives("piz_flat_float.exr")
    survives("piz_flat.exr")
    survives("piz_black.exr")
    survives("piz_rgb_half_lowrange.exr")
    survives("piz_rgb_half_ramp.exr")

    if g_failures == 0 {
        println("envimage: all checks passed (${g_checks})")
        return
    }
    println("envimage: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
