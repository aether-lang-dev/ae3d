// Component kinds (ae3d.component): a kind registered once beside its
// struct, and every component of it read and written by its fields -- what
// the inspector, the scene file, a save and the agent all do.

import std.json
import std.string
import std.observe
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.components
import ae3d.engine
import ae3d.loader
import ae3d.scene
import std.list
import std.fs

// A figure's health, the way a game's script declares it.
struct Health @observable {
    value: float
    max: float
    regenerating: bool
    team: int
    armour: Vec3
    heading: Quat
    label: string
}

health_new() -> ptr {
    h = heap.new(Health)
    h.value = 100.0
    h.max = 100.0
    h.regenerating = true
    h.team = 1
    h.armour = core.vec3(0.2, 0.4, 0.6)
    h.heading = core.quat(0.0, 0.0, 0.0, 1.0)
    h.label = string.copy("survivor")
    return h as ptr
}

health_free(p: ptr) { heap.free(p as *Health) }

health_label(p: ptr) -> string { return (p as *Health).label }
set_health_label(p: ptr, value: string) {
    h = p as *Health
    h.label = core.set_owned(h.label, value)
}

var g_validated = 0
var g_validated_field = 0 - 2

health_validate(p: ptr, field: int) {
    g_validated = g_validated + 1
    g_validated_field = field
}

var g_updates = 0

// What a script does to its own state: a store the registry never sees.
health_update(p: ptr, go: *GameObject, delta: float) {
    h = p as *Health
    h.value = h.value - 1.0
    g_updates = g_updates + 1
}

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

register_health() -> *ComponentKind {
    k = component.kind("Health", "Gameplay", health_new, health_free)
    component.float_field(k, "value", offsetof(Health, value), 0.0, 1000.0)
    component.float_field(k, "max", offsetof(Health, max), 1.0, 1000.0)
    component.bool_field(k, "regenerating", offsetof(Health, regenerating))
    team = component.enum_field(k, "team", offsetof(Health, team))
    component.enum_choice_add(team, "none")
    component.enum_choice_add(team, "survivors")
    component.enum_choice_add(team, "horde")
    component.color_field(k, "armour", offsetof(Health, armour))
    component.rotation_field(k, "heading", offsetof(Health, heading))
    component.text_field(k, "label", health_label, set_health_label)
    component.set_validate(k, health_validate)
    component.set_observable(k, true)
    component.set_unique(k, true)
    component.phases(k, null, health_update, null, null)
    return k
}

// The engine's own kinds: views over its structs, so what the registry
// writes is what is drawn.
builtins() {
    cube = loader.cube(1.0)
    go = behaviour.object_new("Cube")
    behaviour.object_set_model(go, cube)
    components.attach_builtins(go)
    check("a drawn object has a transform, a renderer and a material, in that order",
          behaviour.object_component_count(go) == 3 &&
          component.kind_of(behaviour.object_component(go, 0)) == components.transform_kind() &&
          component.kind_of(behaviour.object_component(go, 2)) == components.material_kind())

    t = components.transform_of(go)
    tk = components.transform_kind()
    component.set_vec3(t, component.field_named(tk, "position"), core.vec3(3.0, 4.0, 5.0))
    check("the transform's position is the model's", near(cube.position.x, 3.0) && near(cube.position.z, 5.0))
    check("and moving it moved the model's matrix", near(cube.model_matrix.m12, 3.0) && near(cube.model_matrix.m14, 5.0))

    mat = component.find(go, components.material_kind())
    mk = components.material_kind()
    component.set_text(mat, component.field_named(mk, "texture"), "resources/obj/Earth/Albedo.jpg")
    check("a texture set through the material is the model's, and marked for the renderer to load",
          string.equals(core.text(cube.material.texture_path), "resources/obj/Earth/Albedo.jpg") == 1 && cube.material.texture_stale)

    lamp = core.light_point(core.vec3(0.0, 0.0, 0.0), core.vec3(1.0, 0.9, 0.8), 2.0, 40.0)
    holder = behaviour.object_new("Lamp")
    lc = components.attach_light(holder, lamp, true)
    lk = components.light_kind()
    check("a light's range reads back in metres", near(component.get_float(lc, component.field_named(lk, "range")), 40.0))
    component.set_float(lc, component.field_named(lk, "range"), 25.0)
    check("and set in metres is the attenuation's", near(core.light_range(lamp), 25.0))
    component.set_int(lc, component.field_named(lk, "type"), core.MODE_SPOT)
    component.set_float(lc, component.field_named(lk, "outer angle"), 40.0)
    component.set_float(lc, component.field_named(lk, "inner angle"), 25.0)
    check("a spot's cone is set in degrees", near(core.light_outer_degrees(lamp), 40.0) && near(core.light_inner_degrees(lamp), 25.0))
    lj = component.to_json(lc, false)
    check("a light is written with its kind by name", string.equals(json.get_string_raw(json.object_get_raw(lj, "type")), "spot") == 1)
    json.free(lj)

    behaviour.object_free(go)
    behaviour.object_free(holder)
    core.model_free(cube)
}

// The scene is an object too: its own components, run before any object's,
// never listed with them.
var g_root_order = ""

root_update(p: ptr, go: *GameObject, delta: float) { g_root_order = "${g_root_order}root " }
object_update(p: ptr, go: *GameObject, delta: float) { g_root_order = "${g_root_order}object " }

scene_root() {
    scene = behaviour.scene_new()
    root = behaviour.scene_root(scene)
    check("a scene has a root named Scene", root != null && string.equals(root.name, "Scene") == 1)
    thing = behaviour.object_new("Thing")
    behaviour.scene_add(scene, thing)
    behaviour.object_add_script(thing, "Mover", null, null, object_update)
    behaviour.object_add_script(root, "Rules", null, null, root_update)
    behaviour.scene_update(scene, 0.016)
    check("the root is not one of the scene's objects", behaviour.scene_count(scene) == 1 && behaviour.scene_find(scene, "Scene") == null)
    check("its components run before any object's (${g_root_order})", string.equals(g_root_order, "root object ") == 1)

    // The engine's settings, as the scene's components.
    settings = engine.engine_defaults()
    env = component.attach_state(root, engine.environment_kind(), settings as ptr, false)
    ek = engine.environment_kind()
    component.set_bool(env, component.field_named(ek, "fog"), true)
    component.set_float(env, component.field_named(ek, "fog end"), 250.0)
    check("the fog set on the Environment is the engine's", settings.fog.enabled && near(settings.fog.end, 250.0))
    rendering = component.attach_state(root, engine.rendering_kind(), settings as ptr, false)
    rk = engine.rendering_kind()
    check("Rendering starts where a new engine does: shadows on", component.get_bool(rendering, component.field_named(rk, "shadows")))
    component.set_float(rendering, component.field_named(rk, "occlusion radius"), 5.5)
    check("and writes into the engine", near(settings.ssao_radius, 5.5))
    env_json = component.to_json(env, true)
    check("a scene's environment is saved as what differs: the fog (${json.object_size_raw(env_json)})",
          json.object_size_raw(env_json) == 2)
    json.free(env_json)
    component.set_float(env, component.field_named(ek, "time of day"), 9.5)
    check("an hour set while the sun does not draw the sky is kept, and the sun stays off",
          settings.time_of_day < 0.0 && near(component.get_float(env, component.field_named(ek, "time of day")), 9.5))
    component.set_bool(env, component.field_named(ek, "sun by time"), true)
    check("switched on, the sun stands at the hour kept", near(settings.time_of_day, 9.5))
    component.set_bool(env, component.field_named(ek, "sun by time"), false)
    check("and switched off again the hour stays for next time", settings.time_of_day < 0.0 &&
          near(component.get_float(env, component.field_named(ek, "time of day")), 9.5))

    behaviour.scene_free(scene)
    engine.engine_defaults_free(settings)
}

// A component that owns its state goes through the scene file and comes
// back on the object it was on; one of a kind the program does not have is
// kept, not lost.
scene_file(k: *ComponentKind) {
    path = "build/test_components_scene.json"
    meshes = "build/test_components_scene_meshes/"
    fs.fs_mkdir_p_raw(meshes)
    world = behaviour.scene_new()
    crate = behaviour.object_new("Crate")
    cube = loader.cube(1.0)
    core.model_set_name(cube, "Crate")
    behaviour.object_set_model(crate, cube)
    crate.owns_model = true
    behaviour.scene_add(world, crate)
    components.attach_builtins(crate)
    h = component.add(crate, k)
    component.set_float(h, component.field_named(k, "value"), 12.5)
    component.set_text(h, component.field_named(k, "label"), "saved")
    behaviour.component_set_enabled(h, false)
    rules = component.add(behaviour.scene_root(world), k)
    component.set_int(rules, component.field_named(k, "team"), 2)

    owned = component.saved_for(world)
    check("only components that own their state are the file's (${list.size(owned)})", list.size(owned) == 2)
    models = list.new()
    list.add_raw(models, cube)
    ok = scene.scene_save(models, null, null, null, owned, path, meshes)
    scene.saved_components_free(owned)
    check("the scene is written", ok)

    loaded = scene.scene_load(path)
    carried = scene.scene_load_components(path)
    check("both come back from the file", list.size(carried) == 2)
    again = behaviour.scene_new()
    copy = behaviour.object_new("Crate")
    behaviour.object_set_model(copy, list.get_raw(loaded, 0) as *Model)
    copy.owns_model = true
    behaviour.scene_add(again, copy)
    objects = list.new()
    list.add_raw(objects, copy)
    unresolved = component.attach_loaded(again, objects, carried)
    back = component.find(copy, k)
    check("the object's component is back with its fields",
          back != null && near(component.get_float(back, component.field_named(k, "value")), 12.5) &&
          string.equals(component.get_text(back, component.field_named(k, "label")), "saved") == 1)
    check("and disabled, as it was", back != null && !behaviour.component_enabled(back))
    root_back = component.find(behaviour.scene_root(again), k)
    check("the scene's own component is back on the scene", root_back != null &&
          component.get_int(root_back, component.field_named(k, "team")) == 2)
    check("nothing was left unresolved", list.size(unresolved) == 0)
    scene.saved_components_free(unresolved)
    scene.loaded_components_free(carried)

    // A kind the loading program has not got: kept, to be written back.
    stranger = json.obj()
    json.object_set_raw(stranger, "kind", json.str("Jetpack"))
    json.object_set_raw(stranger, "enabled", json.boolean(true))
    fuel = json.obj()
    json.object_set_raw(fuel, "fuel", json.num(0.75))
    json.object_set_raw(stranger, "fields", fuel)
    foreign = list.new()
    list.add_raw(foreign, scene.saved_component_new(cube, stranger))
    scene.scene_save(models, null, null, null, foreign, path, meshes)
    scene.saved_components_free(foreign)
    carried = scene.scene_load_components(path)
    unresolved = component.attach_loaded(again, objects, carried)
    check("a component of a kind this program lacks is kept to be written back",
          list.size(unresolved) == 1 && string.contains(component.last_error(), "kept") == 1)
    scene.saved_components_free(unresolved)
    scene.loaded_components_free(carried)

    list.free(objects)
    list.free(loaded)
    list.free(models)
    behaviour.scene_free(again)
    behaviour.scene_free(world)
}

main() {
    k = register_health()
    check("registering twice answers the same kind", component.kind("Health", "Gameplay", health_new, health_free) == k)
    check("the kind is found by name", component.kind_find("Health") == k)
    check("an unknown kind is not", component.kind_find("Nothing") == null)
    check("seven fields, in order", component.field_count(k) == 7 && string.equals(component.field_at(k, 3).name, "team") == 1)

    go = behaviour.object_new("Survivor")
    c = component.add(go, k)
    check("a component of the kind is added", c != null && component.kind_of(c) == k)
    check("it has its own state, with the constructor's defaults",
          c.state != k.defaults && near(component.get_float(c, component.field_named(k, "value")), 100.0))
    check("a second on the same object is refused, it is one per object", component.add(go, k) == null)

    value = component.field_named(k, "value")
    component.set_float(c, value, 1500.0)
    check("a float is held to its range", near(component.get_float(c, value), 1000.0))
    check("the kind's validate is told which field changed", g_validated_field == 0)
    component.set_float(c, value, 42.5)
    check("and reads back what was written", near((c.state as *Health).value, 42.5))

    team = component.field_named(k, "team")
    component.set_int(c, team, 2)
    check("an enum reads as its choice", string.equals(component.enum_choice(team, component.get_int(c, team)), "horde") == 1)

    armour = component.field_named(k, "armour")
    component.set_vec3(c, armour, core.vec3(0.9, 1.5, 0.0 - 1.0))
    a = component.get_vec3(c, armour)
    check("a colour is held to 0..1 per channel", near(a.x, 0.9) && near(a.y, 1.0) && near(a.z, 0.0))

    heading = component.field_named(k, "heading")
    component.set_rotation(c, heading, core.quat(0.0, 2.0, 0.0, 2.0))
    q = component.get_rotation(c, heading)
    check("a rotation is stored normalised", near(q.y, 0.7071067811865476) && near(q.w, 0.7071067811865476))

    label = component.field_named(k, "label")
    component.set_text(c, label, "the last one")
    check("text goes through the kind's own accessors", string.equals(component.get_text(c, label), "the last one") == 1)

    regenerating = component.field_named(k, "regenerating")
    component.set_bool(c, regenerating, false)
    check("a bool is written and read", !component.get_bool(c, regenerating))

    // The scene file and a save.
    full = component.to_json(c, false)
    check("every field is written by name", json.object_size_raw(full) == 7)
    changed_only = component.to_json(c, true)
    // value, regenerating, team, armour, heading and label differ; max does not.
    check("a save writes only what differs from the defaults (${json.object_size_raw(changed_only)})",
          json.object_size_raw(changed_only) == 6 && json.object_get_raw(changed_only, "max") == null)

    other = behaviour.object_new("Copy")
    loaded = component.add_with(other, k, full)
    check("a component read back from its JSON has every field",
          near(component.get_float(loaded, value), 42.5) && component.get_int(loaded, team) == 2 &&
          !component.get_bool(loaded, regenerating) &&
          string.equals(component.get_text(loaded, label), "the last one") == 1)
    lq = component.get_rotation(loaded, heading)
    check("its rotation too", near(lq.y, 0.7071067811865476))
    json.free(full)
    json.free(changed_only)

    // A file from before a field existed, and one naming a field that is gone.
    old = json.obj()
    json.object_set_raw(old, "value", json.num(12.0))
    json.object_set_raw(old, "retired", json.boolean(true))
    json.object_set_raw(old, "team", json.str("nobody"))
    third = behaviour.object_new("Old save")
    oc = component.add(third, k)
    unknown = component.from_json(oc, old)
    check("a name the kind no longer has is counted, not read (${unknown})", unknown == 1)
    check("fields the file does not name keep their defaults", near(component.get_float(oc, component.field_named(k, "max")), 100.0))
    check("a choice the kind does not offer leaves the value", component.get_int(oc, team) == 1)
    check("and what it names is read", near(component.get_float(oc, value), 12.0))
    json.free(old)

    component.reset(c)
    check("reset puts every field back",
          near(component.get_float(c, value), 100.0) && component.get_int(c, team) == 1 &&
          string.equals(component.get_text(c, label), "survivor") == 1)
    check("and differs sees nothing changed", !component.differs(c, value) && !component.differs(c, label))

    component.copy_fields(oc, loaded)
    check("copy_fields makes one component the other's", near(component.get_float(oc, value), 42.5) &&
          string.equals(component.get_text(oc, label), "the last one") == 1)

    // A script's own store on an @observable state is a change too.
    before = component.version(c)
    scene = behaviour.scene_new()
    behaviour.scene_add(scene, go)
    behaviour.scene_update(scene, 0.016)
    check("the script ran on the state the component owns", g_updates == 1 && near((c.state as *Health).value, 99.0))
    check("and its own store bumped the version (${before} to ${component.version(c)})", component.version(c) > before)
    check("the state is observed while the component lives", observe.observer_count(c.state) == 1)

    // Freed with the object: its state, its observer.
    held = c.state
    behaviour.scene_free(scene)
    check("freeing the object took the observer off its state", observe.observer_count(held) == 0)
    behaviour.object_free(other)
    behaviour.object_free(third)

    // Added and freed a thousand times: nothing kept.
    i = 0
    while i < 1000 {
        o = behaviour.object_new("Churn")
        component.add(o, k)
        behaviour.object_free(o)
        i = i + 1
    }
    check("a thousand components added and freed", true)
    builtins()
    scene_root()
    scene_file(k)

    // What was built from a kind's fields (the inspector's rows) is stale
    // once the kind changes; the generation says when it did.
    before = component.generation()
    component.float_field(k, "stamina", offsetof(Health, max), 1.0, 1000.0)
    check("a field added moves the registry's generation", component.generation() > before)
    before = component.generation()
    component.kind_redefine(k, health_new, health_free)
    check("a kind redefined moves it too, and starts with no fields",
          component.generation() > before && component.field_count(k) == 0)
    before = component.generation()
    component.kinds_clear()
    check("the registry empties", component.kind_count() == 0)
    check("and emptying it moves the generation", component.generation() > before)

    if g_failures == 0 {
        println("test_components: all checks passed (${g_checks})")
    } else {
        println("test_components: ${g_failures} failure(s) of ${g_checks}")
    }
}
