// ci: optimised -- seeded knockdowns under a car, CPU work -O0 makes several times slower
// A car over a person struck down (#982): the plaza's car, 1.2 t on four
// sprung wheels, driven at a figure lying on the ground and braked over it,
// and the figure got up while the car stands over it. The UE5 mannequin
// made a character (ae3d.character) with its physanim bodies, knocked down
// as test_knockdowns knocks it (the full ragdoll, LIMP), at rest, then:
//
//   - run over: the car comes at CAR_SPEED along x across where the body
//     lies, offset across its lane by the seed, and brakes once its nose is
//     past the pelvis by the seed's share of its length, so it stops with
//     the body under its wheels, its box or between them;
//   - got up under it: the car stands over the body six seconds and the
//     figure is told to get up (character.get_up), then the car is taken
//     away as the plaza's is. A car over it, the get-up waits
//     (character.get_up_waiting), past its WAIT_MOST; gone, it gets up;
//   - put past a crate: a figure standing, its hips and legs kinematic on
//     its animation, put 1.3 m to its side in a step past a 200 kg crate,
//     as the plaza's mover put a capsule out of the car (physics
//     KINEMATIC_TELEPORT): its bodies put there, the crate left standing.
//
// Held to, over the seeds (worst printed, with its seed): nothing leaves
// the ground faster than the car came: the car's chassis never going up
// faster than CAR_SPEED nor rising more than RISE_MOST over its ride
// height, no body of the figure going up faster than CAR_SPEED nor higher
// than HIGH_MOST; the get-up up every time once the car is gone; the crate
// no faster than a walk. In the plaza (seeds 2 and 5 of ten, 4,800 steps),
// a person got up beside or under the car where it stood: its capsule,
// stood up into the car, was pushed out 0.85 to 1.3 m in a step, its
// kinematic hips and legs went after it at 48 to 75 m/s, and the car was
// thrown 12 m up at 45 m/s. Before the fixes, here: a body up at 12.7 m/s
// and the car lifted 0.65 m by the figure standing up through it (16.3 and
// 0.67 over 64 seeds).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.physanim
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const GET_UP = "LayToIdle"
const SEEDS = 8                      // seeded knockdowns a case (AE3D_SEEDS for another count)
const DOWN_MOST = 600                // steps it may take to come to rest
const BLEND = 0.4

// The plaza's car (tools/plaza_showcase.ae).
const CAR_SPEED = 7.0
const CAR_HALF_X = 2.0               // its length, along its own z
const CAR_HALF_Z = 0.9
const CAR_HALF_Y = 0.55
const CAR_CLEAR = 0.3
const CAR_DENSITY = 150.0
const WHEEL_R = 0.32
const AXLE_HALF = 0.8
const AXLE_AHEAD = 1.4
const CAR_TORQUE = 900.0
const CAR_TOP = 9.0
const CAR_STEER = 0.5
const CAR_SPRING = 7.0
const RUN_UP = 6.0                   // m from the body it starts

// The bounds.
const RISE_MOST = 0.5                // m the chassis may rise over its ride height: over a body under a wheel
const HIGH_MOST = 1.9                // m a body of the figure may be over the ground: a person standing
const STAND_STEPS = 360              // steps the car stands over the figure getting up

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

hashed(seed: int, salt: int) -> float {
    h = (seed * 73856093 + salt * 19349663 + 83492791) % 1000003
    if h < 0 { h = 0 - h }
    return (h as float) / 1000003.0
}

struct Scene {
    engine: ptr                      // *Engine
    person: ptr                      // *Character
    vehicle: ptr                     // *Vehicle
    wheels: ptr                      // *GameObject[WHEEL_COUNT]
    car_up: float                    // the chassis's fastest up, m/s
    car_rise: float                  // its most over its ride height, m
    body_up: float                   // the figure's bodies' fastest up, m/s
    body_high: float                 // their highest, m
    waited: int                      // steps get_up waited while the car stood
    waited_off: int                  // and once it drove off
    risen: bool                      // got up in the end
}

car_mount(k: int) -> Vec3 {
    across = AXLE_HALF
    if k % 2 == 0 { across = 0.0 - AXLE_HALF }
    along = AXLE_AHEAD
    if k < 2 { along = 0.0 - AXLE_AHEAD }
    return core.vec3(across, WHEEL_R - CAR_CLEAR - CAR_HALF_Y, along)
}

// The car's nose (-z) along +x.
car_facing() -> Quat { return core.quat_rotate(0.0 - 1.5707963, core.vec3(0.0, 1.0, 0.0)) }

// A floor, the mannequin on it with its bodies and get-up, and the car off
// to the side, still.
scene_new(g: *Gaits) -> *Scene {
    s = calloc(1, sizeof(Scene)) as *Scene
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Knocked", MANNEQUIN, g)
    s.engine = e as ptr
    if c == null { return s }
    character.physical(c)
    _added = character.get_up_add(c, GET_UP)
    s.person = c as ptr
    at = core.vec3(0.0 - 30.0, CAR_CLEAR + CAR_HALF_Y, 0.0)
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_position(car, at)
    behaviour.object_set_rotation(car, car_facing())
    physics.rigidbody(car, physics.DYNAMIC)
    physics.box_collider(car, core.vec3(CAR_HALF_Z, CAR_HALF_Y, CAR_HALF_X), physics.material(0.6, 0.0), CAR_DENSITY)
    s.wheels = calloc(physics.WHEEL_COUNT, 8)
    wheels = s.wheels as ptr[]
    mounts_block = calloc(physics.WHEEL_COUNT, sizeof(Vec3))
    mounts = mounts_block as Vec3[]
    k = 0
    while k < physics.WHEEL_COUNT {
        mounts[k] = car_mount(k)
        wheel = engine.object(e, "Wheel", loader.sphere(WHEEL_R, 16, 8))
        behaviour.object_set_position(wheel, core.v3_add(at, core.quat_apply(car_facing(), mounts[k])))
        physics.rigidbody(wheel, physics.DYNAMIC)
        physics.sphere_collider(wheel, WHEEL_R, physics.material(1.1, 0.0), 250.0)
        wheels[k] = wheel as ptr
        k = k + 1
    }
    s.vehicle = physics.vehicle(car, s.wheels, mounts_block, CAR_SPRING, 0.8, 0.12, CAR_TORQUE, CAR_TOP / WHEEL_R, CAR_STEER) as ptr
    free(mounts_block)
    physics.physics_set_travel_speculation(physics.of(e), true)
    return s
}

scene_free(s: *Scene) {
    e = s.engine as *Engine
    if s.person != null { character.character_free(s.person as *Character) }
    if s.vehicle != null { physics.vehicle_free(s.vehicle as *Vehicle) }
    if s.wheels != null { free(s.wheels) }
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    free(s as ptr)
}

// The car at x, z, rolling along +x at `speed`.
place_car(s: *Scene, x: float, z: float, speed: float) {
    v = s.vehicle as *Vehicle
    at = core.vec3(x, CAR_CLEAR + CAR_HALF_Y, z)
    going = core.vec3(speed, 0.0, 0.0)
    chassis = physics.vehicle_chassis(v)
    physics.rigidbody_place(chassis, at, car_facing())
    physics.rigidbody_set_velocity(chassis, going)
    dynamics.body_set_angular_velocity(chassis.body_id, core.vec3(0.0, 0.0, 0.0))
    spin = core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), going), 1.0 / WHEEL_R)
    k = 0
    while k < physics.WHEEL_COUNT {
        wheel = physics.vehicle_wheel(v, k)
        physics.rigidbody_place(wheel, core.v3_add(at, core.quat_apply(car_facing(), car_mount(k))), car_facing())
        physics.rigidbody_set_velocity(wheel, going)
        dynamics.body_set_angular_velocity(wheel.body_id, spin)
        k = k + 1
    }
}

// The car gone, as the plaza takes it away once it has stood: out of the
// world, far off. Driven off, it dragged the body caught under it along.
park(s: *Scene) {
    v = s.vehicle as *Vehicle
    away = core.vec3(0.0 - 40.0, CAR_CLEAR + CAR_HALF_Y, 0.0)
    chassis = physics.vehicle_chassis(v)
    physics.rigidbody_place(chassis, away, car_facing())
    dynamics.body_disable(chassis.body_id)
    k = 0
    while k < physics.WHEEL_COUNT {
        wheel = physics.vehicle_wheel(v, k)
        physics.rigidbody_place(wheel, core.v3_add(away, core.quat_apply(car_facing(), car_mount(k))), car_facing())
        dynamics.body_disable(wheel.body_id)
        k = k + 1
    }
}

// A step, and what went up: the chassis and the figure's bodies.
step(s: *Scene) {
    engine.engine_update(s.engine as *Engine, STEP)
    chassis = physics.rigidbody_body(physics.vehicle_chassis(s.vehicle as *Vehicle))
    v = dynamics.body_get_linear_velocity(chassis)
    rise = dynamics.body_get_position(chassis).y - (CAR_CLEAR + CAR_HALF_Y)
    if v.y > s.car_up { s.car_up = v.y }
    if rise > s.car_rise { s.car_rise = rise }
    r = physanim.ragdoll_of(character.physanim_of(s.person as *Character))
    h = physics.ragdoll_human(r)
    b = 0
    while b < physics.ragdoll_bone_count(r) {
        id = human.bone_at(h, b).body_id
        up = dynamics.body_get_linear_velocity(id).y
        y = dynamics.body_get_position(id).y
        if up > s.body_up { s.body_up = up }
        if y > s.body_high { s.body_high = y }
        b = b + 1
    }
}

// Struck down as test_knockdowns strikes (the full ragdoll, LIMP, a blow on
// the chest from the seed's side), and lying at rest: its motion, null when
// it never came to rest.
knock(s: *Scene, seed: int) -> *Motion {
    e = s.engine as *Engine
    c = s.person as *Character
    k = 0
    while k < 30 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    pa = character.physanim_of(c)
    character.pause(c)
    animator.pause(character.animator_of(c))
    physanim.release(pa)
    rag = physanim.ragdoll_of(pa)
    m = motion.active_ragdoll(rag)
    if m == null { return null }
    motion.attach(e, m)
    motion.set_mode(m, motion.LIMP)
    body = physanim.bone_named(pa, "Chest")
    side = hashed(seed, 1) * 6.2831853
    way = core.vec3(core.sin_of(side), 0.15, core.cos_of(side))
    physics.ragdoll_apply_impulse(rag, body, core.v3_mul(way, 60.0 + hashed(seed, 2) * 40.0), behaviour.object_position(physics.ragdoll_bone(rag, body)))
    k = 0
    while k < DOWN_MOST {
        engine.engine_update(e, STEP)
        if k > 30 && motion.down(m) { return m }
        k = k + 1
    }
    return null
}

// The car driven over the body: from RUN_UP back, offset across by the seed,
// braked once its nose is past the pelvis by the seed's share of its length,
// and stood for two seconds. With `rise`, the figure got up once the car
// stands, and the car stood on over it while it does.
over(g: *Gaits, seed: int, rise: bool) -> *Scene {
    s = scene_new(g)
    if s.person == null { return s }
    m = knock(s, seed)
    if m == null {
        s.body_up = 1000.0
        return s
    }
    r = physanim.ragdoll_of(character.physanim_of(s.person as *Character))
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    across = (hashed(seed, 3) * 2.0 - 1.0) * (CAR_HALF_Z + 0.2)
    past = hashed(seed, 4) * 2.0 * CAR_HALF_X
    place_car(s, pelvis.x - RUN_UP, pelvis.z + across, CAR_SPEED)
    v = s.vehicle as *Vehicle
    braking = false
    stood = 0
    k = 0
    while k < 600 && stood < 120 {
        nose = dynamics.body_get_position(physics.rigidbody_body(physics.vehicle_chassis(v))).x + CAR_HALF_X
        if nose > pelvis.x + past { braking = true }
        if braking { physics.vehicle_drive(v, 0.0, 0.0, 1.0) } else { physics.vehicle_drive(v, 0.3, 0.0, 0.0) }
        if braking && core.abs_of(physics.vehicle_speed(v)) < 0.05 { stood = stood + 1 }
        step(s)
        k = k + 1
    }
    if !rise {
        motion.release(m)
        return s
    }
    // Told to get up once, as the plaza tells it: it waits while the car
    // stands, then while it drives off, then gets on its feet.
    c = s.person as *Character
    state = character.get_up(c, m, BLEND)
    k = 0
    while k < STAND_STEPS + 240 {
        if character.get_up_waiting(c) {
            if k < STAND_STEPS { s.waited = s.waited + 1 } else { s.waited_off = s.waited_off + 1 }
        }
        if k < STAND_STEPS { physics.vehicle_drive(v, 0.0, 0.0, 1.0) }
        if k == STAND_STEPS { park(s) }
        step(s)
        k = k + 1
    }
    s.risen = state >= 0 && !character.get_up_waiting(c)
    if core.env_int("AE3D_CAR_TRACE", 0) == 1 {
        car = dynamics.body_get_position(physics.rigidbody_body(physics.vehicle_chassis(v)))
        pelvis_now = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
        println("    seed ${seed}: the car at ${car.x} ${car.y} ${car.z}, the pelvis at ${pelvis_now.x} ${pelvis_now.y} ${pelvis_now.z} (lay at ${pelvis.x} ${pelvis.z})")
    }
    if character.get_up_waiting(c) { motion.release(m) }
    return s
}

// A figure standing on its animation, its hips and legs kinematic
// (physanim), put 1.3 m to its side in a step past a crate standing beside
// it, as the mover put the plaza's capsule out of the car: its bodies are
// put there with it, not swept through the crate at 78 m/s. The crate's
// fastest after, m/s, and the bodies' fastest up.
put_past(g: *Gaits) -> (float, float) {
    s = scene_new(g)
    if s.person == null { return 1000.0, 1000.0 }
    e = s.engine as *Engine
    c = s.person as *Character
    o = character.object_of(c)
    crate = engine.object(e, "Crate", loader.cube(1.0))
    behaviour.object_set_position(crate, core.vec3(0.65, 0.5, 0.0))
    crate_rb = physics.rigidbody(crate, physics.DYNAMIC)
    physics.box_collider(crate, core.vec3(0.15, 0.5, 0.4), physics.material(0.6, 0.0), 200.0)
    k = 0
    while k < 30 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        step(s)
        k = k + 1
    }
    s.body_up = 0.0
    at = behaviour.object_position(o)
    character.resume(c, core.vec3(at.x + 1.3, at.y, at.z), core.vec3(0.0, 0.0, 0.0))
    fastest = 0.0
    k = 0
    while k < 60 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        step(s)
        v = core.v3_len(physics.rigidbody_velocity(crate_rb))
        if v > fastest { fastest = v }
        if core.env_int("AE3D_CAR_TRACE", 0) == 1 {
            r = physanim.ragdoll_of(character.physanim_of(c))
            pel = dynamics.body_get_position(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).body_id)
            cv = physics.rigidbody_velocity(crate_rb)
            ca = behaviour.object_position(crate)
            line = "    put ${k}: crate ${cv.x} ${cv.y} ${cv.z} at ${ca.x} ${ca.y} ${ca.z}, object ${behaviour.object_position(o).x}, pelvis body ${pel.x};"
            b = 0
            while b < physics.ragdoll_bone_count(r) {
                id = human.bone_at(physics.ragdoll_human(r), b).body_id
                line = "${line} ${b}: ${dynamics.body_get_position(id).x} ${dynamics.body_get_position(id).y} v ${dynamics.body_get_linear_velocity(id).x}"
                b = b + 1
            }
            println(line)
        }
        k = k + 1
    }
    up = s.body_up
    scene_free(s)
    return fastest, up
}

main() {
    println("test_car_over_body")
    g = character.gaits(GAITS)
    seeds = core.env_int("AE3D_SEEDS", SEEDS)
    first = core.env_int("AE3D_SEED", 0)
    trace = core.env_int("AE3D_CAR_TRACE", 0) == 1
    crate, up = put_past(g)
    println("  put past a crate: the crate at ${crate} m/s at most after, a body up at ${up} m/s")
    check("put 1.3 m past a crate in a step: the crate goes no faster than a person walks (${crate} m/s)", crate < 1.5)
    check("put 1.3 m past a crate in a step: no body goes up faster than the car came (${up} m/s)", up < CAR_SPEED)
    c = 0
    while c < 2 {
        rise = c == 1
        name = "run over"
        if rise { name = "got up under it" }
        car_up = 0.0
        car_up_seed = 0 - 1
        car_rise = 0.0
        car_rise_seed = 0 - 1
        body_up = 0.0
        body_up_seed = 0 - 1
        body_high = 0.0
        body_high_seed = 0 - 1
        waits = 0                    // seeds the get-up waited for the car
        never = 0                    // seeds it never got up
        n = 0
        while n < seeds {
            seed = first + n
            s = over(g, seed, rise)
            if s.person == null {
                println("  no character: ${character.error()}")
                exit(1)
            }
            if trace { println("  ${name} seed ${seed}: car up ${s.car_up} m/s, risen ${s.car_rise} m; a body up ${s.body_up} m/s, ${s.body_high} m high; waited ${s.waited} steps under it, ${s.waited_off} as it drove off; up ${s.risen}") }
            if s.waited > 0 { waits = waits + 1 }
            if rise && !s.risen { never = never + 1 }
            if s.car_up > car_up {
                car_up = s.car_up
                car_up_seed = seed
            }
            if s.car_rise > car_rise {
                car_rise = s.car_rise
                car_rise_seed = seed
            }
            if s.body_up > body_up {
                body_up = s.body_up
                body_up_seed = seed
            }
            if s.body_high > body_high {
                body_high = s.body_high
                body_high_seed = seed
            }
            scene_free(s)
            n = n + 1
        }
        println("  ${name}, ${seeds} seeds: the car up at ${car_up} m/s (seed ${car_up_seed}), risen ${car_rise} m (seed ${car_rise_seed}); a body up at ${body_up} m/s (seed ${body_up_seed}), ${body_high} m high (seed ${body_high_seed})")
        check("${name}: the car goes up no faster than it came (${car_up} m/s, ${CAR_SPEED})", car_up < CAR_SPEED)
        check("${name}: the car rises no more than ${RISE_MOST} m (${car_rise})", car_rise < RISE_MOST)
        check("${name}: no body goes up faster than the car came (${body_up} m/s)", body_up < CAR_SPEED)
        check("${name}: no body higher than ${HIGH_MOST} m (${body_high})", body_high < HIGH_MOST)
        if rise {
            println("  the get-up waited for the car on ${waits} of ${seeds} seeds")
            check("${name}: up every time once the car is gone (${never} never)", never == 0)
        }
        c = c + 1
    }
    character.gaits_free(g)
    if g_failures > 0 {
        println("car over a body: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    // ci.sh passes a suite on the words "all checks passed".
    println("car over a body: all checks passed (${g_checks})")
}
