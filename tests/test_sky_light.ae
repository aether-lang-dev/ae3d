// The sky lights the scene (#655), on both backends, as bright as it is
// drawn. No lamp, no sun: a flat sky -- the clear colour all round, the
// scene having no sky of its own -- and the light it casts.
//
//   - A white matte surface under it shows the sky's own colour: what it
//     takes in from every direction (pi L) it gives back, the diffuse and
//     the four percent its Fresnel reflects together.
//   - A black glossy one shows only its reflection: four percent of the sky,
//     seen head-on.
//   - A darker sky lights it darker, by the same curve.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader

const WIDTH = 160
const HEIGHT = 120

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// Channel `c` of the frame's centre pixel, 0..255.
centre(backend: *Backend, cam: *Camera, light: *Light, c: int) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    return mem.get_byte(pixels, ((HEIGHT / 2) * WIDTH + WIDTH / 2) * 4 + c)
}

near(got: int, want: int, slack: int) -> bool {
    d = got - want
    if d < 0 { d = 0 - d }
    return d <= slack
}

// What light `x` shows as, in the frame's bytes.
shown(x: float) -> int { return (core.displayed_of(x) * 255.0 + 0.5) as int }

// A cube filling the middle of the view, its near face toward the camera.
cube(r: float, g: float, b: float, roughness: float) -> *Model {
    m = loader.cube(1.0)
    core.model_set_scale(m, 8.0, 8.0, 8.0)
    core.model_plastic(m, r, g, b, roughness)
    return m
}

run_checks(backend: *Backend, name: string) {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 20.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    // A key light that gives nothing: the sky is all the light there is.
    dark = core.light_sun(core.vec3(0.0, 1.0, 0.0))
    dark.intensity = 0.0

    core.backend_set_clear_color(backend, 0.6, 0.6, 0.6)
    white = cube(1.0, 1.0, 1.0, 0.9)
    core.backend_add_model(backend, white)
    lit = centre(backend, cam, dark, 1)
    println("  ${name}: a white surface under a sky shown at 153 shows ${lit}")
    check("${name} a white matte surface under a flat sky shows the sky's colour", near(lit, 153, 4))

    core.backend_set_clear_color(backend, 0.3, 0.3, 0.3)
    dim = centre(backend, cam, dark, 1)
    println("  ${name}: under a sky shown at 77 it shows ${dim}")
    check("${name} a darker sky lights it darker, to its own colour", near(dim, 77, 4))
    core.backend_remove_model(backend, white)
    core.model_free(white)

    core.backend_set_clear_color(backend, 0.6, 0.6, 0.6)
    black = cube(0.0, 0.0, 0.0, 0.05)
    core.backend_add_model(backend, black)
    shine = centre(backend, cam, dark, 1)
    sky = core.display_radiance(core.vec3(0.6, 0.6, 0.6)).y
    println("  ${name}: a black glossy surface shows ${shine}; four percent of the sky shows as ${shown(0.04 * sky)}")
    check("${name} a black glossy surface shows four percent of the sky", near(shine, shown(0.04 * sky), 4))
    core.backend_remove_model(backend, black)
    core.model_free(black)

    core.camera_free(cam)
    core.light_free(dark)
}

main() {
    println("sky light: the sky lights the scene")
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("sky light: SKIP no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("sky light: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl")
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vulkan.available() {
        println("sky light: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vulkan.renderer_new()
        vk_pass = vulkan.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("sky light: SKIP Vulkan would not start (${vulkan.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan")
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("sky light: all checks passed")
    } else {
        println("sky light: ${failures} failure(s)")
    }
}
