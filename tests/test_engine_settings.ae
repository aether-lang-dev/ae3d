// What a settings menu reads back (#751): the occlusion, the bloom, FXAA and
// the render scale, each as it was set, on an engine that has not opened a
// window -- the render scale as asked for, which the engine now keeps for
// the device instead of dropping it when there is none yet.
import ae3d.engine

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

main() {
    println("engine settings: read back as set (#751)")
    e = engine.engine_new()
    check("a new engine draws at its full size", engine.engine_render_scale(e) == 1.0)
    engine.engine_set_ssao(e, true, 4.0, 1.0)
    engine.engine_set_post(e, false, true, 1.0, 0.35)
    check("the occlusion reads back on", engine.engine_ssao(e))
    check("the bloom reads back on and FXAA off", engine.engine_bloom(e) && !engine.engine_fxaa(e))
    engine.engine_set_ssao(e, false, 4.0, 1.0)
    engine.engine_set_post(e, true, false, 1.0, 0.35)
    check("and off and on again", !engine.engine_ssao(e) && !engine.engine_bloom(e) && engine.engine_fxaa(e))
    asked = engine.engine_set_render_scale(e, 0.7)
    check("a render scale asked for before the window is kept", asked == 0.7 && engine.engine_render_scale(e) == 0.7)
    engine.engine_free(e)
    if g_failures == 0 {
        println("engine settings: all checks passed")
    } else {
        println("engine settings: ${g_failures} failure(s)")
    }
}
