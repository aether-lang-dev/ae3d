// What a settings menu reads back (#751): the occlusion, the bloom, FXAA and
// the render scale, each as it was set, on an engine that has not opened a
// window -- the render scale as asked for, which the engine now keeps for
// the device instead of dropping it when there is none yet.
import ae3d.engine
extern exit(code: int)

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

main() {
    println("engine settings: read back as set (#751)")
    e = engine.engine_new()
    check("a new engine draws at its full size", engine.engine_render_scale(e) == 1.0)
    engine.engine_set_ssao(e, true, 4.0, 1.0)
    engine.engine_set_post(e, false, true, 1.0, 0.35)
    check("the occlusion reads back on", engine.engine_ssao(e))
    check("the bloom reads back on and FXAA off", engine.engine_bloom(e) && !engine.engine_fxaa(e))
    engine.engine_set_ssao(e, false, 4.0, 1.0)
    engine.engine_set_post(e, true, false, 1.0, 0.35)
    check("and off and on again", !engine.engine_ssao(e) && !engine.engine_bloom(e) && engine.engine_fxaa(e))
    asked = engine.engine_set_render_scale(e, 0.7)
    check("a render scale asked for before the window is kept", asked == 0.7 && engine.engine_render_scale(e) == 0.7)
    // The upscaler beside it (#867): bilinear until asked, read back as set,
    // clamped to the two there are and to 0..1.
    check("a new engine upscales bilinearly", engine.engine_upscaler(e) == engine.UPSCALER_BILINEAR)
    got = engine.engine_set_upscaler(e, engine.UPSCALER_SPATIAL, 0.3)
    check("the spatial upscaler asked for before the window is kept", got == engine.UPSCALER_SPATIAL && engine.engine_upscaler(e) == engine.UPSCALER_SPATIAL && engine.engine_upscale_sharpness(e) == 0.3)
    got = engine.engine_set_upscaler(e, 7, 2.0)
    check("an upscaler past the last is the last, a sharpness past 1 is 1", got == engine.UPSCALER_SPATIAL && engine.engine_upscale_sharpness(e) == 1.0)
    got = engine.engine_set_upscaler(e, 0 - 1, 0.0 - 1.0)
    check("below the first is bilinear and a sharpness of nothing", got == engine.UPSCALER_BILINEAR && engine.engine_upscale_sharpness(e) == 0.0)
    // Depth of field (#870): off until asked, read back as set, the focus kept
    // above nothing and the discs not below it.
    check("a new engine has no depth of field", !engine.engine_depth_of_field(e))
    engine.engine_set_depth_of_field(e, true, 12.5, 20.0, 40.0)
    check("depth of field asked for before the window is kept, its three values with it",
          engine.engine_depth_of_field(e) && engine.engine_dof_focus(e) == 12.5 && engine.engine_dof_aperture(e) == 20.0 &&
          engine.engine_dof_max_radius(e) == 40.0)
    engine.engine_set_depth_of_field(e, true, 0.0 - 3.0, 0.0 - 1.0, 0.0 - 2.0)
    check("a focus of nothing or less is the nearest there is, a negative disc none",
          engine.engine_dof_focus(e) > 0.0 && engine.engine_dof_aperture(e) == 0.0 && engine.engine_dof_max_radius(e) == 0.0)
    engine.engine_set_depth_of_field(e, false, 12.5, 20.0, 40.0)
    check("and off again", !engine.engine_depth_of_field(e))
    // An environment map (#869): none until asked, kept when asked for before
    // the window, and the empty path is the sky.
    check("a new engine has no environment map", engine.engine_environment(e) == "")
    check("a map asked for before the window is kept", engine.engine_set_environment(e, "tests/fixtures/env/flat.hdr", 2.0) &&
          engine.engine_environment(e) == "tests/fixtures/env/flat.hdr")
    check("and the empty path is the sky", engine.engine_set_environment(e, "", 1.0) && engine.engine_environment(e) == "")
    engine.engine_free(e)
    if g_failures == 0 {
        println("engine settings: all checks passed")
    } else {
        println("engine settings: ${g_failures} failure(s)")
        exit(1)
    }
}
