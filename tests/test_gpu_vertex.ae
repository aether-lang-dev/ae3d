// ae3d.gpu's vertex shaders, written with `quote` (step 6, the first item):
// the full-screen pass's, which every quoted pass draws with.
//
//   - screen_vertex comes out as tests/fixtures/gpu/screen.vert for Vulkan
//     and screen_gl.vert for OpenGL 4.1: its attributes at the locations the
//     pipelines give them (position 0, uv 1), its clip position gl_Position,
//     its varying at location 0 named as the pixel shader it feeds names its
//     own; glslang and spirv-val pass it, and take the OpenGL one;
//   - emit_screen_vertex writes it for a pass under the pass's parameter's
//     name (an `uv_in` pass gets an `uv_in` out);
//   - the CPU back end runs it on the quad's four corners: each corner where
//     it is in clip space (z 0, w 1), its texture coordinate handed on;
//   - an attribute the table does not have, and a return that is not a struct
//     literal, are refused, naming why.
//
// On a GPU every quoted pass draws with it: tests/test_backend_parity and
// every suite. AE3D_GPU_WRITE_GOLDEN=1 writes the fixtures.
import std.os
import std.fs
import std.file
import std.list
import std.string
import std.heap
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader, vertex, fragment)
import ae3d.shaderlib (vec2, vec3, vec4)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }

// glslang -V over `text` (as `stage`), then spirv-val; or, for desktop
// OpenGL's GLSL (`opengl`), glslang's check of it. Skipped where they are
// not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the fixture at `path`; AE3D_GPU_WRITE_GOLDEN=1 writes it.
golden_is(text: string, path: string) {
    if os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    golden, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == golden)
    if text != golden {
        println("--- emitted ---")
        println(text)
    }
}


// A vertex with an attribute no pipeline feeds.
struct OddVertex {
    position: vec3
    tangent: vec3
}
struct OddVaryings {
    position: vec4
}
odd_attribute() -> *GpuShader {
    return vertex("odd") quote | v: OddVertex | {
        return OddVaryings { position: vec4(v.tangent, 1.0) }
    }
}

// A vertex shader that returns a vector, not its varyings.
bare_return() -> *GpuShader {
    return vertex("bare") quote | v: OddVertex | {
        return vec4(v.position, 1.0)
    }
}

// A pass whose varying is not called uv.
named_pass() -> *GpuShader {
    return fragment("named") quote | uv_in: vec2 | {
        return vec4(vec3(uv_in.x, uv_in.y, 0.0), 1.0)
    }
}

main() {
    println("ae3d.gpu: the full-screen vertex shader written with quote")
    vs = gpu.screen_vertex()
    check("a vertex shader", gpu.shader_tree(vs) as ptr != null)
    vk = gpu.emit_vertex_glsl(vs, gpu.VULKAN, "", "")
    if vk == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(vk, "tests/fixtures/gpu/screen.vert")
    check("its attributes at the pipelines' locations, its position gl_Position",
          string.contains(vk, "layout(location = 0) in vec3 inPosition;") != 0 &&
          string.contains(vk, "layout(location = 1) in vec2 inTexCoord;") != 0 &&
          string.contains(vk, "layout(location = 0) out vec2 uv;") != 0 &&
          string.contains(vk, "gl_Position = vec4(vec3(inPosition.x, inPosition.y, 0.0), 1.0);") != 0)
    compiles("screen", vk, "vert", false)
    gl = gpu.emit_vertex_glsl(vs, gpu.GL, "", "")
    golden_is(gl, "tests/fixtures/gpu/screen_gl.vert")
    compiles("screen_gl", gl, "vert", true)

    named = named_pass()
    nv = gpu.emit_screen_vertex(named, gpu.VULKAN)
    check("for a pass, its varying under the pass's own name",
          string.contains(nv, "layout(location = 0) out vec2 uv_in;") != 0 && string.contains(nv, "uv_in = inTexCoord;") != 0)
    gpu.shader_free(named)

    // The quad's corners on the CPU.
    cx = gpu.cpu_new(vs)
    right = 0
    c = 0
    while c < 4 {
        x = -1.0
        y = -1.0
        if c == 1 || c == 2 { x = 1.0 }
        if c >= 2 { y = 1.0 }
        p = gpu.v3(x, y, 0.5)
        uv = gpu.v2((x + 1.0) * 0.5, (y + 1.0) * 0.5)
        gpu.cpu_vertex_attr(cx, "position", p)
        gpu.cpu_vertex_attr(cx, "uv", uv)
        ran = gpu.cpu_run_vertex(cx)
        if !ran { println("  cpu_run_vertex: ${gpu.last_error()}") }
        pos = gpu.cpu_varying(cx, "position")
        out_uv = gpu.cpu_varying(cx, "uv")
        if ran && pos != null && out_uv != null && gpu.val_n(pos) == 4 && gpu.val_x(pos) == x && gpu.val_y(pos) == y &&
           gpu.val_z(pos) == 0.0 && gpu.val_w(pos) == 1.0 && gpu.val_x(out_uv) == (x + 1.0) * 0.5 &&
           gpu.val_y(out_uv) == (y + 1.0) * 0.5 {
            right = right + 1
        }
        heap.free(p)
        heap.free(uv)
        c = c + 1
    }
    check("the CPU puts each of the quad's corners where it is and hands its uv on (${right} of 4)", right == 4)
    gpu.cpu_free(cx)

    odd = odd_attribute()
    ot = gpu.emit_vertex_glsl(odd, gpu.VULKAN, "", "")
    check("an attribute the table has not is refused (${gpu.last_error()})",
          ot == "" && string.contains(gpu.last_error(), "tangent is not a vertex attribute") != 0)
    gpu.shader_free(odd)
    bare = bare_return()
    bt = gpu.emit_vertex_glsl(bare, gpu.VULKAN, "", "")
    check("a return that is not a struct literal is refused (${gpu.last_error()})",
          bt == "" && string.contains(gpu.last_error(), "struct literal") != 0)
    gpu.shader_free(bare)

    if g_failures > 0 {
        println("vertex: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("vertex: all checks passed (${g_checks})")
}
