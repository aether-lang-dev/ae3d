// The camera framing what it is shown (#471), held to numbers: every glTF
// file in the repository -- the fixture's box man, the Khronos fox (a
// hundred units long), the arm, as a .glb and as a .gltf -- and the box man
// made a giant a hundred times over and a doll a hundredth of himself, each
// framed from a three-quarter view (viewpoint.frame, what engine_frame
// calls). For each:
//
//   - every vertex, where it is drawn, projected through the camera: the
//     model spans 40-70% of the frame's height (55% asked), and all of it
//     is in the frame;
//   - the camera stands outside every model's bounds;
//   - nothing is cut by the near plane or lost past the far one;
//   - and the frame itself, drawn through OpenGL and Vulkan off the screen
//     as normals over black, has the model's rows where the numbers put
//     them, within three pixels -- the framing and the renderer agree on
//     where a skinned, scaled, instanced vertex is.
//
// And the fox as a crowd, instanced over its baked walk, each at its own
// phase: framed by its figures' own poses, drawn, the same.
//
// And a framing that follows: a group of points walking steadily, framed
// every frame eased over a second, stays 40-70% of the height and never
// moves the camera further in a frame than the group moved; the group
// jumping fifty metres, the camera goes after it a frame's share of the
// gap at a time, never cutting.

import std.list
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.gltf
import ae3d.skin
import ae3d.viewpoint
import ae3d.posing

const WIDTH = 320
const HEIGHT = 180
const SHARE = 0.55
const YAW = 0.0 - 115.0
const PITCH = 0.0 - 14.0
const FRAMES = 24

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A glTF file loaded, its roots scaled, its primitives placed: null when
// it would not load.
load_scaled(path: string, scale: float) -> *GltfScene {
    scene = gltf.load(path)
    if scene == null { return null }
    i = 0
    while i < gltf.root_count(scene) {
        root = gltf.root(scene, i)
        core.model_set_scale(root, root.scale.x * scale, root.scale.y * scale, root.scale.z * scale)
        i = i + 1
    }
    i = 0
    while i < gltf.primitive_count(scene) {
        core.model_sync_transform(gltf.primitive(scene, i))
        i = i + 1
    }
    return scene
}

// Where the framed points land: the rows (from the top) and columns their
// projections span, as x = top, y = bottom, z = 1 when every one is inside
// the frame and before the camera.
projected_rows(cam: *Camera, pts: *Points) -> Vec3 {
    top = 1000000.0
    bottom = 0.0 - 1000000.0
    inside = 1.0
    i = 0
    while i < viewpoint.points_count(pts) {
        s = core.camera_world_to_screen(cam, viewpoint.points_at(pts, i), WIDTH, HEIGHT)
        if s.w <= 0.0 { inside = 0.0 }
        if s.y < top { top = s.y }
        if s.y > bottom { bottom = s.y }
        if s.x < 0.0 || s.x > WIDTH as float || s.y < 0.0 || s.y > HEIGHT as float { inside = 0.0 }
        i = i + 1
    }
    return core.vec3(top, bottom, inside)
}

// The rows of a frame of normals over black that hold anything: the first
// and last, as x and y; z is how many.
drawn_rows(pixels: ptr) -> Vec3 {
    first = 0 - 1
    last = 0 - 1
    rows = 0
    y = 0
    while y < HEIGHT {
        seen = false
        x = 0
        while x < WIDTH && !seen {
            at = (y * WIDTH + x) * 4
            sum = channel(pixels, at) + channel(pixels, at + 1) + channel(pixels, at + 2)
            if sum > 30 { seen = true }
            x = x + 1
        }
        if seen {
            if first < 0 { first = y }
            last = y
            rows = rows + 1
        }
        y = y + 1
    }
    return core.vec3(first as float, last as float, rows as float)
}

channel(pixels: ptr, index: int) -> int {
    bytes = pixels as byte[]
    return (bytes[index] as int) & 255
}

// One file at one scale: framed, its numbers held, and drawn through a
// backend where one is given.
frame_case(name: string, path: string, scale: float, backend: *Backend) -> float {
    scene = load_scaled(path, scale)
    if scene == null {
        check("${name}: loads", false)
        return 0.0 - 1.0
    }
    pts = viewpoint.points_new()
    i = 0
    while i < gltf.primitive_count(scene) {
        viewpoint.points_add_model(pts, gltf.primitive(scene, i))
        i = i + 1
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    framed = viewpoint.frame(cam, pts, SHARE, YAW, PITCH)
    rows = projected_rows(cam, pts)
    share = (rows.y - rows.x) / (HEIGHT as float)
    // The camera outside every primitive's bounds and all of them together.
    outside = true
    whole_lo = viewpoint.points_lo(pts)
    whole_hi = viewpoint.points_hi(pts)
    i = 0
    while i < gltf.primitive_count(scene) {
        one = viewpoint.points_new()
        viewpoint.points_add_model(one, gltf.primitive(scene, i))
        if viewpoint.points_count(one) > 0 && holds(viewpoint.points_lo(one), viewpoint.points_hi(one), cam.position) { outside = false }
        viewpoint.points_free(one)
        i = i + 1
    }
    if holds(whole_lo, whole_hi, cam.position) { outside = false }
    // The depths the points stand at, against the planes.
    nearest = 1000000000.0
    furthest = 0.0
    i = 0
    while i < viewpoint.points_count(pts) {
        z = core.v3_dot(core.v3_sub(viewpoint.points_at(pts, i), cam.position), cam.front)
        if z < nearest { nearest = z }
        if z > furthest { furthest = z }
        i = i + 1
    }
    size = core.v3_distance(whole_lo, whole_hi)
    if backend == null {
        println("  ${name}: ${viewpoint.points_count(pts)} vertices, ${size} across; framed from ${framed.distance} away: ${share * 100.0}% of the height, ${framed.width * 100.0}% of the width; nearest ${nearest} (near ${cam.near}), furthest ${furthest} (far ${cam.far})")
        check("${name}: spans 40-70% of the frame's height", framed.ok && share >= 0.40 && share <= 0.70)
        check("${name}: all of it inside the frame", rows.z > 0.0)
        check("${name}: the camera outside every model's bounds", outside)
        check("${name}: nothing cut by the near plane or lost past the far one", nearest > cam.near && furthest < cam.far)
    }
    drawn = 0.0 - 1.0
    if backend != null {
        i = 0
        while i < gltf.primitive_count(scene) {
            core.backend_add_model(backend, gltf.primitive(scene, i))
            i = i + 1
        }
        light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
        core.backend_render(backend, cam, light)
        pixels = core.backend_frame_pixels(backend)
        if pixels != null {
            got = drawn_rows(pixels)
            drawn = got.z / (HEIGHT as float)
            gap_top = core.abs_of(got.x - rows.x)
            gap_bottom = core.abs_of(got.y - rows.y)
            // A backend may read its rows bottom first: the span is what counts.
            flipped_top = core.abs_of(((HEIGHT - 1) as float - got.y) - rows.x)
            flipped_bottom = core.abs_of(((HEIGHT - 1) as float - got.x) - rows.y)
            agree = (gap_top <= 3.0 && gap_bottom <= 3.0) || (flipped_top <= 3.0 && flipped_bottom <= 3.0)
            println("  ${name}: drawn over rows ${got.x}..${got.y}, ${drawn * 100.0}% of the height; the numbers put it over ${rows.x}..${rows.y}")
            check("${name}: drawn, it spans 40-70% of the frame's height", drawn >= 0.40 && drawn <= 0.70)
            check("${name}: where the framing put it, within 3 pixels", agree)
        } else {
            check("${name}: the frame reads back", false)
        }
        i = 0
        while i < gltf.primitive_count(scene) {
            core.backend_remove_model(backend, gltf.primitive(scene, i))
            i = i + 1
        }
        core.light_free(light)
    }
    core.camera_free(cam)
    viewpoint.points_free(pts)
    gltf.scene_destroy(scene)
    return drawn
}

holds(lo: Vec3, hi: Vec3, p: Vec3) -> bool {
    return p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y && p.z >= lo.z && p.z <= hi.z
}

// The fox as a crowd: a 3 x 3 of it instanced over its walk, each at its
// own phase, framed by the figures' own poses.
crowd_case(backend: *Backend) {
    scene = gltf.load("tests/fixtures/gltf/Fox.glb")
    if scene == null { check("the fox loads for its crowd", false) ; return }
    bank = gltf.bake_bank(scene, "Walk", FRAMES)
    if bank == null { check("the fox's walk bakes", false) ; gltf.scene_destroy(scene) ; return }
    herd = list.new()
    i = 0
    while i < gltf.primitive_count(scene) {
        m = gltf.primitive(scene, i)
        if m.skeleton != null {
            core.model_set_parent(m, null)
            core.model_set_position(m, 0.0, 0.0, 0.0)
            core.model_set_scale(m, 1.0, 1.0, 1.0)
            core.model_set_rotation(m, core.quat_ident())
            core.model_enable_instancing(m, 9)
            core.model_set_pose_bank(m, bank, FRAMES)
            core.model_enable_instance_phases(m)
            k = 0
            while k < 9 {
                core.model_set_instance_position(m, k, core.vec3(((k % 3) as float - 1.0) * 180.0, 0.0, ((k / 3) as float - 1.0) * 180.0))
                core.model_set_instance_phase(m, k, (k as float) / 9.0)
                k = k + 1
            }
            list.add_raw(herd, m as ptr)
        }
        i = i + 1
    }
    pts = viewpoint.points_new()
    i = 0
    while i < list.size(herd) {
        viewpoint.points_add_model(pts, list.get_raw(herd, i) as *Model)
        i = i + 1
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    framed = viewpoint.frame(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0)
    rows = projected_rows(cam, pts)
    share = (rows.y - rows.x) / (HEIGHT as float)
    lo = viewpoint.points_lo(pts)
    hi = viewpoint.points_hi(pts)
    if backend == null {
        println("  a crowd of nine foxes: ${viewpoint.points_count(pts)} posed vertices; ${share * 100.0}% of the height, ${framed.width * 100.0}% of the width")
        check("a crowd of foxes, each at its own pose, spans 40-70% of the frame's height", framed.ok && share >= 0.40 && share <= 0.70 && rows.z > 0.0)
        check("and the camera stands outside it", !holds(lo, hi, cam.position))
    } else {
        i = 0
        while i < list.size(herd) {
            core.backend_add_model(backend, list.get_raw(herd, i) as *Model)
            i = i + 1
        }
        light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
        core.backend_render(backend, cam, light)
        pixels = core.backend_frame_pixels(backend)
        if pixels != null {
            got = drawn_rows(pixels)
            gap = core.abs_of((got.y - got.x) - (rows.y - rows.x))
            println("  a crowd of nine foxes: drawn over ${got.z} rows; the numbers put it over ${rows.y - rows.x}")
            check("the crowd drawn where its poses put it, within 3 pixels", gap <= 3.0 && got.z / (HEIGHT as float) >= 0.40 && got.z / (HEIGHT as float) <= 0.70)
        } else {
            check("the crowd's frame reads back", false)
        }
        i = 0
        while i < list.size(herd) {
            core.backend_remove_model(backend, list.get_raw(herd, i) as *Model)
            i = i + 1
        }
        core.light_free(light)
    }
    core.camera_free(cam)
    viewpoint.points_free(pts)
    list.free(herd)
    posing.posebank_destroy(bank)
    gltf.scene_destroy(scene)
}


// A framing that follows: a box of a group, walking, and then jumping.
following() {
    cam = core.camera_new(WIDTH, HEIGHT)
    pts = viewpoint.points_new()
    at = core.vec3(0.0, 0.0, 0.0)
    viewpoint.points_add_box(pts, at, core.vec3(10.0, 2.0, 10.0))
    viewpoint.frame(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0)
    step = 1.0 / 60.0
    walk = 0.02
    worst_share = 1.0
    best_share = 0.0
    worst_move = 0.0
    frame = 0
    while frame < 600 {
        at = core.vec3(at.x + walk, 0.0, at.z)
        viewpoint.points_clear(pts)
        viewpoint.points_add_box(pts, at, core.v3_add(at, core.vec3(10.0, 2.0, 10.0)))
        before = cam.position
        viewpoint.frame_eased(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0, step, 1.0)
        moved = core.v3_distance(before, cam.position)
        if moved > worst_move { worst_move = moved }
        rows = projected_rows(cam, pts)
        share = (rows.y - rows.x) / (HEIGHT as float)
        if share < worst_share { worst_share = share }
        if share > best_share { best_share = share }
        frame = frame + 1
    }
    println("  following a group walking ${walk} a frame: ${worst_share * 100.0}..${best_share * 100.0}% of the height over 600 frames; the camera moved at most ${worst_move} a frame")
    check("a framing that follows a walking group keeps it 40-70% of the height", worst_share >= 0.40 && best_share <= 0.70)
    check("and moves the camera no further a frame than the group moved (and 1%)", worst_move <= walk * 1.01)
    // A jump of fifty metres.
    target = viewpoint.framing_of(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0)
    at = core.vec3(at.x + 50.0, 0.0, at.z)
    viewpoint.points_clear(pts)
    viewpoint.points_add_box(pts, at, core.v3_add(at, core.vec3(10.0, 2.0, 10.0)))
    jumped = viewpoint.framing_of(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0)
    gap = core.v3_distance(target.position, jumped.position)
    worst_move = 0.0
    frame = 0
    while frame < 600 {
        before = cam.position
        viewpoint.frame_eased(cam, pts, SHARE, 0.0 - 135.0, 0.0 - 20.0, step, 1.0)
        moved = core.v3_distance(before, cam.position)
        if moved > worst_move { worst_move = moved }
        frame = frame + 1
    }
    left = core.v3_distance(cam.position, jumped.position)
    println("  the group jumping ${gap}: the camera went after it at most ${worst_move} a frame (${worst_move * 100.0 / gap}% of the gap), ${left} short after ten seconds")
    check("a jump is followed, not cut: under 2% of the gap a frame", worst_move < gap * 0.02)
    check("and caught up within ten seconds, to a ten-thousandth of the gap", left < gap * 0.0001)
    viewpoint.points_free(pts)
    core.camera_free(cam)
}

cases(backend: *Backend) {
    frame_case("the box man", "tests/fixtures/gltf/humanoid.glb", 1.0, backend)
    frame_case("the fox", "tests/fixtures/gltf/Fox.glb", 1.0, backend)
    frame_case("the arm (.glb)", "tests/fixtures/gltf/arm.glb", 1.0, backend)
    frame_case("the arm (.gltf)", "tests/fixtures/gltf/arm.gltf", 1.0, backend)
    frame_case("the box man, a giant", "tests/fixtures/gltf/humanoid.glb", 100.0, backend)
    frame_case("the box man, a doll", "tests/fixtures/gltf/humanoid.glb", 0.01, backend)
    crowd_case(backend)
}

main() {
    println("framing: the camera placed to show what it frames, 55% of the height asked")
    cases(null)
    following()

    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("framing: no OpenGL context here; the frames are not drawn")
    } else {
        renderer = gl.renderer_new()
        backend = gl.backend(renderer)
        if core.backend_init(&backend, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
            gl.renderer_set_capture_channel(renderer, 2)
            println("framing: drawn through OpenGL")
            cases(&backend)
            core.backend_cleanup(&backend)
            offscreen.target_destroy(target)
        } else {
            println("framing: the OpenGL backend would not start; the frames are not drawn")
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }
    if vulkan.available() {
        vk_renderer = vulkan.renderer_new()
        vk_backend = vulkan.backend(vk_renderer)
        if core.backend_init(&vk_backend, null, WIDTH, HEIGHT) {
            vulkan.renderer_set_clear_color(vk_renderer, 0.0, 0.0, 0.0)
            vulkan.renderer_set_capture_channel(vk_renderer, 2)
            println("framing: drawn through Vulkan")
            cases(&vk_backend)
            core.backend_cleanup(&vk_backend)
        } else {
            println("framing: Vulkan would not start (${vulkan.last_error()}); the frames are not drawn")
        }
        vulkan.renderer_free(vk_renderer)
    }
    if g_failures == 0 {
        println("framing: all checks passed (${g_checks})")
    } else {
        println("framing: ${g_failures} of ${g_checks} checks FAILED")
    }
}
