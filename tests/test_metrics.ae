// ae3d.metrics (#854) held to telling right from wrong on real motion: the
// Rigify mannequin on its authored walk, measured from what is drawn.
//
// - Skating: the walk with its feet locked by ikrig slides a planted toe
//   under 5 mm a stance; the same walk with no IK slides many times that;
//   a figure carried along the ground at 2 m/s with its feet down skates
//   what it was carried (#927), its feet touching down too fast to begin a
//   stance by their speed.
// - Into the ground: the clip alone sinks a toe tens of millimetres into
//   the floor; with ikrig's feet, under 5 mm.
// - Pops: idle to sprint cut in one frame turns a joint far past the takes'
//   own fastest; the same change eased over 0.3 s does not.
// - The reference: a take's own fastest read from the take (take_fastest)
//   is the one played; and the meter names the joint of each worst.
// - Any writer: a pose put on the joints by hand, with no animator, is
//   measured the same way (a still figure: nothing turns, nothing slides).
// - What a player sees: walking, the legs stay apart and no foot crosses
//   the middle.
//
// No window; the engine stepped by hand at 60 Hz.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.metrics

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

fresh() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

// The mannequin walking at 1.4 m/s along its walk's heading for 4 s, its feet
// locked or not; the meter's worst skate and sink, and the legs' least gap
// and the most a foot crossed, over the last 3 s.
walked(locked: bool) -> (float, float, float, float, bool) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_blend(a, "move")
    walk = animator.take(a, "Walk_Loop", false)
    animator.blend_add(a, s, walk, clips.speed(walk))
    jog = animator.take(a, "Jog_Fwd_Loop", false)
    animator.blend_add(a, s, jog, clips.speed(jog))
    animator.play(a, s, 0.0)
    animator.set_param(a, s, 1.4)
    if locked { animator.set_feet(a, ikrig.feet_new(r, o)) }
    m = metrics.meter_new(r, o)
    ahead = clips.heading(walk)
    at = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 240 {
        at = core.v3_add(at, core.v3_mul(ahead, 1.4 * STEP))
        behaviour.object_set_position(o, at)
        engine.engine_update(e, STEP)
        if k == 60 { metrics.meter_reset(m) }
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    skate = metrics.meter_worst(m, metrics.SKATE)
    into = metrics.meter_worst(m, metrics.INTO_GROUND)
    apart = metrics.meter_worst(m, metrics.LEGS_APART)
    cross = metrics.meter_worst(m, metrics.FEET_CROSS)
    sk = metrics.meter_joint(m, metrics.SKATE)
    foot = sk == pose.human(r, pose.FOOT_L) || sk == pose.human(r, pose.FOOT_R)
    metrics.meter_free(m)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return skate, into, apart, cross, foot
}

// The fastest joint turn, idle to sprint, the change cut in one frame or
// eased over `seconds`, the takes' own fastest played, read from the takes
// (metrics.take_fastest), and whether the pop's joint was named.
changed(seconds: float) -> (float, float, float, bool) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle_t = animator.take(a, "Idle_Loop", false)
    idle = animator.add_state(a, "idle", idle_t, true)
    sprint_t = animator.take(a, "Sprint_Loop", false)
    sprint = animator.add_state(a, "sprint", sprint_t, true)
    // The takes' own fastest, by the same meter on each played alone: the
    // window reset once a take is under way, so the change into it is not
    // counted.
    m = metrics.meter_new(r, o)
    own = 0.0
    states = [sprint, idle]
    n = 0
    while n < 2 {
        animator.play(a, states[n], 0.5)
        k = 0
        while k < 150 {
            engine.engine_update(e, STEP)
            metrics.meter_take(m, STEP)
            if k == 45 { metrics.meter_reset(m) }
            k = k + 1
        }
        if metrics.meter_worst(m, metrics.POP) > own { own = metrics.meter_worst(m, metrics.POP) }
        n = n + 1
    }
    metrics.meter_set_reference(m, own)
    metrics.meter_reset(m)
    animator.play(a, sprint, seconds)
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    fastest = metrics.meter_worst(m, metrics.POP)
    named = metrics.meter_joint(m, metrics.POP) >= 0 && metrics.meter_joint(m, metrics.POP) < pose.count(r)
    read = metrics.take_fastest(sprint_t, r)
    if metrics.take_fastest(idle_t, r) > read { read = metrics.take_fastest(idle_t, r) }
    metrics.meter_free(m)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return fastest, own, read, named
}

// A still figure posed by hand, with no animator: nothing turns, no toe
// slides, nothing jerks.
still_by_hand() -> (float, float, float) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    f = figure.figure_of(o)
    figure.stop(f)
    r = pose.of_skeleton(figure.skeleton(f))
    p = pose.new(r)
    pose.rest_pose(r, p)
    m = metrics.meter_new(r, o)
    k = 0
    while k < 60 {
        pose.apply(r, p)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    turn = metrics.meter_worst(m, metrics.POP)
    skate = metrics.meter_worst(m, metrics.SKATE)
    jerk = metrics.meter_worst(m, metrics.JERK_HANDS)
    metrics.meter_free(m)
    pose.release(p)
    pose.rig_free(r)
    figure.figures_free(e)
    engine.engine_free(e)
    return turn, skate, jerk
}

// The mannequin on its idle, its feet down, carried along the ground at
// `speed` m/s for a second as if its drawing had gone wrong (#927): the
// meter's worst skate, and how far it was carried.
glided(speed: float) -> (float, float) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    m = metrics.meter_new(r, o)
    at = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    metrics.meter_reset(m)
    carried = 0.0
    k = 0
    while k < 60 {
        at = core.v3_add(at, core.vec3(speed * STEP, 0.0, 0.0))
        carried = carried + speed * STEP
        behaviour.object_set_position(o, at)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    skate = metrics.meter_worst(m, metrics.SKATE)
    metrics.meter_free(m)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return skate, carried
}

main() {
    println("metrics: what a player sees, measured on the drawn figure (#854)")
    skate_ik, into_ik, apart, cross, _foot_ik = walked(true)
    skate_bare, into_bare, _apart_bare, _cross_bare, foot_bare = walked(false)
    println("  walking 1.4 m/s: a toe skated ${skate_ik * 1000.0} mm a stance with ikrig's feet, ${skate_bare * 1000.0} mm without; a sole ${into_ik * 1000.0} mm and ${into_bare * 1000.0} mm into the floor")
    check("skating: the locked walk under 5 mm a stance, the bare clip several times that", skate_ik < 0.005 && skate_bare > skate_ik * 3.0)
    check("into the ground: the clip alone sinks a sole past 10 mm, ikrig's feet under 5 mm", into_bare > 0.01 && into_ik < 0.005)
    glide, carried = glided(2.0)
    println("  carried along the ground at 2 m/s for a second, its feet down: a toe skated ${glide * 1000.0} mm (carried ${carried * 1000.0} mm)")
    check("a figure carried along the ground with its feet down skates what it was carried (#927)", glide > carried * 0.9)
    println("  walking, the legs ${apart * 100.0} cm apart at the closest, a foot ${cross * 100.0} cm past the middle at most")
    check("walking, the legs stay 5 cm apart and no foot crosses the hips' middle", apart > 0.05 && cross < 0.0)
    cut, own, read, named = changed(0.0)
    eased, _own_eased, _read_eased, _named_eased = changed(0.3)
    println("  idle to sprint: cut in a frame the fastest joint turn ${cut} rad/s, eased over 0.3 s ${eased}, the takes' own ${own}")
    check("pops: a change cut in a frame turns a joint past the takes' own fastest by half again; eased over 0.3 s, by no more than 2%", cut > own * 1.5 && eased <= own * 1.02)
    println("  the takes' own fastest read from them: ${read} rad/s, played ${own}")
    check("a take's own fastest, read from the take (take_fastest), is the one played within 2%", read > own * 0.98 && read < own * 1.02)
    check("the meter names the joint: the pop's is a joint of the rig, the bare walk's skate a foot", named && foot_bare)
    turn, slid, jerk = still_by_hand()
    println("  a still pose put on by hand, no animator: the fastest turn ${turn} rad/s, a toe slid ${slid * 1000.0} mm, the hands' jerk ${jerk} m/s3")
    check("any writer: a figure posed by hand is measured, and a still one turns (under 0.1 rad/s of rounding), slides and jerks not at all", turn < 0.1 && slid < 0.0001 && jerk < 0.001)
    if g_failures > 0 {
        println("metrics: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("metrics: all checks passed (${g_checks})")
}
