// Lying down on a bedroll and getting up (#825, motion.lie_down / get_up),
// held to the numbers a game judges it by: the box man with feet of its own,
// POWERED, stood over the middle of a bedroll on the ground, lies down on
// its back with its head toward the bedroll's head end, lies still, and gets
// up. No window.
//
//   - stood where motion.lie_spot puts it, lying, every body is over the bedroll (its centre within the mat's
//     footprint) and nothing is more than 1 cm under the mat's top; and the
//     figure a player sees rests on it, its lowest flesh within 1 cm of the
//     top;
//   - it gets up within 4 s of get_up, back in the mode it lay down from
//     and upright a second on (under 0.1 rad);
//   - no body turns more than 6 degrees in a step, from the first step down
//     to standing again (no pop).
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const MAT_LONG = 2.0                   // m, the bedroll head to foot
const MAT_WIDE = 0.8
const MAT_THICK = 0.04

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

main() {
    println("lie: down on a bedroll and up again (#825)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        println("lie: SKIP ${PATH} would not load")
        engine.engine_free(e)
        return
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // The bedroll behind it, its head end behind it, placed so that the
    // figure stands where motion.lie_spot has it lie with its hips over the
    // bedroll's middle.
    way = facing(m)
    head = core.v3_mul(way, 0.0 - 1.0)
    pose = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    physics.ragdoll_body_pose(r, pose)
    feet = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, pose, human.BONE_CALF_L), physics.ragdoll_pose_end(r, pose, human.BONE_CALF_R)), 0.5)
    free(pose)
    spot = motion.lie_spot(m, core.vec3(0.0, 0.0, 0.0), head)
    middle = core.vec3(feet.x - spot.x, MAT_THICK * 0.5, feet.z - spot.z)
    mat = engine.object(e, "Bedroll", loader.cube(1.0))
    behaviour.object_set_position(mat, middle)
    behaviour.object_set_rotation(mat, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), way))
    physics.box_collider(mat, core.vec3(MAT_WIDE * 0.5, MAT_THICK * 0.5, MAT_LONG * 0.5), physics.material(0.8, 0.0))
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }

    count = physics.ragdoll_bone_count(r)
    was = calloc(count * 4, 8)
    last = was as float[]
    i = 0
    while i < count {
        q = physics.ragdoll_bone_rotation(r, i)
        last[i * 4] = q.x
        last[i * 4 + 1] = q.y
        last[i * 4 + 2] = q.z
        last[i * 4 + 3] = q.w
        i = i + 1
    }
    across = core.v3_cross(core.vec3(0.0, 1.0, 0.0), way)
    check("it lies down", motion.lie_down(m, head) && motion.lying_down(m))
    worst_turn = 0.0
    off_mat = 0.0
    under = 0.0
    drawn_low = 1000.0
    asked = 0 - 1
    up_at = 0 - 1
    k = 0
    while k < 900 {
        engine.engine_update(e, STEP)
        i = 0
        while i < count {
            q = physics.ragdoll_bone_rotation(r, i)
            t = turned_by(core.quat(last[i * 4], last[i * 4 + 1], last[i * 4 + 2], last[i * 4 + 3]), q)
            if up_at < 0 && t > worst_turn { worst_turn = t }
            last[i * 4] = q.x
            last[i * 4 + 1] = q.y
            last[i * 4 + 2] = q.z
            last[i * 4 + 3] = q.w
            i = i + 1
        }
        // Lain two seconds: on the mat, then asked up.
        if asked < 0 && k >= 240 {
            i = 0
            while i < count {
                c = behaviour.object_position(physics.ragdoll_bone(r, i))
                d = core.v3_sub(c, middle)
                along = core.abs_of(core.v3_dot(d, way)) - MAT_LONG * 0.5
                side = core.abs_of(core.v3_dot(d, across)) - MAT_WIDE * 0.5
                if along > off_mat { off_mat = along }
                if side > off_mat { off_mat = side }
                low = MAT_THICK - physics.ragdoll_pose_bone_lowest(r, null, i)
                if low > under { under = low }
                at, found = physics.ragdoll_flesh_lowest(r, i)
                if found && at < drawn_low { drawn_low = at }
                i = i + 1
            }
            if motion.get_up(m) { asked = k }
        }
        if asked >= 0 && up_at < 0 && !motion.getting_up(m) && !motion.acting(m) { up_at = k }
        if up_at >= 0 && k == up_at + 60 { k = 900 }
        k = k + 1
    }
    free(was)
    rise = 0.0
    if asked >= 0 && up_at >= 0 { rise = ((up_at - asked) as float) * STEP }
    println("  lying: ${off_mat * 100.0} cm past the mat's edge at the most, ${under * 100.0} cm under its top; up in ${rise} s; the worst turn in a step ${worst_turn * 57.29578} degrees")
    check("lying, every body is over the bedroll", asked >= 0 && off_mat <= 0.0)
    check("and nothing is more than 1 cm under its top", asked >= 0 && under < 0.01)
    println("  lying, its drawn flesh ${(drawn_low - MAT_THICK) * 100.0} cm over the mat's top at its lowest")
    check("lying, the drawn figure rests on the bedroll (its lowest flesh within 1 cm of the top)", asked >= 0 && core.abs_of(drawn_low - MAT_THICK) < 0.01)
    check("it gets up within 4 s", up_at >= 0 && rise <= 4.0)
    check("no body turns more than 6 degrees in a step (no pop)", worst_turn < 0.10472)
    println("  up: ${motion.mode_name(motion.mode(m))}, ${motion.tilt(m)} rad a second on")
    check("up, it is POWERED again and upright a second on (under 0.1 rad)", up_at >= 0 && motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m))
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures > 0 {
        println("lie: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("lie: all checks passed (${g_checks})")
}
