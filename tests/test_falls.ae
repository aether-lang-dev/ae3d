// ci: optimised -- its run is CPU work -O0 makes three to six times slower
// The protective fall over ensembles (#479), held to numbers. Thirty
// falls each way -- over backwards (a blow to the chest from in front),
// forwards (from behind) and sideways -- with blows of 2.7 to 3.05 m/s
// (forwards 2.5 to 2.85, past what a stagger's catch steps hold),
// each on a POWERED figure that protects itself and on its twin that does
// not, side by side on one ground. No window: the engine is stepped by
// hand. Each way, of its thirty falls:
//
//   - every pair falls, and on average the protected head meets the
//     ground slower than its twin's;
//   - in how many the protected head is the slower;
//   - in how many it meets the ground a second time once the figure has
//     landed (it rocks or rolls onto it again at more than 1 m/s);
//   - in how many the figure lies still within 3 s of landing;
//   - the knees give going down, over 0.3 rad on average (#578); forwards
//     the pelvis is lower than the twin's when the figure leans past 45
//     degrees, the body coming down in stages rather than as a plank;
//   - the order it comes down in (#578): every way a hand is on the ground
//     before the head, in at least 29; forwards the knees first and then
//     the hands, in at least 29. Over backwards the hands reach the ground
//     first in all 30 and the head never does; sideways the hands are
//     first in 22, the knees in 8. The twin gets a hand down before its
//     head in 10 over backwards and 19 forwards. Each touch is timed
//     within its step, as the body crossed 2 cm: taken at the step's end,
//     a knee and a hand down within one step counted together, and
//     forwards, where the knees lead the hands by 1.9 steps on average
//     (one hand 0.08 of a step first), two of the thirty did.
//
// The counts are held where the figure is now, less a margin for another
// platform's floating point. #479 asks 29 slower, no second impact and
// every figure still, each way, and all of it is met:
//
//   way              slower   head (m/s, mean)   second impact   still in 3 s (slowest)   knees (rad)
//   over backwards   30       0.10               0               30 (1.25 s)               0.45
//   forwards         30       0.84               0               30 (0.88 s)               0.45
//   sideways         30       0.18               0               30 (1.52 s)               0.48

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const WAYS = 3                       // over backwards, forwards, sideways
const FALLS = 30                     // a way
const FIGURES = 180                  // WAYS * FALLS, a protected and an unprotected twin each
// The blows as the speed they give the whole body, metres a second
// (#626): 376 to 424 N s on the 138.5 kg figure before it weighed what a
// person its height does.
const BLOW_LOW = 2.7
const BLOW_HIGH = 3.05
// From behind, a figure that steps staggers out of shoves up to 1.05 m/s
// (tests/test_stagger.ae): a fall forwards starts well past that, at what
// was 345 to 395 N s.
const FORWARD_LOW = 2.5
const FORWARD_HIGH = 2.85
const BLOW_STEP = 60                 // a second in
const STEPS = 480
const TOUCH = 0.02                   // a body within this of the ground touches it
const STILL = 0.1                    // m/s: no body faster than this is still

// Per figure, what its fall measured.
const FIELDS = 17
const LAND_STEP = 0                  // the first step anything but its feet touched the ground
const HEAD_STEP = 1                  // the first step its head did
const HEAD_SPEED = 2                 // how fast the head was coming down then
const HEAD_LAST = 3                  // the head's lowest point last step
const HEAD_LEFT = 4                  // 1 once the head has left the ground again by 3 cm
const SECOND = 5                     // the fastest the head met the ground again after landing
const MOVED_STEP = 6                 // the last step any body moved faster than STILL
const FELL = 7                       // 1 when its pelvis went under half a metre
const KNEE = 8                       // the most either knee bent before it landed, radians
const DROP = 9                       // how far its pelvis had come down when it leaned past 45 degrees; -1 until then
const STAND = 10                     // its pelvis's height when the blow landed
const KNEE_STEP = 11                 // the first step a knee (a thigh's low end) touched the ground
const HAND_STEP = 12                 // a hand (a forearm)
const HIP_STEP = 13                  // its hips (the pelvis)
const KNEE_LAST = 14                 // the knees' lowest point last step
const HAND_LAST = 15                 // the hands'
const HIP_LAST = 16                  // the hips'

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// A bone's lowest point: its own capsule's, where its body is now.
bone_low(r: *Ragdoll, index: int) -> float {
    bone = human.bone_at(&r.human, index)
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.shape_id)
    ya = t.p.y + core.quat_apply(t.q, c.center1).y
    yb = t.p.y + core.quat_apply(t.q, c.center2).y
    if yb < ya { ya = yb }
    return ya - c.radius
}

// The fastest any of its bodies moves.
fastest(r: *Ragdoll) -> float {
    most = 0.0
    i = 0
    while i < human.BONE_COUNT {
        v = core.v3_len(dynamics.body_get_linear_velocity(human.bone_at(&r.human, i).body_id))
        if v > most { most = v }
        i = i + 1
    }
    return most
}

// Where a figure faces, level: its rest's forward turned as its pelvis is.
facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(&r.human, human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// Fall `n` of a way: its blow, from BLOW_LOW to BLOW_HIGH (forwards, from
// FORWARD_LOW to FORWARD_HIGH).
blow_of(way: int, n: int) -> float {
    low = BLOW_LOW
    high = BLOW_HIGH
    if way == 1 {
        low = FORWARD_LOW
        high = FORWARD_HIGH
    }
    return low + (high - low) * (n as float) / ((FALLS - 1) as float)
}

// The angle between a bone's way and another's, radians.
bent(r: *Ragdoll, a: int, b: int) -> float {
    d = core.v3_dot(core.quat_apply(physics.ragdoll_bone_rotation(r, a), physics.ragdoll_bone_axis(r, a)),
                    core.quat_apply(physics.ragdoll_bone_rotation(r, b), physics.ragdoll_bone_axis(r, b)))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return core.acos_of(d)
}

// Which of knees, hands, hips and head touched the ground first (a field),
// -1 when none did; a tie goes to the earlier in that list.
first_of(record: float[], at: int) -> int {
    best = 0 - 1
    best_step = 0.0
    fields = [KNEE_STEP, HAND_STEP, HIP_STEP, HEAD_STEP]
    i = 0
    while i < 4 {
        f = fields[i]
        s = record[at + f]
        if s >= 0.0 && (best < 0 || s < best_step) {
            best = f
            best_step = s
        }
        i = i + 1
    }
    return best
}

// Whether the one touched the ground, and before the other or the other never.
before(record: float[], one: int, other: int) -> bool {
    if record[one] < 0.0 { return false }
    if record[other] < 0.0 { return true }
    return record[one] < record[other]
}

lower_of(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

// When, in steps, a body coming down from `was` last step to `now` came
// within TOUCH of the ground: within the step, as it crossed TOUCH. Taken
// at the step's end, a knee and a hand down in one sixtieth of a second
// were down together, whichever came first.
crossed(steps: int, was: float, now: float) -> float {
    if was > TOUCH && now < was { return (steps as float) - (TOUCH - now) / (was - now) }
    return steps as float
}

// When `low` first came within TOUCH of the ground, once; `last` keeps it
// from the step before.
first_touch(record: float[], at: int, last: int, steps: int, low: float) {
    if record[at] < 0.0 && low < TOUCH { record[at] = crossed(steps, record[last], low) }
    record[last] = low
}

// A step of a fall watched.
watch(m: *Motion, record: float[], at: int, steps: int, step: float) {
    r = m.ragdoll
    pelvis_y = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
    if record[at + STAND] == 0.0 { record[at + STAND] = pelvis_y }
    if record[at + LAND_STEP] < 0.0 {
        knee = bent(r, human.BONE_THIGH_L, human.BONE_CALF_L)
        other = bent(r, human.BONE_THIGH_R, human.BONE_CALF_R)
        if other > knee { knee = other }
        if knee > record[at + KNEE] { record[at + KNEE] = knee }
    }
    if record[at + DROP] < 0.0 && physics.ragdoll_tilt(r) > 0.785 { record[at + DROP] = record[at + STAND] - pelvis_y }
    head = bone_low(r, human.BONE_NECK)
    others = head
    i = 0
    while i < human.BONE_COUNT {
        if i != human.BONE_CALF_L && i != human.BONE_CALF_R {
            low = bone_low(r, i)
            if low < others { others = low }
        }
        i = i + 1
    }
    if record[at + LAND_STEP] < 0.0 && others < TOUCH { record[at + LAND_STEP] = steps as float }
    if record[at + HEAD_STEP] < 0.0 {
        if head < TOUCH {
            record[at + HEAD_STEP] = crossed(steps, record[at + HEAD_LAST], head)
            record[at + HEAD_SPEED] = (record[at + HEAD_LAST] - head) / step
        }
    } else if record[at + LAND_STEP] >= 0.0 {
        if head > TOUCH + 0.03 { record[at + HEAD_LEFT] = 1.0 }
        if record[at + HEAD_LEFT] > 0.5 && head < TOUCH {
            speed = (record[at + HEAD_LAST] - head) / step
            if speed > record[at + SECOND] { record[at + SECOND] = speed }
            record[at + HEAD_LEFT] = 0.0
        }
    }
    record[at + HEAD_LAST] = head
    first_touch(record, at + KNEE_STEP, at + KNEE_LAST, steps, lower_of(bone_low(r, human.BONE_THIGH_L), bone_low(r, human.BONE_THIGH_R)))
    first_touch(record, at + HAND_STEP, at + HAND_LAST, steps, lower_of(bone_low(r, human.BONE_LOWER_ARM_L), bone_low(r, human.BONE_LOWER_ARM_R)))
    first_touch(record, at + HIP_STEP, at + HIP_LAST, steps, bone_low(r, human.BONE_PELVIS))
    if fastest(r) > STILL { record[at + MOVED_STEP] = steps as float }
    if behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y < 0.5 { record[at + FELL] = 1.0 }
}

// What each way is held to: the table above, less its margin.
// Every way 29 of 30: forwards, on feet that grip, it had been 26 -- the
// arms, flung back by the shove, came forward only once the body was down
// -- and the arms reaching harder as the fall goes on (REACH_STRENGTH,
// #597) brought it to 30.
slower_least(way: int) -> int {
    return 29
}

seconds_most(way: int) -> int { return 0 }

stilled_least(way: int) -> int {
    if way == 1 { return 28 }
    return 29
}

way_name(way: int) -> string {
    if way == 0 { return "over backwards" }
    if way == 1 { return "forwards" }
    return "sideways"
}

main() {
    println("falls: ${FALLS} each way, protected and not, blows from ${BLOW_LOW} to ${BLOW_HIGH} m/s (forwards ${FORWARD_LOW} to ${FORWARD_HIGH})")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(200.0, 0.5, 200.0), physics.material(0.8, 0.0))
    figures_block = calloc(FIGURES, 8)
    figures = figures_block as ptr[]
    rigs_block = calloc(FIGURES, 8)
    rigs = rigs_block as ptr[]
    record_block = calloc(FIGURES * FIELDS, 8)
    record = record_block as float[]
    // Figure k: way k / (2 * FALLS), fall (k / 2) % FALLS, protected at even k.
    k = 0
    while k < FIGURES {
        x = ((k % 30) as float) * 3.0 - 45.0
        z = ((k / 30) as float) * 6.0 - 15.0
        r = physics.ragdoll(e, "Faller", core.vec3(x, 0.02, z), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        physics.ragdoll_dress(r, rig)
        rigs[k] = rig as ptr
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        if k % 2 == 1 { motion.set_protective(m, false) }
        figures[k] = m as ptr
        record[k * FIELDS + LAND_STEP] = 0.0 - 1.0
        record[k * FIELDS + HEAD_STEP] = 0.0 - 1.0
        record[k * FIELDS + KNEE_STEP] = 0.0 - 1.0
        record[k * FIELDS + HAND_STEP] = 0.0 - 1.0
        record[k * FIELDS + HIP_STEP] = 0.0 - 1.0
        record[k * FIELDS + DROP] = 0.0 - 1.0
        k = k + 1
    }
    steps = 0
    while steps < STEPS {
        if steps == BLOW_STEP {
            k = 0
            while k < FIGURES {
                m = figures[k] as *Motion
                way = k / (2 * FALLS)
                ahead = facing(m)
                direction = core.v3_mul(ahead, 0.0 - 1.0)
                if way == 1 { direction = ahead }
                if way == 2 { direction = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead) }
                chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
                motion.hit(m, human.BONE_SPINE_03, chest, core.v3_mul(direction, blow_of(way, (k / 2) % FALLS) * physics.ragdoll_mass(m.ragdoll)))
                k = k + 1
            }
        }
        engine.engine_update(e, 1.0 / 60.0)
        steps = steps + 1
        if steps > BLOW_STEP {
            k = 0
            while k < FIGURES {
                watch(figures[k] as *Motion, record, k * FIELDS, steps, 1.0 / 60.0)
                k = k + 1
            }
        }
    }

    way = 0
    while way < WAYS {
        slower = 0
        fell = 0
        seconds = 0
        restless = 0
        worst_second = 0.0
        worst_rest = 0.0
        head_sum = 0.0
        twin_sum = 0.0
        end_sum = 0.0
        end_worst = 0.0
        end_bone = 0
        knee_sum = 0.0
        twin_knee_sum = 0.0
        drop_sum = 0.0
        twin_drop_sum = 0.0
        hand_first = 0
        twin_hand_first = 0
        knee_first = 0
        hip_first = 0
        head_first = 0
        hand_before_head = 0
        twin_hand_before_head = 0
        knee_before_hand = 0
        n = 0
        while n < FALLS {
            at = (way * 2 * FALLS + n * 2) * FIELDS
            twin = at + FIELDS
            first = first_of(record, at)
            if first == HAND_STEP { hand_first = hand_first + 1 }
            if first == KNEE_STEP { knee_first = knee_first + 1 }
            if first == HIP_STEP { hip_first = hip_first + 1 }
            if first == HEAD_STEP { head_first = head_first + 1 }
            if first_of(record, twin) == HAND_STEP { twin_hand_first = twin_hand_first + 1 }
            if before(record, at + HAND_STEP, at + HEAD_STEP) { hand_before_head = hand_before_head + 1 }
            if before(record, twin + HAND_STEP, twin + HEAD_STEP) { twin_hand_before_head = twin_hand_before_head + 1 }
            if before(record, at + KNEE_STEP, at + HAND_STEP) { knee_before_hand = knee_before_hand + 1 }
            if record[at + FELL] > 0.5 && record[twin + FELL] > 0.5 { fell = fell + 1 }
            knee_sum = knee_sum + record[at + KNEE]
            twin_knee_sum = twin_knee_sum + record[twin + KNEE]
            drop_sum = drop_sum + record[at + DROP]
            twin_drop_sum = twin_drop_sum + record[twin + DROP]
            mine = record[at + HEAD_SPEED]
            theirs = record[twin + HEAD_SPEED]
            if record[at + HEAD_STEP] < 0.0 { mine = 0.0 }
            if record[twin + HEAD_STEP] < 0.0 { theirs = 0.0 }
            head_sum = head_sum + mine
            twin_sum = twin_sum + theirs
            if mine < theirs || (record[at + HEAD_STEP] < 0.0 && record[twin + HEAD_STEP] >= 0.0) { slower = slower + 1 }
            if record[at + SECOND] > 1.0 { seconds = seconds + 1 }
            if record[at + SECOND] > worst_second { worst_second = record[at + SECOND] }
            rest = (record[at + MOVED_STEP] - record[at + LAND_STEP]) / 60.0
            if record[at + LAND_STEP] < 0.0 { rest = 99.0 }
            if rest > worst_rest { worst_rest = rest }
            if rest > 3.0 { restless = restless + 1 }
            r = (figures[way * 2 * FALLS + n * 2] as *Motion).ragdoll
            i = 0
            while i < human.BONE_COUNT {
                v = core.v3_len(dynamics.body_get_linear_velocity(human.bone_at(&r.human, i).body_id))
                if v > end_worst { end_worst = v; end_bone = i }
                i = i + 1
            }
            end_sum = end_sum + fastest(r)
            n = n + 1
        }
        name = way_name(way)
        println("  ${name}: ${fell} of ${FALLS} pairs fell; the protected head slower in ${slower}, at ${head_sum / (FALLS as float)} m/s on average against ${twin_sum / (FALLS as float)}; a second impact past 1 m/s in ${seconds} (the fastest ${worst_second}); still within 3 s of landing in ${FALLS - restless} (the slowest ${worst_rest} s)")
        println("    at the end, the protected figures' fastest body: ${end_sum / (FALLS as float)} m/s on average, ${end_worst} at most (bone ${end_bone})")
        println("    going down, the knees bent ${knee_sum / (FALLS as float)} rad on average (the twin's ${twin_knee_sum / (FALLS as float)}); leaning past 45 degrees, the pelvis was ${drop_sum / (FALLS as float)} m down (the twin's ${twin_drop_sum / (FALLS as float)})")
        println("    first to the ground (protected): hands in ${hand_first}, knees ${knee_first}, hips ${hip_first}, head ${head_first} (the twin's hands first in ${twin_hand_first}); a hand down before the head in ${hand_before_head} (the twin ${twin_hand_before_head}); a knee before a hand in ${knee_before_hand}")
        check("${name}: every pair falls, and on average the protected head meets the ground slower", fell == FALLS && head_sum < twin_sum)
        check("${name}: the protected head is the slower in at least ${slower_least(way)}", slower >= slower_least(way))
        check("${name}: a second head impact after landing in at most ${seconds_most(way)}", seconds <= seconds_most(way))
        check("${name}: lying still within 3 s of landing in at least ${stilled_least(way)}", FALLS - restless >= stilled_least(way))
        check("${name}: the knees give going down, over 0.3 rad on average", knee_sum / (FALLS as float) > 0.3)
        // Forwards the pelvis comes down before the body has turned: the
        // knees give first. (Backwards the protective fall keeps the
        // pelvis up, so the head comes down last.)
        if way == 1 { check("forwards: leaning past 45 degrees the pelvis is lower than the twin's, the knees having given", drop_sum > twin_drop_sum) }
        // And the protected head meets the ground under 0.5 m/s on average:
        // 0.12, the arms thrown out by the blow itself (#606); 0.62 when they
        // waited for the lean, 0.88 before the reach grew stronger, 1.71
        // with the knees giving 0.45.
        if way == 1 { check("forwards: the protected head meets the ground under 0.5 m/s on average", head_sum / (FALLS as float) < 0.5) }
        // The order it comes down in (#578): a hand on the ground before
        // the head every way, and forwards the knees first, then the hands
        // -- in stages, not as a plank.
        check("${name}: a hand is down before the head in at least 29", hand_before_head >= 29)
        if way == 1 { check("forwards: the knees are down first, then the hands, in at least 29", knee_first >= 29 && knee_before_hand >= 29) }
        way = way + 1
    }
    engine.engine_free(e)
    k = 0
    while k < FIGURES {
        motion.motion_free(figures[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(figures_block)
    free(rigs_block)
    free(record_block)
    if g_failures == 0 {
        println("falls: all checks passed (${g_checks})")
    } else {
        println("falls: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
