// A script edited, rebuilt and reloaded over the agent channel while the
// game runs (#510): script.list, script.reload and script.errors over a real
// socket, with log.tail to hear the new code, as test_agent_until.ae talks.
//
// "talky.ae" is written, built (scripts/build_script.sh) and put on an
// object; it says "talky v1 <pace>" each frame. Then:
//   - script.list names it, its library and the one object carrying it;
//   - its source rewritten to say "v2", script.reload with the source builds
//     and swaps it: the console hears "talky v2", and the field the game
//     set (pace 7) is kept across the swap;
//   - a source that does not compile is refused with the compiler's words,
//     script.errors says so, and v2 keeps running;
//   - a source of another name is refused, the script left as it was.
// A hidden window; SKIP where none opens.
import std.os
import std.io
import std.fs
import std.tcp
import std.json
import std.list
import std.string
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour
import ae3d.component
import ae3d.script

extern exit(code: int)

const DIR = "build/agent_scripts"
const SOURCE = "build/agent_scripts/talky.ae"

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_wait = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        io.stderr_write("  ok   ${name}\n")
    } else {
        g_failures = g_failures + 1
        io.stderr_write("  FAIL ${name}\n")
    }
}

// The script, saying `version` each frame with its pace; `broken` leaves a
// statement no compiler takes.
source(version: string, broken: bool) -> string {
    tail = ""
    if broken { tail = "    this is not aether =\n" }
    // The script's own interpolation, written out literally.
    pace = string.concat("$", "{p.pace}")
    head = "// A script the agent test rewrites and reloads.\nimport ae3d.behaviour\nimport ae3d.component\n\n@derive(schema)\nstruct Talky {\n    pace: float @range(0.0, 100.0) @default(1.0)\n}\n\n"
    body = "update(p: *Talky, go: *GameObject, delta: float) {\n    println(\"talky ${version} ${pace}\")\n${tail}}\n"
    return string.concat(head, body)
}

write_source(text: string) -> bool {
    _made = fs.mkdir_p(DIR)
    return fs.write(SOURCE, text) == ""
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 1048576)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

error_of(doc: ptr) -> string {
    node = json.object_get_raw(doc, "error")
    if node == null { return "" }
    return json.get_string_raw(node)
}

text_of(r: ptr, name: string) -> string {
    if r == null { return "" }
    node = json.object_get_raw(r, name)
    if node == null || json.json_type(node) != 3 { return "" }
    return json.get_string_raw(node)
}

int_of(r: ptr, name: string) -> int {
    if r == null { return 0 - 1 }
    node = json.object_get_raw(r, name)
    if node == null { return 0 - 1 }
    return json.get_int(node)
}

// How many of the answer's console lines start with `prefix`.
said(r: ptr, prefix: string) -> int {
    lines = json.object_get_raw(r, "lines")
    n = 0
    k = 0
    while lines != null && k < json.array_size(lines) {
        if string.starts_with(text_of(json.array_get_raw(lines, k), "text"), prefix) == 1 { n = n + 1 }
        k = k + 1
    }
    return n
}

main() {
    io.stderr_write("agent_script: a script rebuilt and reloaded over the channel\n")
    if !write_source(source("v1", false)) {
        io.stderr_write("agent_script: FAIL could not write ${SOURCE}\n")
        exit(1)
    }
    argv = list.new()
    list.add(argv, SOURCE)
    list.add(argv, DIR)
    out, status, err = os.run_capture("scripts/build_script.sh", argv, null)
    list.free(argv)
    if err != "" || status != 0 {
        io.stderr_write("agent_script: FAIL the first build: ${err}${out}\n")
        exit(1)
    }
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_HIDDEN", "1")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 4000)
    lib = script.script_open(script.library_path("${DIR}/", "talky"))
    if lib == null {
        io.stderr_write("agent_script: FAIL the library would not open: ${script.last_error()}\n")
        exit(1)
    }
    kind = script.script_kind(lib, "Talky")
    holder = engine.object(e, "Speaker", loader.cube(1.0))
    c = component.add(holder, kind)
    component.set_float(c, component.field_named(kind, "pace"), 7.0)
    program = engine.behaviour_new("agent script test", null)
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        io.stderr_write("agent_script: SKIP no window\n")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    check("the exchange finished (stage ${g_stage})", g_stage == 9)
    if g_failures == 0 {
        println("agent_script: all checks passed (${g_checks})")
        return
    }
    println("agent_script: ${g_failures} of ${g_checks} checks FAILED")
    exit(1)
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        if engine.engine_frame_count(e) < 10 { return }
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("the client connects", sock != null)
        g_sock = sock
        ask_send("{\"id\":1,\"op\":\"script.list\"}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    // Frames for the reloaded code to speak before the console is read.
    if g_wait > 0 {
        g_wait = g_wait - 1
        if g_wait == 0 { ask_send("{\"id\":9,\"op\":\"log.tail\",\"count\":20}") }
        return
    }
    doc = ask_receive()
    if doc == null { return }
    respond(e, doc)
    json.free(doc)
}

respond(e: *Engine, doc: ptr) {
    r = result_of(doc)
    if g_stage == 1 {
        first = json.array_get_raw(json.object_get_raw(r, "scripts"), 0)
        check("script.list names the script, its library and the object carrying it (${text_of(first, "library")})",
              ok_of(doc) && text_of(first, "name") == "Talky" && int_of(first, "objects") == 1 &&
              string.contains(text_of(first, "library"), "talky") == 1)
        write_source(source("v2", false))
        ask_send("{\"id\":2,\"op\":\"script.reload\",\"name\":\"Talky\",\"source\":\"${SOURCE}\"}")
    } else if g_stage == 2 {
        check("script.reload with its source builds and swaps it (${error_of(doc)})", ok_of(doc) && int_of(r, "objects") == 1)
        g_wait = 5
    } else if g_stage == 3 {
        check("the console hears the new code, its field kept across the swap (${said(r, "talky v2 7")} lines of v2 at pace 7, ${said(r, "talky v1")} of v1 in the last 20)",
              ok_of(doc) && said(r, "talky v2 7") >= 3)
        write_source(source("v3", true))
        ask_send("{\"id\":3,\"op\":\"script.reload\",\"name\":\"Talky\",\"source\":\"${SOURCE}\"}")
    } else if g_stage == 4 {
        why = error_of(doc)
        check("a source that does not compile is refused with the compiler's words",
              !ok_of(doc) && string.contains(why, "talky.ae") == 1)
        ask_send("{\"id\":4,\"op\":\"script.errors\"}")
    } else if g_stage == 5 {
        first = json.array_get_raw(json.object_get_raw(r, "scripts"), 0)
        check("script.errors says so", ok_of(doc) && text_of(first, "name") == "Talky" && text_of(first, "error") != "")
        g_wait = 5
    } else if g_stage == 6 {
        check("and v2 keeps running (${said(r, "talky v2")} of the last 20)", ok_of(doc) && said(r, "talky v2") >= 3 && said(r, "talky v3") == 0)
        ask_send("{\"id\":5,\"op\":\"script.reload\",\"name\":\"Talky\",\"source\":\"build/agent_scripts/other.ae\"}")
    } else if g_stage == 7 {
        check("a source of another name is refused, naming the library it would not build (${error_of(doc)})",
              !ok_of(doc) && string.contains(error_of(doc), "builds other") == 1)
        ask_send("{\"id\":6,\"op\":\"script.reload\"}")
    } else if g_stage == 8 {
        check("script.reload with no name is refused", !ok_of(doc) && string.contains(error_of(doc), "name") == 1)
        g_stage = 9
        engine.engine_stop(e)
        return
    }
    g_stage = g_stage + 1
}
