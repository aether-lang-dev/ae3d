// The scene's authored look through its components, drawn (Nic, 874-6): the
// Rendering component's depth of field reaches the frame on OpenGL and on
// Vulkan, written the way an inspector or an agent writes it.
//
// A thin white bar close to the camera, a view looking at it (a view is drawn
// with the engine's depth of field from its own camera's depth). Three frames
// of the same view:
//
//   - before: the bar is sharp, one narrow peak across the middle row;
//   - after the Rendering's `depth of field` is turned on with the focus far
//     behind the bar (component.set_bool and set_float, which is what the
//     panel and the agent's component.set do): the bar is a disc of
//     confusion wide, its peak well under the sharp one and its spread wider;
//   - after it is turned off through the component: the first frame again,
//     byte for byte.
import std.mem
import ae3d.core
import std.os
import ae3d.engine
import ae3d.platform
import ae3d.vulkan
import ae3d.gl
import ae3d.loader
import ae3d.behaviour
import ae3d.component
extern exit(code: int)
extern malloc(size: long) -> ptr
extern free(p: ptr)

const WIDTH = 160
const HEIGHT = 120
const VIEW_W = 288
const VIEW_H = 216

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

var g_bar: ptr = null
var g_view = 0
var g_cam: ptr = null
var g_sharp: ptr = null
var g_blurred: ptr = null
var g_again: ptr = null

on_start(state: ptr, e: *Engine) {
    bar = loader.cube(1.0)
    core.model_set_scale(bar, 0.3, 6.0, 0.3)
    core.model_set_position(bar, 0.0, 0.0, 0.0)
    core.model_set_diffuse(bar, 1.0, 1.0, 1.0)
    g_bar = bar as ptr
    engine.engine_add_model(e, bar)
    g_view = engine.engine_view_new(e, VIEW_W, VIEW_H)
    cam = core.camera_new(VIEW_W, VIEW_H)
    core.camera_set_aspect(cam, (VIEW_W * 1.0) / (VIEW_H * 1.0))
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 10.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    g_cam = cam as ptr
}

// The view's pixels as a copy, the engine's buffer being the next frame's.
copy_view(e: *Engine) -> ptr {
    pixels = engine.engine_view_pixels(e, g_view)
    if pixels == null { return null }
    n = VIEW_W * VIEW_H * 4
    out = malloc(n as long)
    mem.copy(out, pixels, n as long)
    return out
}

on_update(state: ptr, e: *Engine, delta: float) {
    engine.engine_view_render(e, g_view, g_cam as *Camera)
}

on_render(state: ptr, e: *Engine, delta: float) {
    n = engine.engine_frame_count(e)
    root = engine.engine_scene_root(e)
    rk = engine.rendering_kind()
    rc = component.find(root, rk)
    if n == 4 {
        g_sharp = copy_view(e)
        component.set_bool(rc, component.field_named(rk, "depth of field"), true)
        component.set_float(rc, component.field_named(rk, "dof focus distance"), 60.0)
        component.set_float(rc, component.field_named(rk, "dof aperture"), 100.0)
        component.set_float(rc, component.field_named(rk, "dof max blur"), 100.0)
    }
    if n == 8 {
        g_blurred = copy_view(e)
        component.set_bool(rc, component.field_named(rk, "depth of field"), false)
    }
    if n == 11 {
        g_again = copy_view(e)
    }
}

// The brightest red along the view's middle row, and how many of its pixels
// are lit past a quarter.
peak(pixels: ptr) -> int {
    best = 0
    x = 0
    while x < VIEW_W {
        v = mem.get_byte(pixels, ((VIEW_H / 2) * VIEW_W + x) * 4)
        if v > best { best = v }
        x = x + 1
    }
    return best
}

spread(pixels: ptr) -> int {
    count = 0
    x = 0
    while x < VIEW_W {
        if mem.get_byte(pixels, ((VIEW_H / 2) * VIEW_W + x) * 4) > 20 { count = count + 1 }
        x = x + 1
    }
    return count
}

same(a: ptr, b: ptr) -> bool {
    return mem.compare(a, b, (VIEW_W * VIEW_H * 4) as long) == 0
}

run_engine(api: int, name: string) {
    g_sharp = null
    g_blurred = null
    g_again = null
    os.setenv("AE3D_WIDTH", "")
    os.setenv("AE3D_HEIGHT", "")
    os.setenv("AE3D_DOF", "")
    e = engine.engine_new_with(api)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_title(e, "ae3d scene look test")
    engine.engine_set_frame_limit(e, 13)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_shadows(e, false)
    engine.engine_set_clear_color(e, 0.0, 0.0, 0.0)
    light = core.light_directional(core.vec3(0.2, 0.4, 1.0), core.vec3(1.0, 1.0, 1.0), 1.0)
    engine.engine_set_light(e, light)
    b = engine.behaviour_new("scene look", null)
    b.start = on_start
    b.update = on_update
    b.late_update = on_render
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("  ${name}: SKIP no window available")
        core.light_free(light)
        engine.engine_free(e)
        release()
        return
    }
    check("${name}: the three frames were taken", g_sharp != null && g_blurred != null && g_again != null)
    if g_sharp != null && g_blurred != null && g_again != null {
        sharp_peak = peak(g_sharp)
        blur_peak = peak(g_blurred)
        println("  ${name}: peak ${sharp_peak} sharp, ${blur_peak} blurred; spread ${spread(g_sharp)} sharp, ${spread(g_blurred)} blurred")
        check("${name}: the bar is lit and narrow before", sharp_peak > 150 && spread(g_sharp) < 30)
        check("${name}: the Rendering's depth of field blurs it: a lower peak", blur_peak < sharp_peak * 6 / 10)
        check("${name}: and a wider spread", spread(g_blurred) > spread(g_sharp) * 2)
        check("${name}: turned off through the component the frame is the sharp one again, byte for byte", same(g_sharp, g_again))
    }
    core.light_free(light)
    engine.engine_free(e)
    release()
}

release() {
    if g_sharp != null { free(g_sharp) }
    if g_blurred != null { free(g_blurred) }
    if g_again != null { free(g_again) }
    g_sharp = null
    g_blurred = null
    g_again = null
    if g_bar != null { core.model_free(g_bar as *Model) }
    if g_cam != null { core.camera_free(g_cam as *Camera) }
    g_bar = null
    g_cam = null
}

main() {
    run_engine(platform.API_GL, "opengl")
    if vulkan.available() {
        run_engine(platform.API_VULKAN, "vulkan")
    } else {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
    }
    if failures == 0 {
        println("scene look: all checks passed")
        return
    }
    println("scene look: ${failures} failure(s)")
    exit(1)
}
