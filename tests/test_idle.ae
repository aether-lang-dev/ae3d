// A standing figure's breath and weight shift (#592), held to numbers on
// the box man fixture (tests/fixtures/gltf/humanoid.glb, Mixamo's names,
// its Idle playing), no window, stepped at 60 Hz over 30 s: the clip, then
// the idle layer.
//
//   - the chest's pitch over the clip's rises and falls by BREATH_PITCH,
//     a breath every BREATH_SECONDS or so, no two breaths alike;
//   - the hips sway across by WEIGHT_SHIFT either way over WEIGHT_SECONDS;
//   - the two are not in step;
//   - moving at STILL_BELOW or more, it is the clip exactly;
//   - no bone but the hips and the chest is moved.

import ae3d.core
import ae3d.skin
import ae3d.figure
import ae3d.idle

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

quat_angle(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

main() {
    println("idle: breathing and the weight shifting (#592)")
    group = core.model_new()
    fig = figure.figure_new(PATH, group)
    if fig == null {
        println("idle: SKIP ${PATH} would not load")
        return
    }
    figure.play(fig, "Idle", 1.0, true)
    figure.advance(fig, 0.0)
    sk = figure.skeleton(fig)
    n = skin.skeleton_count(sk)
    hips = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Hips"))
    chest = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Spine2"))
    d = idle.attach(null, group, hips, chest, core.vec3(0.0, 0.0, 1.0))
    check("the box man's hips and chest are found, the layer attached", d != null)
    kept = calloc(n * 7, 8)
    k = kept as float[]
    breath_low = 1.0
    breath_high = 0.0 - 1.0
    sway_low = 1.0
    sway_high = 0.0 - 1.0
    others = 0.0
    applied = 0.0                    // the most the bones' own change differs from the layer's
    tops = 0
    last_breath = 0.0
    rising = false
    top_times = calloc(64, 8)
    tt = top_times as float[]
    product = 0.0
    breath_sq = 0.0
    sway_sq = 0.0
    seconds = 0.0
    step = 0
    while step < 60 * 30 {
        figure.advance(fig, STEP)
        i = 0
        while i < n {
            b = skin.skeleton_bone(sk, i)
            k[i * 7] = b.rotation.x
            k[i * 7 + 1] = b.rotation.y
            k[i * 7 + 2] = b.rotation.z
            k[i * 7 + 3] = b.rotation.w
            k[i * 7 + 4] = b.position.x
            k[i * 7 + 5] = b.position.y
            k[i * 7 + 6] = b.position.z
            i = i + 1
        }
        idle.solve(d, STEP)
        seconds = seconds + STEP
        // What the layer added, against the clip it went over.
        i = 0
        while i < n {
            b = skin.skeleton_bone(sk, i)
            if b != hips && b != chest {
                moved = quat_angle(b.rotation, core.quat(k[i * 7], k[i * 7 + 1], k[i * 7 + 2], k[i * 7 + 3])) +
                        core.v3_len(core.v3_sub(b.position, core.vec3(k[i * 7 + 4], k[i * 7 + 5], k[i * 7 + 6])))
                if moved > others { others = moved }
            }
            i = i + 1
        }
        br = idle.breath(d)
        sw = idle.sway(d)
        // The bones themselves: the chest turned by the breath, the hips
        // moved by the sway (the hips' parent is the figure's root, unscaled).
        ci = skin.skeleton_find(sk, "mixamorig:Spine2")
        hi = skin.skeleton_find(sk, "mixamorig:Hips")
        turned = quat_angle(chest.rotation, core.quat(k[ci * 7], k[ci * 7 + 1], k[ci * 7 + 2], k[ci * 7 + 3]))
        shifted = core.v3_len(core.v3_sub(hips.position, core.vec3(k[hi * 7 + 4], k[hi * 7 + 5], k[hi * 7 + 6])))
        miss = core.abs_of(turned - br)
        if core.abs_of(shifted - core.abs_of(sw)) > miss { miss = core.abs_of(shifted - core.abs_of(sw)) }
        if miss > applied { applied = miss }
        if br < breath_low { breath_low = br }
        if br > breath_high { breath_high = br }
        if sw < sway_low { sway_low = sw }
        if sw > sway_high { sway_high = sw }
        if br > last_breath { rising = true } else if rising {
            if tops < 64 { tt[tops] = seconds }
            tops = tops + 1
            rising = false
        }
        last_breath = br
        // How alike the two are, centred: their correlation.
        bc = br - idle.BREATH_PITCH * 0.5
        product = product + bc * sw
        breath_sq = breath_sq + bc * bc
        sway_sq = sway_sq + sw * sw
        step = step + 1
    }
    // Breaths' lengths: the shortest and longest.
    shortest = 100.0
    longest = 0.0
    i = 1
    while i < tops && i < 64 {
        gap = tt[i] - tt[i - 1]
        if gap < shortest { shortest = gap }
        if gap > longest { longest = gap }
        i = i + 1
    }
    together = product / core.sqrt_of(breath_sq * sway_sq)
    println("  over 30 s: the chest pitched ${breath_low} to ${breath_high} rad (${idle.BREATH_PITCH}); ${tops} breaths, ${shortest} to ${longest} s long; the hips swayed ${sway_low} to ${sway_high} m (${idle.WEIGHT_SHIFT}); the two correlate ${together}; other bones moved ${others} at most")
    check("the chest rises and falls by its breath", breath_low < 0.001 && core.abs_of(breath_high - idle.BREATH_PITCH) < 0.002)
    check("a breath every BREATH_SECONDS or so, no two alike", tops >= 6 && shortest > idle.BREATH_SECONDS * 0.8 && longest < idle.BREATH_SECONDS * 1.25 && longest - shortest > 0.1)
    check("the hips sway across by WEIGHT_SHIFT either way", core.abs_of(sway_high - idle.WEIGHT_SHIFT) < 0.002 && core.abs_of(sway_low + idle.WEIGHT_SHIFT) < 0.002)
    check("the breath and the sway are not in step (correlation under 0.3)", core.abs_of(together) < 0.3)
    check("no bone but the hips and the chest is moved", others < 0.000001)
    println("  the chest's own turn and the hips' own shift against the layer's: ${applied} at most")
    check("the chest turns by the breath and the hips move by the sway, as drawn", applied < 0.0001)

    // Moving: the clip exactly.
    idle.set_speed(d, idle.STILL_BELOW)
    figure.advance(fig, STEP)
    clip_hips = hips.position
    clip_chest = chest.rotation
    idle.solve(d, STEP)
    off = core.v3_len(core.v3_sub(hips.position, clip_hips)) + quat_angle(chest.rotation, clip_chest)
    println("  moving at ${idle.STILL_BELOW} m/s: ${off} from the clip")
    check("moving, it is the clip exactly", off < 0.000001)

    free(kept)
    free(top_times)
    idle.idle_free(d)
    figure.figure_free(fig)
    core.model_free(group)
    if g_failures == 0 {
        println("idle: all checks passed (${g_checks})")
        return
    }
    println("idle: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
