// A standing figure's breath and weight shift (#592), the animator's
// breathing layer (animator.breathe_on, #860: ae3d.idle retired onto it),
// held to numbers on the box man fixture (tests/fixtures/gltf/humanoid.glb,
// Mixamo's names, its Idle playing), no window, stepped at 60 Hz over 30 s
// beside a twin playing the same Idle with no breathing:
//
//   - the chest's pitch over the twin's rises and falls by BREATH_PITCH,
//     a breath every BREATH_SECONDS or so, no two breaths alike;
//   - the hips sway across by WEIGHT_SHIFT either way over WEIGHT_SECONDS;
//   - the two are not in step;
//   - walking (its Walk at its ground speed, past BREATH_STILL), it is the
//     twin's pose exactly;
//   - no joint but the hips and the chest is moved.

import ae3d.core
import ae3d.engine
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

quat_angle(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// The most any joint but `hips` and `chest` differs between the two local
// poses: its turn plus its move.
others_moved(r: *pose.Rig, p: ptr, q: ptr, hips: int, chest: int) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        if j != hips && j != chest {
            moved = quat_angle(pose.rotation(p, j), pose.rotation(q, j)) +
                    core.v3_len(core.v3_sub(pose.translation(p, j), pose.translation(q, j)))
            if moved > most { most = moved }
        }
        j = j + 1
    }
    return most
}

main() {
    println("idle: breathing and the weight shifting on the animator (#592, #860)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    o = figure.figure(e, "Breather", PATH)
    twin_o = figure.figure(e, "Twin", PATH)
    a = animator.attach(e, o)
    twin = animator.attach(e, twin_o)
    if a == null || twin == null {
        println("idle: SKIP ${PATH} would not load")
        return
    }
    r = animator.rig(a)
    idle_s = animator.add_state(a, "idle", animator.take(a, "Idle", false), true)
    walk_s = animator.add_state(a, "walk", animator.take(a, "Walk", true), true)
    twin_idle = animator.add_state(twin, "idle", animator.take(twin, "Idle", false), true)
    twin_walk = animator.add_state(twin, "walk", animator.take(twin, "Walk", true), true)
    animator.play(a, idle_s, 0.0)
    animator.play(twin, twin_idle, 0.0)
    animator.breathe_on(a, 0)
    hips = pose.human(r, pose.PELVIS)
    chest = pose.human(r, pose.SPINE_03)
    check("the box man's hips and chest are found, the breathing on", hips >= 0 && chest >= 0)
    // Metres in the rig's units.
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    w = pose.new(r)
    tw = pose.new(r)
    breath_low = 1.0
    breath_high = 0.0 - 1.0
    sway_low = 1.0
    sway_high = 0.0 - 1.0
    others = 0.0
    applied = 0.0                    // the most the joints' own change differs from the layer's
    tops = 0
    last_breath = 0.0
    rising = false
    top_times = calloc(64, 8)
    tt = top_times as float[]
    product = 0.0
    breath_sq = 0.0
    sway_sq = 0.0
    seconds = 0.0
    step = 0
    while step < 60 * 30 {
        animator.update_now(a, STEP)
        animator.update_now(twin, STEP)
        seconds = seconds + STEP
        p = animator.pose_now(a)
        q = animator.pose_now(twin)
        moved = others_moved(r, p, q, hips, chest)
        if moved > others { others = moved }
        br = animator.breath(a)
        sw = animator.sway(a)
        // The joints themselves: the chest turned by the breath, the hips
        // moved by the sway, in metres over the ground.
        pose.world(r, p, w)
        pose.world(r, q, tw)
        turned = quat_angle(pose.rotation(p, chest), pose.rotation(q, chest))
        shifted = core.v3_len(core.v3_sub(pose.translation(w, hips), pose.translation(tw, hips))) / unit
        miss = core.abs_of(turned - br)
        if core.abs_of(shifted - core.abs_of(sw)) > miss { miss = core.abs_of(shifted - core.abs_of(sw)) }
        if miss > applied { applied = miss }
        if br < breath_low { breath_low = br }
        if br > breath_high { breath_high = br }
        if sw < sway_low { sway_low = sw }
        if sw > sway_high { sway_high = sw }
        if br > last_breath { rising = true } else if rising {
            if tops < 64 { tt[tops] = seconds }
            tops = tops + 1
            rising = false
        }
        last_breath = br
        // How alike the two are, centred: their correlation.
        bc = br - animator.BREATH_PITCH * 0.5
        product = product + bc * sw
        breath_sq = breath_sq + bc * bc
        sway_sq = sway_sq + sw * sw
        step = step + 1
    }
    // Breaths' lengths: the shortest and longest.
    shortest = 100.0
    longest = 0.0
    i = 1
    while i < tops && i < 64 {
        gap = tt[i] - tt[i - 1]
        if gap < shortest { shortest = gap }
        if gap > longest { longest = gap }
        i = i + 1
    }
    together = product / core.sqrt_of(breath_sq * sway_sq)
    println("  over 30 s: the chest pitched ${breath_low} to ${breath_high} rad (${animator.BREATH_PITCH}); ${tops} breaths, ${shortest} to ${longest} s long; the hips swayed ${sway_low} to ${sway_high} m (${animator.WEIGHT_SHIFT}); the two correlate ${together}; other joints moved ${others} at most")
    check("the chest rises and falls by its breath", breath_low < 0.001 && core.abs_of(breath_high - animator.BREATH_PITCH) < 0.002)
    check("a breath every BREATH_SECONDS or so, no two alike", tops >= 6 && shortest > animator.BREATH_SECONDS * 0.8 && longest < animator.BREATH_SECONDS * 1.25 && longest - shortest > 0.1)
    check("the hips sway across by WEIGHT_SHIFT either way", core.abs_of(sway_high - animator.WEIGHT_SHIFT) < 0.002 && core.abs_of(sway_low + animator.WEIGHT_SHIFT) < 0.002)
    check("the breath and the sway are not in step (correlation under 0.3)", core.abs_of(together) < 0.3)
    check("no joint but the hips and the chest is moved", others < 0.000001)
    println("  the chest's own turn and the hips' own shift against the layer's: ${applied} at most")
    check("the chest turns by the breath and the hips move by the sway, as drawn", applied < 0.0001)

    // Walking: the twin's pose exactly, once the change into the walk has
    // eased out on both.
    animator.play(a, walk_s, 0.0)
    animator.play(twin, twin_walk, 0.0)
    step = 0
    while step < 30 {
        animator.update_now(a, STEP)
        animator.update_now(twin, STEP)
        step = step + 1
    }
    speed = animator.ground_speed(a)
    off = others_moved(r, animator.pose_now(a), animator.pose_now(twin), 0 - 1, 0 - 1)
    println("  walking at ${speed} m/s (breathing gone at ${animator.BREATH_STILL}): ${off} from the twin")
    check("walking, it is the twin's pose exactly", speed >= animator.BREATH_STILL && off < 0.000001 && animator.breath(a) == 0.0 && animator.sway(a) == 0.0)

    pose.release(w)
    pose.release(tw)
    free(top_times)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("idle: all checks passed (${g_checks})")
        return
    }
    println("idle: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
