// What each client is sent (#474): relevance and a budget. A host and four
// clients in one process over a loopback link (50 ms, 10 ms of jitter, 2%
// lost), on the test's own clock; 500 replicated objects over a field
// 380 m by 300 m, every one of them turning on a circle of its own so
// every one always has something new to send, and four players at
// different places. Relevance is 60 m round a client's player; what a
// client draws is within 50 m (its view distance). Held to numbers:
//
//   - each client's snapshots stay within its budget, and the budgets are
//     binding: what is relevant would take more;
//   - an object at a client's player never waits more than a tick, while
//     the far edge of its relevance waits its turn;
//   - an object farther than the radius from every player is never sent;
//     one set always relevant is sent to all, one set never to none;
//   - a client walking toward a crate has it before the crate is within
//     its view distance;
//   - what the budget buys: the bytes a client costs, and how long the
//     objects at each distance wait, against no budget.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.net

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern cos(x: float) -> float
extern sin(x: float) -> float
extern sqrt(x: float) -> float

const CLIENTS = 4
const FIELD = 500                    // objects on the field
const COLUMNS = 25
const SPACING = 15.8
const STEPS = 480                    // eight seconds at 60 steps a second
const STEP = 0.016666666666666666
const RELEVANCE = 60.0
const VIEW = 50.0
const WALK = 5.0                     // m/s: client 1 toward the crate

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Where each client's player starts: four corners of the field's middle,
// client 1 facing the crate 80 m north of it.
spawn_x(client: int) -> float {
    if client == 1 { return 0.0 - 60.0 }
    if client == 2 { return 90.0 }
    if client == 3 { return 0.0 - 120.0 }
    if client == 4 { return 140.0 }
    return 0.0
}

spawn_z(client: int) -> float {
    if client == 1 { return 0.0 - 60.0 }
    if client == 2 { return 60.0 }
    if client == 3 { return 100.0 }
    if client == 4 { return 0.0 - 110.0 }
    return 0.0
}

// A side: a world with a ground, its session, and the scene both sides
// build in the same order.
struct Side {
    world: *Engine
    session: *Net
    field: ptr                       // *GameObject[FIELD]
    near: ptr                        // *GameObject[CLIENTS]: one at each player's spawn
    crate: *GameObject               // 80 m ahead of client 1
    far: *GameObject                 // 250 m from every player
    always: *GameObject              // far, but always relevant
    never: *GameObject               // at client 2's feet, but never relevant
}

make_player(context: ptr, client: int) -> *CharacterController {
    e = context as *Engine
    o = engine.object(e, "Player ${client}", null)
    behaviour.object_set_position(o, core.vec3(spawn_x(client), 0.0, spawn_z(client)))
    return physics.character_controller(o, 0.3, 1.8)
}

thing(s: *Side, x: float, z: float) -> *GameObject {
    o = behaviour.object_new("thing")
    behaviour.object_set_position(o, core.vec3(x, 0.0, z))
    net.networked(s.session, o)
    return o
}

side_new(session: *Net) -> *Side {
    s = calloc(1, sizeof(Side)) as *Side
    s.world = engine.engine_new()
    physics.attach(s.world)
    ground = engine.object(s.world, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(300.0, 0.5, 300.0), physics.material(0.8, 0.0))
    s.session = session
    s.field = calloc(FIELD, 8)
    i = 0
    while i < FIELD {
        (s.field as ptr[])[i] = thing(s, field_x(i, 0.0), field_z(i, 0.0)) as ptr
        i = i + 1
    }
    s.near = calloc(CLIENTS, 8)
    c = 1
    while c <= CLIENTS {
        (s.near as ptr[])[c - 1] = thing(s, spawn_x(c) + 1.5, spawn_z(c)) as ptr
        c = c + 1
    }
    s.crate = thing(s, spawn_x(1), spawn_z(1) + 80.0)
    s.far = thing(s, 0.0 - 190.0, 150.0 + 100.0)
    s.always = thing(s, 190.0, 0.0 - 250.0)
    s.never = thing(s, spawn_x(2) - 1.0, spawn_z(2))
    net.set_player_maker(session, make_player, s.world as ptr)
    return s
}

side_free(s: *Side) {
    c = 0
    while c <= CLIENTS {
        pl = net.player_of(s.session, c)
        if pl != null { physics.character_free(pl.controller) }
        c = c + 1
    }
    net.net_free(s.session)
    i = 0
    while i < FIELD {
        behaviour.object_free((s.field as ptr[])[i] as *GameObject)
        i = i + 1
    }
    c = 0
    while c < CLIENTS {
        behaviour.object_free((s.near as ptr[])[c] as *GameObject)
        c = c + 1
    }
    behaviour.object_free(s.crate)
    behaviour.object_free(s.far)
    behaviour.object_free(s.always)
    behaviour.object_free(s.never)
    free(s.field)
    free(s.near)
    engine.engine_free(s.world)
    free(s as ptr)
}

// Field object i at time t: its grid point, and a circle of a metre round
// it at a radian a second, each a radian further on.
field_x(i: int, t: float) -> float {
    return ((i % COLUMNS) as float) * SPACING - 190.0 + cos(t + (i as float))
}

field_z(i: int, t: float) -> float {
    return ((i / COLUMNS) as float) * SPACING - 150.0 + sin(t + (i as float))
}

// Everything that moves, moved on the host: the field on its circles
// (each turned along its circle, so its rotation changes too), and the
// objects at the players' spawns likewise.
move_host(s: *Side, t: float) {
    i = 0
    while i < FIELD {
        o = (s.field as ptr[])[i] as *GameObject
        behaviour.object_set_position(o, core.vec3(field_x(i, t), 0.0, field_z(i, t)))
        behaviour.object_set_rotation(o, core.quat_rotate(t + (i as float), core.vec3(0.0, 1.0, 0.0)))
        i = i + 1
    }
    c = 1
    while c <= CLIENTS {
        o = (s.near as ptr[])[c - 1] as *GameObject
        behaviour.object_set_position(o, core.vec3(spawn_x(c) + 1.5 * cos(t * 2.0), 0.0, spawn_z(c) + 1.5 * sin(t * 2.0)))
        c = c + 1
    }
}

where(pl: *NetPlayer) -> Vec3 {
    return behaviour.object_position(pl.controller.object as *GameObject)
}

// One run: a host and four clients for STEPS, with a budget for each
// client or none. What it measured.
struct BudgetRun {
    largest: ptr                     // int[CLIENTS]
    per_second: ptr                  // float[CLIENTS]: snapshot bytes a second
    budget: ptr                      // int[CLIENTS]
    near_wait: int                   // the most an object at a player waited, any client
    edge_wait: int                   // the most any relevant object waited, any client
    relevant: int                    // field objects within the radius of client 4's player at the end
    far_known: bool                  // any client ever had the far object
    always_known: int                // clients that have the always-relevant one
    never_known: bool                // any client ever had the never-relevant one
    crate_at: float                  // client 1's distance to the crate when it first had it
    crate_known: bool
    snapshots: int                   // client 4's snapshots taken
}

run(budgets: bool) -> *BudgetRun {
    result = calloc(1, sizeof(BudgetRun)) as *BudgetRun
    result.largest = calloc(CLIENTS, 4)
    result.per_second = calloc(CLIENTS, 8)
    result.budget = calloc(CLIENTS, 4)
    result.crate_at = 0.0 - 1.0
    hub = net.hub_new()
    net.hub_set_conditions(hub, 0.05, 0.01, 0.02)
    host = side_new(net.host_loopback(hub))
    net.set_relevance(host.session, RELEVANCE)
    net.set_relevant(host.session, host.always, net.RELEVANT_ALWAYS)
    net.set_relevant(host.session, host.never, net.RELEVANT_NEVER)
    // A budget of 400 bytes a tick for every client, and 250 for the
    // fourth (a slower link), from its first snapshot.
    if budgets {
        net.set_budget(host.session, 400)
        k = 0
        while k < CLIENTS {
            (result.budget as int[])[k] = 400
            k = k + 1
        }
        (result.budget as int[])[CLIENTS - 1] = 250
    }
    clients = calloc(CLIENTS, 8)
    c = 0
    while c < CLIENTS {
        (clients as ptr[])[c] = side_new(net.join_loopback(hub)) as ptr
        c = c + 1
    }
    step = 0
    while step < STEPS {
        now = (step as float) * STEP
        // The fourth's own, as soon as the host has it (before its welcome,
        // so before any snapshot).
        if budgets { net.set_client_budget(host.session, CLIENTS, 250) }
        move_host(host, now)
        // Client 1 walks north toward the crate from a second in; the
        // others stand where they began.
        k = 0
        while k < CLIENTS {
            s = (clients as ptr[])[k] as *Side
            walk = core.vec3(0.0, 0.0, 0.0)
            if k == 0 && now >= 1.0 { walk = core.vec3(0.0, 0.0, WALK) }
            if net.my_player(s.session) != null { net.player_input(s.session, walk, 0.0, now) }
            k = k + 1
        }
        net.step(host.session, now)
        k = 0
        while k < CLIENTS {
            s = (clients as ptr[])[k] as *Side
            net.step(s.session, now)
            if net.known(s.session, net.id_of(s.session, s.far)) { result.far_known = true }
            if net.known(s.session, net.id_of(s.session, s.never)) { result.never_known = true }
            k = k + 1
        }
        one = (clients as ptr[])[0] as *Side
        if !result.crate_known && net.known(one.session, net.id_of(one.session, one.crate)) {
            result.crate_known = true
            mine = net.player_of(host.session, net.client_id(one.session))
            if mine != null {
                at = where(mine)
                crate = behaviour.object_position(host.crate)
                result.crate_at = core.v3_len(core.v3_sub(at, crate))
            }
        }
        step = step + 1
    }
    seconds = (STEPS as float) * STEP
    k = 1
    while k <= CLIENTS {
        (result.largest as int[])[k - 1] = net.largest_snapshot(host.session, k)
        (result.per_second as float[])[k - 1] = (net.snapshot_bytes(host.session, k) as float) / seconds
        s = (clients as ptr[])[k - 1] as *Side
        if net.known(s.session, net.id_of(s.session, s.always)) { result.always_known = result.always_known + 1 }
        near_id = net.id_of(host.session, (host.near as ptr[])[k - 1] as *GameObject)
        wait = net.worst_wait(host.session, k, near_id)
        if wait > result.near_wait { result.near_wait = wait }
        i = 1
        while i <= net.networked_count(host.session) {
            w = net.worst_wait(host.session, k, i)
            if w > result.edge_wait { result.edge_wait = w }
            i = i + 1
        }
        k = k + 1
    }
    // What is relevant to client 4, standing still: the field within the
    // radius of its player.
    four = net.player_of(host.session, 4)
    if four != null {
        at = where(four)
        i = 0
        while i < FIELD {
            o = (host.field as ptr[])[i] as *GameObject
            if core.v3_len(core.v3_sub(behaviour.object_position(o), at)) <= RELEVANCE { result.relevant = result.relevant + 1 }
            i = i + 1
        }
    }
    result.snapshots = net.snapshots_received(((clients as ptr[])[3] as *Side).session)
    c = 0
    while c < CLIENTS {
        side_free((clients as ptr[])[c] as *Side)
        c = c + 1
    }
    free(clients)
    side_free(host)
    net.hub_free(hub)
    return result
}

run_free(r: *BudgetRun) {
    free(r.largest)
    free(r.per_second)
    free(r.budget)
    free(r as ptr)
}

main() {
    println("budget: 500 objects on a field, a host and four clients, relevance 60 m, 50 ms latency, 10 ms jitter, 2% loss")
    open = run(false)
    tight = run(true)
    k = 0
    while k < CLIENTS {
        println("  client ${k + 1}: no budget, snapshots up to ${(open.largest as int[])[k]} bytes, ${(open.per_second as float[])[k] / 1024.0} KB a second; a budget of ${(tight.budget as int[])[k]}, up to ${(tight.largest as int[])[k]} bytes, ${(tight.per_second as float[])[k] / 1024.0} KB a second")
        k = k + 1
    }
    within = true
    binding = true
    k = 0
    while k < CLIENTS {
        if (tight.largest as int[])[k] > (tight.budget as int[])[k] { within = false }
        if (open.largest as int[])[k] <= (tight.budget as int[])[k] { binding = false }
        k = k + 1
    }
    check("every client's snapshots stay within its budget", within)
    check("and the budgets bind: without them, every client's snapshots were larger", binding)
    println("  client 4 has ${tight.relevant} of the field's objects within its relevance; with its budget the object at its player waited at most ${tight.near_wait} tick(s), the slowest relevant one ${tight.edge_wait}; without, ${open.near_wait} and ${open.edge_wait}")
    check("an object at a client's player never waits more than a tick", tight.near_wait <= 1)
    check("and the far edge of the relevance waits its turn, sent within half a second", tight.edge_wait > tight.near_wait && tight.edge_wait <= 15)
    check("without a budget nothing waits", open.near_wait == 0 && open.edge_wait == 0)
    check("an object farther than the relevance from every player is never sent", !tight.far_known && !open.far_known)
    check("one set always relevant reaches every client, one set never reaches none", tight.always_known == CLIENTS && !tight.never_known && !open.never_known)
    println("  client 1, walking at ${WALK} m/s toward a crate 80 m off, had it ${tight.crate_at} m from it with its budget, ${open.crate_at} m without (relevance ${RELEVANCE} m, view ${VIEW} m)")
    check("a client walking toward an object has it before it is within view", tight.crate_known && tight.crate_at > VIEW && open.crate_at > VIEW)
    check("and the clients keep taking snapshots through it", tight.snapshots > 200)
    run_free(open)
    run_free(tight)
    if g_failures == 0 {
        println("budget: all checks passed (${g_checks})")
    } else {
        println("budget: ${g_failures} failure(s) of ${g_checks}")
    }
}
