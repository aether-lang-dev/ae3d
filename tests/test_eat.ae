// Sitting and eating from a bowl held in both hands (#825, its 3:
// motion.hold / eat / let_go), held to the numbers a game judges it by: the
// box man, POWERED, sat on a log 0.4 m high, given a bowl, takes three bites,
// lets go of it and stands up. No window.
//
//   - once it has taken the bowl (motion.TAKE on), each drawn palm is on a
//     grip of it, under 3 cm (#825's 3 cm off its handles), bites and all.
//     The palm is the forearm's line on past the drawn wrist as far as its
//     forearm's body reaches past it (the box man has no fingers: 4.5 cm);
//   - each bite brings the bowl up to its mouth: under 13 cm from it at the
//     top (the bowl is held BITE_AHEAD ahead of the mouth and BITE_UNDER
//     under it), and the mouth is the drawn head's, within 15 cm of it;
//   - its feet stay where they stood: neither toe slides more than 5 mm
//     along the ground, sitting, eating and standing up again;
//   - no body turns more than 6 degrees in a step (no pop): the hands go to
//     the bowl and back over motion.TAKE, not in a step;
//   - let go, its hands are back on its thighs, and it stands up, POWERED
//     and upright a second on.
//
// And sat again with a cup in its right hand (motion.hold_cup / drink), two
// sips: the right palm on the cup's grip (under 3 cm), the left hand on its
// thigh all the while (within 12 cm of its middle level-wise), at each
// sip's top the cup's rim within 6 cm of the mouth and tipped toward the
// face 40 degrees or more; its feet planted, no pop.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import ae3d.skin
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const SEAT_HIGH = 0.4
const GRIP = 0.09                     // m either side of the bowl's middle its grips are
const CUP_HIGH = 0.1                  // m: a cup's height, its grip at its side

var g_checks = 0
var g_failures = 0
var g_palm = 0.0                      // m the forearm's body reaches past the drawn wrist: the palm

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// The ankles' middle, as the bodies stand.
ankles(m: *Motion) -> Vec3 {
    r = m.ragdoll
    pose = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    physics.ragdoll_body_pose(r, pose)
    at = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, pose, human.BONE_CALF_L), physics.ragdoll_pose_end(r, pose, human.BONE_CALF_R)), 0.5)
    free(pose)
    return at
}

// A foot's toe: the end of its capsule farther from its ankle.
toe_at(m: *Motion, foot: int) -> Vec3 {
    bone = human.bone_at(physics.ragdoll_human(m.ragdoll), foot)
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.shape_id)
    a = core.v3_add(t.p, core.quat_apply(t.q, c.center1))
    b = core.v3_add(t.p, core.quat_apply(t.q, c.center2))
    ankle = core.v3_add(t.p, core.quat_apply(t.q, bone.local_frame_b.p))
    if core.v3_len(core.v3_sub(b, ankle)) > core.v3_len(core.v3_sub(a, ankle)) { return b }
    return a
}

along_ground(now: Vec3, was: Vec3) -> float {
    return core.v3_len(core.vec3(now.x - was.x, 0.0, now.z - was.z))
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

drawn(o: *GameObject, name: string) -> Vec3 {
    sk = figure.skeleton(figure.figure_of(o))
    b = skin.skeleton_bone(sk, skin.skeleton_find(sk, name))
    core.model_sync_transform(b)
    return b.world_position
}

// A drawn palm: the forearm's line on past the wrist by g_palm.
palm(o: *GameObject, side: string) -> Vec3 {
    wrist = drawn(o, "mixamorig:${side}Hand")
    elbow = drawn(o, "mixamorig:${side}ForeArm")
    return core.v3_add(wrist, core.v3_mul(core.v3_normalize(core.v3_sub(wrist, elbow)), g_palm))
}

// Each drawn palm to the grip nearer it, the farther of the two: both on
// the bowl when it is under 3 cm.
off_grips(o: *GameObject, bowl: *GameObject) -> float {
    at = behaviour.object_position(bowl)
    turn = behaviour.object_rotation(bowl)
    ga = core.v3_add(at, core.quat_apply(turn, core.vec3(GRIP, 0.0, 0.0)))
    gb = core.v3_add(at, core.quat_apply(turn, core.vec3(0.0 - GRIP, 0.0, 0.0)))
    hl = palm(o, "Left")
    hr = palm(o, "Right")
    one = core.v3_len(core.v3_sub(hl, ga))
    two = core.v3_len(core.v3_sub(hr, gb))
    crossed_one = core.v3_len(core.v3_sub(hl, gb))
    crossed_two = core.v3_len(core.v3_sub(hr, ga))
    worse = one
    if two > worse { worse = two }
    crossed = crossed_one
    if crossed_two > crossed { crossed = crossed_two }
    if crossed < worse { return crossed }
    return worse
}

// A figure sat on a log 0.4 m high before it, in a fresh engine.
struct Sat {
    e: *Engine
    o: *GameObject
    m: *Motion
}

seat_one() -> Sat {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    feet = ankles(m)
    spot = motion.sit_spot(m, core.vec3(0.0, SEAT_HIGH, 0.0), way)
    seat = core.vec3(feet.x - spot.x, SEAT_HIGH, feet.z - spot.z)
    log = engine.object(e, "Log", loader.cube(1.0))
    behaviour.object_set_rotation(log, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), way))
    behaviour.object_set_position(log, core.vec3(seat.x, SEAT_HIGH * 0.5, seat.z))
    physics.box_collider(log, core.vec3(0.6, SEAT_HIGH * 0.5, 0.2), physics.material(0.8, 0.0))
    engine.engine_update(e, STEP)
    motion.sit(m, seat, way)
    return Sat { e: e, o: o, m: m }
}

// Two sips from a cup in the right hand.
sips() {
    st = seat_one()
    e = st.e
    o = st.o
    m = st.m
    r = m.ragdoll
    cup = engine.object(e, "Cup", loader.cube(1.0))
    behaviour.object_set_scale(cup, core.vec3(0.07, CUP_HIGH, 0.07))
    count = physics.ragdoll_bone_count(r)
    was = calloc(count * 4, 8)
    last = was as float[]
    i = 0
    while i < count {
        q = physics.ragdoll_bone_rotation(r, i)
        last[i * 4] = q.x
        last[i * 4 + 1] = q.y
        last[i * 4 + 2] = q.z
        last[i * 4 + 3] = q.w
        i = i + 1
    }
    left0 = toe_at(m, human.BONE_FOOT_L)
    right0 = toe_at(m, human.BONE_FOOT_R)
    grip = core.vec3(0.0 - 0.045, 0.0, 0.0)
    took = 0 - 1
    held = false
    sipped = 0
    tops = 0
    peak = 0.0 - 1000.0
    going_down = false
    rim_close = 1000.0
    tipped = 0.0
    worst_grip = 0.0
    worst_lap = 0.0
    worst_turn = 0.0
    worst_feet = 0.0
    standing = false
    up_at = 0 - 1
    k = 0
    while k < 1500 {
        engine.engine_update(e, STEP)
        i = 0
        while i < count {
            q = physics.ragdoll_bone_rotation(r, i)
            t = turned_by(core.quat(last[i * 4], last[i * 4 + 1], last[i * 4 + 2], last[i * 4 + 3]), q)
            if up_at < 0 && t > worst_turn { worst_turn = t }
            last[i * 4] = q.x
            last[i * 4 + 1] = q.y
            last[i * 4 + 2] = q.z
            last[i * 4 + 3] = q.w
            i = i + 1
        }
        off = along_ground(toe_at(m, human.BONE_FOOT_L), left0)
        off_r = along_ground(toe_at(m, human.BONE_FOOT_R), right0)
        if off_r > off { off = off_r }
        if up_at < 0 && off > worst_feet { worst_feet = off }
        if !held && took < 0 && motion.seated(m) {
            held = motion.hold_cup(m, cup, grip, true)
            took = k
        }
        if held && motion.holding(m) && k > took + 36 {
            at = behaviour.object_position(cup)
            turn = behaviour.object_rotation(cup)
            g = core.v3_len(core.v3_sub(palm(o, "Right"), core.v3_add(at, core.quat_apply(turn, grip))))
            if g > worst_grip { worst_grip = g }
            lh = drawn(o, "mixamorig:LeftHand")
            lt = core.v3_mul(core.v3_add(drawn(o, "mixamorig:LeftUpLeg"), drawn(o, "mixamorig:LeftLeg")), 0.5)
            lap = core.v3_len(core.vec3(lh.x - lt.x, 0.0, lh.z - lt.z))
            if lap > worst_lap { worst_lap = lap }
            if !motion.eating(m) && sipped < 2 {
                if motion.drink(m) {
                    sipped = sipped + 1
                    peak = 0.0 - 1000.0
                    going_down = false
                }
            }
            if motion.eating(m) {
                if at.y > peak {
                    peak = at.y
                    up = core.quat_apply(turn, core.vec3(0.0, 1.0, 0.0))
                    rim = core.v3_add(at, core.v3_mul(up, CUP_HIGH * 0.5))
                    rim_close = core.v3_len(core.v3_sub(rim, motion.mouth(m)))
                    tipped = acos(core.clampf(up.y, 0.0 - 1.0, 1.0))
                } else if !going_down {
                    going_down = true
                    tops = tops + 1
                }
            }
            if sipped == 2 && !motion.eating(m) { motion.let_go(m) }
        }
        if held && !motion.holding(m) && !standing && sipped == 2 && k > took + 60 {
            standing = motion.stand_up(m)
        }
        if standing && up_at < 0 && !motion.acting(m) { up_at = k }
        if up_at >= 0 && k == up_at + 60 { k = 1500 }
        k = k + 1
    }
    free(was)
    println("  a cup: sips ${sipped}, ${tops} at the top; the rim ${rim_close * 100.0} cm from the mouth, tipped ${tipped * 57.29578} degrees at the top; the right palm ${worst_grip * 100.0} cm off the grip at the most, the left hand ${worst_lap * 100.0} cm from its thigh's middle; the toes slid ${worst_feet * 1000.0} mm; the worst turn in a step ${worst_turn * 57.29578} degrees")
    check("a cup: it takes it in its right hand, the palm on its grip (under 3 cm)", held && worst_grip < 0.03)
    check("a cup: its left hand stays on its thigh (within 12 cm of its middle level-wise)", worst_lap < 0.12)
    check("a cup: two sips, the rim at the lips (under 6 cm from the mouth) and tipped toward the face 40 degrees or more", sipped == 2 && tops >= 2 && rim_close < 0.06 && tipped > 0.698)
    check("a cup: its feet stay where they stood (under 5 mm)", worst_feet < 0.005)
    check("a cup: no body turns more than 6 degrees in a step (no pop)", worst_turn < 0.10472)
    check("a cup: it stands up, POWERED", standing && up_at >= 0 && motion.mode(m) == motion.POWERED)
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

main() {
    println("eat: sat on a log, a bowl in both hands, three bites, and up again (#825)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        println("eat: SKIP ${PATH} would not load")
        engine.engine_free(e)
        return
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    engine.engine_update(e, STEP)
    pz = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    physics.ragdoll_body_pose(r, pz)
    g_palm = core.v3_len(core.v3_sub(physics.ragdoll_pose_end(r, pz, human.BONE_LOWER_ARM_L), drawn(o, "mixamorig:LeftHand")))
    free(pz)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    feet = ankles(m)
    spot = motion.sit_spot(m, core.vec3(0.0, SEAT_HIGH, 0.0), way)
    seat = core.vec3(feet.x - spot.x, SEAT_HIGH, feet.z - spot.z)
    log = engine.object(e, "Log", loader.cube(1.0))
    behaviour.object_set_rotation(log, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), way))
    behaviour.object_set_position(log, core.vec3(seat.x, SEAT_HIGH * 0.5, seat.z))
    physics.box_collider(log, core.vec3(0.6, SEAT_HIGH * 0.5, 0.2), physics.material(0.8, 0.0))
    bowl = engine.object(e, "Bowl", loader.cube(1.0))
    behaviour.object_set_scale(bowl, core.vec3(0.18, 0.06, 0.16))
    engine.engine_update(e, STEP)

    count = physics.ragdoll_bone_count(r)
    was = calloc(count * 4, 8)
    last = was as float[]
    i = 0
    while i < count {
        q = physics.ragdoll_bone_rotation(r, i)
        last[i * 4] = q.x
        last[i * 4 + 1] = q.y
        last[i * 4 + 2] = q.z
        last[i * 4 + 3] = q.w
        i = i + 1
    }
    left0 = toe_at(m, human.BONE_FOOT_L)
    right0 = toe_at(m, human.BONE_FOOT_R)
    check("it sits", motion.sit(m, seat, way))
    phase = 0                          // 0 sitting down, 1 holding, 2 letting go, 3 standing up
    took = 0 - 1
    bites = 0
    bite_close = 1000.0
    bite_tops = 0
    worst_grip = 0.0
    worst_turn = 0.0
    worst_feet = 0.0
    mouth_off = 0.0
    lap_off = 1000.0
    up_at = 0 - 1
    standing = false
    peak = 0.0 - 1000.0
    going_down = false
    k = 0
    while k < 1500 {
        engine.engine_update(e, STEP)
        i = 0
        while i < count {
            q = physics.ragdoll_bone_rotation(r, i)
            t = turned_by(core.quat(last[i * 4], last[i * 4 + 1], last[i * 4 + 2], last[i * 4 + 3]), q)
            if up_at < 0 && t > worst_turn { worst_turn = t }
            last[i * 4] = q.x
            last[i * 4 + 1] = q.y
            last[i * 4 + 2] = q.z
            last[i * 4 + 3] = q.w
            i = i + 1
        }
        off = along_ground(toe_at(m, human.BONE_FOOT_L), left0)
        off_r = along_ground(toe_at(m, human.BONE_FOOT_R), right0)
        if off_r > off { off = off_r }
        if up_at < 0 && off > worst_feet { worst_feet = off }
        if phase == 0 && motion.seated(m) {
            check("sat, it takes the bowl", motion.hold(m, bowl, core.vec3(GRIP, 0.0, 0.0), core.vec3(0.0 - GRIP, 0.0, 0.0)))
            phase = 1
            took = k
        } else if phase == 1 {
            // Once taken, its hands on the bowl's grips, bites and all.
            if k > took + 36 {
                g = off_grips(o, bowl)
                if g > worst_grip { worst_grip = g }
            }
            if k > took + 36 && !motion.eating(m) && bites < 3 {
                if motion.eat(m) {
                    bites = bites + 1
                    peak = 0.0 - 1000.0
                    going_down = false
                }
            }
            if motion.eating(m) {
                at = behaviour.object_position(bowl)
                if at.y > peak {
                    peak = at.y
                    close = core.v3_len(core.v3_sub(at, motion.mouth(m)))
                    if close < bite_close || !going_down { bite_close = close }
                    head = drawn(o, "mixamorig:Head")
                    mouth_off = core.v3_len(core.v3_sub(motion.mouth(m), head))
                } else if !going_down {
                    going_down = true
                    bite_tops = bite_tops + 1
                }
            }
            if bites == 3 && !motion.eating(m) && k > took + 36 {
                motion.let_go(m)
                phase = 2
                took = k
            }
        } else if phase == 2 {
            if !motion.holding(m) && k > took + 40 {
                // The hands back on the thighs: each within 6 cm of the
                // thigh's top, between its hip and its knee.
                lh = drawn(o, "mixamorig:LeftHand")
                lt = core.v3_mul(core.v3_add(drawn(o, "mixamorig:LeftUpLeg"), drawn(o, "mixamorig:LeftLeg")), 0.5)
                lap_off = core.v3_len(core.vec3(lh.x - lt.x, 0.0, lh.z - lt.z))
                standing = motion.stand_up(m)
                phase = 3
            }
        } else if phase == 3 {
            if up_at < 0 && !motion.acting(m) { up_at = k }
            if up_at >= 0 && k == up_at + 60 { k = 1500 }
        }
        k = k + 1
    }
    free(was)
    println("  bites ${bites}, ${bite_tops} at the top; the bowl ${bite_close * 100.0} cm from the mouth at the top, the mouth ${mouth_off * 100.0} cm from the drawn head; the palms (${g_palm * 100.0} cm past the wrists) ${worst_grip * 100.0} cm off the grips at the most; let go, the left hand ${lap_off * 100.0} cm from its thigh's middle level-wise; the toes slid ${worst_feet * 1000.0} mm; the worst turn in a step ${worst_turn * 57.29578} degrees")
    check("it holds the bowl in both hands, each palm on a grip (under 3 cm), bites and all", took >= 0 && worst_grip < 0.03)
    check("three bites, each up to the mouth (the bowl under 13 cm from it at the top)", bites == 3 && bite_tops >= 3 && bite_close < 0.13)
    check("its mouth is the drawn head's (within 15 cm of it)", mouth_off < 0.15)
    check("let go, its hands are back on its thighs (the left within 12 cm of its thigh's middle level-wise)", lap_off < 0.12)
    check("its feet stay where they stood (under 5 mm along the ground)", worst_feet < 0.005)
    check("no body turns more than 6 degrees in a step (no pop)", worst_turn < 0.10472)
    println("  stood up: ${motion.mode_name(motion.mode(m))}, ${motion.tilt(m)} rad a second on")
    check("it stands up, POWERED and upright a second on (under 0.1 rad)", standing && up_at >= 0 && motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m))
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    sips()
    if g_failures > 0 {
        println("eat: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("eat: all checks passed (${g_checks})")
}
