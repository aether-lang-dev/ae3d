// The program's console on the agent channel (#510): log.tail and log.since
// over a real socket, one request a frame, as tests/test_agent_until.ae is.
//
// A script on "Talker" prints "talker says <frame>" each update; the
// engine's own behaviour (no object's) prints "program at <frame>" and
// writes "warned at <frame>" to stderr. So:
//   - a line carries the frame its script saw it printed in, exactly;
//   - a script's line names its object, the program's names none;
//   - stderr's lines are kept, and told as stderr;
//   - log.since gives only what came after, and next reads on from there;
//   - the console's own marks are in no line;
//   - count bounds an answer.
import std.os
import std.io
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour

extern exit(code: int)

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_next = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        io.stderr_write("  ok   ${name}\n")
    } else {
        g_failures = g_failures + 1
        io.stderr_write("  FAIL ${name}\n")
    }
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 1048576)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

text_of(r: ptr, name: string) -> string {
    if r == null { return "" }
    node = json.object_get_raw(r, name)
    if node == null || json.json_type(node) != 3 { return "" }
    return json.get_string_raw(node)
}

int_of(r: ptr, name: string) -> int {
    if r == null { return 0 - 1 }
    node = json.object_get_raw(r, name)
    if node == null { return 0 - 1 }
    return json.get_int(node)
}

talk(state: ptr, o: *GameObject, delta: float) {
    e = engine.running()
    println("talker says ${engine.engine_frame_count(e)}")
}

program_update(state: ptr, e: *Engine, delta: float) {
    println("program at ${engine.engine_frame_count(e)}")
    io.stderr_write("warned at ${engine.engine_frame_count(e)}\n")
}

// The number after `prefix` in `text`, or -1 when it does not start so.
number_after(text: string, prefix: string) -> int {
    if string.starts_with(text, prefix) != 1 { return 0 - 1 }
    v, err = string.to_int(string.substring(text, string.length(prefix), string.length(text)))
    if err != "" { return 0 - 1 }
    return v
}

main() {
    io.stderr_write("agent_console: the program's console over the channel\n")
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_HIDDEN", "1")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 1200)
    talker = engine.object(e, "Talker", loader.cube(1.0))
    engine.script(talker, "Chatter", null, null, talk)
    program = engine.behaviour_new("agent console test", null)
    program.update = program_update
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        io.stderr_write("agent_console: SKIP no window\n")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    check("the exchange finished (stage ${g_stage})", g_stage == 5)
    // After the engine: written through to the real stdout as the program
    // exits (the console drains its pipes and puts the streams back).
    if g_failures == 0 {
        println("agent_console: all checks passed (${g_checks})")
        return
    }
    io.stderr_write("agent_console: ${g_failures} of ${g_checks} checks FAILED\n")
    exit(1)
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        if engine.engine_frame_count(e) < 30 { return }
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("the client connects", sock != null)
        g_sock = sock
        ask_send("{\"id\":1,\"op\":\"log.tail\",\"count\":60}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    doc = ask_receive()
    if doc == null { return }
    respond(e, doc)
    json.free(doc)
}

respond(e: *Engine, doc: ptr) {
    r = result_of(doc)
    if g_stage == 1 {
        lines = json.object_get_raw(r, "lines")
        n = json.array_size(lines)
        talks = 0
        talks_right = 0
        programs = 0
        programs_right = 0
        warns = 0
        marks = 0
        k = 0
        while k < n {
            line = json.array_get_raw(lines, k)
            text = text_of(line, "text")
            frame = int_of(line, "frame")
            who = json.object_get_raw(line, "object")
            if string.index_of(text, "\u{1e}") >= 0 { marks = marks + 1 }
            said = number_after(text, "talker says ")
            if said >= 0 {
                talks = talks + 1
                if said == frame && who != null && text_of(who, "name") == "Talker" && text_of(line, "stream") == "out" { talks_right = talks_right + 1 }
            }
            at = number_after(text, "program at ")
            if at >= 0 {
                programs = programs + 1
                if at == frame && who == null { programs_right = programs_right + 1 }
            }
            warned = number_after(text, "warned at ")
            if warned >= 0 && warned == frame && text_of(line, "stream") == "err" { warns = warns + 1 }
            k = k + 1
        }
        check("log.tail gives at most what was asked (${n} of 60)", ok_of(doc) && n == 60)
        check("a script's line carries the frame it was printed in and its object (${talks_right} of ${talks})", talks > 5 && talks_right == talks)
        check("the program's own lines name no object, at their frame (${programs_right} of ${programs})", programs > 5 && programs_right == programs)
        check("stderr's lines are kept, told as stderr, at their frame (${warns})", warns > 5)
        check("and no console mark is in any line (${marks})", marks == 0)
        g_next = int_of(r, "next")
        ask_send("{\"id\":2,\"op\":\"log.since\",\"seq\":${g_next}}")
    } else if g_stage == 2 {
        lines = json.object_get_raw(r, "lines")
        first = json.array_get_raw(lines, 0)
        check("log.since gives what came after, and only that (from seq ${int_of(first, "seq")} after ${g_next})",
              ok_of(doc) && json.array_size(lines) > 0 && int_of(first, "seq") == g_next + 1)
        ask_send("{\"id\":3,\"op\":\"log.since\"}")
    } else if g_stage == 3 {
        reason = ""
        node = json.object_get_raw(doc, "error")
        if node != null { reason = json.get_string_raw(node) }
        check("log.since with no seq is refused, saying what it needs", !ok_of(doc) && string.contains(reason, "seq") == 1)
        ask_send("{\"id\":4,\"op\":\"log.tail\",\"count\":5000}")
    } else if g_stage == 4 {
        check("an answer is bounded at 1024 lines (${json.array_size(json.object_get_raw(r, "lines"))})",
              ok_of(doc) && json.array_size(json.object_get_raw(r, "lines")) <= 1024)
        g_stage = 5
        engine.engine_stop(e)
        return
    }
    g_stage = g_stage + 1
}
