// A frame's fence is waited on for a bounded time, and a wait that runs out
// says so (ae3d.vkframe).
//
// frame_wait and the wait at the start of a frame used to be vkWaitForFences
// with no timeout. A frame whose work never finishes (a lost submission, a
// driver that stalls) then held the thread that read it for good: the editor
// stopped answering and the CI job ran to its limit with nothing in the log
// naming what it waited for. Now the wait ends, the read returns nothing, the
// device error names the frame and the fence and what each had been through,
// and no later wait is tried (each would cost the same time again).
//
// A slot's fence is made unsignalled with nothing submitted to signal it,
// which is what such a frame looks like from the waiting side.

import std.string
import std.os
import ae3d.core
import ae3d.vulkan
import ae3d.vkframe
import ae3d.vkdevice
import ae3d.loader
extern exit(code: int)

const WIDTH = 160
const HEIGHT = 120

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

main() {
    if !vulkan.available() {
        println("vk fence wait: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("vk fence wait: SKIP Vulkan would not start (${vulkan.last_error()})")
        return
    }
    ball = loader.sphere(1.0, 24, 16)
    core.model_set_scale(ball, 30.0, 30.0, 30.0)
    core.model_set_diffuse(ball, 0.8, 0.3, 0.2)
    core.backend_add_model(&backend, ball)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 90.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))

    core.backend_render(&backend, cam, light)
    core.backend_render(&backend, cam, light)
    check_true("a frame that finished is read", vulkan.offscreen_pixels() != null)
    check_true("and its fence passes", vkframe.frame_wait(0) && vkframe.frame_wait(1))

    vkframe.set_fence_wait_ms(300)
    vkframe.hold_fence(0)
    vkframe.hold_fence(1)
    long t0 = os.now_unix_ms()
    pixels = vulkan.offscreen_pixels()
    long took = os.now_unix_ms() - t0
    check_true("a fence that never signals gives no pixels", pixels == null)
    check_true("and the read ends (${took} ms)", took < 5000)
    err = vkdevice.last_error()
    check_true("and the device error names the frame and its fence (${err})",
               string.contains(err, "did not signal") == 1 && string.contains(err, "fence statuses") == 1)

    // The next wait does not cost the time again.
    long t1 = os.now_unix_ms()
    again = vkframe.frame_wait(0)
    long second = os.now_unix_ms() - t1
    check_true("a second wait fails at once (${second} ms)", !again && second < 100)

    core.backend_cleanup(&backend)
    core.model_free(ball)
    vulkan.renderer_free(renderer)
    core.camera_free(cam)
    core.light_free(light)

    if failures > 0 { exit(1) }
    println("vk fence wait: all checks passed")
}
