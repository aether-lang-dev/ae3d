// ci: optimised -- its run is CPU work -O0 makes three to six times slower
// The cluster graph (#536): a mesh cut into clusters and simplified level
// over level, every cut of it at an error the whole surface and nothing
// more.
//
// For a sphere, an open plane, a sphere of two materials, the zombie's body,
// a street block's stone trim (hundreds of separate little pieces, which
// simplify only by going whole), a voxel ground (every quad its own
// vertices and texture coordinates, which hold every vertex where it is)
// and one in steps (its quads pieces):
// the first level holds every triangle once;
// no cluster passes its
// limits; up the graph errors and spheres only grow; at every threshold the
// clusters a view would draw close the surface -- every edge off the mesh's
// own rim walked as often one way as the other, so no crack -- and cover it
// once, their area the mesh's; and a coarser threshold draws fewer
// triangles.

import std.string
import std.os
import ae3d.core
import ae3d.geometry
import ae3d.loader
import ae3d.clusterlod

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// The clusters a view at error `tau` draws: those whose own error is at or
// under it and whose parent's is over. Their triangles' count, and into
// `out` (room for the mesh's triangles three times over, vertex indices).
cut(cm: *ClusterMesh, tau: float, out: int[]) -> int {
    n = 0
    k = 0
    while k < clusterlod.cluster_count(cm) {
        f = clusterlod.record(cm, k) as f32[]
        w = clusterlod.record(cm, k) as int[]
        if (f[clusterlod.REC_LOD_ERROR] as float) <= tau && (f[clusterlod.REC_PARENT_ERROR] as float) > tau {
            refs = clusterlod.vertex_refs(cm) as uint32[]
            tris = clusterlod.triangles(cm) as uint32[]
            t = 0
            while t < w[clusterlod.REC_TRIANGLES] {
                packed = tris[w[clusterlod.REC_TRIS] + t] as int
                out[n * 3] = refs[w[clusterlod.REC_REFS] + (packed & 255)] as int
                out[n * 3 + 1] = refs[w[clusterlod.REC_REFS] + ((packed >> 8) & 255)] as int
                out[n * 3 + 2] = refs[w[clusterlod.REC_REFS] + ((packed >> 16) & 255)] as int
                n = n + 1
                t = t + 1
            }
        }
        k = k + 1
    }
    return n
}

// Each position's id, welding vertices at the same place (as the build
// does), so edges are counted across seams.
positions(verts: f32[], count: int) -> int[] {
    ids = calloc(count, 4) as int[]
    i = 0
    while i < count {
        ids[i] = i
        j = 0
        while j < i {
            if verts[j * 9] == verts[i * 9] && verts[j * 9 + 1] == verts[i * 9 + 1] && verts[j * 9 + 2] == verts[i * 9 + 2] {
                ids[i] = ids[j]
                break
            }
            j = j + 1
        }
        i = i + 1
    }
    return ids
}

// Each edge of the triangles (between welded positions, degenerate ones
// left out), how many of them border it and how many more walk it low to
// high than high to low, into an open-addressed table of `cap` slots: the
// key's two ends packed, low id high.
tally(tris: int[], n: int, pos: int[], keys: long[], counts: int[], turns: int[], cap: int) {
    t = 0
    while t < n {
        k = 0
        while k < 3 {
            a = pos[tris[t * 3 + k]] as long
            b = pos[tris[t * 3 + (k + 1) % 3]] as long
            if a != b {
                lo = a
                hi = b
                turn = 1
                if b < a {
                    lo = b
                    hi = a
                    turn = 0 - 1
                }
                key = (lo << 32) | hi
                h = ((key * (2654435761 as long)) & ((cap - 1) as long)) as int
                while counts[h] != 0 && keys[h] != key { h = (h + 1) & (cap - 1) }
                keys[h] = key
                counts[h] = counts[h] + 1
                turns[h] = turns[h] + turn
            }
            k = k + 1
        }
        t = t + 1
    }
}

table_size(n: int) -> int {
    cap = 64
    while cap < n * 6 { cap = cap * 2 }
    return cap
}

// The mesh's rim: the positions on an edge not walked as often each way
// (its outline, an unwelded seam).
rim_of(tris: int[], n: int, pos: int[], positions: int) -> uint8[] {
    cap = table_size(n)
    keys = calloc(cap, 8) as long[]
    counts = calloc(cap, 4) as int[]
    turns = calloc(cap, 4) as int[]
    tally(tris, n, pos, keys, counts, turns, cap)
    rim = calloc(positions, 1) as uint8[]
    h = 0
    while h < cap {
        if counts[h] != 0 && turns[h] != 0 {
            rim[(keys[h] >> 32) as int] = 1
            rim[(keys[h] & (4294967295 as long)) as int] = 1
        }
        h = h + 1
    }
    free(keys as ptr)
    free(counts as ptr)
    free(turns as ptr)
    return rim
}

// The cut's cracks: edges off the mesh's own rim walked more one way than
// the other.
cracks(tris: int[], n: int, pos: int[], rim: uint8[]) -> int {
    cap = table_size(n)
    keys = calloc(cap, 8) as long[]
    counts = calloc(cap, 4) as int[]
    turns = calloc(cap, 4) as int[]
    tally(tris, n, pos, keys, counts, turns, cap)
    bad = 0
    h = 0
    while h < cap {
        if counts[h] != 0 && turns[h] != 0 {
            lo = (keys[h] >> 32) as int
            hi = (keys[h] & (4294967295 as long)) as int
            if rim[lo] == 0 || rim[hi] == 0 { bad = bad + 1 }
        }
        h = h + 1
    }
    free(keys as ptr)
    free(counts as ptr)
    free(turns as ptr)
    return bad
}

// The diagonal of the vertices' box.
size_of(verts: f32[], count: int) -> float {
    lx = 1.0e30
    ly = 1.0e30
    lz = 1.0e30
    hx = 0.0 - 1.0e30
    hy = 0.0 - 1.0e30
    hz = 0.0 - 1.0e30
    i = 0
    while i < count {
        x = verts[i * 9] as float
        y = verts[i * 9 + 1] as float
        z = verts[i * 9 + 2] as float
        if x < lx { lx = x }
        if y < ly { ly = y }
        if z < lz { lz = z }
        if x > hx { hx = x }
        if y > hy { hy = y }
        if z > hz { hz = z }
        i = i + 1
    }
    return sqrt((hx - lx) * (hx - lx) + (hy - ly) * (hy - ly) + (hz - lz) * (hz - lz))
}

// The triangles' area.
area_of(verts: f32[], tris: int[], n: int) -> float {
    sum = 0.0
    t = 0
    while t < n {
        a = tris[t * 3] * 9
        b = tris[t * 3 + 1] * 9
        c = tris[t * 3 + 2] * 9
        e1x = (verts[b] as float) - (verts[a] as float)
        e1y = (verts[b + 1] as float) - (verts[a + 1] as float)
        e1z = (verts[b + 2] as float) - (verts[a + 2] as float)
        e2x = (verts[c] as float) - (verts[a] as float)
        e2y = (verts[c + 1] as float) - (verts[a + 1] as float)
        e2z = (verts[c + 2] as float) - (verts[a + 2] as float)
        nx = e1y * e2z - e1z * e2y
        ny = e1z * e2x - e1x * e2z
        nz = e1x * e2y - e1y * e2x
        sum = sum + sqrt(nx * nx + ny * ny + nz * nz) * 0.5
        t = t + 1
    }
    return sum
}

// Every check over one mesh; `pieces` for one of separate pieces, whose
// coarse cuts leave the smallest out and so cover less of it; `seams` for
// one whose seams hold it, which the graph says it cannot simplify.
examine(name: string, mesh: ptr, ranges: ptr, range_count: int, pieces: bool, seams: bool) {
    println("== ${name}")
    vcount = geometry.mesh_vertex_count(mesh)
    icount = geometry.mesh_index_count(mesh)
    verts = geometry.mesh_vertex_data(mesh) as f32[]
    idx = geometry.mesh_index_data(mesh) as uint32[]
    started = os.now_monotonic_ns()
    cm = clusterlod.build(geometry.mesh_vertex_data(mesh), vcount, geometry.mesh_index_data(mesh), icount, ranges, range_count)
    total = icount / 3
    count = clusterlod.cluster_count(cm)
    ms = (os.now_monotonic_ns() - started) / 1000000
    println("       ${total} triangles: ${count} clusters over ${clusterlod.levels(cm)} levels, built in ${ms} ms")

    // The first level, every triangle once.
    level0 = 0
    over = 0
    grows = 0
    k = 0
    while k < count {
        w = clusterlod.record(cm, k) as int[]
        f = clusterlod.record(cm, k) as f32[]
        if w[clusterlod.REC_LEVEL] == 0 { level0 = level0 + w[clusterlod.REC_TRIANGLES] }
        if w[clusterlod.REC_TRIANGLES] > clusterlod.MAX_TRIANGLES || w[clusterlod.REC_VERTICES] > clusterlod.MAX_VERTICES { over = over + 1 }
        // Up the graph: the parent's error at least the cluster's, its
        // sphere around the cluster's.
        pe = f[clusterlod.REC_PARENT_ERROR] as float
        if pe < clusterlod.ROOT_ERROR * 0.5 {
            if pe < (f[clusterlod.REC_LOD_ERROR] as float) { grows = grows + 1 }
            dx = (f[clusterlod.REC_PARENT] as float) - (f[clusterlod.REC_LOD] as float)
            dy = (f[clusterlod.REC_PARENT + 1] as float) - (f[clusterlod.REC_LOD + 1] as float)
            dz = (f[clusterlod.REC_PARENT + 2] as float) - (f[clusterlod.REC_LOD + 2] as float)
            if sqrt(dx * dx + dy * dy + dz * dz) + (f[clusterlod.REC_LOD + 3] as float) > (f[clusterlod.REC_PARENT + 3] as float) * 1.0001 + 0.00001 {
                grows = grows + 1
            }
        }
        k = k + 1
    }
    // Every triangle that covers anything: one with two corners at one
    // place is left out.
    pos = positions(verts, vcount)
    covering = 0
    t = 0
    while t < total {
        pa = pos[idx[t * 3] as int]
        pb = pos[idx[t * 3 + 1] as int]
        pc = pos[idx[t * 3 + 2] as int]
        if pa != pb && pb != pc && pa != pc { covering = covering + 1 }
        t = t + 1
    }
    check("${name}: the first level holds every triangle that covers anything (${level0} of ${covering})", level0 == covering)
    check("${name}: no cluster past ${clusterlod.MAX_TRIANGLES} triangles or ${clusterlod.MAX_VERTICES} vertices (${over})", over == 0)
    check("${name}: up the graph errors and spheres only grow (${grows} that shrink)", grows == 0)
    share = clusterlod.coarsest_share(cm)
    if seams {
        check("${name}: the graph says it cannot simplify (its coarsest cut is ${share} of it)", share > 0.5)
    } else {
        check("${name}: the graph simplifies (${clusterlod.levels(cm)} levels, its coarsest cut ${share} of it)",
              clusterlod.levels(cm) > 2 && share < 0.1)
    }

    original = calloc(icount, 4) as int[]
    i = 0
    while i < icount {
        original[i] = idx[i] as int
        i = i + 1
    }
    rim = rim_of(original, total, pos, vcount)
    area = area_of(verts, original, total)
    size = size_of(verts, vcount)
    out = calloc(icount * 3 + 3, 4) as int[]
    // Thresholds from nothing to everything, as shares of the mesh's size:
    // each cut closed, of the mesh's area -- within 2% while fine, never
    // drawing a region twice; a coarse one between 80% and 110%, a few
    // dozen triangles round a sphere falling short of it -- and each
    // coarser one no larger.
    taus = [0.0, 0.0005, 0.002, 0.008, 0.032, 0.128, 1.0, 1.0e20]
    last = total + 1
    broken = 0
    doubled = 0
    larger = 0
    j = 0
    while j < 8 {
        n = cut(cm, taus[j] * size, out)
        bad = cracks(out, n, pos, rim)
        if bad > 0 {
            println("       at ${taus[j]}: ${n} triangles, ${bad} edges cracked")
            broken = broken + 1
        }
        area_share = area_of(verts, out, n) / area
        low = 0.8
        if pieces { low = 0.0 }
        high = 1.1
        if taus[j] <= 0.002 {
            low = 0.98
            high = 1.02
        }
        if area_share < low || area_share > high {
            println("       at ${taus[j]}: ${n} triangles, ${area_share} of the area")
            doubled = doubled + 1
        }
        if n > last { larger = larger + 1 }
        if j == 7 {
            println("       coarsest: ${n} triangles, ${area_share} of the area")
            if !seams { check("${name}: the coarsest cut is far smaller (${n} of ${total})", n * 8 < total) }
        }
        last = n
        j = j + 1
    }
    check("${name}: every cut closes the surface", broken == 0)
    check("${name}: every cut covers it once, its area the mesh's", doubled == 0)
    check("${name}: a coarser threshold never draws more", larger == 0)
    free(pos as ptr)
    free(original as ptr)
    free(rim as ptr)
    free(out as ptr)
    clusterlod.free_mesh(cm)
}

// A ground of `side` by `side` unit quads, each quad its own four vertices
// with its own texture coordinates, as a voxel world's faces are:
// neighbours meet only by position. In a gentle slope, every one meets its
// neighbours; `stepped`, in steps half a metre apart, many do not, and the
// ground is pieces -- the islands that a cluster's growth once left
// behind, a cluster's worth of them heaped into the first (a voxel world
// of half a million faces wrote past its cluster's room).
voxel_ground(side: int, stepped: bool) -> ptr {
    out = geometry.mesh_create()
    up = core.vec3(0.0, 1.0, 0.0)
    z = 0
    while z < side {
        x = 0
        while x < side {
            first = geometry.mesh_vertex_count(out)
            y0 = ((x + z) / 16) as float
            y1 = ((x + 1 + z) / 16) as float
            y2 = ((x + 1 + z + 1) / 16) as float
            y3 = ((x + z + 1) / 16) as float
            if stepped {
                y0 = ((x * 7 + z * 13) % 5) as float * 0.5
                y1 = y0
                y2 = y0
                y3 = y0
            }
            core.mesh_push_vertex(out, core.vec3(x as float, y0, z as float), 0.0, 0.0, up)
            core.mesh_push_vertex(out, core.vec3((x + 1) as float, y1, z as float), 1.0, 0.0, up)
            core.mesh_push_vertex(out, core.vec3((x + 1) as float, y2, (z + 1) as float), 1.0, 1.0, up)
            core.mesh_push_vertex(out, core.vec3(x as float, y3, (z + 1) as float), 0.0, 1.0, up)
            core.mesh_push_triangle(out, first, first + 2, first + 1)
            core.mesh_push_triangle(out, first, first + 3, first + 2)
            x = x + 1
        }
        z = z + 1
    }
    return out
}

// A street block's stone trim and coping, as the city draws them: one mesh
// of the block's seven pieces' files.
street_trim() -> ptr {
    names = ["L0_Trim", "L1_Trim", "R0_Trim", "R1_Trim", "L1_Coping", "L2_Coping", "R1_Pot1"]
    out = geometry.mesh_create()
    i = 0
    while i < 7 {
        m = loader.load_obj("resources/blender/zombie_street/Street_Block${names[i]}.obj", false)
        check("the trim's ${names[i]} loads", m != null)
        if m != null {
            piece = core.model_mesh(m)
            first = geometry.mesh_vertex_count(out)
            count = geometry.mesh_index_count(piece)
            shifted = calloc(count + 1, 4) as uint32[]
            from = geometry.mesh_index_data(piece) as uint32[]
            j = 0
            while j < count {
                shifted[j] = ((from[j] as int) + first) as uint32
                j = j + 1
            }
            geometry.mesh_append_raw(out, geometry.mesh_vertex_data(piece), geometry.mesh_vertex_count(piece),
                                     shifted as ptr, count)
            free(shifted as ptr)
            core.model_free(m)
        }
        i = i + 1
    }
    return out
}

main() {
    sphere = loader.sphere(1.0, 96, 48)
    examine("sphere", core.model_mesh(sphere), null, 0, false, false)
    core.model_free(sphere)
    plane = loader.plane(64, 0.25)
    examine("plane", core.model_mesh(plane), null, 0, false, false)
    core.model_free(plane)
    // A sphere's two halves as two materials: neither cut may open the seam
    // between them.
    halves = loader.sphere(1.0, 64, 32)
    hm = core.model_mesh(halves)
    half = (geometry.mesh_index_count(hm) / 6) * 3
    ranges = calloc(4, 4) as int[]
    ranges[0] = 0
    ranges[1] = half
    ranges[2] = half
    ranges[3] = geometry.mesh_index_count(hm) - half
    examine("two materials", hm, ranges as ptr, 2, false, false)
    free(ranges as ptr)
    core.model_free(halves)
    body = loader.load_obj("resources/blender/zombie_street/Zombie_Body.obj", false)
    check("the zombie's body loads", body != null)
    if body != null {
        examine("zombie body", core.model_mesh(body), null, 0, false, false)
        core.model_free(body)
    }
    trim = street_trim()
    examine("street trim", trim, null, 0, true, false)
    ground = voxel_ground(128, false)
    examine("voxel ground", ground, null, 0, false, true)
    geometry.mesh_destroy(ground)
    steps = voxel_ground(128, true)
    examine("stepped ground", steps, null, 0, true, false)
    geometry.mesh_destroy(steps)
    geometry.mesh_destroy(trim)
    if failures == 0 {
        println("clusterlod: all checks passed")
    } else {
        println("clusterlod: ${failures} failure(s)")
    }
}
