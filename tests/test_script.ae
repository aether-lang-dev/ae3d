// Scripts are components: a file built into a library, opened at run time,
// registered as a kind, and given to objects like any other component.
//
// The point is that the file was not compiled into the program: it is
// built separately (ci.sh's scripts step, scripts/build_script.sh) and
// opened here. What is held: each object a script is on has a state of its
// own; its fields are the kind's, read and written by name; a transient
// field is not saved; and a library opened again under the objects that
// carry it -- a rebuild -- keeps every object's fields while its states are
// made again by the new code.

import std.string
import std.json
import ae3d.core
import ae3d.loader
import ae3d.behaviour
import ae3d.component
import ae3d.script

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

opened(name: string) -> *Script {
    // Named the way the loader names one, not the way this machine happens
    // to: the suffix is the platform's.
    path = script.library_path("build/scripts/", name)
    s = script.script_open(path)
    string.free(path)
    return s
}

cube_object(scene: *Scene, name: string, y: float) -> *GameObject {
    m = loader.cube(1.0)
    core.model_set_position(m, 10.0, y, 0.0)
    o = behaviour.object_new(name)
    behaviour.object_set_model(o, m)
    o.owns_model = true
    behaviour.scene_add(scene, o)
    return o
}

main() {
    bob_lib = opened("bob")
    spin_lib = opened("spin")
    if bob_lib == null || spin_lib == null {
        // Not a skip: the build step runs before this, and a script that
        // will not open is what this test exists to catch.
        println("  FAIL a script would not open: ${script.last_error()}")
        println("script: 1 failure(s) of 1")
        return
    }
    check("built scripts open", true)

    bob = script.script_kind(bob_lib, "bob")
    spin = script.script_kind(spin_lib, "spin")
    check("a script is a kind, listed under Scripts", bob != null && string.equals(bob.category, "Scripts") == 1)
    check("with the fields its file declares", component.field_count(bob) == 3 &&
          component.field_named(bob, "height") != null)
    check("and its defaults from its constructor",
          near(component.field_default_float(bob, component.field_named(bob, "height")), 6.0))

    world = behaviour.scene_new()
    low = cube_object(world, "low", 0.0)
    high = cube_object(world, "high", 0.0)
    low_bob = component.add(low, bob)
    high_bob = component.add(high, bob)
    check("each object it is on has a state of its own", low_bob.state != high_bob.state)
    component.set_float(high_bob, component.field_named(bob, "height"), 12.0)

    // A quarter of the curve: the object rises by its height.
    step = 0
    while step < 60 {
        behaviour.scene_update(world, 0.7854 / 60.0)
        step = step + 1
    }
    low_y = behaviour.object_model(low).position.y
    high_y = behaviour.object_model(high).position.y
    println("  after a quarter of the curve: ${low_y} and ${high_y}")
    check("each bobs by its own height, not a shared one", low_y > 1.0 && high_y > low_y * 1.5)
    check("and each keeps its own clock", near(component.get_float(low_bob, component.field_named(bob, "clock")),
                                               component.get_float(high_bob, component.field_named(bob, "clock"))))

    saved = component.to_json(high_bob, false)
    check("its fields are saved by name, its clock is not",
          json.object_get_raw(saved, "height") != null && json.object_get_raw(saved, "clock") == null)
    json.free(saved)

    // A script with no start is a script with nothing to set up, and the
    // object still turns.
    spinner = cube_object(world, "spinner", 0.0)
    component.add(spinner, spin)
    before = behaviour.object_model(spinner).rotation.y
    behaviour.scene_update(world, 0.5)
    check("a script with only update runs", core.abs_of(behaviour.object_model(spinner).rotation.y - before) > 0.01)

    // The library opened again, as a rebuild is: the objects keep their
    // fields, their states are the new code's.
    rebuilt = opened("bob")
    held_state = high_bob.state
    script.script_reload(bob, bob_lib, rebuilt, world, null)
    script.script_close(bob_lib)
    check("a reload makes each state again", high_bob.state != null && high_bob.state != held_state)
    check("and keeps what each object was set to",
          near(component.get_float(high_bob, component.field_named(bob, "height")), 12.0) &&
          near(component.get_float(low_bob, component.field_named(bob, "height")), 6.0))
    check("and runs start again on the next frame", !high_bob.started)
    behaviour.scene_update(world, 0.1)
    check("the reloaded script runs", high_bob.started)

    behaviour.scene_free(world)
    component.kinds_clear()
    script.script_close(rebuilt)
    script.script_close(spin_lib)

    if g_failures == 0 {
        println("script: all checks passed (${g_checks})")
    } else {
        println("script: ${g_failures} failure(s) of ${g_checks}")
    }
}
