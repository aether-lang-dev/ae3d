// A change of clip under another module's writes (#673), held to numbers on
// the box man (its Walk and Run key the hips' place, its Idle does not), no
// window: the figure stepped by hand at 60 Hz, from Walk to Run and, four
// frames later, while that change still falls, to Idle.
//
//   - with another module lifting the hips each frame, a little
//     differently each frame as a gait's lift is, last frame's lift taken
//     off first, unless the figure put the hips' place back itself
//     (figure.put_back), as ae3d.locomotion and ae3d.feet do: under the lift, the
//     hips step no further in a frame than the clips' own largest step (and
//     a tenth), and come to rest where the figure's own hips do with no one
//     lifting them (to 1e-4 m), and stay there. The figure takes its own
//     offsets off each frame before it puts the next on, as every writer
//     takes its own last move off. It used to leave them on a place
//     another had moved, and the next frame's went on top: in the plaza a
//     standing walker's hips rose 28 cm and its legs folded under it.
//     Carrying no offset at all onto a place the new clip does not key
//     dropped the one still falling from the change to Run instead, a step
//     of 2.9 cm;
//   - with no other module, the figure's own hips step no further than the
//     clips' own (and a tenth) and stay where the changes left them.

import ae3d.core
import ae3d.skin
import ae3d.figure

extern fflush(stream: ptr) -> int
extern exit(code: int)
extern sin(x: float) -> float

const MAN = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666
const LIFT = 0.05                       // m the other module lifts the hips, give or take half

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
    fflush(null)
}

hips_of(f: *Figure) -> *Model {
    sk = figure.skeleton(f)
    return skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Hips"))
}

// The hips' largest step in one frame over `frames` of `name`.
own_step(f: *Figure, name: string, frames: int) -> float {
    hips = hips_of(f)
    figure.play(f, name, 1.0, true)
    figure.advance(f, STEP)
    last = hips.position
    most = 0.0
    k = 0
    while k < frames {
        figure.advance(f, STEP)
        d = core.v3_len(core.v3_sub(hips.position, last))
        if d > most { most = d }
        last = hips.position
        k = k + 1
    }
    return most
}

// The other module's lift for frame `k`, last frame's taken off first
// unless the figure put the hips' place back itself; 0 and nothing done
// when not `lifting`.
lift(f: *Figure, hips: *Model, k: int, lifted: float, lifting: bool) -> float {
    if !lifting { return 0.0 }
    under = hips.position.y
    if !figure.put_back(f, hips) { under = under - lifted }
    up = LIFT * (1.0 + 0.5 * sin((k as float) * 0.7))
    core.model_set_position(hips, hips.position.x, under + up, hips.position.z)
    return up
}

// Walk, Run, and Idle four frames later, the hips under the lift: their
// largest step in a frame, where they rest a second in, and how far they
// move after.
changes(lifting: bool) -> (float, Vec3, float) {
    group = core.model_new()
    f = figure.figure_new(MAN, group)
    hips = hips_of(f)
    figure.play(f, "Walk", 1.0, true)
    lifted = 0.0
    k = 0
    while k < 30 {
        figure.advance(f, STEP)
        lifted = lift(f, hips, k, lifted, lifting)
        k = k + 1
    }
    last = core.v3_sub(hips.position, core.vec3(0.0, lifted, 0.0))
    most = 0.0
    rest = last
    drift = 0.0
    n = 0
    while n < 90 {
        if n == 0 { figure.play_blended(f, "Run", 1.0, true, 0.3) }
        if n == 4 { figure.play_blended(f, "Idle", 1.0, true, 0.3) }
        figure.advance(f, STEP)
        lifted = lift(f, hips, k + n, lifted, lifting)
        now = core.v3_sub(hips.position, core.vec3(0.0, lifted, 0.0))
        d = core.v3_len(core.v3_sub(now, last))
        if d > most { most = d }
        if n == 60 { rest = now }
        if n > 60 {
            off = core.v3_len(core.v3_sub(now, rest))
            if off > drift { drift = off }
        }
        last = now
        n = n + 1
    }
    figure.figure_free(f)
    core.model_free(group)
    return most, rest, drift
}

main() {
    println("blend_writers: a change of clip under another module's writes (#673)")
    group = core.model_new()
    f = figure.figure_new(MAN, group)
    if f == null {
        println("blend_writers: SKIP ${MAN} would not load")
        return
    }
    walk = own_step(f, "Walk", 60)
    run = own_step(f, "Run", 60)
    own = walk
    if run > own { own = run }
    figure.figure_free(f)
    core.model_free(group)

    alone_most, alone_rest, alone_drift = changes(false)
    lifted_most, lifted_rest, lifted_drift = changes(true)
    apart = core.v3_len(core.v3_sub(lifted_rest, alone_rest))
    println("  the clips' own largest step of the hips: ${own * 100.0} cm")
    println("  alone: the hips' largest step ${alone_most * 100.0} cm, ${alone_drift * 100.0} cm on after the changes")
    println("  lifted ${LIFT * 100.0} cm, give or take half: the hips under the lift step ${lifted_most * 100.0} cm at most, rest ${apart * 100.0} cm from where they rest alone, ${lifted_drift * 100.0} cm on after")
    check("the figure's own hips step no further than the clips' own (and a tenth) and stay where the changes left them",
          alone_most <= own * 1.1 && alone_drift < 0.0001)
    check("under another module's lift, the hips step no further than the clips' own (and a tenth)", lifted_most <= own * 1.1)
    check("and come to rest where the figure's own do, and stay there (to 1e-4 m)", apart < 0.0001 && lifted_drift < 0.0001)

    if g_failures == 0 {
        println("blend_writers: all checks passed (${g_checks})")
    } else {
        println("blend_writers: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
