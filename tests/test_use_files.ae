// A figure using slots whose takes come from two files (#950, usable's
// `enter NAME from FILE`): the UE5 mannequin made a character (ae3d.character,
// on 100STYLE's gaits), whose own file is UAL2's, at a workbench whose enter
// and loop are UAL1's Interact and Idle_Loop read from UAL1's file, then at
// a chopping block whose loop is its own TreeChopping_Loop and which names no
// enter (#949). No window; stepped at 60 Hz. Named from one file alone, a
// camp's people could not take UAL1's Sitting and UAL2's Consume both.
//
//   - at the workbench its right hand lands on the tool's grip at the
//     Interact's contact (within 1 cm), the take read from UAL1's file and
//     retargeted;
//   - at the block it chops its own take there, held until it leaves, no
//     toe skating 5 mm while it does (ae3d.metrics).

import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.metrics
import ae3d.usable
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const KINDS = "tests/fixtures/usable/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The figure stood at `at` facing `yaw`, its springs and feet there.
place(c: *Character, at: Vec3, yaw: float) {
    o = character.object_of(c)
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    ikrig.feet_reset(character.feet_of(c))
}

main() {
    println("use_files: slots whose takes come from two files (#950)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Worker", MANNEQUIN, g)
    check("the mannequin made a character: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    r = animator.rig(a)
    m = metrics.meter_new(r, character.object_of(c))
    u = usable.usables_new(2.0)
    bench_kind = usable.kind_read("${KINDS}bench_ual1.usable")
    chop_kind = usable.kind_read("${KINDS}chop.usable")
    check("kinds read, the bench's takes naming UAL1's file: ${usable.kind_error()}", bench_kind != null && chop_kind != null)
    if bench_kind == null || chop_kind == null { exit(1) }
    bench = engine.object(e, "Bench", loader.cube(1.0))
    behaviour.object_set_position(bench, core.vec3(0.0, 0.0, 0.0))
    work = usable.add(u, bench, bench_kind)
    block = engine.object(e, "Block", null)
    behaviour.object_set_position(block, core.vec3(20.0, 0.0, 0.0))
    chop = usable.add(u, block, chop_kind)
    check("the bench's takes name UAL1's file", string_is(usable.slot_enter_from(u, work), "tests/fixtures/people/ual1_rigify.glb") && string_is(usable.slot_loop_from(u, work), "tests/fixtures/people/ual1_rigify.glb"))

    // The workbench, from 3 m in front of it.
    place(c, core.vec3(0.0, 0.0, 3.0), 3.1415926)
    used = character.use(c, u, work)
    off = 0.0 - 1.0
    k = 0
    while k < 1200 && off < 0.0 {
        engine.engine_update(e, STEP)
        if character.use_phase(c) == character.USE_ENTER && animator.current(a) == character.use_enter_state(c) && animator.state_time(a) >= character.use_contact(c) - 0.0001 && !animator.warping(a) {
            w = pose.new(r)
            pose.world(r, animator.pose_now(a), w)
            landed = clips.ground_point(r, pose.translation(w, pose.human(r, pose.HAND_R)))
            pose.release(w)
            off = core.v3_len(core.v3_sub(landed, usable.slot_at(u, work)))
        }
        k = k + 1
    }
    println("  at the workbench, UAL1's Interact read from its file: the right hand ${off * 100.0} cm off the tool's grip at the contact")
    check("at a workbench whose takes are UAL1's, read from that file, the right hand lands within 1 cm of the grip", used && off >= 0.0 && off < 0.01)
    character.leave(c)
    k = 0
    while k < 600 && character.using(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }

    // The chopping block, from 3 m off.
    place(c, core.vec3(20.0, 0.0, 0.0 - 3.0), 0.0)
    chopped = character.use(c, u, chop)
    k = 0
    while k < 1200 && character.use_phase(c) != character.USE_LOOP {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    metrics.meter_reset(m)
    k = 0
    while k < 120 {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    playing = animator.state_name(a, animator.current(a))
    held = character.use_phase(c) == character.USE_LOOP && usable.claimant(u, chop) == c as ptr
    slid = metrics.meter_worst(m, metrics.SKATE)
    println("  at the block: playing ${playing}, held ${held}; a toe skating ${slid * 1000.0} mm over 2 s")
    check("at a block naming no enter, it chops its own take there, held, no toe skating 5 mm", chopped && held && string_is(playing, "TreeChopping_Loop") && slid < 0.005)
    character.leave(c)
    k = 0
    while k < 600 && character.using(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    check("let go when it leaves", usable.claimant(u, chop) == null)

    metrics.meter_free(m)
    usable.usables_free(u)
    usable.kind_free(bench_kind)
    usable.kind_free(chop_kind)
    character.character_free(c)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("use_files: all checks passed (${g_checks})")
        return
    }
    println("use_files: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

string_is(a: string, b: string) -> bool { return string.equals(a, b) == 1 }
