// The frame is light until the composite makes it a picture (#656), on both
// backends.
//
//   - A clear colour is given as it shows, and shows as given: the scene
//     holds it as the light the tone curve takes back to it.
//   - Light past white is not clipped where it is drawn: two glowing
//     surfaces, one four times the other and both past what a display
//     target could hold, show as two different greys, each what the tone
//     curve makes of its light.
//   - A colour texture is sampled as light: a mid-grey texel is the light
//     its sRGB byte decodes to, not the byte read as a fraction.
//
// The frame is dithered by half a step either way, so a shown value is
// held to within two of what the curve says.
//   - A capture channel is the surfaces' own numbers: the albedo of a grey
//     comes out as the grey, with no tone curve over it.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.png

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 160
const HEIGHT = 120
const GREY_TEXTURE = "build/test_hdr_grey.png"

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// The centre pixel's channel `c` of the frame just drawn, 0..255.
centre(backend: *Backend, cam: *Camera, light: *Light, c: int) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    return mem.get_byte(pixels, ((HEIGHT / 2) * WIDTH + WIDTH / 2) * 4 + c)
}

// What light `x` shows as, in the frame's bytes.
shown(x: float) -> int { return (core.displayed_of(x) * 255.0 + 0.5) as int }

near(got: int, want: int, slack: int) -> bool {
    d = got - want
    if d < 0 { d = 0 - d }
    return d <= slack
}

// A 4 by 4 texture of one grey byte, written where the test can load it.
write_grey_texture() -> bool {
    pixels = calloc(16, 4)
    i = 0
    while i < 16 {
        png.rgba_set(pixels, i, 128.0 / 255.0, 128.0 / 255.0, 128.0 / 255.0, 1.0)
        i = i + 1
    }
    written = png.write(GREY_TEXTURE, pixels, 4, 4)
    free(pixels)
    return written
}

// A cube filling the middle of the view, glowing at `strength` times its
// colour (a material exposure of ten is one; it glows past one).
glowing(strength: float) -> *Model {
    cube = loader.cube(1.0)
    core.model_set_scale(cube, 8.0, 8.0, 8.0)
    core.model_set_diffuse(cube, 1.0, 1.0, 1.0)
    core.model_set_exposure(cube, strength * 10.0)
    return cube
}

set_capture(gl_r: *GLRenderer, vk_r: *VKRenderer, channel: int) {
    if gl_r != null { gl.renderer_set_capture_channel(gl_r, channel) }
    if vk_r != null { vulkan.renderer_set_capture_channel(vk_r, channel) }
}

run_checks(backend: *Backend, name: string, gl_r: *GLRenderer, vk_r: *VKRenderer) {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 20.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.0, 1.0, 0.0))

    // Nothing drawn: the clear colour, as given.
    core.backend_set_clear_color(backend, 0.25, 0.5, 0.75)
    r = centre(backend, cam, light, 0)
    g = centre(backend, cam, light, 1)
    b = centre(backend, cam, light, 2)
    println("  ${name}: the clear (0.25, 0.5, 0.75) shows as (${r}, ${g}, ${b})")
    check("${name} a clear colour shows as it was given", near(r, 64, 2) && near(g, 128, 2) && near(b, 191, 2))
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)

    // Past white, twice over.
    dim = glowing(1.2)
    core.backend_add_model(backend, dim)
    dim_shown = centre(backend, cam, light, 1)
    core.backend_remove_model(backend, dim)
    core.model_free(dim)
    bright = glowing(4.0)
    core.backend_add_model(backend, bright)
    bright_shown = centre(backend, cam, light, 1)
    core.backend_remove_model(backend, bright)
    core.model_free(bright)
    println("  ${name}: light 1.2 shows as ${dim_shown} (the curve: ${shown(1.2)}), light 4 as ${bright_shown} (${shown(4.0)})")
    check("${name} light past white is not clipped where it is drawn", bright_shown > dim_shown && bright_shown < 255)
    check("${name} each shows as the tone curve makes it", near(dim_shown, shown(1.2), 2) && near(bright_shown, shown(4.0), 2))

    // A grey texel, glowing at two: its light is twice the byte decoded.
    textured = glowing(2.0)
    core.model_set_texture(textured, GREY_TEXTURE)
    core.backend_add_model(backend, textured)
    grey = centre(backend, cam, light, 1)
    decoded = 2.0 * core.srgb_decode_of(128.0 / 255.0)
    println("  ${name}: the grey texel shows as ${grey}: decoded ${shown(decoded)}, read as a fraction ${shown(2.0 * 128.0 / 255.0)}")
    check("${name} a colour texture is sampled as light", near(grey, shown(decoded), 2))
    core.backend_remove_model(backend, textured)
    core.model_free(textured)

    // The albedo channel of a grey: the grey itself.
    matte = loader.cube(1.0)
    core.model_set_scale(matte, 8.0, 8.0, 8.0)
    core.model_matte(matte, 0.5, 0.5, 0.5)
    core.backend_add_model(backend, matte)
    set_capture(gl_r, vk_r, 1)
    albedo = centre(backend, cam, light, 1)
    set_capture(gl_r, vk_r, 0)
    println("  ${name}: a 0.5 albedo captures as ${albedo}")
    check("${name} a capture channel is the surface's own numbers", near(albedo, 128, 1))
    core.backend_remove_model(backend, matte)
    core.model_free(matte)

    core.camera_free(cam)
    core.light_free(light)
}

main() {
    println("hdr: the frame is light until the composite")
    check("the grey texture is written", write_grey_texture())
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("hdr: SKIP no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("hdr: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl", renderer, null)
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vulkan.available() {
        println("hdr: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vulkan.renderer_new()
        vk_pass = vulkan.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("hdr: SKIP Vulkan would not start (${vulkan.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan", null, vk_renderer)
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("hdr: all checks passed")
    } else {
        println("hdr: ${failures} failure(s)")
    }
}
