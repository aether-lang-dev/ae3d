// Balance that steps to catch itself (#414), held to numbers. POWERED
// figures on one ground, pushed at the chest a second in and asked three
// seconds later whether they stand and how many steps they took; each
// push twice, once with stepping and once without, in engines of their
// own. No window: the engine is stepped by hand.
//
// The pushes are the speed they give the whole body, whatever it weighs
// (#626): the figure weighs a person of its height (86 kg), stands on flat
// feet, and its balance assist holds no more than its feet could. A person
// holds about 0.5 m/s on their feet and steps out of more.
//
//   - a nudge (0.3 m/s) is held without a step: a figure standing still
//     sways, and marching in place is not balance;
//   - pushed forward (from behind) from 0.5 to 1.2 m/s, a figure that can
//     step holds a harder push than one that cannot, and the sweep finds
//     where standing still gives out (0.8 standing, 1.2 stepping);
//   - from the side, 0.8 and 1.0 m/s fell a figure that cannot step, and
//     one that can steps out of them: the far foot crosses in front of the
//     near one, which the shove has loaded, and the near one steps out
//     after it (#481). (0.6 still fells it: its steps after the crossing
//     land behind the body, #626.)
//   - a push onto the heels (0.3 m/s, from in front) is held, stepping or
//     not; one of 0.8 fells a figure that cannot step, and one that can
//     steps back out of it, the weight shifted onto the other foot first
//     (#578) and only once standing could not hold it (#606).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const PUSHES = 13
const SWEEP = 8                      // pushes 1 to 8: from behind, 0.5 m/s up by 0.1

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// The pushes, in order: a nudge from behind, the sweep from behind
// (forward), a push from the side, a push from in front (onto the heels).
// As speeds given the whole body, metres a second along the way pushed.
push_of(k: int) -> Vec3 {
    if k == 0 { return core.vec3(0.0, 0.0, 0.0 - 0.3) }
    if k <= SWEEP { return core.vec3(0.0, 0.0, 0.0 - sweep_of(k)) }
    if k == SWEEP + 1 { return core.vec3(0.8, 0.0, 0.0) }
    if k == SWEEP + 3 { return core.vec3(1.0, 0.0, 0.0) }
    if k == SWEEP + 4 { return core.vec3(0.0, 0.0, 0.8) }
    return core.vec3(0.0, 0.0, 0.3)
}

sweep_of(k: int) -> float { return 0.5 + 0.1 * ((k - 1) as float) }

push_name(k: int) -> string {
    if k == 0 { return "a 0.3 m/s nudge from behind" }
    if k <= SWEEP { return "${sweep_of(k)} m/s from behind" }
    if k == SWEEP + 1 { return "0.8 m/s from the side" }
    if k == SWEEP + 3 { return "1.0 m/s from the side" }
    if k == SWEEP + 4 { return "0.8 m/s from in front" }
    return "0.3 m/s from in front"
}

// The hardest push of the sweep held before the first that was not, or
// 0 when the first was not.
held_to(stood: int[]) -> float {
    held = 0.0
    k = 1
    while k <= SWEEP {
        if stood[k] != 1 { return held }
        held = sweep_of(k)
        k = k + 1
    }
    return held
}

// Every push on a figure of its own, stepping or not: whether each stands
// three seconds after (pelvis at or over 0.8 m), into `stood`, and the
// steps each took, into `steps`.
trial(stepping: bool, stood: ptr, steps: ptr) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    motions_block = calloc(PUSHES, 8)
    motions = motions_block as ptr[]
    rigs_block = calloc(PUSHES, 8)
    rigs = rigs_block as ptr[]
    k = 0
    while k < PUSHES {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 4.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        physics.ragdoll_dress(r, rig)
        rigs[k] = rig as ptr
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        motion.set_stepping(m, stepping)
        motions[k] = m as ptr
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, 1.0 / 60.0)
        step = step + 1
    }
    k = 0
    while k < PUSHES {
        m = motions[k] as *Motion
        chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
        motion.hit(m, human.BONE_SPINE_03, chest, core.v3_mul(push_of(k), physics.ragdoll_mass(m.ragdoll)))
        k = k + 1
    }
    step = 0
    while step < 180 {
        engine.engine_update(e, 1.0 / 60.0)
        step = step + 1
    }
    k = 0
    while k < PUSHES {
        m = motions[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        (stood as int[])[k] = 0
        if pelvis.y >= 0.8 { (stood as int[])[k] = 1 }
        (steps as int[])[k] = motion.steps_taken(m)
        k = k + 1
    }
    engine.engine_free(e)
    k = 0
    while k < PUSHES {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(motions_block)
    free(rigs_block)
}

main() {
    println("balance: pushes at the chest, with and without stepping")
    fixed_block = calloc(PUSHES, 8)
    stepping_block = calloc(PUSHES, 8)
    steps_block = calloc(PUSHES, 8)
    none_block = calloc(PUSHES, 8)
    trial(false, fixed_block, none_block)
    trial(true, stepping_block, steps_block)
    fixed = fixed_block as int[]
    stepped = stepping_block as int[]
    steps = steps_block as int[]
    k = 0
    while k < PUSHES {
        println("  ${push_name(k)}: without stepping it ${stand_word(fixed[k])}; stepping it ${stand_word(stepped[k])}, in ${steps[k]} steps")
        k = k + 1
    }
    side = SWEEP + 1
    front = SWEEP + 2
    still_holds = held_to(fixed)
    stepping_holds = held_to(stepped)
    println("  forward, standing still it holds ${still_holds} m/s; stepping, ${stepping_holds}")
    check("a nudge is held without a step", stepped[0] == 1 && steps[0] == 0)
    check("pushed forward, a figure that steps holds a harder push than one that cannot, which gives out within the sweep",
          stepping_holds > still_holds && fixed[SWEEP] == 0)
    check("0.8 m/s from the side fells a figure that cannot step, and one that can steps out of it", fixed[side] == 0 && stepped[side] == 1 && steps[side] >= 1)
    check("a push onto the heels is held, stepping or not", fixed[front] == 1 && stepped[front] == 1)
    // Past what standing still holds from the side, stepping catches it
    // (#481): a step taken for a step back, as the shove turned the figure a
    // little, had stopped every one after the first.
    hard_side = SWEEP + 3
    check("1.0 m/s from the side fells a figure that cannot step, and one that can steps out of it", fixed[hard_side] == 0 && stepped[hard_side] == 1)
    hard_front = SWEEP + 4
    // Past what standing still holds onto the heels, a step back catches it
    // (#606).
    check("0.8 m/s from in front fells a figure that cannot step, and one that can steps back out of it", fixed[hard_front] == 0 && stepped[hard_front] == 1 && steps[hard_front] >= 1)
    free(fixed_block)
    free(stepping_block)
    free(steps_block)
    free(none_block)
    if g_failures == 0 {
        println("balance: all checks passed (${g_checks})")
    } else {
        println("balance: ${g_failures} failure(s) of ${g_checks}")
    }
}

stand_word(standing: int) -> string {
    if standing == 1 { return "stands" }
    return "falls"
}
