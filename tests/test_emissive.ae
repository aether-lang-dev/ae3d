// A surface's own light (#12 of the game's asks): a lit window, a lamp's
// pane, a glTF's emissiveFactor. In the dark, on both renderers:
//   - a surface with none is black;
//   - one with an emissive colour shows that colour, its strength times it;
//   - one with an emissive map gives its light only where the map is white;
//   - OpenGL and Vulkan agree.
// Headless; a renderer that will not start here is said and left out.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.png

const WIDTH = 160
const HEIGHT = 90
const MAP = "build/emissive_map.png"

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

var g_checks = 0
var g_failures = 0
var g_gl_target: ptr = null

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A map white on its left half and black on its right.
write_map() {
    w = 16
    h = 16
    rgba = calloc(w * h, 4)
    y = 0
    while y < h {
        x = 0
        while x < w {
            v = 0
            if x < w / 2 { v = 255 }
            at = (y * w + x) * 4
            mem.set_byte(rgba, at, v)
            mem.set_byte(rgba, at + 1, v)
            mem.set_byte(rgba, at + 2, v)
            mem.set_byte(rgba, at + 3, 255)
            x = x + 1
        }
        y = y + 1
    }
    png.write(MAP, rgba, w, h)
    free(rgba)
}

frame_of(backend: *Backend) -> ptr {
    if g_gl_target != null { return offscreen.target_pixels(g_gl_target) }
    return core.backend_frame_pixels(backend)
}

// The red, green and blue at (x, y), as one number each in a block of three.
channels(pixels: ptr, x: int, y: int) -> (int, int, int) {
    at = (y * WIDTH + x) * 4
    return mem.get_byte(pixels, at), mem.get_byte(pixels, at + 1), mem.get_byte(pixels, at + 2)
}

// Three quads in a row, in the dark: plain, emissive orange, and emissive
// white through the half-white map. Each place's colour into `seen` (r g b,
// four places: plain, glowing, map's white half, map's black half).
run(backend: *Backend, name: string, seen: int[]) {
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)
    plain = loader.quad(4.0, 4.0)
    glowing = loader.quad(4.0, 4.0)
    mapped = loader.quad(4.0, 4.0)
    core.model_rotate(plain, 90.0, 0.0, 0.0)
    core.model_rotate(glowing, 90.0, 0.0, 0.0)
    core.model_rotate(mapped, 90.0, 0.0, 0.0)
    core.model_set_position(plain, 0.0 - 5.0, 0.0, 0.0)
    core.model_set_position(mapped, 5.0, 0.0, 0.0)
    core.model_matte(plain, 0.5, 0.5, 0.5)
    core.model_matte(glowing, 0.5, 0.5, 0.5)
    core.model_matte(mapped, 0.5, 0.5, 0.5)
    core.model_set_emissive(glowing, 1.0, 0.5, 0.0, 0.8)
    core.model_set_emissive(mapped, 1.0, 1.0, 1.0, 0.8)
    core.model_set_emissive_map(mapped, MAP)
    core.model_recalculate_bounds(plain)
    core.model_recalculate_bounds(glowing)
    core.model_recalculate_bounds(mapped)
    core.backend_add_model(backend, plain)
    core.backend_add_model(backend, glowing)
    core.backend_add_model(backend, mapped)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 10.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    // No light to speak of: what shows is the surfaces' own.
    dark = core.light_directional(core.vec3(0.0, 1.0, 0.0), core.vec3(0.0, 0.0, 0.0), 0.0)
    frame = 0
    while frame < 3 {
        core.backend_render(backend, cam, dark)
        frame = frame + 1
    }
    pixels = frame_of(backend)
    if pixels == null {
        check("${name}: the frame reads back", false)
    } else {
        places = [core.vec3(0.0 - 5.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0), core.vec3(4.0, 0.0, 0.0), core.vec3(6.0, 0.0, 0.0)]
        k = 0
        while k < 4 {
            p = core.camera_world_to_screen(cam, places[k], WIDTH, HEIGHT)
            r, g, b = channels(pixels, p.x as int, p.y as int)
            seen[k * 3] = r
            seen[k * 3 + 1] = g
            seen[k * 3 + 2] = b
            k = k + 1
        }
        println("    ${name}: plain ${seen[0]} ${seen[1]} ${seen[2]}; glowing ${seen[3]} ${seen[4]} ${seen[5]}; map white ${seen[6]} ${seen[7]} ${seen[8]}; map black ${seen[9]} ${seen[10]} ${seen[11]}")
        check("${name}: a surface with no light of its own is black in the dark", seen[0] + seen[1] + seen[2] < 30)
        check("${name}: one with an emissive orange shows orange", seen[3] > 120 && seen[4] > 40 && seen[4] < seen[3] && seen[5] < 30)
        check("${name}: one with an emissive map glows where the map is white", seen[6] > 120 && seen[7] > 120 && seen[8] > 120)
        check("${name}: and not where it is black", seen[9] + seen[10] + seen[11] < 30)
    }
    core.backend_remove_model(backend, plain)
    core.backend_remove_model(backend, glowing)
    core.backend_remove_model(backend, mapped)
    core.model_free(plain)
    core.model_free(glowing)
    core.model_free(mapped)
    core.light_free(dark)
    core.camera_free(cam)
}

main() {
    println("emissive: a surface's own light, in the dark, on both renderers")
    write_map()
    gl_block = calloc(12, 4)
    vk_block = calloc(12, 4)
    gl_seen = gl_block as int[]
    vk_seen = vk_block as int[]
    drew_gl = false
    drew_vk = false
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context != null {
        renderer = gl.renderer_new()
        pass = gl.backend(renderer)
        if core.backend_init(&pass, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            g_gl_target = target
            run(&pass, "opengl", gl_seen)
            g_gl_target = null
            drew_gl = true
            core.backend_cleanup(&pass)
            offscreen.target_destroy(target)
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    } else {
        println("emissive: no OpenGL context; OpenGL is not drawn")
    }
    if vulkan.available() {
        vr = vulkan.renderer_new()
        vpass = vulkan.backend(vr)
        if core.backend_init(&vpass, null, WIDTH, HEIGHT) {
            run(&vpass, "vulkan", vk_seen)
            drew_vk = true
            core.backend_cleanup(&vpass)
        }
        vulkan.renderer_free(vr)
    } else {
        println("emissive: no Vulkan driver; Vulkan is not drawn")
    }
    if drew_gl && drew_vk {
        worst = 0
        i = 0
        while i < 12 {
            d = gl_seen[i] - vk_seen[i]
            if d < 0 { d = 0 - d }
            if d > worst { worst = d }
            i = i + 1
        }
        check("OpenGL and Vulkan give the same light, to 24 of 255 a channel (${worst})", worst <= 24)
    }
    free(gl_block)
    free(vk_block)
    if !drew_gl && !drew_vk {
        println("emissive: SKIP neither renderer would draw here")
    } else if g_failures == 0 {
        println("emissive: all checks passed (${g_checks})")
    } else {
        println("emissive: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
