// Meshes uploaded on Vulkan by ae3d.vkmesh (#402): geometry that appears
// many times goes up once and is shared, a mesh edited after it was
// registered goes up again on its own without reshaping the models still
// sharing what it was, a mesh let go of by its last model frees its
// buffers, and the frame they draw is the one OpenGL draws.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.vkmesh
import ae3d.offscreen
import ae3d.loader

const WIDTH = 256
const HEIGHT = 192

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

// Three cubes, each built on its own from the same bytes, and a sphere,
// in a row across the frame.
build_row(pass_backend: *Backend) -> {
    a = loader.cube(1.0)
    b = loader.cube(1.0)
    c = loader.cube(1.0)
    ball = loader.sphere(1.0, 24, 16)
    core.model_set_scale(a, 14.0, 14.0, 14.0)
    core.model_set_scale(b, 14.0, 14.0, 14.0)
    core.model_set_scale(c, 14.0, 14.0, 14.0)
    core.model_set_scale(ball, 12.0, 12.0, 12.0)
    core.model_set_position(a, 0.0 - 66.0, 0.0, 0.0)
    core.model_set_position(b, 0.0 - 22.0, 0.0, 0.0)
    core.model_set_position(c, 22.0, 0.0, 0.0)
    core.model_set_position(ball, 66.0, 0.0, 0.0)
    core.model_set_diffuse(a, 0.9, 0.4, 0.2)
    core.model_set_diffuse(b, 0.2, 0.8, 0.4)
    core.model_set_diffuse(c, 0.3, 0.5, 0.9)
    core.model_set_diffuse(ball, 0.8, 0.8, 0.8)
    core.backend_add_model(pass_backend, a)
    core.backend_add_model(pass_backend, b)
    core.backend_add_model(pass_backend, c)
    core.backend_add_model(pass_backend, ball)
    return a, b, c, ball
}

// Cube `a` squashed flat where it stands: an edit after registration.
squash(m: *Model) {
    count = core.mesh_vertex_count(m.mesh)
    i = 0
    while i < count {
        p = core.mesh_position(m.mesh, i)
        core.mesh_set_position(m.mesh, i, core.vec3(p.x, p.y * 0.25, p.z))
        i = i + 1
    }
}

// The two frames against each other, as test_backend_parity compares
// them: lit coverage alike, and at most 2% of the channels apart by more
// than eight levels.
compare(name: string, gl_pixels: ptr, vk_pixels: ptr) {
    lit_gl = 0
    lit_vk = 0
    differing = 0
    total = 0
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        if i % 4 != 3 {
            a = mem.get_byte(gl_pixels, i)
            b = mem.get_byte(vk_pixels, i)
            if a > 12 { lit_gl = lit_gl + 1 }
            if b > 12 { lit_vk = lit_vk + 1 }
            difference = a - b
            if difference < 0 { difference = 0 - difference }
            if difference > 8 { differing = differing + 1 }
            total = total + 1
        }
        i = i + 1
    }
    coverage = lit_gl - lit_vk
    if coverage < 0 { coverage = 0 - coverage }
    check_true("${name}: both drew", lit_gl > 2000 && lit_vk > 2000)
    check_true("${name}: both cover the same area", coverage * 20 < lit_gl)
    check_true("${name}: frames agree", differing * 100 < total * 2)
    println("  ${name}: opengl lit ${lit_gl}, vulkan lit ${lit_vk}, ${differing} of ${total} channels differ")
}

main() {
    if !vulkan.available() {
        println("vk mesh: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("vk mesh: SKIP no OpenGL context")
        return
    }

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 40.0, 130.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    light.ambient_strength = 0.55

    gl_renderer = gl.renderer_new()
    gl_pass = gl.backend(gl_renderer)
    check_true("opengl started", core.backend_init(&gl_pass, context, WIDTH, HEIGHT))
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(gl_renderer, target)
    gl.renderer_set_clear_color(gl_renderer, 0.0, 0.0, 0.0)
    gl_a, gl_b, gl_c, gl_ball = build_row(&gl_pass)

    vk_renderer = vulkan.renderer_new()
    vk_pass = vulkan.backend(vk_renderer)
    if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
        println("vk mesh: SKIP Vulkan would not start (${vulkan.last_error()})")
        return
    }
    vulkan.renderer_set_clear_color(vk_renderer, 0.0, 0.0, 0.0)

    // What the renderer uploaded while it started (its screen quad).
    uploads = vkmesh.uploads()
    shares = vkmesh.shares()
    slots = vkmesh.slots()
    live = vkmesh.live()

    a, b, c, ball = build_row(&vk_pass)

    // Identical geometry goes up once: the three cubes are one mesh.
    check_true("the cube and the sphere uploaded, two meshes", vkmesh.uploads() - uploads == 2)
    check_true("the second and third cube shared the first's", vkmesh.shares() - shares == 2)
    check_true("the cubes draw one handle", a.vbo == b.vbo && b.vbo == c.vbo)
    check_true("the sphere has its own", ball.vbo != a.vbo)
    check_true("the cube's mesh is shared", vkmesh.mesh_shared(a.vbo))
    check_true("the sphere's is not", !vkmesh.mesh_shared(ball.vbo))
    check_true("two slots taken for four models", vkmesh.slots() - slots == 2)
    check_true("two meshes held", vkmesh.live() - live == 2)
    println("  uploads ${vkmesh.uploads() - uploads}, shares ${vkmesh.shares() - shares}, slots ${vkmesh.slots() - slots}")

    core.backend_render(&gl_pass, cam, light)
    core.backend_render(&vk_pass, cam, light)
    compare("four models, three sharing a mesh", offscreen.target_pixels(target), vulkan.offscreen_pixels())

    // An edit after registration: the edited cube goes up alone, and the
    // two still drawing the old shape keep it.
    shared = a.vbo
    squash(gl_a)
    squash(a)
    core.backend_render(&gl_pass, cam, light)
    core.backend_render(&vk_pass, cam, light)
    check_true("the edited cube went up again", vkmesh.uploads() - uploads == 3)
    check_true("under a handle of its own", a.vbo != shared && a.vbo != 0)
    check_true("the others kept the old one", b.vbo == shared && c.vbo == shared)
    check_true("which the two still share", vkmesh.mesh_shared(shared))
    check_true("the edited one shares nothing", !vkmesh.mesh_shared(a.vbo))
    check_true("three slots now", vkmesh.slots() - slots == 3)
    compare("one cube edited", offscreen.target_pixels(target), vulkan.offscreen_pixels())

    // Let go of: a mesh another model still draws stays, the last model's
    // going frees it.
    core.backend_remove_model(&vk_pass, b)
    check_true("a mesh still drawn stays", vkmesh.slots() - slots == 3)
    check_true("drawn by one model, no longer shared", !vkmesh.mesh_shared(shared))
    core.backend_remove_model(&vk_pass, c)
    check_true("the last model's going frees it", vkmesh.slots() - slots == 2)
    core.backend_remove_model(&vk_pass, a)
    core.backend_remove_model(&vk_pass, ball)
    check_true("every mesh of the row freed", vkmesh.slots() == slots && vkmesh.live() == live)

    // Uploaded again after all that, the same bytes are a mesh of their own
    // again, not a handle to something freed.
    again = loader.cube(1.0)
    core.backend_add_model(&vk_pass, again)
    check_true("a freed mesh is not handed out", again.vbo != 0 && vkmesh.slots() - slots == 1)
    core.backend_remove_model(&vk_pass, again)
    core.model_free(again)

    core.backend_cleanup(&gl_pass)
    core.backend_cleanup(&vk_pass)
    check_true("nothing held after the backend shut down", vkmesh.live() == 0)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)
    core.model_free(gl_a)
    core.model_free(gl_b)
    core.model_free(gl_c)
    core.model_free(gl_ball)
    core.model_free(a)
    core.model_free(b)
    core.model_free(c)
    core.model_free(ball)
    gl.renderer_free(gl_renderer)
    vulkan.renderer_free(vk_renderer)
    core.camera_free(cam)
    core.light_free(light)

    if failures == 0 {
        println("vk mesh: all checks passed")
    } else {
        println("vk mesh: ${failures} failure(s)")
    }
}
