// Walking to a spot and stopping on it (#825, locomotion.go_to), held to the
// numbers a game judges it by: the box man on its feet (ae3d.feet) under
// locomotion's foot hold, sent to a spot 10 m off five ways -- straight
// ahead; ahead, then turned a quarter to face; to its side (a quarter turn
// on the way); behind it (half a turn); and ahead at a run. No window.
//
// Each way:
//   - it gets there (locomotion.arrived) within 15 s: within 0.3 m of the
//     spot and 10 degrees of the facing asked;
//   - no toe slides more than 5 mm along the ground while it bears, plant by
//     plant (the lowest toe, within 1.5 cm of its height standing, for as
//     long as it stays so), every way: turning on the way and on the spot
//     (#827) and braking a run (#828) too;
//   - no drawn bone goes faster than 12 m/s in the figure's own frame;
//   - there, it stands: its toes move under 5 mm over the next 1.5 s (no
//     step taken standing still).
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.skin
import ae3d.feet
import ae3d.locomotion

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const MAN = "tests/fixtures/gltf/humanoid.glb"
const AWAY = 10.0
// m over its standing height a toe still bears: ae3d.feet's own steps lift a
// foot STEP_LIFT, 6 cm, so a foot stepping through the air is not skating.
const BEARS = 0.015

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

named(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

struct Way {
    name: string
    ahead: float                       // the spot, metres ahead of where it starts facing
    aside: float                       // and to its right
    face_turn: float                   // the facing asked there, radians from its start facing (to the right)
    running: bool
}

// One way: a fresh engine, the box man standing a second, sent there.
go(w: Way) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    man = figure.figure(e, "Man", MAN)
    if man == null {
        println("go_to: SKIP ${MAN} would not load")
        engine.engine_free(e)
        return
    }
    c = physics.character_controller(man, 0.3, 1.8)
    sk = figure.skeleton(figure.figure_of(man))
    l = locomotion.attach(e, man, c, "Idle", "Walk", "Run")
    locomotion.set_turn_steps(l, true)
    f = feet.attach(e, man.model as *Model, named(sk, "mixamorig:Hips"),
                    named(sk, "mixamorig:LeftUpLeg"), named(sk, "mixamorig:LeftLeg"), named(sk, "mixamorig:LeftFoot"),
                    named(sk, "mixamorig:RightUpLeg"), named(sk, "mixamorig:RightLeg"), named(sk, "mixamorig:RightFoot"))
    feet.set_figure(f, figure.figure_of(man))
    toe_l = named(sk, "mixamorig:LeftToeBase")
    toe_r = named(sk, "mixamorig:RightToeBase")
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // A toe bears where it stands: within BEARS of its height standing.
    core.model_sync_transform(toe_l)
    core.model_sync_transform(toe_r)
    rest_y = toe_l.world_position.y
    if toe_r.world_position.y > rest_y { rest_y = toe_r.world_position.y }
    h = locomotion.heading(l)
    fwd = core.vec3(core.sin_of(h), 0.0, core.cos_of(h))
    right = core.vec3(0.0 - fwd.z, 0.0, fwd.x)
    start = physics.character_feet(c)
    spot = core.v3_add(core.vec3(start.x, 0.0, start.z), core.v3_add(core.v3_mul(fwd, w.ahead), core.v3_mul(right, w.aside)))
    face_h = h + w.face_turn
    facing = core.vec3(core.sin_of(face_h), 0.0, core.cos_of(face_h))
    locomotion.go_to(l, spot, facing, w.running)
    count = skin.skeleton_count(sk)
    was_block = calloc(count * 3, 8)
    was = was_block as float[]
    plant_slide = 0.0
    worst_plant = 0.0
    last_low = null as *Model
    last_at = core.vec3(0.0, 0.0, 0.0)
    fastest = 0.0
    arrived_at = 0 - 1
    after = 0.0
    seen = false
    k = 0
    while k < 900 + 90 {
        engine.engine_update(e, STEP)
        if arrived_at < 0 && locomotion.arrived(l) { arrived_at = k }
        // The toes: the lowest on the ground, plant by plant.
        core.model_sync_transform(toe_l)
        core.model_sync_transform(toe_r)
        low = toe_l
        if toe_r.world_position.y < toe_l.world_position.y { low = toe_r }
        on = low.world_position.y < rest_y + BEARS
        if on && low == last_low {
            moved = core.v3_len(core.vec3(low.world_position.x - last_at.x, 0.0, low.world_position.z - last_at.z))
            plant_slide = plant_slide + moved
            if arrived_at >= 0 { after = after + moved }
        } else {
            plant_slide = 0.0
        }
        if plant_slide > worst_plant { worst_plant = plant_slide }
        if on { last_low = low } else { last_low = null as *Model }
        last_at = low.world_position
        // Every drawn bone's speed in the figure's own frame.
        root = behaviour.object_world_position(man)
        i = 0
        while i < count {
            b = skin.skeleton_bone(sk, i)
            core.model_sync_transform(b)
            rel = core.v3_sub(b.world_position, root)
            if seen {
                v = core.v3_len(core.vec3(rel.x - was[i * 3], rel.y - was[i * 3 + 1], rel.z - was[i * 3 + 2])) / STEP
                if v > fastest { fastest = v }
            }
            was[i * 3] = rel.x
            was[i * 3 + 1] = rel.y
            was[i * 3 + 2] = rel.z
            i = i + 1
        }
        seen = true
        if arrived_at >= 0 && k >= arrived_at + 90 { k = 900 + 90 }
        k = k + 1
    }
    free(was_block)
    end = physics.character_feet(c)
    off = core.v3_len(core.vec3(end.x - spot.x, 0.0, end.z - spot.z))
    turn = core.abs_of(wrap(locomotion.heading(l) - face_h))
    secs = (arrived_at as float) * STEP
    println("  ${w.name}: arrived ${arrived_at >= 0} in ${secs} s, ${off * 100.0} cm off the spot, ${turn * 57.29578} degrees off the facing; a toe slid ${worst_plant * 1000.0} mm in a plant at the most, ${after * 1000.0} mm after arriving; the fastest bone ${fastest} m/s")
    check("${w.name}: it gets there within 15 s, within 0.3 m of the spot and 10 degrees of the facing", arrived_at >= 0 && arrived_at < 900 && off < 0.3 && turn < 0.1745)
    check("${w.name}: no toe slides over 5 mm while it bears", worst_plant < 0.005)
    check("${w.name}: no bone goes over 12 m/s in its own frame", fastest < 12.0)
    check("${w.name}: there, it stands (its toes move under 5 mm the next 1.5 s)", arrived_at >= 0 && after < 0.005)
    feet.feet_free(f)
    locomotion.locomotion_free(l)
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

wrap(a: float) -> float {
    t = a
    while t > 3.14159265 { t = t - 6.2831853 }
    while t < 0.0 - 3.14159265 { t = t + 6.2831853 }
    return t
}

main() {
    println("go_to: walking to a spot and stopping on it (#825)")
    go(Way { name: "ahead", ahead: AWAY, aside: 0.0, face_turn: 0.0, running: false })
    go(Way { name: "ahead, then turned a quarter", ahead: AWAY, aside: 0.0, face_turn: 1.5708, running: false })
    go(Way { name: "to its side", ahead: 0.0, aside: AWAY, face_turn: 1.5708, running: false })
    go(Way { name: "behind it", ahead: 0.0 - AWAY, aside: 0.0, face_turn: 3.14159, running: false })
    go(Way { name: "ahead, running", ahead: AWAY, aside: 0.0, face_turn: 0.0, running: true })
    if g_failures > 0 {
        println("go_to: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("go_to: all checks passed (${g_checks})")
}
