// Walking to a spot and stopping on it (#825), through a character using a
// spot (character.use with tests/fixtures/usable/spot.usable's stand slot,
// #949; #860 retired locomotion.go_to onto it), held to the numbers a game
// judges it by: the Rigify mannequin on 100STYLE's gaits, its feet on
// ikrig's, sent to a spot 10 m off five ways -- straight ahead; ahead, then
// turned a quarter to face; to its side (a quarter turn on the way); behind
// it (half a turn); and ahead at a run. No window; stepped at 60 Hz.
//
// Each way:
//   - it gets there (the slot held, character.USE_LOOP) within 15 s: within
//     5 cm of the spot and 0.1 rad of the facing asked;
//   - no toe slides more than 5 mm in a stance (ae3d.metrics' SKATE), every
//     way: turning on the way and on the spot and braking a run too;
//   - no drawn joint goes faster than 12 m/s in the figure's own frame;
//   - there, it stands: its toes move under 5 mm over the next 1.5 s (no
//     step taken standing still).
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.metrics
import ae3d.usable
import ae3d.character

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const SPOT = "tests/fixtures/usable/spot.usable"
const AWAY = 10.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

wrap(a: float) -> float {
    t = a
    while t > 3.14159265 { t = t - 6.2831853 }
    while t < 0.0 - 3.14159265 { t = t + 6.2831853 }
    return t
}

struct Way {
    name: string
    ahead: float                       // the spot, metres ahead of where it starts facing
    aside: float                       // and to its side
    face_turn: float                   // the facing asked there, radians from its start facing
    running: bool
}

// The figure stood at `at` facing `yaw`, its springs and feet there.
place(c: *Character, at: Vec3, yaw: float) {
    o = character.object_of(c)
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    ikrig.feet_reset(character.feet_of(c))
}

// Both toes' tips over the ground.
toes(c: *Character, w: ptr) -> (Vec3, Vec3) {
    a = character.animator_of(c)
    r = animator.rig(a)
    pose.world(r, animator.pose_shown(a), w)
    return ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.BALL_L))), ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.BALL_R)))
}

flat(v: Vec3) -> float { return core.v3_len(core.vec3(v.x, 0.0, v.z)) }

// One way, from `origin` facing +z: the figure standing a second, then sent
// to a spot there.
go(e: *Engine, c: *Character, u: *Usables, kind: *Kind, m: *Meter, origin: Vec3, w: Way) {
    a = character.animator_of(c)
    r = animator.rig(a)
    place(c, origin, 0.0)
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Where it is sent, and the way it is to face there: the spot's object
    // turned so the slot faces it.
    fwd = core.vec3(0.0, 0.0, 1.0)
    side = core.vec3(1.0, 0.0, 0.0)
    spot = core.v3_add(origin, core.v3_add(core.v3_mul(fwd, w.ahead), core.v3_mul(side, w.aside)))
    so = engine.object(e, "Spot ${w.name}", null)
    behaviour.object_set_position(so, spot)
    behaviour.object_set_rotation(so, core.quat_rotate(w.face_turn, core.vec3(0.0, 1.0, 0.0)))
    slot = usable.add(u, so, kind)
    used = character.use(c, u, slot, w.running)
    metrics.meter_reset(m)
    count = pose.count(r)
    wp = pose.new(r)
    was_block = calloc(count * 3, 8)
    was = was_block as float[]
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    fastest = 0.0
    seen = false
    arrived_at = 0 - 1
    after = 0.0
    last_l = core.vec3(0.0, 0.0, 0.0)
    last_r = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 900 + 90 {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if arrived_at < 0 && character.use_phase(c) == character.USE_LOOP {
            arrived_at = k
            last_l, last_r = toes(c, wp)
        } else if arrived_at >= 0 {
            tl, tr = toes(c, wp)
            after = after + flat(core.v3_sub(tl, last_l)) + flat(core.v3_sub(tr, last_r))
            last_l = tl
            last_r = tr
        }
        // Every drawn joint's speed in the figure's own frame (the rig's
        // space, in its units).
        pose.world(r, animator.pose_shown(a), wp)
        i = 0
        while i < count {
            p = pose.translation(wp, i)
            if seen {
                v = core.v3_len(core.vec3(p.x - was[i * 3], p.y - was[i * 3 + 1], p.z - was[i * 3 + 2])) / unit / STEP
                if v > fastest { fastest = v }
            }
            was[i * 3] = p.x
            was[i * 3 + 1] = p.y
            was[i * 3 + 2] = p.z
            i = i + 1
        }
        seen = true
        if arrived_at >= 0 && k >= arrived_at + 90 { k = 900 + 90 }
        k = k + 1
    }
    skated = metrics.meter_worst(m, metrics.SKATE)
    skated_at = metrics.meter_when(m, metrics.SKATE)
    o = character.object_of(c)
    end = behaviour.object_position(o)
    off = flat(core.v3_sub(end, spot))    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    turn = core.abs_of(wrap(core.atan2_of(ahead.x, ahead.z) - w.face_turn))
    held = used && character.use_phase(c) == character.USE_LOOP
    secs = (arrived_at as float) * STEP
    println("  ${w.name}: arrived ${arrived_at >= 0} in ${secs} s, ${off * 100.0} cm off the spot, ${turn * 57.29578} degrees off the facing; a toe slid ${skated * 1000.0} mm in a stance at the most (${skated_at} s in), its toes ${after * 1000.0} mm in the 1.5 s after arriving; the fastest joint ${fastest} m/s")
    check("${w.name}: it gets there within 15 s, within 5 cm of the spot and 0.1 rad of the facing", held && arrived_at >= 0 && arrived_at < 900 && off < 0.05 && turn < 0.1)
    check("${w.name}: no toe slides over 5 mm in a stance", skated < 0.005)
    check("${w.name}: no joint goes over 12 m/s in its own frame", fastest < 12.0)
    check("${w.name}: there, it stands (its toes move under 5 mm the next 1.5 s)", arrived_at >= 0 && after < 0.005)
    free(was_block)
    pose.release(wp)
    character.leave(c)
    k = 0
    while k < 600 && character.using(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

main() {
    println("go_to: walking to a spot and stopping on it, through a character using it (#825, #860)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Goer", RIGIFY, g)
    check("the Rigify mannequin made a character: ${character.error()}", c != null)
    if c == null { exit(1) }
    m = metrics.meter_new(animator.rig(character.animator_of(c)), character.object_of(c))
    u = usable.usables_new(2.0)
    kind = usable.kind_read(SPOT)
    go(e, c, u, kind, m, core.vec3(0.0, 0.0, 0.0), Way { name: "ahead", ahead: AWAY, aside: 0.0, face_turn: 0.0, running: false })
    go(e, c, u, kind, m, core.vec3(100.0, 0.0, 0.0), Way { name: "ahead, then turned a quarter", ahead: AWAY, aside: 0.0, face_turn: 1.5708, running: false })
    go(e, c, u, kind, m, core.vec3(200.0, 0.0, 0.0), Way { name: "to its side", ahead: 0.0, aside: AWAY, face_turn: 1.5708, running: false })
    go(e, c, u, kind, m, core.vec3(300.0, 0.0, 0.0), Way { name: "behind it", ahead: 0.0 - AWAY, aside: 0.0, face_turn: 3.14159, running: false })
    go(e, c, u, kind, m, core.vec3(400.0, 0.0, 0.0), Way { name: "ahead, running", ahead: AWAY, aside: 0.0, face_turn: 0.0, running: true })
    usable.kind_free(kind)
    metrics.meter_free(m)
    usable.usables_free(u)
    character.character_free(c)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures > 0 {
        println("go_to: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("go_to: all checks passed (${g_checks})")
}
