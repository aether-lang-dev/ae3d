// A held frame (frame.pause, AE3D_HOLD) keeps the HUD its scripts drew.
// The HUD is cleared after every frame and drawn again by the scripts'
// updates, which a held frame does not run: the agent's snapshot of a paused
// scene showed no HUD at all, where AE3D_SNAPSHOT's of a running one did.
// Now a held frame shows what the scripts drew before the hold, with its own
// menus and late updates over it, and nothing piles up frame after frame.
// Hidden; SKIP where no window opens.

import std.os
import ae3d.core
import ae3d.engine
import ae3d.hud

const HOLD = 3

extern exit(code: int)

var g_checks = 0
var g_failures = 0
var g_late = 0
var g_held_frames = 0
var g_first_held = 0 - 1
var g_last_held = 0 - 1
var g_updates_held = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A panel in the corner, every update.
on_update(state: ptr, e: *Engine, delta: float) {
    o = engine.engine_hud(e)
    hud.rect(o, 10.0, 10.0, 120.0, 40.0, hud.rgba(0.2, 0.3, 0.4, 1.0))
    if engine.engine_frame_count(e) >= HOLD { g_updates_held = g_updates_held + 1 }
}

// After each frame is drawn: a late update draws a mark of its own too, and
// what the HUD holds for the next frame is read.
on_late(state: ptr, e: *Engine, delta: float) {
    g_late = g_late + 1
    o = engine.engine_hud(e)
    if engine.engine_frame_count(e) == HOLD {
        // Held: the frame counter stops here.
        g_held_frames = g_held_frames + 1
        if g_held_frames == 2 { g_first_held = hud.quad_count(o) }
        if g_held_frames == 6 { g_last_held = hud.quad_count(o) }
        if g_held_frames >= 6 { engine.engine_stop(e) }
    }
    hud.rect(o, 200.0, 10.0, 20.0, 20.0, hud.rgba(1.0, 1.0, 1.0, 1.0))
    if g_late > 60 { engine.engine_stop(e) }
}

main() {
    println("hud_hold: a held frame keeps the HUD its scripts drew")
    os.setenv("AE3D_HIDDEN", "1")
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_HOLD", "${HOLD}")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    b = engine.behaviour_new("panel", null)
    b.update = on_update
    b.late_update = on_late
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("hud_hold: SKIP no window available")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    check("the engine held (${g_held_frames} held frames)", g_held_frames >= 6)
    check("no update ran while held (${g_updates_held})", g_updates_held <= 1)
    // Read after each held frame is drawn: the panel the last update drew
    // and the mark the late update before it drew, the menus none.
    check("a held frame still has the scripts' panel and the late mark under it (${g_first_held} quads)", g_first_held == 2)
    check("and nothing piles up while it is held (${g_first_held} then ${g_last_held})", g_last_held == g_first_held)
    if g_failures == 0 {
        println("hud_hold: all checks passed (${g_checks})")
    } else {
        println("hud_hold: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
