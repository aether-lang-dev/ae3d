// Figures using things (#908), held to numbers: the Rigify mannequin made a
// character (ae3d.character, on 100STYLE's gaits; its sitting and reaching
// takes its own) uses usable objects' slots (ae3d.usable): walks to a slot's
// approach point, turns there to face its way, and enters it, the enter take
// warped so its part lands on the slot (animator.warp). No window; stepped
// at 60 Hz.
//
//   - it sits on a log (0.40 m), a stool (0.60 m, four ways) and a doorstep
//     (0.25 m), coming from eight ways 3 m off each: at the enter take's
//     contact the drawn pelvis is within 2 cm of the seat, and no toe skates
//     5 mm while it sits down (ae3d.metrics);
//   - at a workbench its right hand reaches the tool's grip: within 1 cm of
//     it at the take's contact frame;
//   - a slot one figure holds is refused to another;
//   - a slot with no takes (#949) is claimed, walked to (within 5 cm of its
//     approach point) and faced (within 10 degrees of its way) from eight
//     ways 3 m off, no toe skating 5 mm, and held until it leaves.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.metrics
import ae3d.usable
import ae3d.character

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const KINDS = "tests/fixtures/usable/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The figure stood at `at` facing `yaw`, its springs and feet there.
place(c: *Character, at: Vec3, yaw: float) {
    o = character.object_of(c)
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    ikrig.feet_reset(character.feet_of(c))
}

// Figure `c` uses slot `s` from where it stands and sits: the drawn part
// (pelvis or right hand) off the slot's point at the enter take's contact,
// metres, and the worst a toe skated meanwhile; then it leaves. -1 if it
// never got there in 20 s.
sit(e: *Engine, c: *Character, u: *Usables, s: int, m: *Meter, part: int) -> (float, float) {
    a = character.animator_of(c)
    r = animator.rig(a)
    if !character.use(c, u, s) { return 0.0 - 1.0, 0.0 }
    metrics.meter_reset(m)
    off = 0.0 - 1.0
    skated = 0.0
    k = 0
    while k < 1200 && off < 0.0 {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if character.use_phase(c) == character.USE_ENTER {
            if metrics.meter_worst(m, metrics.SKATE) > skated {
                skated = metrics.meter_worst(m, metrics.SKATE)
            }
            if animator.current(a) == character.use_enter_state(c) && animator.state_time(a) >= character.use_contact(c) - 0.0001 && !animator.warping(a) {
                w = pose.new(r)
                pose.world(r, animator.pose_now(a), w)
                landed = clips.ground_point(r, pose.translation(w, pose.human(r, part)))
                pose.release(w)
                off = core.v3_len(core.v3_sub(landed, usable.slot_at(u, s)))
            }
        } else if character.use_phase(c) != character.USE_ENTER {
            metrics.meter_reset(m)
        }
        k = k + 1
    }
    // Through the rest of the enter, then up and away.
    k = 0
    while k < 240 && character.use_phase(c) == character.USE_ENTER {
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if metrics.meter_worst(m, metrics.SKATE) > skated { skated = metrics.meter_worst(m, metrics.SKATE) }
        k = k + 1
    }
    character.leave(c)
    k = 0
    while k < 600 && character.using(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    return off, skated
}

main() {
    println("use: a figure walks to a seat or a bench, turns and uses it (#908)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Sitter", RIGIFY, g)
    check("the Rigify mannequin made a character: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    r = animator.rig(a)
    m = metrics.meter_new(r, character.object_of(c))
    u = usable.usables_new(2.0)
    kinds = [usable.kind_read("${KINDS}log.usable"), usable.kind_read("${KINDS}stool.usable"), usable.kind_read("${KINDS}step.usable")]
    names = ["a log", "a stool", "a doorstep"]
    places = [core.vec3(0.0, 0.0, 0.0), core.vec3(20.0, 0.0, 0.0), core.vec3(40.0, 0.0, 0.0)]
    k = 0
    while k < 3 {
        o = engine.object(e, names[k], loader.cube(1.0))
        behaviour.object_set_position(o, places[k])
        usable.add(u, o, kinds[k])
        k = k + 1
    }
    worst_off = 0.0
    worst_skate = 0.0
    missed = 0
    k = 0
    while k < 3 {
        line = "  ${names[k]}:"
        way = 0
        while way < 8 {
            yaw = (way as float) * 0.7853982
            from = core.v3_add(places[k], core.vec3(3.0 * core.sin_of(yaw), 0.0, 3.0 * core.cos_of(yaw)))
            // Facing the seat, as one walking up to it.
            place(c, from, yaw + 3.1415926)
            s = usable.find(u, from, 6.0, "sit", c as ptr)
            off, skated = sit(e, c, u, s, m, pose.PELVIS)
            if off < 0.0 {
                missed = missed + 1
            } else {
                if off > worst_off { worst_off = off }
                if skated > worst_skate { worst_skate = skated }
            }
            line = "${line} ${(off * 100.0) as int} cm/${(skated * 1000.0) as int} mm"
            way = way + 1
        }
        println(line)
        k = k + 1
    }
    println("  from eight ways each: the pelvis ${worst_off * 100.0} cm off the seat at the most at the contact, a toe skating ${worst_skate * 1000.0} mm at the most sitting down; ${missed} never sat")
    check("it sits on a log, a stool and a doorstep from any way, the pelvis within 2 cm of the seat, no toe skating 5 mm", missed == 0 && worst_off < 0.02 && worst_skate < 0.005)
    // The workbench: the right hand on the tool's grip.
    bench_kind = usable.kind_read("${KINDS}bench.usable")
    bench = engine.object(e, "Bench", loader.cube(1.0))
    behaviour.object_set_position(bench, core.vec3(60.0, 0.0, 0.0))
    first = usable.add(u, bench, bench_kind)
    place(c, core.vec3(60.0, 0.0, 3.0), 3.1415926)
    reach, _reach_skate = sit(e, c, u, first, m, pose.HAND_R)
    println("  at a workbench: the right hand ${reach * 100.0} cm off the tool's grip at the reach's contact")
    check("at a workbench its right hand lands within 1 cm of the tool's grip", reach >= 0.0 && reach < 0.01)
    // A held slot refused to another.
    other = calloc(1, 8)
    held = usable.claim(u, first, other)
    refused = !character.use(c, u, first)
    usable.release(u, first, other)
    free(other)
    check("a slot another holds is refused", held && refused)
    // A spot with no takes (#949): claimed, walked to and faced, held until
    // it leaves; refused, as every slot with no enter take was, it could not
    // even be walked to.
    spot_kind = usable.kind_read("${KINDS}spot.usable")
    spot = engine.object(e, "Spot", null)
    behaviour.object_set_position(spot, core.vec3(80.0, 0.0, 0.0))
    spot_slot = usable.add(u, spot, spot_kind)
    worst_reach = 0.0
    worst_turn = 0.0
    worst_spot_skate = 0.0
    worst_approach_skate = 0.0
    worst_approach_at = 0.0
    all_held = true
    way = 0
    while way < 8 {
        yaw = (way as float) * 0.7853982
        from = core.v3_add(core.vec3(80.0, 0.0, 0.0), core.vec3(3.0 * core.sin_of(yaw), 0.0, 3.0 * core.cos_of(yaw)))
        place(c, from, yaw + 3.1415926)
        metrics.meter_reset(m)
        used = character.use(c, u, spot_slot)
        k = 0
        while k < 1200 && character.use_phase(c) != character.USE_LOOP {
            engine.engine_update(e, STEP)
            metrics.meter_take(m, STEP)
            k = k + 1
        }
        approach_skate = metrics.meter_worst(m, metrics.SKATE)
        if approach_skate > worst_approach_skate {
            worst_approach_skate = approach_skate
            worst_approach_at = metrics.meter_when(m, metrics.SKATE)
        }
        metrics.meter_reset(m)
        k = 0
        while k < 60 {
            engine.engine_update(e, STEP)
            metrics.meter_take(m, STEP)
            k = k + 1
        }
        o = character.object_of(c)
        at = behaviour.object_position(o)
        goal = usable.slot_approach(u, spot_slot)
        reach = core.v3_len(core.vec3(at.x - goal.x, 0.0, at.z - goal.z))
        ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
        way_to = usable.slot_facing(u, spot_slot)
        turn = core.abs_of(core.atan2_of(ahead.x, ahead.z) - core.atan2_of(way_to.x, way_to.z))
        if turn > 3.1415926 { turn = 6.2831853 - turn }
        if reach > worst_reach { worst_reach = reach }
        if turn > worst_turn { worst_turn = turn }
        if metrics.meter_worst(m, metrics.SKATE) > worst_spot_skate { worst_spot_skate = metrics.meter_worst(m, metrics.SKATE) }
        held_now = used && character.use_phase(c) == character.USE_LOOP && usable.claimant(u, spot_slot) == c as ptr
        character.leave(c)
        k = 0
        while k < 600 && character.using(c) {
            engine.engine_update(e, STEP)
            k = k + 1
        }
        if !held_now || usable.claimant(u, spot_slot) != null { all_held = false }
        way = way + 1
    }
    println("  at a spot with no takes, walking there and turning: a toe skating ${worst_approach_skate * 1000.0} mm at the most (${worst_approach_at} s in); held there ${worst_spot_skate * 1000.0} mm")
    println("  at a spot with no takes, from eight ways: ${worst_reach * 100.0} cm off its approach point and ${worst_turn * 57.29578} degrees off its way at the most, a toe skating ${worst_spot_skate * 1000.0} mm at the most; held until it left ${all_held}")
    check("a slot with no takes is claimed, walked to (within 5 cm) and faced (10 degrees) from any way, no toe skating 5 mm, and held until it leaves", worst_reach < 0.05 && worst_turn < 0.17453 && worst_spot_skate < 0.005 && all_held)
    usable.kind_free(spot_kind)
    metrics.meter_free(m)
    usable.usables_free(u)
    k = 0
    while k < 3 {
        usable.kind_free(kinds[k])
        k = k + 1
    }
    usable.kind_free(bench_kind)
    character.character_free(c)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("use: all checks passed (${g_checks})")
        return
    }
    println("use: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

