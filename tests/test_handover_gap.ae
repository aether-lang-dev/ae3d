// A powered hand-over drawn toward its bodies never past the pose it was
// shown in (#665), held to numbers on the box man. No window.
//
// The box man walked to where its left knee is well bent, its ragdoll's
// bodies put on that pose (ragdoll_to_rig), the rig then back on its rest
// pose, legs straight, and the figure set POWERED: the pose shown is the
// straight one, the bodies' knee bent, and the muscles straighten it toward
// the animation's straight pose while the drawing goes from the one to the
// other over the hand-over's quarter second.
//
//   - the drawn left knee is never bent backwards past straight by more
//     than 2 degrees, about the physical knee's own axis. The offset the
//     drawing kept from the bodies was the one on the frame of the change,
//     added on top of bodies already straightening the pose's way: counted
//     twice, the knee was drawn past straight -- in the plaza 7 to 11
//     degrees, as a risen walker's get-up handed it back;
//   - and the drawing comes to the bodies': a quarter second on, the drawn
//     knee is the bodies' to a degree.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.motion
import aephysics.human
import aephysics.dynamics
import aephysics.joint_solver
import aephysics.math

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

bone(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

// The drawn left knee's bend about the physical left knee's axis, degrees,
// flexed positive (the left knee flexes about its axis the negative way).
drawn_left(r: *Ragdoll, sk: *Skeleton) -> float {
    thigh = bone(sk, "mixamorig:LeftUpLeg")
    knee = bone(sk, "mixamorig:LeftLeg")
    ankle = bone(sk, "mixamorig:LeftFoot")
    core.model_sync_transform(thigh)
    core.model_sync_transform(knee)
    core.model_sync_transform(ankle)
    tq = dynamics.body_get_rotation(human.bone_at(&r.human, human.BONE_THIGH_L).body_id)
    fa = human.bone_at(&r.human, human.BONE_CALF_L).local_frame_a.q
    ax = math.rotate_vector(math.mul_quat(tq, fa), math.vec3(0.0, 0.0, 1.0))
    t = core.v3_sub(knee.world_position, thigh.world_position)
    s = core.v3_sub(ankle.world_position, knee.world_position)
    bend = core.acos_of(core.clampf(core.v3_dot(t, s) / (core.v3_len(t) * core.v3_len(s)), 0.0 - 1.0, 1.0)) * 57.29578
    if core.v3_dot(core.v3_cross(t, s), core.vec3(ax.x, ax.y, ax.z)) > 0.0 { return 0.0 - bend }
    return bend
}

// The bodies' left knee bend, degrees from straight (its upper limit).
bodies_left(r: *Ragdoll) -> float {
    joint = human.bone_at(&r.human, human.BONE_CALF_L).joint_id
    return (joint_solver.revolute_joint_get_upper_limit(joint) - joint_solver.revolute_joint_get_angle(joint)) * 57.29578
}

main() {
    println("handover_gap: a powered hand-over drawn toward its bodies, never past the pose shown (#665)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", "tests/fixtures/gltf/humanoid.glb")
    fig = figure.figure_of(o)
    sk = figure.skeleton(fig)
    rest = figure.keep_pose(fig)
    m = motion.on_figure(e, o)
    r = m.ragdoll
    physics.ragdoll_park(r)
    // Walked to where the left knee is bent the most over a cycle.
    figure.play(fig, "Walk", 1.0, true)
    best_t = 0.0
    best = 0.0
    k = 0
    while k < 60 {
        t = (k as float) / 60.0 * figure.duration(fig)
        figure.set_time(fig, t)
        knee = bone(sk, "mixamorig:LeftLeg")
        thigh = bone(sk, "mixamorig:LeftUpLeg")
        ankle = bone(sk, "mixamorig:LeftFoot")
        core.model_sync_transform(thigh)
        core.model_sync_transform(knee)
        core.model_sync_transform(ankle)
        a = core.v3_sub(knee.world_position, thigh.world_position)
        b = core.v3_sub(ankle.world_position, knee.world_position)
        bend = core.acos_of(core.clampf(core.v3_dot(a, b) / (core.v3_len(a) * core.v3_len(b)), 0.0 - 1.0, 1.0))
        if bend > best {
            best = bend
            best_t = t
        }
        k = k + 1
    }
    figure.set_time(fig, best_t)
    figure.stop(fig)
    // The bodies on the bent pose, then the rig back on its straight rest.
    physics.ragdoll_unpark(r)
    physics.ragdoll_to_rig(r)
    figure.put_pose(fig, rest)
    motion.set_mode(m, motion.POWERED)
    start = bodies_left(r)
    least = 1000.0
    drawn_end = 0.0
    bodies_end = 0.0
    k = 0
    while k < 15 {
        engine.engine_update(e, STEP)
        d = drawn_left(r, sk)
        if d < least { least = d }
        drawn_end = d
        bodies_end = bodies_left(r)
        k = k + 1
    }
    println("  the bodies' left knee bent ${start} degrees at the change, the pose shown straight; drawn ${least} degrees at the least over the hand-over; a quarter second on, drawn ${drawn_end}, the bodies ${bodies_end}")
    check("the drawn left knee is never bent backwards past straight by more than 2 degrees", least > 0.0 - 2.0)
    check("a quarter second on, the drawn knee is the bodies' to a degree", core.abs_of(drawn_end - bodies_end) < 1.0)
    figure.pose_free(rest)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
    if g_failures == 0 {
        println("handover_gap: all checks passed (${g_checks})")
        return
    }
    println("handover_gap: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
