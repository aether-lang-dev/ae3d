// The scene DSL (ae3d.scenedsl, #275): a scene written as nested builders
// is the scene a file loads. A scene built here is placed in an engine,
// saved as a scene file and loaded back, and every model, light, record and
// component is the same on both sides. The file is then written as code
// (scenedsl.text_from_file), which must be the golden module this test is
// built with (tests/fixtures/scene/written), and that module's scene is the
// file's too: from code to file and back to code. Headless.

import std.list
import std.heap
import std.json
import std.string
import std.fs
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.scene
import ae3d.water
import ae3d.scenedsl
import ae3d.scenedsl (scene, model, group, cube, sphere, quad, name, position, scale, scale3, rotate, hidden, no_shadow,
                      material, diffuse, surface, texture, tile_breakup, polished_metal, uniform, uniform_values, value,
                      sun, point_light, spot_light, color, intensity, range, cone, camera, look_at,
                      component, record, body, kind, script, field, field_bool, field_vec3, field_object)
import tests.fixtures.scene.written

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(label: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${label}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${label}")
    }
}

near(a: float, b: float) -> bool { return core.abs_of(a - b) < 0.00001 }

near3(a: Vec3, b: Vec3) -> bool { return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z) }

// A game's own kind: a leash to another object, how long it is.
struct Leash {
    target: int
    length: float
}

leash_new() -> ptr {
    l = heap.new(Leash)
    l.length = 1.0
    return l as ptr
}

leash_free(p: ptr) { heap.free(p as *Leash) }

leash_kind() -> *ComponentKind {
    k = component.kind_named("Leash")
    if k != null { return k }
    k = component.kind("Leash", "Test", leash_new, leash_free)
    component.object_field(k, "target", offsetof(Leash, target))
    component.float_field(k, "length", offsetof(Leash, length), 0.0, 100.0)
    return k
}

// The scene, as a game would write it.
yard() -> *SceneNode {
    dog = null as *SceneNode
    s = scene() {
        sun(0.4, 0.8, 0.5) { intensity(2.5) }
        point_light(3.0, 4.0, 5.0, 12.0) { color(1.0, 0.5, 0.25) }
        camera(0.0, 20.0, 90.0) { look_at(0.0, 0.0, 0.0) }
        group("Yard") {
            position(10.0, 0.0, -4.0)
            rotate(0.0, 30.0, 0.0)
            model("resources/obj/Cube.obj") {
                name("Kennel")
                scale(2.0)
                material() {
                    diffuse(0.6, 0.4, 0.2)
                    surface("roughness", 0.8)
                    surface("fire", 1500.0)
                    surface("cutout", 0.3)
                    tile_breakup(true)
                    texture("resources/textures/sand.png")
                }
                body("static", "box") { field("friction", 0.9) }
                dog = sphere(0.5, 12, 8) {
                    name("Dog")
                    position(0.0, 1.5, 0.0)
                    polished_metal(0.9, 0.8, 0.1)
                    uniform("volumetricIntensity", 0.42)
                    uniform_values("weights", false) {
                        value(0.25)
                        value(0.5)
                        value(1e-05)
                    }
                    body("dynamic", "sphere") {
                        field("density", 2.0)
                        field_bool("trigger", true)
                    }
                }
            }
            cube(1.0) {
                name("Lamp")
                scale3(0.2, 3.0, 0.2)
                position(4.0, 1.5, 0.0)
                no_shadow()
                kind("light")
                spot_light(0.0, 3.0, 0.0, 0.0, -1.0, 0.0, 15.0, 20.0, 35.0) {
                    range(18.0)
                    cone(10.0, 25.0)
                }
            }
        }
        quad(40.0, 40.0) {
            name("Pond")
            position(0.0, -0.5, 30.0)
            hidden()
            record("water") {
                field("ocean_size", 40.0)
                field("base_amplitude", 0.3)
                field_vec3("color", 0.1, 0.3, 0.4)
                field("opacity", 0.7)
            }
        }
        cube(0.5) {
            name("Post")
            position(-6.0, 0.25, 2.0)
            script("bob")
            component("Leash") {
                field("length", 6.5)
                field_object("target", dog)
            }
        }
    }
    return s
}

// Two texts of code the same, their numbers to twelve significant digits:
// a cone's cosine is the last bit of a sine, which the libm a build links
// may round either way, and the code means the same surface either way.
same_code(a: string, b: string) -> bool {
    i = 0
    j = 0
    na = string.length(a)
    nb = string.length(b)
    while i < na && j < nb {
        ca = string.char_at(a, i)
        cb = string.char_at(b, j)
        if number_start(a, i) && number_start(b, j) {
            ea = number_end(a, i)
            eb = number_end(b, j)
            x = number_of(string.substring(a, i, ea))
            y = number_of(string.substring(b, j, eb))
            scale = core.abs_of(x)
            if core.abs_of(y) > scale { scale = core.abs_of(y) }
            if scale < 1.0 { scale = 1.0 }
            if core.abs_of(x - y) > scale * 0.000000000001 { return false }
            i = ea
            j = eb
        } else {
            if ca != cb { return false }
            i = i + 1
            j = j + 1
        }
    }
    return i == na && j == nb
}

// Whether a number starts at `at`: a digit, or a minus before one, not part
// of a name.
number_start(t: string, at: int) -> bool {
    c = string.char_at(t, at)
    if at > 0 {
        before = string.char_at(t, at - 1)
        if (before >= 97 && before <= 122) || (before >= 65 && before <= 90) || before == 95 || (before >= 48 && before <= 57) { return false }
    }
    if c >= 48 && c <= 57 { return true }
    return c == 45 && at + 1 < string.length(t) && string.char_at(t, at + 1) >= 48 && string.char_at(t, at + 1) <= 57
}

number_end(t: string, at: int) -> int {
    k = at + 1
    while k < string.length(t) {
        c = string.char_at(t, k)
        if !((c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || ((c == 45 || c == 43) && (string.char_at(t, k - 1) == 101 || string.char_at(t, k - 1) == 69))) { break }
        k = k + 1
    }
    return k
}

number_of(t: string) -> float {
    n = json.parse_raw(t)
    if n == null { return 0.0 }
    v = json.get_number(n)
    json.free(n)
    return v
}

// Two model lists the same tree: by name, place, shape, parent, surface.
same_models(label: string, a: ptr, b: ptr) {
    check("${label}: as many models (${list.size(a)}, ${list.size(b)})", list.size(a) == list.size(b))
    if list.size(a) != list.size(b) { return }
    count = list.size(a)
    i = 0
    while i < count {
        x = list.get_raw(a, i) as *Model
        y = list.get_raw(b, i) as *Model
        what = "${label}: ${core.text(x.name)}"
        check("${what}: its name", string.equals(core.text(x.name), core.text(y.name)) == 1)
        check("${what}: its place, size and turn",
              near3(x.position, y.position) && near3(x.scale, y.scale) &&
              near(x.rotation.x, y.rotation.x) && near(x.rotation.y, y.rotation.y) &&
              near(x.rotation.z, y.rotation.z) && near(x.rotation.w, y.rotation.w))
        check("${what}: its parent", scene.index_of_model(a, core.model_parent(x)) == scene.index_of_model(b, core.model_parent(y)))
        check("${what}: its mesh", core.mesh_vertex_count(x.mesh) == core.mesh_vertex_count(y.mesh))
        check("${what}: shown and shadowed alike", x.visible == y.visible && x.casts_shadow == y.casts_shadow)
        same_material(what, x.material, y.material)
        check("${what}: its uniforms", same_uniforms(x, y))
        i = i + 1
    }
}

same_material(what: string, x: *Material, y: *Material) {
    if x == null || y == null {
        check("${what}: a material on both or neither", x == null && y == null)
        return
    }
    numbers = true
    i = 0
    while i < scene.material_number_count() {
        if !near(scene.material_number(x, i), scene.material_number(y, i)) { numbers = false }
        i = i + 1
    }
    check("${what}: its material's every number", numbers)
    check("${what}: its colours, breakup and textures", near3(x.diffuse, y.diffuse) && near3(x.specular, y.specular) &&
          x.tile_breakup == y.tile_breakup && string.equals(core.text(x.texture_path), core.text(y.texture_path)) == 1)
}

same_uniforms(x: *Model, y: *Model) -> bool {
    if core.model_uniform_count(x) != core.model_uniform_count(y) { return false }
    i = 0
    while i < core.model_uniform_count(x) {
        u = core.model_uniform(x, i)
        v = core.model_uniform(y, i)
        if string.equals(u.name, v.name) == 0 || u.kind != v.kind || !near(u.number, v.number) || u.integer != v.integer { return false }
        if (u.array == null) != (v.array == null) { return false }
        if u.array != null {
            if core.farr_count(u.array) != core.farr_count(v.array) { return false }
            k = 0
            while k < core.farr_count(u.array) {
                if !near(core.farr_get(u.array, k), core.farr_get(v.array, k)) { return false }
                k = k + 1
            }
        }
        i = i + 1
    }
    return true
}

same_light(x: *Light, y: *Light) -> bool {
    if x == null || y == null { return x == null && y == null }
    return x.mode == y.mode && near3(x.position, y.position) && near3(x.direction, y.direction) && near3(x.color, y.color) &&
           near(x.intensity, y.intensity) && near(x.linear_atten, y.linear_atten) && near(x.quadratic_atten, y.quadratic_atten) &&
           near(x.spot_cos_inner, y.spot_cos_inner) && near(x.spot_cos_outer, y.spot_cos_outer)
}

same_lights(label: string, a: ptr, b: ptr) {
    ok = list.size(a) == list.size(b)
    i = 0
    while ok && i < list.size(a) {
        ok = same_light(list.get_raw(a, i) as *Light, list.get_raw(b, i) as *Light)
        i = i + 1
    }
    check("${label}: the scene's lights", ok)
}

// The attachments of two scenes, matched by their models' places.
same_attachments(label: string, models_a: ptr, a: ptr, models_b: ptr, b: ptr) {
    check("${label}: as many models carry something (${list.size(a)}, ${list.size(b)})", list.size(a) == list.size(b))
    if list.size(a) != list.size(b) { return }
    i = 0
    while i < list.size(a) {
        x = list.get_raw(a, i) as *Attachment
        y = list.get_raw(b, i) as *Attachment
        what = "${label}: what model ${scene.index_of_model(models_a, x.model as *Model)} carries"
        check("${what}: on the same model", scene.index_of_model(models_a, x.model as *Model) == scene.index_of_model(models_b, y.model as *Model))
        check("${what}: its kind and script", string.equals(x.component, y.component) == 1 && string.equals(x.script, y.script) == 1)
        p = scene.attachment_physics(x)
        q = scene.attachment_physics(y)
        bodies = (p == null) == (q == null)
        if p != null && q != null {
            bodies = string.equals(p.body, q.body) == 1 && string.equals(p.collider, q.collider) == 1 &&
                     near(p.friction, q.friction) && near(p.density, q.density) && p.trigger == q.trigger
        }
        check("${what}: its body", bodies)
        check("${what}: its light", same_light(scene.attachment_light(x), scene.attachment_light(y)))
        check("${what}: water on both or neither", (x.water == null) == (y.water == null))
        i = i + 1
    }
}

// The components a file holds against the scene's: each by model and kind,
// with every field the scene gave it.
same_components(label: string, built: ptr, loaded: ptr) {
    i = 0
    while i < list.size(built) {
        c = list.get_raw(built, i) as *LoadedComponent
        found = null as *LoadedComponent
        k = 0
        while k < list.size(loaded) {
            d = list.get_raw(loaded, k) as *LoadedComponent
            if d.model == c.model && string.equals(d.kind, c.kind) == 1 { found = d }
            k = k + 1
        }
        what = "${label}: ${c.kind} on ${c.model}"
        check("${what}: in the file", found != null)
        if found != null {
            same = true
            f = 0
            while f < json.object_size_raw(c.fields) {
                key = json.object_key_at(c.fields, f)
                mine = json.object_value_at(c.fields, f)
                theirs = json.object_get_raw(found.fields, key)
                // A field naming another object is the refs' (checked
                // below): placing writes the object's id over it.
                named = c.refs != null && json.object_get_raw(c.refs, key) != null
                if theirs == null && !named { same = false }
                if theirs != null && !named && json.json_type(mine) == json.JSON_NUMBER && !near(json.get_number(mine), json.get_number(theirs)) { same = false }
                f = f + 1
            }
            check("${what}: every field the scene gave it", same)
            if c.refs != null {
                check("${what}: naming the same model", found.refs != null &&
                      json.get_int(json.object_get_raw(found.refs, "target")) == json.get_int(json.object_get_raw(c.refs, "target")))
            }
        }
        i = i + 1
    }
}

main() {
    println("scenedsl: a scene written as nested builders is the scene a file loads")
    leash_kind()
    fs.mkdir_p("build/scenedsl/")
    path = "build/scenedsl/yard.json"

    s = yard()
    check("every builder was written where it means something (${scenedsl.error(s)})", scenedsl.errors(s) == 0)
    built = scenedsl.models(s)
    check("six models, parents before children", list.size(built) == 6)
    kennel = list.get_raw(built, 1) as *Model
    dog = list.get_raw(built, 2) as *Model
    check("a model in a model's block is its child", core.model_parent(dog) == kennel &&
          core.model_parent(kennel) == list.get_raw(built, 0) as *Model)
    check("the scene's lights: the sun first", list.size(scenedsl.lights(s)) == 2 &&
          near((list.get_raw(scenedsl.lights(s), 0) as *Light).intensity, 2.5))
    marker = null as *Attachment
    k = 0
    while k < list.size(scenedsl.attachments(s)) {
        a = list.get_raw(scenedsl.attachments(s), k) as *Attachment
        if a.model == list.get_raw(built, 3) { marker = a }
        k = k + 1
    }
    check("a light in a model's block is the model's own", marker != null && scene.attachment_light(marker) != null &&
          string.equals(marker.component, "light") == 1)
    cam = null as *LoadedComponent
    k = 0
    while k < list.size(scenedsl.components(s)) {
        c = list.get_raw(scenedsl.components(s), k) as *LoadedComponent
        if string.equals(c.kind, "Camera") == 1 { cam = c }
        k = k + 1
    }
    check("the camera is the scene's, looking at the middle",
          cam != null && cam.model < 0 && near(json.get_number(json.object_get_raw(cam.fields, "yaw")), 0.0 - 90.0) &&
          json.get_number(json.object_get_raw(cam.fields, "pitch")) < 0.0)

    // Built where it means nothing: said, and done nowhere.
    wrong = scene() {
        color(1.0, 0.0, 0.0)
        cube(1.0) { look_at(0.0, 0.0, 0.0) }
        model("resources/obj/no_such.obj") { cube(1.0) }
    }
    check("a builder out of place, and a model whose file is gone, are said (${scenedsl.errors(wrong)})",
          scenedsl.errors(wrong) == 3 && list.size(scenedsl.models(wrong)) == 1)
    scenedsl.release(wrong)

    // Placed in an engine, saved, and loaded back.
    e = engine.engine_new()
    objects = scenedsl.place(e, s)
    check("each model an object", list.size(objects) == 6)
    leash = component.find(list.get_raw(objects, 5) as *GameObject, leash_kind())
    check("a component names the object of the model it named",
          leash != null && component.get_object(leash, component.field_named(leash_kind(), "target")) == list.get_raw(objects, 2) as *GameObject)
    owned = component.saved_for(engine.engine_scene(e))
    check("the scene saves", scene.scene_save(built, scenedsl.lights(s), scenedsl.attachments(s), owned, path, "build/scenedsl/"))
    scene.saved_components_free(owned)
    loaded = scene.scene_load(path)
    check("and loads", loaded != null)
    lamps = scene.scene_load_lights(path)
    carried = scene.scene_load_attachments(path, loaded)
    comps = scene.scene_load_components(path)
    same_models("built, and loaded from its file", built, loaded)
    same_lights("built, and loaded from its file", scenedsl.lights(s), lamps)
    same_attachments("built, and loaded from its file", built, scenedsl.attachments(s), loaded, carried)
    same_components("built, and loaded from its file", scenedsl.components(s), comps)

    // The file as code: what the golden module says, and what it builds.
    text = scenedsl.text_from_file(path)
    golden, err = fs.read("tests/fixtures/scene/written/module.ae")
    matches = err == "" && same_code(text, golden)
    check("the file written as code is the golden module, its numbers to twelve digits", matches)
    if !matches {
        fs.write("build/scenedsl/written.ae", text)
        println("  the code written is build/scenedsl/written.ae: where the change is meant, copy it over tests/fixtures/scene/written/module.ae")
    }
    string.free(text)
    string.free(golden)
    again = written.build()
    check("the golden module builds with no errors (${scenedsl.error(again)})", scenedsl.errors(again) == 0)
    same_models("loaded, and built from its code", loaded, scenedsl.models(again))
    same_lights("loaded, and built from its code", lamps, scenedsl.lights(again))
    same_attachments("loaded, and built from its code", loaded, carried, scenedsl.models(again), scenedsl.attachments(again))
    same_components("built from its code, and loaded", scenedsl.components(again), comps)

    scenedsl.release(again)
    k = 0
    while k < list.size(lamps) {
        core.light_free(list.get_raw(lamps, k) as *Light)
        k = k + 1
    }
    list.free(lamps)
    k = 0
    while k < list.size(carried) {
        a = list.get_raw(carried, k) as *Attachment
        if a.light != null { core.light_free(a.light as *Light) }
        if a.water != null {
            sim = a.water as *Simulation
            sim.model = null
            water.simulation_free(sim)
        }
        k = k + 1
    }
    scene.attachments_free(carried)
    scene.loaded_components_free(comps)
    scene.scene_free(loaded)
    list.free(objects)
    engine.engine_free(e)
    scenedsl.release(s)
    if g_failures == 0 {
        println("scenedsl: all checks passed (${g_checks})")
    } else {
        println("scenedsl: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
