// Flames simulated, not drawn (#738), held to what a flame does. No window.
//
//   - the same seed bakes the same flames, to the byte; another, others;
//   - the heat rises: its middle climbs from the first frame to the eighth;
//   - it burns out: the last frame gives off a small share of the light its
//     hottest does (a black body's, the fourth power of its heat);
//   - it is a flame, not a column: hottest low, its heat thinning upward;
//   - nothing reaches a frame's edge, so no quad shows a cut-off rim;
//   - the smoke flipbook is white, its alpha the smoke.
import std.mem
import ae3d.picture
import ae3d.flames

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Frame `f`'s pixel at (x, y), y up from the frame's foot: the flipbook is
// kept bottom row first, its first frame at the top left.
byte_at(pixels: ptr, f: int, x: int, y: int, channel: int) -> int {
    column = f % flames.COLUMNS
    row = f / flames.COLUMNS
    width = flames.FRAME_WIDTH * flames.COLUMNS
    px = column * flames.FRAME_WIDTH + x
    py = (flames.ROWS - 1 - row) * flames.FRAME_HEIGHT + y
    return mem.get_byte(pixels, (py * width + px) * 4 + channel)
}

// A frame's heat in all, and the height of its middle, in cells.
struct Heat {
    total: float
    light: float                     // the fourth power of the heat, summed
    middle: float
    low: float                       // in the frame's lowest third
    high: float                      // and its highest
}

heat_of(pixels: ptr, f: int) -> Heat {
    total = 0.0
    light = 0.0
    weighted = 0.0
    low = 0.0
    high = 0.0
    y = 0
    while y < flames.FRAME_HEIGHT {
        x = 0
        while x < flames.FRAME_WIDTH {
            h = byte_at(pixels, f, x, y, 0) as float / 255.0
            total = total + h
            light = light + h * h * h * h
            weighted = weighted + h * (y as float)
            if y < flames.FRAME_HEIGHT / 3 { low = low + h }
            if y >= flames.FRAME_HEIGHT * 2 / 3 { high = high + h }
            x = x + 1
        }
        y = y + 1
    }
    middle = 0.0
    if total > 0.0 { middle = weighted / total }
    return Heat { total: total, light: light, middle: middle, low: low, high: high }
}

// The most alpha anywhere on a frame's outermost ring of pixels.
rim_alpha(pixels: ptr, f: int) -> int {
    most = 0
    x = 0
    while x < flames.FRAME_WIDTH {
        a = byte_at(pixels, f, x, 0, 3)
        b = byte_at(pixels, f, x, flames.FRAME_HEIGHT - 1, 3)
        if a > most { most = a }
        if b > most { most = b }
        x = x + 1
    }
    y = 0
    while y < flames.FRAME_HEIGHT {
        a = byte_at(pixels, f, 0, y, 3)
        b = byte_at(pixels, f, flames.FRAME_WIDTH - 1, y, 3)
        if a > most { most = a }
        if b > most { most = b }
        y = y + 1
    }
    return most
}

same_bytes(a: ptr, b: ptr, n: int) -> bool {
    i = 0
    while i < n {
        if mem.get_byte(a, i) != mem.get_byte(b, i) { return false }
        i = i + 1
    }
    return true
}

main() {
    println("flames: a fluid baked into a flipbook (#738)")
    check("a seed bakes", flames.bake("test://flames/a", "test://smoke/a", 7) == 1)
    check("the same seed again", flames.bake("test://flames/b", "", 7) == 1)
    check("and another", flames.bake("test://flames/c", "", 8) == 1)
    a = picture.load("test://flames/a")
    b = picture.load("test://flames/b")
    c = picture.load("test://flames/c")
    smoke = picture.load("test://smoke/a")
    w = picture.width(a)
    h = picture.height(a)
    n = w * h * 4
    check("a flipbook of ${flames.COLUMNS} by ${flames.ROWS} frames of ${flames.FRAME_WIDTH} by ${flames.FRAME_HEIGHT}",
          w == flames.COLUMNS * flames.FRAME_WIDTH && h == flames.ROWS * flames.FRAME_HEIGHT)
    pa = picture.pixels(a)
    check("the same seed bakes the same flames, to the byte", same_bytes(pa, picture.pixels(b), n))
    check("and another seed others", !same_bytes(pa, picture.pixels(c), n))

    frames = flames.COLUMNS * flames.ROWS
    first = heat_of(pa, 0)
    eighth = heat_of(pa, 7)
    last = heat_of(pa, frames - 1)
    brightest = 0.0
    f = 0
    while f < frames {
        t = heat_of(pa, f).light
        if t > brightest { brightest = t }
        f = f + 1
    }
    println("  the heat's middle: ${first.middle} cells up at the first frame, ${eighth.middle} at the eighth; its light ${brightest} at the brightest, ${last.light} at the last")
    check("the heat rises: its middle climbs from the first frame to the eighth", eighth.middle > first.middle + 10.0)
    check("it burns out: the last frame gives off under a fiftieth of the brightest's light", last.light < brightest * 0.02)
    println("  the eighth frame's heat: ${eighth.low} in its lowest third, ${eighth.high} in its highest")
    check("a flame, not a column: hottest low, thinning upward", eighth.low > eighth.high * 2.0)
    most = 0
    f = 0
    while f < frames {
        r = rim_alpha(pa, f)
        if r > most { most = r }
        f = f + 1
    }
    check("nothing reaches a frame's edge (the most alpha on any rim ${most})", most == 0)
    ps = picture.pixels(smoke)
    white = true
    smoky = 0
    i = 0
    while i < w * h {
        if mem.get_byte(ps, i * 4) != 255 || mem.get_byte(ps, i * 4 + 1) != 255 { white = false }
        if mem.get_byte(ps, i * 4 + 3) > 20 { smoky = smoky + 1 }
        i = i + 1
    }
    check("the smoke is white, its alpha the smoke (${smoky} texels of it)", white && smoky > w * h / 50)
    picture.dispose(a)
    picture.dispose(b)
    picture.dispose(c)
    picture.dispose(smoke)
    if g_failures == 0 {
        println("flames: all checks passed (${g_checks})")
    } else {
        println("flames: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
