// The fly camera's mouse look reads the cursor through ae3d.input, as its
// other controls do (#724): an injected cursor moved across with the look
// button held turns the camera, the way a real one does, and with the
// button up the same cursor turns nothing. Read off the window, a scripted
// or headless run's cursor never moved and the look never turned.

import ae3d.core
import ae3d.engine
import ae3d.input
import ae3d.platform

const FRAMES = 40

var failures = 0
var g_frame = 0
var g_yaw_start = 0.0
var g_yaw_held = 0.0
var g_yaw_end = 0.0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// Twenty frames with the look held and the cursor moved 12 px a frame,
// then twenty with it up and the cursor moving on.
update(state: ptr, e: *Engine, delta: float) {
    keys = engine.engine_input(e)
    cam = engine.engine_camera(e)
    g_frame = g_frame + 1
    if g_frame == 1 { g_yaw_start = cam.yaw }
    held = g_frame <= 20
    input.inject_mouse(keys, platform.MOUSE_RIGHT, held)
    input.inject_cursor(keys, 100.0 + (g_frame as float) * 12.0, 90.0)
    if g_frame == 21 { g_yaw_held = cam.yaw }
    g_yaw_end = cam.yaw
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 180)
    engine.engine_set_title(e, "ae3d fly look test")
    engine.engine_set_frame_limit(e, FRAMES)
    engine.engine_set_camera_input(e, true)
    engine.engine_set_shadows(e, false)
    b = engine.behaviour_new("the look", null)
    b.update = update
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("fly_look: SKIP no window available")
        engine.engine_free(e)
        return
    }
    turned = g_yaw_held - g_yaw_start
    after = g_yaw_end - g_yaw_held
    println("       held: ${turned} degrees; up: ${after}")
    check("an injected cursor turns the look while it is held (${turned} degrees)", turned > 10.0)
    check("and with the look up it turns nothing (${after} degrees)", after < 0.001 && after > 0.0 - 0.001)
    engine.engine_free(e)
    if failures == 0 {
        println("fly_look: all checks passed")
    } else {
        println("fly_look: ${failures} failure(s)")
    }
}
