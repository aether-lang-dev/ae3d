// The cluster cut on the Vulkan device (#536): a mesh drawn at the detail
// its distance needs, chosen each frame for each of its instances.
//
// A sphere of 65,536 triangles near the camera and a row of the same sphere
// far off, instanced: the frame with the cut is the frame without it, to
// within what a pixel of error shows -- along the silhouettes, nowhere
// else; the far row is drawn with a small
// share of its triangles; turned away from the view, nothing is kept; and
// coming closer, the cut takes more.

import std.mem
import ae3d.core
import ae3d.vulkan
import ae3d.loader
import ae3d.rendering

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr

const WIDTH = 320
const HEIGHT = 180
const FAR = 24

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// The frame after a few: the cut reads back what it kept a frame in flight
// later, and the budgets settle in a frame or two.
settle(backend: *Backend, cam: *Camera, light: *Light) -> ptr {
    i = 0
    while i < 6 {
        core.backend_render(backend, cam, light)
        i = i + 1
    }
    return core.backend_frame_pixels(backend)
}

// The two frames' pixels that differ by more than `by` in a channel.
differing(a: ptr, b: ptr, by: int) -> int {
    n = 0
    i = 0
    while i < WIDTH * HEIGHT {
        c = 0
        off = false
        while c < 3 {
            d = mem.get_byte(a, i * 4 + c) - mem.get_byte(b, i * 4 + c)
            if d > by || d < 0 - by { off = true }
            c = c + 1
        }
        if off { n = n + 1 }
        i = i + 1
    }
    return n
}

// Of the pixels that differ, those more than a pixel from the background
// in both frames: a difference inside a surface rather than along its edge.
inside(a: ptr, b: ptr, by: int) -> int {
    n = 0
    y = 1
    while y < HEIGHT - 1 {
        x = 1
        while x < WIDTH - 1 {
            i = y * WIDTH + x
            off = false
            c = 0
            while c < 3 {
                d = mem.get_byte(a, i * 4 + c) - mem.get_byte(b, i * 4 + c)
                if d > by || d < 0 - by { off = true }
                c = c + 1
            }
            if off && !by_background(a, x, y) && !by_background(b, x, y) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// Whether a pixel round (x, y), or it, is the clear colour.
by_background(p: ptr, x: int, y: int) -> bool {
    dy = 0 - 1
    while dy <= 1 {
        dx = 0 - 1
        while dx <= 1 {
            i = (y + dy) * WIDTH + x + dx
            if mem.get_byte(p, i * 4) + mem.get_byte(p, i * 4 + 1) + mem.get_byte(p, i * 4 + 2) == 0 { return true }
            dx = dx + 1
        }
        dy = dy + 1
    }
    return false
}

// Pixels that are not the clear colour (black).
drawn(pixels: ptr) -> int {
    n = 0
    i = 0
    while i < WIDTH * HEIGHT {
        if mem.get_byte(pixels, i * 4) + mem.get_byte(pixels, i * 4 + 1) + mem.get_byte(pixels, i * 4 + 2) > 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

census(renderer: ptr, counts: ptr) -> bool {
    return vulkan.renderer_cut_census(renderer as *VKRenderer, counts)
}

main() {
    if !vulkan.available() {
        println("cluster cut: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("cluster cut: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    vulkan.renderer_set_clusters(renderer, core.CLUSTERS_ON)
    if !vulkan.renderer_clusters(renderer) {
        println("cluster cut: SKIP the device draws no cluster cut (multiDrawIndirect, drawIndirectFirstInstance)")
        vulkan.renderer_free(renderer)
        return
    }

    near = loader.sphere(1.0, 256, 128)
    core.model_set_position(near, 0.0, 1.0, 0.0)
    core.model_matte(near, 0.8, 0.7, 0.6)
    rendering.apply(near, rendering.default_config())
    core.backend_add_model(&backend, near)
    full = core.mesh_index_count(near.mesh)
    // The row: the same sphere, a few hundred metres off.
    row = loader.sphere(1.0, 256, 128)
    core.model_matte(row, 0.6, 0.7, 0.8)
    core.model_enable_instancing(row, FAR)
    i = 0
    while i < FAR {
        core.model_set_instance_position(row, i, core.vec3((i - FAR / 2) as float * 12.0, 4.0, 0.0 - 300.0))
        i = i + 1
    }
    rendering.apply(row, rendering.default_config())
    core.backend_add_model(&backend, row)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 1.5, 4.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 1.0, 0.4))
    light.intensity = 3.0
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)

    counts = calloc(3, 4)
    c = counts as int[]
    cut = calloc(WIDTH * HEIGHT, 4)
    memcpy(cut, settle(&backend, cam, light), (WIDTH * HEIGHT * 4) as long)
    check("the cut is on", census(renderer as ptr, counts))
    check("both spheres are drawn by a cut (${c[0]})", c[0] == 2)
    kept = c[1]
    indices = c[2]
    whole = full * (FAR + 1)
    println("       in view: ${kept} clusters, ${indices} of ${whole} indices")
    check("the far row and the near sphere draw a small share of their triangles (${indices} of ${whole})",
          indices > 0 && indices * 4 < whole)

    vulkan.renderer_set_clusters(renderer, core.CLUSTERS_OFF)
    check("the cut is off", !vulkan.renderer_clusters(renderer))
    plain = settle(&backend, cam, light)
    lit = drawn(plain)
    off = differing(cut, plain, 24)
    within = inside(cut, plain, 24)
    println("       ${lit} pixels drawn, ${off} differ, ${within} of them off the silhouettes")
    check("the frame drew the spheres (${lit} pixels)", lit > WIDTH * HEIGHT / 10)
    // A pixel of error moves an edge by up to a pixel: the frames may part
    // along the silhouettes, and only there.
    check("the frame with the cut is the frame without it but along its edges (${within} pixels inside)", within == 0)
    check("and few along them (${off} of ${lit})", off * 50 < lit)

    vulkan.renderer_set_clusters(renderer, core.CLUSTERS_ON)
    core.camera_set_position(cam, core.vec3(0.0, 1.5, 4.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.5, 40.0))
    settle(&backend, cam, light)
    census(renderer as ptr, counts)
    check("turned away, nothing is kept (${c[1]} clusters)", c[1] == 0)

    // The near sphere alone, the row behind the camera: from 30 metres,
    // then from 3.
    core.camera_set_position(cam, core.vec3(0.0, 1.0, 0.0 - 30.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))
    settle(&backend, cam, light)
    census(renderer as ptr, counts)
    afar = c[2]
    core.camera_set_position(cam, core.vec3(0.0, 1.0, 0.0 - 3.0))
    settle(&backend, cam, light)
    census(renderer as ptr, counts)
    println("       the near sphere from 30 m: ${afar} indices, from 3 m: ${c[2]}")
    check("nearer, the cut takes more of it (${c[2]} against ${afar})", c[2] > afar * 4)

    free(cut)
    free(counts)
    core.light_free(light)
    core.camera_free(cam)
    vulkan.renderer_free(renderer)
    core.model_free(near)
    core.model_free(row)
    if failures == 0 {
        println("cluster cut: all checks passed")
    } else {
        println("cluster cut: ${failures} failure(s)")
    }
}
