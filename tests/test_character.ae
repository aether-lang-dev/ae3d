// The character controller (#420): a capsule that walks the world, held to
// numbers. Each character walks its own lane of one ground:
//
//   - the walker: on the flat, at the speed asked, within 1%;
//   - the climber: up a 0.3 m step (under its 0.35 m step height);
//   - the stopped: at a 0.5 m step, which it cannot walk up;
//   - the stander: on a 40 degree ramp with no input, it stays put;
//   - the slider: on a 50 degree ramp, past its 45 degree limit, it slides;
//   - the refused: walking into a 50 and a 60 degree ramp, it does not walk
//     up them, and a 0.4 m kerb (a step past its 0.35 m) stops it (#527);
//   - the jumper: leaves the ground at 5 m/s and peaks at v^2 / 2g, within 2%;
//   - the pusher: walks into a 20 kg crate, which slides ahead of it;
//   - the blocked: walks into an 800 kg crate, which a person's 400 N
//     against its friction does not move, and is stopped by it;
//   - the recorded: a box centred on its origin, 1.8 m tall, given a
//     character record as the editor gives it (scene.PhysicsSpec, body
//     "character"): dropped from 2 m, it stands with its bottom on the
//     ground, and records itself as a character;
//   - the stooped: walks under a stair's underside, sloping down ahead at
//     30 degrees, and stops where its head meets it, its feet on the floor.
//     Pressed down and back by it, a capsule slid down the slope into the
//     floor, could not be lifted back up under it, and fell until its own
//     bottom rested on the floor, its feet a step height under it; a plaza
//     walker beside another, its shoulder over its capsule, walked on 0.355 m
//     under the ground that way;
//   - the sheltered: walks at a 0.3 m step under an awning 1.95 m up, which
//     its 1.8 m capsule fits under on the floor but not on the step, and
//     stops at the step, its feet on the floor. It walked on over the step,
//     its feet 0.35 m inside it;
//   - and none is left inside what it walks on or into: every character's
//     overlap with the world, measured at the end, under a millimetre past
//     the solver's slop.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.scene

extern sqrt(x: float) -> float

const STEPS = 180                    // three seconds at 60
const WALK = 3.0                     // metres a second
const JUMP = 5.0                     // metres a second, up

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Lanes {
    walker: ptr                      // *CharacterController
    climber: ptr
    stopped: ptr
    stander: ptr
    slider: ptr
    jumper: ptr
    steps: int
    walker_start: float
    walker_after_second: float       // x one second into walking
    stander_start: float             // y where the stander was put down
    slider_start: float
    jump_ground: float
    jump_peak: float
    jumped: bool
    climber_high: float              // the climber's feet, their highest
    pusher: ptr
    blocked: ptr
    light: ptr                       // *GameObject, the 20 kg crate
    heavy: ptr                       // and the 800 kg one
    light_start: float
    heavy_start: float
    recorded: ptr                    // *GameObject, the box with a character record
    up50: ptr                        // walking into a 50 degree ramp
    up60: ptr                        // and a 60 degree one
    kerb: ptr                        // and a 0.4 m kerb
    high50: float                    // their feet, their highest
    high60: float
    high_kerb: float
    stooped: ptr                     // under a stair's underside
    sheltered: ptr                   // at a step under an awning
    stooped_low: float               // their feet, their lowest
    sheltered_low: float
    sheltered_high: float            // and the sheltered's highest
}

character(e: *Engine, name: string, at: Vec3) -> *CharacterController {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    return physics.character_controller(o, 0.3, 1.8)
}

feet(c: *CharacterController) -> Vec3 {
    return behaviour.object_position(c.object as *GameObject)
}

// A static box, centred at `at`, `half` its half extents, turned `pitch`
// radians about x (a ramp).
block(e: *Engine, name: string, at: Vec3, half: Vec3, pitch: float) {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    if pitch != 0.0 { behaviour.object_set_rotation(o, core.quat_rotate(pitch, core.vec3(1.0, 0.0, 0.0))) }
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

start(state: ptr, e: *Engine) {
    s = state as *Lanes
    physics.attach(e)
    block(e, "Ground", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(60.0, 0.5, 60.0), 0.0)
    // The steps, across the climber's and the stopped's lanes, 3 m ahead.
    block(e, "Low step", core.vec3(0.0 - 4.0, 0.15, 5.0), core.vec3(1.0, 0.15, 2.0), 0.0)
    block(e, "High step", core.vec3(0.0 - 8.0, 0.25, 5.0), core.vec3(1.0, 0.25, 2.0), 0.0)
    // The ramps: 40 and 50 degrees, rising toward +z.
    block(e, "Ramp 40", core.vec3(4.0, 0.0, 6.0), core.vec3(1.0, 0.1, 6.0), 0.0 - 0.6981)
    block(e, "Ramp 50", core.vec3(8.0, 0.0, 6.0), core.vec3(1.0, 0.1, 6.0), 0.0 - 0.8727)
    s.walker = character(e, "Walker", core.vec3(0.0, 0.0, 0.0 - 10.0)) as ptr
    s.climber = character(e, "Climber", core.vec3(0.0 - 4.0, 0.0, 1.0)) as ptr
    s.stopped = character(e, "Stopped", core.vec3(0.0 - 8.0, 0.0, 1.0)) as ptr
    // On the ramps, four metres along them from their middles, just above
    // their surfaces (d tan(pitch) + 0.1 / cos(pitch)).
    s.stander = character(e, "Stander", core.vec3(4.0, 3.52, 10.0)) as ptr
    s.slider = character(e, "Slider", core.vec3(8.0, 4.95, 10.0)) as ptr
    s.jumper = character(e, "Jumper", core.vec3(12.0, 0.0, 0.0)) as ptr
    // The crates, 2 m ahead of their characters, a metre on a side: 20 kg
    // and 800 kg.
    s.light = crate(e, "Light crate", core.vec3(16.0, 0.5, 2.0), 20.0) as ptr
    s.heavy = crate(e, "Heavy crate", core.vec3(20.0, 0.5, 2.0), 800.0) as ptr
    s.light_start = behaviour.object_position(s.light as *GameObject).z
    s.heavy_start = behaviour.object_position(s.heavy as *GameObject).z
    // The recorded: a unit cube stretched to 0.6 x 1.8 x 0.6, centred on its
    // origin, 2 m up.
    boxy = loader.cube(1.0)
    core.model_set_scale(boxy, 0.6, 1.8, 0.6)
    recorded = engine.object(e, "Recorded", boxy)
    behaviour.object_set_position(recorded, core.vec3(24.0, 2.0, 0.0))
    spec = scene.physics_spec_new("character", "capsule", 0.0, 0.0, 1.0)
    physics.apply_spec(recorded, spec)
    heap.free(spec)
    s.recorded = recorded as ptr
    // The refused: a 50 and a 60 degree ramp rising toward +z, their feet
    // about 2 m ahead, and a 0.4 m kerb whose face is at z = 3.
    block(e, "Steep 50", core.vec3(28.0, 0.0, 6.0), core.vec3(1.0, 0.1, 6.0), 0.0 - 0.8727)
    block(e, "Steep 60", core.vec3(32.0, 0.0, 6.0), core.vec3(1.0, 0.1, 6.0), 0.0 - 1.0472)
    block(e, "Kerb", core.vec3(36.0, 0.2, 5.0), core.vec3(1.0, 0.2, 2.0), 0.0)
    s.up50 = character(e, "Up 50", core.vec3(28.0, 0.0, 0.0)) as ptr
    s.up60 = character(e, "Up 60", core.vec3(32.0, 0.0, 0.0)) as ptr
    s.kerb = character(e, "At the kerb", core.vec3(36.0, 0.0, 1.0)) as ptr
    // The stair's underside: a slab 0.2 m thick pitched 30 degrees, its
    // underside 1.81 m up at z = 3.95 and coming down toward +z to the
    // floor. The awning: 1.95 m up over a 0.3 m step whose face is at z = 3.
    block(e, "Stair", core.vec3(40.0, 1.9, 4.0), core.vec3(1.0, 0.1, 4.0), 0.5236)
    block(e, "Sheltered step", core.vec3(44.0, 0.15, 5.0), core.vec3(1.0, 0.15, 2.0), 0.0)
    block(e, "Awning", core.vec3(44.0, 2.05, 5.0), core.vec3(1.0, 0.1, 2.0), 0.0)
    s.stooped = character(e, "Stooped", core.vec3(40.0, 0.0, 0.0)) as ptr
    s.sheltered = character(e, "Sheltered", core.vec3(44.0, 0.0, 1.0)) as ptr
    s.pusher = character(e, "Pusher", core.vec3(16.0, 0.0, 0.0)) as ptr
    s.blocked = character(e, "Blocked", core.vec3(20.0, 0.0, 0.0)) as ptr
}

crate(e: *Engine, name: string, at: Vec3, density: float) -> *GameObject {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    physics.rigidbody(o, physics.DYNAMIC)
    physics.box_collider(o, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0), density)
    return o
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Lanes
    s.steps = s.steps + 1
    still = core.vec3(0.0, 0.0, 0.0)
    ahead = core.vec3(0.0, 0.0, WALK)
    walker = s.walker as *CharacterController
    if s.steps == 30 { s.walker_start = feet(walker).z }
    if s.steps >= 30 && s.steps < 90 {
        physics.character_move(walker, ahead, 0.0, step)
    } else {
        physics.character_move(walker, still, 0.0, step)
    }
    if s.steps == 90 { s.walker_after_second = feet(walker).z }
    physics.character_move(s.climber as *CharacterController, ahead, 0.0, step)
    climbed = feet(s.climber as *CharacterController).y
    if climbed > s.climber_high { s.climber_high = climbed }
    physics.character_move(s.stopped as *CharacterController, ahead, 0.0, step)
    stander = s.stander as *CharacterController
    slider = s.slider as *CharacterController
    physics.character_move(stander, still, 0.0, step)
    physics.character_move(slider, still, 0.0, step)
    // Settled on their ramps after a quarter second, then watched.
    if s.steps == 15 {
        s.stander_start = feet(stander).y
        s.slider_start = feet(slider).y
    }
    jumper = s.jumper as *CharacterController
    jump = 0.0
    if s.steps == 60 && physics.character_grounded(jumper) {
        s.jump_ground = feet(jumper).y
        jump = JUMP
        s.jumped = true
    }
    physics.character_move(jumper, still, jump, step)
    physics.character_move(s.pusher as *CharacterController, ahead, 0.0, step)
    physics.character_move(s.blocked as *CharacterController, ahead, 0.0, step)
    if s.jumped && feet(jumper).y > s.jump_peak { s.jump_peak = feet(jumper).y }
    physics.character_move(s.up50 as *CharacterController, ahead, 0.0, step)
    physics.character_move(s.up60 as *CharacterController, ahead, 0.0, step)
    physics.character_move(s.kerb as *CharacterController, ahead, 0.0, step)
    if feet(s.up50 as *CharacterController).y > s.high50 { s.high50 = feet(s.up50 as *CharacterController).y }
    if feet(s.up60 as *CharacterController).y > s.high60 { s.high60 = feet(s.up60 as *CharacterController).y }
    if feet(s.kerb as *CharacterController).y > s.high_kerb { s.high_kerb = feet(s.kerb as *CharacterController).y }
    stooped = s.stooped as *CharacterController
    sheltered = s.sheltered as *CharacterController
    physics.character_move(stooped, ahead, 0.0, step)
    physics.character_move(sheltered, ahead, 0.0, step)
    if feet(stooped).y < s.stooped_low { s.stooped_low = feet(stooped).y }
    if feet(sheltered).y < s.sheltered_low { s.sheltered_low = feet(sheltered).y }
    if feet(sheltered).y > s.sheltered_high { s.sheltered_high = feet(sheltered).y }
    if s.steps >= STEPS { engine.engine_stop(e) }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_title(e, "ae3d character test")
    engine.engine_set_camera_input(e, false)
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_frame_limit(e, 100000)
    lanes = Lanes { walker: null, climber: null, stopped: null, stander: null, slider: null, jumper: null, steps: 0,
                    walker_start: 0.0, walker_after_second: 0.0, stander_start: 0.0, slider_start: 0.0,
                    jump_ground: 0.0, jump_peak: 0.0, jumped: false, climber_high: 0.0,
                    pusher: null, blocked: null, light: null, heavy: null, light_start: 0.0, heavy_start: 0.0,
                    recorded: null, up50: null, up60: null, kerb: null, high50: 0.0, high60: 0.0, high_kerb: 0.0,
                    stooped: null, sheltered: null, stooped_low: 0.0, sheltered_low: 0.0, sheltered_high: 0.0 }
    b = engine.behaviour_new("lanes", (&lanes) as ptr)
    b.start = start
    b.fixed_update = fixed_update
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("character: SKIP no window available")
        engine.engine_free(e)
        return
    }
    println("character: a capsule that walks the world, ${lanes.steps} fixed steps")

    walked = lanes.walker_after_second - lanes.walker_start
    println("  walker: ${walked} m in a second at ${WALK} m/s")
    check("on the flat it walks at the speed asked, within 1%", walked > WALK * 0.99 && walked < WALK * 1.01)

    climber = feet(lanes.climber as *CharacterController)
    println("  climber: its feet up to ${lanes.climber_high} m, and at z ${climber.z} at the end")
    check("it walks up a 0.3 m step and over it", lanes.climber_high > 0.29 && lanes.climber_high < 0.31 && climber.z > 7.0)

    stopped = feet(lanes.stopped as *CharacterController)
    println("  stopped: at z ${stopped.z}, y ${stopped.y}")
    check("and stops at a 0.5 m one", stopped.y < 0.01 && stopped.z < 3.0)

    stander = feet(lanes.stander as *CharacterController)
    moved = stander.y - lanes.stander_start
    println("  stander: ${moved} m in two and three quarter seconds on 40 degrees; grounded ${physics.character_grounded(lanes.stander as *CharacterController)}")
    check("on a 40 degree ramp it stays put", moved > 0.0 - 0.01 && moved < 0.01 && physics.character_grounded(lanes.stander as *CharacterController))

    slider = feet(lanes.slider as *CharacterController)
    slid = slider.y - lanes.slider_start
    println("  slider: ${slid} m on 50 degrees")
    check("on a 50 degree ramp it slides down", slid < 0.0 - 0.5)

    kerb_at = feet(lanes.kerb as *CharacterController)
    println("  refused: walking into 50 degrees its feet rose to ${lanes.high50} m, into 60 to ${lanes.high60} m; at a 0.4 m kerb to ${lanes.high_kerb} m, stopping at z ${kerb_at.z} (its face at 3)")
    check("walking into a 50 or a 60 degree ramp, it does not walk up it", lanes.high50 < 0.1 && lanes.high60 < 0.1)
    check("and a 0.4 m kerb, past its step height, stops it at its face", lanes.high_kerb < 0.01 && kerb_at.z < 3.0)

    stooped = lanes.stooped as *CharacterController
    stooped_at = feet(stooped)
    println("  stooped: its feet down to ${lanes.stooped_low * 1000.0} mm, stopping at z ${stooped_at.z} (its head meets the underside at 3.89), grounded ${physics.character_grounded(stooped)}")
    check("walking under a stair's underside, it stops where its head meets it, its feet on the floor",
          lanes.stooped_low > 0.0 - 0.001 && stooped_at.z < 3.95 && physics.character_grounded(stooped))
    sheltered = lanes.sheltered as *CharacterController
    sheltered_at = feet(sheltered)
    println("  sheltered: its feet from ${lanes.sheltered_low * 1000.0} to ${lanes.sheltered_high * 1000.0} mm, stopping at z ${sheltered_at.z} (the step's face at 3), grounded ${physics.character_grounded(sheltered)}")
    check("and at a step under an awning its head does not fit over, it stops at the step, its feet on the floor",
          lanes.sheltered_low > 0.0 - 0.001 && lanes.sheltered_high < 0.001 && sheltered_at.z < 3.001 && physics.character_grounded(sheltered))

    rose = lanes.jump_peak - lanes.jump_ground
    wanted = JUMP * JUMP / (2.0 * 9.81)
    println("  jumper: rose ${rose} m, v^2/2g = ${wanted} m")
    check("a jump peaks at v^2/2g, within 2%", lanes.jumped && rose > wanted * 0.98 && rose < wanted * 1.02)

    light_moved = behaviour.object_position(lanes.light as *GameObject).z - lanes.light_start
    heavy_moved = behaviour.object_position(lanes.heavy as *GameObject).z - lanes.heavy_start
    blocked_at = feet(lanes.blocked as *CharacterController).z
    println("  pusher: the 20 kg crate moved ${light_moved} m; blocked: the 800 kg one ${heavy_moved} m, the character stopped at z ${blocked_at}")
    pusher_walked = feet(lanes.pusher as *CharacterController).z
    println("  the pusher walked to z ${pusher_walked}, its front 0.3 m ahead; the crate's near face at z ${lanes.light_start + light_moved - 0.5}")
    check("walked into, a 20 kg crate slides ahead of it", light_moved > 1.0)
    check("at the character's pace, no faster: its near face within 10 cm of the character's front", lanes.light_start + light_moved - 0.5 - (pusher_walked + 0.3) < 0.1)
    check("and an 800 kg one does not, and stops it at its face", heavy_moved < 0.05 && blocked_at < 1.25)

    recorded = lanes.recorded as *GameObject
    stood = behaviour.object_position(recorded)
    record = physics.spec_of(recorded)
    kind = ""
    if record != null { kind = record.body }
    println("  recorded: its middle at y ${stood.y} (its bottom 0.9 m below), grounded ${physics.character_grounded(physics.character_of(recorded))}, recorded as '${kind}'")
    check("a box with a character record stands with its bottom on the ground", stood.y > 0.89 && stood.y < 0.91 &&
          physics.character_grounded(physics.character_of(recorded)))
    check("and records itself as a character", kind == "character")
    if record != null { heap.free(record) }

    deepest = 0.0
    characters = [lanes.walker, lanes.climber, lanes.stopped, lanes.stander, lanes.slider, lanes.jumper, lanes.pusher, lanes.blocked,
                  lanes.stooped, lanes.sheltered]
    k = 0
    while k < 10 {
        d = physics.character_overlap(characters[k] as *CharacterController)
        if d > deepest { deepest = d }
        k = k + 1
    }
    println("  the deepest any is into the world: ${deepest * 1000.0} mm")
    check("none is left inside what it walks on or into (under 6 mm, the slop and one more)", deepest < 0.006)

    physics.character_free(lanes.walker as *CharacterController)
    physics.character_free(lanes.climber as *CharacterController)
    physics.character_free(lanes.stopped as *CharacterController)
    physics.character_free(lanes.stander as *CharacterController)
    physics.character_free(lanes.slider as *CharacterController)
    physics.character_free(lanes.jumper as *CharacterController)
    physics.character_free(lanes.pusher as *CharacterController)
    physics.character_free(lanes.blocked as *CharacterController)
    physics.character_free(stooped)
    physics.character_free(sheltered)
    engine.engine_free(e)
    if g_failures == 0 {
        println("character: all checks passed (${g_checks})")
    } else {
        println("character: ${g_failures} failure(s) of ${g_checks}")
    }
}
