// Feet on the world (#577), held to numbers on the box man fixture
// (tests/fixtures/gltf/humanoid.glb, Mixamo's bone names), no window: the
// figure re-posed to its bind pose every frame, as a clip would pose it, and
// its feet solved over grounds given as functions.
//
//   - on flat ground at its floor nothing moves;
//   - on a 15-degree slope across its stance each foot stands on the slope
//     (its ankle its standing height over the ground under it, to 1 cm), the
//     pelvis down for the lower foot, the knees bent forward, never past
//     straight, the feet turned to lie on the slope;
//   - stood on a 20 cm kerb with one foot off it, that foot reaches the road
//     and the pelvis has come down 20 cm, at no more than PELVIS_SPEED;
//   - a foot set down stays where it was set while the body moves on over
//     it (under 1 cm), and is let go when the clip lifts it;
//   - by a ledge 0.6 m high, past a step, the foot over it keeps to the
//     floor (its ankle within 1 cm of its standing height); by a 0.3 m
//     step, the foot over it stands on it (within 2 cm). Ground was found
//     a metre over the floor, and a plaza walker by the steps put its foot
//     on a top 0.6 m up, its knee folded back 53 degrees;
//   - turned round on the slope, on legs its clip holds straight, its feet
//     let go first, the knees still bend the way the walk bent them, turned
//     with the body. Kept as a direction in the world, the bend went stale
//     as a walker turned, and the plaza's crowd stood on knees bent back 5
//     to 55 degrees;
//   - a foot set down on a 15 cm kerb by its edge stays on the kerb (to
//     1 cm) while the body moves on off it, the clip's ankle past the edge
//     over the road. Its height taken from the ground under the clip's
//     ankle, it was posed at the road's, down inside the kerb, and the
//     plaza's car struck a walker so and left its foot caught in the kerb.

import ae3d.core
import ae3d.skin
import ae3d.figure
import ae3d.feet

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

extern fflush(stream: ptr) -> int
extern exit(code: int)
extern tan(x: float) -> float

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
    fflush(null)
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// The grounds.
struct Ground { kind: int, height: float, edge: float }

const FLAT = 0
const SLOPE = 1
const KERB = 2
const EDGE = 3                       // a kerb `height` high on the +x side of `edge`

ground(state: ptr, x: float, z: float) -> float {
    g = state as *Ground
    if g.kind == SLOPE { return x * tan(15.0 * 3.14159265 / 180.0) }
    if g.kind == KERB {
        if x > 0.0 { return g.height }
        return 0.0
    }
    if g.kind == EDGE {
        if x > g.edge { return g.height }
        return 0.0
    }
    return 0.0
}

bone(sk: *Skeleton, name: string) -> *Model {
    i = skin.skeleton_find(sk, name)
    if i < 0 { return null }
    return skin.skeleton_bone(sk, i)
}

world(m: *Model) -> Vec3 {
    core.model_sync_transform(m)
    return m.world_position
}

// A frame: the clip's pose (the bind pose, kept), then the feet.
frame(fig: *Figure, kept: ptr, f: *Feet) {
    figure.put_pose(fig, kept)
    feet.solve(f, STEP)
}

main() {
    println("feet: on the world (#577)")
    group = core.model_new()
    fig = figure.figure_new(PATH, group)
    if fig == null {
        println("feet: SKIP ${PATH} would not load")
        return
    }
    sk = figure.skeleton(fig)
    hips = bone(sk, "mixamorig:Hips")
    l_hip = bone(sk, "mixamorig:LeftUpLeg")
    l_knee = bone(sk, "mixamorig:LeftLeg")
    l_ankle = bone(sk, "mixamorig:LeftFoot")
    r_hip = bone(sk, "mixamorig:RightUpLeg")
    r_knee = bone(sk, "mixamorig:RightLeg")
    r_ankle = bone(sk, "mixamorig:RightFoot")
    check("the box man's legs are found by their names", hips != null && l_ankle != null && r_ankle != null)
    kept = figure.keep_pose(fig)
    l_bind = world(l_ankle)
    r_bind = world(r_ankle)
    upper = core.v3_len(core.v3_sub(world(l_knee), world(l_hip)))
    lower = core.v3_len(core.v3_sub(world(l_ankle), world(l_knee)))
    f = feet.attach(null, group, hips, l_hip, l_knee, l_ankle, r_hip, r_knee, r_ankle)
    g = Ground { kind: FLAT, height: 0.0, edge: 0.0 }
    feet.ground_height(f, ground, (&g) as ptr)
    println("  ankles at x ${l_bind.x} and ${r_bind.x}, ${feet.leg(f, 0).standing} m above the floor; thigh ${upper} m, shin ${lower} m")

    // Flat.
    k = 0
    while k < 5 {
        frame(fig, kept, f)
        k = k + 1
    }
    flat_moved = core.v3_len(core.v3_sub(world(l_ankle), l_bind)) + core.v3_len(core.v3_sub(world(r_ankle), r_bind))
    check("on flat ground at its floor nothing moves", flat_moved < 0.0001 && abs_of(feet.pelvis_offset(f)) < 0.0001)

    // A slope across the stance.
    g.kind = SLOPE
    k = 0
    while k < 120 {
        frame(fig, kept, f)
        k = k + 1
    }
    worst = 0.0
    knees_ok = true
    i = 0
    while i < 2 {
        leg = feet.leg(f, i)
        a = world(leg.ankle as *Model)
        want = ground((&g) as ptr, a.x, a.z) + leg.standing
        off = abs_of(a.y - want)
        if off > worst { worst = off }
        span = core.v3_len(core.v3_sub(a, world(leg.hip as *Model)))
        knee = world(leg.knee as *Model)
        mid = core.v3_mul(core.v3_add(a, world(leg.hip as *Model)), 0.5)
        if span > upper + lower + 0.001 || core.v3_dot(core.v3_sub(knee, mid), core.vec3(0.0, 0.0, 1.0)) < 0.0 - 0.001 { knees_ok = false }
        i = i + 1
    }
    println("  on a 15-degree slope: each foot ${worst * 100.0} cm from its height over the slope at worst; the pelvis ${feet.pelvis_offset(f) * 100.0} cm down")
    check("on a slope each foot stands on the ground under it, to 1 cm", worst < 0.01)
    check("the pelvis came down for the lower foot", feet.pelvis_offset(f) < 0.0 - 0.005)
    check("and the knees bend forward, never past straight", knees_ok)
    // Turned to lie on it: the ankle's rotation against the same leg solved
    // with no tilt (the same frame on a ground that is flat but as high).
    tilted = l_ankle.world_rotation
    check("a foot on the slope is turned toward lying on it", abs_of(tilted.w) < 0.9999)

    // The walk's knees, bent as its clip bends them, solved onto the slope:
    // they stay bent that way. The box man's clips walk along its own x, not
    // its root's +z, and with the pole toward the root's +z its knees were
    // solved bent backwards whenever it walked.
    figure.play(fig, "Walk", 1.0, true)
    figure.set_time(fig, figure.duration(fig) * 0.12)
    walk = figure.keep_pose(fig)
    bends_block = calloc(6, 8)
    bends = bends_block as float[]
    i = 0
    while i < 2 {
        leg = feet.leg(f, i)
        a = world(leg.ankle as *Model)
        hip = world(leg.hip as *Model)
        knee = world(leg.knee as *Model)
        line = core.v3_sub(a, hip)
        u = core.v3_dot(core.v3_sub(knee, hip), line) / core.v3_dot(line, line)
        bend = core.v3_sub(knee, core.v3_add(hip, core.v3_mul(line, u)))
        bends[i * 3] = bend.x
        bends[i * 3 + 1] = bend.y
        bends[i * 3 + 2] = bend.z
        i = i + 1
    }
    k = 0
    while k < 120 {
        frame(fig, walk, f)
        k = k + 1
    }
    walk_ok = true
    i = 0
    while i < 2 {
        leg = feet.leg(f, i)
        a = world(leg.ankle as *Model)
        hip = world(leg.hip as *Model)
        knee = world(leg.knee as *Model)
        line = core.v3_sub(a, hip)
        u = core.v3_dot(core.v3_sub(knee, hip), line) / core.v3_dot(line, line)
        bend = core.v3_sub(knee, core.v3_add(hip, core.v3_mul(line, u)))
        clip = core.vec3(bends[i * 3], bends[i * 3 + 1], bends[i * 3 + 2])
        if core.v3_len(clip) > 0.01 && core.v3_dot(bend, clip) < 0.0 { walk_ok = false }
        i = i + 1
    }
    figure.pose_free(walk)
    figure.stop(fig)
    check("a walk's knees solved onto a slope stay bent the way its clip bends them", walk_ok)


    // A kerb: standing on it, one foot off.
    g.kind = KERB
    g.height = 0.2
    core.model_set_position(group, 0.0, 0.2, 0.0)
    worst_step = 0.0
    last = feet.pelvis_offset(f)
    k = 0
    while k < 120 {
        frame(fig, kept, f)
        moved = abs_of(feet.pelvis_offset(f) - last)
        if moved > worst_step { worst_step = moved }
        last = feet.pelvis_offset(f)
        k = k + 1
    }
    off_kerb = feet.leg(f, 0)
    on_kerb = feet.leg(f, 1)
    if world(off_kerb.ankle as *Model).x > 0.0 {
        off_kerb = feet.leg(f, 1)
        on_kerb = feet.leg(f, 0)
    }
    road = world(off_kerb.ankle as *Model).y - off_kerb.standing
    kerb = world(on_kerb.ankle as *Model).y - on_kerb.standing
    println("  on a 20 cm kerb, one foot off: that foot's floor at ${road * 100.0} cm, the other's at ${kerb * 100.0} cm; the pelvis ${feet.pelvis_offset(f) * 100.0} cm down, moving ${worst_step * 100.0} cm a frame at most (${feet.PELVIS_SPEED * STEP * 100.0} allowed)")
    check("the foot off the kerb reaches the road, the other stays on the kerb", abs_of(road) < 0.01 && abs_of(kerb - 0.2) < 0.01)
    check("the pelvis comes down by the kerb's height, never faster than PELVIS_SPEED",
          abs_of(feet.pelvis_offset(f) + 0.2) < 0.01 && worst_step <= feet.PELVIS_SPEED * STEP + 0.000001)
    core.model_set_position(group, 0.0, 0.0, 0.0)
    g.kind = FLAT

    // A foot set down stays while the body moves on over it.
    k = 0
    while k < 60 {
        frame(fig, kept, f)
        k = k + 1
    }
    set_at = world(l_ankle)
    slid = 0.0
    k = 0
    while k < 12 {
        core.model_set_position(group, (k + 1) as float * 0.005, 0.0, 0.0)
        frame(fig, kept, f)
        d = core.v3_len(core.v3_sub(world(l_ankle), set_at))
        if d > slid { slid = d }
        k = k + 1
    }
    locked = feet.leg_locked(f, 0)
    // The clip lifts it: the thigh swung forward, the foot off the floor.
    figure.put_pose(fig, kept)
    core.model_set_rotation(l_hip, core.quat_normalize(core.quat_mul(core.quat_rotate(0.0 - 0.8, core.vec3(1.0, 0.0, 0.0)), l_hip.rotation)))
    raised = world(l_ankle).y
    feet.solve(f, STEP)
    lifted = !feet.leg_locked(f, 0)
    println("  lifted by the clip to ${raised * 100.0} cm")
    println("  a planted foot while the body moved 6 cm over it: ${slid * 100.0} cm from where it was set; let go when lifted: ${lifted}")
    check("a foot set down stays where it was set while the body moves on (under 1 cm)", locked && slid < 0.01)
    check("and is let go when the clip lifts it", lifted)

    // Turned round on the slope, on legs the clip holds straight. The feet
    // let go first, the body drawn away from them, as a body moving on lets
    // them go: turned round at once over feet held where they were, each
    // foot is held on the other side of the body, the legs crossed, and
    // which way a crossed knee bends says nothing of the walk's bend.
    g.kind = SLOPE
    core.model_set_position(group, 1.0, 0.0, 0.0)
    frame(fig, kept, f)
    core.model_set_position(group, 0.0, 0.0, 0.0)
    round = core.quat_rotate(3.14159265358979, core.vec3(0.0, 1.0, 0.0))
    core.model_set_rotation(group, round)
    k = 0
    while k < 60 {
        frame(fig, kept, f)
        k = k + 1
    }
    turned_ok = true
    bent_any = false
    i = 0
    while i < 2 {
        leg = feet.leg(f, i)
        a = world(leg.ankle as *Model)
        hip = world(leg.hip as *Model)
        knee = world(leg.knee as *Model)
        line = core.v3_sub(a, hip)
        u = core.v3_dot(core.v3_sub(knee, hip), line) / core.v3_dot(line, line)
        bend = core.v3_sub(knee, core.v3_add(hip, core.v3_mul(line, u)))
        clip = core.quat_apply(round, core.vec3(bends[i * 3], bends[i * 3 + 1], bends[i * 3 + 2]))
        if core.v3_len(bend) > 0.01 {
            bent_any = true
            if core.v3_dot(bend, clip) < 0.0 { turned_ok = false }
        }
        i = i + 1
    }
    core.model_set_rotation(group, core.quat_ident())
    free(bends_block)
    check("turned round on straight legs, the knees bend the way the walk bent them, turned with it", bent_any && turned_ok)

    // By a ledge past a step, and by a step.
    g.kind = KERB
    core.model_set_position(group, 0.0, 0.0, 0.0)
    over_ledge = 0.0
    over_step = 0.0
    tries = 0
    while tries < 2 {
        g.height = 0.6
        if tries == 1 { g.height = 0.3 }
        k = 0
        while k < 90 {
            frame(fig, kept, f)
            k = k + 1
        }
        high = feet.leg(f, 0)
        if world(high.ankle as *Model).x < world(feet.leg(f, 1).ankle as *Model).x { high = feet.leg(f, 1) }
        up_by = world(high.ankle as *Model).y - high.standing
        if tries == 0 { over_ledge = up_by }
        if tries == 1 { over_step = up_by }
        tries = tries + 1
    }
    println("  by a 0.6 m ledge the foot over it is ${over_ledge * 100.0} cm up; by a 0.3 m step, ${over_step * 100.0} cm")
    check("by a ledge past a step the foot keeps to the floor, and by a step it stands on it", abs_of(over_ledge) < 0.01 && abs_of(over_step - 0.3) < 0.02)

    // A foot set down on a kerb by its edge, the body moving on off it.
    on_leg = 0
    edge_ankle = l_ankle
    edge_x = l_bind.x
    if r_bind.x > l_bind.x {
        on_leg = 1
        edge_ankle = r_ankle
        edge_x = r_bind.x
    }
    g.kind = EDGE
    g.height = 0.15
    g.edge = edge_x - 0.03
    k = 0
    while k < 60 {
        frame(fig, kept, f)
        k = k + 1
    }
    set_on = world(edge_ankle).y - feet.leg(f, on_leg).standing
    held_off = 0.0
    k = 0
    while k < 12 {
        core.model_set_position(group, 0.0 - (k + 1) as float * 0.005, 0.0, 0.0)
        frame(fig, kept, f)
        off = abs_of(world(edge_ankle).y - feet.leg(f, on_leg).standing - g.height)
        if off > held_off { held_off = off }
        k = k + 1
    }
    figure.put_pose(fig, kept)
    clip_x = world(edge_ankle).x
    println("  a foot set down on a 15 cm kerb 3 cm in from its edge, its floor at ${set_on * 100.0} cm; the body moved 6 cm on off it, the clip's ankle ${(g.edge - clip_x) * 100.0} cm past the edge: held ${feet.leg_locked(f, on_leg)}, ${held_off * 100.0} cm off the kerb's top at the most")
    check("a foot held on a kerb by its edge stays on it while the clip's ankle passes the edge (to 1 cm)", abs_of(set_on - g.height) < 0.01 && feet.leg_locked(f, on_leg) && held_off < 0.01)
    core.model_set_position(group, 0.0, 0.0, 0.0)
    g.kind = FLAT

    feet.feet_free(f)
    figure.pose_free(kept)
    figure.figure_free(fig)
    core.model_free(group)
    if g_failures == 0 {
        println("feet: all checks passed (${g_checks})")
    } else {
        println("feet: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
