// Feet on the world (#577, #857, #860), held to numbers on the pipeline's
// feet (ae3d.ikrig): the Rigify mannequin (tests/fixtures/people, CC0) posed
// every frame by its clip, as the animator poses it, and its feet solved
// (ikrig.feet_solve) over grounds made of static boxes. No window.
//
//   - on flat ground at its floor the pelvis stays where the clip has it;
//   - on a 15-degree slope across its stance each foot stands on the slope
//     (its sole's lowest point within 1 cm of the ground under it), the
//     pelvis down for the lower foot, the knees bent forward, never past
//     straight nor past their most, each foot turned to lie on the slope;
//   - a walk's knees solved onto the slope stay bent the way its clip bends
//     them;
//   - stood on a 20 cm kerb with one foot off it, that foot reaches the
//     road, the other stays on the kerb, and the pelvis comes down 20 cm,
//     never faster than PELVIS_SPEED (0.6 m/s, the retired feet module's bound);
//   - a foot let go 10 cm behind where the clip has it, the clip keeping
//     its sole on the floor, is carried there over the ground, not along it
//     (lifted at least RELEASE_LIFT of the way, as before, and under a
//     fifth of the way within 5 mm of the clip's height), and comes down
//     where the clip has it (within 1 mm). Caught up along the floor, the
//     plaza's walkers' feet slid: 70% of their toes' skating;
//   - a knee overstraightened 5 degrees as a walk begins, its foot on a 6 cm
//     step, bends ahead (over 1 cm off the line from its hip to its ankle),
//     its thigh not turned round. Its pole taken from its own bend, the box
//     man's bent backwards, or its thigh turned half round (#781): 13 of 24
//     walkers in the plaza's first second.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig

extern exit(code: int)

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
// The retired feet module's bounds (#860), held to here: metres a second the pelvis came down at
// the most, and the share of a released foot's way it was lifted.
const PELVIS_SPEED = 0.6
const RELEASE_LIFT = 0.2
const SLOPE = 0.2617994                // 15 degrees

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A figure on its own grounds: the engine, the figure, its rig, feet and
// clips, and the poses solved.
struct Scene {
    e: *Engine
    o: *GameObject
    a: *Animator
    r: *pose.Rig
    f: *Feet
    idle: *Take
    walk: *Take
    clip: ptr                          // the clip's pose this frame
    p: ptr                             // the pose solved
    w: ptr                             // its worlds, the rig's
    cw: ptr                            // the clip's worlds
    ahead: Vec3                        // the figure's forward over the ground
    left: Vec3                         // and its left
}

scene() -> Scene {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    f = ikrig.feet_new(r, o)
    ikrig.feet_ground_physics(f, physics.of(e))
    w = pose.new(r)
    pose.rest_world(r, w)
    heel = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L)))
    ball = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.BALL_L)))
    ahead = core.v3_normalize(core.vec3(ball.x - heel.x, 0.0, ball.z - heel.z))
    hl = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_L)))
    hr = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_R)))
    left = core.v3_normalize(core.vec3(hl.x - hr.x, 0.0, hl.z - hr.z))
    return Scene { e: e, o: o, a: a, r: r, f: f, idle: animator.take(a, "Idle_Loop", false), walk: animator.take(a, "Walk_Loop", false),
                   clip: pose.new(r), p: pose.new(r), w: w, cw: pose.new(r), ahead: ahead, left: left }
}

scene_free(s: Scene) {
    pose.release(s.clip)
    pose.release(s.p)
    pose.release(s.w)
    pose.release(s.cw)
    ikrig.feet_free(s.f)
    animator.animator_free(s.a)
    physics.physics_free(physics.of(s.e))
    figure.figures_free(s.e)
    engine.engine_free(s.e)
}

// A static box: its middle, half-extents along `s.left`, up and `s.ahead`,
// tilted `roll` radians about `s.ahead` (its left side up).
slab(s: Scene, middle: Vec3, half: Vec3, roll: float) {
    _b, _shape = block(s, middle, half, roll)
}

// The same, its object and its shape, to take away.
block(s: Scene, middle: Vec3, half: Vec3, roll: float) -> (*GameObject, ShapeId) {
    b = engine.object(s.e, "Ground", loader.cube(1.0))
    yaw = core.quat_rotate(core.atan2_of(s.ahead.x, s.ahead.z), core.vec3(0.0, 1.0, 0.0))
    // The box's own x is along the figure's left once yawed onto its ahead
    // (z), when its left is +x of its ahead; the other way round, -x.
    across = core.quat_apply(yaw, core.vec3(1.0, 0.0, 0.0))
    sign = 1.0
    if core.v3_dot(across, s.left) < 0.0 { sign = 0.0 - 1.0 }
    turn = core.quat_normalize(core.quat_mul(core.quat_rotate(roll * sign, s.ahead), yaw))
    behaviour.object_set_rotation(b, turn)
    behaviour.object_set_position(b, middle)
    return b, physics.box_collider(b, half, physics.material(0.8, 0.0))
}

// The clip's pose at `at` seconds of `t`, then the feet solved on it.
frame(s: Scene, t: *Take, at: float, left: float, right: float) {
    clips.sample(t, s.r, at, true, s.clip)
    pose.world(s.r, s.clip, s.cw)
    pose.copy(s.r, s.clip, s.p)
    ikrig.feet_solve(s.f, s.r, s.p, s.w, left, right, left, right, STEP)
    pose.world(s.r, s.p, s.w)
}

joint(s: Scene, worlds: ptr, slot: int) -> Vec3 { return ikrig.to_ground(s.r, pose.translation(worlds, pose.human(s.r, slot))) }

// The lowest point of foot `side`'s sole over the ground `height` gives it
// (FLAT, the slope through the figure's middle, or a kerb on its left).
const FLAT = 0
const SLOPED = 1
const KERB_LEFT = 2

ground_at(s: Scene, kind: int, p: Vec3) -> float {
    if kind == SLOPED { return core.v3_dot(p, s.left) * core.tan_of(SLOPE) }
    if kind == KERB_LEFT && core.v3_dot(p, s.left) > 0.0 { return 0.2 }
    return 0.0
}

sole_over(s: Scene, side: int, kind: int) -> float {
    heel, pad, toe = ikrig.feet_soles(s.f, s.r, s.w, side)
    points = [heel, pad, toe]
    low = 1000.0
    n = 0
    while n < 3 {
        d = points[n].y - ground_at(s, kind, points[n])
        if d < low { low = d }
        n = n + 1
    }
    return low
}

// Knee `side`'s bend off the line from its hip to its ankle, the ground's.
knee_bend(s: Scene, worlds: ptr, side: int) -> Vec3 {
    slots = [pose.THIGH_L, pose.CALF_L, pose.FOOT_L, pose.THIGH_R, pose.CALF_R, pose.FOOT_R]
    hip = joint(s, worlds, slots[side * 3])
    knee = joint(s, worlds, slots[side * 3 + 1])
    a = joint(s, worlds, slots[side * 3 + 2])
    line = core.v3_sub(a, hip)
    u = core.v3_dot(core.v3_sub(knee, hip), line) / core.v3_dot(line, line)
    return core.v3_sub(knee, core.v3_add(hip, core.v3_mul(line, u)))
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// Flat, then the slope: the pelvis's drop on flat ground; then on the
// slope each sole's worst off the ground, the drop, whether the knees bend
// forward within their most, and the least a foot turned off the clip's.
standing() {
    s = scene()
    slab(s, core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(20.0, 0.5, 20.0), 0.0)
    k = 0
    while k < 5 {
        frame(s, s.idle, 0.0, 1.0, 1.0)
        k = k + 1
    }
    flat_drop = ikrig.feet_drop(s.f)
    flat_sole = core.abs_of(sole_over(s, 0, FLAT))
    if core.abs_of(sole_over(s, 1, FLAT)) > flat_sole { flat_sole = core.abs_of(sole_over(s, 1, FLAT)) }
    scene_free(s)

    s = scene()
    // A slab 40 m square, its top through the figure's middle, its left side up.
    slab(s, core.v3_mul(core.v3_add(core.v3_mul(s.left, 0.0 - core.sin_of(SLOPE)), core.vec3(0.0, core.cos_of(SLOPE), 0.0)), 0.0 - 0.5), core.vec3(20.0, 0.5, 20.0), SLOPE)
    k = 0
    while k < 120 {
        frame(s, s.idle, 0.0, 1.0, 1.0)
        k = k + 1
    }
    worst = 0.0
    knees_ok = true
    least_tilt = 1000.0
    limbs = [ikrig.leg_limb(s.r, 0), ikrig.leg_limb(s.r, 1)]
    feet = [pose.FOOT_L, pose.FOOT_R]
    side = 0
    while side < 2 {
        off = core.abs_of(sole_over(s, side, SLOPED))
        if off > worst { worst = off }
        if ikrig.limb_side(limbs[side], s.w) < 0.0 - 0.001 || ikrig.limb_bend(limbs[side], s.w) > ikrig.KNEE_MOST + 0.001 { knees_ok = false }
        j = pose.human(s.r, feet[side])
        tilt = turned_by(pose.rotation(s.w, j), pose.rotation(s.cw, j))
        if tilt < least_tilt { least_tilt = tilt }
        side = side + 1
    }
    drop = ikrig.feet_drop(s.f)
    println("  on flat ground: the pelvis ${flat_drop * 1000.0} mm off the clip's, a sole ${flat_sole * 1000.0} mm off the floor at worst")
    println("  on a 15-degree slope: each sole ${worst * 1000.0} mm off the slope at worst; the pelvis ${drop * 100.0} cm down; each foot turned ${least_tilt * 57.29578} degrees off the clip's at least")
    check("on flat ground at its floor the pelvis stays where the clip has it", core.abs_of(flat_drop) < 0.0001)
    check("on a slope each foot stands on the ground under it, to 1 cm", worst < 0.01)
    check("the pelvis came down for the lower foot", drop < 0.0 - 0.005)
    check("and the knees bend forward, never past straight nor past their most", knees_ok)
    check("a foot on the slope is turned toward lying on it", least_tilt > 0.05)

    // The walk's knees, bent as its clip bends them, solved onto the slope.
    at = clips.duration(s.walk) * 0.12
    left_down = 0.0
    right_down = 0.0
    if clips.contact(s.walk, 0, at, true) { left_down = 1.0 }
    if clips.contact(s.walk, 1, at, true) { right_down = 1.0 }
    walk_ok = true
    bent = 0
    k = 0
    while k < 120 {
        frame(s, s.walk, at, left_down, right_down)
        k = k + 1
    }
    side = 0
    while side < 2 {
        clip = knee_bend(s, s.cw, side)
        now = knee_bend(s, s.w, side)
        if core.v3_len(clip) > 0.01 {
            bent = bent + 1
            if core.v3_dot(now, clip) < 0.0 { walk_ok = false }
        }
        if ikrig.limb_side(limbs[side], s.w) < 0.0 - 0.001 { walk_ok = false }
        println("  the walk at ${at} s on the slope: knee ${side} bent ${core.v3_len(clip) * 100.0} cm off its line by the clip, ${core.v3_len(now) * 100.0} cm solved, the two ${core.v3_dot(core.v3_normalize(now), core.v3_normalize(clip))} alike")
        side = side + 1
    }
    check("a walk's knees solved onto a slope stay bent the way its clip bends them", walk_ok && bent > 0)
    ikrig.limb_free(limbs[0])
    ikrig.limb_free(limbs[1])
    scene_free(s)
}

// Stood on a 20 cm kerb on its left, its right foot on a plank as high
// beside it; the plank taken away, its right foot is off the kerb.
kerb() {
    s = scene()
    slab(s, core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(20.0, 0.5, 20.0), 0.0)
    slab(s, core.vec3(s.left.x * 2.0, 0.1, s.left.z * 2.0), core.vec3(2.0, 0.1, 2.0), 0.0)
    plank, shape = block(s, core.vec3(s.left.x * (0.0 - 0.3), 0.1, s.left.z * (0.0 - 0.3)), core.vec3(0.3, 0.1, 2.0), 0.0)
    behaviour.object_set_position(s.o, core.vec3(0.0, 0.2, 0.0))
    // Stood there at once, as the animator's first frame stands a figure.
    ikrig.feet_stand(s.f)
    k = 0
    while k < 60 {
        frame(s, s.idle, 0.0, 1.0, 1.0)
        k = k + 1
    }
    stood = ikrig.feet_drop(s.f)
    taken = physics.collider_remove(plank, shape)
    worst_step = 0.0
    last = ikrig.feet_drop(s.f)
    k = 0
    while k < 120 {
        frame(s, s.idle, 0.0, 1.0, 1.0)
        moved = core.abs_of(ikrig.feet_drop(s.f) - last)
        if moved > worst_step { worst_step = moved }
        last = ikrig.feet_drop(s.f)
        k = k + 1
    }
    on_kerb = sole_over(s, 0, KERB_LEFT)
    road = sole_over(s, 1, KERB_LEFT)
    drop = ikrig.feet_drop(s.f)
    println("  on a 20 cm kerb and a plank: the pelvis ${stood * 1000.0} mm off the clip's; the plank taken away (${taken}), its right foot off: that sole ${road * 1000.0} mm off the road, the left's ${on_kerb * 1000.0} mm off the kerb; the pelvis ${drop * 100.0} cm down, moving ${worst_step * 100.0} cm a frame at most (${PELVIS_SPEED * STEP * 100.0} allowed)")
    check("the foot off the kerb reaches the road, the other stays on the kerb", core.abs_of(road) < 0.01 && core.abs_of(on_kerb) < 0.01)
    check("the pelvis comes down by the kerb's height, never faster than PELVIS_SPEED", core.abs_of(drop + 0.2) < 0.01 && worst_step <= PELVIS_SPEED * STEP + 0.000001)
    scene_free(s)
}

// A foot let go 10 cm behind where the clip has it.
released() {
    s = scene()
    slab(s, core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(20.0, 0.5, 20.0), 0.0)
    k = 0
    while k < 60 {
        frame(s, s.idle, 0.0, 1.0, 1.0)
        k = k + 1
    }
    k = 0
    while k < 10 {
        behaviour.object_set_position(s.o, core.v3_mul(s.ahead, ((k + 1) as float) * 0.01))
        frame(s, s.idle, 0.0, 1.0, 1.0)
        k = k + 1
    }
    held_on = ikrig.feet_locked(s.f, 0)
    was = joint(s, s.w, pose.FOOT_L)
    way = 0.0
    on_ground = 0.0
    highest = 0.0
    landed_off = 0.0
    k = 0
    while k < 30 {
        // The clip lifts it, its sole still on the floor.
        frame(s, s.idle, 0.0, 0.0, 1.0)
        clip = joint(s, s.cw, pose.FOOT_L)
        at = joint(s, s.w, pose.FOOT_L)
        if k == 0 { way = core.v3_len(core.vec3(clip.x - was.x, 0.0, clip.z - was.z)) }
        went = core.v3_len(core.vec3(at.x - was.x, 0.0, at.z - was.z))
        up = at.y - clip.y
        if up > highest { highest = up }
        if up < 0.005 { on_ground = on_ground + went }
        landed_off = core.v3_len(core.vec3(at.x - clip.x, 0.0, at.z - clip.z))
        was = at
        k = k + 1
    }
    println("  let go ${way * 100.0} cm from where the clip has it: carried up to ${highest * 100.0} cm over the clip's height, ${on_ground * 100.0} cm of the way under 0.5 cm over it; ${landed_off * 1000.0} mm from the clip's ankle after")
    check("a foot let go behind where the clip has it is carried there over the ground, not along it", held_on && way > 0.08 && highest > way * RELEASE_LIFT * 0.9 && on_ground < way * 0.2)
    check("and comes down where the clip has it", landed_off < 0.001)
    scene_free(s)
}

// A knee overstraightened 5 degrees as a walk begins, its foot on a 6 cm
// step: how far ahead its knee bends off its line, and how far its thigh's
// forward is still ahead (a cosine).
overstraightened() -> (float, float) {
    s = scene()
    slab(s, core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(20.0, 0.5, 20.0), 0.0)
    clips.sample(s.idle, s.r, 0.0, true, s.clip)
    pose.world(s.r, s.clip, s.cw)
    // The step under the right foot, clear of the left.
    right = joint(s, s.cw, pose.FOOT_R)
    middle = core.v3_sub(core.vec3(right.x, 0.03, right.z), core.v3_mul(s.left, 0.15))
    slab(s, middle, core.vec3(0.2, 0.03, 0.4), 0.0)
    // The right knee straightened past its line by 5 degrees: the calf
    // turned about the figure's left, whichever way puts the knee behind.
    limb = ikrig.leg_limb(s.r, 1)
    calf = pose.human(s.r, pose.CALF_R)
    straight = pose.new(s.r)
    best = 1000.0
    sign = 0 - 1
    while sign <= 1 {
        pose.copy(s.r, s.clip, straight)
        pose.world(s.r, straight, s.w)
        axis = ikrig.dir_to_rig(s.r, s.left)
        turn = core.quat_rotate(0.0873 * (sign as float), core.v3_normalize(axis))
        thigh = pose.human(s.r, pose.THIGH_R)
        // The knee pushed back: the thigh turned one way, the calf back the
        // other by twice as much, so the ankle stays under the hip.
        pose.set_rotation(straight, thigh, pose.local_rotation_of(s.r, s.w, thigh, core.quat_normalize(core.quat_mul(turn, pose.rotation(s.w, thigh)))))
        pose.world(s.r, straight, s.w)
        back = core.quat_conjugate(core.quat_mul(turn, turn))
        pose.set_rotation(straight, calf, pose.local_rotation_of(s.r, s.w, calf, core.quat_normalize(core.quat_mul(back, pose.rotation(s.w, calf)))))
        pose.world(s.r, straight, s.w)
        side = ikrig.limb_side(limb, s.w)
        if side < best {
            best = side
            pose.copy(s.r, straight, s.clip)
        }
        sign = sign + 2
    }
    // The clip's pose with its knee overstraightened, solved for 30 frames.
    rest_thigh = pose.rotation(s.cw, pose.human(s.r, pose.THIGH_R))
    pose.world(s.r, s.clip, s.cw)
    println("  the right knee overstraightened: ${best * 100.0} cm behind its line")
    k = 0
    while k < 30 {
        pose.copy(s.r, s.clip, s.p)
        ikrig.feet_solve(s.f, s.r, s.p, s.w, 1.0, 1.0, 1.0, 1.0, STEP)
        pose.world(s.r, s.p, s.w)
        k = k + 1
    }
    bend = knee_bend(s, s.w, 1)
    thigh_turn = core.quat_mul(pose.rotation(s.w, pose.human(s.r, pose.THIGH_R)), core.quat_conjugate(rest_thigh))
    thigh_ahead = core.v3_dot(ikrig.dir_to_ground(s.r, core.quat_apply(thigh_turn, ikrig.dir_to_rig(s.r, s.ahead))), s.ahead)
    knee_ahead = core.v3_dot(bend, s.ahead)
    pose.release(straight)
    ikrig.limb_free(limb)
    scene_free(s)
    return knee_ahead, thigh_ahead
}

main() {
    println("feet: on the world (#577, #857, #860)")
    standing()
    kerb()
    released()
    knee, thigh = overstraightened()
    println("  a knee overstraightened 5 degrees as a walk begins, its foot on a 6 cm step: bent ${knee * 100.0} cm ahead; its thigh's forward ${thigh} ahead")
    check("a knee overstraightened as a walk begins bends ahead, its thigh not turned round", knee > 0.01 && thigh > 0.5)
    if g_failures == 0 {
        println("feet: all checks passed (${g_checks})")
        return
    }
    println("feet: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
