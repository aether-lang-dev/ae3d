// A figure tripped at a run on a kerb (#922), getting up, held to
// test_get_up_kerb's numbers. The box man, POWERED, getting up by itself
// half a second after it settles, its whole body carried ahead at 3.45 m/s
// (Siltreach's player's run) into a kerb 0.2 m high: its near edge 5, 15
// and 30 cm past its toes, so its shins meet it as its body goes on. Each in
// an engine of its own, no window. Siltreach's player tripped so rose for
// 6 s, its pelvis from 0.34 to 0.91 m, fell again and never stood.
//
//   - it falls (its pelvis under half a metre), gets up, and the way up
//     ends near upright (under 0.1 rad);
//   - handed to its balance it stands where it rose: its centre of mass
//     moves under 5 cm along the ground in the second after;
//   - ten seconds on it stands, upright (under 0.1 rad), on the kerb or
//     beside it (pelvis 0.9 m over the ground under it at least).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern exit(code: int)

const STEP = 0.016666666666666666
const RUN = 3.45

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// The far edge of its feet the way it faces: the calves' bounds (a figure
// without ankles carries its feet on them) and an ankled figure's feet.
toes_ahead(r: *Ragdoll, way: Vec3) -> float {
    toes = 0.0
    leg = 0
    while leg < 4 {
        calf = human.BONE_CALF_L
        if leg == 1 { calf = human.BONE_CALF_R }
        if leg == 2 { calf = human.BONE_FOOT_L }
        if leg == 3 { calf = human.BONE_FOOT_R }
        if calf < physics.ragdoll_bone_count(r) {
            box = dynamics.body_compute_aabb(human.bone_at(physics.ragdoll_human(r), calf).body_id)
            c = 0
            while c < 4 {
                cx = box.lower.x
                cz = box.lower.z
                if c == 1 || c == 3 { cx = box.upper.x }
                if c >= 2 { cz = box.upper.z }
                d = cx * way.x + cz * way.z
                if d > toes { toes = d }
                c = c + 1
            }
        }
        leg = leg + 1
    }
    return toes
}

trial(gap: float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", "tests/fixtures/gltf/humanoid.glb")
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    near = toes_ahead(r, way) + gap
    kerb = engine.object(e, "Kerb", loader.cube(1.0))
    behaviour.object_set_position(kerb, core.vec3(way.x * (near + 1.0), 0.1, way.z * (near + 1.0)))
    physics.box_collider(kerb, core.vec3(1.0, 0.1, 1.0), physics.material(0.8, 0.0))
    motion.set_get_up(m, 0.5)
    // A run's momentum: every body carried ahead at RUN.
    run = core.v3_mul(way, RUN)
    i = 0
    while i < physics.ragdoll_bone_count(r) {
        dynamics.body_set_linear_velocity(human.bone_at(physics.ragdoll_human(r), i).body_id, run)
        i = i + 1
    }
    fell = false
    rose = false
    risen_tilt = 0.0
    risen_at = core.vec3(0.0, 0.0, 0.0)
    risen_step = 0
    drift = 0.0
    lowest = 10.0
    k = 0
    while k < 900 {
        before = motion.getting_up(m)
        engine.engine_update(e, STEP)
        pelvis_y = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
        if pelvis_y < lowest { lowest = pelvis_y }
        if pelvis_y < 0.5 { fell = true }
        if before && !motion.getting_up(m) && !rose {
            rose = true
            risen_tilt = motion.tilt(m)
            risen_at = physics.ragdoll_center_of_mass(r)
            risen_step = k
        }
        if rose && k == risen_step + 60 {
            now = physics.ragdoll_center_of_mass(r)
            drift = core.v3_len(core.vec3(now.x - risen_at.x, 0.0, now.z - risen_at.z))
        }
        k = k + 1
    }
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    hit = physics.ray_static_hit(physics.of(e), core.vec3(pelvis.x, pelvis.y, pelvis.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0)
    floor = 0.0
    if hit.hit { floor = hit.point.y }
    println("  a kerb ${gap * 100.0} cm past its toes: fell ${fell} (pelvis down to ${lowest} m), rose ${rose}, the way up ended ${risen_tilt} rad off upright, ${drift * 100.0} cm moved the second after; 15 s on ${motion.tilt(m)} rad, pelvis ${pelvis.y - floor} m over the ground under it (${floor} m)")
    check("tripped ${gap * 100.0} cm short of the kerb: it falls, gets up, ending under 0.1 rad off upright", fell && rose && risen_tilt < 0.1)
    check("tripped ${gap * 100.0} cm short of the kerb: it stands where it rose, moving under 5 cm the second after", rose && drift < 0.05)
    check("tripped ${gap * 100.0} cm short of the kerb: 15 s on it stands upright", motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && pelvis.y - floor >= 0.9)
    engine.engine_free(e)
    motion.motion_free(m)
}

main() {
    println("trip_kerb: the box man run into a kerb at ${RUN} m/s, tripped, getting up (#922)")
    trial(0.05)
    trial(0.15)
    trial(0.3)
    if g_failures == 0 {
        println("trip_kerb: all checks passed (${g_checks})")
        return
    }
    println("trip_kerb: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
