// A view is the frame's variables with other values (#866), swapped in and
// out, so every variable ae3d.vktargets holds that belongs to a frame has to
// be in the swap: a variable added to the module and left out of it would be
// shared by the window and every view, and a view would draw into the
// window's targets or read its history.
//
// scripts/gen_view_swap.py writes the swap from the module's `var g_...`
// lines. This reads the module's text as the script does and checks the
// written swap names each of them, in view_save, view_load and view_reset,
// but for the few that are the device's and the frame's formats, shared by
// design (the list is the script's). A variable that is not named is found
// here, with no GPU.

import std.fs
import std.string
import std.list

extern exit(code: int)

const MODULE = "src/ae3d/vktargets/module.ae"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if !ok {
        g_failures = g_failures + 1
        println("FAIL ${name}")
    }
}

// What the frames share, as the script lists it.
shared(name: string) -> bool {
    return name == "g_color_format" || name == "g_scene_format" || name == "g_color_space" || name == "g_present_mode" ||
           name == "g_depth_format" || name == "g_velocity_format" || name == "g_samples" || name == "g_can_capture" ||
           name == "g_cell" || name == "g_view_pass" || name == "g_view_read" || name == "g_view_read_bytes"
}

// The text of the function `name` (up to the next line that is a closing
// brace at the left margin).
body_of(text: string, name: string) -> string {
    start = string.index_of(text, "\n${name}(")
    if start < 0 { return "" }
    rest = string.substring(text, start + 1, string.length(text))
    stop = string.index_of(rest, "\n}\n")
    if stop < 0 { return rest }
    return string.substring(rest, 0, stop)
}

main() {
    if !fs.exists(MODULE) {
        println("view_swap: SKIP run from the repository's root")
        return
    }
    text, _err = fs.read(MODULE)
    saved = body_of(text, "view_save")
    loaded = body_of(text, "view_load")
    reset = body_of(text, "view_reset")
    check("the module has the swap written", string.length(saved) > 100 && string.length(loaded) > 100 && string.length(reset) > 100)
    lines = string.split(text, "\n")
    n = 0
    named = 0
    i = 0
    while i < string.array_size(lines) {
        line = string.array_get(lines, i)
        if string.starts_with(line, "var g_") != 0 {
            rest = string.substring(line, 4, string.length(line))
            end = 0
            while end < string.length(rest) && string.string_char_at_n(rest, string.length(rest), end) != 58 &&
                  string.string_char_at_n(rest, string.length(rest), end) != 32 {
                end = end + 1
            }
            name = string.substring(rest, 0, end)
            n = n + 1
            if !shared(name) {
                named = named + 1
                check("${name} is saved", string.contains(saved, "= ${name}\n") != 0 || string.contains(saved, "if ${name} {") != 0 ||
                                        string.ends_with(saved, "= ${name}") != 0)
                check("${name} is loaded", string.contains(loaded, "${name} = ") != 0)
                check("${name} is reset", string.contains(reset, "${name} = ") != 0)
            }
        }
        i = i + 1
    }
    check("the module's variables were read (${n})", n > 60)
    check("the swap holds the number the module says (${named})", string.contains(text, "const VIEW_CELLS = ${named}") != 0)
    if g_failures == 0 {
        println("view_swap: all checks passed (${g_checks})")
        return
    }
    println("view_swap: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
