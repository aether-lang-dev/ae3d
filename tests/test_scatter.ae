// Props placed by rule (#918, ae3d.scatter) over a test district: flat
// ground with a ramp too steep for the rules on one side, a residential and
// an industrial area, a road down the middle and a doorway kept clear.
// Every placement is checked: inside an area its palette fits, on ground no
// steeper than its rule, off the road, outside the doorway, and no closer
// than its spacing to any other. The same seed places the same props, to
// the fingerprint, which is held to one number: every machine makes it,
// since the engine is built without fused multiply-adds (scripts/native.sh)
// and nothing here calls the C library's trigonometry. The district is a
// draw a prop. Headless.

import std.list
import ae3d.core
import ae3d.geometry
import ae3d.loader
import ae3d.scatter

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

near(a: float, b: float) -> bool {
    d = a - b
    return d < 0.0001 && d > 0.0 - 0.0001
}

const SEED = 918
// The placements' fingerprint for SEED, as every machine makes it.
const EXPECTED_HASH = -1813850191682973291

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rect(x0: float, z0: float, x1: float, z1: float) -> ptr {
    p = calloc(8, 8)
    v = p as float[]
    v[0] = x0
    v[1] = z0
    v[2] = x1
    v[3] = z0
    v[4] = x1
    v[5] = z1
    v[6] = x0
    v[7] = z1
    return p
}

// The district, its palettes over the given props.
district(seed: long, clutter_a: *Model, clutter_b: *Model, crate: *Model) -> *Scatter {
    s = scatter.scatter_new(seed)
    home = rect(0.0 - 28.0, 0.0 - 28.0, 0.0 - 2.0, 28.0)
    yard = rect(2.0, 0.0 - 28.0, 28.0, 28.0)
    scatter.add_area(s, home, 4, "residential", 0.6)
    scatter.add_area(s, yard, 4, "industrial, rundown", 0.2)
    free(home)
    free(yard)
    road = calloc(4, 8)
    (road as float[])[0] = 0.0 - 30.0
    (road as float[])[1] = 0.0
    (road as float[])[2] = 30.0
    (road as float[])[3] = 0.0
    scatter.add_road(s, road, 2, 6.0)
    free(road)
    scatter.add_exclusion(s, 0.0 - 15.0, 15.0, 4.0)
    clutter = scatter.palette_new("clutter", 0.06, 2.0)
    scatter.palette_tags(clutter, "residential", "")
    scatter.palette_slope(clutter, 0.0, 20.0)
    scatter.palette_align(clutter, scatter.ALIGN_ROAD)
    scatter.palette_scale(clutter, 0.8, 1.2)
    scatter.palette_prop(clutter, clutter_a, 2.0)
    scatter.palette_prop(clutter, clutter_b, 1.0)
    scatter.add_palette(s, clutter)
    crates = scatter.palette_new("crates", 0.04, 3.0)
    scatter.palette_tags(crates, "industrial", "wealthy")
    scatter.palette_slope(crates, 0.0, 20.0)
    scatter.palette_wealth(crates, 0.0, 0.5)
    scatter.palette_align(crates, scatter.ALIGN_SURFACE)
    scatter.palette_prop(crates, crate, 1.0)
    scatter.add_palette(s, crates)
    return s
}

main() {
    println("scatter: props placed by rule, the same from a seed")
    floor = loader.quad(60.0, 60.0)
    // A ramp over the industrial side, above the floor, rising 3 in 4 (37
    // degrees). Turned by the rotation taking up to its normal, which is
    // square roots and sums: no sine, whose last bit is the C library's.
    ramp = loader.quad(10.0, 10.0)
    core.model_set_rotation(ramp, core.quat_from_to(core.vec3(0.0, 1.0, 0.0), core.vec3(0.0 - 0.6, 0.8, 0.0)))
    core.model_set_position(ramp, 18.0, 4.0, 15.0)
    core.model_update_matrix(floor)
    core.model_update_matrix(ramp)
    grounds = list.new()
    list.add_raw(grounds, floor as ptr)
    list.add_raw(grounds, ramp as ptr)
    g = scatter.ground_new(grounds, 0.25)
    check("the ground is sampled", g != null && scatter.ground_covers(g, 0.0, 0.0))
    check("the ramp is its top where it stands (${scatter.ground_height(g, 18.0, 15.0)} m)", scatter.ground_height(g, 18.0, 15.0) > 3.0)
    check("and is steeper than the rules allow there", scatter.ground_normal_y(g, 18.0, 15.0) < scatter.slope_cos(20.0))

    clutter_a = loader.cube(0.5)
    clutter_b = loader.sphere(0.4, 8, 6)
    crate = loader.cube(0.8)
    s = district(SEED as long, clutter_a, clutter_b, crate)
    n = scatter.run(s, g)
    check("the district is filled (${n} props)", n > 40)

    // Every placement against every rule.
    steep_cos = scatter.slope_cos(20.0)
    bad_area = 0
    bad_slope = 0
    bad_road = 0
    bad_door = 0
    bad_spacing = 0
    per_palette = calloc(2, 4)
    i = 0
    while i < n {
        p = scatter.placement(s, i)
        (per_palette as int[])[p.palette] = (per_palette as int[])[p.palette] + 1
        if p.palette == 0 && !(p.x < 0.0 - 2.0 && p.x > 0.0 - 28.0) { bad_area = bad_area + 1 }
        if p.palette == 1 && !(p.x > 2.0 && p.x < 28.0) { bad_area = bad_area + 1 }
        if scatter.ground_normal_y(g, p.x, p.z) < steep_cos { bad_slope = bad_slope + 1 }
        if p.z < 3.0 && p.z > 0.0 - 3.0 { bad_road = bad_road + 1 }
        dx = p.x + 15.0
        dz = p.z - 15.0
        if dx * dx + dz * dz < 16.0 { bad_door = bad_door + 1 }
        spacing = 2.0
        if p.palette == 1 { spacing = 3.0 }
        j = 0
        while j < i {
            q = scatter.placement(s, j)
            ex = q.x - p.x
            ez = q.z - p.z
            if ex * ex + ez * ez < spacing * spacing { bad_spacing = bad_spacing + 1 }
            j = j + 1
        }
        i = i + 1
    }
    println("    ${(per_palette as int[])[0]} clutter in the residential area, ${(per_palette as int[])[1]} crates in the industrial")
    check("both palettes placed where their tags are", (per_palette as int[])[0] > 0 && (per_palette as int[])[1] > 0 && bad_area == 0)
    check("none on ground steeper than its rule (the ramp)", bad_slope == 0)
    check("none on the road", bad_road == 0)
    check("none in the doorway kept clear", bad_door == 0)
    check("none closer than its spacing to another (${bad_spacing})", bad_spacing == 0)
    free(per_palette)

    // The same seed, the same placements; another, others.
    first = scatter.hash(s)
    scatter.run(s, g)
    check("run again, the same placements", scatter.hash(s) == first)
    other = district(919 as long, clutter_a, clutter_b, crate)
    scatter.run(other, g)
    check("another seed, other placements", scatter.hash(other) != first)
    scatter.scatter_free(other)
    println("    fingerprint ${first}")
    check("the fingerprint is the one every machine makes", first == EXPECTED_HASH)

    // The same district from a scatter file places the same props.
    filed = scatter.load("tests/fixtures/scatter/district.json")
    check("the district's file loads (${scatter.last_error()})", filed != null)
    if filed != null {
        check("and places what the code does (${scatter.run(filed, g)} props)", scatter.hash(filed) == first)
        scatter.scatter_free(filed)
    }
    check("a file that is not there is an error, not a scatter", scatter.load("tests/fixtures/scatter/none.json") == null && scatter.last_error() != "")

    // A draw a prop.
    models = scatter.build_models(s)
    instances = 0
    i = 0
    while i < list.size(models) {
        instances = instances + core.model_instance_count(list.get_raw(models, i) as *Model)
        i = i + 1
    }
    check("the district is ${list.size(models)} instanced models, a draw a prop, for ${instances} props", list.size(models) == 3 && instances == n)
    // Each prop's instances are its placements, in order, as they stand: the
    // first placement of each model's prop at its instance 0, its up the
    // ground's (or straight up), its facing along the road where asked.
    bad_matrix = 0
    k = 0
    while k < list.size(models) {
        m = list.get_raw(models, k) as *Model
        mat = geometry.inst_matrix_data(m.instances) as f32[]
        // Models come palette by palette, prop by prop, as placed.
        pal = 0
        prop = k
        if k == 2 {
            pal = 1
            prop = 0
        }
        seen = 0
        i = 0
        while i < n {
            q = scatter.placement(s, i)
            if q.palette == pal && q.prop == prop {
                at = seen * 16
                sc = q.scale
                if !near(mat[at + 12] as float, q.x) || !near(mat[at + 13] as float, q.y) || !near(mat[at + 14] as float, q.z) { bad_matrix = bad_matrix + 1 }
                if !near(mat[at + 4] as float, q.ux * sc) || !near(mat[at + 5] as float, q.uy * sc) || !near(mat[at + 6] as float, q.uz * sc) { bad_matrix = bad_matrix + 1 }
                // The clutter faces along the road (down x), either way.
                if pal == 0 && !near((mat[at + 8] as float) * (mat[at + 8] as float), sc * sc) { bad_matrix = bad_matrix + 1 }
                seen = seen + 1
            }
            i = i + 1
        }
        k = k + 1
    }
    check("every instance stands where its placement does, up and facing as its palette asks", bad_matrix == 0)
    scatter.models_free(models)

    scatter.scatter_free(s)
    scatter.ground_free(g)
    core.model_free(clutter_a)
    core.model_free(clutter_b)
    core.model_free(crate)
    core.model_free(floor)
    core.model_free(ramp)
    list.free(grounds)
    if g_failures == 0 {
        println("scatter: all checks passed (${g_checks})")
    } else {
        println("scatter: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
