// A particle is drawn as the disc its texture is, not the square of its quad
// (#711), and a glowing one too: the cut by the texture's alpha comes before
// the emissive surface's early answer.
//
// OpenGL through the engine: an emitter's particle a metre across, still,
// four metres from the camera, and a glowing one beside it; the middle of
// each is drawn and the corners of its quad are the background. Vulkan
// through its backend: the same quad, textured with a disc and cut at 0.5,
// the same way.

import std.mem
import ae3d.core
import ae3d.engine
import ae3d.platform
import ae3d.particles
import ae3d.capture
import ae3d.vulkan
import ae3d.picture
import ae3d.png
import ae3d.rendering

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float

const WIDTH = 320
const HEIGHT = 180

var failures = 0
var g_plain: ptr = null
var g_glow: ptr = null
var g_read = false
var g_middle = 0
var g_corners = 0
var g_glow_middle = 0
var g_glow_corners = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// One still particle a metre across at (x, 1, 0), thrown nowhere, living on.
still(e: *Engine, x: float, glow: bool) -> *Emitter {
    em = particles.emitter(e, 4)
    particles.set_position(em, core.vec3(x, 1.0, 0.0))
    particles.set_speed(em, 0.0, 0.0)
    particles.set_gravity(em, core.vec3(0.0, 0.0, 0.0))
    particles.set_lifetime(em, 100.0, 100.0)
    particles.set_size(em, 1.0, 1.0)
    particles.set_rate(em, 0.0)
    particles.set_color(em, 1.0, 0.6, 0.2)
    if glow { core.model_set_exposure(particles.emitter_model(em), 30.0) }
    particles.burst(em, 1)
    return em
}

on_start(state: ptr, e: *Engine) {
    g_plain = still(e, 0.0 - 1.2, false) as ptr
    g_glow = still(e, 1.2, true) as ptr
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 1.0, 4.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))
}

// Whether the frame's pixel at the ground of (x, y, z) is drawn: brighter
// than the black it was cleared to.
lit_at(e: *Engine, w: int, h: int, x: float, y: float, z: float) -> bool {
    p = core.camera_world_to_screen(engine.engine_camera(e), core.vec3(x, y, z), w, h)
    if p.w < 0.0001 { return false }
    out = calloc(4, 8)
    capture.pixel(p.x as int, p.y as int, out)
    v = out as float[]
    lit = v[0] + v[1] + v[2] > 30.0
    free(out)
    return lit
}

// Whether the middle of a particle at (x, 1, 0) is drawn (ten), and how many
// of its quad's four corners -- 0.45 m out on each axis, inside the quad,
// past the disc -- are (ones).
judge(e: *Engine, w: int, h: int, x: float) -> int {
    n = 0
    if lit_at(e, w, h, x, 1.0, 0.0) { n = 10 }
    if lit_at(e, w, h, x - 0.45, 1.45, 0.0) { n = n + 1 }
    if lit_at(e, w, h, x + 0.45, 1.45, 0.0) { n = n + 1 }
    if lit_at(e, w, h, x - 0.45, 0.55, 0.0) { n = n + 1 }
    if lit_at(e, w, h, x + 0.45, 0.55, 0.0) { n = n + 1 }
    return n
}

on_render(state: ptr, e: *Engine, delta: float) {
    if engine.engine_frame_count(e) != 6 { return }
    win = engine.engine_window(e)
    w = platform.window_fb_width(win)
    h = platform.window_fb_height(win)
    if capture.frame(w, h) == 0 { return }
    plain = judge(e, w, h, 0.0 - 1.2)
    glow = judge(e, w, h, 1.2)
    g_middle = plain / 10
    g_corners = plain % 10
    g_glow_middle = glow / 10
    g_glow_corners = glow % 10
    g_read = true
}

opengl_checks() {
    e = engine.engine_new_with(platform.API_GL)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_title(e, "ae3d particles drawn test")
    engine.engine_set_frame_limit(e, 8)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_shadows(e, false)
    engine.engine_set_clear_color(e, 0.0, 0.0, 0.0)
    light = core.light_sun(core.vec3(0.2, 0.6, 1.0))
    engine.engine_set_light(e, light)
    b = engine.behaviour_new("particles drawn", null)
    b.start = on_start
    b.late_update = on_render
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("  opengl: SKIP no window available")
        core.light_free(light)
        engine.engine_free(e)
        return
    }
    check("opengl: the frame was read", g_read)
    check("opengl: a particle's middle is drawn", g_middle == 1)
    check("opengl: and its quad's corners are not: a disc, not a square (${g_corners} of 4 drawn)", g_corners == 0)
    check("opengl: a glowing particle's middle is drawn", g_glow_middle == 1)
    check("opengl: and its corners are not either (${g_glow_corners} of 4 drawn)", g_glow_corners == 0)
    particles.emitter_free(g_plain as *Emitter)
    particles.emitter_free(g_glow as *Emitter)
    core.light_free(light)
    engine.engine_free(e)
}

// A disc, white at its middle and clear at its rim, as the emitter's own.
disc_texture(name: string) -> bool {
    side = 32
    pixels = calloc(side * side, 4)
    y = 0
    while y < side {
        x = 0
        while x < side {
            dx = ((x as float) + 0.5) / (side as float) - 0.5
            dy = ((y as float) + 0.5) / (side as float) - 0.5
            r = sqrt(dx * dx + dy * dy) * 2.0
            a = 1.0 - r * r
            if a < 0.0 { a = 0.0 }
            png.rgba_set(pixels, y * side + x, 1.0, 1.0, 1.0, a)
            x = x + 1
        }
        y = y + 1
    }
    ok = picture.register_rgba(name, pixels, side, side) == 1
    free(pixels)
    return ok
}

// A quad a metre across facing +z at (x, 1, 0), textured with the disc and
// cut at 0.5.
disc_quad(backend: *Backend, x: float, glow: bool) -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.0 - 0.5, 0.0), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.0 - 0.5, 0.0), 1.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.5, 0.0), 1.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.5, 0.0), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_set_position(m, x, 1.0, 0.0)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    core.model_set_texture(m, "test://particles_drawn/disc")
    core.model_set_cutout(m, 0.5)
    core.model_set_diffuse(m, 1.0, 0.6, 0.2)
    if glow { core.model_set_exposure(m, 30.0) }
    rendering.apply(m, rendering.default_config())
    core.backend_add_model(backend, m)
    return m
}

// The backend frame's pixel at (x, y, z) drawn.
frame_lit(pixels: ptr, cam: *Camera, x: float, y: float, z: float) -> bool {
    p = core.camera_world_to_screen(cam, core.vec3(x, y, z), WIDTH, HEIGHT)
    if p.w < 0.0001 { return false }
    at = ((p.y as int) * WIDTH + (p.x as int)) * 4
    return mem.get_byte(pixels, at) + mem.get_byte(pixels, at + 1) + mem.get_byte(pixels, at + 2) > 30
}

vulkan_corners(pixels: ptr, cam: *Camera, x: float) -> int {
    n = 0
    if frame_lit(pixels, cam, x - 0.45, 1.45, 0.0) { n = n + 1 }
    if frame_lit(pixels, cam, x + 0.45, 1.45, 0.0) { n = n + 1 }
    if frame_lit(pixels, cam, x - 0.45, 0.55, 0.0) { n = n + 1 }
    if frame_lit(pixels, cam, x + 0.45, 0.55, 0.0) { n = n + 1 }
    return n
}

vulkan_checks() {
    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    plain = disc_quad(&backend, 0.0 - 1.2, false)
    glow = disc_quad(&backend, 1.2, true)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 1.0, 4.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))
    light = core.light_sun(core.vec3(0.2, 0.6, 1.0))
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)
    i = 0
    while i < 4 {
        core.backend_render(&backend, cam, light)
        i = i + 1
    }
    pixels = core.backend_frame_pixels(&backend)
    check("vulkan: a disc's middle is drawn", frame_lit(pixels, cam, 0.0 - 1.2, 1.0, 0.0))
    plain_corners = vulkan_corners(pixels, cam, 0.0 - 1.2)
    check("vulkan: and its quad's corners are not (${plain_corners} of 4 drawn)", plain_corners == 0)
    check("vulkan: a glowing disc's middle is drawn", frame_lit(pixels, cam, 1.2, 1.0, 0.0))
    glow_corners = vulkan_corners(pixels, cam, 1.2)
    check("vulkan: and its corners are not either (${glow_corners} of 4 drawn)", glow_corners == 0)
    core.light_free(light)
    core.camera_free(cam)
    vulkan.renderer_free(renderer)
    core.model_free(plain)
    core.model_free(glow)
}

main() {
    check("the disc texture registers", disc_texture("test://particles_drawn/disc"))
    opengl_checks()
    vulkan_checks()
    if failures == 0 {
        println("particles drawn: all checks passed")
    } else {
        println("particles drawn: ${failures} failure(s)")
    }
}
