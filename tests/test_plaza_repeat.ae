// The people plaza run twice on one seed reads the same (#983). The plaza
// (tools/people_plaza.ae) is the scene every gait change is measured on; a
// change of half a millimetre is only a change if the same run, run again,
// reads the same to the bit. No window, the engine stepped by hand a fixed
// step a frame, as AE3D_TICK=60 steps the plaza.
//
// A few of the plaza's people (the UE5 mannequin on 100STYLE's neutral
// gaits, capsules solid, steering round each other) walk and run to goals
// picked by the plaza's own seeded draw, on a floor small enough that they
// meet. The first run's every step is kept: each person's place, turn,
// mover (velocity, facing) and every joint of its drawn pose. The second,
// from the same seed in the same process, is held to it bit for bit, and
// the first step, person and value they part at is said. The second run's
// memory is the first's freed: a read of memory nobody wrote reads the
// first run's leftovers there, not the zeroed pages the first was handed.
//
//   - every value of every step of the second run is the first's, bit for
//     bit;
//   - the meters (ae3d.metrics) read the same worst toe skate, foot throw
//     and fastest joint;
//   - the people met: some two capsules came within 0.5 m (so the
//     steering and the capsules' contacts are in what is compared), and
//     some goals were reached and new ones picked.

import std.mem
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.metrics
import ae3d.pose

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const PEOPLE = 4
const STEPS = 300
const HALF = 3.0                       // metres: the floor's half width the goals are on
const WALK = 1.2
const RUN = 2.6
const ARRIVED = 0.6
const SEED = 2
const OWN = 11                         // values a person keeps besides its joints: place 3, turn 4, velocity 3, facing 1

var g_checks = 0
var g_failures = 0

check(what: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${what}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${what}")
    }
}

// The plaza's draw (tools/people_plaza.ae).
next_seed(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
unit_of(s: int) -> float { return ((s % 100000) as float) / 100000.0 }

struct Run {
    record: ptr                        // float[STEPS * PEOPLE * fields]: what each step left
    fields: int                        // values a person a step: OWN and 7 a joint
    skate: float
    thrown: float
    fastest: float
    nearest: float                     // metres between the two nearest capsules' skins
    reached: int                       // goals reached
}

// Person `c`'s values this step into `out` from `at`: its place, turn,
// mover, and each joint's translation and rotation in its drawn pose.
keep(c: *Character, out: float[], at: int) {
    o = character.object_of(c)
    p = behaviour.object_position(o)
    q = behaviour.object_rotation(o)
    m = character.mover_of(c)
    v = mover.velocity(m)
    out[at] = p.x
    out[at + 1] = p.y
    out[at + 2] = p.z
    out[at + 3] = q.x
    out[at + 4] = q.y
    out[at + 5] = q.z
    out[at + 6] = q.w
    out[at + 7] = v.x
    out[at + 8] = v.y
    out[at + 9] = v.z
    out[at + 10] = mover.facing_of(m)
    a = character.animator_of(c)
    shown = animator.pose_shown(a)
    r = animator.rig(a)
    j = 0
    while j < pose.count(r) {
        t = pose.translation(shown, j)
        jq = pose.rotation(shown, j)
        k = at + OWN + j * 7
        out[k] = t.x
        out[k + 1] = t.y
        out[k + 2] = t.z
        out[k + 3] = jq.x
        out[k + 4] = jq.y
        out[k + 5] = jq.z
        out[k + 6] = jq.w
        j = j + 1
    }
}

// A goal for person `k` standing at `at`, and its pace: a quarter run.
pick(goals: float[], paces: float[], k: int, seed: int) -> int {
    s = next_seed(seed)
    goals[k * 2] = (unit_of(s) * 2.0 - 1.0) * (HALF - 0.5)
    s = next_seed(s)
    goals[k * 2 + 1] = (unit_of(s) * 2.0 - 1.0) * (HALF - 0.5)
    s = next_seed(s)
    paces[k] = WALK
    if unit_of(s) < 0.25 { paces[k] = RUN }
    return s
}

// The plaza from SEED for STEPS steps, every step kept in `run`.
plaza(run: *Run) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(HALF + 4.0, 0.5, HALF + 4.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    people = calloc(PEOPLE, 8) as ptr[]
    meters = calloc(PEOPLE, 8) as ptr[]
    goals = calloc(PEOPLE * 2, 8) as float[]
    paces = calloc(PEOPLE, 8) as float[]
    seed = 7919 + 104729 * SEED
    k = 0
    while k < PEOPLE {
        c = character.humanoid(e, "Person", MANNEQUIN, g)
        if c == null {
            println("  ${character.error()}")
            exit(1)
        }
        o = character.object_of(c)
        seed = next_seed(seed)
        x = (unit_of(seed) * 2.0 - 1.0) * (HALF - 0.5)
        seed = next_seed(seed)
        z = (unit_of(seed) * 2.0 - 1.0) * (HALF - 0.5)
        behaviour.object_set_position(o, core.vec3(x, 0.0, z))
        mover.settle(character.mover_of(c))
        physics.character_set_solid(physics.character_of(o), true)
        people[k] = c as ptr
        m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
        metrics.meter_ground_physics(m, physics.of(e))
        metrics.meter_animator(m, character.animator_of(c))
        meters[k] = m as ptr
        seed = pick(goals, paces, k, seed)
        k = k + 1
    }
    if run.record == null {
        run.fields = OWN + 7 * pose.count(animator.rig(character.animator_of(people[0] as *Character)))
        run.record = calloc(STEPS * PEOPLE * run.fields, 8)
    }
    record = run.record as float[]
    run.nearest = 1000.0
    run.reached = 0
    f = 0
    while f < STEPS {
        k = 0
        while k < PEOPLE {
            c = people[k] as *Character
            at = behaviour.object_position(character.object_of(c))
            to = core.vec3(goals[k * 2] - at.x, 0.0, goals[k * 2 + 1] - at.z)
            if core.v3_len(to) < ARRIVED {
                run.reached = run.reached + 1
                seed = pick(goals, paces, k, seed)
                to = core.vec3(goals[k * 2] - at.x, 0.0, goals[k * 2 + 1] - at.z)
            }
            character.move(c, core.v3_mul(core.v3_normalize(to), paces[k]), core.vec3(0.0, 0.0, 0.0))
            k = k + 1
        }
        engine.engine_update(e, STEP)
        k = 0
        while k < PEOPLE {
            c = people[k] as *Character
            if f >= 60 { metrics.meter_take(meters[k] as *Meter, STEP) }
            keep(c, record, (f * PEOPLE + k) * run.fields)
            oc = character.object_of(c)
            j = k + 1
            while j < PEOPLE {
                oj = character.object_of(people[j] as *Character)
                pa = behaviour.object_position(oc)
                pb = behaviour.object_position(oj)
                gap = core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z)) - physics.character_radius(physics.character_of(oc)) - physics.character_radius(physics.character_of(oj))
                if gap < run.nearest { run.nearest = gap }
                j = j + 1
            }
            k = k + 1
        }
        f = f + 1
    }
    run.skate = 0.0
    run.thrown = 0.0
    run.fastest = 0.0
    k = 0
    while k < PEOPLE {
        m = meters[k] as *Meter
        if metrics.meter_worst(m, metrics.SKATE) > run.skate { run.skate = metrics.meter_worst(m, metrics.SKATE) }
        if metrics.meter_worst(m, metrics.FOOT_THROW) > run.thrown { run.thrown = metrics.meter_worst(m, metrics.FOOT_THROW) }
        if metrics.meter_worst(m, metrics.POP) > run.fastest { run.fastest = metrics.meter_worst(m, metrics.POP) }
        metrics.meter_free(m)
        character.character_free(people[k] as *Character)
        k = k + 1
    }
    free(people as ptr)
    free(meters as ptr)
    free(goals as ptr)
    free(paces as ptr)
    character.gaits_free(g)
    engine.engine_free(e)
}

same(a: float, b: float) -> bool { return mem.bits_of_float(a) == mem.bits_of_float(b) }

main() {
    println("plaza_repeat: the people plaza run twice on one seed reads the same (#983)")
    first = Run { record: null, fields: 0, skate: 0.0, thrown: 0.0, fastest: 0.0, nearest: 0.0, reached: 0 }
    plaza(&first)
    kept = first.record
    second = Run { record: null, fields: 0, skate: 0.0, thrown: 0.0, fastest: 0.0, nearest: 0.0, reached: 0 }
    plaza(&second)
    println("  ${PEOPLE} people, ${STEPS} steps, ${first.fields} values a person a step; goals reached ${first.reached} and ${second.reached}; capsules ${first.nearest * 1000.0} mm apart at the nearest")
    println("  first: a toe skating ${first.skate * 1000.0} mm, thrown ${first.thrown} m/s, the fastest joint ${first.fastest} rad/s")
    println("  again: a toe skating ${second.skate * 1000.0} mm, thrown ${second.thrown} m/s, the fastest joint ${second.fastest} rad/s")
    a = kept as float[]
    b = second.record as float[]
    total = STEPS * PEOPLE * first.fields
    differ = 0
    parted = 0 - 1
    i = 0
    while i < total {
        if !same(a[i], b[i]) {
            if parted < 0 { parted = i }
            differ = differ + 1
        }
        i = i + 1
    }
    if parted >= 0 {
        step = parted / (PEOPLE * first.fields)
        person = (parted / first.fields) % PEOPLE
        value = parted % first.fields
        what = "its place, turn or mover"
        if value >= OWN { what = "joint ${(value - OWN) / 7}" }
        println("  parted at step ${step}, person ${person}, value ${value} (${what}): ${a[parted]} then ${b[parted]}; ${differ} of ${total} values differ")
    }
    check("every value of every step (place, turn, mover, every joint of the drawn pose) the same bit for bit", second.fields == first.fields && differ == 0)
    check("the meters read the same worst toe skate, foot throw and fastest joint", same(first.skate, second.skate) && same(first.thrown, second.thrown) && same(first.fastest, second.fastest))
    check("the people met and went on to new goals: two capsules within 0.5 m, some goals reached", first.nearest < 0.5 && first.reached > 0)
    free(kept)
    free(second.record)
    if g_failures == 0 {
        println("plaza_repeat: all checks passed (${g_checks})")
        return
    }
    println("plaza_repeat: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
