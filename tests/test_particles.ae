// Particles (#546), held to numbers. No window: the engine is stepped by
// hand at 60 Hz.
//
//   - a particle thrown straight up falls as a body under gravity does: at
//     the top of its flight when v/g has passed, where v^2/2g says;
//   - drag slows it: the same throw with drag tops out lower;
//   - landing: a burst onto a plane at a height lands every particle on
//     it, each saying where, on the plane and with its normal up; a burst
//     onto a static box lands on the box's top, not the ground under it;
//   - a lifetime: particles that never land are gone when it is over;
//   - a rate: 50 a second for two seconds is a hundred, a burst is as many
//     as there is room for, never more than the capacity;
//   - the cone: every particle leaves within its half angle of the axis;
//   - the same seed, the same particles: two runs match to the bit;
//   - the colour: every particle carries its emitter's, in the stream the
//     renderers draw a point from (#557; test_instance_streams draws it);
//   - blended, an emitter's particles keep their soft rim (no cut at a
//     half); opaque, they are cut to the disc (#738);
//   - an area: every particle born on its disc, and across it;
//   - stretched: a spark moving across the view is drawn long, a still one
//     square, and with stretch off none is;
//   - a light: the colour of a black body at its kelvin, its intensity
//     flickering about its power, the same on every run.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.particles
import ae3d.geometry

extern exit(code: int)
extern acos(x: float) -> float

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// A point's stretch, as the point stream carries it to the renderers.
point_stretch(em: *Emitter, i: int) -> float {
    m = particles.emitter_model(em)
    stream = geometry.inst_point_data(m.instances) as f32[]
    return stream[i * geometry.POINT_FLOATS + 11] as float
}

world() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

// Landings, as the game hears them.
struct Heard {
    count: int
    lowest: float
    highest: float
    worst_normal: float              // how far, at most, a normal was from straight up
    sum_x: float
}

heard(context: ptr, at: Vec3, normal: Vec3) {
    h = context as *Heard
    h.count = h.count + 1
    if h.count == 1 || at.y < h.lowest { h.lowest = at.y }
    if h.count == 1 || at.y > h.highest { h.highest = at.y }
    off = 1.0 - normal.y
    if off > h.worst_normal { h.worst_normal = off }
    h.sum_x = h.sum_x + at.x
}

// The highest a particle thrown straight up at `speed` gets, with `drag`.
apex(speed: float, drag: float) -> float {
    e = world()
    em = particles.emitter(e, 4)
    particles.set_position(em, core.vec3(0.0, 0.0, 0.0))
    particles.set_direction(em, core.vec3(0.0, 1.0, 0.0), 0.0)
    particles.set_speed(em, speed, speed)
    particles.set_lifetime(em, 10.0, 10.0)
    particles.set_drag(em, drag)
    particles.burst(em, 1)
    top = 0.0
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        y = particles.particle_position(em, 0).y
        if y > top { top = y }
        k = k + 1
    }
    particles.emitter_free(em)
    engine.engine_free(e)
    return top
}

// Every particle's position after `steps`, summed, for a seed: a run's print.
print_of(seed: long, steps: int) -> float {
    e = world()
    em = particles.emitter(e, 256)
    particles.set_seed(em, seed)
    particles.set_direction(em, core.vec3(0.3, 1.0, 0.0), 0.6)
    particles.set_speed(em, 1.0, 4.0)
    particles.set_lifetime(em, 1.0, 3.0)
    particles.set_rate(em, 80.0)
    particles.set_ground(em, 0.0 - 1.0)
    k = 0
    while k < steps {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    sum = 0.0
    i = 0
    while i < particles.alive(em) {
        p = particles.particle_position(em, i)
        sum = sum + p.x * 1.0 + p.y * 3.0 + p.z * 7.0
        i = i + 1
    }
    sum = sum + (particles.landed(em) as float) * 1000.0
    particles.emitter_free(em)
    engine.engine_free(e)
    return sum
}

main() {
    println("particles: thrown, pulled, slowed, landed")

    // Ballistics.
    speed = 6.0
    top = apex(speed, 0.0)
    want = speed * speed / (2.0 * 9.81)
    println("  thrown up at ${speed} m/s: top ${top} m, v^2/2g ${want} m")
    check("a particle thrown up tops out where v^2/2g says (within 0.1%)", abs_of(top - want) < want * 0.001)
    slowed = apex(speed, 1.0)
    println("  with drag 1/s: top ${slowed} m")
    check("drag tops it out lower", slowed < top * 0.9)

    // Onto a plane.
    e = world()
    em = particles.emitter(e, 200)
    h = Heard { count: 0, lowest: 0.0, highest: 0.0, worst_normal: 0.0, sum_x: 0.0 }
    particles.on_land(em, heard, (&h) as ptr)
    particles.set_position(em, core.vec3(0.0, 2.0, 0.0))
    particles.set_direction(em, core.vec3(1.0, 1.0, 0.0), 0.5)
    particles.set_lifetime(em, 10.0, 10.0)
    particles.set_ground(em, 0.5)
    particles.burst(em, 150)
    k = 0
    while k < 300 { engine.engine_update(e, STEP); k = k + 1 }
    println("  150 onto a plane at 0.5 m: ${h.count} landed, at ${h.lowest} to ${h.highest} m, the normal at most ${h.worst_normal} off up; ${particles.alive(em)} left")
    check("a burst onto a plane lands every particle, on the plane", h.count == 150 && abs_of(h.lowest - 0.5) < 0.000001 && abs_of(h.highest - 0.5) < 0.000001 && particles.alive(em) == 0)
    check("each landing says the plane's normal", h.worst_normal < 0.000001)
    particles.emitter_free(em)
    engine.engine_free(e)

    // Onto a static box over the ground.
    e = world()
    physics.attach(e)
    table = engine.object(e, "Table", loader.cube(1.0))
    behaviour.object_set_position(table, core.vec3(0.0, 0.5, 0.0))
    physics.box_collider(table, core.vec3(1.0, 0.5, 1.0), physics.material(0.6, 0.0))
    em = particles.emitter(e, 100)
    h = Heard { count: 0, lowest: 0.0, highest: 0.0, worst_normal: 0.0, sum_x: 0.0 }
    particles.on_land(em, heard, (&h) as ptr)
    particles.set_position(em, core.vec3(0.0, 3.0, 0.0))
    particles.set_direction(em, core.vec3(0.0, 0.0 - 1.0, 0.0), 0.3)
    particles.set_speed(em, 0.5, 1.5)
    particles.set_lifetime(em, 10.0, 10.0)
    particles.set_ground(em, 0.0)
    particles.burst(em, 60)
    k = 0
    while k < 240 { engine.engine_update(e, STEP); k = k + 1 }
    println("  60 dropped onto a box whose top is at 1 m: ${h.count} landed, at ${h.lowest} to ${h.highest} m")
    check("dropped onto a static box, every particle lands on its top, not the ground under it", h.count == 60 && abs_of(h.lowest - 1.0) < 0.001 && abs_of(h.highest - 1.0) < 0.001)
    check("and the box's top says it faces up", h.worst_normal < 0.001)
    particles.emitter_free(em)
    engine.engine_free(e)

    // A lifetime, a rate, a burst's bound, the cone.
    e = world()
    em = particles.emitter(e, 1000)
    particles.set_gravity(em, core.vec3(0.0, 0.0, 0.0))
    particles.set_direction(em, core.vec3(0.0, 0.0, 1.0), 0.25)
    particles.set_lifetime(em, 5.0, 5.0)
    particles.set_rate(em, 50.0)
    k = 0
    while k < 120 { engine.engine_update(e, STEP); k = k + 1 }
    born = particles.spawned(em)
    widest = 0.0
    i = 0
    while i < particles.alive(em) {
        v = particles.particle_velocity(em, i)
        angle = acos(v.z / core.v3_len(v))
        if angle > widest { widest = angle }
        i = i + 1
    }
    println("  50 a second for two seconds: ${born} born; the widest left ${widest} rad off the axis (the cone 0.25)")
    check("a rate of 50 a second for two seconds is a hundred", born == 100)
    check("every particle leaves within the cone", widest <= 0.25 + 0.000001)
    particles.set_rate(em, 0.0)
    k = 0
    while k < 300 { engine.engine_update(e, STEP); k = k + 1 }
    check("particles that never land are gone when their lifetime is over", particles.alive(em) == 0)
    particles.burst(em, 5000)
    check("a burst is as many as there is room for, never more", particles.alive(em) == 1000)
    particles.emitter_free(em)
    engine.engine_free(e)

    // The colour, where a point's colour is drawn from: its own record in
    // the point stream, four floats in.
    e = world()
    em = particles.emitter(e, 64)
    particles.set_color(em, 0.32, 0.02, 0.02)
    particles.burst(em, 40)
    engine.engine_update(e, STEP)
    m = particles.emitter_model(em)
    stream = geometry.inst_point_data(m.instances) as f32[]
    worst = 0.0
    i = 0
    while i < particles.alive(em) {
        off = abs_of((stream[i * geometry.POINT_FLOATS + 4] as float) - 0.32) + abs_of((stream[i * geometry.POINT_FLOATS + 5] as float) - 0.02) + abs_of((stream[i * geometry.POINT_FLOATS + 6] as float) - 0.02)
        if off > worst { worst = off }
        i = i + 1
    }
    println("  40 coloured (0.32, 0.02, 0.02): ${particles.alive(em)} alive, the furthest from it by ${worst}")
    check("every particle is drawn in its emitter's colour", particles.alive(em) == 40 && worst < 0.00001)
    particles.emitter_free(em)
    engine.engine_free(e)

    // Blended or opaque, the cut (#738).
    e = world()
    em = particles.emitter(e, 8)
    m = particles.emitter_model(em)
    opaque_cut = m.material.cutout
    particles.set_blend(em, core.BLEND_ADD)
    added_cut = m.material.cutout
    particles.set_blend(em, core.BLEND_ALPHA)
    blended_cut = m.material.cutout
    particles.set_blend(em, core.BLEND_OPAQUE)
    check("opaque, a particle is cut to its disc; blended or added, it keeps its soft rim",
          opaque_cut == 0.5 && added_cut == 0.0 && blended_cut == 0.0 && m.material.cutout == 0.5)
    particles.emitter_free(em)
    engine.engine_free(e)

    // An area.
    e = world()
    em = particles.emitter(e, 400)
    particles.set_position(em, core.vec3(1.0, 2.0, 3.0))
    particles.set_area(em, 0.5)
    particles.burst(em, 400)
    furthest = 0.0
    off_level = 0.0
    i = 0
    while i < particles.alive(em) {
        p = particles.particle_position(em, i)
        d = core.sqrt_of((p.x - 1.0) * (p.x - 1.0) + (p.z - 3.0) * (p.z - 3.0))
        if d > furthest { furthest = d }
        if abs_of(p.y - 2.0) > off_level { off_level = abs_of(p.y - 2.0) }
        i = i + 1
    }
    println("  400 born on a disc of 0.5 m: the furthest ${furthest} m out, ${off_level} m off its level")
    check("every particle is born on its disc, and across it", furthest <= 0.5 + 0.000001 && furthest > 0.45 && off_level < 0.000001)
    particles.emitter_free(em)
    engine.engine_free(e)

    // Stretched.
    e = world()
    cam = core.camera_new(320, 180)
    e.camera = cam as ptr
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 10.0))
    em = particles.emitter(e, 4)
    particles.set_gravity(em, core.vec3(0.0, 0.0, 0.0))
    particles.set_direction(em, core.vec3(1.0, 0.0, 0.0), 0.0)
    particles.set_speed(em, 4.0, 4.0)
    particles.set_size(em, 0.1, 0.1)
    particles.burst(em, 1)
    engine.engine_update(e, STEP)
    plain = point_stretch(em, 0)
    particles.set_stretch(em, 0.05)
    engine.engine_update(e, STEP)
    drawn_long = point_stretch(em, 0)
    // 4 m/s across the view for 0.05 s over a 0.1 m width: 1 + 2.
    println("  a spark at 4 m/s across the view: drawn ${plain} long square, ${drawn_long} with a 0.05 s stretch (3 wanted)")
    check("a spark across the view is drawn along its flight, as long as its travel in the stretch", plain == 0.0 && abs_of(drawn_long - 3.0) < 0.01)
    particles.emitter_free(em)
    engine.engine_free(e)

    // A light.
    e = world()
    em = particles.emitter(e, 4)
    particles.set_position(em, core.vec3(0.0, 0.0, 0.0))
    particles.set_light(em, 1900.0, 2.0, 5.0, 0.5)
    l = particles.emitter_light(em)
    low = 100.0
    high = 0.0
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        if l.intensity < low { low = l.intensity }
        if l.intensity > high { high = l.intensity }
        k = k + 1
    }
    println("  a 1900 K light about 2: colour ${l.color.x}, ${l.color.y}, ${l.color.z}; intensity ${low} to ${high} over four seconds, ${l.position.y} m up")
    check("a fire's light is a black body's colour: red, some green, almost no blue",
          l.color.x == 1.0 && l.color.y > 0.2 && l.color.y < 0.6 && l.color.z < 0.1)
    check("and it flickers about its power, never past it", low > 2.0 * 0.6 && high <= 2.0 + 0.000001 && high - low > 0.3 && abs_of(l.position.y - 0.5) < 0.000001)
    particles.emitter_free(em)
    engine.engine_free(e)

    // The same seed, the same particles.
    first = print_of(7 as long, 150)
    second = print_of(7 as long, 150)
    other = print_of(8 as long, 150)
    println("  a run's print: ${first}, again ${second}; another seed ${other}")
    check("the same seed makes the same particles, to the bit", first == second)
    check("and another seed others", first != other)

    if g_failures == 0 {
        println("particles: all checks passed (${g_checks})")
    } else {
        println("particles: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
