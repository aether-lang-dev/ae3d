// ci: optimised -- its run is CPU work -O0 makes three to six times slower
// A figure knocked down hard comes to lie and gets up again, without its
// muscles pushing it along the ground in a heap first (#951), held to
// numbers. The box man on its Idle, POWERED, getting up a second after it
// settles, struck at the chest from in front and from behind, the blow
// giving it 4 to 15 m/s (a car's), on the servo and on muscles: 48 figures,
// each in an engine of its own, no window.
//
//   - each falls, comes to lie, and stands again within 15 s;
//   - heaped: in the protective fall with its pelvis within 0.45 m of the
//     ground. Read as neither lying nor caught, a figure thrown down half
//     sitting went on falling there, its reaching arms and the balance
//     pushing it up and along the ground for two seconds and more. Over
//     the 48 it is heaped 0.24 s on average now, 0.67 at the most, its
//     chest carried 0.79 m meanwhile on average; before (motion.HEAPED)
//     0.50 s and 2.47, and 1.26 m;
//   - from the blow to lying, 2.79 s on average (3.09 before), and over
//     3 s in 18 (26 before): what is left is the throw itself, a body
//     given 10 m/s tumbling on.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEPS = 900                    // 15 s
const HEAP_HEIGHT = 0.45             // m: the pelvis this near the ground, falling, is heaped
const HEAP_MEAN = 0.35               // s heaped on average, at the most
const HEAP_MOST = 1.0                // s heaped in any fall, at the most
const LYING_MEAN = 2.95             // s from the blow to lying on average, at the most

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    h = physics.ragdoll_human(m.ragdoll)
    turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(h, human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(m.ragdoll))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// One figure struck at `speed` m/s (its whole body's), from behind
// (`forward`) or in front, on muscles or the servo: seconds to lying, to
// standing again (each 0 - 1 if never), seconds heaped and the chest's
// travel then.
knock(speed: float, forward: bool, muscles: bool) -> (float, float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    figure.play(figure.figure_of(o), "Idle", 1.0, true)
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    if muscles { motion.set_muscles(m, true) }
    motion.set_get_up(m, 1.0)
    r = m.ragdoll
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
    push = core.v3_mul(facing(m), speed * physics.ragdoll_mass(r))
    if !forward { push = core.v3_mul(push, 0.0 - 1.0) }
    motion.hit(m, human.BONE_SPINE_03, chest, push)
    lying = 0.0 - 1.0
    rose = false
    stood = 0.0 - 1.0
    heaped = 0.0
    carried = 0.0
    was = chest
    k = 0
    while k < STEPS {
        engine.engine_update(e, STEP)
        t = (k + 1) as float * STEP
        if lying < 0.0 && motion.lying(m) { lying = t }
        if motion.getting_up(m) { rose = true }
        if rose && stood < 0.0 && !motion.getting_up(m) { stood = t }
        now = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
        pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
        if motion.falling(m) && !m.landed && pelvis < HEAP_HEIGHT {
            heaped = heaped + STEP
            carried = carried + core.v3_len(core.v3_sub(now, was))
        }
        was = now
        k = k + 1
    }
    up = motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m)
    if !up { stood = 0.0 - 1.0 }
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return lying, stood, heaped, carried
}

main() {
    println("fall_heap: knocked down hard, it lies and gets up, not pushed along the ground in a heap (#951)")
    count = 0
    all_up = true
    heaped_sum = 0.0
    heaped_most = 0.0
    carried_sum = 0.0
    carried_most = 0.0
    lying_sum = 0.0
    over = 0
    way = 0
    while way < 4 {
        forward = way % 2 == 0
        muscles = way >= 2
        s = 4
        while s <= 15 {
            lying, stood, heaped, carried = knock(s as float, forward, muscles)
            count = count + 1
            if lying < 0.0 || stood < 0.0 {
                all_up = false
                println("    ${s} m/s forward ${forward} muscles ${muscles}: lying ${lying} s, standing ${stood} s")
            }
            heaped_sum = heaped_sum + heaped
            if heaped > heaped_most { heaped_most = heaped }
            carried_sum = carried_sum + carried
            if carried > carried_most { carried_most = carried }
            lying_sum = lying_sum + lying
            if lying > 3.0 { over = over + 1 }
            s = s + 1
        }
        way = way + 1
    }
    n = count as float
    println("  ${count} falls: heaped ${heaped_sum / n} s on average, ${heaped_most} at the most; its chest carried ${carried_sum / n} m then on average, ${carried_most} at the most")
    println("  from the blow to lying ${lying_sum / n} s on average, over 3 s in ${over}")
    check("each falls, lies and stands again within 15 s", all_up)
    check("heaped under ${HEAP_MEAN} s on average", heaped_sum / n < HEAP_MEAN)
    check("heaped under ${HEAP_MOST} s in every fall", heaped_most < HEAP_MOST)
    check("from the blow to lying under ${LYING_MEAN} s on average", lying_sum / n < LYING_MEAN)
    if g_failures > 0 {
        println("fall_heap: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("fall_heap: all checks passed (${g_checks})")
}
