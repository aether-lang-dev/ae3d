// Kneeling by someone on the ground to work over them with both hands, and
// up again (#825, its 5: motion.kneel / stand_up), held to the numbers a game
// judges it by: the box man, POWERED, kneels to work at a point on the
// ground ahead of it 0.2 m up (where a lying figure's chest is), works two
// seconds, and stands up. No window.
//
//   - it comes to kneel;
//   - knelt, a knee is on the ground: the drawn flesh of the left calf near
//     the knee under 2 cm over the ground, and no more than 1 cm into it
//     (#825's 2 cm);
//   - working, its hands' middle is at the work point: under 5 cm from it
//     all the while (#825's 5 cm), the hands moving round it;
//   - no toe slides more than 5 mm along the ground while it bears (going
//     down and coming up; a foot lifted to step back is not bearing);
//   - no drawn part goes more than 1 cm under the ground;
//   - no body turns more than 6 degrees in a step (no pop);
//   - up, it is POWERED and upright a second on.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import ae3d.skin
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const WORK_HIGH = 0.2
const BEARS = 0.015                   // m over its standing height a toe still bears

var g_checks = 0
var g_failures = 0
var g_palm = 0.0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

drawn(o: *GameObject, name: string) -> Vec3 {
    sk = figure.skeleton(figure.figure_of(o))
    b = skin.skeleton_bone(sk, skin.skeleton_find(sk, name))
    core.model_sync_transform(b)
    return b.world_position
}

palm(o: *GameObject, side: string) -> Vec3 {
    wrist = drawn(o, "mixamorig:${side}Hand")
    elbow = drawn(o, "mixamorig:${side}ForeArm")
    return core.v3_add(wrist, core.v3_mul(core.v3_normalize(core.v3_sub(wrist, elbow)), g_palm))
}

// The lowest drawn flesh of every bone: nothing under the ground.
body_lowest(r: *Ragdoll) -> float {
    low = 1000.0
    i = 0
    while i < physics.ragdoll_bone_count(r) {
        at, found = physics.ragdoll_flesh_lowest(r, i)
        if found && at < low { low = at }
        i = i + 1
    }
    return low
}

main() {
    println("kneel: down by a point on the ground, working at it, and up again (#825)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        println("kneel: SKIP ${PATH} would not load")
        engine.engine_free(e)
        return
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    engine.engine_update(e, STEP)
    pz = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    physics.ragdoll_body_pose(r, pz)
    g_palm = core.v3_len(core.v3_sub(physics.ragdoll_pose_end(r, pz, human.BONE_LOWER_ARM_L), drawn(o, "mixamorig:LeftHand")))
    free(pz)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    toe_l = drawn(o, "mixamorig:LeftToeBase")
    toe_r = drawn(o, "mixamorig:RightToeBase")
    rest_y = toe_l.y
    if toe_r.y > rest_y { rest_y = toe_r.y }
    // The work point: where kneel_spot has the figure stand for it, ahead.
    feet = core.v3_mul(core.v3_add(drawn(o, "mixamorig:LeftFoot"), drawn(o, "mixamorig:RightFoot")), 0.5)
    probe = motion.kneel_spot(m, core.vec3(0.0, WORK_HIGH, 0.0), way)
    at = core.vec3(feet.x - probe.x, WORK_HIGH, feet.z - probe.z)

    count = physics.ragdoll_bone_count(r)
    was = calloc(count * 4, 8)
    last = was as float[]
    i = 0
    while i < count {
        q = physics.ragdoll_bone_rotation(r, i)
        last[i * 4] = q.x
        last[i * 4 + 1] = q.y
        last[i * 4 + 2] = q.z
        last[i * 4 + 3] = q.w
        i = i + 1
    }
    check("it kneels", motion.kneel(m, at, way))
    knelt_at = 0 - 1
    knee_high = 0.0 - 1000.0
    knee_low = 1000.0
    hands_off = 0.0
    sunk = 1000.0
    worst_turn = 0.0
    slide = 0.0
    worst_slide = 0.0
    was_l = toe_l
    was_r = toe_r
    bore_l = false
    bore_r = false
    standing = false
    up_at = 0 - 1
    k = 0
    while k < 1200 {
        engine.engine_update(e, STEP)
        i = 0
        while i < count {
            q = physics.ragdoll_bone_rotation(r, i)
            t = turned_by(core.quat(last[i * 4], last[i * 4 + 1], last[i * 4 + 2], last[i * 4 + 3]), q)
            if up_at < 0 && t > worst_turn { worst_turn = t }
            last[i * 4] = q.x
            last[i * 4 + 1] = q.y
            last[i * 4 + 2] = q.z
            last[i * 4 + 3] = q.w
            i = i + 1
        }
        // The toes, plant by plant: slid while they bear.
        tl = drawn(o, "mixamorig:LeftToeBase")
        tr = drawn(o, "mixamorig:RightToeBase")
        bl = tl.y < rest_y + BEARS
        br = tr.y < rest_y + BEARS
        if up_at < 0 {
            if bl && bore_l { slide = core.v3_len(core.vec3(tl.x - was_l.x, 0.0, tl.z - was_l.z)) } else { slide = 0.0 }
            if slide > worst_slide { worst_slide = slide }
            if br && bore_r { slide = core.v3_len(core.vec3(tr.x - was_r.x, 0.0, tr.z - was_r.z)) } else { slide = 0.0 }
            if slide > worst_slide { worst_slide = slide }
            low = body_lowest(r)
            if low < sunk { sunk = low }
        }
        bore_l = bl
        bore_r = br
        was_l = tl
        was_r = tr
        if knelt_at < 0 && motion.knelt(m) { knelt_at = k }
        if knelt_at >= 0 && !standing && k > knelt_at + 10 {
            knee = drawn(o, "mixamorig:LeftLeg")
            flesh, found = physics.ragdoll_flesh_lowest(r, human.BONE_CALF_L, knee, 0.1)
            if found {
                if flesh > knee_high { knee_high = flesh }
                if flesh < knee_low { knee_low = flesh }
            }
            mid = core.v3_mul(core.v3_add(palm(o, "Left"), palm(o, "Right")), 0.5)
            off = core.v3_len(core.v3_sub(mid, at))
            if off > hands_off { hands_off = off }
        }
        if knelt_at >= 0 && !standing && k == knelt_at + 120 { standing = motion.stand_up(m) }
        if standing && up_at < 0 && !motion.acting(m) { up_at = k }
        if up_at >= 0 && k == up_at + 60 { k = 1200 }
        k = k + 1
    }
    free(was)
    println("  knelt after ${(knelt_at as float) * STEP} s; the left knee's flesh ${knee_low * 100.0} to ${knee_high * 100.0} cm over the ground; the hands' middle ${hands_off * 100.0} cm from the work at the most; a toe slid ${worst_slide * 1000.0} mm in a step while bearing; the lowest flesh ${sunk * 100.0} cm; the worst turn in a step ${worst_turn * 57.29578} degrees")
    check("it comes to kneel", knelt_at >= 0)
    check("knelt, a knee is on the ground (under 2 cm over it, no more than 1 cm into it)", knelt_at >= 0 && knee_high < 0.02 && knee_low > 0.0 - 0.01)
    check("working, its hands are at the work (their middle under 5 cm from it)", knelt_at >= 0 && hands_off < 0.05)
    check("no toe slides along the ground while it bears (under 5 mm in a step)", worst_slide < 0.005)
    check("nothing drawn goes under the ground (more than 1 cm)", sunk > 0.0 - 0.01)
    check("no body turns more than 6 degrees in a step (no pop)", worst_turn < 0.10472)
    println("  stood up: ${motion.mode_name(motion.mode(m))}, ${motion.tilt(m)} rad a second on")
    check("it stands up, POWERED and upright a second on (under 0.1 rad)", standing && up_at >= 0 && motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m))
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures > 0 {
        println("kneel: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("kneel: all checks passed (${g_checks})")
}
