// A directed hit reaction (#698, part of #572), held to numbers. POWERED
// figures standing on their own, each in an engine of its own, struck a
// second in by a blow they stand through, beside a twin with the reaction
// off (set_hit_reaction false); no window.
//
//   - struck in the belly from in front, a little right of its middle: the
//     right hand is on the wound (its palm within REACH of the point
//     struck, carried with the body) from 0.6 s to 1.6 s after the blow,
//     where the twin's stays where its arm hangs; and the chest folds
//     toward the wound, forward, more than the twin's;
//   - struck on the left upper arm from its left: the right hand goes to
//     it, its palm within REACH_ACROSS (its forearm comes to rest against
//     the chest about 10 cm short, #700), and the struck arm is not aimed;
//   - struck on the left thigh from in front: the left knee gives, bending
//     more than the twin's;
//   - each stands through it;
//   - no arm bone turns faster than ARM_FASTEST: the hand comes in, it
//     does not snap.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const BLOW_STEP = 60
const REACH = 0.15                   // m from the palm to the point struck
const HAND = 0.08                    // m from the wrist to the palm
const REACH_ACROSS = 0.25            // across the body, until #700
const ARM_FASTEST = 14.0             // rad/s
const COST = 0.3                     // the share of the struck bone's muscle the blow takes

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

struct Outcome {
    left_far: float                  // the most the left palm was from the wound, 0.6 s to 1.6 s after
    right_far: float                 // and the right's
    fold: float                      // the most the chest's top came toward the wound, from before the blow (m)
    knee: float                      // the most the left knee bent past where it was before the blow (rad)
    fastest_arm: float               // rad/s, any arm bone, the 2 s after
    left_aimed: bool                 // the left upper arm was aimed at some step after
    fell: bool
}

// A hand's palm: HAND past the wrist, the way the forearm points. The
// box man's forearm ends at the wrist; a hand covers a wound with its palm.
palm(r: *Ragdoll, pose: ptr, forearm: int) -> Vec3 {
    return core.v3_add(physics.ragdoll_pose_end(r, pose, forearm), core.v3_mul(bone_axis_now(r, forearm), HAND))
}

bone_axis_now(r: *Ragdoll, i: int) -> Vec3 {
    return core.quat_apply(physics.ragdoll_bone_rotation(r, i), physics.ragdoll_bone_axis(r, i))
}

// One figure struck on `bone` at `out_by` metres from the bone's middle
// along `side_way` and `ahead_by` along the way it faces, by `impulse`
// newton seconds along `push` (in the figure's frame: x its left, z ahead);
// 3 s on.
trial(bone: int, ahead_by: float, side_by: float, push_x: float, push_z: float, impulse: float, reacting: bool) -> Outcome {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig()
    physics.ragdoll_dress(r, rig)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    motion.set_hit_reaction(m, reacting)
    pose = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    out = Outcome { left_far: 0.0, right_far: 0.0, fold: 0.0, knee: 0.0, fastest_arm: 0.0, left_aimed: false, fell: false }
    ahead = core.vec3(0.0, 0.0, 1.0)
    left = core.vec3(1.0, 0.0, 0.0)
    local = core.vec3(0.0, 0.0, 0.0)
    toward = core.vec3(0.0, 0.0, 0.0)
    chest_top0 = core.vec3(0.0, 0.0, 0.0)
    knee0 = 0.0
    step = 0
    while step < BLOW_STEP + 180 {
        engine.engine_update(e, STEP)
        if step == BLOW_STEP {
            // Its own left and ahead: from its right shoulder to its left,
            // and the way its pelvis faces.
            sl = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_UPPER_ARM_L))
            sr = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_UPPER_ARM_R))
            left = core.v3_normalize(core.vec3(sl.x - sr.x, 0.0, sl.z - sr.z))
            turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS), core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
            f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
            ahead = core.v3_normalize(core.vec3(f.x, 0.0, f.z))
            at = behaviour.object_position(physics.ragdoll_bone(r, bone))
            q = physics.ragdoll_bone_rotation(r, bone)
            point = core.v3_add(at, core.v3_add(core.v3_mul(ahead, ahead_by), core.v3_mul(left, side_by)))
            local = core.quat_apply(core.quat_conjugate(q), core.v3_sub(point, at))
            toward = core.v3_normalize(core.vec3(point.x - at.x, 0.0, point.z - at.z))
            chest_top0 = core.v3_sub(core.v3_add(behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), core.v3_mul(bone_axis_now(r, human.BONE_SPINE_03), 0.3)), behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)))
            knee0 = acos(core.clampf(core.v3_dot(bone_axis_now(r, human.BONE_THIGH_L), bone_axis_now(r, human.BONE_CALF_L)), 0.0 - 1.0, 1.0))
            way = core.v3_add(core.v3_mul(left, push_x), core.v3_mul(ahead, push_z))
            motion.hit(m, bone, point, core.v3_mul(way, impulse), true, COST)
        }
        if step > BLOW_STEP {
            since = ((step - BLOW_STEP) as float) * STEP
            at = behaviour.object_position(physics.ragdoll_bone(r, bone))
            wound = core.v3_add(at, core.quat_apply(physics.ragdoll_bone_rotation(r, bone), local))
            physics.ragdoll_body_pose(r, pose)
            wl = core.v3_len(core.v3_sub(palm(r, pose, human.BONE_LOWER_ARM_L), wound))
            wr = core.v3_len(core.v3_sub(palm(r, pose, human.BONE_LOWER_ARM_R), wound))
            if since >= 0.6 && since <= 1.6 {
                if wl > out.left_far { out.left_far = wl }
                if wr > out.right_far { out.right_far = wr }
            }
            top = core.v3_sub(core.v3_add(behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), core.v3_mul(bone_axis_now(r, human.BONE_SPINE_03), 0.3)), behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)))
            came = core.v3_dot(core.v3_sub(top, chest_top0), toward)
            if since <= 1.6 && came > out.fold { out.fold = came }
            knee = acos(core.clampf(core.v3_dot(bone_axis_now(r, human.BONE_THIGH_L), bone_axis_now(r, human.BONE_CALF_L)), 0.0 - 1.0, 1.0)) - knee0
            if since <= 1.6 && knee > out.knee { out.knee = knee }
            if since <= 2.0 {
                i = human.BONE_UPPER_ARM_L
                while i <= human.BONE_LOWER_ARM_R {
                    w = core.v3_len(dynamics.body_get_angular_velocity(human.bone_at(physics.ragdoll_human(r), i).body_id))
                    if w > out.fastest_arm { out.fastest_arm = w }
                    i = i + 1
                }
            }
            if physics.ragdoll_is_aimed(r, human.BONE_UPPER_ARM_L) { out.left_aimed = true }
            if motion.falling(m) || motion.lying(m) { out.fell = true }
        }
        step = step + 1
    }
    free(pose)
    engine.engine_free(e)
    motion.motion_free(m)
    rig_free(rig)
    return out
}

report(name: string, o: Outcome) {
    println("  ${name}: palms at most ${o.left_far} m (left), ${o.right_far} m (right) from the wound 0.6-1.6 s after; chest toward it ${o.fold} m; left knee ${o.knee} rad; fastest arm ${o.fastest_arm} rad/s; left arm aimed ${o.left_aimed}; fell ${o.fell}")
}

main() {
    println("hit reaction: struck by a blow it stands through, beside a twin with the reaction off")
    belly = trial(human.BONE_SPINE_01, 0.12, 0.0 - 0.05, 0.0, 0.0 - 1.0, 25.0, true)
    belly_twin = trial(human.BONE_SPINE_01, 0.12, 0.0 - 0.05, 0.0, 0.0 - 1.0, 25.0, false)
    report("belly", belly)
    report("belly, the twin", belly_twin)
    arm = trial(human.BONE_UPPER_ARM_L, 0.0, 0.06, 0.0 - 1.0, 0.0, 12.0, true)
    arm_twin = trial(human.BONE_UPPER_ARM_L, 0.0, 0.06, 0.0 - 1.0, 0.0, 12.0, false)
    report("left upper arm", arm)
    report("left upper arm, the twin", arm_twin)
    thigh = trial(human.BONE_THIGH_L, 0.09, 0.0, 0.0, 0.0 - 1.0, 25.0, true)
    thigh_twin = trial(human.BONE_THIGH_L, 0.09, 0.0, 0.0, 0.0 - 1.0, 25.0, false)
    report("left thigh", thigh)
    report("left thigh, the twin", thigh_twin)

    check("struck in the belly, the right hand is on the wound from 0.6 s to 1.6 s after, the twin's is not", belly.right_far < REACH && belly_twin.right_far > REACH * 2.0)
    check("and the chest folds toward the wound, more than the twin's", belly.fold > belly_twin.fold + 0.04)
    check("struck on the left upper arm, the right hand goes to it (within ${REACH_ACROSS} m until #700)", arm.right_far < REACH_ACROSS && arm_twin.right_far > REACH_ACROSS * 2.0)
    check("and the struck arm is not aimed", !arm.left_aimed)
    check("struck on the left thigh, the left knee gives, more than the twin's", thigh.knee > thigh_twin.knee + 0.15)
    check("each stands through it", !belly.fell && !arm.fell && !thigh.fell)
    check("no arm bone turns faster than ${ARM_FASTEST} rad/s", belly.fastest_arm < ARM_FASTEST && arm.fastest_arm < ARM_FASTEST && thigh.fastest_arm < ARM_FASTEST)

    if g_failures == 0 {
        println("hit reaction: all checks passed (${g_checks})")
        return
    }
    println("hit reaction: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
