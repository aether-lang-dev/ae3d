// Expressions over a game's objects (#510, ae3d.agentwatch): what the agent
// channel's frame.until and watch ops read. Headless, a scene of objects with
// the engine's own components:
//   - fields read by kind and name, quoted where a name has a space, by an
//     object's name, quoted name or id; positions and their axes;
//   - arithmetic, comparison, '&&', '||', '!' and their precedence;
//   - what is not there (an object, a kind, a field) makes a comparison
//     false and says so, rather than reading 0;
//   - a malformed expression is refused, naming where and what was
//     expected.

import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.components
import ae3d.agentwatch

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

near(a: float, b: float) -> bool {
    d = a - b
    return d < 0.0001 && d > 0.0 - 0.0001
}

// The value of `text` at frame 120, or -12345 when it would not compile.
value(scene: *Scene, text: string) -> float {
    e = agentwatch.compile(text)
    if e == null { return 0.0 - 12345.0 }
    v = agentwatch.evaluate(e, scene, 120)
    agentwatch.expr_free(e)
    return v
}

missing(scene: *Scene, text: string) -> bool {
    e = agentwatch.compile(text)
    if e == null { return false }
    _v = agentwatch.evaluate(e, scene, 120)
    gone = agentwatch.last_missing()
    agentwatch.expr_free(e)
    return gone
}

refused(text: string, wanted: string) -> bool {
    e = agentwatch.compile(text)
    if e != null {
        agentwatch.expr_free(e)
        return false
    }
    println("      '${text}': ${agentwatch.last_error()}")
    return string.contains(agentwatch.last_error(), wanted) == 1
}

main() {
    println("agentwatch: expressions over a game's objects")
    scene = behaviour.scene_new()
    lamp = core.light_point(core.vec3(0.0, 0.0, 0.0), core.vec3(1.0, 0.5, 0.25), 2.0, 40.0)
    holder = behaviour.object_new("Street Lamp")
    behaviour.scene_add(scene, holder)
    lc = components.attach_light(holder, lamp, true)
    lk = components.light_kind()
    component.set_float(lc, component.field_named(lk, "range"), 25.0)
    player = behaviour.object_new("Player")
    behaviour.scene_add(scene, player)
    behaviour.object_set_position(player, core.vec3(3.0, 4.0, 12.0))

    check("a float field, by an object's quoted name and its kind and field", near(value(scene, "'Street Lamp'.Light.range"), 25.0))
    check("with the optional 'object.' head", near(value(scene, "object.'Street Lamp'.Light.range"), 25.0))
    id = behaviour.object_id(holder)
    check("by its id (#${id})", near(value(scene, "#${id}.Light.range"), 25.0))
    check("a colour's axis, and its length with none", near(value(scene, "'Street Lamp'.Light.color.y"), 0.5) &&
          near(value(scene, "'Street Lamp'.Light.color"), 1.145644))
    check("a position's axis", near(value(scene, "Player.position.z"), 12.0) && near(value(scene, "Player.position.x"), 3.0))
    check("a comparison is 1 or 0", near(value(scene, "Player.position.y < 5"), 1.0) && near(value(scene, "Player.position.y >= 5"), 0.0))
    check("frame is the frame it is read at", near(value(scene, "frame"), 120.0) && near(value(scene, "frame > 100 && frame <= 120"), 1.0))
    check("arithmetic before comparison, '&&' before '||'",
          near(value(scene, "Player.position.x * 2 + 1 == 7"), 1.0) && near(value(scene, "0 && 1 || 1"), 1.0) &&
          near(value(scene, "1 || 0 && 0"), 1.0) && near(value(scene, "(1 || 0) && 0"), 0.0))
    check("'!' and '!=' are told apart", near(value(scene, "!0"), 1.0) && near(value(scene, "Player.position.x != 3"), 0.0) &&
          near(value(scene, "-Player.position.x"), 0.0 - 3.0))

    check("an object that is not there reads as missing, not 0", missing(scene, "Ghost.position.x < 1") && near(value(scene, "Ghost.position.x < 1"), 0.0))
    check("nor a kind it does not carry", missing(scene, "Player.Light.range > 0"))
    check("nor a field its kind has not", missing(scene, "'Street Lamp'.Light.colour > 0"))
    check("but '||' with a side that is there and true is true", near(value(scene, "Ghost.position.x > 0 || frame == 120"), 1.0))
    check("and a path that is there is not missing", !missing(scene, "'Street Lamp'.Light.range > 0"))

    check("a comparison with nothing after it is refused, saying where", refused("Player.position.x <", "at 20: expected"))
    check("as is a path with no field", refused("'Street Lamp'.Light < 3", "a field of Light"))
    check("an unknown axis", refused("Player.position.q > 0", "an axis"))
    check("an unclosed quote", refused("'Street Lamp.Light.range", "closing quote"))
    check("and something left over", refused("frame 3", "an operator or the end"))

    // The light is its component's (attach_light's `owns`), freed with it.
    behaviour.scene_free(scene)
    if g_failures == 0 {
        println("agentwatch: all checks passed (${g_checks})")
    } else {
        println("agentwatch: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
