// A motion stepped by the program itself (#699), held to numbers. Three box
// men (ae3d.figure's humanoid fixture, its Idle playing), each in an engine
// of its own and built as a game builds one by hand (physics.ragdoll,
// ragdoll_dress_humanoid, motion.active_ragdoll), POWERED, knocked over
// backwards a second in and left to get up after a second down:
//
//   - one stepped by the engine (motion.attach);
//   - one stepped by the program: motion_step in its fixed_update and
//     motion.pose in its pose phase, after the clip;
//   - one stepped by the program with no pose phase, as a game could only
//     step one before motion.pose was public.
//
// The second rises as the first does: its way up ends on the same step,
// and a second later its pelvis stands where the first's does, to a
// micrometre. Without the pose phase the clip posed over the way up every
// frame and the next step read that back as the animation's pose: the
// third's rise ends elsewhere (printed, not held). On Siltreach's raider,
// in its sword idle, that rise ended leaning and fell again 3.7 s later.
// No window: the engines are stepped by hand.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const STEPS = 900                    // fifteen seconds
const KNOCK_AT = 60
const FELL = 2.9                     // m/s over the whole body, as test_get_up's
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"

const ATTACHED = 0
const POSED = 1
const UNPOSED = 2

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Rise {
    made: bool
    knocked_down: bool               // it went down after the knock
    ended: int                       // the step its way up ended, or -1
    pelvis: Vec3                     // a second after
}

stepped(state: ptr, e: *Engine, step: float) {
    motion.motion_step(state as *Motion, step)
}

posed(state: ptr, e: *Engine) {
    motion.pose(state as *Motion, e)
}

trial(way: int) -> Rise {
    out = Rise { made: false, knocked_down: false, ended: 0 - 1, pelvis: core.vec3(0.0, 0.0, 0.0) }
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", BOXMAN)
    if o == null {
        engine.engine_free(e)
        figure.figures_free(e)
        return out
    }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    r = physics.ragdoll(e, "BoxMan", group.world_position, 8.0, 8.0, 1.0)
    m = null as *Motion
    if physics.ragdoll_dress_humanoid(r, figure.skeleton(f)) { m = motion.active_ragdoll(r) }
    if m == null {
        engine.engine_free(e)
        figure.figures_free(e)
        return out
    }
    out.made = true
    if way == ATTACHED {
        motion.attach(e, m)
    } else {
        b = engine.behaviour_new("game's motion", m as ptr)
        b.fixed_update = stepped
        if way == POSED { b.pose = posed }
        engine.engine_add_behaviour(e, b)
    }
    motion.set_mode(m, motion.POWERED)
    motion.set_get_up(m, 1.0)
    was_up = false
    step = 0
    while step < STEPS {
        if step == KNOCK_AT {
            chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
            motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - FELL * physics.ragdoll_mass(r)))
        }
        engine.engine_update(e, STEP)
        if motion.lying(m) { out.knocked_down = true }
        up_now = motion.getting_up(m)
        if was_up && !up_now && out.ended < 0 { out.ended = step }
        was_up = up_now
        if out.ended >= 0 && step == out.ended + 60 {
            out.pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
        }
        step = step + 1
    }
    engine.engine_free(e)
    motion.motion_free(m)
    figure.figures_free(e)
    return out
}

main() {
    println("motion stepped: the box man knocked down and getting up, stepped by the engine and by the program")
    attached = trial(ATTACHED)
    by_hand = trial(POSED)
    unposed = trial(UNPOSED)
    gap = core.v3_len(core.v3_sub(attached.pelvis, by_hand.pelvis))
    println("  the way up ended at step ${attached.ended} attached, ${by_hand.ended} stepped by hand with motion.pose, ${unposed.ended} without it")
    println("  a second later the pelvis ${gap * 1000000.0} micrometres from the attached one's; without the pose phase ${core.v3_len(core.v3_sub(attached.pelvis, unposed.pelvis)) * 1000.0} mm")
    check("each is built, knocked down and gets up", attached.made && by_hand.made && attached.knocked_down && by_hand.knocked_down &&
          attached.ended > 0 && by_hand.ended > 0)
    check("stepped by hand with motion.pose, its way up ends on the attached one's step (#699)", by_hand.ended == attached.ended)
    check("and a second later its pelvis stands where the attached one's does, to a micrometre (#699)", gap < 0.000001)
    if g_failures == 0 {
        println("motion stepped: all checks passed (${g_checks})")
    } else {
        println("motion stepped: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
