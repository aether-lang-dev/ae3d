// What a blow costs a figure's balance (#595), held to numbers. POWERED
// figures standing on their own, each in an engine of its own, struck from
// the side a second in; no window.
//
//   - a tap on the hip (0.04 m/s, the speed the blow gives the whole body,
//     #626) leaves the balance assist nearly whole, where
//     every blow to the pelvis left 5% of it;
//   - a tap on the hip before a chest shove the figure stands through on its
//     own changes nothing: it still stands, leaning as far as without it;
//   - a heavy blow to the hip (0.6 m/s) costs more than a tap;
//   - a bullet in the arm (8 N s) still takes the arm's muscle (test_motion).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

struct Outcome {
    full: float                      // the balance assist before it
    assist: float                    // the balance assist just after the blow
    tilt: float                      // the most it leaned after
    fell: bool
}

// One figure: a blow from the side on `bone` (0 for none) after 1 s, and a
// shove at the chest from behind 0.1 s later (0 for none), each as the
// speed it gives the whole body; 4 s on.
trial(bone: int, impulse: float, shove: float) -> Outcome {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig()
    physics.ragdoll_dress(r, rig)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    out = Outcome { full: 0.0, assist: 0.0, tilt: 0.0, fell: false }
    step = 0
    while step < 300 {
        engine.engine_update(e, STEP)
        if step == 60 {
            out.full = physics.ragdoll_balance_assist(r)
            out.assist = out.full
        }
        if step == 60 && impulse > 0.0 {
            at = physics.ragdoll_center_of_mass(r)
            if bone == human.BONE_SPINE_03 { at = core.vec3(at.x, at.y + 0.35, at.z) }
            motion.hit(m, bone, at, core.vec3(impulse * physics.ragdoll_mass(r), 0.0, 0.0))
            out.assist = physics.ragdoll_balance_assist(r)
        }
        if step == 66 && shove > 0.0 {
            c = physics.ragdoll_center_of_mass(r)
            motion.hit(m, human.BONE_SPINE_03, core.vec3(c.x, c.y + 0.35, c.z), core.vec3(0.0, 0.0, shove * physics.ragdoll_mass(r)))
        }
        if step > 60 {
            t = motion.tilt(m)
            if t > out.tilt { out.tilt = t }
            if motion.falling(m) || motion.lying(m) { out.fell = true }
        }
        step = step + 1
    }
    engine.engine_free(e)
    motion.motion_free(m)
    rig_free(rig)
    return out
}

main() {
    println("blows: what a blow costs the balance (#595)")
    tap = trial(human.BONE_PELVIS, 0.04, 0.0)
    heavy = trial(human.BONE_PELVIS, 0.6, 0.0)
    alone = trial(0, 0.0, 0.6)
    tapped = trial(human.BONE_PELVIS, 0.04, 0.6)
    full = tap.full
    println("  a 0.04 m/s tap on the hip leaves ${tap.assist} of ${full} N m of balance; a 0.6 m/s blow ${heavy.assist}")
    println("  a 0.6 m/s chest shove alone: tilt ${alone.tilt}, fell ${alone.fell}; after a tap on the hip: tilt ${tapped.tilt}, fell ${tapped.fell}")
    check("a tap on the hip leaves the balance nearly whole (over 90%)", tap.assist > full * 0.9)
    check("a heavy blow to the hip costs more than a tap", heavy.assist < tap.assist)
    check("a tap on the hip before a shove the figure stands through changes nothing: it stands, leaning no further (within 0.05 rad)",
          !alone.fell && !tapped.fell && tapped.tilt < alone.tilt + 0.05)
    if g_failures == 0 {
        println("blows: all checks passed (${g_checks})")
        return
    }
    println("blows: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
