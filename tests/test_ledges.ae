// ci: optimised -- walks of the mannequin with physics, CPU work -O0 makes several times slower
// People kept to the ground they walk on (#981), held to numbers. In the
// people plaza runners curving round to goals behind them ran over its
// floor's edge, fell still playing a run, and a foot turned 70 rad/s. The
// UE5 mannequin on 100STYLE's neutral gaits (ae3d.character), its capsule on
// a 6 m square platform (top at y 0, x and z -3 to 3) with physics, the
// ground 4 m under it, and for the kerb's walk a lower floor beside it 0.2 m
// down past x 3 (a kerb, not a ledge):
//
//   - a walker asked straight at the platform's edge stops short of it,
//     standing, its axis no nearer than its capsule's radius;
//   - a runner asked at a corner, 45 degrees, never leaves the platform;
//   - a walker sent to goals near the edge and past it (and past a corner)
//     never leaves the platform;
//   - a runner turned round to a goal behind it near the edge (the plaza's
//     case: its curve is wide) never leaves the platform;
//   - a walker asked over the kerb steps down it and walks on: a step
//     down within its step height is no ledge;
//   - a walker let over ledges (character.set_ledges) walks off the edge;
//   - a goal past the edge is brought onto the platform, its capsule's
//     radius in from the edge (character.project_goal); one on it is kept.
//
// The walks' looks are measured and printed each run, and held with
// AE3D_LEDGES_ALL=1 (#981, not met yet), as test_character_walls holds a
// walk against a wall: no foot crossing the hips' middle by 5 mm (metrics
// FEET_CROSS), no toe over the ground 1.5 m/s faster than its clip has it
// (FOOT_THROW), no joint turning faster than the gaits' own fastest and a
// fifth (POP). Met by the walker stopping short of the edge (15.5 rad/s, a
// toe 1.26 m/s); not by a stop entered from a slow curve (a toe 3.9 m/s), a
// walker slid along an edge as along a wall (feet crossed 31 mm), a runner
// slowing to a stop at a corner (feet crossed 5.3 mm), nor by the corner's
// run on open ground too (18.3 rad/s), nor the kerb's step down (19 rad/s). No
// window; the engine stepped by hand at 60 Hz. AE3D_LEDGES_OPEN=1 walks the
// same on open ground; AE3D_LEDGES_TRACE=n traces the nth walk.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const METER_FROM = 30
const CROSS_MOST = 0.005
const EASING = 1.2
const THROW_MOST = 1.5
const EDGE = 3.0                       // the platform's half width
const RADIUS = 0.3                     // the character's capsule's
const SLACK = 0.01                     // metres the axis may be nearer the edge than its radius
const ARRIVED = 0.6

var g_checks = 0
var g_failures = 0
var g_walks = 0

check(what: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${what}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${what}")
    }
}

solid(e: *Engine, name: string, at: Vec3, half: Vec3) {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

struct Walk {
    engine: ptr
    person: ptr                        // *Character
    meter: ptr                         // *Meter
    own: float                         // the gaits' own fastest joint
    nearest: float                     // metres its axis came to the platform's edges (x -3, z -3 and 3), at least
    lowest: float                      // its feet's lowest height
    steps: int
}

// The world and a walker standing at `from`, facing `facing`.
walk_new(g: *Gaits, from: Vec3, facing: Vec3, kerb: bool) -> *Walk {
    g_walks = g_walks + 1
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    // AE3D_LEDGES_OPEN=1: the platform 30 m across, the same walks with no
    // edge near, to tell the edge's share of a number from the walk's.
    half = EDGE
    if core.env_int("AE3D_LEDGES_OPEN", 0) == 1 { half = 30.0 }
    solid(e, "Platform", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(half, 0.5, half))
    if kerb { solid(e, "Below", core.vec3(5.5, 0.0 - 0.7, 0.0), core.vec3(2.5, 0.5, EDGE)) }
    solid(e, "Ground", core.vec3(0.0, 0.0 - 4.5, 0.0), core.vec3(30.0, 0.5, 30.0))
    engine.engine_update(e, STEP)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    behaviour.object_set_position(o, from)
    behaviour.object_set_rotation(o, core.quat_rotate(core.atan2_of(facing.x, facing.z), core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    a = character.animator_of(c)
    m = metrics.meter_new(animator.rig(a), o)
    metrics.meter_ground_physics(m, physics.of(e))
    metrics.meter_animator(m, a)
    w = heap.new(Walk)
    w.engine = e as ptr
    w.person = c as ptr
    w.meter = m as ptr
    w.own = metrics.animator_fastest(a)
    w.nearest = 1000.0
    w.lowest = 1000.0
    return w
}

// One step asked `asked`, measured.
walk_step(w: *Walk, asked: Vec3) {
    c = w.person as *Character
    character.move(c, asked, core.vec3(0.0, 0.0, 0.0))
    engine.engine_update(w.engine as *Engine, STEP)
    m = w.meter as *Meter
    if w.steps == METER_FROM { metrics.meter_reset(m) }
    metrics.meter_take(m, STEP)
    at = behaviour.object_position(character.object_of(c))
    // The platform's edges, x and z -3 and 3.
    near = at.x + EDGE
    if EDGE - at.x < near { near = EDGE - at.x }
    if EDGE - at.z < near { near = EDGE - at.z }
    if at.z + EDGE < near { near = at.z + EDGE }
    if near < w.nearest { w.nearest = near }
    if at.y < w.lowest { w.lowest = at.y }
    // AE3D_LEDGES_TRACE=n: the nth walk (from 1), each step.
    if core.env_int("AE3D_LEDGES_TRACE", 0) == g_walks {
        v = mover.velocity(character.mover_of(c))
        a = character.animator_of(c)
        println("    ${w.steps}: at ${at.x} ${at.y} ${at.z} velocity ${v.x} ${v.z} turn ${metrics.meter_last(m, metrics.POP)} state ${animator.state_name(a, animator.current(a))}")
    }
    w.steps = w.steps + 1
}

walk_at(w: *Walk) -> Vec3 { return behaviour.object_position(character.object_of(w.person as *Character)) }
walk_speed(w: *Walk) -> float { return core.v3_len(mover.velocity(character.mover_of(w.person as *Character))) }

// Held as a walk is, and freed.
walk_end(w: *Walk, name: string) {
    c = w.person as *Character
    m = w.meter as *Meter
    a = character.animator_of(c)
    cross = metrics.meter_worst(m, metrics.FEET_CROSS)
    pop = metrics.meter_worst(m, metrics.POP)
    thrown = metrics.meter_worst(m, metrics.FOOT_THROW)
    joint = "none"
    if metrics.meter_joint(m, metrics.POP) >= 0 { joint = pose.name(animator.rig(a), metrics.meter_joint(m, metrics.POP)) }
    println("  ${name}: a foot ${cross * 1000.0} mm past the hips' middle at most (${metrics.meter_when(m, metrics.FEET_CROSS)} s), the fastest joint ${pop} rad/s (${joint} at ${metrics.meter_when(m, metrics.POP)} s; the gaits' own ${w.own}), a toe thrown ${thrown} m/s past its clip (${metrics.meter_when(m, metrics.FOOT_THROW)} s)")
    if core.env_int("AE3D_LEDGES_ALL", 0) == 1 {
        check("${name}: no foot crosses the hips' middle by 5 mm", cross < CROSS_MOST)
        check("${name}: no joint past the gaits' own fastest and a fifth", pop <= w.own * EASING)
        check("${name}: no toe thrown 1.5 m/s past its clip", thrown < THROW_MOST)
    }
    walk_free(w)
}

walk_free(w: *Walk) {
    metrics.meter_free(w.meter as *Meter)
    character.character_free(w.person as *Character)
    e = w.engine as *Engine
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    heap.free(w)
}

kept_on(w: *Walk, name: string) {
    println("  ${name}: its axis ${w.nearest} m from the edge at the nearest, its feet ${w.lowest} m up at the lowest")
    check("${name}: never leaves the platform", w.lowest > 0.0 - 0.01 && w.nearest > RADIUS - SLACK)
}

// Straight at the +z edge from 2 m in, at a walk, for 5 s.
straight_at(g: *Gaits) {
    w = walk_new(g, core.vec3(0.0, 0.0, 0.0 - 1.0), core.vec3(0.0, 0.0, 1.0), false)
    k = 0
    while k < 300 {
        walk_step(w, core.vec3(0.0, 0.0, 1.2))
        k = k + 1
    }
    at = walk_at(w)
    kept_on(w, "a walker asked straight at the edge")
    println("    it stands ${EDGE - at.z} m from the edge going ${walk_speed(w)} m/s")
    check("a walker asked straight at the edge: stops short of it, within 1.5 m", walk_speed(w) < mover.MOVING && EDGE - at.z < 1.5)
    walk_end(w, "a walker asked straight at the edge")
}

// At the -x, +z corner at a run, for 5 s.
run_at_corner(g: *Gaits) {
    w = walk_new(g, core.vec3(1.0, 0.0, 0.0 - 1.0), core.vec3(0.0 - 1.0, 0.0, 1.0), false)
    k = 0
    while k < 300 {
        walk_step(w, core.vec3(0.0 - 1.84, 0.0, 1.84))
        k = k + 1
    }
    kept_on(w, "a runner asked at a corner")
    walk_end(w, "a runner asked at a corner")
}

// Goals near the edge and past it, each kept until reached or 6 s.
errands(g: *Gaits) {
    w = walk_new(g, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 1.0), false)
    goals =[2.4, 2.4, 0.0, 4.5, 0.0 - 4.0, 0.0, 0.0 - 2.4, 0.0 - 2.4, 0.0 - 5.0, 5.0, 1.0, 0.0 - 2.6, 0.0, 0.0]
    i = 0
    while i < 7 {
        k = 0
        while k < 360 {
            at = walk_at(w)
            to = core.vec3(goals[i * 2] - at.x, 0.0, goals[i * 2 + 1] - at.z)
            if core.v3_len(to) < ARRIVED { break }
            walk_step(w, core.v3_mul(core.v3_normalize(to), 1.2))
            k = k + 1
        }
        i = i + 1
    }
    kept_on(w, "a walker sent near the edge and past it")
    walk_end(w, "a walker sent near the edge and past it")
}

// Running +z, then asked to a goal behind it, near the edge: its curve is
// wide (#973), and carried it over the plaza's floor's edge.
turned_round(g: *Gaits) {
    w = walk_new(g, core.vec3(0.0, 0.0, 0.0 - 2.5), core.vec3(0.0, 0.0, 1.0), false)
    k = 0
    while k < 420 {
        at = walk_at(w)
        asked = core.vec3(0.0, 0.0, 2.6)
        if k >= 70 {
            to = core.vec3(0.0 - 0.5 - at.x, 0.0, 0.0 - 2.0 - at.z)
            asked = core.v3_mul(core.v3_normalize(to), 2.6)
            if core.v3_len(to) < ARRIVED { asked = core.vec3(0.0, 0.0, 0.0) }
        }
        walk_step(w, asked)
        k = k + 1
    }
    kept_on(w, "a runner turned round to a goal behind it")
    walk_end(w, "a runner turned round to a goal behind it")
}

// Over the kerb at x 3, 0.2 m down, at a walk, for 4 s.
over_kerb(g: *Gaits) {
    w = walk_new(g, core.vec3(1.0, 0.0, 0.0), core.vec3(1.0, 0.0, 0.0), true)
    k = 0
    while k < 240 {
        walk_step(w, core.vec3(1.2, 0.0, 0.0))
        k = k + 1
    }
    at = walk_at(w)
    println("  a walker over a 0.2 m kerb: at x ${at.x}, its feet ${at.y} m up")
    check("a walker over a 0.2 m kerb: steps down it and walks on", at.x > 4.5 && at.y < 0.0 - 0.19 && at.y > 0.0 - 0.21)
    walk_end(w, "a walker over a 0.2 m kerb")
}

// Let over ledges: off the +z edge it goes.
let_over(g: *Gaits) {
    w = walk_new(g, core.vec3(0.0, 0.0, 1.0), core.vec3(0.0, 0.0, 1.0), false)
    character.set_ledges(w.person as *Character, true)
    k = 0
    while k < 240 {
        walk_step(w, core.vec3(0.0, 0.0, 1.2))
        k = k + 1
    }
    println("  a walker let over ledges: its feet ${w.lowest} m up at the lowest")
    check("a walker let over ledges: walks off the edge", w.lowest < 0.0 - 1.0)
    walk_free(w)
}

// Goals brought onto the platform.
projected(g: *Gaits) {
    w = walk_new(g, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 1.0), true)
    c = w.person as *Character
    ok, past = character.project_goal(c, core.vec3(0.5, 0.0, 4.5), 3.0)
    println("  a goal 1.5 m past the edge: brought to ${past.x} ${past.y} ${past.z}")
    check("a goal past the edge: brought onto the platform, its radius in from the edge", ok && core.abs_of(past.z - (EDGE - RADIUS)) < 0.02 && core.abs_of(past.x - 0.5) < 0.02 && core.abs_of(past.y) < 0.001)
    ok_on, on = character.project_goal(c, core.vec3(1.0, 0.0, 0.0 - 1.0), 3.0)
    check("a goal on the platform: kept", ok_on && core.abs_of(on.x - 1.0) < 0.0001 && core.abs_of(on.z + 1.0) < 0.0001)
    ok_far, _far = character.project_goal(c, core.vec3(0.0 - 20.0, 3.0, 0.0), 2.0)
    check("a goal nowhere near ground: none", !ok_far)
    walk_free(w)
}

main() {
    println("ledges: people kept to the ground they walk on (#981)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    straight_at(g)
    run_at_corner(g)
    errands(g)
    turned_round(g)
    over_kerb(g)
    let_over(g)
    projected(g)
    character.gaits_free(g)
    if g_failures == 0 {
        println("ledges: all checks passed (${g_checks})")
        return
    }
    println("ledges: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
