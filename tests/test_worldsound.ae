// The world's sounds (#566), held to numbers through a headless mix and an
// engine stepped by hand at 60 Hz:
//
//   - the rain's volume is the rain's intensity, nothing when it clears;
//     the wind's the wind's speed over 25 m/s;
//   - thunder: a storm's flash is heard after the strike's distance over
//     the speed of sound, to within a frame, louder the nearer;
//   - a car's engine pitch rises with its speed, as 0.8 + 0.05 v;
//   - hits: crates dropped on the ground start hit sounds where they land,
//     never more than MAX_HITS in a frame, the hardest the loudest;
//   - the sounds are made, not read: the mix has the rain in it.

import std.audio as mix
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.weather
import ae3d.audio
import ae3d.worldsound

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
    fflush(null)
}

near(a: float, b: float, tolerance: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tolerance
}

frame(e: *Engine) {
    engine.engine_update(e, STEP)
    mix.render(worldsound.RATE / 60)
}

wheel(e: *Engine, name: string, position: Vec3) -> *GameObject {
    w = engine.object(e, name, loader.sphere(0.35, 10, 6))
    behaviour.object_set_position(w, position)
    physics.rigidbody(w, physics.DYNAMIC)
    physics.sphere_collider(w, 0.35, physics.material(1.0, 0.0), 250.0)
    return w
}

main() {
    println("worldsound: the weather, a car and hits, heard (#566)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    light = core.light_sun(core.vec3(0.3, 0.9, 0.2))
    engine.engine_set_light(e, light)
    a = audio.attach_headless(e, worldsound.RATE)
    if !audio.headless(a) {
        println("worldsound: SKIP the mix could not be opened headless")
        engine.engine_free(e)
        core.light_free(light)
        return
    }
    physics.attach(e)
    ws = worldsound.attach(e)
    head = engine.object(e, "listener", null)
    audio.set_listener(e, head)
    w = weather.weather_new(e)
    worldsound.follow_weather(ws, w)

    // Rain and wind.
    weather.weather_set(w, weather.RAIN, 0.5)
    weather.weather_set_wind(w, core.vec3(1.0, 0.0, 0.0), 10.0)
    frame(e)
    frame(e)
    rain = audio.gain(worldsound.rain_source(ws))
    wind = audio.gain(worldsound.wind_source(ws))
    heard = mix.rendered_peak(0)
    weather.weather_set(w, weather.CLEAR, 0.0)
    frame(e)
    frame(e)
    cleared = audio.gain(worldsound.rain_source(ws))
    calm = audio.gain(worldsound.wind_source(ws))
    println("  rain at 0.5: gain ${rain}; wind at 10 m/s: ${wind}; the mix's peak ${heard}; cleared: ${cleared}, ${calm}")
    check("the rain's volume is its intensity, and nothing when it clears", near(rain, 0.5, 0.0001) && cleared == 0.0)
    check("the wind's is its speed over 25 m/s", near(wind, 0.4, 0.0001) && calm == 0.0)
    check("the sounds are made, not read: the rain is in the mix", heard > 0.05)

    // Thunder.
    weather.weather_set(w, weather.STORM, 1.0)
    flashes = weather.weather_flash_count(w)
    seconds = 0.0
    k = 0
    while weather.weather_flash_count(w) == flashes && k < 1200 {
        frame(e)
        seconds = seconds + STEP
        k = k + 1
    }
    distance = weather.weather_strike_distance(w)
    struck_at = seconds
    // Cleared at once, so no later, nearer strike is heard first.
    weather.weather_set(w, weather.CLEAR, 0.0)
    started = worldsound.thunder_started(ws)
    k = 0
    while worldsound.thunder_started(ws) == started && k < 2400 {
        frame(e)
        seconds = seconds + STEP
        k = k + 1
    }
    delay = seconds - struck_at
    want = distance / audio.SPEED_OF_SOUND
    println("  a flash ${distance} m off: its thunder heard ${delay} s after it (${want} s by the speed of sound)")
    check("thunder is heard the strike's distance over the speed of sound after its flash, to within a frame",
          worldsound.thunder_started(ws) == started + 1 && near(delay, want, STEP * 1.5))

    // A car.
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(200.0, 0.5, 200.0), physics.material(0.8, 0.0))
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(1.6, 0.5, 3.6))
    behaviour.object_set_position(car, core.vec3(0.0, 0.7, 20.0))
    physics.rigidbody(car, physics.DYNAMIC)
    physics.box_collider(car, core.vec3(0.8, 0.25, 1.8), physics.material(0.5, 0.0), 250.0)
    wheels_block = calloc(physics.WHEEL_COUNT, 8)
    wheels = wheels_block as ptr[]
    mounts_block = calloc(physics.WHEEL_COUNT, sizeof(Vec3))
    mounts = mounts_block as Vec3[]
    mounts[0] = core.vec3(0.0 - 0.9, 0.0 - 0.35, 0.0 - 1.2)
    mounts[1] = core.vec3(0.9, 0.0 - 0.35, 0.0 - 1.2)
    mounts[2] = core.vec3(0.0 - 0.9, 0.0 - 0.35, 1.2)
    mounts[3] = core.vec3(0.9, 0.0 - 0.35, 1.2)
    i = 0
    while i < physics.WHEEL_COUNT {
        wheels[i] = wheel(e, "Wheel ${i}", core.v3_add(core.vec3(0.0, 0.7, 20.0), mounts[i])) as ptr
        i = i + 1
    }
    v = physics.vehicle(car, wheels_block, mounts_block, 3.0, 0.8, 0.12, 600.0, 30.0, 0.5)
    engine_sound = worldsound.car(ws, v)
    // The engine's own pitch, without the Doppler shift of a car driving
    // past the listener.
    audio.set_doppler(engine_sound, 0.0)
    frame(e)
    idle = audio.gain(engine_sound)
    idle_pitch = engine_pitch(engine_sound)
    k = 0
    while k < 180 {
        physics.vehicle_drive(v, 1.0, 0.0, 0.0)
        frame(e)
        k = k + 1
    }
    speed = physics.vehicle_speed(v)
    driven = engine_pitch(engine_sound)
    println("  the engine: pitch ${idle_pitch} standing, ${driven} at ${speed} m/s (0.8 + 0.05 v: ${0.8 + 0.05 * speed})")
    check("a car's engine pitch rises with its speed, as 0.8 + 0.05 v", near(idle_pitch, 0.8, 0.01) && speed > 3.0 &&
          near(driven, 0.8 + 0.05 * speed, 0.02) && idle > 0.0)

    // Hits: twelve crates dropped from different heights onto the ground.
    worldsound.hits(ws, true)
    crates = calloc(12, 8)
    i = 0
    while i < 12 {
        c = engine.object(e, "Crate ${i}", loader.cube(1.0))
        behaviour.object_set_position(c, core.vec3((i % 4) as float * 3.0 - 4.5, 1.0 + (i as float) * 0.15, 0.0 - 6.0 - (i / 4) as float * 3.0))
        rb = physics.rigidbody(c, physics.DYNAMIC)
        physics.box_collider(c, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0), 100.0)
        physics.rigidbody_enable_hit_events(rb, true)
        (crates as ptr[])[i] = c as ptr
        i = i + 1
    }
    most_in_a_frame = 0
    total_before = worldsound.hits_started(ws)
    k = 0
    while k < 120 {
        before = worldsound.hits_started(ws)
        frame(e)
        this_frame = worldsound.hits_started(ws) - before
        if this_frame > most_in_a_frame { most_in_a_frame = this_frame }
        k = k + 1
    }
    total = worldsound.hits_started(ws) - total_before
    println("  twelve crates dropped: ${total} hits heard, at most ${most_in_a_frame} in a frame (${worldsound.MAX_HITS} allowed)")
    check("crates striking the ground are heard, never more than MAX_HITS a frame", total >= 4 && most_in_a_frame <= worldsound.MAX_HITS && most_in_a_frame >= 1)

    free(crates)
    free(wheels_block)
    free(mounts_block)
    physics.vehicle_free(v)
    weather.weather_free(w)
    engine.engine_free(e)
    core.light_free(light)
    if g_failures == 0 {
        println("worldsound: all checks passed (${g_checks})")
    } else {
        println("worldsound: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}

engine_pitch(s: *AudioSource) -> float { return audio.pitch(s) }
