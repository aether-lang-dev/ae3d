// Takes shared by every character of one figure on one set of gaits (#944,
// ae3d.character): 20 UE5 mannequins made on 100STYLE's neutral gaits. Each
// read and retargeted every capture again, a camp of 20 settlers 20 times.
// No window; stepped at 60 Hz.
//
//   - every character's stand, gaits, starts and stops play the same takes
//     as the first one's (made once, shared);
//   - the first and the twentieth, asked alike, walk alike: every drawn bone
//     turned within 1e-6 rad of the other's through 3 s;
//   - and the twentieth walks on alike with the eighteenth once the first is
//     freed (the takes are the gaits', not the first character's).

import std.os
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.character

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const PEOPLE = 20

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The largest turn between two characters' drawn poses, radians.
apart(a: *Character, b: *Character) -> float {
    ra = animator.rig(character.animator_of(a))
    pa = animator.pose_now(character.animator_of(a))
    pb = animator.pose_now(character.animator_of(b))
    most = 0.0
    j = 0
    while j < pose.count(ra) {
        p = pose.rotation(pa, j)
        q = pose.rotation(pb, j)
        d = core.abs_of(p.x * q.x + p.y * q.y + p.z * q.z + p.w * q.w)
        if d > 1.0 { d = 1.0 }
        t = 2.0 * core.acos_of(d)
        if t > most { most = t }
        j = j + 1
    }
    return most
}

main() {
    println("character_share: takes shared by every character of one figure (#944)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    people = calloc(PEOPLE, 8) as ptr[]
    first_ms = 0.0
    rest_ms = 0.0
    k = 0
    while k < PEOPLE {
        began = os.now_monotonic_ns()
        c = character.humanoid(e, "Settler", MANNEQUIN, g)
        took = ((os.now_monotonic_ns() - began) as float) / 1000000.0
        if c == null {
            println("  no settler: ${character.error()}")
            exit(1)
        }
        if k == 0 { first_ms = took } else { rest_ms = rest_ms + took }
        behaviour.object_set_position(character.object_of(c), core.vec3((k as float) * 2.0, 0.0, 0.0))
        people[k] = c as ptr
        k = k + 1
    }
    println("  the first made in ${first_ms} ms, the other ${PEOPLE - 1} in ${rest_ms / ((PEOPLE - 1) as float)} ms each")
    first = people[0] as *Character
    last = people[PEOPLE - 1] as *Character
    fa = character.animator_of(first)
    same = true
    k = 1
    while k < PEOPLE {
        a = character.animator_of(people[k] as *Character)
        states = [character.idle_state(first), character.move_state(first)]
        s = 0
        while s < 2 {
            if animator.state_take(a, states[s]) != animator.state_take(fa, states[s]) { same = false }
            s = s + 1
        }
        k = k + 1
    }
    check("every character plays the first one's takes (made once, shared)", same)
    ahead = core.vec3(0.0, 0.0, 1.2)
    still = core.vec3(0.0, 0.0, 0.0)
    worst = 0.0
    k = 0
    while k < 180 {
        i = 0
        while i < PEOPLE {
            character.move(people[i] as *Character, ahead, still)
            i = i + 1
        }
        engine.engine_update(e, STEP)
        d = apart(first, last)
        if d > worst { worst = d }
        k = k + 1
    }
    println("  the first and the last asked alike for 3 s: every drawn bone within ${worst} rad of the other's")
    check("the first and the twentieth, asked alike, walk alike (every bone within 1e-6 rad)", worst < 0.000001)
    character.character_free(first)
    people[0] = null
    after = 0.0
    other = people[PEOPLE - 3] as *Character
    k = 0
    while k < 120 {
        i = 1
        while i < PEOPLE {
            character.move(people[i] as *Character, still, still)
            i = i + 1
        }
        engine.engine_update(e, STEP)
        d = apart(other, last)
        if d > after { after = d }
        k = k + 1
    }
    println("  the first freed, the eighteenth and the twentieth stopping alike for 2 s: within ${after} rad")
    check("with the first freed, the others walk on alike on its takes (the gaits')", after < 0.000001)
    k = 1
    while k < PEOPLE {
        character.character_free(people[k] as *Character)
        k = k + 1
    }
    free(people as ptr)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("character_share: all checks passed (${g_checks})")
        return
    }
    println("character_share: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
