// A character's reach cast from a point it does not stand at (#957,
// physics.character_reach_from), held to numbers: a 0.3 m capsule 1.8 m
// tall on a floor, a wall across its way and two other solid characters
// near it, its reach from points ahead of where it stands against its
// reach once stood there. A game's path search casts from the points it
// plans through; with aephysics' cast alone it missed the solid
// characters, which a move meets. No window: the engine is stepped by hand.
//
//   - from points before the wall, between and beside the other two, and
//     across where it stands now, character_reach_from gives what
//     character_reach gives with the capsule stood there (within 1e-6 m);
//   - in the open it reaches the whole offset;
//   - toward a solid character it stops short of it, the two capsules'
//     radii apart.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

character(e: *Engine, name: string, at: Vec3) -> *CharacterController {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    c = physics.character_controller(o, 0.3, 1.8)
    physics.character_set_solid(c, true)
    return c
}

block(e: *Engine, name: string, at: Vec3, half: Vec3) {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

main() {
    println("character_reach: a capsule's reach cast from a point (#957)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    block(e, "Floor", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(30.0, 0.5, 30.0))
    // A wall across x = 4, 0.2 m thick and 2 m high.
    block(e, "Wall", core.vec3(4.1, 1.0, 0.0), core.vec3(0.1, 1.0, 10.0))
    c = character(e, "Walker", core.vec3(0.0, 0.0, 0.0))
    a = character(e, "Left", core.vec3(1.5, 0.0, 2.0))
    b = character(e, "Right", core.vec3(2.7, 0.0, 2.0))
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    o = c.object as *GameObject
    home = behaviour.object_position(o)
    lift = home.y - physics.character_feet(c).y
    // From each point, each way: before the wall, between the two and beside
    // them, back across where it stands.
    froms = [core.vec3(2.0, 0.0, 0.0), core.vec3(3.0, 0.0, 1.0), core.vec3(2.1, 0.0, 0.0 - 0.5), core.vec3(0.5, 0.0, 2.0), core.vec3(1.0, 0.0, 0.0)]
    ways = [core.vec3(3.0, 0.0, 0.0), core.vec3(0.0, 0.0, 3.0), core.vec3(2.0, 0.0, 2.0), core.vec3(0.0 - 2.0, 0.0, 0.0)]
    worst = 0.0
    shortened = 0
    i = 0
    while i < 5 {
        j = 0
        while j < 4 {
            feet = core.vec3(froms[i].x, physics.character_feet(c).y, froms[i].z)
            planned = physics.character_reach_from(c, feet, ways[j])
            behaviour.object_set_position(o, core.vec3(feet.x, feet.y + lift, feet.z))
            stood = physics.character_reach(c, ways[j])
            behaviour.object_set_position(o, home)
            off = core.v3_len(core.v3_sub(planned, stood))
            if off > worst { worst = off }
            if core.v3_len(stood) < core.v3_len(ways[j]) - 0.000001 { shortened = shortened + 1 }
            j = j + 1
        }
        i = i + 1
    }
    println("  20 casts from five points: at most ${worst} m off the reach stood there, ${shortened} of them shortened by the wall or a character")
    check("from a point, it reaches what it reaches stood there (within 1e-6 m), the wall and the solid characters met alike", worst < 0.000001 && shortened >= 6)
    open = physics.character_reach_from(c, core.vec3(0.0, physics.character_feet(c).y, 0.0 - 6.0), core.vec3(0.0, 0.0, 0.0 - 3.0))
    check("in the open it reaches the whole offset", core.abs_of(core.v3_len(open) - 3.0) < 0.000001)
    // Straight at Left from 2 m short of it: stopped its radius and Left's off.
    toward = physics.character_reach_from(c, core.vec3(1.5, physics.character_feet(c).y, 0.0), core.vec3(0.0, 0.0, 3.0))
    gap = 2.0 - core.v3_len(toward)
    println("  straight at a solid character 2 m off: it reaches ${core.v3_len(toward)} m, stopped ${gap} m from it (the radii 0.6)")
    check("toward a solid character it stops the two radii short of it", core.abs_of(gap - 0.6) < 0.001)
    physics.character_free(c)
    physics.character_free(a)
    physics.character_free(b)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    if g_failures == 0 {
        println("character_reach: all checks passed (${g_checks})")
        return
    }
    println("character_reach: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
