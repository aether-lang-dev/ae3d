// A fast car striking a figure meets its limbs at their surface
// (aephysics#173), held to numbers. A 1.2 t box driven at 7 m/s, 11.7 cm a
// step, into the box man standing POWERED, side on; no window, the engine
// stepped by hand, with the world's travel speculation
// (physics_set_travel_speculation) and without, over 15 strikes (6, 7 and
// 8 m/s, the car 0.15 m apart across five lines):
//
//   - with it, a limb goes into the car under 70% as deep as without on
//     average (3.8 cm against 6.8), and never 5 cm: the contacts reach out
//     over the step's travel, so a limb is brought up to speed as the gap
//     closes. Some of a step's depth stays where the limb's joints hold it
//     back against the push (a free body comes in under 1 cm: aephysics'
//     own test); in the plaza, 86% of the seconds in the car go;
//   - without it, Box3D's 2 cm of speculation finds a limb several
//     centimetres inside on the strike's first frame, what the plaza's
//     struck walkers showed for 5 to 7 frames a strike.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human
import aephysics.dynamics
import aephysics.math

extern exit(code: int)
extern sqrt(x: float) -> float

const STEP = 0.016666666666666666
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"
const HALF_X = 0.9                    // the car's half width across the strike
const HALF_Y = 0.55
const HALF_Z = 2.0
const SPEED = 7.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// How far a point is inside the car's box (negative outside), in its frame.
inside_box(car: Transform, p: Vec3) -> float {
    q = math.inv_transform_point(car, p)
    dx = core.abs_of(q.x) - HALF_X
    dy = core.abs_of(q.y) - HALF_Y
    dz = core.abs_of(q.z) - HALF_Z
    most = dx
    if dy > most { most = dy }
    if dz > most { most = dz }
    return 0.0 - most
}

// The deepest any of the figure's capsules goes inside the car over the
// strike, metres; -1 when the fixture would not load.
strike(travel: bool, offset: float, speed: float) -> float {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_travel_speculation(physics.of(e), travel)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", BOXMAN)
    if o == null {
        engine.engine_free(e)
        return 0.0 - 1.0
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // The car, its long side to the figure, 1.5 m off and coming at it.
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(HALF_X * 2.0, HALF_Y * 2.0, HALF_Z * 2.0))
    behaviour.object_set_position(car, core.vec3(0.0 - 1.5 - HALF_X, 0.3 + HALF_Y, offset))
    body = physics.rigidbody(car, physics.DYNAMIC)
    physics.box_collider(car, core.vec3(HALF_X, HALF_Y, HALF_Z), physics.material(0.6, 0.0), 150.0)
    dynamics.body_set_gravity_scale(physics.rigidbody_body(body), 0.0)
    physics.rigidbody_set_velocity(body, core.vec3(speed, 0.0, 0.0))
    h = physics.ragdoll_human(r)
    deepest = 0.0
    k = 0
    while k < 40 {
        engine.engine_update(e, STEP)
        t = dynamics.body_get_transform(physics.rigidbody_body(body))
        b = 0
        while b < physics.ragdoll_bone_count(r) {
            bone = human.bone_at(h, b)
            bt = dynamics.body_get_transform(bone.body_id)
            c = dynamics.shape_get_capsule(bone.shape_id)
            n = 0
            while n < 5 {
                f = (n as float) * 0.25
                at = math.transform_point(bt, math.add(c.center1, math.mul_sv(f, math.sub(c.center2, c.center1))))
                d = inside_box(t, at) + c.radius
                if d > deepest { deepest = d }
                n = n + 1
            }
            b = b + 1
        }
        k = k + 1
    }
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
    return deepest
}

main() {
    println("car_strike: a 1.2 t car at 6 to 8 m/s strikes a standing figure (aephysics#173)")
    if strike(true, 0.0, SPEED) < 0.0 {
        println("car_strike: SKIP ${BOXMAN} would not load")
        return
    }
    with_sum = 0.0
    with_most = 0.0
    without_sum = 0.0
    n = 0
    sp = 0
    while sp < 3 {
        speed = 6.0 + (sp as float)
        o = 0
        while o < 5 {
            offset = 0.15 * ((o as float) - 2.0)
            a = strike(true, offset, speed)
            b = strike(false, offset, speed)
            with_sum = with_sum + a
            without_sum = without_sum + b
            if a > with_most { with_most = a }
            n = n + 1
            o = o + 1
        }
        sp = sp + 1
    }
    with_mean = with_sum / (n as float)
    without_mean = without_sum / (n as float)
    println("  over ${n} strikes, the deepest a capsule went inside the car: ${with_mean * 100.0} cm on average (${with_most * 100.0} at most) with travel speculation, ${without_mean * 100.0} cm without")
    check("with travel speculation, a limb goes in under 70% as deep as without, on average", with_mean < 0.7 * without_mean)
    check("and never 5 cm in", with_most < 0.05)
    if g_failures == 0 {
        println("car_strike: all checks passed (${g_checks})")
        return
    }
    println("car_strike: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
