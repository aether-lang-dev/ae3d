// The feet stand on what can be stood on (#934): the UE5 mannequin walking
// on 100STYLE's neutral gaits (ae3d.character, its capsule off) under a
// plate lying along its way, tilted 60 degrees about it (steeper than a foot
// stands on), 47 to 67 cm up over the left foot's track and its low edge
// 29 cm up outside it (clear of a walk's swing): set from a first walk with
// no plate, where the left foot's pad goes. No window; stepped at 60 Hz.
// Siltreach's settler stood its heel on a seat log's 53 degree flank, 25 cm
// up; beside the log, in the gap under its flank, its meter read the heel
// 213 mm into the ground.
//
//   - walking under the plate, no planted foot stands more than 1 cm over
//     the floor under it;
//   - and ae3d.metrics reads no sole more than 1 cm into the ground (the
//     plate is over them, not under);
//   - and walking on open ground, every planted sole rests on the floor
//     (within 1 cm), as without it.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.mover
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
// The plate: a long box WIDE across and THIN through, turned SLOPE about
// the way, its middle MIDDLE up over the track.
const SLOPE = 1.0471976
const WIDE = 0.3
const THIN = 0.01
const MIDDLE = 0.55

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The mannequin walking 4 s along +z from the origin, the plate's steep face
// over the left pad's track at `track` (none at 0): the left pad's mean x
// while planted, the highest a planted sole stood over the floor, and the
// deepest the meter read a sole into the ground.
walk(track: float) -> (float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    if track != 0.0 {
        // Its upper face's normal leans out from the figure, its low edge
        // outside the track.
        side = 1.0
        if track < 0.0 { side = 0.0 - 1.0 }
        plate = engine.object(e, "Plate", null)
        behaviour.object_set_position(plate, core.vec3(track, MIDDLE, 0.0))
        behaviour.object_set_rotation(plate, core.quat_rotate(0.0 - SLOPE * side, core.vec3(0.0, 0.0, 1.0)))
        physics.box_collider(plate, core.vec3(WIDE, THIN, 6.0), physics.material(0.8, 0.0))
    }
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    character.capsule_off(c)
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0 - 2.0))
    behaviour.object_set_rotation(o, core.quat_ident())
    mover.settle(character.mover_of(c))
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    drawn = pose.new(r)
    worlds = pose.new(r)
    track_x = 0.0
    tracked = 0.0
    highest = 0.0
    ahead = core.vec3(0.0, 0.0, 1.0)
    k = 0
    while k < 300 {
        if k >= 30 { character.move(c, ahead, core.vec3(0.0, 0.0, 0.0)) }
        engine.engine_update(e, STEP)
        if k == 90 { metrics.meter_reset(m) }
        if k >= 90 {
            metrics.meter_take(m, STEP)
            pose.read(r, drawn)
            pose.world(r, drawn, worlds)
            side = 0
            while side < 2 {
                if ikrig.feet_locked(f, side) {
                    heel, pad, toe = ikrig.feet_soles(f, r, worlds, side)
                    low = heel.y
                    if pad.y < low { low = pad.y }
                    if toe.y < low { low = toe.y }
                    if low > highest { highest = low }
                    if side == 0 {
                        track_x = track_x + pad.x
                        tracked = tracked + 1.0
                    }
                }
                side = side + 1
            }
        }
        k = k + 1
    }
    into = metrics.meter_worst(m, metrics.INTO_GROUND)
    metrics.meter_free(m)
    pose.release(drawn)
    pose.release(worlds)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if tracked > 0.0 { track_x = track_x / tracked }
    return track_x, highest, into
}

main() {
    println("feet_steep: a foot stands on what can be stood on (#934)")
    track, open, _open_into = walk(0.0)
    println("  on open ground: the left pad's track at x ${track} m, a planted sole at most ${open * 1000.0} mm over the floor")
    check("on open ground every planted sole rests on the floor (within 1 cm)", open < 0.01)
    _t, under, into = walk(track)
    println("  under a plate sloping 60 degrees over the left foot's track: a planted sole at most ${under * 1000.0} mm over the floor; the meter read a sole ${into * 1000.0} mm into the ground at most")
    check("walking under a surface steeper than a foot stands on, no planted foot stands more than 1 cm over the floor", under < 0.01)
    check("and the meter reads no sole more than 1 cm into the ground: the plate is over them", into < 0.01)
    if g_failures == 0 {
        println("feet_steep: all checks passed (${g_checks})")
        return
    }
    println("feet_steep: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
