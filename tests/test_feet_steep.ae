// The feet stand on what can be stood on (#934): the UE5 mannequin walking
// on 100STYLE's neutral gaits (ae3d.character, its capsule off) beside a
// wedge along its way whose top slopes 60 degrees, steeper than a foot
// stands on, under the left foot's heel, pad and toe some 8 cm up: set from
// a first walk with no wedge, where the left foot's pad goes. No window;
// stepped at 60 Hz. Siltreach's settler, stepping beside a seat log, stood a
// foot on its rounded side 15 to 26 cm up and stepped through it, a sole
// 51 mm inside.
//
//   - walking past the slope, no planted foot stands more than 1 cm over
//     the floor under it;
//   - and walking on open ground, every planted sole rests on the floor
//     (within 1 cm), as without it.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.mover

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
// The wedge: a long box turned 60 degrees about the way, its top face 0.5 up.
const SLOPE = 1.0471976
const HALF = 0.3
// How high its face is over the left pad's track.
const FACE_UP = 0.08

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The mannequin walking 4 s along +z from the origin, a wedge's face under
// the left pad's track at `track` (none at 0): the left pad's mean x while
// planted, and the highest a planted sole stood over the floor.
walk(track: float) -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    if track != 0.0 {
        // Its top face through (track - FACE_UP / tan, 0) along the slope, its
        // centre that face's middle less HALF along the face's normal.
        n = core.vec3(0.0 - core.sin_of(SLOPE), core.cos_of(SLOPE), 0.0)
        side = 1.0
        if track < 0.0 { side = 0.0 - 1.0 }
        n = core.vec3(n.x * side, n.y, 0.0)
        on_face = core.vec3(track, FACE_UP, 0.0)
        centre = core.v3_sub(on_face, core.v3_mul(n, HALF))
        wedge = engine.object(e, "Wedge", null)
        behaviour.object_set_position(wedge, centre)
        behaviour.object_set_rotation(wedge, core.quat_rotate(SLOPE * side, core.vec3(0.0, 0.0, 1.0)))
        physics.box_collider(wedge, core.vec3(HALF, HALF, 6.0), physics.material(0.8, 0.0))
    }
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    character.capsule_off(c)
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0 - 2.0))
    behaviour.object_set_rotation(o, core.quat_ident())
    mover.settle(character.mover_of(c))
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    drawn = pose.new(r)
    worlds = pose.new(r)
    track = 0.0
    tracked = 0.0
    highest = 0.0
    ahead = core.vec3(0.0, 0.0, 1.0)
    k = 0
    while k < 300 {
        if k >= 30 { character.move(c, ahead, core.vec3(0.0, 0.0, 0.0)) }
        engine.engine_update(e, STEP)
        if k >= 90 {
            pose.read(r, drawn)
            pose.world(r, drawn, worlds)
            side = 0
            while side < 2 {
                if ikrig.feet_locked(f, side) {
                    heel, pad, toe = ikrig.feet_soles(f, r, worlds, side)
                    low = heel.y
                    if pad.y < low { low = pad.y }
                    if toe.y < low { low = toe.y }
                    if low > highest { highest = low }
                    if side == 0 {
                        track = track + pad.x
                        tracked = tracked + 1.0
                    }
                }
                side = side + 1
            }
        }
        k = k + 1
    }
    pose.release(drawn)
    pose.release(worlds)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if tracked > 0.0 { track = track / tracked }
    return track, highest
}

main() {
    println("feet_steep: a foot stands on what can be stood on (#934)")
    track, open = walk(0.0)
    println("  on open ground: the left pad's track at x ${track} m, a planted sole at most ${open * 1000.0} mm over the floor")
    check("on open ground every planted sole rests on the floor (within 1 cm)", open < 0.01)
    _t, beside = walk(track)
    println("  past a 60 degree slope under the left foot, ${FACE_UP * 100.0} cm up its track: a planted sole at most ${beside * 1000.0} mm over the floor")
    check("walking past a slope steeper than a foot stands on, no planted foot stands more than 1 cm over the floor", beside < 0.01)
    if g_failures == 0 {
        println("feet_steep: all checks passed (${g_checks})")
        return
    }
    println("feet_steep: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
