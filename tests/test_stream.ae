// A world larger than what is held of it (#917, ae3d.stream): a 512 m
// square of 16 x 16 cells, each a ground tile, six crates and an
// instanced crowd of twenty props, baked by the pipeline's half
// (ae3d.worldbake) into cell files and stand-ins, then driven across at
// 30 m/s in real time, a frame every 16 ms, its cells read and decoded on
// workers. Every frame:
//   - no cell within the radius less the lead (what 30 m/s covers in the
//     second a load is given) is missing;
//   - what the cells hold stays under the ceiling stated below.
// And: the cell file gives back what was written; a stand-in is a fraction
// of its cell's triangles and has no texture; a focus pacing across a
// border loads the cell there once (the margin); every cell behind is let
// go; what arrived and left is said; nothing leaks. Headless: the models
// are made and held, given to no renderer.

import std.list
import std.string
import std.mem
import std.strarr
import ae3d.core
import ae3d.loader
import ae3d.png
import ae3d.cellfile
import ae3d.worldbake
import ae3d.stream
import ae3d.nav

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern usleep(us: int) -> int
extern exit(code: int)

const CELL = 32.0
const SIDE = 16
const RADIUS = 96.0
const MARGIN = 32.0
const FAR = 256.0
const SPEED = 30.0               // metres a second
const FRAME_MS = 16
const LEAD = 32.0                // metres: SPEED over a second, rounded up
const DIR = "build/stream_world/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

write_texture(path: string, r: int, g: int, b: int) {
    rgba = calloc(16 * 16, 4)
    i = 0
    while i < 256 {
        mem.set_byte(rgba, i * 4, r)
        mem.set_byte(rgba, i * 4 + 1, g)
        mem.set_byte(rgba, i * 4 + 2, b)
        mem.set_byte(rgba, i * 4 + 3, 255)
        i = i + 1
    }
    png.write(path, rgba, 16, 16)
    free(rgba)
}

// The world's models, cell by cell, and what each is to the world.
world(models: ptr, flags: ptr) {
    x0 = 0.0 - CELL * (SIDE as float) * 0.5
    f = flags as int[]
    n = 0
    iz = 0
    while iz < SIDE {
        ix = 0
        while ix < SIDE {
            cx = x0 + ((ix as float) + 0.5) * CELL
            cz = x0 + ((iz as float) + 0.5) * CELL
            // A ground of 32 x 32 cells (2,048 triangles) and crates as
            // spheres (some 400 each): geometry a stand-in has something to
            // simplify in.
            ground = loader.plane(33, CELL / 32.0)
            core.model_set_position(ground, cx - CELL * 0.5, 0.0, cz - CELL * 0.5)
            if (ix + iz) % 2 == 0 { core.model_set_texture(ground, "build/stream_grass.png") }
            else { core.model_set_texture(ground, "build/stream_stone.png") }
            list.add_raw(models, ground as ptr)
            // The ground is walked on: a collider, not a blocker.
            f[n] = cellfile.FLAG_COLLIDER
            n = n + 1
            k = 0
            while k < 6 {
                crate = loader.sphere(0.75, 20, 12)
                core.model_set_position(crate, cx - 10.0 + (k as float) * 4.0, 0.75, cz + 6.0)
                core.model_set_texture(crate, "build/stream_crate.png")
                list.add_raw(models, crate as ptr)
                f[n] = cellfile.FLAG_COLLIDER | cellfile.FLAG_NAV
                n = n + 1
                k = k + 1
            }
            props = loader.cube(0.3)
            core.model_enable_instancing(props, 20)
            k = 0
            while k < 20 {
                core.model_set_instance_position(props, k, core.vec3(0.0 - 12.0 + (k as float) * 1.2, 0.15, 0.0 - 8.0))
                k = k + 1
            }
            core.model_set_position(props, cx, 0.0, cz)
            list.add_raw(models, props as ptr)
            f[n] = 0
            n = n + 1
            ix = ix + 1
        }
        iz = iz + 1
    }
}

// A model's texture path, "" for none or no material.
texture_of(m: *Model) -> string {
    if m.material == null { return "" }
    return core.text(m.material.texture_path)
}

// The cell file gives back what was written.
round_trip(models: ptr) {
    sub = list.new()
    list.add_raw(sub, list.get_raw(models, 0))
    list.add_raw(sub, list.get_raw(models, 1))
    list.add_raw(sub, list.get_raw(models, 7))
    flags = calloc(3, 4)
    (flags as int[])[0] = cellfile.FLAG_COLLIDER
    err = cellfile.write("build/stream_round.aecell", sub, flags)
    check("a cell file is written (${err})", err == "")
    d = cellfile.decode("build/stream_round.aecell", null)
    check("and decodes (${d.error}), its three models and the three textures they name", d.error == "" && cellfile.model_count(d) == 3 && strarr.size(d.paths) == 2)
    same = true
    i = 0
    while i < 3 {
        source = list.get_raw(sub, i) as *Model
        m = cellfile.instantiate(d, i)
        if core.mesh_vertex_count(m.mesh) != core.mesh_vertex_count(source.mesh) || core.mesh_index_count(m.mesh) != core.mesh_index_count(source.mesh) { same = false }
        a = core.model_world_position(m)
        b = core.model_world_position(source)
        if a.x != b.x || a.y != b.y || a.z != b.z { same = false }
        if texture_of(m) != texture_of(source) { same = false }
        if m.is_instanced != source.is_instanced { same = false }
        if m.is_instanced && core.model_instance_count(m) != core.model_instance_count(source) { same = false }
        core.model_free(m)
        i = i + 1
    }
    check("each model as it was: its geometry, where it stands, its texture, its instances", same)
    check("what each is to the world is kept", (cellfile.model_at(d, 0).flags & cellfile.FLAG_COLLIDER) != 0 && (cellfile.model_at(d, 1).flags & cellfile.FLAG_COLLIDER) == 0)
    cellfile.data_free(d)
    bad = cellfile.decode("build/stream_none.aecell", null)
    check("a file that is not there is an error, not a cell", bad.error != "")
    cellfile.data_free(bad)
    free(flags)
    list.free(sub)
}

// The crates in a resident cell not blocked, and those in a cell that is
// not resident blocked: what is wrong of the field.
crates_misblocked(st: *Streamer, field: *FlowField) -> int {
    x0 = 0.0 - CELL * (SIDE as float) * 0.5
    wrong = 0
    c = 0
    while c < stream.cell_count(st) {
        cell = stream.cell_at(st, c)
        cx = x0 + ((stream.cell_x(cell) as float) + 0.5) * CELL
        cz = x0 + ((stream.cell_z(cell) as float) + 0.5) * CELL
        there = stream.cell_state(cell) == stream.RESIDENT
        k = 0
        while k < 6 {
            if nav.flow_blocked(field, cx - 10.0 + (k as float) * 4.0, cz + 6.0) != there { wrong = wrong + 1 }
            k = k + 1
        }
        c = c + 1
    }
    return wrong
}

// The field's cells blocked (its origin the world's corner).
blocked_cells(field: *FlowField) -> int {
    x0 = 0.0 - CELL * (SIDE as float) * 0.5
    n = 0
    r = 0
    while r < nav.flow_height(field) {
        c = 0
        while c < nav.flow_width(field) {
            if nav.flow_blocked(field, x0 + (c as float) + 0.5, x0 + (r as float) + 0.5) { n = n + 1 }
            c = c + 1
        }
        r = r + 1
    }
    return n
}

// What a cell file decodes to, textures and all.
decoded_bytes(path: string) -> long {
    d = cellfile.decode(path, null)
    n = cellfile.data_bytes(d)
    cellfile.data_free(d)
    return n
}

main() {
    println("stream: a world larger than what is held of it, driven across at 30 m/s")
    write_texture("build/stream_grass.png", 60, 140, 50)
    write_texture("build/stream_stone.png", 120, 120, 120)
    write_texture("build/stream_crate.png", 150, 100, 40)
    models = list.new()
    flags = calloc(SIDE * SIDE * 8, 4)
    world(models, flags)
    round_trip(models)

    half = CELL * (SIDE as float) * 0.5
    err = worldbake.bake(models, flags, CELL, 0.0 - half, 0.0 - half, SIDE, SIDE, DIR)
    stats = worldbake.last_stats()
    check("the world is baked (${err}): ${stats.cells} cells, ${stats.models} models, ${stats.bytes} bytes", err == "" && stats.cells == SIDE * SIDE && stats.models == list.size(models))
    check("its stand-ins are a fraction of its triangles (${stats.far_triangles} of ${stats.full_triangles})", stats.far_triangles > 0 && stats.far_triangles * 4 < stats.full_triangles)
    // The same world baked a batch at a time: the first half of the rows,
    // then the rest, every cell named once; a batch reaching into a cell
    // an earlier one wrote is refused, naming it.
    half_models = list.size(models) / 2
    first = list.new()
    rest = list.new()
    i = 0
    while i < list.size(models) {
        if i < half_models { list.add_raw(first, list.get_raw(models, i)) } else { list.add_raw(rest, list.get_raw(models, i)) }
        i = i + 1
    }
    rest_flags = (flags + half_models * 4)
    batched = worldbake.begin(CELL, 0.0 - half, 0.0 - half, SIDE, SIDE, "build/stream_world_batched/")
    e1 = worldbake.add(batched, first, flags)
    e2 = worldbake.add(batched, rest, rest_flags)
    e3 = worldbake.add(batched, first, flags)
    e4 = worldbake.finish(batched)
    batched_stats = worldbake.last_stats()
    check("baked in two batches, every cell once (${batched_stats.cells} cells)", e1 == "" && e2 == "" && e4 == "" && batched_stats.cells == SIDE * SIDE)
    check("and a batch reaching into a cell already written is refused, naming it (${e3})", string.contains(e3, "cell 0, 0") == 1)
    // A model off the grid refuses its batch whole, writing nothing; a
    // bake begin refused cannot be added to.
    corner = worldbake.begin(CELL, 0.0 - half, 0.0 - half, 1, 1, "build/stream_world_corner/")
    e5 = worldbake.add(corner, first, flags)
    corner_stats = worldbake.last_stats()
    worldbake.finish(corner)
    check("a batch with a model off the grid is refused whole, naming it (${e5})", string.contains(e5, "off the grid") == 1 && corner_stats.cells == 0)
    e6 = worldbake.add(worldbake.begin(0.0, 0.0, 0.0, 0, 0, "build/stream_world_none/"), first, flags)
    check("a bake begin refused cannot be added to (${e6})", e6 != "")
    list.free(first)
    list.free(rest)
    i = 0
    while i < list.size(models) {
        core.model_free(list.get_raw(models, i) as *Model)
        i = i + 1
    }
    list.free(models)
    free(flags)

    st = stream.open("${DIR}world.json")
    check("the world opens (${stream.last_error()})", st != null)
    if st == null { exit(1) }
    stream.set_radius(st, RADIUS, MARGIN)
    // The walkers' field over the whole world, a cell a metre: the crates of
    // the resident cells block it.
    field = nav.flow_new(0.0 - half, 0.0 - half, half, half, 1.0)
    stream.set_nav(st, field as ptr, 0.0 - 0.3, 2.2, 0)
    stream.set_far(st, FAR)
    stream.set_budget(st, (256 * 1024) as long)

    // The ceiling: a cell's bytes as its decode makes them, textures and all,
    // for every cell a point can have within the radius and margin, and a
    // stand-in's for every cell within the far radius and margin.
    cell_bytes = decoded_bytes("${DIR}cell_0_0.aecell")
    far_bytes = decoded_bytes("${DIR}cell_0_0.far.aecell")
    reach = RADIUS + MARGIN
    across = ((2.0 * reach / CELL) as int) + 2
    far_across = ((2.0 * (FAR + MARGIN) / CELL) as int) + 2
    if far_across > SIDE { far_across = SIDE }
    ceiling = cell_bytes * ((across * across) as long) + far_bytes * ((far_across * far_across) as long)
    // All of it held: every cell and every stand-in.
    world_bytes = (cell_bytes + far_bytes) * ((SIDE * SIDE) as long)
    println("    a cell decodes to ${cell_bytes} bytes, its stand-in to ${far_bytes}")
    check("a stand-in holds a fraction of its cell (${far_bytes} of ${cell_bytes} bytes)", far_bytes * (4 as long) < cell_bytes)
    // The focus starts still, and waits for what is around it, as a game's
    // first frame of a level does.
    x = 0.0 - 200.0
    stream.focus_clear(st)
    stream.focus(st, x, 0.0)
    settled = 0
    while stream.missing(st, RADIUS) > 0 && settled < 2000 {
        stream.update(st)
        usleep(1000)
        settled = settled + 1
    }
    check("standing, every cell within the radius arrives (${stream.resident_count(st)} resident)", stream.missing(st, RADIUS) == 0)
    events_arrived = 0
    events_left = 0
    worst_missing = 0
    worst_bytes = 0 as long
    frames = 0
    stand_in_wrong = 0
    nav_wrong = 0
    far_seen = 0
    step = SPEED * (FRAME_MS as float) / 1000.0
    while x < 200.0 {
        x = x + step
        stream.focus_clear(st)
        stream.focus(st, x, 0.0)
        stream.update(st)
        k = 0
        while k < stream.event_count(st) {
            if stream.event_kind(st, k) == stream.ARRIVED { events_arrived = events_arrived + 1 }
            if stream.event_kind(st, k) == stream.LEFT { events_left = events_left + 1 }
            k = k + 1
        }
        stream.events_clear(st)
        gone = stream.missing(st, RADIUS - LEAD)
        if gone > worst_missing { worst_missing = gone }
        if stream.resident_bytes(st) > worst_bytes { worst_bytes = stream.resident_bytes(st) }
        // A stand-in shows exactly where its cell is not all there.
        c = 0
        while c < stream.cell_count(st) {
            cell = stream.cell_at(st, c)
            if stream.cell_far_state(cell) == stream.RESIDENT {
                if stream.cell_state(cell) == stream.RESIDENT && stream.cell_far_shown(cell) { stand_in_wrong = stand_in_wrong + 1 }
                if stream.cell_state(cell) != stream.RESIDENT { far_seen = far_seen + 1 }
                if stream.cell_state(cell) != stream.RESIDENT && !stream.cell_far_shown(cell) { stand_in_wrong = stand_in_wrong + 1 }
            }
            c = c + 1
        }
        // Every 30 frames: a crate stands blocked exactly where its cell is.
        if frames % 30 == 0 { nav_wrong = nav_wrong + crates_misblocked(st, field) }
        frames = frames + 1
        usleep(FRAME_MS * 1000)
    }
    println("    ${frames} frames; the most held ${worst_bytes} bytes (ceiling ${ceiling}); peak ${stream.peak_bytes(st)}")
    check("no cell within ${RADIUS - LEAD} m of the focus was ever missing (${worst_missing})", worst_missing == 0)
    check("what the cells hold stayed under the ceiling", worst_bytes <= ceiling && stream.peak_bytes(st) <= ceiling)
    // The far radius reaches most of a world this size, so it is the near
    // cells that are left behind: under half of all of it.
    check("and under half of the whole world held (${worst_bytes} of ${world_bytes})", worst_bytes * (2 as long) < world_bytes)
    check("a resident cell's crates block the walkers' field, and a cell not there blocks nothing (${nav_wrong} wrong)", nav_wrong == 0)
    check("cells arrived and left as the focus passed (${events_arrived} in, ${events_left} out)", events_arrived > 20 && events_left > 10)
    check("a stand-in is drawn where its cell is not there, and never over it (${far_seen} stand-in frames)", far_seen > 1000 && stand_in_wrong == 0)

    // Every cell behind let go.
    stale = 0
    c = 0
    while c < stream.cell_count(st) {
        cell = stream.cell_at(st, c)
        cx = 0.0 - half + ((stream.cell_x(cell) as float) + 0.5) * CELL
        if cx < x - reach - CELL && stream.cell_state(cell) != stream.UNLOADED { stale = stale + 1 }
        c = c + 1
    }
    check("every cell left behind is let go (${stale} held)", stale == 0)

    // Pacing across a border: the cell [0, 32) on x, which the drive left
    // behind, comes within the radius as the focus passes -96, and loads
    // once, however many times the focus crosses back and forth by 2 m. The
    // focus starts 2 m short.
    border = 0.0 - RADIUS
    stream.focus_clear(st)
    stream.focus(st, border - 2.0, 16.0)
    settled = 0
    while stream.missing(st, RADIUS) > 0 && settled < 2000 {
        stream.update(st)
        stream.events_clear(st)
        usleep(1000)
        settled = settled + 1
    }
    beyond = stream.cell_of(st, 16.0, 16.0)
    before = stream.cell_loads(beyond)
    pace = 0
    while pace < 120 {
        offset = 2.0
        if (pace / 10) % 2 == 1 { offset = 0.0 - 2.0 }
        stream.focus_clear(st)
        stream.focus(st, border + offset, 16.0)
        stream.update(st)
        stream.events_clear(st)
        usleep(2000)
        pace = pace + 1
    }
    stream.wait_idle(st)
    check("pacing 4 m back and forth by a border loads the cell past it once (${stream.cell_loads(beyond) - before}), and keeps it",
          stream.cell_loads(beyond) - before == 1 && stream.cell_state(beyond) == stream.RESIDENT)
    stream.stream_free(st)
    check("every cell let go, the walkers' field is open again", blocked_cells(field) == 0)
    nav.flow_free(field)
    if g_failures == 0 {
        println("stream: all checks passed (${g_checks})")
    } else {
        println("stream: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
