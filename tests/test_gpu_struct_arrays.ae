// A captured struct holding an array of structs, through ae3d.gpu: the
// scene's lights (Light[16], step 6, docs/aether_quote_design.md section 11),
// here a smaller Sky of four Lamps.
//
//   - capture_field places the array and capture_element_field each field
//     of its element, with the compiler's own offsets and size (offsetof,
//     sizeof); the element is a GLSL struct of its own, declared once before
//     the struct holding the array, its fields in the cell's order, whether
//     the shader reads them off the capture, off a helper's parameter it was
//     handed whole, or builds one as a literal;
//   - the block lays it out as glslang does (std140: the element aligned to
//     sixteen and its size rounded up to sixteen, its arrayStride), asked
//     of glslang itself, and OpenGL sets it a value at a time
//     ("sky.lamps[2].colour");
//   - params_write repacks every element's fields from the cell (a float a
//     double there, an f32 four bytes) to those places, and set_field_words
//     reads them back from a block's words;
//   - on the CPU it draws what the same shader written as plain Aether does;
//   - an element field read but not placed, an array of structs with none
//     placed, a stride that disagrees, and an element field asked of a field
//     that is not an array of structs are refused.
import std.os
import std.list
import std.file
import std.string
import std.heap
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader)
import ae3d.shaderlib (vec2, vec3, vec4, splat3, dot, max, normalize, xyz)

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }

// A lamp: where it is, its colour and how bright, what kind (0 a point, 1
// the sun), and how far it reaches as an f32 (four bytes in the cell, where
// a float is eight); and a note no shader reads, which puts the cell's
// elements 64 bytes apart where the block's are 48.
struct Lamp {
    position: vec3
    colour: vec3
    intensity: float
    kind: int
    reach: f32
    note: vec4
}

struct Sky {
    count: int
    lamps: Lamp[4]
    tint: vec4
}

// One lamp's light onto a surface facing `n` at `p`, the lamp handed whole.
@quotable
lamp_light(l: Lamp, n: vec3, p: vec3) -> vec3 {
    to = l.position - p
    if l.kind == 1 { to = l.position }
    if dot(to, to) > l.reach * l.reach { return splat3(0.0) }
    return l.colour * (l.intensity * max(dot(n, normalize(to)), 0.0))
}

// A lamp made in the shader: a struct literal of the element's type, which
// is then the same GLSL struct as the array's.
@quotable
lamp_of(at: vec3, glow: float) -> Lamp {
    return Lamp { position: at, colour: splat3(glow), intensity: 2.0, kind: 0, reach: 100.0 }
}

sky_shader(sky: Sky) -> *GpuShader {
    s = gpu.fragment("sky_lamps") quote | uv: vec2 | {
        n = normalize(vec3(uv.x - 0.5, 1.0, uv.y - 0.5))
        p = vec3(uv.x * 4.0, 0.0, uv.y * 4.0)
        acc = splat3(0.0)
        i = 0
        while i < sky.count {
            acc = acc + lamp_light(sky.lamps[i], n, p)
            // A field read off the element itself.
            if sky.lamps[i].kind == 1 { acc = acc + sky.lamps[i].colour * 0.125 }
            i = i + 1
        }
        acc = acc + lamp_light(lamp_of(vec3(2.0, 3.0, 2.0), 0.25), n, p)
        return vec4(acc * xyz(sky.tint), sky.tint.w)
    }
    place(s)
    return s
}

place(s: *GpuShader) {
    _c = gpu.capture_field(s, "sky", "count", offsetof(Sky, count))
    _l = gpu.capture_field(s, "sky", "lamps", offsetof(Sky, lamps))
    _t = gpu.capture_field(s, "sky", "tint", offsetof(Sky, tint))
    place_lamp(s)
    _n = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "note", offsetof(Lamp, note))
}

place_lamp(s: *GpuShader) {
    _p = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "position", offsetof(Lamp, position))
    _c = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "colour", offsetof(Lamp, colour))
    _i = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "intensity", offsetof(Lamp, intensity))
    _k = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "kind", offsetof(Lamp, kind))
    _r = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "reach", offsetof(Lamp, reach))
}

// The same body as plain Aether: what the CPU is held to.
reference(sky: Sky, uv: vec2) -> vec4 {
    n = normalize(vec3(uv.x - 0.5, 1.0, uv.y - 0.5))
    p = vec3(uv.x * 4.0, 0.0, uv.y * 4.0)
    acc = splat3(0.0)
    i = 0
    while i < sky.count {
        acc = acc + lamp_light(sky.lamps[i], n, p)
        if sky.lamps[i].kind == 1 { acc = acc + sky.lamps[i].colour * 0.125 }
        i = i + 1
    }
    acc = acc + lamp_light(lamp_of(vec3(2.0, 3.0, 2.0), 0.25), n, p)
    return vec4(acc * xyz(sky.tint), sky.tint.w)
}

// The element's colour read, but not placed: refused.
unplaced_shader(sky: Sky) -> *GpuShader {
    s = gpu.fragment("unplaced_lamps") quote | uv: vec2 | {
        return vec4(sky.lamps[1].colour, uv.x)
    }
    _l = gpu.capture_field(s, "sky", "lamps", offsetof(Sky, lamps))
    _p = gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "position", offsetof(Lamp, position))
    return s
}

// The array placed, none of its element's fields: refused.
bare_shader(sky: Sky) -> *GpuShader {
    s = gpu.fragment("bare_lamps") quote | uv: vec2 | {
        return vec4(sky.lamps[1].position, uv.x)
    }
    _l = gpu.capture_field(s, "sky", "lamps", offsetof(Sky, lamps))
    return s
}

// What glslang reports of a block, `name: offset N, ...` a line, and an
// array's stride where it has one (topLevelArrayStride, for an array of
// structs: each field once, "sky.lamps.colour").
struct Reported {
    names: ptr       // list of strings
    offsets: ptr     // int[REPORTED_MOST]
    strides: ptr     // int[REPORTED_MOST]
}

const REPORTED_MOST = 64

reflect_block(label: string, text: string) -> Reported {
    r = Reported { names: list.new(), offsets: calloc(REPORTED_MOST, 4), strides: calloc(REPORTED_MOST, 4) }
    if string.length(os.which("glslangValidator")) == 0 { return r }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.frag"
    spv = "${tmp}/ae3d_gpu_${label}.frag.spv"
    _w = file.write(src, text)
    argv = list.new()
    list.add(argv, "-V")
    list.add(argv, "-q")
    list.add(argv, "-o")
    list.add(argv, spv)
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    check("glslang compiles ${label}.frag to SPIR-V", status == 0)
    if status != 0 { println(out) }
    lines = string.split(out, "\n")
    k = 0
    while k < string.array_size(lines) && list.size(r.names) < REPORTED_MOST {
        line = string.concat(string.string_array_get(lines, k), "")
        at = string.index_of(line, ": offset ")
        if at > 0 && string.starts_with(line, "sky.") != 0 {
            rest = string.substring(line, at + 9, string.length(line))
            comma = string.index_of(rest, ",")
            off, _e = string.to_int(string.substring(rest, 0, comma))
            stride = 0
            sa = string.index_of(line, "topLevelArrayStride ")
            if sa > 0 {
                tail = string.substring(line, sa + 20, string.length(line))
                e = 0
                while e < string.length(tail) && string.char_at(tail, e) >= 48 && string.char_at(tail, e) <= 57 { e = e + 1 }
                stride, _e2 = string.to_int(string.substring(tail, 0, e))
            }
            (r.offsets as int[])[list.size(r.names)] = off
            (r.strides as int[])[list.size(r.names)] = stride
            list.add(r.names, string.substring(line, 0, at))
        }
        k = k + 1
    }
    string.array_free(lines)
    if string.length(os.which("spirv-val")) > 0 {
        vargv = list.new()
        list.add(vargv, spv)
        vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
        check("spirv-val passes ${label}.frag", vstatus == 0)
        if vstatus != 0 { println(vout) }
        list.free(vargv)
    }
    return r
}

// Our offset of the uniform `name` (gpu.uniforms_*), -1 when there is none.
leaf_offset(s: *GpuShader, name: string) -> int {
    k = 0
    while k < gpu.uniforms_count(s) {
        if gpu.uniforms_name(s, k) == name { return gpu.uniforms_offset(s, k) }
        k = k + 1
    }
    return 0 - 1
}

// Every value glslang reports against ours: an array of structs' field at
// its offset plus its stride times the element, each element we place.
// How many were held (0 when glslang is not on PATH), and how many disagree.
held_to_glslang(s: *GpuShader, r: Reported) -> int {
    held = 0
    bad = 0
    k = 0
    while k < list.size(r.names) {
        name, _ge = list.get_string(r.names, k)
        off = (r.offsets as int[])[k]
        stride = (r.strides as int[])[k]
        dot_at = string.index_of(name, ".lamps.")
        if stride > 0 && dot_at > 0 {
            head = string.substring(name, 0, dot_at + 6)
            tail = string.substring(name, dot_at + 6, string.length(name))
            e = 0
            while leaf_offset(s, "${head}[${e}]${tail}") >= 0 {
                ours = leaf_offset(s, "${head}[${e}]${tail}")
                held = held + 1
                if ours != off + e * stride {
                    println("    ${head}[${e}]${tail} at ${ours}, glslang says ${off + e * stride}")
                    bad = bad + 1
                }
                e = e + 1
            }
        } else {
            ours = leaf_offset(s, name)
            held = held + 1
            if ours != off {
                println("    ${name} at ${ours}, glslang says ${off}")
                bad = bad + 1
            }
        }
        k = k + 1
    }
    if bad > 0 { return 0 - bad }
    return held
}

some_sky() -> Sky {
    sky = Sky { count: 3, tint: vec4(vec3(0.9, 1.0, 1.1), 0.75) }
    sky.lamps[0] = Lamp { position: vec3(1.0, 2.0, 1.0), colour: vec3(1.0, 0.5, 0.25), intensity: 3.0, kind: 0,
                          reach: 6.0 as f32 }
    sky.lamps[1] = Lamp { position: vec3(0.2, 0.9, 0.1), colour: vec3(0.6, 0.7, 0.9), intensity: 1.5, kind: 1,
                          reach: 1000.0 as f32 }
    sky.lamps[2] = Lamp { position: vec3(3.5, 0.5, 3.0), colour: vec3(0.25, 1.0, 0.5), intensity: 4.0, kind: 0,
                          reach: 2.5 as f32 }
    // A fourth past the count: read by nothing.
    sky.lamps[3] = Lamp { position: vec3(9.0, 9.0, 9.0), colour: vec3(9.0, 9.0, 9.0), intensity: 9.0, kind: 0,
                          reach: 9.0 as f32 }
    return sky
}

main() {
    println("struct arrays: a captured struct's array of structs")
    sky = some_sky()
    s = sky_shader(sky)
    vk = gpu.emit_glsl(s, gpu.VULKAN)
    gl = gpu.emit_glsl(s, gpu.GL)
    if vk == "" || gl == "" { println("  emit: ${gpu.last_error()}") }
    check("the element is a struct of its own, its fields in the cell's order, before the struct holding four",
          string.contains(vk, "struct Lamp {\n    vec3 position;\n    vec3 colour;\n    float intensity;\n    int kind;\n    float reach;\n};\nstruct Sky {\n    int count;\n    Lamp lamps[4];\n    vec4 tint;\n};") != 0)
    first = string.index_of(vk, "struct Lamp {")
    check("Lamp is declared once, though the shader builds one as a literal too",
          first >= 0 && string.index_of_from(vk, "struct Lamp {", first + 1) < 0)
    check("the literal is written as the element's constructor, in the cell's order",
          string.contains(vk, "return Lamp(at, vec3(glow), 2.0, 0, 100.0);") != 0)
    check("an element is handed to a helper whole, and read a field at a time",
          string.contains(vk, "lamp_light(sky.lamps[i], n, p)") != 0 && string.contains(vk, "sky.lamps[i].kind == 1") != 0)

    // The block as glslang lays it out: the count, then four elements of
    // forty bytes rounded up to forty-eight, then the tint.
    check("a Lamp is 64 bytes in the cell (${sizeof(Lamp)}), and its note, read by nothing, is not declared",
          sizeof(Lamp) == 64 && string.contains(vk, "note") == 0)
    check("the block is the sky alone, 224 bytes (${gpu.params_size(s)})",
          gpu.params_count(s) == 1 && gpu.params_type(s, 0) == "Sky" && gpu.params_size(s) == 224)
    check("OpenGL sets the count, each element's five fields, the tint: 22 values (${gpu.uniforms_count(s)})",
          gpu.uniforms_count(s) == 22)
    check("lamp 2's colour is at 16 + 2 * 48 + 16, its reach at 16 + 2 * 48 + 36, the tint at 208",
          leaf_offset(s, "sky.lamps[2].colour") == 128 && leaf_offset(s, "sky.lamps[2].reach") == 148 &&
          leaf_offset(s, "sky.tint") == 208 && leaf_offset(s, "sky.count") == 0)
    rv = reflect_block("sky_lamps", vk)
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
    } else {
        held = held_to_glslang(s, rv)
        check("every offset is glslang's, each element at its arrayStride (${held} held)", held == 22)
    }
    list.free(rv.names)
    free(rv.offsets)
    free(rv.strides)
    compiles_gl(gl)

    // params_write: every element's fields from the cell to their places.
    block = calloc(1, gpu.params_size(s))
    gpu.params_write(s, block)
    bi = block as int[]
    bf = block as f32[]
    check("params_write puts the count at 0, lamp 1's position at 64, its kind at 96, its reach at 100",
          bi[0] == 3 && bf[16] == 0.2 as f32 && bf[17] == 0.9 as f32 && bf[18] == 0.1 as f32 && bi[24] == 1 &&
          bf[25] == 1000.0)
    check("lamp 2's colour at 128 and intensity at 140, the tint at 208",
          bf[32] == 0.25 && bf[33] == 1.0 && bf[34] == 0.5 && bf[35] == 4.0 && bf[52] == 0.9 as f32 && bf[55] == 0.75)
    // set_field_words: the same words read back into a fresh sky's cell.
    blank = Sky { count: 3 }
    s2 = sky_shader(blank)
    ok_words = gpu.set_field_words(s2, "sky", "lamps", block + 16)
    cell = gpu.capture_struct(s2, "sky", "Sky") as *Sky
    l2 = cell.lamps[2]
    l1 = cell.lamps[1]
    p2 = l2.colour as f32x4
    check("set_field_words reads each element's fields back from the block's words",
          ok_words && p2.x == 0.25 && p2.y == 1.0 && l2.intensity == 4.0 && l1.kind == 1 && l1.reach == 1000.0 as f32 &&
          l2.reach == 2.5 as f32)
    gpu.shader_free(s2)
    free(block)

    // On the CPU, against the same body as plain Aether.
    cx = gpu.cpu_new(s)
    right = 0
    low = 1000.0
    high = 0.0
    total = 0
    y = 0
    while y < 8 {
        x = 0
        while x < 8 {
            uv = vec2((x * 1.0 + 0.5) / 8.0, (y * 1.0 + 0.5) / 8.0)
            pa = gpu.v2((x * 1.0 + 0.5) / 8.0, (y * 1.0 + 0.5) / 8.0)
            got = gpu.cpu_run(cx, pa)
            heap.free(pa)
            want = reference(sky, uv) as f32x4
            total = total + 1
            if got == null {
                if total == 1 { println("  cpu_run: ${gpu.last_error()}") }
            } else {
                if absf(gpu.val_x(got) - want.x) < 0.00001 && absf(gpu.val_y(got) - want.y) < 0.00001 &&
                   absf(gpu.val_z(got) - want.z) < 0.00001 && absf(gpu.val_w(got) - want.w) < 0.00001 {
                    right = right + 1
                } else if total == 1 {
                    println("    first pixel: got ${gpu.val_x(got)} ${gpu.val_y(got)} ${gpu.val_z(got)} ${gpu.val_w(got)}, want ${want.x} ${want.y} ${want.z} ${want.w}")
                }
                if gpu.val_x(got) < low { low = gpu.val_x(got) }
                if gpu.val_x(got) > high { high = gpu.val_x(got) }
                gpu.val_free(got)
            }
            x = x + 1
        }
        y = y + 1
    }
    gpu.cpu_free(cx)
    check("the CPU draws what the plain Aether does (${right} of ${total})", right == total)
    check("the lamps light it unevenly, the point lamps out of reach of some (${low} to ${high})", high - low > 0.5)

    // Refusals.
    us = unplaced_shader(sky)
    _ue = gpu.emit_glsl(us, gpu.VULKAN)
    check("an element field read but not placed is refused (${gpu.last_error()})",
          gpu.emit_glsl(us, gpu.VULKAN) == "" && string.contains(gpu.last_error(), "placed no colour") != 0)
    ucx = gpu.cpu_new(us)
    upa = gpu.v2(0.5, 0.5)
    check("and on the CPU", gpu.cpu_run(ucx, upa) == null)
    heap.free(upa)
    gpu.cpu_free(ucx)
    gpu.shader_free(us)
    bs = bare_shader(sky)
    _be = gpu.emit_glsl(bs, gpu.VULKAN)
    check("an array of structs with none of its fields placed is refused (${gpu.last_error()})",
          gpu.emit_glsl(bs, gpu.VULKAN) == "" && string.contains(gpu.last_error(), "placed none of") != 0)
    check("a stride that disagrees with the one placed is refused",
          !gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp) + 8, "kind", offsetof(Lamp, kind)))
    check("a field placed twice is refused",
          !gpu.capture_element_field(s, "sky", "lamps", sizeof(Lamp), "kind", offsetof(Lamp, kind)))
    check("an element field of a field that is not an array of structs is refused",
          !gpu.capture_element_field(s, "sky", "tint", 16, "x", 0))
    check("an element field of an array not placed is refused",
          !gpu.capture_element_field(bs, "sky", "others", sizeof(Lamp), "kind", offsetof(Lamp, kind)))
    gpu.shader_free(bs)
    gpu.shader_free(s)

    println("${g_checks - g_failures} of ${g_checks} checks passed")
    if g_failures > 0 { exit(1) }
    println("all checks passed")
}

// OpenGL's GLSL, as glslang checks it.
compiles_gl(text: string) {
    if string.length(os.which("glslangValidator")) == 0 { return }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_sky_lamps_gl.frag"
    _w = file.write(src, text)
    argv = list.new()
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    check("glslang takes sky_lamps_gl.frag as OpenGL's GLSL", status == 0)
    if status != 0 { println(out) }
}
