// How far a light reaches in the clustered grid, and where a game can end it
// (core.light_set_reach). A light reaches as far as its fall-off takes it to
// a 64th, so a light_point made with a range of 4 m reaches 28 m, and every
// cell -- every pixel -- within lists it: eleven window lights covered a
// town. Told where its pool ends, it is in the cells near it and no others.
// Headless.

import std.list
import std.json
import ae3d.core
import ae3d.lightgrid
import ae3d.scene

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The cells listing the lights, a light's whole count over every cell.
entries(lights: ptr, cam: *Camera) -> int {
    g = lightgrid.grid_new()
    lightgrid.build(g, lights, null, cam)
    // Each cell's two words, then a word for each (cell, light) found.
    n = lightgrid.word_count(g) - lightgrid.cell_count(g) * 2
    lightgrid.grid_free(g)
    return n
}

main() {
    println("light_reach: where a light's pool ends")
    cam = core.camera_new(1280, 720)
    core.camera_set_position(cam, core.vec3(0.0, 20.0, 30.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    pane = core.light_point(core.vec3(0.0, 2.0, 0.0), core.vec3(1.0, 0.52, 0.22), 1.2, 4.0)
    lights = list.new()
    list.add_raw(lights, pane as ptr)

    far = lightgrid.reach(pane, 1000.0)
    check("a light made with a range of 4 m reaches ${far} m by its fall-off", far > 27.0 && far < 29.0)
    wide = entries(lights, cam)
    core.light_set_reach(pane, 4.0)
    near = lightgrid.reach(pane, 1000.0)
    tight = entries(lights, cam)
    check("told to end at 4 m, it reaches 4 m", near == 4.0)
    check("and is listed in a fraction of the cells (${tight} of ${wide})", tight > 0 && tight * 4 < wide)
    core.light_set_reach(pane, 60.0)
    check("a limit past its fall-off changes nothing", lightgrid.reach(pane, 1000.0) == far)
    core.light_set_reach(pane, 0.0)
    check("and 0 gives it its fall-off's reach again", lightgrid.reach(pane, 1000.0) == far)

    // The scene file keeps it.
    core.light_set_reach(pane, 4.0)
    node = scene.light_json(pane)
    back = scene.load_light(node)
    check("a light's reach is kept in the scene file (${back.reach_limit})", back.reach_limit == 4.0)
    core.light_free(back)
    json.free(node)

    list.free(lights)
    core.light_free(pane)
    core.camera_free(cam)
    if g_failures == 0 {
        println("light_reach: all checks passed (${g_checks})")
    } else {
        println("light_reach: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
