// Instance streams that grow a little every frame, on Vulkan: an emitter
// one particle fuller each frame, a placement tool adding one more. A
// stream's ring of per-frame buffers used to be remade at every new most,
// exactly the size asked, behind vkDeviceWaitIdle: a stream creeping from
// 1 to 256 instances remade its ring 255 times, each a wait for the whole
// device. Now a ring at least doubles when it grows, and what it outgrew
// (and what a freed stream held) is retired: destroyed once every frame
// that could have drawn it has finished, with no wait (ae3d.vkmesh).
//
// Held here:
//   - creeping from 1 to 256 instances, the ring is remade at most 9 times;
//   - every frame draws its newest instance where it was put, so a ring
//     that grew carries what was written into it;
//   - what was retired is gone FRAMES frames after the growth stops, and
//     a stream let go of (the model removed) is retired and gone the same
//     way, so nothing builds up.
// Headless; SKIP where there is no Vulkan driver.

import std.mem
import ae3d.core
import ae3d.vulkan
import ae3d.vkmesh
import ae3d.loader

const WIDTH = 160
const HEIGHT = 96
const MOST = 256
const COLUMNS = 16
const SPACING = 3.0

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Instance i's place: a grid of COLUMNS a row, centred on the origin.
place_of(i: int) -> Vec3 {
    x = ((i % COLUMNS) as float - (COLUMNS as float - 1.0) * 0.5) * SPACING
    y = ((i / COLUMNS) as float - (MOST / COLUMNS) as float * 0.5) * SPACING
    return core.vec3(x, y, 0.0)
}

// Whether the pixel where `at` is drawn is lit: the stream's instances are
// white on black.
lit_at(pixels: ptr, cam: *Camera, at: Vec3) -> bool {
    s = core.camera_world_to_screen(cam, at, WIDTH, HEIGHT)
    x = s.x as int
    y = s.y as int
    if x < 0 || y < 0 || x >= WIDTH || y >= HEIGHT { return false }
    i = (y * WIDTH + x) * 4
    return mem.get_byte(pixels, i) + mem.get_byte(pixels, i + 1) + mem.get_byte(pixels, i + 2) > 300
}

main() {
    println("vk_rings: an instance stream that grows every frame, on Vulkan")
    if !vulkan.available() {
        println("vk_rings: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("vk_rings: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    vulkan.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 80.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))

    stream = loader.cube(1.0)
    core.model_matte(stream, 1.0, 1.0, 1.0)
    core.model_set_exposure(stream, 14.0)
    core.model_enable_instancing(stream, MOST)
    core.model_set_instance_draw_count(stream, 1)
    core.model_set_instance_position(stream, 0, place_of(0))
    core.model_recalculate_bounds(stream)
    core.backend_add_model(&backend, stream)

    remade = 0
    last_size = 0
    missing = 0
    most_retired = 0
    count = 1
    while count <= MOST {
        core.model_set_instance_draw_count(stream, count)
        core.model_set_instance_position(stream, count - 1, place_of(count - 1))
        core.model_recalculate_bounds(stream)
        core.backend_render(&backend, cam, light)
        size = vkmesh.ring_size(stream.instance_vbo)
        if size != last_size {
            if size > 0 { remade = remade + 1 }
            last_size = size
        }
        if vkmesh.retired() > most_retired { most_retired = vkmesh.retired() }
        pixels = core.backend_frame_pixels(&backend)
        if pixels == null || !lit_at(pixels, cam, place_of(count - 1)) { missing = missing + 1 }
        count = count + 1
    }
    check("creeping from 1 to ${MOST} instances, the ring was made ${remade} times (at most 9: it doubles)", remade >= 1 && remade <= 9)
    check("it holds them all (${last_size} bytes for ${MOST * 80})", last_size >= MOST * 80)
    check("every frame drew its newest instance where it was put (${missing} missed)", missing == 0)
    check("what was retired never built up (at most ${most_retired} buffers waiting)", most_retired <= 4 * 2)

    // No more growth: what the last regrowth retired goes as frames go by.
    frame = 0
    while frame < 4 {
        core.backend_render(&backend, cam, light)
        frame = frame + 1
    }
    check("frames later, nothing retired is left (${vkmesh.retired()})", vkmesh.retired() == 0)

    // A stream let go of: retired, not waited for, and gone frames later.
    core.backend_remove_model(&backend, stream)
    waiting = vkmesh.retired()
    check("a stream let go of is retired, not destroyed under the frames in flight (${waiting} buffers)", waiting > 0)
    frame = 0
    while frame < 4 {
        core.backend_render(&backend, cam, light)
        frame = frame + 1
    }
    check("and gone frames later (${vkmesh.retired()})", vkmesh.retired() == 0)

    core.model_free(stream)
    core.light_free(light)
    core.camera_free(cam)
    core.backend_cleanup(&backend)
    vulkan.renderer_free(renderer)
    if g_failures == 0 {
        println("vk_rings: all checks passed (${g_checks})")
    } else {
        println("vk_rings: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
