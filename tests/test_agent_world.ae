// The world made visible to the agent (#510): physics.bodies,
// physics.contacts, physics.ray, nav.fields and nav.path over a real socket against a running engine, one request
// a frame, as tests/test_agent_until.ae is.
//
// A crate settles on a static ground; a ball rests far off on the same
// ground. So:
//   - physics.bodies lists all three, their kinds, and the region box keeps
//     only the ball;
//   - physics.contacts has the crate on the ground once, pushed up out of
//     it (its normal along y) and pressed (an impulse);
//   - physics.ray down onto the crate meets the crate at its top, and one
//     beside it the static ground;
//   - a ray with no direction is refused, saying what it needs;
//   - the walkers' field the game exposed is listed, and nav.path walks
//     round its wall through the gap, or answers that there is no walk.
import std.os
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour
import ae3d.physics
import ae3d.nav
import ae3d.navagent

extern exit(code: int)

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_settle = 0
var g_width = 0                    // the exposed field's width in cells, as it says

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 262144)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

int_of(r: ptr, name: string) -> int {
    if r == null { return 0 - 1 }
    node = json.object_get_raw(r, name)
    if node == null { return 0 - 1 }
    return json.get_int(node)
}

num_of(r: ptr, name: string) -> float {
    if r == null { return 0.0 - 1.0 }
    node = json.object_get_raw(r, name)
    if node == null { return 0.0 - 1.0 }
    return json.get_number(node)
}

bool_of(r: ptr, name: string) -> bool {
    if r == null { return false }
    node = json.object_get_raw(r, name)
    return node != null && json.get_bool(node) == 1
}

text_of(r: ptr, name: string) -> string {
    if r == null { return "" }
    node = json.object_get_raw(r, name)
    if node == null || json.json_type(node) != 3 { return "" }
    return json.get_string_raw(node)
}

axis(v: ptr, k: int) -> float { return json.get_number(json.array_get_raw(v, k)) }

main() {
    println("agent_world: the physics and the walks an agent cannot see, over the channel")
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_HIDDEN", "1")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 1200)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.6, 0.0))
    crate = engine.object(e, "Crate", loader.cube(1.0))
    behaviour.object_set_position(crate, core.vec3(0.0, 0.6, 0.0))
    physics.rigidbody(crate, physics.DYNAMIC)
    physics.box_collider(crate, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    ball = engine.object(e, "Ball", loader.sphere(0.5, 12, 8))
    behaviour.object_set_position(ball, core.vec3(20.0, 0.5, 20.0))
    physics.rigidbody(ball, physics.DYNAMIC)
    _s = physics.sphere_collider(ball, 0.5, physics.material(0.6, 0.0))
    // The walkers' field: a wall across at z 10 with a gap at x 4..6.
    field = nav.flow_new(0.0 - 20.0, 0.0 - 20.0, 20.0, 20.0, 1.0)
    nav.flow_block(field, 0.0 - 20.0, 10.0, 3.9, 10.9)
    nav.flow_block(field, 6.0, 10.0, 20.0, 10.9)
    navagent.expose(field as ptr, "walkers")
    g_width = nav.flow_width(field)
    program = engine.behaviour_new("agent world test", null)
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    ran = engine.engine_run(e)
    navagent.forget(field as ptr)
    nav.flow_free(field)
    if !ran {
        println("agent_world: SKIP no window")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    check("the exchange finished (stage ${g_stage})", g_stage == 10)
    if g_failures == 0 {
        println("agent_world: all checks passed (${g_checks})")
        return
    }
    println("agent_world: ${g_failures} of ${g_checks} checks FAILED")
    exit(1)
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        // A second of steps for the crate to settle on the ground.
        g_settle = g_settle + 1
        if g_settle < 60 { return }
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("the client connects", sock != null)
        g_sock = sock
        ask_send("{\"id\":1,\"op\":\"physics.bodies\"}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    doc = ask_receive()
    if doc == null { return }
    respond(e, doc)
    json.free(doc)
}

respond(e: *Engine, doc: ptr) {
    r = result_of(doc)
    if g_stage == 1 {
        bodies = json.object_get_raw(r, "bodies")
        kinds = ""
        k = 0
        while k < json.array_size(bodies) {
            listed = json.array_get_raw(bodies, k)
            kinds = "${kinds}${text_of(listed, "object")}:${text_of(listed, "kind")} "
            k = k + 1
        }
        check("physics.bodies lists all three and their kinds (${kinds})", ok_of(doc) && int_of(r, "count") == 3 &&
              string.contains(kinds, "Ground:static") == 1 && string.contains(kinds, "Crate:dynamic") == 1)
        ask_send("{\"id\":2,\"op\":\"physics.bodies\",\"region\":[15,-1,15,25,5,25]}")
    } else if g_stage == 2 {
        first = json.array_get_raw(json.object_get_raw(r, "bodies"), 0)
        check("and a region keeps only what is inside it: the ball", ok_of(doc) && int_of(r, "count") == 1 && text_of(first, "object") == "Ball")
        ask_send("{\"id\":3,\"op\":\"physics.contacts\",\"object\":\"Crate\"}")
    } else if g_stage == 3 {
        c = json.array_get_raw(json.object_get_raw(r, "contacts"), 0)
        a = text_of(json.object_get_raw(c, "a"), "object")
        b = text_of(json.object_get_raw(c, "b"), "object")
        normal = json.object_get_raw(c, "normal")
        up = axis(normal, 1)
        if up < 0.0 { up = 0.0 - up }
        check("physics.contacts has the crate on the ground once (${a} on ${b}, ${int_of(c, "points")} points, normal y ${axis(normal, 1)}, impulse ${num_of(c, "impulse")})",
              ok_of(doc) && int_of(r, "count") == 1 && ((a == "Crate" && b == "Ground") || (a == "Ground" && b == "Crate")) &&
              int_of(c, "points") >= 3 && up > 0.99 && num_of(c, "impulse") > 0.0)
        ask_send("{\"id\":4,\"op\":\"physics.ray\",\"origin\":[0,5,0],\"direction\":[0,-1,0]}")
    } else if g_stage == 4 {
        body = json.object_get_raw(r, "body")
        check("physics.ray down onto the crate meets it at its top (${num_of(r, "distance")} m)",
              ok_of(doc) && bool_of(r, "hit") && text_of(body, "object") == "Crate" && num_of(r, "distance") > 3.9 && num_of(r, "distance") < 4.1 && !bool_of(r, "static"))
        ask_send("{\"id\":5,\"op\":\"physics.ray\",\"origin\":[5,5,5],\"direction\":[0,-2,0],\"reach\":20}")
    } else if g_stage == 5 {
        body = json.object_get_raw(r, "body")
        check("and one beside it the static ground (${num_of(r, "distance")} m)",
              ok_of(doc) && bool_of(r, "hit") && bool_of(r, "static") && text_of(body, "object") == "Ground" && num_of(r, "distance") > 4.9 && num_of(r, "distance") < 5.1)
        ask_send("{\"id\":6,\"op\":\"physics.ray\",\"origin\":[0,5,0]}")
    } else if g_stage == 6 {
        reason = ""
        node = json.object_get_raw(doc, "error")
        if node != null { reason = json.get_string_raw(node) }
        check("a ray with no direction is refused, saying what it needs (${reason})", !ok_of(doc) && string.contains(reason, "direction") == 1)
        ask_send("{\"id\":7,\"op\":\"nav.fields\"}")
    } else if g_stage == 7 {
        first = json.array_get_raw(json.object_get_raw(r, "fields"), 0)
        check("nav.fields lists the field the game exposed", ok_of(doc) && text_of(first, "name") == "walkers" && int_of(first, "width") == g_width && g_width > 0)
        ask_send("{\"id\":8,\"op\":\"nav.path\",\"from\":[-10.5,0.5],\"to\":[-10.5,15.5]}")
    } else if g_stage == 8 {
        points = json.object_get_raw(r, "points")
        through = false
        k = 0
        while k < json.array_size(points) {
            pt = json.array_get_raw(points, k)
            if axis(pt, 1) > 9.0 && axis(pt, 1) < 12.0 && axis(pt, 0) > 3.9 && axis(pt, 0) < 6.1 { through = true }
            k = k + 1
        }
        check("nav.path walks round the wall through its gap (${json.array_size(points)} corners, cost ${int_of(r, "cost")})",
              ok_of(doc) && bool_of(r, "reached") && through && json.array_size(points) >= 3)
        ask_send("{\"id\":9,\"op\":\"nav.path\",\"from\":[-10.5,0.5],\"to\":[-10.5,10.5]}")
    } else if g_stage == 9 {
        check("and into the wall there is no walk", ok_of(doc) && !bool_of(r, "reached") && int_of(r, "cost") == 0 - 1)
        g_stage = 10
        engine.engine_stop(e)
        return
    }
    g_stage = g_stage + 1
}
