// The settling step after a stagger (#697), held to numbers. The IK rig
// (the pipeline's skeleton), POWERED, shoved at the chest 60 ways -- from
// its side, from in front and from behind, 1.0 to 1.6 m/s, straight and 10
// and 20 degrees either way -- left until it has stood still and upright
// for a second (8 s at the most), then shoved 1.2 m/s from its side, as
// the motion showcase shoves its side figure. Each in an engine of its
// own; no window.
//
//   - of those at rest, at most FAR_MOST stand more than 3 cm off the
//     stance they had before the first shove: their feet are back under
//     them, each carried there by a step the body leans off first. 1 of
//     56 now (2 and 3 with the shoves turned 3 degrees and 0.05 m/s faster
//     or slower); 18 of 55 without the settling step (main bae11e8), the
//     stance 8.4 cm off on average and 36 cm at the most;
//   - the second shove fells at most FELLED_MOST of those that stood the
//     first: none of 58 now (2 and 2), 6 of 58 without it. A stance left
//     narrow or split by a stagger's last step fell to a shove it stands
//     from rest.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const STEP = 0.016666666666666666
const FAR_MOST = 4                   // of those at rest, more than 3 cm off their stance
const FELLED_MOST = 3                // felled by the second shove

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

struct Trial {
    fell_first: bool
    stance_off: float                // the most a foot was from where it stood before, after the first shove settled
    fell: bool                       // the second shove felled it
    steps: int                       // steps after the first shove's 4 s, to the end
    tilt: float                      // its lean when the second shove came
    rested: bool                     // it had come to rest when the second shove came
    lurch: float                     // the most it leant after first coming to rest, before the second shove
    leaning: float                   // seconds it stood slow on its feet leaning past 0.12 rad, before the second shove
    calm_steps: int                  // settling steps taken before the second shove
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS), core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

ankle_of(r: *Ragdoll, pose: ptr, calf: int) -> Vec3 {
    physics.ragdoll_body_pose(r, pose)
    return physics.ragdoll_pose_end(r, pose, calf)
}

// Feet relative to the pelvis, along `ahead` and across it.
foot_in_frame(r: *Ragdoll, pose: ptr, calf: int, ahead: Vec3) -> Vec3 {
    a = ankle_of(r, pose, calf)
    p = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    across = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead)
    d = core.vec3(a.x - p.x, 0.0, a.z - p.z)
    return core.vec3(core.v3_dot(d, across), 0.0, core.v3_dot(d, ahead))
}

trial(way: int, speed: float, turn: float) -> Trial {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig()
    physics.ragdoll_dress(r, rig)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    pose = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    out = Trial { fell_first: false, stance_off: 0.0, fell: false, steps: 0, tilt: 0.0, calm_steps: 0, rested: false, lurch: 0.0, leaning: 0.0 }
    seen_rest = false
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    ahead = facing(m)
    rest_l = foot_in_frame(r, pose, human.BONE_CALF_L, ahead)
    rest_r = foot_in_frame(r, pose, human.BONE_CALF_R, ahead)
    dir = ahead
    if way == 0 { dir = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead) }
    if way == 1 { dir = core.v3_mul(ahead, 0.0 - 1.0) }
    dir = core.vec3(dir.x * core.cos_of(turn) + dir.z * core.sin_of(turn), 0.0, dir.z * core.cos_of(turn) - dir.x * core.sin_of(turn))
    motion.shove(m, human.BONE_SPINE_03, core.v3_mul(dir, speed * physics.ragdoll_mass(r)))
    k = 0
    rest_for = 0.0
    last = physics.ragdoll_center_of_mass(r)
    while k < 480 && rest_for < 1.0 {
        engine.engine_update(e, STEP)
        c0 = physics.ragdoll_center_of_mass(r)
        v0 = core.v3_len(core.vec3(c0.x - last.x, 0.0, c0.z - last.z)) / STEP
        last = c0
        if v0 < 0.12 && motion.tilt(m) < 0.05 && !motion.stepping(m) { rest_for = rest_for + STEP } else { rest_for = 0.0 }
        if rest_for >= 0.3 { seen_rest = true }
        if core.env_int("TRACE", 0) == 1 && k % 6 == 0 {
            gaps = ""
            leg = human.BONE_THIGH_L
            while leg <= human.BONE_THIGH_R {
                hb = human.bone_at(physics.ragdoll_human(r), leg)
                cone = dynamics.spherical_joint_of(dynamics.get_joint_sim_of_kind(hb.joint_id, dynamics.JOINT_SPHERICAL))
                par = core.quat_mul(physics.ragdoll_bone_rotation(r, hb.parent_index), dynamics.joint_get_local_frame_a(hb.joint_id).q)
                gap = dynamics.spherical_cone_gap(cone, core.quat_mul(core.quat_conjugate(par), core.quat_mul(physics.ragdoll_bone_rotation(r, leg), dynamics.joint_get_local_frame_b(hb.joint_id).q)))
                gaps = "${gaps} hipgap${leg} ${gap * 57.3}"
                leg = leg + 2
            }
            pl = physics.ragdoll_bone_rotation(r, human.BONE_PELVIS)
            pt = physics.ragdoll_bone_target(r, human.BONE_PELVIS)
            rest = human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q
            up_have = core.quat_apply(core.quat_mul(pl, core.quat_conjugate(rest)), core.vec3(0.0, 1.0, 0.0))
            up_want = core.quat_apply(core.quat_mul(pt, core.quat_conjugate(rest)), core.vec3(0.0, 1.0, 0.0))
            println("      t ${(k as float) / 60.0} tilt ${motion.tilt(m)} v ${v0} stepping ${motion.stepping(m)} stagger ${motion.staggering(m)} steps ${motion.steps_taken(m)} up have ${up_have.x} ${up_have.y} ${up_have.z} want ${up_want.x} ${up_want.y} ${up_want.z} assist ${physics.ragdoll_balance_assist(r)}${gaps}")
        }
        if seen_rest && motion.tilt(m) > out.lurch { out.lurch = motion.tilt(m) }
        if !motion.stepping(m) && !motion.falling(m) && !motion.lying(m) && v0 < 0.25 && motion.tilt(m) > 0.12 && k > 60 { out.leaning = out.leaning + STEP }
        if motion.falling(m) || motion.lying(m) { out.fell_first = true }
        k = k + 1
    }
    if !out.fell_first {
        now = facing(m)
        l = foot_in_frame(r, pose, human.BONE_CALF_L, now)
        rr = foot_in_frame(r, pose, human.BONE_CALF_R, now)
        out.stance_off = core.v3_len(core.v3_sub(l, rest_l))
        dr = core.v3_len(core.v3_sub(rr, rest_r))
        if dr > out.stance_off { out.stance_off = dr }
        out.tilt = motion.tilt(m)
        out.rested = rest_for >= 1.0
        before = motion.steps_taken(m)
        side = core.v3_cross(core.vec3(0.0, 1.0, 0.0), now)
        motion.shove(m, human.BONE_SPINE_03, core.v3_mul(side, 1.2 * physics.ragdoll_mass(r)))
        k = 0
        while k < 180 {
            engine.engine_update(e, STEP)
            if motion.falling(m) || motion.lying(m) { out.fell = true }
            k = k + 1
        }
        out.steps = motion.steps_taken(m) - before
    }
    free(pose)
    engine.engine_free(e)
    motion.motion_free(m)
    rig_free(rig)
    return out
}

main() {
    println("settle: a stagger's stance put right before the next shove")
    lurches = 0
    leaning_sum = 0.0
    leaning_long = 0
    lurch_most = 0.0
    trials = 0
    first = 0
    fell = 0
    off_sum = 0.0
    off_most = 0.0
    steps = 0
    restless = 0
    far = 0
    way = 0
    if core.env_int("TRACE", 0) == 1 {
        t1 = trial(core.env_int("TW", 0), (core.env_int("TS", 100) as float) / 100.0, (core.env_int("TT", 0) as float) * 0.1745329)
        println("  traced: fell first ${t1.fell_first}, rested ${t1.rested}, lurch ${t1.lurch}")
        return
    }
    while way < 3 {
        n = 0
        while n < 4 {
            a = 0
            while a < 5 {
                t = trial(way, 1.0 + 0.2 * (n as float) + (core.env_int("SPEED_OFF", 0) as float) / 1000.0, ((a - 2) as float) * 0.1745329 + (core.env_int("TURN_OFF", 0) as float) * 0.0174533)
                leaning_sum = leaning_sum + t.leaning
                if t.leaning > 1.0 { leaning_long = leaning_long + 1 }
                trials = trials + 1
                if t.fell_first {
                    first = first + 1
                } else if !t.rested {
                    restless = restless + 1
                    if t.fell { fell = fell + 1 }
                } else {
                    if t.fell { fell = fell + 1 }
                    off_sum = off_sum + t.stance_off
                    if t.stance_off > off_most { off_most = t.stance_off }
                    steps = steps + t.steps
                }
                if t.rested && t.stance_off > 0.03 { far = far + 1 }
                if t.lurch > 0.1 { lurches = lurches + 1 }
                if core.env_int("EACH", 0) == 1 { println("    way ${way} speed ${1.0 + 0.2 * (n as float)} turn ${a - 2}: fell first ${t.fell_first}, rested ${t.rested}, lurch ${t.lurch}, leaning ${t.leaning}, off ${t.stance_off}, fell ${t.fell}") }
                if t.lurch > lurch_most { lurch_most = t.lurch }
                a = a + 1
            }
            n = n + 1
        }
        way = way + 1
    }
    stood = trials - first - restless
    println("  ${trials} first shoves, ${first} fell, ${restless} not at rest in 8 s; of the ${stood} at rest, the stance ${off_sum / (stood as float)} m off on average (${off_most} at most), ${far} over 3 cm; the second 1.2 m/s side shove felled ${fell} of the ${trials - first} that stood, ${steps} steps after it in all")
    println("  from rest, ${lurches} leant past 0.1 rad before the second shove, ${lurch_most} at most")
    println("  stood leaning past 0.12 rad, slow on its feet: ${leaning_sum} s in all, over 1 s in ${leaning_long}")
    check("of those at rest, at most ${FAR_MOST} stand more than 3 cm off their stance", far <= FAR_MOST)
    check("the second shove fells at most ${FELLED_MOST} of those that stood the first", fell <= FELLED_MOST)
    if g_failures == 0 {
        println("settle: all checks passed (${g_checks})")
        return
    }
    println("settle: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
