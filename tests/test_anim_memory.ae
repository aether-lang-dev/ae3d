// What a figure's animation holds and shares (#990): one UE5 mannequin
// with its takes held 59 MB, and 100 of them peaked at 5.9 GB. No window.
//
//   - a file's animations read once (ae3d.gltf): two scenes loaded from the
//     same file hold the same clips, each driving its own node, and the
//     second keeps playing them once the first is freed;
//   - one copy of each take a skeleton's figures play: two characters of
//     one figure on one set of gaits play the same take, compressed;
//   - a take compressed ACL's way (clips.compress) moves no point of the
//     skin more than clips.COMPRESS_ERROR (0.1 mm): every joint and its
//     virtual vertices a bone's length out, sampled between its frames, in
//     the rig's space, against the same take uncompressed; at under a fifth
//     of its bytes; a still track holds no frames;
//   - compressed twice, a take decodes to the same bits; and a program that
//     writes its frames (clips.frame) has them back within the bound.

import ae3d.core
import ae3d.engine
import ae3d.figure
import ae3d.gltf
import ae3d.anim
import ae3d.pose
import ae3d.clips
import ae3d.bvh
import ae3d.retarget
import ae3d.animator
import ae3d.character

extern exit(code: int)

const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const WALK = "tests/fixtures/people/100style/neutral_fw.bvh"
const SAMPLES = 400

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A capture retargeted onto rig `r`, its root motion taken out: the caller's.
captured(r: *pose.Rig, path: string) -> *Take {
    c = bvh.load(path, 0.0)
    if c == null { return null }
    made = bvh.take(c, path, 0, 0 - 1)
    t = retarget.retarget(bvh.rig(c), made, r)
    clips.extract_root(t, r, clips.up_of(r))
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

// Each joint's virtual vertices' distance from it: its longest child bone
// (an end joint's own), at least a centimetre. The caller frees it.
shells(r: *pose.Rig) -> float[] {
    n = pose.count(r)
    rest = pose.new(r)
    d = pose.new(r) as float[]
    j = 0
    while j < n {
        d[j] = 0.01
        j = j + 1
    }
    j = 0
    while j < n {
        up = pose.parent(r, j)
        length = core.v3_len(pose.translation(rest, j))
        if up >= 0 && length > d[up] { d[up] = length }
        j = j + 1
    }
    j = 0
    while j < n {
        length = core.v3_len(pose.translation(rest, j))
        if pose.parent(r, j) >= 0 && d[j] <= 0.01 && length > d[j] { d[j] = length }
        j = j + 1
    }
    pose.release(rest)
    return d
}

// The farthest any joint, or a point `d[j]` along any of its axes, is apart
// in two rig-space poses, metres.
skin_apart(r: *pose.Rig, wa: ptr, wb: ptr, d: float[]) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        pa = pose.translation(wa, j)
        pb = pose.translation(wb, j)
        x = core.v3_len(core.v3_sub(pa, pb))
        if x > most { most = x }
        axis = 0
        while axis < 3 {
            e = core.vec3(d[j], 0.0, 0.0)
            if axis == 1 { e = core.vec3(0.0, d[j], 0.0) }
            if axis == 2 { e = core.vec3(0.0, 0.0, d[j]) }
            va = core.v3_add(pa, core.quat_apply(pose.rotation(wa, j), e))
            vb = core.v3_add(pb, core.quat_apply(pose.rotation(wb, j), e))
            y = core.v3_len(core.v3_sub(va, vb))
            if y > most { most = y }
            axis = axis + 1
        }
        j = j + 1
    }
    return most
}

// The most take `b` sampled puts the skin from where take `a` does, over
// SAMPLES times between their frames.
sampled_apart(r: *pose.Rig, a: *Take, b: *Take, d: float[]) -> float {
    pa = pose.new(r)
    pb = pose.new(r)
    wa = pose.new(r)
    wb = pose.new(r)
    most = 0.0
    k = 0
    while k < SAMPLES {
        at = clips.duration(a) * ((k as float) + 0.37) / (SAMPLES as float)
        clips.sample(a, r, at, false, pa)
        clips.sample(b, r, at, false, pb)
        pose.world(r, pa, wa)
        pose.world(r, pb, wb)
        x = skin_apart(r, wa, wb, d)
        if x > most { most = x }
        k = k + 1
    }
    pose.release(pa)
    pose.release(pb)
    pose.release(wa)
    pose.release(wb)
    return most
}

// Whether two takes sample to the same bits at SAMPLES times.
same_bits(r: *pose.Rig, a: *Take, b: *Take) -> bool {
    pa = pose.new(r)
    pb = pose.new(r)
    same = true
    k = 0
    while k < SAMPLES {
        at = clips.duration(a) * (k as float) / (SAMPLES as float)
        clips.sample(a, r, at, true, pa)
        clips.sample(b, r, at, true, pb)
        fa = pa as float[]
        fb = pb as float[]
        i = 0
        while i < pose.size(r) {
            if fa[i] != fb[i] { same = false }
            i = i + 1
        }
        k = k + 1
    }
    pose.release(pa)
    pose.release(pb)
    return same
}

main() {
    println("anim_memory: a figure's animation shared and compressed (#990)")
    // A file's animations read once.
    s1 = gltf.load(MANNEQUIN)
    s2 = gltf.load(MANNEQUIN)
    if s1 == null || s2 == null {
        println("  cannot read ${MANNEQUIN}")
        exit(1)
    }
    clips_same = gltf.clip_count(s1) == gltf.clip_count(s2) && gltf.clip_count(s1) > 100
    own_nodes = true
    i = 0
    while i < gltf.clip_count(s1) && clips_same {
        if gltf.clip(s1, i) != gltf.clip(s2, i) { clips_same = false }
        if gltf.clip_node(s1, i) == gltf.clip_node(s2, i) { own_nodes = false }
        i = i + 1
    }
    println("  ${gltf.clip_count(s1)} clips of ${gltf.animation_count(s1)} animations; held by ${gltf.anims_users(s1)} scenes")
    check("two scenes of one file hold the same clips, read once", clips_same && gltf.anims_users(s2) == 2 && gltf.animation_count(s2) == gltf.animation_count(s1))
    check("each scene's clips drive its own nodes", own_nodes)
    gltf.scene_destroy(s1)
    reg = anim.registry_new()
    played = gltf.play(s2, gltf.animation_name(s2, 1), reg, true)
    anim.registry_advance(reg, 0.25)
    anim.registry_apply(reg)
    anim.registry_free(reg)
    check("the second plays the file's clips once the first is freed", played > 0 && gltf.anims_users(s2) == 1)
    gltf.scene_destroy(s2)
    s3 = gltf.load(MANNEQUIN)
    check("read again after both are freed, it holds them alone", s3 != null && gltf.anims_users(s3) == 1 && gltf.clip_count(s3) > 100)
    gltf.scene_destroy(s3)

    // One copy of each take: two characters of one figure on one set of gaits.
    e = engine.engine_new()
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c1 = character.humanoid(e, "One", MANNEQUIN, g)
    c2 = character.humanoid(e, "Two", MANNEQUIN, g)
    if c1 == null || c2 == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    a1 = character.animator_of(c1)
    a2 = character.animator_of(c2)
    t1 = animator.state_take(a1, character.idle_state(c1))
    t2 = animator.state_take(a2, character.idle_state(c2))
    println("  the stand: ${clips.frames(t1)} frames, ${clips.take_bytes(t1)} bytes, compressed ${clips.compressed(t1)}, within ${clips.compress_error(t1) * 1000.0} mm")
    check("two characters of one figure play one take, compressed", t1 == t2 && clips.compressed(t1) && clips.compress_error(t1) <= clips.COMPRESS_ERROR)
    gait1 = animator.state_take_at(a1, character.move_state(c1), 0)
    gait2 = animator.state_take_at(a2, character.move_state(c2), 0)
    check("and their move blend's gaits, compressed", gait1 == gait2 && clips.compressed(gait1))

    // The bound at the skin.
    r = animator.rig(a1)
    raw = captured(r, WALK)
    packed = captured(r, WALK)
    again = captured(r, WALK)
    if raw == null || packed == null || again == null {
        println("  cannot read ${WALK}")
        exit(1)
    }
    before = clips.take_bytes(packed)
    err = clips.compress(packed, r)
    _again_err = clips.compress(again, r)
    after = clips.take_bytes(packed)
    still, q16, f32s, f64s = clips.track_kinds(packed)
    d = shells(r)
    apart = sampled_apart(r, raw, packed, d)
    println("  the walk: ${clips.frames(raw)} frames, ${before} bytes compressed to ${after}; tracks still ${still}, 16-bit ${q16}, 32-bit ${f32s}, 64-bit ${f64s}")
    println("  the skin within ${err * 1000.0} mm over its frames, ${apart * 1000.0} mm sampled between them")
    check("compressed, it moves no point of the skin more than 0.1 mm (its own measure)", err >= 0.0 && err <= clips.COMPRESS_ERROR)
    check("sampled between its frames, every joint and its virtual vertices within 0.1 mm of the take's own", apart <= clips.COMPRESS_ERROR)
    check("at under a fifth of its bytes", after * (5 as long) < before)
    check("its still tracks hold no frames (some of every joint's tracks are still)", still > 0 && still + q16 + f32s + f64s == pose.count(r) * 3)
    check("compressed twice, it decodes to the same bits", same_bits(r, packed, again))
    // Written back: a program that writes its frames has them as decoded.
    _first = clips.frame(packed, 0)
    check("a program that writes its frames has them back, no longer compressed, within the bound", !clips.compressed(packed) && sampled_apart(r, raw, packed, d) <= clips.COMPRESS_ERROR)
    pose.release(d as ptr)
    clips.take_free(raw)
    clips.take_free(packed)
    clips.take_free(again)
    character.character_free(c1)
    character.character_free(c2)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("anim_memory: all checks passed (${g_checks})")
        return
    }
    println("anim_memory: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
