// What touches what, told to the objects (#508): a component's collision and
// trigger phases, called by the physics after each step. Headless: the
// engine is stepped by hand at the fixed step, no window.
//
// A crate falls on the ground; a ball falls through a trigger and comes to
// rest in it, then is lifted out; a character walks through another; a
// listener switched off hears nothing; a body destroyed and a trigger taken
// off while something touches them tell what touched them it has gone.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.loader
import ae3d.physics

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// What a probe heard.
struct Probe {
    enters: int
    stays: int
    exits: int
    trigger_enters: int
    trigger_stays: int
    trigger_exits: int
    last_other: ptr                // the other object of the last phase heard
    enter_normal: Vec3
    enter_point: Vec3
    stay_impulse: float            // the last stay's impulse
}

probe_new() -> ptr { return heap.new(Probe) as ptr }
probe_free(p: ptr) { heap.free(p as *Probe) }

probe_enter(p: ptr, go: *GameObject, hit: *Collision) {
    s = p as *Probe
    s.enters = s.enters + 1
    s.last_other = hit.other as ptr
    s.enter_normal = hit.normal
    s.enter_point = hit.point
}
probe_stay(p: ptr, go: *GameObject, hit: *Collision) {
    s = p as *Probe
    s.stays = s.stays + 1
    s.last_other = hit.other as ptr
    s.stay_impulse = hit.impulse
}
probe_exit(p: ptr, go: *GameObject, hit: *Collision) {
    s = p as *Probe
    s.exits = s.exits + 1
    s.last_other = hit.other as ptr
}
probe_trigger_enter(p: ptr, go: *GameObject, other: *GameObject) {
    s = p as *Probe
    s.trigger_enters = s.trigger_enters + 1
    s.last_other = other as ptr
}
probe_trigger_stay(p: ptr, go: *GameObject, other: *GameObject) {
    s = p as *Probe
    s.trigger_stays = s.trigger_stays + 1
}
probe_trigger_exit(p: ptr, go: *GameObject, other: *GameObject) {
    s = p as *Probe
    s.trigger_exits = s.trigger_exits + 1
    s.last_other = other as ptr
}

probe_of(c: *Component) -> *Probe { return c.state as *Probe }

steps(e: *Engine, n: int) {
    i = 0
    while i < n {
        engine.engine_update(e, STEP)
        i = i + 1
    }
}

near(a: float, b: float, within: float) -> bool { return core.abs_of(a - b) <= within }

main() {
    println("contacts: what touches what, told to the objects")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    k = component.kind("Probe", "Tests", probe_new, probe_free)
    component.set_collisions(k, probe_enter, probe_stay, probe_exit)
    component.set_triggers(k, probe_trigger_enter, probe_trigger_stay, probe_trigger_exit)
    stone = physics.material(0.6, 0.0)

    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), stone)
    heard_ground = component.add(ground, k)

    // A crate dropped 1.5 m onto the ground.
    crate = engine.object(e, "Crate", loader.cube(1.0))
    behaviour.object_set_position(crate, core.vec3(0.0, 2.0, 0.0))
    physics.rigidbody(crate, physics.DYNAMIC)
    physics.box_collider(crate, core.vec3(0.5, 0.5, 0.5), stone)
    heard_crate = component.add(crate, k)

    // A trigger 2 m high on the ground at x = 10, and a ball dropped into it.
    zone = engine.object(e, "Zone", null)
    behaviour.object_set_position(zone, core.vec3(10.0, 1.0, 0.0))
    zone_shape = physics.box_collider(zone, core.vec3(1.0, 1.0, 1.0), stone, 1.0, true)
    heard_zone = component.add(zone, k)
    ball = engine.object(e, "Ball", loader.sphere(0.25, 10, 6))
    behaviour.object_set_position(ball, core.vec3(10.0, 4.0, 0.0))
    physics.rigidbody(ball, physics.DYNAMIC)
    physics.sphere_collider(ball, 0.25, stone)
    heard_ball = component.add(ball, k)

    // A listener switched off: a crate that falls as the first did and hears
    // nothing.
    deaf = engine.object(e, "Deaf crate", loader.cube(1.0))
    behaviour.object_set_position(deaf, core.vec3(0.0 - 4.0, 2.0, 0.0))
    physics.rigidbody(deaf, physics.DYNAMIC)
    physics.box_collider(deaf, core.vec3(0.5, 0.5, 0.5), stone)
    heard_deaf = component.add(deaf, k)
    behaviour.component_set_enabled(heard_deaf, false)

    steps(e, 120)
    c = probe_of(heard_crate)
    check("the crate entered its contact with the ground once (${c.enters})", c.enters == 1 && c.exits == 0)
    check("told the ground was what it met", c.last_other == ground as ptr)
    check("its normal points from the crate down into the ground (${c.enter_normal.y})", near(c.enter_normal.y, 0.0 - 1.0, 0.001))
    check("at the ground's top (${c.enter_point.y})", near(c.enter_point.y, 0.0, 0.02))
    check("it stays every step after, resting (${c.stays} stays)", c.stays > 80)
    check("and the ground holds its weight: the stay's impulse is its weight over a step (${c.stay_impulse} N s)",
          near(c.stay_impulse, physics.rigidbody_mass(physics.rigidbody_of(crate)) * 9.81 * STEP, 0.05))
    g = probe_of(heard_ground)
    check("the ground was told too, of both crates and the ball, with its normal up (${g.enters})", g.enters == 3 && near(g.enter_normal.y, 1.0, 0.001))
    check("a listener switched off hears nothing", probe_of(heard_deaf).enters == 0 && probe_of(heard_deaf).stays == 0)
    z = probe_of(heard_zone)
    check("the trigger was entered once, by the ball, and not by the ground it stands on (${z.trigger_enters})", z.trigger_enters == 1 && z.enters == 0)
    b = probe_of(heard_ball)
    check("the ball was told it entered the trigger", b.trigger_enters == 1)
    check("the ball rests in the trigger: it stays", z.trigger_stays > 40 && z.trigger_exits == 0)
    check("and a trigger does not collide: the ball fell through it to the ground (${behaviour.object_position(ball).y})",
          near(behaviour.object_position(ball).y, 0.25, 0.02))

    // The ball thrown up out of the trigger at 8 m/s: out of its top (2 m)
    // by half a second, at the top of its throw at 0.8 s.
    physics.rigidbody_set_velocity(physics.rigidbody_of(ball), core.vec3(0.0, 8.0, 0.0))
    steps(e, 40)
    check("lifted out, the trigger and the ball are told it exited (${z.trigger_exits}, ${b.trigger_exits})", z.trigger_exits == 1 && b.trigger_exits == 1)
    check("and the ball left the ground, which both are told (${b.exits})", b.exits == 1)

    // A character walked through a trigger at x = -10.
    gate = engine.object(e, "Gate", null)
    behaviour.object_set_position(gate, core.vec3(0.0 - 10.0, 1.0, 0.0))
    physics.box_collider(gate, core.vec3(0.5, 1.0, 2.0), stone, 1.0, true)
    heard_gate = component.add(gate, k)
    walker = engine.object(e, "Walker", null)
    behaviour.object_set_position(walker, core.vec3(0.0 - 14.0, 0.0, 0.0))
    ch = physics.character_controller(walker, 0.3, 1.8)
    heard_walker = component.add(walker, k)
    walked = 0
    inside = false
    while walked < 240 {
        physics.character_move(ch, core.vec3(2.0, 0.0, 0.0), 0.0, STEP)
        steps(e, 1)
        if behaviour.object_position(walker).x > 0.0 - 10.0 && behaviour.object_position(walker).x < 0.0 - 9.9 { inside = probe_of(heard_gate).trigger_enters == 1 }
        walked = walked + 1
    }
    gt = probe_of(heard_gate)
    check("a character walking through a trigger enters it once (${gt.trigger_enters})", gt.trigger_enters == 1 && inside)
    check("and exits it once it is through (${gt.trigger_exits}, at x ${behaviour.object_position(walker).x})", gt.trigger_exits == 1)
    check("the character's object was told both", probe_of(heard_walker).trigger_enters == 1 && probe_of(heard_walker).trigger_exits == 1)

    // The crate destroyed while it rests on the ground: the ground is told it
    // exited, with the crate.
    before = g.exits
    engine_scene = engine.engine_scene(e)
    behaviour.scene_remove(engine_scene, crate)
    check("a body destroyed tells what it touched it exited (${g.exits - before})", g.exits == before + 1)
    steps(e, 2)
    check("and its end event, a step later, is not told again", g.exits == before + 1)

    // The ball dropped back into the zone, then the zone's trigger taken off.
    behaviour.object_set_position(ball, core.vec3(10.0, 0.25, 0.0))
    physics.rigidbody_place(physics.rigidbody_of(ball), core.vec3(10.0, 0.25, 0.0), core.quat(0.0, 0.0, 0.0, 1.0))
    steps(e, 3)
    entered = z.trigger_enters
    physics.collider_remove(zone, zone_shape)
    check("the ball back in the trigger entered it again (${entered})", entered == 2)
    check("a trigger taken off tells what was in it it exited", z.trigger_exits == 2 && b.trigger_exits == 2)
    steps(e, 3)
    check("and nothing more is told of it", z.trigger_enters == 2 && z.trigger_exits == 2)

    physics.character_free(ch)
    engine.engine_free(e)
    component.kinds_clear()
    if g_failures == 0 {
        println("contacts: all checks passed (${g_checks})")
    } else {
        println("contacts: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
