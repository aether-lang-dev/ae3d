// Ground seen at a slant keeps its detail (anisotropic filtering): a fine
// checker on a plane running to the horizon, looked along from a walker's
// height, drawn with a scene texture filtering across 1 texel and across
// 16, on OpenGL and Vulkan. A single mip blurs the band ahead to a flat
// smear; filtered across 16 texels its checks still show, on both backends
// alike. Held to the mean of a 4-neighbour Laplacian over that band.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.vulkan
import ae3d.picture
import ae3d.png

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 320
const HEIGHT = 180
const CHECKER = "test://anisotropy/checker"
// The band of rows read: from just under the horizon to a third of the way down.
const BAND_FROM = 0.40
const BAND_TO = 0.62

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

checker_texture() -> bool {
    side = 256
    pixels = calloc(side * side, 4)
    y = 0
    while y < side {
        x = 0
        while x < side {
            v = 0.1
            if ((x / 32) + (y / 32)) % 2 == 0 { v = 0.9 }
            png.rgba_set(pixels, y * side + x, v, v, v, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    ok = picture.register_rgba(CHECKER, pixels, side, side) == 1
    free(pixels)
    return ok
}

// A 400 m square at the ground, a check a metre, glowing
// at its texture's own value so no light varies across it.
ground() -> *Model {
    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    core.mesh_reserve(m.mesh, 4, 6)
    reps = 50.0
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 200.0, 0.0, 0.0 - 200.0), 0.0, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(200.0, 0.0, 0.0 - 200.0), reps, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(200.0, 0.0, 200.0), reps, reps, up)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 200.0, 0.0, 200.0), 0.0, reps, up)
    core.mesh_push_triangle(m.mesh, 0, 2, 1)
    core.mesh_push_triangle(m.mesh, 0, 3, 2)
    core.model_set_texture(m, CHECKER)
    core.model_set_exposure(m, 10.01)
    core.model_set_casts_shadow(m, false)
    return m
}

// The mean 4-neighbour Laplacian of the frame's luminance over the band.
detail(pixels: ptr) -> float {
    total = 0.0
    n = 0
    y = (HEIGHT as float * BAND_FROM) as int
    last = (HEIGHT as float * BAND_TO) as int
    while y < last {
        x = 1
        while x < WIDTH - 1 {
            c = luma(pixels, x, y) * 4.0 - luma(pixels, x - 1, y) - luma(pixels, x + 1, y) - luma(pixels, x, y - 1) - luma(pixels, x, y + 1)
            if c < 0.0 { c = 0.0 - c }
            total = total + c
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return total / (n as float)
}

luma(pixels: ptr, x: int, y: int) -> float {
    at = (y * WIDTH + x) * 4
    return (mem.get_byte(pixels, at) + mem.get_byte(pixels, at + 1) + mem.get_byte(pixels, at + 2)) as float / 3.0
}

// The frame's detail with the backend's textures filtered across `texels`.
drawn(backend: *Backend, cam: *Camera, light: *Light, pixels_of: fn(ptr) -> ptr, context: ptr) -> float {
    i = 0
    while i < 3 {
        core.backend_render(backend, cam, light)
        i = i + 1
    }
    return detail(pixels_of(context))
}

gl_pixels(context: ptr) -> ptr { return offscreen.target_pixels(context) }

vulkan_pixels(context: ptr) -> ptr { return core.backend_frame_pixels(context as *Backend) }

camera() -> *Camera {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 1.7, 0.0))
    core.camera_set_far(cam, 1000.0)
    core.camera_look_at(cam, core.vec3(0.0, 1.2, 0.0 - 10.0))
    return cam
}

// Detail at 1 and at 16, OpenGL; -1 where there is no context.
opengl_detail() -> (float, float) {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  opengl: SKIP no OpenGL context available")
        return 0.0 - 1.0, 0.0 - 1.0
    }
    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, WIDTH, HEIGHT) {
        println("  opengl: SKIP the backend would not initialise")
        offscreen.context_destroy(context)
        return 0.0 - 1.0, 0.0 - 1.0
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    m = ground()
    core.backend_add_model(&backend, m)
    cam = camera()
    light = core.light_sun(core.vec3(0.2, 0.9, 0.3))
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)
    sharp = drawn(&backend, cam, light, gl_pixels, target)
    gl.renderer_set_anisotropy(renderer, 1.0)
    blurred = drawn(&backend, cam, light, gl_pixels, target)
    core.backend_remove_model(&backend, m)
    core.model_free(m)
    core.light_free(light)
    core.camera_free(cam)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)
    return blurred, sharp
}

opengl_checks() {
    blurred, sharp = opengl_detail()
    if blurred < 0.0 { return }
    println("  opengl: the band's detail ${blurred} filtered across 1 texel, ${sharp} across 16")
    check("opengl: across 16 texels the ground ahead keeps its detail (${sharp} against ${blurred})", sharp > blurred * 1.3)
    g_gl_sharp = sharp
}

var g_gl_sharp = 0.0 - 1.0

vulkan_checks() {
    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    m = ground()
    core.backend_add_model(&backend, m)
    cam = camera()
    light = core.light_sun(core.vec3(0.2, 0.9, 0.3))
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)
    vulkan.renderer_set_anisotropy(renderer, 16.0)
    sharp = drawn(&backend, cam, light, vulkan_pixels, (&backend) as ptr)
    vulkan.renderer_set_anisotropy(renderer, 1.0)
    blurred = drawn(&backend, cam, light, vulkan_pixels, (&backend) as ptr)
    println("  vulkan: the band's detail ${blurred} filtered across 1 texel, ${sharp} across 16")
    check("vulkan: across 16 texels the ground ahead keeps its detail (${sharp} against ${blurred})", sharp > blurred * 1.3)
    if g_gl_sharp > 0.0 {
        apart = sharp - g_gl_sharp
        if apart < 0.0 { apart = 0.0 - apart }
        check("and it is the detail OpenGL keeps (${sharp} against ${g_gl_sharp})", apart < g_gl_sharp * 0.1)
    }
    vulkan.renderer_set_anisotropy(renderer, 16.0)
    core.backend_remove_model(&backend, m)
    core.model_free(m)
    core.light_free(light)
    core.camera_free(cam)
    vulkan.renderer_free(renderer)
}

main() {
    println("anisotropy: the ground ahead, filtered across 1 texel and across 16")
    check("the checker registers", checker_texture())
    opengl_checks()
    vulkan_checks()
    if g_failures == 0 {
        println("anisotropy: all checks passed")
    } else {
        println("anisotropy: ${g_failures} failure(s)")
    }
}
