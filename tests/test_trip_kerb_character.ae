// ci: optimised -- nine trips at a run, each a fall and a get-up, CPU work -O0 makes several times slower
// A figure tripped at a run on a kerb (#922), on the pipeline: the UE5
// mannequin made a character (ae3d.character, on 100STYLE's gaits) running
// at 3.45 m/s (Siltreach's player's run) at a kerb 0.2 m high, set 3.0 to
// 4.0 m ahead so each trip comes at another moment of the stride. Each in an
// engine of its own, no window, stepped at 60 Hz. test_trip_kerb holds
// ae3d.motion's POWERED figure to the same, until #860 retires it.
//
// The trip: the legs drawn on the animation pass through what they meet (a
// kinematic body is not stopped by the static world), so a trip is the
// moment the drawn foot meets the kerb, and is answered with a knockdown
// (character.knock, no blow): its bodies let go at the velocity the run
// gives each (physanim.go_limp), the shins caught by the kerb, the body
// going on at 3.45 m/s over them. Then down (character.down) and up by the
// planned get-up (character.get_up, no motion). Held to test_get_up_kerb's
// numbers:
//
//   - it falls (its drawn pelvis under FALLEN of its standing height), gets
//     up, and the way up ends near upright: its trunk (pelvis to head),
//     once its stand is taken up after the get-up, under 0.1 rad off the
//     way it stands before it runs;
//   - handed back it stands where it rose: its capsule moves under 5 cm in
//     the second after, and it stands (character.standing);
//   - handed to the gaits it walks: asked to walk the way it faces for three
//     seconds it goes over a metre (its start and its walk), never falling
//     (its pelvis over FALLEN of its standing height);
//   - ten seconds on it stands, its pelvis at its standing height over the
//     ground under it (within 5 cm), on the kerb or beside it.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const GET_UP = "LayToIdle"
const RUN = 3.45
const KERB_HIGH = 0.2
const RUN_MOST = 300                  // steps it may run before it trips
const DOWN_MOST = 600                 // steps it may take to lie still
const UP_MOST = 600                   // steps the get-up may take
const BLEND = 0.4                     // s the get-up is eased in over
const FALLEN = 0.6                    // of its standing pelvis height: down
const TRIALS = 9

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Joint `slot`'s place in the world, the drawn pose read into `p`.
joint_at(r: *pose.Rig, p: ptr, w: ptr, slot: int) -> Vec3 {
    pose.world(r, p, w)
    return clips.ground_point(r, pose.translation(w, pose.human(r, slot)))
}

// How far the drawn trunk (pelvis to head) leans off straight up, radians.
trunk_lean(r: *pose.Rig, p: ptr, w: ptr) -> float {
    pose.read(r, p)
    d = core.v3_sub(joint_at(r, p, w, pose.HEAD), joint_at(r, p, w, pose.PELVIS))
    if core.v3_len(d) < 0.0001 { return 0.0 }
    return core.acos_of(core.clampf(d.y / core.v3_len(d), 0.0 - 1.0, 1.0))
}

// The drawn pelvis's height over the ground under it.
pelvis_up(e: *Engine, r: *pose.Rig, p: ptr, w: ptr) -> float {
    pose.read(r, p)
    at = joint_at(r, p, w, pose.PELVIS)
    hit = physics.ray_static_hit(physics.of(e), at, core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0)
    floor = 0.0
    if hit.hit { floor = hit.point.y }
    return at.y - floor
}

// Whether a drawn foot (its ankle or its ball) is in the kerb starting
// `near` metres ahead (+z): the legs caught.
caught(r: *pose.Rig, p: ptr, w: ptr, near: float) -> bool {
    pose.read(r, p)
    slots = [pose.FOOT_L, pose.FOOT_R, pose.BALL_L, pose.BALL_R]
    i = 0
    while i < 4 {
        at = joint_at(r, p, w, slots[i])
        if at.z >= near && at.y < KERB_HIGH { return true }
        i = i + 1
    }
    return false
}

// A trip with the kerb `near` metres ahead: its numbers checked.
trial(g: *Gaits, near: float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    kerb = engine.object(e, "Kerb", null)
    behaviour.object_set_position(kerb, core.vec3(0.0, KERB_HIGH * 0.5, near + 1.0))
    physics.box_collider(kerb, core.vec3(3.0, KERB_HIGH * 0.5, 1.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Runner", MANNEQUIN, g)
    if c == null || !character.physical(c) || character.get_up_add(c, GET_UP) < 0 {
        check("a character with physics and a get-up", false)
        return
    }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    p = pose.new(r)
    w = pose.new(r)
    k = 0
    while k < 30 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    stood_lean = trunk_lean(r, p, w)
    stood_up = pelvis_up(e, r, p, w)
    // Run at the kerb until a foot meets it, then the trip.
    tripped = false
    k = 0
    while k < RUN_MOST && !tripped {
        character.move(c, core.vec3(0.0, 0.0, RUN), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        if caught(r, p, w, near) { tripped = true }
        k = k + 1
    }
    ran = k
    pelvis = joint_at(r, p, w, pose.PELVIS)
    if tripped { tripped = character.knock(c, core.vec3(0.0, 0.0, 0.0), pelvis) }
    lowest = 10.0
    down = false
    k = 0
    while k < DOWN_MOST && tripped && !down {
        engine.engine_update(e, STEP)
        h = pelvis_up(e, r, p, w)
        if h < lowest { lowest = h }
        down = character.down(c)
        k = k + 1
    }
    fell = lowest < FALLEN * stood_up
    up = false
    if down { up = character.get_up(c, null, BLEND) >= 0 }
    k = 0
    while k < UP_MOST && up && character.acting(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    rose = up && !character.acting(c)
    at = behaviour.object_position(o)
    k = 0
    while k < 60 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Up and its stand taken up (character.ACT_OUT): LayToIdle's own last
    // frame leans 0.127 rad more than the stand does.
    lean = trunk_lean(r, p, w) - stood_lean
    moved = core.v3_len(core.vec3(behaviour.object_position(o).x - at.x, 0.0, behaviour.object_position(o).z - at.z))
    stands = character.standing(c)
    from = behaviour.object_position(o)
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.2))
    walk_low = 10.0
    k = 0
    while k < 180 {
        character.move(c, core.vec3(ahead.x, 0.0, ahead.z), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        h = pelvis_up(e, r, p, w)
        if h < walk_low { walk_low = h }
        k = k + 1
    }
    walked = core.v3_len(core.vec3(behaviour.object_position(o).x - from.x, 0.0, behaviour.object_position(o).z - from.z))
    k = 0
    while k < 600 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    later = pelvis_up(e, r, p, w)
    println("  the kerb ${near} m ahead: tripped ${tripped} after ${ran} steps, fell ${fell} (pelvis down to ${lowest} m of ${stood_up}), down ${down}, rose ${rose}; the way up ended ${lean} rad off how it stands; ${moved * 100.0} cm moved the second after, standing ${stands}; walked ${walked} m (pelvis down to ${walk_low}); ten seconds on its pelvis ${later} m up")
    check("the kerb ${near} m ahead: it trips, falls, gets up, the way up ending under 0.1 rad off how it stands", tripped && fell && rose && core.abs_of(lean) < 0.1)
    check("the kerb ${near} m ahead: it stands where it rose, moving under 5 cm the second after", rose && moved < 0.05 && stands)
    check("the kerb ${near} m ahead: handed back to the gaits it walks over a metre in three seconds, never falling", rose && walked > 1.0 && walk_low > FALLEN * stood_up)
    check("the kerb ${near} m ahead: ten seconds on it stands at its standing height", rose && core.abs_of(later - stood_up) < 0.05)
    pose.release(p)
    pose.release(w)
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

main() {
    println("trip_kerb_character: the mannequin run into a kerb at ${RUN} m/s, tripped, getting up on the pipeline (#922)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    count = core.env_int("AE3D_TRIPS", TRIALS)
    i = 0
    while i < count {
        trial(g, 3.0 + (i as float) * 0.125)
        i = i + 1
    }
    character.gaits_free(g)
    if g_failures == 0 {
        println("trip_kerb_character: all checks passed (${g_checks})")
        return
    }
    println("trip_kerb_character: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
