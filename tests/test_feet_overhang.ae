// A foot under something stands on what is under it (#934,
// physics.ground_below): the UE5 mannequin on 100STYLE's neutral gaits
// (ae3d.character, its capsule off) standing with its heels 6 cm under a
// bench's edge, the bench's underside 10 cm up, then walking away from it at
// 1.2 m/s. No window; stepped at 60 Hz. Read from 0.6 m over them, the heels'
// ground was the bench's top: the figure stood with its heels on the bench,
// 45 cm up, and as a heel rose into the bench's underside walking off, its
// right leg turned 74 rad/s. Siltreach's settler, stood up from a seat log
// with a heel in the gap under its rounded flank, read the flank as ground.
//
//   - standing, its heels are on the floor (within 1 cm);
//   - walking away, no sole goes more than 1 cm into the bench or the
//     ground (ae3d.metrics, a sole inside a solid counted);
//   - it walks away (2 m in 3 s);
//   - and no joint turns faster than it does walking off from the open
//     floor, by more than half again.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.mover
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
// The bench behind the heels: its underside UNDER up, its top TOP up, over
// the heels by OVER.
const UNDER = 0.1
const TOP = 0.45
const OVER = 0.06

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The mannequin standing 1 s at the origin facing +z, then walking ahead at
// 1.2 m/s for 3 s; a bench over its heels by OVER when `heels` is not 0
// (their z standing). Its heels' rearmost z standing and the higher heel's
// height, how far it went, the deepest a sole went into the ground or a
// solid, and the fastest joint turn walking off.
walk_off(heels: float) -> (float, float, float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    if heels != 0.0 {
        bench = engine.object(e, "Bench", null)
        behaviour.object_set_position(bench, core.vec3(0.0, (UNDER + TOP) * 0.5, heels + OVER - 0.3))
        physics.box_collider(bench, core.vec3(1.0, (TOP - UNDER) * 0.5, 0.3), physics.material(0.8, 0.0))
    }
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    character.capsule_off(c)
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0))
    behaviour.object_set_rotation(o, core.quat_ident())
    mover.settle(character.mover_of(c))
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    drawn = pose.new(r)
    worlds = pose.new(r)
    rearmost = 1000.0
    high_heel = 0.0
    ahead = core.vec3(0.0, 0.0, 1.2)
    k = 0
    while k < 240 {
        if k >= 60 { character.move(c, ahead, core.vec3(0.0, 0.0, 0.0)) }
        engine.engine_update(e, STEP)
        if k == 59 {
            pose.read(r, drawn)
            pose.world(r, drawn, worlds)
            side = 0
            while side < 2 {
                heel, _pad, _toe = ikrig.feet_soles(f, r, worlds, side)
                if heel.z < rearmost { rearmost = heel.z }
                if heel.y > high_heel { high_heel = heel.y }
                side = side + 1
            }
            metrics.meter_reset(m)
        }
        if k >= 60 { metrics.meter_take(m, STEP) }
        k = k + 1
    }
    went = behaviour.object_position(o).z
    into = metrics.meter_worst(m, metrics.INTO_GROUND)
    pop = metrics.meter_worst(m, metrics.POP)
    metrics.meter_free(m)
    pose.release(drawn)
    pose.release(worlds)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return rearmost, high_heel, went, into, pop
}

main() {
    println("feet_overhang: a foot under something stands on what is under it (#934)")
    heels, _open_heel, open_went, open_into, open_pop = walk_off(0.0)
    println("  from the open floor: its heels at z ${heels} m standing; it went ${open_went} m, a sole ${open_into * 1000.0} mm into the ground at most, the fastest joint ${open_pop} rad/s")
    _h, heel_up, went, into, pop = walk_off(heels)
    println("  from under a bench's edge (${OVER * 100.0} cm over its heels, ${UNDER * 100.0} cm up): its heels standing ${heel_up * 1000.0} mm up at most; it went ${went} m, a sole ${into * 1000.0} mm into the bench or the ground at most, the fastest joint ${pop} rad/s")
    check("standing with its heels under a bench's edge, they are on the floor (within 1 cm)", heel_up < 0.01)
    check("walking away from under a bench, no sole goes 1 cm into the bench or the ground", into < 0.01)
    check("it walks away (2 m in 3 s)", went > 2.0)
    check("no joint turns faster than walking off the open floor by more than half again", pop <= open_pop * 1.5)
    if g_failures == 0 {
        println("feet_overhang: all checks passed (${g_checks})")
        return
    }
    println("feet_overhang: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
