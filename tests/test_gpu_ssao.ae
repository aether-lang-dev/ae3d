// ae3d.shaders.ssao through ae3d.gpu: the occlusion written with `quote`,
// the first shader with matrices (shaderlib's mat4, mul) and with calls
// whose GLSL is the dialect's own (depth_clip, screen_y_sign).
//
//   - ssao comes out as the GLSL in tests/fixtures/gpu/ssao.frag for Vulkan
//     and ssao_gl.frag for OpenGL 4.1: two mat4s in the block, the depth as
//     its one sampler, its world_at and dither helpers as GLSL functions,
//     depth_clip and screen_y_sign as each dialect has them; glslang and
//     spirv-val pass it;
//   - the CPU back end runs it over the depth of a floor meeting a wall
//     under a real camera's matrices, against the same pass written as
//     Aether over ae3d.shaderlib: the pixels agree, the corner is occluded
//     and the open floor is not;
//   - run as OpenGL over the same depth stored as OpenGL stores it, it
//     rebuilds the same positions (the depth it reports in green).
//
// On a GPU, the pass is drawn when the occlusion is on: tests/test_ssao and
// tests/test_backend_parity. AE3D_GPU_WRITE_GOLDEN=1 writes the fixtures.
import std.os
import std.fs
import std.file
import std.list
import std.string
import std.heap
import std.lanes
import std.quote
import ae3d.core
import ae3d.core (Mat4, Vec3, Vec4)
import ae3d.gpu
import ae3d.shaders.ssao
import ae3d.shaderlib
import ae3d.shaderlib (vec2, vec3, vec4, mat4, Texture, ShaderImage, texture, frag_coord, set_frag_coord, mul, xyz,
                       normalize, cross, distance, abs, max, clamp, mix, smoothstep, screen_y_sign,
                       image_new, image_set, image_channel, image_free, texture_of, mat4_of)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }

// glslang -V over `text` (as `stage`), then spirv-val; or, for desktop
// OpenGL's GLSL (`opengl`), glslang's check of it. Skipped where they are
// not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the fixture at `path`; AE3D_GPU_WRITE_GOLDEN=1 writes it.
golden_is(text: string, path: string) {
    if os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    golden, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == golden)
    if text != golden {
        println("--- emitted ---")
        println(text)
    }
}


const W = 128
const H = 72
const RADIUS = 0.6
const INTENSITY = 1.5

fn f2(v: vec2) -> f32x4 { return v as f32x4 }
fn f3(v: vec3) -> f32x4 { return v as f32x4 }
fn f4(v: vec4) -> f32x4 { return v as f32x4 }

// The pass written as Aether, step for step as the quote is.
reference(depth: Texture, size: vec2, inv: mat4, vp: mat4, eye_at: vec3) -> vec4 {
    fc = f2(frag_coord())
    s2 = f2(size)
    uv = vec2(fc.x / s2.x, fc.y / s2.y)
    d = f4(texture(depth, uv)).x
    p = ssao.world_at(inv, uv, d)
    if d >= 0.99999 || INTENSITY <= 0.0 { return vec4(vec3(1.0, 0.0, 0.0), 1.0) }
    px = f2(vec2(1.0 / s2.x, 1.0 / s2.y))
    ul = (f2(uv) - f2(vec2(px.x, 0.0))) as vec2
    dl = f4(texture(depth, ul)).x
    pl = ssao.world_at(inv, ul, dl)
    ur = (f2(uv) + f2(vec2(px.x, 0.0))) as vec2
    dr = f4(texture(depth, ur)).x
    pr = ssao.world_at(inv, ur, dr)
    above = vec2(0.0, px.y * screen_y_sign())
    ud = (f2(uv) - f2(above)) as vec2
    dd = f4(texture(depth, ud)).x
    pd = ssao.world_at(inv, ud, dd)
    uu = (f2(uv) + f2(above)) as vec2
    du = f4(texture(depth, uu)).x
    pu = ssao.world_at(inv, uu, du)
    dx = (f3(pr) - f3(p)) as vec3
    if abs(dl - d) < abs(dr - d) { dx = (f3(p) - f3(pl)) as vec3 }
    dy = (f3(pu) - f3(p)) as vec3
    if abs(dd - d) < abs(du - d) { dy = (f3(p) - f3(pd)) as vec3 }
    n = normalize(cross(dx, dy))
    eye = distance(eye_at, p)
    up = vec3(1.0, 0.0, 0.0)
    if abs(f3(n).y) < 0.99 { up = vec3(0.0, 1.0, 0.0) }
    t = normalize(cross(up, n))
    b = cross(n, t)
    pixel = vec2(fc.x, fc.y)
    if screen_y_sign() < 0.0 { pixel = vec2(fc.x, s2.y - fc.y) }
    turn = ssao.dither(pixel) * 6.2831853
    occlusion = 0.0
    i = 0.0
    while i < 12.0 {
        f = (i + 0.5) / 12.0
        i = i + 1.0
        a = turn + f * 15.0796
        r = shaderlib.sqrt(f)
        h = shaderlib.sqrt(1.0 - r * r)
        dir = f3(t) * lanes.splat4(shaderlib.cos(a) * r) + f3(b) * lanes.splat4(shaderlib.sin(a) * r) + f3(n) * lanes.splat4(h)
        reach = RADIUS * mix(0.1, 1.0, f * f)
        s = (f3(p) + dir * lanes.splat4(reach)) as vec3
        clip = f4(mul(vp, vec4(s, 1.0)))
        if clip.w <= 0.0 { continue }
        suv = vec2(clip.x / clip.w * 0.5 + 0.5, clip.y / clip.w * 0.5 + 0.5)
        q = f2(suv)
        if q.x < 0.0 || q.x > 1.0 || q.y < 0.0 || q.y > 1.0 { continue }
        sd = f4(texture(depth, suv)).x
        scene_dist = distance(eye_at, ssao.world_at(inv, suv, sd))
        sample_dist = distance(eye_at, s)
        if sample_dist - scene_dist > 0.03 * reach + eye * 0.01 {
            occlusion = occlusion + smoothstep(0.0, 1.0, RADIUS / max(abs(eye - scene_dist), 0.0001))
        }
    }
    occlusion = occlusion / 12.0
    ao = clamp(1.0 - occlusion * INTENSITY, 0.0, 1.0)
    ao = mix(ao, 1.0, smoothstep(RADIUS * 40.0, RADIUS * 120.0, eye))
    return vec4(vec3(ao, f4(mul(vp, vec4(p, 1.0))).w, 0.0), 1.0)
}

// An OpenGL-shaped matrix as the Vulkan renderer puts it in its block
// (vkdesc.clip_correct): clip y down, z in 0..1.
vulkan_clip(m: Mat4) -> Mat4 {
    return Mat4 {
        m0: m.m0, m1: 0.0 - m.m1, m2: 0.5 * (m.m2 + m.m3), m3: m.m3,
        m4: m.m4, m5: 0.0 - m.m5, m6: 0.5 * (m.m6 + m.m7), m7: m.m7,
        m8: m.m8, m9: 0.0 - m.m9, m10: 0.5 * (m.m10 + m.m11), m11: m.m11,
        m12: m.m12, m13: 0.0 - m.m13, m14: 0.5 * (m.m14 + m.m15), m15: m.m15
    }
}

// The world point at clip-space x, y, z: through the inverse, divided by w.
unproject(inv: Mat4, x: float, y: float, z: float) -> Vec3 {
    v = core.mat4_mul_v4(inv, Vec4 { x: x, y: y, z: z, w: 1.0 })
    return core.vec3(v.x / v.w, v.y / v.w, v.z / v.w)
}

// The depth a camera sees of a floor (y = 0) meeting a wall (x = 1), the
// sky past them: each pixel's ray from the inverse view-projection, its
// hit's clip z over w stored as it is (Vulkan's), or as OpenGL stores it
// ((z + 1) / 2) when `gl`.
make_depth(vp: Mat4, inv: Mat4, gl: bool) -> *ShaderImage {
    img = image_new(W, H)
    y = 0
    while y < H {
        x = 0
        while x < W {
            nx = (x + 0.5) / W * 2.0 - 1.0
            ny = (y + 0.5) / H * 2.0 - 1.0
            a = unproject(inv, nx, ny, -1.0)
            b = unproject(inv, nx, ny, 1.0)
            dx = b.x - a.x
            dy = b.y - a.y
            dz = b.z - a.z
            best = 2.0
            if dy < 0.0 && a.y > 0.0 { best = a.y / (0.0 - dy) }
            if dx > 0.0 && a.x < 1.0 {
                tw = (1.0 - a.x) / dx
                if tw < best && a.y + dy * tw > 0.0 { best = tw }
            }
            d = 1.0
            if best <= 1.0 {
                hit = core.vec3(a.x + dx * best, a.y + dy * best, a.z + dz * best)
                cx_ = vp.m0 * hit.x + vp.m4 * hit.y + vp.m8 * hit.z + vp.m12
                cz = vp.m2 * hit.x + vp.m6 * hit.y + vp.m10 * hit.z + vp.m14
                cw = vp.m3 * hit.x + vp.m7 * hit.y + vp.m11 * hit.z + vp.m15
                d = cz / cw
                if gl { d = (d + 1.0) * 0.5 }
                if cx_ > 1000000.0 { d = 1.0 }
            }
            image_set(img, x, y, d, 0.0, 0.0, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

main() {
    println("ae3d.gpu: ssao written with quote")
    proj = core.mat4_perspective(1.0, W * 1.0 / H, 0.1, 50.0)
    eye = core.vec3(-1.5, 1.2, 3.0)
    view = core.mat4_look_at(eye, core.vec3(0.8, 0.2, -1.0), core.vec3(0.0, 1.0, 0.0))
    // OpenGL's matrices, and Vulkan's as its renderer has them.
    vpm = core.mat4_mul(proj, view)
    invm = core.mat4_inverse(vpm)
    vkm = vulkan_clip(vpm)
    vk_invm = core.mat4_inverse(vkm)
    vp = mat4_of(&vkm)
    inv = mat4_of(&vk_invm)
    gl_vp = mat4_of(&vpm)
    gl_inv = mat4_of(&invm)
    eye3 = vec3(eye.x, eye.y, eye.z)
    size = vec2(W * 1.0, H * 1.0)
    depth = make_depth(vkm, vk_invm, false)

    s = ssao.ssao(texture_of(depth), size, RADIUS, INTENSITY, inv, vp, eye3)
    check("two mat4s in the block, the depth its one sampler",
          gpu.params_count(s) == 6 && gpu.samplers_count(s) == 1 && gpu.samplers_name(s, 0) == "depth")
    frag = gpu.emit_glsl(s, gpu.VULKAN)
    if frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(frag, "tests/fixtures/gpu/ssao.frag")
    check("mul as a matrix product, the dialect's depth and y as Vulkan's",
          string.contains(frag, "mat4 inv_view_projection;") != 0 &&
          string.contains(frag, "(inv_view_projection * vec4(vec3(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, depth), 1.0))") != 0 &&
          string.contains(frag, "px.y * (-1.0)") != 0)
    compiles("ssao", frag, "frag", false)
    compiles("ssao", gpu.emit_screen_vertex(s, gpu.VULKAN), "vert", false)
    gl_frag = gpu.emit_glsl(s, gpu.GL)
    if gl_frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(gl_frag, "tests/fixtures/gpu/ssao_gl.frag")
    check("and OpenGL's as OpenGL's",
          string.contains(gl_frag, "(depth * 2.0 - 1.0)") != 0 && string.contains(gl_frag, "px.y * 1.0") != 0)
    compiles("ssao_gl", gl_frag, "frag", true)

    // ── The CPU against the pass written as Aether ──
    cx = gpu.cpu_new(s)
    gpu.cpu_set_viewport(cx, W, H)
    agree = 0
    worst = 0.0
    corner = 1.0
    open_floor = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            uv = gpu.v2((x + 0.5) / W, (y + 0.5) / H)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            set_frag_coord(x + 0.5, y + 0.5)
            want = f4(reference(texture_of(depth), size, inv, vp, eye3))
            if got != null {
                d = max(absf(gpu.val_x(got) - want.x), absf(gpu.val_y(got) - want.y) / (1.0 + absf(want.y)))
                if d < 0.0001 { agree = agree + 1 }
                if d > worst { worst = d }
                if gpu.val_x(got) < corner { corner = gpu.val_x(got) }
                // A surface (not the sky's 1, 0) left unoccluded.
                if gpu.val_y(got) != 0.0 && gpu.val_x(got) > 0.98 { open_floor = open_floor + 1 }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            x = x + 1
        }
        y = y + 1
    }
    // The evaluator holds every value as an f32, as a GPU does; the
    // reference here keeps its scalars in doubles, so where a sample sits
    // right at the occlusion test's edge the two can round to either side
    // of it, by a few ten-thousandths of the pixel's light at most.
    check("the CPU runs it as the pass written as Aether does (${agree} of ${W * H} within 1e-4, worst ${worst})",
          worst < 0.001 && agree * 1000 >= W * H * 999)
    check("the corner where the wall meets the floor is occluded (darkest ${corner})", corner < 0.7)
    check("and the open floor is not (${open_floor} pixels unoccluded)", open_floor > W)
    gpu.cpu_free(cx)

    // ── OpenGL's dialect over OpenGL's stored depth and matrices: the same
    // positions, the image upside down (OpenGL's screen y runs up) ──
    gl_depth = make_depth(vpm, invm, true)
    gs = ssao.ssao(texture_of(gl_depth), size, RADIUS, INTENSITY, gl_inv, gl_vp, eye3)
    gcx = gpu.cpu_new(gs)
    gpu.cpu_set_viewport(gcx, W, H)
    gpu.cpu_set_dialect(gcx, gpu.GL)
    vcx = gpu.cpu_new(s)
    gpu.cpu_set_viewport(vcx, W, H)
    same = 0
    surfaces = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            if image_channel(depth, x, y, 0) < 0.99999 {
                surfaces = surfaces + 1
                uv = gpu.v2((x + 0.5) / W, (y + 0.5) / H)
                flipped = gpu.v2((x + 0.5) / W, (H - y - 0.5) / H)
                b = gpu.cpu_run(vcx, uv)
                a = gpu.cpu_run(gcx, flipped)
                heap.free(uv)
                heap.free(flipped)
                if a != null && b != null {
                    if absf(gpu.val_y(a) - gpu.val_y(b)) < 0.0001 * (1.0 + absf(gpu.val_y(b))) { same = same + 1 }
                }
                if a != null { heap.free(a) }
                if b != null { heap.free(b) }
            }
            x = x + 1
        }
        y = y + 1
    }
    check("run as OpenGL over OpenGL's depth, the same positions (${same} of ${surfaces})", surfaces > 0 && same == surfaces)
    gpu.cpu_free(gcx)
    gpu.cpu_free(vcx)
    gpu.shader_free(gs)
    gpu.shader_free(s)
    image_free(gl_depth)
    image_free(depth)
    if g_failures > 0 {
        println("ssao: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("ssao: all checks passed (${g_checks})")
}
