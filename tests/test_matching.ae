// Motion matching (#586), held to numbers: the Fox fixture (Survey, Walk,
// Run) at a metre long, no window, stepped at 60 Hz. Its clips are the
// database; a stick is pushed: standing, to a walk, to a run, let go, and
// sent off to the side.
//
//   - the database finds the fox's feet and its clips' own speeds;
//   - each stretch plays the clip its speed asks for: Survey standing, Walk
//     walking, Run running;
//   - over a stretch walking or running straight, whole cycles, the foot on
//     the ground drifts along the way under 3% of the body's way;
//   - no bone turns more than 30 degrees in a frame through every change,
//     at the clip's own pace (the clips' own most is 25, a cut 89): a walk
//     the body is still too fast for plays faster, up to 1.5 times, and its
//     bones turn as much faster;
//   - the facing turns smoothly toward the way it is sent, no more than 4
//     degrees in a frame;
//   - contacts (#593): walking, each foot is labelled down part of each
//     cycle and the feet take turns; a foot labelled down stays within 3 cm
//     of where it was set; standing, every foot is down;
//   - a second matcher read from the first's state (#594), between changes,
//     and driven with the same input poses its own fox the same to the bit,
//     through a walk, a run and a stop;
//   - the search (#588) finds the same frame as brute force every frame,
//     and 2,000 of them take a measured time against brute force's;
//   - a game's own animator (#636): a clip made at run time and given to
//     the figure (figure.add_clip) enters the database, and a matcher
//     answering the animator -- told the body's state and the animator's
//     clock -- answers a walk to a body walking, at a pace of 0.5 to 1.5,
//     and poses nothing: the figure's own clip and time are as they were.

import std.os
import ae3d.core
import ae3d.skin
import ae3d.figure
import ae3d.matching
import ae3d.anim

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const FOX = "tests/fixtures/gltf/Fox.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Watch {
    bones: int
    last: ptr                        // float[bones * 7]: world place, local rotation
    now: ptr
    stance: int                      // the foot on the ground last frame, or -1
    drift: Vec3                      // its way over the ground, summed, along a stretch
    went: float                      // and the body's
    last_body: Vec3
    worst_turn: float                // a bone's turn in a frame, over the pace its clip plays at (at least 1)
    worst_heading: float
    last_heading: float
    frames: int
    walk_frames: int                 // frames of a stretch playing each clip
    run_frames: int
    idle_frames: int
    stretch: int                     // frames in the stretch
    compared: int                    // searches checked against brute force
    differed: int                    // and how many found another frame
    // Contacts (#593), over a stretch.
    down_frames: ptr                 // int[FEET]: frames each foot was labelled down
    was_down: ptr                    // int[FEET]: down last frame
    down_from: ptr                   // float[FEET * 3]: where it was set down
    worst_planted: float             // the most a foot labelled down moved from where it was set
    none_down: int                   // frames with no foot down
    all_down: int                    // frames with every foot down
}

read(w: *Watch, sk: *Skeleton, into: ptr) {
    p = into as float[]
    i = 0
    while i < w.bones {
        b = skin.skeleton_bone(sk, i)
        core.model_sync_transform(b)
        p[i * 7] = b.world_position.x
        p[i * 7 + 1] = b.world_position.y
        p[i * 7 + 2] = b.world_position.z
        p[i * 7 + 3] = b.rotation.x
        p[i * 7 + 4] = b.rotation.y
        p[i * 7 + 5] = b.rotation.z
        p[i * 7 + 6] = b.rotation.w
        i = i + 1
    }
}

wrap(a: float) -> float {
    x = a
    while x > 3.14159265 { x = x - 6.2831853 }
    while x < 0.0 - 3.14159265 { x = x + 6.2831853 }
    return x
}

// A frame: stepped, then measured.
frame(m: *Matcher, db: *Database, w: *Watch, sk: *Skeleton, input: Vec3, watching: bool) {
    matching.set_input(m, input)
    matching.step(m, STEP)
    // The search against brute force, from where the figure is now.
    w.compared = w.compared + 1
    if matching.search(m) != matching.search_brute(m) { w.differed = w.differed + 1 }
    pace = figure.speed(figure_of_db(db))
    if pace < 1.0 { pace = 1.0 }
    read(w, sk, w.now)
    a = w.last as float[]
    b = w.now as float[]
    if w.frames > 0 {
        i = 0
        while i < w.bones {
            d = core.abs_of(a[i * 7 + 3] * b[i * 7 + 3] + a[i * 7 + 4] * b[i * 7 + 4] + a[i * 7 + 5] * b[i * 7 + 5] + a[i * 7 + 6] * b[i * 7 + 6])
            if d > 1.0 { d = 1.0 }
            t = 2.0 * core.acos_of(d) / pace
            if t > w.worst_turn { w.worst_turn = t }
            i = i + 1
        }
        dh = core.abs_of(wrap(matching.heading(m) - w.last_heading))
        if dh > w.worst_heading { w.worst_heading = dh }
    }
    w.last_heading = matching.heading(m)
    // The foot on the ground: the lowest of the database's feet.
    lowest = 0 - 1
    i = 0
    while i < w.bones {
        if is_foot(db, i) && (lowest < 0 || b[i * 7 + 1] < b[lowest * 7 + 1]) { lowest = i }
        i = i + 1
    }
    body = matching.position(m)
    if watching && w.stance >= 0 {
        s = w.stance
        w.drift = core.v3_add(w.drift, core.vec3(b[s * 7] - a[s * 7], 0.0, b[s * 7 + 2] - a[s * 7 + 2]))
        w.went = w.went + core.v3_len(core.v3_sub(body, w.last_body))
    }
    if watching {
        any = false
        every = true
        f = 0
        while f < matching.FEET {
            bone = matching.foot_bone(db, f)
            down = bone >= 0 && matching.contact(m, f)
            downs = w.down_frames as int[]
            was = w.was_down as int[]
            from = w.down_from as float[]
            if bone >= 0 {
                if down {
                    any = true
                    downs[f] = downs[f] + 1
                    if was[f] == 0 {
                        from[f * 3] = b[bone * 7]
                        from[f * 3 + 2] = b[bone * 7 + 2]
                    } else {
                        moved = core.v3_len(core.vec3(b[bone * 7] - from[f * 3], 0.0, b[bone * 7 + 2] - from[f * 3 + 2]))
                        if moved > w.worst_planted { w.worst_planted = moved }
                    }
                    was[f] = 1
                } else {
                    every = false
                    was[f] = 0
                }
            }
            f = f + 1
        }
        if !any { w.none_down = w.none_down + 1 }
        if every { w.all_down = w.all_down + 1 }
        w.stretch = w.stretch + 1
        clip = matching.playing_clip(m)
        if clip == "Walk" { w.walk_frames = w.walk_frames + 1 }
        if clip == "Run" { w.run_frames = w.run_frames + 1 }
        if clip == "Survey" { w.idle_frames = w.idle_frames + 1 }
    }
    w.stance = lowest
    w.last_body = body
    tmp = w.last
    w.last = w.now
    w.now = tmp
    w.frames = w.frames + 1
}

figure_of_db(db: *Database) -> *Figure { return db.figure as *Figure }

is_foot(db: *Database, bone: int) -> bool {
    // The database's feet are its first features' bones; ask it.
    return matching_foot(db, bone)
}

matching_foot(db: *Database, bone: int) -> bool {
    feet = db.feet as int[]
    i = 0
    while i < matching.FEET {
        if feet[i] == bone { return true }
        i = i + 1
    }
    return false
}

reset(w: *Watch) {
    w.drift = core.vec3(0.0, 0.0, 0.0)
    w.went = 0.0
    w.walk_frames = 0
    w.run_frames = 0
    w.idle_frames = 0
    w.stretch = 0
    w.worst_planted = 0.0
    w.none_down = 0
    w.all_down = 0
    f = 0
    while f < matching.FEET {
        (w.down_frames as int[])[f] = 0
        (w.was_down as int[])[f] = 0
        f = f + 1
    }
}

// Whole cycles of the playing clip, as near `seconds` as they come: a part
// cycle leaves part of a stride's drift.
cycles(fig: *Figure, seconds: float) -> float {
    cycle = figure.duration(fig) / figure.speed(fig)
    count = (seconds / cycle + 0.5) as int
    if count < 1 { count = 1 }
    return cycle * (count as float)
}

run_for(m: *Matcher, db: *Database, w: *Watch, sk: *Skeleton, input: Vec3, seconds: float, watching: bool) {
    k = 0
    while k < (seconds / STEP) as int {
        frame(m, db, w, sk, input, watching)
        k = k + 1
    }
}

// A rest pose made at run time, rotations only, as the clip "Made".
add_made(fig: *Figure) -> bool {
    sk = figure.skeleton(fig)
    all = true
    i = 0
    while i < skin.skeleton_count(sk) {
        bone = skin.skeleton_bone(sk, i)
        name = core.text(bone.name)
        c = anim.clip_new("Made:${name}")
        ch = anim.channel_new(anim.ROTATION, anim.LINEAR)
        q = bone.rotation
        anim.channel_add_key(ch, 0.0, q.x, q.y, q.z, q.w)
        anim.channel_add_key(ch, 1.0, q.x, q.y, q.z, q.w)
        anim.clip_add_channel(c, ch)
        if !figure.add_clip(fig, "Made", c, name) {
            all = false
            anim.clip_free(c)
        }
        i = i + 1
    }
    return all
}

// A matcher answering a game's animator (#636), over a database with a clip
// made at run time: a second of a body walking at the walk's own speed.
answering(walk: float) {
    group = core.model_new()
    core.model_set_scale(group, 0.01, 0.01, 0.01)
    fig = figure.figure_new(FOX, group)
    made = add_made(fig)
    db = matching.database_new(fig, group)
    added = matching.add_clip(db, "Survey") && matching.add_clip(db, "Walk") && matching.add_clip(db, "Run") && matching.add_clip(db, "Made")
    built = matching.build(db)
    check("a clip made at run time enters the database", made && added && built)
    figure.play(fig, "Survey", 1.0, true)
    figure.advance(fig, STEP)
    held_time = figure.time(fig)
    m = matching.matcher_new(db)
    going = core.vec3(0.0, 0.0, walk)
    clock = 0.0
    at = core.vec3(0.0, 0.0, 0.0)
    first = false
    worst_pace = 1.0
    least_pace = 1.0
    k = 0
    while k < 60 {
        changed = matching.answer(m, at, going, going, 0.0, clock, STEP)
        if k == 0 { first = changed }
        if changed {
            clock = matching.playing_time(m)
        } else {
            clock = clock + STEP * matching.pace(m)
        }
        if matching.pace(m) > worst_pace { worst_pace = matching.pace(m) }
        if matching.pace(m) < least_pace { least_pace = matching.pace(m) }
        at = core.v3_add(at, core.v3_mul(going, STEP))
        k = k + 1
    }
    println("  answering: ${matching.playing_clip(m)} at ${matching.playing_time(m)} s, paced ${least_pace} to ${worst_pace}; the figure still ${figure.clip(fig)} at ${figure.time(fig)} s")
    check("answering a body walking, it answers a walk, paced 0.5 to 1.5", first && matching.playing_clip(m) == "Walk" && least_pace >= 0.5 && worst_pace <= 1.5)
    check("and poses nothing: the figure's clip and time are as they were", figure.clip(fig) == "Survey" && figure.time(fig) == held_time)
    matching.matcher_free(m)
    matching.database_free(db)
    figure.figure_free(fig)
}

main() {
    println("matching: motion matching on the fox (#586)")
    group = core.model_new()
    core.model_set_scale(group, 0.01, 0.01, 0.01)
    fig = figure.figure_new(FOX, group)
    if fig == null {
        println("matching: SKIP ${FOX} would not load")
        return
    }
    db = matching.database_new(fig, group)
    added = matching.add_clip(db, "Survey") && matching.add_clip(db, "Walk") && matching.add_clip(db, "Run")
    built = matching.build(db)
    walk = matching.clip_speed(db, 1)
    run = matching.clip_speed(db, 2)
    println("  ${matching.frames(db)} frames, ${matching.feet_found(db)} feet; the clips' own speeds: Survey ${matching.clip_speed(db, 0)}, Walk ${walk}, Run ${run} m/s")
    check("the database is built from the fox's three clips, its feet found", added && built && matching.frames(db) > 100 && matching.feet_found(db) >= 2)
    check("its walk and run have speeds of their own, the run the faster", walk > 0.3 && run > walk * 1.3)

    sk = figure.skeleton(fig)
    n = skin.skeleton_count(sk)
    w = Watch { bones: n, last: calloc(n * 7, 8), now: calloc(n * 7, 8), stance: 0 - 1, drift: core.vec3(0.0, 0.0, 0.0),
                went: 0.0, last_body: core.vec3(0.0, 0.0, 0.0), worst_turn: 0.0, worst_heading: 0.0, last_heading: 0.0,
                frames: 0, walk_frames: 0, run_frames: 0, idle_frames: 0, stretch: 0, compared: 0, differed: 0,
                down_frames: calloc(matching.FEET, 4), was_down: calloc(matching.FEET, 4), down_from: calloc(matching.FEET * 3, 8),
                worst_planted: 0.0, none_down: 0, all_down: 0 }
    m = matching.matcher_new(db)
    ahead = core.vec3(0.0, 0.0, 1.0)

    // Standing.
    reset(&w)
    run_for(m, db, &w, sk, core.vec3(0.0, 0.0, 0.0), 1.0, true)
    idle_share = (w.idle_frames as float) / (w.stretch as float)
    standing_all_down = (w.all_down as float) / (w.stretch as float)
    // Walking: settled first, then watched.
    run_for(m, db, &w, sk, core.v3_mul(ahead, walk), 1.5, false)
    reset(&w)
    run_for(m, db, &w, sk, core.v3_mul(ahead, walk), cycles(fig, 2.0), true)
    walk_share = (w.walk_frames as float) / (w.stretch as float)
    walk_drift = core.abs_of(core.v3_dot(w.drift, ahead)) / w.went
    walk_planted = w.worst_planted
    walk_none = w.none_down
    walk_all = w.all_down
    walk_frames_count = w.stretch
    least_share = 1.0
    most_share = 0.0
    f = 0
    while f < matching.feet_found(db) {
        share = ((w.down_frames as int[])[f] as float) / (w.stretch as float)
        if share < least_share { least_share = share }
        if share > most_share { most_share = share }
        f = f + 1
    }
    // Running.
    run_for(m, db, &w, sk, core.v3_mul(ahead, run), 1.5, false)
    reset(&w)
    run_for(m, db, &w, sk, core.v3_mul(ahead, run), cycles(fig, 2.0), true)
    run_share = (w.run_frames as float) / (w.stretch as float)
    run_drift = core.abs_of(core.v3_dot(w.drift, ahead)) / w.went
    // Let go, then sent off to the side.
    run_for(m, db, &w, sk, core.vec3(0.0, 0.0, 0.0), 1.5, false)
    stopped = core.v3_len(matching.velocity(m))
    run_for(m, db, &w, sk, core.vec3(walk, 0.0, 0.0), 2.0, false)
    facing = matching.heading(m)

    println("  standing it played Survey ${idle_share * 100.0}% of the time, walking Walk ${walk_share * 100.0}%, running Run ${run_share * 100.0}%; ${matching.switches(m)} changes in ${matching.searches(m)} searches")
    println("  the foot on the ground drifted ${walk_drift * 100.0}% of the body's way walking, ${run_drift * 100.0}% running")
    println("  the most a bone turned in a frame, at its clip's own pace: ${w.worst_turn * 57.29578} degrees; the facing ${w.worst_heading * 57.29578} degrees; let go, ${stopped} m/s; sent along +x it faces ${facing} rad (+x is 1.571)")
    check("each stretch plays the clip its speed asks for (over 80% of it)", idle_share > 0.8 && walk_share > 0.8 && run_share > 0.8)
    check("walking and running, the foot on the ground drifts along the way under 3% of the body's way", walk_drift < 0.03 && run_drift < 0.03)
    check("no bone turns more than 30 degrees in a frame at its clip's own pace, through every change", w.worst_turn < 0.5236)
    check("the facing turns toward the way it is sent, no more than 4 degrees a frame", w.worst_heading < 0.07 && core.abs_of(facing - 1.5708) < 0.1)
    check("let go, it stops", stopped < 0.05)
    println("  contacts: walking each foot down ${least_share * 100.0}% to ${most_share * 100.0}% of the time, ${walk_none} of ${walk_frames_count} frames with none down (the fox's walk slides as its feet land), ${walk_all} with all down; a foot labelled down moved ${walk_planted * 100.0} cm at most; standing, every foot down ${standing_all_down * 100.0}% of the time")
    check("walking, each foot is down part of the time and up the rest, and the feet take turns (never all down)", least_share > 0.2 && most_share < 0.85 && walk_all == 0)
    check("a foot labelled down stays where it was set (under 3 cm)", walk_planted < 0.03)
    check("standing still, every foot is down", standing_all_down > 0.95)

    // A host's state read by a client (#594): a second fox, its own database
    // from the same clips, its matcher read from the first's state at a
    // moment between changes; then both driven alike, every bone compared.
    group2 = core.model_new()
    core.model_set_scale(group2, 0.01, 0.01, 0.01)
    fig2 = figure.figure_new(FOX, group2)
    db2 = matching.database_new(fig2, group2)
    matching.add_clip(db2, "Survey")
    matching.add_clip(db2, "Walk")
    matching.add_clip(db2, "Run")
    matching.build(db2)
    m2 = matching.matcher_new(db2)
    waited = 0
    run_for(m, db, &w, sk, core.v3_mul(ahead, walk), 0.5, false)
    while figure.blending(fig) && waited < 120 {
        frame(m, db, &w, sk, core.v3_mul(ahead, walk), false)
        waited = waited + 1
    }
    state = calloc(matching.STATE_FLOATS, 8)
    matching.state_write(m, state as float[])
    matching.state_read(m2, state as float[])
    sk2 = figure.skeleton(fig2)
    differ = 0
    frames_compared = 0
    k = 0
    while k < 240 {
        input = core.v3_mul(ahead, walk)
        if k >= 60 { input = core.v3_mul(ahead, run) }
        if k >= 150 { input = core.vec3(0.0, 0.0, 0.0) }
        matching.set_input(m, input)
        matching.step(m, STEP)
        matching.set_input(m2, input)
        matching.step(m2, STEP)
        i = 0
        while i < n {
            a1 = skin.skeleton_bone(sk, i)
            a2 = skin.skeleton_bone(sk2, i)
            if a1.rotation.x != a2.rotation.x || a1.rotation.y != a2.rotation.y || a1.rotation.z != a2.rotation.z || a1.rotation.w != a2.rotation.w ||
               a1.position.x != a2.position.x || a1.position.y != a2.position.y || a1.position.z != a2.position.z {
                differ = differ + 1
            }
            i = i + 1
        }
        frames_compared = frames_compared + 1
        k = k + 1
    }
    println("  a matcher read from another's state (${matching.STATE_FLOATS * 8} bytes) and driven alike: ${differ} bone-frames differ in ${frames_compared} frames of ${n} bones, through walk, run and stop")
    check("a client read from the host's state poses its figure as the host does, to the bit", differ == 0 && frames_compared == 240)
    free(state)
    matching.matcher_free(m2)
    matching.database_free(db2)
    figure.figure_free(fig2)
    core.model_free(group2)

    // What a search costs (#588), against brute force, from a figure
    // walking: the fastest of five runs of 2,000.
    run_for(m, db, &w, sk, core.v3_mul(ahead, walk), 1.0, false)
    fast = 1000000000.0
    slow = 1000000000.0
    r = 0
    while r < 5 {
        started = os.now_monotonic_ns()
        k = 0
        while k < 2000 {
            matching.search(m)
            k = k + 1
        }
        t = (os.now_monotonic_ns() - started) as float
        if t < fast { fast = t }
        started = os.now_monotonic_ns()
        k = 0
        while k < 2000 {
            matching.search_brute(m)
            k = k + 1
        }
        t = (os.now_monotonic_ns() - started) as float
        if t < slow { slow = t }
        r = r + 1
    }
    println("  over ${matching.frames(db)} frames, 2,000 searches: ${fast / 1000000.0} ms, brute force ${slow / 1000000.0} ms; ${w.differed} of ${w.compared} searches found another frame than brute force")
    check("the search finds the frame brute force does, every time", w.differed == 0 && w.compared > 500)
    check("and is faster than brute force", fast < slow)

    free(w.last)
    free(w.now)
    free(w.down_frames)
    free(w.was_down)
    free(w.down_from)
    matching.matcher_free(m)
    matching.database_free(db)

    answering(walk)
    figure.figure_free(fig)
    core.model_free(group)
    if g_failures == 0 {
        println("matching: all checks passed (${g_checks})")
        return
    }
    println("matching: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
