// The global illumination's tiers (#537): on Vulkan where the device
// traces, the probes' light (GI_RT) -- the sky's light and its bounces,
// traced -- against the sky's light alone (GI_SKY) and none (GI_OFF).
//
// A white wall stands on a red floor under a black sky and a sun straight
// overhead: the wall's face takes no sun and there is no sky, so all that
// lights it is the sun off the floor. The probes bring that bounce, red;
// the sky's tier, which knows nothing of the floor, leaves the face black.
// Then a sealed room under a grey sky: the sky's tier lights its inside as
// though the walls were not there; the probes, which see the walls, leave
// it dark, and say so when asked; and a glowing panel inside it lights it
// in its colour. And the tiers report what is in effect: GI_AUTO is the
// sky's on a software rasterizer, which would trace a frame's probes in
// seconds.
//
// Skips where there is no Vulkan or no ray query, as test_ray_shadows does.

import std.mem
import ae3d.core
import ae3d.vulkan
import ae3d.vkdevice
import ae3d.loader
import ae3d.rendering

const WIDTH = 160
const HEIGHT = 120

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// The frame after `frames` of them: the probes trace every one, and a
// bounce off a probe's hit is the light the probes gathered the frame
// before.
read_after(backend: *Backend, cam: *Camera, light: *Light, frames: int) -> ptr {
    i = 0
    while i < frames {
        core.backend_render(backend, cam, light)
        i = i + 1
    }
    return core.backend_frame_pixels(backend)
}

// A window's mean of one channel (0 red, 1 green, 2 blue).
channel(pixels: ptr, x0: int, y0: int, x1: int, y1: int, c: int) -> int {
    total = 0
    count = 0
    y = y0
    while y <= y1 {
        x = x0
        while x <= x1 {
            total = total + mem.get_byte(pixels, (y * WIDTH + x) * 4 + c)
            count = count + 1
            x = x + 1
        }
        y = y + 1
    }
    return total / count
}

slab(backend: *Backend, sx: float, sy: float, sz: float, x: float, y: float, z: float, r: float, g: float, b: float) -> *Model {
    m = loader.cube(1.0)
    core.model_set_scale(m, sx, sy, sz)
    core.model_set_position(m, x, y, z)
    core.model_matte(m, r, g, b)
    rendering.apply(m, rendering.default_config())
    core.backend_add_model(backend, m)
    return m
}

main() {
    if !vulkan.available() {
        println("gi: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("gi: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    if !vulkan.renderer_ray_query(renderer) {
        println("gi: SKIP the device does not trace rays (no VK_KHR_ray_query)")
        core.backend_cleanup(&backend)
        vulkan.renderer_free(renderer)
        return
    }
    core.backend_set_shadows(&backend, false)
    // A small volume, every probe traced every frame: a software
    // rasterizer's frame in a second or two.
    vulkan.renderer_set_gi_probes(renderer, 16, 8, 16, 1.0, 4.0, 1)

    auto = core.GI_RT
    if vkdevice.software() { auto = core.GI_SKY }
    check("GI_AUTO is the sky's light on a software rasterizer, the probes on a GPU (${core.gi_name(vulkan.renderer_gi(renderer))})",
          vulkan.renderer_gi(renderer) == auto)
    vulkan.renderer_set_gi(renderer, core.GI_RT)
    check("GI_RT is the probes where the device traces", vulkan.renderer_gi(renderer) == core.GI_RT)

    // The bounce.
    floor = loader.plane(8, 4.0)
    core.model_set_position(floor, 0.0 - 16.0, 0.0, 0.0 - 16.0)
    core.model_matte(floor, 0.8, 0.05, 0.05)
    rendering.apply(floor, rendering.default_config())
    core.backend_add_model(&backend, floor)
    wall = slab(&backend, 20.0, 8.0, 0.5, 0.0, 4.0, 0.0, 0.9, 0.9, 0.9)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 2.0, 6.0))
    core.camera_look_at(cam, core.vec3(0.0, 2.0, 0.0))
    light = core.light_sun(core.vec3(0.0, 1.0, 0.0))
    light.intensity = 3.0
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)

    // The wall's face fills the middle of the view.
    cx = WIDTH / 2
    cy = HEIGHT / 2
    traced = read_after(&backend, cam, light, 4)
    red_rt = channel(traced, cx - 8, cy - 8, cx + 8, cy + 8, 0)
    green_rt = channel(traced, cx - 8, cy - 8, cx + 8, cy + 8, 1)
    check("the probes light the wall's face by the floor's bounce (red ${red_rt})", red_rt > 40)
    check("in the floor's colour (red ${red_rt} against green ${green_rt})", red_rt > green_rt * 3)
    // The probes with nothing within their reach -- over the wall, out in
    // the black -- sleep, tracing a ray in four; those by the floor and the
    // wall are on, and lit the face above.
    counts = calloc(4, 4)
    rays = vulkan.renderer_gi_census(renderer, counts)
    c = counts as int[]
    println("       probes: ${c[0]} on, ${c[1]} asleep, ${c[2]} inside, ${c[3]} untraced; ${rays} rays a frame")
    check("the probes out in the open sleep (${c[1]} of ${c[0] + c[1] + c[2] + c[3]})", c[1] > 0)
    check("and those by the floor and the wall are on (${c[0]})", c[0] > 0)
    free(counts)

    vulkan.renderer_set_gi(renderer, core.GI_SKY)
    check("GI_SKY is the sky's light", vulkan.renderer_gi(renderer) == core.GI_SKY)
    sky = read_after(&backend, cam, light, 2)
    red_sky = channel(sky, cx - 8, cy - 8, cx + 8, cy + 8, 0)
    check("the sky's tier, under a black sky, leaves the face black (red ${red_sky})", red_sky < 8)

    vulkan.renderer_set_gi(renderer, core.GI_OFF)
    check("GI_OFF is none", vulkan.renderer_gi(renderer) == core.GI_OFF)

    // The sealed room: six slabs round a room 6 m by 3 m by 6 m, the camera
    // inside it looking at the far wall, a grey sky and the sun outside.
    floor.visible = false
    wall.visible = false
    slab(&backend, 7.0, 0.5, 7.0, 0.0, 0.0 - 0.25, 0.0, 0.8, 0.8, 0.8)
    slab(&backend, 7.0, 0.5, 7.0, 0.0, 3.25, 0.0, 0.8, 0.8, 0.8)
    slab(&backend, 0.5, 3.5, 7.0, 0.0 - 3.25, 1.5, 0.0, 0.8, 0.8, 0.8)
    slab(&backend, 0.5, 3.5, 7.0, 3.25, 1.5, 0.0, 0.8, 0.8, 0.8)
    slab(&backend, 7.0, 3.5, 0.5, 0.0, 1.5, 0.0 - 3.25, 0.8, 0.8, 0.8)
    slab(&backend, 7.0, 3.5, 0.5, 0.0, 1.5, 3.25, 0.8, 0.8, 0.8)
    core.camera_set_position(cam, core.vec3(0.0, 1.5, 2.5))
    core.camera_look_at(cam, core.vec3(0.0, 1.5, 0.0 - 3.0))
    core.backend_set_clear_color(&backend, 0.6, 0.6, 0.6)
    light.intensity = 1.0

    off = read_after(&backend, cam, light, 2)
    lit_off = channel(off, cx - 8, cy - 8, cx + 8, cy + 8, 1)
    vulkan.renderer_set_gi(renderer, core.GI_SKY)
    sky_room = read_after(&backend, cam, light, 2)
    lit_sky = channel(sky_room, cx - 8, cy - 8, cx + 8, cy + 8, 1)
    vulkan.renderer_set_gi(renderer, core.GI_RT)
    rt_room = read_after(&backend, cam, light, 4)
    lit_rt = channel(rt_room, cx - 8, cy - 8, cx + 8, cy + 8, 1)
    check("the sky's tier lights the sealed room's inside as though it were open (${lit_sky})", lit_sky > 60)
    check("the probes, which see the walls, leave it dark (${lit_rt} against ${lit_sky})", lit_rt * 4 < lit_sky)
    check("and with none it is black (${lit_off})", lit_off < 8)
    // What the engine answers when asked about the far wall's light
    // (ae3d.agent's explain): the probes' reading, not the sky's.
    wall_point = core.vec3(0.0, 1.5, 0.0 - 2.9)
    facing = core.vec3(0.0, 0.0, 1.0)
    asked_rt = vulkan.renderer_indirect_irradiance(renderer, wall_point, facing, facing)
    vulkan.renderer_set_gi(renderer, core.GI_SKY)
    read_after(&backend, cam, light, 1)
    asked_sky = vulkan.renderer_indirect_irradiance(renderer, wall_point, facing, facing)
    vulkan.renderer_set_gi(renderer, core.GI_RT)
    read_after(&backend, cam, light, 4)
    check("asked, the probes say the far wall takes almost nothing (${asked_rt.y} against the sky's ${asked_sky.y})",
          asked_rt.y * 10.0 < asked_sky.y && asked_sky.y > 0.1)

    // A glowing panel on the near wall, behind the camera and facing the
    // far wall 6 m off: the far wall takes its light by the probes alone (it
    // is no lamp) -- about 1.1 of irradiance from a radiance of 4 over 10
    // square metres -- in its colour.
    panel = slab(&backend, 4.0, 2.5, 0.1, 0.0, 1.5, 2.9, 0.2, 1.0, 0.2)
    core.model_set_exposure(panel, 40.0)
    glow = read_after(&backend, cam, light, 4)
    green_glow = channel(glow, cx - 8, cy - 8, cx + 8, cy + 8, 1)
    red_glow = channel(glow, cx - 8, cy - 8, cx + 8, cy + 8, 0)
    check("a glowing panel lights the dark room's far wall through the probes (green ${green_glow} against ${lit_rt})", green_glow > lit_rt + 30)
    check("in its colour (green ${green_glow} against red ${red_glow})", green_glow > red_glow * 2)

    core.backend_cleanup(&backend)
    vulkan.renderer_free(renderer)
    core.camera_free(cam)
    if failures == 0 {
        println("gi: all checks passed")
    } else {
        println("gi: ${failures} failure(s)")
    }
}
