// A streamed world driven across in a running engine (#917): a 448 m world
// of 14 x 14 cells, each a ground tile (a collider) and six crates
// (colliders and the walkers' blockers), baked (ae3d.worldbake) and
// streamed (ae3d.stream) around a ball pushed along it at 30 m/s by the
// engine's physics, the camera following. Twice: with every cell loaded
// before the drive, and streamed from a standing start.
//   - The ball never falls through: every collider is in place before it
//     comes to it (the ball rolls on the ground tiles, nothing else holds it).
//   - What streaming adds to a frame: the 99th percentile of the frame time
//     streamed against the same drive with everything loaded, held under a
//     stated bound.
// A hidden window; SKIP where none opens.

import std.list
import std.os
import ae3d.core
import ae3d.loader
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.cellfile
import ae3d.worldbake
import ae3d.stream

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const CELL = 32.0
const SIDE = 14
const SPEED = 30.0
const DIR = "build/stream_drive_world/"
const MAX_FRAMES = 3000
// What streaming may add to the 99th percentile frame, in milliseconds.
const P99_BOUND = 8.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// One drive's state, the behaviour's.
struct Drive {
    st: *Streamer
    ball: *GameObject
    started: bool
    lowest: float
    times: ptr                    // float[MAX_FRAMES]: each frame's milliseconds
    count: int
    last_ns: long
    all_loaded: bool              // the drive waits for every cell before it starts
    finished: bool
}

var g_drive: ptr = null

world(models: ptr, flags: ptr) {
    half = CELL * (SIDE as float) * 0.5
    f = flags as int[]
    n = 0
    iz = 0
    while iz < SIDE {
        ix = 0
        while ix < SIDE {
            cx = 0.0 - half + ((ix as float) + 0.5) * CELL
            cz = 0.0 - half + ((iz as float) + 0.5) * CELL
            ground = loader.plane(17, CELL / 16.0)
            core.model_set_position(ground, cx - CELL * 0.5, 0.0, cz - CELL * 0.5)
            core.model_matte(ground, 0.3, 0.4, 0.3)
            list.add_raw(models, ground as ptr)
            f[n] = cellfile.FLAG_COLLIDER
            n = n + 1
            k = 0
            while k < 6 {
                crate = loader.cube(1.5)
                // Off the ball's line (z = 0): they stand at z + 8 in each cell.
                core.model_set_position(crate, cx - 10.0 + (k as float) * 4.0, 0.75, cz + 8.0)
                core.model_matte(crate, 0.6, 0.45, 0.3)
                list.add_raw(models, crate as ptr)
                f[n] = cellfile.FLAG_COLLIDER | cellfile.FLAG_NAV
                n = n + 1
                k = k + 1
            }
            ix = ix + 1
        }
        iz = iz + 1
    }
}

on_update(state: ptr, e: *Engine, delta: float) {
    d = g_drive as *Drive
    if d.finished { return }
    now = os.now_monotonic_ns()
    p = behaviour.object_world_position(d.ball)
    rb = physics.rigidbody_of(d.ball)
    if !d.started {
        // Standing until what is wanted is there: every cell for the loaded
        // drive, the radius's for the streamed one.
        stream.focus_clear(d.st)
        stream.focus(d.st, p.x, p.z)
        stream.update(d.st)
        stream.events_clear(d.st)
        ready = stream.missing(d.st, 96.0) == 0
        if d.all_loaded { ready = stream.resident_count(d.st) == stream.cell_count(d.st) }
        // Held still while it waits.
        physics.rigidbody_set_velocity(rb, core.vec3(0.0, 0.0, 0.0))
        if ready && engine.engine_frame_count(e) > 10 {
            d.started = true
            d.last_ns = now
        }
        return
    }
    if d.count < MAX_FRAMES {
        (d.times as float[])[d.count] = ((now - d.last_ns) as float) / 1000000.0
        d.count = d.count + 1
    }
    d.last_ns = now
    v = physics.rigidbody_velocity(rb)
    physics.rigidbody_set_velocity(rb, core.vec3(SPEED, v.y, 0.0))
    if p.y < d.lowest { d.lowest = p.y }
    stream.focus_clear(d.st)
    stream.focus(d.st, p.x, p.z)
    stream.update(d.st)
    stream.events_clear(d.st)
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(p.x - 20.0, 14.0, p.z + 20.0))
    core.camera_look_at(cam, core.vec3(p.x, 0.0, p.z))
    if p.x > CELL * (SIDE as float) * 0.5 - 40.0 || p.y < 0.0 - 5.0 || d.count >= MAX_FRAMES {
        d.finished = true
        engine.engine_stop(e)
    }
}

// The 99th percentile of the first `n` of `v`, sorted in place; 0 for none.
p99(v: float[], n: int) -> float {
    if n <= 0 { return 0.0 }
    a = 1
    while a < n {
        x = v[a]
        b = a - 1
        while b >= 0 && v[b] > x {
            v[b + 1] = v[b]
            b = b - 1
        }
        v[b + 1] = x
        a = a + 1
    }
    at = (n * 99) / 100
    if at >= n { at = n - 1 }
    return v[at]
}

// One drive: an engine, its physics, the stream around the ball. Whether a
// window opened; the drive's numbers in `d`.
drive(d: *Drive, radius: float) -> bool {
    e = engine.engine_new()
    engine.engine_set_size(e, 640, 360)
    engine.engine_set_vsync(e, 0)
    // The drive's own bound, over CI's AE3D_FRAMES smoke cap: a drive is
    // as many frames as the world is long (it stops itself at the end).
    engine.engine_set_frame_limit(e, MAX_FRAMES + 600)
    engine.engine_set_camera_input(e, false)
    p = physics.attach(e)
    st = stream.open("${DIR}world.json")
    stream.set_engine(st, e)
    stream.set_radius(st, radius, 32.0)
    stream.set_far(st, 0.0)
    stream.set_physics(st, true, 0.0)
    d.st = st
    half = CELL * (SIDE as float) * 0.5
    ball = engine.object(e, "Ball", loader.sphere(0.5, 16, 12))
    behaviour.object_set_position(ball, core.vec3(0.0 - half + 40.0, 0.6, 0.0))
    physics.rigidbody(ball, physics.DYNAMIC)
    _shape = physics.sphere_collider(ball, 0.5, physics.material(0.0, 0.0))
    d.ball = ball
    b = engine.behaviour_new("drive", null)
    b.update = on_update
    engine.engine_add_behaviour(e, b)
    ran = engine.engine_run(e)
    stream.stream_free(st)
    physics.physics_free(p)
    engine.engine_free(e)
    return ran
}

drive_new(all_loaded: bool) -> *Drive {
    d = calloc(1, sizeof(Drive)) as *Drive
    d.times = calloc(MAX_FRAMES, 8)
    d.lowest = 1000.0
    d.all_loaded = all_loaded
    return d
}

main() {
    println("stream_drive: a streamed world driven across at 30 m/s, colliders ahead of the ball")
    os.setenv("AE3D_HIDDEN", "1")
    models = list.new()
    flags = calloc(SIDE * SIDE * 7, 4)
    world(models, flags)
    half = CELL * (SIDE as float) * 0.5
    err = worldbake.bake(models, flags, CELL, 0.0 - half, 0.0 - half, SIDE, SIDE, DIR)
    check("the world is baked (${err})", err == "")
    i = 0
    while i < list.size(models) {
        core.model_free(list.get_raw(models, i) as *Model)
        i = i + 1
    }
    list.free(models)
    free(flags)

    loaded = drive_new(true)
    g_drive = loaded as ptr
    if !drive(loaded, 10000.0) {
        println("stream_drive: SKIP no window available")
        return
    }
    streamed = drive_new(false)
    g_drive = streamed as ptr
    drive(streamed, 96.0)

    check("everything loaded: the ball crosses the world on the ground (lowest ${loaded.lowest} m, ${loaded.count} frames)", loaded.lowest > 0.2 && loaded.count > 100)
    check("streamed: every collider is there before the ball comes to it (lowest ${streamed.lowest} m, ${streamed.count} frames)", streamed.lowest > 0.2 && streamed.count > 100)
    loaded_p99 = p99(loaded.times as float[], loaded.count)
    streamed_p99 = p99(streamed.times as float[], streamed.count)
    println("    the 99th percentile frame: ${loaded_p99} ms with everything loaded, ${streamed_p99} ms streamed")
    check("streaming adds under ${P99_BOUND} ms to the 99th percentile frame", loaded.count > 100 && streamed.count > 100 && streamed_p99 < loaded_p99 + P99_BOUND)
    free(loaded.times)
    free(streamed.times)
    free(loaded as ptr)
    free(streamed as ptr)
    if g_failures == 0 {
        println("stream_drive: all checks passed (${g_checks})")
    } else {
        println("stream_drive: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
