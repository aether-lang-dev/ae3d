// Stances and cover (#988, ae3d.stance): the UE5 mannequin made a character
// (ae3d.character, on 100STYLE's gaits) in a world with physics, given its
// stances from Universal Animation Library's crouch (ual1_rigify.glb's
// Crouch_Idle_Loop and Crouch_Fwd_Loop, retargeted), its prone and crawl
// made, held to the numbers a game judges them by. No window; stepped at
// 60 Hz.
//
//   - it crouch-walks at its take's pace (within 10%), no toe skating 5 mm
//     (ae3d.metrics);
//   - it crawls prone at its crawl's pace (within 10%), no ball of a foot
//     sliding 5 mm while it is down (within 1 cm of the lowest it comes),
//     nor a toe skating 5 mm (metrics' skate, which reads a stance from a
//     foot's pad on the ground, sees none in a crawl on tucked toes);
//   - each change, stand to crouch, crouch to stand, crouch to prone and
//     prone to crouch, keeps both feet where they were within 5 mm over the
//     ground (between stand and crouch the heel, the ball and the toe;
//     going prone and back the ball of the foot, which the foot rolls onto),
//     and no joint turns faster than the takes' own fastest plus the
//     change's easing (its largest joint offset at the easing's steepest);
//   - the capsule is the stance's height;
//   - under a low ceiling, asked to stand, it stays crouched and waits, its
//     capsule low; crouch-walked out from under, it stands up;
//   - in cover against a wall, found by a probe, moving along it facing
//     out, its back keeps within 5 cm of the wall; a peek out past the end
//     aims the trunk within 1 degree of the target; and it leaves cover.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.stance
import ae3d.metrics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const UAL1 = "tests/fixtures/people/ual1_rigify.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const PLANTED = 0.005                  // metres a foot may move through a change
const SKATE = 0.005
const BACK_GAP = 0.05
const AIM_MOST = 0.017453292519943295  // a degree

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

level_apart(a: Vec3, b: Vec3) -> float { return core.v3_len(core.vec3(a.x - b.x, 0.0, a.z - b.z)) }

// What a test reads of the drawn figure each frame: each foot's ball, and
// its heel's and its toe's soles (ikrig's), on the ground, the world's.
struct Watch {
    rig: ptr
    feet: ptr                      // *Feet
    p: ptr
    w: ptr
    balls: ptr                     // int[2]
}

watch_new(c: *Character) -> *Watch {
    a = character.animator_of(c)
    r = animator.rig(a)
    wt = heap.new(Watch)
    wt.rig = r as ptr
    wt.feet = character.feet_of(c) as ptr
    wt.p = pose.new(r)
    wt.w = pose.new(r)
    b = calloc(2, 4) as int[]
    b[0] = pose.human(r, pose.BALL_L)
    b[1] = pose.human(r, pose.BALL_R)
    wt.balls = b as ptr
    return wt
}

watch_free(wt: *Watch) {
    pose.release(wt.p)
    pose.release(wt.w)
    free(wt.balls)
    heap.free(wt)
}

ball(wt: *Watch, side: int) -> Vec3 {
    r = wt.rig as *pose.Rig
    pose.read(r, wt.p)
    pose.world(r, wt.p, wt.w)
    return ikrig.to_ground(r, pose.translation(wt.w, (wt.balls as int[])[side]))
}

// Foot `side`'s heel sole, ball and toe sole as drawn.
foot(wt: *Watch, side: int) -> (Vec3, Vec3, Vec3) {
    r = wt.rig as *pose.Rig
    pose.read(r, wt.p)
    pose.world(r, wt.p, wt.w)
    heel, _pad, toe = ikrig.feet_soles(wt.feet as *Feet, r, wt.w, side)
    return heel, ikrig.to_ground(r, pose.translation(wt.w, (wt.balls as int[])[side])), toe
}

// The furthest foot `side`'s heel, ball or toe is, over the ground, from
// where they were.
foot_moved(wt: *Watch, side: int, was_heel: Vec3, was_ball: Vec3, was_toe: Vec3) -> float {
    heel, b, toe = foot(wt, side)
    most = level_apart(heel, was_heel)
    if level_apart(b, was_ball) > most { most = level_apart(b, was_ball) }
    if level_apart(toe, was_toe) > most { most = level_apart(toe, was_toe) }
    return most
}

// The largest turn of any joint between two local poses, radians.
largest_offset(r: *pose.Rig, x: ptr, y: ptr) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        q1 = pose.rotation(x, j)
        q2 = pose.rotation(y, j)
        d = core.abs_of(q1.x * q2.x + q1.y * q2.y + q1.z * q2.z + q1.w * q2.w)
        if d > 1.0 { d = 1.0 }
        ang = 2.0 * core.acos_of(d)
        if ang > most { most = ang }
        j = j + 1
    }
    return most
}

// Stepped `frames` asked `velocity` (zero: stand), metered.
run(e: *Engine, c: *Character, m: *Meter, velocity: Vec3, frames: int) {
    k = 0
    while k < frames {
        character.move(c, velocity, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
}

// A change of stance from a stand still: stepped until it is in the stance
// and settled, at most `frames`; the furthest either foot went over the
// ground from where it was (its heel, ball and toe; `whole` false: its ball
// alone, the foot rolling onto it going prone), the worst joint turn over
// the takes' own plus the easing `ease` (radians a second), and whether it
// got there.
change(e: *Engine, c: *Character, s: *Stances, m: *Meter, wt: *Watch, to: int, frames: int, own: float, ease: float, whole: bool) -> (float, float, bool) {
    a = character.animator_of(c)
    hl, bl, tl = foot(wt, 0)
    hr, br, tr = foot(wt, 1)
    metrics.meter_moved(m)
    metrics.meter_reset(m)
    stance.stance_set(s, to)
    moved = 0.0
    eased = ease
    k = 0
    while k < frames {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if animator.transitioning(a) && animator.transition_seconds(a) > 0.0 {
            need = 1.875 * animator.transition_offset(a) / animator.transition_seconds(a)
            if need > eased { eased = need }
        }
        dl = level_apart(ball(wt, 0), bl)
        dr = level_apart(ball(wt, 1), br)
        if whole {
            dl = foot_moved(wt, 0, hl, bl, tl)
            dr = foot_moved(wt, 1, hr, br, tr)
        }
        if dl > moved { moved = dl }
        if dr > moved { moved = dr }
        k = k + 1
    }
    there = stance.stance_now(s) == to && !stance.stance_changing(s)
    return moved, metrics.meter_worst(m, metrics.POP) / (own + eased), there
}

main() {
    println("stances: crouch, prone, crawl and cover, the feet kept through each change (#988)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Crouched", MANNEQUIN, g)
    if c == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    s = stance.stances(c, UAL1)
    if s == null {
        println("  no stances: ${UAL1} has no crouch")
        exit(1)
    }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    cap = physics.character_of(o)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    wt = watch_new(c)
    stand_t = animator.state_take(a, character.idle_state(c))
    crouch_t = animator.state_take(a, stance.crouch_idle_state(s))
    down_t = animator.state_take(a, stance.down_state(s))
    println("  the crouch ${stance.crouch_drop(s) * 100.0} cm lower than the stand and leant ${core.rad_to_deg(stance.crouch_lean(s))} degrees further; capsules ${stance.stance_height(s, stance.STAND)}, ${stance.stance_height(s, stance.CROUCH)} and ${stance.stance_height(s, stance.PRONE)} m; the crouch walk ${stance.crouch_pace(s)} m/s, the crawl ${stance.crawl_pace(s)} m/s")

    // Standing a second, then crouched and stood again. A change's joints
    // are held to the takes' own fastest plus its easing: the largest turn
    // of any joint between its two ends at the easing's steepest (a
    // cross-fade's smoothstep, 1.5 over its seconds; the way down's hips,
    // stance.change_steepest).
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 60)
    sp = pose.new(r)
    cp = pose.new(r)
    pp = pose.new(r)
    clips.sample_frame(stand_t, r, 0, sp)
    clips.sample_frame(crouch_t, r, 0, cp)
    clips.sample_frame(animator.state_take(a, stance.prone_idle_state(s)), r, 0, pp)
    between = largest_offset(r, sp, cp) * 1.5 / stance.CHANGE
    prone_ease = largest_offset(r, cp, pp) * stance.change_steepest() / clips.duration(down_t)
    own = metrics.take_fastest(stand_t, r)
    crouch_own = metrics.take_fastest(crouch_t, r)
    if crouch_own > own { own = crouch_own }
    moved1, pop1, there1 = change(e, c, s, m, wt, stance.CROUCH, 90, own, between, true)
    crouched_h = physics.character_height(cap)
    moved2, pop2, there2 = change(e, c, s, m, wt, stance.STAND, 90, own, between, true)
    stood_h = physics.character_height(cap)
    println("  stand to crouch: the feet ${moved1 * 1000.0} mm, the fastest joint ${pop1 * 100.0}% of the takes' own plus the easing; crouch to stand: ${moved2 * 1000.0} mm, ${pop2 * 100.0}%; capsules ${crouched_h} and ${stood_h} m")
    check("stand to crouch and back keep both feet planted within 5 mm, no joint past the takes' own plus the easing", there1 && there2 && moved1 < PLANTED && moved2 < PLANTED && pop1 <= 1.0 && pop2 <= 1.0)
    check("the capsule is the stance's height", core.abs_of(crouched_h - stance.stance_height(s, stance.CROUCH)) < 0.001 && core.abs_of(stood_h - stance.stance_height(s, stance.STAND)) < 0.001)

    // Crouch-walked at its take's pace.
    change(e, c, s, m, wt, stance.CROUCH, 60, own, between, true)
    pace = stance.crouch_pace(s)
    run(e, c, m, core.vec3(0.0, 0.0, pace), 150)
    began = behaviour.object_position(o)
    window = metrics.meter_frames(m)
    metrics.meter_reset(m)
    run(e, c, m, core.vec3(0.0, 0.0, pace), 180)
    went = level_apart(behaviour.object_position(o), began) / 3.0
    walk_skate = metrics.meter_worst(m, metrics.SKATE)
    in_move = animator.current(a) == stance.crouch_move_state(s)
    println("  crouch-walked: ${went} m/s (its take's ${pace}), a toe skating ${walk_skate * 1000.0} mm (${pose.name(r, metrics.meter_joint(m, metrics.SKATE))} at ${metrics.meter_when(m, metrics.SKATE)} s, the window from frame ${window}), in its crouch move ${in_move}")
    check("it crouch-walks at its take's pace (10%), no toe skating 5 mm", in_move && core.abs_of(went - pace) < 0.1 * pace && walk_skate < SKATE)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 90)

    // Down to the prone and up again.
    moved3, pop3, there3 = change(e, c, s, m, wt, stance.PRONE, 150, crouch_own, prone_ease, false)
    prone_h = physics.character_height(cap)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 30)
    moved4, pop4, there4 = change(e, c, s, m, wt, stance.CROUCH, 150, crouch_own, prone_ease, false)
    println("  crouch to prone: the feet ${moved3 * 1000.0} mm, the fastest joint ${pop3 * 100.0}% of the take's own plus the easing (capsule ${prone_h} m); prone to crouch: ${moved4 * 1000.0} mm, ${pop4 * 100.0}%")
    check("crouch to prone and back keep both feet planted within 5 mm, no joint past the take's own plus the easing", there3 && there4 && moved3 < PLANTED && moved4 < PLANTED && pop3 <= 1.0 && pop4 <= 1.0)
    check("prone, the capsule is the prone's height", core.abs_of(prone_h - stance.stance_height(s, stance.PRONE)) < 0.001)

    // Crawled at its pace.
    change(e, c, s, m, wt, stance.PRONE, 150, crouch_own, prone_ease, false)
    rest_l = ball(wt, 0)
    rest_r = ball(wt, 1)
    cpace = stance.crawl_pace(s)
    // Two seconds into the crawl, the lowest each ball comes: its plant.
    ground_l = 1000.0
    ground_r = 1000.0
    k = 0
    while k < 120 {
        character.move(c, core.vec3(0.0, 0.0, cpace), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        if k >= 30 && ball(wt, 0).y < ground_l { ground_l = ball(wt, 0).y }
        if k >= 30 && ball(wt, 1).y < ground_r { ground_r = ball(wt, 1).y }
        k = k + 1
    }
    began = behaviour.object_position(o)
    metrics.meter_reset(m)
    slid = 0.0
    planted = [0, 0]
    since_x = [rest_l.x, rest_r.x]
    since_z = [rest_l.z, rest_r.z]
    grounds = [ground_l, ground_r]
    downs = 0
    k = 0
    while k < 360 {
        character.move(c, core.vec3(0.0, 0.0, cpace), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        side = 0
        while side < 2 {
            at = ball(wt, side)
            lying = at.y < grounds[side] + 0.01
            if lying && planted[side] == 0 {
                since_x[side] = at.x
                since_z[side] = at.z
                downs = downs + 1
            }
            if lying {
                d = level_apart(at, core.vec3(since_x[side], 0.0, since_z[side]))
                if d > slid { slid = d }
                planted[side] = 1
            } else {
                planted[side] = 0
            }
            side = side + 1
        }
        k = k + 1
    }
    crawled = level_apart(behaviour.object_position(o), began) / 6.0
    crawl_skate = metrics.meter_worst(m, metrics.SKATE)
    crawling = animator.current(a) == stance.crawl_state(s)
    println("  crawled: ${crawled} m/s (its pace ${cpace}), a ball of the foot sliding ${slid * 1000.0} mm at worst over ${downs} plants, a toe skating ${crawl_skate * 1000.0} mm (metrics), crawling ${crawling}")
    check("it crawls at its pace (10%), no foot sliding 5 mm while down, no toe skating 5 mm", crawling && downs >= 4 && core.abs_of(crawled - cpace) < 0.1 * cpace && slid < SKATE && crawl_skate < SKATE)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 60)
    change(e, c, s, m, wt, stance.STAND, 240, own, between, true)

    // A low ceiling: crouched under it, asked to stand, it waits.
    at = behaviour.object_position(o)
    roof = engine.object(e, "Ceiling", null)
    behaviour.object_set_position(roof, core.vec3(at.x, 1.45, at.z + 1.0))
    physics.box_collider(roof, core.vec3(1.5, 0.05, 2.0), physics.material(0.8, 0.0))
    change(e, c, s, m, wt, stance.CROUCH, 60, own, between, true)
    stance.stance_set(s, stance.STAND)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 120)
    waited = stance.stance_now(s) == stance.CROUCH && stance.stance_waiting(s) && physics.character_height(cap) < 1.4
    // Crouch-walked out from under it, back the way it faces.
    k = 0
    while k < 400 && stance.stance_now(s) != stance.STAND {
        character.move(c, core.vec3(0.0, 0.0, 0.0 - 0.6), core.vec3(0.0, 0.0, 1.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    out_at = behaviour.object_position(o)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 90)
    rose = stance.stance_now(s) == stance.STAND && character.standing(c)
    println("  under a ceiling 1.4 m up, asked to stand: waiting ${waited} (capsule ${physics.character_height(cap)} m after); out from under it at z ${out_at.z - at.z} m from where it waited, standing ${rose}")
    check("under a low ceiling it waits crouched to stand, and stands once out from under it", waited && rose && out_at.z - at.z < 0.0 - 0.9)

    // Cover: a wall 2.2 m high, 4 m long, ahead of it.
    at = behaviour.object_position(o)
    wall = engine.object(e, "Wall", null)
    behaviour.object_set_position(wall, core.vec3(at.x, 1.1, at.z - 1.5))
    physics.box_collider(wall, core.vec3(2.0, 1.1, 0.2), physics.material(0.8, 0.0))
    found = stance.cover_probe(s, core.vec3(0.0, 0.0, 0.0 - 1.0), 3.0)
    high = stance.cover_high(s)
    // Into cover, its back to the wall: two seconds.
    k = 0
    while k < 120 {
        stance.cover_move(s, 0.0)
        engine.engine_update(e, STEP)
        k = k + 1
    }
    settled_gap = stance.cover_back_gap(s)
    // Along it, toward its end at x - 2.
    worst_gap = 0.0
    from_x = behaviour.object_position(o).x
    k = 0
    while k < 180 {
        stance.cover_move(s, 0.6)
        engine.engine_update(e, STEP)
        gap = core.abs_of(stance.cover_back_gap(s))
        if gap > worst_gap { worst_gap = gap }
        k = k + 1
    }
    alongside = behaviour.object_position(o)
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    println("  cover found ${found}, high ${high} (out ${stance.cover_out(s).x} ${stance.cover_out(s).z}); into it its back ${settled_gap * 100.0} cm off the wall; along it at 0.6 m/s it went ${alongside.x - from_x} m facing ${ahead.x} ${ahead.z}, its back off the wall ${worst_gap * 100.0} cm at worst")
    check("in cover it moves along the wall facing out, its back within 5 cm of it", found && high && core.abs_of(alongside.x - from_x) > 1.0 && ahead.z > 0.95 && worst_gap < BACK_GAP)
    // A peek out past the end at a target round it, behind the wall.
    target = core.vec3(at.x - 6.0, 1.4, at.z - 5.0)
    stance.cover_peek(s, target)
    k = 0
    while k < 150 {
        stance.cover_move(s, 0.0)
        engine.engine_update(e, STEP)
        k = k + 1
    }
    err = stance.aim_error(s, target)
    peek_at = behaviour.object_position(o)
    println("  peeked: out to x ${peek_at.x - at.x} m (the wall's end at -2 m), the aim ${core.rad_to_deg(err) * 1000.0} thousandths of a degree off the target")
    check("a peek from cover aims within 1 degree of the target", err < AIM_MOST && peek_at.x - at.x < 0.0 - 2.0 && stance.peeking(s))
    stance.cover_peek_off(s)
    stance.cover_leave(s)
    run(e, c, m, core.vec3(0.0, 0.0, 0.0), 60)
    check("it leaves cover standing", !stance.in_cover(s) && stance.stance_now(s) == stance.STAND)

    pose.release(sp)
    pose.release(cp)
    pose.release(pp)
    watch_free(wt)
    metrics.meter_free(m)
    stance.stances_free(s)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("stances: all checks passed (${g_checks})")
        return
    }
    println("stances: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
