// A figure reads the same at any frame rate (#985): the UE5 mannequin on
// 100STYLE's neutral gaits (ae3d.character), on a physics floor in its
// capsule as the people plaza's are, walks ahead, turns a quarter round
// while walking, walks on and stops, its script asking at the fixed step.
// Stepped through the engine's own frame (engine.engine_simulate) at frames
// of 1/30, 1/45, 1/60 and 1/144 s and a seeded mix of 1/250 to 1/25 s, and
// measured as each frame is drawn (core.interp_apply at the frame's
// fraction, ae3d.metrics), against the same figure on the fixed tick (a
// frame a step, drawn where the step left it). On the wall clock the
// animator posed each figure once a frame with that frame's length while its
// capsule moved at the fixed step: the people plaza's toes skated up to 43 mm
// against 3 on the tick, and its fastest joint turned 22 to 31 rad/s
// against 19.
//
//   - a toe skates within 0.5 mm of what it skates on the tick;
//   - no joint turns faster than its fastest on the tick (within 0.1%,
//     the unevenness of a turn drawn between two steps);
//   - the figure is drawn where the tick has it at the same time within
//     1 mm, and the steps leave it where the tick's do.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.metrics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/lookup_stop.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
// The script's steps: standing, ahead, turning, on, stopped.
const SETTLE = 30
const AHEAD = 150
const TURNED = 270
const STOPPED = 330
const STEPS = 450
const PACE = 1.3

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The figure's script, at the fixed step.
struct Walk {
    c: ptr
    steps: int
}

walk_fixed(state: ptr, e: *Engine, dt: float) {
    w = state as *Walk
    c = w.c as *Character
    k = w.steps
    asked = core.vec3(0.0, 0.0, 0.0)
    if k >= SETTLE && k < AHEAD { asked = core.vec3(0.0, 0.0, PACE) }
    if k >= AHEAD && k < TURNED {
        turn = 1.5707963267948966 * ((k - AHEAD) as float) / ((TURNED - AHEAD) as float)
        asked = core.vec3(PACE * core.sin_of(turn), 0.0, PACE * core.cos_of(turn))
    }
    if k >= TURNED && k < STOPPED { asked = core.vec3(PACE, 0.0, 0.0) }
    character.move(c, asked, core.vec3(0.0, 0.0, 0.0))
    w.steps = k + 1
}

struct Run {
    skate: float
    pop: float
    drawn_off: float      // the most the figure was drawn from where the tick has it then
    stepped_off: float    // the most a step left it from where the tick's step did
    frames: int
}

// The next of a seeded run of frame lengths, 1/250 to 1/25 s.
next_seed(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }

// The figure stepped STEPS fixed steps at frames of `frame` seconds (0: the
// seeded mix), measured as drawn. `tick`: the fixed tick, a frame a step
// drawn where it leaves things, its places kept in `places` (x and z after
// each step); else the places compared with those.
run(g: *Gaits, frame: float, tick: bool, places: float[]) -> Run {
    out = Run { skate: 0.0, pop: 0.0, drawn_off: 0.0, stepped_off: 0.0, frames: 0 }
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    engine.engine_set_interpolation(e, !tick)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    w = Walk { c: c as ptr, steps: 0 }
    b = engine.behaviour_new("walk", (&w) as ptr)
    b.fixed_update = walk_fixed
    engine.engine_add_behaviour(e, b)
    m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
    metrics.meter_ground_physics(m, physics.of(e))
    seed = 977
    measuring = false
    while w.steps < STEPS {
        dt = frame
        if frame <= 0.0 {
            seed = next_seed(seed)
            u = ((seed % 100000) as float) / 100000.0
            dt = 0.004 + u * (0.04 - 0.004)
        }
        engine.engine_simulate(e, dt)
        n = w.steps
        // What the frame draws: between the last two steps by its fraction.
        alpha = engine.engine_step_fraction(e)
        if tick { alpha = 1.0 }
        core.interp_apply(alpha)
        drawn = behaviour.object_position(o)
        if !measuring && n > SETTLE {
            measuring = true
            metrics.meter_reset(m)
        }
        if measuring {
            metrics.meter_take(m, dt)
            out.frames = out.frames + 1
        }
        core.interp_restore()
        at = behaviour.object_position(o)
        if tick {
            places[n * 2] = at.x
            places[n * 2 + 1] = at.z
        } else if n >= 2 && n <= STEPS {
            // Drawn `alpha` of the way from the step before the last to the
            // last: the tick's places between the same two steps.
            px = places[(n - 1) * 2] + (places[n * 2] - places[(n - 1) * 2]) * alpha
            pz = places[(n - 1) * 2 + 1] + (places[n * 2 + 1] - places[(n - 1) * 2 + 1]) * alpha
            off = core.sqrt_of((drawn.x - px) * (drawn.x - px) + (drawn.z - pz) * (drawn.z - pz))
            if off > out.drawn_off { out.drawn_off = off }
            sx = at.x - places[n * 2]
            sz = at.z - places[n * 2 + 1]
            stepped = core.sqrt_of(sx * sx + sz * sz)
            if stepped > out.stepped_off { out.stepped_off = stepped }
        }
    }
    out.skate = metrics.meter_worst(m, metrics.SKATE)
    out.pop = metrics.meter_worst(m, metrics.POP)
    metrics.meter_free(m)
    character.character_free(c)
    figure.figures_free(e)
    engine.engine_free(e)
    return out
}

main() {
    println("frame_rates: a figure reads the same at any frame rate (#985)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    places_block = calloc((STEPS + 2) * 2, 8)
    places = places_block as float[]
    ref = run(g, STEP, true, places)
    println("  on the tick: a toe skated ${ref.skate * 1000.0} mm, the fastest joint ${ref.pop} rad/s, over ${ref.frames} frames")
    frames = [1.0 / 30.0, 1.0 / 45.0, 1.0 / 60.0, 1.0 / 144.0, 0.0]
    names = ["1/30 s", "1/45 s", "1/60 s", "1/144 s", "a seeded mix of 1/250 to 1/25 s"]
    skate_off = 0.0
    pop_over = 0.0
    drawn_off = 0.0
    stepped_off = 0.0
    k = 0
    while k < 5 {
        r = run(g, frames[k], false, places)
        println("  frames of ${names[k]}: a toe skated ${r.skate * 1000.0} mm, the fastest joint ${r.pop} rad/s, over ${r.frames} frames; drawn ${r.drawn_off * 1000.0} mm from the tick's place at the most, stepped ${r.stepped_off * 1000.0} mm")
        d = core.abs_of(r.skate - ref.skate)
        if d > skate_off { skate_off = d }
        if r.pop - ref.pop > pop_over { pop_over = r.pop - ref.pop }
        if r.drawn_off > drawn_off { drawn_off = r.drawn_off }
        if r.stepped_off > stepped_off { stepped_off = r.stepped_off }
        k = k + 1
    }
    check("at every frame rate a toe skates within 0.5 mm of what it skates on the tick", skate_off <= 0.0005)
    // Within 0.1% of it: a joint's turn drawn between two steps, its parent
    // and itself each taken between their two places in the world, is not
    // quite even over the step (14.8300 rad/s at 1/144 s against 14.8297).
    check("at every frame rate no joint turns faster than its fastest on the tick", pop_over <= 0.001 * ref.pop)
    check("at every frame rate the figure is drawn where the tick has it within 1 mm", drawn_off <= 0.001)
    check("at every frame rate the steps leave it where the tick's do within 1 mm", stepped_off <= 0.001)
    free(places_block)
    character.gaits_free(g)
    if g_failures == 0 {
        println("frame_rates: all checks passed (${g_checks})")
        return
    }
    println("frame_rates: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
