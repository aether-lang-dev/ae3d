// A body's life is its object's (#549), held to numbers. No window: the
// engine is stepped by hand at 60 Hz.
//
//   - a thousand crates -- boxes, spheres, capsules and hulls, several
//     hulls shared between crates -- made a few a frame and destroyed
//     ten frames later with engine.destroy: when the last is gone the
//     world holds the bodies and shapes it held before the first, and
//     the physics no record of any;
//   - a crate destroyed from a fixed update, the step after it is freed
//     and every step after: nothing is written into the freed object (a
//     crash where the heap faults, a write into whatever reused the
//     memory where it does not), and the slab under it is left alone;
//   - rigidbody_remove takes the body out of the world and leaves the
//     object, which the step no longer moves;
//   - collider_remove takes one shape off a body, and its mass with it;
//   - freeing the engine afterwards frees what is left.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import aephysics.dynamics
import aephysics.hull

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const CRATES = 1000
const A_FRAME = 7                    // crates made each frame
const LIFE = 10                      // frames a crate lives
const SHARED = 4                     // crates in a row made from one hull

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

world_of(e: *Engine) -> *Physics { return physics.of(e) }

ground(e: *Engine) {
    g = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(g, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(g, core.vec3(40.0, 0.5, 40.0), physics.material(0.6, 0.0))
}

// Crate `n`: a dynamic body with one collider of the four kinds in turn;
// the hulls come from `shared`, one hull for SHARED crates in a row.
crate(e: *Engine, n: int, shared: ptr) -> *GameObject {
    o = engine.object(e, "Crate", loader.cube(0.5))
    behaviour.object_set_position(o, core.vec3(((n % 20) as float) - 10.0, 1.0 + ((n / 20) % 5) as float, 0.0))
    physics.rigidbody(o, physics.DYNAMIC)
    m = physics.material(0.6, 0.0)
    kind = n % 4
    if kind == 0 { physics.box_collider(o, core.vec3(0.25, 0.25, 0.25), m) }
    if kind == 1 { physics.sphere_collider(o, 0.25, m) }
    if kind == 2 { physics.capsule_collider(o, core.vec3(0.0, 0.0 - 0.15, 0.0), core.vec3(0.0, 0.15, 0.0), 0.2, m) }
    if kind == 3 {
        slot = (n / 4) / SHARED
        hulls = shared as ptr[]
        if hulls[slot] == null { hulls[slot] = hull.make_box_hull(0.3, 0.2, 0.3) as ptr }
        physics.hull_collider(o, hulls[slot] as *HullData, m)
    }
    return o
}

// --- a destroy from a fixed update ---------------------------------------------------------------------------

struct Doomed {
    frame: int
    crate: ptr
}

doom(state: ptr, o: *GameObject, step: float) {
    d = state as *Doomed
    d.frame = d.frame + 1
    if d.frame == 60 && d.crate != null {
        engine.destroy(engine.of(o), d.crate as *GameObject)
        d.crate = null
    }
}

main() {
    println("physics lifetime: bodies live and die with their objects")

    // A thousand made and destroyed.
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground(e)
    p = world_of(e)
    bodies_before = physics.physics_body_count(p)
    shapes_before = physics.physics_shape_count(p)
    records_before = physics.rigidbody_count(p)
    hulls_block = calloc((CRATES / 4) / SHARED + 1, 8)
    objects_block = calloc(CRATES, 8)
    objects = objects_block as ptr[]
    deaths_block = calloc(CRATES, 4)
    deaths = deaths_block as int[]
    made = 0
    gone = 0
    frame = 0
    most = 0
    while gone < CRATES {
        k = 0
        while k < A_FRAME && made < CRATES {
            objects[made] = crate(e, made, hulls_block) as ptr
            deaths[made] = frame + LIFE
            made = made + 1
            k = k + 1
        }
        // Each crate goes LIFE frames after it came.
        while gone < made && deaths[gone] <= frame {
            engine.destroy(e, objects[gone] as *GameObject)
            gone = gone + 1
        }
        engine.engine_update(e, STEP)
        if physics.physics_body_count(p) > most { most = physics.physics_body_count(p) }
        frame = frame + 1
    }
    engine.engine_update(e, STEP)
    bodies_after = physics.physics_body_count(p)
    shapes_after = physics.physics_shape_count(p)
    println("  ${CRATES} crates over ${frame} frames, at most ${most} bodies at once: bodies ${bodies_before} then ${bodies_after}, shapes ${shapes_before} then ${shapes_after}, records ${records_before} then ${physics.rigidbody_count(p)}")
    check("a thousand crates made and destroyed: up to ${LIFE * A_FRAME} bodies at once", most > bodies_before + LIFE * A_FRAME / 2)
    check("when the last is gone the world holds the bodies it held before the first", bodies_after == bodies_before)
    check("and the shapes", shapes_after == shapes_before)
    check("and the physics no record of any", physics.rigidbody_count(p) == records_before)
    free(hulls_block)
    free(objects_block)
    free(deaths_block)
    engine.engine_free(e)

    // Destroyed from a fixed update: the steps after it touch nothing freed.
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground(e)
    p = world_of(e)
    c = crate(e, 0, null)
    keeper = engine.object(e, "Keeper", null)
    d = Doomed { frame: 0, crate: c as ptr }
    engine.script(keeper, "doom", (&d) as ptr, null, null, doom)
    bodies_with = physics.physics_body_count(p)
    k = 0
    while k < 180 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    check("a crate destroyed from a fixed update is out of the world, and 120 steps after it ran", physics.physics_body_count(p) == bodies_with - 1)
    engine.engine_free(e)

    // The body off, the object kept.
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground(e)
    p = world_of(e)
    wall = crate(e, 0, null)
    bodies_with = physics.physics_body_count(p)
    k = 0
    while k < 30 { engine.engine_update(e, STEP); k = k + 1 }
    physics.rigidbody_remove(wall)
    behaviour.object_set_position(wall, core.vec3(5.0, 3.0, 5.0))
    k = 0
    while k < 30 { engine.engine_update(e, STEP); k = k + 1 }
    at = behaviour.object_position(wall)
    check("rigidbody_remove takes the body out of the world", physics.physics_body_count(p) == bodies_with - 1 && physics.rigidbody_of(wall) == null)
    check("and leaves the object where the game puts it, unmoved by the step", at.x == 5.0 && at.y == 3.0 && at.z == 5.0)

    // One collider off.
    two = engine.object(e, "Two", loader.cube(0.5))
    behaviour.object_set_position(two, core.vec3(0.0, 2.0, 0.0))
    rb = physics.rigidbody(two, physics.DYNAMIC)
    m = physics.material(0.6, 0.0)
    physics.box_collider(two, core.vec3(0.25, 0.25, 0.25), m)
    second = physics.sphere_collider(two, 0.3, m)
    shapes_with = physics.physics_shape_count(p)
    mass_with = dynamics.body_get_mass(physics.rigidbody_body(rb))
    removed = physics.collider_remove(two, second)
    again = physics.collider_remove(two, second)
    mass_without = dynamics.body_get_mass(physics.rigidbody_body(rb))
    println("  two colliders: mass ${mass_with} kg, ${mass_without} kg with one taken off")
    check("collider_remove takes one shape off the body", removed && physics.physics_shape_count(p) == shapes_with - 1)
    check("and the body's mass with it", mass_without < mass_with && mass_without > 0.0)
    check("and answers false for a shape the body no longer has", !again)
    engine.engine_free(e)

    if g_failures == 0 {
        println("physics lifetime: all checks passed (${g_checks})")
    } else {
        println("physics lifetime: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
