// Bracing against a wall (#590), held to numbers. POWERED figures shoved
// from behind at the chest toward a wall two strides ahead of them --
// nine shoves of 2.25 to 2.55 m/s (the speed each gives the whole body,
// #626), each of which carries the unbraced
// twin into the wall -- each beside an unbraced twin
// (motion.set_bracing false) shoved the same; and the same shoves on
// braced figures with no wall in reach. No window: the engine is stepped
// by hand. A wall a stride ahead is met in 0.22 s at 1.8 m/s, before an arm
// hanging at the side comes up (a person's would not either); at 2.6 m/s and
// past, the body outruns the arms, and the head meets the wall first,
// braced or not, if slower braced. Of the nine:
//
//   - the braced figure's hand (a forearm) is what meets the wall first;
//   - its head meets the wall slower than its twin's, or not at all, and
//     slower on average;
//   - with no wall in reach it never braces: its arms are its clip's, or
//     the protective fall's, as before.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const SHOVES = 9
const FIGURES = 27                   // per shove: braced, its twin, braced with no wall
const SHOVE_LOW = 2.25               // metres a second
const SHOVE_HIGH = 2.55
const SHOVE_STEP = 60                // a second in
const STEPS = 300
const WALL_FACE = 0.0 - 1.6          // the wall's face, z: two strides ahead of the chests
const TOUCH = 0.02                   // a body within this of the wall touches it
const STEP = 0.016666666666666666

// Per figure.
const FIELDS = 5
const FIRST_BONE = 0                 // the first bone to touch the wall, or -1
const HEAD_SPEED = 1                 // how fast the head came at the wall when it touched it; 0 when it did not
const HEAD_LAST = 2                  // the head's distance from the wall last step
const BRACED = 3                     // 1 once it braced
const HEAD_TOUCHED = 4               // 1 once the head touched the wall

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// How far a bone's capsule is from the wall's face, along z toward it.
from_wall(r: *Ragdoll, index: int, wall_z: float) -> float {
    bone = human.bone_at(&r.human, index)
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.shape_id)
    za = t.p.z + core.quat_apply(t.q, c.center1).z
    zb = t.p.z + core.quat_apply(t.q, c.center2).z
    if zb < za { za = zb }
    return za - c.radius - wall_z
}

// Where a figure faces, level: its rest's forward turned as its pelvis is.
facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(&r.human, human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

shove_of(n: int) -> float {
    return SHOVE_LOW + (SHOVE_HIGH - SHOVE_LOW) * (n as float) / ((SHOVES - 1) as float)
}

// A step of a figure watched against the wall at `wall_z`.
watch(m: *Motion, record: float[], at: int, wall_z: float) {
    r = m.ragdoll
    if motion.braced(m) { record[at + BRACED] = 1.0 }
    if record[at + FIRST_BONE] < 0.0 {
        i = 0
        while i < human.BONE_COUNT {
            if record[at + FIRST_BONE] < 0.0 && from_wall(r, i, wall_z) < TOUCH { record[at + FIRST_BONE] = i as float }
            i = i + 1
        }
    }
    head = from_wall(r, human.BONE_NECK, wall_z)
    if record[at + HEAD_TOUCHED] < 0.5 && head < TOUCH {
        record[at + HEAD_TOUCHED] = 1.0
        record[at + HEAD_SPEED] = (record[at + HEAD_LAST] - head) / STEP
    }
    record[at + HEAD_LAST] = head
}

main() {
    println("brace: ${SHOVES} shoves from ${SHOVE_LOW} to ${SHOVE_HIGH} m/s toward a wall a stride ahead, braced and not, and braced with no wall")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(200.0, 0.5, 200.0), physics.material(0.8, 0.0))
    // The wall, before the braced figures and their twins (z 0); the
    // figures with no wall stand 20 m behind them.
    wall = engine.object(e, "Wall", loader.cube(1.0))
    behaviour.object_set_position(wall, core.vec3(0.0, 1.5, WALL_FACE - 0.25))
    physics.box_collider(wall, core.vec3(100.0, 1.5, 0.25), physics.material(0.8, 0.0))
    figures_block = calloc(FIGURES, 8)
    figures = figures_block as ptr[]
    rigs_block = calloc(FIGURES, 8)
    rigs = rigs_block as ptr[]
    record_block = calloc(FIGURES * FIELDS, 8)
    record = record_block as float[]
    // Figure k: shove k / 3; braced (k % 3 == 0), its twin (1), braced with no wall (2).
    k = 0
    while k < FIGURES {
        x = ((k / 3) as float) * 6.0 - 33.0 + ((k % 3) as float) * 2.0
        z = 0.0
        if k % 3 == 2 { z = 20.0 }
        r = physics.ragdoll(e, "Shoved", core.vec3(x, 0.02, z), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        physics.ragdoll_dress(r, rig)
        rigs[k] = rig as ptr
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        if k % 3 == 1 { motion.set_bracing(m, false) }
        figures[k] = m as ptr
        record[k * FIELDS + FIRST_BONE] = 0.0 - 1.0
        record[k * FIELDS + HEAD_LAST] = 1000.0
        k = k + 1
    }
    steps = 0
    while steps < STEPS {
        if steps == SHOVE_STEP {
            k = 0
            while k < FIGURES {
                m = figures[k] as *Motion
                chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
                motion.hit(m, human.BONE_SPINE_03, chest, core.v3_mul(facing(m), shove_of(k / 3) * physics.ragdoll_mass(m.ragdoll)))
                k = k + 1
            }
        }
        engine.engine_update(e, STEP)
        steps = steps + 1
        if steps > SHOVE_STEP {
            k = 0
            while k < FIGURES {
                wall_z = WALL_FACE
                if k % 3 == 2 { wall_z = WALL_FACE + 20.0 }
                watch(figures[k] as *Motion, record, k * FIELDS, wall_z)
                k = k + 1
            }
        }
    }

    hand_first = 0
    slower = 0
    braced_sum = 0.0
    twin_sum = 0.0
    twin_braced = 0
    no_wall_braced = 0
    n = 0
    while n < SHOVES {
        at = n * 3 * FIELDS
        twin = at + FIELDS
        lone = at + 2 * FIELDS
        first = record[at + FIRST_BONE] as int
        if first == human.BONE_LOWER_ARM_L || first == human.BONE_LOWER_ARM_R { hand_first = hand_first + 1 }
        if record[at + HEAD_SPEED] < record[twin + HEAD_SPEED] || record[at + HEAD_TOUCHED] < 0.5 { slower = slower + 1 }
        braced_sum = braced_sum + record[at + HEAD_SPEED]
        twin_sum = twin_sum + record[twin + HEAD_SPEED]
        if record[twin + BRACED] > 0.5 { twin_braced = twin_braced + 1 }
        if record[lone + BRACED] > 0.5 { no_wall_braced = no_wall_braced + 1 }
        println("  ${shove_of(n)} m/s: braced ${record[at + BRACED]}, first at the wall bone ${first}, head ${record[at + HEAD_SPEED]} m/s (touched ${record[at + HEAD_TOUCHED]}); twin first bone ${record[twin + FIRST_BONE]}, head ${record[twin + HEAD_SPEED]} m/s (touched ${record[twin + HEAD_TOUCHED]})")
        n = n + 1
    }
    braced_mean = braced_sum / (SHOVES as float)
    twin_mean = twin_sum / (SHOVES as float)
    println("  of ${SHOVES}: a hand first in ${hand_first}; the braced head slower or clear in ${slower}, ${braced_mean} m/s on average against ${twin_mean}; the twin braced in ${twin_braced}, the figure with no wall in ${no_wall_braced}")
    check("the braced figure's hand meets the wall first", hand_first == SHOVES)
    check("its head meets the wall slower than its twin's, or not at all, and slower on average", slower == SHOVES && braced_mean < twin_mean)
    check("with bracing off, or no wall in reach, it never braces", twin_braced == 0 && no_wall_braced == 0)

    k = 0
    while k < FIGURES {
        motion.motion_free(figures[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(figures_block)
    free(rigs_block)
    free(record_block)
    engine.engine_free(e)
    if g_failures == 0 {
        println("brace: all checks passed (${g_checks})")
        return
    }
    println("brace: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
