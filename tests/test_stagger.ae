// Staggering (#414), held to numbers: a POWERED figure shoved harder than
// one step catches takes catch steps in a run, each to where its capture
// point is then, until it stands or falls into the protective fall. Each
// shove on a figure of its own, from behind at the chest a second in,
// stepping and not, in engines of their own; the whole run twice. No
// window: the engine is stepped by hand.
//
//   - 330 N s fells a figure that cannot step; one that can staggers --
//     two or more catch steps, none more than 0.4 s after the last -- and
//     stands three seconds later, the stagger over;
//   - 360 N s is past what the steps catch: it staggers, then falls into
//     the protective fall, knowing it;
//   - it is deterministic: the same run twice takes the same steps at the
//     same steps and ends bit for bit the same.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const SHOVES = 2
const MOST_STEPS = 16
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there, so a shove along -z is from behind.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

shove_of(k: int) -> float {
    if k == 0 { return 330.0 }
    return 360.0
}

// What a run measured, per shove: whether the stepping figure stands, the
// one that cannot step stands, the steps it took and when (seconds after
// the shove), whether it was seen staggering, whether it still is, whether
// it took itself for falling, and where its pelvis ended.
struct Run {
    stands: ptr            // int[SHOVES]
    fixed_stands: ptr      // int[SHOVES]
    steps: ptr             // int[SHOVES]
    times: ptr             // float[SHOVES * MOST_STEPS]
    staggered: ptr         // int[SHOVES]
    still_staggering: ptr  // int[SHOVES]
    fell: ptr              // int[SHOVES]
    pelvis: ptr            // float[SHOVES * 3]
}

run_new() -> *Run {
    t = calloc(1, sizeof(Run)) as *Run
    t.stands = calloc(SHOVES, 8)
    t.fixed_stands = calloc(SHOVES, 8)
    t.steps = calloc(SHOVES, 8)
    t.times = calloc(SHOVES * MOST_STEPS, 8)
    t.staggered = calloc(SHOVES, 8)
    t.still_staggering = calloc(SHOVES, 8)
    t.fell = calloc(SHOVES, 8)
    t.pelvis = calloc(SHOVES * 3, 8)
    return t
}

run_free(t: *Run) {
    free(t.stands)
    free(t.fixed_stands)
    free(t.steps)
    free(t.times)
    free(t.staggered)
    free(t.still_staggering)
    free(t.fell)
    free(t.pelvis)
    free(t as ptr)
}

// Every shove on a figure of its own, stepping or not, into the run.
trial(stepping: bool, t: *Run) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    motions_block = calloc(SHOVES, 8)
    motions = motions_block as ptr[]
    k = 0
    while k < SHOVES {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 4.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        physics.ragdoll_dress(r, humanoid_rig())
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        motion.set_stepping(m, stepping)
        motions[k] = m as ptr
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    k = 0
    while k < SHOVES {
        m = motions[k] as *Motion
        chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
        motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - shove_of(k)))
        k = k + 1
    }
    steps = t.steps as int[]
    times = t.times as float[]
    staggered = t.staggered as int[]
    fell = t.fell as int[]
    step = 0
    while step < 180 {
        engine.engine_update(e, STEP)
        step = step + 1
        k = 0
        while k < SHOVES {
            m = motions[k] as *Motion
            if stepping {
                taken = motion.steps_taken(m)
                while steps[k] < taken && steps[k] < MOST_STEPS {
                    times[k * MOST_STEPS + steps[k]] = (step as float) * STEP
                    steps[k] = steps[k] + 1
                }
                if motion.staggering(m) { staggered[k] = 1 }
                if motion.falling(m) || motion.lying(m) { fell[k] = 1 }
            }
            k = k + 1
        }
    }
    k = 0
    while k < SHOVES {
        m = motions[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        standing = 0
        if pelvis.y >= 0.8 { standing = 1 }
        if stepping {
            (t.stands as int[])[k] = standing
            if motion.staggering(m) { (t.still_staggering as int[])[k] = 1 }
            p = t.pelvis as float[]
            p[k * 3] = pelvis.x
            p[k * 3 + 1] = pelvis.y
            p[k * 3 + 2] = pelvis.z
        } else {
            (t.fixed_stands as int[])[k] = standing
        }
        k = k + 1
    }
    engine.engine_free(e)
    k = 0
    while k < SHOVES {
        motion.motion_free(motions[k] as *Motion)
        k = k + 1
    }
    free(motions_block)
}

run_all(t: *Run) {
    trial(false, t)
    trial(true, t)
}

// The longest gap, seconds, between one of shove k's steps and the next.
widest_gap(t: *Run, k: int) -> float {
    steps = t.steps as int[]
    times = t.times as float[]
    widest = 0.0
    i = 1
    while i < steps[k] {
        gap = times[k * MOST_STEPS + i] - times[k * MOST_STEPS + i - 1]
        if gap > widest { widest = gap }
        i = i + 1
    }
    return widest
}

step_times(t: *Run, k: int) -> string {
    steps = t.steps as int[]
    times = t.times as float[]
    text = ""
    i = 0
    while i < steps[k] {
        if i > 0 { text = "${text}, " }
        text = "${text}${times[k * MOST_STEPS + i]}"
        i = i + 1
    }
    return text
}

word(standing: int) -> string {
    if standing == 1 { return "stands" }
    return "falls"
}

main() {
    println("stagger: shoves from behind at the chest, stepping and not")
    a = run_new()
    run_all(a)
    stands = a.stands as int[]
    fixed = a.fixed_stands as int[]
    steps = a.steps as int[]
    staggered = a.staggered as int[]
    still = a.still_staggering as int[]
    fell = a.fell as int[]
    k = 0
    while k < SHOVES {
        println("  ${shove_of(k)} N s: without stepping it ${word(fixed[k])}; stepping it ${word(stands[k])} after ${steps[k]} steps at ${step_times(a, k)} s, the widest gap ${widest_gap(a, k)} s; staggered ${staggered[k]}, fell ${fell[k]}")
        k = k + 1
    }
    check("330 N s fells a figure that cannot step", fixed[0] == 0)
    check("one that can staggers: two or more catch steps, and stands", steps[0] >= 2 && stands[0] == 1 && staggered[0] == 1 && fell[0] == 0)
    check("the steps come in a run, none more than 0.4 s after the last", steps[0] >= 2 && widest_gap(a, 0) <= 0.4)
    check("and the stagger is over once it stands", still[0] == 0)
    check("360 N s is past them: it staggers, then falls into the protective fall", steps[1] >= 1 && staggered[1] == 1 && stands[1] == 0 && fell[1] == 1)

    b = run_new()
    run_all(b)
    same = true
    k = 0
    while k < SHOVES {
        if (a.steps as int[])[k] != (b.steps as int[])[k] { same = false }
        i = 0
        while i < MOST_STEPS {
            if (a.times as float[])[k * MOST_STEPS + i] != (b.times as float[])[k * MOST_STEPS + i] { same = false }
            i = i + 1
        }
        i = 0
        while i < 3 {
            if (a.pelvis as float[])[k * 3 + i] != (b.pelvis as float[])[k * 3 + i] { same = false }
            i = i + 1
        }
        k = k + 1
    }
    p = a.pelvis as float[]
    q = b.pelvis as float[]
    println("  the 330 N s figure's pelvis at the end (${p[0]}, ${p[1]}, ${p[2]}) and again (${q[0]}, ${q[1]}, ${q[2]})")
    check("the same run twice takes the same steps and ends bit for bit the same", same)
    run_free(a)
    run_free(b)

    if g_failures == 0 {
        println("stagger: all checks passed (${g_checks})")
        return
    }
    println("stagger: ${g_failures} failure(s) of ${g_checks}")
}
