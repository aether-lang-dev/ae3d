// Staggering (#414), held to numbers: a POWERED figure shoved harder than
// one step catches takes catch steps in a run, each to where its capture
// point is then, until it stands or falls into the protective fall. Each
// shove on a figure of its own, from behind at the chest a second in,
// stepping and not, in engines of their own; the whole run twice. No
// window: the engine is stepped by hand.
//
//   - 1.4 m/s (the shove's speed over the whole body, #626, shoved over
//     0.15 s with motion.shove, #606) fells a figure that cannot step; one that can staggers -- two
//     or more catch steps, none in the first second more than 0.4 s after
//     the last -- and stands three seconds later, the stagger over;
//   - 2.0 m/s is past what the steps catch: it staggers, then falls into
//     the protective fall, knowing it (1.8 was, until its steps aside and
//     back lifted the knee higher on a person's hips; it stands 1.8 now);
//   - a stepping knee bends, over 0.3 rad, so the foot clears the ground
//     (#578);
//   - from the side, every shove of 1.2 to 1.6 m/s (by 0.1) fells a figure
//     that cannot step, and one that can staggers out of it -- the far foot
//     crossing in front of the near one, which the shove has loaded -- its
//     steps in a run as the forward stagger's are (#481);
//   - standing again, every one that stood faces within 10 degrees of the
//     way it faced when shoved (#689): its heading held as far as its
//     soles' grip would hold it, as nothing had held it, and a figure
//     turned with its steps and the trailing foot dragged round, 45
//     degrees a shove from behind;
//   - it is deterministic: the same run twice takes the same steps at the
//     same steps and ends bit for bit the same.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const FORWARD = 2                    // shoves 0 and 1, from behind; the rest from the side
const SIDES = 5
const SHOVES = 7
const MOST_STEPS = 16
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there, so a shove along -z is from behind.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// The more bent knee: the angle between each thigh's way and its calf's.
knee_bend(m: *Motion) -> float {
    r = m.ragdoll
    most = 0.0
    side = 0
    while side < 2 {
        thigh = human.BONE_THIGH_L
        if side == 1 { thigh = human.BONE_THIGH_R }
        d = core.v3_dot(core.quat_apply(physics.ragdoll_bone_rotation(r, thigh), physics.ragdoll_bone_axis(r, thigh)),
                        core.quat_apply(physics.ragdoll_bone_rotation(r, thigh + 1), physics.ragdoll_bone_axis(r, thigh + 1)))
        if d > 1.0 { d = 1.0 }
        a = core.acos_of(d)
        if a > most { most = a }
        side = side + 1
    }
    return most
}

// The speed each shove gives the whole body, metres a second (#626).
shove_of(k: int) -> float {
    if k == 0 { return 1.4 }
    if k == 1 { return 2.0 }
    return 1.2 + 0.1 * ((k - FORWARD) as float)
}

// From behind (along -z, the way it faces) or from its left side (+x).
shove_at(k: int) -> Vec3 {
    if k < FORWARD { return core.vec3(0.0, 0.0, 0.0 - shove_of(k)) }
    return core.vec3(shove_of(k), 0.0, 0.0)
}

// What a run measured, per shove: whether the stepping figure stands, the
// one that cannot step stands, the steps it took and when (seconds after
// the shove), whether it was seen staggering, whether it still is, whether
// it took itself for falling, and where its pelvis ended.
struct Run {
    stands: ptr            // int[SHOVES]
    fixed_stands: ptr      // int[SHOVES]
    steps: ptr             // int[SHOVES]
    times: ptr             // float[SHOVES * MOST_STEPS]
    staggered: ptr         // int[SHOVES]
    still_staggering: ptr  // int[SHOVES]
    fell: ptr              // int[SHOVES]
    pelvis: ptr            // float[SHOVES * 3]
    knee: ptr              // float[SHOVES]: the most a knee bent while a step was under way, radians
    turned: ptr            // float[SHOVES]: degrees it turned from the way it faced when shoved
}

run_new() -> *Run {
    t = calloc(1, sizeof(Run)) as *Run
    t.stands = calloc(SHOVES, 8)
    t.fixed_stands = calloc(SHOVES, 8)
    t.steps = calloc(SHOVES, 8)
    t.times = calloc(SHOVES * MOST_STEPS, 8)
    t.staggered = calloc(SHOVES, 8)
    t.still_staggering = calloc(SHOVES, 8)
    t.fell = calloc(SHOVES, 8)
    t.pelvis = calloc(SHOVES * 3, 8)
    t.knee = calloc(SHOVES, 8)
    t.turned = calloc(SHOVES, 8)
    return t
}

run_free(t: *Run) {
    free(t.stands)
    free(t.fixed_stands)
    free(t.steps)
    free(t.times)
    free(t.staggered)
    free(t.still_staggering)
    free(t.fell)
    free(t.pelvis)
    free(t.knee)
    free(t.turned)
    free(t as ptr)
}

// Every shove on a figure of its own, stepping or not, into the run.
trial(stepping: bool, t: *Run) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    motions_block = calloc(SHOVES, 8)
    motions = motions_block as ptr[]
    rigs_block = calloc(SHOVES, 8)
    rigs = rigs_block as ptr[]
    k = 0
    while k < SHOVES {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 4.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        rigs[k] = rig as ptr
        physics.ragdoll_dress(r, rig)
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        motion.set_stepping(m, stepping)
        motions[k] = m as ptr
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    faced_block = calloc(SHOVES * 2, 8)
    faced = faced_block as float[]
    k = 0
    while k < SHOVES {
        m = motions[k] as *Motion
        f = facing(m)
        faced[k * 2] = f.x
        faced[k * 2 + 1] = f.z
        motion.shove(m, human.BONE_SPINE_03, core.v3_mul(shove_at(k), physics.ragdoll_mass(m.ragdoll)))
        k = k + 1
    }
    steps = t.steps as int[]
    times = t.times as float[]
    staggered = t.staggered as int[]
    fell = t.fell as int[]
    step = 0
    while step < 180 {
        engine.engine_update(e, STEP)
        step = step + 1
        k = 0
        while k < SHOVES {
            m = motions[k] as *Motion
            if stepping {
                taken = motion.steps_taken(m)
                while steps[k] < taken && steps[k] < MOST_STEPS {
                    times[k * MOST_STEPS + steps[k]] = (step as float) * STEP
                    steps[k] = steps[k] + 1
                }
                if motion.staggering(m) { staggered[k] = 1 }
                if motion.stepping(m) {
                    kn = knee_bend(m)
                    if kn > (t.knee as float[])[k] { (t.knee as float[])[k] = kn }
                }
                if motion.falling(m) || motion.lying(m) { fell[k] = 1 }
            }
            k = k + 1
        }
    }
    k = 0
    while k < SHOVES {
        m = motions[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        standing = 0
        if pelvis.y >= 0.8 { standing = 1 }
        if stepping {
            (t.stands as int[])[k] = standing
            if motion.staggering(m) { (t.still_staggering as int[])[k] = 1 }
            p = t.pelvis as float[]
            p[k * 3] = pelvis.x
            p[k * 3 + 1] = pelvis.y
            p[k * 3 + 2] = pelvis.z
            f = facing(m)
            (t.turned as float[])[k] = core.acos_of(core.clampf(f.x * faced[k * 2] + f.z * faced[k * 2 + 1], 0.0 - 1.0, 1.0)) * 57.29578
        } else {
            (t.fixed_stands as int[])[k] = standing
        }
        k = k + 1
    }
    engine.engine_free(e)
    k = 0
    while k < SHOVES {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(motions_block)
    free(rigs_block)
    free(faced_block)
}

// The way a figure faces, level: its rest's forward turned as its pelvis is.
facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

run_all(t: *Run) {
    trial(false, t)
    trial(true, t)
}

// The longest gap, seconds, between one of shove k's steps and the next,
// over the catch: the steps begun in the first second after the shove. A
// step after that is the feet brought together once it has nearly
// stopped, not part of the run.
widest_gap(t: *Run, k: int) -> float {
    steps = t.steps as int[]
    times = t.times as float[]
    widest = 0.0
    i = 1
    while i < steps[k] && times[k * MOST_STEPS + i] < 1.0 {
        gap = times[k * MOST_STEPS + i] - times[k * MOST_STEPS + i - 1]
        if gap > widest { widest = gap }
        i = i + 1
    }
    return widest
}

step_times(t: *Run, k: int) -> string {
    steps = t.steps as int[]
    times = t.times as float[]
    text = ""
    i = 0
    while i < steps[k] {
        if i > 0 { text = "${text}, " }
        text = "${text}${times[k * MOST_STEPS + i]}"
        i = i + 1
    }
    return text
}

word(standing: int) -> string {
    if standing == 1 { return "stands" }
    return "falls"
}

main() {
    println("stagger: shoves from behind at the chest, stepping and not")
    a = run_new()
    run_all(a)
    stands = a.stands as int[]
    fixed = a.fixed_stands as int[]
    steps = a.steps as int[]
    staggered = a.staggered as int[]
    still = a.still_staggering as int[]
    fell = a.fell as int[]
    k = 0
    while k < SHOVES {
        println("  ${shove_of(k)} m/s: without stepping it ${word(fixed[k])}; stepping it ${word(stands[k])} after ${steps[k]} steps at ${step_times(a, k)} s, the widest gap ${widest_gap(a, k)} s; staggered ${staggered[k]}, fell ${fell[k]}")
        k = k + 1
    }
    check("1.4 m/s fells a figure that cannot step", fixed[0] == 0)
    check("one that can staggers: two or more catch steps, and stands", steps[0] >= 2 && stands[0] == 1 && staggered[0] == 1 && fell[0] == 0)
    check("the steps come in a run, none in the first second more than 0.4 s after the last", steps[0] >= 2 && widest_gap(a, 0) <= 0.4)
    check("and the stagger is over once it stands", still[0] == 0)
    println("  stepping, a knee bent ${(a.knee as float[])[0]} rad at most (1.4 m/s)")
    check("a stepping knee bends (#578): over 0.3 rad", (a.knee as float[])[0] > 0.3)
    check("2.0 m/s is past them: it staggers, then falls into the protective fall", steps[1] >= 1 && staggered[1] == 1 && stands[1] == 0 && fell[1] == 1)
    side_fixed = true
    side_stands = true
    side_run = true
    k = FORWARD
    while k < SHOVES {
        if fixed[k] != 0 { side_fixed = false }
        if stands[k] != 1 || staggered[k] != 1 || fell[k] != 0 || still[k] != 0 { side_stands = false }
        if steps[k] < 2 || widest_gap(a, k) > 0.4 { side_run = false }
        k = k + 1
    }
    check("from the side, 1.2 to 1.6 m/s fells a figure that cannot step", side_fixed)
    check("one that can staggers out of each and stands, the stagger over", side_stands)
    check("its side steps come in a run, two or more, none in the first second more than 0.4 s after the last", side_run)
    turned = a.turned as float[]
    worst_turn = 0.0
    k = 0
    while k < SHOVES {
        if stands[k] == 1 && turned[k] > worst_turn { worst_turn = turned[k] }
        k = k + 1
    }
    println("  standing again, the most any turned from the way it faced: ${worst_turn} degrees")
    check("standing again, every one that stood faces within 10 degrees of the way it faced when shoved (#689)", worst_turn < 10.0)

    b = run_new()
    run_all(b)
    same = true
    k = 0
    while k < SHOVES {
        if (a.steps as int[])[k] != (b.steps as int[])[k] { same = false }
        i = 0
        while i < MOST_STEPS {
            if (a.times as float[])[k * MOST_STEPS + i] != (b.times as float[])[k * MOST_STEPS + i] { same = false }
            i = i + 1
        }
        i = 0
        while i < 3 {
            if (a.pelvis as float[])[k * 3 + i] != (b.pelvis as float[])[k * 3 + i] { same = false }
            i = i + 1
        }
        k = k + 1
    }
    p = a.pelvis as float[]
    q = b.pelvis as float[]
    println("  the 1.4 m/s figure's pelvis at the end (${p[0]}, ${p[1]}, ${p[2]}) and again (${q[0]}, ${q[1]}, ${q[2]})")
    check("the same run twice takes the same steps and ends bit for bit the same", same)
    run_free(a)
    run_free(b)

    if g_failures == 0 {
        println("stagger: all checks passed (${g_checks})")
        return
    }
    println("stagger: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
