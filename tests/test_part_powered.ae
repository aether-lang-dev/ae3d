// A part on its own muscles while the figure follows its clip (#658), held
// to numbers. Two ANIMATED figures on the pipeline's humanoid rig, standing
// on it; no window, the engine stepped by hand. The first's spine and head
// set POWERED, the second's left as they are; each jabbed in the face from
// in front, 20 N s on the head at a cost of 0.1 (a punch, #653).
//
//   - set POWERED, the parts read POWERED and the figure stays ANIMATED;
//     standing, its head is drawn within 2 cm of where the clip has it (the
//     muscles hold the pose against its weight);
//   - jabbed, its head is drawn back from the clip by 3 cm at least, the
//     pelvis within 1 cm of the clip, and the figure still ANIMATED; 0.9 s
//     after, the head is back within 1 cm of where it stood (the snap peaks
//     a fifth of a second in). The figure with no part powered draws its
//     head where the clip has it whatever strikes it, the answer a game had
//     (a limp head hanging from a chest on its clip went back 3.3 cm at
//     best);
//   - given back to ANIMATED, the parts are drawn back to the clip with no
//     jump over 1 cm in a step, and 0.5 s on the head is the clip's to 1 mm.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern exit(code: int)

const STEP = 0.016666666666666666
const JAB = 20.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// Where a rig bone is drawn, in the world.
drawn_at(rig: *Skeleton, name: string) -> Vec3 {
    b = skin.skeleton_bone(rig, skin.skeleton_find(rig, name))
    core.model_sync_transform(b)
    return b.world_position
}

main() {
    println("part_powered: a part on its own muscles while the figure follows its clip (#658)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Fighter", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig()
    physics.ragdoll_dress(r, rig)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    r2 = physics.ragdoll(e, "Clipped", core.vec3(3.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig2 = humanoid_rig()
    physics.ragdoll_dress(r2, rig2)
    m2 = motion.active_ragdoll(r2)
    motion.attach(e, m2)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    head_clip = drawn_at(rig, "Head")
    pelvis_clip = drawn_at(rig, "Hips")
    head_clip2 = drawn_at(rig2, "Head")
    set = motion.set_part_mode(m, motion.PART_SPINE, motion.POWERED) && motion.set_part_mode(m, motion.PART_HEAD, motion.POWERED)
    check("set POWERED, the parts read POWERED and the figure stays ANIMATED",
          set && motion.part_mode(m, motion.PART_SPINE) == motion.POWERED && motion.part_mode(m, motion.PART_HEAD) == motion.POWERED && motion.mode(m) == motion.ANIMATED)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    stood = drawn_at(rig, "Head")
    standing = core.v3_len(core.v3_sub(stood, head_clip))
    println("  standing on its muscles, the head is drawn ${standing * 100.0} cm from the clip's")
    check("standing, its head is drawn within 2 cm of where the clip has it", standing < 0.02)
    // On the face: the head, drawn, 5 cm up, where a fist lands.
    face = core.v3_add(drawn_at(rig, "Head"), core.vec3(0.0, 0.05, 0.0))
    face2 = core.v3_add(drawn_at(rig2, "Head"), core.vec3(0.0, 0.05, 0.0))
    motion.hit(m, human.BONE_NECK, face, core.vec3(0.0, 0.0, JAB), true, 0.1)
    motion.hit(m2, human.BONE_NECK, face2, core.vec3(0.0, 0.0, JAB), true, 0.1)
    back = 0.0
    back2 = 0.0
    pelvis_off = 0.0
    animated = true
    k = 0
    while k < 54 {
        engine.engine_update(e, STEP)
        d = drawn_at(rig, "Head").z - head_clip.z
        if d > back { back = d }
        d2 = drawn_at(rig2, "Head").z - head_clip2.z
        if d2 > back2 { back2 = d2 }
        p = core.v3_len(core.v3_sub(drawn_at(rig, "Hips"), pelvis_clip))
        if p > pelvis_off { pelvis_off = p }
        if motion.mode(m) != motion.ANIMATED { animated = false }
        k = k + 1
    }
    after = core.v3_len(core.v3_sub(drawn_at(rig, "Head"), stood))
    println("  jabbed: the head drawn back ${back * 100.0} cm at most (no part powered: ${back2 * 100.0} cm), the pelvis ${pelvis_off * 100.0} cm off its clip; 0.9 s on the head ${after * 100.0} cm from where it stood")
    check("jabbed, its head is drawn back 3 cm at least, the pelvis within 1 cm of its clip, the figure ANIMATED", back >= 0.03 && pelvis_off < 0.01 && animated)
    check("and 0.9 s after, the head is back within 1 cm of where it stood", after < 0.01)
    motion.set_part_mode(m, motion.PART_SPINE, motion.ANIMATED)
    motion.set_part_mode(m, motion.PART_HEAD, motion.ANIMATED)
    jump = 0.0
    last = drawn_at(rig, "Head")
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        now = drawn_at(rig, "Head")
        j = core.v3_len(core.v3_sub(now, last))
        if j > jump { jump = j }
        last = now
        k = k + 1
    }
    home = core.v3_len(core.v3_sub(drawn_at(rig, "Head"), head_clip))
    println("  given back: the head stepped ${jump * 100.0} cm at most; 0.5 s on, ${home * 1000.0} mm from the clip's")
    check("given back to ANIMATED, the head is drawn back with no jump over 1 cm in a step", jump < 0.01 && motion.part_mode(m, motion.PART_HEAD) == motion.ANIMATED)
    check("and 0.5 s on it is the clip's to 1 mm", home < 0.001)
    engine.engine_free(e)
    motion.motion_free(m)
    motion.motion_free(m2)
    rig_free(rig)
    rig_free(rig2)
    if g_failures == 0 {
        println("part_powered: all checks passed (${g_checks})")
        return
    }
    println("part_powered: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
