// A script as one built against another engine: it says a layout, and not
// this engine's. test_script holds script_open to refusing it by name. It
// imports nothing of the engine (whose module would give it the real
// layout under the same C name).

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

create() -> ptr { return calloc(1, 8) }
destroy(p: ptr) { free(p) }
fields(k: ptr) { }

@c_callback("script_layout_hash")
foreign_layout() -> long { return 42 as long }
