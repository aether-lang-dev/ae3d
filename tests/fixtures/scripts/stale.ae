// A script as one built before scripts said what engine they were built
// against: create, destroy and fields, and no layout. test_script holds
// script_open to refusing it. It imports nothing of the engine, so it
// carries no layout of its own either.

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

create() -> ptr { return calloc(1, 8) }
destroy(p: ptr) { free(p) }
fields(k: ptr) { }
