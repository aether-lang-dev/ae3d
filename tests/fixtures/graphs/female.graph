# The female mannequin (the UE5 skeleton) on the runner's gaits, retargeted
# from its file, and its level pistol aim as a layer over her upper body
# (the showcase's female).
take idle Idle_Loop from tests/fixtures/people/ual1_rigify.glb
take walk Walk_Loop from tests/fixtures/people/ual1_rigify.glb
take jog Jog_Fwd_Loop from tests/fixtures/people/ual1_rigify.glb
take sprint Sprint_Loop from tests/fixtures/people/ual1_rigify.glb
take aim Pistol_Aim_Neutral from tests/fixtures/people/ual1_rigify.glb
state idle idle loop
blend move speed
  walk measured
  jog measured
  sprint measured
end
transition idle move 0.35
  when speed above 0.25
end
transition move idle 0.4
  when speed below 0.1
end
layer aim aim from spine_01 loop
play idle
