# The runner of tests/test_animgraph.ae: UAL1's Rigify mannequin on its own
# takes and a 100STYLE capture. A stand, its gaits blended by speed, a jump
# on a trigger, a stride matched over a capture and its mirror, a hit layer
# over the upper body and a pistol's aim offset.
take idle Idle_Loop
take walk Walk_Loop
take jog Jog_Fwd_Loop
take sprint Sprint_Loop
take jump Jump_Start root           # in place: its root motion taken out
take hit Hit_Head
take aim_mid Pistol_Aim_Neutral
take aim_up Pistol_Aim_Up
take aim_down Pistol_Aim_Down
capture fw tests/fixtures/people/100style/neutral_fw.bvh root straighten cut_loop
mirror fw_m fw

state idle idle loop
state jump jump once
blend move speed
  walk measured
  jog measured
  sprint measured
end
matcher strider
  fw
  fw_m
end

transition idle move 0.2
  when speed above 0.1
end
transition move idle 0.3
  when speed below 0.1
end
transition any jump 0.1
  when jump triggered
  crossfade
end
transition jump idle 0.3
  when ended
end
transition idle strider 0.3
  when stride is
end

layer hit hit from spine_01 once
aim pistol from spine_01
  aim_mid 0 0
  aim_up 0 0.7
  aim_down 0 -0.7
end
play idle
