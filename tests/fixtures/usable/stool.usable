# A bar stool, its seat 0.60 m up: sat on facing any way, so four slots.
slot north
  tags sit
  at 0 0.60 0
  facing 0 0 1
  approach 0 0 0.5
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
slot east
  tags sit
  at 0 0.60 0
  facing 1 0 0
  approach 0.5 0 0
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
slot south
  tags sit
  at 0 0.60 0
  facing 0 0 -1
  approach 0 0 -0.5
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
slot west
  tags sit
  at 0 0.60 0
  facing -1 0 0
  approach -0.5 0 0
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
