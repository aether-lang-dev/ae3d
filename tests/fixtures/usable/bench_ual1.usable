# The workbench of bench.usable, its takes read from UAL1's file whatever
# figure uses it (#950): the right hand out to the tool's grip and back.
slot work
  tags work
  at 0.10 0.93 -0.05
  facing 0 0 -1
  approach 0 0 0.65
  enter Interact from tests/fixtures/people/ual1_rigify.glb
  loop Idle_Loop from tests/fixtures/people/ual1_rigify.glb
  lands hand_r
end
