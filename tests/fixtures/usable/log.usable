# A fallen log two can sit on, 1.2 m long along x, its top 0.40 m up.
slot left
  tags sit rest
  at -0.35 0.40 0.0
  facing 0 0 1
  approach 0 0 0.55
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
slot right
  tags sit rest
  at 0.35 0.40 0.0
  facing 0 0 1
  approach 0 0 0.55
  enter Sitting_Enter
  loop Sitting_Idle_Loop
  exit Sitting_Exit
  lands pelvis
end
