# The bar stool of stool.usable, one way on, its takes read from UAL1's file
# whatever figure sits on it (#950): a figure on a database of captures, with
# no sitting takes of its own, sits on it (#935).
slot north
  tags sit
  at 0 0.60 0
  facing 0 0 1
  approach 0 0 0.5
  enter Sitting_Enter from tests/fixtures/people/ual1_rigify.glb
  loop Sitting_Idle_Loop from tests/fixtures/people/ual1_rigify.glb
  exit Sitting_Exit from tests/fixtures/people/ual1_rigify.glb
  lands pelvis
end
