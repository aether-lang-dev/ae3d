// The engine's side of what is at a pixel and several cameras (#865, #866):
// engine_pick, engine_pick_ask and engine_pick_read, engine_view_new,
// engine_view_render, engine_view_show, engine_view_blit and
// engine_view_pixels, through the loop, on each renderer there is.
//
// A red sphere and a blue one; a view looks at the red one. The frame the
// loop draws shows the view on a quad (engine_view_show) and in a corner
// (engine_view_blit); the pixel on the red sphere is the red sphere's
// (engine_pick, and engine_pick_ask before the draw with engine_pick_read
// after it); the view's own pixels are red; and a pixel on nothing is no one.

import std.mem
import ae3d.core
import std.os
import ae3d.engine
import ae3d.platform
import ae3d.vulkan
import ae3d.gl
import ae3d.loader
extern exit(code: int)

const WIDTH = 160
const HEIGHT = 120
const VIEW_W = 48
const VIEW_H = 36

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

var g_red: ptr = null
var g_blue: ptr = null
var g_quad: ptr = null
var g_view = 0
var g_cam: ptr = null
var g_ask = 0 - 1
var g_pick_ask_hit = 0
var g_pick_ask_model = 0
var g_asked_x = 0
var g_asked_y = 0
var g_view_lean = 0
var g_shown = false
var g_blit_taken = false
var g_done = false
var g_sync_model = 0
var g_sync_found: ptr = null
var g_sync_empty = true

lean(pixels: ptr, w: int, h: int) -> int {
    total = 0
    n = 0
    y = h * 2 / 5
    while y < h * 3 / 5 {
        x = w * 2 / 5
        while x < w * 3 / 5 {
            total = total + mem.get_byte(pixels, (y * w + x) * 4) - mem.get_byte(pixels, (y * w + x) * 4 + 2)
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return total / n
}

on_start(state: ptr, e: *Engine) {
    red = loader.sphere(1.0, 24, 18)
    core.model_set_position(red, 0.0, 1.0, 0.0)
    core.model_set_diffuse(red, 0.9, 0.1, 0.1)
    g_red = red as ptr
    engine.engine_add_model(e, red)
    blue = loader.sphere(1.0, 24, 18)
    core.model_set_position(blue, 6.0, 1.0, 0.0)
    core.model_set_diffuse(blue, 0.1, 0.2, 0.9)
    g_blue = blue as ptr
    engine.engine_add_model(e, blue)

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(3.0, 2.0, 11.0))
    core.camera_look_at(cam, core.vec3(3.0, 1.0, 0.0))

    g_view = engine.engine_view_new(e, VIEW_W, VIEW_H)
    other = core.camera_new(VIEW_W, VIEW_H)
    core.camera_set_aspect(other, (VIEW_W * 1.0) / (VIEW_H * 1.0))
    core.camera_set_position(other, core.vec3(0.0, 1.0, 5.0))
    core.camera_look_at(other, core.vec3(0.0, 1.0, 0.0))
    g_cam = other as ptr

    // A quad above, shown by the view.
    quad = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(quad.mesh, 4, 6)
    core.mesh_push_vertex(quad.mesh, core.vec3(0.0 - 1.0, 0.0 - 0.75, 0.0), 0.0, 0.0, facing)
    core.mesh_push_vertex(quad.mesh, core.vec3(1.0, 0.0 - 0.75, 0.0), 1.0, 0.0, facing)
    core.mesh_push_vertex(quad.mesh, core.vec3(1.0, 0.75, 0.0), 1.0, 1.0, facing)
    core.mesh_push_vertex(quad.mesh, core.vec3(0.0 - 1.0, 0.75, 0.0), 0.0, 1.0, facing)
    core.mesh_push_triangle(quad.mesh, 0, 1, 2)
    core.mesh_push_triangle(quad.mesh, 0, 2, 3)
    core.model_set_position(quad, 3.0, 3.2, 4.0)
    core.model_update_matrix(quad)
    core.model_recalculate_bounds(quad)
    core.model_set_diffuse(quad, 1.0, 1.0, 1.0)
    g_quad = quad as ptr
    engine.engine_add_model(e, quad)
    engine.engine_view_show(e, g_view, quad)
}

// The pixel the red sphere's middle is at in the engine's frame.
red_pixel(e: *Engine) -> int {
    p = core.camera_world_to_screen(engine.engine_camera(e), core.vec3(0.0 - 0.0, 1.0, 0.0), WIDTH, HEIGHT)
    return (p.y as int) * 1000 + (p.x as int)
}

on_update(state: ptr, e: *Engine, delta: float) {
    // The view before the frame that shows it, a rectangle of the frame, and
    // what is asked of the frame about to be drawn.
    engine.engine_view_render(e, g_view, g_cam as *Camera)
    if engine.engine_frame_count(e) >= 4 {
        g_blit_taken = engine.engine_view_blit(e, g_view, WIDTH - VIEW_W - 4, 4, VIEW_W, VIEW_H)
    }
    if engine.engine_frame_count(e) == 3 {
        // Now, an extra frame: the red sphere's pixel, and a corner.
        at = red_pixel(e)
        now = engine.engine_pick(e, at % 1000, at / 1000)
        g_sync_model = now.model_id
        g_sync_found = engine.engine_pick_model(e, now) as ptr
        g_sync_empty = !engine.engine_pick(e, 3, 3).hit
    }
    if engine.engine_frame_count(e) == 5 {
        at = red_pixel(e)
        g_asked_x = at % 1000
        g_asked_y = at / 1000
        g_ask = engine.engine_pick_ask(e, g_asked_x, g_asked_y)
    }
}

on_render(state: ptr, e: *Engine, delta: float) {
    // After the frame that was asked about is drawn.
    if engine.engine_frame_count(e) == 5 && g_ask >= 0 {
        got = engine.engine_pick_read(e, g_ask, g_asked_x, g_asked_y)
        if got.hit { g_pick_ask_hit = 1 }
        g_pick_ask_model = got.model_id
    }
    if engine.engine_frame_count(e) == 6 {
        g_view_lean = lean(engine.engine_view_pixels(e, g_view), VIEW_W, VIEW_H)
        g_shown = true
    }
}

run_engine(api: int, name: string) {
    g_ask = 0 - 1
    g_pick_ask_hit = 0
    g_pick_ask_model = 0
    g_view_lean = 0
    g_shown = false
    g_blit_taken = false
    g_sync_model = 0
    g_sync_found = null
    g_sync_empty = false
    // The pixels it asks about are the ones at this size: AE3D_WIDTH and
    // AE3D_HEIGHT (ci.sh sets them small) would move the sphere from them.
    os.setenv("AE3D_WIDTH", "")
    os.setenv("AE3D_HEIGHT", "")
    e = engine.engine_new_with(api)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_title(e, "ae3d engine view test")
    engine.engine_set_frame_limit(e, 8)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_shadows(e, false)
    engine.engine_set_clear_color(e, 0.0, 0.0, 0.0)
    light = core.light_directional(core.vec3(0.2, 0.4, 1.0), core.vec3(1.0, 1.0, 1.0), 1.0)
    engine.engine_set_light(e, light)
    b = engine.behaviour_new("engine view", null)
    b.start = on_start
    b.update = on_update
    b.late_update = on_render
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("  ${name}: SKIP no window available")
        core.light_free(light)
        engine.engine_free(e)
        release()
        return
    }
    check("${name}: a view is made", g_view > 0)
    check("${name}: the view looking at the red sphere is red (${g_view_lean})", g_shown && g_view_lean > 40)
    check("${name}: a quad shown by the view has its texture", core.text((g_quad as *Model).material.texture_path) == "" &&
          (g_quad as *Model).material.texture_id > 0)
    red_id = (g_red as *Model).id
    check("${name}: a rectangle of the frame is taken", g_blit_taken)
    check("${name}: engine_pick_ask before the draw and engine_pick_read after it name the red sphere (${g_pick_ask_model} of ${red_id})",
          g_pick_ask_hit == 1 && g_pick_ask_model == red_id)
    check("${name}: engine_pick draws it now and names the red sphere (${g_sync_model} of ${red_id}), the model itself, and a corner is no one",
          g_sync_model == red_id && g_sync_found == g_red && g_sync_empty)
    core.light_free(light)
    engine.engine_free(e)
    // The engine borrows what it was given: freed here, after it is gone.
    release()
}

release() {
    if g_red != null { core.model_free(g_red as *Model) }
    if g_blue != null { core.model_free(g_blue as *Model) }
    if g_quad != null { core.model_free(g_quad as *Model) }
    if g_cam != null { core.camera_free(g_cam as *Camera) }
    g_red = null
    g_blue = null
    g_quad = null
    g_cam = null
}

main() {
    run_engine(platform.API_GL, "opengl")
    if vulkan.available() {
        run_engine(platform.API_VULKAN, "vulkan")
    } else {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
    }
    if failures == 0 {
        println("engine_view: all checks passed")
        return
    }
    println("engine_view: ${failures} failure(s)")
    exit(1)
}
