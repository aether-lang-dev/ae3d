// A face that lives (#910): eyes turned by the look ahead of the head,
// saccades on the main sequence, and blinks as a layer of the animator's
// pose, on a real CC0 figure with eye joints and blend shapes (VRoid
// Studio's base female, tests/fixtures/people/README.md).
//
// Measured against people:
//   - the eyes land within 1 degree of what is looked at, near or far,
//     ahead or to the side, each on its own line to it (vergence);
//   - in a gaze shift the eyes move first and the head 50 to 100 ms after;
//     the shift's saccade lasts the main sequence for its size;
//   - the saccades' scan: each saccade 20 to 30 ms plus 2 to 3 ms a degree,
//     fixations 200 to 400 ms, microsaccades under a degree;
//   - blinks through the pose's curves to the face's weights, 15 to 20 a
//     minute, and a blink on about a third of the gaze shifts over 30
//     degrees.

import std.list
import ae3d.core
import ae3d.engine
import ae3d.figure
import ae3d.gltf
import ae3d.morph
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.face

extern exit(code: int)

const VROID = "tests/fixtures/people/vroid_base_female.vrm"
const DEG = 57.29578

var g_failures = 0

check(name: string, condition: bool) {
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

absf(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

angle_of(a: Vec3, b: Vec3) -> float {
    return core.atan2_of(core.v3_len(core.v3_cross(a, b)), core.v3_dot(a, b))
}

// --- saccades, on their own ---------------------------------------------------------------------

saccade_timing() {
    println("saccades, two minutes at 1 kHz:")
    s = face.saccades_new(5)
    dt = 0.001
    steps = 120000
    was_yaw = 0.0
    was_pitch = 0.0
    moving = false
    start = 0
    from_yaw = 0.0
    from_pitch = 0.0
    last_end = 0 - 1
    count = 0
    micro = 0
    off_sequence = 0
    biggest_micro = 0.0
    short_fix = 1000.0
    long_fix = 0.0
    // A line through (amplitude, duration), for the main sequence's slope
    // and intercept.
    sx = 0.0
    sy = 0.0
    sxx = 0.0
    sxy = 0.0
    i = 0
    while i < steps {
        face.saccades_step(s, dt)
        y = face.saccade_yaw(s) * DEG
        p = face.saccade_pitch(s) * DEG
        changed = absf(y - was_yaw) > 0.0000001 || absf(p - was_pitch) > 0.0000001
        if changed && !moving {
            moving = true
            start = i
            from_yaw = was_yaw
            from_pitch = was_pitch
            if last_end >= 0 {
                fix = ((start - last_end) as float) * dt
                if fix < short_fix { short_fix = fix }
                if fix > long_fix { long_fix = fix }
            }
        }
        if !changed && moving {
            moving = false
            last_end = i
            span = ((i - start) as float) * dt * 1000.0
            amp = core.sqrt_of((y - from_yaw) * (y - from_yaw) + (p - from_pitch) * (p - from_pitch))
            count = count + 1
            if amp < 1.0 {
                micro = micro + 1
                if amp > biggest_micro { biggest_micro = amp }
            }
            // The main sequence, a step either side for the clock.
            if span < 20.0 + 2.0 * amp - 1.0 || span > 30.0 + 3.0 * amp + 1.0 { off_sequence = off_sequence + 1 }
            sx = sx + amp
            sy = sy + span
            sxx = sxx + amp * amp
            sxy = sxy + amp * span
        }
        was_yaw = y
        was_pitch = p
        i = i + 1
    }
    n = count as float
    slope = (n * sxy - sx * sy) / (n * sxx - sx * sx)
    intercept = (sy - slope * sx) / n
    println("  ${count} saccades (${micro} microsaccades, the largest ${biggest_micro} degrees), ${off_sequence} off the main sequence")
    println("  duration = ${intercept} ms + ${slope} ms a degree; fixations ${short_fix * 1000.0} to ${long_fix * 1000.0} ms")
    check("every saccade lasts 20 to 30 ms plus 2 to 3 ms a degree", off_sequence == 0 && count > 200)
    check("the main sequence fitted: 20 to 30 ms, 2 to 3 ms a degree", intercept >= 20.0 && intercept <= 30.0 && slope >= 2.0 && slope <= 3.0)
    check("fixations of 200 to 400 ms (to the clock's millisecond)", short_fix >= 0.199 && long_fix <= 0.401)
    check("microsaccades, all under a degree", micro > 20 && biggest_micro < 1.0)
    face.saccades_free(s)
}

blinks_on_shifts() {
    println("blinks with gaze shifts:")
    b = face.blinker_new(3)
    big = 0
    small = 0
    shifts = 3000
    i = 0
    while i < shifts {
        // A blink's length and more between shifts, so none is under way.
        face.blink_step(b, 0.5)
        if face.blink_on_shift(b, 45.0) { big = big + 1 }
        face.blink_step(b, 0.5)
        if face.blink_on_shift(b, 20.0) { small = small + 1 }
        i = i + 1
    }
    share = (big as float) / (shifts as float)
    println("  ${big} of ${shifts} shifts of 45 degrees began a blink (${share}); ${small} of ${shifts} of 20 degrees")
    check("about a third of the shifts over 30 degrees bring a blink", share > 0.30 && share < 0.37)
    check("none under 30 degrees", small == 0)
    face.blinker_free(b)
}

// --- the figure ---------------------------------------------------------------------------------

struct Figure {
    e: *Engine
    a: *Animator
    r: *Rig
    worlds: ptr
}

figure_up() -> Figure {
    e = engine.engine_new()
    o = figure.figure(e, "Face", VROID)
    if o == null { return Figure { e: e, a: null, r: null, worlds: null } }
    a = animator.attach(e, o)
    r = animator.rig(a)
    // Standing as it was made: a two-frame take of its rest pose.
    rest = clips.from_frames(r, "Rest", 2, 30.0)
    clips.set_looping(rest, true)
    s = animator.add_state(a, "rest", animator.add_take(a, rest, false), true)
    animator.play(a, s, 0.0)
    return Figure { e: e, a: a, r: r, worlds: pose.new(r) }
}

figure_down(f: Figure) {
    pose.release(f.worlds)
    figure.figures_free(f.e)
    engine.engine_free(f.e)
}

step(f: Figure, dt: float) {
    animator.evaluate(f.a, dt)
    pose.world(f.r, animator.pose_now(f.a), f.worlds)
}

run(f: Figure, seconds: float, dt: float) {
    n = (seconds / dt) as int
    i = 0
    while i < n {
        step(f, dt)
        i = i + 1
    }
}

eyes_between(f: Figure, l: *Look) -> Vec3 {
    return core.v3_mul(core.v3_add(ikrig.look_eye_at(l, f.r, f.worlds, pose.EYE_L), ikrig.look_eye_at(l, f.r, f.worlds, pose.EYE_R)), 0.5)
}

// A point `metres` from between the eyes, `yaw` and `pitch` degrees off the
// way the head faces at rest.
point_off(f: Figure, l: *Look, ahead: Vec3, yaw: float, pitch: float, metres: float) -> Vec3 {
    d = core.quat_apply(core.quat_rotate(yaw / DEG, core.vec3(0.0, 1.0, 0.0)), ahead)
    across = core.v3_normalize(core.v3_cross(d, core.vec3(0.0, 1.0, 0.0)))
    d = core.quat_apply(core.quat_rotate(pitch / DEG, across), d)
    return core.v3_add(eyes_between(f, l), core.v3_mul(core.v3_normalize(d), metres))
}

vroid_face() {
    println("VRoid's base female (CC0):")
    f = figure_up()
    if f.a == null {
        check("the figure loads (${gltf.last_error()})", false)
        return
    }
    r = f.r
    eyes = pose.human(r, pose.EYE_L) >= 0 && pose.human(r, pose.EYE_R) >= 0
    println("  ${pose.count(r)} joints, scheme ${pose.scheme(r)}, eyes ${pose.human(r, pose.EYE_L)} and ${pose.human(r, pose.EYE_R)}, ${pose.curve_count(r)} curves")
    check("its naming read as VRoid's, its eyes found", pose.scheme(r) == pose.SCHEME_VROID && eyes && pose.human(r, pose.HEAD) >= 0)
    blinks = 0
    c = 0
    while c < pose.curve_count(r) {
        slot = face.shape_of(pose.curve_name(r, c))
        if slot == face.EYE_BLINK_LEFT || slot == face.EYE_BLINK_RIGHT { blinks = blinks + 1 }
        c = c + 1
    }
    check("its face's targets are the rig's curves, both eyes' closing among them", pose.curve_count(r) >= 50 && blinks == 2)

    // The eyes on points near and far, ahead and aside: each within a degree.
    l = animator.look(f.a)
    step(f, 1.0 / 60.0)
    ahead = ikrig.look_head_forward(l, r, f.worlds)
    yaws = [0.0, 0.0 - 25.0, 20.0, 60.0, 0.0]
    pitches = [0.0, 5.0, 15.0, 0.0 - 10.0, 0.0]
    metres = [1.0, 1.5, 2.0, 1.0, 0.25]
    worst = 0.0
    k = 0
    while k < 5 {
        target = point_off(f, l, ahead, yaws[k], pitches[k], metres[k])
        animator.look_at(f.a, target, 1.0)
        run(f, 1.5, 1.0 / 60.0)
        e = ikrig.look_eye_error(l, r, f.worlds) * DEG
        println("    ${yaws[k]} degrees aside, ${pitches[k]} up, ${metres[k]} m: the eyes ${e} degrees off it")
        if e > worst { worst = e }
        k = k + 1
    }
    check("the eyes land within 1 degree of what is looked at, near and far, ahead and aside", worst < 1.0)
    // Near, the eyes converge: the two lines cross at the point.
    near_point = point_off(f, l, ahead, 0.0, 0.0, 0.25)
    animator.look_at(f.a, near_point, 1.0)
    run(f, 1.0, 1.0 / 60.0)
    converge = angle_of(ikrig.look_eye_forward(l, r, f.worlds, pose.EYE_L), ikrig.look_eye_forward(l, r, f.worlds, pose.EYE_R)) * DEG
    // What two lines from the eyes to the point make between them.
    lines = angle_of(core.v3_normalize(core.v3_sub(near_point, ikrig.look_eye_at(l, r, f.worlds, pose.EYE_L))),
                     core.v3_normalize(core.v3_sub(near_point, ikrig.look_eye_at(l, r, f.worlds, pose.EYE_R)))) * DEG
    apart = core.v3_len(core.v3_sub(ikrig.look_eye_at(l, r, f.worlds, pose.EYE_L), ikrig.look_eye_at(l, r, f.worlds, pose.EYE_R)))
    println("  at 25 cm the eyes (${apart * 100.0} cm apart) converge ${converge} degrees, their lines to the point ${lines}")
    check("at 25 cm the eyes converge on the point: their angle is their lines' within 0.5 degree, and over 5 degrees", absf(converge - lines) < 0.5 && converge > 5.0)

    // A gaze shift of 35 degrees: the eyes first, the head after.
    start = point_off(f, l, ahead, 0.0, 0.0, 1.5)
    animator.look_at(f.a, start, 1.0)
    run(f, 1.5, 1.0 / 60.0)
    target = point_off(f, l, ahead, 35.0, 0.0, 1.5)
    eye0 = ikrig.look_eye_forward(l, r, f.worlds, pose.EYE_L)
    head0 = ikrig.look_head_forward(l, r, f.worlds)
    animator.look_at(f.a, target, 1.0)
    dt = 0.001
    eye_on = 0 - 1
    head_on = 0 - 1
    fast_from = 0 - 1
    fast_to = 0 - 1
    was = eye0
    i = 0
    while i < 1500 {
        step(f, dt)
        eye = ikrig.look_eye_forward(l, r, f.worlds, pose.EYE_L)
        head = ikrig.look_head_forward(l, r, f.worlds)
        if eye_on < 0 && angle_of(eye, eye0) * DEG > 0.5 { eye_on = i }
        if head_on < 0 && angle_of(head, head0) * DEG > 0.5 { head_on = i }
        speed = angle_of(eye, was) * DEG / dt
        if speed > 30.0 {
            if fast_from < 0 { fast_from = i }
            fast_to = i
        }
        was = eye
        i = i + 1
    }
    lead = ((head_on - eye_on) as float) * dt * 1000.0
    saccade = ((fast_to - fast_from + 1) as float) * dt * 1000.0
    after = ikrig.look_eye_error(l, r, f.worlds) * DEG
    println("  a 35 degree shift: the eyes move at ${eye_on} ms, the head at ${head_on} ms (${lead} ms after); the saccade ${saccade} ms over 30 degrees a second; then ${after} degrees off")
    check("the eyes lead the head by 50 to 100 ms", lead >= 50.0 && lead <= 100.0)
    check("the shift's saccade lasts the main sequence for 35 degrees (90 to 135 ms, its velocity over 30 degrees a second)", saccade >= 0.8 * 90.0 && saccade <= 135.0)
    check("and the eyes end on the point, within 1 degree", after < 1.0)

    // The face on: blinks through the pose to the weights, and with shifts.
    check("the face goes on: blink curves and eyes", animator.face_on(f.a, 11))
    left = 0 - 1
    c = 0
    while c < pose.curve_count(r) {
        if face.shape_of(pose.curve_name(r, c)) == face.EYE_BLINK_LEFT { left = c }
        c = c + 1
    }
    lid_model = pose.curve_model(r, left)
    lid_target = pose.curve_target(r, left)
    blinks_seen = 0
    shut = 0.0
    through = true
    was_w = 0.0
    frames = 60 * 120
    i = 0
    while i < frames {
        step(f, 1.0 / 60.0)
        w = core.model_morph_weight(lid_model, lid_target)
        if absf(w - pose.curve(r, animator.pose_now(f.a), left)) > 0.000001 { through = false }
        if w > 0.0 && was_w == 0.0 { blinks_seen = blinks_seen + 1 }
        if w > shut { shut = w }
        was_w = w
        i = i + 1
    }
    rate = (blinks_seen as float) / 2.0
    println("  two minutes still: ${blinks_seen} blinks, ${rate} a minute, the lids shut to ${shut}")
    check("the face's weights are the pose's curves: the blink goes through the pose", through)
    check("15 to 20 blinks a minute, lids fully shut", rate >= 15.0 && rate <= 20.0 && shut >= 1.0)
    // Shifts of 45 degrees each second: blinks begun on them.
    points = [point_off(f, l, ahead, 0.0 - 22.5, 0.0, 1.5), point_off(f, l, ahead, 22.5, 0.0, 1.5)]
    shifts = 0
    with_blink = 0
    i = 0
    while i < 400 {
        animator.look_at(f.a, points[i % 2], 1.0)
        before = face.blinks(animator.blinker(f.a))
        step(f, 1.0 / 60.0)
        if ikrig.look_shift(l) > 30.0 {
            shifts = shifts + 1
            if face.blinks(animator.blinker(f.a)) > before { with_blink = with_blink + 1 }
        }
        run(f, 1.0, 1.0 / 60.0)
        i = i + 1
    }
    share = (with_blink as float) / (shifts as float)
    println("  ${shifts} shifts of 45 degrees, ${with_blink} with a blink begun on them (${share})")
    check("about a third of large gaze shifts bring a blink", shifts >= 390 && share > 0.25 && share < 0.42)
    figure_down(f)
}

main() {
    println("test_face (#910)")
    saccade_timing()
    blinks_on_shifts()
    vroid_face()
    if g_failures > 0 {
        println("test_face: ${g_failures} FAILED")
        exit(1)
    }
    println("test_face: all passed")
}
