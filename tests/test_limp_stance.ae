// ci: optimised -- forty limp drops, each a figure's fall, CPU work -O0 makes several times slower
// A limp body does not stand (#1002). The UE5 mannequin made a character
// (ae3d.character, on 100STYLE's gaits), walking at 1.2 m/s or running at
// 3.45, let go wholly from where its stride has it (character.die, its
// muscles out at once), every body then stopped: a drop from standing in
// the stance the stride gives it, its feet 0.3 to 0.8 m apart and either leg
// ahead, at twenty moments of each gait's stride; and standing, its legs set
// straight in split stances by hand, 0.3 to 0.8 m apart, either leg ahead,
// its trunk upright or turned 0.3 rad either way. Each in an engine of its
// own, no window, stepped at 60 Hz. Limp, its joints' springs held it up on
// a wide stance: test_knockdowns' seed 60 struck from the gaits' walk
// (agent/gaits7) stood so through step 600 and never got up. Let go, a
// ragdoll's springs are off and its joints' friction is LIMP_FRICTION of
// the made (physics.limp_springs), so every drop here lies; with the
// springs off and the friction whole, a figure let go standing still stood
// balanced on it (test_get_up's limp one).
//
//   - every drop lies within 2 s: its drawn pelvis under DOWN_HIGH over the
//     ground;
//   - the stances swept reach 0.3 and 0.8 m apart, with each leg ahead.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.character
import ae3d.physanim

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const MOMENTS = 20                    // moments of each gait's stride
const DOWN_HIGH = 0.45                // m the pelvis over the ground: lying (motion's DOWN_HEIGHT)
const LIE_MOST = 120                  // steps it may take to lie
const WIDE_LEAST = 0.3                // m apart, the split stances set by hand
const WIDE_MOST = 0.8
const WIDE_STEPS = 5
const LEG = 0.85                      // m, about the mannequin's leg, hip to ankle
// The trunk turned at the spine about the hips' line, each split stance
// upright and leaning LEAN each way (seed 60 stood leaning back).
const LEAN = 0.3

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

joint_at(r: *pose.Rig, p: ptr, w: ptr, slot: int) -> Vec3 {
    pose.world(r, p, w)
    return clips.ground_point(r, pose.translation(w, pose.human(r, slot)))
}

// Joint `j` of local pose `p` (a thigh, rig-space pose `w`) turned `angle`
// about `axis` (rig space) where it hangs from its parent.
turn_thigh(r: *pose.Rig, p: ptr, w: ptr, j: int, axis: Vec3, angle: float) {
    up = pose.parent(r, j)
    world = core.quat_normalize(core.quat_mul(core.quat_rotate(angle, axis), pose.rotation(w, j)))
    pose.set_rotation(p, j, core.quat_normalize(core.quat_mul(core.quat_conjugate(pose.rotation(w, up)), world)))
}

// Knee `j` of local pose `p` as the rest pose has it: the leg straight.
straighten(r: *pose.Rig, p: ptr, j: int) {
    pose.set_rotation(p, j, pose.rotation(pose.rest(r), j))
}

// A drop: walked or run `steps` steps at `speed`, let go and stopped. Its
// feet apart (m), which leg ahead (1 the left), and the steps it took to lie
// (-1: not within LIE_MOST).
drop(g: *Gaits, speed: float, steps: int, split: float, lean: float) -> (float, int, int) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Limp", MANNEQUIN, g)
    if c == null || !character.physical(c) { return 0.0, 0, 0 - 1 }
    a = character.animator_of(c)
    r = animator.rig(a)
    p = pose.new(r)
    w = pose.new(r)
    k = 0
    while k < steps {
        character.move(c, core.vec3(0.0, 0.0, speed), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // A split stance set by hand (`split` over 0): its animator let go and
    // its thighs turned apart about the hips' line, the left ahead (or
    // behind, `split` under 0), its legs straight, and its legs' bodies
    // carried there (kinematic, they follow the figure's joints).
    if split != 0.0 {
        character.pause(c)
        animator.pause(a)
        pose.read(r, p)
        pose.world(r, p, w)
        tl = pose.human(r, pose.THIGH_L)
        tr = pose.human(r, pose.THIGH_R)
        cl = pose.human(r, pose.CALF_L)
        cr = pose.human(r, pose.CALF_R)
        across = core.v3_normalize(core.v3_sub(pose.translation(w, tl), pose.translation(w, tr)))
        straighten(r, p, cl)
        straighten(r, p, cr)
        turn_thigh(r, p, w, tl, across, 0.0 - split)
        turn_thigh(r, p, w, tr, across, split)
        if lean != 0.0 { turn_thigh(r, p, w, pose.human(r, pose.SPINE_01), across, lean) }
        pose.apply(r, p)
        k = 0
        while k < 3 {
            engine.engine_update(e, STEP)
            pose.apply(r, p)
            k = k + 1
        }
    }
    pose.read(r, p)
    left = joint_at(r, p, w, pose.FOOT_L)
    right = joint_at(r, p, w, pose.FOOT_R)
    apart = core.v3_len(core.vec3(left.x - right.x, 0.0, left.z - right.z))
    ahead = 0
    if left.z > right.z { ahead = 1 }
    _died = character.die(c, core.vec3(0.0, 0.0, 0.0), left, 0.0)
    rag = physanim.ragdoll_of(character.physanim_of(c))
    zero = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < physics.ragdoll_bone_count(rag) {
        physics.ragdoll_set_bone_velocity(rag, i, zero, zero)
        i = i + 1
    }
    lay = 0 - 1
    k = 0
    while k < LIE_MOST && lay < 0 {
        engine.engine_update(e, STEP)
        pose.read(r, p)
        if joint_at(r, p, w, pose.PELVIS).y < DOWN_HIGH { lay = k + 1 }
        k = k + 1
    }
    pose.release(p)
    pose.release(w)
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return apart, ahead, lay
}

main() {
    println("limp_stance: let go in the stances a walk's and a run's stride give it, every drop lies (#1002)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    count = core.env_int("AE3D_LIMP_MOMENTS", MOMENTS)
    speeds = [1.2, 3.45]
    least = 10.0
    most = 0.0
    lefts = 0
    rights = 0
    lay_most = 0
    stood = 0
    s = 0
    while s < 2 {
        i = 0
        while i < count {
            apart, ahead, lay = drop(g, speeds[s], 90 + i * 3, 0.0, 0.0)
            if core.env_int("AE3D_LIMP_TRACE", 0) == 1 { println("  ${speeds[s]} m/s, moment ${i}: feet ${apart} m apart, the ${ahead} leg ahead, lying after ${lay} steps") }
            if apart < least { least = apart }
            if apart > most { most = apart }
            if ahead == 1 { lefts = lefts + 1 } else { rights = rights + 1 }
            if lay < 0 { stood = stood + 1 } else if lay > lay_most { lay_most = lay }
            i = i + 1
        }
        s = s + 1
    }
    // And split stances set by hand, standing: the feet WIDE_LEAST to
    // WIDE_MOST apart in WIDE_STEPS, each leg ahead.
    n = 0
    while n <= WIDE_STEPS {
        want = WIDE_LEAST + (WIDE_MOST - WIDE_LEAST) * (n as float) / (WIDE_STEPS as float)
        x = core.clampf(want / (2.0 * LEG), 0.0, 1.0)
        angle = core.atan2_of(x, core.sqrt_of(1.0 - x * x))
        way = 0
        while way < 6 {
            split = angle
            if way % 2 == 1 { split = 0.0 - angle }
            lean = 0.0
            if way / 2 == 1 { lean = LEAN }
            if way / 2 == 2 { lean = 0.0 - LEAN }
            apart, ahead, lay = drop(g, 0.0, 30, split, lean)
            if core.env_int("AE3D_LIMP_TRACE", 0) == 1 { println("  split ${split} rad, trunk turned ${lean}: feet ${apart} m apart, the ${ahead} leg ahead, lying after ${lay} steps") }
            if apart < least { least = apart }
            if apart > most { most = apart }
            if ahead == 1 { lefts = lefts + 1 } else { rights = rights + 1 }
            if lay < 0 { stood = stood + 1 } else if lay > lay_most { lay_most = lay }
            way = way + 1
        }
        n = n + 1
    }
    character.gaits_free(g)
    println("  ${count * 2 + (WIDE_STEPS + 1) * 6} drops, feet ${least} to ${most} m apart, the left leg ahead in ${lefts}, the right in ${rights}: ${stood} still standing after 2 s, the slowest lying after ${(lay_most as float) * STEP} s")
    check("every limp drop lies within 2 s", stood == 0)
    check("the stances swept reach 0.3 and 0.8 m apart, each leg ahead", least <= 0.3 && most >= 0.8 && lefts > 0 && rights > 0)
    if g_failures == 0 {
        println("limp_stance: all checks passed (${g_checks})")
        return
    }
    println("limp_stance: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
