// An impact shows on the frame it lands (#581), held to numbers. A figure
// ANIMATED on its rig, standing, is set POWERED and struck at the chest in
// the same step, as a game reacts to a blow; its twin was POWERED all
// along. No window: the engine is stepped by hand. For the 0.3 s after the
// blow, frame by frame:
//
//   - the drawn hips go where the pelvis body goes: from the blow on, the
//     drawing's way and the body's differ by under 2 cm (the bodies trail
//     a rig of other proportions by that much at rest, and that offset
//     fades);
//   - a fifth of a second in, the drawing has gone most of the way the
//     body has (over 80%);
//   - the twin, POWERED all along, draws its hips with its body to the
//     millimetre.
//
// Before #581 the drawing blended from the rig's pose to the bodies' along
// a smoothstep, and fell 6 cm behind a 60 N s blow 0.08 s after it.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const BLOW = 60.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

drawn_hips(rig: *Skeleton) -> Vec3 {
    hips = skin.skeleton_bone(rig, skin.skeleton_find(rig, "Hips"))
    core.model_sync_transform(hips)
    return hips.world_position
}

pelvis(m: *Motion) -> Vec3 {
    return behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
}

main() {
    println("impact_shows: a blow drawn on the frame it lands (#581)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    rigs_block = calloc(2, 8)
    rigs = rigs_block as ptr[]
    motions_block = calloc(2, 8)
    motions = motions_block as ptr[]
    k = 0
    while k < 2 {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 3.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        rigs[k] = rig as ptr
        physics.ragdoll_dress(r, rig)
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        if k == 0 { motion.set_mode(m, motion.ANIMATED) } else { motion.set_mode(m, motion.POWERED) }
        motions[k] = m as ptr
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    // The blow, from behind at the chest; the animated one goes POWERED
    // with it.
    struck = motions[0] as *Motion
    twin = motions[1] as *Motion
    motion.set_mode(struck, motion.POWERED)
    k = 0
    while k < 2 {
        m = motions[k] as *Motion
        chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
        motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - BLOW))
        k = k + 1
    }
    body_from = pelvis(struck)
    drawn_from = drawn_hips(rigs[0] as *Skeleton)
    twin_body_from = pelvis(twin)
    twin_drawn_from = drawn_hips(rigs[1] as *Skeleton)
    worst = 0.0
    worst_at = 0.0
    twin_worst = 0.0
    share = 0.0
    went = 0.0
    step = 0
    while step < 18 {
        engine.engine_update(e, STEP)
        step = step + 1
        body = core.v3_sub(pelvis(struck), body_from)
        drawn = core.v3_sub(drawn_hips(rigs[0] as *Skeleton), drawn_from)
        apart = core.v3_len(core.v3_sub(body, drawn))
        if apart > worst {
            worst = apart
            worst_at = (step as float) * STEP
        }
        twin_apart = core.v3_len(core.v3_sub(core.v3_sub(pelvis(twin), twin_body_from), core.v3_sub(drawn_hips(rigs[1] as *Skeleton), twin_drawn_from)))
        if twin_apart > twin_worst { twin_worst = twin_apart }
        if step == 12 {
            went = core.v3_len(body)
            if went > 0.000001 { share = core.v3_dot(drawn, body) / (went * went) }
        }
    }
    println("  over the 0.3 s after the blow the drawn hips' way and the body's differ by ${worst * 100.0} cm at most (at ${worst_at} s); 0.2 s in the body has gone ${went * 100.0} cm and the drawing ${share * 100.0}% of it; the twin, powered all along, ${twin_worst * 1000.0} mm")
    check("the drawn hips go where the body goes, within 2 cm, from the blow on", worst < 0.02)
    check("a fifth of a second in, the drawing has gone most of the body's way", went > 0.02 && share > 0.8)
    check("the twin, powered all along, draws its hips with its body to the millimetre", twin_worst < 0.001)
    engine.engine_free(e)
    k = 0
    while k < 2 {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(rigs_block)
    free(motions_block)
    if g_failures == 0 {
        println("impact_shows: all checks passed (${g_checks})")
        return
    }
    println("impact_shows: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
