// A figure shoved toward a wall within its reach catches it (#590), held to
// numbers on the box man (tests/fixtures/gltf/humanoid.glb, motion.on_figure,
// POWERED), the motion showcase's bracing figure's case: shoved at the chest
// from behind at 2.4 m/s toward a wall 1.2 m wide straight ahead, no
// window, the engine stepped by hand.
//
//   - with the wall 0.75 and 0.9 m ahead it takes the wall with its hands
//     and pushes back upright: never falling, lying or down, and leaning
//     under 0.1 rad four seconds after the shove. Falling from the stagger's
//     tilt as before, the protective fall reached its arms for the ground,
//     the wall took its chest, and it lay against the wall 64 degrees over;
//   - with the wall 1.5 m ahead, out of its hands' reach as it goes over,
//     it falls, and its protective fall starts by 0.9 rad, as before: held
//     up by a wall it could not reach, it went over as a plank.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const SHOVE = 2.4

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The figure shoved toward a wall `ahead` metres in front of its pelvis:
// whether it went down, the lean four seconds on, the most lean, and the
// lean as its fall began (0 when none did).
shoved(ahead: float) -> (bool, float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        engine.engine_free(e)
        return false, 0.0 - 1.0, 0.0, 0.0
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    wall = engine.object(e, "Wall", loader.cube(1.0))
    behaviour.object_set_position(wall, core.vec3(pelvis.x, 1.25, pelvis.z + ahead + 0.25))
    physics.box_collider(wall, core.vec3(1.2, 1.25, 0.25), physics.material(0.8, 0.0))
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    motion.shove(m, human.BONE_SPINE_03, core.vec3(0.0, 0.0, SHOVE * physics.ragdoll_mass(r)))
    down = false
    most = 0.0
    fell_at = 0.0
    later = 0.0
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        lean = motion.tilt(m)
        if lean > most { most = lean }
        if motion.falling(m) && fell_at <= 0.0 { fell_at = lean }
        if motion.falling(m) || motion.lying(m) || motion.down(m) { down = true }
        if k == 239 { later = lean }
        k = k + 1
    }
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
    return down, later, most, fell_at
}

main() {
    println("wall catch: shoved at ${SHOVE} m/s toward a wall it can reach (#590)")
    caught = true
    k = 0
    while k < 2 {
        ahead = 0.75 + 0.15 * (k as float)
        down, later, most, _fell = shoved(ahead)
        if later < 0.0 {
            println("wall catch: SKIP ${PATH} would not load")
            return
        }
        println("  the wall ${ahead} m ahead: went down ${down}, leaning ${most} rad at the most, ${later} rad four seconds on")
        if down || later > 0.1 { caught = false }
        k = k + 1
    }
    check("with the wall 0.75 and 0.9 m ahead it takes the wall and pushes back upright: never down, under 0.1 rad four seconds on", caught)
    down, _later, _most, fell_at = shoved(1.5)
    println("  the wall 1.5 m ahead: went down ${down}, its fall begun at ${fell_at} rad")
    check("with the wall 1.5 m ahead, past its reach, it falls, its protective fall begun by 0.9 rad", down && fell_at > 0.0 && fell_at <= 0.9)
    if g_failures == 0 {
        println("wall catch: all checks passed (${g_checks})")
        return
    }
    println("wall catch: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
