// Heat haze (#738): a column of hot air ripples what is seen through it, on
// OpenGL and Vulkan alike.
//
// A wall of fine stripes, glowing so no light varies on it, and a column of
// hot air before it, two metres tall over the point the camera looks at,
// so all of it is in the frame's upper half and a mirrored one would not
// be. Drawn with
// the column and without:
//   - the frame changes through the column, and hardly anywhere else;
//   - where it changes is the column as the camera sees it: its middle
//     between the column's foot and top on the screen, not mirrored;
//   - a column at no strength changes nothing;
//   - both renderers ripple the same region.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.vulkan
import ae3d.picture
import ae3d.png

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 320
const HEIGHT = 180
const STRIPES = "test://heat_haze/stripes"

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

stripes() -> bool {
    w = 64
    h = 4
    pixels = calloc(w * h, 4)
    i = 0
    while i < w * h {
        v = 0.1
        if ((i % w) / 2) % 2 == 0 { v = 0.9 }
        png.rgba_set(pixels, i, v, v, v, 1.0)
        i = i + 1
    }
    ok = picture.register_rgba(STRIPES, pixels, w, h) == 1
    free(pixels)
    return ok
}

// A glowing wall of stripes 20 m across, 6 m behind the column.
wall() -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    z = 0.0 - 6.0
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 10.0, 0.0 - 5.0, z), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(10.0, 0.0 - 5.0, z), 8.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(10.0, 5.0, z), 8.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 10.0, 5.0, z), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_set_texture(m, STRIPES)
    core.model_set_exposure(m, 10.01)
    core.model_set_casts_shadow(m, false)
    return m
}

kept(pixels: ptr) -> ptr {
    copy = calloc(WIDTH * HEIGHT * 4, 1)
    mem.copy(copy, pixels, WIDTH * HEIGHT * 4)
    return copy
}

struct Ripple {
    inside: int                      // pixels changed within the column's screen box
    outside: int                     // and beyond it
    middle_row: float                // the changed pixels' mean row, top down
}

// Where two frames differ, against the column's box on the screen (top-down
// rows `top` to `foot`, columns `left` to `right`).
ripple(before: ptr, after: ptr, left: int, right: int, top: int, foot: int) -> Ripple {
    out = Ripple { inside: 0, outside: 0, middle_row: 0.0 }
    rows = 0.0
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            at = (y * WIDTH + x) * 4
            d = mem.get_byte(before, at) - mem.get_byte(after, at)
            if d < 0 { d = 0 - d }
            if d > 12 {
                if x >= left && x <= right && y >= top && y <= foot {
                    out.inside = out.inside + 1
                } else {
                    out.outside = out.outside + 1
                }
                rows = rows + (y as float)
            }
            x = x + 1
        }
        y = y + 1
    }
    changed = out.inside + out.outside
    if changed > 0 { out.middle_row = rows / (changed as float) }
    return out
}

var g_gl_middle = 0.0 - 1.0

judge(name: string, r: Ripple, still: int, top: int, foot: int) {
    println("  ${name}: ${r.inside} pixels rippled in the column's box, ${r.outside} beyond it, their middle at row ${r.middle_row} (the column from row ${top} to ${foot}); ${still} changed at no strength")
    check("${name}: hot air ripples what is seen through it", r.inside > 200)
    check("${name}: and hardly anything else (${r.outside} beyond it)", r.outside * 20 < r.inside)
    check("${name}: its middle between the column's foot and top on the screen, the right way up", r.middle_row > (top as float) && r.middle_row < (foot as float))
    check("${name}: at no strength it changes nothing", still == 0)
}

// The column's box on the screen: its foot and its top, its width.
struct Box {
    left: int
    right: int
    top: int
    foot: int
}

box_of(cam: *Camera) -> Box {
    foot = core.camera_world_to_screen(cam, core.vec3(0.0, 0.0, 0.0), WIDTH, HEIGHT)
    top = core.camera_world_to_screen(cam, core.vec3(0.0, 2.0, 0.0), WIDTH, HEIGHT)
    side = core.camera_world_to_screen(cam, core.vec3(0.8 * 1.6, 0.0, 0.0), WIDTH, HEIGHT)
    half = (side.x - foot.x) as int + 2
    return Box { left: (foot.x as int) - half, right: (foot.x as int) + half, top: (top.y as int) - 2, foot: (foot.y as int) + 2 }
}

camera() -> *Camera {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 5.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    return cam
}

frames(backend: *Backend, cam: *Camera, light: *Light) {
    i = 0
    while i < 3 {
        core.backend_render(backend, cam, light)
        i = i + 1
    }
}

opengl_checks(cam: *Camera, light: *Light, b: Box) {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  opengl: SKIP no OpenGL context available")
        return
    }
    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, WIDTH, HEIGHT) {
        println("  opengl: SKIP the backend would not initialise")
        offscreen.context_destroy(context)
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    m = wall()
    core.backend_add_model(&backend, m)
    frames(&backend, cam, light)
    plain = kept(offscreen.target_pixels(target))
    gl.renderer_set_haze(renderer, 0, core.vec3(0.0, 0.0, 0.0), 0.8, 2.0, 0.0, 1.0)
    frames(&backend, cam, light)
    still = ripple(plain, offscreen.target_pixels(target), b.left, b.right, b.top, b.foot)
    gl.renderer_set_haze(renderer, 0, core.vec3(0.0, 0.0, 0.0), 0.8, 2.0, 1.0, 1.0)
    frames(&backend, cam, light)
    r = ripple(plain, offscreen.target_pixels(target), b.left, b.right, b.top, b.foot)
    judge("opengl", r, still.inside + still.outside, b.top, b.foot)
    g_gl_middle = r.middle_row
    free(plain)
    core.backend_remove_model(&backend, m)
    core.model_free(m)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)
}

vulkan_checks(cam: *Camera, light: *Light, b: Box) {
    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    m = wall()
    core.backend_add_model(&backend, m)
    frames(&backend, cam, light)
    plain = kept(core.backend_frame_pixels(&backend))
    vulkan.renderer_set_haze(renderer, 0, core.vec3(0.0, 0.0, 0.0), 0.8, 2.0, 0.0, 1.0)
    frames(&backend, cam, light)
    still = ripple(plain, core.backend_frame_pixels(&backend), b.left, b.right, b.top, b.foot)
    vulkan.renderer_set_haze(renderer, 0, core.vec3(0.0, 0.0, 0.0), 0.8, 2.0, 1.0, 1.0)
    frames(&backend, cam, light)
    r = ripple(plain, core.backend_frame_pixels(&backend), b.left, b.right, b.top, b.foot)
    judge("vulkan", r, still.inside + still.outside, b.top, b.foot)
    if g_gl_middle >= 0.0 {
        d = r.middle_row - g_gl_middle
        if d < 0.0 { d = 0.0 - d }
        check("both renderers ripple the same region (rows ${g_gl_middle} and ${r.middle_row})", d < 4.0)
    }
    free(plain)
    core.backend_remove_model(&backend, m)
    core.model_free(m)
    vulkan.renderer_free(renderer)
}

main() {
    println("heat haze: a column of hot air ripples what is seen through it (#738)")
    check("the stripes register", stripes())
    cam = camera()
    light = core.light_sun(core.vec3(0.2, 0.6, 1.0))
    b = box_of(cam)
    opengl_checks(cam, light, b)
    vulkan_checks(cam, light, b)
    core.light_free(light)
    core.camera_free(cam)
    if g_failures == 0 {
        println("heat haze: all checks passed")
    } else {
        println("heat haze: ${g_failures} failure(s)")
    }
}
