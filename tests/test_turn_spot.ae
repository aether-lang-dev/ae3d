// Turning on the spot as a person does (#984): the head first, then the
// chest, then the hips, and one step for any turn up to about half a turn:
// a pivot of the foot on the turn's side, the other foot brought round once.
// The UE5 mannequin standing on 100STYLE's stand, turned by a mover (its
// facing on the character's 0.6 s half-life), its feet stepping
// (ikrig.feet_set_steps). No window; stepped at 60 Hz.
//
//   - a person's own turns on the spot, found in 100STYLE's neutral idle take
//     (the hips turning 60 degrees or more while they stay within 35 cm):
//     how long each took, how many steps, and how fast a stepping toe went;
//   - 30 degrees each way with no step; 90 and 180 each way with one step,
//     settled in 1 to 2 s, within 2 degrees of the way asked;
//   - the head turns before the chest and the chest before the hips, each by
//     a lag measured, and the hips before the step lifts;
//   - the pivot (the planted foot, held on its toe's tip) slides under 5 mm,
//     the hips stay within 5 cm of their spot;
//   - the stepping toe no faster over the ground than the person's turning
//     steps went (or 1.5 m/s, a turning step's, where none is found).

import std.string
import ae3d.core
import ae3d.engine
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.retarget
import ae3d.bvh
import ae3d.mover

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

floats(n: int) -> ptr { return calloc(n, 8) }

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const STYLE = "tests/fixtures/people/100style/"
const IDLE_TAKE = "tests/fixtures/people/100style/whole/Neutral_ID.bvh.gz"
const TURN_TAKE = "tests/fixtures/people/100style/whole/Neutral_TR1.bvh.gz"
const SLIDE = 0.005

var g_checks = 0
var g_failures = 0
var g_trace = false
// The widest the hips turned from standing while staying near, radians.
var g_widest = 0.0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

fresh() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

flat_distance(a: Vec3, b: Vec3) -> float {
    return core.sqrt_of((a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z))
}

wrap_turn(a: float) -> float {
    x = a
    while x > 3.141592653589793 { x = x - 6.283185307179586 }
    while x < 0.0 - 3.141592653589793 { x = x + 6.283185307179586 }
    return x
}

// The way the hips face over the ground in pose `w`: square to the line from
// the right thigh to the left.
hips_yaw(r: *pose.Rig, w: ptr) -> float {
    left = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_L)))
    right = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_R)))
    across = core.vec3(left.x - right.x, 0.0, left.z - right.z)
    ahead = core.v3_cross(across, core.vec3(0.0, 1.0, 0.0))
    return core.atan2_of(ahead.x, ahead.z)
}

// --- a person's turns on the spot -----------------------------------------------------------------

struct Person {
    turns: int                     // turns on the spot found
    steps_most: int                // the most steps any took
    steps_least: int
    seconds_most: float            // the longest any took, from the hips setting off to settling
    seconds_least: float
    toe_most: float                // the fastest a stepping toe went over the ground, m/s
    degrees_most: float            // the largest turn found
}

// Every turn on the spot in the idle take, retargeted onto the mannequin: a
// stretch from the hips standing (under 0.15 m/s) to standing again, the
// hips turning 60 degrees or more and staying within 35 cm, in at most 3 s.
person_turns(path: string) -> Person {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    feet = ikrig.feet_new(r, o)
    c = bvh.load(path, 0.0)
    made = bvh.take(c, "idle", 0, 0 - 1)
    t = retarget.retarget(bvh.rig(c), made, r)
    n = clips.frames(t)
    rate = clips.rate(t)
    p = pose.new(r)
    w = pose.new(r)
    hx = floats(n) as float[]
    hz = floats(n) as float[]
    yaw = floats(n) as float[]
    tips = floats(n * 6) as float[]
    heights = floats(n * 2) as float[]
    unwrapped = 0.0
    was = 0.0
    f = 0
    while f < n {
        clips.sample_frame(t, r, f, p)
        pose.world(r, p, w)
        hips = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.PELVIS)))
        hx[f] = hips.x
        hz[f] = hips.z
        y = hips_yaw(r, w)
        if f > 0 { unwrapped = unwrapped + wrap_turn(y - was) }
        was = y
        yaw[f] = unwrapped
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(feet, r, w, side)
            tips[f * 6 + side * 3] = tip.x
            tips[f * 6 + side * 3 + 1] = tip.y
            tips[f * 6 + side * 3 + 2] = tip.z
            ankle = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
            heights[f * 2 + side] = ankle.y
            side = side + 1
        }
        f = f + 1
    }
    out = Person { turns: 0, steps_most: 0, steps_least: 1000, seconds_most: 0.0, seconds_least: 1000.0, toe_most: 0.0, degrees_most: 0.0 }
    span = (3.0 * rate) as int
    i = 1
    while i < n - span - 1 {
        if hips_speed(hx, hz, i, rate) > 0.15 {
            i = i + 1
            continue
        }
        // The hips turning from here: the first frame they have turned 60
        // degrees, staying near, and on to where they settle.
        j = i + 1
        found = 0 - 1
        while j < i + span {
            if flat_distance(core.vec3(hx[j], 0.0, hz[j]), core.vec3(hx[i], 0.0, hz[i])) > 0.35 { break }
            if core.abs_of(yaw[j] - yaw[i]) > g_widest { g_widest = core.abs_of(yaw[j] - yaw[i]) }
            if core.abs_of(yaw[j] - yaw[i]) > 1.047 {
                found = j
                break
            }
            j = j + 1
        }
        if found < 0 {
            i = i + 1
            continue
        }
        // Settled: the hips turning under 0.3 rad/s and standing.
        k = found
        while k < n - 1 && k < i + span && (core.abs_of(yaw[k + 1] - yaw[k]) * rate > 0.3 || hips_speed(hx, hz, k, rate) > 0.15) { k = k + 1 }
        // Set off: the first frame turned 3 degrees.
        s = i
        while s < k && core.abs_of(yaw[s] - yaw[i]) < 0.052 { s = s + 1 }
        steps = 0
        side = 0
        while side < 2 {
            low = heights[i * 2 + side]
            up = false
            q = i
            while q <= k {
                h = heights[q * 2 + side]
                if h < low { low = h }
                if !up && h - low > 0.025 {
                    up = true
                    steps = steps + 1
                }
                if up && h - low < 0.01 { up = false }
                if up && q > i {
                    sp = flat_distance(core.vec3(tips[q * 6 + side * 3], 0.0, tips[q * 6 + side * 3 + 2]), core.vec3(tips[(q - 1) * 6 + side * 3], 0.0, tips[(q - 1) * 6 + side * 3 + 2])) * rate
                    if sp > out.toe_most { out.toe_most = sp }
                }
                q = q + 1
            }
            side = side + 1
        }
        seconds = ((k - s) as float) / rate
        degrees = core.abs_of(yaw[k] - yaw[i]) * 57.29578
        println("    a person's turn on the spot at ${(i as float) / rate} s: ${degrees} degrees in ${seconds} s, ${steps} steps")
        out.turns = out.turns + 1
        if steps > out.steps_most { out.steps_most = steps }
        if steps < out.steps_least { out.steps_least = steps }
        if seconds > out.seconds_most { out.seconds_most = seconds }
        if seconds < out.seconds_least { out.seconds_least = seconds }
        if degrees > out.degrees_most { out.degrees_most = degrees }
        i = k + 1
    }
    free(hx as ptr)
    free(hz as ptr)
    free(yaw as ptr)
    free(tips as ptr)
    free(heights as ptr)
    pose.release(p)
    pose.release(w)
    clips.take_free(t)
    clips.take_free(made)
    bvh.capture_free(c)
    ikrig.feet_free(feet)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return out
}

hips_speed(x: float[], z: float[], f: int, rate: float) -> float {
    return flat_distance(core.vec3(x[f + 1], 0.0, z[f + 1]), core.vec3(x[f - 1], 0.0, z[f - 1])) * rate * 0.5
}

// --- the figure's turns ---------------------------------------------------------------------------

// The stop take's standing, looped, as an idle for the UE5 mannequin.
standing_idle(a: *Animator, r: *pose.Rig) -> *Take {
    c = bvh.load("${STYLE}neutral_stop.bvh", 0.0)
    made = bvh.take(c, "stand", 0, 0 - 1)
    stood = retarget.retarget(bvh.rig(c), made, r)
    clips.extract_root(stood, r, clips.up_of(r))
    at = (clips.still_at(stood, 0.1) + 1.0) * clips.rate(stood)
    if at < 0.0 { at = 4.0 * clips.rate(stood) }
    standing = clips.crop(stood, r, at as int, clips.frames(stood) - 1, false)
    idle_t = animator.add_take(a, clips.loop_cut(standing, r), false)
    clips.take_free(standing)
    clips.take_free(stood)
    clips.take_free(made)
    bvh.capture_free(c)
    return idle_t
}

// Point `p` turned `yaw` about the upright through `about`, over the ground.
turned_round(about: Vec3, p: Vec3, yaw: float) -> Vec3 {
    rx = p.x - about.x
    rz = p.z - about.z
    c = core.cos_of(yaw)
    s = core.sin_of(yaw)
    return core.vec3(about.x + rx * c + rz * s, p.y, about.z + rz * c - rx * s)
}

// The fastest a toe's tip goes over the ground in the walk forward
// (100STYLE's, retargeted onto the mannequin, its root motion kept): its
// swing's speed, what a turning step's toe is judged by (#984).
walk_swing() -> float {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    feet = ikrig.feet_new(r, o)
    c = bvh.load("${STYLE}neutral_fw.bvh", 0.0)
    made = bvh.take(c, "walk", 0, 0 - 1)
    t = retarget.retarget(bvh.rig(c), made, r)
    p = pose.new(r)
    w = pose.new(r)
    was = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    most = 0.0
    f = 0
    while f < clips.frames(t) {
        clips.sample_frame(t, r, f, p)
        pose.world(r, p, w)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(feet, r, w, side)
            if f > 0 {
                v = flat_distance(tip, was[side]) * clips.rate(t)
                if v > most { most = v }
            }
            was[side] = tip
            side = side + 1
        }
        f = f + 1
    }
    pose.release(p)
    pose.release(w)
    clips.take_free(t)
    clips.take_free(made)
    bvh.capture_free(c)
    ikrig.feet_free(feet)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return most
}

// The way joint `j` of pose `w` points over the ground along `axis` (its own
// frame's), as a yaw.
joint_yaw(r: *pose.Rig, w: ptr, j: int, axis: Vec3) -> float {
    d = ikrig.dir_to_ground(r, core.quat_apply(pose.rotation(w, j), axis))
    return core.atan2_of(d.x, d.z)
}

// The seconds after `asked` at which `yaw` first turned 3 degrees the way `sign` says, or keep `was`.
onset(was: float, yaw: float, sign: float, t: float) -> float {
    if was < 0.0 && sign * yaw > 0.0524 { return t }
    return was
}

struct Turned {
    turned: float                  // degrees it ended facing
    steps: int
    seconds: float                 // from asked to settled
    head: float                    // seconds to each first turning 3 degrees
    chest: float
    hips: float
    lift: float                    // and to the step lifting
    slid: float                    // the most a held toe slid, m
    hips_off: float                // the farthest the hips went from their spot before a foot pivots, m
    arc_off: float                 // once one pivots, the farthest off the arc a turn about its ball takes them, m
    end_off: float                 // and where they end off where that turn puts them, m
    travelled: float               // how far round the pivot they went, m
    toe: float                   // the fastest a stepping toe went over the ground, m/s
}

turn_case(degrees: float) -> Turned {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle = animator.add_state(a, "idle", standing_idle(a, r), true)
    feet = ikrig.feet_new(r, o)
    ikrig.feet_set_steps(feet, true)
    animator.set_feet(a, feet)
    probe = ikrig.feet_new(r, o)
    m = mover.mover_new(a, o)
    mover.set_half_lives(m, mover.HALF_LIFE, 0.6)
    animator.play(a, idle, 0.0)
    w = pose.new(r)
    out = Turned { turned: 0.0, steps: 0, seconds: 0.0, head: 0.0 - 1.0, chest: 0.0 - 1.0, hips: 0.0 - 1.0, lift: 0.0 - 1.0, slid: 0.0, hips_off: 0.0, arc_off: 0.0, end_off: 0.0, travelled: 0.0, toe: 0.0 }
    sign = 1.0
    if degrees < 0.0 { sign = 0.0 - 1.0 }
    asked = degrees / 57.29578
    if core.abs_of(degrees) >= 180.0 { asked = sign * 3.1329 }
    pelvis = pose.human(r, pose.PELVIS)
    joints = [pose.human(r, pose.HEAD), pose.human(r, pose.SPINE_03), pelvis]
    axes = [core.vec3(0.0, 0.0, 1.0), core.vec3(0.0, 0.0, 1.0), core.vec3(0.0, 0.0, 1.0)]
    yaws0 = [0.0, 0.0, 0.0]
    onsets = [0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0]
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    tips_was = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    start = core.vec3(0.0, 0.0, 0.0)
    busy = 0
    pivoted = false
    pivot_at = core.vec3(0.0, 0.0, 0.0)
    pivot_hips = core.vec3(0.0, 0.0, 0.0)
    pivot_yaw = 0.0
    hips_was = core.vec3(0.0, 0.0, 0.0)
    facing_was = 0.0
    k = 0
    while k < (4.5 / STEP) as int {
        if k == 30 { mover.face(m, asked, true) }
        mover.step(m, STEP)
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        hips = ikrig.to_ground(r, pose.translation(w, pelvis))
        if k == 29 {
            start = hips
            ahead = ikrig.dir_to_rig(r, core.vec3(core.sin_of(mover.facing_of(m)), 0.0, core.cos_of(mover.facing_of(m))))
            q = 0
            while q < 3 {
                axes[q] = core.quat_apply(core.quat_conjugate(pose.rotation(w, joints[q])), ahead)
                yaws0[q] = joint_yaw(r, w, joints[q], axes[q])
                q = q + 1
            }
        }
        stepping = ikrig.feet_stepping(feet, 0) || ikrig.feet_stepping(feet, 1)
        if k >= 30 {
            t = (k - 29) as float * STEP
            q = 0
            while q < 3 {
                onsets[q] = onset(onsets[q], wrap_turn(joint_yaw(r, w, joints[q], axes[q]) - yaws0[q]), sign, t)
                q = q + 1
            }
            if out.lift < 0.0 && stepping { out.lift = t }
            if stepping || core.abs_of(wrap_turn(mover.facing_of(m) - asked)) > 0.035 { busy = k - 29 }
            // The hips: on their spot until a foot pivots, then on the arc a
            // turn about its ball takes them round (#984).
            on, ball = ikrig.feet_turn_pivot(feet)
            if on && !pivoted {
                pivoted = true
                pivot_at = ball
                pivot_hips = hips_was
                pivot_yaw = facing_was
            }
            if pivoted {
                expect = turned_round(pivot_at, pivot_hips, wrap_turn(mover.facing_of(m) - pivot_yaw))
                d = flat_distance(hips, expect)
                if d > out.arc_off { out.arc_off = d }
                out.end_off = d
                travelled = flat_distance(hips, start)
                if travelled > out.travelled { out.travelled = travelled }
            } else {
                d = flat_distance(hips, start)
                if d > out.hips_off { out.hips_off = d }
            }
        }
        hips_was = hips
        facing_was = mover.facing_of(m)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(probe, r, w, side)
            if k > 29 && ikrig.feet_stepping(feet, side) {
                went = flat_distance(tip, tips_was[side]) / STEP
                if went > out.toe { out.toe = went }
                if g_trace { println("      ${(k - 29) as float * STEP} s: foot ${side} stepping, its toe ${went} m/s, the body facing ${mover.facing_of(m) * 57.29578}") }
            }
            if g_trace && k > 29 && k % 6 == 0 {
                ank = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
                println("      ${(k - 29) as float * STEP} s: foot ${side} heading ${core.atan2_of(tip.x - ank.x, tip.z - ank.z) * 57.29578}, locked ${ikrig.feet_locked(feet, side)}, stepping ${ikrig.feet_stepping(feet, side)}, body ${mover.facing_of(m) * 57.29578}")
            }
            tips_was[side] = tip
            // A held foot's ball, which a pivot turns about (#984).
            ball_j = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.BALL_L + side * 4)))
            held = ikrig.feet_locked(feet, side) && !ikrig.feet_stepping(feet, side)
            if g_trace && k > 29 && k % 3 == 0 {
                lk, lat, lyaw, lon = ikrig.feet_lock_of(feet, side)
                println("      ${(k - 29) as float * STEP} s: foot ${side} ball at ${ball_j.x} ${ball_j.z}, locked ${lk} on ${lon} at ${lat.x} ${lat.z} heading ${lyaw * 57.29578}, slid ${flat_distance(ball_j, from[side]) * 1000.0} mm from ${from[side].x} ${from[side].z}, held ${held}")
            }
            if held && !was[side] { from[side] = ball_j }
            if held && k > 10 {
                slid = flat_distance(ball_j, from[side])
                if slid > out.slid { out.slid = slid }
            }
            was[side] = held
            side = side + 1
        }
        k = k + 1
    }
    out.steps = ikrig.feet_steps(feet)
    out.turned = wrap_turn(mover.facing_of(m)) * 57.29578
    out.seconds = (busy as float) * STEP
    out.head = onsets[0]
    out.chest = onsets[1]
    out.hips = onsets[2]
    mover.mover_free(m)
    ikrig.feet_free(probe)
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return out
}

main() {
    println("turn_spot: turning on the spot as a person does (#984)")
    g_trace = core.env_int("TURN_TRACE", 0) == 1
    person = person_turns(IDLE_TAKE)
    println("  a person's turns on the spot in the idle take: ${person.turns}, up to ${person.degrees_most} degrees, ${person.steps_least} to ${person.steps_most} steps, ${person.seconds_least} to ${person.seconds_most} s, a stepping toe at ${person.toe_most} m/s at the fastest; the widest standing turn ${g_widest * 57.29578} degrees")
    g_widest = 0.0
    walking = person_turns(TURN_TAKE)
    println("  in the walking turns take: ${walking.turns}, up to ${walking.degrees_most} degrees, ${walking.steps_least} to ${walking.steps_most} steps, ${walking.seconds_least} to ${walking.seconds_most} s, a stepping toe at ${walking.toe_most} m/s at the fastest; the widest standing turn ${g_widest * 57.29578} degrees")
    // The stepping toe is judged by the walk's own swing; the person's
    // turning steps above are printed as a reference only (#984: they
    // shuffled, where the owner's rule is one step).
    toe_bound = walk_swing()
    println("  the walk's own swing: a toe at ${toe_bound} m/s at the fastest")
    sizes = [30.0, 0.0 - 30.0, 90.0, 0.0 - 90.0, 180.0, 0.0 - 180.0]
    k = 0
    while k < 6 {
        degrees = sizes[k]
        asked = degrees
        if core.abs_of(degrees) >= 180.0 { asked = degrees * 3.1329 / 3.14159265 }
        t = turn_case(degrees)
        println("  ${degrees} degrees: turned ${t.turned} in ${t.steps} steps over ${t.seconds} s; the head turned at ${t.head} s, the chest at ${t.chest}, the hips at ${t.hips}, the step lifted at ${t.lift}; a held foot's ball slid ${t.slid * 1000.0} mm; the hips ${t.hips_off * 1000.0} mm off their spot before a foot pivoted, then ${t.arc_off * 1000.0} mm off the arc about its ball at most and ${t.end_off * 1000.0} mm at the end, ${t.travelled * 1000.0} mm round; a stepping toe at ${t.toe} m/s")
        size = core.abs_of(degrees)
        if size < 60.0 {
            check("${degrees} degrees: taken by the hips, no step, within 2 degrees", t.steps == 0 && core.abs_of(t.turned - asked) < 2.0)
        } else {
            check("${degrees} degrees: one step, settled in 1 to 2 s, within 2 degrees", t.steps == 1 && t.seconds >= 1.0 && t.seconds <= 2.0 && core.abs_of(t.turned - asked) < 2.0)
            check("${degrees} degrees: the head before the chest, the chest before the hips, the hips before the step", t.head >= 0.0 && t.chest > t.head && t.hips > t.chest && t.lift > t.hips)
            check("${degrees} degrees: the stepping toe no faster than the walk's own swing (${toe_bound} m/s)", t.toe <= toe_bound)
            check("${degrees} degrees: the hips go round the pivot foot's ball, within 2 cm of that turn's arc and of where it puts them", t.arc_off < 0.02 && t.end_off < 0.02 && t.travelled > 0.0)
        }
        check("${degrees} degrees: a planted foot's ball slides under 5 mm, the hips within 5 cm of their spot until a foot pivots", t.slid < SLIDE && t.hips_off < 0.05)
        k = k + 1
    }
    if g_failures == 0 {
        println("turn_spot: all checks passed (${g_checks})")
        return
    }
    println("turn_spot: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
