// Save games (#507), held to what comes back:
//
//   - a scene played -- a field changed, a field set back to its default
//     over an authored value, a component taken off, an object moved, one
//     destroyed, one spawned, the scene's own rules changed -- saved to a
//     slot and read over the same scene loaded fresh, is the scene as it was
//     played: every field, transform and object, the destroyed one gone and
//     the spawned one back with its id, and the next object spawned taking
//     an id none had;
//   - references between objects come back naming the same objects: an
//     authored one, the spawned one, and one to the destroyed object set to
//     none and counted;
//   - the same through the text form;
//   - a slot gives its details without its state;
//   - a slot changed by a byte reads as damaged, not as a game;
//   - a save from before a field was renamed and another added loads the
//     old value under the new name, the new field at its default, through
//     the migration registered for the step;
//   - two hundred saves and loads in a row each come back the same.
import std.heap
import std.json
import std.fs
import std.mem
import std.bytes
import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.persist
import ae3d.engine
import ae3d.picture
extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Health {
    hp: float
    alive: bool
    team: int
}

health_new() -> ptr {
    h = heap.new(Health)
    h.hp = 100.0
    h.alive = true
    return h as ptr
}
health_free(p: ptr) { heap.free(p as *Health) }

// A mover at schema version 2: `speed` was `velocity` before it, and `grip`
// is new in it.
struct Mover {
    speed: float
    target: Vec3
    grip: float
}

mover_new() -> ptr {
    m = heap.new(Mover)
    m.speed = 1.0
    m.grip = 0.5
    return m as ptr
}
mover_free(p: ptr) { heap.free(p as *Mover) }

struct Rules {
    score: int
}

rules_new() -> ptr { return heap.new(Rules) as ptr }
rules_free(p: ptr) { heap.free(p as *Rules) }

// Who it chases and who sent it: other objects, by id.
struct Chase {
    quarry: int
    sender: int
}

chase_new() -> ptr { return heap.new(Chase) as ptr }
chase_free(p: ptr) { heap.free(p as *Chase) }

var g_health: ptr = null             // *ComponentKind
var g_mover: ptr = null
var g_rules: ptr = null
var g_chase: ptr = null

// Saves from version 1 had the speed in km/h.
from_kmh(fields: ptr) {
    v = json.object_get_raw(fields, "speed")
    if v != null { json.object_set_raw(fields, "speed", json.num(json.get_number(v) / 3.6)) }
}

kinds() {
    h = component.kind("Health", "Game", health_new, health_free)
    component.float_field(h, "hp", offsetof(Health, hp), 0.0, 1000.0)
    component.bool_field(h, "alive", offsetof(Health, alive))
    team = component.enum_field(h, "team", offsetof(Health, team))
    component.enum_choice_add(team, "red")
    component.enum_choice_add(team, "blue")
    g_health = h as ptr
    m = component.kind("Mover", "Game", mover_new, mover_free)
    component.float_field(m, "speed", offsetof(Mover, speed), 0.0, 100.0)
    component.vec3_field(m, "target", offsetof(Mover, target))
    component.float_field(m, "grip", offsetof(Mover, grip), 0.0, 1.0)
    component.set_schema_version(m, 2)
    component.rename_field(m, "velocity", "speed", 2)
    persist.migration("Mover", 2, from_kmh)
    g_mover = m as ptr
    r = component.kind("Rules", "Game", rules_new, rules_free)
    component.int_field(r, "score", offsetof(Rules, score), 0, 1000000)
    component.set_scene(r, true)
    g_rules = r as ptr
    ch = component.kind("Chase", "Game", chase_new, chase_free)
    component.object_field(ch, "quarry", offsetof(Chase, quarry))
    component.object_field(ch, "sender", offsetof(Chase, sender))
    g_chase = ch as ptr
}

health() -> *ComponentKind { return g_health as *ComponentKind }
mover() -> *ComponentKind { return g_mover as *ComponentKind }
rules() -> *ComponentKind { return g_rules as *ComponentKind }
chase() -> *ComponentKind { return g_chase as *ComponentKind }

field(k: *ComponentKind, name: string) -> *ComponentField { return component.field_named(k, name) }

// The scene as authored: four objects, ids 1 to 4; the first's health
// authored at 80, and D chasing B.
author() -> *Scene {
    s = behaviour.scene_new()
    a = behaviour.object_new("A")
    b = behaviour.object_new("B")
    c = behaviour.object_new("C")
    d = behaviour.object_new("D")
    behaviour.scene_add(s, a)
    behaviour.scene_add(s, b)
    behaviour.scene_add(s, c)
    behaviour.scene_add(s, d)
    ha = component.add(a, health())
    component.set_float(ha, field(health(), "hp"), 80.0)
    component.add(a, mover())
    component.add(b, health())
    component.add(c, mover())
    component.set_object(component.add(d, chase()), field(chase(), "quarry"), b)
    component.add(behaviour.scene_root(s), rules())
    return s
}

var g_spawned = 0

make_object(context: ptr, name: string, model: string) -> *GameObject {
    s = context as *Scene
    o = behaviour.object_new(name)
    behaviour.scene_add(s, o)
    g_spawned = g_spawned + 1
    return o
}

// The scene played: A's health back to its default and dead, on the blue
// team, moved and turned, sent by C after E; B's health taken off; C
// destroyed; E spawned with its own health and mover; the score up.
play(s: *Scene) {
    a = behaviour.scene_find_id(s, 1)
    ha = component.find(a, health())
    component.set_float(ha, field(health(), "hp"), 100.0)
    component.set_bool(ha, field(health(), "alive"), false)
    component.set_int(ha, field(health(), "team"), 1)
    behaviour.object_set_position(a, core.vec3(1.0, 2.0, 3.0))
    behaviour.object_set_rotation(a, core.quat_from_euler(0.0, 0.7, 0.0))
    ma = component.find(a, mover())
    component.set_vec3(ma, field(mover(), "target"), core.vec3(0.25, 0.0, 0.0 - 9.5))
    b = behaviour.scene_find_id(s, 2)
    component.remove(b, component.find(b, health()))
    c = behaviour.scene_find_id(s, 3)
    chase_a = component.add(a, chase())
    component.set_object(chase_a, field(chase(), "sender"), c)
    behaviour.scene_destroy_later(s, c)
    behaviour.scene_update(s, 0.0)
    e = behaviour.object_new("E")
    behaviour.scene_add(s, e)
    he = component.add(e, health())
    component.set_float(he, field(health(), "hp"), 30.0)
    me = component.add(e, mover())
    component.set_float(me, field(mover(), "speed"), 7.0)
    component.set_object(chase_a, field(chase(), "quarry"), e)
    rl = component.find(behaviour.scene_root(s), rules())
    component.set_int(rl, field(rules(), "score"), 4200)
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

// Whether the scene is the played one; what differs, said.
played(s: *Scene, name: string) -> bool {
    ok = true
    a = behaviour.scene_find_id(s, 1)
    if a == null { return false }
    ha = component.find(a, health())
    ma = component.find(a, mover())
    if ha == null || ma == null { return false }
    at = behaviour.object_position(a)
    turn = behaviour.object_rotation(a)
    want = core.quat_from_euler(0.0, 0.7, 0.0)
    target = component.get_vec3(ma, field(mover(), "target"))
    if !near(component.get_float(ha, field(health(), "hp")), 100.0) { println("    ${name}: A's hp ${component.get_float(ha, field(health(), "hp"))}, not 100") ; ok = false }
    if component.get_bool(ha, field(health(), "alive")) { println("    ${name}: A alive") ; ok = false }
    if component.get_int(ha, field(health(), "team")) != 1 { println("    ${name}: A's team") ; ok = false }
    if !near(at.x, 1.0) || !near(at.y, 2.0) || !near(at.z, 3.0) { println("    ${name}: A at (${at.x}, ${at.y}, ${at.z})") ; ok = false }
    if !near(turn.y, want.y) || !near(turn.w, want.w) { println("    ${name}: A's rotation") ; ok = false }
    if !near(target.x, 0.25) || !near(target.z, 0.0 - 9.5) { println("    ${name}: A's target") ; ok = false }
    ca = component.find(a, chase())
    if ca == null || named(component.get_object(ca, field(chase(), "quarry"))) != "E" { println("    ${name}: A chases ${named(component.get_object(ca, field(chase(), "quarry")))}, not E") ; ok = false }
    if ca == null || component.get_object(ca, field(chase(), "sender")) != null { println("    ${name}: A's sender is still there") ; ok = false }
    cd = component.find(behaviour.scene_find_id(s, 4), chase())
    if cd == null || named(component.get_object(cd, field(chase(), "quarry"))) != "B" { println("    ${name}: D does not chase B") ; ok = false }
    b = behaviour.scene_find_id(s, 2)
    if b == null || component.find(b, health()) != null { println("    ${name}: B still has its health") ; ok = false }
    if behaviour.scene_find_id(s, 3) != null { println("    ${name}: C is still there") ; ok = false }
    e = behaviour.scene_find_id(s, 5)
    if e == null {
        println("    ${name}: no E")
        ok = false
    } else {
        he = component.find(e, health())
        me = component.find(e, mover())
        if he == null || !near(component.get_float(he, field(health(), "hp")), 30.0) { println("    ${name}: E's health") ; ok = false }
        if me == null || !near(component.get_float(me, field(mover(), "speed")), 7.0) { println("    ${name}: E's mover") ; ok = false }
    }
    rl = component.find(behaviour.scene_root(s), rules())
    if rl == null || component.get_int(rl, field(rules(), "score")) != 4200 { println("    ${name}: the score") ; ok = false }
    return ok
}

named(o: *GameObject) -> string {
    if o == null { return "none" }
    return o.name
}

// A fresh process's scene: authored again, and the save read over it.
reloaded(path: string, text: bool) -> *Scene {
    s = author()
    persist.set_spawner(make_object, s as ptr)
    ok = false
    if text { ok = persist.load_json(s, path) } else { ok = persist.load(s, path) }
    if !ok { println("    load: ${persist.last_error()}") }
    behaviour.scene_update(s, 0.0)
    return s
}

// The scene's Rendering (the root's, id 0) goes through a save like any
// component: only what differs from the defaults is written, so a save from
// before the depth of field (#870) loads with it off, and one with it on
// brings it back (Nic, 874-6).
rendering_saves() {
    mine = engine.engine_defaults()
    s = behaviour.scene_new()
    base = persist.baseline(s)
    root = behaviour.scene_root(s)
    rk = engine.rendering_kind()
    r = component.attach_state(root, rk, mine as ptr, false)
    component.set_bool(r, component.field_named(rk, "bloom"), true)
    check("a default Rendering saves without the depth of field",
          persist.save_json(s, base, "build/persist_saves/rendering_plain.json"))
    plain, plain_err = fs.read("build/persist_saves/rendering_plain.json")
    check("the file has no depth of field in it", plain_err == "" && string.contains(plain, "dof") == 0 &&
          string.contains(plain, "depth of field") == 0)
    string.free(plain)
    component.set_bool(r, component.field_named(rk, "depth of field"), true)
    component.set_float(r, component.field_named(rk, "dof focus distance"), 6.5)
    component.set_float(r, component.field_named(rk, "dof max blur"), 30.0)
    check("a Rendering with the depth of field set saves", persist.save_json(s, base, "build/persist_saves/rendering_dof.json"))

    // A save from before: the same file as the plain one, loaded over a scene
    // whose Rendering has the depth of field on, comes back with it off.
    yours = engine.engine_defaults()
    t = behaviour.scene_new()
    yr = component.attach_state(behaviour.scene_root(t), rk, yours as ptr, false)
    component.set_bool(yr, component.field_named(rk, "depth of field"), true)
    check("an old save loads", persist.load_json(t, "build/persist_saves/rendering_plain.json"))
    check("with the bloom it had and the depth of field at its default, off",
          yours.post_bloom && !yours.dof_on && near(yours.dof_focus, 10.0) && near(yours.dof_max_radius, 16.0))
    check("the new save brings the depth of field back", persist.load_json(t, "build/persist_saves/rendering_dof.json") &&
          yours.dof_on && near(yours.dof_focus, 6.5) && near(yours.dof_max_radius, 30.0) && near(yours.dof_aperture, 12.0))
    behaviour.scene_free(t)
    engine.engine_defaults_free(yours)
    persist.baseline_free(base)
    behaviour.scene_free(s)
    engine.engine_defaults_free(mine)
    environment_saves()
}

// The same for the scene's Environment and the map it names (#869; Nic,
// 875-7): a save from before has none of the three fields and loads with no
// map; one with a map brings back the path, the scale and the turn.
environment_saves() {
    mine = engine.engine_defaults()
    s = behaviour.scene_new()
    base = persist.baseline(s)
    ek = engine.environment_kind()
    env = component.attach_state(behaviour.scene_root(s), ek, mine as ptr, false)
    component.set_bool(env, component.field_named(ek, "fog"), true)
    check("an Environment with no map saves", persist.save_json(s, base, "build/persist_saves/environment_plain.json"))
    plain, plain_err = fs.read("build/persist_saves/environment_plain.json")
    check("the file names no map", plain_err == "" && string.contains(plain, "environment") == 0)
    string.free(plain)
    component.set_text(env, component.field_named(ek, "environment map"), "tests/fixtures/env/sides.hdr")
    component.set_float(env, component.field_named(ek, "environment intensity"), 3.0)
    component.set_float(env, component.field_named(ek, "environment yaw"), 120.0)
    check("an Environment with a map saves", persist.save_json(s, base, "build/persist_saves/environment_map.json"))

    yours = engine.engine_defaults()
    t = behaviour.scene_new()
    yenv = component.attach_state(behaviour.scene_root(t), ek, yours as ptr, false)
    component.set_text(yenv, component.field_named(ek, "environment map"), "tests/fixtures/env/sides.hdr")
    component.set_float(yenv, component.field_named(ek, "environment yaw"), 77.0)
    check("an old save loads", persist.load_json(t, "build/persist_saves/environment_plain.json"))
    check("with its fog and no map: the scene's map is put back to none, unturned",
          yours.fog.enabled && yours.env_path == "" && near(yours.env_intensity, 1.0) && near(yours.env_yaw, 0.0))
    check("the new save brings the map, its scale and its turn back", persist.load_json(t, "build/persist_saves/environment_map.json") &&
          yours.env_path == "tests/fixtures/env/sides.hdr" && near(yours.env_intensity, 3.0) && near(yours.env_yaw, 120.0))
    behaviour.scene_free(t)
    engine.engine_defaults_free(yours)
    persist.baseline_free(base)
    behaviour.scene_free(s)
    engine.engine_defaults_free(mine)
}

main() {
    println("persist: save games (#507)")
    kinds()
    fs.mkdir_p("build/persist_saves")
    rendering_saves()
    slot = "build/persist_saves/slot1.save"
    text_path = "build/persist_saves/slot1.json"

    s = author()
    base = persist.baseline(s)
    play(s)
    extra = json.obj()
    json.object_set_raw(extra, "chapter", json.from_int(2))
    check("a played scene saves to a slot", persist.save(s, base, slot, "Chapter 2", 754.5, extra))
    json.free(extra)
    check("and to text", persist.save_json(s, base, text_path))
    check("the played scene is what the checks call played", played(s, "played"))

    back = reloaded(slot, false)
    check("read over the scene loaded fresh, the slot is the scene as it was played", played(back, "slot"))
    sender = component.object_ref(component.find(behaviour.scene_find_id(back, 1), chase()), field(chase(), "sender"))
    check("a reference to the object the save destroyed is set to none and counted", sender == 0 && persist.last_dangling() == 1)
    check("the spawned object was made back by the game's spawner", g_spawned == 1)
    f = behaviour.object_new("F")
    behaviour.scene_add(back, f)
    check("and the next object spawned takes an id none had", behaviour.object_id(f) == 6)
    behaviour.scene_free(back)

    g_spawned = 0
    back = reloaded(text_path, true)
    check("the text form reads back the same", played(back, "text") && g_spawned == 1)
    behaviour.scene_free(back)

    info = persist.slot_info(slot)
    title = ""
    seconds = 0.0
    chapter = 0
    if info != null {
        title = json.get_string_raw(json.object_get_raw(info, "title"))
        seconds = json.get_number(json.object_get_raw(info, "play_seconds"))
        chapter = json.get_int(json.object_get_raw(json.object_get_raw(info, "game"), "chapter"))
    }
    println("  the slot's details: '${title}', ${seconds} s played, chapter ${chapter}")
    check("a slot gives its details without its state", title == "Chapter 2" && near(seconds, 754.5) && chapter == 2)
    if info != null { json.free(info) }

    // A byte of the state changed.
    content, length, err = fs.read_binary(slot)
    check("the slot file reads back to be changed", err == "" && length > 3)
    b = bytes.new(length + 1)
    bytes.copy_from_string(b, 0, content, length)
    raw = bytes.data(b)
    mem.set_uint8(raw, length - 3, (mem.get_byte(raw, length - 3) + 1) % 256)
    fs.write_binary("build/persist_saves/damaged.save", (raw as byte[])[0..length])
    bytes.free(b)
    damaged = author()
    persist.set_spawner(make_object, damaged as ptr)
    refused = !persist.load(damaged, "build/persist_saves/damaged.save")
    println("  a slot changed by a byte: ${persist.last_error()}")
    check("a slot changed by a byte reads as damaged, not as a game", refused && string.contains(persist.last_error(), "damaged") == 1)
    behaviour.scene_free(damaged)

    // A save from version 1 of the mover: its speed as `velocity`, in km/h,
    // and no grip.
    old = "{\"format\": 1, \"kinds\": {\"Mover\": 1}, \"next_id\": 4, \"destroyed\": [], \"objects\": [{\"id\": 3, \"name\": \"C\", \"tag\": \"\", \"active\": true, \"position\": [0,0,0], \"rotation\": [0,0,0,1], \"scale\": [1,1,1], \"components\": [{\"kind\": \"Mover\", \"enabled\": true, \"fields\": {\"velocity\": 36.0}}]}]}"
    fs.write("build/persist_saves/v1.json", old)
    migrated = author()
    loaded = persist.load_json(migrated, "build/persist_saves/v1.json")
    mc = component.find(behaviour.scene_find_id(migrated, 3), mover())
    speed = component.get_float(mc, field(mover(), "speed"))
    grip = component.get_float(mc, field(mover(), "grip"))
    println("  a version 1 save's velocity 36 km/h: speed ${speed} m/s, grip ${grip}")
    check("a save from before a rename and an added field loads the old value under the new name, through its migration, and the new field at its default",
          loaded && near(speed, 10.0) && near(grip, 0.5))
    behaviour.scene_free(migrated)

    // Off the frame: the capture taken here, the slot written by a worker.
    async_slot = "build/persist_saves/async.save"
    job = persist.save_async(s, base, async_slot, "Chapter 2", 754.5, null)
    while !persist.save_finished(job) { }
    check("a save off the frame finishes, and says it wrote the slot", persist.save_finished(job) && persist.save_job_ok(job))
    persist.save_job_free(job)
    off = reloaded(async_slot, false)
    check("and the slot it wrote is the scene as it was played", played(off, "off the frame"))
    behaviour.scene_free(off)
    bad = persist.save_async(s, base, "build/persist_saves/no such folder/slot.save", "x", 0.0, null)
    while !persist.save_finished(bad) { }
    check("one that cannot be written says why (${persist.save_job_error(bad)})",
          !persist.save_job_ok(bad) && string.contains(persist.save_job_error(bad), "cannot write") == 1)
    persist.save_job_free(bad)

    // The capture writes each component's fields as the registry writes them.
    doc = persist.state_json(s, base)
    objects = json.object_get_raw(doc, "objects")
    same_fields = true
    i = 0
    while i < json.array_size(objects) {
        node = json.array_get_raw(objects, i)
        id = json.get_int(json.object_get_raw(node, "id"))
        o = behaviour.scene_root(s)
        if id != 0 { o = behaviour.scene_find_id(s, id) }
        saved = json.object_get_raw(node, "components")
        j = 0
        while j < json.array_size(saved) {
            entry = json.array_get_raw(saved, j)
            c = component.find(o, component.kind_named(json.get_string_raw(json.object_get_raw(entry, "kind"))))
            live = component.to_json(c, true)
            captured_text = json.stringify_raw(json.object_get_raw(entry, "fields"))
            registry_text = json.stringify_raw(live)
            if string.equals(captured_text, registry_text) != 1 {
                println("    captured ${captured_text}, the registry ${registry_text}")
                same_fields = false
            }
            json.free(live)
            j = j + 1
        }
        i = i + 1
    }
    check("a captured component's fields are, to the byte, what component.to_json writes", same_fields)
    json.free(doc)

    // A capture is written by what the kinds were when it was taken: a kind
    // redefined since (a script reloaded, its fields made again) changes
    // nothing in it.
    redefined()
    pictured(s, base)
    restored()

    // A thousand saves and loads in a row: each the same, and nothing held
    // from one to the next (`leaks` holds the suite to none).
    same = true
    k = 0
    while k < 1000 && same {
        persist.save(s, base, slot, "again", 1.0, null)
        g_spawned = 0
        again = reloaded(slot, false)
        if !played(again, "again ${k}") { same = false }
        behaviour.scene_free(again)
        k = k + 1
    }
    check("a thousand saves and loads in a row each come back the same", same && k == 1000)

    persist.baseline_free(base)
    behaviour.scene_free(s)
    persist.migrations_clear()
    component.kinds_clear()
    if g_failures == 0 {
        println("persist: all checks passed (${g_checks})")
    } else {
        println("persist: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}

// A gauge, for the capture taken before its kind is redefined.
struct Gauge { level: float }

gauge_new() -> ptr {
    g = heap.new(Gauge)
    g.level = 1.0
    return g as ptr
}

gauge_free(p: ptr) { heap.free(p as *Gauge) }

redefined() {
    k = component.kind("Gauge", "Tests", gauge_new, gauge_free)
    component.float_field(k, "level", offsetof(Gauge, level), 0.0, 0.0)
    s = behaviour.scene_new()
    o = behaviour.object_new("Dial")
    behaviour.scene_add(s, o)
    c = component.add(o, k)
    (c.state as *Gauge).level = 0.25
    b = persist.baseline(s)
    cap = persist.capture(s, b, false)
    component.kind_redefine(k, gauge_new, gauge_free)
    doc = persist.capture_doc(cap)
    node = json.array_get_raw(json.object_get_raw(doc, "objects"), 1)
    entry = json.array_get_raw(json.object_get_raw(node, "components"), 0)
    level = json.object_get_raw(json.object_get_raw(entry, "fields"), "level")
    check("a capture taken before its kind was redefined writes the fields it had then",
          level != null && near(json.get_number(level), 0.25) && component.field_count(k) == 0)
    json.free(doc)
    component.capture_free(cap)
    persist.baseline_free(b)
    behaviour.scene_free(s)
}

// A picture: 64 by 36, every pixel its own colour, as a view's pixels are.
gradient(width: int, height: int) -> ptr {
    rgba = calloc(width * height, 4)
    y = 0
    while y < height {
        x = 0
        while x < width {
            at = (y * width + x) * 4
            mem.set_uint8(rgba, at, (x * 4) % 256)
            mem.set_uint8(rgba, at + 1, (y * 7) % 256)
            mem.set_uint8(rgba, at + 2, (x + y) % 256)
            mem.set_uint8(rgba, at + 3, 255)
            x = x + 1
        }
        y = y + 1
    }
    return rgba
}

// Whether a decoded picture (ae3d.picture: bottom row first) is the RGBA it was
// made from (top row first, as a view's pixels and a PNG are).
same_pixels(decoded: ptr, rgba: ptr, width: int, height: int) -> bool {
    row = width * 4
    y = 0
    while y < height {
        x = 0
        while x < row {
            if mem.get_byte(decoded, (height - 1 - y) * row + x) != mem.get_byte(rgba, y * row + x) { return false }
            x = x + 1
        }
        y = y + 1
    }
    return true
}

// A slot's picture: kept beside the state, read without it, decoded as the
// pixels given; a slot without one says so; and a slot of format 1, written
// before slots had pictures, still loads.
pictured(s: *Scene, base: *Baseline) {
    rgba = gradient(64, 36)
    path = "build/persist_saves/pictured.save"
    check("a save keeps its picture", persist.save(s, base, path, "with a picture", 1.0, null, rgba, 64, 36))
    png_bytes, length = persist.slot_picture(path)
    decoded = picture.from_memory(png_bytes, length)
    check("the picture reads back, without the state, as the pixels given (${length} bytes of PNG)",
          decoded != null && picture.width(decoded) == 64 && picture.height(decoded) == 36 &&
          same_pixels(picture.pixels(decoded), rgba, 64, 36))
    picture.dispose(decoded)
    free(png_bytes)
    info = persist.slot_info(path)
    check("its details read as before", info != null && json.get_string_raw(json.object_get_raw(info, "title")) == "with a picture")
    json.free(info)
    back = reloaded(path, false)
    check("and the game loads from it", played(back, "pictured"))
    behaviour.scene_free(back)

    // Off the frame: the picture copied as it is asked for, the frame's
    // buffer free to be drawn over at once.
    job = persist.save_async(s, base, "build/persist_saves/pictured_async.save", "async", 1.0, null, rgba, 64, 36)
    mem.set_uint8(rgba, 0, 7)
    while !persist.save_finished(job) { }
    persist.save_job_free(job)
    async_bytes, async_length = persist.slot_picture("build/persist_saves/pictured_async.save")
    seen = picture.from_memory(async_bytes, async_length)
    check("a save off the frame keeps the picture as it was when it was asked for",
          seen != null && mem.get_byte(picture.pixels(seen), (36 - 1) * 64 * 4) == 0)
    picture.dispose(seen)
    free(async_bytes)

    plain = "build/persist_saves/plain.save"
    persist.save(s, base, plain, "no picture", 1.0, null)
    absent, absent_length = persist.slot_picture(plain)
    check("a slot saved without a picture has none", absent == null && absent_length == 0)

    // Format 1: the same slot with its header four bytes shorter and no
    // picture, as slots were written before pictures.
    content, total, err = fs.read_binary(plain)
    old = bytes.new(total)
    bytes.copy_from_string(old, 0, content, total)
    raw = bytes.data(old)
    mem.set_uint32(raw, 4, 1 as long)
    bytes.copy_within(old, 24, 28, total - 28)
    raw = bytes.data(old)
    fs.write_binary("build/persist_saves/format1.save", (raw as byte[])[0..(total - 4)])
    bytes.free(old)
    back = reloaded("build/persist_saves/format1.save", false)
    check("a slot of format 1, from before pictures, still loads", err == "" && played(back, "format 1"))
    behaviour.scene_free(back)
    free(rgba)
}

// A checkpoint put back in-process (persist.restore), each case as the
// agent's roll back meets it: an object made since goes, one gone outright
// comes back only by the spawner, and one still waiting to be destroyed at
// the next update is kept.
restored() {
    s = author()
    persist.set_spawner(make_object, s as ptr)
    doc = persist.checkpoint(s)
    made = behaviour.object_new("Made since")
    behaviour.scene_add(s, made)
    waiting = behaviour.scene_find_id(s, 2)
    behaviour.scene_destroy_later(s, waiting)
    gone = behaviour.scene_find_id(s, 3)
    behaviour.scene_remove(s, gone)
    ok = persist.restore(s, doc)
    behaviour.scene_update(s, 0.0)
    check("a restore with a spawner puts every object back (${persist.last_missing()} missing)", ok && persist.last_missing() == 0)
    check("one made since goes", behaviour.scene_find(s, "Made since") == null)
    check("one waiting to be destroyed is kept", behaviour.scene_find_id(s, 2) != null)
    check("one gone outright is made back, with its id", behaviour.scene_find_id(s, 3) != null)
    persist.set_spawner(null, null)
    behaviour.scene_remove(s, behaviour.scene_find_id(s, 3))
    check("without a spawner it is counted, not made back", !persist.restore(s, doc) && persist.last_missing() == 1)
    json.free(doc)
    behaviour.scene_free(s)
}
