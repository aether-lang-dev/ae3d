// Save games (#507), held to what comes back:
//
//   - a scene played -- a field changed, a field set back to its default
//     over an authored value, a component taken off, an object moved, one
//     destroyed, one spawned, the scene's own rules changed -- saved to a
//     slot and read over the same scene loaded fresh, is the scene as it was
//     played: every field, transform and object, the destroyed one gone and
//     the spawned one back with its id, and the next object spawned taking
//     an id none had;
//   - references between objects come back naming the same objects: an
//     authored one, the spawned one, and one to the destroyed object set to
//     none and counted;
//   - the same through the text form;
//   - a slot gives its details without its state;
//   - a slot changed by a byte reads as damaged, not as a game;
//   - a save from before a field was renamed and another added loads the
//     old value under the new name, the new field at its default, through
//     the migration registered for the step;
//   - two hundred saves and loads in a row each come back the same.
import std.heap
import std.json
import std.fs
import std.mem
import std.bytes
import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.persist
extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Health {
    hp: float
    alive: bool
    team: int
}

health_new() -> ptr {
    h = heap.new(Health)
    h.hp = 100.0
    h.alive = true
    return h as ptr
}
health_free(p: ptr) { heap.free(p as *Health) }

// A mover at schema version 2: `speed` was `velocity` before it, and `grip`
// is new in it.
struct Mover {
    speed: float
    target: Vec3
    grip: float
}

mover_new() -> ptr {
    m = heap.new(Mover)
    m.speed = 1.0
    m.grip = 0.5
    return m as ptr
}
mover_free(p: ptr) { heap.free(p as *Mover) }

struct Rules {
    score: int
}

rules_new() -> ptr { return heap.new(Rules) as ptr }
rules_free(p: ptr) { heap.free(p as *Rules) }

// Who it chases and who sent it: other objects, by id.
struct Chase {
    quarry: int
    sender: int
}

chase_new() -> ptr { return heap.new(Chase) as ptr }
chase_free(p: ptr) { heap.free(p as *Chase) }

var g_health: ptr = null             // *ComponentKind
var g_mover: ptr = null
var g_rules: ptr = null
var g_chase: ptr = null

// Saves from version 1 had the speed in km/h.
from_kmh(fields: ptr) {
    v = json.object_get_raw(fields, "speed")
    if v != null { json.object_set_raw(fields, "speed", json.num(json.get_number(v) / 3.6)) }
}

kinds() {
    h = component.kind("Health", "Game", health_new, health_free)
    component.float_field(h, "hp", offsetof(Health, hp), 0.0, 1000.0)
    component.bool_field(h, "alive", offsetof(Health, alive))
    team = component.enum_field(h, "team", offsetof(Health, team))
    component.enum_choice_add(team, "red")
    component.enum_choice_add(team, "blue")
    g_health = h as ptr
    m = component.kind("Mover", "Game", mover_new, mover_free)
    component.float_field(m, "speed", offsetof(Mover, speed), 0.0, 100.0)
    component.vec3_field(m, "target", offsetof(Mover, target))
    component.float_field(m, "grip", offsetof(Mover, grip), 0.0, 1.0)
    component.set_schema_version(m, 2)
    component.rename_field(m, "velocity", "speed", 2)
    persist.migration("Mover", 2, from_kmh)
    g_mover = m as ptr
    r = component.kind("Rules", "Game", rules_new, rules_free)
    component.int_field(r, "score", offsetof(Rules, score), 0, 1000000)
    component.set_scene(r, true)
    g_rules = r as ptr
    ch = component.kind("Chase", "Game", chase_new, chase_free)
    component.object_field(ch, "quarry", offsetof(Chase, quarry))
    component.object_field(ch, "sender", offsetof(Chase, sender))
    g_chase = ch as ptr
}

health() -> *ComponentKind { return g_health as *ComponentKind }
mover() -> *ComponentKind { return g_mover as *ComponentKind }
rules() -> *ComponentKind { return g_rules as *ComponentKind }
chase() -> *ComponentKind { return g_chase as *ComponentKind }

field(k: *ComponentKind, name: string) -> *ComponentField { return component.field_named(k, name) }

// The scene as authored: four objects, ids 1 to 4; the first's health
// authored at 80, and D chasing B.
author() -> *Scene {
    s = behaviour.scene_new()
    a = behaviour.object_new("A")
    b = behaviour.object_new("B")
    c = behaviour.object_new("C")
    d = behaviour.object_new("D")
    behaviour.scene_add(s, a)
    behaviour.scene_add(s, b)
    behaviour.scene_add(s, c)
    behaviour.scene_add(s, d)
    ha = component.add(a, health())
    component.set_float(ha, field(health(), "hp"), 80.0)
    component.add(a, mover())
    component.add(b, health())
    component.add(c, mover())
    component.set_object(component.add(d, chase()), field(chase(), "quarry"), b)
    component.add(behaviour.scene_root(s), rules())
    return s
}

var g_spawned = 0

make_object(context: ptr, name: string, model: string) -> *GameObject {
    s = context as *Scene
    o = behaviour.object_new(name)
    behaviour.scene_add(s, o)
    g_spawned = g_spawned + 1
    return o
}

// The scene played: A's health back to its default and dead, on the blue
// team, moved and turned, sent by C after E; B's health taken off; C
// destroyed; E spawned with its own health and mover; the score up.
play(s: *Scene) {
    a = behaviour.scene_find_id(s, 1)
    ha = component.find(a, health())
    component.set_float(ha, field(health(), "hp"), 100.0)
    component.set_bool(ha, field(health(), "alive"), false)
    component.set_int(ha, field(health(), "team"), 1)
    behaviour.object_set_position(a, core.vec3(1.0, 2.0, 3.0))
    behaviour.object_set_rotation(a, core.quat_from_euler(0.0, 0.7, 0.0))
    ma = component.find(a, mover())
    component.set_vec3(ma, field(mover(), "target"), core.vec3(0.25, 0.0, 0.0 - 9.5))
    b = behaviour.scene_find_id(s, 2)
    component.remove(b, component.find(b, health()))
    c = behaviour.scene_find_id(s, 3)
    chase_a = component.add(a, chase())
    component.set_object(chase_a, field(chase(), "sender"), c)
    behaviour.scene_destroy_later(s, c)
    behaviour.scene_update(s, 0.0)
    e = behaviour.object_new("E")
    behaviour.scene_add(s, e)
    he = component.add(e, health())
    component.set_float(he, field(health(), "hp"), 30.0)
    me = component.add(e, mover())
    component.set_float(me, field(mover(), "speed"), 7.0)
    component.set_object(chase_a, field(chase(), "quarry"), e)
    rl = component.find(behaviour.scene_root(s), rules())
    component.set_int(rl, field(rules(), "score"), 4200)
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

// Whether the scene is the played one; what differs, said.
played(s: *Scene, name: string) -> bool {
    ok = true
    a = behaviour.scene_find_id(s, 1)
    if a == null { return false }
    ha = component.find(a, health())
    ma = component.find(a, mover())
    if ha == null || ma == null { return false }
    at = behaviour.object_position(a)
    turn = behaviour.object_rotation(a)
    want = core.quat_from_euler(0.0, 0.7, 0.0)
    target = component.get_vec3(ma, field(mover(), "target"))
    if !near(component.get_float(ha, field(health(), "hp")), 100.0) { println("    ${name}: A's hp ${component.get_float(ha, field(health(), "hp"))}, not 100") ; ok = false }
    if component.get_bool(ha, field(health(), "alive")) { println("    ${name}: A alive") ; ok = false }
    if component.get_int(ha, field(health(), "team")) != 1 { println("    ${name}: A's team") ; ok = false }
    if !near(at.x, 1.0) || !near(at.y, 2.0) || !near(at.z, 3.0) { println("    ${name}: A at (${at.x}, ${at.y}, ${at.z})") ; ok = false }
    if !near(turn.y, want.y) || !near(turn.w, want.w) { println("    ${name}: A's rotation") ; ok = false }
    if !near(target.x, 0.25) || !near(target.z, 0.0 - 9.5) { println("    ${name}: A's target") ; ok = false }
    ca = component.find(a, chase())
    if ca == null || named(component.get_object(ca, field(chase(), "quarry"))) != "E" { println("    ${name}: A chases ${named(component.get_object(ca, field(chase(), "quarry")))}, not E") ; ok = false }
    if ca == null || component.get_object(ca, field(chase(), "sender")) != null { println("    ${name}: A's sender is still there") ; ok = false }
    cd = component.find(behaviour.scene_find_id(s, 4), chase())
    if cd == null || named(component.get_object(cd, field(chase(), "quarry"))) != "B" { println("    ${name}: D does not chase B") ; ok = false }
    b = behaviour.scene_find_id(s, 2)
    if b == null || component.find(b, health()) != null { println("    ${name}: B still has its health") ; ok = false }
    if behaviour.scene_find_id(s, 3) != null { println("    ${name}: C is still there") ; ok = false }
    e = behaviour.scene_find_id(s, 5)
    if e == null {
        println("    ${name}: no E")
        ok = false
    } else {
        he = component.find(e, health())
        me = component.find(e, mover())
        if he == null || !near(component.get_float(he, field(health(), "hp")), 30.0) { println("    ${name}: E's health") ; ok = false }
        if me == null || !near(component.get_float(me, field(mover(), "speed")), 7.0) { println("    ${name}: E's mover") ; ok = false }
    }
    rl = component.find(behaviour.scene_root(s), rules())
    if rl == null || component.get_int(rl, field(rules(), "score")) != 4200 { println("    ${name}: the score") ; ok = false }
    return ok
}

named(o: *GameObject) -> string {
    if o == null { return "none" }
    return o.name
}

// A fresh process's scene: authored again, and the save read over it.
reloaded(path: string, text: bool) -> *Scene {
    s = author()
    persist.set_spawner(make_object, s as ptr)
    ok = false
    if text { ok = persist.load_json(s, path) } else { ok = persist.load(s, path) }
    if !ok { println("    load: ${persist.last_error()}") }
    behaviour.scene_update(s, 0.0)
    return s
}

main() {
    println("persist: save games (#507)")
    kinds()
    fs.mkdir_p("build/persist_saves")
    slot = "build/persist_saves/slot1.save"
    text_path = "build/persist_saves/slot1.json"

    s = author()
    base = persist.baseline(s)
    play(s)
    extra = json.obj()
    json.object_set_raw(extra, "chapter", json.from_int(2))
    check("a played scene saves to a slot", persist.save(s, base, slot, "Chapter 2", 754.5, extra))
    json.free(extra)
    check("and to text", persist.save_json(s, base, text_path))
    check("the played scene is what the checks call played", played(s, "played"))

    back = reloaded(slot, false)
    check("read over the scene loaded fresh, the slot is the scene as it was played", played(back, "slot"))
    sender = component.object_ref(component.find(behaviour.scene_find_id(back, 1), chase()), field(chase(), "sender"))
    check("a reference to the object the save destroyed is set to none and counted", sender == 0 && persist.last_dangling() == 1)
    check("the spawned object was made back by the game's spawner", g_spawned == 1)
    f = behaviour.object_new("F")
    behaviour.scene_add(back, f)
    check("and the next object spawned takes an id none had", behaviour.object_id(f) == 6)
    behaviour.scene_free(back)

    g_spawned = 0
    back = reloaded(text_path, true)
    check("the text form reads back the same", played(back, "text") && g_spawned == 1)
    behaviour.scene_free(back)

    info = persist.slot_info(slot)
    title = ""
    seconds = 0.0
    chapter = 0
    if info != null {
        title = json.get_string_raw(json.object_get_raw(info, "title"))
        seconds = json.get_number(json.object_get_raw(info, "play_seconds"))
        chapter = json.get_int(json.object_get_raw(json.object_get_raw(info, "game"), "chapter"))
    }
    println("  the slot's details: '${title}', ${seconds} s played, chapter ${chapter}")
    check("a slot gives its details without its state", title == "Chapter 2" && near(seconds, 754.5) && chapter == 2)
    if info != null { json.free(info) }

    // A byte of the state changed.
    content, length, err = fs.read_binary(slot)
    check("the slot file reads back to be changed", err == "" && length > 3)
    b = bytes.new(length + 1)
    bytes.copy_from_string(b, 0, content, length)
    raw = bytes.data(b)
    mem.set_uint8(raw, length - 3, (mem.get_byte(raw, length - 3) + 1) % 256)
    fs.write_binary("build/persist_saves/damaged.save", (raw as byte[])[0..length])
    bytes.free(b)
    damaged = author()
    persist.set_spawner(make_object, damaged as ptr)
    refused = !persist.load(damaged, "build/persist_saves/damaged.save")
    println("  a slot changed by a byte: ${persist.last_error()}")
    check("a slot changed by a byte reads as damaged, not as a game", refused && string.contains(persist.last_error(), "damaged") == 1)
    behaviour.scene_free(damaged)

    // A save from version 1 of the mover: its speed as `velocity`, in km/h,
    // and no grip.
    old = "{\"format\": 1, \"kinds\": {\"Mover\": 1}, \"next_id\": 4, \"destroyed\": [], \"objects\": [{\"id\": 3, \"name\": \"C\", \"tag\": \"\", \"active\": true, \"position\": [0,0,0], \"rotation\": [0,0,0,1], \"scale\": [1,1,1], \"components\": [{\"kind\": \"Mover\", \"enabled\": true, \"fields\": {\"velocity\": 36.0}}]}]}"
    fs.write("build/persist_saves/v1.json", old)
    migrated = author()
    loaded = persist.load_json(migrated, "build/persist_saves/v1.json")
    mc = component.find(behaviour.scene_find_id(migrated, 3), mover())
    speed = component.get_float(mc, field(mover(), "speed"))
    grip = component.get_float(mc, field(mover(), "grip"))
    println("  a version 1 save's velocity 36 km/h: speed ${speed} m/s, grip ${grip}")
    check("a save from before a rename and an added field loads the old value under the new name, through its migration, and the new field at its default",
          loaded && near(speed, 10.0) && near(grip, 0.5))
    behaviour.scene_free(migrated)

    // Two hundred saves and loads in a row.
    same = true
    k = 0
    while k < 200 && same {
        persist.save(s, base, slot, "again", 1.0, null)
        g_spawned = 0
        again = reloaded(slot, false)
        if !played(again, "again ${k}") { same = false }
        behaviour.scene_free(again)
        k = k + 1
    }
    check("two hundred saves and loads in a row each come back the same", same)

    persist.baseline_free(base)
    behaviour.scene_free(s)
    persist.migrations_clear()
    component.kinds_clear()
    if g_failures == 0 {
        println("persist: all checks passed (${g_checks})")
    } else {
        println("persist: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
