// A shove, not a blow (#606), held to numbers. The box man (the fixture
// the motion showcase dresses), POWERED, pushed from behind at the chest
// 1.0 m/s over the whole body: once with `motion.shove`, the impulse spread
// over SHOVE_SECONDS as a hand or a shoulder pushes, once with `motion.hit`,
// the same impulse in an instant, as a blow lands. Each in an engine of
// its own; no window.
//
//   - shoved, the body takes at least 70% of the speed struck gives it
//     (its centre of mass from 0.18 to 0.23 s on, the shove done): the
//     feet, planted, hold some of a push back while it lasts, as a
//     person's do, where a blow lands before they can;
//   - shoved, the trunk folds at most half as far as struck: a blow to the
//     chest gives the chest several times the body's speed, and the hips
//     fold under it;
//   - shoved, it costs no muscle (a blow does), and the figure stands.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const SPEED = 1.0                     // m/s over the whole body

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Outcome {
    speed: float                     // the centre of mass's level speed 0.18 to 0.23 s on
    fold: float                      // the most the spine's joints are off their pose, radians
    weakest: float                   // the most muscle any bone lost
    stood: bool
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

trial(shoved: bool) -> Outcome {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", "tests/fixtures/gltf/humanoid.glb")
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    out = Outcome { speed: 0.0, fold: 0.0, weakest: 0.0, stood: false }
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    impulse = core.v3_mul(facing(m), SPEED * physics.ragdoll_mass(r))
    if shoved {
        motion.shove(m, human.BONE_SPINE_03, impulse)
    } else {
        motion.hit(m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), impulse)
    }
    i = 0
    while i < human.BONE_COUNT {
        w = motion.bone_weakness(m, i)
        if w > out.weakest { out.weakest = w }
        i = i + 1
    }
    before = physics.ragdoll_center_of_mass(r)
    k = 0
    while k < 180 {
        engine.engine_update(e, STEP)
        fold = physics.ragdoll_joint_error(r, human.BONE_SPINE_01) + physics.ragdoll_joint_error(r, human.BONE_SPINE_03)
        if k < 30 && fold > out.fold { out.fold = fold }
        if k == 10 { before = physics.ragdoll_center_of_mass(r) }
        if k == 13 {
            now = physics.ragdoll_center_of_mass(r)
            moved = core.vec3(now.x - before.x, 0.0, now.z - before.z)
            out.speed = core.v3_len(moved) / (3.0 * STEP)
        }
        k = k + 1
    }
    out.stood = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y >= 0.8
    engine.engine_free(e)
    motion.motion_free(m)
    return out
}

main() {
    println("shove: the box man pushed from behind at the chest, ${SPEED} m/s, shoved and struck")
    shoved = trial(true)
    struck = trial(false)
    println("  shoved: the body at ${shoved.speed} m/s 0.2 s on, the spine folded ${shoved.fold} rad at most, ${shoved.weakest} of a bone's muscle lost, stood ${shoved.stood}")
    println("  struck: the body at ${struck.speed} m/s 0.2 s on, the spine folded ${struck.fold} rad at most, ${struck.weakest} of a bone's muscle lost, stood ${struck.stood}")
    check("shoved, the body takes at least 70% of the speed struck gives it, and no more", shoved.speed >= struck.speed * 0.7 && shoved.speed <= struck.speed * 1.05)
    check("shoved, the trunk folds at most half as far as struck", shoved.fold <= struck.fold * 0.5)
    check("shoved, it costs no muscle and the figure stands", shoved.weakest == 0.0 && shoved.stood)
    if g_failures == 0 {
        println("shove: all checks passed (${g_checks})")
        return
    }
    println("shove: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
