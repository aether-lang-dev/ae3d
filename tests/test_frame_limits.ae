// A frame that draws more than its first allotment is drawn whole (#725).
// On Vulkan a frame's draws past its ring's 4096 blocks, past the 256
// descriptor sets a frame slot held, and textures past the 256 its table
// held, were dropped without a word: the models made last went unseen, or
// drew with the default texture. In a game those are the people made last,
// Siltreach's arena fighters among them.
//
// One frame, merging off (so each cube is a draw of its own, as a model
// that cannot merge is: skinned, masked, grouped):
//
//   - CUBES small grey cubes round the view, past the ring's 4096 blocks
//     (an unskinned draw takes a third of one, #726: 12,288 to 12,487 of
//     them fill it, by the device's alignment);
//   - TEXTURED more, each with a texture of its own, past the 256 textures
//     and the 256 sets;
//   - then, made last, a red cube with no texture, and a white cube with a
//     blue texture of its own, side by side in the middle of the view.
//
// Both are drawn: the middle of each, read off the frame, is red and blue.
// Before, the red cube was not drawn at all and the blue one drew white.
// SKIP where there is no window.
import std.os
import ae3d.core
import ae3d.engine
import ae3d.loader
import ae3d.picture

extern exit(code: int)

const CUBES = 12800
const TEXTURED = 300
const STEPS = 30
const SHOT = "build/test_frame_limits.png"
const PATCH = 12                     // pixels either way of each marker's middle

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct Stage {
    steps: int
    draws: int
}

fixed_update(state: ptr, e: *Engine, step: float) {
    t = state as *Stage
    t.steps = t.steps + 1
    if t.steps == 1 {
        side = 1
        while side * side < CUBES + TEXTURED { side = side + 1 }
        i = 0
        while i < CUBES + TEXTURED {
            m = loader.cube(1.0)
            core.model_set_scale(m, 0.3, 0.3, 0.3)
            core.model_matte(m, 0.6, 0.6, 0.6)
            if i >= CUBES {
                // A texture of its own, a colour no other has.
                k = i - CUBES
                px = picture.pixels(picture.solid(4, 4, 40 + (k % 200), 40 + (k / 200) * 40, 90, 255))
                picture.register_rgba("frame limits ${k}", px, 4, 4)
                core.model_set_texture(m, "frame limits ${k}")
            }
            // A grid on the ground round the view, its middle left clear.
            x = ((i % side) as float - (side as float) * 0.5) * 0.8
            z = ((i / side) as float - (side as float) * 0.5) * 0.8 + 6.0
            if x > 0.0 - 1.8 && x < 1.8 && z < 3.0 { x = x + 3.6 }
            core.model_set_position(m, x, 0.0 - 1.0, z)
            engine.object(e, "cube ${i}", m)
            i = i + 1
        }
        red = loader.cube(1.0)
        core.model_matte(red, 0.9, 0.05, 0.05)
        core.model_set_scale(red, 0.6, 0.6, 0.6)
        core.model_set_position(red, 0.0 - 0.5, 0.0, 0.0)
        engine.object(e, "red cube", red)
        blue = loader.cube(1.0)
        core.model_matte(blue, 1.0, 1.0, 1.0)
        core.model_set_scale(blue, 0.6, 0.6, 0.6)
        core.model_set_position(blue, 0.5, 0.0, 0.0)
        tint = picture.pixels(picture.solid(4, 4, 20, 40, 230, 255))
        picture.register_rgba("frame limits blue", tint, 4, 4)
        core.model_set_texture(blue, "frame limits blue")
        engine.object(e, "blue cube", blue)
        cam = engine.engine_camera(e)
        core.camera_set_position(cam, core.vec3(0.0, 0.6, 0.0 - 3.0))
        core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    }
    if t.steps == STEPS { t.draws = engine.engine_draw_calls(e) }
}

// How many of the patch's pixels round (x, y), as a share of the frame's
// width and height, are mostly `which`: 0 red, 2 blue.
patch(img: ptr, fx: float, fy: float, which: int) -> int {
    w = picture.width(img)
    h = picture.height(img)
    px = picture.pixels(img) as byte[]
    cx = (fx * (w as float)) as int
    cy = (fy * (h as float)) as int
    count = 0
    y = cy - PATCH
    while y < cy + PATCH {
        x = cx - PATCH
        while x < cx + PATCH {
            at = (y * w + x) * 4
            c = (px[at + which] as int) & 255
            o1 = (px[at + (which + 1) % 3] as int) & 255
            o2 = (px[at + (which + 2) % 3] as int) & 255
            if c > 60 && c * 2 > o1 * 3 && c * 2 > o2 * 3 { count = count + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return count
}

main() {
    println("frame limits: a frame past its first ring, sets and textures is drawn whole (#725)")
    os.setenv("AE3D_SNAPSHOT", SHOT)
    // A frame a step: the draws read at step STEPS are a whole frame's.
    os.setenv("AE3D_TICK", "60")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_title(e, "ae3d frame limits test")
    engine.engine_set_camera_input(e, false)
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_frame_limit(e, STEPS)
    light = core.light_sun(core.vec3(0.3, 0.8, 0.0 - 0.5))
    engine.engine_set_light(e, light)
    core.set_draw_merging(false)
    t = Stage { steps: 0, draws: 0 }
    b = engine.behaviour_new("stage", (&t) as ptr)
    b.fixed_update = fixed_update
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("frame limits: SKIP no window available")
        engine.engine_free(e)
        core.light_free(light)
        return
    }
    engine.engine_free(e)
    core.light_free(light)
    img = picture.load(SHOT)
    if img == null {
        println("frame limits: FAIL no frame written to ${SHOT}")
        exit(1)
    }
    full = (2 * PATCH) * (2 * PATCH)
    red = patch(img, 0.66, 0.5, 0)
    blue = patch(img, 0.34, 0.5, 2)
    picture.dispose(img)
    println("  ${t.draws} draws in the last frame; the red cube ${red} of ${full} pixels, the blue one ${blue}")
    check("every cube is drawn: ${CUBES + TEXTURED + 2} or more draws in the frame", t.draws >= CUBES + TEXTURED + 2)
    check("the red cube, made last, past the ring's first 4096 blocks, is drawn", red > full * 3 / 4)
    check("the blue cube, its texture past the first 256 textures and sets, draws with it", blue > full * 3 / 4)
    if g_failures == 0 {
        println("frame limits: all checks passed (${g_checks})")
    } else {
        println("frame limits: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
