// What AE3D_PERF's transparent_cover line counts (engine.transparent_share):
// the screen a blended model's bounds cover from the camera, since the
// transparent pass lights every covered pixel once a layer and its cost
// goes with that area, not with draws. Headless.

import ae3d.core
import ae3d.engine
import ae3d.loader

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

main() {
    println("transparent_cover: the screen a blended model covers")
    cam = core.camera_new(1280, 720)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 10.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    veil = loader.quad(400.0, 400.0)
    core.model_rotate(veil, 90.0, 0.0, 0.0)
    core.model_set_alpha(veil, 0.4)
    core.model_recalculate_bounds(veil)
    near = engine.transparent_share(cam, veil, 1280, 720)
    check("a blended sheet filling the view is one screen (${near})", near > 0.999 && near <= 1.0)

    puff = loader.cube(1.0)
    core.model_set_position(puff, 0.0, 0.0, 0.0 - 190.0)
    core.model_set_alpha(puff, 0.4)
    core.model_recalculate_bounds(puff)
    far = engine.transparent_share(cam, puff, 1280, 720)
    check("a small one far off is a sliver of it (${far})", far > 0.0 && far < 0.001)

    core.model_set_alpha(puff, 1.0)
    check("an opaque one is none of the transparent pass's", engine.transparent_share(cam, puff, 1280, 720) == 0.0)
    core.model_set_alpha(puff, 0.4)
    core.model_set_position(puff, 0.0, 0.0, 40.0)
    core.model_recalculate_bounds(puff)
    check("nor one behind the camera", engine.transparent_share(cam, puff, 1280, 720) == 0.0)

    // Off the view, and an emitter with nothing to draw: none.
    core.model_set_position(puff, 300.0, 0.0, 0.0 - 10.0)
    core.model_recalculate_bounds(puff)
    check("nor one off the view", engine.transparent_share(cam, puff, 1280, 720) == 0.0)
    sparks = loader.quad(1.0, 1.0)
    core.model_set_alpha(sparks, 0.5)
    core.model_enable_instancing(sparks, 8)
    core.model_set_instance_draw_count(sparks, 0)
    core.model_recalculate_bounds(sparks)
    check("nor an instanced one drawing none", engine.transparent_share(cam, sparks, 1280, 720) == 0.0)
    core.model_free(sparks)
    core.model_free(veil)
    core.model_free(puff)
    core.camera_free(cam)
    if g_failures == 0 {
        println("transparent_cover: all checks passed (${g_checks})")
    } else {
        println("transparent_cover: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
