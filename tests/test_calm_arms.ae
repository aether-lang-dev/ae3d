// A POWERED figure's arms drawn to their clip while it stands calm (#600),
// held to numbers: the pipeline-proportioned rig, standing two seconds,
// shoved from behind at 270 N s (a stagger it stands out of), and left
// four seconds more. No window: the engine is stepped by hand.
//
//   - standing calm, every arm bone is drawn within half a degree of its
//     clip, while its body stays where the flanks hold it, ten degrees and
//     more from it -- the drawing, not the physics, is what changed;
//   - shoved, the drawing gives way to the bodies within CALM_OUT and a
//     little: drawn as the bodies are, the stagger shows;
//   - standing calm again, the arms are drawn on their clip again within
//     three seconds of the shove;
//   - no arm bone is drawn turning more than 6 degrees in a frame, coming
//     in or giving way.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const STEP = 0.016666666666666666
const SHOVE = 120

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

quat_angle(a: Quat, b: Quat) -> float {
    d = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    if d < 0.0 { d = 0.0 - d }
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d) * 57.2958
}

// The most any arm bone is drawn from its clip, degrees.
drawn_off(m: *Motion) -> float {
    most = 0.0
    k = human.BONE_UPPER_ARM_L
    while k <= human.BONE_LOWER_ARM_R {
        d = quat_angle(physics.ragdoll_rig_bone(m.ragdoll, k).rotation, physics.ragdoll_clip_local(m.ragdoll, k))
        if d > most { most = d }
        k = k + 1
    }
    return most
}

// The most any arm bone was drawn turning since `last` (float[16], its
// rotations under their parents last frame), degrees; this frame's kept.
arm_turn(m: *Motion, last: float[]) -> float {
    most = 0.0
    k = 0
    while k < 4 {
        now = physics.ragdoll_rig_bone(m.ragdoll, human.BONE_UPPER_ARM_L + k).rotation
        if last[k * 4 + 3] != 0.0 {
            d = quat_angle(now, core.quat(last[k * 4], last[k * 4 + 1], last[k * 4 + 2], last[k * 4 + 3]))
            if d > most { most = d }
        }
        last[k * 4] = now.x
        last[k * 4 + 1] = now.y
        last[k * 4 + 2] = now.z
        last[k * 4 + 3] = now.w
        k = k + 1
    }
    return most
}

main() {
    println("calm arms: a POWERED figure's arms drawn to their clip while it stands calm (#600)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Rig", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig()
    physics.ragdoll_dress(r, rig)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    last_block = calloc(16, 8)
    last = last_block as float[]
    calm_drawn = 0.0
    calm_body = 0.0
    gave_way = 0 - 1
    back_on = 0 - 1
    worst_turn = 0.0
    k = 0
    while k < 360 {
        if k == SHOVE {
            chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
            motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - 270.0))
        }
        engine.engine_update(e, STEP)
        turn = arm_turn(m, last)
        if k > 1 && turn > worst_turn { worst_turn = turn }
        if k == SHOVE - 1 {
            calm_drawn = drawn_off(m)
            calm_body = motion.tracking_error(m, human.BONE_UPPER_ARM_L) * 57.2958
        }
        if k >= SHOVE && gave_way < 0 && motion.calm(m) <= 0.0 { gave_way = k - SHOVE }
        if gave_way >= 0 && back_on < 0 && drawn_off(m) < 0.5 { back_on = k - SHOVE }
        k = k + 1
    }
    println("  standing calm: the arms drawn ${calm_drawn} deg from their clip, their bodies ${calm_body} deg; shoved, the drawing gave way in ${gave_way} steps and was back on the clip ${back_on} steps after the shove; the most an arm bone was drawn turning in a frame ${worst_turn} deg")
    check("standing calm, the arms are drawn on their clip, their bodies where the flanks hold them", calm_drawn < 0.5 && calm_body > 10.0)
    check("shoved, the drawing gives way to the bodies within CALM_OUT and a little", gave_way >= 0 && gave_way <= 15)
    check("standing calm again, the arms are drawn on their clip within three seconds of the shove", back_on >= 0 && back_on <= 180)
    check("no arm bone is drawn turning more than 6 degrees in a frame", worst_turn < 6.0)
    free(last_block)
    engine.engine_free(e)
    motion.motion_free(m)
    rig_free(rig)
    if g_failures == 0 {
        println("calm arms: all checks passed (${g_checks})")
        return
    }
    println("calm arms: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
