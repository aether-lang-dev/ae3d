// A stop settles without its feet jumping (#930): the UE5 mannequin on
// 100STYLE's neutral gaits (ae3d.character), its stop 100STYLE's LookUp walk
// stop as Siltreach's settler has it, stopped from a walk at 1.2 m/s and a
// run at 3 m/s, let go a quarter stride apart so it comes to rest on either
// foot. No window; stepped at 60 Hz. Siltreach's settler, the stop's last
// settle step flickering its contacts down, up and down again in 0.14 s,
// locked its foot again where the take had it each time: 167 mm in a frame,
// then 45.
//
//   - let go, it comes to rest (its object slower than 5 cm/s) within 4 s,
//     from the run too: braked from 3 m/s at its walk stop's 0.41 m/s^2, it
//     was still going 1.35 m/s 4 s on;
//   - once at rest, no foot within 2 cm of the ground moves more than 5 mm
//     over it between two frames;
//   - and no toe skates 5 mm through the stop (ae3d.metrics).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/lookup_stop.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(o: *GameObject) -> Vec3 { return core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }

// Asked to go at `speed` for `go` frames, then let go for 4 s: the most a
// foot near the ground moved over it in a frame once the figure was at rest
// (and when), and the worst a toe skated.
halt(e: *Engine, c: *Character, m: *Meter, speed: float, go: int) -> (float, float, float, float) {
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    o = character.object_of(c)
    drawn = pose.new(r)
    worlds = pose.new(r)
    metrics.meter_reset(m)
    ahead = facing(o)
    still = core.vec3(0.0, 0.0, 0.0)
    jump = 0.0
    jumped_at = 0.0 - 1.0
    lx = [0.0, 0.0]
    lz = [0.0, 0.0]
    was = behaviour.object_position(o)
    resting = false
    rested_at = 0.0 - 1.0
    k = 0
    while k < go + 240 {
        asked = still
        if k < go { asked = core.v3_mul(ahead, speed) }
        character.move(c, asked, still)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        now = behaviour.object_position(o)
        moving = core.v3_len(core.vec3(now.x - was.x, 0.0, now.z - was.z)) / STEP
        was = now
        if k > go && moving < 0.05 && !resting {
            resting = true
            rested_at = ((k - go) as float) * STEP
        }
        pose.read(r, drawn)
        pose.world(r, drawn, worlds)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(f, r, worlds, side)
            heel, pad, toe = ikrig.feet_soles(f, r, worlds, side)
            low = heel.y
            if pad.y < low { low = pad.y }
            if toe.y < low { low = toe.y }
            if resting && low < 0.02 {
                dx = tip.x - lx[side]
                dz = tip.z - lz[side]
                d = core.sqrt_of(dx * dx + dz * dz)
                if d > jump {
                    jump = d
                    jumped_at = ((k - go) as float) * STEP
                }
            }
            lx[side] = tip.x
            lz[side] = tip.z
            side = side + 1
        }
        k = k + 1
    }
    pose.release(drawn)
    pose.release(worlds)
    return jump, jumped_at, metrics.meter_worst(m, metrics.SKATE), rested_at
}

main() {
    println("stop_settle: a stop settles without its feet jumping (#930)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Settler", MANNEQUIN, g)
    if c == null {
        println("  no settler: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    speeds = [1.2, 1.2, 3.0, 3.0]
    goes = [150, 158, 150, 155]
    names = ["walk", "walk, a quarter stride on", "run", "run, a quarter stride on"]
    worst_jump = 0.0
    worst_skate = 0.0
    slowest = 0.0
    k = 0
    while k < 4 {
        jump, at, skate, rested = halt(e, c, m, speeds[k], goes[k])
        println("  from a ${names[k]} at ${speeds[k]} m/s: at rest ${rested} s after letting go; then a foot moved ${jump * 1000.0} mm in a frame at most (${at} s after letting go); a toe skated ${skate * 1000.0} mm")
        if jump > worst_jump { worst_jump = jump }
        if skate > worst_skate { worst_skate = skate }
        if rested < 0.0 || rested > slowest { slowest = rested }
        if rested < 0.0 { slowest = 1000.0 }
        k = k + 1
    }
    check("let go from a walk or a run, it comes to rest within 4 s", slowest <= 4.0)
    check("once at rest, no foot near the ground moves 5 mm over it in a frame", worst_jump < 0.005)
    check("no toe skates 5 mm through a stop", worst_skate < 0.005)
    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("stop_settle: all checks passed (${g_checks})")
        return
    }
    println("stop_settle: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
