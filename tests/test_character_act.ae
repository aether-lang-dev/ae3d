// A one-off take played on a character (#958, character.act): the UE5
// mannequin made a character (ae3d.character, on 100STYLE's gaits) in a
// world with physics, walking, plays UAL2's Hit_Knockback_RM by act. A game
// paused the character, turned root motion on, played the state and resumed
// it at the object's place by hand, and had to get that order right itself.
// No window; stepped at 60 Hz.
//
//   - its object travels the take's root travel (within 1 cm), the mover
//     left alone meanwhile, whatever is asked;
//   - with a wall a metre behind it, the wall stops it short (its capsule
//     against the wall, the object a capsule's radius off it);
//   - knocked down by it (the take ends lying), then got up by a second act
//     (UAL2's LayToIdle): it stands on its stand where it got up, no toe
//     skating 5 mm as it takes the stand up (ae3d.metrics);
//   - act_stop ends an act part way, and the character walks on asked.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.clips
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The level distance between two points.
level_apart(a: Vec3, b: Vec3) -> float { return core.v3_len(core.vec3(a.x - b.x, 0.0, a.z - b.z)) }

// Walked ahead at 1.2 m/s for `frames`, at `from`, facing +z.
walk(e: *Engine, c: *Character, from: Vec3, frames: int) {
    o = character.object_of(c)
    behaviour.object_set_position(o, from)
    behaviour.object_set_rotation(o, core.quat_ident())
    k = 0
    while k < frames {
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

main() {
    println("character_act: a one-off take played with its root motion through the capsule (#958)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Struck", MANNEQUIN, g)
    if c == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    a = character.animator_of(c)
    o = character.object_of(c)
    take = animator.take(a, "Hit_Knockback_RM", true)
    if take == null {
        println("  the mannequin has no Hit_Knockback_RM")
        exit(1)
    }
    knocked = animator.add_state(a, "knocked", take, false)
    travel = core.v3_len(clips.root_delta(take, 0.0, clips.duration(take), false))
    m = metrics.meter_new(animator.rig(a), o)
    metrics.meter_ground_physics(m, physics.of(e))

    // In the open, walking.
    walk(e, c, core.vec3(0.0, 0.0, 0.0), 90)
    began = behaviour.object_position(o)
    acted = character.act(c, knocked, 0.15)
    k = 0
    while k < 300 && character.acting(c) {
        // Asked to walk on: the act holds it.
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    ended = behaviour.object_position(o)
    went = level_apart(ended, began)
    // Knocked down by it (the take ends lying, its pelvis 10 cm up), and got
    // up by a second act, UAL2's LayToIdle; its stand taken up where it got up.
    getting_up = animator.add_state(a, "getting up", animator.take(a, "LayToIdle", true), false)
    rose = character.act(c, getting_up, 0.2)
    k = 0
    while k < 400 && character.acting(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    up_at = behaviour.object_position(o)
    // Its stand taken up where it got to.
    metrics.meter_reset(m)
    k = 0
    while k < 90 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    stood = character.standing(c)
    skated = metrics.meter_worst(m, metrics.SKATE)
    after = level_apart(behaviour.object_position(o), up_at)
    println("  acted ${acted}: the object went ${went} m (the take's root ${travel} m); got up by LayToIdle ${rose}; then standing ${stood}, ${after * 100.0} cm on, a toe skating ${skated * 1000.0} mm")
    check("its object travels the take's root travel (within 1 cm), the mover left alone though asked to walk", acted && core.abs_of(went - travel) < 0.01)
    check("knocked down, then got up by a second act, it stands on its stand where it got up, no toe skating 5 mm", rose && stood && after < 0.05 && skated < 0.005)

    // A wall behind it, its face at z 19, a metre or so back from where it
    // is struck (the take carries it back, along -z).
    wall = engine.object(e, "Wall", null)
    behaviour.object_set_position(wall, core.vec3(0.0, 1.0, 18.9))
    physics.box_collider(wall, core.vec3(3.0, 1.0, 0.1), physics.material(0.8, 0.0))
    walk(e, c, core.vec3(0.0, 0.0, 20.0), 30)
    began = behaviour.object_position(o)
    character.act(c, knocked, 0.15)
    k = 0
    while k < 300 && character.acting(c) {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    ended = behaviour.object_position(o)
    off_wall = ended.z - 19.0
    println("  a wall behind it: it went ${level_apart(ended, began)} m, stopped ${off_wall} m off the wall's face (its capsule's radius ${physics.character_radius(physics.character_of(o))})")
    check("a wall behind it stops it short, its capsule against the wall", level_apart(ended, began) < travel - 0.5 && core.abs_of(off_wall - physics.character_radius(physics.character_of(o))) < 0.03)

    // Ended part way, it walks on.
    walk(e, c, core.vec3(10.0, 0.0, 0.0), 30)
    character.act(c, knocked, 0.15)
    run_frames = 0
    while run_frames < 12 {
        engine.engine_update(e, STEP)
        run_frames = run_frames + 1
    }
    character.act_stop(c, 0.2)
    stopped = !character.acting(c)
    from = behaviour.object_position(o)
    k = 0
    while k < 120 {
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    on = behaviour.object_position(o).z - from.z
    println("  ended part way: acting ${!stopped}, then asked to walk it went ${on} m in 2 s")
    check("act_stop ends it part way, and asked to walk it walks on", stopped && on > 1.0)

    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("character_act: all checks passed (${g_checks})")
        return
    }
    println("character_act: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
