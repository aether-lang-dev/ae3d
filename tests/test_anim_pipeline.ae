// The animation pipeline (#853: pose, clips, animator, ikrig) held to the
// numbers a game judges it by, on real people: the Quaternius mannequins and
// their authored clips (tests/fixtures/people), not the box man. No window;
// the engine stepped by hand at 60 Hz.
//
//   - rigs: each humanoid naming (UE5, Rigify) maps every one of the 53
//     humanoid slots, fingers too; the box man's Mixamo rig its 20 bones;
//   - takes: resampled at the file's key rate, a take is the figure's own
//     sampler to 0.1 degree and a hundredth of a millimetre at any joint;
//     the walk's speed over the ground comes out a walk's, each of its feet
//     comes down once a cycle, an idle's feet never lift, and the roll's
//     root motion is its root's 5 m;
//   - mirroring: on the UE5 and the Rigify mannequin, every side's humanoid
//     joint mirrors to the other side's, the rest pose is its own mirror,
//     a walk mirrored twice is itself, and the mirrored walk leads with the
//     other foot at the same speed;
//   - events: the walk's footfalls are its events, and an event fires
//     once each time the animator's clock passes it;
//   - locomotion: the figure moved at 1 to 8 m/s along its gait's heading,
//     playing the walk, jog and sprint blended by speed and synced on their
//     footfalls. With its feet locked by ikrig, no planted toe (its tip, from
//     when the clip plants the foot to when it lifts it) slides 5 mm; with no
//     IK at all, the blend's feet carry the ground at the speed the figure
//     moves, within 1%;
//   - retargeting: the Rigify mannequin's walk carried onto the box man
//     (Mixamo's naming, other proportions) points every mapped limb and spine
//     segment where the source's does, its speed scaled by the two pelvises'
//     heights; the female mannequin (UE5's skeleton) walked and run on her
//     retargeted gaits, feet locked, slides no planted toe 5 mm;
//   - transitions: idle to walk to jog to sprint and back down to idle,
//     inertialized over 0.3 s and handed from gait to gait in step, never
//     turn a joint faster than the takes' own fastest played alone;
//   - layers: an upper body aiming a pistol over the walk leaves the legs
//     exactly the walk's; a chest hit added over the idle starts as the idle
//     and turns the chest;
//   - root motion: the roll played with it carries the figure's object its
//     root's 5 m, within 1%;
//   - feet: one foot over a 10 cm block comes onto it, its sole within 5 mm
//     of the block's top, the other on the floor, and no joint turns faster
//     than 6 degrees a step getting there;
//   - hands: walking with a bowl held in both hands, each hand within 5 mm of
//     its grip every frame, no elbow locked straight or folded shut;
//   - look: the head turns toward a point 60 degrees off to the side, more
//     than half way, and no further than LOOK_MOST.
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.retarget
import ae3d.bvh
import ae3d.mover

extern exit(code: int)
extern acos(x: float) -> float
extern clock_ns() -> long

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"
const FEMALE = "tests/fixtures/people/mannequin_f.glb"
const STYLE = "tests/fixtures/people/100style/"
const SLIDE = 0.005

var g_checks = 0
var g_failures = 0
var g_fastest_joint = 0 - 1
var g_show_samples = true

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

// A drawn joint's place in the world.
drawn(r: *pose.Rig, j: int) -> Vec3 {
    m = pose.joint(r, j)
    core.model_sync_transform(m)
    return m.world_position
}

// The figure's forward over the ground: from its heels to its toes as it
// stands at rest.
forward_of(r: *pose.Rig) -> Vec3 {
    w = pose.new(r)
    pose.rest_world(r, w)
    a = clips.ground_point(r, pose.translation(w, pose.human(r, pose.FOOT_L)))
    b = clips.ground_point(r, pose.translation(w, pose.human(r, pose.BALL_L)))
    pose.release(w)
    d = core.vec3(b.x - a.x, 0.0, b.z - a.z)
    return core.v3_normalize(d)
}

fresh() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

// --- rigs and takes -----------------------------------------------------------------------------

rigs() {
    names = [MANNEQUIN, "tests/fixtures/people/mannequin_f.glb", RIGIFY, BOXMAN]
    wanted = [pose.SLOTS, pose.SLOTS, pose.SLOTS, 20]
    schemes = [pose.SCHEME_UE5, pose.SCHEME_UE5, pose.SCHEME_RIGIFY, pose.SCHEME_MIXAMO]
    k = 0
    while k < 4 {
        e = fresh()
        o = figure.figure(e, "Person", names[k])
        r = pose.of_skeleton(figure.skeleton(figure.figure_of(o)))
        filled = 0
        slot = 0
        while slot < pose.SLOTS {
            if pose.human(r, slot) >= 0 { filled = filled + 1 }
            slot = slot + 1
        }
        println("  ${names[k]}: ${pose.count(r)} joints, scheme ${pose.scheme(r)}, ${filled} humanoid slots")
        check("${names[k]}: its naming read as expected and ${wanted[k]} humanoid slots mapped", pose.scheme(r) == schemes[k] && filled == wanted[k])
        pose.rig_free(r)
        figure.figures_free(e)
        engine.engine_free(e)
        k = k + 1
    }
}

takes() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    f = figure.figure_of(o)
    r = pose.of_skeleton(figure.skeleton(f))
    walk = clips.from_scene(r, figure.scene(f), "Walk_Loop", 0.0)
    // Against the figure's own sampler.
    figure.play(f, "Walk_Loop", 1.0, false)
    mine = pose.new(r)
    theirs = pose.new(r)
    worst_turn = 0.0
    worst_move = 0.0
    k = 0
    while k <= 40 {
        at = clips.duration(walk) * (k as float) / 40.0
        figure.set_time(f, at)
        pose.read(r, theirs)
        clips.sample(walk, r, at, false, mine)
        j = 0
        while j < pose.count(r) {
            t = turned_by(pose.rotation(mine, j), pose.rotation(theirs, j))
            if t > worst_turn { worst_turn = t }
            d = core.v3_len(core.v3_sub(pose.translation(mine, j), pose.translation(theirs, j)))
            if d > worst_move { worst_move = d }
            j = j + 1
        }
        k = k + 1
    }
    figure.stop(f)
    println("  Walk_Loop at ${clips.rate(walk)}/s: against the figure's sampler ${worst_turn * 57.29578} degrees, ${worst_move * 1000.0} mm at worst; ${clips.speed(walk)} m/s; feet down first at ${clips.foot_down(walk, 0)} and ${clips.foot_down(walk, 1)} s")
    check("a take is the figure's own sampler to 0.1 degree and 0.01 mm at any joint", worst_turn < 0.001745 && worst_move < 0.00001)
    check("the walk's speed over the ground is a walk's (0.8 to 1.6 m/s)", clips.speed(walk) > 0.8 && clips.speed(walk) < 1.6)
    // Each foot comes down once a cycle.
    downs = [0, 0]
    side = 0
    while side < 2 {
        was = clips.contact(walk, side, 0.0, true)
        fr = 1
        while fr < clips.frames(walk) {
            now = clips.contact(walk, side, (fr as float) / clips.rate(walk), true)
            if now && !was { downs[side] = downs[side] + 1 }
            was = now
            fr = fr + 1
        }
        side = side + 1
    }
    check("each of the walk's feet comes down once a cycle", downs[0] == 1 && downs[1] == 1)
    idle = clips.from_scene(r, figure.scene(f), "Idle_Loop", 0.0)
    always = true
    fr = 0
    while fr < clips.frames(idle) {
        t = (fr as float) / clips.rate(idle)
        if !clips.contact(idle, 0, t, false) || !clips.contact(idle, 1, t, false) { always = false }
        fr = fr + 1
    }
    check("an idle's feet never lift", always)
    roll = clips.from_scene(r, figure.scene(f), "Roll_RM", 0.0)
    clips.extract_root(roll, r, clips.up_of(r))
    went = clips.travel(roll, clips.duration(roll))
    far = core.sqrt_of(went.x * went.x + went.y * went.y)
    println("  Roll_RM: root motion on ${pose.name(r, clips.root_joint(roll))}, ${far} m")
    check("the roll's root motion is its root's, 4.9 to 5.1 m", clips.root_joint(roll) == pose.human(r, pose.ROOT) && far > 4.9 && far < 5.1)
    pose.release(mine)
    pose.release(theirs)
    clips.take_free(walk)
    clips.take_free(idle)
    clips.take_free(roll)
    pose.rig_free(r)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- mirroring and events -----------------------------------------------------------------------

// The worst turn and move between two poses' joints in the rig's space.
world_gap(r: *pose.Rig, a: ptr, b: ptr) -> (float, float) {
    wa = pose.new(r)
    wb = pose.new(r)
    pose.world(r, a, wa)
    pose.world(r, b, wb)
    turn = 0.0
    move = 0.0
    j = 0
    while j < pose.count(r) {
        t = turned_by(pose.rotation(wa, j), pose.rotation(wb, j))
        if t > turn { turn = t }
        d = core.v3_len(core.v3_sub(pose.translation(wa, j), pose.translation(wb, j)))
        if d > move { move = d }
        j = j + 1
    }
    pose.release(wa)
    pose.release(wb)
    return turn, move
}

mirroring() {
    names = [MANNEQUIN, RIGIFY]
    walks = ["Walk_Carry_Loop", "Walk_Loop"]
    k = 0
    while k < 2 {
        e = fresh()
        o = figure.figure(e, "Person", names[k])
        f = figure.figure_of(o)
        r = pose.of_skeleton(figure.skeleton(f))
        // Every humanoid slot of a side has its other side's joint as its mirror.
        paired = true
        slot = pose.CLAVICLE_L
        while slot < pose.SLOTS {
            other = 0 - 1
            if slot >= pose.CLAVICLE_L && slot <= pose.HAND_L { other = slot + 4 }
            if slot >= pose.THIGH_L && slot <= pose.BALL_L { other = slot + 4 }
            if slot >= pose.FINGERS && slot < pose.FINGERS + 15 { other = slot + 15 }
            if other >= 0 && pose.mirror_of(r, pose.human(r, slot)) != pose.human(r, other) { paired = false }
            if other >= 0 && pose.mirror_of(r, pose.human(r, other)) != pose.human(r, slot) { paired = false }
            slot = slot + 1
        }
        // The rest pose is its own mirror: the mannequins are made symmetric.
        rest = pose.new(r)
        flipped = pose.new(r)
        pose.mirror(r, rest, flipped)
        rest_turn, rest_move = world_gap(r, rest, flipped)
        // Mirrored twice, every frame of the walk is itself again.
        walk = clips.from_scene(r, figure.scene(f), walks[k], 0.0)
        if walk == null {
            check("${names[k]}: has its walk, ${walks[k]}", false)
            return
        }
        twice_turn = 0.0
        twice_move = 0.0
        back = pose.new(r)
        fr = 0
        while fr < clips.frames(walk) {
            pose.mirror(r, clips.frame(walk, fr), flipped)
            pose.mirror(r, flipped, back)
            t, m = world_gap(r, clips.frame(walk, fr), back)
            if t > twice_turn { twice_turn = t }
            if m > twice_move { twice_move = m }
            fr = fr + 1
        }
        // The mirrored walk leads with the other foot, at the walk's speed.
        other_walk = clips.mirror(walk, r)
        frame_gap = 1.5 / clips.rate(walk)
        swapped = core.abs_of(clips.foot_down(other_walk, 0) - clips.foot_down(walk, 1)) <= frame_gap &&
                  core.abs_of(clips.foot_down(other_walk, 1) - clips.foot_down(walk, 0)) <= frame_gap
        same_speed = core.abs_of(clips.speed(other_walk) - clips.speed(walk)) <= clips.speed(walk) * 0.01
        println("  ${names[k]}: rest against its mirror ${rest_turn * 57.29578} degrees, ${rest_move * 1000.0} mm; mirrored twice ${twice_turn * 57.29578} degrees, ${twice_move * 1000.0} mm; mirrored walk's feet down at ${clips.foot_down(other_walk, 0)} and ${clips.foot_down(other_walk, 1)} s against ${clips.foot_down(walk, 1)} and ${clips.foot_down(walk, 0)}, ${clips.speed(other_walk)} m/s against ${clips.speed(walk)}")
        check("${names[k]}: every side's humanoid joint mirrors to the other side's", paired)
        check("${names[k]}: the rest pose is its own mirror, within 0.5 degree and 1 mm", rest_turn < 0.0087 && rest_move < 0.001)
        check("${names[k]}: a walk mirrored twice is itself, within 0.001 degree and 0.001 mm", twice_turn < 0.0000175 && twice_move < 0.000001)
        check("${names[k]}: the mirrored walk puts down its left foot where the walk put down its right, at its speed within 1%", swapped && same_speed)
        clips.take_free(other_walk)
        clips.take_free(walk)
        pose.release(rest)
        pose.release(flipped)
        pose.release(back)
        pose.rig_free(r)
        figure.figures_free(e)
        engine.engine_free(e)
        k = k + 1
    }
}

events() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    walk = animator.take(a, "Walk_Loop", false)
    // The footfalls found at import: one a foot a cycle, as each foot comes down.
    lefts = 0
    rights = 0
    at_left = 0.0 - 1.0
    i = 0
    while i < clips.event_count(walk) {
        if string_is(clips.event_name(walk, i), clips.FOOT_LEFT) {
            lefts = lefts + 1
            at_left = clips.event_time(walk, i)
        }
        if string_is(clips.event_name(walk, i), clips.FOOT_RIGHT) { rights = rights + 1 }
        i = i + 1
    }
    check("the walk's footfalls are its events, one a foot a cycle, the left's as its left foot comes down", lefts == 1 && rights == 1 && core.abs_of(at_left - clips.foot_down(walk, 0)) < 0.0001)
    // An event added at 0.25 s fires once a cycle as the clock passes it,
    // the first time as the state starts there.
    clips.add_event(walk, 0.25, "cue")
    s = animator.add_state(a, "walk", walk, true)
    animator.play_at(a, s, 0.25, 0.0)
    cues = 0
    left_steps = 0
    seconds = clips.duration(walk) * 3.0
    k = 0
    while k < (seconds / STEP + 0.5) as int {
        engine.engine_update(e, STEP)
        if animator.fired(a, "cue") { cues = cues + 1 }
        if animator.fired(a, clips.FOOT_LEFT) { left_steps = left_steps + 1 }
        k = k + 1
    }
    println("  over three cycles of the walk: the cue fired ${cues} times, the left foot came down ${left_steps}")
    check("an event fires once each time the clock passes it, from where the state starts", cues == 3 && left_steps == 3)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

string_is(a: string, b: string) -> bool { return string.equals(a, b) == 1 }

// --- locomotion ---------------------------------------------------------------------------------

// An animator on the Rigify mannequin with its gaits blended by speed: walk,
// jog and sprint, each at its own speed. The idle is not a gait (it takes no
// steps) and stays out of the blend, a state of its own as a shipped game's
// is; below the walk's speed the walk plays slower. Blended in, its 2.5 s
// stretched the walk's stance past the stride the walk covers, and a locked
// toe was dragged 10 mm as the leg ran out of reach.
gaits(e: *Engine, o: *GameObject) -> (*Animator, int) {
    a = animator.attach(e, o)
    s = animator.add_blend(a, "move")
    gait_names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    k = 0
    while k < 3 {
        t = animator.take(a, gait_names[k], false)
        animator.blend_add(a, s, t, clips.speed(t))
        k = k + 1
    }
    animator.play(a, s, 0.0)
    return a, s
}

// An animator on the female mannequin (UE5's skeleton) with the Rigify
// mannequin's walk, jog and sprint retargeted onto it, blended by speed.
retargeted_gaits(e: *Engine, o: *GameObject) -> (*Animator, int) {
    source_o = figure.figure(e, "Source", RIGIFY)
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    a = animator.attach(e, o)
    s = animator.add_blend(a, "move")
    gait_names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    k = 0
    while k < 3 {
        made = clips.from_scene(source, figure.scene(source_f), gait_names[k], 0.0)
        t = animator.add_take(a, retarget.retarget(source, made, animator.rig(a)), false)
        clips.take_free(made)
        animator.blend_add(a, s, t, clips.speed(t))
        k = k + 1
    }
    pose.rig_free(source)
    animator.play(a, s, 0.0)
    return a, s
}

// The worst a toe slides, walking `speed` along the gait's heading for 3 s
// (after 1 s to settle), feet locked by ikrig or not: planted (from when the
// clip plants the foot, flat or on its ball, to when it lifts it), and while
// the clip has it planted.
slide_at(speed: float, locked: bool, female: bool) -> (float, float) {
    e = fresh()
    o = null as *GameObject
    a = null as *Animator
    s = 0
    if female {
        o = figure.figure(e, "Person", FEMALE)
        a, s = retargeted_gaits(e, o)
    } else {
        o = figure.figure(e, "Person", RIGIFY)
        a, s = gaits(e, o)
    }
    r = animator.rig(a)
    if locked { animator.set_feet(a, ikrig.feet_new(r, o)) }
    // The toes' tips are what touch the ground: measured as ikrig finds them,
    // on the pose drawn.
    probe = ikrig.feet_new(r, o)
    w = pose.new(r)
    // Along the gait's own heading (the one nearest this speed): the way its
    // stance feet carry the figure.
    ahead = clips.heading(animator.take(a, "Walk_Loop", false))
    names = ["Jog_Fwd_Loop", "Sprint_Loop"]
    m = 0
    while m < 2 {
        t = animator.take(a, names[m], false)
        if speed > clips.speed(t) * 0.75 { ahead = clips.heading(t) }
        m = m + 1
    }
    animator.set_param(a, s, speed)
    planted_from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    flat_from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    planted_was = [false, false]
    flat_was = [false, false]
    worst_planted = 0.0
    worst_flat = 0.0
    at = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 240 {
        at = core.v3_add(at, core.v3_mul(ahead, speed * STEP))
        behaviour.object_set_position(o, at)
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        side = 0
        while side < 2 {
            toe = ikrig.toe_tip(probe, r, w, side)
            down = animator.contact_weight(a, side) > 0.99
            flat = animator.plant_weight(a, side) > 0.99
            planted = down && (flat || planted_was[side])
            if planted && !planted_was[side] { planted_from[side] = toe }
            if flat && !flat_was[side] { flat_from[side] = toe }
            if k >= 60 {
                if planted {
                    d = flat_distance(toe, planted_from[side])
                    if d > worst_planted { worst_planted = d }
                }
                if flat {
                    d = flat_distance(toe, flat_from[side])
                    if d > worst_flat { worst_flat = d }
                }
            }
            planted_was[side] = planted
            flat_was[side] = flat
            side = side + 1
        }
        k = k + 1
    }
    ikrig.feet_free(probe)
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return worst_planted, worst_flat
}

flat_distance(a: Vec3, b: Vec3) -> float {
    return core.sqrt_of((a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z))
}

locomotion() {
    speeds = [1.0, 2.0, 4.0, 6.0, 8.0]
    most_locked = 0.0
    most_loose = 0.0
    line = "  the worst a toe slides, planted with feet locked / flat with no IK:"
    k = 0
    while k < 5 {
        tight, _tight_flat = slide_at(speeds[k], true, false)
        _loose_planted, loose = slide_at(speeds[k], false, false)
        line = "${line} ${speeds[k]} m/s ${tight * 1000.0} / ${loose * 1000.0} mm;"
        if tight > most_locked { most_locked = tight }
        if loose > most_loose { most_loose = loose }
        k = k + 1
    }
    println(line)
    check("moved at 1 to 8 m/s on its gaits blended by speed, feet locked, no planted toe slides 5 mm", most_locked < SLIDE)
    // With no IK, the blend plays its gaits at the speed the figure moves: its
    // feet carry the ground at that speed (what a hand-keyed clip does within a
    // stance is the clip's own, and the locks above hold it).
    worst_pace = 0.0
    k = 0
    while k < 5 {
        e = fresh()
        o = figure.figure(e, "Person", RIGIFY)
        a, s = gaits(e, o)
        animator.set_param(a, s, speeds[k])
        n = 0
        while n < 10 {
            engine.engine_update(e, STEP)
            n = n + 1
        }
        off = core.abs_of(animator.ground_speed(a) - speeds[k]) / speeds[k]
        if off > worst_pace { worst_pace = off }
        animator.animator_free(a)
        figure.figures_free(e)
        engine.engine_free(e)
        k = k + 1
    }
    println("  the blend's feet carry the ground at the speed asked, within ${worst_pace * 100.0}% from 1 to 8 m/s")
    check("with no IK at all, the blend's feet carry the ground at the speed the figure moves, within 1%", worst_pace < 0.01)
}

// --- retargeting --------------------------------------------------------------------------------

// The Rigify mannequin's walk carried onto the box man (Mixamo's naming,
// 8.7% taller, other proportions, no clavicles or fingers): each mapped limb
// and spine segment points where the source's does, and the walk's speed
// scales by the two pelvises' heights. And the female mannequin (UE5's
// skeleton, the same body), walked on her retargeted gaits with her feet
// locked: no planted toe slides 5 mm.
retargeting() {
    e = fresh()
    source_o = figure.figure(e, "Source", RIGIFY)
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    o = figure.figure(e, "Person", BOXMAN)
    target = pose.of_skeleton(figure.skeleton(figure.figure_of(o)))
    walk_s = clips.from_scene(source, figure.scene(source_f), "Walk_Loop", 0.0)
    walk_t = retarget.retarget_with(source, walk_s, target, false)
    ratio = retarget.height_ratio(source, target)
    segments = [pose.THIGH_L, pose.CALF_L, pose.CALF_L, pose.FOOT_L, pose.UPPERARM_L, pose.LOWERARM_L, pose.LOWERARM_L, pose.HAND_L,
                pose.THIGH_R, pose.CALF_R, pose.CALF_R, pose.FOOT_R, pose.UPPERARM_R, pose.LOWERARM_R, pose.LOWERARM_R, pose.HAND_R,
                pose.SPINE_01, pose.SPINE_02, pose.SPINE_03, pose.NECK]
    ws = pose.new(source)
    wt = pose.new(target)
    worst = 0.0
    fr = 0
    while fr < clips.frames(walk_s) {
        pose.world(source, clips.frame(walk_s, fr), ws)
        pose.world(target, clips.frame(walk_t, fr), wt)
        k = 0
        while k < 20 {
            a1 = clips.ground_point(source, pose.translation(ws, pose.human(source, segments[k])))
            b1 = clips.ground_point(source, pose.translation(ws, pose.human(source, segments[k + 1])))
            a2 = clips.ground_point(target, pose.translation(wt, pose.human(target, segments[k])))
            b2 = clips.ground_point(target, pose.translation(wt, pose.human(target, segments[k + 1])))
            d = core.acos_of(core.clampf(core.v3_dot(core.v3_normalize(core.v3_sub(b1, a1)), core.v3_normalize(core.v3_sub(b2, a2))), 0.0 - 1.0, 1.0))
            if d > worst { worst = d }
            k = k + 2
        }
        fr = fr + 1
    }
    scaled = clips.speed(walk_t) / clips.speed(walk_s)
    println("  the walk on the box man: limbs and spine within ${worst * 57.29578} degrees of the source's; ${clips.speed(walk_t)} m/s against ${clips.speed(walk_s)} (${scaled} of it, the pelvises' ratio ${ratio})")
    check("retargeted onto another body and naming, every limb and spine segment points where the source's does (within 0.5 degree)", worst < 0.0087)
    check("and the walk's speed scales by the pelvises' heights (within 5%)", core.abs_of(scaled - ratio) < ratio * 0.05)
    pose.release(ws)
    pose.release(wt)
    clips.take_free(walk_s)
    clips.take_free(walk_t)
    pose.rig_free(source)
    pose.rig_free(target)
    figure.figures_free(e)
    engine.engine_free(e)
    worst_slide = 0.0
    speeds = [1.5, 4.0]
    k = 0
    while k < 2 {
        slide, _flat = slide_at(speeds[k], true, true)
        if slide > worst_slide { worst_slide = slide }
        k = k + 1
    }
    println("  the female on her retargeted gaits, feet locked: a planted toe's worst slide ${worst_slide * 1000.0} mm")
    check("walked and run on her retargeted gaits with her feet locked, no planted toe slides 5 mm", worst_slide < SLIDE)
}

// --- motion capture -----------------------------------------------------------------------------

// The worst angle between the source's and the target's segments of `pairs`
// (joint to joint, humanoid slots), the source's turned by `yaw` to the
// target's facing, over every frame.
worst_segment(source: *pose.Rig, ts: *Take, target: *pose.Rig, tt: *Take, pairs: int[], count: int, yaw: Quat) -> float {
    ws = pose.new(source)
    wt = pose.new(target)
    worst = 0.0
    fr = 0
    while fr < clips.frames(ts) {
        pose.world(source, clips.frame(ts, fr), ws)
        pose.world(target, clips.frame(tt, fr), wt)
        k = 0
        while k < count {
            a1 = clips.ground_point(source, pose.translation(ws, pose.human(source, pairs[k])))
            b1 = clips.ground_point(source, pose.translation(ws, pose.human(source, pairs[k + 1])))
            a2 = clips.ground_point(target, pose.translation(wt, pose.human(target, pairs[k])))
            b2 = clips.ground_point(target, pose.translation(wt, pose.human(target, pairs[k + 1])))
            d1 = core.quat_apply(yaw, core.v3_normalize(core.v3_sub(b1, a1)))
            d = core.acos_of(core.clampf(core.v3_dot(d1, core.v3_normalize(core.v3_sub(b2, a2))), 0.0 - 1.0, 1.0))
            if d > worst { worst = d }
            k = k + 2
        }
        fr = fr + 1
    }
    pose.release(ws)
    pose.release(wt)
    return worst
}

// The worst a planted toe's tip slides over the ground through one of the
// take's stances (the take's own planted frames; the ground still, as under a
// capture read whole). `probe` finds the tips (null: the ball's child joint).
worst_stance_slide(r: *pose.Rig, t: *Take, probe: *Feet) -> float {
    w = pose.new(r)
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    worst = 0.0
    fr = 0
    while fr < clips.frames(t) {
        pose.world(r, clips.frame(t, fr), w)
        side = 0
        while side < 2 {
            tip = core.vec3(0.0, 0.0, 0.0)
            if probe != null {
                tip = ikrig.toe_tip(probe, r, w, side)
            } else {
                ball = pose.human(r, pose.BALL_L)
                if side == 1 { ball = pose.human(r, pose.BALL_R) }
                end = pose.find(r, "${pose.name(r, ball)}_end")
                tip = clips.ground_point(r, pose.translation(w, end))
            }
            planted = clips.planted(t, side, (fr as float) / clips.rate(t), false)
            if planted && !was[side] { from[side] = tip }
            if planted {
                d = flat_distance(tip, from[side])
                if d > worst { worst = d }
            }
            was[side] = planted
            side = side + 1
        }
        fr = fr + 1
    }
    pose.release(w)
    return worst
}

capture() {
    capture_one("neutral_fw.bvh", "forward walk", 139, 1.0)
    capture_one("neutral_fr.bvh", "forward run", 79, 1.0)
    capture_one("neutral_bw.bvh", "backward walk", 135, 0.0 - 1.0)
}

capture_one(file: string, title: string, frames: int, ahead: float) {
    c = bvh.load("${STYLE}${file}", 0.0)
    if c == null {
        check("100STYLE's ${title} reads: ${bvh.error()}", false)
        return
    }
    source = bvh.rig(c)
    filled = 0
    slot = 0
    while slot < pose.FINGERS {
        if pose.human(source, slot) >= 0 { filled = filled + 1 }
        slot = slot + 1
    }
    walk = bvh.take(c, title, 0, 0 - 1)
    println("  100STYLE's ${title}: ${pose.count(source)} joints, ${filled} body slots in Xsens's naming, ${bvh.unit(c)} m a unit, ${bvh.frames(c)} frames at ${clips.rate(walk)}/s")
    check("${title}: a BVH capture reads: Xsens's 22 body joints mapped, centimetres found, ${frames} frames at 60/s", pose.scheme(source) == pose.SCHEME_BVH && filled == 22 && core.abs_of(bvh.unit(c) - 0.01) < 0.000001 && bvh.frames(c) == frames && core.abs_of(clips.rate(walk) - 60.0) < 0.01)
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    target = pose.of_skeleton(figure.skeleton(figure.figure_of(o)))
    fs = retarget.facing(source)
    ft = retarget.facing(target)
    yaw = core.quat_rotate(core.atan2_of(fs.z * ft.x - fs.x * ft.z, fs.x * ft.x + fs.z * ft.z), core.vec3(0.0, 1.0, 0.0))
    turned = retarget.retarget_with(source, walk, target, false)
    kept = retarget.retarget(source, walk, target)
    upper = [pose.UPPERARM_L, pose.LOWERARM_L, pose.LOWERARM_L, pose.HAND_L, pose.UPPERARM_R, pose.LOWERARM_R, pose.LOWERARM_R, pose.HAND_R,
             pose.PELVIS, pose.SPINE_01, pose.SPINE_01, pose.SPINE_02, pose.SPINE_02, pose.SPINE_03, pose.NECK, pose.HEAD]
    legs = [pose.THIGH_L, pose.CALF_L, pose.CALF_L, pose.FOOT_L, pose.FOOT_L, pose.BALL_L,
            pose.THIGH_R, pose.CALF_R, pose.CALF_R, pose.FOOT_R, pose.FOOT_R, pose.BALL_R]
    turned_upper = worst_segment(source, walk, target, turned, upper, 16, yaw)
    turned_legs = worst_segment(source, walk, target, turned, legs, 12, yaw)
    kept_upper = worst_segment(source, walk, target, kept, upper, 16, yaw)
    kept_legs = worst_segment(source, walk, target, kept, legs, 12, yaw)
    probe = ikrig.feet_new(target, o)
    own = worst_stance_slide(source, walk, null as *Feet)
    turned_slide = worst_stance_slide(target, turned, probe)
    kept_slide = worst_stance_slide(target, kept, probe)
    // The pelvis's travel, scaled by the pelvises' heights.
    k = retarget.height_ratio(source, target)
    ws = pose.new(source)
    wt = pose.new(target)
    pose.world(source, clips.frame(walk, 0), ws)
    a_s = clips.ground_point(source, pose.translation(ws, pose.human(source, pose.PELVIS)))
    pose.world(source, clips.frame(walk, clips.frames(walk) - 1), ws)
    b_s = clips.ground_point(source, pose.translation(ws, pose.human(source, pose.PELVIS)))
    pose.world(target, clips.frame(kept, 0), wt)
    a_t = clips.ground_point(target, pose.translation(wt, pose.human(target, pose.PELVIS)))
    pose.world(target, clips.frame(kept, clips.frames(kept) - 1), wt)
    b_t = clips.ground_point(target, pose.translation(wt, pose.human(target, pose.PELVIS)))
    travel_ratio = flat_distance(b_t, a_t) / flat_distance(b_s, a_s)
    println("  onto the UE5 mannequin, turned bone by bone: arms, spine and head within ${turned_upper * 57.29578} degrees, legs ${turned_legs * 57.29578}; a planted toe slides ${turned_slide * 1000.0} mm a stance (the capture's own ${own * 1000.0} mm)")
    println("  with its feet kept on their contacts: arms, spine and head within ${kept_upper * 57.29578} degrees, legs ${kept_legs * 57.29578}; a planted toe slides ${kept_slide * 1000.0} mm a stance; the pelvis travels ${travel_ratio} of the source's (the pelvises' ratio ${k})")
    check("${title}: a capture retargeted turns every bone where the source's turns, within 2 degrees", turned_upper < 0.0349 && turned_legs < 0.0349)
    check("${title}: with its feet kept on their contacts, arms, spine and head stay within 2 degrees of the source's", kept_upper < 0.0349)
    // The head as it stands, not only where the neck points it: its rest
    // neck-to-head line turned as the head is, against the capture's.
    head_s = pose.human(source, pose.HEAD)
    head_t = pose.human(target, pose.HEAD)
    neck_s = pose.human(source, pose.NECK)
    neck_t = pose.human(target, pose.NECK)
    rest_s = pose.new(source)
    rest_t = pose.new(target)
    pose.rest_world(source, rest_s)
    pose.rest_world(target, rest_t)
    worst_head = 0.0
    fr = 0
    while fr < clips.frames(walk) {
        pose.world(source, clips.frame(walk, fr), ws)
        pose.world(target, clips.frame(kept, fr), wt)
        up_s = core.quat_apply(core.quat_mul(pose.rotation(ws, head_s), core.quat_conjugate(pose.rotation(rest_s, head_s))),
                               core.v3_normalize(core.v3_sub(pose.translation(rest_s, head_s), pose.translation(rest_s, neck_s))))
        up_t = core.quat_apply(core.quat_mul(pose.rotation(wt, head_t), core.quat_conjugate(pose.rotation(rest_t, head_t))),
                               core.v3_normalize(core.v3_sub(pose.translation(rest_t, head_t), pose.translation(rest_t, neck_t))))
        d = core.acos_of(core.clampf(core.v3_dot(core.quat_apply(yaw, up_s), up_t), 0.0 - 1.0, 1.0))
        if d > worst_head { worst_head = d }
        fr = fr + 1
    }
    println("  the head as it stands: within ${worst_head * 57.29578} degrees of the capture's")
    check("${title}: the head stands as the capture's does (its own pitch, not only the neck's line), within 2 degrees", worst_head < 0.0349)
    pose.release(rest_s)
    pose.release(rest_t)
    check("${title}: and no planted toe slides 5 mm through a stance", kept_slide < SLIDE)
    check("${title}: its pelvis travels the source's way scaled by the pelvises' heights, within 1%", core.abs_of(travel_ratio - k) < k * 0.01)
    // Root motion from the root made under the hips (the capture has none).
    clips.extract_root(kept, target, clips.up_of(target))
    rm = clips.travel(kept, clips.duration(kept))
    rm_far = core.sqrt_of(rm.x * rm.x + rm.y * rm.y)
    hips_far = flat_distance(b_t, a_t)
    println("  its root made under the hips carries ${rm_far} m of root motion, the hips ${hips_far} m")
    check("${title}: a root is made under the hips, and its root motion is the hips' travel, within 1%", clips.root_joint(kept) == pose.human(target, pose.ROOT) && core.abs_of(rm_far - hips_far) < hips_far * 0.01)
    // Locked to the rest pose: the figure drawn on its object, its root
    // motion along its own facing (forward, or back for a backward walk).
    pw = pose.new(target)
    pose.world(target, clips.frame(kept, 0), pw)
    rw = pose.new(target)
    pose.rest_world(target, rw)
    off = flat_distance(clips.ground_point(target, pose.translation(pw, pose.human(target, pose.PELVIS))), clips.ground_point(target, pose.translation(rw, pose.human(target, pose.PELVIS))))
    along = (rm.x * ft.x + rm.y * ft.z) / rm_far
    println("  locked to its rest: frame 0's pelvis ${off * 1000.0} mm from its rest place, its root motion ${along} along its facing")
    check("${title}: its root locked to the rest pose, the figure is drawn on its object (pelvis within 15 cm of its rest place) and goes its own way (${ahead} along its facing, within 0.1)", off < 0.15 && core.abs_of(along - ahead) < 0.1)
    // Straightened for a blend space: no turn, its travel's length kept on
    // the nearest of forward and back.
    clips.straighten(kept, target, true)
    st = clips.travel(kept, clips.duration(kept))
    println("  straightened: ${st.y} m ahead, ${st.x} m across, turned ${st.z}")
    check("${title}: straightened, it goes straight ${ahead} along its facing, turning nowhere, its length its path's as the root took it (within 2% of its travel)", core.abs_of(st.y - ahead * rm_far) < rm_far * 0.02 && core.abs_of(st.x) < 0.000001 && core.abs_of(st.z) < 0.000001)
    pose.release(pw)
    pose.release(rw)
    ikrig.feet_free(probe)
    pose.release(ws)
    pose.release(wt)
    clips.take_free(turned)
    clips.take_free(kept)
    clips.take_free(walk)
    pose.rig_free(target)
    bvh.capture_free(c)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- root motion through a capsule --------------------------------------------------------------

// The roll played with root motion on a figure with a character controller:
// on open ground its capsule goes the root's travel; with a wall across the
// way 2 m on, the capsule stops at it.
capsule_root_motion() {
    walls = [false, true]
    went_open = 0.0
    went_walled = 0.0
    should = 0.0
    k = 0
    while k < 2 {
        e = fresh()
        physics.attach(e)
        ground = engine.object(e, "Ground", loader.cube(1.0))
        behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
        physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
        o = figure.figure(e, "Person", RIGIFY)
        capsule = physics.character_controller(o, 0.3, 1.7)
        a = animator.attach(e, o)
        roll = animator.take(a, "Roll_RM", true)
        s = animator.add_state(a, "roll", roll, false)
        animator.set_root_motion(a, true)
        own = clips.travel(roll, clips.duration(roll))
        should = core.sqrt_of(own.x * own.x + own.y * own.y)
        ahead = clips.heading(roll)
        start = behaviour.object_position(o)
        if walls[k] {
            wall = engine.object(e, "Wall", loader.cube(1.0))
            behaviour.object_set_position(wall, core.v3_add(start, core.vec3(ahead.x * 2.05, 1.0, ahead.z * 2.05)))
            behaviour.object_set_rotation(wall, core.quat_rotate(core.atan2_of(ahead.x, ahead.z), core.vec3(0.0, 1.0, 0.0)))
            physics.box_collider(wall, core.vec3(3.0, 1.0, 0.05), physics.material(0.8, 0.0))
        }
        animator.play(a, s, 0.0)
        n = 0
        while n < (clips.duration(roll) / STEP) as int + 10 {
            engine.engine_update(e, STEP)
            n = n + 1
        }
        end = behaviour.object_position(o)
        went = core.v3_dot(core.vec3(end.x - start.x, 0.0, end.z - start.z), ahead)
        if walls[k] { went_walled = went } else { went_open = went }
        physics.character_free(capsule)
        animator.animator_free(a)
        figure.figures_free(e)
        engine.engine_free(e)
        k = k + 1
    }
    println("  the roll on a capsule: ${went_open} m of its root's ${should} on open ground; ${went_walled} m with a wall 2 m on (its face at 2.0, the capsule 0.3 wide)")
    check("root motion carries a character controller its root's travel on open ground, within 1%", core.abs_of(went_open - should) < should * 0.01)
    check("and a wall across the way stops it, its capsule against the wall's face", went_walled > 1.6 && went_walled < 1.72)
}

// --- loops and cost -----------------------------------------------------------------------------

// Each of the Rigify mannequin's loops played across its seam: the last
// frame is the first again (no snap), the step across turns no joint
// faster than the take's own fastest step (no hitch), and an in-place
// loop's pelvis ends where it began (no drift).
loop_seams() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    f = figure.figure_of(o)
    r = pose.of_skeleton(figure.skeleton(f))
    names = ["Idle_Loop", "Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    snap = 0.0
    hitch = 0.0
    drift = 0.0
    line = ""
    pelvis = pose.human(r, pose.PELVIS)
    k = 0
    while k < 4 {
        t = clips.from_scene(r, figure.scene(f), names[k], 0.0)
        n = clips.frames(t)
        inside = 0.0
        fr = 0
        while fr < n - 1 {
            x = fastest_turn(r, clips.frame(t, fr), clips.frame(t, fr + 1))
            if x > inside { inside = x }
            fr = fr + 1
        }
        apart, _moved = world_gap(r, clips.frame(t, n - 1), clips.frame(t, 0))
        across = fastest_turn(r, clips.frame(t, n - 2), clips.frame(t, 1)) / 2.0
        a = pose.translation(clips.frame(t, 0), pelvis)
        b = pose.translation(clips.frame(t, n - 1), pelvis)
        gone = flat_distance(clips.ground_point(r, a), clips.ground_point(r, b))
        if apart > snap { snap = apart }
        if across / inside > hitch { hitch = across / inside }
        if gone > drift { drift = gone }
        line = "${line} ${names[k]} ${apart * 57.29578} degrees, ${across / inside} of its fastest step, ${gone * 1000.0} mm;"
        clips.take_free(t)
        k = k + 1
    }
    println("  across each loop's seam:${line}")
    check("no loop snaps at its seam: its last frame is its first, within 0.1 degree at any joint", snap < 0.00175)
    check("no loop hitches across its seam: the step over it turns no joint faster than the take's fastest step", hitch <= 1.0)
    check("no in-place loop drifts: its pelvis ends within 1 mm of where it began", drift < 0.001)
    pose.rig_free(r)
    figure.figures_free(e)
    engine.engine_free(e)
}

// What a figure's take costs to sample, the walk at random times, a frame's
// worth for each of 100 characters. Held to 250 microseconds a character:
// the suites build at -O0, and macOS's leak shard measured 25 where an
// optimised build takes 0.32; a bound that still catches a sample made
// slow (one that allocates).
sampling_cost() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    f = figure.figure_of(o)
    r = pose.of_skeleton(figure.skeleton(f))
    walk = clips.from_scene(r, figure.scene(f), "Walk_Loop", 0.0)
    out = pose.new(r)
    samples = 6000
    at = 0.37
    began = clock_ns()
    k = 0
    while k < samples {
        clips.sample(walk, r, at, true, out)
        at = at + 0.6180339887
        k = k + 1
    }
    seconds = ((clock_ns() - began) as float) / 1000000000.0
    each = seconds / (samples as float)
    println("  sampling the walk for one character (${pose.count(r)} joints): ${each * 1000000.0} microseconds")
    check("sampling a take costs under 250 microseconds a character, at -O0 under the leak check", each < 0.00025)
    pose.release(out)
    clips.take_free(walk)
    pose.rig_free(r)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- the 2D blend space -------------------------------------------------------------------------

// 100STYLE's walks and runs, forward, back and to the side (each side's
// mirrored for the other), on the UE5 mannequin in a 2D blend space: each
// take retargeted with its feet kept, its root motion taken out, straightened
// on its nearest axis and its best loop cut from it (clips.loop_cut), and set in the space at its own
// velocity. Its index; `wanted` gets the samples' velocities, (x, z) a take.
strafes(a: *Animator, r: *pose.Rig) -> int {
    move = animator.add_blend2(a, "move")
    names = ["neutral_fw.bvh", "neutral_bw.bvh", "neutral_sw.bvh", "neutral_fr.bvh", "neutral_br.bvh", "neutral_sr.bvh"]
    sides = [false, false, true, false, false, true]
    k = 0
    while k < 6 {
        c = bvh.load("${STYLE}${names[k]}", 0.0)
        made = bvh.take(c, names[k], 0, 0 - 1)
        t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
        clips.straighten(t, r, true)
        t = animator.add_take(a, clips.loop_cut(t, r), false)
        // Its stride on its axis too: a loop cut from the take sways a
        // degree or two off it, and a sample on the wrong side of the one
        // beyond it kept a quarter of the weight at a speed it cannot reach.
        clips.straighten(t, r, true)
        went = clips.travel(t, clips.duration(t))
        animator.blend_add2(a, move, t, went.x / clips.duration(t), went.y / clips.duration(t))
        if g_show_samples { println("    sample ${names[k]}: ${went.x / clips.duration(t)}, ${went.y / clips.duration(t)}; speed ${clips.speed(t)}, heading ${clips.heading(t).x}, ${clips.heading(t).z}, feet down ${clips.foot_down(t, 0)} ${clips.foot_down(t, 1)} of ${clips.duration(t)}") }
        if sides[k] {
            other = animator.add_take(a, clips.mirror(t, r), false)
            far = clips.travel(other, clips.duration(other))
            animator.blend_add2(a, move, other, far.x / clips.duration(other), far.y / clips.duration(other))
            if g_show_samples { println("    sample mirrored ${names[k]}: ${far.x / clips.duration(other)}, ${far.y / clips.duration(other)}; feet down ${clips.foot_down(other, 0)} ${clips.foot_down(other, 1)}") }
        }
        clips.take_free(made)
        bvh.capture_free(c)
        k = k + 1
    }
    return move
}

// The figure moved at (vx, vz) metres a second over the ground (x to its
// left, z ahead) for 4 s on the blend: the worst a planted toe's tip slides
// through a stance after the first second, with its feet locked; and the
// blend's ground speed against the speed asked.
strafe_at(vx: float, vz: float) -> (float, float) {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    move = strafes(a, r)
    g_show_samples = false
    animator.set_feet(a, ikrig.feet_new(r, o))
    probe = ikrig.feet_new(r, o)
    animator.set_velocity(a, move, vx, vz)
    animator.play(a, move, 0.0)
    ahead = retarget.facing(r)
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    velocity = core.v3_add(core.v3_mul(left, vx), core.v3_mul(ahead, vz))
    w = pose.new(r)
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    worst = 0.0
    matched = 0.0
    at = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 240 {
        at = core.v3_add(at, core.v3_mul(velocity, STEP))
        behaviour.object_set_position(o, at)
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(probe, r, w, side)
            planted = animator.contact_weight(a, side) > 0.99 && (animator.plant_weight(a, side) > 0.99 || was[side])
            if planted && !was[side] { from[side] = tip }
            if planted && k >= 60 {
                d = flat_distance(tip, from[side])
                if d > worst { worst = d }
            }
            was[side] = planted
            side = side + 1
        }
        matched = animator.ground_speed(a)
        k = k + 1
    }
    ikrig.feet_free(probe)
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return worst, matched
}

blend_space_2d() {
    // Within the space: its slowest outer sample, the run back, is 1.31 m/s.
    speeds = [0.6, 1.0, 1.3]
    worst = 0.0
    off = 0.0
    line = ""
    d = 0
    while d < 8 {
        angle = (d as float) * 0.7853981633974483
        s = 0
        while s < 3 {
            vx = speeds[s] * core.sin_of(angle)
            vz = speeds[s] * core.cos_of(angle)
            slid, speed = strafe_at(vx, vz)
            if slid > worst { worst = slid }
            if slid > SLIDE || core.abs_of(speed - speeds[s]) > speeds[s] * 0.01 { println("    at ${d * 45} degrees, ${speeds[s]} m/s: ${slid * 1000.0} mm, ground speed ${speed}") }
            miss = core.abs_of(speed - speeds[s]) / speeds[s]
            if miss > off { off = miss }
            s = s + 1
        }
        line = "${line} ${d * 45} degrees;"
        d = d + 1
    }
    println("  the 2D blend at 8 directions and 0.6, 1.0, 1.3 m/s: a planted toe's worst slide ${worst * 1000.0} mm, its speed ${off * 100.0}% off the speed asked at worst")
    check("moved any way at walking and running speeds on the 2D blend, feet locked, no planted toe slides 5 mm", worst < SLIDE)
    check("and the blend carries the ground at the speed asked, within 1%", off < 0.01)
}

// --- starts and stops by distance ---------------------------------------------------------------

// A capture's take on the UE5 mannequin: retargeted with its feet kept, its
// root motion taken out and straightened, cut from `from` to `to` seconds of
// it (negative: from its root's first move, or to its root's coming still,
// by that much). Owned by the animator.
captured(a: *Animator, r: *pose.Rig, file: string, from: float, to: float, around_move: bool) -> *Take {
    c = bvh.load("${STYLE}${file}", 0.0)
    made = bvh.take(c, file, 0, 0 - 1)
    t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
    clips.straighten(t, r, true)
    mark = clips.moving_at(t, 0.1)
    if !around_move { mark = clips.still_at(t, 0.1) }
    a0 = ((mark + from) * clips.rate(t)) as int
    b0 = ((mark + to) * clips.rate(t)) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    cut = animator.add_take(a, clips.crop(t, r, a0, b0, false), false)
    clips.take_free(made)
    bvh.capture_free(c)
    return cut
}

// The UE5 mannequin on a mover and a graph of idle, a start, the 2D blend
// and a stop, all from 100STYLE: the start played by the distance come, the
// stop by the distance left to rest. Stand 1 s, walk ahead at 0.8 m/s for
// 4 s, let go. With `locked`, its feet locked. The states it went through,
// the worst a planted toe slid through a stance, and how far it ended from
// where the mover brought it to rest.
start_stop_run(locked: bool) -> (string, float) {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    // The idle: the stop take's standing, looped.
    c = bvh.load("${STYLE}neutral_stop.bvh", 0.0)
    made = bvh.take(c, "stand", 0, 0 - 1)
    stood = retarget.retarget(bvh.rig(c), made, r)
    clips.extract_root(stood, r, clips.up_of(r))
    at = (clips.still_at(stood, 0.1) + 1.0) * clips.rate(stood)
    if at < 0.0 { at = 4.0 * clips.rate(stood) }
    standing = clips.crop(stood, r, at as int, clips.frames(stood) - 1, false)
    idle_t = animator.add_take(a, clips.loop_cut(standing, r), false)
    clips.take_free(standing)
    clips.take_free(stood)
    clips.take_free(made)
    bvh.capture_free(c)
    idle = animator.add_state(a, "idle", idle_t, true)
    move = strafes(a, r)
    animator.bind2(a, move, "vx", "vz")
    start_t = captured(a, r, "neutral_start.bvh", 0.0 - 0.3, 1.6, true)
    start = animator.add_state(a, "start", start_t, false)
    animator.clock_by(a, start, "travelled", false)
    stop_t = captured(a, r, "lookup_stop.bvh", 0.0 - 1.6, 0.3, false)
    stop = animator.add_state(a, "stop", stop_t, false)
    animator.clock_by(a, stop, "rest", true)
    go = animator.add_transition(a, idle, start, 0.2)
    animator.transition_when(a, go, "go", animator.IS, 0.0)
    on = animator.add_transition(a, start, move, 0.3)
    animator.transition_when(a, on, "", animator.ENDED, 0.0)
    animator.transition_synced(a, on, true)
    halt = animator.add_transition(a, move, stop, 0.25)
    animator.transition_when(a, halt, "go", animator.IS_NOT, 0.0)
    // Once the way left to rest fits in the stop: distance matching's entry.
    animator.transition_when(a, halt, "rest", animator.BELOW, clips.travel_length(stop_t))
    rested = animator.add_transition(a, stop, idle, 0.3)
    animator.transition_when(a, rested, "", animator.ENDED, 0.0)
    // The stop on the other foot: its mirror, whichever the feet match.
    stop_m = animator.add_state(a, "stop", animator.add_take(a, clips.mirror(stop_t, r), false), false)
    animator.clock_by(a, stop_m, "rest", true)
    animator.transition_or(a, halt, stop_m)
    rested_m = animator.add_transition(a, stop_m, idle, 0.3)
    animator.transition_when(a, rested_m, "", animator.ENDED, 0.0)
    if locked { animator.set_feet(a, ikrig.feet_new(r, o)) }
    probe = ikrig.feet_new(r, o)
    m = mover.mover_new(a, o)
    mover.set_braking(m, clips.braking(stop_t))
    if locked { println("    the stop: ${clips.travel_length(stop_t)} m, braking ${clips.braking(stop_t)} m/s2") }
    animator.play(a, idle, 0.0)
    w = pose.new(r)
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    worst = 0.0
    seen = ""
    last_state = 0 - 1
    ahead = retarget.facing(r)
    k = 0
    while k < (8.0 / STEP) as int {
        now = (k as float) * STEP
        asked = core.vec3(0.0, 0.0, 0.0)
        if now >= 1.0 && now < 5.0 { asked = core.v3_mul(ahead, 0.8) }
        mover.ask(m, asked)
        mover.step(m, STEP)
        engine.engine_update(e, STEP)
        if animator.current(a) != last_state {
            last_state = animator.current(a)
            seen = "${seen} ${animator.state_name(a, last_state)}"
        }
        pose.world(r, animator.pose_now(a), w)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(probe, r, w, side)
            planted = animator.contact_weight(a, side) > 0.99 && (animator.plant_weight(a, side) > 0.99 || was[side])
            if planted && !was[side] { from[side] = tip }
            if planted && k > 10 {
                d = flat_distance(tip, from[side])
                if d > worst { worst = d }
            }
            was[side] = planted
            side = side + 1
        }
        k = k + 1
    }
    mover.mover_free(m)
    ikrig.feet_free(probe)
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return seen, worst
}

starts_and_stops() {
    seen, locked = start_stop_run(true)
    _seen2, free_feet = start_stop_run(false)
    println("  stood, walked 4 s at 0.8 m/s and let go on a mover braking as the stop does: the graph went${seen}; a planted toe slid ${locked * 1000.0} mm at worst with the feet locked, ${free_feet * 1000.0} mm with no IK")
    check("a mover and its graph start and stop by distance: idle, start, gaits, stop, idle", string_is(seen, " idle start move stop idle"))
    check("and through the start and the stop, feet locked, no planted toe slides 5 mm", locked < SLIDE)
}

// --- turning on the spot ------------------------------------------------------------------------

// The stop take's standing, looped, as an idle for the UE5 mannequin.
standing_idle(a: *Animator, r: *pose.Rig) -> *Take {
    c = bvh.load("${STYLE}neutral_stop.bvh", 0.0)
    made = bvh.take(c, "stand", 0, 0 - 1)
    stood = retarget.retarget(bvh.rig(c), made, r)
    clips.extract_root(stood, r, clips.up_of(r))
    at = (clips.still_at(stood, 0.1) + 1.0) * clips.rate(stood)
    if at < 0.0 { at = 4.0 * clips.rate(stood) }
    standing = clips.crop(stood, r, at as int, clips.frames(stood) - 1, false)
    idle_t = animator.add_take(a, clips.loop_cut(standing, r), false)
    clips.take_free(standing)
    clips.take_free(stood)
    clips.take_free(made)
    bvh.capture_free(c)
    return idle_t
}

// The UE5 mannequin standing on its idle, turned round on the spot by a
// mover (half a turn, its facing on a 0.6 s half-life), its feet stepping
// (ikrig.feet_set_steps): no planted toe slides 5 mm while it is held, it
// turns in steps of 45 degrees or less, its body stays on its spot, and no
// foot is left more than 50 degrees further off the way the body faces
// than it stood (the idle stands its feet turned out). As a player sees it
// (#898): no foot crosses the hips' middle and no knee bends 30 degrees
// out, each step lifts its foot 3 cm, and no ankle moves 3 m/s (a foot held
// to its toe's old lock through its step jumped 16 cm between frames).
turn_on_the_spot() {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle = animator.add_state(a, "idle", standing_idle(a, r), true)
    feet = ikrig.feet_new(r, o)
    ikrig.feet_set_steps(feet, true)
    animator.set_feet(a, feet)
    probe = ikrig.feet_new(r, o)
    m = mover.mover_new(a, o)
    mover.set_half_lives(m, mover.HALF_LIFE, 0.6)
    animator.play(a, idle, 0.0)
    w = pose.new(r)
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    worst = 0.0
    twisted = 0.0
    stood = [0.0, 0.0]
    pelvis = pose.human(r, pose.PELVIS)
    start = core.vec3(0.0, 0.0, 0.0)
    farthest = 0.0
    knee_out = 0.0
    crossed = 0.0 - 1.0
    ankles_was = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    rest_y = [0.0, 0.0]
    fastest = 0.0
    lifted = 0.0
    k = 0
    while k < (4.0 / STEP) as int {
        if k == 30 { mover.face(m, 3.141592653589793, true) }
        mover.step(m, STEP)
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        hips = ikrig.to_ground(r, pose.translation(w, pelvis))
        if k == 29 { start = hips }
        if k > 29 {
            d = flat_distance(hips, start)
            if d > farthest { farthest = d }
        }
        if k > 29 {
            seen_out, seen_cross = legs_read(r, w)
            if seen_out > knee_out { knee_out = seen_out }
            if seen_cross > crossed { crossed = seen_cross }
        }
        body = mover.facing_of(m)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(probe, r, w, side)
            ankle = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
            if k > 29 {
                moved = core.v3_len(core.v3_sub(ankle, ankles_was[side])) / STEP
                if moved > fastest { fastest = moved }
                if ikrig.feet_stepping(feet, side) && ankle.y - rest_y[side] > lifted { lifted = ankle.y - rest_y[side] }
            }
            if k == 29 { rest_y[side] = ankle.y }
            ankles_was[side] = ankle
            held = ikrig.feet_locked(feet, side) && !ikrig.feet_stepping(feet, side)
            if held && !was[side] { from[side] = tip }
            if held && k > 10 {
                slid = flat_distance(tip, from[side])
                if slid > worst { worst = slid }
                // How far the planted foot points off the way the body faces.
                yaw = core.atan2_of(tip.x - ankle.x, tip.z - ankle.z)
                off = core.abs_of(wrap_turn(yaw - body))
                if k == 29 { stood[side] = off }
                if k > 29 { off = core.abs_of(off - stood[side]) } else { off = 0.0 }
                if off > twisted { twisted = off }
            }
            was[side] = held
            side = side + 1
        }
        k = k + 1
    }
    steps = ikrig.feet_steps(feet)
    turned = core.abs_of(wrap_turn(mover.facing_of(m))) * 57.29578
    each = turned
    if steps > 0 { each = turned / (steps as float) }
    println("  turned ${turned} degrees on the spot in ${steps} steps (${each} a step): a planted toe slid ${worst * 1000.0} mm at worst, the hips went ${farthest * 1000.0} mm off their spot, a planted foot turned ${twisted * 57.29578} degrees further off the body than it stood at most")
    check("turned round on the spot, it steps: no planted toe slides 5 mm, and each step turns it 45 degrees or less", worst < SLIDE && steps > 0 && each <= 45.0)
    check("and it stays on its spot (the hips within 5 cm), no planted foot left more than 50 degrees further off the way it faces than it stood", farthest < 0.05 && twisted * 57.29578 < 50.0)
    println("  turning: a foot past the hips' middle ${crossed * 100.0} cm at most (below 0, never), a knee bent out off the hips ${knee_out * 57.29578} degrees at most, a step's foot lifted ${lifted * 1000.0} mm, an ankle at ${fastest} m/s at the fastest")
    check("turning, no foot crosses the hips' middle or knee bends 30 degrees out, each step lifts its foot 3 cm, and no ankle moves 3 m/s", crossed < 0.0 && knee_out * 57.29578 < 30.0 && lifted > 0.03 && fastest < 3.0)
    mover.mover_free(m)
    ikrig.feet_free(probe)
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// How the legs of pose `w` read to a player, as the showcase's
// AE3D_METRICS reads them (#898): the most a knee bent 6 cm off its leg's
// line points out off the way the hips face, in radians, and how far a foot
// stands past the hips' middle toward the other side, in metres (below 0
// while neither crosses).
legs_read(r: *pose.Rig, w: ptr) -> (float, float) {
    hip_l = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_L)))
    knee_l = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.CALF_L)))
    ankle_l = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L)))
    hip_r = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.THIGH_R)))
    knee_r = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.CALF_R)))
    ankle_r = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_R)))
    across = core.v3_sub(hip_l, hip_r)
    across = core.v3_normalize(core.vec3(across.x, 0.0, across.z))
    facing = core.v3_cross(across, core.vec3(0.0, 1.0, 0.0))
    out = 0.0
    sides = [1.0, 0.0 - 1.0]
    k = 0
    while k < 2 {
        hip = hip_l
        knee = knee_l
        ankle = ankle_l
        if k == 1 {
            hip = hip_r
            knee = knee_r
            ankle = ankle_r
        }
        line = core.v3_normalize(core.v3_sub(ankle, hip))
        off = core.v3_sub(core.v3_sub(knee, hip), core.v3_mul(line, core.v3_dot(core.v3_sub(knee, hip), line)))
        flat = core.vec3(off.x, 0.0, off.z)
        if core.v3_len(flat) > 0.06 {
            flat = core.v3_normalize(flat)
            this_out = core.atan2_of(core.v3_dot(flat, core.v3_mul(across, sides[k])), core.v3_dot(flat, facing))
            if this_out > out { out = this_out }
        }
        k = k + 1
    }
    middle = core.v3_lerp(hip_l, hip_r, 0.5)
    crossed = core.v3_dot(core.v3_sub(ankle_r, middle), across)
    crossed_l = 0.0 - core.v3_dot(core.v3_sub(ankle_l, middle), across)
    if crossed_l > crossed { crossed = crossed_l }
    return out, crossed
}

wrap_turn(a: float) -> float {
    x = a
    while x > 3.141592653589793 { x = x - 6.283185307179586 }
    while x < 0.0 - 3.141592653589793 { x = x + 6.283185307179586 }
    return x
}

// --- motion matching ----------------------------------------------------------------------------

// A capture's take on the UE5 mannequin, retargeted with its feet kept and
// its root motion taken out (its turns kept: the way ahead is the matcher's).
matchable(a: *Animator, r: *pose.Rig, file: string) -> *Take {
    c = bvh.load("${STYLE}${file}", 0.0)
    made = bvh.take(c, file, 0, 0 - 1)
    t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

// The UE5 mannequin played by a matcher over 100STYLE's walks, runs, side
// steps (each side's mirror for the other), walking turns (and their
// mirror), a start, a stop (and its mirror) and a stand, moved by a mover
// whose stick stands it, walks it ahead, steps it left facing ahead, walks
// it round to its right and stops it; feet locked, following its clips (the
// mover's springs a simulation). It plays what the way ahead asks: a walk
// ahead walking, a side step stepping aside, a stand or a stop at rest. How
// far a planted toe slides and how fast a joint turns through its changes
// are printed, not held: with one short take of each motion, a frame whose
// feet agree with the pose drawn is often not there, and holding them waits
// on a database of the style's whole takes.
motion_matching() {
    e = fresh()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    matcher = animator.add_matcher(a, "match")
    names = ["neutral_fw.bvh", "neutral_bw.bvh", "neutral_sw.bvh", "neutral_fr.bvh", "neutral_br.bvh", "neutral_sr.bvh",
             "neutral_tr1.bvh", "neutral_start.bvh", "lookup_stop.bvh"]
    mirrored = [false, false, true, false, false, true, true, false, true]
    own = 0.0
    k = 0
    while k < 9 {
        t = matchable(a, r, names[k])
        if k < 6 {
            // A gait as a loop on its axis, as the blend space has it: a
            // matcher plays on round it, never off its end.
            clips.straighten(t, r, true)
            t = animator.add_take(a, clips.loop_cut(t, r), false)
            clips.straighten(t, r, true)
        }
        animator.matcher_add(a, matcher, t)
        x = own_fastest(r, t)
        if x > own { own = x }
        if mirrored[k] { animator.matcher_add(a, matcher, animator.add_take(a, clips.mirror(t, r), false)) }
        k = k + 1
    }
    animator.matcher_add(a, matcher, standing_idle(a, r))
    animator.matcher_build(a, matcher)
    animator.set_feet(a, ikrig.feet_new(r, o))
    probe = ikrig.feet_new(r, o)
    m = mover.mover_new(a, o)
    mover.set_matcher(m, matcher)
    mover.set_follow(m, true)
    animator.play(a, matcher, 0.0)
    ahead = retarget.facing(r)
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    right_ahead = core.vec3(0.0 - left.x, 0.0, 0.0 - left.z)
    w = pose.new(r)
    before = pose.new(r)
    from = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was = [false, false]
    worst = 0.0
    fastest = 0.0
    played = ""
    at_walk = ""
    at_side = ""
    at_rest = ""
    v_walk = core.vec3(0.0, 0.0, 0.0)
    v_side = core.vec3(0.0, 0.0, 0.0)
    v_rest = core.vec3(0.0, 0.0, 0.0)
    last_take = ""
    distinct = 0
    k = 0
    while k < (11.0 / STEP) as int {
        now = (k as float) * STEP
        asked = core.vec3(0.0, 0.0, 0.0)
        if now >= 1.0 && now < 4.0 { asked = core.v3_mul(ahead, 0.8) }
        if now >= 4.0 && now < 6.0 {
            asked = core.v3_mul(left, 0.55)
            mover.face(m, core.atan2_of(ahead.x, ahead.z), true)
        }
        if now >= 6.0 && now < 8.5 {
            mover.face(m, 0.0, false)
            asked = core.v3_mul(right_ahead, 0.8)
        }
        mover.ask(m, asked)
        mover.step(m, STEP)
        pose.copy(r, animator.pose_now(a), before)
        engine.engine_update(e, STEP)
        if k > 0 {
            x = fastest_turn(r, before, animator.pose_now(a))
            if x > fastest {
                fastest = x
            }
        }
        playing = clips.name(animator.current_take(a))
        if k == (3.0 / STEP) as int {
            at_walk = playing
            v_walk = clips.root_delta(animator.current_take(a), animator.state_time(a), animator.state_time(a) + 0.5, clips.looping(animator.current_take(a)))
        }
        if k == (5.5 / STEP) as int {
            at_side = playing
            v_side = clips.root_delta(animator.current_take(a), animator.state_time(a), animator.state_time(a) + 0.5, clips.looping(animator.current_take(a)))
        }
        if k == (10.5 / STEP) as int {
            at_rest = playing
            v_rest = clips.root_delta(animator.current_take(a), animator.state_time(a), animator.state_time(a) + 0.5, clips.looping(animator.current_take(a)))
        }
        if !string_is(playing, last_take) {
            if string.contains(played, playing) != 1 { distinct = distinct + 1 }
            played = "${played} ${playing}"
            last_take = playing
        }
        pose.world(r, animator.pose_now(a), w)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(probe, r, w, side)
            planted = animator.contact_weight(a, side) > 0.99 && (animator.plant_weight(a, side) > 0.99 || was[side])
            if planted && !was[side] { from[side] = tip }
            if planted && k > 10 {
                d = flat_distance(tip, from[side])
                if d > worst { worst = d }
            }
            was[side] = planted
            side = side + 1
        }
        k = k + 1
    }
    changes = animator.matcher_changes(a, matcher)
    searches = animator.matcher_searches(a, matcher)
    println("  motion matching through a stand, a walk, a side step, a turn and a stop: ${searches} searches, ${changes} changes, ${distinct} takes played; a planted toe slid ${worst * 1000.0} mm at worst; the fastest joint turn ${fastest} rad/s, the takes' own ${own}")
    println("  playing ${at_walk} walking ahead (its root ${v_walk.x * 2.0}, ${v_walk.y * 2.0} m/s across and ahead over half a second), ${at_side} stepping to the left (${v_side.x * 2.0}, ${v_side.y * 2.0}), ${at_rest} at rest (${v_rest.x * 2.0}, ${v_rest.y * 2.0})")
    walking = v_walk.y * 2.0 > 0.5 && core.abs_of(v_walk.x * 2.0) < 0.3
    siding = v_side.x * 2.0 > 0.3 && core.abs_of(v_side.y * 2.0) < 0.3
    resting = core.sqrt_of(v_rest.x * v_rest.x + v_rest.y * v_rest.y) * 2.0 < 0.15
    check("a matcher driven by a mover plays what the way ahead asks: a frame going ahead at a walk while it walks, to the left while it steps left, still at rest", walking && siding && resting && changes > 3)
    mover.mover_free(m)
    ikrig.feet_free(probe)
    pose.release(w)
    pose.release(before)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- the graph: a state machine, cross-fades, poses held, aim offsets ------------------------------

// The fastest a joint turns in take `t` played alone, radians a second.
own_fastest(r: *pose.Rig, t: *Take) -> float {
    p = pose.new(r)
    q = pose.new(r)
    most = 0.0
    k = 0
    while k < (clips.duration(t) / STEP) as int {
        clips.sample(t, r, (k as float) * STEP, false, p)
        clips.sample(t, r, ((k + 1) as float) * STEP, false, q)
        x = fastest_turn(r, p, q)
        if x > most { most = x }
        k = k + 1
    }
    pose.release(p)
    pose.release(q)
    return most
}

// The Rigify mannequin on a graph a game drives by its parameters alone:
// idle, a gait blend bound to "speed", and a roll. Idle to the gaits above
// 0.25 m/s and back below 0.1, a roll from any state on its trigger, and
// out of it to the idle as it ends. The speed is raised to 3 m/s and
// lowered, and the roll triggered: the states come in that order, the
// trigger is spent, and no joint turns faster than the takes' own fastest.
state_machine() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle_t = animator.take(a, "Idle_Loop", false)
    idle = animator.add_state(a, "idle", idle_t, true)
    move = animator.add_blend(a, "move")
    names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    own = own_fastest(r, idle_t)
    k = 0
    while k < 3 {
        t = animator.take(a, names[k], false)
        animator.blend_add(a, move, t, clips.speed(t))
        x = own_fastest(r, t)
        if x > own { own = x }
        k = k + 1
    }
    roll_t = animator.take(a, "Roll", false)
    if roll_t == null { roll_t = animator.take(a, "Roll_RM", false) }
    roll = animator.add_state(a, "roll", roll_t, false)
    x = own_fastest(r, roll_t)
    if x > own { own = x }
    animator.bind(a, move, "speed")
    go = animator.add_transition(a, idle, move, 0.35)
    animator.transition_when(a, go, "speed", animator.ABOVE, 0.25)
    halt = animator.add_transition(a, move, idle, 0.4)
    animator.transition_when(a, halt, "speed", animator.BELOW, 0.1)
    dive = animator.add_transition(a, animator.ANY, roll, 0.2)
    animator.transition_when(a, dive, "roll", animator.TRIGGERED, 0.0)
    up = animator.add_transition(a, roll, idle, 0.3)
    animator.transition_when(a, up, "", animator.ENDED, 0.0)
    animator.play(a, idle, 0.0)
    seen = ""
    last_state = 0 - 1
    fastest = 0.0
    before = pose.new(r)
    seconds = 9.0 + clips.duration(roll_t)
    k = 0
    while k < (seconds / STEP) as int {
        now = (k as float) * STEP
        speed = 0.0
        if now > 0.5 && now < 4.5 { speed = 3.0 * (1.0 - core.abs_of(now - 2.5) / 2.0) }
        animator.set_float(a, "speed", speed)
        if k == (6.0 / STEP) as int { animator.trigger(a, "roll") }
        pose.copy(r, animator.pose_now(a), before)
        engine.engine_update(e, STEP)
        if k > 0 {
            x = fastest_turn(r, before, animator.pose_now(a))
            if x > fastest { fastest = x }
        }
        if animator.current(a) != last_state {
            last_state = animator.current(a)
            seen = "${seen} ${animator.state_name(a, last_state)}"
        }
        k = k + 1
    }
    println("  the graph driven by its parameters went:${seen}; its fastest joint turn ${fastest} rad/s, the takes' own ${own}; the trigger left at ${animator.float_param(a, "roll")}")
    check("a state machine driven by parameters alone goes idle, gaits, idle, roll, idle, and spends its trigger", string_is(seen, " idle move idle roll idle") && animator.float_param(a, "roll") == 0.0)
    check("and through every transition turns no joint faster than the takes' own fastest, plus 2%", fastest <= own * 1.02)
    pose.release(before)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// A cross-fade from the idle to the walk over 0.6 s: halfway through, the
// pose drawn is between the two states', as near the one as the other.
crossfade() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle_t = animator.take(a, "Idle_Loop", false)
    walk_t = animator.take(a, "Walk_Loop", false)
    idle = animator.add_state(a, "idle", idle_t, true)
    walk = animator.add_state(a, "walk", walk_t, true)
    over = animator.add_transition(a, idle, walk, 0.6)
    animator.transition_when(a, over, "go", animator.IS, 0.0)
    animator.transition_crossfade(a, over, true)
    animator.play(a, idle, 0.0)
    engine.engine_update(e, STEP)
    animator.set_bool(a, "go", true)
    k = 0
    while k < 18 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Where each state alone would be now.
    p = pose.new(r)
    q = pose.new(r)
    clips.sample(idle_t, r, 19.0 * STEP, true, p)
    clips.sample(walk_t, r, 18.0 * STEP, true, q)
    to_idle, _m1 = world_gap(r, animator.pose_now(a), p)
    to_walk, _m2 = world_gap(r, animator.pose_now(a), q)
    apart, _m3 = world_gap(r, p, q)
    println("  halfway through a 0.6 s cross-fade from the idle to the walk: ${to_idle * 57.29578} degrees from the idle at worst, ${to_walk * 57.29578} from the walk, the two ${apart * 57.29578} apart")
    check("halfway through a cross-fade the pose is between the two states', neither of them", to_idle < apart * 0.8 && to_walk < apart * 0.8 && to_idle > apart * 0.2 && to_walk > apart * 0.2)
    pose.release(p)
    pose.release(q)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// A pose held: the roll's pose half a second in, snapshot, played as a state
// for a second: drawn exactly as it was taken all that time.
held_pose() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    roll_t = animator.take(a, "Roll_RM", false)
    roll = animator.add_state(a, "roll", roll_t, false)
    animator.play(a, roll, 0.0)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    taken = pose.new(r)
    pose.copy(r, animator.pose_now(a), taken)
    held = animator.snapshot(a, "landed")
    animator.play(a, held, 0.0)
    worst = 0.0
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        turn, _move = world_gap(r, animator.pose_now(a), taken)
        if turn > worst { worst = turn }
        k = k + 1
    }
    println("  a pose held for a second: ${worst * 57.29578} degrees from the pose taken at worst")
    check("a pose snapshot played as a state is drawn as it was taken", worst < 0.0000001)
    pose.release(taken)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// An aim offset of the pistol's aims (down, level, up) over the spine of the
// idle: aimed level the pose is the idle's; aimed down, level and up, the
// right hand is lower, then higher.
aim_offset() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle = animator.add_state(a, "idle", animator.take(a, "Pistol_Idle_Loop", false), true)
    aim = animator.add_aim(a, pose.human(r, pose.SPINE_01))
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Neutral", false), 0.0, 0.0)
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Up", false), 0.0, 0.7)
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Down", false), 0.0, 0.0 - 0.7)
    animator.play(a, idle, 0.0)
    pitches = [0.0 - 0.7, 0.0, 0.7]
    heights = [0.0, 0.0, 0.0]
    level_gap = 0.0
    plain = pose.new(r)
    k = 0
    while k < 3 {
        animator.set_aim(a, aim, 0.0, pitches[k], 1.0)
        engine.engine_update(e, STEP)
        heights[k] = drawn(r, pose.human(r, pose.HAND_R)).y
        if k == 1 {
            clips.sample(animator.take(a, "Pistol_Idle_Loop", false), r, (2 as float) * STEP, true, plain)
            level_gap, _m = world_gap(r, animator.pose_now(a), plain)
        }
        k = k + 1
    }
    println("  the pistol's aim offset: the right hand at ${heights[0]}, ${heights[1]}, ${heights[2]} m aimed down, level and up; aimed level, ${level_gap * 57.29578} degrees off the idle's pose")
    check("an aim offset aimed level leaves the pose as it was, and aimed down and up lowers and raises the hand", level_gap < 0.0001 && heights[0] < heights[1] && heights[1] < heights[2])
    pose.release(plain)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- transitions --------------------------------------------------------------------------------

// The fastest any joint of `r` turns, radians a second, over `p` and `q`
// one step apart (local rotations: what a pop is, joint by joint).
fastest_turn(r: *pose.Rig, p: ptr, q: ptr) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        t = turned_by(pose.rotation(p, j), pose.rotation(q, j)) / STEP
        if t > most {
            most = t
            g_fastest_joint = j
        }
        j = j + 1
    }
    return most
}

transitions() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    names = ["Idle_Loop", "Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    states = [0, 0, 0, 0]
    // The takes' own fastest turn, each played alone.
    own = 0.0
    p = pose.new(r)
    q = pose.new(r)
    k = 0
    while k < 4 {
        t = animator.take(a, names[k], false)
        states[k] = animator.add_state(a, names[k], t, true)
        clips.sample(t, r, 0.0, true, p)
        n = 0
        while n < (clips.duration(t) / STEP) as int + 2 {
            clips.sample(t, r, ((n + 1) as float) * STEP, true, q)
            f = fastest_turn(r, p, q)
            if f > own { own = f }
            pose.copy(r, q, p)
            n = n + 1
        }
        k = k + 1
    }
    order = [0, 1, 2, 3, 2, 1, 0]
    animator.play(a, states[0], 0.0)
    worst = 0.0
    last = pose.new(r)
    engine.engine_update(e, STEP)
    pose.copy(r, animator.pose_now(a), last)
    step = 1
    while step < 7 {
        // Each change at a different moment of the gait it leaves; from gait to
        // gait in step, as a game hands them over, and the idle from its start.
        if order[step] == 0 || order[step - 1] == 0 {
            animator.play(a, states[order[step]], 0.3)
        } else {
            animator.play_synced(a, states[order[step]], 0.3)
        }
        n = 0
        while n < 50 + step * 7 {
            engine.engine_update(e, STEP)
            f = fastest_turn(r, last, animator.pose_now(a))
            if f > worst { worst = f }
            if core.env_int("TRACE_TURN", 0) == 1 && f > own { println("    TURN step ${step} frame ${n}: ${f} rad/s at ${pose.name(r, g_fastest_joint)}, to ${names[order[step]]}") }
            pose.copy(r, animator.pose_now(a), last)
            n = n + 1
        }
        step = step + 1
    }
    println("  idle, walk, jog, sprint and back down, in step from gait to gait, inertialized over 0.3 s: fastest joint turn ${worst} rad/s, the takes' own ${own}")
    check("idle to sprint and back down, inertialized, no joint turns faster than the takes' own fastest", worst <= own * 1.02)
    pose.release(p)
    pose.release(q)
    pose.release(last)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- handing a figure over (#859, #860) ---------------------------------------------------------

struct Freer {
    target: ptr                    // the *Animator to free
    calls: int
    at: int                        // the pose phase it frees it in
}

// A behaviour that frees an animator from inside the pose phase, on its
// `at`th call: a game freeing a figure in the middle of a frame.
freer_pose(state: ptr, e: *Engine) {
    f = state as *Freer
    f.calls = f.calls + 1
    if f.calls == f.at && f.target != null {
        animator.animator_free(f.target as *Animator)
        f.target = null
    }
}

// Three figures on their walks and, after the first in the engine's loop,
// a behaviour that frees the first one's animator in the pose phase. The
// animator leaves the loop, and the figures after it are each posed once in
// that frame: removed outright, the list shifted under the loop walking it,
// so the second figure went unposed for a frame and the third, read again
// past the list's end, was posed twice (and the animator, never removed,
// was called on freed memory; Siltreach, 2026-11-01).
freed_mid_frame() {
    e = fresh()
    o1 = figure.figure(e, "First", RIGIFY)
    a1 = animator.attach(e, o1)
    freer = Freer { target: a1 as ptr, calls: 0, at: 10 }
    b = engine.behaviour_new("freer", (&freer) as ptr)
    b.pose = freer_pose
    engine.engine_add_behaviour(e, b)
    o2 = figure.figure(e, "Second", RIGIFY)
    a2 = animator.attach(e, o2)
    o3 = figure.figure(e, "Third", RIGIFY)
    a3 = animator.attach(e, o3)
    animator.play(a1, animator.add_state(a1, "walk", animator.take(a1, "Walk_Loop", false), true), 0.0)
    animator.play(a2, animator.add_state(a2, "walk", animator.take(a2, "Walk_Loop", false), true), 0.0)
    animator.play(a3, animator.add_state(a3, "walk", animator.take(a3, "Walk_Loop", false), true), 0.0)
    engine.engine_update(e, STEP)
    before = engine.engine_behaviour_count(e)
    k = 0
    while k < 20 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    after = engine.engine_behaviour_count(e)
    // Each evaluation moves an animator's clock on a step: 21 frames, 21 steps.
    wanted = 21.0 * STEP
    second = animator.state_time(a2)
    third = animator.state_time(a3)
    println("  an animator freed inside the pose phase: the engine's behaviours ${before} then ${after}; the figures after it ${second / STEP} and ${third / STEP} frames on, of 21")
    check("an animator freed mid-frame leaves the engine's loop, and the figures after it are each posed once a frame", freer.target == null && after == before - 1 && core.abs_of(second - wanted) < STEP * 0.5 && core.abs_of(third - wanted) < STEP * 0.5)
    animator.animator_free(a2)
    animator.animator_free(a3)
    figure.figures_free(e)
    engine.engine_free(e)
}

// The fastest any joint of the walk or the idle turns, played on their own.
walk_idle_fastest(r: *pose.Rig, walk: *Take, idle: *Take) -> float {
    own = 0.0
    p = pose.new(r)
    q = pose.new(r)
    k = 0
    while k < 2 {
        t = walk
        if k == 1 { t = idle }
        clips.sample(t, r, 0.0, true, p)
        n = 0
        while n < (clips.duration(t) / STEP) as int + 2 {
            clips.sample(t, r, ((n + 1) as float) * STEP, true, q)
            f = fastest_turn(r, p, q)
            if f > own { own = f }
            pose.copy(r, q, p)
            n = n + 1
        }
        k = k + 1
    }
    pose.release(p)
    pose.release(q)
    return own
}

// The Rigify mannequin on its walk handed to another writer for a second,
// here one playing its idle into the joints itself, then taken back with
// resume over `seconds`. How far what stood while paused was from what that
// writer drew (radians), the fastest joint turn after it was taken back, the
// clips' own fastest, and the largest joint offset to ease out (radians).
resumed(seconds: float) -> (float, float, float, float) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    walk = animator.take(a, "Walk_Loop", false)
    idle = animator.take(a, "Idle_Loop", false)
    own = walk_idle_fastest(r, walk, idle)
    animator.play(a, animator.add_state(a, "walk", walk, true), 0.0)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    animator.pause(a)
    other = pose.new(r)
    seen = pose.new(r)
    held = 0.0
    k = 0
    while k < 60 {
        clips.sample(idle, r, (k as float) * STEP, true, other)
        pose.apply(r, other)
        engine.engine_update(e, STEP)
        pose.read(r, seen)
        j = 0
        while j < pose.count(r) {
            d = turned_by(pose.rotation(other, j), pose.rotation(seen, j))
            if d > held { held = d }
            j = j + 1
        }
        k = k + 1
    }
    // The largest offset the resume eases out: each joint from what was
    // drawn to where the walk is.
    target = pose.new(r)
    clips.sample(walk, r, animator.state_time(a), true, target)
    offset = 0.0
    j = 0
    while j < pose.count(r) {
        d = turned_by(pose.rotation(other, j), pose.rotation(target, j))
        if d > offset { offset = d }
        j = j + 1
    }
    pose.release(target)
    animator.resume(a, seconds)
    fastest = 0.0
    last = pose.new(r)
    now = pose.new(r)
    pose.copy(r, other, last)
    k = 0
    while k < 40 {
        engine.engine_update(e, STEP)
        pose.read(r, now)
        f = fastest_turn(r, last, now)
        if f > fastest { fastest = f }
        pose.copy(r, now, last)
        k = k + 1
    }
    pose.release(other)
    pose.release(seen)
    pose.release(last)
    pose.release(now)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return held, fastest, own, offset
}

// The figure handed to another writer and taken back (animator.pause and
// resume), as motion sits a settler down and stands it up: paused, the
// animator writes none of its joints; resumed over 0.3 s, its walk eases in
// from what the other writer drew, no joint turning faster than the clips'
// own fastest plus the easing's own (an offset x eased out over T on the
// quintic turns at 1.875 x / T at its fastest). Taken back at once, it snaps.
hand_off() {
    held, eased, own, offset = resumed(0.3)
    _held_at_once, snapped, _own_at_once, _offset_at_once = resumed(0.0)
    allowed = own + 1.875 * offset / 0.3
    println("  handed to another writer for 1 s: what stood was ${held * 57.29578} degrees off what it drew; taken back over 0.3 s from ${offset * 57.29578} degrees off the walk, the fastest joint turn ${eased} rad/s, at once ${snapped} (the clips' own ${own}, with the easing's ${allowed})")
    check("paused, the animator writes none of the figure's joints", held < 0.000001)
    check("taken back over 0.3 s, no joint turns faster than the clips' own fastest plus the easing's (taken back at once, it snaps)", eased <= allowed * 1.02 && snapped > allowed * 1.02)
}

// One take loaded once and shared by two figures on the same rig: both play
// it alike, it outlives both animators (its owner frees it), and a figure on
// a rig of another size is refused it.
shared_take() {
    e = fresh()
    o1 = figure.figure(e, "One", RIGIFY)
    o2 = figure.figure(e, "Two", RIGIFY)
    a1 = animator.attach(e, o1)
    a2 = animator.attach(e, o2)
    own_rig = pose.of_skeleton(figure.skeleton(figure.figure_of(o1)))
    walk = clips.from_scene(own_rig, figure.scene(figure.figure_of(o1)), "Walk_Loop", 0.0)
    animator.play(a1, animator.add_state(a1, "walk", animator.share_take(a1, walk, false), true), 0.0)
    animator.play(a2, animator.add_state(a2, "walk", animator.share_take(a2, walk, false), true), 0.0)
    k = 0
    while k < 20 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    apart = 0.0
    j = 0
    while j < pose.count(own_rig) {
        d = turned_by(pose.rotation(animator.pose_now(a1), j), pose.rotation(animator.pose_now(a2), j))
        if d > apart { apart = d }
        j = j + 1
    }
    other = figure.figure(e, "Other", MANNEQUIN)
    ao = animator.attach(e, other)
    refused = ao != null && pose.count(animator.rig(ao)) != pose.count(own_rig) && animator.share_take(ao, walk, false) == null
    animator.animator_free(a1)
    animator.animator_free(a2)
    animator.animator_free(ao)
    p = pose.new(own_rig)
    clips.sample(walk, own_rig, 0.5, true, p)
    outlived = clips.frames(walk) > 1 && pose.rotation(p, pose.human(own_rig, pose.THIGH_L)).w != 0.0
    println("  one walk shared by two figures: their joints ${apart * 57.29578} degrees apart at most; it outlived both animators: ${outlived}; refused to a rig of another size: ${refused}")
    check("a shared take plays alike on two figures, outlives their animators, and is refused to a rig of another size", apart < 0.000001 && outlived && refused)
    pose.release(p)
    clips.take_free(walk)
    pose.rig_free(own_rig)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- layers -------------------------------------------------------------------------------------

layers() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    walk = animator.take(a, "Walk_Loop", false)
    s = animator.add_state(a, "walk", walk, true)
    aim = animator.add_layer(a, animator.take(a, "Pistol_Aim_Neutral", false), pose.human(r, pose.SPINE_01), false, true)
    animator.play(a, s, 0.0)
    animator.layer_weight(a, aim, 1.0, 0.0)
    alone = pose.new(r)
    legs_same = true
    arm_moved = 0.0
    legs = [pose.THIGH_L, pose.CALF_L, pose.FOOT_L, pose.THIGH_R, pose.CALF_R, pose.FOOT_R]
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        clips.sample(walk, r, animator.state_time(a), true, alone)
        m = 0
        while m < 6 {
            j = pose.human(r, legs[m])
            if turned_by(pose.rotation(alone, j), pose.rotation(animator.pose_now(a), j)) > 0.000001 { legs_same = false }
            m = m + 1
        }
        arm = pose.human(r, pose.UPPERARM_R)
        t = turned_by(pose.rotation(alone, arm), pose.rotation(animator.pose_now(a), arm))
        if t > arm_moved { arm_moved = t }
        k = k + 1
    }
    println("  the pistol aim over the walk turned the right upper arm ${arm_moved * 57.29578} degrees off the walk's at most")
    check("an upper body aiming over the walk leaves the legs exactly the walk's", legs_same)
    check("and turns the arm (more than 10 degrees off the walk's)", arm_moved > 0.1745)
    pose.release(alone)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    // A hit added over the idle.
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle = animator.take(a, "Idle_Loop", false)
    s = animator.add_state(a, "idle", idle, true)
    hit = animator.add_layer(a, animator.take(a, "Hit_Chest", false), 0 - 1, true, false)
    animator.play(a, s, 0.0)
    animator.layer_weight(a, hit, 1.0, 0.0)
    alone = pose.new(r)
    engine.engine_update(e, 0.0)
    clips.sample(idle, r, animator.state_time(a), true, alone)
    chest = pose.human(r, pose.SPINE_03)
    first = turned_by(pose.rotation(alone, chest), pose.rotation(animator.pose_now(a), chest))
    most = 0.0
    k = 0
    while k < 20 {
        engine.engine_update(e, STEP)
        clips.sample(idle, r, animator.state_time(a), true, alone)
        t = turned_by(pose.rotation(alone, chest), pose.rotation(animator.pose_now(a), chest))
        if t > most { most = t }
        k = k + 1
    }
    println("  the chest hit added over the idle: ${first * 57.29578} degrees at its start, ${most * 57.29578} at most")
    check("a hit added over the idle starts as the idle (under 0.01 degree) and turns the chest (over 2 degrees)", first < 0.000175 && most > 0.0349)
    pose.release(alone)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- root motion --------------------------------------------------------------------------------

root_motion() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    roll = animator.take(a, "Roll_RM", true)
    s = animator.add_state(a, "roll", roll, false)
    animator.set_root_motion(a, true)
    animator.play(a, s, 0.0)
    start = behaviour.object_position(o)
    k = 0
    while k < (clips.duration(roll) / STEP) as int + 10 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    end = behaviour.object_position(o)
    went = core.v3_len(core.vec3(end.x - start.x, 0.0, end.z - start.z))
    own = clips.travel(roll, clips.duration(roll))
    should = core.sqrt_of(own.x * own.x + own.y * own.y)
    println("  the roll with root motion carried the figure ${went} m of its root's ${should}")
    check("the roll played with root motion carries the figure its root's travel, within 1%", core.abs_of(went - should) < should * 0.01)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- feet ---------------------------------------------------------------------------------------

feet_on_block() {
    e = fresh()
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    engine.engine_update(e, STEP)
    // The left foot's place, and a block 10 cm high under it alone.
    left = drawn(r, pose.human(r, pose.FOOT_L))
    right = drawn(r, pose.human(r, pose.FOOT_R))
    sole_l = drawn(r, pose.human(r, pose.BALL_L)).y
    sole_r = drawn(r, pose.human(r, pose.BALL_R)).y
    side = core.v3_sub(left, right)
    middle = core.v3_mul(core.v3_add(left, right), 0.5)
    block_at = core.v3_add(middle, core.v3_mul(side, 0.75))
    block = engine.object(e, "Block", loader.cube(1.0))
    behaviour.object_set_position(block, core.vec3(block_at.x, 0.05, block_at.z))
    physics.box_collider(block, core.vec3(core.v3_len(side) * 0.5, 0.05, 0.25), physics.material(0.8, 0.0))
    f = ikrig.feet_new(r, o)
    ikrig.feet_ground_physics(f, physics.of(e))
    animator.set_feet(a, f)
    last = pose.new(r)
    pose.copy(r, animator.pose_now(a), last)
    worst = 0.0
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        t = fastest_turn(r, last, animator.pose_now(a)) * STEP
        if t > worst { worst = t }
        pose.copy(r, animator.pose_now(a), last)
        k = k + 1
    }
    up_l = drawn(r, pose.human(r, pose.BALL_L)).y - sole_l
    up_r = drawn(r, pose.human(r, pose.BALL_R)).y - sole_r
    println("  over a 10 cm block: the left sole rose ${up_l * 1000.0} mm, the right ${up_r * 1000.0} mm; the fastest joint turn getting there ${worst * 57.29578} degrees a step")
    check("one foot over a 10 cm block comes onto it (its sole within 5 mm of the block's top), the other on the floor", core.abs_of(up_l - 0.1) < 0.005 && core.abs_of(up_r) < 0.005)
    check("and no joint turns faster than 6 degrees a step getting there", worst < 0.10472)
    pose.release(last)
    animator.animator_free(a)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- hands --------------------------------------------------------------------------------------

// Walking with a bowl held in both hands (#842): the bowl 32 cm in front of
// the figure at its belly, each hand on a rim 13 cm off the middle. Once the
// hands have come on, each is within 5 mm of its grip every frame, and
// neither elbow locks straight (under 172 degrees) or folds shut (over 25).
carry_bowl() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    walk = animator.take(a, "Walk_Loop", false)
    s = animator.add_state(a, "walk", walk, true)
    animator.play(a, s, 0.0)
    h = ikrig.hands_new(r)
    animator.set_hands(a, h)
    animator.set_feet(a, ikrig.feet_new(r, o))
    ahead = clips.heading(walk)
    side = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead)
    w = pose.new(r)
    pose.rest_world(r, w)
    belly = clips.ground_point(r, pose.translation(w, pose.human(r, pose.SPINE_01))).y
    pose.release(w)
    hands = [pose.human(r, pose.HAND_L), pose.human(r, pose.HAND_R)]
    uppers = [pose.human(r, pose.UPPERARM_L), pose.human(r, pose.UPPERARM_R)]
    fores = [pose.human(r, pose.LOWERARM_L), pose.human(r, pose.LOWERARM_R)]
    sides = [1.0, 0.0 - 1.0]
    worst_off = 0.0
    straightest = 0.0
    shut = 3.1416
    at = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 180 {
        at = core.v3_add(at, core.v3_mul(ahead, clips.speed(walk) * STEP))
        behaviour.object_set_position(o, at)
        middle = core.v3_add(core.v3_add(at, core.v3_mul(ahead, 0.32)), core.vec3(0.0, belly, 0.0))
        g = 0
        while g < 2 {
            ikrig.hands_set(h, g, core.v3_add(middle, core.v3_mul(side, 0.13 * sides[g])), 1.0)
            g = g + 1
        }
        engine.engine_update(e, STEP)
        if k >= 40 {
            g = 0
            while g < 2 {
                grip = core.v3_add(middle, core.v3_mul(side, 0.13 * sides[g]))
                off = core.v3_len(core.v3_sub(drawn(r, hands[g]), grip))
                if off > worst_off { worst_off = off }
                sh = drawn(r, uppers[g])
                el = drawn(r, fores[g])
                wr = drawn(r, hands[g])
                bend = core.acos_of(core.clampf(core.v3_dot(core.v3_normalize(core.v3_sub(sh, el)), core.v3_normalize(core.v3_sub(wr, el))), 0.0 - 1.0, 1.0))
                if bend > straightest { straightest = bend }
                if bend < shut { shut = bend }
                g = g + 1
            }
        }
        k = k + 1
    }
    println("  walking with a bowl: each hand at worst ${worst_off * 1000.0} mm off its grip; the elbows between ${shut * 57.29578} and ${straightest * 57.29578} degrees")
    check("walking with a bowl in both hands, each hand within 5 mm of its grip every frame", worst_off < 0.005)
    check("and no elbow locks straight (under 172 degrees) or folds shut (over 25)", straightest < 3.0 && shut > 0.4363)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- look ---------------------------------------------------------------------------------------

look() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    engine.engine_update(e, STEP)
    head = pose.human(r, pose.HEAD)
    at = drawn(r, head)
    ahead = forward_of(r)
    side = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead)
    // 60 degrees off to the side, two metres away, at the head's height.
    to = core.v3_add(core.v3_mul(ahead, 0.5), core.v3_mul(side, 0.8660254))
    point = core.v3_add(at, core.v3_mul(to, 2.0))
    before = pose.joint(r, head).world_rotation
    animator.look_at(a, point, 1.0)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    m = pose.joint(r, head)
    core.model_sync_transform(m)
    turned = turned_by(before, m.world_rotation)
    println("  looking 60 degrees off to the side: the head turned ${turned * 57.29578} degrees")
    check("the head turns toward a point 60 degrees to the side more than half way, and no further than 70 degrees", turned > 0.5236 && turned < 1.2217)
    // And where it points: its forward at rest (level, heels to toes) as it
    // now stands, against the way to the point. Held to how far it turned
    // alone, a head looking 30 degrees over every point passed.
    w = pose.new(r)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    pose.world(r, animator.pose_now(a), w)
    axis = core.quat_apply(core.quat_conjugate(pose.rotation(rest, head)), ikrig.dir_to_rig(r, ahead))
    face = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(pose.rotation(w, head), axis)))
    want = core.v3_normalize(core.v3_sub(point, ikrig.to_ground(r, pose.translation(w, head))))
    off = core.acos_of(core.clampf(core.v3_dot(face, want), 0.0 - 1.0, 1.0))
    println("  and faces ${off * 57.29578} degrees off the point")
    check("and faces the point: the head's forward within 2 degrees of the way to it", off < 0.0349)
    pose.release(w)
    pose.release(rest)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

main() {
    println("anim_pipeline: rigs, takes, locomotion, transitions, layers, root motion, feet and look on the Quaternius mannequins (#853)")
    rigs()
    takes()
    mirroring()
    events()
    locomotion()
    retargeting()
    capture()
    blend_space_2d()
    state_machine()
    crossfade()
    held_pose()
    aim_offset()
    starts_and_stops()
    turn_on_the_spot()
    motion_matching()
    transitions()
    freed_mid_frame()
    hand_off()
    shared_take()
    layers()
    root_motion()
    capsule_root_motion()
    loop_seams()
    sampling_cost()
    feet_on_block()
    carry_bowl()
    look()
    if g_failures > 0 {
        println("anim_pipeline: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("anim_pipeline: all checks passed (${g_checks})")
}
