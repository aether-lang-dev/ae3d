// Several cameras: a view is a camera drawn into a texture (#866).
//
// Two spheres stand apart, a red one and a blue one. A view looks at each,
// from its own place and at its own size; what it draws is read back, and
// shown on a quad in the frame the window's camera draws, where a material
// samples it. The things a second camera must keep apart from the first are
// checked as a frame is: a view that is the window's camera is the window's
// frame; the window's frame is the frame it was after a view has been drawn
// between two of them; and a view that is not drawn this frame is a texture
// that is not there.

import std.mem
import std.os
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader

const WIDTH = 160
const HEIGHT = 120
const VIEW_W = 64
const VIEW_H = 48

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(to: ptr, from: ptr, bytes: int) -> ptr
extern exit(code: int)

var g_failures = 0

check(name: string, condition: bool) {
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

channel(pixels: ptr, width: int, x: int, y: int, c: int) -> int {
    return mem.get_byte(pixels, (y * width + x) * 4 + c)
}

// How far the mean of the middle of a picture leans to red or to blue:
// red minus blue over its middle fifth.
lean(pixels: ptr, width: int, height: int) -> int {
    total = 0
    n = 0
    y = height * 2 / 5
    while y < height * 3 / 5 {
        x = width * 2 / 5
        while x < width * 3 / 5 {
            total = total + channel(pixels, width, x, y, 0) - channel(pixels, width, x, y, 2)
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return total / n
}

lean_at(pixels: ptr, width: int, x: int, y: int) -> int {
    return channel(pixels, width, x, y, 0) - channel(pixels, width, x, y, 2)
}

lit_pixels(pixels: ptr, width: int, height: int) -> int {
    count = 0
    i = 0
    while i < width * height {
        if mem.get_byte(pixels, i * 4) > 6 || mem.get_byte(pixels, i * 4 + 2) > 6 { count = count + 1 }
        i = i + 1
    }
    return count
}

differing(a: ptr, b: ptr, bytes: int) -> int {
    count = 0
    i = 0
    while i < bytes {
        d = mem.get_byte(a, i) - mem.get_byte(b, i)
        if d < 0 { d = 0 - d }
        if d > 1 { count = count + 1 }
        i = i + 1
    }
    return count
}

look(cam: *Camera, ex: float, ey: float, ez: float, tx: float, ty: float, tz: float) {
    core.camera_set_position(cam, core.vec3(ex, ey, ez))
    core.camera_look_at(cam, core.vec3(tx, ty, tz))
}

// A quad a metre and a half wide facing +z, centred at (x, y, z), shown by
// the texture `id` the backend holds.
screen_quad(x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 1.0, 0.0 - 0.75, 0.0), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(1.0, 0.0 - 0.75, 0.0), 1.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(1.0, 0.75, 0.0), 1.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 1.0, 0.75, 0.0), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_set_position(m, x, y, z)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// The window's frame: what this backend's last render drew.
struct Frame {
    read: fn() -> ptr
}

run_checks(pass: *Backend, name: string, frame: fn() -> ptr, taa: fn(bool), capture: fn(int), dof: fn(bool)) {
    core.backend_set_clear_color(pass, 0.0, 0.0, 0.0)
    main_cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_aspect(main_cam, (WIDTH * 1.0) / (HEIGHT * 1.0))
    look(main_cam, 3.0, 2.0, 11.0, 3.0, 1.0, 0.0)
    view_cam = core.camera_new(VIEW_W, VIEW_H)
    core.camera_set_aspect(view_cam, (VIEW_W * 1.0) / (VIEW_H * 1.0))
    light = core.light_directional(core.vec3(0.2, 0.4, 1.0), core.vec3(1.0, 1.0, 1.0), 1.0)

    red = loader.sphere(1.0, 24, 18)
    core.model_set_position(red, 0.0, 1.0, 0.0)
    core.model_set_diffuse(red, 0.9, 0.1, 0.1)
    core.backend_add_model(pass, red)
    blue = loader.sphere(1.0, 24, 18)
    core.model_set_position(blue, 6.0, 1.0, 0.0)
    core.model_set_diffuse(blue, 0.1, 0.2, 0.9)
    core.backend_add_model(pass, blue)

    // Made, and not made.
    nothing = core.backend_view_new(pass, 0, 0)
    check("${name}: a view of no size is no view", nothing == 0)
    a = core.backend_view_new(pass, VIEW_W, VIEW_H)
    b = core.backend_view_new(pass, VIEW_W / 2, VIEW_H / 2)
    check("${name}: two views are made (${a}, ${b})", a > 0 && b > 0 && a != b)
    check("${name}: each is a texture a material can name (${core.backend_view_texture(pass, a)}, ${core.backend_view_texture(pass, b)})",
          core.backend_view_texture(pass, a) > 0 && core.backend_view_texture(pass, b) > 0 &&
          core.backend_view_texture(pass, a) != core.backend_view_texture(pass, b))
    check("${name}: a view that is not has none", core.backend_view_texture(pass, 99) == 0 && core.backend_view_pixels(pass, 99) == null)

    // Each looks at its sphere and draws it.
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    red_view = calloc(VIEW_W * VIEW_H, 4)
    memcpy(red_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4)
    look(view_cam, 6.0, 1.0, 5.0, 6.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    blue_view = calloc(VIEW_W * VIEW_H, 4)
    memcpy(blue_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4)
    println("  ${name}: the view looking at the red sphere leans ${lean(red_view, VIEW_W, VIEW_H)}, at the blue ${lean(blue_view, VIEW_W, VIEW_H)}")
    check("${name}: the view looking at the red sphere is red", lean(red_view, VIEW_W, VIEW_H) > 40)
    check("${name}: and looking at the blue one it is blue", lean(blue_view, VIEW_W, VIEW_H) < 0 - 40)
    check("${name}: the sphere is part of the picture, not all of it", lit_pixels(red_view, VIEW_W, VIEW_H) > VIEW_W * VIEW_H / 20 &&
          lit_pixels(red_view, VIEW_W, VIEW_H) < VIEW_W * VIEW_H * 3 / 4)

    // A view not drawn is not there: the other, never rendered, is black.
    unseen = core.backend_view_pixels(pass, b)
    check("${name}: control: a view never drawn has nothing in it (${lit_pixels(unseen, VIEW_W / 2, VIEW_H / 2)} lit)",
          unseen == null || lit_pixels(unseen, VIEW_W / 2, VIEW_H / 2) == 0)

    // The window's frame, alone.
    core.backend_render(pass, main_cam, light)
    core.backend_render(pass, main_cam, light)
    alone = calloc(WIDTH * HEIGHT, 4)
    memcpy(alone, frame(), WIDTH * HEIGHT * 4)

    // A view the shape of the window, from the window's camera, is the window's frame.
    big = core.backend_view_new(pass, WIDTH, HEIGHT)
    core.backend_view_render(pass, big, main_cam, light)
    twin = core.backend_view_pixels(pass, big)
    check("${name}: a view from the window's camera, at its size, is the window's frame (${differing(alone, twin, WIDTH * HEIGHT * 4)} bytes differ)",
          twin != null && differing(alone, twin, WIDTH * HEIGHT * 4) <= WIDTH * HEIGHT / 100)

    // And drawing views between two window frames leaves the second what it was.
    core.backend_view_render(pass, a, view_cam, light)
    core.backend_view_render(pass, b, view_cam, light)
    core.backend_render(pass, main_cam, light)
    check("${name}: the window's frame after views is the window's frame before them (${differing(alone, frame(), WIDTH * HEIGHT * 4)} bytes differ)",
          differing(alone, frame(), WIDTH * HEIGHT * 4) == 0)
    core.backend_view_free(pass, big)

    // A quad in the window's frame shows the view: its material names the texture.
    quad = screen_quad(3.0, 2.0, 4.0)
    core.model_set_diffuse(quad, 1.0, 1.0, 1.0)
    core.material_set_texture_id(quad.material, core.backend_view_texture(pass, a))
    core.backend_add_model(pass, quad)
    qx = core.camera_world_to_screen(main_cam, core.vec3(3.0, 2.0, 4.0), WIDTH, HEIGHT)
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    core.backend_render(pass, main_cam, light)
    shown_red = frame()
    centre_x = qx.x as int
    centre_y = qx.y as int
    red_on_quad = channel(shown_red, WIDTH, centre_x, centre_y, 0) - channel(shown_red, WIDTH, centre_x, centre_y, 2)
    look(view_cam, 6.0, 1.0, 5.0, 6.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    core.backend_render(pass, main_cam, light)
    blue_on_quad = channel(frame(), WIDTH, centre_x, centre_y, 0) - channel(frame(), WIDTH, centre_x, centre_y, 2)
    println("  ${name}: on the quad, the view of the red sphere leans ${red_on_quad}, of the blue ${blue_on_quad}")
    check("${name}: a material shows the view: red when it looks at the red sphere", red_on_quad > 40)
    check("${name}: and blue when it looks at the blue one", blue_on_quad < 0 - 40)

    // A rectangle of the frame shows a view: one the view's own size, 1:1, is
    // the view's pixels -- picture-in-picture -- and the rest of the frame is
    // the window's, untouched.
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    core.backend_remove_model(pass, quad)
    core.backend_render(pass, main_cam, light)
    plain = calloc(WIDTH * HEIGHT, 4)
    memcpy(plain, frame(), WIDTH * HEIGHT * 4)
    pip_x = 12
    pip_y = 9
    check("${name}: a rectangle is taken", core.backend_view_blit(pass, a, pip_x, pip_y, VIEW_W, VIEW_H))
    check("${name}: a view that is not has no rectangle", !core.backend_view_blit(pass, 99, 0, 0, 10, 10))
    core.backend_render(pass, main_cam, light)
    shown = calloc(WIDTH * HEIGHT, 4)
    memcpy(shown, frame(), WIDTH * HEIGHT * 4)
    inside = 0
    outside = 0
    seen = core.backend_view_pixels(pass, a)
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            in_rect = x >= pip_x && x < pip_x + VIEW_W && y >= pip_y && y < pip_y + VIEW_H
            c = 0
            while c < 3 {
                got = channel(shown, WIDTH, x, y, c)
                if in_rect {
                    d = got - channel(seen, VIEW_W, x - pip_x, y - pip_y, c)
                    if d < 0 { d = 0 - d }
                    if d > 1 { inside = inside + 1 }
                } else {
                    d = got - channel(plain, WIDTH, x, y, c)
                    if d < 0 { d = 0 - d }
                    if d > 0 { outside = outside + 1 }
                }
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    println("  ${name}: the rectangle differs from the view in ${inside} channels, the rest of the frame from the window's in ${outside}")
    check("${name}: the rectangle is the view's pixels, one for one", inside <= VIEW_W * VIEW_H / 50)
    check("${name}: and the rest of the frame is the window's", outside == 0)
    // Not asked again, it is gone: the next frame is the window's.
    core.backend_render(pass, main_cam, light)
    check("${name}: control: a rectangle not asked for again is not drawn", differing(plain, frame(), WIDTH * HEIGHT * 4) == 0)

    // Halves of a split screen: each half is its view, red and blue.
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    look(view_cam, 6.0, 1.0, 5.0, 6.0, 1.0, 0.0)
    core.backend_view_render(pass, b, view_cam, light)
    core.backend_view_blit(pass, a, 0, 0, WIDTH / 2, HEIGHT)
    core.backend_view_blit(pass, b, WIDTH / 2, 0, WIDTH / 2, HEIGHT)
    core.backend_render(pass, main_cam, light)
    left = lean_at(frame(), WIDTH, WIDTH / 4, HEIGHT / 2)
    right = lean_at(frame(), WIDTH, WIDTH * 3 / 4, HEIGHT / 2)
    println("  ${name}: split screen: the left half leans ${left}, the right ${right}")
    check("${name}: a split screen shows one view a side", left > 40 && right < 0 - 40)

    // A view's exposure is its own: dimmer, the picture is dimmer and the
    // window's frame is what it was.
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_set_exposure(pass, a, 0.25)
    core.backend_view_render(pass, a, view_cam, light)
    dim = lean(core.backend_view_pixels(pass, a), VIEW_W, VIEW_H)
    core.backend_render(pass, main_cam, light)
    check("${name}: a view at a quarter of the exposure is dimmer (${dim} against ${lean(red_view, VIEW_W, VIEW_H)})",
          dim > 0 && dim * 2 < lean(red_view, VIEW_W, VIEW_H))
    check("${name}: and the window's frame is the same (${differing(plain, frame(), WIDTH * HEIGHT * 4)} bytes differ)",
          differing(plain, frame(), WIDTH * HEIGHT * 4) == 0)
    core.backend_view_set_exposure(pass, a, 1.0)

    // The temporal pass keeps a history a view: one drawn beside a moving
    // window, as often as the window, ends where one drawn alone does.
    taa(true)
    solo = core.backend_view_new(pass, VIEW_W, VIEW_H)
    beside = core.backend_view_new(pass, VIEW_W, VIEW_H)
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    first = calloc(VIEW_W * VIEW_H, 4)
    n = 0
    while n < 6 {
        core.backend_view_render(pass, solo, view_cam, light)
        if n == 0 { memcpy(first, core.backend_view_pixels(pass, solo), VIEW_W * VIEW_H * 4) }
        n = n + 1
    }
    alone_view = calloc(VIEW_W * VIEW_H, 4)
    memcpy(alone_view, core.backend_view_pixels(pass, solo), VIEW_W * VIEW_H * 4)
    n = 0
    while n < 6 {
        look(main_cam, 3.0 + n * 0.7, 2.0, 11.0 - n * 0.5, 3.0, 1.0, 0.0)
        core.backend_render(pass, main_cam, light)
        core.backend_view_render(pass, beside, view_cam, light)
        n = n + 1
    }
    together = core.backend_view_pixels(pass, beside)
    println("  ${name}: the history after six frames: alone and beside a moving window differ in ${differing(alone_view, together, VIEW_W * VIEW_H * 4)} bytes, the first frame and the sixth in ${differing(first, alone_view, VIEW_W * VIEW_H * 4)}")
    check("${name}: control: the temporal pass is at work (the sixth frame is not the first)", differing(first, alone_view, VIEW_W * VIEW_H * 4) > 4)
    check("${name}: a view's history is its own: beside a moving window it ends where it does alone", differing(alone_view, together, VIEW_W * VIEW_H * 4) == 0)
    taa(false)
    free(first)
    free(alone_view)
    core.backend_view_free(pass, solo)
    core.backend_view_free(pass, beside)

    // Depth of field (#870) is the scene's setting, and a view draws with it
    // over its own camera's depth: the red sphere, 4 from the view's lens,
    // is blurred when the focus is at 40, the view is not the sharp one, and
    // the window's frame beside it, drawn with the same setting, is the same
    // with a view drawn before it as without (the targets are each its own).
    look(view_cam, 0.0, 1.0, 5.0, 0.0, 1.0, 0.0)
    core.backend_view_render(pass, a, view_cam, light)
    sharp_view = calloc(VIEW_W * VIEW_H, 4)
    memcpy(sharp_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4)
    dof(true)
    core.backend_render(pass, main_cam, light)
    core.backend_render(pass, main_cam, light)
    dof_alone = calloc(WIDTH * HEIGHT, 4)
    memcpy(dof_alone, frame(), WIDTH * HEIGHT * 4)
    core.backend_view_render(pass, a, view_cam, light)
    blurred_view = calloc(VIEW_W * VIEW_H, 4)
    memcpy(blurred_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4)
    core.backend_render(pass, main_cam, light)
    core.backend_render(pass, main_cam, light)
    println("  ${name}: depth of field: the view differs from the sharp one in ${differing(sharp_view, blurred_view, VIEW_W * VIEW_H * 4)} bytes; the window's frame with a view drawn before it differs from the one without in ${differing(dof_alone, frame(), WIDTH * HEIGHT * 4)}")
    check("${name}: a view takes the scene's depth of field (it is not the sharp view)", differing(sharp_view, blurred_view, VIEW_W * VIEW_H * 4) > 100)
    check("${name}: and the window's frame is the same with a view drawn before it", differing(dof_alone, frame(), WIDTH * HEIGHT * 4) == 0)
    dof(false)
    core.backend_view_render(pass, a, view_cam, light)
    check("${name}: control: off again, the view is the sharp one (${differing(sharp_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4)} bytes differ)",
          differing(sharp_view, core.backend_view_pixels(pass, a), VIEW_W * VIEW_H * 4) == 0)
    free(sharp_view)
    free(blurred_view)
    free(dof_alone)

    // A view does not close the window's frame: what moves is moved a step in
    // the window's motion vectors (capture channel 3 shows them as colour),
    // whatever was drawn between two window frames. A sphere steps, the frame
    // after its step drawn alone and with a view drawn before it: the same.
    capture(3)
    moving = loader.sphere(0.6, 20, 14)
    core.model_set_diffuse(moving, 0.9, 0.9, 0.2)
    core.backend_add_model(pass, moving)
    look(main_cam, 3.0, 2.0, 11.0, 3.0, 1.0, 0.0)
    step_alone = calloc(WIDTH * HEIGHT, 4)
    step_beside = calloc(WIDTH * HEIGHT, 4)
    twice = 0
    while twice < 2 {
        core.model_set_position(moving, 1.0, 1.0, 2.0)
        core.backend_render(pass, main_cam, light)
        core.model_set_position(moving, 1.8, 1.0, 2.0)
        if twice == 1 { core.backend_view_render(pass, a, view_cam, light) }
        core.backend_render(pass, main_cam, light)
        if twice == 0 { memcpy(step_alone, frame(), WIDTH * HEIGHT * 4) }
        if twice == 1 { memcpy(step_beside, frame(), WIDTH * HEIGHT * 4) }
        twice = twice + 1
    }
    nonzero = 0
    i = 0
    while i < WIDTH * HEIGHT {
        if mem.get_byte(step_alone, i * 4) != mem.get_byte(step_alone, i * 4 + 1) || mem.get_byte(step_alone, i * 4 + 2) > 2 { nonzero = nonzero + 1 }
        i = i + 1
    }
    println("  ${name}: the motion channel of a sphere's step: ${nonzero} pixels carry motion; alone and beside a view they differ in ${differing(step_alone, step_beside, WIDTH * HEIGHT * 4)} bytes")
    check("${name}: control: the sphere's step shows in the motion channel", nonzero > 40)
    check("${name}: a view drawn before the frame leaves the window's motion as it was", differing(step_alone, step_beside, WIDTH * HEIGHT * 4) == 0)
    capture(0)
    core.backend_remove_model(pass, moving)
    core.model_free(moving)
    free(step_alone)
    free(step_beside)
    free(plain)
    free(shown)

    core.model_free(quad)
    core.backend_view_free(pass, a)
    core.backend_view_free(pass, b)
    check("${name}: a view freed is no texture", core.backend_view_texture(pass, a) == 0)
    free(alone)
    free(red_view)
    free(blue_view)
    core.backend_remove_model(pass, red)
    core.backend_remove_model(pass, blue)
    core.model_free(red)
    core.model_free(blue)
    core.camera_free(main_cam)
    core.camera_free(view_cam)
    core.light_free(light)
}

var g_gl_target: ptr = null

var g_gl_renderer: ptr = null
var g_vk_renderer: ptr = null

gl_frame() -> ptr { return offscreen.target_pixels(g_gl_target as *Target) }
vk_frame() -> ptr { return vulkan.offscreen_pixels() }
gl_taa(on: bool) { gl.renderer_set_taa(g_gl_renderer as *GLRenderer, on) }
vk_taa(on: bool) { vulkan.renderer_set_taa(g_vk_renderer as *VKRenderer, on) }
gl_channel(c: int) { gl.renderer_set_capture_channel(g_gl_renderer as *GLRenderer, c) }
vk_channel(c: int) { vulkan.renderer_set_capture_channel(g_vk_renderer as *VKRenderer, c) }
gl_dof(on: bool) { gl.renderer_set_dof(g_gl_renderer as *GLRenderer, on, 40.0, 300.0, 600.0) }
vk_dof(on: bool) { vulkan.renderer_set_dof(g_vk_renderer as *VKRenderer, on, 40.0, 300.0, 600.0) }

main() {
    // AE3D_TEST_API=vulkan or opengl draws with that renderer alone.
    only = os.getenv("AE3D_TEST_API")
    context = null
    if only != "vulkan" { context = offscreen.context_create(WIDTH, HEIGHT) }
    if context == null && only != "vulkan" {
        println("view: SKIP no OpenGL context")
    }
    if context != null {
        renderer = gl.renderer_new()
        gl_pass = gl.backend(renderer)
        if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
            println("view: SKIP the OpenGL backend would not initialise")
        } else {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            g_gl_target = target as ptr
            g_gl_renderer = renderer as ptr
            run_checks(&gl_pass, "opengl", gl_frame, gl_taa, gl_channel, gl_dof)
            core.backend_cleanup(&gl_pass)
            offscreen.target_destroy(target)
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }

    if only == "opengl" {
        println("view: Vulkan not asked for")
    } else if !vulkan.available() {
        println("view: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vulkan.renderer_new()
        vk_pass = vulkan.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("view: SKIP Vulkan would not start (${vulkan.last_error()})")
        } else {
            g_vk_renderer = vk_renderer as ptr
            run_checks(&vk_pass, "vulkan", vk_frame, vk_taa, vk_channel, vk_dof)
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    }

    if g_failures == 0 {
        println("view: all checks passed")
    } else {
        println("view: ${g_failures} failure(s)")
        exit(1)
    }
}
