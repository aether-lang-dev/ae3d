// A rifle held as a person holds one (#1010), on the engine's own hold
// (ae3d.items: tests/fixtures/items/rifle.item, an M4's measures): the UE5
// mannequin made a person (ae3d.character, on 100STYLE's gaits), the rifle
// held in both hands, aimed (items.aim) at a point that sweeps 35 degrees
// either way and rises and falls before it, then held at the low ready, the
// high ready, and aimed again (items.ready). No window; stepped at 60 Hz.
//
// Held to a person shouldering a rifle (the bounds from how one stands at
// the ready and aiming: Army FM 3-22.9's firing positions, Lyra's and GTA's
// rifle poses), from a second into each part:
//
//   - its butt within 3 cm of the shoulder pocket (on the trigger side,
//     inside the shoulder's joint by a quarter of the way to the other, 5 cm
//     ahead of it), aimed and at either ready;
//   - aimed, the eye on that side within 2 cm of the sight line (the cheek
//     on the stock), the sight line within 1 degree of the point as it
//     sweeps, and the head along the sight line within 10 degrees;
//   - at a ready, the head within 15 degrees of level, and the muzzle 30
//     to 50 degrees down at the low ready, 30 to 45 up at the high (TC
//     3-22.9's ready positions: the butt kept in the shoulder, the muzzle
//     to the ground ahead or up before the face);
//   - aimed or at a ready, the head upright (FM 3-22.9: as erect as
//     possible, the cheek brought to the stock): its eyes' line within 15
//     degrees of level;
//   - each hand within 5 mm of its grip; each wrist within 35 degrees of
//     straight;
//   - the support elbow down under the handguard: 5 cm under its grip at
//     the least, and flared out from under the shoulder no more than 45
//     degrees; the trigger elbow down by the ribs, never in across the
//     chest: from 12 degrees inside the line down from its shoulder to 70
//     out (the modern carbine stance, FM 3-22.9's elbows down; the owner
//     chose it on 2026-11-16 over an elbow held 30 degrees out, which this
//     rig could not reach with the trigger wrist within 35 degrees);
//   - each elbow bent no more than 150 degrees, no shoulder raised over 5
//     cm, and the hands and elbows, in the chest's place, never faster than
//     0.5 m/s while aimed at the sweep: one frame with the rifle.
//
// Printed: the worst of each, per part. AE3D_TRACE=1 prints a line every
// quarter second.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.items

extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern acos(x: float) -> float
extern atan2(y: float, x: float) -> float

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const RIFLE = "tests/fixtures/items/rifle.item"
const BLADE = 0.524                  // radians the rifle lies across the chest (its kind's aim front)
const SETTLE = 60                      // frames into each part before it is measured
const POCKET_IN = 0.25
const POCKET_UP = 0.0
const POCKET_AHEAD = 0.05
const BUTT_MOST = 0.03                 // metres
const EYE_MOST = 0.02
const AIM_MOST = 1.0                   // degrees
const HEAD_AIM_MOST = 10.0
const HEAD_READY_MOST = 15.0
const HAND_MOST = 0.005
const WRIST_MOST = 35.0
const SUPPORT_UNDER = 0.05             // metres under the handguard
const SUPPORT_FLARE_MOST = 45.0
const TRIGGER_FLARE_LEAST = -12.0      // never in across the chest (the owner's choice, 2026-11-16)
const TRIGGER_FLARE_MOST = 70.0
const CANT_MOST = 15.0
const LOW_PITCH_LEAST = -50.0          // degrees over level, the muzzle at the low ready
const LOW_PITCH_MOST = -30.0
const HIGH_PITCH_LEAST = 30.0          // and at the high ready
const HIGH_PITCH_MOST = 45.0
const BEND_MOST = 150.0
const RAISE_MOST = 0.05
const SPEED_MOST = 0.5

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

deg(x: float) -> float { return x * 57.29578 }

angle_of(a: Vec3, b: Vec3) -> float {
    la = core.v3_len(a)
    lb = core.v3_len(b)
    if la < 0.000001 || lb < 0.000001 { return 0.0 }
    d = core.v3_dot(a, b) / (la * lb)
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return acos(d)
}

// The world's place of human joint `slot` as `w` (the rig's space) has it.
at(o: *GameObject, r: *pose.Rig, w: ptr, slot: int) -> Vec3 {
    return ikrig.to_ground(r, pose.translation(w, pose.human(r, slot)))
}

// The worst of one part.
struct Part {
    butt: float
    eye: float
    aim: float
    head: float
    cant: float                      // the head's tilt aside: the eyes' line off level
    pitch_least: float               // the muzzle's pitch over level, degrees (under 0 down): least and most
    pitch_most: float
    hand: float
    wrist: float
    wrist_s: float                   // the support wrist's alone
    under: float                     // the support elbow under its grip, least
    flare_s: float
    flare_t: float
    flare_t_least: float             // the trigger elbow's least flare (negative: in across the chest)
    bend: float
    raise: float
    speed: float
}

main() {
    println("rifle_ready: a rifle shouldered, aimed and at the ready (#1010)")
    trace = core.env_int("AE3D_TRACE", 0) == 1
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Rifleman", MANNEQUIN, g)
    if c == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    kind = items.kind_read(RIFLE)
    check("the rifle reads, shouldered: ${items.kind_error()}", kind != null)
    if kind == null { exit(1) }
    rifle = items.item_new(e, kind, engine.object(e, "Rifle", null))
    items.hold(rifle, a, 1)
    h = animator.hands(a)
    look = animator.look(a)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    rest_raise = [ikrig.to_ground(r, pose.translation(rest, pose.human(r, pose.UPPERARM_L))).y - ikrig.to_ground(r, pose.translation(rest, pose.human(r, pose.SPINE_03))).y, ikrig.to_ground(r, pose.translation(rest, pose.human(r, pose.UPPERARM_R))).y - ikrig.to_ground(r, pose.translation(rest, pose.human(r, pose.SPINE_03))).y]
    pose.release(rest)
    w = pose.new(r)
    k = 0
    while k < 30 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    names = ["aimed at the sweep", "at the low ready", "at the high ready", "aimed again"]
    hows = [items.READY_AIM, items.READY_LOW, items.READY_HIGH, items.READY_AIM]
    lengths = [460, 180, 180, 180]
    parts = calloc(4, 8) as ptr[]
    pn = 0
    while pn < 4 {
        made = heap.new(Part)
        made.under = 10.0
        made.flare_t_least = 90.0
        made.pitch_least = 90.0
        made.pitch_most = 0.0 - 90.0
        parts[pn] = made as ptr
        pn = pn + 1
    }
    clock = 0.0
    aimed_all = true
    was_hand = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was_elbow = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    pi = 0
    while pi < 4 {
        pt = parts[pi] as *Part
        items.ready(rifle, hows[pi])
        k = 0
        while k < lengths[pi] {
            // The point swept before it (the showcase's), the body turned
            // to it with the rifle bladed across the chest.
            sweep = 0.611 * sin(clock * 0.5)
            rise = 0.15 + 0.12 * sin(clock * 0.37)
            if pi > 0 { sweep = 0.0 }
            way = core.vec3(sin(sweep) * cos(rise), sin(rise), cos(sweep) * cos(rise))
            target = core.v3_add(core.vec3(0.0, 1.45, 0.0), core.v3_mul(way, 10.0))
            yaw = sweep - BLADE
            character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(sin(yaw), 0.0, cos(yaw)))
            aimed_all = aimed_all && items.aim(rifle, target, 1.0)
            character.look(c, target)
            engine.engine_update(e, STEP)
            clock = clock + STEP
            pose.world(r, animator.pose_now(a), w)
            if k >= SETTLE {
                ch = at(o, r, w, pose.SPINE_03)
                // The trunk's frame: the chest's forward and the body's up.
                fwd = core.v3_sub(at(o, r, w, pose.NECK), ch)
                up = core.vec3(0.0, 1.0, 0.0)
                facing = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
                left = core.v3_normalize(core.v3_cross(up, facing))
                // The butt in the pocket.
                sh_r = at(o, r, w, pose.UPPERARM_R)
                sh_l = at(o, r, w, pose.UPPERARM_L)
                ahead_c = core.v3_normalize(core.v3_cross(core.v3_sub(sh_l, sh_r), core.v3_normalize(fwd)))
                up_c = core.v3_normalize(core.v3_cross(ahead_c, core.v3_normalize(core.v3_sub(sh_l, sh_r))))
                pocket = core.v3_add(core.v3_add(core.v3_add(sh_r, core.v3_mul(core.v3_sub(sh_l, sh_r), POCKET_IN)), core.v3_mul(ahead_c, POCKET_AHEAD)), core.v3_mul(up_c, POCKET_UP))
                butt = core.v3_len(core.v3_sub(items.butt_point(rifle), pocket))
                if butt > pt.butt { pt.butt = butt }
                // The eye on the sight line, the line on the point, the head.
                sight, look_way = items.sight_line(rifle)
                eye = ikrig.to_ground(r, ikrig.eye_place(look, r, w, 1))
                rel = core.v3_sub(eye, sight)
                off_line = core.v3_len(core.v3_sub(rel, core.v3_mul(look_way, core.v3_dot(rel, look_way))))
                head_way = ikrig.look_head_forward(look, r, w)
                eyes = core.v3_sub(ikrig.to_ground(r, ikrig.eye_place(look, r, w, 0)), eye)
                cant = core.abs_of(deg(atan2(eyes.y, core.sqrt_of(eyes.x * eyes.x + eyes.z * eyes.z))))
                if cant > pt.cant { pt.cant = cant }
                muzzle = items.front_of(rifle)
                mp = deg(atan2(muzzle.y, core.sqrt_of(muzzle.x * muzzle.x + muzzle.z * muzzle.z)))
                if mp < pt.pitch_least { pt.pitch_least = mp }
                if mp > pt.pitch_most { pt.pitch_most = mp }
                if hows[pi] == items.READY_AIM {
                    if off_line > pt.eye { pt.eye = off_line }
                    err = deg(angle_of(look_way, core.v3_sub(target, sight)))
                    if err > pt.aim { pt.aim = err }
                    hd = deg(angle_of(head_way, look_way))
                    if hd > pt.head { pt.head = hd }
                } else {
                    pitch = core.abs_of(deg(atan2(head_way.y, core.sqrt_of(head_way.x * head_way.x + head_way.z * head_way.z))))
                    if pitch > pt.head { pt.head = pitch }
                }
                // The hands, wrists, elbows and shoulders.
                side = 0
                while side < 2 {
                    palm, _faces = ikrig.hands_palm(h, r, w, side)
                    d = core.v3_len(core.v3_sub(palm, ikrig.hands_grip(h, r, w, side)))
                    if d > pt.hand { pt.hand = d }
                    sh = at(o, r, w, pose.UPPERARM_L + side * 4)
                    el = at(o, r, w, pose.LOWERARM_L + side * 4)
                    wr = at(o, r, w, pose.HAND_L + side * 4)
                    mid = at(o, r, w, pose.FINGERS + side * 15 + 2 * 3)
                    wrist = deg(angle_of(core.v3_sub(wr, el), core.v3_sub(mid, wr)))
                    if wrist > pt.wrist { pt.wrist = wrist }
                    if side == 0 && wrist > pt.wrist_s { pt.wrist_s = wrist }
                    bend = 180.0 - deg(angle_of(core.v3_sub(sh, el), core.v3_sub(wr, el)))
                    if bend > pt.bend { pt.bend = bend }
                    raised = (sh.y - ch.y) - rest_raise[side]
                    if raised > pt.raise { pt.raise = raised }
                    // Flared: the upper arm out of the plane through the
                    // shoulder along the body's facing and up, the angle
                    // off that plane (0 tucked, forward or down; 90 out to
                    // the side).
                    outward = left
                    if side == 1 { outward = core.v3_mul(left, 0.0 - 1.0) }
                    arm = core.v3_sub(el, sh)
                    in_plane = core.sqrt_of(core.v3_dot(arm, facing) * core.v3_dot(arm, facing) + arm.y * arm.y)
                    flare = deg(atan2(core.v3_dot(arm, outward), in_plane))
                    if side == 0 {
                        if flare > pt.flare_s { pt.flare_s = flare }
                        under = items.off_grip_point(rifle).y - el.y
                        if under < pt.under { pt.under = under }
                    } else {
                        if flare > pt.flare_t { pt.flare_t = flare }
                        if flare < pt.flare_t_least { pt.flare_t_least = flare }
                    }
                    if trace && (k % 60) == 0 {
                        f_sh = core.v3_sub(sh, pocket)
                        f_el = core.v3_sub(el, pocket)
                        f_wr = core.v3_sub(wr, pocket)
                        f_mid = core.v3_sub(mid, pocket)
                        println("      side ${side} (left up ahead of the pocket, cm): shoulder ${core.v3_dot(f_sh, left) * 100.0} ${f_sh.y * 100.0} ${core.v3_dot(f_sh, facing) * 100.0}, elbow ${core.v3_dot(f_el, left) * 100.0} ${f_el.y * 100.0} ${core.v3_dot(f_el, facing) * 100.0}, wrist ${core.v3_dot(f_wr, left) * 100.0} ${f_wr.y * 100.0} ${core.v3_dot(f_wr, facing) * 100.0}, knuckle ${core.v3_dot(f_mid, left) * 100.0} ${f_mid.y * 100.0} ${core.v3_dot(f_mid, facing) * 100.0}; flare ${flare} wrist ${wrist}")
                    }
                    hand_rel = core.v3_sub(wr, ch)
                    elbow_rel = core.v3_sub(el, ch)
                    fast = core.v3_len(core.v3_sub(hand_rel, was_hand[side])) / STEP
                    fe = core.v3_len(core.v3_sub(elbow_rel, was_elbow[side])) / STEP
                    if fe > fast { fast = fe }
                    if pi == 0 && fast > pt.speed { pt.speed = fast }
                    was_hand[side] = hand_rel
                    was_elbow[side] = elbow_rel
                    side = side + 1
                }
                if trace && (k % 15) == 0 {
                    bp = items.butt_point(rifle)
                    println("    ${names[pi]} ${k}: butt ${butt * 100.0} cm off the pocket (butt ${bp.x} ${bp.y} ${bp.z}, pocket ${pocket.x} ${pocket.y} ${pocket.z}, shoulder ${sh_r.x} ${sh_r.y} ${sh_r.z}), eye ${off_line * 100.0} cm off the sight line (eye ${eye.x} ${eye.y} ${eye.z}, sight ${sight.x} ${sight.y} ${sight.z}), head ${deg(angle_of(head_way, look_way))} off it")
                }
            } else {
                // Not measured yet: the speeds' last places kept.
                side = 0
                while side < 2 {
                    ch0 = at(o, r, w, pose.SPINE_03)
                    was_hand[side] = core.v3_sub(at(o, r, w, pose.HAND_L + side * 4), ch0)
                    was_elbow[side] = core.v3_sub(at(o, r, w, pose.LOWERARM_L + side * 4), ch0)
                    side = side + 1
                }
            }
            k = k + 1
        }
        println("  ${names[pi]}: the butt ${pt.butt * 100.0} cm off the shoulder pocket; the eye ${pt.eye * 100.0} cm off the sight line, the sight ${pt.aim} degrees off the point; the head ${pt.head} degrees off (aimed: the sight line; at a ready: level), canted ${pt.cant}; the muzzle ${pt.pitch_least} to ${pt.pitch_most} degrees over level; a hand ${pt.hand * 1000.0} mm off its grip; a wrist ${pt.wrist} degrees (the support's ${pt.wrist_s}); the support elbow ${pt.under * 100.0} cm under the handguard at the least, flared ${pt.flare_s} degrees, the trigger elbow ${pt.flare_t_least} to ${pt.flare_t}; an elbow bent ${pt.bend}; a shoulder raised ${pt.raise * 100.0} cm; hands and elbows ${pt.speed} m/s in the chest's place")
        pi = pi + 1
    }
    check("held and aimed throughout", aimed_all && items.aiming(rifle))
    butt_ok = true
    hand_ok = true
    wrist_ok = true
    elbow_ok = true
    body_ok = true
    head_ok = true
    pi = 0
    while pi < 4 {
        pt = parts[pi] as *Part
        butt_ok = butt_ok && pt.butt <= BUTT_MOST
        hand_ok = hand_ok && pt.hand <= HAND_MOST
        wrist_ok = wrist_ok && pt.wrist <= WRIST_MOST
        // Under the handguard aimed; at a ready the handguard is pitched
        // down or up with the muzzle, the support forearm along it.
        if hows[pi] == items.READY_AIM { elbow_ok = elbow_ok && pt.under >= SUPPORT_UNDER }
        elbow_ok = elbow_ok && pt.flare_s <= SUPPORT_FLARE_MOST && pt.flare_t <= TRIGGER_FLARE_MOST && pt.flare_t_least >= TRIGGER_FLARE_LEAST
        head_ok = head_ok && pt.cant <= CANT_MOST
        body_ok = body_ok && pt.bend <= BEND_MOST && pt.raise <= RAISE_MOST
        if hows[pi] == items.READY_AIM { head_ok = head_ok && pt.head <= HEAD_AIM_MOST } else { head_ok = head_ok && pt.head <= HEAD_READY_MOST }
        pi = pi + 1
    }
    check("the butt within 3 cm of the shoulder pocket, aimed and at either ready", butt_ok)
    first = parts[0] as *Part
    last = parts[3] as *Part
    check("aimed, the eye within 2 cm of the sight line (the cheek on the stock)", first.eye <= EYE_MOST && last.eye <= EYE_MOST)
    check("aimed at the sweep, the sight line within 1 degree of the point", first.aim <= AIM_MOST && last.aim <= AIM_MOST)
    check("the head along the sight line within 10 degrees aimed, within 15 of level at a ready, never canted over 15", head_ok)
    low = parts[1] as *Part
    high = parts[2] as *Part
    check("at the low ready the muzzle 30 to 50 degrees down, at the high ready 30 to 45 up", low.pitch_least >= LOW_PITCH_LEAST && low.pitch_most <= LOW_PITCH_MOST && high.pitch_least >= HIGH_PITCH_LEAST && high.pitch_most <= HIGH_PITCH_MOST)
    check("each hand within 5 mm of its grip", hand_ok)
    check("each wrist within 35 degrees of straight", wrist_ok)
    check("the support elbow 5 cm under the handguard and flared no more than 45 degrees, the trigger elbow from 12 in to 70 out", elbow_ok)
    check("no elbow bent over 150 degrees, no shoulder raised over 5 cm", body_ok)
    check("aimed at the sweep, hands and elbows one frame with the rifle: never faster than 0.5 m/s in the chest's place", first.speed <= SPEED_MOST)
    items.aim_off(rifle)
    items.item_free(rifle)
    items.kind_free(kind)
    pose.release(w)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("rifle_ready: all checks passed (${g_checks})")
        return
    }
    println("rifle_ready: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

extern calloc(count: int, size: int) -> ptr
