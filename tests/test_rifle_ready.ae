// A rifle held at the ready as its aim sweeps (#1010): the showcase's
// rifleman (tools/anim_showcase.ae, AE3D_WATCH=7), the UE5 mannequin on its
// idle holding a rifle bladed in both hands, aiming it at a point that
// sweeps 35 degrees either way and rises and falls before it, the aim spread
// up its spine and its hands solved onto the rifle where the aim puts it
// (ikrig.hands_hold). No window; stepped at 60 Hz. Held to a person at the
// ready tracking a target, the head and trunk turning while the arms and the
// rifle stay one frame, from a second on:
//
//   - each elbow under its shoulder (the elbows down);
//   - each wrist bent no more than 35 degrees off straight onto its grip
//     (the hand may roll round the grip to keep it so). Solved as the idle
//     bends the elbows (its arms hanging), the elbows hung under the hands
//     and the wrists bent 50 and 73 degrees; with the wrists held straight,
//     both elbows rose over the shoulders;
//   - each elbow bent no more than 150 degrees;
//   - no shoulder raised more than 5 cm over its rest against the chest;
//   - the hands and elbows, in the chest's place, never faster than 0.5 m/s:
//     one frame with the rifle, no elbow flicking round as the aim sweeps.
//
// Printed: the worst of each, per arm. AE3D_TRACE=1 prints a line every
// quarter second.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.character

extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const MALE = "tests/fixtures/people/mannequin.glb"
const GRAPHS = "tests/fixtures/graphs/"
const BLADE = 0.611                    // radians the rifle lies across the chest (the showcase's)
const FRAMES = 760                     // a whole sweep and more
const SETTLE = 60                      // frames before it is measured
const WRIST_MOST = 35.0                // degrees
const BEND_MOST = 150.0                // degrees
const RAISE_MOST = 0.05                // metres
const SPEED_MOST = 0.5                 // metres a second

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

deg(x: float) -> float { return x * 57.29578 }

angle_of(a: Vec3, b: Vec3) -> float {
    la = core.v3_len(a)
    lb = core.v3_len(b)
    if la < 0.000001 || lb < 0.000001 { return 0.0 }
    d = core.v3_dot(a, b) / (la * lb)
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return acos(d)
}

at(r: *pose.Rig, w: ptr, joint: int) -> Vec3 { return ikrig.to_ground(r, pose.translation(w, pose.human(r, joint))) }

main() {
    println("rifle_ready: a rifle held at the ready as its aim sweeps (#1010)")
    trace = core.env_int("AE3D_TRACE", 0) == 1
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    c = character.graphed(e, "Rifleman", MALE, "${GRAPHS}stand.graph")
    if c == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    ro = character.object_of(c)
    behaviour.object_set_position(ro, core.vec3(0.0 - 12.0, 0.0, 4.0))
    mover.settle(character.mover_of(c))
    ra = character.animator_of(c)
    r = animator.rig(ra)
    hands = ikrig.hands_new(r)
    animator.set_hands(ra, hands)
    // The rifle and the hands on it as the showcase sets them (make_rifleman).
    chest = pose.human(r, pose.SPINE_03)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    into = core.quat_conjugate(pose.rotation(rest, chest))
    ahead = core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 1.0)))
    down = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))))
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    up = core.v3_mul(down, 0.0 - 1.0)
    across = core.v3_normalize(core.v3_add(core.v3_mul(ahead, cos(BLADE)), core.v3_mul(core.v3_normalize(core.v3_cross(up, ahead)), sin(BLADE))))
    butt = core.v3_add(core.quat_apply(into, core.v3_sub(pose.translation(rest, pose.human(r, pose.UPPERARM_R)), pose.translation(rest, chest))), core.v3_mul(ahead, 0.08 * unit))
    rest_raise = [at(r, rest, pose.UPPERARM_L).y - at(r, rest, pose.SPINE_03).y, at(r, rest, pose.UPPERARM_R).y - at(r, rest, pose.SPINE_03).y]
    pose.release(rest)
    ikrig.aim_set_line(animator.trunk_aim(ra), butt, across)
    right = core.v3_normalize(core.v3_cross(across, up))
    rake = 0.349
    grip_down = core.v3_normalize(core.v3_sub(core.v3_mul(down, cos(rake)), core.v3_mul(across, sin(rake))))
    grip_mid = core.v3_add(core.v3_add(butt, core.v3_mul(across, 0.21 * unit)), core.v3_add(core.v3_mul(down, 0.035 * unit), core.v3_mul(grip_down, 0.05 * unit)))
    trigger = core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.265 * unit), core.v3_mul(down, 0.05 * unit)))
    around = core.v3_normalize(core.v3_sub(across, core.v3_mul(grip_down, core.v3_dot(across, grip_down))))
    ikrig.hands_hold(hands, 1, chest, core.v3_add(grip_mid, core.v3_mul(right, 0.027 * unit)), core.v3_mul(right, 0.0 - 1.0), around, 0.85, 1.0)
    ikrig.hands_fingers(hands, 1, 0.6, 0.3, 0.85, 0.85, 0.85)
    ikrig.hands_trigger(hands, 1, chest, trigger, 0.0)
    ikrig.hands_hold(hands, 0, chest, core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.45 * unit), core.v3_mul(down, 0.047 * unit))), up, right, 0.55, 1.0)
    // A round pistol grip and fore-end: each hand takes them at the angle
    // its arm brings it (ikrig.hands_hold_roll).
    ikrig.hands_hold_roll(hands, 0, 0.6)
    ikrig.hands_hold_roll(hands, 1, 0.6)
    w = pose.new(r)
    clock = 0.0
    drop_least = [10.0, 10.0]
    wrist_most = [0.0, 0.0]
    bend_most = [0.0, 0.0]
    raise_most = [0.0 - 10.0, 0.0 - 10.0]
    speed_most = [0.0, 0.0]
    was_hand = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    was_elbow = [core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)]
    k = 0
    while k < FRAMES {
        // The showcase's sweep (step_rifleman): the body turned to it, the
        // aim on it, the eyes on it.
        sweep = 0.611 * sin(clock * 0.5)
        rise = 0.15 + 0.12 * sin(clock * 0.37)
        way = core.vec3(sin(sweep) * cos(rise), sin(rise), cos(sweep) * cos(rise))
        target = core.v3_add(core.vec3(0.0 - 12.0, 1.45, 4.0), core.v3_mul(way, 10.0))
        yaw = sweep - BLADE
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(sin(yaw), 0.0, cos(yaw)))
        animator.aim_at(ra, target, 1.0)
        character.look(c, target)
        engine.engine_update(e, STEP)
        clock = clock + STEP
        pose.world(r, animator.pose_now(ra), w)
        ch = at(r, w, pose.SPINE_03)
        line = "    ${k}:"
        side = 0
        while side < 2 {
            sh = at(r, w, pose.UPPERARM_L + side * 4)
            el = at(r, w, pose.LOWERARM_L + side * 4)
            wr = at(r, w, pose.HAND_L + side * 4)
            mid = at(r, w, pose.FINGERS + side * 15 + 2 * 3)
            drop = sh.y - el.y
            bend = 180.0 - deg(angle_of(core.v3_sub(sh, el), core.v3_sub(wr, el)))
            wrist = deg(angle_of(core.v3_sub(wr, el), core.v3_sub(mid, wr)))
            raised = (sh.y - ch.y) - rest_raise[side]
            hand_rel = core.v3_sub(wr, ch)
            elbow_rel = core.v3_sub(el, ch)
            fast = core.v3_len(core.v3_sub(hand_rel, was_hand[side])) / STEP
            fe = core.v3_len(core.v3_sub(elbow_rel, was_elbow[side])) / STEP
            if fe > fast { fast = fe }
            was_hand[side] = hand_rel
            was_elbow[side] = elbow_rel
            if k >= SETTLE {
                if drop < drop_least[side] { drop_least[side] = drop }
                if wrist > wrist_most[side] { wrist_most[side] = wrist }
                if bend > bend_most[side] { bend_most[side] = bend }
                if raised > raise_most[side] { raise_most[side] = raised }
                if fast > speed_most[side] { speed_most[side] = fast }
            }
            line = "${line} ${side}: elbow ${drop * 100.0} cm under, bent ${bend}, wrist ${wrist}, shoulder ${raised * 100.0} cm, ${fast} m/s;"
            side = side + 1
        }
        if trace && (k % 15) == 0 { println(line) }
        k = k + 1
    }
    names = ["left", "right"]
    side = 0
    while side < 2 {
        println("  ${names[side]} arm: the elbow ${drop_least[side] * 100.0} cm under the shoulder at the least, bent ${bend_most[side]} degrees at most; the wrist ${wrist_most[side]} degrees off straight at most; the shoulder ${raise_most[side] * 100.0} cm over its rest at most; hand and elbow ${speed_most[side]} m/s at most in the chest's place")
        side = side + 1
    }
    check("each elbow under its shoulder (the elbows down)", drop_least[0] > 0.0 && drop_least[1] > 0.0)
    check("each wrist bent no more than 35 degrees onto its grip", wrist_most[0] <= WRIST_MOST && wrist_most[1] <= WRIST_MOST)
    check("each elbow bent no more than 150 degrees", bend_most[0] <= BEND_MOST && bend_most[1] <= BEND_MOST)
    check("no shoulder raised more than 5 cm over its rest", raise_most[0] <= RAISE_MOST && raise_most[1] <= RAISE_MOST)
    check("hands and elbows one frame with the rifle: never faster than 0.5 m/s in the chest's place", speed_most[0] <= SPEED_MOST && speed_most[1] <= SPEED_MOST)
    pose.release(w)
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("rifle_ready: all checks passed (${g_checks})")
        return
    }
    println("rifle_ready: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
