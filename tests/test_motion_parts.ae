// A mode and a strength a body part (#573), held to numbers. Three figures
// on the pipeline's humanoid rig, the rig's arms raised 0.6 rad ahead as a
// clip would hold them; no window, the engine stepped by hand.
//
//   - an ANIMATED figure's left arm let go (LIMP): it hangs from the
//     shoulder while the right holds its clip, it is drawn as its body
//     hangs, and the figure stands on its clip;
//   - struck at the forearm, the limp arm swings, drawn swinging;
//   - taken back, it is drawn to its clip with no pop, and its bodies
//     follow (to within 0.3 rad: a following figure's joints' springs pull
//     toward the reference pose against the anchors' 5 Hz, and a healthy
//     arm held up ahead trails its clip too);
//   - a POWERED figure's right arm at a lasting 3% of its muscle keeps it
//     through a blow and the recovery after it;
//   - a POWERED figure's limp arm has no muscle and hangs.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// The clip's pose: both arms raised ahead, 0.6 rad (35 degrees) from
// hanging, within the reference ragdoll's 45-degree shoulder.
raise_arms(rig: *Skeleton) {
    raised = core.quat_rotate(0.6, core.vec3(1.0, 0.0, 0.0))
    core.model_set_rotation(skin.skeleton_bone(rig, skin.skeleton_find(rig, "ShoulderL")), raised)
    core.model_set_rotation(skin.skeleton_bone(rig, skin.skeleton_find(rig, "ShoulderR")), raised)
}

// The way a bone's body runs from its joint, in the world.
body_way(m: *Motion, bone: int) -> Vec3 {
    return core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, bone), physics.ragdoll_bone_axis(m.ragdoll, bone))
}

// The way a rig bone runs, drawn: from it to its child, in the world.
drawn_way(rig: *Skeleton, name: string, child: string) -> Vec3 {
    a = skin.skeleton_bone(rig, skin.skeleton_find(rig, name))
    b = skin.skeleton_bone(rig, skin.skeleton_find(rig, child))
    core.model_sync_transform(a)
    core.model_sync_transform(b)
    return core.v3_normalize(core.v3_sub(b.world_position, a.world_position))
}

angle(a: Vec3, b: Vec3) -> float {
    d = core.v3_dot(core.v3_normalize(a), core.v3_normalize(b))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return core.acos_of(d)
}

run(e: *Engine, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

main() {
    println("motion_parts: a mode and a strength a body part (#573)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    rigs_block = calloc(3, 8)
    rigs = rigs_block as ptr[]
    motions_block = calloc(3, 8)
    motions = motions_block as ptr[]
    k = 0
    while k < 3 {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 3.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        rigs[k] = rig as ptr
        physics.ragdoll_dress(r, rig)
        raise_arms(rig)
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        if k > 0 { motion.set_mode(m, motion.POWERED) }
        motions[k] = m as ptr
        k = k + 1
    }
    run(e, 1.0)
    animated = motions[0] as *Motion
    rig_a = rigs[0] as *Skeleton
    powered = motions[1] as *Motion
    limp_powered = motions[2] as *Motion
    ahead = physics.ragdoll_rest_forward(animated.ragdoll)
    down = core.vec3(0.0, 0.0 - 1.0, 0.0)
    // The clip's way for an arm: 0.6 rad from hanging, toward ahead; and
    // each arm's body as the clip holds it, before anything is let go (a
    // body's capsule and the rig's shoulder-to-elbow differ by 0.17 rad).
    clip_way = core.v3_normalize(core.v3_add(core.v3_mul(down, core.cos_of(0.6)), core.v3_mul(ahead, core.sin_of(0.6))))
    left_held = body_way(animated, human.BONE_UPPER_ARM_L)
    right_held = body_way(animated, human.BONE_UPPER_ARM_R)
    limp_left_held = body_way(limp_powered, human.BONE_UPPER_ARM_L)
    limp_right_held = body_way(limp_powered, human.BONE_UPPER_ARM_R)

    // An ANIMATED figure's left arm let go: it hangs, and is drawn hanging.
    let_go = motion.set_part_mode(animated, motion.PART_ARM_L, motion.LIMP)
    motion.set_part_mode(limp_powered, motion.PART_ARM_L, motion.LIMP)
    motion.set_part_strength(powered, motion.PART_ARM_R, 0.03)
    run(e, 2.0)
    hang = angle(body_way(animated, human.BONE_UPPER_ARM_L), down)
    held_hang = angle(left_held, down)
    fell = angle(body_way(animated, human.BONE_UPPER_ARM_L), left_held)
    held = angle(body_way(animated, human.BONE_UPPER_ARM_R), right_held)
    drawn_off = angle(drawn_way(rig_a, "ShoulderL", "ElbowL"), body_way(animated, human.BONE_UPPER_ARM_L))
    standing = behaviour.object_position(physics.ragdoll_bone(animated.ragdoll, human.BONE_PELVIS)).y
    println("  animated, left arm limp: it came down ${fell} rad from its clip, to ${hang} rad from straight down (held, ${held_hang}); the right ${held} rad from its clip; the left drawn ${drawn_off} rad from its body; the pelvis at ${standing} m")
    check("set LIMP, the part says so", let_go && motion.part_mode(animated, motion.PART_ARM_L) == motion.LIMP && motion.part_mode(animated, motion.PART_ARM_R) == motion.ANIMATED)
    check("the limp arm comes down from its clip (over 0.2 rad, nearer hanging) while the other holds its clip (within 0.05)", fell > 0.2 && hang < held_hang && held < 0.05)
    check("the limp arm is drawn as its body hangs (within 0.05 rad), the figure still standing on its clip", drawn_off < 0.05 && standing > 0.8)

    // Struck, the limp arm swings, drawn as it swings.
    fore = behaviour.object_position(physics.ragdoll_bone(animated.ragdoll, human.BONE_LOWER_ARM_L))
    before = drawn_way(rig_a, "ShoulderL", "ElbowL")
    motion.hit(animated, human.BONE_LOWER_ARM_L, fore, core.vec3(8.0, 0.0, 0.0))
    swung = 0.0
    k = 0
    while k < 20 {
        engine.engine_update(e, STEP)
        a = angle(drawn_way(rig_a, "ShoulderL", "ElbowL"), before)
        if a > swung { swung = a }
        k = k + 1
    }
    println("  struck at the forearm, the drawn left arm swung ${swung} rad")
    check("struck, the limp arm swings and is drawn swinging (over 0.2 rad)", swung > 0.2)
    run(e, 2.0)

    // Taken back: drawn to its clip with no pop, its bodies following.
    hung = drawn_way(rig_a, "ShoulderL", "ElbowL")
    motion.set_part_mode(animated, motion.PART_ARM_L, motion.ANIMATED)
    last = hung
    worst_step = 0.0
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        now = drawn_way(rig_a, "ShoulderL", "ElbowL")
        a = angle(now, last)
        if a > worst_step { worst_step = a }
        last = now
        k = k + 1
    }
    drawn_back = angle(drawn_way(rig_a, "ShoulderL", "ElbowL"), clip_way)
    body_back = angle(body_way(animated, human.BONE_UPPER_ARM_L), left_held)
    println("  taken back: the drawn arm turned ${worst_step} rad a frame at most, and a second on is ${drawn_back} rad from its clip, its body ${body_back}")
    check("taken back, the arm is drawn to its clip with no pop (under 0.15 rad a frame)", worst_step < 0.15)
    check("and a second on it is drawn on its clip (within 0.05 rad), its body back near it (within 0.3)", drawn_back < 0.05 && body_back < 0.3)

    // A lasting weakness: the powered figure's right arm at 3%, through a
    // blow and the recovery after it.
    left_drive = physics.ragdoll_bone_drive_torque(powered.ragdoll, human.BONE_UPPER_ARM_L)
    right_drive = physics.ragdoll_bone_drive_torque(powered.ragdoll, human.BONE_UPPER_ARM_R)
    chest = behaviour.object_position(physics.ragdoll_bone(powered.ragdoll, human.BONE_SPINE_03))
    motion.hit(powered, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - 60.0))
    run(e, 1.5)
    left_after = physics.ragdoll_bone_drive_torque(powered.ragdoll, human.BONE_UPPER_ARM_L)
    right_after = physics.ragdoll_bone_drive_torque(powered.ragdoll, human.BONE_UPPER_ARM_R)
    println("  powered, its right arm at 3%: ${right_drive / left_drive} of the left's muscle before a blow, ${right_after / left_after} after it and its recovery")
    check("a part's lasting strength holds through a blow and the recovery after it", core.abs_of(right_drive / left_drive - 0.03) < 0.001 && core.abs_of(right_after / left_after - 0.03) < 0.001 && motion.part_strength(powered, motion.PART_ARM_R) == 0.03)

    // Powered with its left arm limp: no muscle there, and it hangs.
    limp_drive = physics.ragdoll_bone_drive_torque(limp_powered.ragdoll, human.BONE_UPPER_ARM_L)
    limp_hang = angle(body_way(limp_powered, human.BONE_UPPER_ARM_L), down)
    limp_fell = angle(body_way(limp_powered, human.BONE_UPPER_ARM_L), limp_left_held)
    limp_held = angle(body_way(limp_powered, human.BONE_UPPER_ARM_R), limp_right_held)
    println("  powered, left arm limp: its muscle ${limp_drive} N m; it came down ${limp_fell} rad from its clip to ${limp_hang} from straight down, the right ${limp_held} from its clip")
    check("powered, a limp arm has no muscle and hangs while the other holds", limp_drive == 0.0 && limp_fell > 0.2 && limp_held < 0.1)

    engine.engine_free(e)
    k = 0
    while k < 3 {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(rigs_block)
    free(motions_block)
    if g_failures == 0 {
        println("motion_parts: all checks passed (${g_checks})")
        return
    }
    println("motion_parts: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
