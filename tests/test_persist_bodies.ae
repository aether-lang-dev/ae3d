// What a save keeps of the bodies (#507): a world of crates thrown and
// falling, saved mid-flight (ae3d.persist with ae3d.physics's provider),
// loaded into a fresh world built the same way. Headless: each world is
// stepped by hand at the fixed step.
//
//   - every body is where its object was saved, as fast and turning as fast,
//     awake or asleep as it was, to the bit;
//   - the first step goes on from there: a dynamic body's place is the save's,
//     not the scene's as built, which it wrote back over the object before;
//   - two worlds loaded from one save step the same, every body to the bit,
//     for 300 steps;
//   - a record naming no object is counted; a world freed saves nothing more.

import std.json
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.loader
import ae3d.physics
import ae3d.persist
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const STEP = 0.016666666666666666
const CRATES = 8

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

struct World {
    e: *Engine
    crates: ptr                    // *GameObject[CRATES]
}

crate_of(w: *World, i: int) -> *GameObject { return (w.crates as ptr[])[i] as *GameObject }

// The same world every time: the ground, and crates in a row, each thrown
// its own way.
world_new() -> *World {
    w = heap.new(World)
    w.e = engine.engine_new()
    engine.engine_set_fixed_step(w.e, STEP)
    physics.attach(w.e)
    stone = physics.material(0.6, 0.2)
    ground = engine.object(w.e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), stone)
    w.crates = calloc(CRATES, 8)
    i = 0
    while i < CRATES {
        c = engine.object(w.e, "Crate ${i}", loader.cube(1.0))
        behaviour.object_set_position(c, core.vec3((i as float) * 2.5 - 9.0, 1.0 + (i as float) * 0.7, 0.0))
        rb = physics.rigidbody(c, physics.DYNAMIC)
        physics.box_collider(c, core.vec3(0.5, 0.5, 0.5), stone)
        physics.rigidbody_set_velocity(rb, core.vec3(1.0 - (i as float) * 0.3, 2.0 + (i as float) * 0.5, (i % 3) as float - 1.0))
        (w.crates as ptr[])[i] = c as ptr
        i = i + 1
    }
    return w
}

world_free(w: *World) {
    engine.engine_free(w.e)
    free(w.crates)
    heap.free(w)
}

steps(w: *World, n: int) {
    i = 0
    while i < n {
        engine.engine_update(w.e, STEP)
        i = i + 1
    }
}

// Every crate's body as text, every number to the bit (std.json writes a
// double whole): what two worlds are compared by.
bodies_text(w: *World) -> string {
    a = json.arr()
    i = 0
    while i < CRATES {
        b = physics.rigidbody_body(physics.rigidbody_of(crate_of(w, i)))
        p = dynamics.body_get_position(b)
        v = physics.rigidbody_velocity(physics.rigidbody_of(crate_of(w, i)))
        json.array_add_raw(a, json.num(p.x))
        json.array_add_raw(a, json.num(p.y))
        json.array_add_raw(a, json.num(p.z))
        json.array_add_raw(a, json.num(v.x))
        json.array_add_raw(a, json.num(v.y))
        json.array_add_raw(a, json.num(v.z))
        i = i + 1
    }
    text = json.stringify_raw(a)
    json.free(a)
    return text
}

main() {
    println("persist bodies: a world of moving bodies saved and loaded")
    first = world_new()
    base = persist.baseline(engine.engine_scene(first.e))
    steps(first, 40)
    doc = persist.state_json(engine.engine_scene(first.e), base)
    systems = json.object_get_raw(doc, "systems")
    physics_entry = null as ptr
    if systems != null { physics_entry = json.object_get_raw(systems, "physics") }
    check("a save holds the bodies' own state beside the objects, a record of eight a body",
          physics_entry != null && json.get_int(json.object_get_raw(physics_entry, "width")) == 8 &&
          json.array_size(json.object_get_raw(physics_entry, "records")) == CRATES)
    saved = bodies_text(first)
    saved_awake = physics.rigidbody_is_awake(physics.rigidbody_of(crate_of(first, 0)))

    second = world_new()
    base2 = persist.baseline(engine.engine_scene(second.e))
    check("a save loads over a fresh world built the same way", persist.apply_json(engine.engine_scene(second.e), doc) && persist.last_unknown() == 0)
    loaded = bodies_text(second)
    check("every body is where its object was saved, as fast, to the bit", string.equals(saved, loaded) == 1)
    check("awake as it was", physics.rigidbody_is_awake(physics.rigidbody_of(crate_of(second, 0))) == saved_awake)
    // The step after: from the save's place, not the scene's as built.
    was = behaviour.object_position(crate_of(second, 7))
    built_y = 1.0 + 7.0 * 0.7
    steps(second, 1)
    now = behaviour.object_position(crate_of(second, 7))
    check("the first step goes on from where the save had it (${was.y} to ${now.y}, built at ${built_y})",
          core.abs_of(now.y - was.y) < 0.2 && core.abs_of(now.y - built_y) > 0.05)

    // Two loads of one save step the same.
    third = world_new()
    base3 = persist.baseline(engine.engine_scene(third.e))
    persist.apply_json(engine.engine_scene(third.e), doc)
    steps(third, 1)
    same = true
    k = 0
    while k < 300 && same {
        steps(second, 1)
        steps(third, 1)
        a = bodies_text(second)
        b = bodies_text(third)
        if string.equals(a, b) != 1 { same = false }
        k = k + 1
    }
    check("two worlds loaded from one save step the same, every body to the bit, for 300 steps (${k})", same && k == 300)

    // A record naming an object the scene does not have.
    bodies = json.object_get_raw(json.object_get_raw(systems, "physics"), "records")
    stray = json.arr()
    json.array_add_raw(stray, json.num(9999.0))
    j = 0
    while j < 7 {
        json.array_add_raw(stray, json.num(0.0))
        j = j + 1
    }
    json.array_add_raw(bodies, stray)
    persist.apply_json(engine.engine_scene(third.e), doc)
    check("a record naming no object is counted (${persist.last_unknown()})", persist.last_unknown() == 1)

    json.free(doc)
    persist.baseline_free(base)
    persist.baseline_free(base2)
    persist.baseline_free(base3)
    world_free(first)
    world_free(second)
    world_free(third)
    // With every world freed, a save of a scene has no system's state.
    lone = behaviour.scene_new()
    lone_base = persist.baseline(lone)
    plain = persist.state_json(lone, lone_base)
    check("a world freed takes its provider with it", json.object_get_raw(plain, "systems") == null)
    json.free(plain)
    persist.baseline_free(lone_base)
    behaviour.scene_free(lone)
    component.kinds_clear()

    if g_failures == 0 {
        println("persist bodies: all checks passed (${g_checks})")
    } else {
        println("persist bodies: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
