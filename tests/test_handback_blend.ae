// A POWERED figure handed back to its animation (motion.set_mode ANIMATED)
// blends from where its bodies stand into the animation over motion's
// BLEND, held to numbers on the box man (tests/fixtures/gltf/humanoid.glb,
// motion.on_figure), no window, the engine stepped by hand:
//
//   - handed back as it begins to wave, the drawn right forearm comes up
//     into the wave over the blend and never turns faster than 15 rad/s.
//     Blended toward the animation as it was when the blend began, it held
//     still through the blend and was thrown 1.4 rad in a frame (85 rad/s)
//     as the blend ended;
//   - handed back walking, the drawn neck, which the walk does not key,
//     never turns faster than 10 rad/s: blended toward the animation as it
//     is now, the pose shown has to be kept as the bodies' side's, or it is
//     taken for the clip's where the clip keys nothing, and the neck held
//     still through the blend and was let go 1.1 rad in a frame (69 rad/s).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import ae3d.skin

extern exit(code: int)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turn_between(a: Quat, b: Quat) -> float {
    d = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    if d < 0.0 { d = 0.0 - d }
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

// The box man standing POWERED in `start` for two seconds, then `to`
// played and handed back ANIMATED in the same step: the fastest the drawn
// `bone` turns over the 0.6 s after, rad/s; -1 when it would not load.
handed_back(start: string, to: string, bone: string) -> float {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        engine.engine_free(e)
        return 0.0 - 1.0
    }
    f = figure.figure_of(o)
    figure.play(f, start, 1.0, true)
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    sk = figure.skeleton(f)
    b = skin.skeleton_bone(sk, skin.skeleton_find(sk, bone))
    k = 0
    while k < 120 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    if to != start { figure.play(f, to, 1.0, true) }
    motion.set_mode(m, motion.ANIMATED)
    core.model_sync_transform(b)
    last = b.world_rotation
    most = 0.0
    k = 0
    while k < 36 {
        engine.engine_update(e, STEP)
        core.model_sync_transform(b)
        speed = turn_between(last, b.world_rotation) / STEP
        if speed > most { most = speed }
        last = b.world_rotation
        k = k + 1
    }
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
    return most
}

main() {
    println("handback_blend: a POWERED figure blended back into its animation")
    wave = handed_back("Idle", "Wave", "mixamorig:RightForeArm")
    if wave < 0.0 {
        println("handback_blend: SKIP ${PATH} would not load")
        return
    }
    println("  handed back as it begins to wave: the right forearm turns ${wave} rad/s at the most")
    check("handed back as it begins to wave, the drawn forearm comes into the wave, never past 15 rad/s", wave < 15.0)
    walk = handed_back("Walk", "Walk", "mixamorig:Neck")
    println("  handed back walking: the neck, which the walk does not key, turns ${walk} rad/s at the most")
    check("handed back walking, the drawn neck the walk does not key never turns past 10 rad/s", walk < 10.0)
    if g_failures == 0 {
        println("handback_blend: all checks passed (${g_checks})")
        return
    }
    println("handback_blend: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
