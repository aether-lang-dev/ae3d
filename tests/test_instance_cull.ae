// An instanced model's copies culled by cluster (#19). A prop kind laid over
// a whole map was one instanced model drawn whole: every copy, every frame,
// the ones off the screen with the ones on it.
//
// Headless, the clusters themselves, over 2,400 copies on a 400 m map:
//   - every copy is in exactly one cluster, and inside its sphere;
//   - a place in cluster order turns back into its copy;
//   - the runs a view's frustum reaches hold every copy that view can see,
//     and a fraction of the rest;
//   - joined to at most RUN_LIMIT runs, they still hold every one;
//   - clustering again after a copy is added is cheap (stated, measured).
// On both renderers (left out where one will not start): the same picture
// with the culling as without it, drawn in runs, and a pick naming the copy
// the game set, not its place in cluster order.

import std.list
import std.mem
import std.os
import ae3d.core
import ae3d.geometry
import ae3d.loader
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float
extern exit(code: int)

const SIDE = 49                  // copies a row: 2,401 over the map
const SPACING = 8.0              // metres between them: a 392 m map
const WIDTH = 160
const HEIGHT = 120

var g_checks = 0
var g_failures = 0
var g_gl_target: ptr = null

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A prop kind over the map: a cube a copy, SIDE x SIDE of them.
props(size: float) -> *Model {
    m = loader.cube(size)
    n = SIDE * SIDE
    core.model_enable_instancing(m, n)
    half = SPACING * ((SIDE - 1) as float) * 0.5
    i = 0
    while i < n {
        core.model_set_instance_position(m, i, core.vec3(((i % SIDE) as float) * SPACING - half, size * 0.5, ((i / SIDE) as float) * SPACING - half))
        i = i + 1
    }
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

clusters_headless() {
    println("the clusters, on a 392 m map of 2,401 copies")
    m = props(1.0)
    check("a still opaque stream is clusterable", core.instances_clusterable(m))
    check("and cut into clusters", core.instances_cluster(m))
    c = geometry.inst_clusters(m.instances)
    n = core.model_instance_count(m)
    order = c.order as int[]
    places = c.places as int[]
    first = c.first as int[]
    sp = c.spheres as f32[]
    println("    ${c.clusters} clusters of ${n} copies")
    // Every copy once.
    seen = calloc(n, 4) as int[]
    k = 0
    while k < n {
        seen[order[k]] = seen[order[k]] + 1
        k = k + 1
    }
    once = true
    k = 0
    while k < n {
        if seen[k] != 1 || places[order[k]] != k || geometry.inst_place_of(m.instances, k) != order[k] { once = false }
        k = k + 1
    }
    check("every copy is in exactly one cluster, and its place turns back into it", once && first[c.clusters] == n)
    // Inside its cluster's sphere (a cube of 1 m: its sphere 0.87 m).
    mat = geometry.inst_matrix_data(m.instances) as f32[]
    inside = true
    cl = 0
    while cl < c.clusters {
        p = first[cl]
        while p < first[cl + 1] {
            j = order[p]
            dx = (mat[j * 16 + 12] as float) - (sp[cl * 4] as float)
            dy = (mat[j * 16 + 13] as float) - (sp[cl * 4 + 1] as float)
            dz = (mat[j * 16 + 14] as float) - (sp[cl * 4 + 2] as float)
            if sqrt(dx * dx + dy * dy + dz * dz) + 0.866 > (sp[cl * 4 + 3] as float) + 0.001 { inside = false }
            p = p + 1
        }
        cl = cl + 1
    }
    check("each copy is inside its cluster's sphere", inside)

    // A view over a corner of the map, as a builder's camera sees it.
    cam = core.camera_new(1280, 720)
    core.camera_set_position(cam, core.vec3(0.0 - 150.0, 60.0, 0.0 - 110.0))
    core.camera_look_at(cam, core.vec3(0.0 - 150.0, 0.0, 0.0 - 160.0))
    frustum = core.frustum_new()
    core.camera_fill_frustum(cam, frustum)
    firsts = calloc(core.RUN_LIMIT, 4) as int[]
    counts = calloc(core.RUN_LIMIT, 4) as int[]
    runs = core.instance_runs(m, frustum, firsts, counts)
    drawn = calloc(n, 4) as int[]
    total = 0
    r = 0
    while r < runs {
        p = firsts[r]
        while p < firsts[r] + counts[r] {
            drawn[order[p]] = 1
            p = p + 1
        }
        total = total + counts[r]
        r = r + 1
    }
    visible = 0
    missed = 0
    k = 0
    while k < n {
        centre = core.vec3(mat[k * 16 + 12] as float, mat[k * 16 + 13] as float, mat[k * 16 + 14] as float)
        if core.frustum_sphere_visible(frustum, centre, 0.866) {
            visible = visible + 1
            if drawn[k] == 0 { missed = missed + 1 }
        }
        k = k + 1
    }
    println("    a corner view: ${visible} copies visible, ${total} drawn in ${runs} runs, of ${n}")
    check("every copy the view can see is drawn (${missed} missed)", missed == 0 && visible > 0)
    check("and a fraction of the rest (${total} of ${n})", total * 4 < n)
    check("in at most ${core.RUN_LIMIT} runs", runs <= core.RUN_LIMIT)

    // Wide: a view of most of the map, its runs joined to the limit.
    core.camera_set_position(cam, core.vec3(0.0, 120.0, 260.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    core.camera_fill_frustum(cam, frustum)
    runs = core.instance_runs(m, frustum, firsts, counts)
    k = 0
    while k < n {
        drawn[k] = 0
        k = k + 1
    }
    r = 0
    while r < runs {
        p = firsts[r]
        while p < firsts[r] + counts[r] {
            drawn[order[p]] = 1
            p = p + 1
        }
        r = r + 1
    }
    missed = 0
    k = 0
    while k < n {
        centre = core.vec3(mat[k * 16 + 12] as float, mat[k * 16 + 13] as float, mat[k * 16 + 14] as float)
        if core.frustum_sphere_visible(frustum, centre, 0.866) && drawn[k] == 0 { missed = missed + 1 }
        k = k + 1
    }
    check("a wide view, its runs joined to ${runs}, still draws every copy it sees (${missed} missed)", missed == 0 && runs <= core.RUN_LIMIT)

    // Laying a tile: a copy more, clustered again.
    core.model_enable_instancing(m, n + 1)
    core.model_set_instance_position(m, n, core.vec3(500.0, 0.5, 500.0))
    started = os.now_monotonic_ns()
    again = core.instances_cluster(m)
    took = (os.now_monotonic_ns() - started) / (1000 as long)
    println("    clustered again with a copy more in ${took} us")
    check("a copy added, the stream is clustered again, the new copy in it", again && geometry.inst_clusters(m.instances).count == n + 1)
    check("for under a millisecond", took < (1000 as long))

    // Moving streams, crowds and what blends are drawn whole.
    core.model_set_alpha(m, 0.5)
    check("a stream that blends is not clustered (its copies' order is the blend's)", !core.instances_clusterable(m))
    core.model_set_alpha(m, 1.0)
    small = props(1.0)
    core.model_enable_instancing(small, 60)
    check("nor one too small to pay for its draws", !core.instances_cluster(small))
    core.model_free(small)

    free(seen as ptr)
    free(drawn as ptr)
    free(firsts as ptr)
    free(counts as ptr)
    core.frustum_free(frustum)
    core.camera_free(cam)
    core.model_free(m)
}

frame_of(backend: *Backend) -> ptr {
    if g_gl_target != null { return offscreen.target_pixels(g_gl_target) }
    return core.backend_frame_pixels(backend)
}

// The frame, kept past the next.
kept(pixels: ptr) -> ptr {
    copy = calloc(WIDTH * HEIGHT, 4)
    mem.copy_at(copy, 0 as long, pixels, 0 as long, (WIDTH * HEIGHT * 4) as long)
    return copy
}

// A few frames, for the stream to stand still and be clustered.
frames(backend: *Backend, cam: *Camera, light: *Light, count: int) {
    k = 0
    while k < count {
        core.backend_render(backend, cam, light)
        k = k + 1
    }
}

drawn(backend: *Backend, name: string, draw_calls: fn(ptr) -> int, state: ptr) {
    core.backend_set_clear_color(backend, 0.1, 0.1, 0.12)
    m = props(1.6)
    core.backend_add_model(backend, m)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0 - 150.0, 40.0, 0.0 - 120.0))
    core.camera_look_at(cam, core.vec3(0.0 - 150.0, 0.0, 0.0 - 165.0))
    light = core.light_directional(core.vec3(0.3, 1.0, 0.4), core.vec3(1.0, 1.0, 1.0), 1.0)

    core.set_frustum_culling(false)
    frames(backend, cam, light, 4)
    whole = kept(frame_of(backend))
    whole_calls = draw_calls(state)
    core.set_frustum_culling(true)
    frames(backend, cam, light, 4)
    culled = frame_of(backend)
    culled_calls = draw_calls(state)
    check("${name}: the stream is clustered once it stands still", geometry.inst_clusters(m.instances) != null)
    differ = 0
    lit = 0
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        if i % 4 != 3 {
            a = mem.get_byte(whole, i)
            b = mem.get_byte(culled, i)
            d = a - b
            if d < 0 { d = 0 - d }
            if d > 2 { differ = differ + 1 }
            if a > 40 { lit = lit + 1 }
        }
        i = i + 1
    }
    println("    ${name}: ${differ} channels differ of ${lit} lit; ${whole_calls} draws whole, ${culled_calls} by runs")
    check("${name}: the picture culled by cluster is the picture drawn whole", lit > 1000 && differ == 0)
    // What the runs draw for this camera: the same frustum the renderer filled.
    frustum = core.frustum_new()
    core.camera_fill_frustum(cam, frustum)
    firsts = calloc(core.RUN_LIMIT, 4) as int[]
    counts = calloc(core.RUN_LIMIT, 4) as int[]
    runs = core.instance_runs(m, frustum, firsts, counts)
    copies = 0
    r = 0
    while r < runs {
        copies = copies + counts[r]
        r = r + 1
    }
    check("${name}: drawn by runs, ${copies} copies of ${core.model_instance_count(m)} in ${runs} (${culled_calls} draws, ${whole_calls} whole)",
          copies * 4 < core.model_instance_count(m) && culled_calls >= whole_calls)
    free(firsts as ptr)
    free(counts as ptr)
    core.frustum_free(frustum)

    // A pick names the copy the game set, not its place in cluster order:
    // copy 152 (the sixth of the fourth row), picked where it is drawn.
    wanted = 3 * SIDE + 5
    mat = geometry.inst_matrix_data(m.instances) as f32[]
    at = core.camera_world_to_screen(cam, core.vec3(mat[wanted * 16 + 12] as float, mat[wanted * 16 + 13] as float, mat[wanted * 16 + 14] as float), WIDTH, HEIGHT)
    px = at.x as int
    py = at.y as int
    k = core.backend_pick_ask(backend, px, py)
    core.backend_render(backend, cam, light)
    hit = core.backend_pick_read(backend, k, cam, px, py, WIDTH, HEIGHT)
    check("${name}: a pick at copy ${wanted} names it (${hit.instance}; its place in cluster order is ${(geometry.inst_clusters(m.instances).places as int[])[wanted]})",
          hit.hit && hit.instance == wanted)

    free(whole)
    core.backend_remove_model(backend, m)
    core.model_free(m)
    core.light_free(light)
    core.camera_free(cam)
}

gl_calls(state: ptr) -> int { return gl.renderer_draw_calls(state as *GLRenderer) }
vk_calls(state: ptr) -> int { return vulkan.renderer_draw_calls(state as *VKRenderer) }

main() {
    println("instance_cull: an instanced model's copies culled by cluster")
    clusters_headless()
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context != null {
        renderer = gl.renderer_new()
        pass = gl.backend(renderer)
        if core.backend_init(&pass, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            g_gl_target = target
            drawn(&pass, "opengl", gl_calls, renderer as ptr)
            g_gl_target = null
            core.backend_cleanup(&pass)
            offscreen.target_destroy(target)
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    } else {
        println("instance_cull: no OpenGL context; OpenGL is not drawn")
    }
    if vulkan.available() {
        vr = vulkan.renderer_new()
        vpass = vulkan.backend(vr)
        if core.backend_init(&vpass, null, WIDTH, HEIGHT) {
            drawn(&vpass, "vulkan", vk_calls, vr as ptr)
            core.backend_cleanup(&vpass)
        }
        vulkan.renderer_free(vr)
    } else {
        println("instance_cull: no Vulkan driver; Vulkan is not drawn")
    }
    if g_failures == 0 {
        println("instance_cull: all checks passed (${g_checks})")
    } else {
        println("instance_cull: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
