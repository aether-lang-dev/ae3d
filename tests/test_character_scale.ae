// A character at another size than its file's (#943, character.humanoid's
// `scale`): the UE5 mannequin at 0.9, 1.0 and 1.1 of its size on 100STYLE's
// neutral gaits, in a world with physics, walking ahead at 1.2 m/s for 3 s.
// No window; stepped at 60 Hz. Made at its file's size and scaled after, a
// figure kept a capsule and gaits for the size it was made at (Siltreach's
// people, scaled to 1.75 m).
//
//   - its capsule is that share of the mannequin's at its own size, in
//     height and in radius (within 1%);
//   - and it walks at that size: no planted toe skates 5 mm (ae3d.metrics),
//     its drawn head that share as high as the mannequin's (within 1%).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The mannequin at `scale`, walking 3 s: its capsule's height (feet to the
// top) and radius, its drawn head's highest over the floor, and the worst a
// toe skated.
walk(scale: float) -> (float, float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Walker", MANNEQUIN, g, scale)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    a = character.animator_of(c)
    r = animator.rig(a)
    capsule = physics.character_of(o)
    height = physics.character_height(capsule)
    radius = physics.character_radius(capsule)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    head = pose.joint(r, pose.human(r, pose.HEAD))
    highest = 0.0
    k = 0
    while k < 180 {
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        core.model_sync_transform(head)
        if head.world_position.y > highest { highest = head.world_position.y }
        k = k + 1
    }
    slid = metrics.meter_worst(m, metrics.SKATE)
    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return height, radius, highest, slid
}

main() {
    println("character_scale: a character at another size than its file's (#943)")
    h1, r1, top1, s1 = walk(1.0)
    println("  at its own size: capsule ${h1} m tall, ${r1} m round; head ${top1} m up at most; a toe skating ${s1 * 1000.0} mm")
    scales = [0.9, 1.1]
    sized = true
    walked = s1 < 0.005
    k = 0
    while k < 2 {
        h, rad, top, slid = walk(scales[k])
        println("  at ${scales[k]} of it: capsule ${h / h1} of its height, ${rad / r1} of its radius; head ${top / top1} as high; a toe skating ${slid * 1000.0} mm")
        if core.abs_of(h / h1 - scales[k]) > 0.01 || core.abs_of(rad / r1 - scales[k]) > 0.01 { sized = false }
        if core.abs_of(top / top1 - scales[k]) > 0.01 || slid >= 0.005 { walked = false }
        k = k + 1
    }
    check("at 0.9 and 1.1 of its size, its capsule is that share of its own, tall and round (1%)", sized)
    check("and it walks at that size: its head that share as high (1%), no toe skating 5 mm", walked)
    if g_failures == 0 {
        println("character_scale: all checks passed (${g_checks})")
        return
    }
    println("character_scale: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
