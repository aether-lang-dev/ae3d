// A figure standing on two feet stands on both (#777), held to numbers. The
// box man (the fixture the motion showcase dresses), POWERED in its Idle,
// whose clip holds its feet level and its centre of mass midway between
// them; no window, the engine stepped by hand.
//
//   - fitted, its soles stand at one height, to 1 mm: each foot was laid
//     under its shin at its own toe's height along it, and the reference's
//     right toe sits 8 mm below its left;
//   - standing 2 s, each foot carries between 40% and 60% of what the two
//     carry: with the right sole lower, the right foot carried 844 N and
//     the left none, the figure held up on one leg by the sole's roll and
//     the balance assist, and every step began from one loaded foot.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human
import aephysics.dynamics
import aephysics.manifold
import aephysics.math

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The bone a calf's foot is: the calf itself, or with ankles (#709) the
// foot bone below it.
foot_bone(r: *Ragdoll, calf: int) -> int {
    if physics.ragdoll_bone_count(r) <= human.BONE_COUNT { return calf }
    if calf == human.BONE_CALF_R { return human.BONE_FOOT_R }
    return human.BONE_FOOT_L
}

// What the ground pushes up on a calf's foot with, newtons, over the last
// step.
load_of(r: *Ragdoll, calf: int) -> float {
    id = human.bone_at(physics.ragdoll_human(r), foot_bone(r, calf)).body_id
    room = 16
    block = calloc(room, sizeof(ContactData))
    touching = block as ContactData[]
    n = dynamics.body_get_contact_data(id, touching, room)
    total = 0.0
    k = 0
    while k < n {
        manifolds = touching[k].manifolds as Manifold[]
        j = 0
        while j < touching[k].manifold_count {
            mf = manifolds[j]
            if mf.point_count > 0 { total = total + (mf.point0.total_normal_impulse as float) }
            if mf.point_count > 1 { total = total + (mf.point1.total_normal_impulse as float) }
            if mf.point_count > 2 { total = total + (mf.point2.total_normal_impulse as float) }
            if mf.point_count > 3 { total = total + (mf.point3.total_normal_impulse as float) }
            j = j + 1
        }
        k = k + 1
    }
    free(block)
    return total / STEP
}

// The lowest point of a calf's foot, in the world.
sole(r: *Ragdoll, calf: int) -> float {
    bone = human.bone_at(physics.ragdoll_human(r), foot_bone(r, calf))
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.foot_shape_id)
    a = math.transform_point(t, c.center1)
    b = math.transform_point(t, c.center2)
    low = a.y
    if b.y < low { low = b.y }
    return low - c.radius
}

main() {
    println("stance_feet: a figure standing on two feet stands on both (#777)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", BOXMAN)
    if o == null {
        println("stance_feet: SKIP ${BOXMAN} would not load")
        engine.engine_free(e)
        return
    }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    r = physics.ragdoll(e, "BoxMan", group.world_position, 8.0, 8.0, 1.0)
    physics.ragdoll_dress_humanoid(r, figure.skeleton(f))
    gap = core.abs_of(sole(r, human.BONE_CALF_L) - sole(r, human.BONE_CALF_R))
    println("  fitted: the soles ${gap * 1000.0} mm apart in height")
    check("fitted, its soles stand at one height, to 1 mm", gap < 0.001)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    k = 0
    while k < 120 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    left = load_of(r, human.BONE_CALF_L)
    right = load_of(r, human.BONE_CALF_R)
    share = 0.0
    if left + right > 0.0 { share = left / (left + right) }
    println("  standing 2 s: the left foot carries ${left} N, the right ${right} N (the left's share ${share})")
    check("standing, each foot carries between 40% and 60% of the two's load", share > 0.4 && share < 0.6)
    engine.engine_free(e)
    motion.motion_free(m)
    figure.figures_free(e)
    if g_failures == 0 {
        println("stance_feet: all checks passed (${g_checks})")
        return
    }
    println("stance_feet: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
