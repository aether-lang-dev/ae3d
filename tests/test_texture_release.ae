// A texture is the renderer's for as long as a model it draws uses it, and
// no longer, on both renderers. A renderer holds a texture once a material
// that names it, however many models share that material, so:
//   - two models sharing a material, one taken out: the other keeps drawing
//     its texture (it was deleted under it on OpenGL);
//   - both out: the texture is let go (a world streamed past, its cells'
//     textures were held for ever on Vulkan);
//   - one put back: its texture is there again (it kept the deleted one's
//     id and drew nothing);
//   - a model whose geometry changed, uploaded again: the same texture, not
//     a second read of its file.
// Headless; a renderer that will not start here is said and left out.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.png
import ae3d.geometry

const WIDTH = 64
const HEIGHT = 64
const IMAGE = "build/texture_release.png"

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

var g_checks = 0
var g_failures = 0
var g_gl: ptr = null
var g_vk: ptr = null

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

write_image() {
    rgba = calloc(8 * 8, 4)
    i = 0
    while i < 64 {
        mem.set_byte(rgba, i * 4, 200)
        mem.set_byte(rgba, i * 4 + 1, 40)
        mem.set_byte(rgba, i * 4 + 2, 40)
        mem.set_byte(rgba, i * 4 + 3, 255)
        i = i + 1
    }
    png.write(IMAGE, rgba, 8, 8)
    free(rgba)
}

textures() -> int {
    if g_gl != null { return gl.renderer_texture_count(g_gl as *GLRenderer) }
    return vulkan.renderer_texture_count(g_vk as *VKRenderer)
}

run(backend: *Backend, name: string) {
    shared = core.material_new("brick")
    core.material_set_texture_path(shared, IMAGE)
    a = loader.quad(2.0, 2.0)
    b = loader.quad(2.0, 2.0)
    a.material = shared
    b.material = shared
    core.model_own_material(a, shared)
    base = textures()
    core.backend_add_model(backend, a)
    core.backend_add_model(backend, b)
    check("${name}: two models sharing a material hold its texture once (${textures() - base})", textures() - base == 1)
    core.backend_remove_model(backend, b)
    check("${name}: one taken out, the other still has its texture", textures() - base == 1 && shared.texture_id != 0)
    core.backend_remove_model(backend, a)
    check("${name}: both out, the texture is let go (${textures() - base})", textures() - base == 0)
    core.backend_add_model(backend, a)
    check("${name}: one put back, its texture is there again", textures() - base == 1 && shared.texture_id != 0)

    // Its geometry changed: uploaded again, with the texture it had.
    held = shared.texture_id
    geometry.mesh_set_pos(a.mesh, 0, 0.0 - 1.5, 0.0, 0.0 - 1.5)
    core.model_geometry_changed(a)
    cam = core.camera_new(WIDTH, HEIGHT)
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0)
    core.backend_render(backend, cam, light)
    check("${name}: uploaded again for its new geometry, the same texture kept", textures() - base == 1 && shared.texture_id == held)
    core.backend_remove_model(backend, a)
    check("${name}: and let go when it leaves", textures() - base == 0)
    core.model_free(a)
    core.model_free(b)
    core.light_free(light)
    core.camera_free(cam)
}

main() {
    println("texture_release: a texture held while it is drawn, on both renderers")
    write_image()
    drew = false
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context != null {
        renderer = gl.renderer_new()
        pass = gl.backend(renderer)
        if core.backend_init(&pass, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            g_gl = renderer as ptr
            run(&pass, "opengl")
            g_gl = null
            drew = true
            core.backend_cleanup(&pass)
            offscreen.target_destroy(target)
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    } else {
        println("texture_release: no OpenGL context; OpenGL is not checked")
    }
    if vulkan.available() {
        vr = vulkan.renderer_new()
        vpass = vulkan.backend(vr)
        if core.backend_init(&vpass, null, WIDTH, HEIGHT) {
            g_vk = vr as ptr
            run(&vpass, "vulkan")
            g_vk = null
            drew = true
            core.backend_cleanup(&vpass)
        }
        vulkan.renderer_free(vr)
    } else {
        println("texture_release: no Vulkan driver; Vulkan is not checked")
    }
    if !drew {
        println("texture_release: SKIP neither renderer would start here")
    } else if g_failures == 0 {
        println("texture_release: all checks passed (${g_checks})")
    } else {
        println("texture_release: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
