// Two modules writing the hips in the pose phase (#673), held to numbers.
// The box man walked by ae3d.locomotion, its feet on a 10-degree slope by
// ae3d.feet (which lowers its pelvis for the lower foot), asked to step on
// and stop again every second, standing in Idle between -- the clip that
// does not key the hips' place, as the Walk does. No window.
//
//   - over 12 s the hips do not drift: standing at the end of each
//     second, each stop made at the same moment of the walk, their height
//     over the walker's floor, less the feet's pelvis drop, is the same to
//     1 cm, and never more than 10 cm under where they first stood (the
//     walk's own dip): neither module's move piles up on the other's. Each module undid
//     last frame's write only where the hips still held exactly what it
//     had written; the other's write in between defeated that, the pelvis
//     drop and the lean were added on top of themselves frame on frame,
//     and in the plaza a standing walker's feet were set 13 cm under the
//     ground;
//   - no foot goes under the slope by more than 2 cm.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.locomotion
import ae3d.feet

extern exit(code: int)
extern tan(x: float) -> float

const STEP = 0.016666666666666666
const SLOPE = 0.1763                   // tan(10 degrees)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The slope across the walker's way, through its floor where it stands:
// the controller walks a flat floor, so ground falling away from under it
// as it wandered off sideways left its legs too short for its lower foot.
slope(state: ptr, x: float, z: float) -> float {
    return (x - behaviour.object_world_position(state as *GameObject).x) * SLOPE
}

bone(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

main() {
    println("hips_writers: locomotion and the feet writing the hips together (#673)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Walker", "tests/fixtures/gltf/humanoid.glb")
    c = physics.character_controller(o, 0.3, 1.8)
    l = locomotion.attach(e, o, c, "Idle", "Walk", "Run")
    sk = figure.skeleton(figure.figure_of(o))
    f = feet.attach(e, o.model as *Model, bone(sk, "mixamorig:Hips"),
                    bone(sk, "mixamorig:LeftUpLeg"), bone(sk, "mixamorig:LeftLeg"), bone(sk, "mixamorig:LeftFoot"),
                    bone(sk, "mixamorig:RightUpLeg"), bone(sk, "mixamorig:RightLeg"), bone(sk, "mixamorig:RightFoot"))
    feet.set_figure(f, figure.figure_of(o))
    feet.ground_height(f, slope, o as ptr)
    hips = bone(sk, "mixamorig:Hips")
    feet_l = bone(sk, "mixamorig:LeftFoot")
    feet_r = bone(sk, "mixamorig:RightFoot")
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    core.model_sync_transform(hips)
    floor0 = behaviour.object_world_position(o).y
    start = hips.world_position.y - floor0 - feet.pelvis_offset(f)
    lowest = 1000.0
    highest = 0.0 - 1000.0
    stood_low = 1000.0
    stood_high = 0.0 - 1000.0
    under = 0.0
    k = 0
    while k < 720 {
        // A step on for a fifth of each second, then standing.
        if k % 60 == 0 { locomotion.set_input(l, core.vec3(0.0, 0.0, 1.0), false) }
        if k % 60 == 12 { locomotion.set_input(l, core.vec3(0.0, 0.0, 0.0), false) }
        engine.engine_update(e, STEP)
        core.model_sync_transform(hips)
        floor = behaviour.object_world_position(o).y
        h = hips.world_position.y - floor - feet.pelvis_offset(f)
        if h < lowest { lowest = h }
        if h > highest { highest = h }
        // Standing, the last frame of each second.
        if k % 60 == 59 {
            if h < stood_low { stood_low = h }
            if h > stood_high { stood_high = h }
        }
        core.model_sync_transform(feet_l)
        core.model_sync_transform(feet_r)
        dl = slope(o as ptr, feet_l.world_position.x, feet_l.world_position.z) - feet_l.world_position.y
        dr = slope(o as ptr, feet_r.world_position.x, feet_r.world_position.z) - feet_r.world_position.y
        if dl > under { under = dl }
        if dr > under { under = dr }
        k = k + 1
    }
    core.model_sync_transform(hips)
    end = hips.world_position.y - behaviour.object_world_position(o).y - feet.pelvis_offset(f)
    println("  the hips, less the pelvis drop (${feet.pelvis_offset(f) * 100.0} cm at the end), ${start} m over the floor at the start, ${end} at the end, ${lowest} to ${highest} between, standing ${stood_low} to ${stood_high}; a foot ${under * 100.0} cm under the slope at worst")
    check("the hips do not drift: standing at the end of each second within 1 cm of each other, never 10 cm under where they first stood",
          stood_high - stood_low < 0.01 && lowest > start - 0.1)
    check("no foot goes under the slope by more than 2 cm", under < 0.02)
    feet.feet_free(f)
    locomotion.locomotion_free(l)
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    if g_failures == 0 {
        println("hips_writers: all checks passed (${g_checks})")
        return
    }
    println("hips_writers: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
