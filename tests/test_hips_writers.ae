// The hips through stop and go on a slope (#673, #860), held to numbers.
// The UE5 mannequin on 100STYLE's neutral gaits (ae3d.character: one
// animator writing the pose, ikrig's feet lowering the pelvis for the lower
// foot), its capsule on a 10-degree slope across its way, asked to step on
// for a fifth of each second and stand the rest, for 12 s. No window.
// (Before the pipeline, ae3d.locomotion and ae3d.feet both wrote the hips;
// each undid last frame's write only where the hips still held exactly what
// it had written, the other's write in between defeated that, and in the
// plaza a standing walker's feet were set 13 cm under the ground.)
//
//   - over 12 s the hips do not drift: standing at the end of each second,
//     their height over the figure's floor, less the feet's pelvis drop, is
//     the same to 1 cm, and never more than 10 cm under where they first
//     stood (the walk's own dip);
//   - no sole goes under the slope by more than 2 cm.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const SLOPE = 0.17453293               // 10 degrees, rising along +x

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The slope's height at x.
slope_at(x: float) -> float { return x * core.tan_of(SLOPE) }

// The pelvis over the figure's floor, less the feet's drop.
hips_over(c: *Character, drawn: ptr, worlds: ptr) -> float {
    a = character.animator_of(c)
    r = animator.rig(a)
    pose.read(r, drawn)
    pose.world(r, drawn, worlds)
    pelvis = ikrig.to_ground(r, pose.translation(worlds, pose.human(r, pose.PELVIS)))
    floor = behaviour.object_position(character.object_of(c)).y
    return pelvis.y - floor - ikrig.feet_drop(character.feet_of(c))
}

main() {
    println("hips_writers: the hips through stop and go on a 10-degree slope (#673, #860)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    // A slab 40 m square, its top through the origin, tilted about z.
    ground = engine.object(e, "Slope", loader.cube(1.0))
    behaviour.object_set_rotation(ground, core.quat_rotate(SLOPE, core.vec3(0.0, 0.0, 1.0)))
    behaviour.object_set_position(ground, core.quat_apply(core.quat_rotate(SLOPE, core.vec3(0.0, 0.0, 1.0)), core.vec3(0.0, 0.0 - 0.5, 0.0)))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(0.0, 0.3, 0.0))
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    drawn = pose.new(r)
    worlds = pose.new(r)
    still = core.vec3(0.0, 0.0, 0.0)
    ahead = core.vec3(0.0, 0.0, 1.0)
    k = 0
    while k < 90 {
        character.move(c, still, still)
        engine.engine_update(e, STEP)
        k = k + 1
    }
    start = hips_over(c, drawn, worlds)
    lowest = 1000.0
    highest = 0.0 - 1000.0
    stood_low = 1000.0
    stood_high = 0.0 - 1000.0
    under = 0.0
    k = 0
    while k < 720 {
        // A step on for a fifth of each second, then standing.
        asked = still
        if k % 60 < 12 { asked = ahead }
        character.move(c, asked, still)
        engine.engine_update(e, STEP)
        h = hips_over(c, drawn, worlds)
        if h < lowest { lowest = h }
        if h > highest { highest = h }
        if k % 60 == 59 {
            if h < stood_low { stood_low = h }
            if h > stood_high { stood_high = h }
        }
        side = 0
        while side < 2 {
            heel, pad, toe = ikrig.feet_soles(f, r, worlds, side)
            points = [heel, pad, toe]
            n = 0
            while n < 3 {
                d = slope_at(points[n].x) - points[n].y
                if d > under { under = d }
                n = n + 1
            }
            side = side + 1
        }
        k = k + 1
    }
    at = behaviour.object_position(o)
    println("  the hips, less the pelvis drop (${ikrig.feet_drop(f) * 100.0} cm at the end), ${start} m over the floor at the start, ${lowest} to ${highest} between, standing ${stood_low} to ${stood_high}; a sole ${under * 100.0} cm under the slope at worst; ended at (${at.x}, ${at.y}, ${at.z})")
    check("the hips do not drift: standing at the end of each second within 1 cm of each other, never 10 cm under where they first stood",
          stood_high - stood_low < 0.01 && lowest > start - 0.1)
    check("no sole goes under the slope by more than 2 cm", under < 0.02)
    pose.release(drawn)
    pose.release(worlds)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("hips_writers: all checks passed (${g_checks})")
        return
    }
    println("hips_writers: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
