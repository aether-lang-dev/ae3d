// Character controllers meeting each other (#662), held to numbers. No
// window, the engine stepped by hand. Each character 0.3 m by 1.8 m.
//
//   - two solid (character_set_solid, as locomotion's walkers are) walking
//     at each other head on (their lanes 5 cm apart) at
//     1.5 m/s: their axes never come nearer than their two radii, less the
//     mover's 5 mm slop and a millimetre, and each gets past the other,
//     1.5 m beyond where they met. Until the capsules met each other, they
//     walked through;
//   - a third, not solid (the default, and a walker handed to its ragdoll),
//     is walked through by a fourth as if not there: the fourth keeps to its
//     line within a millimetre;
//   - two people on the pipeline (ae3d.character: the UE5 mannequin on
//     100STYLE's neutral gaits, its feet on ikrig's), their capsules solid,
//     walked head on with no steering (character.set_avoidance off), are
//     drawn apart as their
//     capsules are: their drawn pelvises never nearer than 0.45 m (two
//     radii, less the hips' sway). On the retired locomotion module's foot hold a drawn
//     body was carried up to 0.5 m ahead of a capsule its neighbour held
//     off, and two walkers whose capsules kept apart were drawn half inside
//     each other.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const WALK = 1.5
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

walker(e: *Engine, name: string, at: Vec3) -> *CharacterController {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    return physics.character_controller(o, 0.3, 1.8)
}

level_gap(a: *CharacterController, b: *CharacterController) -> float {
    pa = physics.character_feet(a)
    pb = physics.character_feet(b)
    return core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z))
}

// A person at `at` facing `facing`, its avoidance off (no steering).
person(e: *Engine, g: *Gaits, name: string, at: Vec3, facing: Vec3) -> *Character {
    c = character.humanoid(e, name, MANNEQUIN, g)
    if c == null { return null }
    o = character.object_of(c)
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, core.quat_rotate(core.atan2_of(facing.x, facing.z), core.vec3(0.0, 1.0, 0.0)))
    // Solid, as a crowd's people are: met by each other's capsules.
    physics.character_set_solid(physics.character_of(o), true)
    character.set_avoidance(c, false, 0.0)
    return c
}

// Its pelvis as drawn, the ground's.
pelvis_of(c: *Character, drawn: ptr, worlds: ptr) -> Vec3 {
    r = animator.rig(character.animator_of(c))
    pose.read(r, drawn)
    pose.world(r, drawn, worlds)
    return ikrig.to_ground(r, pose.translation(worlds, pose.human(r, pose.PELVIS)))
}

// Two people head on, 5 cm off each other's line, walking at 1.5 m/s for
// 6 s: their drawn pelvises' least distance apart, level, and how far each
// went along its way.
walked_apart() -> (float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    east = core.vec3(1.0, 0.0, 0.0)
    west = core.vec3(0.0 - 1.0, 0.0, 0.0)
    ca = person(e, g, "A", core.vec3(0.0 - 4.0, 0.0, 0.0), east)
    cb = person(e, g, "B", core.vec3(4.0, 0.0, 0.05), west)
    if ca == null || cb == null {
        println("  no walkers: ${character.error()}")
        exit(1)
    }
    r = animator.rig(character.animator_of(ca))
    drawn = pose.new(r)
    worlds = pose.new(r)
    least = 1000.0
    k = 0
    while k < 360 {
        character.move(ca, core.v3_mul(east, WALK), core.vec3(0.0, 0.0, 0.0))
        character.move(cb, core.v3_mul(west, WALK), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        pa = pelvis_of(ca, drawn, worlds)
        pb = pelvis_of(cb, drawn, worlds)
        d = core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z))
        if k > 10 && d < least { least = d }
        k = k + 1
    }
    went_a = behaviour.object_position(character.object_of(ca)).x + 4.0
    went_b = 4.0 - behaviour.object_position(character.object_of(cb)).x
    pose.release(drawn)
    pose.release(worlds)
    character.character_free(ca)
    character.character_free(cb)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return least, went_a, went_b
}

main() {
    println("characters_meet: character controllers meeting each other")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    a = walker(e, "A", core.vec3(0.0 - 3.0, 0.0, 0.0))
    b = walker(e, "B", core.vec3(3.0, 0.0, 0.05))
    physics.character_set_solid(a, true)
    physics.character_set_solid(b, true)
    post = walker(e, "Not solid", core.vec3(0.0, 0.0, 6.0))
    through = walker(e, "Through", core.vec3(0.0 - 3.0, 0.0, 6.0))
    physics.character_set_solid(through, true)
    nearest = 1000.0
    off_line = 0.0
    k = 0
    while k < 240 {
        physics.character_move(a, core.vec3(WALK, 0.0, 0.0), 0.0, STEP)
        physics.character_move(b, core.vec3(0.0 - WALK, 0.0, 0.0), 0.0, STEP)
        physics.character_move(post, core.vec3(0.0, 0.0, 0.0), 0.0, STEP)
        physics.character_move(through, core.vec3(WALK, 0.0, 0.0), 0.0, STEP)
        engine.engine_update(e, STEP)
        g = level_gap(a, b)
        if g < nearest { nearest = g }
        d = core.abs_of(physics.character_feet(through).z - 6.0)
        if d > off_line { off_line = d }
        k = k + 1
    }
    pa = physics.character_feet(a)
    pb = physics.character_feet(b)
    println("  head on: their axes ${nearest} m apart at the nearest (two radii 0.6); A ended at x ${pa.x}, B at ${pb.x}")
    println("  through one not solid: ${off_line * 1000.0} mm off its line at most, ended at x ${physics.character_feet(through).x}")
    check("walking at each other, their axes never nearer than their two radii, less the slop and a millimetre", nearest > 0.594)
    check("and each gets past the other, 1.5 m beyond where they met", pa.x > 1.5 && pb.x < 0.0 - 1.5)
    check("one not solid is walked through: the walker keeps to its line within a millimetre", off_line < 0.001 && physics.character_feet(through).x > 2.5)
    physics.character_free(a)
    physics.character_free(b)
    physics.character_free(post)
    physics.character_free(through)
    engine.engine_free(e)
    hips, went_a, went_b = walked_apart()
    println("  two people head on, not steering: their drawn pelvises ${hips} m apart at the nearest; they went ${went_a} and ${went_b} m along their ways")
    check("two walkers on their figures are drawn apart as their capsules are, hips never nearer than 0.45 m", hips > 0.45)
    if g_failures == 0 {
        println("characters_meet: all checks passed (${g_checks})")
        return
    }
    println("characters_meet: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
