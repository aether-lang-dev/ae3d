// Character controllers meeting each other (#662), held to numbers. No
// window, the engine stepped by hand. Each character 0.3 m by 1.8 m.
//
//   - two solid (character_set_solid, as locomotion's walkers are) walking
//     at each other head on (their lanes 5 cm apart) at
//     1.5 m/s: their axes never come nearer than their two radii, less the
//     mover's 5 mm slop and a millimetre, and each gets past the other,
//     1.5 m beyond where they met. Until the capsules met each other, they
//     walked through;
//   - a third, not solid (the default, and a walker handed to its ragdoll),
//     is walked through by a fourth as if not there: the fourth keeps to its
//     line within a millimetre;
//   - two box men walked by ae3d.locomotion, head on with no steering, are
//     drawn apart as their capsules are: their drawn hips never nearer than
//     0.45 m (two radii, less the hips' sway). The foot hold carried a drawn
//     body up to 0.5 m ahead of a capsule its neighbour held off, and two
//     walkers whose capsules kept apart were drawn half inside each other.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.locomotion

extern exit(code: int)

const STEP = 0.016666666666666666
const WALK = 1.5

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

walker(e: *Engine, name: string, at: Vec3) -> *CharacterController {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    return physics.character_controller(o, 0.3, 1.8)
}

level_gap(a: *CharacterController, b: *CharacterController) -> float {
    pa = physics.character_feet(a)
    pb = physics.character_feet(b)
    return core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z))
}

// A box man walked by locomotion from `at` toward `going`, and its hips.
box_man(e: *Engine, name: string, at: Vec3, going: Vec3) -> *Model {
    o = figure.figure(e, name, "tests/fixtures/gltf/humanoid.glb")
    behaviour.object_set_position(o, at)
    c = physics.character_controller(o, 0.3, 1.8)
    l = locomotion.attach(e, o, c, "Idle", "Walk", "Run")
    locomotion.set_input(l, going, false)
    sk = figure.skeleton(figure.figure_of(o))
    return skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Hips"))
}

// Two box men head on, 5 cm off each other's line: their drawn hips' least
// distance apart, level.
walked_apart() -> float {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    a = box_man(e, "A", core.vec3(0.0 - 4.0, 0.0, 0.0), core.vec3(1.0, 0.0, 0.0))
    b = box_man(e, "B", core.vec3(4.0, 0.0, 0.05), core.vec3(0.0 - 1.0, 0.0, 0.0))
    least = 1000.0
    k = 0
    while k < 360 {
        engine.engine_update(e, STEP)
        core.model_sync_transform(a)
        core.model_sync_transform(b)
        pa = a.world_position
        pb = b.world_position
        d = core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z))
        if k > 10 && d < least { least = d }
        k = k + 1
    }
    figure.figures_free(e)
    engine.engine_free(e)
    return least
}

main() {
    println("characters_meet: character controllers meeting each other")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    a = walker(e, "A", core.vec3(0.0 - 3.0, 0.0, 0.0))
    b = walker(e, "B", core.vec3(3.0, 0.0, 0.05))
    physics.character_set_solid(a, true)
    physics.character_set_solid(b, true)
    post = walker(e, "Not solid", core.vec3(0.0, 0.0, 6.0))
    through = walker(e, "Through", core.vec3(0.0 - 3.0, 0.0, 6.0))
    physics.character_set_solid(through, true)
    nearest = 1000.0
    off_line = 0.0
    k = 0
    while k < 240 {
        physics.character_move(a, core.vec3(WALK, 0.0, 0.0), 0.0, STEP)
        physics.character_move(b, core.vec3(0.0 - WALK, 0.0, 0.0), 0.0, STEP)
        physics.character_move(post, core.vec3(0.0, 0.0, 0.0), 0.0, STEP)
        physics.character_move(through, core.vec3(WALK, 0.0, 0.0), 0.0, STEP)
        engine.engine_update(e, STEP)
        g = level_gap(a, b)
        if g < nearest { nearest = g }
        d = core.abs_of(physics.character_feet(through).z - 6.0)
        if d > off_line { off_line = d }
        k = k + 1
    }
    pa = physics.character_feet(a)
    pb = physics.character_feet(b)
    println("  head on: their axes ${nearest} m apart at the nearest (two radii 0.6); A ended at x ${pa.x}, B at ${pb.x}")
    println("  through one not solid: ${off_line * 1000.0} mm off its line at most, ended at x ${physics.character_feet(through).x}")
    check("walking at each other, their axes never nearer than their two radii, less the slop and a millimetre", nearest > 0.594)
    check("and each gets past the other, 1.5 m beyond where they met", pa.x > 1.5 && pb.x < 0.0 - 1.5)
    check("one not solid is walked through: the walker keeps to its line within a millimetre", off_line < 0.001 && physics.character_feet(through).x > 2.5)
    physics.character_free(a)
    physics.character_free(b)
    physics.character_free(post)
    physics.character_free(through)
    engine.engine_free(e)
    hips = walked_apart()
    println("  two box men head on: their drawn hips ${hips} m apart at the nearest")
    check("two walkers on their figures are drawn apart as their capsules are, hips never nearer than 0.45 m", hips > 0.45)
    if g_failures == 0 {
        println("characters_meet: all checks passed (${g_checks})")
        return
    }
    println("characters_meet: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
