// A state played backward (#947, animator.set_rate below 0): the UE5
// mannequin's UAL2 Hit_Knockback_RM, its root motion taken out, played
// forward 0.5 s and then back at the same rate to its start, as a blade's
// rebound plays its swing back. No window; stepped at 60 Hz.
//
//   - the figure ends where it began (within 1 mm), its root motion run back;
//   - every frame going back is the forward pass's at the same time (within
//     1e-6 rad at every joint);
//   - the take's event fires again as it passes it going back;
//   - its end transition (ENDED) fires at its start.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const FRAMES = 30

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

main() {
    println("animator_back: a state played backward (#947)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    o = figure.figure(e, "Struck", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    t = animator.take(a, "Hit_Knockback_RM", true)
    if t == null {
        println("  the mannequin has no Hit_Knockback_RM")
        exit(1)
    }
    clips.add_event(t, 0.2, "rebound")
    knocked = animator.add_state(a, "knocked", t, false)
    rest = animator.snapshot(a, "rest")
    back_out = animator.add_transition(a, knocked, rest, 0.0)
    animator.transition_when(a, back_out, "", animator.ENDED, 0.0)
    animator.set_root_motion(a, true)
    animator.play(a, knocked, 0.0)
    began = behaviour.object_position(o)
    // Forward, each frame's pose kept.
    kept = pose.new(r)
    forward = list_of_poses(r, FRAMES + 1)
    pose.copy(r, animator.pose_now(a), forward[0])
    k = 1
    fired_forward = false
    while k <= FRAMES {
        engine.engine_update(e, STEP)
        if animator.fired(a, "rebound") { fired_forward = true }
        pose.copy(r, animator.pose_now(a), forward[k])
        k = k + 1
    }
    went = behaviour.object_position(o)
    // And back, at the same rate.
    animator.set_rate(a, knocked, 0.0 - 1.0)
    worst = 0.0
    fired_back = false
    ended_at = 0 - 1
    k = FRAMES - 1
    while k >= 0 {
        engine.engine_update(e, STEP)
        if animator.fired(a, "rebound") { fired_back = true }
        if animator.current(a) == knocked && k >= 1 {
            j = 0
            while j < pose.count(r) {
                d = turned_by(pose.rotation(animator.pose_now(a), j), pose.rotation(forward[k], j))
                if d > worst { worst = d }
                j = j + 1
            }
        } else if animator.current(a) != knocked && ended_at < 0 {
            ended_at = k
        }
        k = k - 1
    }
    // A frame or two more: the clock held at the start, the end transition.
    more = 0
    while more < 3 && animator.current(a) == knocked {
        engine.engine_update(e, STEP)
        more = more + 1
    }
    if animator.current(a) != knocked && ended_at < 0 { ended_at = 0 }
    back = behaviour.object_position(o)
    off = core.v3_len(core.vec3(back.x - began.x, 0.0, back.z - began.z))
    println("  forward 0.5 s it went ${core.v3_len(core.vec3(went.x - began.x, 0.0, went.z - began.z))} m; back, ${off * 1000.0} mm from where it began; a frame going back ${worst} rad off the forward pass's at the most; the event forward ${fired_forward}, back ${fired_back}; ended at its start ${ended_at >= 0 && animator.current(a) == rest}")
    check("played back to its start, the figure ends where it began (within 1 mm)", off < 0.001)
    check("every frame going back is the forward pass's at the same time (within 1e-6 rad)", worst < 0.000001)
    check("its event fires going back as going forward", fired_forward && fired_back)
    check("its end transition fires at its start", ended_at >= 0 && animator.current(a) == rest)
    pose.release(kept)
    k = 0
    while k <= FRAMES {
        pose.release(forward[k])
        k = k + 1
    }
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("animator_back: all checks passed (${g_checks})")
        return
    }
    println("animator_back: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

// `n` poses of rig `r`, new.
list_of_poses(r: *pose.Rig, n: int) -> ptr[] {
    out = calloc_ptrs(n)
    k = 0
    while k < n {
        out[k] = pose.new(r)
        k = k + 1
    }
    return out
}

extern calloc(count: int, size: int) -> ptr

calloc_ptrs(n: int) -> ptr[] { return calloc(n, 8) as ptr[] }
