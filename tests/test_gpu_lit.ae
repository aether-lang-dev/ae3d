// ae3d.shaders.lit through ae3d.gpu: the scene's shaders, written with
// `quote` (step 6), over the three blocks the scene's uniforms are.
//
//   - lit_vertex, lit_plain_vertex, lit_pixel, lit_depth_vertex,
//     lit_depth_plain_vertex and lit_depth_pixel come out as the Vulkan GLSL
//     the generator wrote (src/ae3d/vkspirv/glsl/lit_*_quoted.*) and as the
//     OpenGL GLSL in tests/fixtures/gpu/lit*_gl.*, and glslang and spirv-val
//     pass them;
//   - the pixel shaders link to their vertex shaders with every varying at
//     the hand-written shader's place, and the plain pipelines' and the
//     crowd's vertex shaders hand each on at the same place;
//   - each value is in its block's set: the draw's (0), the camera's (1),
//     the world's (2), as frame.SCENE_SETS orders them;
//   - every value the shaders have is the OpenGL name (lit.gl_name) of a
//     uniform the renderer sets by its hand-written name, so the OpenGL
//     renderer sets them all;
//   - on the CPU, the surface shows its colour, its normal and its motion
//     for capture channels 1, 2 and 3, and the cut's far side and a wound's
//     core are not drawn by either pixel shader.
//
// On a GPU the scene is drawn by test_backend_parity and every frame test.
// AE3D_GPU_WRITE_GOLDEN=1 writes the OpenGL fixtures.
import std.os
import std.fs
import std.file
import std.list
import std.string
import ae3d.gpu
import ae3d.gpu (GpuShader, GpuVal)
import ae3d.shaders.lit
import ae3d.shaders.lit (Draw, DrawMaterial, Surface, Cut, Wounds, Damage, Skin)
import ae3d.shaders.frame
import ae3d.shaders.frame (Eye, ShadowCascades, Grid, WorldState, Weather, Shadow)
import ae3d.shaders.throng
import ae3d.shaders.throng (Throng)
import ae3d.shaderlib
import ae3d.shaderlib (vec2, vec3, vec4, Texture, Floats, Vec4s, ShaderImage, image_new, image_set, image_free, texture_of,
                       splat4, zero_mat4)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }

// glslang -V over `text` (as `stage`), then spirv-val; or, for desktop
// OpenGL's GLSL (`opengl`), glslang's check of it. Skipped where they are
// not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the file at `path`; with `golden` and AE3D_GPU_WRITE_GOLDEN=1
// it is written first.
same_as(text: string, path: string, golden: bool) {
    if golden && os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    held, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == held)
}

// Each shader's GLSL: the Vulkan dialect the generator's, the OpenGL one a
// fixture, both compiled.
written(label: string, generated: string, vk: string, gl: string, stage: string) {
    if vk == "" || gl == "" { println("  emit ${label}: ${gpu.last_error()}") }
    same_as(vk, "src/ae3d/vkspirv/glsl/${generated}.${stage}", false)
    compiles(label, vk, stage, false)
    same_as(gl, "tests/fixtures/gpu/${label}_gl.${stage}", true)
    compiles("${label}_gl", gl, stage, true)
}

// The varying `name` handed on at `at` by the vertex shader written as `text`.
hands_on(text: string, t: string, name: string, at: int) -> bool {
    return string.contains(text, "layout(location = ${at}) out ${t} ${name};") != 0
}

// The varyings the hand-written FRAGMENT_DEFAULT read, at its places.
const VARYINGS[] = ["fragTexCoord", "Normal", "FragPos", "InstanceColor", "FragPosLightSpace", "Occlusion", "ClipNow",
                    "ClipPrev", "BindPos", "ClipLimb", "MaskUV", "ParticleAlpha", "FlipNext"]
const VARYING_TYPES[] = ["vec2", "vec3", "vec3", "vec3", "vec4", "float", "vec4", "vec4", "vec3", "float", "vec2", "float",
                         "vec3"]
const VARYING_COUNT = 13

// Whether the uniform the renderer sets as `name` is, on OpenGL, the
// shaders' value `value`: the name itself, an array's element past the
// first (skin.bones[3] after skin.bones[0]), a light's field.
names(name: string, value: string) -> bool {
    g = lit.gl_name(name)
    if g == value { return true }
    if string.ends_with(g, "[0]") != 0 {
        stem = string.substring(g, 0, string.length(g) - 3)
        return string.starts_with(value, "${stem}[") != 0 && string.ends_with(value, "]") != 0 &&
               string.index_of(string.substring(value, string.length(stem), string.length(value)), ".") < 0
    }
    return false
}

// The hand-written uniform the renderer sets for the shaders' value
// `value`; "" for none.
set_as(value: string) -> string {
    k = 0
    while k < lit.draw_count() {
        if names(lit.draw_uniform(k), value) { return lit.draw_uniform(k) }
        k = k + 1
    }
    k = 0
    while k < frame.view_count() {
        if names(frame.view_uniform(k), value) { return frame.view_uniform(k) }
        k = k + 1
    }
    k = 0
    while k < frame.world_count() {
        if names(frame.world_uniform(k), value) { return frame.world_uniform(k) }
        k = k + 1
    }
    if string.starts_with(value, "world.lights[") != 0 {
        close = string.index_of(value, "]")
        field = string.substring(value, close + 2, string.length(value))
        k = 0
        while k < frame.light_count() {
            if frame.light_field(k) == field {
                hand = "lights${string.substring(value, 12, close + 1)}.${frame.light_uniform(k)}"
                if lit.gl_name(hand) == value { return hand }
            }
            k = k + 1
        }
    }
    return ""
}

// How many of `s`'s values are set by a hand-written name; the first that
// is not into g_unset.
var g_unset = ""
set_count(s: *GpuShader) -> int {
    n = 0
    k = 0
    while k < gpu.uniforms_count(s) {
        if set_as(gpu.uniforms_name(s, k)) != "" { n = n + 1 } else if g_unset == "" { g_unset = gpu.uniforms_name(s, k) }
        k = k + 1
    }
    return n
}

// How many of `s`'s values are in the set their struct's block is.
in_sets(s: *GpuShader) -> int {
    n = 0
    k = 0
    while k < gpu.uniforms_count(s) {
        v = gpu.uniforms_name(s, k)
        want = 0
        if string.starts_with(v, "eye.") != 0 || string.starts_with(v, "cascades.") != 0 ||
           string.starts_with(v, "grid.") != 0 || string.starts_with(v, "probes.") != 0 { want = 1 }
        if string.starts_with(v, "world.") != 0 || string.starts_with(v, "weather.") != 0 { want = 2 }
        if gpu.uniforms_set(s, k) == want { n = n + 1 } else { println("  ${v} in set ${gpu.uniforms_set(s, k)}") }
        k = k + 1
    }
    return n
}

flat_picture(r: float, g: float, b: float, a: float) -> *ShaderImage {
    img = image_new(4, 4)
    y = 0
    while y < 4 {
        x = 0
        while x < 4 {
            image_set(img, x, y, r, g, b, a)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

pixel(draw: Draw, material: DrawMaterial, cut: Cut, wounds: Wounds, eye: Eye, colour: Texture, flat: Texture) -> *GpuShader {
    return lit.lit_pixel(draw, material, Surface { shadows: 0 }, cut, wounds, Damage { on: 0 }, eye, ShadowCascades { on: 0 },
                         Grid { lamp_base: 0 }, WorldState { light_count: 0 }, Weather { fog: 0 }, colour, flat, flat, flat,
                         flat, Vec4s { data: null }, Floats { data: null }, flat, flat, flat, flat, flat)
}

// The scene's varyings at one point: its uv, normal and place, white, its
// bind position and limb, and where it is on the screen now and last frame.
varyings(normal: vec3, bind: vec3, limb: float, now: vec4, prev: vec4) -> *GpuVal {
    v = gpu.vstruct()
    gpu.val_set(v, "fragTexCoord", gpu.v2(0.5, 0.5))
    gpu.val_set(v, "Normal", gpu.v3(normal.x, normal.y, normal.z))
    gpu.val_set(v, "FragPos", gpu.v3(1.0, 0.5, -3.0))
    gpu.val_set(v, "InstanceColor", gpu.v3(1.0, 1.0, 1.0))
    gpu.val_set(v, "FragPosLightSpace", gpu.v4(0.0, 0.0, 0.0, 1.0))
    gpu.val_set(v, "Occlusion", gpu.v1(1.0))
    gpu.val_set(v, "ClipNow", gpu.v4(now.x, now.y, now.z, now.w))
    gpu.val_set(v, "ClipPrev", gpu.v4(prev.x, prev.y, prev.z, prev.w))
    gpu.val_set(v, "BindPos", gpu.v3(bind.x, bind.y, bind.z))
    gpu.val_set(v, "ClipLimb", gpu.v1(limb))
    gpu.val_set(v, "MaskUV", gpu.v2(0.0, 0.0))
    gpu.val_set(v, "ParticleAlpha", gpu.v1(1.0))
    gpu.val_set(v, "FlipNext", gpu.v3(0.0, 0.0, -1.0))
    return v
}

// The surface's colour for capture channel `channel`, or its discarding:
// null when the shader did not draw the point.
run_pixel(s: *GpuShader, v: *GpuVal) -> *GpuVal {
    cx = gpu.cpu_new(s)
    gpu.cpu_set_frag_coord(cx, 10.5, 7.5)
    out = gpu.cpu_run(cx, v)
    if out == null && !gpu.cpu_discarded(cx) { println("  cpu_run: ${gpu.last_error()}") }
    if gpu.cpu_discarded(cx) {
        gpu.val_free(out)
        out = null
    }
    gpu.cpu_free(cx)
    return out
}

near(v: *GpuVal, x: float, y: float, z: float, w: float) -> bool {
    if v == null { return false }
    return absf(gpu.val_x(v) - x) < 1e-5 && absf(gpu.val_y(v) - y) < 1e-5 && absf(gpu.val_z(v) - z) < 1e-5 &&
           absf(gpu.val_w(v) - w) < 1e-5
}

main() {
    println("ae3d.shaders.lit: the scene's shaders")
    blank_draw = Draw { lift: 0.0 }
    vs = lit.lit_vertex(blank_draw, Cut { on: 0 }, Skin {}, Eye { far: 0.0 })
    pv = lit.lit_plain_vertex(blank_draw, Cut { on: 0 }, Skin {}, Eye { far: 0.0 })
    blank = Texture { image: null }
    ps = pixel(blank_draw, DrawMaterial { alpha: 0.0 }, Cut { on: 0 }, Wounds { count: 0 }, Eye { far: 0.0 }, blank, blank)
    dv = lit.lit_depth_vertex(blank_draw, Cut { on: 0 }, Skin {}, Eye { far: 0.0 })
    dpv = lit.lit_depth_plain_vertex(blank_draw, Cut { on: 0 }, Skin {}, Eye { far: 0.0 })
    dp = lit.lit_depth_pixel(Cut { on: 0 }, Wounds { count: 0 })

    // ── The GLSL ──
    check("the surface links to its vertex shader", gpu.link(vs, ps))
    check("the depth pass's pixel shader links to its vertex shader", gpu.link(dv, dp))
    vk_vert = gpu.emit_vertex_glsl(vs, gpu.VULKAN, "", "")
    written("lit", "lit_quoted", vk_vert, gpu.emit_vertex_glsl(vs, gpu.GL, "", ""), "vert")
    vk_plain = gpu.emit_vertex_glsl(pv, gpu.VULKAN, "", "")
    written("lit_plain", "lit_plain_quoted", vk_plain, gpu.emit_vertex_glsl(pv, gpu.GL, "", ""), "vert")
    written("lit", "lit_quoted", gpu.emit_glsl(ps, gpu.VULKAN), gpu.emit_glsl(ps, gpu.GL), "frag")
    vk_depth = gpu.emit_vertex_glsl(dv, gpu.VULKAN, "", "")
    written("lit_depth", "lit_depth_quoted", vk_depth, gpu.emit_vertex_glsl(dv, gpu.GL, "", ""), "vert")
    vk_depth_plain = gpu.emit_vertex_glsl(dpv, gpu.VULKAN, "", "")
    written("lit_depth_plain", "lit_depth_plain_quoted", vk_depth_plain, gpu.emit_vertex_glsl(dpv, gpu.GL, "", ""), "vert")
    written("lit_depth", "lit_depth_quoted", gpu.emit_glsl(dp, gpu.VULKAN), gpu.emit_glsl(dp, gpu.GL), "frag")

    // ── The varyings, at the hand-written places ──
    cv = throng.crowd_vertex(Throng { frames: 0 }, Eye { far: 0.0 }, Shadow { reach: splat4(0.0) }, blank)
    cpv = throng.crowd_pull_vertex(Throng { frames: 0 }, Eye { far: 0.0 }, Shadow { reach: splat4(0.0) }, blank,
                                   Floats { data: null }, Vec4s { data: null }, Floats { data: null })
    vk_crowd = gpu.emit_vertex_glsl(cv, gpu.VULKAN, "", "")
    vk_pull = gpu.emit_vertex_glsl(cpv, gpu.VULKAN, "", "")
    placed = 0
    plain_too = 0
    crowd_too = 0
    k = 0
    while k < VARYING_COUNT {
        // The light-space place the cascades made unread (#469), still
        // handed on at its place.
        want = k
        if VARYINGS[k] == "FragPosLightSpace" { want = 0 - 1 }
        if gpu.varying_location(ps, VARYINGS[k]) == want { placed = placed + 1 } else {
            println("  ${VARYINGS[k]} at ${gpu.varying_location(ps, VARYINGS[k])}")
        }
        if hands_on(vk_vert, VARYING_TYPES[k], VARYINGS[k], k) && hands_on(vk_plain, VARYING_TYPES[k], VARYINGS[k], k) {
            plain_too = plain_too + 1
        }
        // The crowd hands on what a figure has (not its mask's uv or its
        // flipbook), at the same places.
        if VARYINGS[k] == "MaskUV" || VARYINGS[k] == "FlipNext" || VARYINGS[k] == "ParticleAlpha" ||
           (hands_on(vk_crowd, VARYING_TYPES[k], VARYINGS[k], k) && hands_on(vk_pull, VARYING_TYPES[k], VARYINGS[k], k)) {
            crowd_too = crowd_too + 1
        }
        k = k + 1
    }
    check("the surface reads 12 of its 13 varyings at FRAGMENT_DEFAULT's places, not the light-space one (${placed} of 13)", placed == VARYING_COUNT)
    check("the skinned and the plain vertex shaders hand each on there (${plain_too} of 13)", plain_too == VARYING_COUNT)
    check("and the crowd's two lit vertex shaders those a figure has (${crowd_too} of 13)", crowd_too == VARYING_COUNT)
    check("the depth pass's reads the bind position and the limb at 0 and 1, where every depth vertex shader hands them on",
          gpu.varying_location(dp, "BindPos") == 0 && gpu.varying_location(dp, "ClipLimb") == 1 &&
          hands_on(vk_depth, "vec3", "BindPos", 0) && hands_on(vk_depth, "float", "ClipLimb", 1) &&
          hands_on(vk_depth_plain, "vec3", "BindPos", 0) && hands_on(vk_depth_plain, "float", "ClipLimb", 1))

    // ── The blocks ──
    total = gpu.uniforms_count(ps) + gpu.uniforms_count(vs) + gpu.uniforms_count(pv) + gpu.uniforms_count(dv) +
            gpu.uniforms_count(dpv) + gpu.uniforms_count(dp)
    sets = in_sets(ps) + in_sets(vs) + in_sets(pv) + in_sets(dv) + in_sets(dpv) + in_sets(dp)
    check("each value is in its block's set, the draw's 0, the camera's 1, the world's 2 (${sets} of ${total})",
          sets == total && total > 0)
    check("the surface reads the draw's, the camera's and the world's blocks and the scene's images where they were",
          string.contains(gpu.emit_glsl(ps, gpu.VULKAN), "layout(std140, set = 1, binding = 0) uniform CameraBlock {") != 0 &&
          string.contains(gpu.emit_glsl(ps, gpu.VULKAN), "layout(std140, set = 2, binding = 0) uniform WorldBlock {") != 0 &&
          string.contains(gpu.emit_glsl(ps, gpu.VULKAN), "layout(set = 1, binding = 1) uniform sampler2D shadow_map;") != 0 &&
          string.contains(gpu.emit_glsl(ps, gpu.VULKAN), "layout(set = 2, binding = 1) uniform sampler2D sky_light;") != 0)

    // ── OpenGL's names ──
    check("OpenGL finds viewPos as eye.position, lights[3].color as world.lights[3].colour, bones as skin.bones[0], shadowMap as shadow_map",
          lit.gl_name("viewPos") == "eye.position" && lit.gl_name("lights[3].color") == "world.lights[3].colour" &&
          lit.gl_name("bones") == "skin.bones[0]" && lit.gl_name("shadowMap") == "shadow_map" &&
          lit.gl_name("lights[12].isDirectional") == "world.lights[12].kind")
    check("and a uniform the shaders do not have by the name it is set by", lit.gl_name("crowdTravel") == "crowdTravel" &&
          lit.gl_name("lights[3].nothing") == "lights[3].nothing")
    covered = set_count(ps) + set_count(vs) + set_count(pv) + set_count(dv) + set_count(dpv) + set_count(dp)
    check("every value of the six shaders is a uniform the renderer sets by its hand-written name (${covered} of ${total}; ${g_unset})",
          covered == total)

    // ── On the CPU ──
    eye = Eye { position: vec3(0.0, 1.0, 2.0), far: 100.0, jitter: vec2(0.01, -0.02), screen_size: vec2(64.0, 36.0) }
    red = flat_picture(0.8, 0.4, 0.2, 1.0)
    grey = flat_picture(0.5, 0.5, 0.5, 1.0)
    colour = texture_of(red)
    flat = texture_of(grey)
    material = DrawMaterial { diffuse: vec3(0.5, 1.0, 0.25), alpha: 1.0, exposure: 1.0 }
    normal = vec3(0.0, 0.6, 0.8)
    now = vec4(vec3(0.2, -0.1, 0.5), 2.0)
    prev = vec4(vec3(0.1, 0.1, 0.5), 2.0)
    // velocity: the point's place on the screen now, less the jitter, less last frame's.
    vx = (0.2 / 2.0 * 0.5 + 0.5 - 0.01) - (0.1 / 2.0 * 0.5 + 0.5)
    vy = (0.0 - 0.1 / 2.0 * 0.5 + 0.5 + 0.02) - (0.1 / 2.0 * 0.5 + 0.5)
    seen = 0
    moved = 0
    channel = 1
    while channel <= 3 {
        e = eye
        e.capture = channel
        s = pixel(blank_draw, material, Cut { on: 0 }, Wounds { count: 0 }, e, colour, flat)
        _l = gpu.link(vs, s)
        v = varyings(normal, vec3(0.0, 0.0, 0.0), 0.0, now, prev)
        out = run_pixel(s, v)
        if out != null && gpu.val_is_struct(out) {
            c = gpu.val_field(out, "colour")
            if channel == 1 && near(c, 0.4, 0.4, 0.05, 1.0) { seen = seen + 1 }
            if channel == 2 && near(c, 0.5, 0.8, 0.9, 1.0) { seen = seen + 1 }
            if channel == 3 && near(c, vx * 64.0 / 200.0 + 0.5, vy * 36.0 / 200.0 + 0.5, 0.0, 1.0) { seen = seen + 1 }
            vel = gpu.val_field(out, "velocity")
            if vel != null && absf(gpu.val_x(vel) - vx) < 1e-6 && absf(gpu.val_y(vel) - vy) < 1e-6 { moved = moved + 1 }
            if seen < channel { println("  channel ${channel}: ${gpu.val_x(c)} ${gpu.val_y(c)} ${gpu.val_z(c)} ${gpu.val_w(c)}") }
        }
        gpu.val_free(out)
        gpu.val_free(v)
        gpu.shader_free(s)
        channel = channel + 1
    }
    check("the surface shows its colour, its normal and its motion for capture channels 1, 2 and 3 (${seen} of 3)", seen == 3)
    check("and hands on its motion with each (${moved} of 3)", moved == 3)

    // The cut: a limb's point past the plane is not drawn, one before it
    // and a point off the limb are; a wound's core is a hole.
    cut = Cut { on: 1, plane: vec4(vec3(1.0, 0.0, 0.0), 0.25), detached: 0 }
    s = pixel(blank_draw, material, cut, Wounds { count: 0 }, eye, colour, flat)
    _c = gpu.link(vs, s)
    dcut = lit.lit_depth_pixel(cut, Wounds { count: 0 })
    _d = gpu.link(dv, dcut)
    drawn = 0
    k = 0
    while k < 3 {
        bind = vec3(0.5, 0.0, 0.0)
        limb = 1.0
        if k == 1 { bind = vec3(0.0, 0.0, 0.0) }
        if k == 2 { limb = 0.0 }
        v = varyings(normal, bind, limb, now, prev)
        out = run_pixel(s, v)
        d = gpu.vstruct()
        gpu.val_set(d, "BindPos", gpu.v3(bind.x, bind.y, bind.z))
        gpu.val_set(d, "ClipLimb", gpu.v1(limb))
        dcx = gpu.cpu_new(dcut)
        dout = gpu.cpu_run(dcx, d)
        gone = gpu.cpu_discarded(dcx)
        if k == 0 && out == null && gone { drawn = drawn + 1 }
        if k > 0 && out != null && !gone { drawn = drawn + 1 }
        gpu.val_free(out)
        gpu.val_free(dout)
        gpu.val_free(d)
        gpu.val_free(v)
        gpu.cpu_free(dcx)
        k = k + 1
    }
    check("the cut's far side is drawn by neither pixel shader, its near side and a point off the limb by both (${drawn} of 3)",
          drawn == 3)
    gpu.shader_free(s)
    gpu.shader_free(dcut)
    gpu.shader_free(cpv)
    gpu.shader_free(cv)
    gpu.shader_free(dp)
    gpu.shader_free(dpv)
    gpu.shader_free(dv)
    gpu.shader_free(ps)
    gpu.shader_free(pv)
    gpu.shader_free(vs)
    image_free(grey)
    image_free(red)

    if g_failures > 0 {
        println("test_gpu_lit: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("test_gpu_lit: all checks passed (${g_checks})")
}
