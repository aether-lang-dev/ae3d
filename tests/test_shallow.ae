// ci: optimised -- its run is CPU work -O0 makes three to six times slower
// Shallow water over the ground (#744), held to numbers:
//
//   - a lake over a bumpy bed stays a lake: its surface level to a tenth of
//     a millimetre and still, ten seconds on;
//   - a dam breaking into a dry channel keeps its water: the volume a
//     minute on is the volume, to a part in a hundred thousand, and no cell
//     ever holds less than none;
//   - a small wave on a metre of still water runs at sqrt(g h), 3.13 m/s,
//     within a tenth;
//   - a wave run up a beach stops on it: the water ends at the still level,
//     none above it, and the wet edge no further up the slope than the
//     wave carried it;
//   - and the dam's front over a dry bed runs out at about two thirds of
//     sqrt(g h0), under Ritter's 2 sqrt(g h0): the scheme has no momentum
//     advection and a little viscosity, and a dry-bed front is where that
//     shows.
import std.os
import ae3d.shallow

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

abs_of(v: float) -> float {
    if v < 0.0 { return 0.0 - v }
    return v
}

extern sqrt(x: float) -> float
extern sin(x: float) -> float
extern cos(x: float) -> float

flat(context: ptr, x: float, z: float) -> float { return 0.0 }

bumpy(context: ptr, x: float, z: float) -> float {
    return 0.3 + 0.3 * sin(x * 0.7) * cos(z * 0.9)
}

// A beach: level at 0 to x = 0, rising one in four past it.
beach(context: ptr, x: float, z: float) -> float {
    if x < 0.0 { return 0.0 }
    return x * 0.25
}

lake_checks() {
    s = shallow.shallow_new(64, 32.0, 0.0, 0.0)
    shallow.shallow_ground_from(s, bumpy, null)
    shallow.shallow_fill_box(s, 0.0 - 100.0, 0.0 - 100.0, 100.0, 100.0, 1.0)
    t = 0
    while t < 600 {
        shallow.shallow_step(s, 1.0 / 60.0)
        t = t + 1
    }
    worst = 0.0
    j = 0
    while j < 64 {
        i = 0
        while i < 64 {
            x = shallow.shallow_origin_x(s) + ((i as float) + 0.5) * 0.5
            z = shallow.shallow_origin_z(s) + ((j as float) + 0.5) * 0.5
            off = abs_of(shallow.shallow_level(s, x, z) - 1.0)
            if off > worst { worst = off }
            i = i + 1
        }
        j = j + 1
    }
    println("  a lake to 1 m over a bed of 0 to 0.6 m: its surface off level by ${worst * 1000.0} mm ten seconds on")
    check("a lake over a bumpy bed stays level and still", worst < 0.0001)
    shallow.shallow_free(s)
}

// The deepest point along the channel's middle row past x, on the +x side.
front_of(s: *Shallow, from: float, above: float) -> float {
    far = from
    x = from
    while x < shallow.shallow_origin_x(s) + shallow.shallow_extent(s) {
        if shallow.shallow_depth(s, x, 0.0) > above { far = x }
        x = x + shallow.shallow_extent(s) / (shallow.shallow_cells(s) as float)
    }
    return far
}

dam_checks() {
    // A channel 120 m along x, a reservoir 2 m deep in its first 20 m.
    s = shallow.shallow_new(240, 120.0, 0.0, 0.0)
    shallow.shallow_ground_from(s, flat, null)
    shallow.shallow_fill_box(s, 0.0 - 60.0, 0.0 - 60.0, 0.0 - 40.0, 60.0, 2.0)
    start = shallow.shallow_volume(s)
    took = os.now_monotonic_ns()
    t = 0
    front_at_2 = 0.0
    while t < 3600 {
        shallow.shallow_step(s, 1.0 / 60.0)
        t = t + 1
        if t == 120 { front_at_2 = front_of(s, 0.0 - 40.0, 0.01) }
    }
    ms = ((os.now_monotonic_ns() - took) as float) / 1000000.0 / 3600.0
    end = shallow.shallow_volume(s)
    drift = abs_of(end - start) / start
    println("  a dam 2 m deep breaking into a dry channel: ${start} m^3, a minute on ${end} m^3 (a part in ${1.0 / (drift + 1e-12)})")
    check("a dam breaking into a dry channel keeps its water to a part in a hundred thousand", drift < 0.00001)
    speed = (front_at_2 + 40.0) / 2.0
    println("  its front ran ${speed} m/s over the first two seconds; sqrt(g h0) is ${sqrt(9.81 * 2.0)}, Ritter's 2 sqrt(g h0) ${2.0 * sqrt(9.81 * 2.0)}")
    check("and its front runs out at about two thirds of sqrt(g h0), under Ritter's 2 sqrt(g h0)", speed > sqrt(9.81 * 2.0) * 0.6 && speed < 2.0 * sqrt(9.81 * 2.0))
    println("  a step of 240 x 240 cells (120 m) costs ${ms} ms a frame")
    shallow.shallow_free(s)
}

wave_checks() {
    // A metre of still water; a 5 cm ridge across the channel at x = 0.
    s = shallow.shallow_new(256, 64.0, 0.0, 0.0)
    shallow.shallow_ground_from(s, flat, null)
    shallow.shallow_fill_box(s, 0.0 - 100.0, 0.0 - 100.0, 100.0, 100.0, 1.0)
    shallow.shallow_set_friction(s, 0.0)
    x = 0.0 - 1.0
    while x <= 1.0 {
        z = 0.0 - 32.0
        while z < 32.0 {
            shallow.shallow_add(s, x, z, 0.26, 0.02)
            z = z + 0.25
        }
        x = x + 0.25
    }
    t = 0
    while t < 120 {
        shallow.shallow_step(s, 1.0 / 60.0)
        t = t + 1
    }
    // The crest on the +x side two seconds on.
    best = 0.0
    crest = 0.0
    x = 0.5
    while x < 31.0 {
        h = shallow.shallow_level(s, x, 0.0)
        if h > best {
            best = h
            crest = x
        }
        x = x + 0.25
    }
    speed = crest / 2.0
    want = sqrt(9.81 * 1.0)
    println("  a ridge on a metre of still water: its crest ${crest} m out two seconds on, ${speed} m/s against sqrt(g h) ${want}")
    check("a small wave runs at sqrt(g h), within a tenth", abs_of(speed - want) < want * 0.1)
    shallow.shallow_free(s)
}

beach_checks() {
    // Still water to 1 m against the beach, the shore 4 m up it; a mound of
    // water dropped 8 m out runs in.
    s = shallow.shallow_new(256, 64.0, 0.0, 0.0)
    shallow.shallow_ground_from(s, beach, null)
    shallow.shallow_fill_box(s, 0.0 - 100.0, 0.0 - 100.0, 100.0, 100.0, 1.0)
    shallow.shallow_set_friction(s, 0.1)
    shallow.shallow_add(s, 0.0 - 8.0, 0.0, 5.0, 1.0)
    farthest = 0.0
    t = 0
    while t < 2400 {
        // After its run-up the sea is let settle: a closed basin sloshes
        // for minutes on its own.
        if t == 900 { shallow.shallow_set_friction(s, 1.5) }
        shallow.shallow_step(s, 1.0 / 60.0)
        edge = front_of(s, 0.0, 0.002)
        if edge > farthest { farthest = edge }
        t = t + 1
    }
    edge = front_of(s, 0.0, 0.002)
    level = shallow.shallow_level(s, 0.0 - 20.0, 0.0)
    near = shallow.shallow_level(s, 0.0 - 2.0, 0.0)
    println("  a wave run up a beach: the wet edge reached ${farthest} m up it and rests at ${edge} m; the sea stands at ${level} m 20 m out and ${near} m 2 m out")
    check("a wave runs up a beach past the still shore and falls back", farthest > 4.3 && edge < farthest)
    check("and the sea comes to rest level, its wet edge where that level meets the beach",
          abs_of(level - near) < 0.003 && abs_of(edge - (level / 0.25)) < 0.5)
    shallow.shallow_free(s)
}

main() {
    println("shallow water: lakes, dams, waves and beaches (#744)")
    lake_checks()
    dam_checks()
    wave_checks()
    beach_checks()
    if g_failures == 0 {
        println("shallow: all checks passed (${g_checks})")
    } else {
        println("shallow: ${g_failures} failure(s) of ${g_checks}")
    }
}
