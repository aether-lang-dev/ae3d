// Ray queries in a shader written with `quote` (ae3d.gpu, ae3d.shaderlib's
// AccelerationStructure, RayQuery and ray_query_*), on a pixel shader of its
// own; no GPU. What is checked is what each back end writes and what the CPU
// does with it; that the GLSL compiles for Vulkan 1.2 is generate_shaders's
// (glslang, over lit_rq), and the MSL's that scripts/msl_check.sh's (over
// src/ae3d/metal, and this shader's when AE3D_MSL_OUT names a directory to
// write it to).
//
//   - an acceleration structure is captured and placed (capture_binding): a
//     `uniform accelerationStructureEXT` at its set and binding, and the
//     shader's version 460 with GL_EXT_ray_query;
//   - a ray query is declared, not given a value (`rayQueryEXT q;`), and its
//     calls are rayQueryInitializeEXT (flags and mask as uints),
//     rayQueryProceedEXT and rayQueryGetIntersectionTypeEXT against
//     gl_RayQueryCommittedIntersectionNoneEXT; the flags the two names stand
//     for are the GLSL constants';
//   - a helper handed the structure by every call reads it in place, as a
//     hand-written shader's helper reads its global;
//   - OpenGL has no ray queries: writing the shader for it is refused, and
//     says so;
//   - MSL: the structure an `instance_acceleration_structure` argument at its
//     place in the pixel shader's buffers, the query an
//     `intersection_query<triangle_data, instancing>`, the flags
//     intersection_params;
//   - the CPU's evaluator has no scene: a ray finds nothing, so the shader
//     runs as it does where no ray is cast;
//   - a shader that traces no ray is written as it was (version 450).
import std.os
import std.file
import std.string
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader)
import ae3d.shaderlib (vec2, vec3, vec4, splat3, AccelerationStructure, ray_query, ray_query_initialize, ray_query_proceed,
                       ray_query_committed_hit, ray_flag_opaque, ray_flag_terminate_on_first_hit)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

has(text: string, part: string) -> bool { return string.contains(text, part) != 0 }

// One ray from `origin` along `direction`, to `far`: blocked by anything the
// scene has (it stops at the first hit, and meets opaque surfaces only).
@quotable
blocked(scene: AccelerationStructure, origin: vec3, direction: vec3, far: float) -> bool {
    q = ray_query()
    ray_query_initialize(q, scene, ray_flag_opaque() | ray_flag_terminate_on_first_hit(), 1, origin, 0.01, direction, far)
    ray_query_proceed(q)
    return ray_query_committed_hit(q)
}

@quotable
shadow_of(scene: AccelerationStructure, origin: vec3, direction: vec3) -> float {
    if blocked(scene, origin, direction, 500.0) { return 0.25 }
    return 1.0
}

traced_pixel(scene: AccelerationStructure, sun: vec3) -> *GpuShader {
    s = gpu.fragment("ray_pixel") quote | uv: vec2 | {
        lit = shadow_of(scene, vec3(uv.x, uv.y, 0.0), sun)
        return vec4(splat3(lit), 1.0)
    }
    _a = gpu.capture_binding(s, "scene", 2, 4)
    gpu.read_in_place(s)
    return s
}

plain_pixel(sun: vec3) -> *GpuShader {
    return gpu.fragment("ray_plain") quote | uv: vec2 | {
        return vec4(splat3(sun.y * uv.x), 1.0)
    }
}

write_out(name: string, text: string) {
    dir = os.getenv("AE3D_MSL_OUT")
    if dir == null { return }
    _w = file.write("${dir}/${name}", text)
}

main() {
    scene = AccelerationStructure { handle: null }
    sun = vec3(0.0, 1.0, 0.0)
    ps = traced_pixel(scene, sun)

    println("GLSL")
    glsl = gpu.emit_glsl(ps, gpu.VULKAN)
    if glsl == "" { println("    ${gpu.last_error()}") }
    check("the GLSL is written", glsl != "")
    write_out("ray_pixel.frag", glsl)
    check("at 460 with the ray-query extension", has(glsl, "#version 460\n#extension GL_EXT_ray_query : require\n"))
    check("the structure at the place it was given",
          has(glsl, "layout(set = 2, binding = 4) uniform accelerationStructureEXT scene;"))
    check("a query is declared and not given a value", has(glsl, "rayQueryEXT q;\n"))
    check("rayQueryInitializeEXT takes the flags and the mask as uints",
          has(glsl, "rayQueryInitializeEXT(q, scene, uint((int(gl_RayFlagsOpaqueEXT) | int(gl_RayFlagsTerminateOnFirstHitEXT))), uint(1), origin, 0.01, sun, far);"))
    check("it is run and read", has(glsl, "rayQueryProceedEXT(q);") &&
          has(glsl, "return (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT);"))
    // (And the sun it is handed alike by every call, which it reads in place too.)
    check("a helper reads the structure in place", has(glsl, "bool blocked(vec3 origin, float far)") &&
          has(glsl, "float shadow_of(vec3 origin)"))
    check("OpenGL's is refused for it", gpu.emit_glsl(ps, gpu.GL) == "" && has(gpu.last_error(), "no ray queries"))
    plain = plain_pixel(sun)
    check("a shader with no ray is still version 450", has(gpu.emit_glsl(plain, gpu.VULKAN), "#version 450\n"))

    println("MSL")
    msl = gpu.emit_msl(ps)
    if msl == "" { println("    ${gpu.last_error()}") }
    check("the MSL is written", msl != "")
    write_out("ray_pixel.frag.metal", msl)
    check("with Metal's ray tracing", has(msl, "#include <metal_raytracing>\nusing namespace metal::raytracing;\n"))
    check("the structure an argument", has(msl, "instance_acceleration_structure scene [[buffer("))
    check("the query a triangle intersection_query", has(msl, "intersection_query<triangle_data, instancing> q;"))
    check("reset over a ray and the flags as parameters",
          has(msl, "q.reset(ray(origin, sun, 0.01, far), scene, uint(1), ae_ray_params((1 | 4)));"))
    check("run and read", has(msl, "q.next();") && has(msl, "q.get_committed_intersection_type() != intersection_type::none"))

    println("the CPU")
    cx = gpu.cpu_new(ps)
    at = gpu.v2(0.5, 0.5)
    got = gpu.cpu_run(cx, at)
    if got == null { println("    ${gpu.last_error()}") }
    check("runs, a ray finding nothing", got != null && gpu.val_x(got) == 1.0 && gpu.val_w(got) == 1.0)
    gpu.val_free(got)
    gpu.val_free(at)
    gpu.cpu_free(cx)

    gpu.shader_free(ps)
    gpu.shader_free(plain)
    if g_failures > 0 {
        println("gpu_ray: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("gpu_ray: all checks passed (${g_checks})")
}
