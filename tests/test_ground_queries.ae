// The static world read as ground (#934): physics.ray_static_ground, the
// first surface down a foot can stand on, and physics.static_depth, how far a
// point is inside a solid. No window. On a 1 cm thick floor slab's top at
// y 0: a 5 cm kerb, a plate tilted 60 degrees over it, a 30 degree ramp and
// a 0.6 m block.
//
//   - down onto the plate over the kerb, the ground is the kerb's top
//     (the plate's slope passed), facing up;
//   - down from inside the block, the ground is the floor under it (a ray
//     starting inside a solid meets it where it starts, facing nowhere);
//   - down onto the ramp, the ground is the ramp, its normal 30 degrees off
//     up (a slope a foot stands on is not passed);
//   - a point 4 cm under the block's top is 4 cm inside it; a point under
//     the plate, clear of it, and one on the open floor are in nothing.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics

extern exit(code: int)

const STAND = 0.64

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

solid(e: *Engine, name: string, at: Vec3, turn: Quat, half: Vec3) {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, turn)
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

main() {
    println("ground_queries: the static world read as ground")
    e = engine.engine_new()
    physics.attach(e)
    up = core.vec3(0.0, 0.0, 1.0)
    level = core.quat_ident()
    solid(e, "Floor", core.vec3(0.0, 0.0 - 0.5, 0.0), level, core.vec3(20.0, 0.5, 20.0))
    // The kerb along z at x 0, the plate over it turned 60 degrees.
    solid(e, "Kerb", core.vec3(0.0, 0.025, 0.0), level, core.vec3(0.3, 0.025, 2.0))
    solid(e, "Plate", core.vec3(0.0, 0.55, 0.0), core.quat_rotate(0.0 - 1.0471976, up), core.vec3(0.3, 0.01, 2.0))
    // The ramp at x 3: a slab turned 30 degrees, its top over x 3 at 0.2 m.
    solid(e, "Ramp", core.vec3(3.0, 0.2 - 0.05 / 0.8660254, 0.0), core.quat_rotate(0.5235988, up), core.vec3(1.0, 0.05, 2.0))
    // The block at x 6, its top at 0.6.
    solid(e, "Block", core.vec3(6.0, 0.3, 0.0), level, core.vec3(0.3, 0.3, 0.3))
    engine.engine_update(e, 0.016666666666666666)
    p = physics.of(e)
    down = core.vec3(0.0, 0.0 - 1.0, 0.0)

    kerb = physics.ray_static_ground(p, core.vec3(0.0, 1.2, 0.0), down, 2.0, STAND)
    first = physics.ray_static_hit(p, core.vec3(0.0, 1.2, 0.0), down, 2.0)
    println("  down onto the plate over the kerb: the first surface ${first.point.y} m up (normal ${first.normal.y} up), the ground ${kerb.point.y} m (normal ${kerb.normal.y} up)")
    check("down onto a 60 degree plate over a kerb, the ground is the kerb's top, facing up", kerb.hit && core.abs_of(kerb.point.y - 0.05) < 0.001 && kerb.normal.y > 0.999 && first.point.y > 0.4)

    inside = physics.ray_static_ground(p, core.vec3(6.0, 0.5, 0.0), down, 2.0, STAND)
    println("  down from inside the block: the ground ${inside.point.y} m")
    check("down from inside a block, the ground is the floor under it", inside.hit && core.abs_of(inside.point.y) < 0.001 && inside.normal.y > 0.999)

    ramp = physics.ray_static_ground(p, core.vec3(3.0, 1.2, 0.0), down, 2.0, STAND)
    println("  down onto the ramp: the ground ${ramp.point.y} m, its normal ${ramp.normal.y} up")
    check("down onto a 30 degree ramp, the ground is the ramp", ramp.hit && core.abs_of(ramp.point.y - 0.2) < 0.002 && core.abs_of(ramp.normal.y - 0.8660254) < 0.001)

    in_block = physics.static_depth(p, core.vec3(6.0, 0.56, 0.1), 0.6)
    under_plate = physics.static_depth(p, core.vec3(0.0, 0.2, 0.0), 0.6)
    open = physics.static_depth(p, core.vec3(9.0, 0.01, 0.0), 0.6)
    println("  inside: 4 cm under the block's top ${in_block * 1000.0} mm, under the plate ${under_plate * 1000.0} mm, over the open floor ${open * 1000.0} mm")
    check("a point 4 cm under a block's top is 4 cm inside it", core.abs_of(in_block - 0.04) < 0.001)
    check("a point under the plate, clear of it, and one over the open floor are in nothing", under_plate == 0.0 && open == 0.0)

    physics.physics_free(p)
    engine.engine_free(e)
    if g_failures == 0 {
        println("ground_queries: all checks passed (${g_checks})")
        return
    }
    println("ground_queries: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
