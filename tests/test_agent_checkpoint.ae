// The agent's checkpoint and roll back (#507, #510): an agent building a
// game keeps the scene as it is, tries something, and puts it back. Driven
// over a real socket against the engine, one request a frame, as
// tests/test_agent_components.ae is.
//
// Between the checkpoint and the roll back the game moves a crate, changes a
// component's field, lets a body fall, makes an object and destroys another.
// Rolled back with no spawner, everything comes back but the destroyed
// object, which is counted; rolled back again with one, it comes back too.

import std.os
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour
import ae3d.component
import ae3d.components
import ae3d.physics
import ae3d.persist
extern exit(code: int)

struct Stamina {
    value: float
}

stamina_new() -> ptr {
    s = heap.new(Stamina)
    s.value = 100.0
    return s as ptr
}

stamina_free(p: ptr) { heap.free(p as *Stamina) }

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_kind: ptr = null
var g_faller_y = 0.0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if !condition {
        g_failures = g_failures + 1
        println("FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 262144)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

bool_of(r: ptr, name: string) -> bool {
    if r == null { return false }
    node = json.object_get_raw(r, name)
    return node != null && json.get_bool(node) == 1
}

int_of(r: ptr, name: string) -> int {
    if r == null { return 0 - 1 }
    node = json.object_get_raw(r, name)
    if node == null { return 0 - 1 }
    return json.get_int(node)
}

// What the game sets to make an object back: a barrel, as it made the first.
make_back(context: ptr, name: string, model: string) -> *GameObject {
    e = context as *Engine
    return engine.object(e, name, loader.cube(1.0))
}

stamina_of(o: *GameObject) -> *Stamina { return component.state_of(o, g_kind as *ComponentKind) as *Stamina }

main() {
    os.setenv("AE3D_AGENT", "auto")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 120)
    physics.attach(e)
    k = component.kind("Stamina", "Gameplay", stamina_new, stamina_free)
    component.float_field(k, "value", offsetof(Stamina, value), 0.0, 100.0)
    g_kind = k as ptr
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.6, 0.0))
    crate = engine.object(e, "Crate", loader.cube(1.0))
    component.add(crate, k)
    engine.object(e, "Barrel", loader.cube(1.0))
    faller = engine.object(e, "Faller", loader.cube(1.0))
    behaviour.object_set_position(faller, core.vec3(4.0, 6.0, 0.0))
    physics.rigidbody(faller, physics.DYNAMIC)
    physics.box_collider(faller, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    program = engine.behaviour_new("agent checkpoint test", null)
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        println("SKIP no window")
        engine.engine_free(e)
        component.kinds_clear()
        return
    }
    engine.engine_free(e)
    component.kinds_clear()
    if g_stage < 7 {
        println("FAIL the exchange did not finish (stopped at stage ${g_stage})")
        g_failures = g_failures + 1
    }
    if g_failures == 0 {
        println("test_agent_checkpoint: all checks passed (${g_checks})")
        return
    }
    println("test_agent_checkpoint: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

on_render(state: ptr, e: *Engine, delta: float) {
    scene = engine.engine_scene(e)
    if g_stage == 0 {
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("client connects", sock != null)
        g_sock = sock
        g_faller_y = behaviour.object_position(behaviour.scene_find(scene, "Faller")).y
        ask_send("{\"id\":1,\"op\":\"persist.checkpoint\",\"name\":\"before\"}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    doc = ask_receive()
    if doc == null { return }
    r = result_of(doc)

    if g_stage == 1 {
        check("a checkpoint is kept under its name", ok_of(doc) && json.get_string_raw(json.object_get_raw(r, "name")) == "before")
        // What the game does after it: everything a roll back has to undo.
        crate = behaviour.scene_find(scene, "Crate")
        behaviour.object_set_position(crate, core.vec3(9.0, 3.0, 9.0))
        stamina_of(crate).value = 12.0
        engine.object(e, "Intruder", loader.cube(1.0))
        // Gone outright. (One only waiting for the next update is kept by a
        // roll back, held in-process by test_persist: over the socket, the
        // frame the roll back lands in decides whether it is still waiting.)
        behaviour.scene_remove(scene, behaviour.scene_find(scene, "Barrel"))
        ask_send("{\"id\":2,\"op\":\"persist.rollback\",\"name\":\"before\"}")
    } else if g_stage == 2 {
        // The body fell for a few frames before the roll back, and one step after.
        crate = behaviour.scene_find(scene, "Crate")
        faller = behaviour.object_position(behaviour.scene_find(scene, "Faller"))
        check("with no spawner the roll back says it could not make the barrel back", ok_of(doc) && !bool_of(r, "restored") && int_of(r, "missing") == 1)
        check("and puts back what it could: the crate where it was", core.abs_of(behaviour.object_position(crate).x) < 0.0001)
        check("its field as it was", core.abs_of(stamina_of(crate).value - 100.0) < 0.0001)
        check("the falling body back up where it was (${faller.y}, kept at ${g_faller_y})", core.abs_of(faller.y - g_faller_y) < 0.05)
        check("and what was made since is gone", behaviour.scene_find(scene, "Intruder") == null)
        persist.set_spawner(make_back, e as ptr)
        ask_send("{\"id\":3,\"op\":\"persist.rollback\",\"name\":\"before\"}")
    } else if g_stage == 3 {
        check("with a spawner every object comes back", ok_of(doc) && bool_of(r, "restored") && int_of(r, "missing") == 0)
        check("the barrel among them", behaviour.scene_find(scene, "Barrel") != null)
        ask_send("{\"id\":4,\"op\":\"persist.checkpoints\"}")
    } else if g_stage == 4 {
        names = json.object_get_raw(r, "checkpoints")
        check("the checkpoints are listed by name", names != null && json.array_size(names) == 1 && json.get_string_raw(json.array_get_raw(names, 0)) == "before")
        ask_send("{\"id\":5,\"op\":\"persist.rollback\",\"name\":\"never\"}")
    } else if g_stage == 5 {
        check("a roll back to a checkpoint never kept is refused", !ok_of(doc))
        ask_send("{\"id\":6,\"op\":\"persist.checkpoint\",\"name\":\"before\"}")
    } else if g_stage == 6 {
        check("a checkpoint of the same name replaces it", ok_of(doc))
        ask_send("{\"id\":7,\"op\":\"quit\"}")
        g_stage = 7
        json.free(doc)
        return
    }
    json.free(doc)
    g_stage = g_stage + 1
}
