// A humanoid character (#903, ae3d.character), held to numbers: the UE5
// mannequin made a person in
// one call (character.humanoid, on 100STYLE's neutral captures), then only
// asked, every frame, to go, look and aim. No window; stepped at 60 Hz.
//
//   - it is made: its states (a stand, a 2D blend of the gaits, a start, a
//     stop and its mirror) and its parts (animator, mover, feet) there for a
//     game to reach;
//   - asked to walk ahead at 0.8 m/s it walks, its blend playing, along the
//     way asked (within 10 degrees), no toe skating 5 mm (ae3d.metrics);
//   - let go, it comes to a stand within 3 s, still (its object under
//     5 cm/s) and on its stand;
//   - asked to go to its left facing ahead, it goes left and still faces
//     ahead (within 10 degrees): strafing;
//   - told to look at a point 50 degrees to its side, its head faces it
//     within 3 degrees;
//   - given a file's pistol aims and told to aim at a point ahead and up, its
//     hands come up: the right hand 25 cm higher than standing with none.
//
//   - turned round on the spot it steps: no planted toe sliding 5 mm, 45
//     degrees or less a step, its hips on their spot, no foot crossing;
//   - in a world with physics, made with its capsule: up and down five
//     0.2 m stairs and over a 20 degree ramp, it stands on the top, no sole
//     5 mm into them, no planted toe sliding 5 mm;
//   - stood a second and set off at a walk (1.2 m/s) and a run (2.6 m/s),
//     ahead, to its sides and behind: through its start and the switch into
//     its gaits no joint turns faster than the takes' own fastest plus what
//     the easing needs, and no foot crosses the hips' middle (#937).
//
// And the same person moving by a database (character.match_add, #906, #935):
// four of 100STYLE's neutral takes read whole (walking ahead, to the side,
// turning and idling; the last three mirrored too; the whole style is
// test_matching_db's), no gaits given:
//   - asked to walk ahead at 0.8 m/s it goes along the way asked (within
//     10 degrees) at it (2 m in the 4 s, from standing), no toe skating
//     5 mm;
//   - let go, it stands within 3 s, still, no toe skating 5 mm;
//   - asked to go left facing ahead, it goes left still facing ahead.
//
// And a person on a graph file (character.graphed): the Rigify mannequin
// on its own walk, jog and sprint blended by speed
// (tests/fixtures/graphs/gaits.graph):
//   - asked to run ahead at 3 m/s, it goes on its blend along the way
//     asked (within 10 degrees, 8 m in the 4 s from standing), no toe
//     skating 5 mm;
//   - walked, run and sprinted at 1.2, 6, 7, 8 and 8.5 m/s, no toe skating
//     5 mm;
//   - let go, it is on its stand within 3 s, still, no toe skating 5 mm;
//   - from standing to 8 and to 8.5 m/s, accelerating through the jog into
//     the sprint, no toe skating 5 mm (#926).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.metrics
import ae3d.physics
import ae3d.usable
import ae3d.loader

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const WHOLE = "tests/fixtures/people/100style/whole/"
const GAITS_GRAPH = "tests/fixtures/graphs/gaits.graph"
// The course: five 0.2 m stairs a step deep up, a landing, five down, and a
// 20 degree ramp up and down.
const TREAD = 0.6
const STEPS = 5
const RISE = 0.2
const LANDING = 2.0
const SLOPE = 0.349066

var g_checks = 0
var g_failures = 0
var g_meter: ptr = null

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The angle between two level ways, degrees.
apart(a: Vec3, b: Vec3) -> float {
    x = core.vec3(a.x, 0.0, a.z)
    y = core.vec3(b.x, 0.0, b.z)
    if core.v3_len(x) < 0.000001 || core.v3_len(y) < 0.000001 { return 180.0 }
    return core.acos_of(core.clampf(core.v3_dot(core.v3_normalize(x), core.v3_normalize(y)), 0.0 - 1.0, 1.0)) * 57.29578
}

facing(o: *GameObject) -> Vec3 { return core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }

// Steps `n` frames asking `velocity` and `face`; the worst a toe skated in
// them (ae3d.metrics: how far a toe's tip slid while its foot stood on the
// ground, a step lifted off it not counted).
run(e: *Engine, c: *Character, n: int, velocity: Vec3, face: Vec3) -> float {
    m = g_meter as *Meter
    metrics.meter_reset(m)
    k = 0
    while k < n {
        character.move(c, velocity, face)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    return metrics.meter_worst(m, metrics.SKATE)
}

// Turned round on the spot, standing: asked to face behind it with no
// velocity. As test_anim_pipeline holds a mover and its feet: it steps (no
// planted toe sliding 5 mm, 45 degrees or less a step), its hips stay on
// their spot (5 cm), and no foot crosses the hips' middle.
turn_round(e: *Engine, c: *Character) {
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    m = g_meter as *Meter
    metrics.meter_reset(m)
    feet = character.feet_of(c)
    before = ikrig.feet_steps(feet)
    was = facing(o)
    behind = core.v3_mul(was, 0.0 - 1.0)
    w = pose.new(r)
    pelvis = pose.human(r, pose.PELVIS)
    pose.world(r, animator.pose_now(a), w)
    spot = ikrig.to_ground(r, pose.translation(w, pelvis))
    farthest = 0.0
    k = 0
    while k < 240 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), behind)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        pose.world(r, animator.pose_now(a), w)
        hips = ikrig.to_ground(r, pose.translation(w, pelvis))
        off = core.v3_len(core.vec3(hips.x - spot.x, 0.0, hips.z - spot.z))
        if off > farthest { farthest = off }
        k = k + 1
    }
    pose.release(w)
    turned = apart(facing(o), was)
    steps = ikrig.feet_steps(feet) - before
    each = turned
    if steps > 0 { each = turned / (steps as float) }
    slid = metrics.meter_worst(m, metrics.SKATE)
    crossed = metrics.meter_worst(m, metrics.FEET_CROSS)
    println("  turned round on the spot: ${turned} degrees in ${steps} steps (${each} a step), a planted toe slid ${slid * 1000.0} mm, the hips ${farthest * 100.0} cm off their spot, a foot past the hips' middle ${crossed * 100.0} cm at most (below 0, never)")
    check("turned round on the spot it steps: no planted toe slides 5 mm, 45 degrees or less a step, its hips within 5 cm of their spot, no foot past the hips' middle", turned > 170.0 && steps > 0 && each <= 45.0 && slid < 0.005 && farthest < 0.05 && crossed < 0.0)
}

// A static box `half` big, its middle at (0, `high`, `along`), pitched
// `pitch` (its top rising along +z).
course_box(e: *Engine, along: float, high: float, half: Vec3, pitch: float) {
    b = engine.object(e, "Course", null)
    behaviour.object_set_position(b, core.vec3(0.0, high, along))
    behaviour.object_set_rotation(b, core.quat_rotate(0.0 - pitch, core.vec3(1.0, 0.0, 0.0)))
    physics.box_collider(b, half, physics.material(0.8, 0.0))
}

// Up and down five 0.2 m stairs a step deep and over a 20 degree ramp,
// through the component in a world with physics: its capsule (made by
// humanoid, as Unity's CharacterController) carries it up each stair and
// the ramp, its feet on them (ikrig, on the physics' static world). As
// test_ik_constraints holds a walk: no sole goes 5 mm into the ground and
// no planted toe slides 5 mm (ae3d.metrics, over the physics' ground); it
// stands on the top (within 3 cm of 1 m) and ends on the floor.
climbs(g: *Gaits) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    up_end = 1.5 + TREAD * (STEPS as float)
    down_end = up_end + LANDING + TREAD * (STEPS as float)
    k = 1
    while k <= STEPS {
        from = 1.5 + TREAD * ((k - 1) as float)
        to = down_end - TREAD * ((k - 1) as float)
        course_box(e, (from + to) * 0.5, RISE * (k as float) * 0.5, core.vec3(1.0, RISE * (k as float) * 0.5, (to - from) * 0.5), 0.0)
        k = k + 1
    }
    run = 3.0
    high = run * core.sin_of(SLOPE)
    flat = run * core.cos_of(SLOPE)
    thick = 0.25
    first = down_end + 2.0
    course_box(e, first + flat * 0.5 + thick * core.sin_of(SLOPE), high * 0.5 - thick * core.cos_of(SLOPE), core.vec3(1.0, thick, run * 0.5), SLOPE)
    course_box(e, first + flat + 1.0, high * 0.5, core.vec3(1.0, high * 0.5, 1.0), 0.0)
    course_box(e, first + flat + 2.0 + flat * 0.5 - thick * core.sin_of(SLOPE), high * 0.5 - thick * core.cos_of(SLOPE), core.vec3(1.0, thick, run * 0.5), 0.0 - SLOPE)
    ends = first + flat * 2.0 + 2.0 + 1.5
    c = character.humanoid(e, "Climber", MANNEQUIN, g)
    check("in a world with physics, made with its capsule: ${character.error()}", c != null && physics.character_of(character.object_of(c)) != null)
    if c == null { exit(1) }
    o = character.object_of(c)
    m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
    metrics.meter_ground_physics(m, physics.of(e))
    top = 0.0
    on_stairs = true
    stairs_into = 0.0
    stairs_slid = 0.0
    k = 0
    while k < (40.0 / STEP) as int && behaviour.object_position(o).z < ends {
        character.move(c, core.vec3(0.0, 0.0, 0.8), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        at = behaviour.object_position(o)
        if on_stairs && at.y > top { top = at.y }
        if on_stairs && at.z > down_end + 1.0 {
            stairs_into = metrics.meter_worst(m, metrics.INTO_GROUND)
            stairs_slid = metrics.meter_worst(m, metrics.SKATE)
            metrics.meter_reset(m)
            on_stairs = false
        }
        k = k + 1
    }
    at = behaviour.object_position(o)
    ramp_into = metrics.meter_worst(m, metrics.INTO_GROUND)
    ramp_slid = metrics.meter_worst(m, metrics.SKATE)
    println("  up and down five 0.2 m stairs ${TREAD} m deep: at most ${top} m up, a sole ${stairs_into * 1000.0} mm into the ground, a planted toe sliding ${stairs_slid * 1000.0} mm at worst")
    println("  over the 20 degree ramp: a sole ${ramp_into * 1000.0} mm into it, a planted toe sliding ${ramp_slid * 1000.0} mm at worst; it ends ${at.z} m along, ${at.y} m up")
    check("up and down 0.2 m stairs, it stands on the top (within 3 cm of 1 m), no sole 5 mm into them, no planted toe sliding 5 mm", core.abs_of(top - RISE * (STEPS as float)) < 0.03 && !on_stairs && stairs_into < 0.005 && stairs_slid < 0.005)
    check("over a 20 degree ramp up and down to the floor again, no sole 5 mm into it, no planted toe sliding 5 mm", at.z >= ends && at.y < 0.03 && ramp_into < 0.005 && ramp_slid < 0.005)
    metrics.meter_free(m)
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

// Set off from a stand (#937), as a game sets its people off: on a physics
// floor with its capsule, stood a second, then asked to walk (1.2 m/s) and
// to run (2.6 m/s) ahead, to its left, to its right and behind, metered for
// 3 s from the go. Through the turn where it stands, the start played by
// the distance come and its switch into the gaits, no joint turns faster
// than the takes' own fastest plus what the easing of the transitions taken
// needs (1.875 x offset / seconds, the quintic's steepest), and no foot
// crosses the hips' middle. Clocked by the distance alone, the start take
// raced up to 28 times its own pace, a ball turned 20 to 30 rad/s and the
// feet crossed 40 to 88 mm in the plaza.
starts(g: *Gaits) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(80.0, 0.5, 80.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Starter", MANNEQUIN, g)
    check("on a physics floor, made with its capsule: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    metrics.meter_animator(m, a)
    own = metrics.animator_fastest(a)
    speeds = [1.2, 2.6]
    // Ahead, left, right, behind: the way asked off the way it faces.
    ways = [0.0, 1.5707963, 0.0 - 1.5707963, 3.1415926]
    names = ["ahead", "left", "right", "behind"]
    worst_ratio = 0.0
    worst_cross = 0.0 - 1.0
    sp = 0
    while sp < 2 {
        line = "  set off at ${speeds[sp]} m/s:"
        k = 0
        while k < 4 {
            // Stood: on its stand, then a second more.
            n = 0
            while n < 600 && !character.standing(c) {
                character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
                engine.engine_update(e, STEP)
                n = n + 1
            }
            n = 0
            while n < 60 {
                character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
                engine.engine_update(e, STEP)
                n = n + 1
            }
            f = facing(o)
            yaw = core.atan2_of(f.x, f.z) + ways[k]
            asked = core.vec3(speeds[sp] * core.sin_of(yaw), 0.0, speeds[sp] * core.cos_of(yaw))
            // Its joints taken from where they stand now, not from the last
            // frame metered, three seconds before.
            metrics.meter_moved(m)
            metrics.meter_reset(m)
            ease = 0.0
            n = 0
            while n < 180 {
                character.move(c, asked, core.vec3(0.0, 0.0, 0.0))
                engine.engine_update(e, STEP)
                metrics.meter_take(m, STEP)
                if animator.transitioning(a) && animator.transition_seconds(a) > 0.0 {
                    need = 1.875 * animator.transition_offset(a) / animator.transition_seconds(a)
                    if need > ease { ease = need }
                }
                n = n + 1
            }
            ratio = metrics.meter_worst(m, metrics.POP) / (own + ease)
            crossed = metrics.meter_worst(m, metrics.FEET_CROSS)
            if ratio > worst_ratio { worst_ratio = ratio }
            if crossed > worst_cross { worst_cross = crossed }
            line = "${line} ${names[k]} ${(ratio * 100.0) as int}% (${pose.name(r, metrics.meter_joint(m, metrics.POP))} ${metrics.meter_worst(m, metrics.POP)} rad/s at ${metrics.meter_when(m, metrics.POP)} s), crossing ${(crossed * 1000.0) as int} mm, a toe thrown ${metrics.meter_worst(m, metrics.FOOT_THROW)} m/s;"
            // Let go, back to a stand.
            n = 0
            while n < 30 {
                character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
                engine.engine_update(e, STEP)
                n = n + 1
            }
            k = k + 1
        }
        println(line)
        sp = sp + 1
    }
    println("  set off from a stand: the fastest joint ${worst_ratio * 100.0}% of the takes' own fastest (${own} rad/s) plus the easing's at the most, a foot ${worst_cross * 1000.0} mm past the hips' middle at the most (below 0, never)")
    check("set off from a stand at a walk and a run, ahead, to the sides and behind: no joint faster than the takes' own plus the easing's, no foot past the hips' middle", worst_ratio <= 1.02 && worst_cross < 0.0)
    metrics.meter_free(m)
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

// The person on a graph file (see the top).
graphed_person() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    c = character.graphed(e, "Runner", RIGIFY, GAITS_GRAPH)
    made = c != null && character.graph_of(c) != null && character.idle_state(c) >= 0 && character.move_state(c) >= 0
    check("made on a graph file, its stand and its blend found by name: ${character.error()}", made)
    if !made { exit(1) }
    a = character.animator_of(c)
    o = character.object_of(c)
    g_meter = metrics.meter_new(animator.rig(a), o) as ptr
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    start = behaviour.object_position(o)
    ahead = facing(o)
    still = core.vec3(0.0, 0.0, 0.0)
    ran = run(e, c, 240, core.v3_mul(ahead, 3.0), still)
    went = core.v3_sub(behaviour.object_position(o), start)
    gone = core.v3_len(core.vec3(went.x, 0.0, went.z))
    off_way = apart(went, ahead)
    blending = animator.current(a) == character.move_state(c)
    println("  on a graph file, running ahead 4 s at 3 m/s: ${gone} m on its blend ${blending}, ${off_way} degrees off the way asked; a toe skated ${ran * 1000.0} mm at worst")
    check("on a graph file, asked to run ahead it runs on its blend along the way asked, no toe skating 5 mm", blending && gone > 8.0 && off_way < 10.0 && ran < 0.005)
    // At the showcase's other paces, as test_anim_pipeline holds its gaits
    // blended by speed from 1 to 8 m/s.
    paces = [1.2, 6.0, 7.0, 8.0, 8.5]
    worst_pace = 0.0
    k = 0
    while k < 5 {
        slid = run(e, c, 180, core.v3_mul(facing(o), paces[k]), still)
        m = g_meter as *Meter
        println("    at ${paces[k]} m/s: a toe skated ${slid * 1000.0} mm, ${metrics.meter_when(m, metrics.SKATE)} s into it")
        if slid > worst_pace { worst_pace = slid }
        k = k + 1
    }
    println("  on a graph file, at 1.2, 6, 7, 8 and 8.5 m/s: a toe skated ${worst_pace * 1000.0} mm at worst")
    check("on a graph file, walked, run and sprinted at 1.2 to 8.5 m/s, no toe skating 5 mm", worst_pace < 0.005)
    stopped = run(e, c, 180, still, still)
    before = behaviour.object_position(o)
    engine.engine_update(e, STEP)
    speed = core.v3_len(core.v3_sub(behaviour.object_position(o), before)) / STEP
    resting = character.standing(c)
    println("  on a graph file, let go: ${speed} m/s three seconds on, on its stand ${resting}; a toe skated ${stopped * 1000.0} mm")
    check("on a graph file, let go, it is on its stand within 3 s, still, no toe skating 5 mm", resting && speed < 0.05 && stopped < 0.005)
    // From standing to a sprint (#926): through the jog into the sprint, the
    // blend's weights changing every frame as it speeds up.
    tops = [8.0, 8.5]
    worst_accel = 0.0
    k = 0
    while k < 2 {
        _rest = run(e, c, 180, still, still)
        slid = run(e, c, 180, core.v3_mul(facing(o), tops[k]), still)
        m = g_meter as *Meter
        println("    from standing to ${tops[k]} m/s: a toe skated ${slid * 1000.0} mm, ${metrics.meter_when(m, metrics.SKATE)} s into it")
        if slid > worst_accel { worst_accel = slid }
        k = k + 1
    }
    check("on a graph file, from standing to 8 and 8.5 m/s, accelerating through the jog to the sprint, no toe skating 5 mm (#926)", worst_accel < 0.005)
    character.character_free(c)
    metrics.meter_free(g_meter as *Meter)
    figure.figures_free(e)
    engine.engine_free(e)
}

// The person on a database of whole captures, no gaits (see the top).
matched() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    c = character.humanoid(e, "Matched", MANNEQUIN, null as *Gaits)
    names = ["FW", "SW", "TR1", "ID"]
    mirrored = [false, true, true, true]
    read = c != null
    k = 0
    while k < 4 && read {
        read = character.match_add(c, "${WHOLE}Neutral_${names[k]}.bvh.gz", mirrored[k])
        k = k + 1
    }
    check("made with no gaits, given a database of whole captures: ${character.error()}", read && character.matching(c))
    if !read { exit(1) }
    a = character.animator_of(c)
    o = character.object_of(c)
    g_meter = metrics.meter_new(animator.rig(a), o) as ptr
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    start = behaviour.object_position(o)
    ahead = facing(o)
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    still = core.vec3(0.0, 0.0, 0.0)
    walked = run(e, c, 240, core.v3_mul(ahead, 0.8), still)
    went = core.v3_sub(behaviour.object_position(o), start)
    gone = core.v3_len(core.vec3(went.x, 0.0, went.z))
    off_way = apart(went, ahead)
    println("  on the database, walking ahead 4 s at 0.8 m/s: ${gone} m, ${off_way} degrees off the way asked; a toe skated ${walked * 1000.0} mm at worst")
    check("on the database, asked to walk ahead it walks along the way asked, no toe skating 5 mm", gone > 2.0 && off_way < 10.0 && walked < 0.005)
    stopped = run(e, c, 180, still, still)
    before = behaviour.object_position(o)
    engine.engine_update(e, STEP)
    speed = core.v3_len(core.v3_sub(behaviour.object_position(o), before)) / STEP
    resting = character.standing(c)
    println("  on the database, let go: ${speed} m/s three seconds on, standing ${resting}; a toe skated ${stopped * 1000.0} mm")
    check("on the database, let go, it stands within 3 s, still, no toe skating 5 mm", resting && speed < 0.05 && stopped < 0.005)
    face0 = facing(o)
    start = behaviour.object_position(o)
    slid = run(e, c, 180, core.v3_mul(left, 0.6), face0)
    went = core.v3_sub(behaviour.object_position(o), start)
    kept = apart(facing(o), face0)
    sideways = apart(went, left)
    println("  on the database, to its left facing ahead: ${sideways} degrees off the way asked, its facing ${kept} degrees off ahead; a toe skated ${slid * 1000.0} mm")
    check("on the database, asked to go left facing ahead, it goes left and still faces ahead", sideways < 10.0 && kept < 10.0)
    // Turned on the spot by 90 and then 180 degrees (#935): its joints no
    // faster than the takes' own fastest plus what each change's easing
    // needs, no sole into the ground, no toe skating.
    m = g_meter as *Meter
    run(e, c, 120, still, still)
    metrics.meter_reset(m)
    ease = 0.0
    turned_to = [1.5707963, 4.712389]
    q = 0
    while q < 2 {
        base = facing(o)
        cs = core.cos_of(turned_to[q])
        sn = core.sin_of(turned_to[q])
        aim = core.vec3(base.x * cs + base.z * sn, 0.0, base.z * cs - base.x * sn)
        k = 0
        while k < 180 {
            character.move(c, still, aim)
            engine.engine_update(e, STEP)
            metrics.meter_take(m, STEP)
            if animator.transitioning(a) && animator.transition_seconds(a) > 0.0 {
                need = 1.875 * animator.transition_offset(a) / animator.transition_seconds(a)
                if need > ease { ease = need }
            }
            k = k + 1
        }
        q = q + 1
    }
    turn_pop = metrics.meter_worst(m, metrics.POP)
    turn_own = metrics.animator_fastest(a)
    turn_sunk = metrics.meter_worst(m, metrics.INTO_GROUND)
    turn_skate = metrics.meter_worst(m, metrics.SKATE)
    println("  on the database, turned on the spot 90 then 180 degrees: the fastest joint ${turn_pop} rad/s (${pose.name(animator.rig(a), metrics.meter_joint(m, metrics.POP))}), the takes' own ${turn_own} and the easing's ${ease}; a sole ${turn_sunk * 1000.0} mm into the ground, a toe skating ${turn_skate * 1000.0} mm")
    check("on the database, turned on the spot by 90 and 180 degrees, no joint faster than the takes' own fastest plus the easing's, no sole 5 mm into the ground, no toe skating 5 mm (#935)", turn_pop <= (turn_own + ease) * 1.02 && turn_sunk < 0.005 && turn_skate < 0.005)
    // Then to a stool 2 m ahead, faced, sat on and stood up from, and walked
    // on (#935): its sitting takes are UAL1's, read from their own file.
    u = usable.usables_new(2.0)
    stool = engine.object(e, "Stool", loader.cube(1.0))
    ahead_now = facing(o)
    behaviour.object_set_position(stool, core.v3_add(behaviour.object_position(o), core.v3_mul(ahead_now, 2.0)))
    stool_kind = usable.kind_read("tests/fixtures/usable/stool_ual1.usable")
    seat = usable.add(u, stool, stool_kind)
    metrics.meter_reset(m)
    ease = 0.0
    sat = character.use(c, u, seat)
    was_seated = false
    k = 0
    while k < 1500 && (character.using(c) || k < 10) {
        if character.seated(c) {
            was_seated = true
            character.leave(c)
        }
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if animator.transitioning(a) && animator.transition_seconds(a) > 0.0 {
            need = 1.875 * animator.transition_offset(a) / animator.transition_seconds(a)
            if need > ease { ease = need }
        }
        k = k + 1
    }
    k = 0
    while k < 120 {
        character.move(c, core.v3_mul(facing(o), 0.8), still)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        if animator.transitioning(a) && animator.transition_seconds(a) > 0.0 {
            need = 1.875 * animator.transition_offset(a) / animator.transition_seconds(a)
            if need > ease { ease = need }
        }
        k = k + 1
    }
    seat_pop = metrics.meter_worst(m, metrics.POP)
    seat_own = metrics.animator_fastest(a)
    seat_sunk = metrics.meter_worst(m, metrics.INTO_GROUND)
    seat_skate = metrics.meter_worst(m, metrics.SKATE)
    println("  on the database, to a stool, sat on, stood up from and walked on: seated ${was_seated}; the fastest joint ${seat_pop} rad/s (${pose.name(animator.rig(a), metrics.meter_joint(m, metrics.POP))} at ${metrics.meter_when(m, metrics.POP)} s), the takes' own ${seat_own} and the easing's ${ease}; a sole ${seat_sunk * 1000.0} mm into the ground, a toe skating ${seat_skate * 1000.0} mm")
    // A matcher's change eased the feet's contacts from a stale weight: a
    // foot in the air read as down, its lock pulled the leg to the floor and
    // a thigh turned 34.7 rad/s on the walk on, a toe skating 6.7 mm.
    check("on the database, faced to a stool, sat on, stood up from and walked on: no joint faster than the takes' own fastest plus the easing's, no sole 5 mm into the ground, no toe skating 5 mm (#935)", sat && was_seated && seat_pop <= (seat_own + ease) * 1.02 && seat_sunk < 0.005 && seat_skate < 0.005)
    character.character_free(c)
    usable.usables_free(u)
    usable.kind_free(stool_kind)
    metrics.meter_free(g_meter as *Meter)
    figure.figures_free(e)
    engine.engine_free(e)
}

main() {
    println("humanoid: a person in one call, then asked to go, look and aim (#903)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    // 100STYLE's neutral gaits; its stop the neutral style's straight one from
    // its idle take, its start the StartStop style's, their arms by their sides.
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Hero", MANNEQUIN, g)
    check("made in one call: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    g_meter = metrics.meter_new(r, o) as ptr
    check("its stand, its gaits, its animator, mover and feet are there to reach", character.idle_state(c) >= 0 && character.move_state(c) >= 0 && character.mover_of(c) != null && character.feet_of(c) != null)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    start = behaviour.object_position(o)
    ahead = facing(o)
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    still = core.vec3(0.0, 0.0, 0.0)
    walked = run(e, c, 240, core.v3_mul(ahead, 0.8), still)
    went = core.v3_sub(behaviour.object_position(o), start)
    off_way = apart(went, ahead)
    walking = animator.current(a) == character.move_state(c)
    println("  walking ahead 4 s at 0.8 m/s: ${core.v3_len(core.vec3(went.x, 0.0, went.z))} m, ${off_way} degrees off the way asked; a toe skated ${walked * 1000.0} mm at worst")
    check("asked to walk ahead it walks, along the way asked, no toe skating 5 mm", walking && off_way < 10.0 && walked < 0.005)
    // Let go.
    stopped = run(e, c, 180, still, still)
    before = behaviour.object_position(o)
    engine.engine_update(e, STEP)
    speed = core.v3_len(core.v3_sub(behaviour.object_position(o), before)) / STEP
    resting = character.standing(c)
    println("  let go: ${speed} m/s three seconds on, standing ${resting}; a toe skated ${stopped * 1000.0} mm")
    check("let go, it comes to a stand within 3 s, still, on its stand, no toe skating 5 mm", resting && speed < 0.05 && stopped < 0.005)
    turn_round(e, c)
    // Strafing: to its left, facing ahead.
    face0 = facing(o)
    start = behaviour.object_position(o)
    _side_slid = run(e, c, 180, core.v3_mul(left, 0.6), face0)
    went = core.v3_sub(behaviour.object_position(o), start)
    kept = apart(facing(o), face0)
    sideways = apart(went, left)
    println("  to its left facing ahead: ${sideways} degrees off the way asked, its facing ${kept} degrees off ahead")
    check("asked to go left facing ahead, it goes left and still faces ahead (strafing)", sideways < 10.0 && kept < 10.0)
    _stood = run(e, c, 180, still, still)
    // Looking 50 degrees to its side, at its eyes' height.
    head = pose.human(r, pose.HEAD)
    at = behaviour.object_position(o)
    f = facing(o)
    side = core.vec3(f.z, 0.0, 0.0 - f.x)
    way = core.v3_add(core.v3_mul(f, 0.6427876), core.v3_mul(side, 0.7660444))
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    eyes = clips.ground_point(r, pose.translation(w, head))
    point = core.v3_add(eyes, core.v3_mul(way, 3.0))
    character.look(c, point)
    _looked = run(e, c, 90, still, still)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    axis = core.quat_apply(core.quat_conjugate(pose.rotation(rest, head)), ikrig.dir_to_rig(r, f))
    pose.world(r, animator.pose_now(a), w)
    face = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(pose.rotation(w, head), axis)))
    want = core.v3_normalize(core.v3_sub(point, clips.ground_point(r, pose.translation(w, head))))
    off = core.acos_of(core.clampf(core.v3_dot(face, want), 0.0 - 1.0, 1.0)) * 57.29578
    println("  told to look 50 degrees to its side: its head faces ${off} degrees off the point")
    check("told to look at a point, its head faces it within 3 degrees", off < 3.0)
    character.look_ahead(c)
    // Aiming ahead and up, from a file's pistol aims.
    hand = pose.human(r, pose.HAND_R)
    pose.world(r, animator.pose_now(a), w)
    low = clips.ground_point(r, pose.translation(w, hand)).y
    given = character.aims(c, e, RIGIFY, "Pistol_Aim_Neutral", "Pistol_Aim_Up", "Pistol_Aim_Down")
    at = behaviour.object_position(o)
    f = facing(o)
    character.aim(c, core.vec3(at.x + f.x * 10.0, at.y + 3.0, at.z + f.z * 10.0))
    _aimed = run(e, c, 90, still, still)
    pose.world(r, animator.pose_now(a), w)
    high = clips.ground_point(r, pose.translation(w, hand)).y
    println("  aiming ahead and up: the right hand ${(high - low) * 100.0} cm higher than standing with none")
    check("given a file's pistol aims and told to aim up ahead, its hands come up 25 cm", given && high - low > 0.25)
    pose.release(w)
    pose.release(rest)
    character.character_free(c)
    metrics.meter_free(g_meter as *Meter)
    figure.figures_free(e)
    engine.engine_free(e)
    matched()
    graphed_person()
    climbs(g)
    starts(g)
    character.gaits_free(g)
    if g_failures == 0 {
        println("humanoid: all checks passed (${g_checks})")
        return
    }
    println("humanoid: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
