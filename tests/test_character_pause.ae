// A character paused while something else holds its body, and resumed where
// that left it (#942, character.pause / resume): the UE5 mannequin on
// 100STYLE's neutral gaits (ae3d.character) in a world with physics, walking
// ahead at 1.2 m/s, paused for a second while the game still asks it to
// walk, then its object moved 3 m to the side (as a fall would carry it) and
// resumed there, facing the other way. No window; stepped at 60 Hz.
// Stepped on through it, a figure's mover walked its object on at the last
// speed asked, under the body a fall held (Siltreach's settlers).
//
//   - paused, its object does not move (under 1 mm) though it is asked to
//     walk on;
//   - resumed, it stands where it was put, facing as asked (within 1 cm and
//     2 degrees), and walks on from there: 2 m in 3 s, no planted toe
//     skating 5 mm (ae3d.metrics).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

main() {
    println("character_pause: paused while something else holds it, resumed where it was left (#942)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
    metrics.meter_ground_physics(m, physics.of(e))
    ahead = core.vec3(0.0, 0.0, 1.2)
    still = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < 150 {
        character.move(c, ahead, still)
        engine.engine_update(e, STEP)
        k = k + 1
    }
    character.pause(c)
    held_at = behaviour.object_position(o)
    k = 0
    while k < 60 {
        character.move(c, ahead, still)
        engine.engine_update(e, STEP)
        k = k + 1
    }
    now = behaviour.object_position(o)
    drift = core.v3_len(core.v3_sub(now, held_at))
    println("  paused a second, asked to walk on at 1.2 m/s: its object moved ${drift * 1000.0} mm")
    check("paused, its object does not move though it is asked to walk on (under 1 mm)", character.paused(c) && drift < 0.001)
    put = core.vec3(now.x + 3.0, now.y, now.z)
    back = core.vec3(0.0, 0.0, 0.0 - 1.0)
    behaviour.object_set_position(o, put)
    character.resume(c, put, back)
    engine.engine_update(e, STEP)
    stood = behaviour.object_position(o)
    faced = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    off = core.v3_len(core.vec3(stood.x - put.x, 0.0, stood.z - put.z))
    turned = core.acos_of(core.clampf(faced.z * back.z + faced.x * back.x, 0.0 - 1.0, 1.0)) * 57.29578
    metrics.meter_reset(m)
    k = 0
    while k < 180 {
        character.move(c, core.v3_mul(back, 1.2), still)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        k = k + 1
    }
    went = core.v3_len(core.v3_sub(behaviour.object_position(o), stood))
    slid = metrics.meter_worst(m, metrics.SKATE)
    println("  resumed 3 m to its side facing back: ${off * 100.0} cm off where it was put, ${turned} degrees off the way asked; it went ${went} m in 3 s, a toe skating ${slid * 1000.0} mm")
    check("resumed, it stands where it was put facing as asked (1 cm, 2 degrees)", !character.paused(c) && off < 0.01 && turned < 2.0)
    check("and walks on from there: 2 m in 3 s, no planted toe skating 5 mm", went > 2.0 && slid < 0.005)
    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("character_pause: all checks passed (${g_checks})")
        return
    }
    println("character_pause: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
