// What every peer has to simulate the same, to the bit, on every platform
// (#441): the networked horde and aephysics. Each is run from a fixed
// start and hashed at every tick, and the hashes are the trail. In one
// process the trail is held to itself -- the horde's at one thread and at
// four, a client's against the host's, the physics' run twice -- and with
// AE3D_DETERMINISM_TRAIL=<path> it is written out, so CI's three runners
// (Linux and Windows on x86-64, macOS on arm64) can be compared line for
// line by a job that reads all three (.github/workflows/ci.yml,
// "determinism"). A Mac and a PC that part show up there as the first
// tick whose hash differs.
//
//   - The horde: 2,000 zombies from a seed on the test street's ground
//     and flow field, the target moved, zombies killed and hit, handed
//     over and given back, and a client joining mid-run, which snaps every
//     peer to the quantised state; 180 ticks. What a tick runs is what
//     ae3d.nethorde's header lists: the flow field's steering, the wander,
//     the separation, the step and the shoves, the snap's and the
//     rejoin's packing.
//   - The physics: the reference's cross-platform scene, eight humans
//     dropped on grid meshes and tori, stepped until every body sleeps
//     (or 1,500 steps), every body's transform hashed each step. It is
//     aephysics's own claim (tests/test_determinism.ae there compares
//     Linux against Windows by hand) made on every runner.
//
// Headless: sessions, hordes and a physics world, no engine.

import std.fs
import std.strbuilder
import std.string
import std.os
import aephysics.math
import aephysics.mesh
import aephysics.dynamics
import aephysics.physics_world
import aephysics.human
import ae3d.jobs
import ae3d.nav
import ae3d.net
import ae3d.nethorde

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const ZOMBIES = 2000
const SEED = 441
const TICKS = 180
const JOIN_TICK = 90                 // the client joins here: every peer snaps
const PHYSICS_STEPS = 1500
const X0 = 0.0 - 60.0
const Z0 = 0.0 - 20.0
const X1 = 60.0
const Z1 = 20.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// FNV-1a over 64-bit words.
fold(hash: long, word: long) -> long {
    return (hash ^ word) * (1099511628211 as long)
}

const FNV_BASIS: long = 1469598103934665603

// --- the horde ---------------------------------------------------------------------------------

field_new() -> *FlowField {
    f = nav.flow_new(X0, Z0, X1, Z1, 1.0)
    nav.flow_block(f, 0.0 - 40.0, 0.0 - 8.0, 0.0 - 30.0, 6.0)
    nav.flow_block(f, 0.0 - 5.0, 2.0, 5.0, 14.0)
    nav.flow_block(f, 25.0, 0.0 - 14.0, 38.0, 0.0 - 2.0)
    return f
}

// The host's horde hash at every tick into `hashes` (long[TICKS + 1]),
// over a perfect loopback with a client that joins at JOIN_TICK; the
// client's hash, every frame it steps past its state, is compared with
// the host's at the tick it is at. Returns the frames that differed, as
// a negative count, or the frames that matched.
horde_trail(hashes: ptr) -> int {
    trail = hashes as long[]
    hub = net.hub_new()
    host = net.host_loopback(hub)
    host_field = field_new()
    h = nethorde.horde_new(host, host_field)
    nethorde.set_checks(h, 1)
    client = null as *Net
    client_field = null as *FlowField
    c = null as *NetHorde
    matched = 0
    wrong = 0
    // The tick the client's state put it at: it holds that tick with the
    // snap already in it, which the host holds only from the next, so it
    // is compared from the first tick it steps.
    from_tick = 0 - 1
    step = 0
    started = false
    // Sixty steps a second on the test's own clock, the horde at thirty.
    while step < (TICKS + 20) * 2 {
        now = (step as float) / 60.0
        if !started && step == 2 {
            nethorde.set_target(h, 50.0, 10.0, now)
            started = nethorde.start(h, SEED, ZOMBIES, X0, Z0, X1, Z1, now)
        }
        tick = nethorde.horde_tick(h)
        running = tick < TICKS
        if started && running && step % 20 == 7 {
            nethorde.set_target(h, ((step * 37) % 100 - 50) as float, ((step * 11) % 36 - 18) as float, now)
        }
        if started && running && step % 12 == 5 {
            nethorde.kill(h, (step * 7) % nethorde.horde_count(h), now)
        }
        if started && running && step % 6 == 3 {
            dx = ((((step * 37) % 11) - 5) as float) * 0.8
            dz = ((((step * 53) % 11) - 5) as float) * 0.8 + 0.4
            nethorde.hit(h, (step * 29) % nethorde.horde_count(h), dx, dz, 0.5, now)
        }
        // A zombie handed over every two thirds of a second, and the first
        // one out given back twenty steps later, somewhere else.
        if started && running && step % 40 == 11 {
            nethorde.hand_over(h, (step * 3) % nethorde.horde_count(h), now)
        }
        if started && running && step % 40 == 31 {
            i = 0
            while i < nethorde.horde_count(h) && !nethorde.is_out(h, i) { i = i + 1 }
            if i < nethorde.horde_count(h) {
                nethorde.rejoin(h, i, ((step % 60) - 30) as float + 0.37, 5.5, (step as float) * 0.3, 0.37, now)
            }
        }
        if client == null && started && tick >= JOIN_TICK {
            client = net.join_loopback(hub)
            client_field = field_new()
            c = nethorde.horde_new(client, client_field)
        }
        net.step(host, now)
        if running { nethorde.step(h, now) }
        after = nethorde.horde_tick(h)
        if after > tick && after <= TICKS { trail[after] = nethorde.checksum(h) }
        if client != null {
            net.step(client, now)
            nethorde.step(c, now)
            at = nethorde.horde_tick(c)
            if nethorde.started(c) && from_tick < 0 { from_tick = at }
            if nethorde.started(c) && at > from_tick && at <= TICKS {
                if nethorde.checksum(c) == trail[at] { matched = matched + 1 } else { wrong = wrong + 1 }
            }
        }
        step = step + 1
    }
    nethorde.horde_free(h)
    nav.flow_free(host_field)
    if c != null { nethorde.horde_free(c) }
    if client_field != null { nav.flow_free(client_field) }
    if client != null { net.net_free(client) }
    net.net_free(host)
    net.hub_free(hub)
    if wrong > 0 { return 0 - wrong }
    return matched
}

// --- the physics -------------------------------------------------------------------------------

const GRID_COUNT = 2
const GROUP_SIZE = 2
const GRID_SIZE = 15.0

// A body's transform into the hash, bit for bit.
fold_body(hash: long, id: BodyId, scratch: ptr) -> long {
    t = dynamics.body_get_transform(id)
    v = scratch as float[]
    v[0] = t.p.x
    v[1] = t.p.y
    v[2] = t.p.z
    v[3] = t.q.x
    v[4] = t.q.y
    v[5] = t.q.z
    v[6] = t.q.w
    words = scratch as long[]
    out = hash
    k = 0
    while k < 7 {
        out = fold(out, words[k])
        k = k + 1
    }
    return out
}

// The reference's falling ragdolls (Box3D's shared/determinism.c): the
// hash of every body after every step into `hashes` (long[PHYSICS_STEPS
// + 1]). Returns the step every body slept on, or the steps run.
physics_trail(hashes: ptr) -> int {
    trail = hashes as long[]
    wdef = dynamics.default_world_def()
    wdef.worker_count = 1
    world_id = dynamics.create_world(&wdef)
    half_rows = 4
    grid = mesh.create_grid_mesh(2 * half_rows, 2 * half_rows, GRID_SIZE / (2.0 * (half_rows as float)), 0, true)
    torus = mesh.create_torus_mesh(16, 16, 0.25 * GRID_SIZE, 1.0)
    span = GRID_SIZE * (GRID_COUNT as float)
    humans = GRID_COUNT * GRID_COUNT * GROUP_SIZE
    humans_block = calloc(humans, sizeof(Human))
    bodies_block = calloc(humans * human.BONE_COUNT, sizeof(BodyId))
    bodies = bodies_block as BodyId[]
    gdef = dynamics.default_body_def()
    sdef = dynamics.default_shape_def()
    n = 0
    i = 0
    while i < GRID_COUNT {
        j = 0
        while j < GRID_COUNT {
            gdef.position = math.vec3(0.0 - 0.5 * span + 0.5 * GRID_SIZE + (i as float) * GRID_SIZE, 0.0,
                                      0.0 - 0.5 * span + 0.5 * GRID_SIZE + (j as float) * GRID_SIZE)
            ground = dynamics.create_body(world_id, &gdef)
            dynamics.create_mesh_shape(ground, &sdef, grid, math.vec3_one())
            dynamics.create_mesh_shape(ground, &sdef, torus, math.vec3_one())
            group = i * GRID_COUNT + j
            apart = span / (GRID_COUNT as float)
            position = math.vec3(0.0 - 0.5 * span + apart * ((j as float) + 0.5), 15.0, 0.0 - 0.5 * span + apart * ((i as float) + 0.5))
            k = 0
            while k < GROUP_SIZE {
                who = (humans_block + n * sizeof(Human)) as *Human
                human.create_human(who, world_id, position, 5.0, 1.0, 0.7, group, null)
                b = 0
                while b < human.BONE_COUNT {
                    bodies[n * human.BONE_COUNT + b] = human.bone_at(who, b).body_id
                    b = b + 1
                }
                position.x = position.x + 0.75
                n = n + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    scratch = calloc(8, 8)
    slept = PHYSICS_STEPS
    step = 1
    while step <= PHYSICS_STEPS {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        hash = FNV_BASIS
        b = 0
        while b < humans * human.BONE_COUNT {
            hash = fold_body(hash, bodies[b], scratch)
            b = b + 1
        }
        trail[step] = hash
        if physics_world.get_awake_body_count(world_id) == 0 {
            slept = step
            break
        }
        step = step + 1
    }
    free(scratch)
    n = 0
    while n < humans {
        human.destroy_human((humans_block + n * sizeof(Human)) as *Human)
        n = n + 1
    }
    free(bodies_block)
    free(humans_block)
    dynamics.destroy_world(world_id)
    mesh.destroy_mesh(grid)
    mesh.destroy_mesh(torus)
    return slept
}

same_trail(a: ptr, b: ptr, count: int) -> bool {
    x = a as long[]
    y = b as long[]
    i = 1
    while i <= count {
        if x[i] != y[i] { return false }
        i = i + 1
    }
    return true
}

// The trail as text: a line a tick and a line a step, each hash in
// sixteen hex digits, so the three runners' files compare byte for byte.
write_trail(path: string, horde_hashes: ptr, physics_hashes: ptr, slept: int) {
    b = strbuilder.new(65536)
    horde_trail_words = horde_hashes as long[]
    t = 1
    while t <= TICKS {
        strbuilder.append(b, "horde ")
        strbuilder.append_int(b, t)
        strbuilder.append(b, " ")
        strbuilder.append_hex(b, horde_trail_words[t], 16)
        strbuilder.append(b, "\n")
        t = t + 1
    }
    physics_words = physics_hashes as long[]
    s = 1
    while s <= slept {
        strbuilder.append(b, "physics ")
        strbuilder.append_int(b, s)
        strbuilder.append(b, " ")
        strbuilder.append_hex(b, physics_words[s], 16)
        strbuilder.append(b, "\n")
        s = s + 1
    }
    strbuilder.append(b, "physics slept ")
    strbuilder.append_int(b, slept)
    strbuilder.append(b, "\n")
    text = strbuilder.finish(b)
    err = fs.write(path, text)
    if err != "" { println("  could not write the trail to ${path}: ${err}") }
    string.free(text)
}

main() {
    println("determinism: the horde and the physics, hashed at every tick")
    alone = calloc(TICKS + 1, 8)
    pooled = calloc(TICKS + 1, 8)
    alone_matched = horde_trail(alone)
    jobs.start(4)
    pooled_matched = horde_trail(pooled)
    jobs.stop()
    last = alone as long[]
    println("  horde: ${ZOMBIES} zombies, ${TICKS} ticks; tick ${TICKS} hashes to ${last[TICKS]}; the late client held the host's hash in all ${alone_matched} frames it drew alone and ${pooled_matched} over four threads")
    check("the horde's trail is the same at one thread and at four", same_trail(alone, pooled, TICKS))
    check("a client that joins mid-run holds the host's hash at every tick after it", alone_matched > 60 && pooled_matched > 60)

    first = calloc(PHYSICS_STEPS + 1, 8)
    second = calloc(PHYSICS_STEPS + 1, 8)
    slept = physics_trail(first)
    slept_again = physics_trail(second)
    words = first as long[]
    println("  physics: eight ragdolls dropped on grids and tori slept at step ${slept}; its hash there ${words[slept]}")
    check("the physics' trail is the same run twice", slept == slept_again && same_trail(first, second, slept))
    check("and the ragdolls come to rest", slept < PHYSICS_STEPS)

    path_raw = os.getenv("AE3D_DETERMINISM_TRAIL")
    if path_raw != null {
        path = string.copy(path_raw)
        write_trail(path, alone, first, slept)
        println("  the trail written to ${path}: ${TICKS} ticks of the horde, ${slept} steps of the physics")
        string.free(path)
        string.free(path_raw)
    }
    free(alone)
    free(pooled)
    free(first)
    free(second)
    if g_failures == 0 {
        println("determinism: all checks passed (${g_checks})")
    } else {
        println("determinism: ${g_failures} failure(s) of ${g_checks}")
    }
}
