// Getting up from the front on feet of its own (#841): the box man with
// ankles, POWERED, tripped onto its front, gets up by itself, held to what a
// player sees of its feet. No window.
//
//   - it gets up, and stands POWERED and upright a second on;
//   - its drawn feet go no more than 1 cm into the ground all the way up
//     (a standing foot's flesh sits 0.7 cm in). Kneeling on hands and
//     knees, its shins laid level and its feet at the ankle's rest from
//     them, the drawn toes went 8.8 cm into the ground: they are tucked
//     under now, as a kneeler's are.
//
// Up from its back its feet still go 3.6 cm in, drawn, as it draws its
// knees up out of the pose it lay in (#841, open): printed, not held.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const PUSH = 2.9                      // m/s at the chest, from behind for the front

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    h = physics.ragdoll_human(m.ragdoll)
    turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(h, human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(m.ragdoll))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// One figure struck down onto its front (or its back), getting up: the
// lowest its drawn feet go on the way, and whether it rose and stands.
rise(front: bool) -> (float, bool, bool) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    motion.set_protective(m, false)
    motion.set_get_up(m, 0.5)
    r = m.ragdoll
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
    push = core.v3_mul(facing(m), 0.0 - PUSH * physics.ragdoll_mass(r))
    if front { push = core.v3_mul(push, 0.0 - 1.0) }
    motion.hit(m, human.BONE_SPINE_03, chest, push)
    feet = 1000.0
    rose = false
    up_at = 0 - 1
    k = 0
    while k < 900 {
        engine.engine_update(e, STEP)
        if motion.getting_up(m) {
            rose = true
            i = human.BONE_FOOT_L
            while i <= human.BONE_FOOT_R {
                at, found = physics.ragdoll_flesh_lowest(r, i)
                if found && at < feet { feet = at }
                i = i + 1
            }
        }
        if rose && up_at < 0 && !motion.getting_up(m) { up_at = k }
        if up_at >= 0 && k == up_at + 60 { k = 900 }
        k = k + 1
    }
    stands = up_at >= 0 && motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m)
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return feet, rose, stands
}

main() {
    println("get_up_feet: up from the front on feet of its own, its drawn feet over the ground (#841)")
    feet, rose, stands = rise(true)
    println("  from the front: rose ${rose}, standing ${stands}; its drawn feet ${feet * 100.0} cm at the lowest")
    check("from the front, it gets up and stands POWERED and upright a second on", rose && stands)
    check("from the front, its drawn feet go no more than 1 cm into the ground", feet > 0.0 - 0.01)
    back, rose_b, stands_b = rise(false)
    println("  from the back (not held, #841): rose ${rose_b}, standing ${stands_b}; its drawn feet ${back * 100.0} cm at the lowest")
    if g_failures > 0 {
        println("get_up_feet: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("get_up_feet: all checks passed (${g_checks})")
}
