// A ragdoll dressed in a figure rigged the way Blender exports an IK rig
// (#539), held to numbers: tests/fixtures/gltf/ik_man.glb, written by
// tools/make_gltf_fixture.ae. Its calves have no child; its feet are bones
// hung from Root, their heads at the sole, their +y toward the toes; its
// nodes are saved off the bind pose (Body turned 27 degrees, a stride, the
// arms let down). This is how the CC0 Quaternius characters come, and on
// one of them a fitted ragdoll staggered at a nudge: dressed in the saved
// pose, faced nowhere, its feet hung below the mesh.
//
//   - striking the bind pose puts every bone where its inverse bind matrix
//     says the mesh was modelled: the palette is the identity;
//   - dressed, the figure faces the way its toes point, and the rig's feet
//     on the ragdoll point that way too;
//   - the mesh stands on the ground the ragdoll stands on: its sole and
//     the ragdoll's lowest point within a centimetre;
//   - both legs fitted alike;
//   - the IK feet go with the shins: after a fall, each foot bone is where
//     its calf carried it, not left standing under the root;
//   - POWERED and pushed at the chest from behind, it stands a nudge
//     without a step and holds pushes up to HOLDS N s with a few steps;
//     pushed in front, it holds up to HOLDS_FRONT. Measured on this
//     figure: from behind 200 N s held in two steps and 240 a fall; in
//     front 160 held and 200 a fall. (The Quaternius Adventurer, dressed
//     in its saved pose before #539, staggered six steps at 40 N s.)

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import ae3d.gltf
import std.list
import aephysics.human
import aephysics.dynamics
import aephysics.shape

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const PATH = "tests/fixtures/gltf/ik_man.glb"
const STEP = 0.016666666666666666
const HOLDS = 200.0
const HOLDS_FRONT = 160.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// The lowest point of the mesh, posed where its bones stand now.
mesh_lowest(rig: *Skeleton) -> float {
    low = 1000.0
    i = 0
    while i < skin.skeleton_count(rig) {
        e = skin.skeleton_bone_extreme(rig, i, core.vec3(0.0, 0.0 - 1.0, 0.0))
        if e.found && e.at.y < low { low = e.at.y }
        i = i + 1
    }
    return low
}

// The largest difference from the identity among the palette's entries:
// the bones' world matrices times their inverse binds.
palette_off_identity(rig: *Skeleton) -> float {
    worst = 0.0
    i = 0
    while i < skin.skeleton_count(rig) {
        bone = skin.skeleton_bone(rig, i)
        core.model_sync_transform(bone)
        m = core.mat4_mul(bone.model_matrix, (list.get_raw(rig.bones, i) as *Bone).inverse_bind)
        id = core.mat4_ident()
        k = 0
        while k < 16 {
            d = abs_of(core.mat4_at(m, k / 4, k % 4) - core.mat4_at(id, k / 4, k % 4))
            if d > worst { worst = d }
            k = k + 1
        }
        i = i + 1
    }
    return worst
}

level(v: Vec3) -> Vec3 {
    flat = core.vec3(v.x, 0.0, v.z)
    if core.v3_len(flat) < 0.000001 { return core.vec3(0.0, 0.0, 1.0) }
    return core.v3_normalize(flat)
}

capsule_length(body: BodyId, foot: bool) -> float {
    block = calloc(4, sizeof(ShapeId))
    shapes = block as ShapeId[]
    n = dynamics.body_get_shapes(body, shapes, 4)
    lengths = 0.0
    k = 0
    seen = 0
    while k < n {
        if dynamics.shape_get_type(shapes[k]) == shape.SHAPE_CAPSULE {
            c = dynamics.shape_get_capsule(shapes[k])
            if (seen == 0) == foot { lengths = core.v3_len(core.v3_sub(c.center2, c.center1)) }
            seen = seen + 1
        }
        k = k + 1
    }
    free(block)
    return lengths
}

// One figure in an engine of its own.
struct Trial {
    e: *Engine
    scene: *GltfScene
    rig: *Skeleton
    r: *Ragdoll
    m: *Motion
}

trial_new() -> *Trial {
    t = calloc(1, sizeof(Trial)) as *Trial
    t.e = engine.engine_new()
    engine.engine_set_fixed_step(t.e, STEP)
    physics.attach(t.e)
    ground = engine.object(t.e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    t.r = physics.ragdoll(t.e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    t.scene = gltf.load(PATH)
    t.rig = gltf.skeleton(t.scene, 0)
    names = ["Hips", "Abdomen", "Chest", "Neck",
             "UpperLeg.L", "LowerLeg.L", "UpperLeg.R", "LowerLeg.R",
             "UpperArm.L", "LowerArm.L", "UpperArm.R", "LowerArm.R"]
    if !physics.ragdoll_dress_named(t.r, t.rig, names) {
        println("  could not dress the IK man")
        exit(1)
    }
    t.m = motion.active_ragdoll(t.r)
    motion.attach(t.e, t.m)
    motion.set_mode(t.m, motion.POWERED)
    return t
}

trial_free(t: *Trial) {
    engine.engine_free(t.e)
    motion.motion_free(t.m)
    gltf.scene_destroy(t.scene)
    free(t as ptr)
}

run(t: *Trial, steps: int) {
    k = 0
    while k < steps {
        engine.engine_update(t.e, STEP)
        k = k + 1
    }
}

// Pushed at the chest with `amount` N s along the figure's facing (from
// behind) or against it, one second after it stands: whether it stands
// three seconds later, the steps it took and its worst lean in degrees.
struct Push {
    stood: bool
    steps: int
    lean: float
}

push(amount: float, behind: bool) -> Push {
    t = trial_new()
    run(t, 60)
    forward = level(physics.ragdoll_rest_forward(t.r))
    sign = 1.0
    if !behind { sign = 0.0 - 1.0 }
    chest = behaviour.object_position(physics.ragdoll_bone(t.r, human.BONE_SPINE_03))
    if amount > 0.0 {
        motion.hit(t.m, human.BONE_SPINE_03, chest, core.vec3(sign * amount * forward.x, 0.0, sign * amount * forward.z))
    }
    worst = 0.0
    k = 0
    while k < 180 {
        engine.engine_update(t.e, STEP)
        if motion.tilt(t.m) > worst { worst = motion.tilt(t.m) }
        k = k + 1
    }
    out = Push {
        stood: behaviour.object_position(physics.ragdoll_bone(t.r, human.BONE_PELVIS)).y >= 0.8,
        steps: motion.steps_taken(t.m),
        lean: worst * 57.29578
    }
    way = "behind"
    if !behind { way = "front" }
    println("  pushed from ${way} with ${amount} N s: stood ${out.stood}, ${out.steps} steps, worst lean ${out.lean} deg")
    trial_free(t)
    return out
}

main() {
    println("ragdoll on an IK rig: ${PATH}")

    // The file's nodes are saved off the bind pose.
    scene = gltf.load(PATH)
    rig = gltf.skeleton(scene, 0)
    saved = palette_off_identity(rig)
    skin.skeleton_strike_bind(rig)
    struck = palette_off_identity(rig)
    println("  palette off the identity: ${saved} as saved, ${struck} in the bind pose")
    check("the file's nodes are saved off the bind pose", saved > 0.1)
    check("striking the bind pose puts every bone where its inverse bind says (palette within 1e-4 of the identity)", struck < 0.0001)
    gltf.scene_destroy(scene)

    // Dressed: facing, ground, legs.
    t = trial_new()
    forward = level(physics.ragdoll_rest_forward(t.r))
    foot_l = skin.skeleton_bone(t.rig, skin.skeleton_find(t.rig, "Foot.L"))
    foot_r = skin.skeleton_bone(t.rig, skin.skeleton_find(t.rig, "Foot.R"))
    core.model_sync_transform(foot_l)
    core.model_sync_transform(foot_r)
    toes = level(core.v3_add(core.quat_apply(foot_l.world_rotation, core.vec3(0.0, 1.0, 0.0)), core.quat_apply(foot_r.world_rotation, core.vec3(0.0, 1.0, 0.0))))
    facing = core.v3_dot(toes, forward)
    sole = mesh_lowest(t.rig)
    lowest = physics.ragdoll_pose_lowest(t.r, null)
    h = physics.ragdoll_human(t.r)
    shin_l = capsule_length(human.bone_at(h, human.BONE_CALF_L).body_id, false)
    shin_r = capsule_length(human.bone_at(h, human.BONE_CALF_R).body_id, false)
    println("  dressed: toes . facing ${facing}; the mesh's sole at ${sole} m, the ragdoll's lowest at ${lowest} m; shins ${shin_l} and ${shin_r} m")
    check("the figure faces the way its toes point", facing > 0.95)
    check("the mesh stands where the ragdoll does (sole within 1 cm of its lowest point)", abs_of(sole - lowest) < 0.01)
    check("both legs fitted alike (shins within 1 mm)", abs_of(shin_l - shin_r) < 0.001)

    // A fall: the IK feet go with the shins.
    run(t, 60)
    motion.hit(t.m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(t.r, human.BONE_SPINE_03)),
               core.vec3(400.0 * forward.x, 0.0, 400.0 * forward.z))
    run(t, 180)
    worst_gap = 0.0
    pose = calloc(human.BONE_COUNT * 7, 8)
    physics.ragdoll_body_pose(t.r, pose)
    side = 0
    while side < 2 {
        calf = human.BONE_CALF_L
        foot = foot_l
        if side == 1 {
            calf = human.BONE_CALF_R
            foot = foot_r
        }
        core.model_sync_transform(foot)
        ankle = physics.ragdoll_pose_end(t.r, pose, calf)
        gap = core.v3_len(core.v3_sub(foot.world_position, ankle))
        if gap > worst_gap { worst_gap = gap }
        side = side + 1
    }
    free(pose)
    pelvis = behaviour.object_position(physics.ragdoll_bone(t.r, human.BONE_PELVIS))
    println("  fallen: pelvis at ${pelvis.y} m; each IK foot within ${worst_gap} m of its shin's end")
    check("the figure fell", pelvis.y < 0.5)
    check("the IK feet went with the shins (each foot bone within 10 cm of its shin's end)", worst_gap < 0.1)
    trial_free(t)

    // Balance.
    still = push(0.0, true)
    nudge = push(40.0, true)
    check("standing, it holds itself without a step", still.stood && still.steps == 0)
    check("a 40 N s nudge from behind takes no step and leans under 5 degrees", nudge.stood && nudge.steps == 0 && nudge.lean < 5.0)
    amount = 80.0
    held = true
    while amount <= HOLDS {
        p = push(amount, true)
        if !p.stood || p.steps > 4 { held = false }
        amount = amount + 40.0
    }
    check("pushes from behind up to ${HOLDS} N s are held, with at most four steps", held)
    held_front = true
    amount = 40.0
    while amount <= HOLDS_FRONT {
        p = push(amount, false)
        if !p.stood { held_front = false }
        amount = amount + 40.0
    }
    check("pushes from in front up to ${HOLDS_FRONT} N s are held", held_front)

    if g_failures == 0 {
        println("ragdoll on an IK rig: all checks passed (${g_checks})")
    } else {
        println("ragdoll on an IK rig: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
