// Sound in the world (#415), held to numbers through a headless mix: an
// engine stepped by hand, its sound opened headless (AE3D_AUDIO=headless),
// the mixer rendered only when asked (audio.attach_headless). The clip is a constant-sample tone, so
// a block's peak is its gain and pan exactly.
//
//   - distance: within min_distance, full; at twice it, half; at four times,
//     a quarter; held past max_distance -- min / d, the gain applied and the
//     peak rendered both;
//   - pan, equal-power: a source dead ahead is centred (each side
//     cos(pi/4) of the gain); one 90 degrees to the right is all right;
//     one crossing in front goes from left to right through the middle;
//   - Doppler: a car passing at 30 m/s is heard at 343 / (343 - 30) of its
//     pitch coming and 343 / (343 + 30) going, within a hundredth of a
//     percent of the formula;
//   - buses: the effects bus at half volume halves its sources' peak and no
//     other bus's; music ducked under a voice falls to the duck's share
//     while the voice plays and comes back after;
//   - a source goes with its object; a non-spatial one plays centred;
//   - what placing 256 sources costs a frame.

import std.fs
import std.audio as mix
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.audio as sound

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

const RATE = 48000
const LEVEL = 0.5                    // the tone's sample
const WAV = "build/test_audio_tone.wav"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
    fflush(null)
}

near(a: float, b: float, tolerance: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tolerance
}

// A second of 16-bit mono at LEVEL, as a WAV file.
write_tone() {
    frames = RATE
    total = 44 + frames * 2
    data = calloc(total, 1)
    b = data as byte[]
    put_text(b, 0, "RIFF")
    put32(b, 4, total - 8)
    put_text(b, 8, "WAVE")
    put_text(b, 12, "fmt ")
    put32(b, 16, 16)
    put16(b, 20, 1)
    put16(b, 22, 1)
    put32(b, 24, RATE)
    put32(b, 28, RATE * 2)
    put16(b, 32, 2)
    put16(b, 34, 16)
    put_text(b, 36, "data")
    put32(b, 40, frames * 2)
    sample = (LEVEL * 32767.0) as int
    i = 0
    while i < frames {
        put16(b, 44 + i * 2, sample)
        i = i + 1
    }
    fs.write_binary(WAV, b[0..total])
    free(data)
}

put_text(b: byte[], at: int, s: string) {
    i = 0
    while i < 4 {
        b[at + i] = string_char(s, i)
        i = i + 1
    }
}

string_char(s: string, i: int) -> int { return string.char_at(s, i) }

put16(b: byte[], at: int, v: int) {
    b[at] = v & 255
    b[at + 1] = (v / 256) & 255
}

put32(b: byte[], at: int, v: int) {
    b[at] = v & 255
    b[at + 1] = (v / 256) & 255
    b[at + 2] = (v / 65536) & 255
    b[at + 3] = (v / 16777216) & 255
}

// The engine, stepped by hand: no window, so no camera; the listener is an
// object at the origin facing -z, its right +x (a player's head).
world() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

// A frame: the engine stepped, then a block of the mix rendered (a
// hundredth of a second, after the fade std.audio applies to a change).
frame(e: *Engine) {
    engine.engine_update(e, STEP)
    mix.render(RATE / 50)
    mix.render(RATE / 100)
}

emitter(e: *Engine, name: string, at: Vec3, bus: int) -> *AudioSource {
    o = engine.object(e, name, null)
    behaviour.object_set_position(o, at)
    s = sound.source(o, WAV, bus)
    sound.set_looping(s, true)
    sound.set_distances(s, 2.0, 40.0)
    return s
}

main() {
    println("audio: sound in the world, held to numbers (#415)")
    write_tone()
    e = world()
    a = sound.attach_headless(e, RATE)
    if !sound.headless(a) {
        println("audio: SKIP the mix could not be opened headless")
        engine.engine_free(e)
        return
    }
    centre = LEVEL * 0.70710678
    head = engine.object(e, "listener", null)
    sound.set_listener(e, head)

    // Distance.
    s = emitter(e, "tone", core.vec3(0.0, 0.0, 0.0 - 1.0), sound.EFFECTS)
    o = s.object as *GameObject
    sound.play(s)
    distances = [1.0, 2.0, 4.0, 8.0, 40.0, 80.0]
    wants = [1.0, 1.0, 0.5, 0.25, 0.05, 0.05]
    wrong = ""
    k = 0
    while k < 6 {
        behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0 - distances[k]))
        frame(e)
        g = sound.gain(s)
        peak = mix.rendered_peak(0)
        if !near(g, wants[k], 0.0001) || !near(peak, centre * wants[k], 0.001) {
            wrong = "${wrong} at ${distances[k]} m gain ${g} peak ${peak};"
        }
        k = k + 1
    }
    check("distance: full within min_distance, min / d past it, held at max_distance -- in the gain and the rendered peak${wrong}", wrong == "")

    // Pan.
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0 - 2.0))
    frame(e)
    ahead_l = mix.rendered_peak(0)
    ahead_r = mix.rendered_peak(1)
    behaviour.object_set_position(o, core.vec3(2.0, 0.0, 0.0))
    frame(e)
    right_l = mix.rendered_peak(0)
    right_r = mix.rendered_peak(1)
    println("  ahead: left ${ahead_l} right ${ahead_r}; to the right: left ${right_l} right ${right_r}")
    check("pan: dead ahead is centred, each side cos(pi/4) of it", near(ahead_l, centre, 0.001) && near(ahead_r, centre, 0.001))
    check("pan: 90 degrees to the right is all right", right_l < 0.001 && near(right_r, LEVEL, 0.001))
    // Crossing in front, two metres ahead, from four to the left to four to the right.
    last_pan = 0.0 - 2.0
    monotonic = true
    mid_l = 0.0
    mid_r = 0.0
    x = 0.0 - 4.0
    while x <= 4.0 {
        behaviour.object_set_position(o, core.vec3(x, 0.0, 0.0 - 2.0))
        frame(e)
        p = sound.pan(s)
        if p < last_pan { monotonic = false }
        last_pan = p
        if near(x, 0.0, 0.01) {
            mid_l = mix.rendered_peak(0)
            mid_r = mix.rendered_peak(1)
        }
        x = x + 0.5
    }
    check("pan: a source crossing in front goes from left to right through the middle (${mid_l}, ${mid_r} at the middle)",
          monotonic && near(mid_l, mid_r, 0.001) && last_pan > 0.85)

    // Doppler: a car passing at 30 m/s, 5 m to the side.
    sound.set_distances(s, 1.0, 400.0)
    behaviour.object_set_position(o, core.vec3(0.0 - 100.0, 0.0, 0.0 - 5.0))
    frame(e)
    speed = 30.0
    behaviour.object_set_position(o, core.vec3(0.0 - 100.0 + speed * STEP, 0.0, 0.0 - 5.0))
    frame(e)
    coming = sound.pitch(s)
    behaviour.object_set_position(o, core.vec3(100.0, 0.0, 0.0 - 5.0))
    frame(e)
    behaviour.object_set_position(o, core.vec3(100.0 + speed * STEP, 0.0, 0.0 - 5.0))
    frame(e)
    going = sound.pitch(s)
    // Along the line to the listener, 100 m off and 5 aside: the speed's
    // share toward it.
    along = speed * 100.0 / core.sqrt_of(100.0 * 100.0 + 25.0)
    want_coming = sound.SPEED_OF_SOUND / (sound.SPEED_OF_SOUND - along)
    want_going = sound.SPEED_OF_SOUND / (sound.SPEED_OF_SOUND + along)
    println("  a car at 30 m/s: coming ${coming} (${want_coming}), going ${going} (${want_going}); the mixer's ${mix.get_pitch(s.sound)}")
    check("Doppler: coming and going at the formula's pitch, to a hundredth of a percent",
          near(coming, want_coming, want_coming * 0.0001) && near(going, want_going, want_going * 0.0001) &&
          near(mix.get_pitch(s.sound), going, 0.0001))
    sound.set_doppler(s, 0.0)
    frame(e)
    check("Doppler off: the pitch asked for", near(sound.pitch(s), 1.0, 0.000001))
    sound.set_doppler(s, 1.0)
    sound.stop(s)

    // Buses: an effect and a piece of music, side by side, not spatial.
    sound.set_spatial(s, false)
    sound.play(s)
    music = emitter(e, "music", core.vec3(0.0, 0.0, 0.0), sound.MUSIC)
    sound.set_spatial(music, false)
    sound.play(music)
    frame(e)
    both = mix.rendered_peak(0)
    sound.stop(music)
    frame(e)
    effect_alone = mix.rendered_peak(0)
    sound.set_bus_volume(e, sound.EFFECTS, 0.5)
    frame(e)
    effect_half = mix.rendered_peak(0)
    sound.stop(s)
    sound.play(music)
    frame(e)
    music_alone = mix.rendered_peak(0)
    println("  buses: effect alone ${effect_alone}, at half volume ${effect_half}; music alone ${music_alone}; together ${both}")
    check("a non-spatial source plays centred at its volume", near(effect_alone, centre, 0.001))
    check("two sources mix: the effect and the music together are the two summed", near(both, centre * 2.0, 0.002))
    check("the effects bus at half volume halves the effect and not the music", near(effect_half, centre * 0.5, 0.001) && near(music_alone, centre, 0.001))
    sound.set_bus_volume(e, sound.EFFECTS, 1.0)

    // Ducking: music under a voice.
    voice = emitter(e, "voice", core.vec3(0.0, 0.0, 0.0), sound.VOICE)
    sound.set_spatial(voice, false)
    sound.set_volume(voice, 0.0)
    sound.duck(e, sound.MUSIC, sound.VOICE, 0.35)
    sound.play(voice)
    k = 0
    while k < 30 {
        frame(e)
        k = k + 1
    }
    ducked = mix.group_get_volume(groups_of(a, sound.MUSIC))
    sound.stop(voice)
    k = 0
    while k < 30 {
        frame(e)
        k = k + 1
    }
    back = mix.group_get_volume(groups_of(a, sound.MUSIC))
    println("  music under a voice: ${ducked}, after it ${back}")
    check("music ducks to its share under a voice and comes back after", near(ducked, 0.35, 0.0001) && near(back, 1.0, 0.0001))
    sound.stop(music)

    // A source goes with its object.
    before = sound.source_count(a)
    engine.destroy(e, o)
    frame(e)
    check("a source goes with its object (${before} then ${sound.source_count(a)})", sound.source_count(a) == before - 1)

    // The cost of 256 sources.
    i = 0
    while i < 256 {
        many = emitter(e, "crowd ${i}", core.vec3((i % 16) as float * 3.0 - 24.0, 0.0, (i / 16) as float * 3.0 - 24.0), sound.AMBIENCE)
        sound.play(many)
        i = i + 1
    }
    worst = 0.0
    k = 0
    while k < 20 {
        engine.engine_update(e, STEP)
        if sound.update_seconds(a) > worst { worst = sound.update_seconds(a) }
        k = k + 1
    }
    println("  ${sound.source_count(a)} sources placed in ${worst * 1000.0} ms a frame at worst")
    check("256 sources are placed in under a millisecond a frame", worst < 0.001)

    engine.engine_free(e)
    fs.delete(WAV)
    if g_failures == 0 {
        println("audio: all checks passed (${g_checks})")
    } else {
        println("audio: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}

groups_of(a: *Audio, bus: int) -> ptr { return (a.groups as ptr[])[bus] }
