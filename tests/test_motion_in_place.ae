// A motion put on a figure leaves the figure where it stands (#928): the box
// man fixture, its Idle playing, turned a quarter turn, given an active
// ragdoll by motion.on_figure (ANIMATED), against a twin with none in an
// engine of its own. No window; stepped at 60 Hz. Dressed as a ragdoll is,
// the figure was stood on the ragdoll's pelvis and set down on the
// reference's feet, and the UE5 mannequin moved 2.6 cm forward and 1.4 cm
// down before anything touched it.
//
//   - its object where it was put, exactly;
//   - for its first second every bone drawn within 1e-6 m of the twin's.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.motion

extern exit(code: int)

const STEP = 0.016666666666666666
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

stage(e: *Engine, name: string) -> *GameObject {
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    o = figure.figure(e, name, BOXMAN)
    if o == null { return null }
    behaviour.object_set_position(o, core.vec3(1.5, 0.0, 2.0))
    behaviour.object_set_rotation(o, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    figure.play(figure.figure_of(o), "Idle", 1.0, true)
    return o
}

main() {
    println("motion_in_place: a motion put on a figure leaves it where it stands (#928)")
    e = engine.engine_new()
    o = stage(e, "Moved")
    e_t = engine.engine_new()
    twin = stage(e_t, "Twin")
    check("two box men made", o != null && twin != null)
    if o == null || twin == null { exit(1) }
    before = behaviour.object_position(o)
    m = motion.on_figure(e, o)
    check("an active ragdoll put on it", m != null)
    if m == null { exit(1) }
    after = behaviour.object_position(o)
    moved = core.v3_len(core.v3_sub(after, before))
    println("  its object moved ${moved * 1000.0} mm as the motion was put on")
    check("its object where it was put, exactly (within 1e-9 m)", moved < 0.000000001)
    sk = figure.skeleton(figure.figure_of(o))
    sk_t = figure.skeleton(figure.figure_of(twin))
    worst = 0.0
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        engine.engine_update(e_t, STEP)
        b = 0
        while b < skin.skeleton_count(sk) {
            one = skin.skeleton_bone(sk, b)
            two = skin.skeleton_bone(sk_t, b)
            core.model_sync_transform(one)
            core.model_sync_transform(two)
            d = core.v3_len(core.v3_sub(one.world_position, two.world_position))
            if d > worst { worst = d }
            b = b + 1
        }
        k = k + 1
    }
    println("  its first second: every bone within ${worst * 1000.0} mm of the twin's")
    check("for its first second every bone drawn within 1e-6 m of the twin's, ANIMATED", worst < 0.000001)
    engine.engine_free(e)
    motion.motion_free(m)
    physics.physics_free(physics.of(e_t))
    figure.figures_free(e_t)
    engine.engine_free(e_t)
    if g_failures == 0 {
        println("motion_in_place: all checks passed (${g_checks})")
        return
    }
    println("motion_in_place: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
