// Menus that can be pointed at, clicked and typed into (#484), driven by
// synthetic cursor and key events through ae3d.input, at two window sizes
// and two UI scales:
//
//   - a click lands on the widget under it and none behind it: two buttons
//     that overlap, the later added in front; a menu pushed over another
//     takes the click where it covers the one below; outside the panel
//     nothing is clicked;
//   - a toggle flips, a slider takes the value where it is clicked (on its
//     step), a text field ends with exactly the characters typed, UTF-8
//     and Backspace included;
//   - the focus goes round the widgets in the order they were added with
//     Tab, back with Shift+Tab, with the arrows and the d-pad, wrapping;
//     Enter and A activate, left and right move a slider and set a toggle;
//   - Escape pops a menu that may be closed and not one that may not;
//   - the game's input sees nothing while a menu is open -- not the click,
//     not the keys, not the typing, not the mouse's movement -- and no
//     edge when the menu closes with a key still down.
//
// Then the menu drawn on both renderers: every widget where the hit test
// says it is, the focus ring round the focused one, Vulkan as OpenGL.

import std.mem
import std.string
import ae3d.core
import ae3d.platform
import ae3d.input
import ae3d.hud
import ae3d.menu
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
    fflush(null)
}

abs_of(v: float) -> float {
    if v < 0.0 { return 0.0 - v }
    return v
}

// The widgets, in the order they are added: what the focus goes round.
const BACK = 0
const FRONT = 1
const SOUND = 2
const VOLUME = 3
const NAME = 4

struct Scene {
    inp: ptr                  // *Input
    o: ptr                   // *Hud
    stack: ptr               // *MenuStack
    pause: ptr               // *Menu
    confirm: ptr             // *Menu
    width: int
    height: int
    scale: float
}

// The pause menu: two buttons that overlap in the middle (BACK spans -90 to
// 10 points across the centre, FRONT -10 to 90), a toggle, a slider and a
// text field, on a 220 x 170 point panel at the centre.
pause_menu() -> *Menu {
    m = menu.menu_new("pause")
    menu.set_panel(m, hud.CENTRE, 0.0, 0.0, 220.0, 170.0)
    menu.button(m, "Back", hud.CENTRE, 0.0 - 40.0, 0.0 - 55.0, 100.0, 28.0)
    menu.button(m, "Front", hud.CENTRE, 40.0, 0.0 - 55.0, 100.0, 28.0)
    menu.toggle(m, "Sound", hud.CENTRE, 0.0, 0.0 - 20.0, 180.0, 28.0, false)
    menu.slider(m, "Volume", hud.CENTRE, 0.0, 15.0, 180.0, 28.0, 0.0, 1.0, 0.5, 0.1)
    menu.field(m, "Name", hud.CENTRE, 0.0, 50.0, 180.0, 28.0)
    return m
}

// The point at `dx`, `dy` points from the screen's centre, in pixels --
// from the screen's size and scale, not from the menu's arithmetic.
at_x(sc: *Scene, dx: float) -> float { return (sc.width as float) * 0.5 + dx * sc.scale }
at_y(sc: *Scene, dy: float) -> float { return (sc.height as float) * 0.5 + dy * sc.scale }

// One frame: the input polled, the menus given it.
frame(sc: *Scene) {
    input.poll(sc.inp as *Input)
    menu.process(sc.stack as *MenuStack, sc.inp as *Input, sc.o as *Hud)
}

// A click at a pixel: the cursor there, pressed for a frame, released.
// What it activated is read after the release's frame.
click(sc: *Scene, x: float, y: float) {
    inp = sc.inp as *Input
    input.inject_cursor(inp, x, y)
    input.inject_mouse(inp, platform.MOUSE_LEFT, true)
    frame(sc)
    input.inject_mouse(inp, platform.MOUSE_LEFT, false)
    frame(sc)
}

// A key pressed for a frame and released.
tap(sc: *Scene, key: int) {
    inp = sc.inp as *Input
    input.inject_key(inp, key, true)
    frame(sc)
    input.inject_key(inp, key, false)
    frame(sc)
}

pad(sc: *Scene, button: int) {
    inp = sc.inp as *Input
    input.inject_button(inp, button, true)
    frame(sc)
    input.inject_button(inp, button, false)
    frame(sc)
}

shift_tab(sc: *Scene) {
    inp = sc.inp as *Input
    input.inject_key(inp, platform.KEY_LEFT_SHIFT, true)
    tap(sc, platform.KEY_TAB)
    input.inject_key(inp, platform.KEY_LEFT_SHIFT, false)
    frame(sc)
}

// What a click activated, as names.
activations(m: *Menu) -> string {
    names = ""
    i = 0
    while i < menu.widget_count(m) {
        if menu.activated(m, i) { names = "${names} ${i}" }
        i = i + 1
    }
    if names == "" { return "none" }
    return names
}

// The game's bindings, read through the block: none may stir while a menu
// is open.
var g_game_stirred = 0

game_reads(inp: *Input) {
    if input.pressed(inp, "fire") || input.held(inp, "fire") || input.released(inp, "fire") { g_game_stirred = g_game_stirred + 1 }
    if input.pressed(inp, "jump") || input.held(inp, "jump") { g_game_stirred = g_game_stirred + 1 }
    if input.pressed(inp, "pause") { g_game_stirred = g_game_stirred + 1 }
    if input.typed_count(inp) > 0 { g_game_stirred = g_game_stirred + 1 }
    if input.mouse_dx(inp) != 0.0 || input.mouse_dy(inp) != 0.0 { g_game_stirred = g_game_stirred + 1 }
}

run_size(width: int, height: int, scale: float) {
    label = "${width} x ${height} at ${scale}"
    inp = input.input_new(null)
    input.bind_mouse(inp, "fire", platform.MOUSE_LEFT)
    input.bind_key(inp, "jump", platform.KEY_SPACE)
    input.bind_key(inp, "pause", platform.KEY_ESCAPE)
    o = hud.hud_new()
    hud.set_screen(o, width, height, scale)
    stack = menu.stack_new()
    pause = pause_menu()
    sc = Scene { inp: inp as ptr, o: o as ptr, stack: stack as ptr, pause: pause as ptr, confirm: null,
                 width: width, height: height, scale: scale }
    menu.push(stack, pause)
    frame(&sc)

    // Clicks.
    click(&sc, at_x(&sc, 0.0), at_y(&sc, 0.0 - 55.0))
    overlap = activations(pause)
    click(&sc, at_x(&sc, 0.0 - 70.0), at_y(&sc, 0.0 - 55.0))
    back_only = activations(pause)
    click(&sc, at_x(&sc, 80.0), at_y(&sc, 0.0 - 55.0))
    front_only = activations(pause)
    check("${label}: a click where two buttons overlap is the front one's alone (${overlap}), each one's own its (${back_only}, ${front_only})",
          overlap == " 1" && back_only == " 0" && front_only == " 1")
    click(&sc, at_x(&sc, 0.0 - 100.0), at_y(&sc, 0.0 - 80.0))
    corner = activations(pause)
    click(&sc, 2.0, 2.0)
    outside = activations(pause)
    check("${label}: a click on the panel between widgets, or outside it, clicks nothing (${corner}, ${outside})",
          corner == "none" && outside == "none")
    click(&sc, at_x(&sc, 0.0), at_y(&sc, 0.0 - 20.0))
    check("${label}: a click flips the toggle", menu.on(pause, SOUND) && menu.changed(pause, SOUND))
    // 72% along the slider (180 points from -90): 0.72, on its step 0.7.
    click(&sc, at_x(&sc, 0.0 - 90.0 + 180.0 * 0.72), at_y(&sc, 15.0))
    check("${label}: a click on the slider takes the value there, on its step (${menu.value(pause, VOLUME)})",
          abs_of(menu.value(pause, VOLUME) - 0.7) < 0.000001)

    // Typing.
    click(&sc, at_x(&sc, 0.0), at_y(&sc, 50.0))
    input.inject_text(inp, "Zoë 7")
    frame(&sc)
    typed = menu.text(pause, NAME)
    tap(&sc, platform.KEY_BACKSPACE)
    input.inject_text(inp, "!é")
    frame(&sc)
    tap(&sc, platform.KEY_BACKSPACE)
    edited = menu.text(pause, NAME)
    check("${label}: the field has exactly what was typed (\"${typed}\", then \"${edited}\")",
          typed == "Zoë 7" && edited == "Zoë !" && menu.focus(pause) == NAME)
    string.free(typed)
    string.free(edited)

    // The focus, round the widgets.
    menu.set_focus(pause, BACK)
    order = "${menu.focus(pause)}"
    k = 0
    while k < 5 {
        tap(&sc, platform.KEY_TAB)
        order = "${order} ${menu.focus(pause)}"
        k = k + 1
    }
    shift_tab(&sc)
    order = "${order} ${menu.focus(pause)}"
    tap(&sc, platform.KEY_DOWN)
    order = "${order} ${menu.focus(pause)}"
    pad(&sc, input.PAD_UP)
    order = "${order} ${menu.focus(pause)}"
    pad(&sc, input.PAD_DOWN)
    order = "${order} ${menu.focus(pause)}"
    check("${label}: Tab goes round in order and wraps, Shift+Tab back, the arrows and the d-pad too (${order})",
          order == "0 1 2 3 4 0 4 0 4 0")
    menu.set_focus(pause, SOUND)
    before = menu.on(pause, SOUND)
    tap(&sc, platform.KEY_ENTER)
    flipped = menu.on(pause, SOUND) != before
    tap(&sc, platform.KEY_LEFT)
    off = !menu.on(pause, SOUND)
    pad(&sc, input.PAD_RIGHT)
    on_again = menu.on(pause, SOUND)
    menu.set_focus(pause, VOLUME)
    tap(&sc, platform.KEY_RIGHT)
    up = menu.value(pause, VOLUME)
    tap(&sc, platform.KEY_LEFT)
    tap(&sc, platform.KEY_LEFT)
    down = menu.value(pause, VOLUME)
    // A key or a button activates as it goes down.
    menu.set_focus(pause, FRONT)
    input.inject_button(inp, input.PAD_A, true)
    frame(&sc)
    a_clicks = activations(pause)
    input.inject_button(inp, input.PAD_A, false)
    frame(&sc)
    check("${label}: Enter flips the focused toggle, left and right set it (${flipped}, ${off}, ${on_again})",
          flipped && off && on_again)
    check("${label}: left and right move the focused slider by its step (${up}, ${down})",
          abs_of(up - 0.8) < 0.000001 && abs_of(down - 0.6) < 0.000001)
    check("${label}: the gamepad's A activates the focused button (${a_clicks})", a_clicks == " 1")

    // A menu over it takes the click where it covers the one below.
    confirm = menu.menu_new("confirm")
    yes = menu.button(confirm, "Yes", hud.CENTRE, 0.0, 50.0, 120.0, 28.0)
    menu.push(stack, confirm)
    frame(&sc)
    name_before = menu.text(pause, NAME)
    focus_before = menu.focus(pause)
    click(&sc, at_x(&sc, 0.0), at_y(&sc, 50.0))
    yes_clicked = menu.activated(confirm, yes)
    input.inject_text(inp, "x")
    frame(&sc)
    name_after = menu.text(pause, NAME)
    check("${label}: the menu on top takes the click, the one under it nothing (yes ${yes_clicked}, the field \"${name_after}\")",
          yes_clicked && name_after == name_before && menu.focus(pause) == focus_before)
    string.free(name_before)
    string.free(name_after)

    // Escape pops what may be closed, and not what may not.
    menu.set_closable(confirm, false)
    tap(&sc, platform.KEY_ESCAPE)
    kept = menu.depth(stack)
    menu.set_closable(confirm, true)
    input.inject_key(inp, platform.KEY_ESCAPE, true)
    frame(&sc)
    popped_confirm = menu.popped(stack) == confirm
    input.inject_key(inp, platform.KEY_ESCAPE, false)
    frame(&sc)
    check("${label}: Escape pops a menu that may be closed, and not one that may not (${kept} then ${menu.depth(stack)})",
          kept == 2 && popped_confirm && menu.depth(stack) == 1)

    // The game, through the block: a whole run of clicking, typing, keys
    // and moving, and the menu closed with Escape still down.
    g_game_stirred = 0
    input.inject_cursor(inp, 10.0, 10.0)
    frame(&sc)
    game_reads(inp)
    input.inject_cursor(inp, 30.0, 40.0)
    input.inject_mouse(inp, platform.MOUSE_LEFT, true)
    input.inject_key(inp, platform.KEY_SPACE, true)
    input.inject_text(inp, "abc")
    frame(&sc)
    game_reads(inp)
    input.inject_mouse(inp, platform.MOUSE_LEFT, false)
    input.inject_key(inp, platform.KEY_SPACE, false)
    frame(&sc)
    game_reads(inp)
    input.inject_key(inp, platform.KEY_ESCAPE, true)
    frame(&sc)
    game_reads(inp)
    closed = menu.depth(stack) == 0
    frame(&sc)
    pause_edge = input.pressed(inp, "pause")
    input.inject_key(inp, platform.KEY_ESCAPE, false)
    frame(&sc)
    input.inject_mouse(inp, platform.MOUSE_LEFT, true)
    frame(&sc)
    fired = input.pressed(inp, "fire")
    input.inject_mouse(inp, platform.MOUSE_LEFT, false)
    frame(&sc)
    check("${label}: the game's input saw nothing while the menu was open (${g_game_stirred} reads stirred)", g_game_stirred == 0)
    check("${label}: and no edge when the menu closed with Escape still down; a click after is the game's",
          closed && !pause_edge && fired)

    menu.menu_free(confirm)
    menu.menu_free(pause)
    menu.stack_free(stack)
    hud.hud_free(o)
    input.input_free(inp)
}

// --- drawn ------------------------------------------------------------------------------------

const DRAW_W = 320
const DRAW_H = 180
const GROUND = 0.05

frame_of(backend: *Backend) -> ptr {
    core.backend_frame_pixels(backend)
    return core.backend_frame_pixels(backend)
}

channel(pixels: ptr, x: int, y: int, c: int) -> int {
    if x < 0 || y < 0 || x >= DRAW_W || y >= DRAW_H { return 0 }
    return mem.get_uint8(pixels, (y * DRAW_W + x) * 4 + c)
}

orange(pixels: ptr, x: int, y: int) -> bool {
    return channel(pixels, x, y, 0) > 200 && channel(pixels, x, y, 1) > 110 && channel(pixels, x, y, 1) < 200 && channel(pixels, x, y, 2) < 90
}

var g_opengl_frame: ptr = null

drawn_checks(backend: *Backend, name: string) {
    core.backend_set_clear_color(backend, GROUND, GROUND, GROUND)
    o = hud.hud_new()
    hud.set_screen(o, DRAW_W, DRAW_H, 1.0)
    core.backend_set_overlay(backend, o as ptr)
    cam = core.camera_new(DRAW_W, DRAW_H)
    light = core.light_sun(core.vec3(0.2, 1.0, 0.4))
    stack = menu.stack_new()
    pause = pause_menu()
    menu.push(stack, pause)
    menu.set_focus(pause, VOLUME)
    menu.draw(stack, o)
    core.backend_render(backend, cam, light)
    pixels = frame_of(backend)
    if pixels == null {
        println("menu: SKIP ${name} gave no pixels")
    } else {
        // Each widget's face is lit where the hit test puts the widget: its
        // middle differs from the panel's dark ground.
        panel = channel(pixels, DRAW_W / 2 - 105, DRAW_H / 2 + 80, 1)
        missing = ""
        i = 0
        while i < menu.widget_count(pause) {
            x, y, w, h = menu.widget_rect(o, pause, i)
            mx = (x + w * 0.1) as int
            my = (y + h * 0.5) as int
            face = channel(pixels, mx, my, 0) + channel(pixels, mx, my, 1) + channel(pixels, mx, my, 2)
            if i == NAME {
                // The field is darker than the panel, and outlined.
                if channel(pixels, (x + w * 0.5) as int, y as int, 1) <= panel { missing = "${missing} ${i}" }
            } else if face <= panel * 3 + 15 {
                missing = "${missing} ${i}"
            }
            i = i + 1
        }
        check("${name}: every widget is drawn where the hit test says it is${missing}", missing == "")
        x, y, w, h = menu.widget_rect(o, pause, VOLUME)
        ring_above = orange(pixels, (x + w * 0.5) as int, (y - 1.0) as int)
        ring_left = orange(pixels, (x - 1.0) as int, (y + h * 0.5) as int)
        bx, by, bw, _bh = menu.widget_rect(o, pause, BACK)
        none_round_back = !orange(pixels, (bx + bw * 0.3) as int, (by - 1.0) as int)
        check("${name}: the focus ring is round the focused widget and no other", ring_above && ring_left && none_round_back)
        if g_opengl_frame == null {
            g_opengl_frame = calloc(DRAW_W * DRAW_H, 4)
            mem.copy(g_opengl_frame, pixels, (DRAW_W * DRAW_H * 4) as long)
        } else {
            differing = 0
            k = 0
            while k < DRAW_W * DRAW_H * 4 {
                if k % 4 != 3 {
                    d = mem.get_uint8(pixels, k) - mem.get_uint8(g_opengl_frame, k)
                    if d > 16 || d < 0 - 16 { differing = differing + 1 }
                }
                k = k + 1
            }
            println("  ${name}: ${differing} channels differ from OpenGL's by more than 16 of 255")
            check("${name}: the menu is drawn as OpenGL draws it", differing < DRAW_W * DRAW_H * 3 / 100)
        }
    }
    core.backend_set_overlay(backend, null)
    menu.menu_free(pause)
    menu.stack_free(stack)
    hud.hud_free(o)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    println("menu: pointed at, clicked and typed into (#484)")
    run_size(320, 180, 1.0)
    run_size(640, 360, 2.0)

    context = offscreen.context_create(DRAW_W, DRAW_H)
    if context == null {
        println("menu: no OpenGL context; not drawn")
    } else {
        renderer = gl.renderer_new()
        pass = gl.backend(renderer)
        if core.backend_init(&pass, context, DRAW_W, DRAW_H) {
            target = offscreen.target_create(DRAW_W, DRAW_H)
            gl.renderer_set_target(renderer, target)
            drawn_checks(&pass, "opengl")
            core.backend_cleanup(&pass)
            offscreen.target_destroy(target)
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }
    if vulkan.available() {
        vk_renderer = vulkan.renderer_new()
        vk_pass = vulkan.backend(vk_renderer)
        if core.backend_init(&vk_pass, null, DRAW_W, DRAW_H) {
            drawn_checks(&vk_pass, "vulkan")
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    } else {
        println("menu: no Vulkan driver (${vulkan.last_error()}), drawn on OpenGL only")
    }
    if g_opengl_frame != null { free(g_opengl_frame) }

    if g_failures == 0 {
        println("menu: all checks passed (${g_checks})")
    } else {
        println("menu: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
