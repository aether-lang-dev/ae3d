// A figure under a player's hand (#576, #591), held to numbers: the Fox fixture
// (Survey, Walk, Run) at a metre long, on a character controller, driven
// through a scripted run with no window -- stand, walk, walk at half the
// stick, run, stop, turn a quarter, turn round, climb a 20 cm step -- the
// engine stepped at 60 Hz.
//
//   - momentum: speed changes no faster than the accelerations;
//   - feet: walking, at half the stick and running straight, over whole
//     cycles, the foot on the ground drifts along the way under 3% of the
//     body's way (the clip played at the body's speed over its own);
//   - no pop: no bone turns more than 30 degrees in a frame through every
//     change (the clips' own most is 25, a cut 89), and while blending from
//     one clip or frame to another none turns faster than the clips' own
//     fastest played alone (#509's stated limit on a transition);
//   - turning: the facing never turns faster than TURN_RATE;
//   - a step: the capsule climbs it at once, the drawn hips at no more than
//     STEP_SPEED over the walk's own bob.
//
// The whole script runs twice: the figure posed by idle, walk or run chosen
// by speed, and posed by motion matching over the same clips (#591), held
// to the same.
//
// And two foxes in a crowd (set_crowd, ae3d.avoid, #509), walking head on
// to where the other started: they pass each other on opposite sides,
// never nearer than avoid.RADIUS twice, and both get there.
//
// And the box man (tests/fixtures/gltf/humanoid.glb, a biped, its Walk a
// gait made on the spot, #611), walked straight four seconds on a
// controller, by speed and by matching: the toe on the ground drifts under
// 3% of the way the body goes (5% by matching), and it stays upright, its head over its
// hips, every frame -- a walk keying the hips' height and not their turn
// had the lean leant on frame on frame until the figure stood on its head.
// Stopping its toe on the ground stays put, and turning round slips under
// 5% of the way the body goes (108% before its foot was held, 29% while
// the offset bled out of the drawn body and not into its capsule, #611), the
// drawn body within LOCK_MOST of its capsule.
//
// And the box man on ae3d.feet, its legs solved onto the ground under
// locomotion's own foot hold: walking straight its toe on the ground stays
// put (under 0.5% of the body's way; its foot turned with the solved shin,
// it swept 55%), stopping too, and turning round slips under 5% (40% while
// the two holds pulled against each other).
//
// And a fox carrying something (set_load, #509): 20 kg a quarter metre to
// its right, standing, leans it away by atan(20 x 0.25 / (75 x its hips'
// height)) and not forward or back; walking, it goes at its walk slowed by
// half the load's share of its mass; 20 kg 0.3 m ahead pitches it back by
// as much; set down, it stands straight again.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.skin
import ae3d.locomotion
import ae3d.feet
import ae3d.matching
import ae3d.avoid
import std.list

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

const FOX = "tests/fixtures/gltf/Fox.glb"
const MAN = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
    fflush(null)
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// What a run measures, frame by frame.
struct Watch {
    bones: int
    last: ptr                        // float[bones * 7]: world position, local rotation
    now: ptr
    feet: ptr                        // int[bones]: 1 for a bone that rises and falls
    stance_bone: int                 // the foot on the ground, or -1
    stance_from: Vec3
    worst_slide: float               // over a straight stretch
    straight: bool
    worst_turn: float                // a bone's turn in a frame
    worst_blending: float            // the same while the figure blends from one clip or frame to another
    worst_steady: float              // and while it plays one alone
    worst_heading: float
    worst_accel: float
    last_heading: float
    last_speed: float
    drift: Vec3                      // the foot on the ground's way over the ground, summed
    went: float                      // and the body's
    last_body: Vec3
    hips: ptr                        // *Model: the bone locomotion carries
    worst_hips_climb: float
    last_hips_y: float
    frames: int
}

bone_world(sk: *Skeleton, i: int) -> Vec3 {
    b = skin.skeleton_bone(sk, i)
    core.model_sync_transform(b)
    return b.world_position
}

read(w: *Watch, sk: *Skeleton, into: ptr) {
    p = into as float[]
    i = 0
    while i < w.bones {
        b = skin.skeleton_bone(sk, i)
        core.model_sync_transform(b)
        p[i * 7] = b.world_position.x
        p[i * 7 + 1] = b.world_position.y
        p[i * 7 + 2] = b.world_position.z
        p[i * 7 + 3] = b.rotation.x
        p[i * 7 + 4] = b.rotation.y
        p[i * 7 + 5] = b.rotation.z
        p[i * 7 + 6] = b.rotation.w
        i = i + 1
    }
}

// One frame of the run: the engine on, then everything measured.
frame(e: *Engine, w: *Watch, l: *Locomotion, sk: *Skeleton) {
    engine.engine_update(e, STEP)
    read(w, sk, w.now)
    a = w.last as float[]
    b = w.now as float[]
    if w.frames > 0 {
        i = 0
        while i < w.bones {
            d = abs_of(a[i * 7 + 3] * b[i * 7 + 3] + a[i * 7 + 4] * b[i * 7 + 4] + a[i * 7 + 5] * b[i * 7 + 5] + a[i * 7 + 6] * b[i * 7 + 6])
            if d > 1.0 { d = 1.0 }
            t = 2.0 * core.acos_of(d)
            if t > w.worst_turn { w.worst_turn = t }
            if figure.blending(l.figure as *Figure) {
                if t > w.worst_blending { w.worst_blending = t }
            } else if t > w.worst_steady {
                w.worst_steady = t
            }
            i = i + 1
        }
        dh = abs_of(locomotion.heading(l) - w.last_heading)
        if dh > w.worst_heading { w.worst_heading = dh }
        acc = abs_of(locomotion.speed(l) - w.last_speed) / STEP
        if acc > w.worst_accel { w.worst_accel = acc }
    }
    w.last_heading = locomotion.heading(l)
    w.last_speed = locomotion.speed(l)
    // The foot on the ground: the lowest of the feet.
    lowest = 0 - 1
    i = 0
    while i < w.bones {
        if (w.feet as int[])[i] == 1 && (lowest < 0 || b[i * 7 + 1] < b[lowest * 7 + 1]) { lowest = i }
        i = i + 1
    }
    body = behaviour.object_world_position(l.object as *GameObject)
    // The foot that was on the ground, its way since: through every frame,
    // the one where another foot comes down too.
    was = w.stance_bone
    if was >= 0 && w.straight {
        w.drift = core.v3_add(w.drift, core.vec3(b[was * 7] - a[was * 7], 0.0, b[was * 7 + 2] - a[was * 7 + 2]))
        w.went = w.went + core.v3_len(core.vec3(body.x - w.last_body.x, 0.0, body.z - w.last_body.z))
    }
    w.last_body = body
    if lowest != w.stance_bone {
        w.stance_bone = lowest
        if lowest >= 0 { w.stance_from = core.vec3(b[lowest * 7], 0.0, b[lowest * 7 + 2]) }
    } else if lowest >= 0 && w.straight {
        dx = b[lowest * 7] - w.stance_from.x
        dz = b[lowest * 7 + 2] - w.stance_from.z
        slide = core.sqrt_of(dx * dx + dz * dz)
        if slide > w.worst_slide { w.worst_slide = slide }
    }
    hips_bone = w.hips as *Model
    core.model_sync_transform(hips_bone)
    hips = hips_bone.world_position.y
    if w.frames > 0 {
        climb = abs_of(hips - w.last_hips_y) / STEP
        if climb > w.worst_hips_climb { w.worst_hips_climb = climb }
    }
    w.last_hips_y = hips
    tmp = w.last
    w.last = w.now
    w.now = tmp
    w.frames = w.frames + 1
}

// A straight stretch watched, whole cycles of the clip playing (a part
// cycle leaves part of a stride's drift): the farthest a foot went while
// the lowest.
watch_straight(e: *Engine, w: *Watch, l: *Locomotion, sk: *Skeleton, dir: Vec3, running: bool) -> float {
    fig = figure.figure_of(l.object as *GameObject)
    cycle = figure.duration(fig) / figure.speed(fig)
    cycles = (1.5 / cycle) as int + 1
    w.straight = true
    w.stance_bone = 0 - 1
    w.worst_slide = 0.0
    w.drift = core.vec3(0.0, 0.0, 0.0)
    w.went = 0.0
    w.worst_hips_climb = 0.0
    run_for(e, w, l, sk, dir, running, cycle * cycles as float)
    w.straight = false
    return w.worst_slide
}

run_for(e: *Engine, w: *Watch, l: *Locomotion, sk: *Skeleton, dir: Vec3, running: bool, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        locomotion.set_input(l, dir, running)
        frame(e, w, l, sk)
        k = k + 1
    }
}

// The whole script, the figure posed by a clip by speed or, `matched`, by
// motion matching over its clips (#591).
scenario(matched: bool) {
    mode = "by speed"
    if matched { mode = "by matching" }
    println("  -- posed ${mode}")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    fox = figure.figure(e, "Fox", FOX)
    if fox == null {
        println("locomotion: SKIP ${FOX} would not load")
        engine.engine_free(e)
        return
    }
    behaviour.object_set_scale(fox, core.vec3(0.01, 0.01, 0.01))
    behaviour.object_set_position(fox, core.vec3(0.0, 0.0, 0.0))
    c = physics.character_controller(fox, 0.25, 0.8)
    l = locomotion.attach(e, fox, c, "Survey", "Walk", "Run")
    check("locomotion takes the fox's idle, walk and run", l != null)
    if l == null {
        physics.character_free(c)
        engine.engine_free(e)
        return
    }
    db = null as *Database
    if matched {
        db = matching.database_new(figure.figure_of(fox), fox.model as *Model)
        matching.add_clip(db, "Survey")
        matching.add_clip(db, "Walk")
        matching.add_clip(db, "Run")
        check("the fox's clips make a database", matching.build(db))
        locomotion.use_matching(l, db)
    }
    println("  the clips' own speeds: walk ${locomotion.clip_speed(l, 1)} m/s, run ${locomotion.clip_speed(l, 2)} m/s")
    sk = figure.skeleton(figure.figure_of(fox))
    n = skin.skeleton_count(sk)
    w = Watch { bones: n, last: calloc(n * 7, 8), now: calloc(n * 7, 8), feet: calloc(n, 4), stance_bone: 0 - 1,
                stance_from: core.vec3(0.0, 0.0, 0.0), worst_slide: 0.0, straight: false, worst_turn: 0.0, worst_blending: 0.0, worst_steady: 0.0,
                worst_heading: 0.0, worst_accel: 0.0, last_heading: 0.0, last_speed: 0.0, worst_hips_climb: 0.0,
                drift: core.vec3(0.0, 0.0, 0.0), went: 0.0, last_body: core.vec3(0.0, 0.0, 0.0), hips: l.hips,
                last_hips_y: 0.0, frames: 0 }
    // The feet: the bones that rise and fall over a walk.
    lows = calloc(n, 8)
    highs = calloc(n, 8)
    i = 0
    while i < n {
        (lows as float[])[i] = 1000000.0
        (highs as float[])[i] = 0.0 - 1000000.0
        i = i + 1
    }
    k = 0
    while k < 90 {
        locomotion.set_input(l, core.vec3(0.0, 0.0, 1.0), false)
        engine.engine_update(e, STEP)
        i = 0
        while i < n {
            y = bone_world(sk, i).y
            if y < (lows as float[])[i] { (lows as float[])[i] = y }
            if y > (highs as float[])[i] { (highs as float[])[i] = y }
            i = i + 1
        }
        k = k + 1
    }
    count_feet = 0
    i = 0
    while i < n {
        if (highs as float[])[i] - (lows as float[])[i] > 0.04 && (lows as float[])[i] < 0.08 {
            (w.feet as int[])[i] = 1
            count_feet = count_feet + 1
        }
        i = i + 1
    }
    free(lows)
    free(highs)
    run_for(e, &w, l, sk, core.vec3(0.0, 0.0, 0.0), false, 1.0)
    println("  ${count_feet} feet found by how they rise and fall")

    // Straight: walk, then at half the stick, then run, the feet watched once
    // at speed. A foot on the ground goes nowhere over a stretch if the body
    // covers what the clip's feet do at the pace it is played.
    run_for(e, &w, l, sk, core.vec3(0.0, 0.0, 1.0), false, 1.5)
    walk_slide = watch_straight(e, &w, l, sk, core.vec3(0.0, 0.0, 1.0), false)
    walk_drift = abs_of(w.drift.z) / w.went
    walk_aside = abs_of(w.drift.x) / w.went
    walk_bob = w.worst_hips_climb
    run_for(e, &w, l, sk, core.vec3(0.0, 0.0, 0.5), false, 1.5)
    slow_speed = locomotion.speed(l)
    _slow_slide = watch_straight(e, &w, l, sk, core.vec3(0.0, 0.0, 0.5), false)
    slow_drift = abs_of(w.drift.z) / w.went
    slow_aside = abs_of(w.drift.x) / w.went
    run_for(e, &w, l, sk, core.vec3(0.0, 0.0, 1.0), true, 1.5)
    run_slide = watch_straight(e, &w, l, sk, core.vec3(0.0, 0.0, 1.0), true)
    run_drift = abs_of(w.drift.z) / w.went
    run_aside = abs_of(w.drift.x) / w.went
    running_speed = locomotion.speed(l)
    // Stop, turn a quarter, turn round.
    run_for(e, &w, l, sk, core.vec3(0.0, 0.0, 0.0), false, 1.0)
    stopped = locomotion.speed(l)
    run_for(e, &w, l, sk, core.vec3(1.0, 0.0, 0.0), false, 1.5)
    run_for(e, &w, l, sk, core.vec3(0.0 - 1.0, 0.0, 0.0), false, 2.0)
    // A 20 cm step ahead, walked onto.
    at = behaviour.object_world_position(fox)
    kerb = engine.object(e, "Kerb", loader.cube(1.0))
    behaviour.object_set_position(kerb, core.vec3(at.x - 1.5, 0.1, at.z))
    physics.box_collider(kerb, core.vec3(0.5, 0.1, 2.0), physics.material(0.8, 0.0))
    w.worst_hips_climb = 0.0
    feet_before = behaviour.object_world_position(fox).y
    run_for(e, &w, l, sk, core.vec3(0.0 - 1.0, 0.0, 0.0), false, 1.5)
    feet_after = behaviour.object_world_position(fox).y

    println("  over a stretch a foot on the ground drifted ${walk_drift * 100.0}% of the way the body went walking, ${slow_drift * 100.0}% at half the stick (${slow_speed} m/s), ${run_drift * 100.0}% running (${running_speed} m/s); aside, as the clips step, ${walk_aside * 100.0}%, ${slow_aside * 100.0}%, ${run_aside * 100.0}%")
    println("  the fox's clips carry a foot ${walk_slide * 100.0} cm (walk) and ${run_slide * 100.0} cm (run) while it is the lowest, landing and lifting, as they do on the spot")
    println("  the most a bone turned in a frame: ${w.worst_turn * 57.29578} degrees (blending ${w.worst_blending * 57.29578}, a clip alone ${w.worst_steady * 57.29578}); the heading ${w.worst_heading * 57.29578} degrees (cap ${locomotion.TURN_RATE * STEP * 57.29578}); speed changed at ${w.worst_accel} m/s2 at most")
    println("  the step: the capsule went from ${feet_before} to ${feet_after} m; the hips climbed at ${w.worst_hips_climb} m/s at most (${locomotion.STEP_SPEED} allowed over the walk's own bob of ${walk_bob})")
    check("${mode}: momentum: speed changes no faster than the deceleration (the larger limit)", w.worst_accel <= locomotion.DECELERATION + 0.01)
    check("${mode}: it stops when nothing is asked", stopped < 0.01)
    check("${mode}: walking straight, the foot on the ground drifts along it under 3% of the body's way", count_feet >= 2 && walk_drift < 0.03)
    check("${mode}: at half the stick too, the walk slowed to match", slow_speed < locomotion.clip_speed(l, 1) * 0.6 && slow_drift < 0.03)
    check("${mode}: running too", run_drift < 0.03)
    check("${mode}: the facing never turns faster than TURN_RATE", w.worst_heading <= locomotion.TURN_RATE * STEP + 0.0001)
    check("${mode}: no bone turns more than 30 degrees in a frame through every change (a cut is 89)", w.worst_turn < 0.5236)
    // #509's stated limit on a transition: while the figure blends from
    // one clip, or one frame of the database, to another, no bone turns
    // faster than the clips' own fastest, played alone -- the blend adds
    // no motion of its own. On the fox: 21.4 degrees a frame blending
    // against 25.2 alone by speed, 22.6 against 25.0 by matching (1,512
    // degrees a second).
    check("${mode}: blending between clips, no bone turns faster than the clips' own fastest played alone", w.worst_blending <= w.worst_steady && w.worst_steady > 0.0)
    check("${mode}: a step: the capsule climbs it, the drawn hips at no more than STEP_SPEED over the gait's bob",
          feet_after > feet_before + 0.15 && w.worst_hips_climb <= locomotion.STEP_SPEED + walk_bob + 0.01)

    free(w.last)
    free(w.now)
    free(w.feet)
    locomotion.locomotion_free(l)
    if db != null { matching.database_free(db) }
    // The controller is the program's, not the locomotion's or the world's.
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

// Two foxes in a crowd, head on.
crowd() {
    println("  -- two in a crowd, head on")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    a = figure.figure(e, "FoxA", FOX)
    b = figure.figure(e, "FoxB", FOX)
    if a == null || b == null {
        println("locomotion: SKIP ${FOX} would not load")
        engine.engine_free(e)
        return
    }
    behaviour.object_set_scale(a, core.vec3(0.01, 0.01, 0.01))
    behaviour.object_set_scale(b, core.vec3(0.01, 0.01, 0.01))
    behaviour.object_set_position(a, core.vec3(0.0, 0.0, 0.0 - 6.0))
    behaviour.object_set_position(b, core.vec3(0.0, 0.0, 6.0))
    ca = physics.character_controller(a, 0.25, 0.8)
    cb = physics.character_controller(b, 0.25, 0.8)
    la = locomotion.attach(e, a, ca, "Survey", "Walk", "Run")
    lb = locomotion.attach(e, b, cb, "Survey", "Walk", "Run")
    walkers = list.new()
    list.add_raw(walkers, la as ptr)
    list.add_raw(walkers, lb as ptr)
    locomotion.set_crowd(la, walkers)
    locomotion.set_crowd(lb, walkers)
    goal_a = core.vec3(0.0, 0.0, 6.0)
    goal_b = core.vec3(0.0, 0.0, 0.0 - 6.0)
    nearest = 1000.0
    met_a = 0.0
    met_b = 0.0
    step = 0
    while step < 60 * 14 {
        pa = behaviour.object_world_position(a)
        pb = behaviour.object_world_position(b)
        locomotion.set_input(la, toward_goal(pa, goal_a), false)
        locomotion.set_input(lb, toward_goal(pb, goal_b), false)
        engine.engine_update(e, STEP)
        pa = behaviour.object_world_position(a)
        pb = behaviour.object_world_position(b)
        d = core.v3_len(core.vec3(pa.x - pb.x, 0.0, pa.z - pb.z))
        if d < nearest {
            nearest = d
            met_a = pa.x
            met_b = pb.x
        }
        step = step + 1
    }
    pa = behaviour.object_world_position(a)
    pb = behaviour.object_world_position(b)
    off_a = core.v3_len(core.vec3(pa.x - goal_a.x, 0.0, pa.z - goal_a.z))
    off_b = core.v3_len(core.vec3(pb.x - goal_b.x, 0.0, pb.z - goal_b.z))
    println("  nearest ${nearest} m, one at x ${met_a} and the other at ${met_b} then; at the end ${off_a} and ${off_b} m from where they were going")
    check("two in a crowd coming head on pass on opposite sides, never nearer than two radii", nearest >= 2.0 * avoid.RADIUS && met_a * met_b < 0.0)
    check("and both get where they were going", off_a < 0.5 && off_b < 0.5)
    locomotion.locomotion_free(la)
    locomotion.locomotion_free(lb)
    list.free(walkers)
    physics.character_free(ca)
    physics.character_free(cb)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

// The stick toward `goal`: full until half a metre off, then easing to none.
toward_goal(at: Vec3, goal: Vec3) -> Vec3 {
    d = core.vec3(goal.x - at.x, 0.0, goal.z - at.z)
    n = core.v3_len(d)
    if n < 0.05 { return core.vec3(0.0, 0.0, 0.0) }
    push = 1.0
    if n < 0.5 { push = n / 0.5 }
    return core.vec3(d.x / n * push, 0.0, d.z / n * push)
}

// A fox carrying a load.
carrying() {
    println("  -- carrying")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    fox = figure.figure(e, "Fox", FOX)
    if fox == null {
        println("locomotion: SKIP ${FOX} would not load")
        engine.engine_free(e)
        return
    }
    behaviour.object_set_scale(fox, core.vec3(0.01, 0.01, 0.01))
    c = physics.character_controller(fox, 0.25, 0.8)
    l = locomotion.attach(e, fox, c, "Survey", "Walk", "Run")
    // Settled, unladen.
    hold(e, l, core.vec3(0.0, 0.0, 0.0), 1.0)
    straight = core.abs_of(locomotion.lean_roll(l)) + core.abs_of(locomotion.lean_pitch(l))
    h = locomotion.hips_height(l)
    locomotion.set_load(l, 20.0, 0.25, 0.0)
    hold(e, l, core.vec3(0.0, 0.0, 0.0), 3.0)
    side_roll = locomotion.lean_roll(l)
    side_pitch = locomotion.lean_pitch(l)
    side_want = core.atan2_of(20.0 * 0.25, locomotion.BODY_MASS * h)
    hold(e, l, core.vec3(0.0, 0.0, 1.0), 4.0)
    laden_speed = locomotion.speed(l)
    want_speed = locomotion.clip_speed(l, 1) * (1.0 - locomotion.LOAD_SLOW * 20.0 / locomotion.BODY_MASS)
    locomotion.set_load(l, 20.0, 0.0, 0.3)
    hold(e, l, core.vec3(0.0, 0.0, 0.0), 3.0)
    front_pitch = locomotion.lean_pitch(l)
    front_want = 0.0 - core.atan2_of(20.0 * 0.3, locomotion.BODY_MASS * h)
    locomotion.set_load(l, 0.0, 0.0, 0.0)
    hold(e, l, core.vec3(0.0, 0.0, 0.0), 3.0)
    after = core.abs_of(locomotion.lean_roll(l)) + core.abs_of(locomotion.lean_pitch(l))
    println("  hips ${h} m up; unladen lean ${straight} rad; 20 kg at the side: roll ${side_roll} (${side_want} asked), pitch ${side_pitch}; walking ${laden_speed} m/s (${want_speed} asked); 20 kg ahead: pitch ${front_pitch} (${front_want}); set down ${after}")
    check("standing unladen, it stands straight", straight < 0.0001)
    check("20 kg at its side leans it away by what keeps the two over its feet, and not forward or back", core.abs_of(side_roll - side_want) < 0.002 && side_roll > 0.0 && core.abs_of(side_pitch) < 0.002)
    check("walking laden, it goes at its walk slowed by half the load's share of its mass", core.abs_of(laden_speed - want_speed) < want_speed * 0.02)
    check("20 kg ahead pitches it back by as much", core.abs_of(front_pitch - front_want) < 0.002 && front_pitch < 0.0)
    check("set down, it stands straight again", after < 0.0001)
    locomotion.locomotion_free(l)
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

// `seconds` of the stick held at `stick`, walking.
hold(e: *Engine, l: *Locomotion, stick: Vec3, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        locomotion.set_input(l, stick, false)
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

// The box man walked straight.
biped(matched: bool) {
    mode = "by speed"
    if matched { mode = "by matching" }
    println("  -- the box man walking, ${mode}")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    man = figure.figure(e, "Man", MAN)
    if man == null {
        println("locomotion: SKIP ${MAN} would not load")
        engine.engine_free(e)
        return
    }
    c = physics.character_controller(man, 0.3, 1.8)
    l = locomotion.attach(e, man, c, "Idle", "Walk", "Run")
    db = null as *Database
    if matched {
        db = matching.database_new(figure.figure_of(man), man.model as *Model)
        matching.add_clip(db, "Idle")
        matching.add_clip(db, "Walk")
        matching.add_clip(db, "Run")
        matching.build(db)
        locomotion.use_matching(l, db)
    }
    sk = figure.skeleton(figure.figure_of(man))
    toe_l = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:LeftToeBase"))
    toe_r = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:RightToeBase"))
    hips = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Hips"))
    head = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Head"))
    upright = true
    drift = 0.0
    went = 0.0
    last_low = toe_l
    last_at = core.vec3(0.0, 0.0, 0.0)
    last_body = behaviour.object_world_position(man)
    k = 0
    while k < 240 {
        locomotion.set_input(l, core.vec3(0.0, 0.0, 0.0 - 1.0), false)
        engine.engine_update(e, STEP)
        core.model_sync_transform(toe_l)
        core.model_sync_transform(toe_r)
        core.model_sync_transform(hips)
        core.model_sync_transform(head)
        if head.world_position.y < hips.world_position.y + 0.5 { upright = false }
        low = toe_l
        if toe_r.world_position.y < toe_l.world_position.y { low = toe_r }
        body = behaviour.object_world_position(man)
        // The last two seconds, at speed: the toe on the ground's way while
        // it stays the lowest, against the body's.
        if k >= 120 {
            if low == last_low { drift = drift + core.v3_len(core.vec3(low.world_position.x - last_at.x, 0.0, low.world_position.z - last_at.z)) }
            went = went + core.v3_len(core.vec3(body.x - last_body.x, 0.0, body.z - last_body.z))
        }
        last_low = low
        last_at = low.world_position
        last_body = body
        k = k + 1
    }
    println("  the toe on the ground went ${drift} m while the body went ${went} m (${drift / went * 100.0}%); upright ${upright}")
    // Its foot held as it stops and as it turns round (#611).
    stop, _stop_back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 0.0), 60)
    round, back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 1.0), 120)
    println("  stopping, the toe on the ground went ${stop.x} m; turning round, ${round.x} m while the body went ${round.y} m (${round.x / round.y * 100.0}%); the drawn body ${round.z} m off its capsule at most; going backwards at ${back} m/s at most")
    check("${mode}: stopping, the toe on the ground stays put (under 2 cm)", stop.x < 0.02)
    check("${mode}: turning round, it slips under 5% of the body's way (108% unheld), the drawn body within LOCK_MOST of its capsule",
          round.x / round.y < 0.05 && round.z <= locomotion.LOCK_MOST + 0.0001)
    // Asked to go behind it, it turned walking backwards (#611): now it
    // turns, crawling, and walks off the way it faces.
    check("${mode}: turning round, it never goes backwards faster than TURN_CRAWL of its walk",
          back <= locomotion.clip_speed(l, 1) * locomotion.TURN_CRAWL + 0.01)
    // By matching, 5%: the database's blends between its frames slide the
    // planted toe a little more (3.8% here, summed step by step; by speed
    // 1.4%).
    most = 0.03
    if matched { most = 0.05 }
    check("${mode}: the box man walking straight, the toe on the ground drifts under ${most * 100.0}% of the body's way", went > 1.0 && drift / went < most)
    check("${mode}: and stays upright, its head over its hips, every frame", upright)
    locomotion.locomotion_free(l)
    if db != null { matching.database_free(db) }
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

// `steps` of the stick held at `stick`: how far the toe on the ground went
// while it stayed the lowest (x), the body's way (y), and the most the
// drawn body was off its capsule (z); and the fastest it went backwards,
// against the way it faces.
toe_drift(e: *Engine, man: *GameObject, l: *Locomotion, toe_l: *Model, toe_r: *Model, stick: Vec3, steps: int) -> (Vec3, float) {
    back = 0.0
    drift = 0.0
    went = 0.0
    off = 0.0
    last_low = null as *Model
    last_at = core.vec3(0.0, 0.0, 0.0)
    last_body = behaviour.object_world_position(man)
    k = 0
    while k < steps {
        locomotion.set_input(l, stick, false)
        engine.engine_update(e, STEP)
        core.model_sync_transform(toe_l)
        core.model_sync_transform(toe_r)
        low = toe_l
        if toe_r.world_position.y < toe_l.world_position.y { low = toe_r }
        body = behaviour.object_world_position(man)
        if low == last_low && low.world_position.y < 0.08 { drift = drift + core.v3_len(core.vec3(low.world_position.x - last_at.x, 0.0, low.world_position.z - last_at.z)) }
        went = went + core.v3_len(core.vec3(body.x - last_body.x, 0.0, body.z - last_body.z))
        o = core.v3_len(locomotion.lock_offset(l))
        if o > off { off = o }
        v = locomotion.velocity(l)
        h = locomotion.heading(l)
        against = 0.0 - (v.x * core.sin_of(h) + v.z * core.cos_of(h))
        if against > back { back = against }
        last_low = low
        last_at = low.world_position
        last_body = body
        k = k + 1
    }
    return core.vec3(drift, went, off), back
}

// The box man with its legs solved onto the ground (ae3d.feet) under
// locomotion's own foot hold: walked straight, stopped and turned round as
// biped's.
on_feet() {
    println("  -- the box man on ae3d.feet")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    man = figure.figure(e, "Man", MAN)
    if man == null {
        println("locomotion: SKIP ${MAN} would not load")
        engine.engine_free(e)
        return
    }
    c = physics.character_controller(man, 0.3, 1.8)
    l = locomotion.attach(e, man, c, "Idle", "Walk", "Run")
    sk = figure.skeleton(figure.figure_of(man))
    f = feet.attach(e, man.model as *Model, named(sk, "mixamorig:Hips"),
                    named(sk, "mixamorig:LeftUpLeg"), named(sk, "mixamorig:LeftLeg"), named(sk, "mixamorig:LeftFoot"),
                    named(sk, "mixamorig:RightUpLeg"), named(sk, "mixamorig:RightLeg"), named(sk, "mixamorig:RightFoot"))
    toe_l = named(sk, "mixamorig:LeftToeBase")
    toe_r = named(sk, "mixamorig:RightToeBase")
    // Two seconds getting going, two at speed.
    _start, _start_back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 0.0 - 1.0), 120)
    straight, _back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 0.0 - 1.0), 120)
    stop, _stop_back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 0.0), 60)
    round, _round_back = toe_drift(e, man, l, toe_l, toe_r, core.vec3(0.0, 0.0, 1.0), 120)
    println("  walking straight the toe on the ground went ${straight.x} m while the body went ${straight.y} m (${straight.x / straight.y * 100.0}%); stopping, ${stop.x} m; turning round, ${round.x} m of ${round.y} m (${round.x / round.y * 100.0}%)")
    // Its foot turned with the solved shin, a planted foot pitched about its
    // locked ankle and swept its toe 55% of the body's way.
    check("on ae3d.feet: walking straight, the toe on the ground stays put (under 0.5% of the body's way; 55% before)",
          straight.y > 1.0 && straight.x / straight.y < 0.005)
    check("on ae3d.feet: stopping, the toe on the ground stays put (under 2 cm)", stop.x < 0.02)
    check("on ae3d.feet: turning round, it slips under 5% of the body's way", round.x / round.y < 0.05)
    feet.feet_free(f)
    locomotion.locomotion_free(l)
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
}

named(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

main() {
    println("locomotion: a figure under a player's hand (#576, #591)")
    scenario(false)
    scenario(true)
    crowd()
    carrying()
    biped(false)
    biped(true)
    on_feet()
    if g_failures == 0 {
        println("locomotion: all checks passed (${g_checks})")
    } else {
        println("locomotion: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
