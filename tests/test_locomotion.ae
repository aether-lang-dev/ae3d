// A figure under a player's hand (#576, #591, #860), held to numbers on the
// pipeline: the UE5 mannequin on 100STYLE's neutral gaits (ae3d.character:
// its mover's springs, its animator's graph, ikrig's feet), on a capsule,
// the engine stepped at 60 Hz with no window. What the locomotion module was held
// to before it was retired onto these layers:
//
//   - momentum and turning: through a scripted run -- stand, walk, walk at
//     half the pace, run, stop, turn a quarter, turn round -- its speed
//     changes no faster than 6 m/s^2 and its facing turns no faster than
//     4 rad/s (locomotion's DECELERATION and TURN_RATE);
//   - a step: walked onto a 20 cm step, the capsule climbs it and the drawn
//     pelvis climbs no faster than 1.2 m/s (locomotion's STEP_SPEED) over
//     the walk's own bob;
//   - attaching the animator leaves the figure in its bind pose (its pelvis
//     and ankles within 1 mm), and stopped after a walk, it stands in its
//     rest stance: both soles on the floor and its pelvis at the height it
//     stood at, to 1 cm;
//   - the box man's ways (#672), read off its clips (tests/fixtures/gltf/
//     humanoid.glb's Walk_Back, Strafe_L, Strafe_R, each a gait made on the
//     spot, read by its planted feet): back half a turn from its walk's, the
//     sides a quarter turn either way (to 0.05 rad), and their paces back
//     0.71 m/s, the sides 0.33 (to 2 cm/s);
//   - carrying something (#509; ikrig.hands_load, the character slowed by
//     it): 20 kg a quarter metre to its right leans its trunk away by what
//     balances it over its hips (the load's moment against half its body's
//     over its trunk, ikrig's most at the least), and not forward or back;
//     20 kg 0.3 m ahead leans it back by as much; walking laden, it goes at
//     the pace asked slowed by half the load's share of its mass; set down,
//     it stands straight again.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const MAN = "tests/fixtures/gltf/humanoid.glb"
// The retired locomotion module's bounds, held to here: metres a second each second its
// speed changed at the most, radians a second its facing turned, and metres
// a second its drawn hips climbed a step over the gait's own bob.
const DECELERATION = 6.0
const TURN_RATE = 4.0
const STEP_SPEED = 1.2
// Of the load's share of the body's mass, off the pace asked (locomotion's
// LOAD_SLOW, ae3d.character's now).
const LOAD_SLOW = 0.5

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

world() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    return e
}

world_free(e: *Engine) {
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

wrap(a: float) -> float {
    t = a
    while t > 3.14159265 { t = t - 6.2831853 }
    while t < 0.0 - 3.14159265 { t = t + 6.2831853 }
    return t
}

yaw_of(o: *GameObject) -> float {
    f = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    return core.atan2_of(f.x, f.z)
}

// What the scripted run watches each frame.
struct Watch {
    c: *Character
    drawn: ptr
    worlds: ptr
    frames: int
    last_speed: float
    last_yaw: float
    last_hips: float
    worst_accel: float
    worst_turn: float
    worst_climb: float
}

// The drawn pelvis, the ground's.
pelvis_of(w: *Watch) -> Vec3 {
    r = animator.rig(character.animator_of(w.c))
    pose.read(r, w.drawn)
    pose.world(r, w.drawn, w.worlds)
    return ikrig.to_ground(r, pose.translation(w.worlds, pose.human(r, pose.PELVIS)))
}

// `seconds` asked to go at `v`, watched.
go(e: *Engine, w: *Watch, v: Vec3, seconds: float) {
    m = character.mover_of(w.c)
    o = character.object_of(w.c)
    k = 0
    while k < (seconds / STEP) as int {
        character.move(w.c, v, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        speed = core.v3_len(mover.velocity(m))
        yaw = yaw_of(o)
        hips = pelvis_of(w).y
        if w.frames > 0 {
            acc = core.abs_of(speed - w.last_speed) / STEP
            if acc > w.worst_accel { w.worst_accel = acc }
            turn = core.abs_of(wrap(yaw - w.last_yaw)) / STEP
            if turn > w.worst_turn { w.worst_turn = turn }
            climb = core.abs_of(hips - w.last_hips) / STEP
            if climb > w.worst_climb { w.worst_climb = climb }
        }
        w.last_speed = speed
        w.last_yaw = yaw
        w.last_hips = hips
        w.frames = w.frames + 1
        k = k + 1
    }
}

// The lowest of foot `side`'s heel, pad and toe over the floor at `floor`.
sole_over(c: *Character, worlds: ptr, side: int, floor: float) -> float {
    r = animator.rig(character.animator_of(c))
    heel, pad, toe = ikrig.feet_soles(character.feet_of(c), r, worlds, side)
    low = heel.y
    if pad.y < low { low = pad.y }
    if toe.y < low { low = toe.y }
    return low - floor
}

// The mean height of the pelvis over the floor and the worst sole off it,
// over `seconds` standing.
stand(e: *Engine, w: *Watch, seconds: float) -> (float, float) {
    o = character.object_of(w.c)
    sum = 0.0
    off = 0.0
    n = 0
    while n < (seconds / STEP) as int {
        character.move(w.c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        floor = behaviour.object_position(o).y
        sum = sum + pelvis_of(w).y - floor
        side = 0
        while side < 2 {
            d = core.abs_of(sole_over(w.c, w.worlds, side, floor))
            if d > off { off = d }
            side = side + 1
        }
        n = n + 1
    }
    return sum / (n as float), off
}

// The scripted run, and the rest stance after it.
scripted() {
    println("  -- the scripted run")
    e = world()
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Runner", MANNEQUIN, g)
    if c == null {
        println("  no runner: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    r = animator.rig(character.animator_of(c))
    w = Watch { c: c, drawn: pose.new(r), worlds: pose.new(r), frames: 0, last_speed: 0.0, last_yaw: 0.0, last_hips: 0.0,
                worst_accel: 0.0, worst_turn: 0.0, worst_climb: 0.0 }
    still = core.vec3(0.0, 0.0, 0.0)
    go(e, &w, still, 1.0)
    rest, _off = stand(e, &w, 1.0)
    turned = behaviour.object_rotation(o)
    ahead = core.quat_apply(turned, core.vec3(0.0, 0.0, 1.0))
    right = core.vec3(0.0 - ahead.z, 0.0, ahead.x)
    go(e, &w, core.v3_mul(ahead, 1.2), 2.0)
    // The walk's own bob, straight on.
    w.worst_climb = 0.0
    go(e, &w, core.v3_mul(ahead, 1.2), 1.5)
    bob = w.worst_climb
    go(e, &w, core.v3_mul(ahead, 0.6), 2.0)
    go(e, &w, core.v3_mul(ahead, 3.0), 2.0)
    rested_in = 0.0 - 1.0
    k = 0
    while k < 240 {
        go(e, &w, still, STEP * 1.01)
        if rested_in < 0.0 && core.v3_len(mover.velocity(character.mover_of(c))) < 0.01 { rested_in = ((k + 1) as float) * STEP }
        k = k + 1
    }
    stopped = core.v3_len(mover.velocity(character.mover_of(c)))
    stood, sole_off = stand(e, &w, 1.0)
    // A quarter turn, walking off to its right, then round, walking back
    // (a walker curves round, #969).
    go(e, &w, core.v3_mul(right, 1.2), 2.0)
    go(e, &w, core.v3_mul(right, 0.0 - 1.2), 6.0)
    go(e, &w, still, 3.0)
    // A 20 cm step 1.5 m ahead, walked onto from standing.
    turned = behaviour.object_rotation(o)
    way = core.quat_apply(turned, core.vec3(0.0, 0.0, 1.0))
    at = behaviour.object_position(o)
    kerb = engine.object(e, "Kerb", loader.cube(1.0))
    behaviour.object_set_position(kerb, core.vec3(at.x + way.x * 2.0, 0.1, at.z + way.z * 2.0))
    // A metre deep along the way it walks, 4 m across it.
    behaviour.object_set_rotation(kerb, turned)
    physics.box_collider(kerb, core.vec3(2.0, 0.1, 0.5), physics.material(0.8, 0.0))
    turn_worst = w.worst_turn
    accel_worst = w.worst_accel
    w.worst_climb = 0.0
    before = behaviour.object_position(o).y
    go(e, &w, core.v3_mul(way, 1.2), 2.5)
    after = behaviour.object_position(o).y
    println("  speed changed at ${accel_worst} m/s2 at most (${DECELERATION} allowed), the facing turned at ${turn_worst} rad/s at most (${TURN_RATE} allowed); let go from a run at 3 m/s, at rest in ${rested_in} s, ${stopped} m/s 4 s on")
    println("  the step: the capsule went from ${before} to ${after} m; the pelvis climbed at ${w.worst_climb} m/s at most (${STEP_SPEED} allowed over the walk's own bob of ${bob})")
    println("  standing: the pelvis ${rest} m over the floor before the run, ${stood} after its stop; a sole ${sole_off * 1000.0} mm off the floor at worst")
    check("momentum: speed changes no faster than the deceleration", accel_worst <= DECELERATION + 0.01)
    check("it stops when nothing is asked", stopped < 0.01)
    check("the facing never turns faster than TURN_RATE", turn_worst <= TURN_RATE + 0.006)
    check("a step: the capsule climbs it, the drawn pelvis at no more than STEP_SPEED over the gait's bob", after > before + 0.15 && w.worst_climb <= STEP_SPEED + bob + 0.01)
    check("stopped, it stands in its rest stance, both soles down and the pelvis at its rest height, to 1 cm", sole_off < 0.01 && core.abs_of(stood - rest) < 0.01)
    pose.release(w.drawn)
    pose.release(w.worlds)
    character.character_free(c)
    character.gaits_free(g)
    world_free(e)
}

// The animator attached to a figure leaves it in its bind pose.
attached() {
    e = world()
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    k = 0
    while k < 3 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    drawn = pose.new(r)
    worlds = pose.new(r)
    rest = pose.new(r)
    pose.read(r, drawn)
    pose.world(r, drawn, worlds)
    pose.rest_world(r, rest)
    slots = [pose.PELVIS, pose.FOOT_L, pose.FOOT_R]
    worst = 0.0
    k = 0
    while k < 3 {
        j = pose.human(r, slots[k])
        d = core.v3_len(core.v3_sub(ikrig.to_ground(r, pose.translation(worlds, j)), ikrig.to_ground(r, pose.translation(rest, j))))
        if d > worst { worst = d }
        k = k + 1
    }
    println("  attached: the pelvis and ankles ${worst * 1000.0} mm off the bind pose at most")
    check("attaching the animator leaves the figure in its bind pose, its pelvis and ankles within 1 mm", worst < 0.001)
    pose.release(drawn)
    pose.release(worlds)
    pose.release(rest)
    animator.animator_free(a)
    world_free(e)
}

// The box man's ways off its clips.
ways() {
    println("  -- the box man's ways")
    e = world()
    o = figure.figure(e, "Man", MAN)
    a = animator.attach(e, o)
    walk = animator.take(a, "Walk", false)
    back = animator.take(a, "Walk_Back", false)
    left = animator.take(a, "Strafe_L", false)
    right = animator.take(a, "Strafe_R", false)
    if walk == null || back == null || left == null || right == null {
        println("  the box man's clips would not load")
        exit(1)
    }
    on = clips.heading(walk)
    takes = [back, left, right]
    turns = [0.0, 0.0, 0.0]
    k = 0
    while k < 3 {
        h = clips.heading(takes[k])
        turns[k] = wrap(core.atan2_of(h.x, h.z) - core.atan2_of(on.x, on.z))
        k = k + 1
    }
    println("  ways from the walk's: back ${turns[0]}, left ${turns[1]}, right ${turns[2]} radians; paces ${clips.speed(back)}, ${clips.speed(left)}, ${clips.speed(right)} m/s (the walk ${clips.speed(walk)})")
    check("the box man's ways read off its clips: back half a turn, the sides a quarter turn either way (to 0.05 rad)",
          core.abs_of(core.abs_of(turns[0]) - 3.14159265) < 0.05 && core.abs_of(core.abs_of(turns[1]) - 1.5707963) < 0.05 && core.abs_of(turns[1] + turns[2]) < 0.05)
    check("and their paces: back 0.71 m/s, the sides 0.33 (to 2 cm/s)",
          core.abs_of(clips.speed(back) - 0.71) < 0.02 && core.abs_of(clips.speed(left) - 0.33) < 0.02 && core.abs_of(clips.speed(right) - 0.33) < 0.02)
    animator.animator_free(a)
    world_free(e)
}

// Two people standing alike, 3 m apart, one of them carrying: the trunk's
// lean, as a turn (radians) about the figure's ahead (a roll, to its left
// positive) and its left (a pitch, back positive), from the neck of the
// one carrying against the other's.
struct Pair {
    e: *Engine
    laden: *Character
    bare: *Character
    hands: *Hands
    drawn: ptr
    worlds: ptr
    other: ptr
    other_worlds: ptr
}

lean_of(p: *Pair) -> (float, float) {
    r = animator.rig(character.animator_of(p.laden))
    pose.read(r, p.drawn)
    pose.world(r, p.drawn, p.worlds)
    rb = animator.rig(character.animator_of(p.bare))
    pose.read(rb, p.other)
    pose.world(rb, p.other, p.other_worlds)
    neck = pose.human(r, pose.NECK)
    q = core.quat_mul(pose.rotation(p.worlds, neck), core.quat_conjugate(pose.rotation(p.other_worlds, pose.human(rb, pose.NECK))))
    if q.w < 0.0 { q = core.quat(0.0 - q.x, 0.0 - q.y, 0.0 - q.z, 0.0 - q.w) }
    s = core.sqrt_of(q.x * q.x + q.y * q.y + q.z * q.z)
    if s < 0.0000001 { return 0.0, 0.0 }
    angle = 2.0 * core.atan2_of(s, q.w)
    axis = core.v3_normalize(ikrig.dir_to_ground(r, core.vec3(q.x / s, q.y / s, q.z / s)))
    o = character.object_of(p.laden)
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    // A turn about ahead by a positive angle takes the top toward its right:
    // the roll to its left is the turn about ahead's opposite.
    return 0.0 - core.v3_dot(axis, ahead) * angle, core.v3_dot(axis, core.v3_mul(left, 0.0 - 1.0)) * angle
}

// The middle of its hips, as drawn.
hips_of(p: *Pair) -> Vec3 {
    r = animator.rig(character.animator_of(p.laden))
    pose.read(r, p.drawn)
    pose.world(r, p.drawn, p.worlds)
    return core.v3_lerp(ikrig.to_ground(r, pose.translation(p.worlds, pose.human(r, pose.THIGH_L))),
                        ikrig.to_ground(r, pose.translation(p.worlds, pose.human(r, pose.THIGH_R))), 0.5)
}

// `seconds` with `kg` carried `across` metres to its right of its hips and
// `ahead` metres ahead of them at their height, both asked to go at `v`.
carry(p: *Pair, kg: float, across: float, ahead: float, v: Vec3, seconds: float) {
    o = character.object_of(p.laden)
    k = 0
    while k < (seconds / STEP) as int {
        way = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
        right = core.vec3(0.0 - way.z, 0.0, way.x)
        at = core.v3_add(core.v3_add(hips_of(p), core.v3_mul(right, across)), core.v3_mul(way, ahead))
        ikrig.hands_load(p.hands, kg, 0 - 1, at)
        character.move(p.laden, v, core.vec3(0.0, 0.0, 0.0))
        character.move(p.bare, v, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(p.e, STEP)
        k = k + 1
    }
}

// What a load leans the trunk by: its moment over the hips against half the
// body's over the trunk, at ikrig's most.
wanted_lean(r: *pose.Rig, worlds: ptr, kg: float, reach: float) -> float {
    hips = core.v3_lerp(ikrig.to_ground(r, pose.translation(worlds, pose.human(r, pose.THIGH_L))),
                        ikrig.to_ground(r, pose.translation(worlds, pose.human(r, pose.THIGH_R))), 0.5)
    tall = ikrig.to_ground(r, pose.translation(worlds, pose.human(r, pose.NECK))).y - hips.y
    sine = kg * reach / (ikrig.BODY_MASS * tall * 0.5)
    if sine > core.sin_of(ikrig.LOAD_LEAN) { sine = core.sin_of(ikrig.LOAD_LEAN) }
    return core.atan2_of(sine, core.sqrt_of(1.0 - sine * sine))
}

carrying() {
    println("  -- carrying")
    e = world()
    g = character.gaits(GAITS)
    laden = character.humanoid(e, "Laden", MANNEQUIN, g)
    bare = character.humanoid(e, "Bare", MANNEQUIN, g)
    if laden == null || bare == null {
        println("  no people: ${character.error()}")
        exit(1)
    }
    behaviour.object_set_position(character.object_of(bare), core.vec3(3.0, 0.0, 0.0))
    character.set_avoidance(laden, false, 0.0)
    character.set_avoidance(bare, false, 0.0)
    a = character.animator_of(laden)
    r = animator.rig(a)
    h = ikrig.hands_new(r)
    animator.set_hands(a, h)
    animator.set_hands(character.animator_of(bare), ikrig.hands_new(animator.rig(character.animator_of(bare))))
    p = Pair { e: e, laden: laden, bare: bare, hands: h, drawn: pose.new(r), worlds: pose.new(r), other: pose.new(r), other_worlds: pose.new(r) }
    still = core.vec3(0.0, 0.0, 0.0)
    carry(&p, 0.0, 0.0, 0.0, still, 1.0)
    roll0, pitch0 = lean_of(&p)
    straight = core.abs_of(roll0) + core.abs_of(pitch0)
    carry(&p, 20.0, 0.25, 0.0, still, 2.0)
    // What it asks, off the pose the other stands in (the same, unleaned).
    rb = animator.rig(character.animator_of(bare))
    side_roll, side_pitch = lean_of(&p)
    side_want = wanted_lean(rb, p.other_worlds, 20.0, 0.25)
    carry(&p, 0.0, 0.0, 0.0, still, 1.0)
    carry(&p, 20.0, 0.0, 0.3, still, 2.0)
    front_roll, front_pitch = lean_of(&p)
    front_want = wanted_lean(rb, p.other_worlds, 20.0, 0.3)
    carry(&p, 0.0, 0.0, 0.0, still, 2.0)
    after_roll, after_pitch = lean_of(&p)
    after = core.abs_of(after_roll) + core.abs_of(after_pitch)
    // Walking laden.
    o = character.object_of(laden)
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    carry(&p, 20.0, 0.25, 0.0, core.v3_mul(ahead, 1.2), 4.0)
    laden_speed = core.v3_len(mover.velocity(character.mover_of(laden)))
    bare_speed = core.v3_len(mover.velocity(character.mover_of(bare)))
    want_speed = 1.2 * (1.0 - LOAD_SLOW * 20.0 / character.body_mass(laden))
    println("  unladen lean ${straight} rad; 20 kg at its side: roll ${side_roll} (${side_want} asked), pitch ${side_pitch}; 20 kg ahead: pitch ${front_pitch} (${front_want}), roll ${front_roll}; set down ${after}")
    println("  walking laden ${laden_speed} m/s (${want_speed} asked, the other ${bare_speed}; its mass ${character.body_mass(laden)} kg)")
    check("standing unladen, it stands straight", straight < 0.0001)
    check("20 kg at its side leans its trunk away by what balances it, and not forward or back", core.abs_of(side_roll - side_want) < 0.002 && side_roll > 0.0 && core.abs_of(side_pitch) < 0.002)
    check("20 kg ahead leans it back by as much", core.abs_of(front_pitch - front_want) < 0.002 && front_pitch > 0.0 && core.abs_of(front_roll) < 0.002)
    check("walking laden, it goes at the pace asked slowed by half the load's share of its mass", core.abs_of(laden_speed - want_speed) < want_speed * 0.02)
    check("set down, it stands straight again", after < 0.0001)
    pose.release(p.drawn)
    pose.release(p.worlds)
    pose.release(p.other)
    pose.release(p.other_worlds)
    character.character_free(laden)
    character.character_free(bare)
    character.gaits_free(g)
    world_free(e)
}

main() {
    println("locomotion: a figure under a player's hand, on the pipeline (#576, #591, #860)")
    scripted()
    attached()
    ways()
    carrying()
    if g_failures == 0 {
        println("locomotion: all checks passed (${g_checks})")
        return
    }
    println("locomotion: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
