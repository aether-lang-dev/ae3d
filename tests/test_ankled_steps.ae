// A figure with ankles (#709) steps as one without does, held to numbers.
// The box man (the fixture the motion showcase dresses), POWERED, made
// with ankles (physics_set_ankles) and without, each in an engine of its
// own; no window.
//
//   - with ankles it weighs what it weighs without, each foot its share
//     (1.37% of the body) and each calf its shank's (4.33%): given the
//     foot's share as well, the calf weighed both and each foot kept its
//     solid capsule's 1.8 kg, the whole 3.6 kg too heavy, at the ends of
//     its legs;
//   - shoved at the chest at 1.5 m/s from 16 ways round it, 4 s each, it
//     falls no more often than twice as many times as the figure without
//     ankles, plus one. Its feet are bodies of their own, and a crossing
//     foot met the other leg's shin, stopped from 3.1 m/s to 0.3 in a step
//     4 cm over the ground, and the figure stood on the other leg and fell:
//     12 of the 16, against 1 without ankles.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float

const STEP = 0.016666666666666666
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"
const WAYS = 16
const SPEED = 1.5                     // m/s over the whole body
const SHOVE_AT = 60
const AFTER = 240

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The box man standing POWERED in an engine of its own, with ankles or
// without; null when the fixture would not load.
struct Standing {
    e: *Engine
    r: *Ragdoll
    m: *Motion
}

stand(ankles: bool) -> Standing {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), ankles)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", BOXMAN)
    if o == null { return Standing { e: e, r: null, m: null } }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    r = physics.ragdoll(e, "BoxMan", group.world_position, 8.0, 8.0, 1.0)
    physics.ragdoll_dress_humanoid(r, figure.skeleton(f))
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    motion.set_get_up(m, 1.5)
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    return Standing { e: e, r: r, m: m }
}

done(s: Standing) {
    engine.engine_free(s.e)
    if s.m != null { motion.motion_free(s.m) }
    figure.figures_free(s.e)
}

bone_mass(r: *Ragdoll, index: int) -> float {
    return dynamics.body_get_mass(human.bone_at(physics.ragdoll_human(r), index).body_id)
}

// How many of WAYS shoves at SPEED from round the figure fell it.
falls(ankles: bool) -> int {
    fell = 0
    w = 0
    while w < WAYS {
        s = stand(ankles)
        angle = 6.283185 * (w as float) / (WAYS as float)
        k = 0
        while k < SHOVE_AT + AFTER {
            if k == SHOVE_AT {
                j = SPEED * physics.ragdoll_mass(s.r)
                motion.shove(s.m, human.BONE_SPINE_03, core.vec3(sin(angle) * j, 0.0, cos(angle) * j))
            }
            engine.engine_update(s.e, STEP)
            k = k + 1
        }
        if motion.falling(s.m) || motion.lying(s.m) || motion.down(s.m) { fell = fell + 1 }
        done(s)
        w = w + 1
    }
    return fell
}

main() {
    println("ankled_steps: a figure with ankles steps as one without does (#709)")
    plain = stand(false)
    if plain.r == null {
        println("ankled_steps: SKIP ${BOXMAN} would not load")
        done(plain)
        return
    }
    ankled = stand(true)
    if physics.ragdoll_bone_count(ankled.r) <= human.BONE_COUNT {
        println("ankled_steps: SKIP the fixture's rig has no toes to stand a foot on")
        done(plain)
        done(ankled)
        return
    }
    whole = physics.ragdoll_mass(plain.r)
    total = physics.ragdoll_mass(ankled.r)
    foot = bone_mass(ankled.r, human.BONE_FOOT_L)
    calf = bone_mass(ankled.r, human.BONE_CALF_L)
    println("  without ankles ${whole} kg; with them ${total} kg, a foot ${foot}, a calf ${calf}")
    check("with ankles it weighs what it weighs without, to 0.1 kg", core.abs_of(total - whole) < 0.1)
    check("each foot its share (1.37%) and each calf its shank's (4.33%), to 1 g a kilogram",
          core.abs_of(foot - whole * 0.0137) < 0.001 * whole && core.abs_of(calf - whole * 0.0433) < 0.001 * whole)
    done(plain)
    done(ankled)
    without = falls(false)
    with_ankles = falls(true)
    println("  shoved ${SPEED} m/s from ${WAYS} ways: ${with_ankles} fell with ankles, ${without} without")
    check("shoved from round it, it falls no more often than twice as often as without ankles, plus one", with_ankles <= without * 2 + 1)
    if g_failures == 0 {
        println("ankled_steps: all checks passed (${g_checks})")
        return
    }
    println("ankled_steps: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
