// Shadows asked for through the engine surface have to reach the frame.
//
// ae3d#231: every shadow the engine could draw was drawn by something else.
// The renderers build their map inside the "turn shadows on" setter, and the
// engine never called it, so a program written against ae3d.engine rendered
// shadowless whatever it asked for -- the editor and the backend suites call
// the backend directly and never noticed. Rendering the same scene twice
// through the engine and comparing the two frames is the only thing that would
// have caught it: with no shadow map the two are identical.
//
// #464: the scene this measured by was a ball 130 m up under a low sun, whose
// shadow fell a hundred and fifty metres off to the side: the half of the
// frame it was read on darkened by half a percent, and a shadow almost gone
// would have passed. The scene is now a box floating a few metres over the
// ground, the sun high and to one side, and the shadow read where geometry
// puts it:
//
//   - the ground inside the box's shadow, where the camera sees it past the
//     box, darkens by more than a third when shadows are on;
//   - lit ground on either side of it, the control, moves by less than two
//     hundredths, so what darkened is the shadow and not the frame;
//   - both by more than the frame moves by itself, two frames running.

import std.mem
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader
import ae3d.capture

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 320
const HEIGHT = 180

var g_checks = 0
var g_failures = 0

var g_ground: ptr = null
var g_blocker: ptr = null

var g_default_on = false
var g_reported_off = true
var g_measured = 0

// The spot in the shadow and the two controls, with shadows on, off, and
// off again the frame after.
var g_shadowed_spot = 0.0
var g_shadowed_left = 0.0
var g_shadowed_right = 0.0
var g_lit_spot = 0.0
var g_lit_left = 0.0
var g_lit_right = 0.0
var g_again_spot = 0.0

// The ground under the box's shadow, and lit ground to its left and right.
// The sun comes from (0.6, 1.0, 0.2): the box's top, at 11 m, throws its
// shadow 6.6 m toward -x and 2.2 m toward -z, so the ground around
// (-8.5, 0, -3.5) is in shadow and outside the box's own footprint.
const SPOT_X = 0.0 - 8.5
const SPOT_Z = 0.0 - 3.5
const LEFT_X = 0.0 - 22.0
const RIGHT_X = 12.0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

// The mean grey of a 6 x 6 block of the frame around where the ground point
// (x, 0, z) lands, projected onto the frame at the size it was drawn: the
// window's framebuffer, twice the window on a HiDPI screen (#671), where at
// the window's size the spots all fell in the frame's bottom-left quarter.
spot_grey(e: *Engine, block: ptr, x: float, z: float) -> float {
    win = engine.engine_window(e)
    p = core.camera_world_to_screen(engine.engine_camera(e), core.vec3(x, 0.0, z), platform.window_fb_width(win),
                                    platform.window_fb_height(win))
    if p.w < 0.0001 { return 0.0 - 1.0 }
    if capture.region((p.x as int) - 3, (p.y as int) - 3, 6, 6, 0, 0, block) == 0 { return 0.0 - 1.0 }
    return (capture.slot(block, 0) + capture.slot(block, 1) + capture.slot(block, 2)) / 3.0
}

on_start(state: ptr, e: *Engine) {
    ground = loader.plane(24, 16.0)
    core.model_set_position(ground, 0.0 - 192.0, 0.0, 0.0 - 192.0)
    core.model_matte(ground, 0.85, 0.85, 0.85)
    engine.engine_add_model(e, ground)
    g_ground = ground as ptr

    blocker = loader.cube(1.0)
    core.model_set_scale(blocker, 8.0, 8.0, 8.0)
    core.model_set_position(blocker, 0.0, 7.0, 0.0)
    core.model_matte(blocker, 0.8, 0.3, 0.2)
    engine.engine_add_model(e, blocker)
    g_blocker = blocker as ptr

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 40.0, 30.0))
    core.camera_look_at(cam, core.vec3(0.0 - 4.0, 0.0, 0.0 - 1.0))

    // Before anything was rendered, and without the program having asked: an
    // engine lights its scenes with shadows unless told otherwise.
    g_default_on = engine.engine_shadows(e)
}

on_render(state: ptr, e: *Engine, delta: float) {
    frame = engine.engine_frame_count(e)

    // Past the first frames, whose picture is still settling (#394: on
    // llvmpipe the whole frame came out 0.06 brighter at frame 2 than at
    // frame 4).
    if frame != 4 && frame != 8 && frame != 9 { return }
    win = engine.engine_window(e)
    if capture.frame(platform.window_fb_width(win), platform.window_fb_height(win)) == 0 { return }

    block = calloc(8, 8)
    spot = spot_grey(e, block, SPOT_X, SPOT_Z)
    left = spot_grey(e, block, LEFT_X, SPOT_Z)
    right = spot_grey(e, block, RIGHT_X, SPOT_Z)
    if frame == 4 {
        g_shadowed_spot = spot
        g_shadowed_left = left
        g_shadowed_right = right
        engine.engine_set_shadows(e, false)
        g_reported_off = engine.engine_shadows(e)
    } else if frame == 8 {
        g_lit_spot = spot
        g_lit_left = left
        g_lit_right = right
    } else {
        g_again_spot = spot
    }
    g_measured = g_measured + 1
    free(block)
}

main() {
    // An OpenGL test by design: it reads the frame through capture.frame.
    e = engine.engine_new_with(platform.API_GL)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_title(e, "ae3d engine shadows test")
    engine.engine_set_frame_limit(e, 10)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_vsync(e, 0)

    light = core.light_sun(core.vec3(0.6, 1.0, 0.2))
    engine.engine_set_light(e, light)

    program = engine.behaviour_new("shadows test", null)
    program.start = on_start
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)

    if !engine.engine_run(e) {
        println("engine shadows: SKIP no window")
        core.light_free(light)
        engine.engine_free(e)
        return
    }

    if g_measured < 3 {
        println("engine shadows: SKIP no readable frames")
        core.light_free(light)
        engine.engine_free(e)
        return
    }

    check("shadows are on by default", g_default_on)
    check("turning them off is reported", !g_reported_off)

    // How much of the spot's light the shadow takes, and how much of the
    // controls'.
    darkened = 1.0 - g_shadowed_spot / g_lit_spot
    moved_left = g_shadowed_left - g_lit_left
    if moved_left < 0.0 { moved_left = 0.0 - moved_left }
    moved_right = g_shadowed_right - g_lit_right
    if moved_right < 0.0 { moved_right = 0.0 - moved_right }
    drift = g_again_spot - g_lit_spot
    if drift < 0.0 { drift = 0.0 - drift }
    println("  the shadowed spot ${g_shadowed_spot} against ${g_lit_spot} lit: darkened by ${darkened * 100.0}%; the controls moved ${moved_left} and ${moved_right}; the frame by itself ${drift}")

    // A shadow takes the sun's direct light and leaves the sky's fill.
    check("the engine's frame darkens where the shadow falls, by more than a third", darkened > 0.33)
    check("and not beside it", moved_left < 0.02 && moved_right < 0.02)
    check("by more than the frame moves by itself", g_lit_spot - g_shadowed_spot > drift * 10.0)

    core.light_free(light)
    engine.engine_free(e)
    if g_ground != null { core.model_free(g_ground as *Model) }
    if g_blocker != null { core.model_free(g_blocker as *Model) }

    if g_failures == 0 {
        println("engine shadows: all checks passed (${g_checks})")
    } else {
        println("engine shadows: ${g_failures} of ${g_checks} checks failed")
    }
}
