// What a scene is set to, written as its root's components (#895): where it
// is seen from, its sky and environment map, its fog, its passes, its culling
// and its weather go into the scene file's components with everything else,
// and come back into a fresh engine through them. No view is written. A
// weather running in the program takes what the file's Weather said. Headless.

import std.json
import std.list
import std.string
import std.fs
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.components
import ae3d.scene
import ae3d.weather

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

near(a: float, b: float) -> bool { return core.abs_of(a - b) < 0.0001 }

// An engine with no window, its scene seen from a camera of its own, and the
// scene's Weather held for a weather not yet running.
world() -> *Engine {
    e = engine.engine_new()
    root = engine.engine_scene_root(e)
    cam = core.camera_new(1280, 720)
    components.place_camera(root, cam)
    component.add(root, weather.weather_component_kind())
    return e
}

camera_of(e: *Engine) -> *Camera {
    return behaviour.component_state(component.find(engine.engine_scene_root(e), components.camera_kind())) as *Camera
}

weather_state(e: *Engine) -> *Weather {
    return behaviour.component_state(component.find(engine.engine_scene_root(e), weather.weather_component_kind())) as *Weather
}

main() {
    println("scene settings: what a scene is set to, as its root's components")
    fs.mkdir_p("build/scene_settings/")
    path = "build/scene_settings/scene.json"

    first = world()
    cam = camera_of(first)
    core.camera_set_position(cam, core.vec3(12.0, 34.0, 56.0))
    cam.yaw = 0.0 - 33.0
    cam.pitch = 12.5
    core.camera_update_vectors(cam)
    core.camera_set_fov(cam, 62.0)
    core.camera_set_far(cam, 4321.0)
    engine.engine_set_clear_color(first, 0.2, 0.4, 0.6)
    engine.engine_set_post(first, true, true, 1.0, 1.75)
    engine.engine_set_depth_of_field(first, true, 4.25, 20.0, 40.0)
    engine.engine_set_face_culling(first, false)
    fog = core.fog_none()
    fog.enabled = true
    fog.start = 20.0
    fog.end = 300.0
    fog.intensity = 0.5
    engine.engine_set_fog(first, fog)
    sky = component.find(engine.engine_scene_root(first), weather.weather_component_kind())
    component.set_int(sky, component.field_named(weather.weather_component_kind(), "kind"), weather.STORM)
    component.set_float(sky, component.field_named(weather.weather_component_kind(), "intensity"), 0.9)
    component.set_float(sky, component.field_named(weather.weather_component_kind(), "wind heading"), 135.0)
    component.set_float(sky, component.field_named(weather.weather_component_kind(), "wind speed"), 12.5)

    models = list.new()
    lights = list.new()
    owned = component.saved_for(engine.engine_scene(first))
    check("a scene with every setting changed saves", scene.scene_save(models, lights, null, owned, path, "build/scene_settings/"))
    scene.saved_components_free(owned)
    text, err = fs.read(path)
    check("the file carries no view", err == "" && string.index_of(text, "\"view\"") < 0 && !scene.scene_has_view(path))
    check("and the scene's camera, environment, rendering and weather among its components",
          string.index_of(text, "\"kind\":\"Camera\"") >= 0 && string.index_of(text, "\"kind\":\"Environment\"") >= 0 &&
          string.index_of(text, "\"kind\":\"Rendering\"") >= 0 && string.index_of(text, "\"kind\":\"Weather\"") >= 0)
    string.free(text)

    // A fresh engine, its settings as a new one has them, then the file's.
    second = world()
    carried = scene.scene_load_components(path)
    placed = list.new()
    unresolved = component.attach_loaded(engine.engine_scene(second), placed, carried)
    check("every component of the file is one this program has", list.size(unresolved) == 0)
    list.free(unresolved)
    list.free(placed)
    scene.loaded_components_free(carried)
    seen = camera_of(second)
    check("the camera stands where it stood (${seen.position.x}, ${seen.position.y}, ${seen.position.z})",
          near(seen.position.x, 12.0) && near(seen.position.y, 34.0) && near(seen.position.z, 56.0))
    check("looking the way it looked", near(seen.yaw, 0.0 - 33.0) && near(seen.pitch, 12.5) && near(seen.front.x, cam.front.x) && near(seen.front.y, cam.front.y))
    check("through the same lens", near(seen.fov, 62.0) && near(seen.far, 4321.0))
    view = engine.engine_view(second)
    check("the sky's colour", near(view.sky_r, 0.2) && near(view.sky_g, 0.4) && near(view.sky_b, 0.6))
    check("the bloom", view.fxaa && view.bloom && near(view.bloom_intensity, 1.75))
    check("the depth of field", view.dof && near(view.dof_focus, 4.25) && near(view.dof_aperture, 20.0) && near(view.dof_max_radius, 40.0))
    check("the fog", view.fog && near(view.fog_start, 20.0) && near(view.fog_end, 300.0) && near(view.fog_intensity, 0.5))
    check("and the culling, the scene's own: faces drawn both sides", !view.face_culling && view.frustum_culling && !core.face_culling())
    w = weather_state(second)
    check("the weather held for the program: a storm, 0.9, toward 135 degrees at 12.5 m/s",
          weather.weather_kind(w) == weather.STORM && near(weather.weather_intensity(w), 0.9) &&
          near(core.rad_to_deg(core.atan2_of(w.wind_dir.z, w.wind_dir.x)), 135.0) && near(w.wind_speed, 12.5))

    // A weather running in the program takes it in place of the one held.
    running = weather.weather_new(second)
    weather.weather_attach(running, engine.engine_scene_root(second))
    check("a running weather put on the scene takes the file's",
          weather_state(second) == running && weather.weather_kind(running) == weather.STORM && near(weather.weather_intensity(running), 0.9) &&
          near(running.wind_speed, 12.5))

    // A camera made after the file was read gives way the same: the engine
    // puts its own on the scene once its window is up, with the file's place.
    later = core.camera_new(640, 360)
    components.place_camera(engine.engine_scene_root(second), later)
    check("a camera put on the scene takes the place it held", camera_of(second) == later && near(later.position.y, 34.0) && near(later.fov, 62.0))

    engine.engine_set_face_culling(second, true)
    weather.weather_free(running)
    core.camera_free(cam)
    core.camera_free(seen)
    core.camera_free(later)
    engine.engine_free(first)
    engine.engine_free(second)
    list.free(models)
    list.free(lights)
    if g_failures == 0 {
        println("scene settings: all checks passed (${g_checks})")
    } else {
        println("scene settings: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
