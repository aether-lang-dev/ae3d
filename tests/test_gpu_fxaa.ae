// ae3d.gpu's FXAA tree, run on the CPU, against FXAA run on the GPU by the
// renderer (fxaa_vk.frag, the last pass of the Vulkan frame).
//
// FXAA is the last pass: the composite writes the frame into a display-
// format texture and FXAA reads it there, through a linear clamp-to-edge
// sampler. So a frame drawn with FXAA off is exactly what FXAA reads when
// it is on. This draws a small scene with edges (a sphere and a cube on
// black) with temporal anti-aliasing off, twice without FXAA (the two must
// be the same frame, or there is nothing fixed to compare against) and once
// with it; runs gpu.fxaa_shader() on the CPU over the plain frame, with the
// uniforms the renderer gives the pass (edge thresholds 0.125 and 0.0625,
// subpixel quality 0.75, a texel of the frame's size); rounds each colour to
// 8 bits as the frame's format does; and holds every channel of every pixel
// to the GPU's within one step of 255 (the GPU's float maths and its
// sampler's weights against the evaluator's doubles land a rounding either
// side, and no more). A smoothstep off by a twentieth reaches two steps;
// finer errors than that an 8-bit frame cannot show, and tests/test_gpu.ae
// holds the evaluator to 1e-5 against FXAA written in Aether. How many
// pixels match exactly is reported, not held: it is how a device rounds
// (34 of 6144 differ on an Apple GPU, 23 on lavapipe on x86_64, 187 on
// lavapipe on arm64), always by the one step.
//
// Skips where there is no Vulkan device.

import std.mem
import std.heap
import ae3d.core
import ae3d.vulkan
import ae3d.loader
import ae3d.gpu

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, bytes: int) -> ptr
extern exit(code: int)

const WIDTH = 96
const HEIGHT = 64
// Steps of 255 a channel may differ by.
const STEPS = 1

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

channel(pixels: ptr, index: int) -> int {
    return mem.get_byte(pixels, index)
}

same_frame(a: ptr, c: ptr) -> bool {
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        if channel(a, i) != channel(c, i) { return false }
        i = i + 1
    }
    return true
}

// A colour as the frame stores it: 8 bits, rounded.
to8(v: float) -> int {
    x = v
    if x < 0.0 { x = 0.0 }
    if x > 1.0 { x = 1.0 }
    return (x * 255.0 + 0.5) as int
}

absi(v: int) -> int {
    if v < 0 { return 0 - v }
    return v
}

main() {
    println("ae3d.gpu FXAA on the CPU against the renderer's FXAA on the GPU")
    if !vulkan.available() {
        println("gpu_fxaa: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    pass = vulkan.backend(renderer)
    if !core.backend_init(&pass, null, WIDTH, HEIGHT) {
        println("gpu_fxaa: SKIP Vulkan would not start (${vulkan.last_error()})")
        return
    }
    vulkan.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    vulkan.renderer_set_taa(renderer, false)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 20.0, 90.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    ball = loader.sphere(1.0, 24, 16)
    core.model_set_scale(ball, 22.0, 22.0, 22.0)
    core.model_set_position(ball, 0.0 - 18.0, 0.0, 0.0)
    core.model_set_diffuse(ball, 0.9, 0.85, 0.8)
    core.backend_add_model(&pass, ball)
    box = loader.cube(1.0)
    core.model_set_scale(box, 26.0, 26.0, 26.0)
    core.model_set_position(box, 22.0, 0.0, 0.0 - 10.0)
    core.model_set_diffuse(box, 0.2, 0.6, 0.9)
    core.backend_add_model(&pass, box)

    // The frame FXAA will read, drawn twice: it must not move between draws.
    core.backend_set_post(&pass, false, false, 0.8, 0.4)
    core.backend_render(&pass, cam, light)
    plain = calloc(WIDTH * HEIGHT * 4, 1)
    memcpy(plain, vulkan.offscreen_pixels(), WIDTH * HEIGHT * 4)
    core.backend_render(&pass, cam, light)
    check("the plain frame is the same drawn twice", same_frame(plain, vulkan.offscreen_pixels()))

    core.backend_set_post(&pass, true, false, 0.8, 0.4)
    core.backend_render(&pass, cam, light)
    smoothed = calloc(WIDTH * HEIGHT * 4, 1)
    memcpy(smoothed, vulkan.offscreen_pixels(), WIDTH * HEIGHT * 4)
    check("the GPU's FXAA changed the frame", !same_frame(plain, smoothed))

    // The plain frame as the image FXAA samples.
    img = gpu.image_new(WIDTH, HEIGHT)
    lit = 0
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            i = (y * WIDTH + x) * 4
            r = channel(plain, i)
            if r + channel(plain, i + 1) + channel(plain, i + 2) > 0 { lit = lit + 1 }
            gpu.image_set(img, x, y, r / 255.0, channel(plain, i + 1) / 255.0, channel(plain, i + 2) / 255.0, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    check("the scene is in the frame (${lit} of ${WIDTH * HEIGHT} pixels lit)", lit > WIDTH * HEIGHT / 10 && lit < WIDTH * HEIGHT)

    s = gpu.fxaa_shader()
    cx = gpu.cpu_new(s)
    gpu.cpu_set(cx, "texelSize", gpu.v2(1.0 / WIDTH, 1.0 / HEIGHT))
    gpu.cpu_set(cx, "edgeThreshold", gpu.v1(0.125))
    gpu.cpu_set(cx, "edgeThresholdMin", gpu.v1(0.0625))
    gpu.cpu_set(cx, "subpixelQuality", gpu.v1(0.75))
    gpu.cpu_texture(cx, "screenTexture", img)

    worst = 0
    off = 0
    exact = 0
    changed_cpu = 0
    ran = 0
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            uv = gpu.v2((x + 0.5) / WIDTH, (y + 0.5) / HEIGHT)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            if got != null {
                ran = ran + 1
                i = (y * WIDTH + x) * 4
                dr = absi(to8(gpu.val_x(got)) - channel(smoothed, i))
                dg = absi(to8(gpu.val_y(got)) - channel(smoothed, i + 1))
                db = absi(to8(gpu.val_z(got)) - channel(smoothed, i + 2))
                d = dr
                if dg > d { d = dg }
                if db > d { d = db }
                if d > worst { worst = d }
                if d > STEPS { off = off + 1 }
                if d == 0 { exact = exact + 1 }
                if to8(gpu.val_x(got)) != channel(plain, i) || to8(gpu.val_y(got)) != channel(plain, i + 1) || to8(gpu.val_z(got)) != channel(plain, i + 2) {
                    changed_cpu = changed_cpu + 1
                }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            x = x + 1
        }
        y = y + 1
    }
    check("the CPU ran every pixel (${ran} of ${WIDTH * HEIGHT})", ran == WIDTH * HEIGHT)
    check("the CPU's FXAA changed pixels too (${changed_cpu})", changed_cpu > 0)
    check("every channel within ${STEPS} step of the GPU's (worst ${worst}, ${off} over)", off == 0)
    println("       ${exact} of ${WIDTH * HEIGHT} pixels exactly the GPU's")
    gpu.cpu_free(cx)
    free(plain)
    free(smoothed)

    println("${g_checks - g_failures}/${g_checks} checks passed")
    if g_failures > 0 { exit(1) }
}
