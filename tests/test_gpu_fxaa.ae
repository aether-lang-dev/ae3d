// FXAA as written with `quote` (ae3d.shaders.fxaa), run on the CPU by
// ae3d.gpu, against FXAA run on the GPU by each renderer (the last pass of
// the frame): Vulkan, from the SPIR-V generated from the tree, and OpenGL,
// from the GLSL the same tree writes for it at start.
//
// FXAA is the last pass: the composite writes the frame into a display-
// format texture and FXAA reads it there, through a linear clamp-to-edge
// sampler. So a frame drawn with FXAA off is exactly what FXAA reads when
// it is on. This draws a small scene with edges (a sphere and a cube on
// black) with temporal anti-aliasing off, twice without FXAA (the two must
// be the same frame, or there is nothing fixed to compare against) and once
// with it; runs fxaa.fxaa() on the CPU over the plain frame, with the
// uniforms the renderer gives the pass (edge thresholds 0.125 and 0.0625,
// subpixel quality 0.75, a texel of the frame's size); rounds each colour to
// 8 bits as the frame's format does; and holds every channel of every pixel
// to the GPU's within one step of 255 (the GPU's float maths and its
// sampler's weights against the evaluator's doubles land a rounding either
// side, and no more). A smoothstep off by a twentieth reaches two steps;
// finer errors than that an 8-bit frame cannot show, and tests/test_gpu.ae
// holds the evaluator to 1e-5 against FXAA written in Aether. How many
// pixels match exactly is reported, not held: it is how a device rounds,
// always by the one step.
//
// Each renderer is held to it at the size it started at and then at
// another: the texel is a capture of FXAA's tree, which a renderer makes
// again when its frame changes size (a tree left at the first size is five
// steps out at the second on Vulkan).
//
// Vulkan skips where there is no Vulkan device, OpenGL where no context
// can be made.

import std.mem
import std.heap
import std.string
import ae3d.core
import ae3d.vulkan
import ae3d.gl
import ae3d.offscreen
import ae3d.loader
import ae3d.gpu
import ae3d.shaders.fxaa
import ae3d.shaderlib (vec2, image_new, image_set, image_free, texture_of)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, bytes: int) -> ptr
extern exit(code: int)

const WIDTH = 96
const HEIGHT = 64
// The size the frame is then remade at.
const WIDTH_2 = 80
const HEIGHT_2 = 56
// Steps of 255 a channel may differ by.
const STEPS = 1
// On Apple's OpenGL, which is a translation onto Metal: one pixel of the
// 80 x 56 frame comes out two steps from the CPU's, where the GPU's FXAA
// moved it by nothing. The hand-written GLSL the quoted shader replaced
// gave that pixel the same (checked, 2026-10-13); Mesa's OpenGL and every
// Vulkan are within the one step.
const APPLE_GL_STEPS = 2
var g_steps = STEPS

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

channel(pixels: ptr, index: int) -> int {
    return mem.get_byte(pixels, index)
}

same_frame(a: ptr, c: ptr, bytes: int) -> bool {
    i = 0
    while i < bytes {
        if channel(a, i) != channel(c, i) { return false }
        i = i + 1
    }
    return true
}

// A colour as the frame stores it: 8 bits, rounded.
to8(v: float) -> int {
    x = v
    if x < 0.0 { x = 0.0 }
    if x > 1.0 { x = 1.0 }
    return (x * 255.0 + 0.5) as int
}

absi(v: int) -> int {
    if v < 0 { return 0 - v }
    return v
}

// The CPU's FXAA over `plain` (w x h, RGBA8, top row first), against what
// the GPU made of it, `smoothed`. `flipped` where the GPU's texture has its
// first row at the bottom (OpenGL's): the CPU's image is laid out as the
// texture is, so north and south are the GPU's.
against(plain: ptr, smoothed: ptr, w: int, h: int, flipped: bool) {
    bytes = w * h * 4
    check("the GPU's FXAA changed the frame", !same_frame(plain, smoothed, bytes))

    // The plain frame as the image FXAA samples.
    img = image_new(w, h)
    lit = 0
    y = 0
    while y < h {
        x = 0
        while x < w {
            i = (row_of(y, h, flipped) * w + x) * 4
            r = channel(plain, i)
            if r + channel(plain, i + 1) + channel(plain, i + 2) > 0 { lit = lit + 1 }
            image_set(img, x, y, r / 255.0, channel(plain, i + 1) / 255.0, channel(plain, i + 2) / 255.0, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    check("the scene is in the frame (${lit} of ${w * h} pixels lit)", lit > w * h / 10 && lit < w * h)

    s = fxaa.fxaa(texture_of(img), vec2(1.0 / w, 1.0 / h), 0.125, 0.0625, 0.75)
    cx = gpu.cpu_new(s)
    worst = 0
    off = 0
    exact = 0
    changed_cpu = 0
    ran = 0
    y = 0
    while y < h {
        x = 0
        while x < w {
            uv = gpu.v2((x + 0.5) / w, (y + 0.5) / h)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            if got != null {
                ran = ran + 1
                i = (row_of(y, h, flipped) * w + x) * 4
                dr = absi(to8(gpu.val_x(got)) - channel(smoothed, i))
                dg = absi(to8(gpu.val_y(got)) - channel(smoothed, i + 1))
                db = absi(to8(gpu.val_z(got)) - channel(smoothed, i + 2))
                d = dr
                if dg > d { d = dg }
                if db > d { d = db }
                if d > worst { worst = d }
                if d > g_steps { off = off + 1 }
                if d == 0 { exact = exact + 1 }
                if to8(gpu.val_x(got)) != channel(plain, i) || to8(gpu.val_y(got)) != channel(plain, i + 1) || to8(gpu.val_z(got)) != channel(plain, i + 2) {
                    changed_cpu = changed_cpu + 1
                }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            x = x + 1
        }
        y = y + 1
    }
    check("the CPU ran every pixel (${ran} of ${w * h})", ran == w * h)
    check("the CPU's FXAA changed pixels too (${changed_cpu})", changed_cpu > 0)
    check("every channel within ${g_steps} step(s) of the GPU's (worst ${worst}, ${off} over)", off == 0)
    println("       ${exact} of ${w * h} pixels exactly the GPU's")
    gpu.cpu_free(cx)
    gpu.shader_free(s)
    image_free(img)
}

// The frame's row of the texture's row `y`.
row_of(y: int, h: int, flipped: bool) -> int {
    if flipped { return h - 1 - y }
    return y
}

// A sphere and a cube, lit by `light`, in `pass`'s scene; freed by the
// caller.
add_scene(pass: *Backend) -> (*Model, *Model) {
    ball = loader.sphere(1.0, 24, 16)
    core.model_set_scale(ball, 22.0, 22.0, 22.0)
    core.model_set_position(ball, 0.0 - 18.0, 0.0, 0.0)
    core.model_set_diffuse(ball, 0.9, 0.85, 0.8)
    core.backend_add_model(pass, ball)
    box = loader.cube(1.0)
    core.model_set_scale(box, 26.0, 26.0, 26.0)
    core.model_set_position(box, 22.0, 0.0, 0.0 - 10.0)
    core.model_set_diffuse(box, 0.2, 0.6, 0.9)
    core.backend_add_model(pass, box)
    return ball, box
}

camera_for(w: int, h: int) -> *Camera {
    cam = core.camera_new(w, h)
    core.camera_set_position(cam, core.vec3(0.0, 20.0, 90.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    return cam
}

vulkan_rounds() {
    println("Vulkan")
    if !vulkan.available() {
        println("  skip no Vulkan driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    pass = vulkan.backend(renderer)
    if !core.backend_init(&pass, null, WIDTH, HEIGHT) {
        println("  skip Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    vulkan.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    vulkan.renderer_set_taa(renderer, false)
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    ball, box = add_scene(&pass)
    round = 0
    while round < 2 {
        w = WIDTH
        h = HEIGHT
        if round == 1 {
            w = WIDTH_2
            h = HEIGHT_2
            core.backend_update_viewport(&pass, w, h)
        }
        println("  at ${w} x ${h}")
        cam = camera_for(w, h)
        bytes = w * h * 4
        // Drawn twice without FXAA: it must not move between draws. (The
        // first draw at a new size is where the frame is remade.)
        core.backend_set_post(&pass, false, false, 0.8, 0.4)
        core.backend_render(&pass, cam, light)
        check("the frame is ${w} x ${h}", vulkan.offscreen_width() == w && vulkan.offscreen_height() == h)
        plain = calloc(bytes, 1)
        memcpy(plain, vulkan.offscreen_pixels(), bytes)
        core.backend_render(&pass, cam, light)
        check("the plain frame is the same drawn twice", same_frame(plain, vulkan.offscreen_pixels(), bytes))
        core.backend_set_post(&pass, true, false, 0.8, 0.4)
        core.backend_render(&pass, cam, light)
        smoothed = calloc(bytes, 1)
        memcpy(smoothed, vulkan.offscreen_pixels(), bytes)
        against(plain, smoothed, w, h, false)
        free(plain)
        free(smoothed)
        core.camera_free(cam)
        round = round + 1
    }
    vulkan.renderer_free(renderer)
    core.model_free(ball)
    core.model_free(box)
    core.light_free(light)
}

opengl_rounds() {
    println("OpenGL")
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  skip no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    pass = gl.backend(renderer)
    if !core.backend_init(&pass, context, WIDTH, HEIGHT) {
        println("  skip OpenGL would not start")
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
        return
    }
    if string.contains(gl.gl_version(), "Metal") != 0 { g_steps = APPLE_GL_STEPS }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    gl.renderer_set_taa(renderer, false)
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    ball, box = add_scene(&pass)
    round = 0
    while round < 2 {
        w = WIDTH
        h = HEIGHT
        if round == 1 {
            w = WIDTH_2
            h = HEIGHT_2
            core.backend_update_viewport(&pass, w, h)
            offscreen.target_resize(target, w, h)
        }
        println("  at ${w} x ${h}")
        cam = camera_for(w, h)
        bytes = w * h * 4
        core.backend_set_post(&pass, false, false, 0.8, 0.4)
        core.backend_render(&pass, cam, light)
        plain = calloc(bytes, 1)
        memcpy(plain, offscreen.target_pixels(target), bytes)
        core.backend_render(&pass, cam, light)
        check("the plain frame is the same drawn twice", same_frame(plain, offscreen.target_pixels(target), bytes))
        core.backend_set_post(&pass, true, false, 0.8, 0.4)
        core.backend_render(&pass, cam, light)
        smoothed = calloc(bytes, 1)
        memcpy(smoothed, offscreen.target_pixels(target), bytes)
        against(plain, smoothed, w, h, true)
        free(plain)
        free(smoothed)
        core.camera_free(cam)
        round = round + 1
    }
    gl.renderer_free(renderer)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)
    core.model_free(ball)
    core.model_free(box)
    core.light_free(light)
}

main() {
    println("ae3d.gpu FXAA on the CPU against the renderers' FXAA on the GPU")
    vulkan_rounds()
    opengl_rounds()

    // ci.sh passes a suite on this line.
    if g_failures == 0 {
        println("gpu_fxaa: all checks passed (${g_checks})")
        return
    }
    println("gpu_fxaa: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
