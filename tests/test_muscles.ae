// A figure on muscles (#790, motion.set_muscles), held to numbers: the box
// man with feet of its own (#709), POWERED, each case in an engine of its
// own, no window.
//
//   - on muscles it stands: under 0.05 rad and its pelvis under 3 cm off
//     where it stood, three seconds on;
//   - shoved 1.0 m/s at the chest from behind, what a step catches, its
//     balance stays pinned and it stands;
//   - shoved 2.4 m/s with nothing ahead, past what its steps catch, the pin
//     is let go: all of it within PIN_RELEASE and a little (and regained
//     after, as long as it keeps its feet);
//   - shoved 2.4 m/s toward a wall 0.9 m ahead, its hands take the wall and
//     it stands, under 0.1 rad four seconds on (the blow does not unpin it:
//     the wall holds it up);
//   - struck down onto its front, it gets up by itself, ends under 0.1 rad
//     off upright and moves under 5 cm the second after it is handed back to
//     its balance, its pin regained by then (its muscles idle through the way
//     up, its anchors carrying it);
//   - knocked down backwards as Siltreach knocks its people (2.8 m/s back
//     and 0.25 up, at its centre of mass and 0.35 m), the fall's brake
//     holds until it lands (its balance assist at the fall's torque, over
//     0.9 of it, however unpinned) and its hips stay under its neck: let go
//     with the pin, Siltreach's figure went over its shoulders, legs over its
//     head, and rose turned half round (#822);
//   - taken off muscles standing, it stands on the velocity servo.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// An engine with ground, and the box man on muscles standing in it a
// second and a half; null when the fixture would not load.
stage(e: *Engine) -> *Motion {
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null { return null }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    motion.set_muscles(m, true)
    run(e, 90)
    return m
}

run(e: *Engine, steps: int) {
    k = 0
    while k < steps {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

done(e: *Engine, m: *Motion) {
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
}

pelvis_at(m: *Motion) -> Vec3 {
    return behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
}

shove(m: *Motion, way: Vec3, speed: float) {
    motion.shove(m, human.BONE_SPINE_03, core.v3_mul(way, speed * physics.ragdoll_mass(m.ragdoll)))
}

standing() {
    e = engine.engine_new()
    m = stage(e)
    if m == null {
        check("the box man loads", false)
        engine.engine_free(e)
        return
    }
    check("it is on muscles", motion.muscles(m) && physics.ragdoll_muscles(m.ragdoll))
    from = pelvis_at(m)
    run(e, 180)
    moved = core.v3_len(core.vec3(pelvis_at(m).x - from.x, 0.0, pelvis_at(m).z - from.z))
    println("  standing: ${motion.tilt(m)} rad, the pelvis ${moved * 100.0} cm off where it stood")
    check("on muscles it stands: under 0.05 rad, the pelvis under 3 cm off three seconds on", motion.tilt(m) < 0.05 && moved < 0.03)
    // Taken off muscles, standing: the servo holds it as before.
    motion.set_muscles(m, false)
    run(e, 180)
    check("taken off muscles, it stands on the servo (under 0.05 rad three seconds on)", !motion.muscles(m) && motion.tilt(m) < 0.05 && !motion.falling(m))
    done(e, m)
}

pinned() {
    e = engine.engine_new()
    m = stage(e)
    if m == null { return }
    shove(m, facing(m), 1.0)
    most = 0.0
    down = false
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        if m.unpin > most { most = m.unpin }
        if motion.falling(m) || motion.lying(m) { down = true }
        k = k + 1
    }
    println("  shoved 1.0 m/s: unpinned ${most} at the most, down ${down}")
    check("shoved 1.0 m/s, what a step catches, it stays pinned and stands", most < 0.01 && !down)
    done(e, m)
}

unpinned() {
    e = engine.engine_new()
    m = stage(e)
    if m == null { return }
    shove(m, facing(m), 2.4)
    // Let go over PIN_RELEASE, then regained as long as it keeps its feet:
    // the most it was let go.
    most = 0.0
    k = 0
    while k < 36 {
        engine.engine_update(e, STEP)
        if m.unpin > most { most = m.unpin }
        k = k + 1
    }
    println("  shoved 2.4 m/s with nothing ahead: unpinned ${most} at the most in 0.6 s")
    check("shoved 2.4 m/s with nothing ahead, its pin is let go within 0.6 s", most > 0.95)
    done(e, m)
}

walled() {
    e = engine.engine_new()
    m = stage(e)
    if m == null { return }
    way = facing(m)
    at = pelvis_at(m)
    wall = engine.object(e, "Wall", loader.cube(1.0))
    behaviour.object_set_position(wall, core.vec3(at.x + way.x * 1.15, 1.25, at.z + way.z * 1.15))
    behaviour.object_set_rotation(wall, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), way))
    physics.box_collider(wall, core.vec3(1.2, 1.25, 0.25), physics.material(0.8, 0.0))
    run(e, 30)
    shove(m, way, 2.4)
    down = false
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        if motion.lying(m) || motion.down(m) { down = true }
        k = k + 1
    }
    println("  shoved 2.4 m/s at a wall 0.9 m ahead: down ${down}, ${motion.tilt(m)} rad four seconds on, unpinned ${m.unpin}")
    check("shoved 2.4 m/s at a wall 0.9 m ahead, it takes the wall and stands, under 0.1 rad four seconds on", !down && motion.tilt(m) < 0.1)
    done(e, m)
}

risen() {
    e = engine.engine_new()
    m = stage(e)
    if m == null { return }
    motion.set_get_up(m, 0.5)
    r = m.ragdoll
    motion.hit(m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), core.v3_mul(facing(m), 3.25 * physics.ragdoll_mass(r)))
    rose = false
    tilt_up = 1.0
    risen_at = core.vec3(0.0, 0.0, 0.0)
    risen_step = 0
    drift = 1.0
    unpin = 1.0
    k = 0
    while k < 600 {
        before = motion.getting_up(m)
        engine.engine_update(e, STEP)
        if before && !motion.getting_up(m) && !rose {
            rose = true
            tilt_up = motion.tilt(m)
            risen_at = physics.ragdoll_center_of_mass(r)
            risen_step = k
            unpin = m.unpin
        }
        if rose && k == risen_step + 60 {
            now = physics.ragdoll_center_of_mass(r)
            drift = core.v3_len(core.vec3(now.x - risen_at.x, 0.0, now.z - risen_at.z))
        }
        k = k + 1
    }
    println("  struck down onto its front: rose ${rose}, ${tilt_up} rad off upright, ${drift * 100.0} cm moved the second after, unpinned ${unpin} as it was handed over")
    check("struck down, it gets up, under 0.1 rad off upright", rose && tilt_up < 0.1)
    check("handed back to its balance it stands where it rose, under 5 cm the second after", rose && drift < 0.05)
    check("its pin regained through the way up (under 0.05 unpinned at the hand-over)", rose && unpin < 0.05)
    done(e, m)
}

knocked() {
    e = engine.engine_new()
    m = stage(e)
    if m == null { return }
    r = m.ragdoll
    mass = physics.ragdoll_mass(r)
    at = core.v3_add(physics.ragdoll_center_of_mass(r), core.vec3(0.0, 0.35, 0.0))
    motion.hit(m, human.BONE_SPINE_03, at, core.v3_add(core.v3_mul(facing(m), 0.0 - 2.8 * mass), core.vec3(0.0, 0.25 * mass, 0.0)))
    brake = 0.0
    held = 1.0
    over = 0.0 - 1.0
    fell = false
    k = 0
    while k < 240 {
        engine.engine_update(e, STEP)
        if motion.falling(m) && !m.landed {
            fell = true
            now = physics.ragdoll_balance_assist(r)
            if brake <= 0.0 { brake = now }
            if brake > 0.0 && now / brake < held { held = now / brake }
        }
        hips = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y - behaviour.object_position(physics.ragdoll_bone(r, human.BONE_NECK)).y
        if hips > over { over = hips }
        k = k + 1
    }
    println("  knocked back 2.8 m/s: fell ${fell}, the fall's brake ${brake} N m held to ${held} of it until it landed, the hips ${over} m over the neck at the most")
    check("knocked down backwards, the fall's brake holds until it lands (over 0.9 of it)", fell && brake > 0.0 && held > 0.9)
    check("knocked down backwards, its hips stay under its neck (it does not roll over its shoulders)", fell && over < 0.0)
    done(e, m)
}

main() {
    println("muscles: the box man on muscles, with feet of its own (#790)")
    standing()
    pinned()
    unpinned()
    walled()
    knocked()
    risen()
    if g_failures > 0 {
        println("muscles: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("muscles: all checks passed (${g_checks})")
}
