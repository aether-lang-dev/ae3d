// Writhing on the ground (#414, #480), held to numbers. POWERED figures
// knocked down by a shove at the chest: from in front, onto their backs,
// one writhing for three seconds once it lands, a twin lying still and a
// third struck on the right forearm once down; from behind, onto its face,
// a fourth writhing where it lies. No window: the engine is stepped by
// hand.
//
//   - writhing moves the legs, face up and face down: face up the left hip
//     bends and straightens through more than 0.25 rad, face down the left
//     knee does (#691), where the still twin's hip hardly moves;
//   - its arms fold over its front: the upper arm points the way the
//     chest faces, a cosine of 0.3 more than at rest, as the ragdoll's
//     reference pose holds it (the reference ragdoll's shoulders and
//     elbows turn too little for a hand to reach its own chest, so the
//     fold is what is measured; the still twin is no measure, its arms
//     where its landing left them);
//   - it writhes where it lies, face up or down: the pelvis moves little;
//   - it stops when its time is up, and then settles, so a get-up counts
//     from there;
//   - a figure struck on the right forearm folds its left arm, and the
//     struck arm is left alone;
//   - it is deterministic: the same run twice ends bit for bit the same;
//   - every way a figure lands (#480): 64 writhers shoved from 32 ways
//     at 3.25 and 3.6 m/s (the speed each gives the whole body, #626;
//     450 and 500 N s on the 138.5 kg figure) all land, face up or down,
//     and in every one the leg (the hip, or face down the knee) swings
//     over 0.25 rad and the writhing stops on time; the pelvis drifts under
//     0.3 m in at least DRIFT_LEAST, all of them. Shoved from within 10
//     degrees of straight behind, face down, a writher drew a knee up
//     under its belly and rolled onto its back, 0.3 m and more across the
//     ground, in 2 of the 64; its arms, folded with all their muscle,
//     pressed its chest up and the legs pushed it along (#691). Sixteen from
//     eight ways, 45 degrees apart, stepped over that band.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const WRITHE = 3.0
const FIGURES = 4

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

// What a trial measured, per figure: 0 writhing face up, 1 still, 2 struck
// on the forearm (face up too), 3 writhing face down.
struct Trial {
    landed: ptr            // float[FIGURES]: seconds from the shove to lying; -1 never
    hip_swing: ptr         // float[FIGURES]: radians the left leg's angle ranged over, 0.5-2.5 s down (leg_cos)
    fold: ptr              // float[FIGURES]: how far the left upper arm points the way the chest faces (mean cosine), 0.5-2.5 s down
    face_up: ptr           // int[FIGURES]: 1 when it lay face up, 1 s down
    at_rest: float         // the same in the reference pose
    drift: float           // metres the writher's pelvis moved, level, from 1.5 s down to the end of writhing
    down_drift: float      // and the face-down writher's
    twin_drift: float      // and the still twin's, over the same three seconds
    stopped_at: float      // seconds after landing it stopped writhing; -1 never
    settled_after: float   // seconds after it stopped that it was down; -1 never
    right_aimed: bool      // the struck figure's right arm was aimed while it writhed
    end_pelvis: Vec3       // the writher's pelvis at the end
}

bone_at(m: *Motion, index: int) -> Vec3 {
    return behaviour.object_position(physics.ragdoll_bone(m.ragdoll, index))
}

// A hand: its forearm's far end.
hand(m: *Motion, forearm: int, pose: ptr) -> Vec3 {
    physics.ragdoll_body_pose(m.ragdoll, pose)
    return physics.ragdoll_pose_end(m.ragdoll, pose, forearm)
}

// The way the chest faces: the figure's front standing, turned as the
// chest is turned from standing.
chest_front(m: *Motion) -> Vec3 {
    rest = human.bone_at(physics.ragdoll_human(m.ragdoll), human.BONE_SPINE_03).reference_frame.q
    turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_SPINE_03), core.quat_conjugate(rest))
    ahead = physics.ragdoll_rest_forward(m.ragdoll)
    return core.quat_apply(turned, core.v3_normalize(core.vec3(ahead.x, 0.0, ahead.z)))
}

apart(a: Vec3, b: Vec3) -> float { return core.v3_len(core.v3_sub(a, b)) }

// How bent a writher's left leg is, as a cosine: at the hip face up (the
// thigh against the body, pelvis to chest), at the knee face down (the
// shin against the thigh): face down the legs bend at the knee (#691).
leg_cos(m: *Motion, prone: bool) -> float {
    thigh_way = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_THIGH_L),
                                physics.ragdoll_bone_axis(m.ragdoll, human.BONE_THIGH_L))
    if prone {
        shin_way = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_CALF_L),
                                   physics.ragdoll_bone_axis(m.ragdoll, human.BONE_CALF_L))
        return core.v3_dot(shin_way, thigh_way)
    }
    pelvis = bone_at(m, human.BONE_PELVIS)
    body_down = core.v3_normalize(core.v3_sub(pelvis, bone_at(m, human.BONE_SPINE_03)))
    return core.v3_dot(thigh_way, body_down)
}

clamp_unit(x: float) -> float {
    if x > 1.0 { return 1.0 }
    if x < 0.0 - 1.0 { return 0.0 - 1.0 }
    return x
}

run_trial(t: *Trial) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))

    pose = calloc(human.BONE_COUNT * physics.POSE_STRIDE, 8)
    motions_block = calloc(FIGURES, 8)
    motions = motions_block as ptr[]
    rigs_block = calloc(FIGURES, 8)
    rigs = rigs_block as ptr[]
    landed = t.landed as float[]
    fold = t.fold as float[]
    hip_swing = t.hip_swing as float[]
    hip_low_block = calloc(FIGURES, 8)
    hip_high_block = calloc(FIGURES, 8)
    hip_low = hip_low_block as float[]
    hip_high = hip_high_block as float[]
    k = 0
    while k < FIGURES {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 5.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        rigs[k] = rig as ptr
        physics.ragdoll_dress(r, rig)
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        if k != 1 { motion.set_writhing(m, WRITHE) }
        if k == 0 {
            // The left upper arm's way in the reference pose, against the
            // way the reference faces.
            h = physics.ragdoll_human(r)
            arm_rest = core.quat_apply(human.bone_at(h, human.BONE_UPPER_ARM_L).reference_frame.q,
                                       physics.ragdoll_bone_axis(r, human.BONE_UPPER_ARM_L))
            ahead = physics.ragdoll_rest_forward(r)
            t.at_rest = core.v3_dot(arm_rest, core.v3_normalize(core.vec3(ahead.x, 0.0, ahead.z)))
        }
        motions[k] = m as ptr
        landed[k] = 0.0 - 1.0
        hip_low[k] = 10.0
        hip_high[k] = 0.0 - 10.0
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    // Down, each of them, by a shove no balance holds: from in front, onto
    // their backs (they face -z), the last from behind, onto its face.
    k = 0
    while k < FIGURES {
        m = motions[k] as *Motion
        chest = bone_at(m, human.BONE_SPINE_03)
        shove = core.vec3(0.0, 0.0, 3.25)
        if k == 3 { shove = core.vec3(0.0, 0.0, 0.0 - 3.25) }
        motion.hit(m, human.BONE_SPINE_03, chest, core.v3_mul(shove, physics.ragdoll_mass(m.ragdoll)))
        k = k + 1
    }

    samples_block = calloc(FIGURES, 8)
    samples = samples_block as int[]
    struck = false
    writher = motions[0] as *Motion
    face_down = motions[3] as *Motion
    landed_at = core.vec3(0.0, 0.0, 0.0)
    down_at = core.vec3(0.0, 0.0, 0.0)
    twin_at = core.vec3(0.0, 0.0, 0.0)
    t.stopped_at = 0.0 - 1.0
    t.settled_after = 0.0 - 1.0
    t.right_aimed = false
    t.drift = 0.0
    t.down_drift = 0.0
    t.twin_drift = 0.0
    seconds = 0.0
    step = 0
    while step < 60 * 12 {
        engine.engine_update(e, STEP)
        seconds = seconds + STEP
        k = 0
        while k < FIGURES {
            m = motions[k] as *Motion
            if landed[k] < 0.0 && motion.lying(m) {
                landed[k] = seconds
                if k == 1 { twin_at = bone_at(m, human.BONE_PELVIS) }
                if motion.face_up(m) { (t.face_up as int[])[k] = 1 } else { (t.face_up as int[])[k] = 0 }
                // Down, the third is struck on its right forearm: a light
                // blow, enough to be the wound.
                if k == 2 && !struck {
                    fore = bone_at(m, human.BONE_LOWER_ARM_R)
                    motion.hit(m, human.BONE_LOWER_ARM_R, fore, core.vec3(0.0, 5.0, 0.0))
                    struck = true
                }
            }
            k = k + 1
        }
        // From half a second to two and a half after each lands, once the
        // landing has died down: how far its hip bends and straightens,
        // and where its hands are.
        k = 0
        while k < FIGURES {
            m = motions[k] as *Motion
            if landed[k] >= 0.0 && seconds - landed[k] > 0.5 && seconds - landed[k] < 2.5 {
                // The leg: at the hip face up, at the knee face down.
                hip = leg_cos(m, (t.face_up as int[])[k] == 0)
                if hip < hip_low[k] { hip_low[k] = hip }
                if hip > hip_high[k] { hip_high[k] = hip }
                arm_way = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_UPPER_ARM_L),
                                          physics.ragdoll_bone_axis(m.ragdoll, human.BONE_UPPER_ARM_L))
                fold[k] = fold[k] + core.v3_dot(arm_way, chest_front(m))
                samples[k] = samples[k] + 1

                if k == 2 && motion.writhing(m) &&
                   (physics.ragdoll_is_aimed(m.ragdoll, human.BONE_UPPER_ARM_R) ||
                    physics.ragdoll_is_aimed(m.ragdoll, human.BONE_LOWER_ARM_R)) {
                    t.right_aimed = true
                }
            }
            k = k + 1
        }
        if landed[1] >= 0.0 && seconds - landed[1] < WRITHE {
            q = bone_at(motions[1] as *Motion, human.BONE_PELVIS)
            twin_level = apart(core.vec3(q.x, 0.0, q.z), core.vec3(twin_at.x, 0.0, twin_at.z))
            if twin_level > t.twin_drift { t.twin_drift = twin_level }
        }
        if landed[3] >= 0.0 {
            if seconds - landed[3] < 1.5 {
                down_at = bone_at(face_down, human.BONE_PELVIS)
            } else if motion.writhing(face_down) {
                p3 = bone_at(face_down, human.BONE_PELVIS)
                level3 = apart(core.vec3(p3.x, 0.0, p3.z), core.vec3(down_at.x, 0.0, down_at.z))
                if level3 > t.down_drift { t.down_drift = level3 }
            }
        }
        if landed[0] >= 0.0 {
            if seconds - landed[0] < 1.5 {
                landed_at = bone_at(writher, human.BONE_PELVIS)
            } else if motion.writhing(writher) {
                p = bone_at(writher, human.BONE_PELVIS)
                level = apart(core.vec3(p.x, 0.0, p.z), core.vec3(landed_at.x, 0.0, landed_at.z))
                if level > t.drift { t.drift = level }
            } else if t.stopped_at < 0.0 {
                t.stopped_at = seconds - landed[0]
            }
            if t.stopped_at >= 0.0 && t.settled_after < 0.0 && motion.down(writher) {
                t.settled_after = seconds - landed[0] - t.stopped_at
            }
        }
        step = step + 1
    }
    k = 0
    while k < FIGURES {
        if samples[k] > 0 {
            fold[k] = fold[k] / (samples[k] as float)
        }

        // The hip's angle at its most bent less at its straightest.
        hip_swing[k] = acos(clamp_unit(hip_low[k])) - acos(clamp_unit(hip_high[k]))
        k = k + 1
    }
    t.end_pelvis = bone_at(writher, human.BONE_PELVIS)
    engine.engine_free(e)
    k = 0
    while k < FIGURES {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(motions_block)
    free(rigs_block)
    free(samples_block)
    free(hip_low_block)
    free(hip_high_block)
    free(pose)
}

// Every way a figure lands (#480): 64 writhers, shoved at the chest from
// 32 directions at 3.25 and 3.6 m/s, on one ground. Each must land, and
// in each, from half a second to two and a half after it lands, its hip
// swings over 0.25 rad, and it stops when its time is up; in at least
// DRIFT_LEAST its pelvis stays within 0.3 m from 1.5 s down to the end of
// its writhing (#691).
const ENSEMBLE = 64
const WAYS = 32
const DRIFT_LEAST = 64

struct Ensemble {
    landed: int                      // how many landed
    face_up: int                     // of them, how many face up
    least_swing: float               // the least hip swing among them
    most_drift: float                // the most pelvis drift
    held: int                        // how many drifted under 0.3 m
    late: int                        // how many did not stop on time
}

run_ensemble(out: *Ensemble) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    motions_block = calloc(ENSEMBLE, 8)
    motions = motions_block as ptr[]
    rigs_block = calloc(ENSEMBLE, 8)
    rigs = rigs_block as ptr[]
    landed_block = calloc(ENSEMBLE, 8)
    landed = landed_block as float[]
    low_block = calloc(ENSEMBLE, 8)
    low = low_block as float[]
    high_block = calloc(ENSEMBLE, 8)
    high = high_block as float[]
    knee_low_block = calloc(ENSEMBLE, 8)
    knee_low = knee_low_block as float[]
    knee_high_block = calloc(ENSEMBLE, 8)
    knee_high = knee_high_block as float[]
    at_block = calloc(ENSEMBLE * 3, 8)
    at = at_block as float[]
    drift_block = calloc(ENSEMBLE, 8)
    drift = drift_block as float[]
    stopped_block = calloc(ENSEMBLE, 8)
    stopped = stopped_block as float[]
    up_block = calloc(ENSEMBLE, 4)
    up = up_block as int[]
    k = 0
    while k < ENSEMBLE {
        r = physics.ragdoll(e, "Figure", core.vec3(((k % 8) as float) * 5.0, 0.02, ((k / 8) as float) * 5.0), 8.0, 8.0, 1.0)
        rig = humanoid_rig()
        rigs[k] = rig as ptr
        physics.ragdoll_dress(r, rig)
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        motion.set_writhing(m, WRITHE)
        motions[k] = m as ptr
        landed[k] = 0.0 - 1.0
        stopped[k] = 0.0 - 1.0
        low[k] = 10.0
        high[k] = 0.0 - 10.0
        knee_low[k] = 10.0
        knee_high[k] = 0.0 - 10.0
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    k = 0
    while k < ENSEMBLE {
        m = motions[k] as *Motion
        way = ((k % WAYS) as float) * 6.283185307179586 / (WAYS as float)
        blow = 3.25 * physics.ragdoll_mass(m.ragdoll)
        if k >= WAYS { blow = 3.6 * physics.ragdoll_mass(m.ragdoll) }
        chest = bone_at(m, human.BONE_SPINE_03)
        motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(core.sin_of(way) * blow, 0.0, core.cos_of(way) * blow))
        k = k + 1
    }
    seconds = 0.0
    step = 0
    while step < 60 * 10 {
        engine.engine_update(e, STEP)
        seconds = seconds + STEP
        k = 0
        while k < ENSEMBLE {
            m = motions[k] as *Motion
            if landed[k] < 0.0 && motion.lying(m) {
                landed[k] = seconds
                if motion.face_up(m) { up[k] = 1 }
            }
            if landed[k] >= 0.0 {
                since = seconds - landed[k]
                if since > 0.5 && since < 2.5 {
                    // The hip and the knee both: lying on its side, a
                    // writher counts face up or face down from one moment
                    // to the next, and its legs move at either.
                    hip = leg_cos(m, false)
                    if hip < low[k] { low[k] = hip }
                    if hip > high[k] { high[k] = hip }
                    knee = leg_cos(m, true)
                    if knee < knee_low[k] { knee_low[k] = knee }
                    if knee > knee_high[k] { knee_high[k] = knee }
                }
                if since < 1.5 {
                    p = bone_at(m, human.BONE_PELVIS)
                    at[k * 3] = p.x
                    at[k * 3 + 2] = p.z
                } else if motion.writhing(m) {
                    p = bone_at(m, human.BONE_PELVIS)
                    level = core.v3_len(core.vec3(p.x - at[k * 3], 0.0, p.z - at[k * 3 + 2]))
                    if level > drift[k] { drift[k] = level }
                } else if stopped[k] < 0.0 {
                    stopped[k] = since
                }
            }
            k = k + 1
        }
        step = step + 1
    }
    out.landed = 0
    out.face_up = 0
    out.least_swing = 10.0
    out.most_drift = 0.0
    out.held = 0
    out.late = 0
    k = 0
    while k < ENSEMBLE {
        if landed[k] >= 0.0 {
            out.landed = out.landed + 1
            out.face_up = out.face_up + up[k]
            swing = acos(clamp_unit(low[k])) - acos(clamp_unit(high[k]))
            knee_swing = acos(clamp_unit(knee_low[k])) - acos(clamp_unit(knee_high[k]))
            if knee_swing > swing { swing = knee_swing }
            if swing < out.least_swing { out.least_swing = swing }
            if drift[k] > out.most_drift { out.most_drift = drift[k] }
            if drift[k] < 0.3 { out.held = out.held + 1 }
            if stopped[k] < WRITHE - 0.1 || stopped[k] > WRITHE + 0.1 { out.late = out.late + 1 }
            println("    shove ${k}: landed at ${landed[k]} s, face up ${up[k]}, leg swing ${swing} rad, drift ${drift[k]} m, stopped ${stopped[k]} s")
        }
        k = k + 1
    }
    engine.engine_free(e)
    k = 0
    while k < ENSEMBLE {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(motions_block)
    free(rigs_block)
    free(landed_block)
    free(low_block)
    free(high_block)
    free(knee_low_block)
    free(knee_high_block)
    free(at_block)
    free(drift_block)
    free(stopped_block)
    free(up_block)
}

trial_new() -> *Trial {
    t = calloc(1, sizeof(Trial)) as *Trial
    t.landed = calloc(FIGURES, 8)
    t.hip_swing = calloc(FIGURES, 8)
    t.fold = calloc(FIGURES, 8)
    t.face_up = calloc(FIGURES, 8)

    return t
}

trial_free(t: *Trial) {
    free(t.landed)
    free(t.hip_swing)
    free(t.fold)
    free(t.face_up)

    free(t as ptr)
}

main() {
    a = trial_new()
    run_trial(a)
    landed = a.landed as float[]
    swing = a.hip_swing as float[]
    fold = a.fold as float[]
    up = a.face_up as int[]
    println("  landed after ${landed[0]} s writhing, ${landed[1]} s still, ${landed[2]} s struck, ${landed[3]} s writhing face down; face up: ${up[0]}, ${up[1]}, ${up[2]}, ${up[3]}")
    println("  the left leg's swing, 0.5-2.5 s down: ${swing[0]} rad writhing (the hip), ${swing[3]} face down (the knee), ${swing[1]} still")
    println("  the left upper arm toward the chest's front (cosine): ${fold[0]} writhing, ${fold[2]} struck on the right forearm, ${a.at_rest} at rest, ${fold[1]} the still twin")
    println("  pelvis drift from 1.5 s down while writhing ${a.drift} m (face down ${a.down_drift}), the still twin's over 3 s ${a.twin_drift} m; stopped ${a.stopped_at} s after landing, down ${a.settled_after} s after that")

    check("all four are knocked down, three onto their backs and one onto its face", landed[0] >= 0.0 && landed[1] >= 0.0 && landed[2] >= 0.0 && landed[3] >= 0.0 && up[0] == 1 && up[2] == 1 && up[3] == 0)
    check("writhing moves the legs, face up and face down: the hip, or face down the knee, swings over 0.25 rad, the still twin's hardly", swing[0] > 0.25 && swing[3] > 0.25 && swing[1] < 0.1)
    check("its arms fold over its front", fold[0] > a.at_rest + 0.3)
    check("it writhes where it lies, face up or down", a.drift < 0.3 && a.down_drift < 0.3)
    check("it stops when its time is up", a.stopped_at > WRITHE - 0.1 && a.stopped_at < WRITHE + 0.1)
    check("and then settles", a.settled_after >= 0.0 && a.settled_after < 2.0)
    check("struck on the right forearm, it folds the left arm", fold[2] > a.at_rest + 0.3)
    check("and the struck arm is left alone", !a.right_aimed)

    b = trial_new()
    run_trial(b)
    same = a.end_pelvis.x == b.end_pelvis.x && a.end_pelvis.y == b.end_pelvis.y && a.end_pelvis.z == b.end_pelvis.z
    println("  pelvis at the end (${a.end_pelvis.x}, ${a.end_pelvis.y}, ${a.end_pelvis.z}) and again (${b.end_pelvis.x}, ${b.end_pelvis.y}, ${b.end_pelvis.z})")
    check("the same run twice ends bit for bit the same", same)
    trial_free(a)
    trial_free(b)

    // Every way a figure lands (#480).
    en = Ensemble { landed: 0, face_up: 0, least_swing: 0.0, most_drift: 0.0, held: 0, late: 0 }
    run_ensemble(&en)
    println("  shoved from ${WAYS} ways at 3.25 and 3.6 m/s: ${en.landed} of ${ENSEMBLE} landed, ${en.face_up} face up; the least leg swing ${en.least_swing} rad, the most drift ${en.most_drift} m, under 0.3 m in ${en.held}, ${en.late} not stopped on time")
    check("from every way, every figure lands and writhes: its hip, or face down its knee, swings over 0.25 rad, it stops on time", en.landed == ENSEMBLE && en.least_swing > 0.25 && en.late == 0)
    check("and writhes where it lies, drifting under 0.3 m, in at least ${DRIFT_LEAST} (#691)", en.held >= DRIFT_LEAST)

    if g_failures == 0 {
        println("test_writhe: all checks passed (${g_checks})")
        return
    }
    println("test_writhe: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
