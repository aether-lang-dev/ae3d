// Writhing on the ground (#414), held to numbers. POWERED figures knocked
// down by a shove at the chest, one writhing for three seconds once it
// lands and a twin lying still; a third struck on the right forearm once
// down. No window: the engine is stepped by hand.
//
//   - writhing moves the legs: the left hip bends and straightens through
//     more than half a radian, where the still twin's hardly moves;
//   - its arms fold over its front: the upper arm points the way the
//     chest faces, a cosine of 0.3 more than the still twin's does (the
//     reference ragdoll's shoulders and elbows turn too little for a hand
//     to reach its own chest, so the fold is what is measured);
//   - it writhes where it lies: face down it may roll onto its back, and
//     once it has, the pelvis moves little;
//   - it stops when its time is up, and then settles, so a get-up counts
//     from there;
//   - a figure struck on the right forearm folds its left arm, and the
//     struck arm is left alone;
//   - it is deterministic: the same run twice ends bit for bit the same.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const WRITHE = 3.0

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is. It faces
// -z: its toes point there.
humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// What a trial measured, per figure: 0 writhing, 1 still, 2 struck on the
// forearm.
struct Trial {
    landed: ptr            // float[3]: seconds from the shove to lying; -1 never
    hip_swing: ptr         // float[3]: radians the left hip's angle ranged over, 0.5-2.5 s down
    fold: ptr              // float[3]: how far the left upper arm points the way the chest faces (mean cosine), 0.5-2.5 s down
    drift: float           // metres the writher's pelvis moved, level, from 1.5 s down to the end of writhing
    twin_drift: float      // and the still twin's, over the same three seconds
    stopped_at: float      // seconds after landing it stopped writhing; -1 never
    settled_after: float   // seconds after it stopped that it was down; -1 never
    right_aimed: bool      // the struck figure's right arm was aimed while it writhed
    end_pelvis: Vec3       // the writher's pelvis at the end
}

bone_at(m: *Motion, index: int) -> Vec3 {
    return behaviour.object_position(physics.ragdoll_bone(m.ragdoll, index))
}

// A hand: its forearm's far end.
hand(m: *Motion, forearm: int, pose: ptr) -> Vec3 {
    physics.ragdoll_body_pose(m.ragdoll, pose)
    return physics.ragdoll_pose_end(m.ragdoll, pose, forearm)
}

// The way the chest faces: the figure's front standing, turned as the
// chest is turned from standing.
chest_front(m: *Motion) -> Vec3 {
    rest = human.bone_at(physics.ragdoll_human(m.ragdoll), human.BONE_SPINE_03).reference_frame.q
    turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_SPINE_03), core.quat_conjugate(rest))
    ahead = physics.ragdoll_rest_forward(m.ragdoll)
    return core.quat_apply(turned, core.v3_normalize(core.vec3(ahead.x, 0.0, ahead.z)))
}

apart(a: Vec3, b: Vec3) -> float { return core.v3_len(core.v3_sub(a, b)) }

clamp_unit(x: float) -> float {
    if x > 1.0 { return 1.0 }
    if x < 0.0 - 1.0 { return 0.0 - 1.0 }
    return x
}

run_trial(t: *Trial) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))

    pose = calloc(human.BONE_COUNT * physics.POSE_STRIDE, 8)
    motions_block = calloc(3, 8)
    motions = motions_block as ptr[]
    landed = t.landed as float[]
    fold = t.fold as float[]
    hip_swing = t.hip_swing as float[]
    hip_low_block = calloc(3, 8)
    hip_high_block = calloc(3, 8)
    hip_low = hip_low_block as float[]
    hip_high = hip_high_block as float[]
    k = 0
    while k < 3 {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 5.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        physics.ragdoll_dress(r, humanoid_rig())
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        if k != 1 { motion.set_writhing(m, WRITHE) }
        motions[k] = m as ptr
        landed[k] = 0.0 - 1.0
        hip_low[k] = 10.0
        hip_high[k] = 0.0 - 10.0
        k = k + 1
    }
    step = 0
    while step < 60 {
        engine.engine_update(e, STEP)
        step = step + 1
    }
    // Down, each of them, by a shove from behind no balance holds.
    k = 0
    while k < 3 {
        m = motions[k] as *Motion
        chest = bone_at(m, human.BONE_SPINE_03)
        motion.hit(m, human.BONE_SPINE_03, chest, core.vec3(0.0, 0.0, 0.0 - 450.0))
        k = k + 1
    }

    samples = 0
    struck = false
    writher = motions[0] as *Motion
    landed_at = core.vec3(0.0, 0.0, 0.0)
    twin_at = core.vec3(0.0, 0.0, 0.0)
    t.stopped_at = 0.0 - 1.0
    t.settled_after = 0.0 - 1.0
    t.right_aimed = false
    t.drift = 0.0
    t.twin_drift = 0.0
    seconds = 0.0
    step = 0
    while step < 60 * 12 {
        engine.engine_update(e, STEP)
        seconds = seconds + STEP
        k = 0
        while k < 3 {
            m = motions[k] as *Motion
            if landed[k] < 0.0 && motion.lying(m) {
                landed[k] = seconds
                if k == 1 { twin_at = bone_at(m, human.BONE_PELVIS) }
                // Down, the third is struck on its right forearm: a light
                // blow, enough to be the wound.
                if k == 2 && !struck {
                    fore = bone_at(m, human.BONE_LOWER_ARM_R)
                    motion.hit(m, human.BONE_LOWER_ARM_R, fore, core.vec3(0.0, 5.0, 0.0))
                    struck = true
                }
            }
            k = k + 1
        }
        // From half a second to two and a half after each lands, once the
        // landing has died down: how far its hip bends and straightens,
        // and where its hands are.
        k = 0
        while k < 3 {
            m = motions[k] as *Motion
            if landed[k] >= 0.0 && seconds - landed[k] > 0.5 && seconds - landed[k] < 2.5 {
                // The hip: the thigh's length against the body's, pelvis
                // to chest.
                pelvis = bone_at(m, human.BONE_PELVIS)
                body_down = core.v3_normalize(core.v3_sub(pelvis, bone_at(m, human.BONE_SPINE_03)))
                thigh_way = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_THIGH_L),
                                            physics.ragdoll_bone_axis(m.ragdoll, human.BONE_THIGH_L))
                hip = core.v3_dot(thigh_way, body_down)
                if hip < hip_low[k] { hip_low[k] = hip }
                if hip > hip_high[k] { hip_high[k] = hip }
                arm_way = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_UPPER_ARM_L),
                                          physics.ragdoll_bone_axis(m.ragdoll, human.BONE_UPPER_ARM_L))
                fold[k] = fold[k] + core.v3_dot(arm_way, chest_front(m))
                if k == 0 { samples = samples + 1 }
                if k == 2 && motion.writhing(m) &&
                   (physics.ragdoll_is_aimed(m.ragdoll, human.BONE_UPPER_ARM_R) ||
                    physics.ragdoll_is_aimed(m.ragdoll, human.BONE_LOWER_ARM_R)) {
                    t.right_aimed = true
                }
            }
            k = k + 1
        }
        if landed[1] >= 0.0 && seconds - landed[1] < WRITHE {
            q = bone_at(motions[1] as *Motion, human.BONE_PELVIS)
            twin_level = apart(core.vec3(q.x, 0.0, q.z), core.vec3(twin_at.x, 0.0, twin_at.z))
            if twin_level > t.twin_drift { t.twin_drift = twin_level }
        }
        if landed[0] >= 0.0 {
            if seconds - landed[0] < 1.5 {
                landed_at = bone_at(writher, human.BONE_PELVIS)
            } else if motion.writhing(writher) {
                p = bone_at(writher, human.BONE_PELVIS)
                level = apart(core.vec3(p.x, 0.0, p.z), core.vec3(landed_at.x, 0.0, landed_at.z))
                if level > t.drift { t.drift = level }
            } else if t.stopped_at < 0.0 {
                t.stopped_at = seconds - landed[0]
            }
            if t.stopped_at >= 0.0 && t.settled_after < 0.0 && motion.down(writher) {
                t.settled_after = seconds - landed[0] - t.stopped_at
            }
        }
        step = step + 1
    }
    k = 0
    while k < 3 {
        if samples > 0 {
            fold[k] = fold[k] / (samples as float)
        }
        // The hip's angle at its most bent less at its straightest.
        hip_swing[k] = acos(clamp_unit(hip_low[k])) - acos(clamp_unit(hip_high[k]))
        k = k + 1
    }
    t.end_pelvis = bone_at(writher, human.BONE_PELVIS)
    k = 0
    while k < 3 {
        motion.motion_free(motions[k] as *Motion)
        k = k + 1
    }
    free(motions_block)
    free(hip_low_block)
    free(hip_high_block)
    free(pose)
    engine.engine_free(e)
}

trial_new() -> *Trial {
    t = calloc(1, sizeof(Trial)) as *Trial
    t.landed = calloc(3, 8)
    t.hip_swing = calloc(3, 8)
    t.fold = calloc(3, 8)
    return t
}

trial_free(t: *Trial) {
    free(t.landed)
    free(t.hip_swing)
    free(t.fold)
    free(t as ptr)
}

main() {
    a = trial_new()
    run_trial(a)
    landed = a.landed as float[]
    swing = a.hip_swing as float[]
    fold = a.fold as float[]
    println("  landed after ${landed[0]} s writhing, ${landed[1]} s still, ${landed[2]} s struck")
    println("  the left hip's swing, 0.5-2.5 s down: ${swing[0]} rad writhing, ${swing[1]} rad still")
    println("  the left upper arm toward the chest's front (cosine): ${fold[0]} writhing, ${fold[1]} still, ${fold[2]} struck on the right forearm")
    println("  pelvis drift from 1.5 s down while writhing ${a.drift} m, the still twin's over 3 s ${a.twin_drift} m; stopped ${a.stopped_at} s after landing, down ${a.settled_after} s after that")

    check("all three are knocked down", landed[0] >= 0.0 && landed[1] >= 0.0 && landed[2] >= 0.0)
    check("writhing moves the legs: the hip swings over half a radian, the still twin's hardly", swing[0] > 0.5 && swing[1] < 0.1)
    check("its arms fold over its front", fold[0] > fold[1] + 0.3)
    check("it writhes where it lies", a.drift < 0.3)
    check("it stops when its time is up", a.stopped_at > WRITHE - 0.1 && a.stopped_at < WRITHE + 0.1)
    check("and then settles", a.settled_after >= 0.0 && a.settled_after < 2.0)
    check("struck on the right forearm, it folds the left arm", fold[2] > fold[1] + 0.3)
    check("and the struck arm is left alone", !a.right_aimed)

    b = trial_new()
    run_trial(b)
    same = a.end_pelvis.x == b.end_pelvis.x && a.end_pelvis.y == b.end_pelvis.y && a.end_pelvis.z == b.end_pelvis.z
    println("  pelvis at the end (${a.end_pelvis.x}, ${a.end_pelvis.y}, ${a.end_pelvis.z}) and again (${b.end_pelvis.x}, ${b.end_pelvis.y}, ${b.end_pelvis.z})")
    check("the same run twice ends bit for bit the same", same)
    trial_free(a)
    trial_free(b)

    if g_failures == 0 {
        println("test_writhe: all checks passed (${g_checks})")
        return
    }
    println("test_writhe: ${g_failures} failure(s) of ${g_checks}")
}
