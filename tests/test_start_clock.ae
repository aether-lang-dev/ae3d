// A start played by the distance come (#937), with nothing keeping the
// figure to the take's pace: the UE5 mannequin on its 100STYLE gaits, its
// mover's start pace off (mover.set_start_pace 0), as a game's own mover or
// a graph file drives a figure. Stood a second, then asked to walk off
// ahead (1.2 m/s), to run off ahead (2.6 m/s) and to walk back (1.2 m/s,
// behind it), metered for 3 s from the go:
//   - the start's clock plays within a person's range of its own pace
//     (animator's CLOCK_MOST), however fast the figure goes;
//   - no joint turns faster than the takes' own fastest plus what the
//     easing of the transitions taken needs (animator.transition_need);
//   - no toe skates 5 mm.
// Clocked by the distance alone, a start raced up to 25 times real time,
// and its switch into the gait inertialized from the race (57.7 rad/s on
// Siltreach's figure).
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.character
import ae3d.metrics
import ae3d.physics
import ae3d.mover

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(o: *GameObject) -> Vec3 {
    q = behaviour.object_rotation(o)
    f = core.quat_apply(q, core.vec3(0.0, 0.0, 1.0))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

main() {
    println("start_clock: a start played by the distance come, its figure not kept to its pace (#937)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Starter", MANNEQUIN, g)
    check("the mannequin made a person: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    o = character.object_of(c)
    r = animator.rig(a)
    mover.set_start_pace(character.mover_of(c), 0.0)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    own = metrics.animator_fastest(a)
    speeds = [1.2, 2.6, 1.2]
    ways = [0.0, 0.0, 3.1415926]
    names = ["walked off", "run off", "walked back"]
    worst_ratio = 0.0
    worst_rate = 0.0
    worst_skate = 0.0
    k = 0
    while k < 3 {
        n = 0
        while n < 600 && !character.standing(c) {
            character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
            engine.engine_update(e, STEP)
            n = n + 1
        }
        n = 0
        while n < 60 {
            character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
            engine.engine_update(e, STEP)
            n = n + 1
        }
        f = facing(o)
        yaw = core.atan2_of(f.x, f.z) + ways[k]
        asked = core.vec3(speeds[k] * core.sin_of(yaw), 0.0, speeds[k] * core.cos_of(yaw))
        metrics.meter_moved(m)
        metrics.meter_reset(m)
        ease = 0.0
        rate = 0.0
        was_state = 0 - 1
        was_time = 0.0
        n = 0
        while n < 180 {
            character.move(c, asked, core.vec3(0.0, 0.0, 0.0))
            engine.engine_update(e, STEP)
            metrics.meter_take(m, STEP)
            if animator.transitioning(a) && animator.transition_need(a) > ease { ease = animator.transition_need(a) }
            now = animator.current(a)
            if now == was_state && string_is(animator.state_name(a, now), "start") {
                played = (animator.state_time(a) - was_time) / STEP
                if played > rate { rate = played }
            }
            was_state = now
            was_time = animator.state_time(a)
            n = n + 1
        }
        ratio = metrics.meter_worst(m, metrics.POP) / (own + ease)
        if metrics.meter_worst(m, metrics.SKATE) > worst_skate { worst_skate = metrics.meter_worst(m, metrics.SKATE) }
        if ratio > worst_ratio { worst_ratio = ratio }
        if rate > worst_rate { worst_rate = rate }
        println("  ${names[k]} at ${speeds[k]} m/s: the start played at ${rate} times real time at most; the fastest joint ${metrics.meter_worst(m, metrics.POP)} rad/s (${pose.name(r, metrics.meter_joint(m, metrics.POP))} at ${metrics.meter_when(m, metrics.POP)} s), ${ratio * 100.0}% of the takes' own ${own} plus the easing's ${ease}")
        n = 0
        while n < 60 {
            character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
            engine.engine_update(e, STEP)
            n = n + 1
        }
        k = k + 1
    }
    check("walked off, run off and walked back, the start plays within a person's range of its pace (1.5 times real time at most)", worst_rate <= 1.5 + 0.0001)
    check("and no joint turns faster than the takes' own fastest plus what the easing needs", worst_ratio <= 1.0)
    println("  a toe skating ${worst_skate * 1000.0} mm at worst through the three")
    check("and no toe skates 5 mm", worst_skate < 0.005)
    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures > 0 {
        println("start_clock: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("start_clock: all checks passed (${g_checks})")
}

string_is(a: string, b: string) -> bool { return string.equals(a, b) == 1 }
