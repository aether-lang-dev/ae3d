// Inverse kinematics and constraints (#857, layer 3 of #853) held to what a
// player sees, on the Rigify-named Quaternius mannequin and its authored
// clips. No window; the engine stepped by hand at 60 Hz.
//
//   - limits: walking, jogging and crouching with the feet locked, and
//     limbs asked to fold past their joints (a hand at its own shoulder, a
//     foot at its hip): no knee or elbow bends past its most, no knee ever
//     bends backward, and a limb asked too far reaches as far as its joint
//     lets it;
//   - twist: a hand turned 90 degrees about its forearm on its grip ends
//     turned so, within half a degree and 5 mm, and the forearm takes half
//     the turn (a forearm's pronation is the forearm's), the wrist the rest;
//   - chains: a FABRIK chain up the spine to the head reaches a point a
//     bow away within 1 mm, every bone its length within a hundredth of a
//     millimetre, no joint past its cone; asked a bow its cones do not
//     allow, it goes as far as they let;
//   - the whole body: a hand reaching 15 cm past its arm's length leans the
//     spine and moves the hips until it is there, within 5 mm, the feet held
//     within 1 mm of where they stood; at half weight it goes half way;
//   - aim: a rifle held on the chest, aimed 40 degrees right and 15 up at a
//     point 10 m off, held bladed (the barrel across the chest): its barrel
//     within a degree of the point, each hand within 5 mm of its grip, no
//     elbow past its limit, and the forearm reaching across to the
//     fore-end kept clear of the trunk.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig

extern exit(code: int)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
// Of the walk's stride, the steps up and down the 20 degree ramp: a 36% grade,
// a steep trail's, where people step short. At the walk's own stride the
// trailing leg, straight at its push-off up the slope, left its toe 16 mm
// off it.
const SLOPE_STRIDE = 0.7

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

fresh() -> *Engine {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    return e
}

// The figure's forward over the ground, from its heels to its toes at rest.
forward_of(r: *pose.Rig) -> Vec3 {
    w = pose.new(r)
    pose.rest_world(r, w)
    a = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L)))
    b = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.BALL_L)))
    pose.release(w)
    return core.v3_normalize(core.vec3(b.x - a.x, 0.0, b.z - a.z))
}

// The shortest distance between segments a0-a1 and b0-b1.
segment_gap(a0: Vec3, a1: Vec3, b0: Vec3, b1: Vec3) -> float {
    best = 1000000.0
    k = 0
    while k <= 20 {
        p = core.v3_lerp(a0, a1, (k as float) / 20.0)
        d = point_segment(p, b0, b1)
        if d < best { best = d }
        q = core.v3_lerp(b0, b1, (k as float) / 20.0)
        d2 = point_segment(q, a0, a1)
        if d2 < best { best = d2 }
        k = k + 1
    }
    return best
}

point_segment(p: Vec3, a: Vec3, b: Vec3) -> float {
    ab = core.v3_sub(b, a)
    t = 0.0
    if core.v3_dot(ab, ab) > 0.0 { t = core.clampf(core.v3_dot(core.v3_sub(p, a), ab) / core.v3_dot(ab, ab), 0.0, 1.0) }
    return core.v3_len(core.v3_sub(p, core.v3_add(a, core.v3_mul(ab, t))))
}

// --- limits -------------------------------------------------------------------------------------

limits() {
    takes = ["Walk_Loop", "Jog_Fwd_Loop", "Crouch_Idle_Loop", "Idle_Loop"]
    worst_knee = 0.0
    worst_elbow = 0.0
    most_back = 0.0
    t = 0
    while t < 4 {
        e = fresh()
        o = figure.figure(e, "Person", RIGIFY)
        a = animator.attach(e, o)
        r = animator.rig(a)
        take = animator.take(a, takes[t], false)
        s = animator.add_state(a, takes[t], take, true)
        animator.play(a, s, 0.0)
        f = ikrig.feet_new(r, o)
        animator.set_feet(a, f)
        h = ikrig.hands_new(r)
        animator.set_hands(a, h)
        ahead = forward_of(r)
        limbs = [ikrig.leg_limb(r, 0), ikrig.leg_limb(r, 1), ikrig.arm_limb(r, 0), ikrig.arm_limb(r, 1)]
        w = pose.new(r)
        at = core.vec3(0.0, 0.0, 0.0)
        k = 0
        while k < 150 {
            if t < 2 {
                at = core.v3_add(at, core.v3_mul(ahead, clips.speed(take) * STEP))
                behaviour.object_set_position(o, at)
            }
            // The hands on a bowl at the belly while it goes.
            middle = core.v3_add(core.v3_add(at, core.v3_mul(ahead, 0.3)), core.vec3(0.0, 0.95, 0.0))
            side = core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead)
            ikrig.hands_set(h, 0, core.v3_add(middle, core.v3_mul(side, 0.13)), 1.0)
            ikrig.hands_set(h, 1, core.v3_sub(middle, core.v3_mul(side, 0.13)), 1.0)
            engine.engine_update(e, STEP)
            pose.world(r, animator.pose_now(a), w)
            n = 0
            while n < 4 {
                bend = ikrig.limb_bend(limbs[n], w)
                if n < 2 {
                    if bend > worst_knee { worst_knee = bend }
                    back = 0.0 - ikrig.limb_side(limbs[n], w)
                    if back > most_back { most_back = back }
                } else if bend > worst_elbow { worst_elbow = bend }
                n = n + 1
            }
            k = k + 1
        }
        n = 0
        while n < 4 {
            ikrig.limb_free(limbs[n])
            n = n + 1
        }
        pose.release(w)
        animator.animator_free(a)
        figure.figures_free(e)
        engine.engine_free(e)
        t = t + 1
    }
    println("  walk, jog, crouch and idle, feet locked and hands on a bowl: knees bent ${worst_knee * 57.29578} degrees at most, elbows ${worst_elbow * 57.29578}; a knee ${most_back * 1000.0} mm behind straight at worst")
    check("no knee or elbow bends past its most through walk, jog, crouch and idle", worst_knee <= ikrig.KNEE_MOST + 0.001 && worst_elbow <= ikrig.ELBOW_MOST + 0.001)
    check("and no knee bends backward (its knee never 1 mm behind the line from hip to ankle)", most_back < 0.001)

    // Folded past the joint: a hand asked to its own shoulder, a foot to its hip.
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    engine.engine_update(e, STEP)
    w = pose.new(r)
    p = pose.new(r)
    pose.copy(r, animator.pose_now(a), p)
    pose.world(r, p, w)
    arm = ikrig.arm_limb(r, 1)
    leg = ikrig.leg_limb(r, 0)
    reached_arm = ikrig.limb_solve(arm, r, p, w, core.v3_lerp(pose.translation(w, arm.upper), pose.translation(w, arm.middle), 0.1), pose.rotation(w, arm.end))
    reached_leg = ikrig.limb_solve(leg, r, p, w, core.v3_lerp(pose.translation(w, leg.upper), pose.translation(w, leg.middle), 0.1), pose.rotation(w, leg.end))
    pose.world(r, p, w)
    elbow = ikrig.limb_bend(arm, w)
    knee = ikrig.limb_bend(leg, w)
    println("  a hand asked to its own shoulder: its elbow bent ${elbow * 57.29578} degrees (its most ${ikrig.ELBOW_MOST * 57.29578}); a foot at its hip: the knee ${knee * 57.29578}")
    check("a limb asked to fold past its joint stops at its most, and says it did not reach", !reached_arm && !reached_leg && core.abs_of(elbow - ikrig.ELBOW_MOST) < 0.002 && core.abs_of(knee - ikrig.KNEE_MOST) < 0.002)
    ikrig.limb_free(arm)
    ikrig.limb_free(leg)
    pose.release(w)
    pose.release(p)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- twist --------------------------------------------------------------------------------------

twist() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    idle = animator.take(a, "Idle_Loop", false)
    s = animator.add_state(a, "idle", idle, true)
    animator.play(a, s, 0.0)
    engine.engine_update(e, STEP)
    arm = ikrig.arm_limb(r, 1)
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    grip = ikrig.to_ground(r, pose.translation(w, arm.end))
    fore = core.v3_normalize(ikrig.dir_to_ground(r, core.v3_sub(pose.translation(w, arm.end), pose.translation(w, arm.middle))))
    hand = pose.joint(r, arm.end)
    core.model_sync_transform(hand)
    wanted = core.quat_normalize(core.quat_mul(core.quat_rotate(1.5707963, fore), hand.world_rotation))
    h = ikrig.hands_new(r)
    animator.set_hands(a, h)
    ikrig.hands_set_turned(h, 1, grip, wanted, 1.0)
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    core.model_sync_transform(hand)
    off = core.v3_len(core.v3_sub(hand.world_position, grip))
    turned = turned_by(hand.world_rotation, wanted)
    // The wrist's own twist about the forearm, against the clip's.
    pose.world(r, animator.pose_now(a), w)
    wrist = ikrig.limb_end_twist(arm, w)
    alone = pose.new(r)
    clips.sample(idle, r, animator.state_time(a), true, alone)
    pose.world(r, alone, w)
    wrist_clip = ikrig.limb_end_twist(arm, w)
    share = core.abs_of(wrist - wrist_clip)
    while share > 3.141592653589793 { share = 6.283185307179586 - share }
    println("  a hand turned 90 degrees about its forearm: ${off * 1000.0} mm off its grip, ${turned * 57.29578} degrees off its turn; the wrist took ${share * 57.29578} degrees of it, the forearm the rest")
    check("a hand turned about its forearm ends on its grip (5 mm) turned so (half a degree)", off < 0.005 && turned < 0.0087)
    check("and the forearm takes half the turn, the wrist the rest (40 to 50 degrees)", share > 0.698 && share < 0.873)
    ikrig.limb_free(arm)
    pose.release(w)
    pose.release(alone)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- chains -------------------------------------------------------------------------------------

// A spine chain from the pelvis up to the head bowing it `forward` and
// `down` (metres) from the idle: how far its head ends from the point, how
// far it began, the most a bone changed its length, and the most a joint
// bent off the way the idle bent it.
bow(forward: float, down: float) -> (float, float, float, float) {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    engine.engine_update(e, STEP)
    p = pose.new(r)
    w = pose.new(r)
    before = pose.new(r)
    pose.copy(r, animator.pose_now(a), p)
    pose.world(r, p, w)
    pose.world(r, p, before)
    joints = [pose.human(r, pose.SPINE_01), pose.human(r, pose.SPINE_02), pose.human(r, pose.SPINE_03), pose.human(r, pose.NECK), pose.human(r, pose.HEAD)]
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    ahead = ikrig.dir_to_rig(r, forward_of(r))
    lower = ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))
    target = core.v3_add(pose.translation(w, joints[4]), core.v3_add(core.v3_mul(ahead, forward), core.v3_mul(lower, down)))
    began = core.v3_len(core.v3_sub(pose.translation(w, joints[4]), target)) / unit
    _left = ikrig.chain_solve(r, p, w, joints, 5, target, ikrig.SPINE_CONE)
    pose.world(r, p, w)
    reached = core.v3_len(core.v3_sub(pose.translation(w, joints[4]), target)) / unit
    stretched = 0.0
    bent = 0.0
    k = 0
    while k < 4 {
        was = core.v3_len(core.v3_sub(pose.translation(before, joints[k + 1]), pose.translation(before, joints[k])))
        now = core.v3_len(core.v3_sub(pose.translation(w, joints[k + 1]), pose.translation(w, joints[k])))
        if core.abs_of(now - was) / unit > stretched { stretched = core.abs_of(now - was) / unit }
        // Each bone's turn off the way it lay, past its parent bone's turn.
        old = core.v3_normalize(core.v3_sub(pose.translation(before, joints[k + 1]), pose.translation(before, joints[k])))
        if k > 0 {
            parent_turn = core.quat_from_to(core.v3_sub(pose.translation(before, joints[k]), pose.translation(before, joints[k - 1])),
                                            core.v3_sub(pose.translation(w, joints[k]), pose.translation(w, joints[k - 1])))
            old = core.quat_apply(parent_turn, old)
        }
        nw = core.v3_normalize(core.v3_sub(pose.translation(w, joints[k + 1]), pose.translation(w, joints[k])))
        off = core.acos_of(core.clampf(core.v3_dot(old, nw), 0.0 - 1.0, 1.0))
        if off > bent { bent = off }
        k = k + 1
    }
    pose.release(p)
    pose.release(w)
    pose.release(before)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    return reached, began, stretched, bent
}

chains() {
    reached, _began, stretched, bent = bow(0.10, 0.02)
    println("  a spine chain bowing the head 10 cm forward and 2 cm down: ${reached * 1000.0} mm off; bones ${stretched * 1000.0} mm off their lengths; ${bent * 57.29578} degrees the most a joint bent (its cone ${ikrig.SPINE_CONE * 57.29578})")
    deep, began_deep, stretched_deep, bent_deep = bow(0.15, 0.10)
    println("  bowing it 15 cm forward and 10 down, past what its cones let: ${deep * 1000.0} mm off, of ${began_deep * 1000.0}; bones ${stretched_deep * 1000.0} mm off; ${bent_deep * 57.29578} degrees the most a joint bent")
    check("a FABRIK chain up the spine reaches its point within 1 mm", reached < 0.001)
    check("and keeps every bone its length (0.01 mm) and every joint within its cone", stretched < 0.00001 && bent <= ikrig.SPINE_CONE + 0.0001)
    check("asked past its cones, it goes as far as they let (more than half way), every joint within its cone", deep < began_deep * 0.5 && stretched_deep < 0.00001 && bent_deep <= ikrig.SPINE_CONE + 0.0001)
}

// --- the whole body -----------------------------------------------------------------------------

whole_body() {
    weights = [1.0, 0.5]
    offs = [0.0, 0.0]
    feet_off = 0.0
    k = 0
    while k < 2 {
        e = fresh()
        o = figure.figure(e, "Person", RIGIFY)
        a = animator.attach(e, o)
        r = animator.rig(a)
        s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
        animator.play(a, s, 0.0)
        engine.engine_update(e, STEP)
        p = pose.new(r)
        w = pose.new(r)
        pose.copy(r, animator.pose_now(a), p)
        pose.world(r, p, w)
        b = ikrig.body_new(r)
        ikrig.body_hold_feet(b, true)
        arm = ikrig.body_limb(b, ikrig.BODY_HAND_R)
        shoulder = ikrig.to_ground(r, pose.translation(w, arm.upper))
        hand_was = ikrig.to_ground(r, pose.translation(w, arm.end))
        span = core.v3_len(core.v3_sub(pose.translation(w, arm.middle), pose.translation(w, arm.upper))) +
               core.v3_len(core.v3_sub(pose.translation(w, arm.end), pose.translation(w, arm.middle)))
        reach = span * core.v3_len(ikrig.dir_to_ground(r, core.vec3(1.0, 0.0, 0.0)))
        // Forward and a little down from the shoulder, 15 cm past the arm's length.
        way = core.v3_normalize(core.v3_add(forward_of(r), core.vec3(0.0, 0.0 - 0.3, 0.0)))
        point = core.v3_add(shoulder, core.v3_mul(way, reach + 0.15))
        feet_at = [ikrig.to_ground(r, pose.translation(w, ikrig.body_limb(b, ikrig.BODY_FOOT_L).end)),
                   ikrig.to_ground(r, pose.translation(w, ikrig.body_limb(b, ikrig.BODY_FOOT_R).end))]
        ikrig.body_set(b, ikrig.BODY_HAND_R, point, weights[k])
        ikrig.body_solve(b, r, p, w)
        pose.world(r, p, w)
        hand = ikrig.to_ground(r, pose.translation(w, arm.end))
        wanted = core.v3_lerp(hand_was, point, weights[k])
        offs[k] = core.v3_len(core.v3_sub(hand, wanted))
        n = 0
        while n < 2 {
            d = core.v3_len(core.v3_sub(ikrig.to_ground(r, pose.translation(w, ikrig.body_limb(b, ikrig.BODY_FOOT_L + n).end)), feet_at[n]))
            if d > feet_off { feet_off = d }
            n = n + 1
        }
        if k == 0 { println("  reaching 15 cm past the arm's length (${reach} m): the hand ${offs[0] * 1000.0} mm off the point") }
        ikrig.body_free(b)
        pose.release(p)
        pose.release(w)
        animator.animator_free(a)
        figure.figures_free(e)
        engine.engine_free(e)
        k = k + 1
    }
    println("  at half weight the hand ${offs[1] * 1000.0} mm off half way; the feet ${feet_off * 1000.0} mm off where they stood")
    check("a hand reaching 15 cm past its arm's length gets there (5 mm), the spine and hips leaning to it", offs[0] < 0.005)
    check("at half weight it goes half way (5 mm), and the feet stay where they stood (1 mm)", offs[1] < 0.005 && feet_off < 0.001)
}

// --- aim ----------------------------------------------------------------------------------------

rifle() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    s = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    animator.play(a, s, 0.0)
    animator.set_feet(a, ikrig.feet_new(r, o))
    h = ikrig.hands_new(r)
    animator.set_hands(a, h)
    chest = pose.human(r, pose.SPINE_03)
    shoulder = pose.human(r, pose.UPPERARM_R)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    into = core.quat_conjugate(pose.rotation(rest, chest))
    ahead = core.quat_apply(into, ikrig.dir_to_rig(r, forward_of(r)))
    down = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))))
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    // Held bladed, as a rifleman holds one: the barrel across the chest, 35
    // degrees left of its forward, so the chest faces off to the right of
    // the target and the left shoulder comes round toward the fore-end.
    // The butt against the front of the right shoulder; the grip 18 cm on
    // and 7 down, the fore-end 40 on and 4 down: all in the chest's frame.
    up = core.v3_mul(down, 0.0 - 1.0)
    across = core.v3_normalize(core.v3_add(core.v3_mul(ahead, core.cos_of(0.611)), core.v3_mul(core.v3_normalize(core.v3_cross(up, ahead)), core.sin_of(0.611))))
    butt = core.v3_add(core.quat_apply(into, core.v3_sub(pose.translation(rest, shoulder), pose.translation(rest, chest))), core.v3_mul(ahead, 0.08 * unit))
    grip = core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.18 * unit), core.v3_mul(down, 0.07 * unit)))
    fore_end = core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.40 * unit), core.v3_mul(down, 0.04 * unit)))
    pose.release(rest)
    ikrig.aim_set_line(animator.trunk_aim(a), butt, across)
    ikrig.hands_set_on(h, 1, chest, grip, 1.0)
    ikrig.hands_set_on(h, 0, chest, fore_end, 1.0)
    // 40 degrees right and 15 up, 10 m off.
    face = forward_of(r)
    right = core.v3_cross(face, core.vec3(0.0, 1.0, 0.0))
    level = core.v3_add(core.v3_mul(face, core.cos_of(0.698)), core.v3_mul(right, core.sin_of(0.698)))
    way = core.v3_add(core.v3_mul(level, core.cos_of(0.262)), core.vec3(0.0, core.sin_of(0.262), 0.0))
    target = core.v3_add(core.vec3(0.0, 1.45, 0.0), core.v3_mul(way, 10.0))
    animator.aim_at(a, target, 1.0)
    w = pose.new(r)
    arms = [ikrig.arm_limb(r, 0), ikrig.arm_limb(r, 1)]
    worst_aim = 0.0
    worst_hand = 0.0
    worst_elbow = 0.0
    closest = 1000.0
    k = 0
    while k < 150 {
        engine.engine_update(e, STEP)
        if k >= 60 {
            pose.world(r, animator.pose_now(a), w)
            from = ikrig.to_ground(r, core.v3_add(pose.translation(w, chest), core.quat_apply(pose.rotation(w, chest), butt)))
            barrel = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(pose.rotation(w, chest), across)))
            off = core.acos_of(core.clampf(core.v3_dot(barrel, core.v3_normalize(core.v3_sub(target, from))), 0.0 - 1.0, 1.0))
            if off > worst_aim { worst_aim = off }
            n = 0
            while n < 2 {
                d = core.v3_len(core.v3_sub(ikrig.to_ground(r, pose.translation(w, arms[n].end)), ikrig.hands_grip(h, r, w, n)))
                if d > worst_hand { worst_hand = d }
                bend = ikrig.limb_bend(arms[n], w)
                if bend > worst_elbow { worst_elbow = bend }
                n = n + 1
            }
            // The left forearm against the trunk's line, pelvis to chest.
            gap = segment_gap(ikrig.to_ground(r, pose.translation(w, arms[0].middle)), ikrig.to_ground(r, pose.translation(w, arms[0].end)),
                              ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.SPINE_01))), ikrig.to_ground(r, pose.translation(w, chest)))
            if gap < closest { closest = gap }
        }
        k = k + 1
    }
    println("  a rifle aimed 40 degrees right and 15 up at 10 m: the barrel ${worst_aim * 57.29578} degrees off at worst; the hands ${worst_hand * 1000.0} mm off their grips; elbows bent ${worst_elbow * 57.29578} at most; the left forearm ${closest * 100.0} cm from the trunk's line")
    check("a rifle aimed with both hands points within a degree of its target", worst_aim < 0.01745)
    check("with each hand within 5 mm of its grip and no elbow past its most", worst_hand < 0.005 && worst_elbow <= ikrig.ELBOW_MOST + 0.001)
    check("and the forearm across to the fore-end clear of the trunk (12 cm off its line)", closest > 0.12)
    ikrig.limb_free(arms[0])
    ikrig.limb_free(arms[1])
    pose.release(w)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
}

// --- stairs and slopes --------------------------------------------------------------------------

// A static box `half` (its own frame: across, up, along) at `along` metres
// on the way `ahead` from `start` and `high` up, turned to face along it and
// pitched `pitch` radians (its top rising along the way).
course_box(e: *Engine, start: Vec3, ahead: Vec3, along: float, high: float, half: Vec3, pitch: float) {
    b = engine.object(e, "Step", loader.cube(1.0))
    behaviour.object_set_position(b, core.v3_add(core.v3_add(start, core.v3_mul(ahead, along)), core.vec3(0.0, high, 0.0)))
    yaw = core.quat_rotate(core.atan2_of(ahead.x, ahead.z), core.vec3(0.0, 1.0, 0.0))
    behaviour.object_set_rotation(b, core.quat_normalize(core.quat_mul(yaw, core.quat_rotate(0.0 - pitch, core.vec3(1.0, 0.0, 0.0)))))
    physics.box_collider(b, half, physics.material(0.8, 0.0))
}

// The figure walked across a course on a capsule, with its feet on the
// ground by ikrig (`ik`) or as the clip has them, stepping `stride` of the
// walk's stride at as much of its speed: `kind` 0 a flight of `count` 0.2 m
// stairs `tread` deep up, a landing, and as many down; 1 a 20 degree ramp
// up, a top, and one down. A foot is down while its contact is on and the
// clip has its sole on its floor (its lowest point within 1 cm of it).
// Through the walk: the worst a foot down's sole stands off the ground (its
// lowest point, heel to pad to toe, over the ground under it), the worst
// any sole goes into the ground, the knees' most bend, how far it went, and
// on the ramp, where the clip has a foot flat on its floor and the ramp is
// one plane under it, the worst its heel or pad is off the height over the
// ramp the clip has it at over its floor.
walk_course(kind: int, tread: float, count: int, ik: bool, stride: float) -> (float, float, float, float, float) {
    e = fresh()
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    r = animator.rig(a)
    walk = animator.take(a, "Walk_Loop", false)
    s = animator.add_state(a, "walk", walk, true)
    animator.play(a, s, 0.0)
    ahead = forward_of(r)
    start = core.vec3(0.0, 0.0, 0.0)
    first = 1.5
    rise = 0.2
    top = 2.0
    length = 0.0
    if kind == 0 {
        // Each step a slab from the floor to its top, out to the far end of
        // the way down's step of the same height.
        up_end = first + tread * (count as float)
        down_end = up_end + top + tread * (count as float)
        k = 1
        while k <= count {
            from = first + tread * ((k - 1) as float)
            to = down_end - tread * ((k - 1) as float)
            course_box(e, start, ahead, (from + to) * 0.5, rise * (k as float) * 0.5, core.vec3(2.0, rise * (k as float) * 0.5, (to - from) * 0.5), 0.0)
            k = k + 1
        }
        length = down_end + first
    } else {
        // A 20 degree ramp 3 m long up, a top, and its mirror down: each ramp a
        // slab whose top face runs from the floor to the top.
        slope = 0.349066
        run = 3.0
        high = run * core.sin_of(slope)
        flat = run * core.cos_of(slope)
        thick = 0.25
        course_box(e, start, ahead, first + flat * 0.5 + thick * core.sin_of(slope), high * 0.5 - thick * core.cos_of(slope), core.vec3(2.0, thick, run * 0.5), slope)
        course_box(e, start, ahead, first + flat + top * 0.5, high * 0.5, core.vec3(2.0, high * 0.5, top * 0.5), 0.0)
        course_box(e, start, ahead, first + flat + top + flat * 0.5 - thick * core.sin_of(slope), high * 0.5 - thick * core.cos_of(slope), core.vec3(2.0, thick, run * 0.5), 0.0 - slope)
        length = first + flat * 2.0 + top + first
    }
    capsule = physics.character_controller(o, 0.3, 1.7)
    physics.character_set_slope_limit(capsule, 40.0)
    f = ikrig.feet_new(r, o)
    ikrig.feet_ground_physics(f, physics.of(e))
    ikrig.feet_set_stride(f, stride)
    if ik { animator.set_feet(a, f) }
    limbs = [ikrig.leg_limb(r, 0), ikrig.leg_limb(r, 1)]
    w = pose.new(r)
    alone = pose.new(r)
    w_clip = pose.new(r)
    stand_off = 0.0
    worst_lie = 0.0
    into = 0.0
    bent = 0.0
    went = 0.0
    k = 0
    while went < length && k < 4000 {
        physics.character_move(capsule, core.v3_mul(ahead, clips.speed(walk) * stride), 0.0, STEP)
        engine.engine_update(e, STEP)
        went = core.v3_dot(behaviour.object_position(o), ahead)
        if k > 30 {
            pose.world(r, animator.pose_now(a), w)
            side = 0
            while side < 2 {
                heel, pad, toe = ikrig.feet_soles(f, r, w, side)
                // The sole's lowest point over the ground under it, along heel
                // to pad to toe, and the heel's and the pad's own.
                low = sole_low(e, heel, pad, toe)
                ch = heel.y - under(e, heel)
                cp = pad.y - under(e, pad)
                if 0.0 - low > into { into = 0.0 - low }
                // A foot down: its contact on, and the clip's sole on its floor
                // (its lowest point within 1 cm of it), as the clip lifts a
                // foot a few frames before its contact ends.
                clips.sample(walk, r, animator.state_time(a), true, alone)
                pose.world(r, alone, w_clip)
                heel_c, pad_c, toe_c = ikrig.feet_soles(f, r, w_clip, side)
                level = behaviour.object_position(o).y
                clip_low = heel_c.y
                if pad_c.y < clip_low { clip_low = pad_c.y }
                if toe_c.y < clip_low { clip_low = toe_c.y }
                if animator.contact_weight(a, side) > 0.99 && clip_low - level < 0.01 {
                    off = core.abs_of(low)
                    // Where the clip has the foot flat on its floor (heel and pad
                    // within 1 cm of it) and the ramp is one plane under it: heel and
                    // pad each as high over the ramp as the clip has them over its floor.
                    clip_flat = heel_c.y - level < 0.01 && pad_c.y - level < 0.01
                    if kind == 1 && clip_flat && core.v3_dot(under_normal(e, heel), under_normal(e, pad)) > 0.9998 {
                        lie = core.abs_of(ch - (heel_c.y - level))
                        if core.abs_of(cp - (pad_c.y - level)) > lie { lie = core.abs_of(cp - (pad_c.y - level)) }
                        if lie > worst_lie { worst_lie = lie }
                    }
                    if off > stand_off { stand_off = off }
                }
                b = ikrig.limb_bend(limbs[side], w)
                if b > bent { bent = b }
                side = side + 1
            }
        }
        k = k + 1
    }
    ikrig.limb_free(limbs[0])
    ikrig.limb_free(limbs[1])
    pose.release(w)
    pose.release(alone)
    pose.release(w_clip)
    physics.character_free(capsule)
    if !ik { ikrig.feet_free(f) }
    animator.animator_free(a)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return stand_off, into, bent, went, worst_lie
}

// The lowest a sole comes over the ground under it: heel to pad at 16
// points and pad to toe at 8, and at any edge between two of them its
// corner, found by halving, the sole over it read against the higher side.
sole_low(e: *Engine, heel: Vec3, pad: Vec3, toe: Vec3) -> float {
    a = segment_low(e, heel, pad, 16)
    b = segment_low(e, pad, toe, 8)
    if b < a { return b }
    return a
}

segment_low(e: *Engine, from: Vec3, to: Vec3, steps: int) -> float {
    low = 1000.0
    last_g = 0.0
    k = 0
    while k <= steps {
        u = (k as float) / (steps as float)
        p = core.v3_lerp(from, to, u)
        g = under(e, p)
        if p.y - g < low { low = p.y - g }
        if k > 0 && core.abs_of(g - last_g) > 0.01 {
            lo = u - 1.0 / (steps as float)
            hi = u
            n = 0
            while n < 12 {
                middle = (lo + hi) * 0.5
                gm = under(e, core.v3_lerp(from, to, middle))
                if core.abs_of(gm - last_g) < core.abs_of(gm - g) { lo = middle } else { hi = middle }
                n = n + 1
            }
            edge = core.v3_lerp(from, to, (lo + hi) * 0.5)
            top = last_g
            if g > top { top = g }
            if edge.y - top < low { low = edge.y - top }
        }
        last_g = g
        k = k + 1
    }
    return low
}

// The ground's normal under `p`.
under_normal(e: *Engine, p: Vec3) -> Vec3 {
    hit = physics.ray_static_hit(physics.of(e), core.vec3(p.x, p.y + 0.6, p.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0)
    if !hit.hit { return core.vec3(0.0, 1.0, 0.0) }
    return core.v3_normalize(hit.normal)
}

// The ground's height under `p`.
under(e: *Engine, p: Vec3) -> float {
    hit = physics.ray_static_hit(physics.of(e), core.vec3(p.x, p.y + 0.6, p.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0)
    if !hit.hit { return 0.0 }
    return hit.point.y
}

stairs_and_slopes() {
    e = fresh()
    o = figure.figure(e, "Person", RIGIFY)
    a = animator.attach(e, o)
    walk = animator.take(a, "Walk_Loop", false)
    // A step of the walk: half its cycle's travel.
    stride = clips.speed(walk) * clips.duration(walk) * 0.5
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    clip_off, clip_into, _clip_bent, _clip_went, _clip_lie = walk_course(0, 0.3, 0, false, 1.0)
    flat_off, flat_into, _flat_bent, _flat_went, _flat_lie = walk_course(0, 0.3, 0, true, 1.0)
    println("  on flat ground: the walk alone has a planted sole ${clip_off * 1000.0} mm off the ground, a sole ${clip_into * 1000.0} mm into it; with its feet on the ground by ikrig ${flat_off * 1000.0} and ${flat_into * 1000.0} mm")
    deep_off, deep_into, deep_bent, deep_went, _deep_lie = walk_course(0, stride, 5, true, 1.0)
    println("  over five 0.2 m stairs a step deep (${stride} m) up and down, ${deep_went} m: a planted sole ${deep_off * 1000.0} mm off the ground at worst, a sole ${deep_into * 1000.0} mm into it at worst; knees bent ${deep_bent * 57.29578} degrees at most")
    std_off, std_into, std_bent, std_went, _std_lie = walk_course(0, 0.3, 5, true, 0.3 / stride)
    println("  over five 0.2 m stairs 0.3 m deep up and down, a tread a step (the stride cut to ${0.3 / stride} of the walk's), ${std_went} m: a planted sole ${std_off * 1000.0} mm off, a sole ${std_into * 1000.0} mm into the ground at worst; knees bent ${std_bent * 57.29578} degrees at most")
    ramp_off, ramp_into, ramp_bent, ramp_went, ramp_lie = walk_course(1, 0.0, 0, true, SLOPE_STRIDE)
    println("  over a 20 degree ramp up and down, at ${SLOPE_STRIDE} of the walk's stride, ${ramp_went} m: a foot down's sole ${ramp_off * 1000.0} mm off the ground at worst, a sole ${ramp_into * 1000.0} mm into it at worst; a flat foot's heel and pad ${ramp_lie * 1000.0} mm off the heights the clip has them at; knees bent ${ramp_bent * 57.29578} degrees at most")
    check("walking 0.2 m stairs up and down, a planted sole rests on the ground (within 1 cm) and no sole goes 5 mm into it", deep_off < 0.01 && deep_into < 0.005 && std_off < 0.01 && std_into < 0.005)
    check("walking a 20 degree ramp up and down, a foot down rests on it (within 1 cm), a flat one lies on it as the clip has it on its floor (heel and pad within 5 mm), and no sole goes 5 mm into it", ramp_off < 0.01 && ramp_lie < 0.005 && ramp_into < 0.005)
    check("and no knee bends past its most on either", deep_bent <= ikrig.KNEE_MOST + 0.001 && std_bent <= ikrig.KNEE_MOST + 0.001 && ramp_bent <= ikrig.KNEE_MOST + 0.001)
}

main() {
    limits()
    twist()
    chains()
    whole_body()
    rifle()
    stairs_and_slopes()
    if g_failures > 0 {
        println("ik_constraints: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("ik_constraints: all checks passed (${g_checks})")
}
