// A ragdoll fitted to the figure it dresses (#529, #482), held to numbers.
// Two rigs of the same proportions: one straight up the spine, as the
// pipeline's figure is, and one curved as an MPFB human's is -- the lower
// spine leaning 7 degrees forward, the chest 9 back, the neck's base 14 cm
// in front of the chest's. Dressed, each ragdoll is built as its rig's
// figure; POWERED, each stands five seconds, and holds a 0.3 m/s push at
// the chest (the speed it gives the whole body, #626) from behind, from in
// front and from the side. No window: the
// engine is stepped by hand.
//
//   - dressed, every body's joint is at its rig bone's head and every bone
//     runs along the rig's line (each calf ankle to knee, its shin's own
//     capsule, not its foot's), within a degree;
//   - the rig's bind pose is the ragdoll's rest: the rotation each joint
//     is driven to, read off the rig as it was bound, is the body's own;
//   - both figures stand five seconds and hold every push, and the curved
//     one leans no further than the straight one does past a margin;
//   - a target for a thigh is kept inside its hip's cone as the joint has
//     it (physics.ragdoll_within_cone): of 144 targets a thigh, swung 10 to
//     120 degrees every way from where it hangs, every one returned lies
//     the margin inside by the solver's own measure
//     (dynamics.spherical_cone_gap), and every one already inside is
//     returned as it was. The hip's cone is an ellipse about its own
//     centre (aephysics#129, 125 degrees ahead and 25 back, 45 out and 30
//     across); taken as a circle about the joint's z, 89 of each thigh's
//     144 targets were returned past it, by up to 53 degrees, and 9 to 11
//     inside it were moved;
//   - a third rig's pelvis runs 32.5 degrees up and back from its hips, as
//     a Siltreach figure's MPFB pelvis bone does, its chest bringing the
//     neck back over them. Its hips' cones are a person's as it stands: a
//     thigh hanging straight down is inside each, and one swung 20 degrees
//     back. Powered, it stands five seconds and holds every push, its
//     pelvis within 0.1 rad of upright after the first half second and
//     leaning no more than 0.1 rad past the straight figure. The limits
//     were measured on the reference before it was fitted, and each hip's
//     cone stayed on the pelvis as fitted: tipped back with the pelvis's
//     line, it leaned 32.5 degrees forward of the figure, a thigh straight
//     down past it, and a figure standing on straight legs had its pelvis
//     tipped 0.2 rad by the limits (#706, #704);
//   - with ankles (#709, physics_set_ankles before the ragdoll is made),
//     the box man fixture's ragdoll has fourteen bones, its feet bones of
//     their own; dressed, each rig's ankle rides its foot's body, its
//     offset from the joint below its calf (where fitting set the sole,
//     under 3 cm) changing by under 5 mm, the joint's give, the whole
//     time (the rig draws the ankle where the calf carries it); POWERED, it stands
//     three seconds on soles flat to the ground, each one's ends within
//     5 mm of level. Without them it is the twelve, as before;
//   - crouched (#709): the box man's clip held with its hips 25 degrees
//     forward, its knees bent 50 and its ankles 25 the other way, POWERED.
//     With ankles it stands on flat soles, both ends of each within 1 cm of
//     the ground, its pelvis lowered by the crouch. Without them each foot
//     tilts with its shin and it stands on one end of each sole, the other
//     6.4 cm up (printed).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.motion
import aephysics.human
import aephysics.dynamics
import aephysics.math
import ae3d.figure
import ae3d.anim

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern atan2(y: float, x: float) -> float
extern exit(code: int)

const TRIALS = 4                     // standing, then a push from behind, in front, the side
const DEGREE = 0.0174533
const STRAIGHT = 0
const CURVED = 1
const TIPPED = 2
const TIP = 32.5                     // degrees the tipped rig's pelvis runs back from vertical

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

// A skeleton named and proportioned as the pipeline's figure is, facing
// -z; `curved`, its spine as an MPFB human's: the same segments' lengths,
// turned. Each segment `length` metres at `lean` radians forward (toward
// -z) of straight up.
humanoid_rig(curved: bool) -> *Skeleton {
    if curved { return rig_of(CURVED) }
    return rig_of(STRAIGHT)
}

rig_of(kind: int) -> *Skeleton {
    if kind == CURVED {
        // The neck's base 14 cm in front of the chest's.
        return shaped_rig(7.0 * DEGREE, 0.0 - 9.0 * DEGREE, atan2(0.14, sqrt(0.22 * 0.22 - 0.14 * 0.14)))
    }
    if kind == TIPPED {
        // The pelvis's line TIP back; the chest's forward by as much
        // across, so the neck's base is over the hips.
        back = 0.13 * sin(TIP * DEGREE)
        return shaped_rig(0.0 - TIP * DEGREE, atan2(back, sqrt(0.26 * 0.26 - back * back)), 0.0)
    }
    return shaped_rig(0.0, 0.0, 0.0)
}

// The rig with its spine's three lines leaning forward by these angles.
shaped_rig(lower: float, middle: float, upper: float) -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13 * cos(lower), 0.0 - 0.13 * sin(lower))
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26 * cos(middle), 0.0 - 0.26 * sin(middle))
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22 * cos(upper), 0.0 - 0.22 * sin(upper))
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

extern sin(x: float) -> float
extern cos(x: float) -> float
extern sqrt(x: float) -> float

rig_free(rig: *Skeleton) {
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

angle_between(a: Vec3, b: Vec3) -> float {
    return atan2(core.v3_len(core.v3_cross(a, b)), core.v3_dot(a, b))
}

// The rig bone a ragdoll bone's line ends at: its next mapped bone along
// the chain, or for the neck, a calf and a forearm, its own child.
tail_name(index: int) -> string {
    if index == human.BONE_PELVIS { return "Spine" }
    if index == human.BONE_SPINE_01 { return "Chest" }
    if index == human.BONE_SPINE_03 { return "Neck" }
    if index == human.BONE_NECK { return "Head" }
    if index == human.BONE_THIGH_L { return "KneeL" }
    if index == human.BONE_CALF_L { return "AnkleL" }
    if index == human.BONE_THIGH_R { return "KneeR" }
    if index == human.BONE_CALF_R { return "AnkleR" }
    if index == human.BONE_UPPER_ARM_L { return "ElbowL" }
    if index == human.BONE_LOWER_ARM_L { return "WristL" }
    if index == human.BONE_UPPER_ARM_R { return "ElbowR" }
    return "WristR"
}

rig_position(rig: *Skeleton, name: string) -> Vec3 {
    return core.model_world_position(skin.skeleton_bone(rig, skin.skeleton_find(rig, name)))
}

// Where a body's line ends: its child's joint along the chain, or the
// far end of its own capsule.
body_tail(r: *Ragdoll, index: int) -> Vec3 {
    bone = human.bone_at(&r.human, index)
    next = human.human_chain_child(index)
    if next >= 0 { return dynamics.body_get_position(human.bone_at(&r.human, next).body_id) }
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.shape_id)
    far = c.center1
    if core.v3_len(c.center2) > core.v3_len(c.center1) { far = c.center2 }
    return core.v3_add(t.p, core.quat_apply(t.q, far))
}

// One rig's figure, dressed: how far its joints sit from the rig's (m),
// its lines from the rig's and its rest from the bind pose (radians).
struct Fit {
    joints: float
    lines: float
    calves: float
    rest: float
    facing: float                    // radians between where the figure faces and the rig's toes
}

measure_fit(r: *Ragdoll, rig: *Skeleton) -> Fit {
    out = Fit { joints: 0.0, lines: 0.0, calves: 0.0, rest: 0.0, facing: 0.0 }
    i = 0
    while i < human.BONE_COUNT {
        head = rig_position(rig, physics.humanoid_bone(i))
        body = dynamics.body_get_position(human.bone_at(&r.human, i).body_id)
        off = core.v3_len(core.v3_sub(head, body))
        if off > out.joints { out.joints = off }
        line = angle_between(core.v3_sub(body_tail(r, i), body), core.v3_sub(rig_position(rig, tail_name(i)), head))
        if line > out.lines { out.lines = line }
        if (i == human.BONE_CALF_L || i == human.BONE_CALF_R) && line > out.calves { out.calves = line }
        target = physics.ragdoll_bone_target(r, i)
        have = physics.ragdoll_bone_rotation(r, i)
        d = target.x * have.x + target.y * have.y + target.z * have.z + target.w * have.w
        if d < 0.0 { d = 0.0 - d }
        if d > 1.0 { d = 1.0 }
        rest = 2.0 * atan2(sqrt(1.0 - d * d), d)
        if rest > out.rest { out.rest = rest }
        i = i + 1
    }
    // Where it faces, as a motion reads it: its rest's forward turned as its pelvis is.
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(&r.human, human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    toes = core.v3_sub(rig_position(rig, "ToeL"), rig_position(rig, "AnkleL"))
    out.facing = angle_between(core.vec3(f.x, 0.0, f.z), core.vec3(toes.x, 0.0, toes.z))
    return out
}

// A push, metres a second: what a figure pushed onto its heels holds
// without stepping back (#606).
const PUSH = 0.3

push_of(k: int) -> Vec3 {
    if k == 1 { return core.vec3(0.0, 0.0, 0.0 - PUSH) }
    if k == 2 { return core.vec3(0.0, 0.0, PUSH) }
    if k == 3 { return core.vec3(PUSH, 0.0, 0.0) }
    return core.vec3(0.0, 0.0, 0.0)
}

trial_name(k: int) -> string {
    if k == 0 { return "standing" }
    if k == 1 { return "0.3 m/s from behind" }
    if k == 2 { return "0.3 m/s from in front" }
    return "0.3 m/s from the side"
}

// The chest's lean from upright, radians.
lean(m: *Motion) -> float {
    q = physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_SPINE_03)
    rest = human.bone_at(&m.ragdoll.human, human.BONE_SPINE_03).reference_frame.q
    up = core.quat_apply(q, core.quat_apply(core.quat_conjugate(rest), core.vec3(0.0, 1.0, 0.0)))
    return angle_between(up, core.vec3(0.0, 1.0, 0.0))
}

// One rig's four figures in an engine of their own: standing, and each
// pushed a second in. Into `stood` (int[TRIALS], 1 when the pelvis is
// at or over 0.8 m five seconds in), `leant` (float[TRIALS], the chest's
// worst lean after the first half second) and `tipped` (float[TRIALS],
// the pelvis's worst tilt then).
trial(kind: int, fit: *Fit, stood: ptr, leant: ptr, tipped: ptr) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    motions_block = calloc(TRIALS, 8)
    motions = motions_block as ptr[]
    rigs_block = calloc(TRIALS, 8)
    rigs = rigs_block as ptr[]
    k = 0
    while k < TRIALS {
        r = physics.ragdoll(e, "Figure", core.vec3((k as float) * 4.0, 0.02, 0.0), 8.0, 8.0, 1.0)
        rig = rig_of(kind)
        physics.ragdoll_dress(r, rig)
        if k == 0 { fit[0] = measure_fit(r, rig) }
        rigs[k] = rig as ptr
        m = motion.active_ragdoll(r)
        motion.attach(e, m)
        motion.set_mode(m, motion.POWERED)
        motions[k] = m as ptr
        k = k + 1
    }
    worst = leant as float[]
    tilts = tipped as float[]
    step = 0
    while step < 300 {
        if step == 60 {
            k = 1
            while k < TRIALS {
                m = motions[k] as *Motion
                chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
                motion.hit(m, human.BONE_SPINE_03, chest, core.v3_mul(push_of(k), physics.ragdoll_mass(m.ragdoll)))
                k = k + 1
            }
        }
        engine.engine_update(e, 1.0 / 60.0)
        if step >= 30 {
            k = 0
            while k < TRIALS {
                a = lean(motions[k] as *Motion)
                if a > worst[k] { worst[k] = a }
                t = physics.ragdoll_tilt((motions[k] as *Motion).ragdoll)
                if t > tilts[k] { tilts[k] = t }
                k = k + 1
            }
        }
        step = step + 1
    }
    k = 0
    while k < TRIALS {
        m = motions[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        (stood as int[])[k] = 0
        if pelvis.y >= 0.8 { (stood as int[])[k] = 1 }
        k = k + 1
    }
    engine.engine_free(e)
    k = 0
    while k < TRIALS {
        motion.motion_free(motions[k] as *Motion)
        rig_free(rigs[k] as *Skeleton)
        k = k + 1
    }
    free(motions_block)
    free(rigs_block)
}

// The lean read off a ragdoll dressed in a rig whose hips' line to the
// spine leans 20 degrees forward, as an MPFB figure's does, turned 0.5 rad
// about the vertical and otherwise as dressed: no lean (#550).
turned_tilt() -> float {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = shaped_rig(20.0 * DEGREE, 0.0 - 20.0 * DEGREE, 0.0)
    physics.ragdoll_dress(r, rig)
    physics.ragdoll_turn(r, 0.5)
    tilt = physics.ragdoll_tilt(r)
    engine.engine_free(e)
    rig_free(rig)
    return tilt
}

// How far inside its hip's cone a thigh is on a figure dressed in the
// tipped rig, radians (negative past it): hanging straight down as the
// rig binds it, and swung 20 degrees back from there.
hip_room(index: int) -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = rig_of(TIPPED)
    physics.ragdoll_dress(r, rig)
    bone = human.bone_at(physics.ragdoll_human(r), index)
    joint = bone.joint_id
    cone = dynamics.spherical_joint_of(dynamics.get_joint_sim_of_kind(joint, dynamics.JOINT_SPHERICAL))
    parent = core.quat_mul(physics.ragdoll_bone_rotation(r, bone.parent_index), dynamics.joint_get_local_frame_a(joint).q)
    frame_b = dynamics.joint_get_local_frame_b(joint).q
    hanging = physics.ragdoll_bone_rotation(r, index)
    // The figure faces -z: back is +z, the thigh's foot carried there.
    back = core.quat_from_to(core.vec3(0.0, 0.0 - 1.0, 0.0), core.vec3(0.0, 0.0 - cos(20.0 * DEGREE), sin(20.0 * DEGREE)))
    straight = dynamics.spherical_cone_gap(cone, core.quat_mul(core.quat_conjugate(parent), core.quat_mul(hanging, frame_b)))
    swung = dynamics.spherical_cone_gap(cone, core.quat_mul(core.quat_conjugate(parent), core.quat_mul(core.quat_mul(back, hanging), frame_b)))
    engine.engine_free(e)
    rig_free(rig)
    return straight, swung
}

// Of a thigh's targets swung every way from where it hangs, how many
// within_cone returned past its hip's cone less MARGIN, the furthest
// past, and how many already inside it came back changed.
const CONE_MARGIN = 0.05
cone_kept(index: int) -> (int, float, int) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    r = physics.ragdoll(e, "Figure", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    rig = humanoid_rig(false)
    physics.ragdoll_dress(r, rig)
    bone = human.bone_at(physics.ragdoll_human(r), index)
    joint = bone.joint_id
    cone = dynamics.spherical_joint_of(dynamics.get_joint_sim_of_kind(joint, dynamics.JOINT_SPHERICAL))
    frame_a = dynamics.joint_get_local_frame_a(joint).q
    frame_b = dynamics.joint_get_local_frame_b(joint).q
    parent = core.quat_mul(physics.ragdoll_bone_rotation(r, bone.parent_index), frame_a)
    hanging = physics.ragdoll_bone_rotation(r, index)
    past = 0
    worst = 0.0
    moved = 0
    way = 0
    while way < 12 {
        turn = (way as float) * 30.0 * DEGREE
        axis = core.vec3(cos(turn), 0.0, sin(turn))
        k = 1
        while k <= 12 {
            target = core.quat_normalize(core.quat_mul(core.quat_rotate((k as float) * 10.0 * DEGREE, axis), hanging))
            kept = physics.ragdoll_within_cone(r, index, target, CONE_MARGIN)
            gap = dynamics.spherical_cone_gap(cone, core.quat_mul(core.quat_conjugate(parent), core.quat_mul(kept, frame_b)))
            if gap < CONE_MARGIN - 0.001 {
                past = past + 1
                if CONE_MARGIN - gap > worst { worst = CONE_MARGIN - gap }
            }
            before = dynamics.spherical_cone_gap(cone, core.quat_mul(core.quat_conjugate(parent), core.quat_mul(target, frame_b)))
            if before > CONE_MARGIN + 0.001 && angle_between(core.quat_apply(kept, core.vec3(0.0, 0.0, 1.0)), core.quat_apply(target, core.vec3(0.0, 0.0, 1.0))) > 0.0001 { moved = moved + 1 }
            k = k + 1
        }
        way = way + 1
    }
    engine.engine_free(e)
    rig_free(rig)
    return past, worst, moved
}

// The box man, with ankles or without: its bone count; and with them, the
// furthest its rig's ankles were from the joints below its calves, how much
// that changed (the most, less the least, either foot), the most either
// sole tilted (the height between its ends) over three seconds POWERED,
// and whether it stood. -1 for the distances when it could not be built
// or dressed.
const BOXMAN = "tests/fixtures/gltf/humanoid.glb"

ankled(ankles: bool) -> (int, float, float, float, bool) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), ankles)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", BOXMAN)
    if o == null {
        engine.engine_free(e)
        figure.figures_free(e)
        return (0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, false)
    }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    r = physics.ragdoll(e, "BoxMan", group.world_position, 8.0, 8.0, 1.0)
    sk = figure.skeleton(f)
    if !physics.ragdoll_dress_humanoid(r, sk) {
        engine.engine_free(e)
        figure.figures_free(e)
        return (physics.ragdoll_bone_count(r), 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, false)
    }
    count = physics.ragdoll_bone_count(r)
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    motion.set_mode(m, motion.POWERED)
    h = physics.ragdoll_human(r)
    off = 0.0
    tilt = 0.0
    least_l = 1000.0
    most_l = 0.0
    least_r = 1000.0
    most_r = 0.0
    k = 0
    while k < 180 && count > human.BONE_COUNT {
        engine.engine_update(e, 1.0 / 60.0)
        side = 0
        while side < 2 {
            foot = human.BONE_FOOT_L
            name = "mixamorig:LeftFoot"
            if side == 1 {
                foot = human.BONE_FOOT_R
                name = "mixamorig:RightFoot"
            }
            bone = human.bone_at(h, foot)
            t = dynamics.body_get_transform(bone.body_id)
            ankle = skin.skeleton_bone(sk, skin.skeleton_find(sk, name))
            core.model_sync_transform(ankle)
            d = core.v3_len(core.v3_sub(ankle.world_position, math.transform_point(t, bone.local_frame_b.p)))
            if d > off { off = d }
            if side == 0 {
                if d < least_l { least_l = d }
                if d > most_l { most_l = d }
            } else {
                if d < least_r { least_r = d }
                if d > most_r { most_r = d }
            }
            c = dynamics.shape_get_capsule(bone.shape_id)
            ends = core.abs_of(math.transform_point(t, c.center1).y - math.transform_point(t, c.center2).y)
            if ends > tilt { tilt = ends }
            side = side + 1
        }
        k = k + 1
    }
    up = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y > 0.8 && motion.tilt(m) < 0.1
    engine.engine_free(e)
    motion.motion_free(m)
    figure.figures_free(e)
    spread = most_l - least_l
    if most_r - least_r > spread { spread = most_r - least_r }
    if count <= human.BONE_COUNT { spread = 0.0 }
    return (count, off, spread, tilt, up)
}

// A clip, `clip`, holding the named bone turned `degrees` about its local x
// from the pose it has now.
add_hold(f: *Figure, clip: string, name: string, degrees: float) {
    sk = figure.skeleton(f)
    bone = skin.skeleton_bone(sk, skin.skeleton_find(sk, name))
    c = anim.clip_new("${clip}:${name}")
    ch = anim.channel_new(anim.ROTATION, anim.LINEAR)
    q = core.quat_normalize(core.quat_mul(bone.rotation, core.quat_rotate(degrees * DEGREE, core.vec3(1.0, 0.0, 0.0))))
    anim.channel_add_key(ch, 0.0, q.x, q.y, q.z, q.w)
    anim.channel_add_key(ch, 1.0, q.x, q.y, q.z, q.w)
    anim.clip_add_channel(c, ch)
    figure.add_clip(f, clip, c, name)
}

// The box man crouched (CROUCH_HIP, CROUCH_KNEE, CROUCH_ANKLE on its legs'
// bones), POWERED four seconds, with ankles or without: the most either
// sole's ends differ in height over the last second, its pelvis's height
// at the end, and whether it stands. -1 when it could not be made.
const CROUCH_HIP = 25.0
const CROUCH_KNEE = 0.0 - 50.0
const CROUCH_ANKLE = 25.0

crouched(ankles: bool) -> (float, float, bool) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), ankles)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", BOXMAN)
    if o == null {
        engine.engine_free(e)
        figure.figures_free(e)
        return (0.0 - 1.0, 0.0 - 1.0, false)
    }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    figure.advance(f, 0.0)
    side = 0
    while side < 2 {
        way = "Left"
        if side == 1 { way = "Right" }
        add_hold(f, "Crouch", "mixamorig:${way}UpLeg", CROUCH_HIP)
        add_hold(f, "Crouch", "mixamorig:${way}Leg", CROUCH_KNEE)
        add_hold(f, "Crouch", "mixamorig:${way}Foot", CROUCH_ANKLE)
        side = side + 1
    }
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    r = physics.ragdoll(e, "BoxMan", group.world_position, 8.0, 8.0, 1.0)
    if !physics.ragdoll_dress_humanoid(r, figure.skeleton(f)) {
        engine.engine_free(e)
        figure.figures_free(e)
        return (0.0 - 1.0, 0.0 - 1.0, false)
    }
    m = motion.active_ragdoll(r)
    motion.attach(e, m)
    figure.play(f, "Crouch", 1.0, true)
    motion.set_mode(m, motion.POWERED)
    h = physics.ragdoll_human(r)
    ends = 0.0
    k = 0
    while k < 240 {
        engine.engine_update(e, 1.0 / 60.0)
        if k >= 180 {
            side = 0
            while side < 2 {
                calf = human.BONE_CALF_L
                if side == 1 { calf = human.BONE_CALF_R }
                bone = human.bone_at(h, calf)
                sole = bone.foot_shape_id
                if physics.ragdoll_bone_count(r) > human.BONE_COUNT {
                    bone = human.bone_at(h, human.BONE_FOOT_L + side)
                    sole = bone.shape_id
                }
                t = dynamics.body_get_transform(bone.body_id)
                c = dynamics.shape_get_capsule(sole)
                d = core.abs_of(math.transform_point(t, c.center1).y - math.transform_point(t, c.center2).y)
                if d > ends { ends = d }
                side = side + 1
            }
        }
        k = k + 1
    }
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
    up = pelvis > 0.7 && motion.tilt(m) < 0.1
    engine.engine_free(e)
    motion.motion_free(m)
    figure.figures_free(e)
    return (ends, pelvis, up)
}

main() {
    println("ragdoll fit: a straight rig and a curved one, dressed, powered, pushed at the chest")
    flat_ends, flat_pelvis, flat_up = crouched(true)
    plain_ends, plain_pelvis, _plain_up = crouched(false)
    println("  crouched: with ankles its soles' ends ${flat_ends * 100.0} cm apart in height at most, pelvis ${flat_pelvis} m; without, ${plain_ends * 100.0} cm, pelvis ${plain_pelvis} m")
    check("crouched with ankles (#709), it stands on flat soles, both ends of each within 1 cm of the ground", flat_up && flat_ends >= 0.0 && flat_ends < 0.01)
    plain, _plain_off, _plain_spread, _plain_tilt, _plain_up = ankled(false)
    feet, off, spread, tilt, up = ankled(true)
    stood = 0
    if up { stood = 1 }
    println("  the box man: ${plain} bones without ankles, ${feet} with; its rig's ankles ${off * 100.0} cm from the joints below its calves at most, changing by ${spread * 1000.0} mm, its soles ${tilt * 1000.0} mm off level at most, ${stand_word(stood)} three seconds POWERED")
    check("with ankles (#709) the box man has fourteen bones, without them twelve", feet == human.MAX_BONE_COUNT && plain == human.BONE_COUNT)
    check("dressed with ankles, its rig's ankles ride its feet's bodies: under 3 cm from the joints below the calves, changing by under 5 mm (the joint's give)", off >= 0.0 && off < 0.03 && spread < 0.005)
    check("POWERED with ankles, it stands three seconds on soles each within 5 mm of level", up && tilt >= 0.0 && tilt < 0.005)
    left_past, left_worst, left_moved = cone_kept(human.BONE_THIGH_L)
    right_past, right_worst, right_moved = cone_kept(human.BONE_THIGH_R)
    println("  thighs' targets kept to the hips' cones: left ${left_past} of 144 past by ${left_worst / DEGREE} deg at most, ${left_moved} inside moved; right ${right_past} past by ${right_worst / DEGREE} deg, ${right_moved} moved")
    check("a thigh's targets are kept the margin inside its hip's cone as the joint has it, and those inside left alone",
          left_past == 0 && right_past == 0 && left_moved == 0 && right_moved == 0)
    left_down, left_back = hip_room(human.BONE_THIGH_L)
    right_down, right_back = hip_room(human.BONE_THIGH_R)
    println("  a pelvis ${TIP} deg back: inside the hips' cones, a thigh straight down ${left_down / DEGREE} deg (left) ${right_down / DEGREE} (right), swung 20 back ${left_back / DEGREE} and ${right_back / DEGREE}")
    check("a pelvis ${TIP} degrees back, a thigh straight down and one swung 20 degrees back are inside the hips' cones (#706)",
          left_down > 0.0 && right_down > 0.0 && left_back > 0.0 && right_back > 0.0)
    turned = turned_tilt()
    println("  a figure whose hips' line leans 20 degrees, turned 0.5 rad about the vertical: tilt ${turned} rad")
    check("a turn about the vertical is no lean, on a pelvis whose line leans 20 degrees (#550)", turned < 0.02)
    straight_fit = Fit { joints: 0.0, lines: 0.0, calves: 0.0, rest: 0.0, facing: 0.0 }
    curved_fit = Fit { joints: 0.0, lines: 0.0, calves: 0.0, rest: 0.0, facing: 0.0 }
    straight_stood = calloc(TRIALS, 8)
    curved_stood = calloc(TRIALS, 8)
    straight_leant = calloc(TRIALS, 8)
    curved_leant = calloc(TRIALS, 8)
    tipped_fit = Fit { joints: 0.0, lines: 0.0, calves: 0.0, rest: 0.0, facing: 0.0 }
    tipped_stood = calloc(TRIALS, 8)
    tipped_leant = calloc(TRIALS, 8)
    straight_tilt = calloc(TRIALS, 8)
    curved_tilt = calloc(TRIALS, 8)
    tipped_tilt = calloc(TRIALS, 8)
    trial(STRAIGHT, &straight_fit, straight_stood, straight_leant, straight_tilt)
    trial(CURVED, &curved_fit, curved_stood, curved_leant, curved_tilt)
    trial(TIPPED, &tipped_fit, tipped_stood, tipped_leant, tipped_tilt)
    println("  straight: joints ${straight_fit.joints * 1000.0} mm off the rig's, lines ${straight_fit.lines / DEGREE} deg, calves ${straight_fit.calves / DEGREE} deg, rest ${straight_fit.rest / DEGREE} deg off the bind pose, facing ${straight_fit.facing / DEGREE} deg off its toes")
    println("  curved:   joints ${curved_fit.joints * 1000.0} mm off the rig's, lines ${curved_fit.lines / DEGREE} deg, calves ${curved_fit.calves / DEGREE} deg, rest ${curved_fit.rest / DEGREE} deg off the bind pose, facing ${curved_fit.facing / DEGREE} deg off its toes")
    ss = straight_stood as int[]
    cs = curved_stood as int[]
    sl = straight_leant as float[]
    cl = curved_leant as float[]
    ts = tipped_stood as int[]
    tl = tipped_leant as float[]
    tt = tipped_tilt as float[]
    all_stood = true
    worse = 0.0
    tipped_stood_all = true
    tipped_worse = 0.0
    tipped_most = 0.0
    k = 0
    while k < TRIALS {
        println("  ${trial_name(k)}: straight ${stand_word(ss[k])}, leaning ${sl[k]} rad at worst, pelvis ${(straight_tilt as float[])[k]}; curved ${stand_word(cs[k])}, ${cl[k]} rad, pelvis ${(curved_tilt as float[])[k]}; tipped ${stand_word(ts[k])}, ${tl[k]} rad, pelvis ${tt[k]}")
        if ss[k] != 1 || cs[k] != 1 { all_stood = false }
        if cl[k] - sl[k] > worse { worse = cl[k] - sl[k] }
        if ts[k] != 1 { tipped_stood_all = false }
        if tl[k] - sl[k] > tipped_worse { tipped_worse = tl[k] - sl[k] }
        if tt[k] > tipped_most { tipped_most = tt[k] }
        k = k + 1
    }
    check("dressed, every joint is at its rig bone's head (within a millimetre)", straight_fit.joints < 0.001 && curved_fit.joints < 0.001)
    check("and every bone runs along the rig's line within a degree", straight_fit.lines < DEGREE && curved_fit.lines < DEGREE)
    check("each calf's shin runs knee to ankle within a degree of the rig's (#482)", straight_fit.calves < DEGREE && curved_fit.calves < DEGREE)
    check("the rig's bind pose is the ragdoll's rest: no joint driven off its body (within a degree)", straight_fit.rest < DEGREE && curved_fit.rest < DEGREE)
    check("each faces the way its rig's toes point (within 5 degrees)", straight_fit.facing < 5.0 * DEGREE && curved_fit.facing < 5.0 * DEGREE)
    check("both figures stand five seconds powered, and hold 0.3 m/s from behind, in front and the side", all_stood)
    check("the curved figure leans no more than 0.1 rad past the straight one in any trial (${worse})", worse < 0.1)
    check("the tipped figure stands five seconds powered and holds every push (#706)", tipped_stood_all)
    check("its pelvis within 0.1 rad of upright (${tipped_most}) and its chest no more than 0.1 rad past the straight figure's (${tipped_worse}) (#706)",
          tipped_most < 0.1 && tipped_worse < 0.1)
    free(straight_stood)
    free(curved_stood)
    free(straight_leant)
    free(curved_leant)
    free(tipped_stood)
    free(tipped_leant)
    free(straight_tilt)
    free(curved_tilt)
    free(tipped_tilt)
    if g_failures == 0 {
        println("ragdoll fit: all checks passed (${g_checks})")
    } else {
        println("ragdoll fit: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}

stand_word(standing: int) -> string {
    if standing == 1 { return "stands" }
    return "falls"
}
