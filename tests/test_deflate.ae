// ae3d.deflate, held to numbers: every input comes back through
// ae3d.inflate byte for byte -- nothing, one byte, noise, text, rows of an
// image as PNG filters them, a long run of zeros, at every level -- the
// Adler-32 and CRC-32 are zlib's, zlib's own inflate reads the streams,
// gzip members go both ways between the two, and at zlib's
// default level the stream is within 5% of the size zlib makes of the
// same bytes.

import std.os
import std.bytes
import std.zlib
import std.string
import ae3d.checksum
import ae3d.deflate
import ae3d.inflate

extern malloc(size: long) -> ptr
extern free(p: ptr)
extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Whether `length` bytes at `data` deflate and inflate back to themselves
// at `level`; the stream's size into `sizes[0]`.
round_trip(data: ptr, length: int, level: int, sizes: ptr) -> bool {
    z = deflate.zlib(data, length, level)
    packed = deflate.take(z)
    n = deflate.size(z)
    deflate.done(z)
    (sizes as int[])[0] = n
    back = inflate.zlib(packed, n, length + 1, 0, 1)
    ok = !inflate.failed(back) && inflate.size(back) == length
    if ok {
        out = inflate.take(back)
        a = data as uint8[]
        b = out as uint8[]
        i = 0
        while ok && i < length {
            if a[i] != b[i] { ok = false }
            i = i + 1
        }
        free(out)
    }
    inflate.done(back)
    free(packed)
    return ok
}

// Whether `length` bytes gzip and come back, through ae3d.inflate and
// through zlib; whether zlib's gzip comes back through ae3d.inflate; and
// whether a member with its CRC-32 broken is refused.
gzip_round_trip(data: ptr, length: int) -> bool {
    z = deflate.gzip(data, length, 6)
    packed = deflate.take(z)
    n = deflate.size(z)
    deflate.done(z)
    back = inflate.gzip(packed, n, length + 1, 0)
    ok = !inflate.failed(back) && inflate.size(back) == length
    inflate.done(back)
    _out, out_length, err = zlib.gzip_inflate((packed as byte[])[0..n])
    ok = ok && err == "" && out_length == length
    // Its CRC-32 broken: refused.
    bad = packed as uint8[]
    bad[n - 8] = ((bad[n - 8] as int) ^ 1) as uint8
    broken = inflate.gzip(packed, n, length + 1, 0)
    ok = ok && inflate.failed(broken)
    inflate.done(broken)
    free(packed)
    // zlib's own member, read by ae3d.inflate.
    theirs, theirs_length, gzip_err = zlib.gzip_deflate((data as byte[])[0..length], 6)
    if gzip_err != "" { return false }
    copy = bytes.new(theirs_length)
    bytes.copy_from_string(copy, 0, theirs, theirs_length)
    read = inflate.gzip(bytes.data(copy), theirs_length, length + 1, 0)
    ok = ok && !inflate.failed(read) && inflate.size(read) == length
    inflate.done(read)
    bytes.free(copy)
    return ok
}

// Whether zlib's own inflate reads the stream back to `length` bytes: it
// checks the Adler-32 that ae3d.inflate does not.
zlib_reads(data: ptr, length: int, level: int) -> bool {
    z = deflate.zlib(data, length, level)
    packed = deflate.take(z)
    n = deflate.size(z)
    deflate.done(z)
    _out, out_length, err = zlib.inflate((packed as byte[])[0..n])
    free(packed)
    return err == "" && out_length == length
}

// zlib's stream size for the same bytes at its default level.
zlib_size(data: ptr, length: int) -> int {
    _packed, packed_size, err = zlib.deflate((data as byte[])[0..length], 6)
    if err != "" { return 0 - 1 }
    return packed_size
}

// Noise: a linear congruential generator's high bytes.
noise(length: int) -> ptr {
    out = malloc(length as long)
    o = out as uint8[]
    x = 12345 as long
    i = 0
    while i < length {
        x = (x * (1103515245 as long) + (12345 as long)) % (2147483648 as long)
        o[i] = ((x >> 16) & (255 as long)) as uint8
        i = i + 1
    }
    return out
}

// Text: sentences from a few dozen words, picked by the generator.
text(length: int) -> ptr {
    words = ["the ", "horde ", "comes ", "down ", "street ", "at ", "night ", "and ", "every ", "peer ",
             "holds ", "what ", "host ", "sent ", "zombie ", "quantised ", "to ", "ten ", "bytes ", "a ",
             "joiner ", "takes ", "state ", "once, ", "reliable, ", "over ", "first ", "quarter ", "second. "]
    out = malloc(length as long)
    o = out as uint8[]
    x = 777 as long
    at = 0
    while at < length {
        x = (x * (1103515245 as long) + (12345 as long)) % (2147483648 as long)
        w = words[((x >> 16) % (29 as long)) as int]
        k = 0
        while k < string.length(w) && at < length {
            o[at] = string.char_at(w, k) as uint8
            at = at + 1
            k = k + 1
        }
    }
    return out
}

// An image's rows as a PNG writer filters them: a filter byte, then RGBA
// in smooth gradients with a little noise.
rows(width: int, height: int) -> ptr {
    length = (width * 4 + 1) * height
    out = malloc(length as long)
    o = out as uint8[]
    x = 99 as long
    y = 0
    at = 0
    while y < height {
        o[at] = 0 as uint8
        at = at + 1
        i = 0
        while i < width {
            x = (x * (1103515245 as long) + (12345 as long)) % (2147483648 as long)
            jitter = ((x >> 16) % (5 as long)) as int
            o[at] = ((i + jitter) & 255) as uint8
            o[at + 1] = ((y * 2 + jitter) & 255) as uint8
            o[at + 2] = (((i + y) / 3) & 255) as uint8
            o[at + 3] = 255 as uint8
            at = at + 4
            i = i + 1
        }
        y = y + 1
    }
    return out
}

zeros(length: int) -> ptr {
    out = malloc(length as long)
    o = out as uint8[]
    i = 0
    while i < length {
        o[i] = 0 as uint8
        i = i + 1
    }
    return out
}

main() {
    println("deflate: round trips through ae3d.inflate, against zlib")
    sizes_block = malloc(8 as long)
    sizes = sizes_block as int[]

    // Adler-32 of "Wikipedia" is 0x11E60398.
    wiki = malloc(9 as long)
    wb = wiki as uint8[]
    name = "Wikipedia"
    i = 0
    while i < 9 {
        wb[i] = string.char_at(name, i) as uint8
        i = i + 1
    }
    check("the Adler-32 is zlib's", checksum.adler32(wiki, 9) == (300286872 as long))
    // CRC-32 of "Wikipedia" is 0xADAAC02E.
    check("the CRC-32 is zlib's", checksum.crc32(0 as long, wiki, 9) == (2913648686 as long))

    check("nothing comes back as nothing", round_trip(wiki, 0, 6, sizes_block))
    check("one byte comes back", round_trip(wiki, 1, 6, sizes_block))
    check("one byte stored comes back", round_trip(wiki, 1, 0, sizes_block))
    free(wiki)

    random_length = 100000
    random = noise(random_length)
    check("noise comes back", round_trip(random, random_length, 6, sizes_block))
    println("    noise: ${random_length} bytes to ${sizes[0]}")
    check("noise grows by under 0.1% (stored rather than coded)", sizes[0] <= random_length + random_length / 1000 + 16)
    free(random)

    text_length = 200000
    words = text(text_length)

    level = 0
    every_level = true
    while level <= 9 {
        if !round_trip(words, text_length, level, sizes_block) { every_level = false }
        level = level + 1
    }
    check("text comes back at every level, 0 to 9", every_level)
    began = os.now_monotonic_ns()
    round_trip(words, text_length, 6, sizes_block)
    took = ((os.now_monotonic_ns() - began) as float) * 0.000000001
    ours = sizes[0]
    theirs = zlib_size(words, text_length)
    println("    text: ${text_length} bytes to ${ours} at level 6, zlib ${theirs}; the round trip ${took * 1000.0} ms")
    check("text: within 5% of zlib's size", theirs > 0 && (ours as float) <= (theirs as float) * 1.05)
    check("text: zlib's inflate reads it, Adler-32 and all, stored and coded", zlib_reads(words, text_length, 6) && zlib_reads(words, text_length, 1) && zlib_reads(words, text_length, 0))
    free(words)

    image = rows(512, 256)
    image_length = (512 * 4 + 1) * 256
    check("an image's rows come back", round_trip(image, image_length, 6, sizes_block))
    ours = sizes[0]
    theirs = zlib_size(image, image_length)
    println("    image rows: ${image_length} bytes to ${ours}, zlib ${theirs}")
    check("image rows: within 5% of zlib's size", theirs > 0 && (ours as float) <= (theirs as float) * 1.05)
    check("image rows: zlib's inflate reads them", zlib_reads(image, image_length, 9))
    check("image rows as gzip: read back by ae3d.inflate and zlib, zlib's read by ae3d.inflate, a broken CRC refused", gzip_round_trip(image, image_length))
    free(image)

    zero_length = 1000000
    blank = zeros(zero_length)
    check("a million zeros come back", round_trip(blank, zero_length, 6, sizes_block))
    ours = sizes[0]
    theirs = zlib_size(blank, zero_length)
    println("    zeros: ${zero_length} bytes to ${ours}, zlib ${theirs}")
    check("zeros: within 5% of zlib's size", theirs > 0 && (ours as float) <= (theirs as float) * 1.05)
    free(blank)

    free(sizes_block)
    if g_failures == 0 {
        println("deflate: all checks passed (${g_checks})")
    } else {
        println("deflate: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
