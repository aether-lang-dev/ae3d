// ci: optimised -- two figures' falls and get-ups in each of several layouts, CPU work -O0 makes several times slower
// Two get-ups side by side (#835, #859 L5): two of the UE5 mannequin made
// characters (ae3d.character, on 100STYLE's gaits) in a world with physics.
// One is knocked onto its back; once it lies still the other is stood
// beside its hips and let go (the full ragdoll, LIMP), so it crumples next
// to it or onto it. Once both lie still, both are told to get up on the same
// frame (character.get_up). No window; stepped at 60 Hz.
//
// Measured over the layouts (the second figure GAPS from the first's hips,
// turned TURNS), as the plaza scorecard measures two figures inside each
// other: any of one's hips, chest and knees, as drawn, nearer any of the
// other's than the two parts are thick (their ragdoll capsules' radii,
// summed) by more than GIVE, a contact's give. Printed: the seconds inside
// each other over the get-ups and the deepest, and whether both stood.
//
// Held to: both get up in every layout. The figures getting up still go
// inside each other (#835, open): printed, not held. On the get-ups chosen
// by how the body lies (character.get_up, LayToIdle or its mirror), 0.67 s
// over the 9 layouts, 5.0 cm at the deepest (0.2 m apart, turned a
// quarter); each get-up is laid onto its own body as if alone.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.character
import ae3d.physanim
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const GET_UP = "LayToIdle"

const BLEND = 0.4                    // s each get-up is inertialized in over
const DOWN_MOST = 600                // steps a figure may take to come to rest
const UP_MOST = 600                  // steps the get-ups may take
const GIVE = 0.02                    // m two parts may be inside each other, touching
const PUSH = 60.0                    // N s on the first figure's chest, from in front
const PARTS = 4                      // hips, chest, each knee
const STAND = 60                     // steps the second stands beside the first before it is let go

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

flat_of(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

// A figure's ragdoll let go to ae3d.motion LIMP, as a full knockdown is.
let_go(e: *Engine, c: *Character) -> *Motion {
    character.pause(c)
    animator.pause(character.animator_of(c))
    pa = character.physanim_of(c)
    physanim.release(pa)
    m = motion.active_ragdoll(physanim.ragdoll_of(pa))
    if m == null { return null }
    motion.attach(e, m)
    motion.set_mode(m, motion.LIMP)
    return m
}

// Stepped until motion has `m` at rest (and `n`, when given): false when
// either never comes to rest.
lie_still(e: *Engine, m: *Motion, n: *Motion) -> bool {
    k = 0
    while k < DOWN_MOST {
        engine.engine_update(e, STEP)
        if k > 30 && motion.down(m) && (n == null || motion.down(n)) { return true }
        k = k + 1
    }
    return false
}

// A figure's parts' half thickness (hips, chest, each knee): its ragdoll's
// capsule radii, the pelvis's, the chest's and each calf's.
thickness(c: *Character, out: float[]) {
    h = physics.ragdoll_human(physanim.ragdoll_of(character.physanim_of(c)))
    out[0] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_PELVIS).shape_id).radius
    out[1] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_SPINE_03).shape_id).radius
    out[2] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_CALF_L).shape_id).radius
    out[3] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_CALF_R).shape_id).radius
}

// A figure's parts as drawn now, in the world: hips, chest, each knee.
parts(c: *Character, p: ptr, w: ptr, out: ptr) {
    r = animator.rig(character.animator_of(c))
    pose.read(r, p)
    pose.world(r, p, w)
    slots = [pose.PELVIS, pose.SPINE_03, pose.CALF_L, pose.CALF_R]
    o = out as float[]
    k = 0
    while k < PARTS {
        at = clips.ground_point(r, pose.translation(w, pose.human(r, slots[k])))
        o[k * 3] = at.x
        o[k * 3 + 1] = at.y
        o[k * 3 + 2] = at.z
        k = k + 1
    }
}

// How far the two figures' parts are inside each other past GIVE (0 when
// none is): the deepest pair.
inside(pa: float[], ta: float[], pb: float[], tb: float[]) -> float {
    deepest = 0.0
    i = 0
    while i < PARTS {
        k = 0
        while k < PARTS {
            d = core.v3_len(core.vec3(pa[i * 3] - pb[k * 3], pa[i * 3 + 1] - pb[k * 3 + 1], pa[i * 3 + 2] - pb[k * 3 + 2]))
            depth = ta[i] + tb[k] - GIVE - d
            if depth > deepest { deepest = depth }
            k = k + 1
        }
        i = i + 1
    }
    return deepest
}

// One layout: the second figure `gap` metres from the first's hips (level,
// across its spine), turned `turn` radians from facing along it. The
// seconds the two get-ups were drawn inside each other, the deepest, and
// whether both got up.
layout(g: *Gaits, gap: float, turn: float) -> (float, float, bool) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    a = character.humanoid(e, "A", MANNEQUIN, g)
    b = character.humanoid(e, "B", MANNEQUIN, g)
    if a == null || b == null {
        println("  no character: ${character.error()}")
        return 0.0, 0.0, false
    }
    _pa = character.physical(a)
    _pb = character.physical(b)
    character.resume(b, core.vec3(3.0, 0.0, 0.0), core.vec3(0.0, 0.0, 1.0))
    if character.get_up_add(a, GET_UP) < 0 || character.get_up_add(b, GET_UP) < 0 { return 0.0, 0.0, false }
    k = 0
    while k < 30 {
        character.move(a, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        character.move(b, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // The first onto its back: pushed at the chest from in front.
    ma = let_go(e, a)
    if ma == null { return 0.0, 0.0, false }
    rag = physanim.ragdoll_of(character.physanim_of(a))
    chest = physanim.bone_named(character.physanim_of(a), "Chest")
    at = behaviour.object_position(physics.ragdoll_bone(rag, chest))
    physics.ragdoll_apply_impulse(rag, chest, core.vec3(0.0, 0.1 * PUSH, 0.0 - PUSH), at)
    if !lie_still(e, ma, null) { return 0.0, 0.0, false }
    // The second stood beside its hips and let go.
    hips = behaviour.object_position(physics.ragdoll_bone(rag, 0))
    neck = behaviour.object_position(physics.ragdoll_bone(rag, physanim.bone_named(character.physanim_of(a), "Neck")))
    spine = core.v3_normalize(flat_of(core.v3_sub(neck, hips)))
    side = core.vec3(spine.z, 0.0, 0.0 - spine.x)
    facing = core.quat_apply(core.quat_rotate(turn, core.vec3(0.0, 1.0, 0.0)), spine)
    character.resume(b, core.v3_add(flat_of(hips), core.v3_mul(side, gap)), facing)
    // Stood there a while first: its bodies follow it there, and let go
    // the step after it was put there they flew at the speed of the move.
    k = 0
    while k < STAND {
        character.move(b, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    mb = let_go(e, b)
    if mb == null || !lie_still(e, ma, mb) { return 0.0, 0.0, false }
    // Both up on the same frame.
    _sa = character.get_up(a, ma, BLEND)
    _sb = character.get_up(b, mb, BLEND)
    ta = calloc(PARTS, 8) as float[]
    tb = calloc(PARTS, 8) as float[]
    thickness(a, ta)
    thickness(b, tb)
    ra = animator.rig(character.animator_of(a))
    rb = animator.rig(character.animator_of(b))
    p = pose.new(ra)
    w = pose.new(ra)
    q = pose.new(rb)
    v = pose.new(rb)
    pts_a = calloc(PARTS * 3, 8)
    pts_b = calloc(PARTS * 3, 8)
    seconds = 0.0
    deepest = 0.0
    k = 0
    while k < UP_MOST && (character.acting(a) || character.acting(b)) {
        engine.engine_update(e, STEP)
        parts(a, p, w, pts_a)
        parts(b, q, v, pts_b)
        depth = inside(pts_a as float[], ta, pts_b as float[], tb)
        if depth > 0.0 { seconds = seconds + STEP }
        if depth > deepest { deepest = depth }
        k = k + 1
    }
    up = !character.acting(a) && !character.acting(b)
    free(pts_a)
    free(pts_b)
    free(ta as ptr)
    free(tb as ptr)
    pose.release(p)
    pose.release(w)
    pose.release(q)
    pose.release(v)
    character.character_free(a)
    character.character_free(b)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return seconds, deepest, up
}

main() {
    println("get_up_pair: two figures getting up side by side (#835)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    gaps = [0.1, 0.2, 0.3]
    turns = [0.0, 1.5707963, 3.1415926]
    total = 0.0
    worst = 0.0
    layouts = 0
    all_up = true
    i = 0
    while i < 3 {
        k = 0
        while k < 3 {
            seconds, deepest, up = layout(g, gaps[i], turns[k])
            println("  gap ${gaps[i]} m, turned ${turns[k]}: inside each other ${seconds} s, deepest ${deepest} m, up ${up}")
            total = total + seconds
            if deepest > worst { worst = deepest }
            if !up { all_up = false }
            layouts = layouts + 1
            k = k + 1
        }
        i = i + 1
    }
    println("  ${layouts} layouts: inside each other ${total} s in all, deepest ${worst} m")
    check("both get up in every layout", all_up)
    character.gaits_free(g)
    if g_failures == 0 {
        println("get_up_pair: all checks passed (${g_checks})")
        return
    }
    println("get_up_pair: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
