// The pairs tests/test_canvas.ae draws into a canvas with: a card's vertex
// shader, its corners given in OpenGL's clip space and made the renderer's
// by `lens` (engine_canvas_lens's matrix), and two pixel shaders, one that
// reads a picture of the program's at the card's uv and one of a single
// colour, its alpha the draw's. Their SPIR-V is made by
// tools/canvas_test_spirv.ae (tests/lib/canvascard_spirv): run that after
// this changes.

import std.quote
import ae3d.gpu (GpuShader, vertex, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, mat4, mul, Texture, texture)

exports (CardVertex, CardVaryings, card_vertex, card_picture, card_colour)

struct CardVertex {
    position: vec3
    uv: vec2
    normal: vec3
}

struct CardVaryings {
    position: vec4
    uv: vec2
}

card_vertex(lens: mat4) -> *GpuShader {
    return vertex("canvas_card_vertex") quote | v: CardVertex | {
        return CardVaryings { position: mul(lens, vec4(v.position, 1.0)), uv: v.uv }
    }
}

// The picture's texel at the card's uv, as it is.
card_picture(picture: Texture) -> *GpuShader {
    return fragment("canvas_card_picture") quote | f: CardVaryings | {
        return texture(picture, f.uv)
    }
}

// One colour, its alpha what `over` lays it on by.
card_colour(colour: vec4) -> *GpuShader {
    return fragment("canvas_card_colour") quote | f: CardVaryings | {
        return colour
    }
}
