// A foot swinging over the ground clears it (ae3d.ikrig, SWING_CLEAR): the
// UE5 mannequin on 100STYLE's neutral gaits (ae3d.character), its stop
// 100STYLE's LookUp walk stop as Siltreach's settler has it, run at 3 m/s and
// let go, then walked at 1.2 m/s and let go. No window; stepped at 60 Hz.
// On Siltreach's settler the stop's step swung a toe 0 to 4 mm over the floor
// at 3 to 4.6 m/s (the capture's rigid toes pitched down as its heel rose, the
// figure still carried at a run), and the meter read it as a toe sliding
// 378 mm.
//
//   - while a foot not locked has its toe going faster than 1.5 m/s over the
//     ground, its sole's lowest point is 1 cm over the floor or more;
//   - and no toe skates 5 mm (ae3d.metrics) running, stopping, walking and
//     stopping.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/lookup_stop.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(o: *GameObject) -> Vec3 { return core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }

// Asked to go at `speed` ahead for `go` frames, then let go for `rest`: the
// lowest a sole was over the floor while its foot was not locked and its
// toe went faster than 1.5 m/s, and the worst a toe skated.
pace(e: *Engine, c: *Character, m: *Meter, speed: float, go: int, rest: int) -> (float, float) {
    a = character.animator_of(c)
    r = animator.rig(a)
    f = character.feet_of(c)
    o = character.object_of(c)
    drawn = pose.new(r)
    worlds = pose.new(r)
    metrics.meter_reset(m)
    ahead = facing(o)
    still = core.vec3(0.0, 0.0, 0.0)
    lowest = 1000.0
    lx = [0.0, 0.0]
    lz = [0.0, 0.0]
    k = 0
    while k < go + rest {
        asked = still
        if k < go { asked = core.v3_mul(ahead, speed) }
        character.move(c, asked, still)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)
        pose.read(r, drawn)
        pose.world(r, drawn, worlds)
        side = 0
        while side < 2 {
            tip = ikrig.toe_tip(f, r, worlds, side)
            heel, pad, toe = ikrig.feet_soles(f, r, worlds, side)
            low = heel.y
            if pad.y < low { low = pad.y }
            if toe.y < low { low = toe.y }
            if k > 0 && !ikrig.feet_locked(f, side) {
                dx = tip.x - lx[side]
                dz = tip.z - lz[side]
                if core.sqrt_of(dx * dx + dz * dz) / STEP > 1.5 && low < lowest { lowest = low }
            }
            lx[side] = tip.x
            lz[side] = tip.z
            side = side + 1
        }
        k = k + 1
    }
    pose.release(drawn)
    pose.release(worlds)
    return lowest, metrics.meter_worst(m, metrics.SKATE)
}

main() {
    println("swing_clear: a foot swinging over the ground clears it")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Settler", MANNEQUIN, g)
    if c == null {
        println("  no settler: ${character.error()}")
        exit(1)
    }
    character.capsule_off(c)
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, 0.0 - 20.0))
    m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
    metrics.meter_ground_physics(m, physics.of(e))
    k = 0
    while k < 30 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    ran_low, ran_skate = pace(e, c, m, 3.0, 150, 150)
    println("  run at 3 m/s and let go: a sole swinging past 1.5 m/s ${ran_low * 1000.0} mm over the floor at its lowest; a toe skated ${ran_skate * 1000.0} mm (${metrics.meter_when(m, metrics.SKATE)} s in)")
    walked_low, walked_skate = pace(e, c, m, 1.2, 180, 150)
    println("  walked at 1.2 m/s and let go: a sole swinging past 1.5 m/s ${walked_low * 1000.0} mm over the floor at its lowest; a toe skated ${walked_skate * 1000.0} mm (${metrics.meter_when(m, metrics.SKATE)} s in)")
    low = ran_low
    if walked_low < low { low = walked_low }
    skate = ran_skate
    if walked_skate > skate { skate = walked_skate }
    check("a foot not locked, its toe going faster than 1.5 m/s over the ground, has its sole 1 cm over the floor or more", low >= 0.01)
    check("running and walking ahead and let go, no toe skates 5 mm", skate < 0.005)
    metrics.meter_free(m)
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("swing_clear: all checks passed (${g_checks})")
        return
    }
    println("swing_clear: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
