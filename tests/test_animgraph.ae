// Animation graphs as data (#903, ae3d.animgraph): a graph read from a file
// against the same graph built by the animator's calls. UAL1's Rigify
// mannequin twice, one on tests/fixtures/graphs/runner.graph, one on the
// calls the file stands for, both driven by the same parameters for 8 s. No
// window; stepped at 60 Hz.
//
//   - the file builds: its states, layer, aim and takes found by their names,
//     at the indices the calls give them;
//   - driven alike (standing, walking, a jump triggered, a hit layer raised,
//     a pistol aimed, a stride on a matcher), the two pass through the same
//     states (stand, blend, jump, stand, matcher), and every frame every
//     joint of the one is within 1e-6 rad and 1e-6 m of the other's (the
//     calls compressing each take as the file's line finishes it, #992);
//   - takes from another figure's file (take ... from): the female mannequin
//     (UE5's skeleton) on the Rigify runner's gaits and pistol aim, as the
//     showcase has her, every joint of every frame of her walk the retarget
//     by calls gives (1e-6 rad);
//   - a capture cropped and read from CMU's ASF/AMC (#948): its take the one
//     built by calls (1e-6 rad), named as the graph names it, its two events
//     firing at their seconds into the crop over its state's rate (1.5);
//   - a file naming a state it never declares is refused, the error saying
//     its line; so is one naming an animation the figure's file lacks.

import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.bvh
import ae3d.animgraph

extern exit(code: int)

const STEP = 0.016666666666666666
const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const GRAPHS = "tests/fixtures/graphs/"
const FW = "tests/fixtures/people/100style/neutral_fw.bvh"
const FEMALE = "tests/fixtures/people/mannequin_f.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The angle between two turns, as unit turns: a file's rest can hold a
// rotation a little off unit length (UE5's mannequins' roots, necks,
// thighs and thumb tips), and measured against itself as it was, the same
// rotation came out 0.0007 rad.
turned_by(a: Quat, b: Quat) -> float {
    la = core.sqrt_of(a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w)
    lb = core.sqrt_of(b.x * b.x + b.y * b.y + b.z * b.z + b.w * b.w)
    if la < 0.000001 || lb < 0.000001 { return 0.0 }
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w) / (la * lb)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// The graph runner.graph declares, by the animator's calls. Its states'
// indices, in the file's order: idle, jump, move, strider. Each take
// compressed as its line finishes it, as a graph's are (#992).
by_calls(a: *Animator) -> (int, int) {
    r = animator.rig(a)
    idle = packed(animator.take(a, "Idle_Loop", false), r)
    walk = packed(animator.take(a, "Walk_Loop", false), r)
    jog = packed(animator.take(a, "Jog_Fwd_Loop", false), r)
    sprint = packed(animator.take(a, "Sprint_Loop", false), r)
    jump = packed(animator.take(a, "Jump_Start", true), r)
    hit = packed(animator.take(a, "Hit_Head", false), r)
    aim_mid = packed(animator.take(a, "Pistol_Aim_Neutral", false), r)
    aim_up = packed(animator.take(a, "Pistol_Aim_Up", false), r)
    aim_down = packed(animator.take(a, "Pistol_Aim_Down", false), r)
    c = bvh.load(FW, 0.0)
    made = bvh.take(c, FW, 0, 0 - 1)
    fw = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
    clips.take_free(made)
    bvh.capture_free(c)
    clips.straighten(fw, r, true)
    fw = animator.add_take(a, clips.loop_cut(fw, r), false)
    clips.straighten(fw, r, true)
    fw = packed(fw, r)
    fw_m = packed(animator.add_take(a, clips.mirror(fw, r), false), r)
    s_idle = animator.add_state(a, "idle", idle, true)
    s_jump = animator.add_state(a, "jump", jump, false)
    move = animator.add_blend(a, "move")
    animator.bind(a, move, "speed")
    animator.blend_add(a, move, walk, clips.speed(walk))
    animator.blend_add(a, move, jog, clips.speed(jog))
    animator.blend_add(a, move, sprint, clips.speed(sprint))
    strider = animator.add_matcher(a, "strider")
    animator.matcher_add(a, strider, fw)
    animator.matcher_add(a, strider, fw_m)
    animator.matcher_build(a, strider)
    t = animator.add_transition(a, s_idle, move, 0.2)
    animator.transition_when(a, t, "speed", animator.ABOVE, 0.1)
    t = animator.add_transition(a, move, s_idle, 0.3)
    animator.transition_when(a, t, "speed", animator.BELOW, 0.1)
    t = animator.add_transition(a, animator.ANY, s_jump, 0.1)
    animator.transition_when(a, t, "jump", animator.TRIGGERED, 0.0)
    animator.transition_crossfade(a, t, true)
    t = animator.add_transition(a, s_jump, s_idle, 0.3)
    animator.transition_when(a, t, "", animator.ENDED, 0.0)
    t = animator.add_transition(a, s_idle, strider, 0.3)
    animator.transition_when(a, t, "stride", animator.IS, 0.0)
    layer = animator.add_layer(a, hit, pose.human(r, pose.SPINE_01), false, false)
    aim = animator.add_aim(a, pose.human(r, pose.SPINE_01))
    animator.aim_add(a, aim, aim_mid, 0.0, 0.0)
    animator.aim_add(a, aim, aim_up, 0.0, 0.7)
    animator.aim_add(a, aim, aim_down, 0.0, 0.0 - 0.7)
    animator.play(a, s_idle, 0.0)
    return layer, aim
}

// Take `t` compressed (clips.compress), as a graph's take is.
packed(t: *Take, r: *pose.Rig) -> *Take {
    _err = clips.compress(t, r)
    return t
}

// The same asked of both at time `now`.
drive(a: *Animator, now: float, layer: int, aim: int) {
    speed = 0.0
    if now >= 1.0 && now < 3.0 { speed = 1.5 }
    animator.set_float(a, "speed", speed)
    if core.abs_of(now - 2.9) < STEP * 0.5 { animator.trigger(a, "jump") }
    if core.abs_of(now - 4.5) < STEP * 0.5 { animator.layer_weight(a, layer, 1.0, 0.1) }
    if core.abs_of(now - 5.0) < STEP * 0.5 { animator.layer_weight(a, layer, 0.0, 0.2) }
    w = 0.0
    if now >= 5.0 { w = 1.0 }
    animator.set_aim(a, aim, 0.0, 0.5, w)
    animator.set_bool(a, "stride", now >= 6.0)
}

main() {
    println("animgraph: a graph read from a file against the same built by calls (#903)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    file_o = figure.figure(e, "FromFile", RIGIFY)
    calls_o = figure.figure(e, "ByCalls", RIGIFY)
    fa = animator.attach(e, file_o)
    ca = animator.attach(e, calls_o)
    r = animator.rig(fa)
    g = animgraph.load(fa, "${GRAPHS}runner.graph")
    check("the file builds: ${animgraph.error()}", g != null)
    if g == null { exit(1) }
    layer, aim = by_calls(ca)
    named = animgraph.state_of(g, "idle") == 0 && animgraph.state_of(g, "jump") == 1 && animgraph.state_of(g, "move") == 2 && animgraph.state_of(g, "strider") == 3
    named = named && animgraph.layer_of(g, "hit") == layer && animgraph.aim_of(g, "pistol") == aim && animgraph.take_of(g, "fw") != null
    named = named && animgraph.state_of(g, "fw") < 0 && animgraph.take_of(g, "idle") != null
    check("its states, layer, aim and takes are found by their names, at the indices the calls give them", named)
    // Driven alike.
    worst_turn = 0.0
    worst_move = 0.0
    visited = ""
    last = 0 - 1
    k = 0
    while k < (8.0 / STEP) as int {
        now = (k as float) * STEP
        drive(fa, now, animgraph.layer_of(g, "hit"), animgraph.aim_of(g, "pistol"))
        drive(ca, now, layer, aim)
        engine.engine_update(e, STEP)
        fp = animator.pose_now(fa)
        cp = animator.pose_now(ca)
        j = 0
        while j < pose.count(r) {
            d = turned_by(pose.rotation(fp, j), pose.rotation(cp, j))
            if d > worst_turn { worst_turn = d }
            m = core.v3_len(core.v3_sub(pose.translation(fp, j), pose.translation(cp, j)))
            if m > worst_move { worst_move = m }
            j = j + 1
        }
        now_state = animator.current(fa)
        if now_state != last {
            if last >= 0 { visited = "${visited} " }
            visited = "${visited}${animator.state_name(fa, now_state)}"
            last = now_state
        }
        k = k + 1
    }
    println("  driven 8 s: through ${visited}; the most a joint differed ${worst_turn} rad, ${worst_move} m")
    check("driven alike, it passes through the stand, the blend, the jump, the stand and the matcher", visited == "idle move jump idle strider")
    check("every frame every joint is within 1e-6 rad and 1e-6 m of the graph built by calls", worst_turn < 0.000001 && worst_move < 0.000001)
    // Takes from another figure's file.
    fo = figure.figure(e, "Female", FEMALE)
    behaviour.object_set_position(fo, core.vec3(4.0, 0.0, 0.0))
    fa2 = animator.attach(e, fo)
    fg = animgraph.load(fa2, "${GRAPHS}female.graph")
    check("a graph's takes from another figure's file build: ${animgraph.error()}", fg != null && animgraph.layer_of(fg, "aim") >= 0 && animgraph.state_of(fg, "move") >= 0)
    if fg == null { exit(1) }
    src_o = figure.figure(e, "Source", RIGIFY)
    src_f = figure.figure_of(src_o)
    src = pose.of_skeleton(figure.skeleton(src_f))
    made = clips.from_scene(src, figure.scene(src_f), "Walk_Loop", 0.0)
    by_calls = packed(retarget.retarget(src, made, animator.rig(fa2)), animator.rig(fa2))
    from_file = animgraph.take_of(fg, "walk")
    fr = animator.rig(fa2)
    worst_from = 0.0
    same = clips.frames(from_file) == clips.frames(by_calls)
    f = 0
    while same && f < clips.frames(from_file) {
        j = 0
        while j < pose.count(fr) {
            d = turned_by(pose.rotation(clips.frame(from_file, f), j), pose.rotation(clips.frame(by_calls, f), j))
            if d > worst_from { worst_from = d }
            j = j + 1
        }
        f = f + 1
    }
    println("  the female's walk from the runner's file: ${clips.frames(from_file)} frames, every joint within ${worst_from} rad of the retarget by calls")
    check("and each is the retarget by calls, every joint of every frame within 1e-6 rad", same && worst_from < 0.000001)
    clips.take_free(made)
    clips.take_free(by_calls)
    pose.rig_free(src)
    animgraph.graph_free(fg)
    animator.animator_free(fa2)
    // A CMU capture from its ASF skeleton and AMC take (#948): cropped to
    // 0.5 to 2.0 s, two events on it, its state at 1.5 times its pace.
    cmu_o = figure.figure(e, "Walker", FEMALE)
    behaviour.object_set_position(cmu_o, core.vec3(8.0, 0.0, 0.0))
    cmu_anim = animator.attach(e, cmu_o)
    cmu_g = animgraph.load(cmu_anim, "${GRAPHS}cmu.graph")
    check("a graph's cropped ASF/AMC capture with events and a rate builds: ${animgraph.error()}", cmu_g != null && animgraph.state_of(cmu_g, "walking") >= 0)
    if cmu_g == null { exit(1) }
    cmu_c = bvh.load_asf("tests/fixtures/people/cmu/02.asf", "tests/fixtures/people/cmu/02_01.amc", 120.0, 0.0)
    cmu_made = bvh.take(cmu_c, "walk", 60, 240)
    cmu_calls = packed(retarget.retarget(bvh.rig(cmu_c), cmu_made, animator.rig(cmu_anim)), animator.rig(cmu_anim))
    cmu_file = animgraph.take_of(cmu_g, "walk")
    cmu_r = animator.rig(cmu_anim)
    worst_cmu = 0.0
    cmu_same = clips.frames(cmu_file) == clips.frames(cmu_calls) && string.equals(clips.name(cmu_file), "walk") == 1
    f = 0
    while cmu_same && f < clips.frames(cmu_file) {
        j = 0
        while j < pose.count(cmu_r) {
            d = turned_by(pose.rotation(clips.frame(cmu_file, f), j), pose.rotation(clips.frame(cmu_calls, f), j))
            if d > worst_cmu { worst_cmu = d }
            j = j + 1
        }
        f = f + 1
    }
    // Its events, played: at their seconds into the crop over the rate.
    left_at = 0.0 - 1.0
    right_at = 0.0 - 1.0
    k = 0
    while k < 120 {
        engine.engine_update(e, STEP)
        if animator.fired(cmu_anim, "left") && left_at < 0.0 { left_at = ((k + 1) as float) * STEP }
        if animator.fired(cmu_anim, "right") && right_at < 0.0 { right_at = ((k + 1) as float) * STEP }
        k = k + 1
    }
    println("  CMU's walk from ASF/AMC, cropped: ${clips.frames(cmu_file)} frames, every joint within ${worst_cmu} rad of the take by calls; its events at ${left_at} s and ${right_at} s (asked ${(0.8 - 0.5) / 1.5} and ${(1.3 - 0.5) / 1.5})")
    check("a cropped ASF/AMC capture is the take built by calls, every joint of every frame within 1e-6 rad, named as the graph names it", cmu_same && worst_cmu < 0.000001)
    check("its events fire at their seconds into the crop over its state's rate (within a frame)", core.abs_of(left_at - 0.2) <= STEP + 0.0001 && core.abs_of(right_at - (0.8 / 1.5)) <= STEP + 0.0001)
    clips.take_free(cmu_made)
    clips.take_free(cmu_calls)
    bvh.capture_free(cmu_c)
    animgraph.graph_free(cmu_g)
    animator.animator_free(cmu_anim)
    // Refused files.
    bad = animgraph.load(fa, "${GRAPHS}no_state.graph")
    why = animgraph.error()
    println("  a transition to a state never declared: ${why}")
    check("a file naming a state it never declares is refused, saying its line", bad == null && why == "line 5: no state `run`")
    bad = animgraph.load(fa, "${GRAPHS}no_animation.graph")
    why = animgraph.error()
    println("  a take of an animation the figure lacks: ${why}")
    check("a file naming an animation the figure's file lacks is refused, saying its line", bad == null && why == "line 3: the figure's file has no animation `Backstroke_Loop`")
    animgraph.graph_free(g)
    animator.animator_free(fa)
    animator.animator_free(ca)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("animgraph: all checks passed (${g_checks})")
        return
    }
    println("animgraph: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
