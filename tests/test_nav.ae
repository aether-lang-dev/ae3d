// The flow field: a flood from the target over the open ground, a direction
// per cell toward it, and the horde's headings turned by it; footprints from
// a model's own triangles (#817); cells that are dear and not blocked, and
// the clearance that keeps a crowd off walls without closing doorways
// (#819). Headless.

import std.string
import ae3d.core
import ae3d.geometry
import ae3d.loader
import ae3d.nav

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

var failures = 0

check(name: string, ok: bool) {
    if !ok {
        println("nav: FAIL ${name}")
        failures = failures + 1
    }
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

main() {
    // Twenty metres square, a cell a metre; a wall across the middle with a
    // gap at one end, the target beyond it.
    f = nav.flow_new(0.0, 0.0, 19.0, 19.0, 1.0)
    check("the field has a cell a metre", nav.flow_width(f) == 20 && nav.flow_height(f) == 20)
    check("an unbuilt field has no direction", !nav.flow_has_direction(f, 5.0, 5.0))
    check("and no cost", nav.flow_cost(f, 5.0, 5.0) < 0.0)

    nav.flow_block(f, 0.0, 10.0, 15.9, 10.9)  // the wall: x 0..15, the row at z 10
    check("a blocked cell is blocked", nav.flow_blocked(f, 5.5, 10.5))
    check("the gap is open", !nav.flow_blocked(f, 18.5, 10.5))
    check("off the field is blocked", nav.flow_blocked(f, 0.0 - 3.0, 5.0))

    reached = nav.flow_build(f, core.vec3(5.5, 0.0, 15.5))
    check("the flood reaches every open cell", reached == 400 - 16)
    check("the wall is one row", nav.flow_blocked(f, 5.5, 10.5) && !nav.flow_blocked(f, 5.5, 9.5) && !nav.flow_blocked(f, 5.5, 11.5))
    check("the target's own cell has no direction", !nav.flow_has_direction(f, 5.5, 15.5))
    check("a wall cell has none", !nav.flow_has_direction(f, 5.5, 10.5))
    check("the target is at no cost", near(nav.flow_cost(f, 5.5, 15.5), 0.0))

    // Beside the target: straight at it, one metre away.
    d = nav.flow_direction(f, 6.5, 15.5)
    check("beside the target the way is straight at it", near(d.x, 0.0 - 1.0) && near(d.z, 0.0))
    check("and a metre off costs a metre", near(nav.flow_cost(f, 6.5, 15.5), 1.0))
    check("two metres off costs two", near(nav.flow_cost(f, 7.5, 15.5), 2.0))
    check("a diagonal step costs its length", near(nav.flow_cost(f, 6.5, 16.5), 1.4))

    // Below the wall, right under the target: the way is not straight up
    // through the wall but off toward the gap, and the cost is the walk
    // round.
    d = nav.flow_direction(f, 5.5, 5.5)
    check("under the wall the way is not straight through it", d.x > 0.5)
    check("and a cell just under the wall points along it", nav.flow_direction(f, 5.5, 9.5).x > 0.99)
    check("and the cost is the walk round, not the crow's flight", nav.flow_cost(f, 5.5, 5.5) > 20.0)

    // Costs fall along the direction: following the field from anywhere
    // reaches the target.
    x = 1.5
    z = 1.5
    steps = 0
    while steps < 200 && nav.flow_has_direction(f, x, z) {
        d = nav.flow_direction(f, x, z)
        before = nav.flow_cost(f, x, z)
        // To the centre of the cell the direction points at.
        x = ((x + d.x * 1.01) as int) as float + 0.5
        z = ((z + d.z * 1.01) as int) as float + 0.5
        check("every step lowers the cost", nav.flow_cost(f, x, z) < before)
        steps = steps + 1
    }
    check("following the field arrives", near(x, 5.5) && near(z, 15.5))
    check("in the walk's length", steps > 20 && steps < 60)

    // A target inside the wall, or off the field, floods nothing.
    check("a target in a wall reaches nothing", nav.flow_build(f, core.vec3(5.5, 0.0, 10.5)) == 0)
    check("a target off the field reaches nothing", nav.flow_build(f, core.vec3(50.0, 0.0, 5.0)) == 0)
    nav.flow_build(f, core.vec3(5.5, 0.0, 15.5))

    // The steer: three zombies' headings, packed like the crowd's columns,
    // turned toward the field under them by at most the turn given.
    pos_block = calloc(9, 8)
    yaw_block = calloc(3, 8)
    pos = pos_block as float[]
    yaw = yaw_block as float[]
    pos[0] = 7.5 ; pos[1] = 0.0 ; pos[2] = 15.5     // beside the target: wants pi (west)
    pos[3] = 5.5 ; pos[4] = 0.0 ; pos[5] = 10.5     // in the wall: keeps its heading
    pos[6] = 5.5 ; pos[7] = 0.0 ; pos[8] = 15.5     // on the target: keeps its heading
    yaw[0] = 0.0
    yaw[1] = 1.0
    yaw[2] = 2.0
    nav.flow_steer(f, pos_block, yaw_block, 3, 0.5)
    check("a heading turns toward the field by the turn allowed", near(yaw[0], 0.5))
    check("a zombie in a wall keeps its heading", near(yaw[1], 1.0))
    check("a zombie on the target keeps its heading", near(yaw[2], 2.0))
    k = 0
    while k < 20 { nav.flow_steer(f, pos_block, yaw_block, 3, 0.5) ; k = k + 1 }
    check("and settles on it", near(yaw[0], 3.14159265))
    free(pos_block)
    free(yaw_block)

    // A cleared field forgets its walls.
    nav.flow_clear(f)
    check("a clear opens the wall", !nav.flow_blocked(f, 5.5, 10.5))
    reached = nav.flow_build(f, core.vec3(5.5, 0.0, 15.5))
    check("and the flood reaches every cell", reached == 400)
    d = nav.flow_direction(f, 5.5, 5.5)
    check("with the wall gone the way is straight up", near(d.x, 0.0) && near(d.z, 1.0))

    nav.flow_free(f)

    footprints()
    prices()
    if failures == 0 {
        println("nav: all checks passed")
        return
    }
    println("nav: ${failures} failure(s)")
    exit(1)
}

// --- footprints from triangles (#817) ----------------------------------------------------------------------------

blocked_count(f: *FlowField) -> int {
    count = 0
    r = 0
    while r < nav.flow_height(f) {
        c = 0
        while c < nav.flow_width(f) {
            if nav.flow_blocked(f, (c as float) + 0.5, (r as float) + 0.5) { count = count + 1 }
            c = c + 1
        }
        r = r + 1
    }
    return count
}

// One cube instanced at each (x, y, z, sx, sy, sz) of `boxes`, unrotated.
boxes_model(boxes: float[], count: int) -> *Model {
    m = loader.cube(1.0)
    core.model_enable_instancing(m, count)
    i = 0
    while i < count {
        b = i * 6
        geometry.inst_set_trs(m.instances, i, boxes[b], boxes[b + 1], boxes[b + 2],
                              boxes[b + 3], boxes[b + 4], boxes[b + 5], 0.0, 0.0, 0.0, 1.0)
        i = i + 1
    }
    core.model_recalculate_bounds(m)
    return m
}

// A shack 5 m by 5 m, walls 0.2 m thick standing on the cells' middles, with a
// doorway 2 m wide in its south wall: cells x 20..25, z 40..45 hold walls,
// the doorway is cells 22 and 23 of row 40.
shack() -> *Model {
    block = calloc(5 * 6, 8)
    b = block as float[]
    // south, west of the door: x 20.4 .. 22
    b[0] = 21.2; b[1] = 1.0; b[2] = 40.5; b[3] = 1.6; b[4] = 2.0; b[5] = 0.2
    // south, east of the door: x 24 .. 25.6
    b[6] = 24.8; b[7] = 1.0; b[8] = 40.5; b[9] = 1.6; b[10] = 2.0; b[11] = 0.2
    // north: x 20.4 .. 25.6
    b[12] = 23.0; b[13] = 1.0; b[14] = 45.5; b[15] = 5.2; b[16] = 2.0; b[17] = 0.2
    // west and east: z 40.4 .. 45.6
    b[18] = 20.5; b[19] = 1.0; b[20] = 43.0; b[21] = 0.2; b[22] = 2.0; b[23] = 5.2
    b[24] = 25.5; b[25] = 1.0; b[26] = 43.0; b[27] = 0.2; b[28] = 2.0; b[29] = 5.2
    m = boxes_model(b, 5)
    free(block)
    return m
}

footprints() {
    f = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)

    // A cube a metre across with its faces on a cell's lines blocks that
    // cell and none of the four it shares a line with.
    cube = loader.cube(1.0)
    core.model_set_position(cube, 5.5, 0.5, 5.5)
    n = nav.flow_block_mesh(f, cube, 0.0 - 0.3, 2.2, 0)
    check("a cube a cell across blocks its one cell (${n})", n == 1 && blocked_count(f) == 1 && nav.flow_blocked(f, 5.5, 5.5))
    check("and again blocks nothing new", nav.flow_block_mesh(f, cube, 0.0 - 0.3, 2.2, 0) == 0)
    core.model_free(cube)
    nav.flow_clear(f)

    // A fence 40 m long and 0.2 m thick blocks the line it runs along; its
    // bounding sphere's square would close 40 m by 40 m.
    fence = loader.cube(1.0)
    core.model_set_scale(fence, 40.0, 1.5, 0.2)
    core.model_set_position(fence, 30.0, 0.75, 20.5)
    n = nav.flow_block_mesh(f, fence, 0.0 - 0.3, 2.2, 0)
    check("a 40 m fence blocks the 40 cells it stands on (${n})", n == 40 && blocked_count(f) == 40)
    check("from x 10 to 49, in row 20", nav.flow_blocked(f, 10.5, 20.5) && nav.flow_blocked(f, 49.5, 20.5) && !nav.flow_blocked(f, 9.5, 20.5) && !nav.flow_blocked(f, 50.5, 20.5))
    check("and not the rows beside it", !nav.flow_blocked(f, 30.5, 19.5) && !nav.flow_blocked(f, 30.5, 21.5))
    square = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)
    nav.flow_block_model(square, fence)
    check("where its bounding square blocks over 1,600", blocked_count(square) > 1600)
    nav.flow_free(square)
    core.model_free(fence)
    nav.flow_clear(f)

    // The same fence turned 45 degrees: the cells along its line, nothing a
    // cell's half-diagonal past it, and no way through it.
    fence = loader.cube(1.0)
    core.model_set_scale(fence, 30.0, 1.5, 0.1)
    core.model_set_rotation(fence, core.quat_from_euler(0.0, 0.7853981633974483, 0.0))
    core.model_set_position(fence, 30.0, 0.75, 30.0)
    nav.flow_block_mesh(f, fence, 0.0 - 0.3, 2.2, 0)
    // Its line: x + z = 60, 15 m each way of (30, 30).
    on_line = true
    near_line = true
    r = 0
    while r < 60 {
        c = 0
        while c < 60 {
            x = (c as float) + 0.5
            z = (r as float) + 0.5
            along = ((x - 30.0) - (z - 30.0)) * 0.7071067811865476
            across = ((x - 30.0) + (z - 30.0)) * 0.7071067811865476
            if across < 0.0 { across = 0.0 - across }
            if along < 0.0 { along = 0.0 - along }
            blocked = nav.flow_blocked(f, x, z)
            if across < 0.01 && along < 14.5 && !blocked { on_line = false }
            if blocked && (across > 0.76 || along > 15.8) { near_line = false }
            c = c + 1
        }
        r = r + 1
    }
    check("a fence on the diagonal blocks every cell its line crosses", on_line)
    check("and none farther than a half-diagonal from it", near_line)
    nav.flow_build(f, core.vec3(25.5, 0.0, 25.5))
    crow = nav.flow_cost(f, 34.5, 34.5)
    check("and nothing walks through it: round its end, not across (${crow} m against 12.7)", crow > 20.0)
    core.model_free(fence)
    nav.flow_clear(f)

    // The band: a water tower's tank, 3 m to 5 m up, blocks nothing; its four
    // legs block their four cells.
    tank = loader.cube(1.0)
    core.model_set_scale(tank, 4.0, 2.0, 4.0)
    core.model_set_position(tank, 12.0, 4.0, 12.0)
    check("a tank over a body's head blocks nothing", nav.flow_block_mesh(f, tank, 0.0 - 0.3, 2.2, 0) == 0)
    core.model_free(tank)
    block = calloc(4 * 6, 8)
    b = block as float[]
    k = 0
    while k < 4 {
        b[k * 6] = 10.5 + ((k % 2) as float) * 3.0
        b[k * 6 + 1] = 1.5
        b[k * 6 + 2] = 10.5 + ((k / 2) as float) * 3.0
        b[k * 6 + 3] = 0.3
        b[k * 6 + 4] = 3.0
        b[k * 6 + 5] = 0.3
        k = k + 1
    }
    legs = boxes_model(b, 4)
    free(block)
    n = nav.flow_block_mesh(f, legs, 0.0 - 0.3, 2.2, 0)
    check("its four legs, instanced, block four cells (${n})", n == 4 && nav.flow_blocked(f, 13.5, 13.5) && !nav.flow_blocked(f, 12.5, 12.5))
    core.model_free(legs)
    nav.flow_clear(f)

    // A shack with a doorway: the walls block, the doorway and the floor
    // inside stay open, and the way in is through the door.
    hut = shack()
    nav.flow_block_mesh(f, hut, 0.0 - 0.3, 2.2, 0)
    check("the shack's doorway is open", !nav.flow_blocked(f, 22.5, 40.5) && !nav.flow_blocked(f, 23.5, 40.5))
    check("and its walls are not", nav.flow_blocked(f, 21.5, 40.5) && nav.flow_blocked(f, 24.5, 40.5) && nav.flow_blocked(f, 23.5, 45.5))
    nav.flow_build(f, core.vec3(23.5, 0.0, 43.5))
    check("a target inside the shack is reached from outside through the door", nav.flow_cost(f, 23.5, 35.5) > 7.9 && nav.flow_cost(f, 23.5, 35.5) < 8.1)
    check("and from behind it, round the walls", nav.flow_cost(f, 23.5, 50.5) > 12.0)
    boxed = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)
    nav.flow_block_model(boxed, hut)
    check("where its bounding square closes the shack, inside too", nav.flow_build(boxed, core.vec3(23.5, 0.0, 43.5)) == 0)
    nav.flow_free(boxed)
    // Grown by a cell for a body's clearance, the doorway closes: what the
    // clearance's prices are for (#819).
    nav.flow_clear(f)
    nav.flow_block_mesh(f, hut, 0.0 - 0.3, 2.2, 1)
    nav.flow_build(f, core.vec3(23.5, 0.0, 43.5))
    check("grown by a cell, the doorway closes", nav.flow_blocked(f, 22.5, 40.5) && nav.flow_cost(f, 23.5, 35.5) < 0.0)
    core.model_free(hut)
    nav.flow_clear(f)

    // Growth is a disc by the flood's measure: two cells round one is the 13
    // within 2 (the four at 2 straight, the four at a diagonal, the four
    // beside, itself), and one cell round a row of 20 adds the rows on each
    // side and one cell at each end, 62. A solid 10 by 10 grown by one adds
    // a row on each of its sides and not its corners, 140. (The row is
    // stamped, the solid measured over its box; the counts are the same
    // rule's.)
    cube = loader.cube(1.0)
    core.model_set_position(cube, 30.5, 0.5, 30.5)
    n = nav.flow_block_mesh(f, cube, 0.0 - 0.3, 2.2, 2)
    check("a cell grown by two is 13 cells (${n})", n == 13 && nav.flow_blocked(f, 32.5, 30.5) && nav.flow_blocked(f, 31.5, 31.5) && !nav.flow_blocked(f, 32.5, 31.5))
    nav.flow_clear(f)
    core.model_set_scale(cube, 20.0, 1.0, 1.0)
    core.model_set_position(cube, 30.0, 0.5, 30.5)
    n = nav.flow_block_mesh(f, cube, 0.0 - 0.3, 2.2, 1)
    check("a row of 20 grown by one is 62 cells (${n})", n == 62)
    nav.flow_clear(f)
    core.model_set_scale(cube, 10.0, 1.0, 10.0)
    core.model_set_position(cube, 30.0, 0.5, 30.0)
    n = nav.flow_block_mesh(f, cube, 0.0 - 0.3, 2.2, 1)
    check("a solid 10 by 10 grown by one is 140 cells (${n})", n == 140 && !nav.flow_blocked(f, 24.5, 24.5) && nav.flow_blocked(f, 24.5, 25.5))
    core.model_free(cube)
    nav.flow_clear(f)

    // A lone panel with no thickness, standing on a cell line: the cells
    // behind its face, one row, and no way through.
    panel = loader.quad(4.0, 1.5)
    core.model_set_rotation(panel, core.quat_from_euler(1.5707963267948966, 0.0, 0.0))
    core.model_set_position(panel, 50.0, 0.75, 30.0)
    n = nav.flow_block_mesh(f, panel, 0.0 - 0.3, 2.2, 0)
    check("a panel on a cell line blocks one row of cells (${n})", n == 4 && nav.flow_blocked(f, 50.5, 29.5) && !nav.flow_blocked(f, 50.5, 30.5))
    core.model_free(panel)
    nav.flow_clear(f)

    // Points (particles) are no footprint.
    dust = loader.cube(1.0)
    core.model_enable_instancing(dust, 3)
    geometry.inst_enable_points(dust.instances)
    check("a model drawn as points blocks nothing", nav.flow_block_mesh(f, dust, 0.0 - 0.3, 2.2, 0) == 0)
    core.model_free(dust)

    nav.flow_free(f)
}

// --- prices and the clearance (#819) -----------------------------------------------------------------------------

// Every cell with a way points at a neighbour whose cost and the step to it
// add to its own, to the tenth, and following the ways from every cell
// reaches the target: the field's ways are its costs' own walks.
ways_are_walks(f: *FlowField, tx: float, tz: float) -> bool {
    ok = true
    r = 0
    while r < nav.flow_height(f) {
        c = 0
        while c < nav.flow_width(f) {
            x = (c as float) + 0.5
            z = (r as float) + 0.5
            if nav.flow_has_direction(f, x, z) {
                d = nav.flow_direction(f, x, z)
                sx = 0
                sz = 0
                if d.x > 0.1 { sx = 1 }
                if d.x < 0.0 - 0.1 { sx = 0 - 1 }
                if d.z > 0.1 { sz = 1 }
                if d.z < 0.0 - 0.1 { sz = 0 - 1 }
                here = (nav.flow_cost(f, x, z) * 10.0 + 0.5) as int
                there = (nav.flow_cost(f, x + (sx as float), z + (sz as float)) * 10.0 + 0.5) as int
                p = nav.flow_price(f, x, z)
                step = 10 + p
                if sx != 0 && sz != 0 { step = 14 + (p * 14) / 10 }
                if here - there != step { ok = false }
                // Walked to the end: no loop, and the end is the target's cell.
                wx = x
                wz = z
                steps = 0
                while steps < 10000 && nav.flow_has_direction(f, wx, wz) {
                    e = nav.flow_direction(f, wx, wz)
                    wx = ((wx + e.x * 1.01) as int) as float + 0.5
                    wz = ((wz + e.z * 1.01) as int) as float + 0.5
                    steps = steps + 1
                }
                if !(near(wx, tx) && near(wz, tz)) { ok = false }
            }
            c = c + 1
        }
        r = r + 1
    }
    return ok
}

same_prices(a: *FlowField, b: *FlowField) -> bool {
    r = 0
    while r < nav.flow_height(a) {
        c = 0
        while c < nav.flow_width(a) {
            x = (c as float) + 0.5
            z = (r as float) + 0.5
            if nav.flow_price(a, x, z) != nav.flow_price(b, x, z) { return false }
            c = c + 1
        }
        r = r + 1
    }
    return true
}

prices() {
    f = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)

    // A dear strip across the way: crossing it when it is cheap, round it
    // when going round costs less than its price.
    nav.flow_cost_rect(f, 20.0, 0.0, 20.9, 30.9, 2)
    nav.flow_build(f, core.vec3(35.5, 0.0, 20.5))
    check("a cell of price 2 crossed adds 0.2 m (${nav.flow_cost(f, 5.5, 20.5)})", near(nav.flow_cost(f, 5.5, 20.5), 30.2))
    check("its price reads back", nav.flow_price(f, 20.5, 10.5) == 2 && nav.flow_price(f, 21.5, 10.5) == 0)
    nav.flow_cost_rect(f, 20.0, 0.0, 20.9, 30.9, 300)
    nav.flow_build(f, core.vec3(35.5, 0.0, 20.5))
    round = nav.flow_cost(f, 5.5, 20.5)
    check("at 300 the walk goes round its end (${round} m, under the 60 m across)", round > 30.5 && round < 50.0)
    check("and the strip still has ways out of it", nav.flow_has_direction(f, 20.5, 10.5))
    check("the ways are the costs' walks", ways_are_walks(f, 35.5, 20.5))
    nav.flow_cost_rect(f, 20.0, 0.0, 20.9, 30.9, 0)
    nav.flow_build(f, core.vec3(35.5, 0.0, 20.5))
    check("priced back to 0, the walk is straight again", near(nav.flow_cost(f, 5.5, 20.5), 30.0))

    // The clearance: two cells, 30 beside a wall, falling evenly to 15 at two
    // cells (straight) and 24 at a diagonal, by the flood's own measure.
    nav.flow_block(f, 10.0, 10.0, 29.9, 10.9)          // row 10, x 10..29
    nav.flow_clearance(f, 2, 30)
    check("beside a wall a cell costs the clearance's price", nav.flow_price(f, 15.5, 11.5) == 30 && nav.flow_price(f, 15.5, 9.5) == 30)
    check("two cells off, half of it", nav.flow_price(f, 15.5, 12.5) == 15)
    check("three cells off, nothing", nav.flow_price(f, 15.5, 13.5) == 0)
    check("a diagonal off the wall's end, by the chamfer", nav.flow_price(f, 30.5, 11.5) == 24 && nav.flow_price(f, 31.5, 10.5) == 15)
    nav.flow_build(f, core.vec3(20.5, 0.0, 20.5))
    check("a cell beside the wall still has a way", nav.flow_has_direction(f, 15.5, 9.5))
    check("the field round a wall at a distance: its ways are its walks", ways_are_walks(f, 20.5, 20.5))
    // The wall torn down takes its margin with it.
    nav.flow_open(f, 10.0, 10.0, 29.9, 10.9)
    check("a wall torn down opens its cells and its margin", !nav.flow_blocked(f, 15.5, 10.5) && nav.flow_price(f, 15.5, 11.5) == 0)
    nav.flow_free(f)

    // The doorway that blocking a margin closed: with a clearance instead,
    // the walls keep their margin and the door stays a way in.
    f = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)
    hut = shack()
    nav.flow_clearance(f, 2, 30)
    nav.flow_block_mesh(f, hut, 0.0 - 0.3, 2.2, 0)
    nav.flow_build(f, core.vec3(23.5, 0.0, 43.5))
    door = nav.flow_cost(f, 23.5, 35.5)
    check("with a clearance the doorway stays a way in (${door} m)", door > 8.0 && door < 20.0)
    check("a body against a wall inside has a way out of the margin", nav.flow_has_direction(f, 21.5, 44.5))
    check("the doorway's cells are dear but open", !nav.flow_blocked(f, 22.5, 40.5) && nav.flow_price(f, 22.5, 40.5) > 0)
    check("a body's way through the shack field is its walk", ways_are_walks(f, 23.5, 43.5))

    // Priced as the walls go up is priced as if all were there at once.
    g = nav.flow_new(0.0, 0.0, 59.0, 59.0, 1.0)
    nav.flow_block_mesh(g, hut, 0.0 - 0.3, 2.2, 0)
    nav.flow_block(f, 40.0, 5.0, 41.9, 30.9)
    nav.flow_block(g, 40.0, 5.0, 41.9, 30.9)
    nav.flow_cost_rect(f, 5.0, 5.0, 8.9, 8.9, 50)
    nav.flow_cost_rect(g, 5.0, 5.0, 8.9, 8.9, 50)
    nav.flow_open(f, 40.0, 15.0, 41.9, 16.9)
    nav.flow_open(g, 40.0, 15.0, 41.9, 16.9)
    nav.flow_price(f, 0.0, 0.0)
    nav.flow_block(f, 45.0, 45.0, 45.9, 58.9)
    nav.flow_block(g, 45.0, 45.0, 45.9, 58.9)
    nav.flow_clearance(g, 2, 30)
    check("prices kept up as walls go up and down are the prices made at once", same_prices(f, g))
    core.model_free(hut)
    nav.flow_free(g)
    nav.flow_free(f)

    // A field so large that a walk at MAX_PRICE could pass an int caps its
    // prices: 1240 by 1240 cells, 1.54 million, at 987.
    big = nav.flow_new(0.0, 0.0, 1239.0, 1239.0, 1.0)
    nav.flow_cost_rect(big, 0.0, 0.0, 0.5, 0.5, 5000)
    check("a price on a field of 1.54 million cells is capped where no walk can overflow (${nav.flow_price(big, 0.25, 0.25)})", nav.flow_price(big, 0.25, 0.25) == 987)
    nav.flow_free(big)
    small = nav.flow_new(0.0, 0.0, 9.0, 9.0, 1.0)
    nav.flow_cost_rect(small, 0.0, 0.0, 0.5, 0.5, 5000)
    check("and at MAX_PRICE on one that cannot", nav.flow_price(small, 0.25, 0.25) == nav.MAX_PRICE)
    nav.flow_free(small)
}
