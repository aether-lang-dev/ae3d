// The sea mirrors the sky the engine drew, and knows whether the eye is
// above it or under it (#742), on OpenGL and Vulkan alike.
//
// A flat green sky (the clear colour, captured as every sky is) and a sea
// whose own sky colour is set red, to tell the two apart:
//   - mirroring the captured sky, seen from three metres up, the sea is
//     green, not red: it reflects what the engine drew, and the eye a few
//     metres over the swell is above it (a fixed level five metres over the
//     sea took that eye for under, and drew the underside);
//   - ten metres under, the eye sees the underside, lit by the sea's own
//     sky colour: red.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.vulkan
import ae3d.water

const WIDTH = 240
const HEIGHT = 135

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

struct Mean {
    r: float
    g: float
    b: float
}

// The mean colour of the frame's lower half: the sea.
lower_mean(pixels: ptr, flipped: bool) -> Mean {
    r = 0.0
    g = 0.0
    b = 0.0
    n = 0
    y = HEIGHT / 2 + 8
    while y < HEIGHT {
        row = y
        if flipped { row = HEIGHT - 1 - y }
        x = 0
        while x < WIDTH {
            at = (row * WIDTH + x) * 4
            r = r + mem.get_byte(pixels, at) as float
            g = g + mem.get_byte(pixels, at + 1) as float
            b = b + mem.get_byte(pixels, at + 2) as float
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return Mean { r: r / (n as float), g: g / (n as float), b: b / (n as float) }
}

sea() -> *Simulation {
    w = water.simulation_new(400.0, 0.4)
    water.simulation_set_wave_scale(w, 400.0)
    water.simulation_set_sky_color(w, 1.0, 0.0, 0.0)
    water.simulation_set_color(w, 0.03, 0.05, 0.06)
    water.simulation_set_opacity(w, 0.97)
    water.simulation_set_sky_capture(w, true)
    water.simulation_build(w, 64)
    return w
}

// The sea from `height` metres over its level, looking along it.
view(backend: *Backend, w: *Simulation, height: float, pixels_of: fn(ptr) -> ptr, context: ptr, flipped: bool) -> Mean {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, height, 0.0))
    core.camera_set_far(cam, 2000.0)
    if height > 0.0 {
        core.camera_look_at(cam, core.vec3(0.0, height - 2.5, 0.0 - 20.0))
    } else {
        // Under it, looking up at the underside ahead.
        core.camera_look_at(cam, core.vec3(0.0, height + 6.0, 0.0 - 20.0))
    }
    light = core.light_sun(core.vec3(0.3, 0.8, 0.2))
    core.backend_set_clear_color(backend, 0.1, 0.8, 0.1)
    i = 0
    while i < 4 {
        water.simulation_update(w, 0.016)
        core.backend_render(backend, cam, light)
        i = i + 1
    }
    m = lower_mean(pixels_of(context), flipped)
    if height < 0.0 {
        // Looking up: the underside fills the upper half instead.
        m = upper_mean(pixels_of(context), flipped)
    }
    core.light_free(light)
    core.camera_free(cam)
    return m
}

upper_mean(pixels: ptr, flipped: bool) -> Mean {
    r = 0.0
    g = 0.0
    b = 0.0
    n = 0
    y = 0
    while y < HEIGHT / 2 - 8 {
        row = y
        if flipped { row = HEIGHT - 1 - y }
        x = 0
        while x < WIDTH {
            at = (row * WIDTH + x) * 4
            r = r + mem.get_byte(pixels, at) as float
            g = g + mem.get_byte(pixels, at + 1) as float
            b = b + mem.get_byte(pixels, at + 2) as float
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return Mean { r: r / (n as float), g: g / (n as float), b: b / (n as float) }
}

judge(name: string, above: Mean, below: Mean) {
    println("  ${name}: from 3 m up the sea is ${above.r}, ${above.g}, ${above.b}; from 10 m under its underside ${below.r}, ${below.g}, ${below.b}")
    check("${name}: from a few metres up the sea mirrors the captured green sky, not its own red (it is seen from above)",
          above.g > above.r * 1.3 && above.g > above.b)
    check("${name}: from under it the underside shows, lit by the sea's own red sky colour", below.r > below.g && below.r > below.b)
}

gl_pixels(context: ptr) -> ptr { return offscreen.target_pixels(context) }
vk_pixels(context: ptr) -> ptr { return core.backend_frame_pixels(context as *Backend) }

main() {
    println("water sky: the sea mirrors the sky the engine drew (#742)")
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  opengl: SKIP no OpenGL context available")
    } else {
        renderer = gl.renderer_new()
        backend = gl.backend(renderer)
        if core.backend_init(&backend, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            w = sea()
            core.backend_add_model(&backend, water.simulation_model(w))
            above = view(&backend, w, 3.0, gl_pixels, target, false)
            below = view(&backend, w, 0.0 - 10.0, gl_pixels, target, false)
            judge("opengl", above, below)
            core.backend_remove_model(&backend, water.simulation_model(w))
            water.simulation_free(w)
            offscreen.target_destroy(target)
        } else {
            println("  opengl: SKIP the backend would not initialise")
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }
    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
    } else {
        vrenderer = vulkan.renderer_new()
        vbackend = vulkan.backend(vrenderer)
        if core.backend_init(&vbackend, null, WIDTH, HEIGHT) {
            w = sea()
            core.backend_add_model(&vbackend, water.simulation_model(w))
            above = view(&vbackend, w, 3.0, vk_pixels, (&vbackend) as ptr, false)
            below = view(&vbackend, w, 0.0 - 10.0, vk_pixels, (&vbackend) as ptr, false)
            judge("vulkan", above, below)
            core.backend_remove_model(&vbackend, water.simulation_model(w))
            water.simulation_free(w)
        } else {
            println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        }
        vulkan.renderer_free(vrenderer)
    }
    if g_failures == 0 {
        println("water sky: all checks passed")
    } else {
        println("water sky: ${g_failures} failure(s)")
    }
}
