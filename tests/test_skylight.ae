// The split-sum table the sky's reflections are scaled by (#655).
//
// It conserves energy: a smooth surface seen head-on gives back all of
// F0's light (scale plus bias one), and a rough one at a graze less; and
// the bias -- the Fresnel rise -- grows as the view grazes.
import ae3d.skylight

extern free(p: ptr)

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

main() {
    println("skylight: the split-sum table")
    lut = skylight.brdf_lut() as float[]
    size = skylight.LUT_SIZE
    smooth_on = (0 * size + (size - 1)) * 2
    smooth_graze = (0 * size + 0) * 2
    rough_graze = ((size - 1) * size + 0) * 2
    smooth_total = lut[smooth_on] + lut[smooth_on + 1]
    rough_total = lut[rough_graze] + lut[rough_graze + 1]
    println("  smooth head-on ${lut[smooth_on]} + ${lut[smooth_on + 1]}, smooth at a graze ${lut[smooth_graze]} + ${lut[smooth_graze + 1]}, rough at a graze ${lut[rough_graze]} + ${lut[rough_graze + 1]}")
    d = smooth_total - 1.0
    if d < 0.0 { d = 0.0 - d }
    check("a smooth surface seen head-on gives back all of F0's light", d < 0.03)
    check("a rough one at a graze gives back less", rough_total < smooth_total * 0.9)
    check("the Fresnel rise grows as the view grazes", lut[smooth_graze + 1] > lut[smooth_on + 1] + 0.3)
    free(lut as ptr)
    if failures == 0 {
        println("skylight: all checks passed")
    } else {
        println("skylight: ${failures} failure(s)")
    }
}
