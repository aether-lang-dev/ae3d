// Physical animation (#858, ae3d.physanim), held to numbers: the UE5
// mannequin made a person (ae3d.character) walking at 1 m/s in a world with
// physics, its ragdoll following its animated pose, beside a twin with none
// asked the same in an engine of its own. No window; stepped at 60 Hz.
//
//   - every body's weight 0: every joint drawn within 1e-6 of the twin's
//     (the animation exactly);
//   - struck in the chest from behind, still walking: the chest drawn off
//     the twin's (over 3 degrees), back on it (within half a degree) once
//     the hit has eased out; on its walk all the while (its legs on the
//     animation), where the twin walks (its object within 1 mm of the
//     twin's), its toes not skating 5 mm;
//   - easing back, no joint turns faster than the takes' own fastest plus
//     what the easing itself needs;
//   - a measured cost a figure a step: the physics' step and the drawing,
//     for eight figures, under 0.5 ms each;
//   - through the character (character.hit), the mannequin on the struck
//     graph (its hit_head and hit_chest flinches): struck at a point, its
//     ragdoll put on at the blow, the nearest body taken, the head flinch
//     played from its start; struck by name, the chest flinch, and once
//     eased out the figure drawn as its graph has it.

import std.os
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.metrics
import ae3d.physanim
import ae3d.animgraph

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const STRUCK = "tests/fixtures/graphs/struck.graph"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    la = core.sqrt_of(a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w)
    lb = core.sqrt_of(b.x * b.x + b.y * b.y + b.z * b.z + b.w * b.w)
    if la < 0.000001 || lb < 0.000001 { return 0.0 }
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w) / (la * lb)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// The most any joint of `p` is off `q`'s, turned (radians) or moved (the
// rig's units), local poses of one rig.
apart(r: *pose.Rig, p: ptr, q: ptr) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        d = turned_by(pose.rotation(p, j), pose.rotation(q, j))
        if d > most { most = d }
        t = core.v3_len(core.v3_sub(pose.translation(p, j), pose.translation(q, j)))
        if t > most { most = t }
        j = j + 1
    }
    return most
}

// A joint's turn in the rig's space, `w` a pose's worlds.
joint_off(r: *pose.Rig, p: ptr, q: ptr, wp: ptr, wq: ptr, j: int) -> float {
    pose.world(r, p, wp)
    pose.world(r, q, wq)
    return turned_by(pose.rotation(wp, j), pose.rotation(wq, j))
}

fastest_turn(r: *pose.Rig, p: ptr, q: ptr, dt: float) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        t = turned_by(pose.rotation(p, j), pose.rotation(q, j)) / dt
        if t > most { most = t }
        j = j + 1
    }
    return most
}

person(e: *Engine, name: string, x: float, g: *Gaits) -> *Character {
    c = character.humanoid(e, name, MANNEQUIN, g)
    if c == null { return null }
    behaviour.object_set_position(character.object_of(c), core.vec3(x, 0.0, 0.0))
    mover.settle(character.mover_of(c))
    return c
}

main() {
    println("physanim: physical animation, body by body (#858)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = person(e, "Struck", 0.0, g)
    // The twin in an engine of its own, where the figure is: beside it, its
    // feet's sums rounded otherwise, 0.00009 off.
    e_t = engine.engine_new()
    engine.engine_set_fixed_step(e_t, STEP)
    physics.attach(e_t)
    floor_t = engine.object(e_t, "Floor", null)
    behaviour.object_set_position(floor_t, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor_t, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    twin = person(e_t, "Twin", 0.0, g)
    check("two people made: ${character.error()}", c != null && twin != null)
    if c == null || twin == null { exit(1) }
    a = character.animator_of(c)
    ta = character.animator_of(twin)
    r = animator.rig(a)
    pa = physanim.attach(e, a)
    check("its ragdoll on its figure, a body a ragdoll bone", pa != null && physanim.bones(pa) >= 12)
    if pa == null { exit(1) }
    m = metrics.meter_new(r, character.object_of(c))
    metrics.meter_ground_physics(m, physics.of(e))
    ahead = core.vec3(0.0, 0.0, 1.0)
    // Walking, every weight 0.
    worst_zero = 0.0
    k = 0
    while k < 180 {
        character.move(c, ahead, core.vec3(0.0, 0.0, 0.0))
        character.move(twin, ahead, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        engine.engine_update(e_t, STEP)
        metrics.meter_take(m, STEP)
        d = apart(r, animator.pose_shown(a), animator.pose_shown(ta))
        if d > worst_zero { worst_zero = d }
        k = k + 1
    }
    println("  walking 3 s, every body's weight 0: every joint within ${worst_zero} of the twin's")
    check("every weight 0, the figure is drawn as its animation, exactly (within 1e-6 of a twin with none)", worst_zero < 0.000001)
    // Struck in the chest from behind.
    chest = physanim.bone_named(pa, "Chest")
    joint = pose.human(r, pose.SPINE_03)
    at = behaviour.object_position(character.object_of(c))
    physanim.hit(pa, chest, core.vec3(at.x, at.y + 1.35, at.z - 0.1), core.vec3(0.0, 0.0, 40.0))
    wp = pose.new(r)
    wq = pose.new(r)
    before = pose.new(r)
    most_off = 0.0
    back = 1000.0
    fastest_easing = 0.0
    strayed = 0.0
    walking = true
    metrics.meter_reset(m)
    steps = ((physanim.HIT_HOLD + physanim.HIT_RECOVER + 0.4) / STEP) as int
    k = 0
    while k < steps {
        pose.copy(r, animator.pose_shown(a), before)
        character.move(c, ahead, core.vec3(0.0, 0.0, 0.0))
        character.move(twin, ahead, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        engine.engine_update(e_t, STEP)
        metrics.meter_take(m, STEP)
        off = joint_off(r, animator.pose_shown(a), animator.pose_shown(ta), wp, wq, joint)
        if off > most_off { most_off = off }
        now = (k as float) * STEP
        if now > physanim.HIT_HOLD + 0.02 {
            x = fastest_turn(r, before, animator.pose_shown(a), STEP)
            if x > fastest_easing { fastest_easing = x }
        }
        if now > physanim.HIT_HOLD + physanim.HIT_RECOVER + 0.1 { back = off }
        gone = core.v3_len(core.v3_sub(behaviour.object_position(character.object_of(c)), behaviour.object_position(character.object_of(twin))))
        if gone > strayed { strayed = gone }
        if animator.current(a) != character.move_state(c) { walking = false }
        k = k + 1
    }
    skated = metrics.meter_worst(m, metrics.SKATE)
    println("  struck in the chest (40 N s from behind) at a walk: the chest ${most_off * 57.29578} degrees off the twin's at most, ${back * 57.29578} once eased out; walking ${walking}, ${strayed * 1000.0} mm off the twin's place; a toe skated ${skated * 1000.0} mm")
    check("struck in the chest, the chest is drawn off the animation (over 3 degrees) and back on it (within half a degree)", most_off > 0.0524 && back < 0.00873)
    // Its place, not only its toes: the meter starts a stance only on a foot
    // slower over the ground than a step's, and a figure carried off by its
    // shoved hips at 18 m/s read 0 mm.
    check("and it keeps walking where its twin walks (within 1 mm), its toes not skating 5 mm", walking && strayed < 0.001 && skated < 0.005)
    // The takes' own fastest, from the twin walking alike.
    own = 0.0
    k = 0
    while k < 60 {
        pose.copy(r, animator.pose_shown(ta), before)
        character.move(twin, ahead, core.vec3(0.0, 0.0, 0.0))
        character.move(c, ahead, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        engine.engine_update(e_t, STEP)
        x = fastest_turn(r, before, animator.pose_shown(ta), STEP)
        if x > own { own = x }
        k = k + 1
    }
    allowed = own + 1.875 * most_off / physanim.HIT_RECOVER
    println("  easing back: the fastest joint turn ${fastest_easing} rad/s, the walk's own ${own} plus the easing's ${allowed}")
    check("easing back, no joint turns faster than the takes' own fastest plus what the easing needs", fastest_easing <= allowed * 1.02)
    pose.release(wp)
    pose.release(wq)
    pose.release(before)
    metrics.meter_free(m)
    physanim.physanim_free(pa)
    character.character_free(c)
    character.character_free(twin)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    physics.physics_free(physics.of(e_t))
    figure.figures_free(e_t)
    engine.engine_free(e_t)
    // The cost: eight people walking, each with its ragdoll, the step timed.
    e2 = engine.engine_new()
    engine.engine_set_fixed_step(e2, STEP)
    physics.attach(e2)
    floor2 = engine.object(e2, "Floor", null)
    behaviour.object_set_position(floor2, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor2, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    people = [null as *Character, null as *Character, null as *Character, null as *Character, null as *Character, null as *Character, null as *Character, null as *Character]
    rags = [null as *Physanim, null as *Physanim, null as *Physanim, null as *Physanim, null as *Physanim, null as *Physanim, null as *Physanim, null as *Physanim]
    k = 0
    while k < 8 {
        people[k] = person(e2, "Crowd", (k as float) * 2.0, g)
        rags[k] = physanim.attach(e2, character.animator_of(people[k]))
        k = k + 1
    }
    k = 0
    while k < 60 {
        n = 0
        while n < 8 {
            character.move(people[n], ahead, core.vec3(0.0, 0.0, 0.0))
            n = n + 1
        }
        engine.engine_update(e2, STEP)
        k = k + 1
    }
    // Struck each, so their drawing runs too.
    n = 0
    while n < 8 {
        p_at = behaviour.object_position(character.object_of(people[n]))
        physanim.hit(rags[n], physanim.bone_named(rags[n], "ShoulderL"), core.vec3(p_at.x + 0.2, p_at.y + 1.3, p_at.z), core.vec3(0.0 - 10.0, 0.0, 0.0))
        n = n + 1
    }
    started = os.now_monotonic_ns()
    k = 0
    while k < 60 {
        n = 0
        while n < 8 {
            character.move(people[n], ahead, core.vec3(0.0, 0.0, 0.0))
            n = n + 1
        }
        engine.engine_update(e2, STEP)
        k = k + 1
    }
    with_rags = ((os.now_monotonic_ns() - started) as float) / 1000000.0 / 60.0
    n = 0
    while n < 8 {
        physanim.physanim_free(rags[n])
        n = n + 1
    }
    started = os.now_monotonic_ns()
    k = 0
    while k < 60 {
        n = 0
        while n < 8 {
            character.move(people[n], ahead, core.vec3(0.0, 0.0, 0.0))
            n = n + 1
        }
        engine.engine_update(e2, STEP)
        k = k + 1
    }
    without = ((os.now_monotonic_ns() - started) as float) / 1000000.0 / 60.0
    per = (with_rags - without) / 8.0
    println("  eight people walking: a step ${with_rags} ms with their ragdolls, ${without} ms without: ${per} ms a figure")
    check("a measured cost a figure a step, its ragdoll's step and its drawing: under 0.5 ms", per < 0.5)
    n = 0
    while n < 8 {
        character.character_free(people[n])
        n = n + 1
    }
    character.gaits_free(g)
    physics.physics_free(physics.of(e2))
    figure.figures_free(e2)
    engine.engine_free(e2)
    // Through the character (#903): a figure on a graph with flinches.
    e3 = engine.engine_new()
    engine.engine_set_fixed_step(e3, STEP)
    physics.attach(e3)
    floor3 = engine.object(e3, "Floor", null)
    behaviour.object_set_position(floor3, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor3, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    gs = character.graphed(e3, "Standing", MANNEQUIN, STRUCK)
    check("a figure on the struck graph made: ${character.error()}", gs != null)
    if gs == null { exit(1) }
    mover.settle(character.mover_of(gs))
    ga = character.animator_of(gs)
    gr = character.graph_of(gs)
    head_layer = animgraph.layer_of(gr, "hit_head")
    chest_layer = animgraph.layer_of(gr, "hit_chest")
    k = 0
    while k < 30 {
        engine.engine_update(e3, STEP)
        k = k + 1
    }
    at = behaviour.object_position(character.object_of(gs))
    no_rag = character.physanim_of(gs) == null
    took = character.hit(gs, "", core.vec3(at.x, at.y + 1.6, at.z - 0.1), core.vec3(0.0, 0.0, 15.0))
    gp = character.physanim_of(gs)
    neck = 0 - 1
    if gp != null { neck = physanim.bone_named(gp, "Neck") }
    engine.engine_update(e3, STEP)
    head_t = animator.layer_time(ga, head_layer)
    neck_w = 0.0
    if gp != null { neck_w = physanim.weight_of(gp, neck) }
    println("  struck at the head by where it lands: ragdoll put on at the blow ${no_rag && gp != null}, its neck's weight ${neck_w}, the head flinch ${head_t} s in")
    check("character.hit at a point: its ragdoll put on at the first blow, the body nearest struck (the neck), its graph's head flinch played from its start", took && no_rag && gp != null && neck_w > 0.999 && head_t > 0.0 && head_t < 2.5 * STEP)
    k = 0
    while k < 60 {
        engine.engine_update(e3, STEP)
        k = k + 1
    }
    took = character.hit(gs, "Chest", core.vec3(at.x, at.y + 1.35, at.z - 0.1), core.vec3(0.0, 0.0, 15.0))
    engine.engine_update(e3, STEP)
    chest_t = animator.layer_time(ga, chest_layer)
    k = 0
    while k < ((physanim.HIT_HOLD + physanim.HIT_RECOVER + 0.2) / STEP) as int {
        engine.engine_update(e3, STEP)
        k = k + 1
    }
    still = 0.0
    j = 0
    while j < physanim.bones(gp) {
        if physanim.weight_of(gp, j) > still { still = physanim.weight_of(gp, j) }
        j = j + 1
    }
    rest = apart(animator.rig(ga), animator.pose_shown(ga), animator.pose_now(ga))
    println("  struck in the chest by name: the chest flinch ${chest_t} s in; once eased out every weight ${still}, drawn ${rest} off the graph's pose")
    check("character.hit by name: its chest flinch played, and once eased out the figure drawn as its graph has it", took && chest_t > 0.0 && chest_t < 2.5 * STEP && still == 0.0 && rest < 0.000001)
    character.character_free(gs)
    physics.physics_free(physics.of(e3))
    figure.figures_free(e3)
    engine.engine_free(e3)
    if g_failures == 0 {
        println("physanim: all checks passed (${g_checks})")
        return
    }
    println("physanim: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
