// Solid characters steering round each other (#956), held to numbers. The
// UE5 mannequin on 100STYLE's neutral gaits, its capsule solid
// (physics.character_set_solid), asked each frame to walk at 1.2 m/s toward
// a point 6 m beyond the others' start. No window, the engine stepped by
// hand.
//
//   - two walking at each other head on, and four crossing at a point from
//     four ways: each reaches its point within 2 s of the time it takes
//     walking there alone, steering round the others (character.steer,
//     reciprocal: each takes half the turn). Asked straight at each other
//     with nothing steering, two walked into each other and stopped 0.56 m
//     apart until both gave the walk up;
//   - no two capsules' axes come nearer than their two radii, less the
//     mover's 5 mm slop and a millimetre;
//   - two side by side, each turned across the other's way, never touch
//     and both arrive: each way weighed by where the mover's curve really
//     takes it (mover.path). Weighed as if taken at once, the two touched
//     and the slower took 18.9 s (13.6 s weighed by the curve);
//   - no toe skates 5 mm;
//   - a standing figure turned half round, on the spot or to walk off
//     behind it, faces within 5 degrees of where its mover's way ahead
//     (mover.path_ways) said it would, frame by frame (#976).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.metrics

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const WALK = 1.2
const BEYOND = 6.0
const ARRIVED = 0.3
const FRAMES_MOST = 2400

var g_checks = 0
var g_failures = 0

check(what: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${what}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${what}")
    }
}

// The walkers from `starts` (count of them) each to the point BEYOND past
// the start facing it across the middle (`turn_at` seconds on, when above
// 0, each to its point in `turns` instead, x and z): the most seconds any
// took to arrive, the nearest two capsules' axes came less their radii
// (metres, below 0 inside), and the worst toe skate.
walk_across(starts: float[], count: int, turn_at: float, turns: float[]) -> (float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    people = calloc(count, 8) as ptr[]
    goals = calloc(count * 3, 8) as float[]
    meters = calloc(count, 8) as ptr[]
    arrived = calloc(count, 8) as float[]
    k = 0
    while k < count {
        c = character.humanoid(e, "Walker", MANNEQUIN, g)
        if c == null {
            println("  ${character.error()}")
            exit(1)
        }
        o = character.object_of(c)
        sx = starts[k * 2]
        sz = starts[k * 2 + 1]
        behaviour.object_set_position(o, core.vec3(sx, 0.0, sz))
        // Facing the middle, its point BEYOND past the start across from it.
        across = core.v3_normalize(core.vec3(0.0 - sx, 0.0, 0.0 - sz))
        behaviour.object_set_rotation(o, core.quat_rotate(core.atan2_of(across.x, across.z), core.vec3(0.0, 1.0, 0.0)))
        mover.settle(character.mover_of(c))
        physics.character_set_solid(physics.character_of(o), true)
        goals[k * 3] = 0.0 - sx + across.x * BEYOND
        goals[k * 3 + 2] = 0.0 - sz + across.z * BEYOND
        people[k] = c as ptr
        arrived[k] = 0.0 - 1.0
        k = k + 1
    }
    f = 0
    while f < 30 {
        engine.engine_update(e, STEP)
        f = f + 1
    }
    k = 0
    while k < count {
        c = people[k] as *Character
        meters[k] = metrics.meter_new(animator.rig(character.animator_of(c)), character.object_of(c)) as ptr
        k = k + 1
    }
    nearest = 1000.0
    f = 0
    left = count
    while f < FRAMES_MOST && left > 0 {
        if turn_at > 0.0 && f == (turn_at / STEP) as int {
            k = 0
            while k < count {
                goals[k * 3] = turns[k * 2]
                goals[k * 3 + 2] = turns[k * 2 + 1]
                k = k + 1
            }
        }
        k = 0
        while k < count {
            c = people[k] as *Character
            at = behaviour.object_position(character.object_of(c))
            to = core.vec3(goals[k * 3] - at.x, 0.0, goals[k * 3 + 2] - at.z)
            if arrived[k] < 0.0 && core.v3_len(to) < ARRIVED {
                arrived[k] = (f as float) * STEP
                left = left - 1
            }
            if arrived[k] < 0.0 {
                character.move(c, core.v3_mul(core.v3_normalize(to), WALK), core.vec3(0.0, 0.0, 0.0))
            } else {
                character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
            }
            k = k + 1
        }
        engine.engine_update(e, STEP)
        k = 0
        while k < count {
            c = people[k] as *Character
            metrics.meter_take(meters[k] as *Meter, STEP)
            j = k + 1
            while j < count {
                a_at = behaviour.object_position(character.object_of(c))
                b_at = behaviour.object_position(character.object_of(people[j] as *Character))
                ra = physics.character_radius(physics.character_of(character.object_of(c)))
                rb = physics.character_radius(physics.character_of(character.object_of(people[j] as *Character)))
                gap = core.v3_len(core.vec3(a_at.x - b_at.x, 0.0, a_at.z - b_at.z)) - ra - rb
                if gap < nearest { nearest = gap }
                j = j + 1
            }
            k = k + 1
        }
        f = f + 1
    }
    most = 0.0
    skate = 0.0
    k = 0
    while k < count {
        took = arrived[k]
        if took < 0.0 { took = (FRAMES_MOST as float) * STEP }
        if took > most { most = took }
        s = metrics.meter_worst(meters[k] as *Meter, metrics.SKATE)
        if s > skate { skate = s }
        metrics.meter_free(meters[k] as *Meter)
        character.character_free(people[k] as *Character)
        k = k + 1
    }
    free(people as ptr)
    free(goals as ptr)
    free(meters as ptr)
    free(arrived as ptr)
    character.gaits_free(g)
    engine.engine_free(e)
    return most, nearest, skate
}

// One walker standing, then asked to face behind it (`walk` false: a half
// turn on the spot) or to walk off behind it (a half turn, then away): the
// most its facing strays, frame by frame over 4 s, from where the mover's
// way ahead (mover.path_ways), taken as it is asked, said it would face, in
// radians. What avoidance weighs a way by: run ahead on its facing spring
// alone, a standing half turn was predicted done in about a second where
// its steps take three (#976).
predicted_turn(walk: bool) -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  ${character.error()}")
        exit(1)
    }
    m = character.mover_of(c)
    f = 0
    while f < 60 {
        engine.engine_update(e, STEP)
        f = f + 1
    }
    behind = core.vec3(0.0, 0.0, 0.0 - 1.0)
    velocity = core.vec3(0.0, 0.0, 0.0)
    face = behind
    if walk {
        velocity = core.v3_mul(behind, WALK)
        face = core.vec3(0.0, 0.0, 0.0)
    }
    character.move(c, velocity, face)
    // As the character asks its mover each step (character_fixed).
    if !walk { mover.face(m, core.atan2_of(behind.x, behind.z), true) }
    count = 240
    out = calloc(count * 2, 8) as float[]
    yaws = calloc(count, 8) as float[]
    mover.path_ways(m, velocity, STEP, count, out, yaws, true)
    worst = 0.0
    f = 0
    while f < count {
        character.move(c, velocity, face)
        engine.engine_update(e, STEP)
        off = core.abs_of(wrap(mover.facing_of(m) - yaws[f]))
        if off > worst { worst = off }
        f = f + 1
    }
    // And it did turn round: its facing at the end, off straight behind.
    left = core.abs_of(wrap(mover.facing_of(m) - core.atan2_of(behind.x, behind.z)))
    free(out as ptr)
    free(yaws as ptr)
    character.character_free(c)
    character.gaits_free(g)
    engine.engine_free(e)
    return worst, left
}

wrap(a: float) -> float {
    x = a
    while x > 3.141592653589793 { x = x - 6.283185307179586 }
    while x < 0.0 - 3.141592653589793 { x = x + 6.283185307179586 }
    return x
}

main() {
    println("characters_avoid: solid characters steering round each other (#956)")
    on_spot, spot_left = predicted_turn(false)
    walk_off, walk_left = predicted_turn(true)
    println("  a standing half turn as the mover's way ahead said it would face: ${on_spot * 57.29578} degrees off at most on the spot (ending ${spot_left * 57.29578} off behind), ${walk_off * 57.29578} turning to walk off behind (ending ${walk_left * 57.29578} off)")
    check("a standing figure's half turn, on the spot and to walk off behind it, faces as mover.path_ways predicted within 5 degrees (avoidance weighs the way it will really face), and ends within 5 degrees of behind", on_spot * 57.29578 < 5.0 && walk_off * 57.29578 < 5.0 && spot_left * 57.29578 < 5.0 && walk_left * 57.29578 < 5.0)
    // Alone: one walker from (-3, 0) to its point, the time a walker takes.
    alone, _n0, alone_skate = walk_across([0.0 - 3.0, 0.0], 1, 0.0, [0.0])
    println("  alone: ${alone} s to its point 12 m on, a toe skating ${alone_skate * 1000.0} mm")
    pair, pair_gap, pair_skate = walk_across([0.0 - 3.0, 0.0, 3.0, 0.0], 2, 0.0, [0.0])
    println("  two head on: ${pair} s for the slower (alone ${alone}), their capsules ${pair_gap * 1000.0} mm apart at the nearest beyond their radii, a toe skating ${pair_skate * 1000.0} mm")
    check("two walking at each other head on pass, each at its point within 2 s of walking there alone, no capsules inside each other, no toe skating 5 mm", pair <= alone + 2.0 && pair_gap > 0.0 - 0.006 && pair_skate < 0.005)
    four, four_gap, four_skate = walk_across([0.0 - 3.0, 0.0, 3.0, 0.0, 0.0, 0.0 - 3.0, 0.0, 3.0], 4, 0.0, [0.0])
    println("  four crossing at a point: ${four} s for the slowest (alone ${alone}), their capsules ${four_gap * 1000.0} mm apart at the nearest beyond their radii, a toe skating ${four_skate * 1000.0} mm")
    check("four crossing at a point from four ways pass, each at its point within 2 s of walking there alone, no capsules inside each other, no toe skating 5 mm", four <= alone + 2.0 && four_gap > 0.0 - 0.006 && four_skate < 0.005)
    // Two walking side by side 1.5 m apart, each turned after 3 s toward a
    // point ahead on the other's side: each curves across the other's way
    // (ae3d.mover's curve turns a way about 20 degrees a second), as the
    // plaza's walkers turned to new goals do. Weighed as if each way were
    // taken at once, the steering chose turns the curve had not made when
    // the two met, and the plaza's capsules touched and shoved each other.
    cross, cross_gap, cross_skate = walk_across([0.0 - 0.75, 0.0 - 6.0, 0.75, 0.0 - 6.0], 2, 2.5, [10.0, 0.0, 0.0 - 10.0, 0.0])    println("  two turned across each other: their capsules ${cross_gap * 1000.0} mm apart at the nearest beyond their radii, a toe skating ${cross_skate * 1000.0} mm (${cross} s for the slower)")
    check("two side by side turned across each other's way never touch, both arrive, no toe skating 5 mm", cross_gap > 0.0 && cross < (FRAMES_MOST as float) * STEP && cross_skate < 0.005)
    if g_failures == 0 {
        println("characters_avoid: all checks passed (${g_checks})")
        return
    }
    println("characters_avoid: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
