// ae3d.gpu, over the tree a `quote` hands it (Aether 0.810), held to three
// things:
//
//   - FXAA (ae3d.shaders.fxaa, written with quote) comes out as the GLSL
//     in tests/fixtures/gpu/fxaa.frag for Vulkan and fxaa_gl.frag for
//     OpenGL 4.1; glslang compiles the first and its full-screen vertex
//     shader to SPIR-V that spirv-val passes, and takes the second and its
//     vertex shader as OpenGL's GLSL (where glslang is on PATH: the Vulkan
//     SDK, Homebrew's glslang, Debian's glslang-tools); its uniform block is
//     laid out as std140 lays it out;
//   - the CPU back end runs it to agree with FXAA written straight in
//     Aether, calling ae3d.shaderlib's functions (the ones the quote is
//     type-checked against), on every pixel of an image with edges, flat
//     ground and a lone bright pixel, both of FXAA's paths taken;
//   - a shader with loops, an else-if and an int uniform runs on the CPU as
//     the same body does run as Aether, and its GLSL compiles.
//
// AE3D_GPU_WRITE_GOLDEN=1 writes the fixtures from what is emitted.

import std.os
import std.fs
import std.file
import std.list
import std.string
import std.heap
import std.lanes
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader)
import ae3d.shaders.fxaa
import ae3d.shaderlib (vec2, vec3, vec4, Texture, ShaderImage, texture, rgb, dot, min, max, abs, sign, clamp, smoothstep,
                       image_new, image_set, image_channel, image_free, texture_of)

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// ── FXAA straight in Aether, on ae3d.shaderlib ─────────────────────────

var g_aa = 0

fxaa_ref(screen: Texture, uv: vec2, texel: vec2, edge: float, edge_min: float, subpixel: float) -> vec3 {
    luma = vec3(0.299, 0.587, 0.114)
    c = rgb(texture(screen, uv))
    n = rgb(texture(screen, uv + vec2(0.0, -1.0) * texel))
    s = rgb(texture(screen, uv + vec2(0.0, 1.0) * texel))
    e = rgb(texture(screen, uv + vec2(1.0, 0.0) * texel))
    w = rgb(texture(screen, uv + vec2(-1.0, 0.0) * texel))
    lc = dot(c, luma)
    ln = dot(n, luma)
    ls = dot(s, luma)
    le = dot(e, luma)
    lw = dot(w, luma)
    lo = min(lc, min(min(ln, ls), min(le, lw)))
    hi = max(lc, max(max(ln, ls), max(le, lw)))
    range = hi - lo
    if range < max(edge_min, hi * edge) { return c }
    g_aa = g_aa + 1
    avg = (ln + ls + le + lw) * 0.25
    blend = smoothstep(0.0, 1.0, clamp(abs(avg - lc) / range, 0.0, 1.0))
    blend = blend * blend * subpixel
    horiz = abs(-2.0 * lw + lc) + abs(-2.0 * lc + le) * 2.0 + abs(-2.0 * le + lc)
    vert = abs(-2.0 * ln + lc) + abs(-2.0 * lc + ls) * 2.0 + abs(-2.0 * ls + lc)
    along = horiz >= vert
    l1 = le
    l2 = lw
    if along {
        l1 = ls
        l2 = ln
    }
    g1 = l1 - lc
    g2 = l2 - lc
    dir = sign(g2)
    if abs(g1) >= abs(g2) { dir = sign(g1) }
    step = blend * dir
    off = vec2(step * texel.x, 0.0)
    if along { off = vec2(0.0, step * texel.y) }
    return rgb(texture(screen, uv + off))
}

// ── A shader with loops ────────────────────────────────────────────────

loops(k: int, base: float) -> *GpuShader {
    return gpu.fragment("loops") quote | uv: vec2 | {
        total = base
        for (i = 0; i < k; i++) {
            if i == 2 { continue }
            total += 0.25
        }
        j = 0
        while j < 10 {
            j += 1
            if j >= 3 { break }
        }
        lift = j * 0.1
        if total > 2.0 {
            return vec4(vec3(1.0, 0.0, lift), 1.0)
        } else if total > 1.0 {
            return vec4(vec3(0.0, 1.0, lift), 1.0)
        }
        return vec4(vec3(0.0, 0.0, total), 1.0)
    }
}

// The same body, as Aether runs it.
loops_ref(k: int, base: float) -> vec4 {
    total = base
    for (i = 0; i < k; i++) {
        if i == 2 { continue }
        total += 0.25
    }
    j = 0
    while j < 10 {
        j += 1
        if j >= 3 { break }
    }
    lift = j * 0.1
    if total > 2.0 {
        return vec4(vec3(1.0, 0.0, lift), 1.0)
    } else if total > 1.0 {
        return vec4(vec3(0.0, 1.0, lift), 1.0)
    }
    return vec4(vec3(0.0, 0.0, total), 1.0)
}

// ── The test image ─────────────────────────────────────────────────────

make_image() -> *ShaderImage {
    W = 12
    H = 8
    img = image_new(W, H)
    y = 0
    while y < H {
        x = 0
        while x < W {
            // Grey ground; white right of a staircase edge; a red block; one
            // bright pixel on its own in the grey.
            r = 0.2
            g = 0.2
            bl = 0.2
            if x > 5 + y / 2 {
                r = 0.95
                g = 0.95
                bl = 0.95
            }
            if x >= 1 && x <= 3 && y >= 4 && y <= 6 {
                r = 0.9
                g = 0.1
                bl = 0.1
            }
            if x == 2 && y == 1 {
                r = 1.0
                g = 1.0
                bl = 1.0
            }
            image_set(img, x, y, r, g, bl, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }
maxf(a: float, c: float) -> float { if a > c { return a } return c }

// glslang -V over `text` (as `stage`), then spirv-val over what it wrote;
// or, for desktop OpenGL's GLSL (`opengl`), glslang's check of it as
// OpenGL compiles it. Skipped where they are not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the fixture at `path`; AE3D_GPU_WRITE_GOLDEN=1 writes it.
golden_is(text: string, path: string) {
    if os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    golden, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == golden)
    if text != golden {
        println("--- emitted ---")
        println(text)
    }
}

main() {
    println("ae3d.gpu: FXAA written with quote")
    img = make_image()
    W = 12
    H = 8
    texel = vec2(1.0 / W, 1.0 / H)
    screen = texture_of(img)
    s = fxaa.fxaa(screen, texel, 0.125, 0.0312, 0.75)

    // ── The tree ──
    t = gpu.shader_tree(s)
    check("the tree's parameter is uv: vec2", quote.param_name(t, 0) == "uv" && quote.param_type(t, 0) == "vec2")
    names = ""
    i = 0
    while i < quote.capture_count(t) {
        c = quote.capture(t, i)
        names = "${names}${quote.capture_name(c)}:${quote.capture_type(c)} "
        i = i + 1
    }
    check("its captures are the function's parameters (${names})",
          names == "screen:Texture texel:vec2 edge_min:float edge:float subpixel:float ")

    // ── GLSL, for Vulkan and for OpenGL ──
    frag = gpu.emit_glsl(s, gpu.VULKAN)
    if frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(frag, "tests/fixtures/gpu/fxaa.frag")
    compiles("fxaa", frag, "frag", false)
    compiles("fxaa", gpu.emit_screen_vertex(s, gpu.VULKAN), "vert", false)
    gl_frag = gpu.emit_glsl(s, gpu.GL)
    if gl_frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(gl_frag, "tests/fixtures/gpu/fxaa_gl.frag")
    compiles("fxaa_gl", gl_frag, "frag", true)
    compiles("fxaa_gl", gpu.emit_screen_vertex(s, gpu.GL), "vert", true)

    // The block: texel at 0, the three floats after it, 32 bytes in all.
    layout = ""
    k = 0
    while k < gpu.params_count(s) {
        layout = "${layout}${gpu.params_type(s, k)} ${gpu.params_name(s, k)}@${gpu.params_offset(s, k)} "
        k = k + 1
    }
    check("the uniform block is std140 (${layout}${gpu.params_size(s)})",
          layout == "vec2 texel@0 float edge_min@8 float edge@12 float subpixel@16 " && gpu.params_size(s) == 32)
    check("one sampler, the screen", gpu.samplers_count(s) == 1 && gpu.samplers_name(s, 0) == "screen")
    block = calloc(1, 32)
    gpu.params_write(s, block)
    p = block as f32[]
    check("the block holds the captures' values",
          absf(p[0] - 1.0 / W) < 0.000001 && absf(p[1] - 1.0 / H) < 0.000001 && absf(p[2] - 0.0312) < 0.000001 &&
          absf(p[3] - 0.125) < 0.000001 && absf(p[4] - 0.75) < 0.000001)
    free(block)

    // ── The CPU back end against FXAA in Aether ──
    cx = gpu.cpu_new(s)
    worst = 0.0
    ran = 0
    changed = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            u = (x + 0.5) / W
            v = (y + 0.5) / H
            uv = gpu.v2(u, v)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            if got != null {
                ran = ran + 1
                want = fxaa_ref(screen, vec2(u, v), texel, 0.125, 0.0312, 0.75)
                d = maxf(maxf(absf(gpu.val_x(got) - want.x), absf(gpu.val_y(got) - want.y)), absf(gpu.val_z(got) - want.z))
                worst = maxf(worst, d)
                if absf(gpu.val_x(got) - image_channel(img, x, y, 0)) > 0.0001 { changed = changed + 1 }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            x = x + 1
        }
        y = y + 1
    }
    check("the CPU back end ran every pixel (${ran} of ${W * H})", ran == W * H)
    check("it agrees with FXAA in Aether on every pixel (worst ${worst})", worst < 0.00001)
    check("FXAA's edge path was taken (${g_aa} pixels)", g_aa > 0)
    check("and its flat path (${W * H - g_aa} pixels)", W * H - g_aa > 0)
    check("FXAA changed some pixels (${changed})", changed > 0)
    gpu.cpu_free(cx)
    gpu.shader_free(s)

    // ── Loops, an else-if and an int uniform ──
    println("ae3d.gpu: loops")
    worst = 0.0
    runs = 0
    kk = 0
    while kk < 8 {
        base = 0.1 * kk
        ls = loops(kk, base)
        if kk == 0 {
            lf = gpu.emit_glsl(ls, gpu.VULKAN)
            if lf == "" { println("  emit: ${gpu.last_error()}") }
            check("its GLSL has the loops and the else-if",
                  string.contains(lf, "for (int i = 0; i < k; i += 1) {") == 1 && string.contains(lf, "} else if (total > 1.0) {") == 1 &&
                  string.contains(lf, "    int k;\n") == 1)
            compiles("loops", lf, "frag", false)
            compiles("loops_gl", gpu.emit_glsl(ls, gpu.GL), "frag", true)
        }
        lx = gpu.cpu_new(ls)
        uv = gpu.v2(0.5, 0.5)
        got = gpu.cpu_run(lx, uv)
        heap.free(uv)
        want = loops_ref(kk, base)
        if got != null {
            runs = runs + 1
            worst = maxf(worst, maxf(maxf(absf(gpu.val_x(got) - want.x), absf(gpu.val_y(got) - want.y)), absf(gpu.val_z(got) - want.z)))
            heap.free(got)
        } else {
            println("  cpu_run failed: ${gpu.last_error()}")
        }
        gpu.cpu_free(lx)
        gpu.shader_free(ls)
        kk = kk + 1
    }
    check("it ran for every k (${runs} of 8)", runs == 8)
    check("as the same body runs as Aether (worst ${worst})", worst < 0.000001)
    image_free(img)

    // ci.sh passes a suite on this line.
    if g_failures == 0 {
        println("gpu: all checks passed (${g_checks})")
        return
    }
    println("gpu: ${g_failures} of ${g_checks} checks failed")
    exit(1)
}
