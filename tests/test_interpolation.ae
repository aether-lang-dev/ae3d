// Render interpolation (#563), held to numbers.
//
// Driven step by step through ae3d.core, deterministically:
//   - a model the steps move is put between its last two steps by the
//     frame's share of the next one: at a quarter, a quarter of the way;
//   - a frame with no step moves it on by its time, not not at all; the next
//     step starts from where the steps left it, not from where it was drawn;
//   - in world space, under a parent moved every frame: a body the steps
//     place in the world under a parent that slides on does not slide with
//     it between steps;
//   - a rotation turns between the steps, by its share;
//   - a transform a script writes after the steps keeps what it was given,
//     and is not put back;
//   - a teleport is not swept across: drawn where the step put it;
//   - a model the steps stop moving is at rest, where they left it.
// And through the engine on the real clock, the issue's repro: a ball
// falling under physics, where each frame drew it. Without interpolation
// most frames draw it where the frame before did; with it, none do, and no
// frame moves it much more than its time asks. Every script reads the
// steps' pose either way; the drawn one is model_interpolated_position at
// the frame's fraction.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics

extern fflush(stream: ptr) -> int
extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
    fflush(null)
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

// One fixed step that puts the model at x.
step_to(m: *Model, x: float, y: float, z: float) {
    core.interp_begin_step()
    core.model_set_position(m, x, y, z)
    core.interp_end_step()
}

// A step that moves nothing: what the steps leave at rest.
empty_step() {
    core.interp_begin_step()
    core.interp_end_step()
}

core_checks() {
    m = core.model_new()
    core.model_set_position(m, 0.0, 0.0, 0.0)
    step_to(m, 1.0, 0.0, 0.0)
    step_to(m, 2.0, 0.0, 0.0)
    core.interp_apply(0.25)
    quarter = core.model_world_position(m).x
    core.interp_apply(0.75)
    three_quarters = core.model_world_position(m).x
    check("put between its last two steps by the frame's share of the next (${quarter} at 0.25, ${three_quarters} at 0.75)",
          near(quarter, 1.25) && near(three_quarters, 1.75))
    step_to(m, 3.0, 0.0, 0.0)
    core.interp_apply(0.0)
    started = core.model_world_position(m).x
    check("the next step starts from where the steps left it, not where it was drawn (${started})", near(started, 2.0))

    // A parent sliding along every frame, written outside the steps; the
    // child placed by the steps at a world height, falling.
    parent = core.model_new()
    child = core.model_new()
    core.model_set_parent(child, parent)
    step_to(child, 0.0, 10.0, 0.0)
    step_to(child, 0.0, 9.0, 0.0)
    core.model_set_position(parent, 5.0, 0.0, 0.0)
    core.interp_apply(0.5)
    w = core.model_world_position(child)
    check("in world space: under a parent that slid on, the body does not slide with it (at ${w.x}, ${w.y})",
          near(w.y, 9.5) && near(w.x, 0.0))
    core.interp_begin_step()
    core.interp_end_step()
    core.model_set_parent(child, null)
    core.model_free(child)
    core.model_free(parent)

    // A parent and its child both moved by the steps: drawn between, then
    // both back where the steps left them -- a parent left at its drawn
    // pose is what the simulation would read next.
    body = core.model_new()
    limb = core.model_new()
    core.model_set_parent(limb, body)
    core.interp_begin_step()
    core.model_set_position(body, 0.0, 0.0, 0.0)
    core.model_set_position(limb, 0.0, 1.0, 0.0)
    core.interp_end_step()
    core.interp_begin_step()
    core.model_set_position(body, 2.0, 0.0, 0.0)
    core.model_set_position(limb, 0.0, 2.0, 0.0)
    core.interp_end_step()
    core.interp_apply(0.5)
    drawn_body = core.model_world_position(body).x
    drawn_limb = core.model_world_position(limb)
    core.interp_restore()
    back_body = core.model_world_position(body).x
    back_limb = core.model_world_position(limb)
    check("a parent and its child the steps both move are drawn between (${drawn_body}; ${drawn_limb.x}, ${drawn_limb.y}) and both put back (${back_body}; ${back_limb.x}, ${back_limb.y})",
          near(drawn_body, 1.0) && near(drawn_limb.x, 1.0) && near(drawn_limb.y, 1.5) &&
          near(back_body, 2.0) && near(back_limb.x, 2.0) && near(back_limb.y, 2.0))
    // A child the steps do not move, under a body they do (#565): read
    // where it is drawn, it is where interp_apply draws it -- under its
    // parent as the parent is drawn, not where the steps left the parent.
    finger = core.model_new()
    core.model_set_parent(finger, limb)
    core.model_set_position(finger, 0.5, 0.0, 0.0)
    asked = core.model_interpolated_position(finger, 0.5)
    core.interp_apply(0.5)
    drawn = core.model_world_position(finger)
    core.interp_restore()
    check("a child the steps do not move is read where it is drawn, under its parent as drawn (${asked.x}, ${asked.y} against ${drawn.x}, ${drawn.y})",
          near(asked.x, drawn.x) && near(asked.y, drawn.y) && near(asked.x, 1.5) && near(asked.y, 1.5))
    core.model_set_parent(finger, null)
    core.model_free(finger)
    core.interp_begin_step()
    core.interp_end_step()
    core.interp_begin_step()
    core.interp_end_step()
    core.model_set_parent(limb, null)
    core.model_free(limb)
    core.model_free(body)

    // A turn.
    r = core.model_new()
    core.interp_begin_step()
    core.model_set_rotation(r, core.quat_ident())
    core.interp_end_step()
    core.interp_begin_step()
    core.model_set_rotation(r, core.quat_rotate(1.0, core.vec3(0.0, 1.0, 0.0)))
    core.interp_end_step()
    core.interp_apply(0.5)
    half = core.quat_rotate(0.5, core.vec3(0.0, 1.0, 0.0))
    got = r.world_rotation
    check("a rotation turns between the steps by its share",
          near(got.x, half.x) && near(got.y, half.y) && near(got.z, half.z) && near(got.w, half.w))
    core.model_free(r)

    // A script's write after the steps.
    s = core.model_new()
    step_to(s, 0.0, 0.0, 0.0)
    step_to(s, 1.0, 0.0, 0.0)
    core.interp_apply(0.5)
    core.model_set_position(s, 7.0, 0.0, 0.0)
    core.interp_apply(0.75)
    kept = core.model_world_position(s).x
    core.interp_begin_step()
    after_step = core.model_world_position(s).x
    core.interp_end_step()
    check("a transform a script writes after the steps keeps what it was given (${kept}, ${after_step})",
          near(kept, 7.0) && near(after_step, 7.0))
    core.model_free(s)

    // A teleport.
    t = core.model_new()
    step_to(t, 0.0, 0.0, 0.0)
    step_to(t, 1.0, 0.0, 0.0)
    core.interp_begin_step()
    core.model_set_position(t, 100.0, 0.0, 0.0)
    core.model_reset_interpolation(t)
    core.interp_end_step()
    core.interp_apply(0.5)
    jumped = core.model_world_position(t).x
    check("a teleport is drawn where the step put it, not swept across (${jumped})", near(jumped, 100.0))
    core.model_free(t)

    // At rest.
    step_to(m, 4.0, 0.0, 0.0)
    empty_step()
    empty_step()
    core.interp_apply(0.5)
    rest = core.model_world_position(m).x
    check("a model the steps stop moving is at rest where they left it (${rest}; ${core.interp_count()} still followed)",
          near(rest, 4.0) && core.interp_count() == 0)
    core.model_free(m)
}

// The issue's repro: the ball's height read each frame in late_update.
struct Probe {
    ball: ptr
    last_y: float
    known: bool
    frames: int
    still: int
    seconds: float
    worst_ratio: float
    interpolate: bool
}

late(state: ptr, e: *Engine, delta: float) {
    p = state as *Probe
    // Where the frame drew it: the steps' pose between the last two, at the
    // frame's fraction (what the engine's interpolation put it at for the
    // draw, and took back after).
    model = behaviour.object_model(p.ball as *GameObject)
    y = core.model_interpolated_position(model, engine.engine_step_fraction(e)).y
    if !p.interpolate { y = behaviour.object_world_position(p.ball as *GameObject).y }
    p.seconds = p.seconds + delta
    if p.known && p.seconds > 0.2 && p.seconds < 0.9 && delta > 0.0 {
        p.frames = p.frames + 1
        moved = p.last_y - y
        if moved == 0.0 { p.still = p.still + 1 }
        ratio = moved / (9.81 * p.seconds * delta)
        if ratio > p.worst_ratio { p.worst_ratio = ratio }
    }
    p.last_y = y
    p.known = true
}

fall(interpolate: bool) -> Probe {
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 180)
    engine.engine_set_title(e, "ae3d interpolation test")
    engine.engine_set_frame_limit(e, 400)
    engine.engine_set_vsync(e, 0)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_interpolation(e, interpolate)
    light = core.light_sun(core.vec3(0.4, 0.8, 0.3))
    engine.engine_set_light(e, light)
    physics.attach(e)
    ball = engine.object(e, "ball", loader.sphere(0.2, 12, 8))
    behaviour.object_set_position(ball, core.vec3(0.0, 10.0, 0.0))
    physics.rigidbody(ball, physics.DYNAMIC)
    physics.sphere_collider(ball, 0.2, physics.material(0.5, 0.0), 1000.0)
    p = Probe { ball: ball as ptr, last_y: 0.0, known: false, frames: 0, still: 0, seconds: 0.0, worst_ratio: 0.0,
                interpolate: interpolate }
    b = engine.behaviour_new("probe", (&p) as ptr)
    b.late_update = late
    engine.engine_add_behaviour(e, b)
    ran = engine.engine_run(e)
    if !ran { p.frames = 0 - 1 }
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    core.light_free(light)
    return p
}

main() {
    println("interpolation: fixed steps drawn between (#563)")
    core_checks()

    off = fall(false)
    on = fall(true)
    if off.frames < 0 || on.frames < 0 {
        println("interpolation: SKIP no window for the engine's run")
    } else {
        println("  a falling ball, read each frame: without interpolation ${off.still} of ${off.frames} frames where the frame before was, the worst ${off.worst_ratio}x its time; with it ${on.still} of ${on.frames}, the worst ${on.worst_ratio}x")
        // A frame shorter than the step is what shows it; a machine that
        // draws slower than the steps has nothing to interpolate.
        if off.still == 0 {
            println("interpolation: every frame took a step here; nothing to show")
        } else {
            check("with interpolation no frame draws the ball where the frame before did", on.still == 0)
            check("and no frame moves it more than a fifth past what its time asks", on.worst_ratio < 1.2)
        }
    }

    if g_failures == 0 {
        println("interpolation: all checks passed (${g_checks})")
    } else {
        println("interpolation: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
