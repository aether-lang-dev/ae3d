// Held items (#925, ae3d.items), held to numbers: the UE5 mannequin made a
// person (ae3d.character) in a world with physics, given weapons by their
// handles. No window; stepped at 60 Hz.
//
//   - kinds read from files: a knife, a one-handed sword, a two-handed
//     sword, an axe, a bat, a pistol and a rifle, each its mass and its hands;
//   - drawn from its socket and sheathed back: the hand on the handle within
//     1 cm at the contact, the item never jumping between socket and hand (no
//     step it turns faster than both the hand and the socket's joint, none it
//     moves 3 mm or turns a degree against the one it rides on);
//   - through the mannequin's own swing: the main hand on its grip within 2
//     mm every frame, the fingers round the handle (none through it, none off
//     it by more than 5 mm);
//   - a two-handed axe through a chop: the second hand on its grip within 5
//     mm every frame, the axe never turning faster than its hands; and held
//     through a walk, a run and a stop, no finger turning faster than the
//     takes' own fingers plus 2 rad/s (#959), the second hand still on its
//     grip; and sheathed as a pistol is drawn in the same frame (one set of
//     hands under both), its second hand let go no faster than 4 m/s;
//   - a swing over a walk (items.swing_over, #945): on the upper body, the
//     legs walking on at their pace, no toe skating 5 mm; and with the whole
//     body (character.swing): stepped in by its take's root motion (2 cm),
//     its toes skating no more than the gliding take's own, the hand on its
//     grip (1 cm), and from the walk's stand as from its own end (#966);
//   - the sword's edge swept through a swing hits a body it passes through,
//     once a swing, at a measured cost, the hit naming the bone met, the
//     edge's speed at the point met (the sweep's own there, 0% off) and its
//     depth (#946), a wall there met too, and a
//     blade raised in the way met as an item (a parry) and ended by
//     items.swing_stop; and a
//     person standing there, made
//     physical before any blow (character.physical, #940), as an unhurt
//     one with no bodies is not;
//   - a knife against a two-handed axe: the axe's swing slower and the trunk
//     leaning back further for it.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.metrics
import ae3d.ikrig
import ae3d.character
import ae3d.items
import ae3d.physanim
import ae3d.mover

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const KINDS = "tests/fixtures/items/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// A joint's place and turn in the world, as the figure is drawn.
struct Placed {
    at: Vec3
    turn: Quat
}

joint_placed(r: *pose.Rig, w: ptr, j: int) -> Placed {
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    q = pose.rotation(w, j)
    x = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(q, core.vec3(unit, 0.0, 0.0))))
    y = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(q, core.vec3(0.0, unit, 0.0))))
    z = core.v3_normalize(core.v3_cross(x, y))
    y = core.v3_cross(z, x)
    return Placed { at: ikrig.to_ground(r, pose.translation(w, j)), turn: core.quat_from_axes(x, y, z) }
}

most_of(a: float, b: float) -> float {
    if b > a { return b }
    return a
}

// How far the line through `a` and `b` passes from `p`.
off_line(p: Vec3, a: Vec3, b: Vec3) -> float {
    way = core.v3_normalize(core.v3_sub(b, a))
    d = core.v3_sub(p, a)
    return core.v3_len(core.v3_sub(d, core.v3_mul(way, core.v3_dot(d, way))))
}

// Hand `side`'s palm put on a handle: the point a radius off the palm along
// the way it faces (where hands_hold puts the handle's line).
palm_axis(h: *Hands, r: *pose.Rig, w: ptr, side: int, radius: float) -> Vec3 {
    palm, faces = ikrig.hands_palm(h, r, w, side)
    return core.v3_add(palm, core.v3_mul(faces, radius))
}

// Each of hand `side`'s fingers, index to little: the least any of its
// joints, its phalanges' middles or its tip comes off the handle's surface
// less a pad's depth (below 0: into it), metres; the worst through, the
// worst off, and which finger that was. The tip from the last joint as it is
// turned now, its last phalanx four fifths of the middle one at rest (the
// rig ends each finger at its last joint).
fingers_on(r: *pose.Rig, w: ptr, rest: ptr, side: int, a: Vec3, b: Vec3, radius: float) -> (float, float, int) {
    base = pose.FINGERS + side * 15
    through = 0.0
    off = 0.0
    worst = 0 - 1
    finger = 1
    while finger < 5 {
        j0 = pose.human(r, base + finger * 3)
        j1 = pose.human(r, base + finger * 3 + 1)
        j2 = pose.human(r, base + finger * 3 + 2)
        if j0 >= 0 && j1 >= 0 && j2 >= 0 {
            last = core.v3_mul(core.v3_sub(pose.translation(rest, j2), pose.translation(rest, j1)), 0.8)
            last = core.quat_apply(core.quat_conjugate(pose.rotation(rest, j2)), last)
            p0 = pose.translation(w, j0)
            p1 = pose.translation(w, j1)
            p2 = pose.translation(w, j2)
            p3 = core.v3_add(p2, core.quat_apply(pose.rotation(w, j2), last))
            points = [p0, p1, p2, p3, core.v3_lerp(p0, p1, 0.5), core.v3_lerp(p1, p2, 0.5), core.v3_lerp(p2, p3, 0.5)]
            least = 1000.0
            k = 0
            while k < 7 {
                gap = off_line(ikrig.to_ground(r, points[k]), a, b) - radius - ikrig.FINGER_PAD
                if gap < least { least = gap }
                k = k + 1
            }
            if 0.0 - least > through { through = 0.0 - least }
            if least > off {
                off = least
                worst = finger
            }
        }
        finger = finger + 1
    }
    return through, off, worst
}

run(e: *Engine, n: int) {
    k = 0
    while k < n {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

// The fastest any finger joint of either hand turns from pose `a` to pose
// `b` (local poses, `dt` apart), radians a second, and which joint.
fingers_fastest(r: *pose.Rig, a: ptr, b: ptr, dt: float) -> (float, int) {
    most = 0.0
    joint = 0 - 1
    k = 0
    while k < 30 {
        j = pose.human(r, pose.FINGERS + k)
        if j >= 0 {
            turned = turned_by(pose.rotation(a, j), pose.rotation(b, j)) / dt
            if turned > most {
                most = turned
                joint = j
            }
        }
        k = k + 1
    }
    return most, joint
}

// The fastest any finger joint turns in the takes figure `a`'s graph plays,
// frame to frame, radians a second: the fingers' own.
takes_fingers_fastest(a: *Animator) -> float {
    r = animator.rig(a)
    most = 0.0
    s = 0
    while s < animator.state_count(a) {
        k = 0
        while k < animator.state_take_count(a, s) {
            t = animator.state_take_at(a, s, k)
            f = 1
            while t != null && f < clips.frames(t) {
                turned, _j = fingers_fastest(r, clips.frame(t, f - 1), clips.frame(t, f), 1.0 / clips.rate(t))
                if turned > most { most = turned }
                f = f + 1
            }
            k = k + 1
        }
        s = s + 1
    }
    return most
}

// The item's motion against its hand's and its socket joint's, a step apart:
// how far it turned past the faster of the two (5% over, a tenth of a degree
// spared), and how far it moved and turned against whichever of them it rode
// on (a jump moves it against both).
struct Pace {
    item_was: Placed
    hand_was: Placed
    socket_was: Placed
    known: bool
    worst_turn: float
    worst_jump: float
    worst_jump_turn: float
}

// Placed `p` in the frame of `on`.
against(p: Placed, on: Placed) -> Placed {
    back = core.quat_conjugate(on.turn)
    return Placed { at: core.quat_apply(back, core.v3_sub(p.at, on.at)), turn: core.quat_normalize(core.quat_mul(back, p.turn)) }
}

pace(p: *Pace, item: Placed, hand: Placed, socket: Placed) {
    if p.known {
        it_t = turned_by(item.turn, p.item_was.turn)
        most_t = most_of(turned_by(hand.turn, p.hand_was.turn), turned_by(socket.turn, p.socket_was.turn))
        over_t = it_t - most_t * 1.05 - 0.0017
        if over_t > p.worst_turn { p.worst_turn = over_t }
        on_hand = against(item, hand)
        was_hand = against(p.item_was, p.hand_was)
        on_socket = against(item, socket)
        was_socket = against(p.item_was, p.socket_was)
        moved = core.v3_len(core.v3_sub(on_hand.at, was_hand.at))
        moved_s = core.v3_len(core.v3_sub(on_socket.at, was_socket.at))
        if moved_s < moved { moved = moved_s }
        turned = turned_by(on_hand.turn, was_hand.turn)
        turned_s = turned_by(on_socket.turn, was_socket.turn)
        if turned_s < turned { turned = turned_s }
        if moved > p.worst_jump { p.worst_jump = moved }
        if turned > p.worst_jump_turn { p.worst_jump_turn = turned }
    }
    p.item_was = item
    p.hand_was = hand
    p.socket_was = socket
    p.known = true
}

item_placed(it: *Item) -> Placed {
    o = items.object_of(it)
    return Placed { at: behaviour.object_position(o), turn: behaviour.object_rotation(o) }
}

main() {
    println("items: weapons and tools held by their handles (#925)")
    names = ["knife", "sword", "longsword", "axe", "bat", "pistol", "rifle"]
    masses = [0.15, 1.1, 1.5, 3.2, 0.9, 0.85, 3.6]
    two = [false, false, true, true, true, false, true]
    kinds = [null as *Kind, null as *Kind, null as *Kind, null as *Kind, null as *Kind, null as *Kind, null as *Kind]
    read = true
    k = 0
    while k < 7 {
        kinds[k] = items.kind_read("${KINDS}${names[k]}.item")
        if kinds[k] == null {
            println("  ${names[k]}: ${items.kind_error()}")
            read = false
        } else if core.abs_of(items.kind_mass(kinds[k]) - masses[k]) > 0.0001 || items.kind_two_handed(kinds[k]) != two[k] || items.kind_sockets(kinds[k]) < 1 {
            read = false
        }
        k = k + 1
    }
    check("kinds read from files: a knife, a sword, a longsword, an axe, a bat, a pistol and a rifle, each its mass, its hands and a socket", read)
    if !read { exit(1) }
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    c = character.humanoid(e, "Fighter", MANNEQUIN, g)
    check("the mannequin made a person: ${character.error()}", c != null)
    if c == null { exit(1) }
    a = character.animator_of(c)
    r = animator.rig(a)
    w = pose.new(r)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    hand_r = pose.human(r, pose.HAND_R)
    pelvis = pose.human(r, pose.PELVIS)
    run(e, 30)

    // Drawn from the left hip and sheathed back.
    sword = items.item_new(e, kinds[1], engine.object(e, "Sword", null))
    carried = items.carry(sword, a, "hip_l")
    run(e, 30)
    drew = items.draw(sword)
    h = animator.hands(a)
    radius = 0.013
    drawing = Pace { item_was: Placed { at: core.vec3(0.0, 0.0, 0.0), turn: core.quat_ident() }, hand_was: Placed { at: core.vec3(0.0, 0.0, 0.0), turn: core.quat_ident() }, socket_was: Placed { at: core.vec3(0.0, 0.0, 0.0), turn: core.quat_ident() }, known: false, worst_turn: 0.0, worst_jump: 0.0, worst_jump_turn: 0.0 }
    at_contact = 0.0 - 1.0
    k = 0
    while k < 60 && items.phase_of(sword) != items.PHASE_HELD {
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        pace(&drawing, item_placed(sword), joint_placed(r, w, hand_r), joint_placed(r, w, pelvis))
        // The contact: the step the item went from the socket to the hand.
        if at_contact < 0.0 && (k as float + 1.0) * STEP >= items.REACH - 0.000001 {
            at_contact = core.v3_len(core.v3_sub(palm_axis(h, r, w, 1, radius), items.grip_point(sword)))
        }
        k = k + 1
    }
    drawn = items.held(sword)
    println("  drawn from the hip: held ${drawn}, the hand ${at_contact * 1000.0} mm off the handle at the contact; the item turned ${drawing.worst_turn * 57.29578} degrees a step past the faster of the hand and the hip at most, and moved ${drawing.worst_jump * 1000.0} mm and turned ${drawing.worst_jump_turn * 57.29578} degrees a step against the one it rode on")
    check("drawn from its socket: the hand on the handle within 1 cm at the contact; the item never turning faster than both hand and socket, nor jumping (3 mm, 1 degree a step against what it rides on)", carried && drew && drawn && at_contact >= 0.0 && at_contact < 0.01 && drawing.worst_turn <= 0.0 && drawing.worst_jump < 0.003 && drawing.worst_jump_turn < 0.01745)
    run(e, 30)
    sheathing = Pace { item_was: drawing.item_was, hand_was: drawing.hand_was, socket_was: drawing.socket_was, known: false, worst_turn: 0.0, worst_jump: 0.0, worst_jump_turn: 0.0 }
    put = items.sheathe(sword)
    k = 0
    while k < 90 && (items.phase_of(sword) != items.PHASE_CARRIED || k < 20) {
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        pace(&sheathing, item_placed(sword), joint_placed(r, w, hand_r), joint_placed(r, w, pelvis))
        k = k + 1
    }
    println("  sheathed: on its socket ${items.carried(sword)}; the item turned ${sheathing.worst_turn * 57.29578} degrees a step past the faster of the hand and the hip at most, and moved ${sheathing.worst_jump * 1000.0} mm and turned ${sheathing.worst_jump_turn * 57.29578} degrees a step against the one it rode on")
    check("sheathed back: never turning faster than both hand and socket, nor jumping", put && items.carried(sword) && sheathing.worst_turn <= 0.0 && sheathing.worst_jump < 0.003 && sheathing.worst_jump_turn < 0.01745)

    // Through the mannequin's own swing, held in the right hand.
    items.draw(sword)
    run(e, 60)
    swung = items.swing(sword, 0)
    worst_grip = 0.0
    worst_through = 0.0
    worst_off = 0.0
    worst_finger = 0 - 1
    frames = 0
    while items.swinging(sword) && frames < 300 {
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        ha, hb = items.handle_axis(sword)
        grip = off_line(palm_axis(h, r, w, 1, radius), ha, hb)
        if grip > worst_grip { worst_grip = grip }
        through, off, which = fingers_on(r, w, rest, 1, ha, hb, radius)
        if through > worst_through { worst_through = through }
        if off > worst_off {
            worst_off = off
            worst_finger = which
        }
        frames = frames + 1
    }
    println("  through Sword_Regular_A (${frames} frames, at ${items.swing_rate(sword)} of its pace): the main hand ${worst_grip * 1000.0} mm off its grip at worst; a finger ${worst_through * 1000.0} mm into the handle and ${worst_off * 1000.0} mm off it at worst (finger ${worst_finger}, 1 the index)")
    check("through a swing the main hand is on its grip within 2 mm every frame", swung && frames > 10 && worst_grip < 0.002)
    check("and the fingers close round the handle: none through it, none off it by more than 5 mm", worst_through < 0.001 && worst_off < 0.005)

    // The edge swept: a body where the swing's edge passes, hit once.
    tip_at = core.vec3(0.0, 0.0, 0.0)
    // And the farthest ahead the tip comes at a person's waist to chest (the
    // fighter faces +z), where a person stood is cut (#940).
    front = core.vec3(0.0, 0.0, 0.0 - 100.0)
    swung = items.swing(sword, 0)
    strike = items.strike_at(sword)
    while items.swinging(sword) {
        engine.engine_update(e, STEP)
        if animator.state_time(a) <= strike {
            _ea, eb = items.edge_points(sword)
            tip_at = eb
        }
        _fa, fb = items.edge_points(sword)
        if fb.y > 0.6 && fb.y < 1.4 && fb.z > front.z { front = fb }
    }
    target = engine.object(e, "Target", null)
    behaviour.object_set_position(target, tip_at)
    body = physics.rigidbody(target, physics.KINEMATIC)
    physics.box_collider(target, core.vec3(0.15, 0.15, 0.15), physics.material(0.5, 0.0))
    run(e, 30)
    cost_was = items.sweep_seconds(sword)
    steps_was = items.sweeps(sword)
    items.swing(sword, 0)
    while items.swinging(sword) { engine.engine_update(e, STEP) }
    met = items.hits(sword)
    right = met == 1 && items.hit_object(sword, 0) == target
    per_swing = items.sweep_seconds(sword) - cost_was
    println("  the edge swept through a swing: ${met} hit, the target's ${right}; ${items.sweeps(sword) - steps_was} steps swept in ${per_swing * 1000000.0} microseconds")
    check("the edge's sweep hits the body it passes through, once a swing", right && body != null)
    check("at a measured cost: under 200 microseconds a swing", per_swing < 0.0002)

    // A person standing where the edge passes, the box moved away: unhurt,
    // with no bodies until its first blow, the edge passes through it
    // (#940); made physical (character.physical), its bodies are there.
    behaviour.object_set_position(target, core.vec3(0.0, 0.0 - 20.0, 0.0))
    victim = character.humanoid(e, "Victim", MANNEQUIN, g)
    vo = character.object_of(victim)
    behaviour.object_set_position(vo, core.vec3(front.x, 0.0, front.z - 0.1))
    mover.settle(character.mover_of(victim))
    run(e, 30)
    items.swing(sword, 0)
    while items.swinging(sword) { engine.engine_update(e, STEP) }
    unhurt_hits = items.hits(sword)
    bodied = character.physical(victim)
    run(e, 30)
    items.swing(sword, 0)
    // The edge's own speed at the hit, measured here from its ends a step
    // apart at the point of it nearest the hit.
    own_speed = 0.0 - 1.0
    sa, sb = items.edge_points(sword)
    qa = sa
    qb = sb
    while items.swinging(sword) {
        engine.engine_update(e, STEP)
        na, nb = items.edge_points(sword)
        // The sweep runs at the fixed step, ahead of the frame's animation,
        // so it reads the edge's move over the frame before this one.
        if own_speed < 0.0 && items.hits(sword) >= 1 {
            at = items.hit_point(sword, 0)
            along = core.v3_sub(sb, sa)
            u = core.clampf(core.v3_dot(core.v3_sub(at, sa), along) / core.v3_dot(along, along), 0.0, 1.0)
            moved = core.v3_lerp(core.v3_sub(sa, qa), core.v3_sub(sb, qb), u)
            own_speed = core.v3_len(moved) / STEP
        }
        qa = sa
        qb = sb
        sa = na
        sb = nb
    }
    body_hits = items.hits(sword)
    on_it = body_hits >= 1 && bodied && items.hit_ragdoll(sword, 0) == physanim.ragdoll_of(character.physanim_of(victim))
    println("  a person where the edge passes: unhurt with no bodies ${unhurt_hits} hit; made physical ${body_hits} hit, on its ragdoll ${on_it}")
    check("a person standing where the edge passes is hit once it is physical, before any blow (unhurt, with no bodies, it is passed through)", unhurt_hits == 0 && on_it)
    // What the hit says (#946): the bone met, the edge's velocity there and
    // how deep it went, a damage model's reading.
    hit_bone = items.hit_bone(sword, 0)
    hit_speed = core.v3_len(items.hit_velocity(sword, 0))
    hit_deep = items.hit_depth(sword, 0)
    speed_off = 1.0
    if own_speed > 0.0 {
        speed_off = (hit_speed - own_speed) / own_speed
        if speed_off < 0.0 { speed_off = 0.0 - speed_off }
    }
    println("  the person's hit: kind ${items.hit_kind(sword, 0)}, bone ${hit_bone}, the edge going ${hit_speed} m/s (its own there ${own_speed}, ${speed_off * 100.0}% off), ${hit_deep * 1000.0} mm past the surface that step")
    check("a hit on a figure names the bone met, the edge's speed there (within 5% of its own) and its depth", items.hit_kind(sword, 0) == items.HIT_BODY && hit_bone >= 0 && speed_off < 0.05 && hit_deep > 0.0)
    // And a wall where the edge passes, the person gone: the static world
    // met, once a swing. Swept for moving bodies alone, an edge passed
    // through walls.
    behaviour.object_set_position(vo, core.vec3(0.0, 0.0, 0.0 - 40.0))
    mover.settle(character.mover_of(victim))
    wall = engine.object(e, "Wall", null)
    behaviour.object_set_position(wall, core.vec3(front.x, front.y, front.z + 0.02))
    physics.box_collider(wall, core.vec3(1.0, 1.0, 0.05), physics.material(0.8, 0.0))
    run(e, 30)
    items.swing(sword, 0)
    while items.swinging(sword) { engine.engine_update(e, STEP) }
    walled = items.hits(sword) >= 1 && items.hit_kind(sword, 0) == items.HIT_STATIC
    println("  a wall where the edge passes: ${items.hits(sword)} hit, the static world ${walled}")
    check("an edge meets the static world where it passes, once a swing", walled && items.hits(sword) == 1)
    behaviour.object_set_position(wall, core.vec3(0.0, 0.0 - 30.0, 0.0))
    run(e, 5)
    // A blade raised in the way (#946): a second sword stood upright where
    // the swing's edge passes at its strike. The swing meets it, an item met
    // (a parry; what the swing does then is the game's, swing_stop ends it).
    guard = items.item_new(e, kinds[1], engine.object(e, "Guard", null))
    behaviour.object_set_position(items.object_of(guard), core.vec3(tip_at.x, tip_at.y - 0.55, tip_at.z))
    run(e, 5)
    items.swing(sword, 0)
    parried = false
    while items.swinging(sword) {
        engine.engine_update(e, STEP)
        n_hit = 0
        while n_hit < items.hits(sword) {
            if items.hit_kind(sword, n_hit) == items.HIT_ITEM && items.hit_item(sword, n_hit) == guard {
                if !parried { items.swing_stop(sword, 0.1) }
                parried = true
            }
            n_hit = n_hit + 1
        }
    }
    println("  a sword stood where the edge passes: met as an item ${parried}, the swing ended there ${!items.swinging(sword)}")
    check("a blade in the way is met as an item (a parry), and swing_stop ends the swing", parried && !items.swinging(sword))
    items.item_free(guard)
    run(e, 30)
    character.character_free(victim)

    // Clear of the wall and the target (static, they stay where they were
    // made), facing +z.
    fo = character.object_of(c)
    behaviour.object_set_position(fo, core.vec3(15.0, 0.0, 0.0))
    behaviour.object_set_rotation(fo, core.quat_ident())
    mover.settle(character.mover_of(c))
    ikrig.feet_reset(character.feet_of(c))
    run(e, 30)
    // A swing over a walk (#945): the sword's swing on the upper body as the
    // fighter walks on at 1.2 m/s, its legs on the walk. Played as a whole
    // state, a swing stopped the legs for its length.
    k = 0
    while k < 120 {
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    sm = metrics.meter_new(r, character.object_of(c))
    walked_from = behaviour.object_position(character.object_of(c))
    swung_over = items.swing_over(sword, 0, 1.0)
    still_walking = true
    frames_over = 0
    while items.swinging(sword) && frames_over < 300 {
        character.move(c, core.vec3(0.0, 0.0, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        metrics.meter_take(sm, STEP)
        if animator.current(a) != character.move_state(c) { still_walking = false }
        frames_over = frames_over + 1
    }
    walked = behaviour.object_position(character.object_of(c)).z - walked_from.z
    over_skate = metrics.meter_worst(sm, metrics.SKATE)
    metrics.meter_free(sm)
    println("  Sword_Regular_A over a walk (${frames_over} frames): walking all through it ${still_walking}, ${walked / ((frames_over as float) * STEP)} m/s; a toe skating ${over_skate * 1000.0} mm")
    check("a swing over a walk plays on the upper body: the legs keep walking (on the walk, at its pace), no toe skating 5 mm", swung_over && still_walking && frames_over > 10 && walked / ((frames_over as float) * STEP) > 1.0 && over_skate < 0.005)
    k = 0
    while k < 60 {
        character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }

    // A swing with the whole body (#945): Sword_Regular_A steps in 0.82 m.
    // Played as an act (character.swing), the take's root motion moves the
    // figure through its capsule; played in place, its feet slid under a
    // figure that stood. The take is a gliding lunge: sampled with its root
    // motion, its front foot slides 1.2 m along the floor and its back foot
    // drags 21 cm. So its feet are held to the take's own: swung once with
    // the foot IK on, and once off (the take as it is, the same way through).
    fo_body = character.object_of(c)
    step_take = animator.take(a, "Sword_Regular_A", true)
    step_root = clips.root_delta(step_take, 0.0, clips.duration(step_take), false)
    step_skates = [0.0, 0.0, 0.0]
    step_miss = 0.0
    step_off_grip = 0.0
    step_frames = 0
    stepped = true
    pass = 0
    while pass < 3 {
        foot_weight = 1.0
        if pass == 1 { foot_weight = 0.0 }
        ikrig.feet_set_weight(character.feet_of(c), foot_weight)
        heading = behaviour.object_rotation(fo_body)
        step_ahead = core.quat_apply(heading, core.vec3(0.0, 0.0, 1.0))
        step_across = core.quat_apply(heading, core.vec3(1.0, 0.0, 0.0))
        step_want = core.v3_add(core.v3_mul(step_across, step_root.x), core.v3_mul(step_ahead, step_root.y))
        step_from = behaviour.object_position(fo_body)
        bm = metrics.meter_new(r, fo_body)
        if !character.swing(c, sword, 0, 1.0, 0.1) { stepped = false }
        step_frames = 0
        while (items.swinging(sword) || character.acting(c)) && step_frames < 300 {
            engine.engine_update(e, STEP)
            metrics.meter_take(bm, STEP)
            pose.world(r, animator.pose_now(a), w)
            sa_h, sb_h = items.handle_axis(sword)
            grip_now = off_line(palm_axis(h, r, w, 1, radius), sa_h, sb_h)
            if pass == 0 && step_frames > 6 && grip_now > step_off_grip { step_off_grip = grip_now }
            step_frames = step_frames + 1
        }
        step_moved = core.v3_sub(behaviour.object_position(fo_body), step_from)
        step_moved = core.vec3(step_moved.x, 0.0, step_moved.z)
        miss_now = core.v3_len(core.v3_sub(step_moved, step_want))
        if miss_now > step_miss { step_miss = miss_now }
        step_skates[pass] = metrics.meter_worst(bm, metrics.SKATE)
        metrics.meter_free(bm)
        // Settled with its feet on before the next pass, as any stand is.
        ikrig.feet_set_weight(character.feet_of(c), 1.0)
        run(e, 30)
        pass = pass + 1
    }
    ikrig.feet_set_weight(character.feet_of(c), 1.0)
    println("  Sword_Regular_A with the whole body (${step_frames} frames): moved by its take's root motion (${core.v3_len(core.vec3(step_root.x, 0.0, step_root.y))} m) within ${step_miss * 100.0} cm; a toe skating ${step_skates[0] * 1000.0} mm, the take's own ${step_skates[1] * 1000.0} mm, swung again ${step_skates[2] * 1000.0} mm; the hand ${step_off_grip * 1000.0} mm off its grip at most")
    check("a swing with the whole body steps in by its take's root motion (within 2 cm), its toes skating no more than the take's own, the hand on its grip (1 cm)", stepped && step_miss < 0.02 && step_skates[0] <= step_skates[1] && step_off_grip < 0.01)
    // From the walk's stand as from its own end (#966): a foot the stand
    // held is held through the act's fade and stepped, not slid, to where
    // the take has it. Let go on the fade's first frame, it slid 117 mm.
    first_apart = step_skates[0] - step_skates[2]
    if first_apart < 0.0 { first_apart = 0.0 - first_apart }
    check("the first swing from the walk's stand skates within 2 mm of the same swing again", first_apart < 0.002)

    // A two-handed axe through a chop: the second hand on its grip.
    items.sheathe(sword)
    run(e, 60)
    axe = items.item_new(e, kinds[3], engine.object(e, "Axe", null))
    items.hold(axe, a, 1)
    run(e, 30)
    lean_axe = 0.0
    chopped = items.swing(axe, 0)
    worst_off_hand = 0.0
    worst_axe_turn = 0.0
    hand_l = pose.human(r, pose.HAND_L)
    axe_was = item_placed(axe)
    pose.world(r, animator.pose_now(a), w)
    right_was = joint_placed(r, w, hand_r)
    left_was = joint_placed(r, w, hand_l)
    frames = 0
    while items.swinging(axe) && frames < 400 {
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        ha, hb = items.handle_axis(axe)
        off_hand = off_line(palm_axis(h, r, w, 0, 0.017), ha, hb)
        if ikrig.hands_load_lean(h) > lean_axe { lean_axe = ikrig.hands_load_lean(h) }
        if frames > 15 && off_hand > worst_off_hand { worst_off_hand = off_hand }
        // The axe turns as its two hands steer it: never faster than the
        // faster of them (5% over, a tenth of a degree spared).
        axe_now = item_placed(axe)
        right_now = joint_placed(r, w, hand_r)
        left_now = joint_placed(r, w, hand_l)
        over = turned_by(axe_now.turn, axe_was.turn) - most_of(turned_by(right_now.turn, right_was.turn), turned_by(left_now.turn, left_was.turn)) * 1.05 - 0.0017
        if frames > 15 && over > worst_axe_turn { worst_axe_turn = over }
        axe_was = axe_now
        right_was = right_now
        left_was = left_now
        frames = frames + 1
    }
    axe_rate = items.swing_rate(axe)
    println("  the axe through TreeChopping_Loop (${frames} frames): the second hand ${worst_off_hand * 1000.0} mm off its grip at worst; the axe turned ${worst_axe_turn * 57.29578} degrees a step past the faster of its hands at most")
    check("a two-handed axe through a chop: the second hand on its grip within 5 mm every frame, the axe never turning faster than the hands that drive it", chopped && frames > 10 && worst_off_hand < 0.005 && worst_axe_turn <= 0.0)
    // Held through a walk, a run and a stop (#959): the off hand's fingers
    // wrapped on the haft follow it, none flipping from one wrap to another.
    // Siltreach's two-handed axe turned its off hand's fingers 65 to 96 rad/s
    // in nearly every step it took.
    own_fingers = takes_fingers_fastest(a)
    own_all = metrics.animator_fastest(a)
    held_arm = 0.0
    was_pose = pose.new(r)
    held_fingers = 0.0
    held_joint = 0 - 1
    held_off = 0.0
    k = 0
    while k < 360 {
        asked = core.vec3(0.0, 0.0, 0.0)
        if k < 150 { asked = core.vec3(0.0, 0.0, 1.2) }
        if k >= 150 && k < 210 { asked = core.vec3(0.0, 0.0, 3.0) }
        character.move(c, asked, core.vec3(0.0, 0.0, 0.0))
        pose.copy(r, animator.pose_now(a), was_pose)
        engine.engine_update(e, STEP)
        if k > 30 {
            turned, joint = fingers_fastest(r, was_pose, animator.pose_now(a), STEP)
            arm_ids = [pose.CLAVICLE_L, pose.UPPERARM_L, pose.LOWERARM_L, pose.HAND_L, pose.CLAVICLE_R, pose.UPPERARM_R, pose.LOWERARM_R, pose.HAND_R]
            q = 0
            while q < 8 {
                aj = pose.human(r, arm_ids[q])
                if aj >= 0 {
                    arm_turn = turned_by(pose.rotation(was_pose, aj), pose.rotation(animator.pose_now(a), aj)) / STEP
                    if arm_turn > held_arm { held_arm = arm_turn }
                }
                q = q + 1
            }
            if turned > held_fingers {
                held_fingers = turned
                held_joint = joint
            }
            pose.world(r, animator.pose_now(a), w)
            ha, hb = items.handle_axis(axe)
            off_now = off_line(palm_axis(h, r, w, 0, 0.017), ha, hb)
            if off_now > held_off { held_off = off_now }
        }
        k = k + 1
    }
    pose.release(was_pose)
    println("  the axe held two-handed through a walk, a run and a stop: a finger turning ${held_fingers} rad/s at most (joint ${held_joint}; the takes' own ${own_fingers}), an arm joint ${held_arm} (the takes' own fastest ${own_all}), the second hand ${held_off * 1000.0} mm off its grip at worst")
    check("held two-handed through a walk, a run and a stop, no finger turns faster than the takes' own fingers plus 2 rad/s, the second hand on its grip within 5 mm", held_fingers <= own_fingers + 2.0 && held_off < 0.005)
    check("and no arm joint turns faster than the takes' own fastest (metrics.animator_fastest): a gait's unsealed loop jumped its hands 5 cm, the second arm 77 rad/s (#962)", held_arm <= own_all)
    items.item_free(axe)
    run(e, 30)
    knife = items.item_new(e, kinds[0], engine.object(e, "Knife", null))
    items.hold(knife, a, 1)
    run(e, 30)
    lean_knife = 0.0
    _cut = items.swing(knife, 0)
    while items.swinging(knife) {
        engine.engine_update(e, STEP)
        if ikrig.hands_load_lean(h) > lean_knife { lean_knife = ikrig.hands_load_lean(h) }
    }
    knife_rate = items.swing_rate(knife)
    println("  a 0.15 kg knife swings at ${knife_rate} of the captured pace, the trunk leaning ${lean_knife * 57.29578} degrees at most through its swing; a 3.2 kg axe at ${axe_rate}, the trunk leaning ${lean_axe * 57.29578} degrees at most through its chop")
    check("a knife against an axe: the axe's swing slower and the trunk leaning further back for it", axe_rate < knife_rate && lean_axe > lean_knife)
    // Swapped as a player swaps (#959's second hand): the two-handed axe
    // sheathed and a pistol drawn in the same frame, one set of hands under
    // both. The pistol's draw let the axe's second hand go at once, and the
    // hand went 34 m/s in a frame toward the world's origin (Siltreach).
    axe2 = items.item_new(e, kinds[3], engine.object(e, "Axe2", null))
    pistol = items.item_new(e, kinds[5], engine.object(e, "Pistol", null))
    items.carry(axe2, a, "back")
    items.carry(pistol, a, "holster")
    items.draw(axe2)
    k = 0
    while k < 120 && items.phase_of(axe2) != items.PHASE_HELD {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    run(e, 30)
    sheathed = items.sheathe(axe2)
    drawn = items.draw(pistol)
    hand_l = pose.human(r, pose.HAND_L)
    pose.world(r, animator.pose_now(a), w)
    off_was = ikrig.to_ground(r, pose.translation(w, hand_l))
    fastest_left = 0.0
    k = 0
    while k < 120 {
        engine.engine_update(e, STEP)
        pose.world(r, animator.pose_now(a), w)
        off_now_at = ikrig.to_ground(r, pose.translation(w, hand_l))
        speed = core.v3_len(core.v3_sub(off_now_at, off_was)) / STEP
        if speed > fastest_left { fastest_left = speed }
        off_was = off_now_at
        k = k + 1
    }
    println("  the axe sheathed and a pistol drawn in one frame: sheathed ${sheathed}, drawn ${drawn}; the second hand letting go of the haft at ${fastest_left} m/s at most")
    check("the axe sheathed and a pistol drawn in one frame, the second hand lets go of the haft no faster than 4 m/s", sheathed && fastest_left < 4.0)
    items.item_free(pistol)
    items.item_free(axe2)
    items.item_free(knife)
    items.item_free(sword)
    pose.release(w)
    pose.release(rest)
    character.character_free(c)
    character.gaits_free(g)
    k = 0
    while k < 7 {
        items.kind_free(kinds[k])
        k = k + 1
    }
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("items: all checks passed (${g_checks})")
        return
    }
    println("items: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
