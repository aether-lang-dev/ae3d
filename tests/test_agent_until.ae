// The agent's loop over time (#510): object.find, frame.until and watch.*,
// over a real socket against a running engine, one request a frame, as
// tests/test_agent_checkpoint.ae is.
//
// A crate's Stamina drains by one each frame the world moves, from 100. So:
//   - object.find finds the crate by its component, a barrel by a part of its
//     name, and nothing by a kind there is none of;
//   - frame.until "Crate.Stamina.value < 50" stops at the first frame it
//     holds -- 49.0, and the frame before was 50 -- and holds there: a
//     frame.stats after it is the same frame;
//   - the watch added before it read every frame on the way, one less each;
//   - an until over an object that is not there times out, met false;
//   - a malformed expression is refused, saying where;
//   - a watch removed is gone.
import std.os
import std.tcp
import std.json
import std.string
import std.heap
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour
import ae3d.component

extern exit(code: int)

struct Stamina {
    value: float
}

stamina_new() -> ptr {
    s = heap.new(Stamina)
    s.value = 100.0
    return s as ptr
}

stamina_free(p: ptr) { heap.free(p as *Stamina) }

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_kind: ptr = null
var g_until_frame = 0
var g_watch = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 262144)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

int_of(r: ptr, name: string) -> int {
    if r == null { return 0 - 1 }
    node = json.object_get_raw(r, name)
    if node == null { return 0 - 1 }
    return json.get_int(node)
}

num_of(r: ptr, name: string) -> float {
    if r == null { return 0.0 - 1.0 }
    node = json.object_get_raw(r, name)
    if node == null { return 0.0 - 1.0 }
    return json.get_number(node)
}

bool_of(r: ptr, name: string) -> bool {
    if r == null { return false }
    node = json.object_get_raw(r, name)
    return node != null && json.get_bool(node) == 1
}

stamina_of(scene: *Scene) -> *Stamina {
    return component.state_of(behaviour.scene_find(scene, "Crate"), g_kind as *ComponentKind) as *Stamina
}

// Each frame the world moves, a point of stamina.
drain(state: ptr, e: *Engine, delta: float) {
    if delta <= 0.0 { return }
    s = stamina_of(engine.engine_scene(e))
    if s.value > 0.0 { s.value = s.value - 1.0 }
}

main() {
    println("agent_until: objects found, watched and run to, over the channel")
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_HIDDEN", "1")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 2000)
    k = component.kind("Stamina", "Gameplay", stamina_new, stamina_free)
    component.float_field(k, "value", offsetof(Stamina, value), 0.0, 100.0)
    g_kind = k as ptr
    crate = engine.object(e, "Crate", loader.cube(1.0))
    component.add(crate, k)
    engine.object(e, "Old Barrel", loader.cube(1.0))
    program = engine.behaviour_new("agent until test", null)
    program.update = drain
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        println("agent_until: SKIP no window")
        engine.engine_free(e)
        component.kinds_clear()
        return
    }
    engine.engine_free(e)
    component.kinds_clear()
    check("the exchange finished (stage ${g_stage})", g_stage == 9)
    if g_failures == 0 {
        println("agent_until: all checks passed (${g_checks})")
        return
    }
    println("agent_until: ${g_failures} of ${g_checks} checks FAILED")
    exit(1)
}

on_render(state: ptr, e: *Engine, delta: float) {
    scene = engine.engine_scene(e)
    if g_stage == 0 {
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("the client connects", sock != null)
        g_sock = sock
        // Held, so the watch and the run start from a frame that is known.
        ask_send("{\"id\":1,\"op\":\"frame.pause\"}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    doc = ask_receive()
    if doc == null { return }
    // Each answer read in the frame it arrives, and let go there.
    respond(e, scene, doc)
    json.free(doc)
}

respond(e: *Engine, scene: *Scene, doc: ptr) {
    r = result_of(doc)

    if g_stage == 1 {
        ask_send("{\"id\":2,\"op\":\"object.find\",\"component\":\"Stamina\"}")
    } else if g_stage == 2 {
        items = json.object_get_raw(r, "objects")
        first = json.array_get_raw(items, 0)
        check("object.find by component finds the crate, and only it",
              ok_of(doc) && int_of(r, "count") == 1 && json.get_string_raw(json.object_get_raw(first, "name")) == "Crate")
        ask_send("{\"id\":3,\"op\":\"object.find\",\"name\":\"Barrel\",\"component\":\"Nonesuch\"}")
    } else if g_stage == 3 {
        check("a kind there is none of is no object's", ok_of(doc) && int_of(r, "count") == 0)
        ask_send("{\"id\":4,\"op\":\"watch.add\",\"expression\":\"Crate.Stamina.value\",\"name\":\"stamina\"}")
    } else if g_stage == 4 {
        g_watch = int_of(r, "watch")
        check("a watch is added (${g_watch})", ok_of(doc) && g_watch > 0)
        ask_send("{\"id\":5,\"op\":\"frame.until\",\"expression\":\"Crate.Stamina.value < 50\",\"timeout\":600}")
    } else if g_stage == 5 {
        g_until_frame = int_of(r, "frame")
        now = stamina_of(scene).value
        check("frame.until stops where it first holds: 49 (it read ${num_of(r, "value")}, the crate holds ${now}, after ${int_of(r, "frames")} frames)",
              ok_of(doc) && bool_of(r, "met") && now == 49.0 && int_of(r, "frames") > 0)
        ask_send("{\"id\":6,\"op\":\"frame.stats\"}")
    } else if g_stage == 6 {
        check("and holds there: the next frame.stats is the same frame (${int_of(r, "frame")} of ${g_until_frame})",
              ok_of(doc) && int_of(r, "frame") == g_until_frame && stamina_of(scene).value == 49.0)
        ask_send("{\"id\":7,\"op\":\"watch.get\",\"watch\":${g_watch}}")
    } else if g_stage == 7 {
        frames = json.object_get_raw(r, "frames")
        values = json.object_get_raw(r, "values")
        n = json.array_size(values)
        steady = n > 2
        k = 1
        while k < n {
            a = json.get_number(json.array_get_raw(values, k - 1))
            b = json.get_number(json.array_get_raw(values, k))
            fa = json.get_int(json.array_get_raw(frames, k - 1))
            fb = json.get_int(json.array_get_raw(frames, k))
            if fb != fa + 1 || b != a - 1.0 { steady = false }
            k = k + 1
        }
        last = json.get_number(json.array_get_raw(values, n - 1))
        check("the watch read every frame on the way, one less each, to 49 (${n} samples)", ok_of(doc) && steady && last == 49.0)
        ask_send("{\"id\":8,\"op\":\"frame.until\",\"expression\":\"Crate.Stamina.value <\"}")
        g_stage = 70
        return
    } else if g_stage == 70 {
        reason = ""
        node = json.object_get_raw(doc, "error")
        if node != null { reason = json.get_string_raw(node) }
        check("a malformed expression is refused, saying where (${reason})", !ok_of(doc) && string.contains(reason, "at 22") == 1)
        ask_send("{\"id\":9,\"op\":\"frame.until\",\"expression\":\"Ghost.Stamina.value < 0\",\"timeout\":5}")
        g_stage = 7
    } else if g_stage == 8 {
        check("an until over an object that is not there times out, met false, after its 5 frames",
              ok_of(doc) && !bool_of(r, "met") && int_of(r, "frames") == 5)
        ask_send("{\"id\":10,\"op\":\"watch.remove\",\"watch\":${g_watch}}")
    } else if g_stage == 9 {
        ask_send("{\"id\":11,\"op\":\"watch.list\"}")
        g_stage = 90
        return
    } else if g_stage == 90 {
        check("a watch removed is gone", ok_of(doc) && json.array_size(json.object_get_raw(r, "watches")) == 0)
        g_stage = 9
        engine.engine_stop(e)
        return
    }
    g_stage = g_stage + 1
}
