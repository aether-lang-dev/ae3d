// A figure's animation at levels of detail (#862, ae3d.animlod): UE5
// mannequins on 100STYLE's neutral gaits, walking at 1.2 m/s. No window;
// stepped at 60 Hz.
//
//   - a crowd's pose bank baked from the walking figure's own graph (its
//     move blend at the velocity it walks at): a palette a frame over the
//     figure's every bone, going at the speed the graph goes, its cycle
//     closing without a seam, and its pose at the figure's phase the
//     graph's own pose (its takes, blended as the graph blends them);
//   - the graph evaluated one frame in 4 and in 8 (animator.set_every),
//     each frame drawn between: near a figure drawn every frame with its
//     feet unlocked as a slower rate's are, and no joint turning faster
//     than one drawn every frame; taken back to every frame, no jump, and
//     a second on drawn as the figure drawn every frame;
//   - a standing figure handed a crowd instance's walk by pose snapshot
//     (animlod.enter_character): its first frames go on from the
//     instance's pose no faster than the walk turns, and it walks on in
//     its move blend; a walking figure handed back (animlod.leave) to the
//     phase its graph is at;
//   - a budget over sixteen walkers: within its seconds, the nearest every
//     frame, each no faster than one nearer, the farthest slowed.
//
// Figure 0 walks every frame, 1 and 2 at the slower rates, 3 every frame
// with its feet unlocked, 4 stands until it is handed the crowd's walk.
// The cost of each level per figure is benchmarks/bench_animlod.ae's.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.skin
import ae3d.posing
import ae3d.animator
import ae3d.ikrig
import ae3d.character
import ae3d.animlod

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const FRAMES = 32
const WALK = 1.2
const CROWD = 16

var g_checks = 0
var g_failures = 0
var g_engine: ptr = null
var g_people: ptr = null           // ptr[CROWD]: *Character
var g_count = 0
var g_walking = 0                  // the first this many walk; the rest stand

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

person(i: int) -> *Character { return (g_people as ptr[])[i] as *Character }
anim(i: int) -> *Animator { return character.animator_of(person(i)) }

// The largest turn of any joint between two poses on rig `r`, radians.
apart(r: *pose.Rig, p: ptr, q: ptr) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        a = pose.rotation(p, j)
        b = pose.rotation(q, j)
        d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
        if d > 1.0 { d = 1.0 }
        t = 2.0 * core.acos_of(d)
        if t > most { most = t }
        j = j + 1
    }
    return most
}

// The same over every joint but the toes (the balls of the feet): the
// feet's toe bend, as a heel peels off the ground, is a flick of a tenth
// of a second that a slower rate samples a frame either side of.
apart_body(r: *pose.Rig, p: ptr, q: ptr) -> float {
    left = pose.human(r, pose.BALL_L)
    right = pose.human(r, pose.BALL_R)
    most = 0.0
    j = 0
    while j < pose.count(r) {
        if j != left && j != right {
            a = pose.rotation(p, j)
            b = pose.rotation(q, j)
            d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
            if d > 1.0 { d = 1.0 }
            t = 2.0 * core.acos_of(d)
            if t > most { most = t }
        }
        j = j + 1
    }
    return most
}

// One frame: the walkers asked to walk on, the rest to stand.
frame() {
    ahead = core.vec3(0.0, 0.0, WALK)
    still = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < g_count {
        if i < g_walking { character.move(person(i), ahead, still) } else { character.move(person(i), still, still) }
        i = i + 1
    }
    engine.engine_update(g_engine as *Engine, STEP)
}

frames(n: int) {
    k = 0
    while k < n {
        frame()
        k = k + 1
    }
}

make_people(g: *Gaits) {
    g_people = calloc(CROWD, 8)
    k = 0
    while k < CROWD {
        c = character.humanoid(g_engine as *Engine, "Walker", MANNEQUIN, g)
        if c == null {
            println("  no walker: ${character.error()}")
            exit(1)
        }
        behaviour.object_set_position(character.object_of(c), core.vec3((k as float) * 3.0, 0.0, 0.0))
        (g_people as ptr[])[k] = c as ptr
        k = k + 1
    }
    g_count = CROWD
}

// --- the bank ---

check_bank(b: *Bank) {
    a = anim(0)
    c = person(0)
    r = animator.rig(a)
    sk = figure.skeleton(figure.figure_of(character.object_of(c)))
    check("the bank: a palette a frame over the figure's every bone", b != null && posing.posebank_frames(animlod.bank_posebank(b)) == FRAMES && posing.posebank_bones(animlod.bank_posebank(b)) == skin.skeleton_count(sk))
    went = animator.ground_speed(a)
    println("  the bank goes ${animlod.bank_speed(b)} m/s over a ${animlod.bank_cycle(b)} s cycle; the graph ${went} m/s")
    check("the bank goes at the speed the graph goes (within 3%)", core.abs_of(animlod.bank_speed(b) - went) < 0.03 * went)
    // Its cycle closes: the step from the last frame round to the first no
    // larger than the largest between frames inside it.
    p = pose.new(r)
    q = pose.new(r)
    inside = 0.0
    k = 0
    while k < FRAMES - 1 {
        animlod.bank_pose(b, (k as float) / (FRAMES as float), p)
        animlod.bank_pose(b, ((k + 1) as float) / (FRAMES as float), q)
        d = apart(r, p, q)
        if d > inside { inside = d }
        k = k + 1
    }
    animlod.bank_pose(b, ((FRAMES - 1) as float) / (FRAMES as float), p)
    animlod.bank_pose(b, 0.0, q)
    seam = apart(r, p, q)
    println("  a frame of the bank turns a joint ${inside} rad at most; the loop's seam ${seam} rad")
    check("the bank's cycle closes without a seam (its last frame to its first no more than 1.5 times any step inside)", seam <= 1.5 * inside)
    // Its pose at the figure's phase, frame after frame, against the graph's own.
    move = character.move_state(c)
    graph = 0.0
    drawn = 0.0
    in_move = true
    k = 0
    while k < 60 {
        frame()
        if animator.current(a) != move { in_move = false }
        animlod.bank_pose(b, animator.cycle_phase(a, move), p)
        d = apart(r, p, animator.pose_graph(a))
        if d > graph { graph = d }
        d = apart(r, p, animator.pose_shown(a))
        if d > drawn { drawn = d }
        k = k + 1
    }
    println("  the bank at the figure's phase against its graph's pose: ${graph} rad; against what it draws (feet, eyes on): ${drawn} rad")
    // Between its frames the bank is blended as the GPU draws it: off the
    // graph by at most half a frame's step, if it is the graph's data.
    check("the bank at the figure's phase is the graph's own pose (every joint within half a frame's largest step)", in_move && graph < 0.5 * inside)
    pose.release(p)
    pose.release(q)
}

// --- update-rate LOD ---

// Figures 0 to 3 drawn, measured frame to frame: each one's fastest joint
// turn, and how far each is off figure 3 (every frame, its feet unlocked:
// the feet a slower rate solves) and off figure 0 (every frame, locked).
struct Drawn {
    prev: ptr                      // ptr[4]: each figure's pose drawn the frame before
    fastest: ptr                   // float[4]: each one's fastest joint turn, rad/s
    gap: ptr                       // float[4]: each one's largest turn off figure 3's drawn pose
    locked_gap: ptr                // float[4]: and off figure 0's
    body_gap: ptr                  // float[4]: off figure 3's but for the toes (apart_body)
}

drawn_new(r: *pose.Rig) -> *Drawn {
    d = heap.new(Drawn)
    d.prev = calloc(4, 8)
    d.fastest = calloc(4, 8)
    d.gap = calloc(4, 8)
    d.locked_gap = calloc(4, 8)
    d.body_gap = calloc(4, 8)
    i = 0
    while i < 4 {
        (d.prev as ptr[])[i] = pose.new(r)
        pose.copy(r, animator.pose_shown(anim(i)), (d.prev as ptr[])[i])
        i = i + 1
    }
    return d
}

drawn_free(d: *Drawn) {
    i = 0
    while i < 4 {
        pose.release((d.prev as ptr[])[i])
        i = i + 1
    }
    free(d.prev)
    free(d.fastest)
    free(d.gap)
    free(d.locked_gap)
    free(d.body_gap)
    heap.free(d)
}

drawn_frame(d: *Drawn, r: *pose.Rig) {
    frame()
    i = 0
    while i < 4 {
        now = animator.pose_shown(anim(i))
        prev = (d.prev as ptr[])[i]
        speed = apart(r, prev, now) / STEP
        if speed > (d.fastest as float[])[i] { (d.fastest as float[])[i] = speed }
        gap = apart(r, animator.pose_shown(anim(3)), now)
        if gap > (d.gap as float[])[i] { (d.gap as float[])[i] = gap }
        gap = apart(r, animator.pose_shown(anim(0)), now)
        if gap > (d.locked_gap as float[])[i] { (d.locked_gap as float[])[i] = gap }
        gap = apart_body(r, animator.pose_shown(anim(3)), now)
        if gap > (d.body_gap as float[])[i] { (d.body_gap as float[])[i] = gap }
        pose.copy(r, now, prev)
        i = i + 1
    }
}

frames_drawn(d: *Drawn, r: *pose.Rig, n: int) {
    k = 0
    while k < n {
        drawn_frame(d, r)
        k = k + 1
    }
}

drawn_reset(d: *Drawn) {
    i = 0
    while i < 4 {
        (d.fastest as float[])[i] = 0.0
        (d.gap as float[])[i] = 0.0
        (d.locked_gap as float[])[i] = 0.0
        (d.body_gap as float[])[i] = 0.0
        i = i + 1
    }
}

// The faster of the two figures drawn every frame, rad/s.
every_frame_fastest(d: *Drawn) -> float {
    f = d.fastest as float[]
    if f[3] > f[0] { return f[3] }
    return f[0]
}

check_rates() {
    r = animator.rig(anim(0))
    animator.set_every(anim(1), 4, 0)
    animator.set_every(anim(2), 8, 0)
    d = drawn_new(r)
    frames_drawn(d, r, 180)
    fastest = d.fastest as float[]
    gap = d.gap as float[]
    locked = d.locked_gap as float[]
    body = d.body_gap as float[]
    most = every_frame_fastest(d)
    println("  over 3 s, every frame: a joint turns ${fastest[0]} rad/s at most (feet locked), ${fastest[3]} (unlocked), the two ${gap[0]} rad apart")
    println("  one in 4: ${fastest[1]} rad/s; off every frame unlocked ${body[1]} rad but the toes, ${gap[1]} with them; off locked ${locked[1]}")
    println("  one in 8: ${fastest[2]} rad/s; off every frame unlocked ${body[2]} rad but the toes, ${gap[2]} with them; off locked ${locked[2]}")
    check("one in 4 and one in 8: no joint turning faster than every frame turns one (within 10%)", fastest[1] <= 1.1 * most && fastest[2] <= 1.1 * most)
    // Drawn between two evaluations, a joint is off by what the motion bends
    // away from a straight turn over the interval: held within a quarter of
    // the most any joint turns over one (0.17 rad at 4 frames, 0.34 at 8;
    // 0.13 and 0.18 measured).
    check("one in 4 and one in 8 drawn within a quarter of an interval's fastest turn of every frame, but the toes (the feet unlocked alike)", body[1] < 0.25 * most * 4.0 * STEP && body[2] < 0.25 * most * 8.0 * STEP)
    // Back to every frame, two frames into an interval: no jump.
    frame()
    frame()
    animator.set_every(anim(1), 1, 0)
    animator.set_every(anim(2), 1, 0)
    drawn_reset(d)
    frames_drawn(d, r, 60)
    most = every_frame_fastest(d)
    println("  back to every frame: ${fastest[1]} and ${fastest[2]} rad/s at most against ${most}")
    check("taken back to every frame mid-interval, no joint turns faster than every frame turns one (within 10%)", fastest[1] <= 1.1 * most && fastest[2] <= 1.1 * most)
    drawn_reset(d)
    drawn_frame(d, r)
    println("  a second on: ${locked[1]} and ${locked[2]} rad off the figure drawn every frame")
    check("a second back at every frame, drawn as the figure drawn every frame (within 0.01 rad)", locked[1] < 0.01 && locked[2] < 0.01)
    drawn_free(d)
}

// --- hand-over ---

check_enter(b: *Bank, walking_fastest: float) {
    // Figure 4 has stood since the start; it takes over a crowd instance
    // walking at phase 0.37 where it stands.
    i = 4
    c = person(i)
    a = anim(i)
    r = animator.rig(a)
    was = pose.new(r)
    phase = 0.37
    animlod.bank_pose(b, phase, was)
    animlod.enter_character(b, c, phase, core.vec3(0.0, 0.0, WALK), STEP, 0.3)
    g_walking = 5
    fastest = 0.0
    in_move = true
    k = 0
    while k < 60 {
        frame()
        now = animator.pose_shown(a)
        speed = apart(r, was, now) / STEP
        if speed > fastest { fastest = speed }
        if k == 0 { println("  the first frame after the hand-over turns a joint ${speed} rad/s from the instance's pose") }
        if animator.current(a) != character.move_state(c) { in_move = false }
        pose.copy(r, now, was)
        k = k + 1
    }
    animlod.bank_pose(b, animator.cycle_phase(a, character.move_state(c)), was)
    off = apart(r, was, animator.pose_graph(a))
    println("  over its first second: ${fastest} rad/s at most (walking, ${walking_fastest}); then ${off} rad off the bank at its phase")
    check("handed a crowd instance's walk, its first second turns no joint faster than the walk does (within 10%)", fastest <= 1.1 * walking_fastest)
    check("and it walks on in its move blend, the bank's motion (within 0.03 rad of the bank at its phase)", in_move && off < 0.03)
    pose.release(was)
}

check_leave(b: *Bank) {
    a = anim(0)
    r = animator.rig(a)
    move = character.move_state(person(0))
    phase = animlod.leave(b, a)
    at = animator.cycle_phase(a, move)
    off = core.abs_of(phase - at)
    if off > 0.5 { off = 1.0 - off }
    p = pose.new(r)
    animlod.bank_pose(b, phase, p)
    pop = apart(r, p, animator.pose_shown(a))
    println("  handed back at phase ${phase}, its graph at ${at}; the instance's pose ${pop} rad off what it drew")
    check("handed back to the crowd at the phase its graph is at (within a frame of the bank)", off < 1.0 / (FRAMES as float))
    pose.release(p)
}

// --- the budget ---

check_budget() {
    b = animlod.budget_new(g_engine as *Engine, 1.0)
    i = 0
    while i < g_count {
        animlod.budget_add(b, anim(i))
        i = i + 1
    }
    // Looking down +x from beside the first: the line of walkers ahead.
    at = behaviour.object_position(character.object_of(person(0)))
    animlod.budget_view(b, core.vec3(0.0 - 2.0, 1.6, at.z), core.vec3(1.0, 0.0, 0.0), 0.8)
    frames(10)
    whole = 0.0
    i = 0
    while i < g_count {
        whole = whole + animator.graph_cost(anim(i))
        i = i + 1
    }
    animlod.budget_set_seconds(b, whole * 0.35)
    frames(30)
    ordered = true
    i = 1
    while i < g_count {
        // Placed along +x, each further than the one before.
        if animlod.budget_every(b, i) < animlod.budget_every(b, i - 1) { ordered = false }
        i = i + 1
    }
    println("  sixteen walkers' graphs ${whole * 1000000.0} us a frame; a budget of 35%: ${animlod.budget_planned(b) * 1000000.0} us planned; the nearest every ${animlod.budget_every(b, 0)}, the farthest every ${animlod.budget_every(b, g_count - 1)}")
    check("the budget's plan within its seconds", animlod.budget_planned(b) <= animlod.budget_seconds(b))
    check("the nearest every frame, each no faster than one nearer, the farthest slowed", animlod.budget_every(b, 0) == 1 && ordered && animlod.budget_every(b, g_count - 1) > 1)
    animlod.budget_free(b)
    check("freed, every figure back to every frame", animator.update_every(anim(g_count - 1)) == 1)
}

main() {
    println("animlod: a figure's animation at levels of detail (#862)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g_engine = e as ptr
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    make_people(g)
    // Figure 3 every frame with its feet unlocked: what a slower rate's
    // feet are measured against.
    ikrig.feet_set_lock(character.feet_of(person(3)), false)
    g_walking = 4
    frames(120)
    b = animlod.bake(anim(0), character.move_state(person(0)), FRAMES)
    if b == null {
        println("  no bank")
        exit(1)
    }
    check_bank(b)
    // The walk's own fastest joint turn, drawn every frame, for the hand-over's bound.
    r = animator.rig(anim(0))
    d = drawn_new(r)
    k = 0
    while k < 60 {
        drawn_frame(d, r)
        k = k + 1
    }
    walking_fastest = (d.fastest as float[])[0]
    drawn_free(d)
    check_rates()
    check_enter(b, walking_fastest)
    check_leave(b)
    g_walking = CROWD
    check_budget()
    animlod.bank_free(b)
    k = 0
    while k < g_count {
        character.character_free(person(k))
        k = k + 1
    }
    free(g_people)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("animlod: all checks passed (${g_checks})")
        return
    }
    println("animlod: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
