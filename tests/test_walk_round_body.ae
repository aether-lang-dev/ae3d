// ci: optimised -- seeded knockdowns and walks, CPU work -O0 makes several times slower
// A walker steps round a person lying struck in its way (#979): the UE5
// mannequin made a character (ae3d.character), knocked down as
// test_knockdowns knocks it (the full ragdoll, LIMP, its character
// paused), lying at rest across the way of another, which is asked to walk
// straight on past it at a walk, its capsule solid so it steers round what
// it meets (character.steer, #956). Over seeds, the body's pose and where
// it lies across the way changing.
//
// Held to: the walker's capsule never touches any of the lying body's
// bodies (their capsules, level), and it gets past, beyond the body by
// PAST within the time a walk there takes and half again. Before, steer
// left a paused character out, and the walker walked through the body as
// through nothing (the plaza: bodies walked through 0.17 s on seed 2).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.physanim
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const SEEDS = 16                     // AE3D_SEEDS for another count, AE3D_SEED the first
const DOWN_MOST = 600
const WALK = 1.2                     // m/s asked
const AHEAD = 3.0                    // m along its way the body lies
const PAST = 1.5                     // m beyond the body it gets to

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

hashed(seed: int, salt: int) -> float {
    h = (seed * 73856093 + salt * 19349663 + 83492791) % 1000003
    if h < 0 { h = 0 - h }
    return (h as float) / 1000003.0
}

// The lying body's least gap to the walker's capsule, level, metres
// (negative inside): each of its bodies' capsules against the capsule's
// axis.
gap_to(r: *Ragdoll, at: Vec3, radius: float) -> float {
    h = physics.ragdoll_human(r)
    least = 1000.0
    b = 0
    while b < physics.ragdoll_bone_count(r) {
        bone = human.bone_at(h, b)
        t = dynamics.body_get_transform(bone.body_id)
        cap = dynamics.shape_get_capsule(bone.shape_id)
        k = 0
        while k < 5 {
            f = (k as float) * 0.25
            local = core.v3_add(cap.center1, core.v3_mul(core.v3_sub(cap.center2, cap.center1), f))
            p = core.v3_add(t.p, core.quat_apply(t.q, local))
            d = core.sqrt_of((p.x - at.x) * (p.x - at.x) + (p.z - at.z) * (p.z - at.z)) - radius - cap.radius
            if d < least { least = d }
            k = k + 1
        }
        b = b + 1
    }
    return least
}

// Seed `seed`: the least gap the walker kept, and how far past the body it
// got (along its way, beyond the body's middle).
trial(g: *Gaits, seed: int) -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    down = character.humanoid(e, "Down", MANNEQUIN, g)
    walker = character.humanoid(e, "Walker", MANNEQUIN, g)
    if down == null || walker == null {
        println("  no character: ${character.error()}")
        exit(1)
    }
    character.physical(down)
    character.physical(walker)
    across = (hashed(seed, 3) * 2.0 - 1.0) * 0.3
    od = character.object_of(down)
    behaviour.object_set_position(od, core.vec3(across, 0.0, AHEAD))
    ow = character.object_of(walker)
    behaviour.object_set_position(ow, core.vec3(0.0, 0.0, 0.0 - 4.0))
    physics.character_set_solid(physics.character_of(od), true)
    physics.character_set_solid(physics.character_of(ow), true)
    k = 0
    while k < 30 {
        character.move(down, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        character.move(walker, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Struck down where it stands, as the plaza's car strikes.
    pa = character.physanim_of(down)
    character.pause(down)
    animator.pause(character.animator_of(down))
    physanim.release(pa)
    physics.character_set_solid(physics.character_of(od), false)
    rag = physanim.ragdoll_of(pa)
    m = motion.active_ragdoll(rag)
    motion.attach(e, m)
    motion.set_mode(m, motion.LIMP)
    body = physanim.bone_named(pa, "Chest")
    side = hashed(seed, 1) * 6.2831853
    way = core.vec3(core.sin_of(side), 0.15, core.cos_of(side))
    physics.ragdoll_apply_impulse(rag, body, core.v3_mul(way, 60.0 + hashed(seed, 2) * 40.0), behaviour.object_position(physics.ragdoll_bone(rag, body)))
    k = 0
    while k < DOWN_MOST && !(k > 30 && motion.down(m)) {
        character.move(walker, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    lies = behaviour.object_position(physics.ragdoll_bone(rag, human.BONE_PELVIS))
    radius = physics.character_radius(physics.character_of(ow))
    least = 1000.0
    steps = ((AHEAD + 4.0 + PAST) / WALK * 1.5 / STEP) as int
    k = 0
    while k < steps {
        character.move(walker, core.vec3(0.0, 0.0, WALK), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        gap = gap_to(rag, behaviour.object_position(ow), radius)
        if gap < least { least = gap }
        if core.env_int("AE3D_ROUND_STEPS", 0 - 1) == seed && k % 6 == 0 {
            wa = behaviour.object_position(ow)
            println("    ${k}: walker at ${wa.x} ${wa.y} ${wa.z}, gap ${gap}")
        }
        k = k + 1
    }
    past = behaviour.object_position(ow).z - lies.z
    if core.env_int("AE3D_ROUND_TRACE", 0) == 1 { println("  seed ${seed}: the body lies at ${lies.x} ${lies.z}, the walker kept ${least} m off it, got ${past} m past, ended at ${behaviour.object_position(ow).x}") }
    motion.release(m)
    character.character_free(walker)
    character.character_free(down)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return least, past
}

main() {
    println("test_walk_round_body")
    g = character.gaits(GAITS)
    seeds = core.env_int("AE3D_SEEDS", SEEDS)
    least = 1000.0
    least_seed = 0 - 1
    shortest = 1000.0
    shortest_seed = 0 - 1
    n = core.env_int("AE3D_SEED", 0)
    while n < core.env_int("AE3D_SEED", 0) + seeds {
        gap, past = trial(g, n)
        if gap < least {
            least = gap
            least_seed = n
        }
        if past < shortest {
            shortest = past
            shortest_seed = n
        }
        n = n + 1
    }
    println("  ${seeds} seeds: the walker kept ${least} m off the body at least (seed ${least_seed}); got ${shortest} m past it at least (seed ${shortest_seed})")
    check("the walker never touches the body lying in its way (${least} m)", least > 0.0)
    check("the walker gets past it, ${PAST} m beyond (${shortest} m)", shortest > PAST)
    character.gaits_free(g)
    if g_failures > 0 {
        println("walk round a body: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    // ci.sh passes a suite on the words "all checks passed".
    println("walk round a body: all checks passed (${g_checks})")
}
