// A texture's repeat broken up, and a field varied over the world (#737),
// on OpenGL and Vulkan.
//
// A wall seen face on, a noise texture repeating every metre across it:
//   - sampled as it repeats, the frame matches itself shifted by one tile
//     almost exactly (the correlation is near 1): the grid is plain to see;
//   - sampled as hexagons of offset copies, it no longer does;
//   - a plain white wall with variation on is lighter and darker from
//     stretch to stretch; with it off it is one shade;
//   - with a detail layer (its own texture again at eight times the
//     frequency) the noise wall, magnified to ten metres a tile, has finer
//     grain than without, and none past the distance the layer fades by;
//   - a wall with no UVs to speak of is one flat colour, and mapped from
//     the world on three planes it has the texture's grain;
//   - a glossy wall whose fine bumps its mips have averaged away shows a
//     softer highlight than the same wall flat: the bumps went into its
//     roughness (Toksvig) instead of vanishing;
//   - glitter: a wall whose grains are facets flashes in a sparse share
//     of its pixels, and none without it (#741);
//   - embers: a charred wall up close glows red-hot in a share of its
//     pixels that grows with the share of its char alight -- barely any
//     with none, over two fifths with all -- and what glows is an ember's
//     red, not white (#738).
// Both backends the same, to within a few hundredths.
import std.mem
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.vulkan
import ae3d.picture
import ae3d.png

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float

const WIDTH = 320
const HEIGHT = 180
const NOISE = "test://tile_breakup/noise"
const WHITE = "test://tile_breakup/white"
const BUMPS = "test://tile_breakup/bumps"
const DISTANCE = 10.0

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

textures() -> bool {
    side = 64
    pixels = calloc(side * side, 4)
    seed = 12345 as long
    i = 0
    while i < side * side {
        seed = (seed * (1103515245 as long) + (12345 as long)) % (2147483648 as long)
        v = 0.15 + 0.7 * (((seed / (65536 as long)) % (1024 as long)) as float) / 1023.0
        png.rgba_set(pixels, i, v, v, v, 1.0)
        i = i + 1
    }
    ok = picture.register_rgba(NOISE, pixels, side, side) == 1
    i = 0
    while i < side * side {
        png.rgba_set(pixels, i, 0.8, 0.8, 0.8, 1.0)
        i = i + 1
    }
    ok = ok && picture.register_rgba(WHITE, pixels, side, side) == 1
    // Bumps: every other pair of columns tilted 30 degrees left, the rest
    // 30 right, so a mip that averages them is flat and short.
    i = 0
    while i < side * side {
        x = i % side
        tilt = 0.25
        if (x / 2) % 2 == 0 { tilt = 0.75 }
        png.rgba_set(pixels, i, tilt, 0.5, 0.933, 1.0)
        i = i + 1
    }
    ok = ok && picture.register_rgba(BUMPS, pixels, side, side) == 1
    free(pixels)
    return ok
}

// A wall 80 m across at DISTANCE, facing the camera, the texture
// repeating `reps` times across it.
wall(texture: string, reps: float) -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    z = 0.0 - DISTANCE
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 40.0, 0.0 - 40.0, z), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(40.0, 0.0 - 40.0, z), reps, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(40.0, 40.0, z), reps, reps, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 40.0, 40.0, z), 0.0, reps, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_set_texture(m, texture)
    core.model_set_pbr(m, 0.0, 1.0)
    core.model_set_specular(m, 0.0, 0.0, 0.0)
    core.model_set_casts_shadow(m, false)
    return m
}

luma(pixels: ptr, x: int, y: int) -> float {
    at = (y * WIDTH + x) * 4
    return (mem.get_byte(pixels, at) + mem.get_byte(pixels, at + 1) + mem.get_byte(pixels, at + 2)) as float / 3.0
}

// How alike the frame is to itself `lag` pixels to the right: the
// normalised correlation over the middle rows.
correlation(pixels: ptr, lag: int) -> float {
    sa = 0.0
    sb = 0.0
    saa = 0.0
    sbb = 0.0
    sab = 0.0
    n = 0
    y = HEIGHT / 4
    while y < HEIGHT * 3 / 4 {
        x = 8
        while x + lag < WIDTH - 8 {
            a = luma(pixels, x, y)
            b = luma(pixels, x + lag, y)
            sa = sa + a
            sb = sb + b
            saa = saa + a * a
            sbb = sbb + b * b
            sab = sab + a * b
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    fn = n as float
    cov = sab / fn - (sa / fn) * (sb / fn)
    va = saa / fn - (sa / fn) * (sa / fn)
    vb = sbb / fn - (sb / fn) * (sb / fn)
    if va <= 0.0 || vb <= 0.0 { return 0.0 }
    return cov / sqrt(va * vb)
}

// The largest correlation over every lag from 8 to 80 pixels: the tile's
// period, wherever the projection put it.
periodicity(pixels: ptr) -> float {
    best = 0.0 - 1.0
    lag = 8
    while lag <= 80 {
        c = correlation(pixels, lag)
        if c > best { best = c }
        lag = lag + 1
    }
    return best
}

// The spread of the middle of the frame's luminance, over its mean.
spread(pixels: ptr) -> float {
    s = 0.0
    ss = 0.0
    n = 0
    y = HEIGHT / 4
    while y < HEIGHT * 3 / 4 {
        x = WIDTH / 8
        while x < WIDTH * 7 / 8 {
            v = luma(pixels, x, y)
            s = s + v
            ss = ss + v * v
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    mean = s / (n as float)
    if mean <= 0.0 { return 0.0 }
    return sqrt(ss / (n as float) - mean * mean) / mean
}

struct Readings {
    sparkles: int
    plain_sparkles: int
    embers_none: float
    embers_half: float
    embers_full: float
    ember_red: float
    unmapped: float
    triplanar: float
    flat_peak: float
    bumpy_peak: float
    repeated: float
    broken: float
    flat: float
    varied: float
    coarse: float
    grained: float
    faded: float
}

// A wall 4 m across, 1.5 m in front of the camera, facing it: close enough
// that char a few centimetres a block is many pixels a block.
near_wall() -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    z = 0.0 - 1.5
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 2.0, 0.0 - 2.0, z), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(2.0, 0.0 - 2.0, z), 1.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(2.0, 2.0, z), 1.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 2.0, 2.0, z), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_set_texture(m, WHITE)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// The share of the frame glowing red-hot, and the hot pixels' red over
// their blue.
struct Glow {
    share: float
    red: float
}

glowing(pixels: ptr) -> Glow {
    n = 0
    r = 0.0
    b = 0.0
    i = 0
    while i < WIDTH * HEIGHT {
        pr = mem.get_byte(pixels, i * 4)
        if pr > 90 {
            n = n + 1
            r = r + (pr as float)
            b = b + (mem.get_byte(pixels, i * 4 + 2) as float)
        }
        i = i + 1
    }
    red = 0.0
    if b > 0.0 { red = r / b }
    if n > 0 && b == 0.0 { red = 100.0 }
    return Glow { share: (n as float) / ((WIDTH * HEIGHT) as float), red: red }
}

// The mean 4-neighbour Laplacian of the middle of the frame: its grain.
grain(pixels: ptr) -> float {
    total = 0.0
    n = 0
    y = HEIGHT / 4
    while y < HEIGHT * 3 / 4 {
        x = WIDTH / 8
        while x < WIDTH * 7 / 8 {
            c = luma(pixels, x, y) * 4.0 - luma(pixels, x - 1, y) - luma(pixels, x + 1, y) - luma(pixels, x, y - 1) - luma(pixels, x, y + 1)
            if c < 0.0 { c = 0.0 - c }
            total = total + c
            n = n + 1
            x = x + 1
        }
        y = y + 1
    }
    return total / (n as float)
}

// The four readings on one backend; `frame` draws and hands back pixels.
readings(backend: *Backend, frame: fn(ptr, *Camera, *Light) -> ptr, context: ptr) -> Readings {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 0.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0 - 1.0))
    light = core.light_sun(core.vec3(0.0, 0.0, 1.0))
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)
    out = Readings { sparkles: 0, plain_sparkles: 0, unmapped: 0.0, triplanar: 0.0, flat_peak: 0.0, bumpy_peak: 0.0,
                     repeated: 0.0, broken: 0.0, flat: 0.0, varied: 0.0, coarse: 0.0, grained: 0.0, faded: 0.0 }
    m = wall(NOISE, 80.0)
    core.backend_add_model(backend, m)
    out.repeated = periodicity(frame(context, cam, light))
    core.model_set_tile_breakup(m, true, 0.0)
    out.broken = periodicity(frame(context, cam, light))
    core.backend_remove_model(backend, m)
    core.model_free(m)
    // Ten metres a tile: the texture magnified four times over, as ground
    // is at the eye's feet.
    big = wall(NOISE, 8.0)
    core.backend_add_model(backend, big)
    out.coarse = grain(frame(context, cam, light))
    core.model_set_detail(big, 8.0, 1.0, 30.0)
    out.grained = grain(frame(context, cam, light))
    core.model_set_detail(big, 8.0, 1.0, 5.0)
    out.faded = grain(frame(context, cam, light))
    core.backend_remove_model(backend, big)
    core.model_free(big)
    w = wall(WHITE, 80.0)
    core.backend_add_model(backend, w)
    out.flat = spread(frame(context, cam, light))
    core.model_set_variation(w, 0.3, 4.0)
    out.varied = spread(frame(context, cam, light))
    core.backend_remove_model(backend, w)
    core.model_free(w)
    // No UVs to speak of: every vertex at (0, 0).
    bare = wall(NOISE, 0.0)
    core.backend_add_model(backend, bare)
    out.unmapped = grain(frame(context, cam, light))
    core.model_set_triplanar(bare, 1.0)
    out.triplanar = grain(frame(context, cam, light))
    core.backend_remove_model(backend, bare)
    core.model_free(bare)
    // A glossy metal wall, the sun behind the eye, its highlight in the
    // middle; a tile of bumps every ten centimetres, minified past them.
    shiny = wall(WHITE, 800.0)
    core.model_set_pbr(shiny, 1.0, 0.15)
    core.backend_add_model(backend, shiny)
    out.flat_peak = peak(frame(context, cam, light))
    core.material_set_normal_path(shiny.material, BUMPS)
    out.bumpy_peak = peak(frame(context, cam, light))
    core.backend_remove_model(backend, shiny)
    core.model_free(shiny)
    // Glitter: a matte white wall, four grains a metre, a third of them
    // facets; the sun behind the eye.
    grainy = wall(WHITE, 80.0)
    core.model_set_pbr(grainy, 0.0, 0.95)
    core.model_set_specular(grainy, 0.03, 0.03, 0.03)
    core.backend_add_model(backend, grainy)
    base = kept(frame(context, cam, light))
    out.plain_sparkles = brighter(base, frame(context, cam, light))
    core.model_set_glitter(grainy, 0.35, 4.0, 60.0)
    out.sparkles = brighter(base, frame(context, cam, light))
    free(base)
    core.backend_remove_model(backend, grainy)
    core.model_free(grainy)
    // Embers: a charred wall, black but for its char's glow, none, half
    // and all of its blocks alight.
    char = near_wall()
    core.model_set_diffuse(char, 0.04, 0.03, 0.03)
    core.model_set_pbr(char, 0.0, 0.95)
    core.backend_add_model(backend, char)
    core.model_set_embers(char, 1200.0, 0.0, 3.0)
    out.embers_none = glowing(frame(context, cam, light)).share
    core.model_set_embers(char, 1200.0, 0.5, 3.0)
    out.embers_half = glowing(frame(context, cam, light)).share
    core.model_set_embers(char, 1200.0, 1.0, 3.0)
    full = glowing(frame(context, cam, light))
    out.embers_full = full.share
    out.ember_red = full.red
    core.backend_remove_model(backend, char)
    core.model_free(char)
    core.light_free(light)
    core.camera_free(cam)
    return out
}

kept(pixels: ptr) -> ptr {
    copy = calloc(WIDTH * HEIGHT * 4, 1)
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        mem.set_byte(copy, i, mem.get_byte(pixels, i))
        i = i + 1
    }
    return copy
}

// How many pixels are far brighter in `now` than in `before`.
brighter(before: ptr, now: ptr) -> int {
    n = 0
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            if luma(now, x, y) > luma(before, x, y) + 30.0 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// The brightest luminance in the middle eighth of the frame.
peak(pixels: ptr) -> float {
    most = 0.0
    y = HEIGHT * 7 / 16
    while y < HEIGHT * 9 / 16 {
        x = WIDTH * 7 / 16
        while x < WIDTH * 9 / 16 {
            v = luma(pixels, x, y)
            if v > most { most = v }
            x = x + 1
        }
        y = y + 1
    }
    return most
}

var g_gl_backend: *Backend = null
var g_vk_backend: *Backend = null

gl_frame(context: ptr, cam: *Camera, light: *Light) -> ptr {
    i = 0
    while i < 3 {
        core.backend_render(g_gl_backend, cam, light)
        i = i + 1
    }
    return offscreen.target_pixels(context)
}

vk_frame(context: ptr, cam: *Camera, light: *Light) -> ptr {
    i = 0
    while i < 3 {
        core.backend_render(g_vk_backend, cam, light)
        i = i + 1
    }
    return core.backend_frame_pixels(g_vk_backend)
}

report(name: string, r: Readings) {
    println("  ${name}: repeated ${r.repeated}, broken up ${r.broken}; spread ${r.flat} plain, ${r.varied} varied")
    check("${name}: as it repeats the frame matches itself a tile over (${r.repeated})", r.repeated > 0.9)
    check("${name}: broken up into hexagons it does not (${r.broken})", r.broken < r.repeated - 0.3)
    check("${name}: a white wall is one shade (${r.flat})", r.flat < 0.02)
    check("${name}: and varied over the world it is lighter and darker by stretches (${r.varied})", r.varied > 0.05)
    println("  ${name}: glitter flashes in ${r.sparkles} pixels of ${WIDTH * HEIGHT}, ${r.plain_sparkles} without it")
    check("${name}: a wall of glittering grains flashes, in a sparse share of its pixels (#741)",
          r.sparkles > 30 && r.sparkles * 20 < WIDTH * HEIGHT && r.plain_sparkles == 0)
    println("  ${name}: char glows red-hot over ${r.embers_none} of the frame with none alight, ${r.embers_half} with half, ${r.embers_full} with all; red over blue ${r.ember_red}")
    // Its blocks breathe, and the renderers differ by a few hundredths: all
    // alight glowed over 0.54 to 0.57 of the frame (M1 Pro, llvmpipe).
    check("${name}: a charred wall glows over more of itself the more of its char is alight -- barely any with none, over two fifths with all (#738; ${r.embers_none}, ${r.embers_half}, ${r.embers_full})",
          r.embers_none < 0.03 && r.embers_half > 0.1 && r.embers_half < 0.75 && r.embers_full > 0.4 && r.embers_full > r.embers_half * 1.5)
    check("${name}: and what glows is an ember's red, not white", r.ember_red > 2.0)
    println("  ${name}: a wall with no UVs, grain ${r.unmapped}; mapped on three planes ${r.triplanar}")
    check("${name}: with no UVs a wall is one colour, and mapped from the world it has its texture (${r.triplanar} against ${r.unmapped})",
          r.unmapped < 3.0 && r.triplanar > 10.0)
    println("  ${name}: a glossy wall's highlight ${r.flat_peak} flat, ${r.bumpy_peak} with its bumps averaged away")
    check("${name}: bumps its mips averaged away soften the highlight (Toksvig), not vanish (${r.bumpy_peak} against ${r.flat_peak})",
          r.bumpy_peak < r.flat_peak * 0.85)
    println("  ${name}: grain ${r.coarse} plain, ${r.grained} with a detail layer, ${r.faded} with it faded by 5 m")
    check("${name}: a detail layer adds grain (${r.grained} against ${r.coarse})", r.grained > r.coarse * 1.3)
    check("${name}: and past its fade it adds none (${r.faded})", near(r.faded, r.coarse, r.coarse * 0.02))
}

near(a: float, b: float, by: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= by
}

main() {
    println("tile breakup: a texture's repeat broken up, a field varied (#737)")
    check("the textures register", textures())
    gl_read = Readings { sparkles: 0, plain_sparkles: 0, unmapped: 0.0, triplanar: 0.0, flat_peak: 0.0, bumpy_peak: 0.0,
                         repeated: 0.0 - 1.0, broken: 0.0, flat: 0.0, varied: 0.0, coarse: 0.0, grained: 0.0, faded: 0.0 }
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  opengl: SKIP no OpenGL context available")
    } else {
        renderer = gl.renderer_new()
        backend = gl.backend(renderer)
        if core.backend_init(&backend, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            g_gl_backend = &backend
            gl_read = readings(&backend, gl_frame, target)
            report("opengl", gl_read)
            offscreen.target_destroy(target)
        } else {
            println("  opengl: SKIP the backend would not initialise")
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }
    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
    } else {
        vrenderer = vulkan.renderer_new()
        vbackend = vulkan.backend(vrenderer)
        if core.backend_init(&vbackend, null, WIDTH, HEIGHT) {
            g_vk_backend = &vbackend
            vk_read = readings(&vbackend, vk_frame, null)
            report("vulkan", vk_read)
            if gl_read.repeated >= 0.0 {
                check("both backends read alike", near(gl_read.broken, vk_read.broken, 0.05) && near(gl_read.varied, vk_read.varied, 0.01) &&
                  near(gl_read.grained, vk_read.grained, gl_read.grained * 0.05) &&
                  near(gl_read.triplanar, vk_read.triplanar, gl_read.triplanar * 0.05) &&
                  near(gl_read.bumpy_peak, vk_read.bumpy_peak, 6.0) &&
                  near(gl_read.sparkles as float, vk_read.sparkles as float, (gl_read.sparkles as float) * 0.15 + 3.0))
            }
        } else {
            println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        }
        vulkan.renderer_free(vrenderer)
    }
    if g_failures == 0 {
        println("tile breakup: all checks passed")
    } else {
        println("tile breakup: ${g_failures} failure(s)")
    }
}
