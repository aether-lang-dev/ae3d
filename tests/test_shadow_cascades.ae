// The key light's shadow, stable in the world whatever the camera does
// (#469). Offscreen, on both renderers.
//
// A six-metre post under a slanting sun, and a shadow distance of 80 m as
// the street scenes set one. The map used to be fitted around the camera
// and snapped on the world's axes, which for a sun not straight overhead
// slid it by fractions of a texel as the camera moved: every shadow edge
// crawled. The shadow is in cascades now, each a sphere around its slice of
// the view on its own texel grid:
//
//   - the post's shadow crosses a line on the ground in two edges, found in
//     world metres from the frame; the camera is moved in thirteen-cm steps
//     and turned a little, twelve times, and neither edge moves by more
//     than three texels of its cascade -- the pixel it is read from is most
//     of that. On the renderer before this the same edges wandered by 13 cm,
//     thirteen texels;
//   - a second post 59 m away still casts a shadow;
//   - OpenGL and Vulkan put the edges in the same place, to a texel;
//   - what the shadow pass costs on each renderer.
import std.mem
import ae3d.core
import ae3d.loader
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.cascades

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// Offscreen, so the frame is this size whatever size a window would be:
// fine enough that a pixel is under a centimetre where the edges are read.
const WIDTH = 1280
const HEIGHT = 720
const LINE_Z = 0.0 - 1.2
const POSES = 12

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

grey_at(pixels: ptr, x: int, y: int) -> float {
    if x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT { return 0.0 - 1.0 }
    at = (y * WIDTH + x) * 4
    return ((mem.get_uint8(pixels, at) + mem.get_uint8(pixels, at + 1) + mem.get_uint8(pixels, at + 2)) as float) / 3.0
}

// The grey of the ground at world point `p` in `cam`'s frame, read
// bilinearly at the sub-pixel place it projects to.
ground_grey(pixels: ptr, cam: *Camera, p: Vec3) -> float {
    s = core.camera_world_to_screen(cam, p, WIDTH, HEIGHT)
    if s.w < 0.0001 { return 0.0 - 1.0 }
    fx = s.x - 0.5
    fy = s.y - 0.5
    x0 = fx as int
    y0 = fy as int
    tx = fx - (x0 as float)
    ty = fy - (y0 as float)
    a = grey_at(pixels, x0, y0)
    b = grey_at(pixels, x0 + 1, y0)
    c = grey_at(pixels, x0, y0 + 1)
    d = grey_at(pixels, x0 + 1, y0 + 1)
    return (a * (1.0 - tx) + b * tx) * (1.0 - ty) + (c * (1.0 - tx) + d * tx) * ty
}

mean_grey(pixels: ptr, cam: *Camera, from: float, to: float) -> float {
    total = 0.0
    n = 0
    x = from
    while x <= to {
        total = total + ground_grey(pixels, cam, core.vec3(x, 0.0, LINE_Z))
        n = n + 1
        x = x + 0.01
    }
    return total / (n as float)
}

// Where along the line z = LINE_Z the ground turns from lit to shadowed and
// back: where the ratio of its grey between the lit ground's and the
// shadow's (each averaged along its own stretch of the line) crosses a
// half, stepping a millimetre and interpolating between steps, and each
// grey read bilinearly at the sub-pixel place the point projects to. Read
// to a pixel's nearest centre, the edge wandered by the pixel's own width
// and by how the lit ground's specular changed with the view. Into `out`
// [entering, leaving].
edges(pixels: ptr, cam: *Camera, out: ptr) {
    lit = mean_grey(pixels, cam, 0.05, 0.3)
    dark = mean_grey(pixels, cam, 0.0 - 2.3, 0.0 - 1.7)
    result = out as float[]
    result[0] = 0.0
    result[1] = 0.0
    step = 0.001
    prev = 1.0
    x = 0.3
    while x > 0.0 - 1.5 {
        r = (ground_grey(pixels, cam, core.vec3(x, 0.0, LINE_Z)) - dark) / (lit - dark)
        if r < 0.5 {
            result[0] = x + step * (0.5 - r) / (prev - r)
            break
        }
        prev = r
        x = x - step
    }
    prev = 1.0
    x = 0.0 - 4.5
    while x < 0.0 - 2.5 {
        r = (ground_grey(pixels, cam, core.vec3(x, 0.0, LINE_Z)) - dark) / (lit - dark)
        if r < 0.5 {
            result[1] = x - step * (0.5 - r) / (prev - r)
            break
        }
        prev = r
        x = x + step
    }
}

build_scene(pass: *Backend) -> ptr {
    kept = calloc(3, 8)
    models = kept as ptr[]
    ground = loader.cube(1.0)
    core.model_set_position(ground, 0.0, 0.0 - 0.1, 0.0)
    core.model_set_scale(ground, 400.0, 0.2, 400.0)
    core.model_matte(ground, 0.7, 0.7, 0.7)
    core.backend_add_model(pass, ground)
    models[0] = ground as ptr
    post = loader.cube(1.0)
    core.model_set_position(post, 0.0, 3.0, 0.0)
    core.model_set_scale(post, 1.0, 6.0, 1.0)
    core.model_matte(post, 0.6, 0.3, 0.2)
    core.backend_add_model(pass, post)
    models[1] = post as ptr
    far = loader.cube(1.0)
    core.model_set_position(far, 0.0 - 2.0, 3.0, 50.0)
    core.model_set_scale(far, 1.0, 6.0, 1.0)
    core.model_matte(far, 0.6, 0.3, 0.2)
    core.backend_add_model(pass, far)
    models[2] = far as ptr
    return kept
}

free_scene(kept: ptr) {
    models = kept as ptr[]
    i = 0
    while i < 3 {
        core.model_free(models[i] as *Model)
        i = i + 1
    }
    free(kept)
}

// Pose `k` of the twelve: moved sideways and forward in thirteen- and
// eleven-centimetre steps, and turned by aiming a little off the line.
pose(cam: *Camera, k: int) {
    x = 0.0 - 2.0 + (k as float) * 0.13
    z = 0.0 - 9.0 + ((k % 4) as float) * 0.11
    core.camera_set_position(cam, core.vec3(x, 2.5, z))
    turn = ((k % 3) as float - 1.0) * 0.3
    core.camera_look_at(cam, core.vec3(0.0 - 2.0 + turn, 0.0, LINE_Z))
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("shadow cascades: SKIP no OpenGL context")
        return
    }
    gl_renderer = gl.renderer_new()
    opengl_pass = gl.backend(gl_renderer)
    if !core.backend_init(&opengl_pass, context, WIDTH, HEIGHT) {
        println("shadow cascades: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(gl_renderer, target)
    gl_kept = build_scene(&opengl_pass)
    core.backend_set_shadows(&opengl_pass, true)
    core.backend_set_shadow_distance(&opengl_pass, 80.0)

    vk_renderer = vulkan.renderer_new()
    vulkan_pass = vulkan.backend(vk_renderer)
    have_vulkan = core.backend_init(&vulkan_pass, null, WIDTH, HEIGHT)
    vk_kept = null as ptr
    if have_vulkan {
        vk_kept = build_scene(&vulkan_pass)
        core.backend_set_shadows(&vulkan_pass, true)
        core.backend_set_shadow_distance(&vulkan_pass, 80.0)
    } else {
        println("  no Vulkan here (${vulkan.last_error()}): OpenGL only")
    }

    sun = core.light_directional(core.vec3(0.5, 0.8, 0.3), core.vec3(1.0, 0.95, 0.85), 1.4)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_near(cam, 0.1)
    core.camera_set_far(cam, 400.0)

    // The edges from every pose, on each renderer.
    found_block = calloc(2, 8)
    found = found_block as float[]
    lo_in = 1000.0
    hi_in = 0.0 - 1000.0
    lo_out = 1000.0
    hi_out = 0.0 - 1000.0
    worst_backends = 0.0
    k = 0
    while k < POSES {
        pose(cam, k)
        core.backend_render(&opengl_pass, cam, sun)
        edges(offscreen.target_pixels(target), cam, found_block)
        entering = found[0]
        leaving = found[1]
        if entering < lo_in { lo_in = entering }
        if entering > hi_in { hi_in = entering }
        if leaving < lo_out { lo_out = leaving }
        if leaving > hi_out { hi_out = leaving }
        if have_vulkan {
            core.backend_render(&vulkan_pass, cam, sun)
            edges(vulkan.offscreen_pixels(), cam, found_block)
            gap = found[0] - entering
            if gap < 0.0 { gap = 0.0 - gap }
            if gap > worst_backends { worst_backends = gap }
            gap = found[1] - leaving
            if gap < 0.0 { gap = 0.0 - gap }
            if gap > worst_backends { worst_backends = gap }
        }
        k = k + 1
    }
    // A texel of the cascade the line falls in: the largest of the cascades
    // that reach the line's distance from the camera, so the bound holds
    // whichever of two a blend band mixes.
    c = gl_renderer.cascades as *Cascades
    texel = 0.0
    i = 0
    while i < cascades.COUNT {
        start = 0.0
        if i > 0 { start = cascades.split(c, i - 1) }
        if start < 10.0 && cascades.texel_world(c, i) > texel { texel = cascades.texel_world(c, i) }
        i = i + 1
    }
    println("  the shadow enters at ${lo_in}..${hi_in} m and leaves at ${lo_out}..${hi_out} m over ${POSES} poses; a texel is ${texel} m")
    check("the shadow's edges stay put as the camera moves and turns",
          hi_in - lo_in <= texel * 3.0 && hi_out - lo_out <= texel * 3.0 && hi_in < 0.0 && lo_out < 0.0)
    if have_vulkan {
        println("  OpenGL against Vulkan: the edges at most ${worst_backends} m apart")
        check("OpenGL and Vulkan put the edges in the same place", worst_backends <= texel)
    }

    // The far post's shadow, 59 m out: its middle against the lit ground
    // beside it.
    core.camera_set_position(cam, core.vec3(0.0 - 2.0, 3.0, 0.0 - 9.0))
    core.camera_look_at(cam, core.vec3(0.0 - 2.0, 0.0, 50.0))
    core.backend_render(&opengl_pass, cam, sun)
    pixels = offscreen.target_pixels(target)
    shade = ground_grey(pixels, cam, core.vec3(0.0 - 2.0 - 1.9, 0.0, 50.0 - 1.1))
    open = ground_grey(pixels, cam, core.vec3(0.0 - 2.0 + 3.0, 0.0, 50.0 - 1.1))
    println("  the far post's shadow, 59 m out: ${shade} against the lit ground's ${open}")
    check("a shadow 59 m away is drawn", shade >= 0.0 && open > shade + 20.0)

    // What the pass costs.
    gl_ms = 0.0
    vk_ms = 0.0
    frames = 20
    f = 0
    while f < frames {
        core.backend_render(&opengl_pass, cam, sun)
        gl_ms = gl_ms + gl.renderer_shadow_ms(gl_renderer)
        if have_vulkan {
            core.backend_render(&vulkan_pass, cam, sun)
            vk_ms = vk_ms + vulkan.renderer_shadow_ms(vk_renderer)
        }
        f = f + 1
    }
    println("  the shadow pass, four cascades: ${gl_ms / (frames as float)} ms on OpenGL, ${vk_ms / (frames as float)} ms on Vulkan")

    free(found_block)
    core.backend_cleanup(&opengl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(gl_renderer)
    offscreen.context_destroy(context)
    if have_vulkan { core.backend_cleanup(&vulkan_pass) }
    vulkan.renderer_free(vk_renderer)
    free_scene(gl_kept)
    if vk_kept != null { free_scene(vk_kept) }
    core.light_free(sun)
    core.camera_free(cam)

    if g_failures == 0 {
        println("shadow cascades: all checks passed (${g_checks})")
        return
    }
    println("shadow cascades: ${g_failures} failure(s) of ${g_checks}")
}
