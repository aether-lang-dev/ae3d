// A scene lit by an environment map instead of the sky (#869), on both
// backends. No lamp, no sun: the map is all the light there is.
//
//   - A flat map (one colour in every direction, tests/fixtures/env/flat.hdr)
//     lights a white matte cube to its own colour, as a flat sky does in
//     tests/test_sky_light, and its scale (`intensity`) scales the result; a
//     black glossy cube shows four percent of it.
//   - A gradient map (bright blue above, dim brown below) gives the
//     irradiance onto an upward normal, a downward one and a horizontal one
//     the numbers an integral of the decoded picture over the hemisphere
//     gives, to a few percent: the picture is placed in the world the way a
//     painted sky is, up above, and the sky model is not what lit it.
//   - Giving the empty path goes back to the sky, and the frame is the sky's
//     again; a file that is not a picture is refused and leaves the map as
//     it was.
import std.mem
import std.string
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.envimage
import ae3d.hdrimage
extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float

const WIDTH = 160
const HEIGHT = 120
const PI = 3.14159265358979323846
const FLAT = "tests/fixtures/env/flat.hdr"
const GRADIENT = "tests/fixtures/env/gradient.hdr"
// Warm over the longitudes that look toward +x (an azimuth from -90 to +90
// degrees), cold over the others.
const SIDES = "tests/fixtures/env/sides.hdr"

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

near(got: int, want: int, slack: int) -> bool {
    d = got - want
    if d < 0 { d = 0 - d }
    return d <= slack
}

shown(x: float) -> int { return (core.displayed_of(x) * 255.0 + 0.5) as int }

// Channel `c` of the frame's centre pixel, 0..255.
centre(backend: *Backend, cam: *Camera, light: *Light, c: int) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    return mem.get_byte(pixels, ((HEIGHT / 2) * WIDTH + WIDTH / 2) * 4 + c)
}

cube(r: float, g: float, b: float, roughness: float) -> *Model {
    m = loader.cube(1.0)
    core.model_set_scale(m, 8.0, 8.0, 8.0)
    core.model_plastic(m, r, g, b, roughness)
    return m
}

// The irradiance a picture gives a surface facing `n`: the cosine-weighted
// sum of the light over the hemisphere, divided by pi (so a flat map of light
// L gives L back and the renderer's irradiance, which is not divided, is pi
// times this), channel `c`, the picture a
// latitude-longitude one with the zenith in its top row and the direction +x
// in its middle column.
integral(img: ptr, n: Vec3, c: int) -> float {
    w = hdrimage.width(img)
    h = hdrimage.height(img)
    p = hdrimage.pixels(img) as f32[]
    sum = 0.0
    j = 0
    while j < h {
        phi = (0.5 - ((j as float) + 0.5) / (h as float)) * PI
        i = 0
        while i < w {
            theta = (((i as float) + 0.5) / (w as float)) * 2.0 * PI - PI
            dx = cos(phi) * cos(theta)
            dy = sin(phi)
            dz = cos(phi) * sin(theta)
            d = dx * n.x + dy * n.y + dz * n.z
            if d > 0.0 {
                solid = cos(phi) * (2.0 * PI / (w as float)) * (PI / (h as float))
                sum = sum + (p[(j * w + i) * 4 + c] as float) * d * solid
            }
            i = i + 1
        }
        j = j + 1
    }
    return sum / PI
}

pct(got: float, want: float) -> float {
    d = got - want
    if d < 0.0 { d = 0.0 - d }
    if want == 0.0 { return d }
    return d / want
}

var g_gl: ptr = null
var g_vk: ptr = null

set_env(api: int, path: string, intensity: float) -> bool {
    if api == 0 { return gl.renderer_set_environment(g_gl as *GLRenderer, path, intensity) }
    return vulkan.renderer_set_environment(g_vk as *VKRenderer, path, intensity)
}

look(api: int, intensity: float, yaw: float) {
    if api == 0 { gl.renderer_set_environment_look(g_gl as *GLRenderer, intensity, yaw) } else { vulkan.renderer_set_environment_look(g_vk as *VKRenderer, intensity, yaw) }
}

ground(api: int, albedo: Vec3) {
    if api == 0 { gl.renderer_set_ground_bounce(g_gl as *GLRenderer, albedo) } else { vulkan.renderer_set_ground_bounce(g_vk as *VKRenderer, albedo) }
}

irradiance(api: int, n: Vec3) -> Vec3 {
    if api == 0 { return gl.renderer_sky_irradiance(g_gl as *GLRenderer, n) }
    return vulkan.renderer_sky_irradiance(g_vk as *VKRenderer, n)
}

run_checks(backend: *Backend, name: string, api: int) {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 20.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    dark = core.light_sun(core.vec3(0.0, 1.0, 0.0))
    dark.intensity = 0.0
    // The sky the frame has without a map: a flat grey.
    core.backend_set_clear_color(backend, 0.6, 0.6, 0.6)
    white = cube(1.0, 1.0, 1.0, 0.9)
    core.backend_add_model(backend, white)
    sky_green = centre(backend, cam, dark, 1)

    check("${name} the flat map loads", set_env(api, FLAT, 1.0))
    // Flat.hdr is (0.5, 0.25, 0.125): the cube shows each channel as that
    // light shows.
    red = centre(backend, cam, dark, 0)
    green = centre(backend, cam, dark, 1)
    blue = centre(backend, cam, dark, 2)
    println("  ${name}: a white matte cube under the flat map shows ${red} ${green} ${blue}; the light shows ${shown(0.5)} ${shown(0.25)} ${shown(0.125)}")
    check("${name} a white matte cube shows the flat map's colour", near(red, shown(0.5), 4) && near(green, shown(0.25), 4) && near(blue, shown(0.125), 4))
    check("${name} the map, not the sky, lit it (the sky's own green was ${sky_green}, the map's is ${green})", !near(red, sky_green, 20))

    check("${name} the flat map at twice the intensity loads", set_env(api, FLAT, 2.0))
    twice = centre(backend, cam, dark, 0)
    println("  ${name}: at twice the intensity the red shows ${twice}; light 1.0 shows ${shown(1.0)}")
    check("${name} intensity scales the light", near(twice, shown(1.0), 4))
    core.backend_remove_model(backend, white)
    core.model_free(white)

    check("${name} the flat map again", set_env(api, FLAT, 1.0))
    black = cube(0.0, 0.0, 0.0, 0.05)
    core.backend_add_model(backend, black)
    shine = centre(backend, cam, dark, 0)
    println("  ${name}: a black glossy cube shows ${shine}; four percent of 0.5 shows as ${shown(0.04 * 0.5)}")
    check("${name} a black glossy cube shows four percent of the map", near(shine, shown(0.04 * 0.5), 4))
    core.backend_remove_model(backend, black)
    core.model_free(black)

    // The gradient's irradiance.
    img = envimage.load(GRADIENT)
    check("${name} the gradient decodes for the integral", img != null)
    // A ground albedo laid under the horizon, as a scene with ground bounce
    // has, is the sky model's; a map has its own ground, so the irradiance
    // below is the picture's and not lit by what is above it.
    ground(api, core.vec3(0.8, 0.8, 0.8))
    check("${name} the gradient map loads", set_env(api, GRADIENT, 1.0))
    // One frame draws the capture.
    probe = cube(1.0, 1.0, 1.0, 0.9)
    core.backend_add_model(backend, probe)
    red = centre(backend, cam, dark, 0)
    up = core.vec3(0.0, 1.0, 0.0)
    down = core.vec3(0.0, 0.0 - 1.0, 0.0)
    side = core.vec3(0.0, 0.0, 1.0)
    east = core.vec3(1.0, 0.0, 0.0)
    if img != null {
        names = ["up", "down", "+z", "+x"]
        normals = [up, down, side, east]
        k = 0
        while k < 4 {
            e = irradiance(api, normals[k])
            wr = integral(img, normals[k], 0) * PI
            wg = integral(img, normals[k], 1) * PI
            wb = integral(img, normals[k], 2) * PI
            println("  ${name}: irradiance ${names[k]}: (${e.x}, ${e.y}, ${e.z}) against the picture's (${wr}, ${wg}, ${wb})")
            check("${name} the irradiance onto ${names[k]} is the picture's, to 10%",
                  pct(e.x, wr) < 0.10 && pct(e.y, wg) < 0.10 && pct(e.z, wb) < 0.10)
            k = k + 1
        }
        e_up = irradiance(api, up)
        e_down = irradiance(api, down)
        check("${name} the zenith above is lit more than the ground below", e_up.z > 2.0 * e_down.z)
        check("${name} the sky is blue and the ground brown", e_up.z > e_up.x && e_down.x > e_down.z)
        envimage.dispose(img)
    }
    core.backend_remove_model(backend, probe)
    core.model_free(probe)

    ground(api, core.vec3(0.0, 0.0, 0.0))

    // The yaw (Nic, 875-6): the map turned about up, the way the camera's yaw
    // turns, without reading the file again. The camera looks down -z at the
    // cube's +z face, whose light is the +z half of the map: with no yaw the
    // warm and the cold halves share it, a quarter turn one way gives it all
    // to the warm half and the other way to the cold, and whole turns are
    // no turn.
    check("${name} the two-sided map loads", set_env(api, SIDES, 1.0))
    sided = cube(1.0, 1.0, 1.0, 0.9)
    core.backend_add_model(backend, sided)
    look(api, 1.0, 0.0)
    r0 = centre(backend, cam, dark, 0)
    b0 = centre(backend, cam, dark, 2)
    look(api, 1.0, 90.0)
    r_plus = centre(backend, cam, dark, 0)
    b_plus = centre(backend, cam, dark, 2)
    look(api, 1.0, 0.0 - 90.0)
    r_minus = centre(backend, cam, dark, 0)
    b_minus = centre(backend, cam, dark, 2)
    look(api, 1.0, 180.0)
    r_half = centre(backend, cam, dark, 0)
    b_half = centre(backend, cam, dark, 2)
    look(api, 1.0, 360.0)
    r_whole = centre(backend, cam, dark, 0)
    b_whole = centre(backend, cam, dark, 2)
    look(api, 1.0, 450.0)
    r_more = centre(backend, cam, dark, 0)
    b_more = centre(backend, cam, dark, 2)
    look(api, 1.0, 0.0 - 270.0)
    r_back = centre(backend, cam, dark, 0)
    b_back = centre(backend, cam, dark, 2)
    println("  ${name}: the +z face under the two-sided map shows (red, blue) yaw 0: ${r0} ${b0}; +90: ${r_plus} ${b_plus}; -90: ${r_minus} ${b_minus}; 180: ${r_half} ${b_half}")
    check("${name} with no yaw the warm and the cold halves share the face (red ${r0}, blue ${b0})", near(r0, b0, 12) && r0 > 60)
    check("${name} a yaw of +90 turns the warm half to it (red ${r_plus}, blue ${b_plus})", r_plus > b_plus + 50)
    check("${name} a yaw of -90 turns the cold half to it (red ${r_minus}, blue ${b_minus})", b_minus > r_minus + 50)
    check("${name} a yaw of 180 is the other way round from none: the same share, the cold half behind", near(r_half, r0, 12) && near(b_half, b0, 12))
    check("${name} 360 is no turn (${r_whole} ${b_whole} against ${r0} ${b0})", near(r_whole, r0, 1) && near(b_whole, b0, 1))
    check("${name} 450 is +90 (${r_more} ${b_more} against ${r_plus} ${b_plus})", near(r_more, r_plus, 1) && near(b_more, b_plus, 1))
    check("${name} -270 is +90 (${r_back} ${b_back})", near(r_back, r_plus, 1) && near(b_back, b_plus, 1))
    // The scale and the yaw are set without a new read of the file, and the
    // scale scales whatever the turn is.
    look(api, 0.05, 0.0 - 90.0)
    b_quarter = centre(backend, cam, dark, 2)
    look(api, 0.05, 90.0)
    r_quarter = centre(backend, cam, dark, 0)
    check("${name} the intensity is a scale on the turned light too (${b_quarter} against ${b_minus} at a twentieth)", b_quarter < b_minus - 40 && r_quarter < r_plus - 40)
    look(api, 1.0, 0.0)
    core.backend_remove_model(backend, sided)
    core.model_free(sided)

    // A file that is not a picture is refused and the map stays.
    before = irradiance(api, up)
    check("${name} a file that is not a picture is refused", !set_env(api, "tests/fixtures/env/coded_piz.exr", 1.0))
    after = irradiance(api, up)
    check("${name} the refused file left the map as it was", pct(after.z, before.z) < 0.001)

    // Back to the sky.
    check("${name} the empty path goes back to the sky", set_env(api, "", 1.0))
    white = cube(1.0, 1.0, 1.0, 0.9)
    core.backend_add_model(backend, white)
    back = centre(backend, cam, dark, 1)
    println("  ${name}: back under the sky the cube shows ${back}, it showed ${sky_green} before")
    check("${name} the frame is the sky's again", near(back, sky_green, 1))
    core.backend_remove_model(backend, white)
    core.model_free(white)
    core.camera_free(cam)
    core.light_free(dark)
}

main() {
    println("environment: a map lights the scene")
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("environment: SKIP no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    g_gl = renderer as ptr
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("environment: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl", 0)
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vulkan.available() {
        println("environment: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vulkan.renderer_new()
        g_vk = vk_renderer as ptr
        vk_pass = vulkan.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("environment: SKIP Vulkan would not start (${vulkan.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan", 1)
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("environment: all checks passed")
    } else {
        println("environment: ${failures} failure(s)")
        exit(1)
    }
}
