// A crowd figure's feet and heading (#575), held to numbers on the Fox's
// walk baked as a pose bank, stepped at 60 Hz with no window.
//
// A crowd figure's feet are planted when its body moves, step by step, as
// far as its clip's root travelled over the same stretch of the walk: the
// bank is baked in place, so the clip's feet move back under the root at
// exactly the root's travel, and a body that covers that distance leaves
// them where they were set down. What a step slides by is the difference.
//
//   - walking free, the slide is nothing;
//   - held to 60% of its clip's speed by the speed limit, it still is: the
//     walk slows with the figure (it used to run on and slide by 40%);
//   - standing still, the walk stops (it used to walk on the spot);
//   - shoved sideways every frame by a neighbour, its heading turns by no
//     more than the turn rate a frame;
//   - walked into the street's edge, it turns back in over frames, never by
//     more than the rate in one, and ends walking away from the edge;
//   - a step of no time moves no one: a frame of zero seconds (an engine's
//     first) made every walking figure's position 0/0, and a city's horde
//     went from the frame for good (#659).

import ae3d.core
import ae3d.gltf
import ae3d.crowd
import ae3d.posing

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int
extern exit(code: int)

const FOX = "tests/fixtures/gltf/Fox.glb"
const STEP = 0.016666666666666666
const FRAMES = 48
const TURN_RATE = 3.5
const PI = 3.14159265358979

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
    fflush(null)
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// How far the bank's root travelled from phase `a` to phase `b` (ahead,
// wrapping once round the cycle), interpolated within its frames.
travel_at(bank: ptr, phase: float) -> float {
    at = phase * (FRAMES as float)
    f = at as int
    if f >= FRAMES { f = FRAMES - 1 }
    t = at - (f as float)
    a = posing.posebank_travel(bank, f)
    b = posing.posebank_travel(bank, f + 1)
    return a + (b - a) * t
}

travelled(bank: ptr, a: float, b: float) -> float {
    if b >= a { return travel_at(bank, b) - travel_at(bank, a) }
    whole = posing.posebank_travel(bank, FRAMES)
    return whole - travel_at(bank, a) + travel_at(bank, b)
}

// The columns for `n` figures.
struct Crowd {
    pos: ptr
    vel: ptr
    yaw: ptr
    phase: ptr
}

crowd_new(n: int) -> Crowd {
    return Crowd { pos: calloc(n * 3, 8), vel: calloc(n * 3, 8), yaw: calloc(n, 8), phase: calloc(n, 8) }
}

crowd_free(c: Crowd) {
    free(c.pos)
    free(c.vel)
    free(c.yaw)
    free(c.phase)
}

// A figure asked to walk along +x at `asked` metres a second, its speed held
// to `limit`, for two seconds: the worst slide in a step (metres a second)
// and the phase it walked through.
walk_slide(bank: ptr, walk: float, asked: float, limit: float) -> (float, float) {
    c = crowd_new(1)
    vel = c.vel as float[]
    pos = c.pos as float[]
    phase = c.phase as float[]
    worst = 0.0
    walked = 0.0
    k = 0
    while k < 120 {
        vel[0] = asked
        vel[2] = 0.0
        x0 = pos[0]
        z0 = pos[2]
        ph0 = phase[0]
        crowd.crowd_step(c.pos, c.vel, c.yaw, c.phase, 0, 1, STEP, limit, 0.0 - 1000.0, 1000.0, 0.0 - 1000.0, 1000.0, 0.0, walk, bank)
        moved = core.sqrt_of((pos[0] - x0) * (pos[0] - x0) + (pos[2] - z0) * (pos[2] - z0))
        // The pace the step took the walk at is the figure's own (0.85 to
        // 1.15 of the clip); the clip's travel scales with it as its speed did.
        clip = travelled(bank, ph0, phase[0])
        advanced = phase[0] - ph0
        if advanced < 0.0 { advanced = advanced + 1.0 }
        walked = walked + advanced
        slide = abs_of(moved - clip) / STEP
        if slide > worst { worst = slide }
        k = k + 1
    }
    crowd_free(c)
    return worst, walked
}

// The figure's own pace through its walk, as the horde spreads them.
figure_pace(i: int) -> float {
    t = (i as float) * 0.6180339887498949
    t = t - ((t as long) as float)
    return 0.85 + 0.30 * t
}

main() {
    println("crowd_feet: planted feet and a heading that turns (#575)")
    scene = gltf.load(FOX)
    if scene == null {
        println("crowd_feet: SKIP ${FOX} would not load")
        return
    }
    bank = gltf.bake_bank(scene, "Walk", FRAMES)
    walk = gltf.animation_duration(scene, "Walk")
    clip_speed = posing.posebank_travel(bank, FRAMES) / walk
    println("  the fox's walk: ${posing.posebank_travel(bank, FRAMES)} units a ${walk} s cycle, ${clip_speed} a second")

    free_slide, _free_walked = walk_slide(bank, walk, clip_speed, clip_speed * 10.0)
    held_slide, held_walked = walk_slide(bank, walk, clip_speed, clip_speed * 0.6)
    _still_slide, still_walked = walk_slide(bank, walk, 0.0, clip_speed * 10.0)
    println("  the worst slide in a step: walking free ${free_slide}, held to 60% ${held_slide} (it was 40% of ${clip_speed}), units a second; standing, the walk went ${still_walked} cycles")
    check("walking free, the body covers what the clip travels: no slide", free_slide < clip_speed * 0.02)
    check("held under its clip's speed, the walk slows with it: still no slide", held_slide < clip_speed * 0.02 && held_walked > 0.5)
    check("standing still, the walk stops", still_walked < 0.0001)

    // Shoved sideways every frame while walking along +x.
    c = crowd_new(1)
    vel = c.vel as float[]
    yaw = c.yaw as float[]
    pos = c.pos as float[]
    most_turn = 0.0
    k = 0
    while k < 120 {
        vel[0] = clip_speed
        side = clip_speed * 0.8
        if k % 2 == 0 { side = 0.0 - side }
        vel[2] = side
        before = yaw[0]
        crowd.crowd_step(c.pos, c.vel, c.yaw, c.phase, 0, 1, STEP, clip_speed * 10.0, 0.0 - 1000.0, 1000.0, 0.0 - 1000.0, 1000.0, 0.0, walk, bank)
        turned = abs_of(yaw[0] - before)
        if turned > most_turn { most_turn = turned }
        k = k + 1
    }
    println("  shoved left and right every frame: its heading turned ${most_turn * 57.29578} degrees in a frame at most (the cap ${TURN_RATE * STEP * 57.29578})")
    check("a neighbour's shove turns the heading by no more than the turn rate a frame", most_turn <= TURN_RATE * STEP + 0.000001)

    // Walked into the edge at x = 1000 (the fox is in centimetres).
    pos[0] = 990.0
    pos[2] = 0.0
    yaw[0] = 0.0
    most_turn = 0.0
    k = 0
    while k < 240 {
        crowd.crowd_wander(c.vel, c.yaw, 1, clip_speed)
        before = yaw[0]
        crowd.crowd_step(c.pos, c.vel, c.yaw, c.phase, 0, 1, STEP, clip_speed * 10.0, 0.0 - 1000.0, 1000.0, 0.0 - 1000.0, 1000.0, 0.0, walk, bank)
        d = yaw[0] - before
        while d > PI { d = d - 2.0 * PI }
        while d < 0.0 - PI { d = d + 2.0 * PI }
        turned = abs_of(d)
        if turned > most_turn { most_turn = turned }
        k = k + 1
    }
    heading = core.cos_of(yaw[0])
    println("  walked into the edge: turned ${most_turn * 57.29578} degrees in a frame at most; four seconds on it is at x ${pos[0]}, heading ${heading} along +x")
    check("an edge turns it back in over frames, never by more than the rate in one", most_turn <= TURN_RATE * STEP + 0.000001)
    check("and it walks away from the edge, back into the street", heading < 0.0 - 0.3 && pos[0] < 900.0)
    crowd_free(c)

    c = crowd_new(1)
    vel = c.vel as float[]
    pos = c.pos as float[]
    pos[0] = 4.0
    vel[0] = clip_speed
    crowd.crowd_step(c.pos, c.vel, c.yaw, c.phase, 0, 1, 0.0, clip_speed * 10.0, 0.0 - 1000.0, 1000.0, 0.0 - 1000.0, 1000.0, 0.0, walk, bank)
    println("  a step of no time: the figure at x ${pos[0]}, its walk at ${(c.phase as float[])[0]}")
    check("a step of no time moves no one", pos[0] == 4.0 && pos[2] == 0.0 && (c.phase as float[])[0] == 0.0)
    crowd_free(c)

    crowd.posebank_free(bank)
    gltf.scene_destroy(scene)
    if g_failures == 0 {
        println("crowd_feet: all checks passed (${g_checks})")
    } else {
        println("crowd_feet: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
