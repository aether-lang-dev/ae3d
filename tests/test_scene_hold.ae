// A frame drawn the same on every run and on either renderer, and the
// channel ops that read it by region: what tools/scene_parity.ae stands on
// (#494).
//
// AE3D_TICK=60 advances the world by exactly 1/60 s a frame, whatever the
// wall clock did, and the renderers' clock (platform.scene_time) by the
// same ticks; AE3D_HOLD=12 holds the engine at frame 12, as frame.pause
// would. frame.stats says the frame is held there and what the clear colour
// is; scene.isolate shows the models whose names hold one of a list of
// strings, or none of them, or all of them again.
//
// Driven from late_update over the engine's own channel, a request a frame,
// the way test_agent is: late_update runs on a held frame, update does not.

import std.os
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.agent
import ae3d.loader

const HOLD = 12
const TICK = 60

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_updates = 0
var g_off_tick = 0
// The engine borrows its models, so these are freed after it.
var g_wall_a: ptr = null
var g_wall_b: ptr = null
var g_zombie: ptr = null

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if !condition {
        g_failures = g_failures + 1
        println("FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock == null { return }
    tcp.tcp_send_raw(g_sock, string.concat(line, "\n"))
}

// One answer, or null when none has arrived yet; polled, never blocked (the
// engine answers at the end of this same frame on this same thread).
ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 65536)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

int_field(node: ptr, name: string) -> int {
    if node == null { return -1 }
    found = json.object_get_raw(node, name)
    if found == null { return -1 }
    return json.get_int(found)
}

// The clear colour the test set, as frame.stats reports it.
is_clear(clear: ptr) -> bool {
    if clear == null || json.array_size(clear) < 3 { return false }
    if json.get_number(json.array_get_raw(clear, 0)) != 0.25 { return false }
    if json.get_number(json.array_get_raw(clear, 1)) != 0.5 { return false }
    return json.get_number(json.array_get_raw(clear, 2)) == 0.75
}

shown(m: ptr) -> string {
    if (m as *Model).visible { return "shown" }
    return "hidden"
}

// Which of the three models are visible: "shown shown hidden" and so on.
visible_set() -> string {
    return "${shown(g_wall_a)} ${shown(g_wall_b)} ${shown(g_zombie)}"
}

main() {
    os.setenv("AE3D_AGENT", "auto")
    os.setenv("AE3D_TICK", "${TICK}")
    os.setenv("AE3D_HOLD", "${HOLD}")

    e = engine.engine_new()
    engine.engine_set_size(e, 160, 120)
    engine.engine_set_title(e, "ae3d scene hold test")
    engine.engine_set_camera_input(e, false)
    engine.engine_set_clear_color(e, 0.25, 0.5, 0.75)
    // A backstop: the exchange ends the run long before this.
    engine.engine_set_frame_limit(e, 600)
    program = engine.behaviour_new("scene hold test", null)
    program.start = on_start
    program.update = on_update
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)

    if !engine.engine_run(e) {
        println("SKIP no window")
        engine.engine_free(e)
        free_models()
        return
    }
    engine.engine_free(e)
    free_models()

    if g_stage < 7 {
        println("FAIL the exchange did not finish (stopped at stage ${g_stage})")
        g_failures = g_failures + 1
    }
    if g_failures == 0 {
        println("test_scene_hold: all checks passed (${g_checks})")
        return
    }
    println("test_scene_hold: ${g_failures} failure(s) of ${g_checks}")
}

free_models() {
    if g_wall_a != null { core.model_free(g_wall_a as *Model) }
    if g_wall_b != null { core.model_free(g_wall_b as *Model) }
    if g_zombie != null { core.model_free(g_zombie as *Model) }
    g_wall_a = null
    g_wall_b = null
    g_zombie = null
}

cube_named(e: *Engine, name: string, x: float) -> ptr {
    cube = loader.cube(1.0)
    core.model_set_name(cube, name)
    core.model_set_position(cube, x, 0.0, 0.0)
    engine.engine_add_model(e, cube)
    return cube as ptr
}

on_start(state: ptr, e: *Engine) {
    g_wall_a = cube_named(e, "wall a", 0.0 - 2.0)
    g_wall_b = cube_named(e, "wall b", 0.0)
    g_zombie = cube_named(e, "zombie", 2.0)
    core.camera_set_position(engine.engine_camera(e), core.vec3(0.0, 0.0, 12.0))
}

// Every frame the world advances by the tick, to the last bit.
on_update(state: ptr, e: *Engine, delta: float) {
    g_updates = g_updates + 1
    if delta != 1.0 / (TICK as float) { g_off_tick = g_off_tick + 1 }
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("client connects", sock != null)
        g_sock = sock
        g_stage = 1
        ask_send("{\"id\":1,\"op\":\"frame.stats\"}")
        return
    }
    if g_sock == null { return }

    if g_stage == 1 {
        doc = ask_receive()
        if doc == null { return }
        r = result_of(doc)
        paused = r != null && json.get_bool(json.object_get_raw(r, "paused")) == 1
        if !paused {
            // Not there yet: asked again next frame.
            json.free(doc)
            ask_send("{\"id\":1,\"op\":\"frame.stats\"}")
            return
        }
        check("the engine holds at the frame it was asked to", int_field(r, "frame") == HOLD)
        check("frame.stats says the clear colour", is_clear(json.object_get_raw(r, "clear")))
        json.free(doc)
        // Twelve ticks of 1/60 s, on the renderers' clock too.
        drift = platform.scene_time() - (HOLD as float) / (TICK as float)
        if drift < 0.0 { drift = 0.0 - drift }
        check("the renderers' clock is the ticks added up (${platform.scene_time()} s)", drift < 0.000000001)
        check("every frame advanced the world by one tick (${g_off_tick} of ${g_updates} did not)",
              g_updates == HOLD && g_off_tick == 0)
        ask_send("{\"id\":2,\"op\":\"scene.isolate\",\"matching\":[\"wall\"]}")
        g_stage = 2
        return
    }
    if g_stage == 2 {
        doc = ask_receive()
        if doc == null { return }
        check("isolate by what the names hold answers with the count", int_field(result_of(doc), "visible") == 2)
        check("and shows those models alone", visible_set() == "shown shown hidden")
        json.free(doc)
        ask_send("{\"id\":3,\"op\":\"scene.isolate\",\"matching\":[\"zom\",\"b\"]}")
        g_stage = 3
        return
    }
    if g_stage == 3 {
        doc = ask_receive()
        if doc == null { return }
        check("any of the strings will do", visible_set() == "hidden shown shown")
        json.free(doc)
        ask_send("{\"id\":4,\"op\":\"scene.isolate\",\"none\":true}")
        g_stage = 4
        return
    }
    if g_stage == 4 {
        doc = ask_receive()
        if doc == null { return }
        check("none hides every model", int_field(result_of(doc), "visible") == 0 && visible_set() == "hidden hidden hidden")
        json.free(doc)
        ask_send("{\"id\":5,\"op\":\"scene.isolate\"}")
        g_stage = 5
        return
    }
    if g_stage == 5 {
        doc = ask_receive()
        if doc == null { return }
        check("nothing shows them all again", visible_set() == "shown shown shown")
        json.free(doc)
        ask_send("{\"id\":6,\"op\":\"frame.stats\"}")
        g_stage = 6
        return
    }
    if g_stage == 6 {
        doc = ask_receive()
        if doc == null { return }
        check("and the frame is still the one held", int_field(result_of(doc), "frame") == HOLD)
        json.free(doc)
        tcp.tcp_close(g_sock)
        g_sock = null
        g_stage = 7
        engine.engine_stop(e)
        return
    }
}
