// The overlay laid out (#459), on both renderers, at two window sizes and
// two UI scales, held to numbers:
//
//   - anchors: a box at each of the nine anchors, sized and offset in
//     points, lands on the pixels the window's size and the scale say --
//     white to its every pixel, and nothing white one pixel past its edge;
//   - clips: a red rectangle and a word drawn through a panel's clip ink
//     nothing outside it, fill it to its edge, and a clip pushed inside
//     another draws only where the two meet;
//   - text: a sentence wrapped to a width inks nothing past the width, on
//     more than one line, within the height it says it took; right-aligned
//     text ends at the width's end and centred text sits in its middle;
//   - images: a picture of four coloured quarters drawn at four times its
//     size shows each quarter where it belongs, a tint at half alpha shows
//     it half over the frame, and loading it again is the same image;
//   - the engine over a renderer tells the overlay its screen and scale.
//
// Then Vulkan's frames are held to OpenGL's.

import std.mem
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.hud
import ae3d.picture

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern fflush(stream: ptr) -> int

const SIZES = 2
const FRAMES = 4
// The frame's own colour, dark, so white and red stand out of it.
const GROUND = 0.08

var g_checks = 0
var g_failures = 0
var g_width = 0
var g_height = 0
// OpenGL's frames, SIZES x FRAMES, for Vulkan's to be held to.
var g_opengl: ptr = null

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
    fflush(null)
}

channel(pixels: ptr, x: int, y: int, c: int) -> int {
    if x < 0 || y < 0 || x >= g_width || y >= g_height { return 0 }
    return mem.get_uint8(pixels, (y * g_width + x) * 4 + c)
}

luma(pixels: ptr, x: int, y: int) -> int {
    return (299 * channel(pixels, x, y, 0) + 587 * channel(pixels, x, y, 1) + 114 * channel(pixels, x, y, 2)) / 1000
}

white(pixels: ptr, x: int, y: int) -> bool {
    return channel(pixels, x, y, 0) > 250 && channel(pixels, x, y, 1) > 250 && channel(pixels, x, y, 2) > 250
}

// Whether a pixel is not the frame's own colour.
inked(pixels: ptr, x: int, y: int, ground: int) -> bool {
    d = luma(pixels, x, y) - ground
    return d > 24 || d < 0 - 24
}

abs_int(v: int) -> int {
    if v < 0 { return 0 - v }
    return v
}

frame_of(backend: *Backend) -> ptr {
    core.backend_frame_pixels(backend)
    return core.backend_frame_pixels(backend)
}

copy_frame(pixels: ptr) -> ptr {
    if pixels == null { return null }
    copy = calloc(g_width * g_height, 4)
    mem.copy(copy, pixels, (g_width * g_height * 4) as long)
    return copy
}

render(backend: *Backend, cam: *Camera, light: *Light) -> ptr {
    core.backend_render(backend, cam, light)
    return copy_frame(frame_of(backend))
}

// Where the box at `anchor` should stand, worked out from the anchor's
// own definition rather than hud.place's arithmetic: its column and row
// (0, 1, 2), the box 20 x 12 points, 6 points in from each edge it is
// anchored to.
expected(anchor: int, s: float) -> (int, int) {
    col = anchor % 3
    row = anchor / 3
    w = (20.0 * s) as int
    h = (12.0 * s) as int
    inset = (6.0 * s) as int
    x = inset
    if col == 1 { x = (g_width - w) / 2 }
    if col == 2 { x = g_width - inset - w }
    y = inset
    if row == 1 { y = (g_height - h) / 2 }
    if row == 2 { y = g_height - inset - h }
    return x, y
}

// The nine boxes.
anchors_frame(o: *Hud) {
    a = 0
    while a < 9 {
        col = a % 3
        row = a / 3
        dx = 6.0 - (col as float) * 6.0
        dy = 6.0 - (row as float) * 6.0
        x, y = hud.place(o, a, dx, dy, 20.0, 12.0)
        hud.rect(o, x, y, hud.px(o, 20.0), hud.px(o, 12.0), hud.rgba(1.0, 1.0, 1.0, 1.0))
        a = a + 1
    }
}

anchors_checks(name: string, pixels: ptr, s: float) {
    w = (20.0 * s) as int
    h = (12.0 * s) as int
    wrong = ""
    a = 0
    while a < 9 {
        x, y = expected(a, s)
        filled = true
        row = y
        while row < y + h {
            col = x
            while col < x + w {
                if !white(pixels, col, row) { filled = false }
                col = col + 1
            }
            row = row + 1
        }
        // The ring one pixel outside the box.
        spilled = false
        col = x - 1
        while col <= x + w {
            if white(pixels, col, y - 1) || white(pixels, col, y + h) { spilled = true }
            col = col + 1
        }
        row = y
        while row < y + h {
            if white(pixels, x - 1, row) || white(pixels, x + w, row) { spilled = true }
            row = row + 1
        }
        if !filled || spilled { wrong = "${wrong} anchor ${a} at (${x}, ${y})" }
        a = a + 1
    }
    check("${name}: each of the nine anchored boxes is on its pixels, white to its edge and not past it${wrong}", wrong == "")
}

// A red rectangle and a word through a panel's clip, and a rectangle
// through a clip inside a clip.
const CLIP_X = 40
const CLIP_Y = 40
const CLIP_W = 80
const CLIP_H = 40
const INNER_X = 100
const INNER_Y = 20
const NEST_X = 160
const NEST_Y = 90

clip_frame(o: *Hud) {
    hud.push_clip(o, CLIP_X as float, CLIP_Y as float, CLIP_W as float, CLIP_H as float)
    hud.rect(o, (CLIP_X - 20) as float, (CLIP_Y - 10) as float, (CLIP_W + 60) as float, (CLIP_H + 40) as float,
             hud.rgba(1.0, 0.0, 0.0, 1.0))
    hud.text(o, (CLIP_X - 10) as float, (CLIP_Y + 4) as float, 40.0, "CLIPPED WORD", hud.rgba(1.0, 1.0, 1.0, 1.0))
    hud.pop_clip(o)
    // Nested: a 40 x 40 clip, a 20 x 60 one inside it overlapping its right
    // half, a 100 x 100 rectangle through both -- 20 x 40 is drawn.
    hud.push_clip(o, NEST_X as float, NEST_Y as float, 40.0, 40.0)
    hud.push_clip(o, (NEST_X + 20) as float, (NEST_Y - 10) as float, 40.0, 60.0)
    hud.rect(o, (NEST_X - 30) as float, (NEST_Y - 30) as float, 100.0, 100.0, hud.rgba(0.0, 1.0, 0.0, 1.0))
    hud.pop_clip(o)
    hud.pop_clip(o)
}

clip_checks(name: string, pixels: ptr, ground: int) {
    outside = 0
    inside_red = 0
    nested = 0
    y = 0
    while y < g_height {
        x = 0
        while x < g_width {
            in_clip = x >= CLIP_X && x < CLIP_X + CLIP_W && y >= CLIP_Y && y < CLIP_Y + CLIP_H
            in_nest = x >= NEST_X - 30 && x < NEST_X + 70 && y >= NEST_Y - 30 && y < NEST_Y + 70
            if in_nest {
                if channel(pixels, x, y, 1) > 200 && channel(pixels, x, y, 0) < 60 { nested = nested + 1 }
            } else if in_clip {
                if channel(pixels, x, y, 0) > 200 { inside_red = inside_red + 1 }
            } else if inked(pixels, x, y, ground) {
                outside = outside + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    println("  ${name}: through a ${CLIP_W} x ${CLIP_H} clip, ${inside_red} pixels red inside and ${outside} inked outside; ${nested} drawn through the nested clips (800 wanted)")
    check("${name}: nothing drawn through a clip reaches outside it", outside == 0)
    check("${name}: and it fills the clip to its edge", inside_red == CLIP_W * CLIP_H)
    check("${name}: a clip inside a clip draws only where the two meet", nested == 800)
}

// A sentence wrapped to a width, a word right-aligned, a word centred.
const BOX_X = 16
const BOX_Y = 12
const BOX_W = 130
const RIGHT_Y = 116
const MIDDLE_Y = 146
const SENTENCE = "The horde turned at the bridge and the lamps went out one by one."

var g_box_height = 0.0

text_frame(o: *Hud) {
    white_ink = hud.rgba(1.0, 1.0, 1.0, 1.0)
    g_box_height = hud.text_box(o, BOX_X as float, BOX_Y as float, BOX_W as float, 14.0, SENTENCE, white_ink, hud.ALIGN_LEFT)
    hud.text_box(o, BOX_X as float, RIGHT_Y as float, BOX_W as float, 18.0, "RIGHT", white_ink, hud.ALIGN_RIGHT)
    hud.text_box(o, BOX_X as float, MIDDLE_Y as float, BOX_W as float, 18.0, "MIDDLE", white_ink, hud.ALIGN_CENTRE)
}

// The inked box of the rows from y0 to y1: its left, right, top, bottom.
ink_box(pixels: ptr, y0: int, y1: int, ground: int) -> (int, int, int, int) {
    left = g_width
    right = 0 - 1
    top = g_height
    bottom = 0 - 1
    y = y0
    while y < y1 && y < g_height {
        x = 0
        while x < g_width {
            if inked(pixels, x, y, ground) {
                if x < left { left = x }
                if x > right { right = x }
                if y < top { top = y }
                if y > bottom { bottom = y }
            }
            x = x + 1
        }
        y = y + 1
    }
    return left, right, top, bottom
}

text_checks(name: string, pixels: ptr, ground: int) {
    left, right, top, bottom = ink_box(pixels, 0, RIGHT_Y - 4, ground)
    one_line = 14
    println("  ${name}: the sentence wrapped to ${BOX_W} px inks x ${left}..${right}, y ${top}..${bottom}; the box says ${g_box_height} px tall")
    check("${name}: wrapped text inks nothing past its width", left >= BOX_X && right < BOX_X + BOX_W)
    check("${name}: on more than one line, within the height it says it took",
          bottom - top > one_line * 2 && bottom <= BOX_Y + (g_box_height as int) + 2)
    rl, rr, rt, rb = ink_box(pixels, RIGHT_Y - 2, MIDDLE_Y - 4, ground)
    check("${name}: right-aligned text ends at the width's end (ink ${rl}..${rr}, the end ${BOX_X + BOX_W})",
          rr <= BOX_X + BOX_W && rr >= BOX_X + BOX_W - 4)
    ml, mr, mt, mb = ink_box(pixels, MIDDLE_Y - 2, MIDDLE_Y + 30, ground)
    middle = (ml + mr) / 2
    check("${name}: centred text sits in the width's middle (ink ${ml}..${mr}, middle ${middle}, the width's ${BOX_X + BOX_W / 2})",
          abs_int(middle - (BOX_X + BOX_W / 2)) <= 2)
}

// A 16 x 16 picture of four quarters, registered by name: red at the top
// left, green at the top right, blue at the bottom left, white at the
// bottom right. A picture's rows are stored bottom first.
const IMAGE_NAME = "hud_layout_quarters"
const IMAGE_X = 40
const IMAGE_Y = 40
const IMAGE_SIDE = 64
const FADED_X = 160

register_quarters() {
    rgba = calloc(16 * 16, 4)
    p = rgba as byte[]
    row = 0
    while row < 16 {
        col = 0
        while col < 16 {
            at = (row * 16 + col) * 4
            top = row >= 8
            r = 0
            g = 0
            b = 0
            if top && col < 8 { r = 255 }
            if top && col >= 8 { g = 255 }
            if !top && col < 8 { b = 255 }
            if !top && col >= 8 {
                r = 255
                g = 255
                b = 255
            }
            p[at] = r
            p[at + 1] = g
            p[at + 2] = b
            p[at + 3] = 255
            col = col + 1
        }
        row = row + 1
    }
    picture.register_rgba(IMAGE_NAME, rgba, 16, 16)
    free(rgba)
}

var g_image = 0 - 1
var g_image_again = 0 - 1

image_frame(o: *Hud) {
    g_image = hud.image_load(o, IMAGE_NAME)
    g_image_again = hud.image_load(o, IMAGE_NAME)
    hud.image(o, g_image, IMAGE_X as float, IMAGE_Y as float, IMAGE_SIDE as float, IMAGE_SIDE as float, hud.rgba(1.0, 1.0, 1.0, 1.0))
    hud.image(o, g_image, FADED_X as float, IMAGE_Y as float, IMAGE_SIDE as float, IMAGE_SIDE as float, hud.rgba(1.0, 1.0, 1.0, 0.5))
}

// The colour at the middle of a quarter, as r g b packed into one number
// for the message.
quarter(pixels: ptr, x0: int, qx: int, qy: int, c: int) -> int {
    q = IMAGE_SIDE / 4
    return channel(pixels, x0 + q + qx * IMAGE_SIDE / 2, IMAGE_Y + q + qy * IMAGE_SIDE / 2, c)
}

image_checks(name: string, pixels: ptr, ground: int) {
    tl_r = quarter(pixels, IMAGE_X, 0, 0, 0)
    tl_g = quarter(pixels, IMAGE_X, 0, 0, 1)
    tr_g = quarter(pixels, IMAGE_X, 1, 0, 1)
    tr_r = quarter(pixels, IMAGE_X, 1, 0, 0)
    bl_b = quarter(pixels, IMAGE_X, 0, 1, 2)
    bl_r = quarter(pixels, IMAGE_X, 0, 1, 0)
    br = luma(pixels, IMAGE_X + IMAGE_SIDE * 3 / 4, IMAGE_Y + IMAGE_SIDE * 3 / 4)
    println("  ${name}: the image's quarters: top left r ${tl_r} g ${tl_g}, top right g ${tr_g} r ${tr_r}, bottom left b ${bl_b} r ${bl_r}, bottom right luma ${br}")
    check("${name}: an image shows each quarter where it belongs, in its colour",
          tl_r > 250 && tl_g < 5 && tr_g > 250 && tr_r < 5 && bl_b > 250 && bl_r < 5 && br > 250)
    faded = quarter(pixels, FADED_X, 0, 0, 0)
    ground_red = channel(pixels, 2, g_height / 2, 0)
    half = (255 + ground_red) / 2
    println("  ${name}: tinted to half alpha, its red quarter's red ${faded} (half over the frame ${half})")
    check("${name}: a tint at half alpha shows the image half over the frame", abs_int(faded - half) <= 3)
    check("${name}: loading the image again is the same image", g_image >= 0 && g_image_again == g_image)
}

// One window size and scale through one backend: the four frames, checked;
// OpenGL's kept for Vulkan's.
run_size(backend: *Backend, name: string, size: int, s: float) {
    core.backend_set_clear_color(backend, GROUND, GROUND, GROUND)
    o = hud.hud_new()
    core.backend_set_overlay(backend, o as ptr)
    hud.set_screen(o, g_width, g_height, s)
    cam = core.camera_new(g_width, g_height)
    light = core.light_sun(core.vec3(0.2, 1.0, 0.4))
    label = "${name} ${g_width} x ${g_height} at ${s}"

    bare = render(backend, cam, light)
    if bare == null {
        println("hud_layout: SKIP ${label} gave no pixels")
    } else {
        ground = luma(bare, 0, 0)
        frames = calloc(FRAMES, 8)
        anchors_frame(o)
        (frames as ptr[])[0] = render(backend, cam, light)
        hud.clear(o)
        clip_frame(o)
        (frames as ptr[])[1] = render(backend, cam, light)
        hud.clear(o)
        text_frame(o)
        (frames as ptr[])[2] = render(backend, cam, light)
        hud.clear(o)
        image_frame(o)
        (frames as ptr[])[3] = render(backend, cam, light)
        hud.clear(o)
        anchors_checks(label, (frames as ptr[])[0], s)
        clip_checks(label, (frames as ptr[])[1], ground)
        text_checks(label, (frames as ptr[])[2], ground)
        image_checks(label, (frames as ptr[])[3], ground)
        kept = (g_opengl as ptr[])[size]
        if kept == null {
            (g_opengl as ptr[])[size] = frames
        } else {
            same(label, kept, frames)
            f = 0
            while f < FRAMES {
                free((frames as ptr[])[f])
                f = f + 1
            }
            free(frames)
        }
        free(bare)
    }
    core.backend_set_overlay(backend, null)
    hud.hud_free(o)
    core.camera_free(cam)
    core.light_free(light)
}

// Vulkan's frames against OpenGL's, frame by frame.
same(label: string, opengl: ptr, vulkan: ptr) {
    f = 0
    differing = 0
    while f < FRAMES {
        a = (opengl as ptr[])[f]
        b = (vulkan as ptr[])[f]
        i = 0
        while i < g_width * g_height * 4 {
            if i % 4 != 3 {
                d = abs_int(mem.get_uint8(a, i) - mem.get_uint8(b, i))
                if d > 16 { differing = differing + 1 }
            }
            i = i + 1
        }
        f = f + 1
    }
    println("  ${label}: vulkan against opengl, ${differing} channels of the four frames differ by more than 16 of 255")
    check("${label}: vulkan lays the overlay out as opengl does", differing < g_width * g_height * 3 * FRAMES / 200)
}

size_of(size: int) -> (int, int, float) {
    if size == 0 { return 320, 180, 1.0 }
    return 400, 240, 1.5
}

// The engine over a renderer tells its overlay the screen it is drawn
// over and the scale, before its behaviours lay anything out.
engine_checks(renderer: ptr) {
    cam = core.camera_new(g_width, g_height)
    light = core.light_sun(core.vec3(0.2, 1.0, 0.4))
    e = engine.engine_over(renderer, platform.API_GL, cam, light)
    engine.engine_set_size(e, 333, 222)
    engine.engine_set_ui_scale(e, 1.25)
    engine.engine_update(e, 1.0 / 60.0)
    o = engine.engine_hud(e)
    println("  engine over a renderer: its overlay's screen ${hud.screen_width(o)} x ${hud.screen_height(o)} at ${hud.scale(o)}")
    check("the engine tells its overlay its screen and scale",
          hud.screen_width(o) == 333.0 && hud.screen_height(o) == 222.0 && hud.scale(o) == 1.25)
    engine.engine_free(e)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    println("hud_layout: anchors, clips, wrapped text and images over the frame (#459)")
    register_quarters()
    g_opengl = calloc(SIZES, 8)

    size = 0
    while size < SIZES {
        w, h, s = size_of(size)
        g_width = w
        g_height = h
        context = offscreen.context_create(w, h)
        if context == null {
            println("hud_layout: SKIP no OpenGL context")
            return
        }
        renderer = gl.renderer_new()
        pass = gl.backend(renderer)
        if !core.backend_init(&pass, context, w, h) {
            println("hud_layout: SKIP the OpenGL backend would not initialise")
            return
        }
        target = offscreen.target_create(w, h)
        gl.renderer_set_target(renderer, target)
        run_size(&pass, "opengl", size, s)
        if size == 0 { engine_checks(renderer as ptr) }
        core.backend_cleanup(&pass)
        offscreen.target_destroy(target)
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
        size = size + 1
    }

    if !vulkan.available() {
        println("hud_layout: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        size = 0
        while size < SIZES {
            w, h, s = size_of(size)
            g_width = w
            g_height = h
            vk_renderer = vulkan.renderer_new()
            vk_pass = vulkan.backend(vk_renderer)
            if !core.backend_init(&vk_pass, null, w, h) {
                println("hud_layout: SKIP Vulkan would not start (${vulkan.last_error()})")
            } else {
                run_size(&vk_pass, "vulkan", size, s)
                core.backend_cleanup(&vk_pass)
            }
            vulkan.renderer_free(vk_renderer)
            size = size + 1
        }
    }

    size = 0
    while size < SIZES {
        frames = (g_opengl as ptr[])[size]
        if frames != null {
            f = 0
            while f < FRAMES {
                free((frames as ptr[])[f])
                f = f + 1
            }
            free(frames)
        }
        size = size + 1
    }
    free(g_opengl)
    picture.unregister(IMAGE_NAME)

    if g_failures == 0 {
        println("hud_layout: all checks passed (${g_checks})")
    } else {
        println("hud_layout: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}

extern exit(code: int)
