// frame.pixel says what is at the pixel, not only its colour (#865).
//
// The channel is driven over a real socket by the program it is attached to,
// as tests/test_agent.ae does. A cube stands in the middle of the frame and a
// sphere to its left; frame.pixel is asked of a pixel on each, of a corner
// of the frame and of a point off the frame, and the answers' pick must name
// the model drawn there, its place and its depth. The corner is the control:
// a pick that named a model for every pixel would pass the others.

import std.os
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.agent
import ae3d.loader
extern exit(code: int)

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_cube: ptr = null
var g_sphere: ptr = null
var g_cube_id = 0
var g_sphere_id = 0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if !condition {
        g_failures = g_failures + 1
        println("FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock == null { return }
    tcp.tcp_send_raw(g_sock, string.concat(line, "\n"))
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 65536)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

int_field(node: ptr, name: string) -> int {
    if node == null { return -1 }
    found = json.object_get_raw(node, name)
    if found == null { return -1 }
    return json.get_int(found)
}

num_field(node: ptr, name: string) -> float {
    if node == null { return -1000.0 }
    found = json.object_get_raw(node, name)
    if found == null { return -1000.0 }
    return json.get_number(found)
}

bool_field(node: ptr, name: string) -> bool {
    if node == null { return false }
    found = json.object_get_raw(node, name)
    if found == null { return false }
    return json.get_bool(found) == 1
}

pick_of(r: ptr) -> ptr {
    if r == null { return null }
    return json.object_get_raw(r, "pick")
}

model_of(pick: ptr) -> ptr {
    if pick == null { return null }
    return json.object_get_raw(pick, "model")
}

main() {
    os.setenv("AE3D_AGENT", "auto")
    // It asks about pixels at its own size; ci.sh's small AE3D_WIDTH and
    // AE3D_HEIGHT would move what is under them.
    os.setenv("AE3D_WIDTH", "")
    os.setenv("AE3D_HEIGHT", "")
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_title(e, "ae3d agent pick test")
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 240)
    program = engine.behaviour_new("agent pick test", null)
    program.start = on_start
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        println("SKIP no window")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    if g_cube != null { core.model_free(g_cube as *Model) }
    if g_sphere != null { core.model_free(g_sphere as *Model) }
    if g_stage < 9 {
        println("FAIL the exchange did not finish (stopped at stage ${g_stage})")
        g_failures = g_failures + 1
    }
    if g_failures == 0 {
        println("test_agent_pick: all checks passed (${g_checks})")
        return
    }
    println("test_agent_pick: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}

on_start(state: ptr, e: *Engine) {
    cube = loader.cube(1.0)
    core.model_set_name(cube, "probe cube")
    core.model_set_scale(cube, 4.0, 4.0, 4.0)
    core.model_matte(cube, 0.8, 0.3, 0.2)
    g_cube = cube as ptr
    g_cube_id = cube.id
    engine.engine_add_model(e, cube)

    sphere = loader.sphere(1.0, 24, 18)
    core.model_set_name(sphere, "probe sphere")
    core.model_set_position(sphere, 0.0 - 6.0, 0.0, 0.0)
    core.model_matte(sphere, 0.2, 0.3, 0.8)
    g_sphere = sphere as ptr
    g_sphere_id = sphere.id
    engine.engine_add_model(e, sphere)

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 30.0))
}

// The pixel the asked point shows at, from the camera the engine draws with.
pixel_of(e: *Engine, x: float, y: float, z: float) -> int {
    p = core.camera_world_to_screen(engine.engine_camera(e), core.vec3(x, y, z), 320, 240)
    return (p.y as int) * 1000 + (p.x as int)
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        g_sock = sock
        check("the client connects", sock != null)
        g_stage = 1
        return
    }
    if g_sock == null { return }

    // The cube's middle.
    if g_stage == 1 {
        at = pixel_of(e, 0.0, 0.0, 2.0)
        ask_send("{\"id\":1,\"op\":\"frame.pixel\",\"x\":${at % 1000},\"y\":${at / 1000}}")
        g_stage = 2
        return
    }
    if g_stage == 2 {
        doc = ask_receive()
        if doc == null { return }
        r = result_of(doc)
        pick = pick_of(r)
        model = model_of(pick)
        check("a pixel's colour is still there", r != null && int_field(r, "a") >= 0)
        check("the cube's middle hits", pick != null && bool_field(pick, "hit"))
        check("and names the cube (id ${int_field(model, "id")} of ${g_cube_id})", int_field(model, "id") == g_cube_id)
        check("by its name", model != null && json.get_string_raw(json.object_get_raw(model, "name")) == "probe cube")
        check("its depth is in the view", num_field(pick, "depth") > 0.0 && num_field(pick, "depth") < 1.0)
        pos = json.object_get_raw(pick, "position")
        px = 0.0 - 1000.0
        pz = 0.0 - 1000.0
        if pos != null && json.array_size(pos) == 3 {
            px = json.get_number(json.array_get_raw(pos, 0))
            pz = json.get_number(json.array_get_raw(pos, 2))
        }
        check("and its point is on the cube's near face (x ${px}, z ${pz})", pz > 1.0 && pz < 3.0 && px > 0.0 - 0.5 && px < 0.5)
        if doc != null { json.free(doc) }
        g_stage = 3
        return
    }

    // The sphere.
    if g_stage == 3 {
        at = pixel_of(e, 0.0 - 6.0, 0.0, 1.0)
        ask_send("{\"id\":2,\"op\":\"frame.pixel\",\"x\":${at % 1000},\"y\":${at / 1000}}")
        g_stage = 4
        return
    }
    if g_stage == 4 {
        doc = ask_receive()
        if doc == null { return }
        pick = pick_of(result_of(doc))
        check("the sphere's pixel names the sphere", int_field(model_of(pick), "id") == g_sphere_id)
        if doc != null { json.free(doc) }
        g_stage = 5
        return
    }

    // The control: the corner of the frame, where nothing is drawn.
    if g_stage == 5 {
        ask_send("{\"id\":3,\"op\":\"frame.pixel\",\"x\":3,\"y\":3}")
        g_stage = 6
        return
    }
    if g_stage == 6 {
        doc = ask_receive()
        if doc == null { return }
        pick = pick_of(result_of(doc))
        check("the corner of the frame has a pick", pick != null && bool_field(pick, "available"))
        check("and hits nothing", pick != null && !bool_field(pick, "hit") && model_of(pick) == null)
        if doc != null { json.free(doc) }
        g_stage = 7
        return
    }

    // Off the frame: the colour read fails as it did, and says so.
    if g_stage == 7 {
        ask_send("{\"id\":4,\"op\":\"frame.pixel\",\"x\":9999,\"y\":9999}")
        g_stage = 8
        return
    }
    if g_stage == 8 {
        doc = ask_receive()
        if doc == null { return }
        node = json.object_get_raw(doc, "ok")
        check("a point off the frame is refused, not answered with a model", node != null && json.get_bool(node) != 1)
        if doc != null { json.free(doc) }
        g_stage = 9
        engine.engine_stop(e)
        return
    }
}
