// The engine's orbit camera (#823): a target, a distance, a yaw and a pitch,
// turned by a drag, zoomed by the wheel, held by limits, put on a camera; and
// driven by the engine's loop from its input. Headless: the input is injected
// and no window is made.

import ae3d.core
import ae3d.platform
import ae3d.input
import ae3d.engine
import ae3d.orbitcam
extern exit(code: int)

var failures = 0

check(name: string, ok: bool) {
    if !ok {
        println("orbitcam: FAIL ${name}")
        failures = failures + 1
    }
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

near_v(a: Vec3, b: Vec3) -> bool {
    return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z)
}

// One frame of input the way the engine's loop reads it.
frame(i: *Input, o: *Orbit, cam: *Camera, x: float, y: float, down: bool, scroll: float, delta: float) {
    input.inject_cursor(i, x, y)
    input.inject_mouse(i, platform.MOUSE_LEFT, down)
    if scroll != 0.0 { input.inject_scroll(i, scroll) }
    input.poll_frame(i, delta)
    orbitcam.orbit_update(o, i, cam, delta)
}

pose_checks() {
    cam = core.camera_new(320, 180)
    target = core.vec3(1.0, 2.0, 3.0)
    o = orbitcam.orbit_new(target, 10.0, 0.0, 0.0)

    orbitcam.orbit_apply(o, cam)
    check("yaw 0, pitch 0 stands on +x", near_v(cam.position, core.vec3(11.0, 2.0, 3.0)))
    check("and looks at the target (front is -x)", near_v(cam.front, core.vec3(0.0 - 1.0, 0.0, 0.0)))

    orbitcam.orbit_set_pose(o, 10.0, 90.0, 0.0)
    orbitcam.orbit_apply(o, cam)
    check("yaw 90 stands on +z", near_v(cam.position, core.vec3(1.0, 2.0, 13.0)))

    orbitcam.orbit_set_pose(o, 10.0, 0.0, 30.0)
    orbitcam.orbit_apply(o, cam)
    check("pitch 30 is 5 above and 8.66 out", near_v(cam.position, core.vec3(1.0 + 8.660254, 7.0, 3.0)))

    orbitcam.orbit_set_pose(o, 7.5, 123.0, 41.0)
    orbitcam.orbit_apply(o, cam)
    check("the eye is `distance` from the target", near(core.v3_distance(cam.position, target), 7.5))
    toward = core.v3_normalize(core.v3_sub(target, cam.position))
    check("and looks along the line to it", near_v(cam.front, toward))

    // A drag: right 20 px turns yaw by 20 * 0.35, down 10 px lowers pitch.
    orbitcam.orbit_set_pose(o, 10.0, 0.0, 10.0)
    orbitcam.orbit_turn(o, 20.0, 10.0)
    check("a drag turns the yaw by speed per pixel", near(o.yaw, 7.0))
    check("and the pitch the other way", near(o.pitch, 6.5))

    // Pitch limits.
    orbitcam.orbit_turn(o, 0.0, 0.0 - 1000.0)
    orbitcam.orbit_apply(o, cam)
    check("pitch is held at the upper limit", near(o.pitch, 85.0))
    orbitcam.orbit_turn(o, 0.0, 1000.0)
    orbitcam.orbit_apply(o, cam)
    check("and at the lower", near(o.pitch, 0.0 - 85.0))
    orbitcam.orbit_set_limits(o, 2.0, 50.0, 0.0 - 10.0, 60.0)
    orbitcam.orbit_apply(o, cam)
    check("narrowed limits take hold at the next apply", near(o.pitch, 0.0 - 10.0))
    orbitcam.orbit_set_limits(o, 50.0, 2.0, 60.0, 0.0 - 10.0)
    check("limits given the wrong way round are put in order", near(o.min_distance, 2.0) && near(o.max_pitch, 60.0))

    // Zoom.
    orbitcam.orbit_set_pose(o, 10.0, 0.0, 0.0)
    orbitcam.orbit_zoom_step(o, true)
    check("a notch in divides the distance by the step", near(o.distance, 10.0 / 1.12))
    orbitcam.orbit_zoom_step(o, false)
    check("a notch out multiplies it back", near(o.distance, 10.0))
    orbitcam.orbit_zoom(o, 2.0)
    check("two notches in are two steps", near(o.distance, 10.0 / 1.12 / 1.12))
    orbitcam.orbit_set_pose(o, 10.0, 0.0, 0.0)
    orbitcam.orbit_zoom(o, 0.5)
    check("half a notch is between none and one", o.distance < 10.0 && o.distance > 10.0 / 1.12)
    orbitcam.orbit_set_pose(o, 10.0, 0.0, 0.0)
    orbitcam.orbit_zoom(o, 100.0)
    orbitcam.orbit_apply(o, cam)
    check("zoom in stops at the nearest distance", near(o.distance, 2.0))
    orbitcam.orbit_zoom(o, 0.0 - 100.0)
    orbitcam.orbit_apply(o, cam)
    check("and out at the farthest", near(o.distance, 50.0))

    // The editor's limits: 8 to 8000, 85 degrees.
    orbitcam.orbit_set_limits(o, 8.0, 8000.0, 0.0 - 85.0, 85.0)
    orbitcam.orbit_set_pose(o, 3.0, 0.0, 0.0)
    orbitcam.orbit_apply(o, cam)
    check("below the minimum distance is lifted to it", near(o.distance, 8.0))
    core.camera_free(cam)
    orbitcam.orbit_free(o)
}

// The camera's own view kept: the orbit made from where it stands and looks
// puts it back where it stood.
from_camera_checks() {
    cam = core.camera_new(320, 180)
    core.camera_set_position(cam, core.vec3(5.0, 3.0, 9.0))
    cam.yaw = 0.0 - 70.0
    cam.pitch = 12.0
    core.camera_update_vectors(cam)
    at = cam.position
    front = cam.front

    o = orbitcam.orbit_new(core.v3_zero(), 1.0, 0.0, 0.0)
    orbitcam.orbit_set_limits(o, 8.0, 8000.0, 0.0 - 85.0, 85.0)
    orbitcam.orbit_from_camera(o, cam, orbitcam.ORBIT_AHEAD)
    check("the pivot is 40 ahead along the line of sight",
          near_v(o.target, core.v3_add(at, core.v3_mul(front, 40.0))))
    check("the distance is the pivot's", near(o.distance, 40.0))
    check("the camera has not moved", near_v(cam.position, at))
    check("nor turned", near_v(cam.front, front))
    core.camera_free(cam)
    orbitcam.orbit_free(o)
}

input_checks() {
    cam = core.camera_new(320, 180)
    i = input.input_new(null)
    o = orbitcam.orbit_new(core.v3_zero(), 10.0, 0.0, 0.0)

    // A press that does not travel is a click: nothing turns.
    frame(i, o, cam, 100.0, 100.0, false, 0.0, 0.016)
    frame(i, o, cam, 100.0, 100.0, true, 0.0, 0.016)
    frame(i, o, cam, 102.0, 101.0, true, 0.0, 0.016)
    check("a press within the slop is not a drag", near(o.yaw, 0.0) && near(o.pitch, 0.0) && !orbitcam.orbit_dragging(o))
    // Crossing the slop turns by that frame's own move, and on.
    frame(i, o, cam, 112.0, 101.0, true, 0.0, 0.016)
    check("crossing the slop turns by the frame's move", near(o.yaw, 10.0 * 0.35) && orbitcam.orbit_dragging(o))
    frame(i, o, cam, 112.0, 121.0, true, 0.0, 0.016)
    check("a drag down lowers the pitch", near(o.pitch, 0.0 - 20.0 * 0.35) && near(o.yaw, 3.5))
    frame(i, o, cam, 140.0, 121.0, false, 0.0, 0.016)
    check("released, the move turns nothing", near(o.yaw, 3.5) && !orbitcam.orbit_dragging(o))
    check("and the camera follows the orbit", near_v(cam.position, orbitcam.orbit_eye(o)))

    // A second press starts again from where it went down.
    frame(i, o, cam, 140.0, 121.0, true, 0.0, 0.016)
    frame(i, o, cam, 141.0, 121.0, true, 0.0, 0.016)
    check("a new press is a click again", near(o.yaw, 3.5))
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.016)

    // The wheel, pushed away, zooms in.
    before = o.distance
    frame(i, o, cam, 141.0, 121.0, false, 1.0, 0.016)
    check("a notch away zooms in", near(o.distance, before / 1.12))
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.016)
    check("and only that frame's", near(o.distance, before / 1.12))
    frame(i, o, cam, 141.0, 121.0, false, 0.0 - 2.0, 0.016)
    check("two notches toward zoom out", near(o.distance, before * 1.12))

    // Keys: the arrows turn at key_turn degrees a second.
    yaw = o.yaw
    input.inject_key(i, platform.KEY_RIGHT, true)
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.5)
    check("right turns the yaw 45 in half a second", near(o.yaw, yaw + 45.0))
    input.inject_key(i, platform.KEY_RIGHT, false)
    input.inject_key(i, platform.KEY_UP, true)
    pitch = o.pitch
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.25)
    check("up raises the pitch", near(o.pitch, pitch + 22.5))
    input.inject_key(i, platform.KEY_UP, false)

    // Zoom keys are unbound until asked for.
    distance = o.distance
    input.inject_key(i, platform.KEY_Q, true)
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.25)
    check("no zoom key until one is bound", near(o.distance, distance))
    orbitcam.orbit_bind_zoom_keys(o, platform.KEY_Q, platform.KEY_E)
    frame(i, o, cam, 141.0, 121.0, false, 0.0, 0.25)
    check("a bound zoom key zooms in", o.distance < distance)
    input.inject_key(i, platform.KEY_Q, false)

    // A menu has the input: nothing moves, and a press under way is dropped.
    yaw = o.yaw
    distance = o.distance
    input.set_blocked(i, true)
    input.inject_key(i, platform.KEY_LEFT, true)
    frame(i, o, cam, 150.0, 121.0, true, 1.0, 0.016)
    frame(i, o, cam, 190.0, 121.0, true, 1.0, 0.016)
    check("a blocked input moves nothing", near(o.yaw, yaw) && near(o.distance, distance))
    input.set_blocked(i, false)
    input.inject_key(i, platform.KEY_LEFT, false)

    // Another button drags when asked to.
    orbitcam.orbit_set_button(o, platform.MOUSE_RIGHT)
    input.inject_mouse(i, platform.MOUSE_LEFT, false)
    frame(i, o, cam, 200.0, 100.0, false, 0.0, 0.016)
    input.inject_mouse(i, platform.MOUSE_RIGHT, true)
    frame(i, o, cam, 200.0, 100.0, false, 0.0, 0.016)
    yaw = o.yaw
    input.inject_cursor(i, 240.0, 100.0)
    input.poll_frame(i, 0.016)
    orbitcam.orbit_update(o, i, cam, 0.016)
    check("the right button drags when it is the one set", near(o.yaw, yaw + 40.0 * 0.35))

    input.inject_clear(i)
    input.input_free(i)
    core.camera_free(cam)
    orbitcam.orbit_free(o)
}

// The engine drives it from its own loop.
engine_checks() {
    e = engine.engine_new()
    // The engine has its camera only once it runs; a camera of the program's
    // own (a view's) is driven the same way.
    cam = core.camera_new(320, 180)
    o = orbitcam.orbit_new(core.vec3(0.0, 1.0, 0.0), 20.0, 90.0, 20.0)
    count = engine.engine_behaviour_count(e)
    orbitcam.attach(e, o, cam)
    check("attach adds a behaviour", engine.engine_behaviour_count(e) == count + 1)
    engine.engine_update(e, 0.016)
    check("the engine's update puts the camera on the orbit", near_v(cam.position, orbitcam.orbit_eye(o)))

    i = engine.engine_input(e)
    input.inject_cursor(i, 10.0, 10.0)
    input.inject_mouse(i, platform.MOUSE_LEFT, true)
    input.poll_frame(i, 0.016)
    engine.engine_update(e, 0.016)
    input.inject_cursor(i, 50.0, 10.0)
    input.poll_frame(i, 0.016)
    engine.engine_update(e, 0.016)
    check("a drag in the engine's input turns it", near(o.yaw, 90.0 + 40.0 * 0.35))
    check("and the camera follows", near_v(cam.position, orbitcam.orbit_eye(o)))

    orbitcam.detach(o)
    check("detach takes the behaviour out", engine.engine_behaviour_count(e) == count)
    yaw = o.yaw
    input.inject_cursor(i, 90.0, 10.0)
    input.poll_frame(i, 0.016)
    engine.engine_update(e, 0.016)
    check("a detached orbit is not driven", near(o.yaw, yaw))
    input.inject_clear(i)
    orbitcam.orbit_free(o)
    core.camera_free(cam)
    engine.engine_free(e)
}

main() {
    println("orbitcam: the engine's orbit camera (#823)")
    pose_checks()
    from_camera_checks()
    input_checks()
    engine_checks()
    if failures > 0 {
        println("orbitcam: ${failures} failure(s)")
        exit(1)
    }
    println("orbitcam: all checks passed")
}
