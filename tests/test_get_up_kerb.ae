// Getting up over a kerb (#643), held to numbers. The box man (the fixture
// the motion showcase dresses), POWERED, getting up by itself half a
// second after it settles, struck from behind 3.25 m/s at the chest so it
// falls on its front with the kerb, 0.2 m high, under its chest or its
// legs: kerbs starting 0.0, 0.3, 0.6 and 1.0 m ahead of it, 1.2, 1.4 and
// 1.6, where its chest lands across the kerb's edge and it rises on the
// kerb with its heels over the edge, and 2.0, past where it lands. Each in
// an engine of its own, no window.
//
//   - it gets up, and the way up ends near upright (under 0.1 rad): its
//     hands, knees and feet set on the ground under each, not on one flat
//     floor at its lowest point (kerb 0.3 m ahead: 0.71 rad off, and down
//     again 10 s on);
//   - handed to its balance it stands where it rose: its centre of mass
//     moves under 5 cm along the ground in the second after. Handed over
//     on the clock with its feet dragged 20 cm behind its hips, it righted
//     itself 20 to 30 cm back, and on the kerb's edge stepped back off it;
//   - ten seconds on it stands, upright (under 0.1 rad), on the kerb or
//     beside it (pelvis 0.9 m over the ground under it at least).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.motion
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

trial(ahead: float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", "tests/fixtures/gltf/humanoid.glb")
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    way = facing(m)
    kerb = engine.object(e, "Kerb", loader.cube(1.0))
    behaviour.object_set_position(kerb, core.vec3(way.x * (ahead + 1.0), 0.1, way.z * (ahead + 1.0)))
    physics.box_collider(kerb, core.vec3(1.0, 0.1, 1.0), physics.material(0.8, 0.0))
    motion.set_get_up(m, 0.5)
    motion.hit(m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03)), core.v3_mul(way, 3.25 * physics.ragdoll_mass(r)))
    rose = false
    risen_tilt = 0.0
    risen_at = core.vec3(0.0, 0.0, 0.0)
    risen_step = 0
    drift = 0.0
    k = 0
    while k < 600 {
        before = motion.getting_up(m)
        engine.engine_update(e, STEP)
        if before && !motion.getting_up(m) && !rose {
            rose = true
            risen_tilt = motion.tilt(m)
            risen_at = physics.ragdoll_center_of_mass(r)
            risen_step = k
        }
        if rose && k == risen_step + 60 {
            now = physics.ragdoll_center_of_mass(r)
            drift = core.v3_len(core.vec3(now.x - risen_at.x, 0.0, now.z - risen_at.z))
        }
        k = k + 1
    }
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    hit = physics.ray_static_hit(physics.of(e), core.vec3(pelvis.x, pelvis.y, pelvis.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0)
    floor = 0.0
    if hit.hit { floor = hit.point.y }
    println("  kerb ${ahead} m ahead: rose ${rose}, the way up ended ${risen_tilt} rad off upright, ${drift * 100.0} cm moved the second after; 10 s on ${motion.tilt(m)} rad, pelvis ${pelvis.y - floor} m over the ground under it (${floor} m)")
    check("kerb ${ahead} m ahead: it gets up, ending under 0.1 rad off upright", rose && risen_tilt < 0.1)
    check("kerb ${ahead} m ahead: it stands where it rose, moving under 5 cm the second after", rose && drift < 0.05)
    check("kerb ${ahead} m ahead: 10 s on it stands upright", motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && pelvis.y - floor >= 0.9)
    engine.engine_free(e)
    motion.motion_free(m)
}

main() {
    println("get_up_kerb: the box man tripped onto a kerb ahead of it, getting up")
    trial(0.0)
    trial(0.3)
    trial(0.6)
    trial(1.0)
    trial(1.2)
    trial(1.4)
    trial(1.6)
    trial(2.0)
    if g_failures == 0 {
        println("get_up_kerb: all checks passed (${g_checks})")
        return
    }
    println("get_up_kerb: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
