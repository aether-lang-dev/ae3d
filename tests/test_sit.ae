// Sitting on a seat and standing up (#825, motion.sit / stand_up), held to
// the numbers a game judges it by: the box man with feet of its own, POWERED,
// stood where motion.sit_spot puts it before a log 0.4 m high, sits on it,
// stays, and stands up. No window.
//
//   - sat, its drawn pelvis and thighs rest on the log's top all the while:
//     the lowest of their flesh under 1 cm over it and no more than 1 cm
//     into it (#825's 3 cm, for the figure a player sees). Set down by its
//     capsules, fitted round the bones, the drawn sitter rested 1.35 cm
//     over the log;
//   - its feet stay where they stood: neither toe slides more than 5 mm
//     along the ground, going down and coming up (toe skating, as the game
//     measures feet);
//   - no body turns more than 6 degrees in a step, from the first step
//     down to standing again (no pop);
//   - stood up, it is POWERED again and upright: under 0.1 rad a second on.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human
import aephysics.dynamics

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern acos(x: float) -> float

const STEP = 0.016666666666666666
const PATH = "tests/fixtures/gltf/humanoid.glb"
const SEAT_HIGH = 0.4

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// The ankles' middle, as the bodies stand.
ankles(m: *Motion) -> Vec3 {
    r = m.ragdoll
    pose = calloc(human.MAX_BONE_COUNT * physics.POSE_STRIDE, 8)
    physics.ragdoll_body_pose(r, pose)
    at = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, pose, human.BONE_CALF_L), physics.ragdoll_pose_end(r, pose, human.BONE_CALF_R)), 0.5)
    free(pose)
    return at
}

// A foot's toe: the end of its capsule farther from its ankle.
toe_at(m: *Motion, foot: int) -> Vec3 {
    bone = human.bone_at(physics.ragdoll_human(m.ragdoll), foot)
    t = dynamics.body_get_transform(bone.body_id)
    c = dynamics.shape_get_capsule(bone.shape_id)
    a = core.v3_add(t.p, core.quat_apply(t.q, c.center1))
    b = core.v3_add(t.p, core.quat_apply(t.q, c.center2))
    ankle = core.v3_add(t.p, core.quat_apply(t.q, bone.local_frame_b.p))
    if core.v3_len(core.v3_sub(b, ankle)) > core.v3_len(core.v3_sub(a, ankle)) { return b }
    return a
}

// The lowest point of the drawn flesh of the pelvis and the thighs: what a
// player sees rest on the seat.
seat_low(m: *Motion) -> float {
    r = m.ragdoll
    low = 1000.0
    bones = [human.BONE_PELVIS, human.BONE_THIGH_L, human.BONE_THIGH_R]
    j = 0
    while j < 3 {
        at, found = physics.ragdoll_flesh_lowest(r, bones[j])
        if found && at < low { low = at }
        j = j + 1
    }
    return low
}

// How far `now` is from `was` along the ground: a foot's skate.
along_ground(now: Vec3, was: Vec3) -> float {
    return core.v3_len(core.vec3(now.x - was.x, 0.0, now.z - was.z))
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

main() {
    println("sit: on a log 0.4 m high and up again (#825)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    physics.physics_set_ankles(physics.of(e), true)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Man", PATH)
    if o == null {
        println("sit: SKIP ${PATH} would not load")
        engine.engine_free(e)
        return
    }
    m = motion.on_figure(e, o)
    motion.set_mode(m, motion.POWERED)
    r = m.ragdoll
    k = 0
    while k < 90 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // The log where its hips will rest, a thigh behind where it stands.
    way = facing(m)
    feet = ankles(m)
    spot = motion.sit_spot(m, core.vec3(0.0, SEAT_HIGH, 0.0), way)
    seat = core.vec3(feet.x - spot.x, SEAT_HIGH, feet.z - spot.z)
    log = engine.object(e, "Log", loader.cube(1.0))
    behaviour.object_set_position(log, core.vec3(seat.x, SEAT_HIGH * 0.5, seat.z))
    behaviour.object_set_rotation(log, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), way))
    physics.box_collider(log, core.vec3(0.6, SEAT_HIGH * 0.5, 0.2), physics.material(0.8, 0.0))
    engine.engine_update(e, STEP)

    count = physics.ragdoll_bone_count(r)
    was = calloc(count * 4, 8)
    last = was as float[]
    i = 0
    while i < count {
        q = physics.ragdoll_bone_rotation(r, i)
        last[i * 4] = q.x
        last[i * 4 + 1] = q.y
        last[i * 4 + 2] = q.z
        last[i * 4 + 3] = q.w
        i = i + 1
    }
    left0 = toe_at(m, human.BONE_FOOT_L)
    right0 = toe_at(m, human.BONE_FOOT_R)
    check("it sits", motion.sit(m, seat, way) && motion.sitting(m))
    worst_turn = 0.0
    feet_down = 0.0
    feet_up = 0.0
    seated_at = 0 - 1
    low_sat = 1.0
    high_sat = 0.0 - 1.0
    standing = false
    up_at = 0 - 1
    k = 0
    while k < 600 {
        engine.engine_update(e, STEP)
        i = 0
        while i < count {
            q = physics.ragdoll_bone_rotation(r, i)
            t = turned_by(core.quat(last[i * 4], last[i * 4 + 1], last[i * 4 + 2], last[i * 4 + 3]), q)
            if up_at < 0 && t > worst_turn { worst_turn = t }
            last[i * 4] = q.x
            last[i * 4 + 1] = q.y
            last[i * 4 + 2] = q.z
            last[i * 4 + 3] = q.w
            i = i + 1
        }
        off = along_ground(toe_at(m, human.BONE_FOOT_L), left0)
        off_r = along_ground(toe_at(m, human.BONE_FOOT_R), right0)
        if off_r > off { off = off_r }
        if seated_at < 0 && motion.seated(m) { seated_at = k }
        // Sat, all the while: how far the drawn flesh is off the log's top.
        if seated_at >= 0 && !standing {
            gap = seat_low(m) - SEAT_HIGH
            if gap > high_sat { high_sat = gap }
            if gap < low_sat { low_sat = gap }
        }
        if !standing && off > feet_down { feet_down = off }
        if standing && up_at < 0 && off > feet_up { feet_up = off }
        // A second sat, it stands up.
        if seated_at >= 0 && !standing && k == seated_at + 60 { standing = motion.stand_up(m) }
        if standing && up_at < 0 && !motion.acting(m) { up_at = k }
        if up_at >= 0 && k == up_at + 60 { k = 600 }
        k = k + 1
    }
    free(was)
    println("  sat after ${(seated_at as float) * STEP} s, its drawn pelvis and thighs ${low_sat * 100.0} to ${high_sat * 100.0} cm over the log all the while; the toes slid ${feet_down * 1000.0} mm going down, ${feet_up * 1000.0} mm coming up; the worst turn in a step ${worst_turn * 57.29578} degrees")
    check("it comes to sit", seated_at >= 0)
    check("sat, its drawn pelvis and thighs rest on the log all the while (under 1 cm over it, no more than 1 cm into it)", seated_at >= 0 && high_sat < 0.01 && low_sat > 0.0 - 0.01)
    check("its feet stay where they stood going down (under 5 mm along the ground)", feet_down < 0.005)
    check("it stands up", standing && up_at >= 0)
    check("its feet stay where they stood coming up (under 5 mm along the ground)", standing && feet_up < 0.005)
    check("no body turns more than 6 degrees in a step (no pop)", worst_turn < 0.10472)
    println("  stood up: ${motion.mode_name(motion.mode(m))}, ${motion.tilt(m)} rad a second on")
    check("stood up, it is POWERED again and upright a second on (under 0.1 rad)", up_at >= 0 && motion.mode(m) == motion.POWERED && motion.tilt(m) < 0.1 && !motion.falling(m))
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures > 0 {
        println("sit: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
    println("sit: all checks passed (${g_checks})")
}
