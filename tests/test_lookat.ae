// A head that looks at a point (#587), held to numbers on the box man
// fixture (tests/fixtures/gltf/humanoid.glb, Mixamo's names, its Idle
// playing), no window, stepped at 60 Hz: the clip, then the look.
//
//   - a point ahead and to the side, within the limits: the head faces it,
//     to 3 degrees, a second on;
//   - a point behind: the turn is held at the limit, YAW_LIMIT;
//   - the head never turns more than 6 degrees in a frame, the clip's own
//     motion included;
//   - cleared, the head is back on its clip a second on (to a thousandth of
//     a radian);
//   - every bone but the neck and the head is left as the clip posed it;
//   - looking through a change of clip (#673): from the Idle into a clip
//     keying the neck and the head ("Nod", made at run time) and four
//     frames later back into the Idle, which keys neither, so Nod's offset
//     falls on them there; the look told the figure (set_figure). Cleared after, the
//     head is back where a twin stepped alike with no look has it, to a
//     thousandth of a radian. The figure takes its own offsets off the
//     neck and the head from under the look; the look, taking its turn off
//     only where they still held exactly what it wrote, left it on, and
//     the next went on top;
//   - struck while looking (#678): the box man, its look 60 degrees to its
//     left, given an active ragdoll that follows it, handed to POWERED from
//     the pose on the screen and the look let go, as the plaza strikes a
//     walker watching the car. Its neck turns under 100 degrees a second
//     against its chest in the three steps after; the muscles' targets
//     came off the look's turn at once, and the neck snapped back at 180 to
//     700 degrees a second. A second on, the neck is on its clip's target
//     again, within 5 degrees.

import ae3d.core
import ae3d.skin
import ae3d.figure
import ae3d.lookat
import ae3d.anim
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import aephysics.human
import aephysics.dynamics

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

angle(a: Vec3, b: Vec3) -> float {
    d = core.v3_dot(core.v3_normalize(a), core.v3_normalize(b))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return core.acos_of(d)
}

quat_angle(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// Where the head faces, in the world.
facing(l: *LookAt) -> Vec3 {
    head = l.head as *Model
    core.model_sync_transform(head)
    return core.quat_apply(head.world_rotation, l.head_forward)
}

struct Run {
    worst_step: float                // the head's turn in a frame, the most
    others_moved: float              // the most any other bone's local rotation moved under the look
    last: Quat
    known: bool
}

// A frame: the clip, then the look; what it did to the head and the rest.
frame(fig: *Figure, l: *LookAt, run: *Run, kept: ptr) {
    figure.advance(fig, STEP)
    sk = figure.skeleton(fig)
    n = skin.skeleton_count(sk)
    k = kept as float[]
    i = 0
    while i < n {
        q = skin.skeleton_bone(sk, i).rotation
        k[i * 4] = q.x
        k[i * 4 + 1] = q.y
        k[i * 4 + 2] = q.z
        k[i * 4 + 3] = q.w
        i = i + 1
    }
    lookat.solve(l, STEP)
    i = 0
    while i < n {
        b = skin.skeleton_bone(sk, i)
        if b != l.neck as *Model && b != l.head as *Model {
            moved = quat_angle(b.rotation, core.quat(k[i * 4], k[i * 4 + 1], k[i * 4 + 2], k[i * 4 + 3]))
            if moved > run.others_moved { run.others_moved = moved }
        }
        i = i + 1
    }
    head = l.head as *Model
    core.model_sync_transform(head)
    if run.known {
        t = quat_angle(head.world_rotation, run.last)
        if t > run.worst_step { run.worst_step = t }
    }
    run.last = head.world_rotation
    run.known = true
}

run_for(fig: *Figure, l: *LookAt, run: *Run, kept: ptr, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        frame(fig, l, run, kept)
        k = k + 1
    }
}

// "Nod" on the box man: its neck and head from 0.4 rad off their rest to
// 0.8, over a second.
add_nod(f: *Figure) {
    sk = figure.skeleton(f)
    k = 0
    while k < 2 {
        name = "mixamorig:Neck"
        if k == 1 { name = "mixamorig:Head" }
        bone = skin.skeleton_bone(sk, skin.skeleton_find(sk, name))
        c = anim.clip_new("Nod:${name}")
        ch = anim.channel_new(anim.ROTATION, anim.LINEAR)
        q = core.quat_normalize(core.quat_mul(bone.rotation, core.quat_rotate(0.4, core.vec3(1.0, 0.0, 0.0))))
        on = core.quat_normalize(core.quat_mul(bone.rotation, core.quat_rotate(0.8, core.vec3(1.0, 0.0, 0.0))))
        anim.channel_add_key(ch, 0.0, q.x, q.y, q.z, q.w)
        anim.channel_add_key(ch, 1.0, on.x, on.y, on.z, on.w)
        anim.clip_add_channel(c, ch)
        figure.add_clip(f, "Nod", c, name)
        k = k + 1
    }
}

// Two box men stepped alike from the Idle into Nod and, four frames later,
// back into the Idle, Nod's offset still falling on the neck and the head
// there; one looking aside through it: how far its head is from its twin's
// once the look is cleared.
through_a_change() -> float {
    group = core.model_new()
    twin_group = core.model_new()
    fig = figure.figure_new(PATH, group)
    twin = figure.figure_new(PATH, twin_group)
    add_nod(fig)
    add_nod(twin)
    sk = figure.skeleton(fig)
    neck = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Neck"))
    head = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Head"))
    twin_sk = figure.skeleton(twin)
    twin_head = skin.skeleton_bone(twin_sk, skin.skeleton_find(twin_sk, "mixamorig:Head"))
    l = lookat.attach(null, group, neck, head, core.vec3(0.0, 0.0, 1.0))
    lookat.set_figure(l, fig)
    figure.play(fig, "Idle", 1.0, true)
    figure.play(twin, "Idle", 1.0, true)
    core.model_sync_transform(head)
    lookat.set_target(l, core.v3_add(head.world_position, core.vec3(0.6, 0.1, 1.0)))
    k = 0
    while k < 150 {
        if k == 40 {
            figure.play_blended(fig, "Nod", 1.0, true, 0.3)
            figure.play_blended(twin, "Nod", 1.0, true, 0.3)
        }
        if k == 44 {
            figure.play_blended(fig, "Idle", 1.0, true, 0.3)
            figure.play_blended(twin, "Idle", 1.0, true, 0.3)
        }
        if k == 90 { lookat.clear(l) }
        figure.advance(fig, STEP)
        figure.advance(twin, STEP)
        lookat.solve(l, STEP)
        k = k + 1
    }
    apart = quat_angle(head.rotation, twin_head.rotation)
    lookat.lookat_free(l)
    figure.figure_free(fig)
    figure.figure_free(twin)
    core.model_free(group)
    core.model_free(twin_group)
    return apart
}

// The box man looking LOOK_ASIDE to its left for a second, struck: handed
// to POWERED from the pose on the screen and the look let go. Its neck's
// fastest turn against its chest over the three steps after (radians a
// second), and a second on, its neck's turn off the clip's target (radians).
// -1 for both when it could not be built.
const LOOK_ASIDE = 1.05              // radians, 60 degrees

struck_looking() -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "BoxMan", PATH)
    if o == null {
        engine.engine_free(e)
        figure.figures_free(e)
        return (0.0 - 1.0, 0.0 - 1.0)
    }
    f = figure.figure_of(o)
    figure.play(f, "Idle", 1.0, true)
    sk = figure.skeleton(f)
    group = behaviour.object_model(o)
    core.model_sync_transform(group)
    l = lookat.attach(e, group, skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Neck")),
                      skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Head")), core.vec3(0.0, 0.0, 1.0))
    lookat.set_figure(l, f)
    at = group.world_position
    lookat.set_target(l, core.vec3(at.x + 3.0 * core.sin_of(LOOK_ASIDE), at.y + 1.6, at.z + 3.0 * core.cos_of(LOOK_ASIDE)))
    r = physics.ragdoll(e, "BoxMan", at, 8.0, 8.0, 1.0)
    m = null as *Motion
    if physics.ragdoll_dress_humanoid(r, sk) { m = motion.active_ragdoll(r) }
    if m == null {
        lookat.lookat_free(l)
        engine.engine_free(e)
        figure.figures_free(e)
        return (0.0 - 1.0, 0.0 - 1.0)
    }
    motion.attach(e, m)
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Struck, as the plaza strikes: the bodies on the pose on the screen,
    // powered from it, and only then the look let go.
    physics.ragdoll_to_rig(r)
    motion.set_mode(m, motion.POWERED)
    lookat.release(l)
    h = physics.ragdoll_human(r)
    fastest = 0.0
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        if k < 3 {
            wn = dynamics.body_get_angular_velocity(human.bone_at(h, human.BONE_NECK).body_id)
            wc = dynamics.body_get_angular_velocity(human.bone_at(h, human.BONE_SPINE_03).body_id)
            spin = core.v3_len(core.v3_sub(wn, wc))
            if spin > fastest { fastest = spin }
        }
        k = k + 1
    }
    rel = core.quat_mul(core.quat_conjugate(physics.ragdoll_bone_rotation(r, human.BONE_SPINE_03)), physics.ragdoll_bone_rotation(r, human.BONE_NECK))
    want = core.quat_mul(core.quat_conjugate(physics.ragdoll_bone_target(r, human.BONE_SPINE_03)), physics.ragdoll_bone_target(r, human.BONE_NECK))
    off = quat_angle(rel, want)
    lookat.lookat_free(l)
    engine.engine_free(e)
    motion.motion_free(m)
    figure.figures_free(e)
    return (fastest, off)
}

main() {
    println("lookat: a head that looks (#587)")
    group = core.model_new()
    fig = figure.figure_new(PATH, group)
    if fig == null {
        println("lookat: SKIP ${PATH} would not load")
        return
    }
    figure.play(fig, "Idle", 1.0, true)
    figure.advance(fig, 0.0)
    sk = figure.skeleton(fig)
    neck = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Neck"))
    head = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Head"))
    l = lookat.attach(null, group, neck, head, core.vec3(0.0, 0.0, 1.0))
    check("the box man's neck and head are found, the look attached", l != null)
    kept = calloc(skin.skeleton_count(sk) * 4, 8)
    run = Run { worst_step: 0.0, others_moved: 0.0, last: core.quat_ident(), known: false }
    run_for(fig, l, &run, kept, 0.5)
    core.model_sync_transform(head)
    head_at = head.world_position

    // Ahead and to the side, within the limits.
    point = core.v3_add(head_at, core.vec3(0.6, 0.15, 1.0))
    lookat.set_target(l, point)
    run_for(fig, l, &run, kept, 1.0)
    core.model_sync_transform(head)
    off = angle(facing(l), core.v3_sub(point, head.world_position))
    println("  a point 31 degrees aside and a little up: the head faces ${off * 57.29578} degrees off it (yaw ${lookat.yaw(l)}, pitch ${lookat.pitch(l)})")
    check("it faces a point within its limits, to 3 degrees", off < 0.0524)

    // Behind: held at the limit.
    lookat.set_target(l, core.v3_add(head_at, core.vec3(0.3, 0.0, 0.0 - 1.0)))
    run_for(fig, l, &run, kept, 1.5)
    held = lookat.yaw(l)
    println("  a point behind: the turn held at ${held} rad (the limit ${lookat.YAW_LIMIT})")
    check("a point past the limits is held at the limit", core.abs_of(core.abs_of(held) - lookat.YAW_LIMIT) < 0.01)

    // Cleared: back on the clip.
    lookat.clear(l)
    run_for(fig, l, &run, kept, 1.0)
    clip_head = l.head_rot
    back = quat_angle(head.rotation, clip_head)
    println("  cleared, a second on, the head ${back} rad from its clip; the head turned ${run.worst_step * 57.29578} degrees a frame at most; other bones moved ${run.others_moved} rad under the look")
    check("cleared, the head is back on its clip", back < 0.001)
    check("the head never turns more than 6 degrees in a frame", run.worst_step < 0.1047)
    check("no bone but the neck and the head is turned", run.others_moved < 0.000001)

    apart = through_a_change()
    println("  looking through a change from Nod to the Idle, then cleared: the head ${apart} rad from its twin's, which never looked")
    check("looking through a change of clip, then cleared, the head is where its twin's is", apart < 0.001)

    free(kept)
    lookat.lookat_free(l)
    figure.figure_free(fig)
    core.model_free(group)
    fastest, off = struck_looking()
    println("  struck while looking ${LOOK_ASIDE * 57.2958} degrees aside: the neck turned ${fastest * 57.2958} deg/s at most against its chest in the three steps after; a second on, ${off * 57.2958} degrees off its clip's target")
    check("struck while looking, the neck turns under 100 degrees a second in the three steps after (#678)", fastest >= 0.0 && fastest < 1.745)
    check("and a second on it is on its clip's target, within 5 degrees", off >= 0.0 && off < 0.0873)
    if g_failures == 0 {
        println("lookat: all checks passed (${g_checks})")
        return
    }
    println("lookat: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
