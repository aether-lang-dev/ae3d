// A head that looks at a point (#587), the animator's look (ikrig's, through
// animator.look_at as character.look calls it; #860 retired ae3d.lookat
// onto it), held to numbers on the box man fixture
// (tests/fixtures/gltf/humanoid.glb, Mixamo's names, its Idle playing), no
// window, stepped at 60 Hz beside a twin playing the same with no look:
//
//   - a point ahead and to the side, within the limits: the head faces it,
//     to 3 degrees, a second on;
//   - a point past the side's limit: the way looked is held at the limit,
//     LOOK_YAW_MOST, and the head turns no further; a point behind is let
//     go (ikrig: it would turn to see it), the head back on its clip;
//   - the head never turns more than 6 degrees in a frame, the clip's own
//     motion included;
//   - cleared, the head is back on its clip a second on (to a thousandth of
//     a radian of the twin's);
//   - every joint but the look's (the chest, the neck and the head, which
//     share its turn) is left as the take poses it;
//   - looking through a change of state (#673): from the Idle into the
//     Walk and four frames later back, each blended over 0.3 s, then
//     cleared: the head is where the twin's is, to a thousandth of a radian;
//   - struck while looking (#678): the box man, its look 60 degrees to its
//     left, its physical animation (ae3d.physanim) handed every body, driven
//     toward the take and drawn from its body, and the look let go, as a
//     walker watching a car is struck. Its neck turns under 100 degrees a
//     second against its chest in the three steps after, and a second on it
//     is on its animated target again, within 5 degrees.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator
import ae3d.ikrig
import ae3d.physanim

extern exit(code: int)

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

angle(a: Vec3, b: Vec3) -> float {
    d = core.v3_dot(core.v3_normalize(a), core.v3_normalize(b))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return core.acos_of(d)
}

quat_angle(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// The box man on its Idle, its animator; its Walk a second state.
man(e: *Engine, name: string) -> (*Animator, int, int) {
    o = figure.figure(e, name, PATH)
    if o == null { return null as *Animator, 0, 0 }
    a = animator.attach(e, o)
    if a == null { return null as *Animator, 0, 0 }
    idle = animator.add_state(a, "idle", animator.take(a, "Idle", false), true)
    walk = animator.add_state(a, "walk", animator.take(a, "Walk", true), true)
    animator.play(a, idle, 0.0)
    return a, idle, walk
}

struct Run {
    worst_step: float                // the head's turn in a frame, the most
    others_moved: float              // the most any joint outside the look's moved against the twin's
    last: Quat
    known: bool
}

// A frame of both: what the look did to the head and the rest.
frame(a: *Animator, twin: *Animator, run: *Run, w: ptr) {
    animator.update_now(a, STEP)
    animator.update_now(twin, STEP)
    r = animator.rig(a)
    p = animator.pose_now(a)
    q = animator.pose_now(twin)
    chest = pose.human(r, pose.SPINE_03)
    neck = pose.human(r, pose.NECK)
    head = pose.human(r, pose.HEAD)
    j = 0
    while j < pose.count(r) {
        if j != chest && j != neck && j != head {
            moved = quat_angle(pose.rotation(p, j), pose.rotation(q, j)) +
                    core.v3_len(core.v3_sub(pose.translation(p, j), pose.translation(q, j)))
            if moved > run.others_moved { run.others_moved = moved }
        }
        j = j + 1
    }
    pose.world(r, p, w)
    now = pose.rotation(w, head)
    if run.known {
        t = quat_angle(now, run.last)
        if t > run.worst_step { run.worst_step = t }    }
    run.last = now
    run.known = true
}

run_for(a: *Animator, twin: *Animator, run: *Run, w: ptr, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        frame(a, twin, run, w)
        k = k + 1
    }
}

// The head's joint and the way it faces, over the ground.
head_at(a: *Animator, w: ptr) -> (Vec3, Vec3) {
    r = animator.rig(a)
    pose.world(r, animator.pose_now(a), w)
    at = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.HEAD)))
    return at, ikrig.look_head_forward(animator.look(a), r, w)
}

// The way the figure faces over the ground, level, and its left.
facing_of(a: *Animator) -> (Vec3, Vec3) {
    r = animator.rig(a)
    f = ikrig.dir_to_ground(r, ikrig.rest_forward(r))
    ahead = core.v3_normalize(core.vec3(f.x, 0.0, f.z))
    return ahead, core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead)
}

// A point `far` metres off `from`, `yaw` radians to the figure's left of
// the way it faces, `up` metres higher.
aside(a: *Animator, from: Vec3, yaw: float, far: float, up: float) -> Vec3 {
    ahead, left = facing_of(a)
    way = core.v3_add(core.v3_mul(ahead, far * core.cos_of(yaw)), core.v3_mul(left, far * core.sin_of(yaw)))
    return core.v3_add(from, core.v3_add(way, core.vec3(0.0, up, 0.0)))
}

// Joint `b`'s rotation under joint `a`'s in the rig-space pose `w`.
under(w: ptr, a: int, b: int) -> Quat {
    return core.quat_mul(core.quat_conjugate(pose.rotation(w, a)), pose.rotation(w, b))
}

// The head's local turn off the twin's.
apart(a: *Animator, twin: *Animator) -> float {
    head = pose.human(animator.rig(a), pose.HEAD)
    return quat_angle(pose.rotation(animator.pose_now(a), head), pose.rotation(animator.pose_now(twin), head))
}

// Two box men stepped alike from the Idle into the Walk and, four frames
// later, back into the Idle; one looking aside through it, cleared at 1.5 s:
// how far its head is from its twin's at 2.5 s.
through_a_change() -> float {
    e = engine.engine_new()
    a, idle, walk = man(e, "Looker")
    twin, twin_idle, twin_walk = man(e, "Twin")
    if a == null || twin == null {
        figure.figures_free(e)
        engine.engine_free(e)
        return 1.0
    }
    w = pose.new(animator.rig(a))
    animator.update_now(a, 0.0)
    animator.update_now(twin, 0.0)
    at, _ahead = head_at(a, w)
    animator.look_at(a, aside(a, at, 0.54, 1.17, 0.1), 1.0)
    k = 0
    while k < 150 {
        if k == 40 {
            animator.play(a, walk, 0.3)
            animator.play(twin, twin_walk, 0.3)
        }
        if k == 44 {
            animator.play(a, idle, 0.3)
            animator.play(twin, twin_idle, 0.3)
        }
        if k == 90 { animator.look_off(a) }
        animator.update_now(a, STEP)
        animator.update_now(twin, STEP)
        k = k + 1
    }
    off = apart(a, twin)
    pose.release(w)
    figure.figures_free(e)
    engine.engine_free(e)
    return off
}

// The box man looking LOOK_ASIDE to its left for a second, struck: every
// body of its physical animation driven toward the take and drawn from its
// body, and the look let go. Its drawn neck's fastest turn against its
// drawn chest over the three steps after (radians a second), and a second
// on, the drawn neck's turn under the chest off the animated pose's
// (radians). -1 for both when it could not be built.
const LOOK_ASIDE = 1.05              // radians, 60 degrees
// Seconds the bodies take over the drawn pose: drawn from them at once, the
// neck went from where the take had it to where its body lagged, 4.6
// degrees under the chest in a frame.
const HAND_OVER = 0.25

struck_looking() -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    a, _idle, _walk = man(e, "BoxMan")
    if a == null {
        figure.figures_free(e)
        engine.engine_free(e)
        return (0.0 - 1.0, 0.0 - 1.0)
    }
    pa = physanim.attach(e, a)
    if pa == null {
        figure.figures_free(e)
        engine.engine_free(e)
        return (0.0 - 1.0, 0.0 - 1.0)
    }
    at = behaviour.object_position(animator.figure_object(a))
    animator.look_at(a, aside(a, at, LOOK_ASIDE, 3.0, 1.6), 1.0)
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Struck: every body driven toward the take and drawn from its body,
    // and the look let go.
    k = 0
    while k < physanim.bones(pa) {
        physanim.set_mode(pa, k, physanim.MODE_DRIVEN)
        physanim.set_weight(pa, k, 1.0, HAND_OVER)
        k = k + 1
    }
    animator.look_off(a)
    rig = animator.rig(a)
    neck = pose.human(rig, pose.NECK)
    chest = pose.human(rig, pose.SPINE_03)
    rd = physanim.ragdoll_of(pa)
    neck_body = physanim.bone_named(pa, "Neck")
    chest_body = physanim.bone_named(pa, "Chest")
    w = pose.new(rig)
    pose.world(rig, animator.pose_shown(a), w)
    was = under(w, chest, neck)
    fastest = 0.0
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        if k < 3 {
            // The bodies' own spin, and the drawn neck's turn under the chest.
            _vn, wn = physics.ragdoll_bone_velocity(rd, neck_body)
            _vc, wc = physics.ragdoll_bone_velocity(rd, chest_body)
            spin = core.v3_len(core.v3_sub(wn, wc))
            if spin > fastest { fastest = spin }
            pose.world(rig, animator.pose_shown(a), w)
            now = under(w, chest, neck)
            drawn_spin = quat_angle(now, was) / STEP
            if drawn_spin > fastest { fastest = drawn_spin }
            was = now
        }
        k = k + 1
    }
    pose.world(rig, animator.pose_shown(a), w)
    drawn = under(w, chest, neck)
    pose.world(rig, animator.pose_now(a), w)
    off = quat_angle(drawn, under(w, chest, neck))
    println("  struck: ${physanim.bones(pa)} bodies, the neck's drawn from its body by ${physanim.weight_of(pa, physanim.bone_named(pa, "Neck"))}")
    pose.release(w)
    figure.figures_free(e)
    engine.engine_free(e)
    return (fastest, off)
}

main() {
    println("lookat: a head that looks, on the animator (#587, #860)")
    e = engine.engine_new()
    a, _idle, _walk = man(e, "Looker")
    twin, _twin_idle, _twin_walk = man(e, "Twin")
    if a == null || twin == null {
        println("lookat: SKIP ${PATH} would not load")
        figure.figures_free(e)
        engine.engine_free(e)
        return
    }
    r = animator.rig(a)
    l = animator.look(a)
    check("the box man's chest, neck and head are found, the look made", l != null && pose.human(r, pose.SPINE_03) >= 0 && pose.human(r, pose.NECK) >= 0 && pose.human(r, pose.HEAD) >= 0)
    w = pose.new(r)
    run = Run { worst_step: 0.0, others_moved: 0.0, last: core.quat_ident(), known: false }
    run_for(a, twin, &run, w, 0.5)
    from, _ahead = head_at(a, w)
    body, _left = facing_of(a)

    // Ahead and to the side, within the limits (as far off as 0.6 m aside
    // 1 m ahead).
    point = aside(a, from, 0.54, 1.17, 0.15)
    animator.look_at(a, point, 1.0)
    run_for(a, twin, &run, w, 1.0)
    at, faces = head_at(a, w)
    off = angle(faces, core.v3_sub(point, at))
    println("  a point 31 degrees aside and a little up: the head faces ${off * 57.29578} degrees off it (yaw ${l.yaw}, pitch ${l.pitch})")
    check("it faces a point within its limits, to 3 degrees", off < 0.0524)

    // Past the side's limit (86 degrees aside), and behind.
    animator.look_at(a, aside(a, from, 1.5, 3.0, 0.0), 1.0)
    run_for(a, twin, &run, w, 1.0)
    held = l.yaw
    _at2, faces2 = head_at(a, w)
    turned = angle(core.vec3(faces2.x, 0.0, faces2.z), body)
    println("  a point 86 degrees aside: the way looked held at ${held} rad (the limit ${ikrig.LOOK_YAW_MOST}), the head turned ${turned} rad")
    check("a point past the limits is held at the limit, the head turned no further", core.abs_of(core.abs_of(held) - ikrig.LOOK_YAW_MOST) < 0.01 && turned < ikrig.LOOK_YAW_MOST + 0.01)
    animator.look_at(a, aside(a, from, 3.1415926, 3.0, 0.0), 1.0)
    run_for(a, twin, &run, w, 1.0)
    behind = apart(a, twin)
    println("  a point behind, a second on: the head ${behind} rad from its twin's")
    check("a point behind is let go, the head back on its clip", behind < 0.001)

    // Cleared: back on the clip.
    animator.look_at(a, point, 1.0)
    run_for(a, twin, &run, w, 1.0)
    animator.look_off(a)
    run_for(a, twin, &run, w, 1.0)
    back = apart(a, twin)
    println("  cleared, a second on, the head ${back} rad from its twin's; the head turned ${run.worst_step * 57.29578} degrees a frame at most; joints outside the look moved ${run.others_moved} under it")
    check("cleared, the head is back on its clip", back < 0.001)
    check("the head never turns more than 6 degrees in a frame", run.worst_step < 0.1047)
    check("no joint but the chest, the neck and the head is turned", run.others_moved < 0.000001)
    pose.release(w)
    figure.figures_free(e)
    engine.engine_free(e)

    changed = through_a_change()
    println("  looking through a change from the Idle to the Walk and back, then cleared: the head ${changed} rad from its twin's, which never looked")
    check("looking through a change of state, then cleared, the head is where its twin's is", changed < 0.001)

    fastest, struck_off = struck_looking()
    println("  struck while looking ${LOOK_ASIDE * 57.2958} degrees aside: the neck turned ${fastest * 57.2958} deg/s at most against its chest in the three steps after; a second on, ${struck_off * 57.2958} degrees off its animated target")
    check("struck while looking, the neck turns under 100 degrees a second in the three steps after (#678)", fastest >= 0.0 && fastest < 1.745)
    check("and a second on it is on its animated target, within 5 degrees", struck_off >= 0.0 && struck_off < 0.0873)
    if g_failures == 0 {
        println("lookat: all checks passed (${g_checks})")
        return
    }
    println("lookat: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
