// A head that looks at a point (#587), held to numbers on the box man
// fixture (tests/fixtures/gltf/humanoid.glb, Mixamo's names, its Idle
// playing), no window, stepped at 60 Hz: the clip, then the look.
//
//   - a point ahead and to the side, within the limits: the head faces it,
//     to 3 degrees, a second on;
//   - a point behind: the turn is held at the limit, YAW_LIMIT;
//   - the head never turns more than 6 degrees in a frame, the clip's own
//     motion included;
//   - cleared, the head is back on its clip a second on (to a thousandth of
//     a radian);
//   - every bone but the neck and the head is left as the clip posed it.

import ae3d.core
import ae3d.skin
import ae3d.figure
import ae3d.lookat

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const PATH = "tests/fixtures/gltf/humanoid.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

angle(a: Vec3, b: Vec3) -> float {
    d = core.v3_dot(core.v3_normalize(a), core.v3_normalize(b))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return core.acos_of(d)
}

quat_angle(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

// Where the head faces, in the world.
facing(l: *LookAt) -> Vec3 {
    head = l.head as *Model
    core.model_sync_transform(head)
    return core.quat_apply(head.world_rotation, l.head_forward)
}

struct Run {
    worst_step: float                // the head's turn in a frame, the most
    others_moved: float              // the most any other bone's local rotation moved under the look
    last: Quat
    known: bool
}

// A frame: the clip, then the look; what it did to the head and the rest.
frame(fig: *Figure, l: *LookAt, run: *Run, kept: ptr) {
    figure.advance(fig, STEP)
    sk = figure.skeleton(fig)
    n = skin.skeleton_count(sk)
    k = kept as float[]
    i = 0
    while i < n {
        q = skin.skeleton_bone(sk, i).rotation
        k[i * 4] = q.x
        k[i * 4 + 1] = q.y
        k[i * 4 + 2] = q.z
        k[i * 4 + 3] = q.w
        i = i + 1
    }
    lookat.solve(l, STEP)
    i = 0
    while i < n {
        b = skin.skeleton_bone(sk, i)
        if b != l.neck as *Model && b != l.head as *Model {
            moved = quat_angle(b.rotation, core.quat(k[i * 4], k[i * 4 + 1], k[i * 4 + 2], k[i * 4 + 3]))
            if moved > run.others_moved { run.others_moved = moved }
        }
        i = i + 1
    }
    head = l.head as *Model
    core.model_sync_transform(head)
    if run.known {
        t = quat_angle(head.world_rotation, run.last)
        if t > run.worst_step { run.worst_step = t }
    }
    run.last = head.world_rotation
    run.known = true
}

run_for(fig: *Figure, l: *LookAt, run: *Run, kept: ptr, seconds: float) {
    k = 0
    while k < (seconds / STEP) as int {
        frame(fig, l, run, kept)
        k = k + 1
    }
}

main() {
    println("lookat: a head that looks (#587)")
    group = core.model_new()
    fig = figure.figure_new(PATH, group)
    if fig == null {
        println("lookat: SKIP ${PATH} would not load")
        return
    }
    figure.play(fig, "Idle", 1.0, true)
    figure.advance(fig, 0.0)
    sk = figure.skeleton(fig)
    neck = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Neck"))
    head = skin.skeleton_bone(sk, skin.skeleton_find(sk, "mixamorig:Head"))
    l = lookat.attach(null, group, neck, head, core.vec3(0.0, 0.0, 1.0))
    check("the box man's neck and head are found, the look attached", l != null)
    kept = calloc(skin.skeleton_count(sk) * 4, 8)
    run = Run { worst_step: 0.0, others_moved: 0.0, last: core.quat_ident(), known: false }
    run_for(fig, l, &run, kept, 0.5)
    core.model_sync_transform(head)
    head_at = head.world_position

    // Ahead and to the side, within the limits.
    point = core.v3_add(head_at, core.vec3(0.6, 0.15, 1.0))
    lookat.set_target(l, point)
    run_for(fig, l, &run, kept, 1.0)
    core.model_sync_transform(head)
    off = angle(facing(l), core.v3_sub(point, head.world_position))
    println("  a point 31 degrees aside and a little up: the head faces ${off * 57.29578} degrees off it (yaw ${lookat.yaw(l)}, pitch ${lookat.pitch(l)})")
    check("it faces a point within its limits, to 3 degrees", off < 0.0524)

    // Behind: held at the limit.
    lookat.set_target(l, core.v3_add(head_at, core.vec3(0.3, 0.0, 0.0 - 1.0)))
    run_for(fig, l, &run, kept, 1.5)
    held = lookat.yaw(l)
    println("  a point behind: the turn held at ${held} rad (the limit ${lookat.YAW_LIMIT})")
    check("a point past the limits is held at the limit", core.abs_of(core.abs_of(held) - lookat.YAW_LIMIT) < 0.01)

    // Cleared: back on the clip.
    lookat.clear(l)
    run_for(fig, l, &run, kept, 1.0)
    clip_head = l.head_rot
    back = quat_angle(head.rotation, clip_head)
    println("  cleared, a second on, the head ${back} rad from its clip; the head turned ${run.worst_step * 57.29578} degrees a frame at most; other bones moved ${run.others_moved} rad under the look")
    check("cleared, the head is back on its clip", back < 0.001)
    check("the head never turns more than 6 degrees in a frame", run.worst_step < 0.1047)
    check("no bone but the neck and the head is turned", run.others_moved < 0.000001)

    free(kept)
    lookat.lookat_free(l)
    figure.figure_free(fig)
    core.model_free(group)
    if g_failures == 0 {
        println("lookat: all checks passed (${g_checks})")
        return
    }
    println("lookat: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
