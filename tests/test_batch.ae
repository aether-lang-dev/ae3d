// A frame in one batch (ae3d.batch), the way a sae page's three.js hands
// one over: a cube of six faces, its normals drawn as three.js's
// MeshNormalMaterial draws them (ae3d.batchmaterials), into a canvas read
// back. Held to what the pose says, worked out here and not by a
// renderer: each face the eye sees is, at its centre, the colour of its
// normal in the eye's space to 2/255, and the corners are the clear
// colour; a second pose moves the silhouette. Batches that are malformed or
// over the limits are refused, each with its reason, and change nothing.
//
// With AE3D_BATCH_FILES (paths, a space between) and AE3D_BATCH_OUT (a
// directory) it also draws those batches, a page's as three.js's AeRenderer
// wrote them, in order, and writes each picture there (batch<n>.png).
import std.mem
import std.os
import std.fs
import std.bytes
import std.string
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.png
import ae3d.batch

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern tan(x: float) -> float
extern fabs(x: float) -> float

const SIZE = 256
const HALF = 0.1                   // BoxGeometry(0.2, 0.2, 0.2)

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

// --- writing a batch -----------------------------------------------------------

struct Writer {
    data: ptr
    at: int                        // words written
    cap: int
}

fn writer_new(words: int) -> *Writer {
    w = heap_writer()
    w.data = calloc(words, 4)
    w.cap = words
    return w
}

fn heap_writer() -> *Writer { return calloc(1, sizeof(Writer)) as *Writer }

fn u(w: *Writer, v: long) {
    _s = mem.set_u32_le(w.data, w.at * 4, v)
    w.at = w.at + 1
}

fn f(w: *Writer, v: float) {
    _s = mem.set_float32(w.data, w.at * 4, v)
    w.at = w.at + 1
}

// The README's camera: 70 degrees, square, near 0.01, far 10, one back.
fn camera(w: *Writer) {
    // view: the eye at z = 1, so the world moves back by one
    f(w, 1.0); f(w, 0.0); f(w, 0.0); f(w, 0.0)
    f(w, 0.0); f(w, 1.0); f(w, 0.0); f(w, 0.0)
    f(w, 0.0); f(w, 0.0); f(w, 1.0); f(w, 0.0)
    f(w, 0.0); f(w, 0.0); f(w, 0.0 - 1.0); f(w, 1.0)
    s = 1.0 / tan(35.0 * 3.141592653589793 / 180.0)
    n = 0.01
    fr = 10.0
    f(w, s); f(w, 0.0); f(w, 0.0); f(w, 0.0)
    f(w, 0.0); f(w, s); f(w, 0.0); f(w, 0.0)
    f(w, 0.0); f(w, 0.0); f(w, 0.0 - (fr + n) / (fr - n)); f(w, 0.0 - 1.0)
    f(w, 0.0); f(w, 0.0); f(w, 0.0 - 2.0 * fr * n / (fr - n)); f(w, 0.0)
}

// Face k's normal: +x, -x, +y, -y, +z, -z.
fn face_normal(k: int) -> Vec3 {
    if k == 0 { return core.vec3(1.0, 0.0, 0.0) }
    if k == 1 { return core.vec3(0.0 - 1.0, 0.0, 0.0) }
    if k == 2 { return core.vec3(0.0, 1.0, 0.0) }
    if k == 3 { return core.vec3(0.0, 0.0 - 1.0, 0.0) }
    if k == 4 { return core.vec3(0.0, 0.0, 1.0) }
    return core.vec3(0.0, 0.0, 0.0 - 1.0)
}

// Two axes across face k, b = n cross a, so that a cross b is its normal (counter-clockwise
// seen from outside, as three.js winds its faces).
fn face_axes(k: int) -> (Vec3, Vec3) {
    n = face_normal(k)
    a = core.vec3(n.z, n.x, n.y)
    b = core.vec3(n.y * a.z - n.z * a.y, n.z * a.x - n.x * a.z, n.x * a.y - n.y * a.x)   // n cross a
    return a, b
}

// The cube, as one mesh section: 24 vertices, 36 indices.
fn cube(w: *Writer, id: long) {
    u(w, id); u(w, 24); u(w, 36)
    k = 0
    while k < 6 {
        n = face_normal(k)
        a, b = face_axes(k)
        c = 0
        while c < 4 {
            sa = 1.0
            sb = 1.0
            if c == 1 || c == 2 { sa = 0.0 - 1.0 }
            if c >= 2 { sb = 0.0 - 1.0 }
            // corners in order (+a+b, -a+b, -a-b, +a-b): counter-clockwise
            f(w, HALF * (n.x + sa * a.x + sb * b.x)); f(w, HALF * (n.y + sa * a.y + sb * b.y)); f(w, HALF * (n.z + sa * a.z + sb * b.z))
            c = c + 1
        }
        k = k + 1
    }
    k = 0
    while k < 24 {
        n = face_normal(k / 4)
        f(w, n.x); f(w, n.y); f(w, n.z)
        k = k + 1
    }
    k = 0
    while k < 24 { f(w, 0.0); f(w, 0.0); k = k + 1 }
    k = 0
    while k < 6 {
        o = k * 4
        u(w, o as long); u(w, (o + 1) as long); u(w, (o + 2) as long)
        u(w, o as long); u(w, (o + 2) as long); u(w, (o + 3) as long)
        k = k + 1
    }
}

// Three.js's Euler (rx, ry, 0) in its XYZ order: Rx times Ry, a column at a time.
fn turned(rx: float, ry: float) -> (Vec3, Vec3, Vec3) {
    cx = cos(rx)
    sx = sin(rx)
    cy = cos(ry)
    sy = sin(ry)
    c0 = core.vec3(cy, sx * sy, 0.0 - cx * sy)
    c1 = core.vec3(0.0, cx, sx)
    c2 = core.vec3(sy, 0.0 - sx * cy, cx * cy)
    return c0, c1, c2
}

fn world(w: *Writer, rx: float, ry: float) {
    c0, c1, c2 = turned(rx, ry)
    f(w, c0.x); f(w, c0.y); f(w, c0.z); f(w, 0.0)
    f(w, c1.x); f(w, c1.y); f(w, c1.z); f(w, 0.0)
    f(w, c2.x); f(w, c2.y); f(w, c2.z); f(w, 0.0)
    f(w, 0.0); f(w, 0.0); f(w, 0.0); f(w, 1.0)
}

// A whole batch: the header, the cube when `send`, a draw of it at (rx, ry).
fn frame_batch(frame: int, with_mesh: bool, rx: float, ry: float) -> *Writer {
    w = writer_new(512)
    u(w, batch.MAGIC as long); u(w, batch.VERSION as long); u(w, 0); u(w, frame as long)
    camera(w)
    f(w, 0.0); f(w, 0.0); f(w, 0.0); f(w, 1.0)
    if with_mesh { u(w, 1); cube(w, 7) } else { u(w, 0) }
    u(w, 0)
    u(w, 1)
    u(w, 7); u(w, batch.MATERIAL_NORMAL as long); u(w, 0); f(w, 1.0)
    world(w, rx, ry)
    _s = mem.set_u32_le(w.data, 8, w.at as long)
    return w
}

fn writer_free(w: *Writer) {
    free(w.data)
    free(w as ptr)
}

// --- reading the picture -------------------------------------------------------

fn channel(pixels: ptr, x: int, y: int, c: int) -> int {
    return mem.get_uint8(pixels, (y * SIZE + x) * 4 + c)
}

fn covered(pixels: ptr) -> int {
    n = 0
    i = 0
    while i < SIZE * SIZE {
        if mem.get_uint8(pixels, i * 4) + mem.get_uint8(pixels, i * 4 + 1) + mem.get_uint8(pixels, i * 4 + 2) > 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

// Where a point of the cube, in its own space, falls on the canvas, top
// left first: the pose's turn, the eye one back, the README's lens.
fn project(p: Vec3, rx: float, ry: float) -> (int, int) {
    c0, c1, c2 = turned(rx, ry)
    x = c0.x * p.x + c1.x * p.y + c2.x * p.z
    y = c0.y * p.x + c1.y * p.y + c2.y * p.z
    z = c0.z * p.x + c1.z * p.y + c2.z * p.z - 1.0
    s = 1.0 / tan(35.0 * 3.141592653589793 / 180.0)
    nx = s * x / (0.0 - z)
    ny = s * y / (0.0 - z)
    return ((nx + 1.0) * 0.5 * SIZE) as int, ((1.0 - ny) * 0.5 * SIZE) as int
}

fn eye_normal(k: int, rx: float, ry: float) -> Vec3 {
    n = face_normal(k)
    c0, c1, c2 = turned(rx, ry)
    return core.vec3(c0.x * n.x + c1.x * n.y + c2.x * n.z,
                     c0.y * n.x + c1.y * n.y + c2.y * n.z,
                     c0.z * n.x + c1.z * n.y + c2.z * n.z)
}

fn near(got: int, want: float) -> bool {
    return fabs((got as float) - (want * 0.5 + 0.5) * 255.0) <= 2.0
}

// Each face turned to the eye, at its centre, the colour of its normal there.
fn faces_hold(pixels: ptr, rx: float, ry: float, label: string) {
    k = 0
    seen = 0
    while k < 6 {
        n = eye_normal(k, rx, ry)
        centre = face_normal(k)
        // facing the eye, which is at (0, 0, 1) in the cube's frame of the view
        c0, c1, c2 = turned(rx, ry)
        px = HALF * (c0.x * centre.x + c1.x * centre.y + c2.x * centre.z)
        py = HALF * (c0.y * centre.x + c1.y * centre.y + c2.y * centre.z)
        pz = HALF * (c0.z * centre.x + c1.z * centre.y + c2.z * centre.z)
        toward = n.x * (0.0 - px) + n.y * (0.0 - py) + n.z * (1.0 - pz)
        if toward > 0.15 {
            x, y = project(core.vec3(HALF * centre.x, HALF * centre.y, HALF * centre.z), rx, ry)
            r = channel(pixels, x, y, 0)
            g = channel(pixels, x, y, 1)
            b = channel(pixels, x, y, 2)
            check("${label}: face ${k} at (${x}, ${y}) is ${r} ${g} ${b}, its normal in the eye's space (${n.x}, ${n.y}, ${n.z})",
                  near(r, n.x) && near(g, n.y) && near(b, n.z))
            seen = seen + 1
        }
        k = k + 1
    }
    check("${label}: the eye sees ${seen} faces", seen >= 1)
    check("${label}: the corners are the clear colour",
          channel(pixels, 0, 0, 0) == 0 && channel(pixels, SIZE - 1, 0, 1) == 0 && channel(pixels, 0, SIZE - 1, 2) == 0 &&
          channel(pixels, SIZE - 1, SIZE - 1, 0) == 0)
}

fn refused(b: *Batch, w: *Writer, bytes: int, wanted: string, label: string) {
    meshes = batch.batch_mesh_count(b)
    why = batch.batch_submit(b, w.data, bytes)
    check("refused, ${label}: \"${why}\"", why != "" && string_has(why, wanted) && batch.batch_mesh_count(b) == meshes)
}

extern strstr(h: string, n: string) -> ptr

fn string_has(h: string, n: string) -> bool { return strstr(h, n) != null }

// A page's own batches, from files (three.js's AeRenderer's, one a frame,
// in order), drawn by a batch of their own, each picture written out.
fn file_batches(renderer: *GLRenderer) {
    paths = os.getenv("AE3D_BATCH_FILES")
    dir = os.getenv("AE3D_BATCH_OUT")
    if paths == null || dir == null { return }
    b = batch.batch_new(renderer, SIZE, SIZE)
    k = 0
    rest = paths
    while string.length(rest) > 0 {
        cut = string.index_of(rest, " ")
        path = rest
        if cut >= 0 { path = string.substring(rest, 0, cut) }
        if cut >= 0 { rest = string.substring(rest, cut + 1, string.length(rest)) } else { rest = "" }
        data, length, err = fs.read_binary(path)
        if err != "" {
            check("read ${path}: ${err}", false)
            return
        }
        buffer = bytes.new(length + 4)
        bytes.copy_from_string(buffer, 0, data, length)
        why = batch.batch_submit(b, bytes.data(buffer), length)
        bytes.free(buffer)
        check("${path} is taken (${why})", why == "")
        batch.batch_draw(b)
        pixels = batch.batch_pixels(b)
        k = k + 1
        out = "${dir}/batch${k}.png"
        check("written to ${out}", png.write(out, pixels, SIZE, SIZE))
        println("  ${path}: frame ${batch.batch_frame(b)}, ${batch.batch_mesh_count(b)} meshes, ${batch.batch_triangle_count(b)} triangles, ${batch.batch_draw_count(b)} draws, ${covered(pixels)} pixels covered")
    }
    batch.batch_free(b)
}

main() {
    println("test_batch: a frame in one batch, its normals drawn")
    context = offscreen.context_create(SIZE, SIZE)
    if context == null {
        println("  SKIP no OpenGL context available")
        return
    }
    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, SIZE, SIZE) {
        println("  SKIP the OpenGL backend would not initialise")
        offscreen.context_destroy(context)
        return
    }
    b = batch.batch_new(renderer, SIZE, SIZE)
    check("a batch's canvas is made", b != null)
    if b == null { exit(1) }

    // The first frame sends the cube; the second only draws it, turned.
    rx = 0.6
    ry = 0.9
    w = frame_batch(1, true, rx, ry)
    why = batch.batch_submit(b, w.data, w.at * 4)
    check("frame 1 is taken (${why})", why == "")
    check("one mesh, 24 vertices, 12 triangles, one draw",
          batch.batch_mesh_count(b) == 1 && batch.batch_vertex_count(b) == 24 && batch.batch_triangle_count(b) == 12 &&
          batch.batch_draw_count(b) == 1)
    batch.batch_draw(b)
    first = calloc(SIZE * SIZE, 4)
    _c = mem.copy(first, batch.batch_pixels(b), (SIZE * SIZE * 4) as long)
    one = covered(first)
    println("  frame 1: ${one} pixels covered")
    shot = os.getenv("AE3D_BATCH_SHOTS")
    if shot != null { _p = png.write("${shot}/frame1.png", first, SIZE, SIZE) }
    check("frame 1: the cube is there", one > 1000 && one < SIZE * SIZE / 4)
    faces_hold(first, rx, ry, "frame 1")
    writer_free(w)

    w = frame_batch(2, false, 1.3, 2.4)
    why = batch.batch_submit(b, w.data, w.at * 4)
    check("frame 2, the mesh kept, is taken (${why})", why == "" && batch.batch_mesh_count(b) == 1)
    batch.batch_draw(b)
    second = batch.batch_pixels(b)
    two = covered(second)
    differ = 0
    i = 0
    while i < SIZE * SIZE {
        if mem.get_uint8(first, i * 4) != mem.get_uint8(second, i * 4) { differ = differ + 1 }
        i = i + 1
    }
    println("  frame 2: ${two} pixels covered, ${differ} differ from frame 1")
    check("frame 2: the silhouette moved", differ > 200)
    faces_hold(second, 1.3, 2.4, "frame 2")
    writer_free(w)

    // Refusals, each leaving the batch as it was.
    w = frame_batch(3, true, rx, ry)
    words = w.at
    refused(b, w, words * 4 - 4, "words", "one word short")
    _m = mem.set_u32_le(w.data, 0, 1)
    refused(b, w, words * 4, "magic", "not a batch")
    writer_free(w)
    w = frame_batch(3, true, rx, ry)
    _x = mem.set_u32_le(w.data, (41 + 3 + 24 * 8 + 5) * 4, 24)
    refused(b, w, words * 4, "past its vertices", "an index past the vertices")
    writer_free(w)
    w = frame_batch(3, false, rx, ry)
    _d = mem.set_u32_le(w.data, (43) * 4, 99)
    refused(b, w, w.at * 4, "not there", "a draw of a mesh that is not there")
    writer_free(w)
    batch.batch_set_limits(b, 1024, 23, 16)
    w = frame_batch(3, true, rx, ry)
    refused(b, w, w.at * 4, "24 vertices", "24 vertices over a limit of 23")
    writer_free(w)
    batch.batch_set_limits(b, 1024, 4096, 16)

    file_batches(renderer)

    batch.batch_free(b)
    free(first)
    core.backend_cleanup(&backend)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)
    if g_failures > 0 {
        println("test_batch: ${g_failures} failed")
        exit(1)
    }
    println("batch: all checks passed")
}
