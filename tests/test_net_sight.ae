// Relevance by what each client can see (#487): 500 objects in a street
// of buildings, a host and two clients standing in the middle of it
// looking opposite ways along it, over the loopback's 50 ms, 10 ms of
// jitter and 2% lost, on the test's clock. Half the objects are on the
// road; the other half in the yards behind the buildings, which the host
// has as physics statics. Every object moves every tick, so every one
// always has something to send, and every client's snapshots have a
// budget that cannot hold them all. Each client sends its view with its
// inputs. Held to numbers:
//
//   - an object a client can see (in its view, and a ray from its eye
//     reaches it) waits at most a tick between snapshots that carry it;
//   - one it cannot -- occluded by a building, or out of its view --
//     waits longer, N ticks at most, N stated, and is never left unsent;
//   - a client that turns round has every object newly in its view up to
//     date within 2 ticks of the first tick judged by its new view;
//   - at the same budget, the share of the snapshot bytes spent on what a
//     client can see, against relevance by distance alone -- and how long
//     the objects it can see wait there;
//   - what judging sight costs the host: rays a tick, and the milliseconds
//     of its step against distance alone.
//
// Every wait is measured here, from the tick each object was last sent,
// not taken from the session's own counters.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.platform
import ae3d.net

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern cos(x: float) -> float
extern sin(x: float) -> float

const OBJECTS = 500
const STREET = 250                   // on the road; the rest in the yards
const COLUMNS = 50
const STEP = 0.016666666666666666
const STEPS = 480                    // eight seconds
const SETTLE = 2.0                   // seconds before the waits are measured: every object whole once, the views in
const TURN_AT = 5.0                  // client 1 turns round
const BUDGET = 900                   // bytes a snapshot, every client: what a client sees fits every other tick, the rest waits its turn
const FOV = 1.2217304763960306       // 70 degrees, vertical
const ASPECT = 1.7777777777777777
const BLOCKS = 13                    // buildings each side, 20 m long with 4 m alleys between

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Object i's place at time t: its spot on the road or in a yard, and a
// circle of 80 cm round it at a radian a second, each a radian further on.
spot_x(i: int) -> float {
    k = i % STREET
    return (0.0 - 145.0) + ((k / 5) as float) * 5.8
}

spot_z(i: int) -> float {
    row = i % 5
    if i < STREET { return (0.0 - 4.0) + (row as float) * 2.0 }
    if row == 0 { return 26.0 }
    if row == 1 { return 30.0 }
    if row == 2 { return 34.0 }
    if row == 3 { return 0.0 - 28.0 }
    return 0.0 - 32.0
}

at_x(i: int, t: float) -> float { return spot_x(i) + 0.8 * cos(t + (i as float)) }
at_z(i: int, t: float) -> float { return spot_z(i) + 0.8 * sin(t + (i as float)) }

struct Side {
    world: *Engine
    session: *Net
    things: ptr                      // *GameObject[OBJECTS]
}

make_player(context: ptr, client: int) -> *CharacterController {
    s = context as *Side
    o = engine.object(s.world, "Player ${client}", null)
    z = 0.0
    if client == 1 { z = 0.0 - 1.5 }
    if client == 2 { z = 1.5 }
    behaviour.object_set_position(o, core.vec3(0.0, 0.0, z))
    return physics.character_controller(o, 0.3, 1.8)
}

// The street: the ground, and on the host the buildings either side of
// the road, 12 m tall, their yards behind them.
side_new(session: *Net, buildings: bool) -> *Side {
    s = calloc(1, sizeof(Side)) as *Side
    s.world = engine.engine_new()
    physics.attach(s.world)
    ground = engine.object(s.world, "Ground", null)
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(200.0, 0.5, 60.0), physics.material(0.8, 0.0))
    if buildings {
        k = 0
        while k < BLOCKS {
            x = (0.0 - 150.0) + (k as float) * 24.0 + 10.0
            north = engine.object(s.world, "Building", null)
            behaviour.object_set_position(north, core.vec3(x, 6.0, 14.5))
            physics.box_collider(north, core.vec3(10.0, 6.0, 7.5), physics.material(0.8, 0.0))
            south = engine.object(s.world, "Building", null)
            behaviour.object_set_position(south, core.vec3(x, 6.0, 0.0 - 14.5))
            physics.box_collider(south, core.vec3(10.0, 6.0, 7.5), physics.material(0.8, 0.0))
            k = k + 1
        }
    }
    s.session = session
    s.things = calloc(OBJECTS, 8)
    i = 0
    while i < OBJECTS {
        o = behaviour.object_new("thing")
        behaviour.object_set_position(o, core.vec3(at_x(i, 0.0), 0.5, at_z(i, 0.0)))
        net.networked(session, o)
        (s.things as ptr[])[i] = o as ptr
        i = i + 1
    }
    net.set_player_maker(session, make_player, s as ptr)
    return s
}

side_free(s: *Side) {
    c = 0
    while c <= 2 {
        pl = net.player_of(s.session, c)
        if pl != null { physics.character_free(pl.controller) }
        c = c + 1
    }
    net.net_free(s.session)
    i = 0
    while i < OBJECTS {
        behaviour.object_free((s.things as ptr[])[i] as *GameObject)
        i = i + 1
    }
    free(s.things)
    engine.engine_free(s.world)
    free(s as ptr)
}

// What one run measured, for each client.
struct SightRun {
    seen_wait: ptr                   // int[3]: the most ticks in a row an object waited seen, by client
    hidden_wait: ptr                 // occluded
    out_wait: ptr                    // out of view
    unsent: int                      // objects never sent to a client over the run
    seen_share: float                // client 1: of the record bytes, the share on what it could see (settled, before the turn)
    turned: int                      // objects newly in client 1's view at its turn
    turn_wait: int                   // the most ticks one of them waited from the first tick judged by the new view
    turn_tick: int
    rays: float                      // rays a tick, both clients
    step_ms: float                   // the host's step, a tick's worth, milliseconds
    largest: int
}

run(sighted: bool) -> *SightRun {
    result = calloc(1, sizeof(SightRun)) as *SightRun
    result.seen_wait = calloc(3, 4)
    result.hidden_wait = calloc(3, 4)
    result.out_wait = calloc(3, 4)
    result.turn_wait = 0 - 1
    hub = net.hub_new()
    net.hub_set_conditions(hub, 0.05, 0.01, 0.02)
    host = side_new(net.host_loopback(hub), true)
    net.set_budget(host.session, BUDGET)
    net.set_occluders(host.session, physics.of(host.world))
    net.set_visibility(host.session, sighted)
    one = side_new(net.join_loopback(hub), false)
    two = side_new(net.join_loopback(hub), false)
    // The test's own measure: a streak an object and client, the ticks in
    // a row it has waited unsent in the sight it has; and client 1's
    // sights the tick before.
    streak = calloc(3 * OBJECTS, 4)
    streak_sight = calloc(3 * OBJECTS, 4)
    before = calloc(OBJECTS, 4)
    newly = calloc(OBJECTS, 4)
    last_tick = 0
    turn_from = 0
    rays_from = 0 as long
    rays_ticks = 0
    step_seconds = 0.0
    step_ticks = 0
    bytes_from_seen = 0 as long
    bytes_from_hidden = 0 as long
    bytes_to_seen = 0 as long
    bytes_to_hidden = 0 as long
    pre_turn_view = 0
    step = 0
    while step < STEPS {
        now = (step as float) * STEP
        i = 0
        while i < OBJECTS {
            o = (host.things as ptr[])[i] as *GameObject
            behaviour.object_set_position(o, core.vec3(at_x(i, now), 0.5, at_z(i, now)))
            i = i + 1
        }
        // Each client's view from its eye: client 1 along +x until it
        // turns round, client 2 along -x.
        look_one = 1.0
        if now >= TURN_AT { look_one = 0.0 - 1.0 }
        net.set_view(one.session, core.vec3(0.0, 1.7, 0.0 - 1.5), core.vec3(look_one, 0.0 - 0.05, 0.0), FOV, ASPECT)
        net.set_view(two.session, core.vec3(0.0, 1.7, 1.5), core.vec3(0.0 - 1.0, 0.0 - 0.05, 0.0), FOV, ASPECT)
        if net.my_player(one.session) != null { net.player_input(one.session, core.vec3(0.0, 0.0, 0.0), 0.0, now) }
        if net.my_player(two.session) != null { net.player_input(two.session, core.vec3(0.0, 0.0, 0.0), 0.0, now) }
        started = platform.time()
        net.step(host.session, now)
        spent = platform.time() - started
        net.step(one.session, now)
        net.step(two.session, now)
        tick = net.host_tick(host.session)
        if tick != last_tick {
            last_tick = tick
            if now >= SETTLE {
                step_seconds = step_seconds + spent
                step_ticks = step_ticks + 1
            }
            if now >= SETTLE && now < TURN_AT {
                if rays_ticks == 0 {
                    rays_from = net.rays_cast(host.session, 1) + net.rays_cast(host.session, 2)
                    bytes_from_seen = net.view_bytes(host.session, 1)
                    bytes_from_hidden = net.hidden_bytes(host.session, 1)
                }
                rays_ticks = rays_ticks + 1
                bytes_to_seen = net.view_bytes(host.session, 1)
                bytes_to_hidden = net.hidden_bytes(host.session, 1)
                pre_turn_view = net.view_tick(host.session, 1)
            }
            c = 1
            while c <= 2 {
                i = 0
                while i < OBJECTS {
                    id = i + 1
                    at = c * OBJECTS + i
                    looks = net.sight(host.session, c, id)
                    if net.last_sent(host.session, c, id) == tick {
                        (streak as int[])[at] = 0
                    } else {
                        if (streak_sight as int[])[at] != looks { (streak as int[])[at] = 0 }
                        (streak as int[])[at] = (streak as int[])[at] + 1
                        // Measured once settled, and before the turn: the
                        // turn is measured apart.
                        if now >= SETTLE && now < TURN_AT {
                            w = (streak as int[])[at]
                            if looks == net.SIGHT_SEEN && w > (result.seen_wait as int[])[c] { (result.seen_wait as int[])[c] = w }
                            if looks == net.SIGHT_HIDDEN && w > (result.hidden_wait as int[])[c] { (result.hidden_wait as int[])[c] = w }
                            if looks == net.SIGHT_OUT && w > (result.out_wait as int[])[c] { (result.out_wait as int[])[c] = w }
                        }
                    }
                    (streak_sight as int[])[at] = looks
                    i = i + 1
                }
                c = c + 1
            }
            // The turn: the first tick judged by client 1's new view, and
            // every object it made newly seen, until each has been sent.
            if now >= TURN_AT && turn_from == 0 && net.view_tick(host.session, 1) != pre_turn_view && tick >= net.view_tick(host.session, 1) {
                turn_from = net.view_tick(host.session, 1)
                result.turn_tick = turn_from
                i = 0
                while i < OBJECTS {
                    if net.sight(host.session, 1, i + 1) == net.SIGHT_SEEN && (before as int[])[i] == net.SIGHT_OUT {
                        (newly as int[])[i] = 1
                        result.turned = result.turned + 1
                    }
                    i = i + 1
                }
            }
            if turn_from > 0 {
                i = 0
                while i < OBJECTS {
                    if (newly as int[])[i] == 1 && net.last_sent(host.session, 1, i + 1) >= turn_from {
                        (newly as int[])[i] = 2
                        waited = net.last_sent(host.session, 1, i + 1) - turn_from
                        if waited > result.turn_wait { result.turn_wait = waited }
                    }
                    i = i + 1
                }
            }
            i = 0
            while i < OBJECTS {
                (before as int[])[i] = net.sight(host.session, 1, i + 1)
                i = i + 1
            }
        }
        step = step + 1
    }
    // Any newly seen object never sent after the turn waited past the run.
    i = 0
    while i < OBJECTS {
        if (newly as int[])[i] == 1 { result.turn_wait = 999 }
        c = 1
        while c <= 2 {
            if net.last_sent(host.session, c, i + 1) == 0 { result.unsent = result.unsent + 1 }
            c = c + 1
        }
        i = i + 1
    }
    seen = bytes_to_seen - bytes_from_seen
    hidden = bytes_to_hidden - bytes_from_hidden
    if seen + hidden > (0 as long) { result.seen_share = (seen as float) / ((seen + hidden) as float) }
    if rays_ticks > 0 {
        rays_to = net.rays_cast(host.session, 1) + net.rays_cast(host.session, 2)
        result.rays = ((rays_to - rays_from) as float) / (rays_ticks as float)
    }
    if step_ticks > 0 { result.step_ms = step_seconds / (step_ticks as float) * 1000.0 }
    result.largest = net.largest_snapshot(host.session, 1)
    if net.largest_snapshot(host.session, 2) > result.largest { result.largest = net.largest_snapshot(host.session, 2) }
    free(streak)
    free(streak_sight)
    free(before)
    free(newly)
    side_free(one)
    side_free(two)
    side_free(host)
    net.hub_free(hub)
    return result
}

run_free(r: *SightRun) {
    free(r.seen_wait)
    free(r.hidden_wait)
    free(r.out_wait)
    free(r as ptr)
}

main() {
    println("sight: 500 objects in a street of buildings, a host and two clients looking opposite ways along it, a budget of ${BUDGET} bytes a snapshot, 50 ms, 10 ms of jitter, 2% lost")
    seeing = run(true)
    distance = run(false)
    c = 1
    while c <= 2 {
        println("  client ${c}, by sight: an object seen waited at most ${(seeing.seen_wait as int[])[c]} tick(s), occluded ${(seeing.hidden_wait as int[])[c]}, out of view ${(seeing.out_wait as int[])[c]}; by distance alone ${(distance.seen_wait as int[])[c]}, ${(distance.hidden_wait as int[])[c]} and ${(distance.out_wait as int[])[c]}")
        c = c + 1
    }
    check("an object a client can see waits at most a tick", (seeing.seen_wait as int[])[1] <= 1 && (seeing.seen_wait as int[])[2] <= 1)
    worst_hidden = (seeing.hidden_wait as int[])[1]
    if (seeing.hidden_wait as int[])[2] > worst_hidden { worst_hidden = (seeing.hidden_wait as int[])[2] }
    worst_out = (seeing.out_wait as int[])[1]
    if (seeing.out_wait as int[])[2] > worst_out { worst_out = (seeing.out_wait as int[])[2] }
    println("  N: an occluded object waited at most ${worst_hidden} ticks (${(worst_hidden as float) / 30.0} s), one out of view ${worst_out}; unsent over the run: ${seeing.unsent}")
    check("one it cannot see waits longer, a second and a half (45 ticks) at most, and none is left unsent",
          worst_hidden > 1 && worst_hidden <= 46 && worst_out > 1 && worst_out <= 46 && seeing.unsent == 0)
    println("  client 1 turned round: ${seeing.turned} objects newly in its view at tick ${seeing.turn_tick}, the last of them sent ${seeing.turn_wait} tick(s) after it")
    check("a client that turns round has every object newly in view within 2 ticks", seeing.turned > 50 && seeing.turn_wait >= 0 && seeing.turn_wait <= 2)
    println("  the bytes on what client 1 could see: ${seeing.seen_share * 100.0}% by sight, ${distance.seen_share * 100.0}% by distance alone; the largest snapshot ${seeing.largest} and ${distance.largest} bytes")
    check("at the same budget, sight spends most of the bytes on what is seen, and more than distance alone does",
          seeing.seen_share > 0.5 && seeing.seen_share > distance.seen_share * 2.0 && seeing.largest <= BUDGET && distance.largest <= BUDGET)
    check("by distance alone, what is seen waits longer", (distance.seen_wait as int[])[1] > 1)
    println("  the host's cost: ${seeing.rays} rays a tick for two clients; its step ${seeing.step_ms} ms a tick by sight, ${distance.step_ms} by distance alone")
    run_free(seeing)
    run_free(distance)
    check("every session made is let go", net.alive() == 0)
    if g_failures == 0 {
        println("sight: all checks passed (${g_checks})")
    } else {
        println("sight: ${g_failures} failure(s) of ${g_checks}")
    }
}
