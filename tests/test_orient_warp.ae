// The gaits' orientation warp (#987): UE5's Animation Warping pair, stride
// and orientation, the second half. A figure running on a curve faces a
// little off the way it goes (its facing trails the turn); its run blend
// weighs its takes by their angles and travels less off its facing than
// the figure does, and its planted feet stay behind as the body goes on
// sideways over them. ikrig turns each foot about the hips by the angle
// between the blend's own travel and the figure's (animator.orient_step).
//
// The UE5 mannequin on 100STYLE's neutral gaits, running at 1.55 m/s (the
// run's slow end, its stance long) on a curve turning 16 degrees a second,
// as the people plaza's runners do, metered from its third second for six;
// the same run again with the warp off (animator.orient_warp):
//   - no foot past the hips' middle (with the warp off, 2 mm, the plaza's);
//   - no toe skating 5 mm;
//   - no joint turning faster than the same run with the warp off.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const SPEED = 1.55
const TURN = 0.2793                  // radians a second: 16 degrees
const SETTLE = 180                   // steps before it is metered
const METERED = 360                  // steps it is metered over

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The run on the curve, the warp `on` or off: the worst a foot came past the
// hips' middle (metres, below 0 never), the worst a toe skated, and the
// fastest joint turn drawn.
run_curve(g: *character.Gaits, on: bool) -> (float, float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    c = character.humanoid(e, "Runner", MANNEQUIN, g)
    if c == null {
        println("  no runner: ${character.error()}")
        exit(1)
    }
    a = character.animator_of(c)
    animator.orient_warp(a, on)
    o = character.object_of(c)
    m = metrics.meter_new(animator.rig(a), o)
    metrics.meter_animator(m, a)
    still = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < SETTLE + METERED {
        way = (k as float) * STEP * TURN
        asked = still
        if k >= 30 { asked = core.vec3(core.sin_of(way) * SPEED, 0.0, core.cos_of(way) * SPEED) }
        character.move(c, asked, still)
        engine.engine_update(e, STEP)
        if k == SETTLE { metrics.meter_reset(m) }
        if k > SETTLE { metrics.meter_take(m, STEP) }
        k = k + 1
    }
    crossed = metrics.meter_worst(m, metrics.FEET_CROSS)
    skate = metrics.meter_worst(m, metrics.SKATE)
    fastest = metrics.meter_worst(m, metrics.POP)
    metrics.meter_free(m)
    character.character_free(c)
    figure.figures_free(e)
    engine.engine_free(e)
    return crossed, skate, fastest
}

main() {
    println("orient_warp: a run on a curve, its feet turned to the way it goes (#987)")
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    crossed, skate, fastest = run_curve(g, true)
    crossed_off, skate_off, fastest_off = run_curve(g, false)
    println("  warped: a foot ${crossed * 1000.0} mm past the hips' middle at worst, a toe skating ${skate * 1000.0} mm, the fastest joint ${fastest} rad/s")
    println("  not warped: ${crossed_off * 1000.0} mm, ${skate_off * 1000.0} mm, ${fastest_off} rad/s")
    check("no foot past the hips' middle", crossed <= 0.0)
    check("no toe skating 5 mm", skate < 0.005)
    check("no joint turning faster than the same run not warped", fastest <= fastest_off)
    character.gaits_free(g)
    if g_failures == 0 {
        println("orient_warp: all checks passed (${g_checks})")
        return
    }
    println("orient_warp: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
