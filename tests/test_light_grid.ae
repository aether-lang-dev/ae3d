// The clusters' lists, held to what they promise (#468): every light whose
// reach covers a point is listed in the cell that point falls in, from any
// camera, and the lists are not the whole scene. No window: the grid is the
// CPU's.
//
//   - a street of 256 lamps, a camera in it: 20,000 points spread through
//     the view, each against every lamp by brute force -- a lamp that
//     reaches a point and is missing from its cell is a lamp the pixel
//     would not see, and there must be none;
//   - the same from a second camera across the street, looking the other
//     way: the lists move with the view, the lamps' reach does not;
//   - a cell lists little more than the lamps that do reach its points:
//     the lists are tight;
//   - the reach: a lamp made with range R reaches where its attenuation
//     has fallen to 1/64, the fall-off the shader used to cut at;
//   - what a build costs, for 64, 256 and 1024 lamps.
import std.list
import std.os
import ae3d.core
import ae3d.lightgrid

extern sqrt(x: float) -> float

const SURVEY_POINTS = 20000

var g_checks = 0
var g_failures = 0
var g_seed: long = 12345

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// A fixed sequence, so a failure repeats.
rand01() -> float {
    g_seed = (g_seed * 1103515245 + 12345) % 2147483648
    return (g_seed as float) / 2147483648.0
}

// A street of lamps: two rows along x, a lamp every `spacing` metres, each
// at 4.25 m with the range the street scenes give theirs.
street(count: int, spacing: float) -> ptr {
    lamps = list.new()
    i = 0
    while i < count {
        side = 0.0 - 5.0
        if i % 2 == 1 { side = 5.0 }
        x = ((i / 2) as float) * spacing - (count as float) * spacing * 0.25
        l = core.light_point(core.vec3(x, 4.25, side), core.vec3(1.0, 0.74, 0.42), 1.8, 7.0)
        list.add_raw(lamps, l as ptr)
        i = i + 1
    }
    return lamps
}

free_lamps(lamps: ptr) {
    i = 0
    while i < list.size(lamps) {
        core.light_free(list.get_raw(lamps, i) as *Light)
        i = i + 1
    }
    list.free(lamps)
}

// Points through the view: a random place on the screen at a random depth,
// log-spread like the slices, back into the world.
// The misses (a lamp reaching a point but not listed in its cell), and the
// listed lamps summed over the points, into `out` [misses, listed, reaching].
survey(g: *LightGrid, cam: *Camera, lamps: ptr, out: ptr) {
    inverse = core.mat4_inverse(core.camera_view_projection(cam))
    words = lightgrid.word_data(g) as f32[]
    result = out as int[]
    result[0] = 0
    result[1] = 0
    result[2] = 0
    k = 0
    while k < SURVEY_POINTS {
        nx = rand01() * 2.0 - 1.0
        ny = rand01() * 2.0 - 1.0
        // The depth buffer's value for a view depth d, so the point lands
        // at that depth once unprojected.
        d = cam.near * exp_ratio(cam.far / cam.near, rand01())
        p = cam.projection
        nz = (0.0 - p.m10 * d + p.m14) / d
        clip = core.mat4_mul_v4(inverse, Vec4 { x: nx, y: ny, z: nz, w: 1.0 })
        world = core.vec3(clip.x / clip.w, clip.y / clip.w, clip.z / clip.w)
        cell = lightgrid.cell_of(g, world)
        first = words[cell * 2] as int
        count = words[cell * 2 + 1] as int
        result[1] = result[1] + count
        // The lamps are clustered in list order, so a lamp's index is its
        // place in the list.
        i = 0
        while i < list.size(lamps) {
            l = list.get_raw(lamps, i) as *Light
            gap = core.v3_len(core.v3_sub(world, l.position))
            if gap < lightgrid.reach(l, 1000000.0) {
                result[2] = result[2] + 1
                listed = false
                j = 0
                while j < count {
                    if (words[first + j] as int) == i { listed = true }
                    j = j + 1
                }
                if !listed { result[0] = result[0] + 1 }
            }
            i = i + 1
        }
        k = k + 1
    }
}

extern exp(x: float) -> float
extern log(x: float) -> float

exp_ratio(ratio: float, t: float) -> float { return exp(log(ratio) * t) }

camera_at(position: Vec3, target: Vec3) -> *Camera {
    cam = core.camera_new(1920, 1080)
    core.camera_set_near(cam, 0.1)
    core.camera_set_far(cam, 400.0)
    core.camera_set_position(cam, position)
    core.camera_look_at(cam, target)
    return cam
}

main() {
    // The reach, against its definition.
    lamp = core.light_point(core.vec3(0.0, 0.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0, 7.0)
    r = lightgrid.reach(lamp, 1000.0)
    at_reach = 1.0 / (lamp.constant_atten + lamp.linear_atten * r + lamp.quadratic_atten * r * r)
    println("  a lamp of range 7 m reaches ${r} m, where its attenuation is ${at_reach}")
    check("the reach is where the attenuation falls to 1/64", at_reach > 0.0156 && at_reach < 0.0157)
    core.light_free(lamp)

    lamps = street(256, 4.0)
    g = lightgrid.grid_new()
    cam = camera_at(core.vec3(0.0, 1.7, 0.0), core.vec3(30.0, 1.5, 0.0))
    lightgrid.build(g, lamps, null, cam)
    out_block = calloc(3, 8)
    survey(g, cam, lamps, out_block)
    result = out_block as int[]
    cells = lightgrid.cell_count(g)
    println("  down the street: ${SURVEY_POINTS} points, ${result[2]} lamp-point pairs in reach, ${result[0]} missing from their cells; ${lightgrid.word_count(g) - cells * 2} listings over ${cells} cells")
    check("every lamp that reaches a point is listed in its cell", result[0] == 0)
    check("the survey met lamps in reach", result[2] > 1000)
    per_point = (result[1] as float) / (SURVEY_POINTS as float)
    reaching = (result[2] as float) / (SURVEY_POINTS as float)
    println("  a point's cell lists ${per_point} lamps on average, of 256; ${reaching} of them reach it")
    check("the lists are tight: a cell lists at most a quarter more lamps than reach its points", per_point < reaching * 1.25)

    // Across the street, looking the other way.
    cam2 = camera_at(core.vec3(20.0, 2.5, 3.0), core.vec3(0.0 - 40.0, 1.0, 0.0 - 4.0))
    lightgrid.build(g, lamps, null, cam2)
    survey(g, cam2, lamps, out_block)
    result = out_block as int[]
    println("  the other way: ${result[2]} pairs in reach, ${result[0]} missing")
    check("from a second camera, every reaching lamp is listed too", result[0] == 0 && result[2] > 1000)

    // The key light is not clustered, nor a directional one.
    sun = core.light_directional(core.vec3(0.3, 1.0, 0.2), core.vec3(1.0, 1.0, 1.0), 1.0)
    list.add_raw(lamps, sun as ptr)
    lightgrid.build(g, lamps, list.get_raw(lamps, 0) as *Light, cam)
    check("the key light and a directional light stay out of the clusters", lightgrid.light_count(g) == 255)
    list.remove(lamps, list.size(lamps) - 1)
    core.light_free(sun)

    // What a build costs: the fastest of twenty, each timed alone. A shared
    // machine only adds time -- another job on the core, a page fault --
    // and averaged, one stall in the twenty put 256 lamps at 2.2 ms on a
    // macOS runner where 64 took 1.2 (PR #502); the fastest is the build.
    // And held against the 64 lamps' build on the same machine, not to a
    // time: a runner slow the whole while put even the fastest of twenty
    // 256-lamp builds at 2.05 ms against a 2 ms bound (#604). Here 256
    // take 1.8 times 64's; under 3 holds the build's scaling, and 5 ms
    // anywhere is a build gone wrong.
    small_us = 0.0
    sizes_block = calloc(3, 8)
    sizes = sizes_block as int[]
    sizes[0] = 64
    sizes[1] = 256
    sizes[2] = 1024
    s = 0
    while s < 3 {
        more = street(sizes[s], 2.0)
        rounds = 20
        us = 0.0 - 1.0
        k = 0
        while k < rounds {
            started = os.now_monotonic_ns()
            lightgrid.build(g, more, null, cam)
            took = ((os.now_monotonic_ns() - started) as float) / 1000.0
            if us < 0.0 || took < us { us = took }
            k = k + 1
        }
        println("  ${sizes[s]} lamps: a build takes ${us} us, ${lightgrid.word_count(g) - cells * 2} listings")
        if sizes[s] == 64 { small_us = us }
        if sizes[s] == 256 {
            println("  256 lamps take ${us / small_us} times 64's")
            check("a build of 256 lamps takes under 3 times one of 64, and under 5 ms", us < 3.0 * small_us && us < 5000.0)
        }
        free_lamps(more)
        s = s + 1
    }

    free(sizes_block)
    free(out_block)
    lightgrid.grid_free(g)
    core.camera_free(cam)
    core.camera_free(cam2)
    free_lamps(lamps)

    if g_failures == 0 {
        println("light grid: all checks passed (${g_checks})")
        return
    }
    println("light grid: ${g_failures} failure(s) of ${g_checks}")
}

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
