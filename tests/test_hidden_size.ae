// A window that is not shown draws at the size it was asked for. On a
// display that scales (a Retina Mac's two pixels a point), a hidden run
// asked for 1280x720 drew and wrote 2560x1440: four times the pixels a
// scripted shot or a CI frame meant to pay for, and AE3D_WIDTH and
// AE3D_HEIGHT changed nothing. Run hidden, on both renderers; SKIP where no
// window opens.

import std.os
import ae3d.core
import ae3d.engine
import ae3d.platform

const WIDTH = 320
const HEIGHT = 240

extern exit(code: int)

var g_checks = 0
var g_failures = 0
var g_fb_w = 0
var g_fb_h = 0
var g_engine_w = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

on_update(state: ptr, e: *Engine, delta: float) {
    if engine.engine_frame_count(e) == 2 {
        g_fb_w = platform.window_fb_width(engine.engine_window(e))
        g_fb_h = platform.window_fb_height(engine.engine_window(e))
        g_engine_w = e.width
    }
}

run(api: int, name: string) {
    g_fb_w = 0
    g_fb_h = 0
    g_engine_w = 0
    e = engine.engine_new_with(api)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_frame_limit(e, 4)
    b = engine.behaviour_new("size", null)
    b.update = on_update
    engine.engine_add_behaviour(e, b)
    if !engine.engine_run(e) {
        println("  ${name}: SKIP no window available")
        engine.engine_free(e)
        return
    }
    check("${name}: a hidden window asked for ${WIDTH}x${HEIGHT} draws ${g_fb_w}x${g_fb_h}", g_fb_w == WIDTH && g_fb_h == HEIGHT)
    check("${name}: and the engine's frame is that size (${g_engine_w})", g_engine_w == WIDTH)
    engine.engine_free(e)
}

main() {
    println("hidden_size: a hidden window draws at the size asked")
    os.setenv("AE3D_HIDDEN", "1")
    os.setenv("AE3D_WIDTH", "")
    os.setenv("AE3D_HEIGHT", "")
    run(platform.API_GL, "opengl")
    run(platform.API_VULKAN, "vulkan")
    if g_failures == 0 {
        println("hidden_size: all checks passed (${g_checks})")
    } else {
        println("hidden_size: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
