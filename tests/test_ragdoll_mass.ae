// A ragdoll weighing what the person it stands for weighs (#626), held to
// numbers. physics.ragdoll_set_mass gives each bone its share of a total
// (ragdoll_segment_share, de Leva's segment table), the shapes keeping their
// shape. No window: the engine is stepped by hand.
//
//   - the reference human, as physics.ragdoll makes it, weighs 110 to 140 kg
//     (138.5 here), 1.5 to 1.8 times a person;
//   - set to 75 kg it weighs 75, each bone its share, and the shares sum
//     to 1;
//   - person_mass gives a 1.75 m person 70.4 kg (a body-mass index of 23);
//   - a 400 N s shove in the air moves the whole body by 400 over its mass:
//     5.3 m/s at 75 kg against 2.9 as made;
//   - the box man (tests/fixtures/gltf/humanoid.glb) set to 75 kg and
//     POWERED stands three seconds upright, its muscle and assist still
//     those tuned against the heavy reference (the retune is #626's next
//     step).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.motion
import ae3d.figure
import aephysics.human
import aephysics.dynamics

extern exit(code: int)

const STEP = 0.016666666666666666
const MAN = "tests/fixtures/gltf/humanoid.glb"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// The whole body's velocity: its momentum over its mass.
body_velocity(r: *Ragdoll) -> Vec3 {
    p = core.vec3(0.0, 0.0, 0.0)
    m = 0.0
    i = 0
    while i < human.BONE_COUNT {
        id = human.bone_at(&r.human, i).body_id
        bm = dynamics.body_get_mass(id)
        p = core.v3_add(p, core.v3_mul(dynamics.body_get_linear_velocity(id), bm))
        m = m + bm
        i = i + 1
    }
    return core.v3_mul(p, 1.0 / m)
}

// A shove of `blow` N s along x at the pelvis of a ragdoll hanging in the
// air (no ground under it), weighing `kg` (0 for as made): the whole body's
// speed along x a step later.
shoved(kg: float, blow: float) -> float {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    r = physics.ragdoll(e, "Shoved", core.vec3(0.0, 20.0, 0.0), 8.0, 8.0, 1.0)
    if kg > 0.0 { physics.ragdoll_set_mass(r, kg) }
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS).body_id
    dynamics.body_apply_linear_impulse_to_center(pelvis, core.vec3(blow, 0.0, 0.0), true)
    engine.engine_update(e, STEP)
    v = body_velocity(r)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    return v.x
}

main() {
    println("ragdoll mass: a ragdoll weighing what its person weighs (#626)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    r = physics.ragdoll(e, "Person", core.vec3(0.0, 0.02, 0.0), 8.0, 8.0, 1.0)
    made = physics.ragdoll_mass(r)
    physics.ragdoll_set_mass(r, 75.0)
    set = physics.ragdoll_mass(r)
    worst = 0.0
    shares = 0.0
    i = 0
    while i < human.BONE_COUNT {
        want = 75.0 * physics.ragdoll_segment_share(i)
        off = abs_of(dynamics.body_get_mass(human.bone_at(&r.human, i).body_id) - want)
        if off > worst { worst = off }
        shares = shares + physics.ragdoll_segment_share(i)
        i = i + 1
    }
    println("  as made ${made} kg; set to 75, ${set} kg, each bone within ${worst} kg of its share; the shares sum to ${shares}")
    check("the reference human as made weighs 1.5 to 1.8 times a person (110 to 140 kg)", made > 110.0 && made < 140.0)
    check("set to 75 kg it weighs 75, each bone its share (within 1 g)", abs_of(set - 75.0) < 0.001 && worst < 0.001)
    check("the shares sum to 1", abs_of(shares - 1.0) < 0.0001)
    check("a 1.75 m person weighs 70.4 kg (a body-mass index of 23)", abs_of(physics.person_mass(1.75) - 70.4375) < 0.0001)

    engine.engine_free(e)

    // The box man stood POWERED at a person's weight, three seconds: an
    // active ragdoll needs a rig to wear (motion.on_figure dresses it).
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    man = figure.figure(e, "Man", MAN)
    m = motion.on_figure(e, man)
    if m == null {
        println("ragdoll mass: SKIP ${MAN} would not load")
        engine.engine_free(e)
        return
    }
    physics.ragdoll_set_mass(m.ragdoll, 75.0)
    motion.set_mode(m, motion.POWERED)
    worst_tilt = 0.0
    k = 0
    while k < 180 {
        engine.engine_update(e, STEP)
        if k > 30 && motion.tilt(m) > worst_tilt { worst_tilt = motion.tilt(m) }
        k = k + 1
    }
    pelvis_y = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS)).y
    println("  POWERED at 75 kg for 3 s: leaning ${worst_tilt} rad at most, the pelvis ${pelvis_y} m up")
    check("at 75 kg, POWERED, it stands three seconds upright (under 0.1 rad, the pelvis over 0.8 m)", worst_tilt < 0.1 && pelvis_y > 0.8)
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)

    // The same shove on each weight, in the air.
    heavy = shoved(0.0, 400.0)
    light = shoved(75.0, 400.0)
    println("  400 N s in the air: ${heavy} m/s as made, ${light} m/s at 75 kg (400 / 75 = ${400.0 / 75.0})")
    check("a 400 N s shove moves the 75 kg body at 400 / 75 m/s (within 1%)", abs_of(light - 400.0 / 75.0) < 0.01 * 400.0 / 75.0)
    check("and the body as made at 400 over its own mass", abs_of(heavy - 400.0 / made) < 0.01 * 400.0 / made)

    if g_failures == 0 {
        println("ragdoll mass: all checks passed (${g_checks})")
    } else {
        println("ragdoll mass: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
}
