// Instance streams that change between frames, drawn through OpenGL and
// Vulkan and held to the same picture.
//
// zombie_city's blocks are instanced models added with no instances and
// filled as the camera walks: the count goes up and down, the instances
// move, each has a colour. On OpenGL they drew as triangles stretched
// across the frame: an instanced model added empty went through the shared
// geometry cache, so when its instances came it drew them through a vertex
// array with no instance stream of its own. On both backends an instanced
// model with no instances drew as its mesh, once, where it stood -- merged
// into a batch on OpenGL, given the draw's identity instance on Vulkan.
//
// So, on each backend, the same frames of the same scene:
//
//   - a row of blocks, one instanced model with a colour per instance, added
//     with none; then three, then five moved elsewhere and recoloured, then
//     two, then five again with nothing set but the count, then none;
//   - a row of grains, an instanced model of points, added with two and
//     raised to four -- a point is 32 bytes of the stream, not a matrix's 64;
//   - two plain cubes of the same mesh above them, a batch of their own.
//
// Each frame, every place a block, a grain or a cube can stand is read and
// named by its colour -- black, red, green, blue, yellow, cyan, magenta,
// white -- and must be what the frame put there; the origin, where the
// empty model stands, must stay black. Then the two backends' frames are
// the same, place by place and in how much of them is lit.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader

const WIDTH = 256
const HEIGHT = 144
const CAPACITY = 8
const FRAMES = 6
// Six places for blocks, four for grains, two cubes and the origin.
const PLACES = 13
const BLOCK_Y = 0.0
const GRAIN_Y = 0.0 - 10.0
const CUBE_Y = 10.0
const CAMERA_Z = 46.0

const BLACK = 0
const BLUE = 1
const GREEN = 2
const CYAN = 3
const RED = 4
const MAGENTA = 5
const YELLOW = 6
const WHITE = 7
// Lit, and no colour of the eight: a stream read from the wrong bytes.
const MUDDY = 8

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// The frame just drawn. OpenGL's backend reads its frame back pipelined,
// a frame behind -- what a viewport wants, not a test that draws one frame
// and reads it -- so the OpenGL target is read directly.
var g_gl_target: ptr = null

drawn_frame(backend: *Backend) -> ptr {
    if g_gl_target != null { return offscreen.target_pixels(g_gl_target) }
    return core.backend_frame_pixels(backend)
}

channel(pixels: ptr, index: int) -> int {
    return mem.get_byte(pixels, index)
}

colour_name(c: int) -> string {
    if c == BLACK { return "black" }
    if c == BLUE { return "blue" }
    if c == GREEN { return "green" }
    if c == CYAN { return "cyan" }
    if c == RED { return "red" }
    if c == MAGENTA { return "magenta" }
    if c == YELLOW { return "yellow" }
    if c == WHITE { return "white" }
    return "muddy"
}

// Where a place is in the world: 0-5 the blocks' row, 6-9 the grains',
// 10-11 the two cubes, 12 the origin.
place_at(place: int) -> Vec3 {
    if place < 6 {
        x = 0.0
        if place == 0 { x = 0.0 - 27.0 }
        if place == 1 { x = 0.0 - 18.0 }
        if place == 2 { x = 0.0 - 9.0 }
        if place == 3 { x = 9.0 }
        if place == 4 { x = 18.0 }
        if place == 5 { x = 27.0 }
        return core.vec3(x, BLOCK_Y, 0.0)
    }
    if place < 10 {
        return core.vec3(((place - 6) as float) * 12.0 - 18.0, GRAIN_Y, 0.0)
    }
    if place == 10 { return core.vec3(0.0 - 9.0, CUBE_Y, 0.0) }
    if place == 11 { return core.vec3(9.0, CUBE_Y, 0.0) }
    return core.vec3(0.0, 0.0, 0.0)
}

// The colour a pixel is, one of the eight or muddy.
colour_at(pixels: ptr, x: int, y: int) -> int {
    at = (y * WIDTH + x) * 4
    r = channel(pixels, at)
    g = channel(pixels, at + 1)
    b = channel(pixels, at + 2)
    if r < 40 && g < 40 && b < 40 { return BLACK }
    c = 0
    if r > 150 { c = c + RED }
    if g > 150 { c = c + GREEN }
    if b > 150 { c = c + BLUE }
    // Each channel is on or off: one in between is not a colour of ours.
    if (r >= 40 && r <= 150) || (g >= 40 && g <= 150) || (b >= 40 && b <= 150) { return MUDDY }
    if c == 0 { return MUDDY }
    return c
}

// What each place holds in each frame: the blocks' count, positions and
// colours as step() leaves them, the grains' count, the cubes always.
expected(frame: int, place: int) -> int {
    if place == 10 || place == 11 { return WHITE }
    if place == 12 { return BLACK }
    if place >= 6 {
        grain = place - 6
        if grain < 2 || frame >= 3 { return grain_colour(grain) }
        return BLACK
    }
    if frame == 1 {
        if place == 0 { return RED }
        if place == 2 { return GREEN }
        if place == 4 { return BLUE }
    }
    if frame == 2 {
        if place == 0 { return RED }
        if place == 1 { return YELLOW }
        if place == 2 { return GREEN }
        if place == 3 { return CYAN }
        if place == 5 { return MAGENTA }
    }
    if frame == 3 {
        if place == 1 { return BLUE }
        if place == 3 { return CYAN }
    }
    if frame == 4 {
        if place == 0 { return RED }
        if place == 1 { return BLUE }
        if place == 2 { return GREEN }
        if place == 3 { return CYAN }
        if place == 5 { return MAGENTA }
    }
    return BLACK
}

grain_colour(grain: int) -> int {
    if grain == 0 { return RED }
    if grain == 1 { return GREEN }
    if grain == 2 { return BLUE }
    return YELLOW
}

set_block(blocks: *Model, index: int, place: int, colour: int) {
    core.model_set_instance_position(blocks, index, place_at(place))
    set_block_colour(blocks, index, colour)
}

set_block_colour(blocks: *Model, index: int, colour: int) {
    r = 0.0
    g = 0.0
    b = 0.0
    if colour >= RED { r = 1.0 }
    if colour % 4 >= GREEN { g = 1.0 }
    if colour % 2 == 1 { b = 1.0 }
    core.model_set_instance_color(blocks, index, r, g, b)
}

// An emissive white material: the frame is the instance colours themselves,
// whatever the light does.
bright(m: *Model) {
    core.model_matte(m, 1.0, 1.0, 1.0)
    core.model_set_exposure(m, 14.0)
}

// The scene on one backend: the blocks (empty), the grains (two of eight)
// and the two plain cubes.
build(backend: *Backend) -> {
    blocks = loader.cube(1.0)
    core.model_set_scale(blocks, 4.0, 4.0, 4.0)
    bright(blocks)
    core.model_enable_instancing(blocks, CAPACITY)
    core.model_enable_instance_colors(blocks)
    core.model_set_instance_draw_count(blocks, 0)
    core.backend_add_model(backend, blocks)

    grains = loader.cube(1.0)
    core.model_set_scale(grains, 3.0, 3.0, 3.0)
    bright(grains)
    core.model_enable_instancing(grains, CAPACITY)
    core.model_enable_point_instancing(grains)
    xyz = calloc(CAPACITY * 3, 8)
    rgb = calloc(CAPACITY * 3, 8)
    positions = xyz as float[]
    tints = rgb as float[]
    i = 0
    while i < CAPACITY {
        at = place_at(6 + (i % 4))
        positions[i * 3] = at.x
        positions[i * 3 + 1] = at.y
        positions[i * 3 + 2] = at.z
        c = grain_colour(i % 4)
        tints[i * 3] = 0.0
        tints[i * 3 + 1] = 0.0
        tints[i * 3 + 2] = 0.0
        if c >= RED { tints[i * 3] = 1.0 }
        if c % 4 >= GREEN { tints[i * 3 + 1] = 1.0 }
        if c % 2 == 1 { tints[i * 3 + 2] = 1.0 }
        i = i + 1
    }
    core.model_set_instance_positions(grains, xyz, CAPACITY)
    core.model_set_instance_colors(grains, rgb, CAPACITY)
    free(xyz)
    free(rgb)
    core.model_set_instance_draw_count(grains, 2)
    core.backend_add_model(backend, grains)

    left = loader.cube(1.0)
    core.model_set_scale(left, 4.0, 4.0, 4.0)
    core.model_set_position(left, place_at(10).x, CUBE_Y, 0.0)
    bright(left)
    core.backend_add_model(backend, left)
    right = loader.cube(1.0)
    core.model_set_scale(right, 4.0, 4.0, 4.0)
    core.model_set_position(right, place_at(11).x, CUBE_Y, 0.0)
    bright(right)
    core.backend_add_model(backend, right)
    return blocks, grains, left, right
}

// The frame's changes, made the same way on both backends.
step(blocks: *Model, grains: *Model, frame: int) {
    if frame == 1 {
        core.model_set_instance_draw_count(blocks, 3)
        set_block(blocks, 0, 0, RED)
        set_block(blocks, 1, 2, GREEN)
        set_block(blocks, 2, 4, BLUE)
    }
    if frame == 2 {
        core.model_set_instance_draw_count(blocks, 5)
        set_block(blocks, 0, 1, YELLOW)
        set_block(blocks, 1, 3, CYAN)
        set_block(blocks, 2, 5, MAGENTA)
        set_block(blocks, 3, 0, RED)
        set_block(blocks, 4, 2, GREEN)
    }
    if frame == 3 {
        // Down to two, one recoloured: the colours go out for two.
        core.model_set_instance_draw_count(blocks, 2)
        set_block_colour(blocks, 0, BLUE)
        // More grains than the stream was made for.
        core.model_set_instance_draw_count(grains, 4)
    }
    if frame == 4 {
        // Up to five, nothing set but the count: the three that come back
        // wear the colours they had.
        core.model_set_instance_draw_count(blocks, 5)
    }
    if frame == 5 {
        core.model_set_instance_draw_count(blocks, 0)
    }
    core.model_recalculate_bounds(blocks)
}

// Every frame drawn on one backend, each place's colour kept in `seen`
// (FRAMES x PLACES) and each frame's lit pixels in `lit`.
run(backend: *Backend, name: string, seen: int[], lit: int[]) {
    blocks, grains, left, right = build(backend)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, CAMERA_Z))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    frame = 0
    while frame < FRAMES {
        step(blocks, grains, frame)
        core.backend_render(backend, cam, light)
        pixels = drawn_frame(backend)
        if pixels == null {
            check("${name}: frame ${frame} reads back", false)
            frame = FRAMES
        } else {
            wrong = ""
            place = 0
            while place < PLACES {
                s = core.camera_world_to_screen(cam, place_at(place), WIDTH, HEIGHT)
                got = colour_at(pixels, s.x as int, s.y as int)
                seen[frame * PLACES + place] = got
                want = expected(frame, place)
                if got != want { wrong = "${wrong} place ${place} ${colour_name(got)} (${colour_name(want)} wanted);" }
                place = place + 1
            }
            count = 0
            i = 0
            while i < WIDTH * HEIGHT {
                if channel(pixels, i * 4) + channel(pixels, i * 4 + 1) + channel(pixels, i * 4 + 2) > 60 { count = count + 1 }
                i = i + 1
            }
            lit[frame] = count
            if wrong == "" {
                check("${name}: frame ${frame}: every place holds what the frame put there (${count} pixels lit)", true)
            } else {
                check("${name}: frame ${frame}: every place holds what the frame put there --${wrong}", false)
            }
            frame = frame + 1
        }
    }
    core.backend_remove_model(backend, blocks)
    core.backend_remove_model(backend, grains)
    core.backend_remove_model(backend, left)
    core.backend_remove_model(backend, right)
    core.model_free(blocks)
    core.model_free(grains)
    core.model_free(left)
    core.model_free(right)
    core.light_free(light)
    core.camera_free(cam)
}

main() {
    println("instance_streams: instanced models whose count, places and colours change between frames")
    gl_seen_block = calloc(FRAMES * PLACES, 4)
    vk_seen_block = calloc(FRAMES * PLACES, 4)
    gl_lit_block = calloc(FRAMES, 4)
    vk_lit_block = calloc(FRAMES, 4)
    gl_seen = gl_seen_block as int[]
    vk_seen = vk_seen_block as int[]
    gl_lit = gl_lit_block as int[]
    vk_lit = vk_lit_block as int[]
    drew_gl = false
    drew_vk = false

    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("instance_streams: no OpenGL context here; OpenGL is not drawn")
    } else {
        renderer = gl.renderer_new()
        backend = gl.backend(renderer)
        if core.backend_init(&backend, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
            g_gl_target = target
            run(&backend, "opengl", gl_seen, gl_lit)
            g_gl_target = null
            drew_gl = true
            core.backend_cleanup(&backend)
            offscreen.target_destroy(target)
        } else {
            println("instance_streams: the OpenGL backend would not start")
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }
    if vulkan.available() {
        vk_renderer = vulkan.renderer_new()
        vk_backend = vulkan.backend(vk_renderer)
        if core.backend_init(&vk_backend, null, WIDTH, HEIGHT) {
            vulkan.renderer_set_clear_color(vk_renderer, 0.0, 0.0, 0.0)
            run(&vk_backend, "vulkan", vk_seen, vk_lit)
            drew_vk = true
            core.backend_cleanup(&vk_backend)
        } else {
            println("instance_streams: Vulkan would not start (${vulkan.last_error()})")
        }
        vulkan.renderer_free(vk_renderer)
    } else {
        println("instance_streams: no Vulkan driver (${vulkan.last_error()})")
    }

    if drew_gl && drew_vk {
        frame = 0
        while frame < FRAMES {
            same = true
            place = 0
            while place < PLACES {
                if gl_seen[frame * PLACES + place] != vk_seen[frame * PLACES + place] { same = false }
                place = place + 1
            }
            spread = gl_lit[frame] - vk_lit[frame]
            if spread < 0 { spread = 0 - spread }
            check("frame ${frame}: OpenGL and Vulkan agree place by place, and lit ${gl_lit[frame]} and ${vk_lit[frame]} pixels (within 5%)",
                  same && spread * 20 <= gl_lit[frame] + 20)
            frame = frame + 1
        }
    }
    free(gl_seen_block)
    free(vk_seen_block)
    free(gl_lit_block)
    free(vk_lit_block)

    if !drew_gl && !drew_vk {
        println("instance_streams: SKIP neither backend would draw here")
    } else if g_failures == 0 {
        println("instance_streams: all checks passed (${g_checks})")
    } else {
        println("instance_streams: ${g_failures} of ${g_checks} checks FAILED")
    }
}
