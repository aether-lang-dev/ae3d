// The ground the scene stands on lights what faces down (#740), on OpenGL
// and Vulkan alike, read off each renderer's sky irradiance.
//
// Without probes' light a surface turned from the sun was lit by the sky's
// capture alone: what faces straight down saw the capture's lower half.
// With a ground set, it sees that ground lit by the sky and the sun:
//   - with blank set, the irradiance onto a downward face is what it was;
//   - with a warm desert ground it is brighter, and warm (red over blue
//     past what the sky gives it);
//   - an upward face is lit near as before (a few percent, from the
//     irradiance's texels that straddle the horizon);
//   - both renderers read alike.
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.vulkan

const WIDTH = 160
const HEIGHT = 90

var g_failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

struct Bounce {
    down_bare: Vec3
    down_ground: Vec3
    up_bare: Vec3
    up_ground: Vec3
}

near(a: float, b: float, by: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= by
}

report(name: string, b: Bounce) {
    println("  ${name}: facing down ${b.down_bare.x}, ${b.down_bare.y}, ${b.down_bare.z} with no ground; ${b.down_ground.x}, ${b.down_ground.y}, ${b.down_ground.z} over desert sand")
    println("  ${name}: facing up ${b.up_bare.x}, ${b.up_bare.y}, ${b.up_bare.z}; with the ground ${b.up_ground.x}, ${b.up_ground.y}, ${b.up_ground.z}")
    check("${name}: over sunlit ground what faces down is lit by it, brighter", b.down_ground.x > b.down_bare.x * 1.5)
    check("${name}: and warm, as the sand is (red over blue ${b.down_ground.x / b.down_ground.z} against ${b.down_bare.x / b.down_bare.z})",
          b.down_ground.x / b.down_ground.z > b.down_bare.x / b.down_bare.z + 0.3)
    // Within a few percent: the irradiance's 16 by 16 texels on the horizon
    // are part ground.
    check("${name}: what faces up is lit near as before", near(b.up_ground.x, b.up_bare.x, b.up_bare.x * 0.05) && near(b.up_ground.z, b.up_bare.z, b.up_bare.z * 0.05))
}

// Four frames each way, so the sky is captured with the ground's light,
// under a flat blue sky all round (the clear colour, with no sky set).
frames(backend: *Backend, cam: *Camera, light: *Light) {
    core.backend_set_clear_color(backend, 0.30, 0.45, 0.70)
    i = 0
    while i < 4 {
        core.backend_render(backend, cam, light)
        i = i + 1
    }
}

main() {
    println("ground bounce: the sunlit ground lights what faces down (#740)")
    sun = core.light_sun(core.vec3(0.3, 0.6, 0.2))
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 2.0, 5.0))
    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))
    down = core.vec3(0.0, 0.0 - 1.0, 0.0)
    up = core.vec3(0.0, 1.0, 0.0)
    sand = core.vec3(0.40, 0.33, 0.22)
    blank = core.vec3(0.0, 0.0, 0.0)
    gl_read = Bounce { down_bare: blank, down_ground: blank, up_bare: blank, up_ground: blank }
    gl_done = false

    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("  opengl: SKIP no OpenGL context available")
    } else {
        renderer = gl.renderer_new()
        backend = gl.backend(renderer)
        if core.backend_init(&backend, context, WIDTH, HEIGHT) {
            target = offscreen.target_create(WIDTH, HEIGHT)
            gl.renderer_set_target(renderer, target)
            frames(&backend, cam, sun)
            gl_read.down_bare = gl.renderer_sky_irradiance(renderer, down)
            gl_read.up_bare = gl.renderer_sky_irradiance(renderer, up)
            gl.renderer_set_ground_bounce(renderer, sand)
            frames(&backend, cam, sun)
            gl_read.down_ground = gl.renderer_sky_irradiance(renderer, down)
            gl_read.up_ground = gl.renderer_sky_irradiance(renderer, up)
            report("opengl", gl_read)
            gl_done = true
            offscreen.target_destroy(target)
        } else {
            println("  opengl: SKIP the backend would not initialise")
        }
        gl.renderer_free(renderer)
        offscreen.context_destroy(context)
    }

    if !vulkan.available() {
        println("  vulkan: SKIP no Vulkan driver (${vulkan.last_error()})")
    } else {
        vrenderer = vulkan.renderer_new()
        vbackend = vulkan.backend(vrenderer)
        if core.backend_init(&vbackend, null, WIDTH, HEIGHT) {
            vk_read = Bounce { down_bare: blank, down_ground: blank, up_bare: blank, up_ground: blank }
            frames(&vbackend, cam, sun)
            vk_read.down_bare = vulkan.renderer_sky_irradiance(vrenderer, down)
            vk_read.up_bare = vulkan.renderer_sky_irradiance(vrenderer, up)
            vulkan.renderer_set_ground_bounce(vrenderer, sand)
            frames(&vbackend, cam, sun)
            vk_read.down_ground = vulkan.renderer_sky_irradiance(vrenderer, down)
            vk_read.up_ground = vulkan.renderer_sky_irradiance(vrenderer, up)
            report("vulkan", vk_read)
            if gl_done {
                check("both renderers light it alike", near(gl_read.down_ground.x, vk_read.down_ground.x, gl_read.down_ground.x * 0.05) &&
                      near(gl_read.down_ground.z, vk_read.down_ground.z, gl_read.down_ground.z * 0.05))
            }
        } else {
            println("  vulkan: SKIP Vulkan would not start (${vulkan.last_error()})")
        }
        vulkan.renderer_free(vrenderer)
    }
    core.camera_free(cam)
    core.light_free(sun)
    if g_failures == 0 {
        println("ground bounce: all checks passed")
    } else {
        println("ground bounce: ${g_failures} failure(s)")
    }
}
