// A walker struck down and up again (locomotion.set_paused), held to
// numbers. The box man walked by ae3d.locomotion, its feet on the ground by
// ae3d.feet, its active ragdoll parked, as the plaza's walkers are; struck
// at the hips as the plaza's car strikes, at 21 moments of its stride (90
// to 150 steps in, every 3). Each in an engine of its own; no window.
//
//   - handed over, its clip holds the frame it is at, every time;
//   - it gets up and stands every time: played on, the walk went on
//     stepping under the ragdoll, and it went over four or five times;
//   - it goes down only once in 17 or more of the 21. Up from its back it
//     can tip as it is handed to its own balance, its feet sliding, and go
//     down again before a step starts (#684): at 4 of the 21 moments on
//     aephysics b944448, 3 now. Held at three moments, as this was, the
//     check passed or failed on which three;
//   - taken up again and asked to walk, it walks, every time.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.locomotion
import ae3d.feet
import ae3d.motion
import aephysics.human

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

bone(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

// Struck after `walked` steps: whether its clip held its frame, how many
// times it went down, whether it stood at the end, and whether it walked
// when taken up again.
trial(walked: int) -> (bool, int, bool, bool) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(80.0, 0.5, 80.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Walker", "tests/fixtures/gltf/humanoid.glb")
    fig = figure.figure_of(o)
    c = physics.character_controller(o, 0.3, 1.8)
    l = locomotion.attach(e, o, c, "Idle", "Walk", "Run")
    sk = figure.skeleton(fig)
    f = feet.attach(e, o.model as *Model, bone(sk, "mixamorig:Hips"),
                    bone(sk, "mixamorig:LeftUpLeg"), bone(sk, "mixamorig:LeftLeg"), bone(sk, "mixamorig:LeftFoot"),
                    bone(sk, "mixamorig:RightUpLeg"), bone(sk, "mixamorig:RightLeg"), bone(sk, "mixamorig:RightFoot"))
    feet.set_figure(f, fig)
    feet.ground_physics(f, physics.of(e))
    m = motion.on_figure(e, o)
    physics.ragdoll_park(m.ragdoll)
    locomotion.set_input(l, core.vec3(1.0, 0.0, 0.0), false)
    k = 0
    while k < walked {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Struck, as the plaza's car strikes.
    r = m.ragdoll
    physics.ragdoll_unpark(r)
    physics.ragdoll_to_rig(r)
    // POWERED from the pose on the screen, the feet let go after, then the
    // clip held (the plaza's order).
    motion.set_mode(m, motion.POWERED)
    feet.release(f)
    locomotion.set_paused(l, true)
    motion.set_get_up(m, 1.0)
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
    motion.hit(m, human.BONE_PELVIS, pelvis, core.vec3(315.0, 67.5, 0.0))
    held = figure.time(fig)
    falls = 0
    was = false
    k = 0
    while k < 1200 {
        engine.engine_update(e, STEP)
        now = motion.falling(m)
        if now && !was { falls = falls + 1 }
        was = now
        k = k + 1
    }
    stands = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
    println("  struck after ${walked} steps: clip at ${held} s then ${figure.time(fig)} s, went down ${falls} time(s), pelvis ${stands} m up, tilt ${motion.tilt(m)}, mode ${motion.mode(m)}")
    clip_held = figure.time(fig) == held
    stood = motion.mode(m) == motion.POWERED && stands >= 0.9 && motion.tilt(m) < 0.2
    // Taken up again, as the plaza hands a risen walker back.
    motion.set_mode(m, motion.ANIMATED)
    physics.ragdoll_park(r)
    locomotion.set_paused(l, false)
    feet.set_weight(f, 1.0)
    locomotion.set_input(l, core.vec3(1.0, 0.0, 0.0), false)
    k = 0
    while k < 60 {
        engine.engine_update(e, STEP)
        k = k + 1
    }
    walks = locomotion.clip_now(l) == 1 && figure.time(fig) != held
    locomotion.locomotion_free(l)
    feet.feet_free(f)
    // The controller is the program's, not the locomotion's or the world's.
    physics.character_free(c)
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
    figure.figures_free(e)
    motion.motion_free(m)
    return clip_held, falls, stood, walks
}

main() {
    println("struck walker: the box man walking, struck at the hips, getting up again")
    moments = 0
    held_all = 0
    stood_all = 0
    once = 0
    walked_on = 0
    walked = 90
    while walked <= 150 {
        clip_held, falls, stood, walks = trial(walked)
        moments = moments + 1
        if clip_held { held_all = held_all + 1 }
        if stood { stood_all = stood_all + 1 }
        if falls == 1 { once = once + 1 }
        if walks { walked_on = walked_on + 1 }
        walked = walked + 3
    }
    println("  of ${moments} moments: the clip held in ${held_all}, it stood up in ${stood_all}, went down only once in ${once}, walked when taken up again in ${walked_on}")
    check("handed over, its clip holds the frame it is at, every time", held_all == moments)
    check("it gets up and stands every time", stood_all == moments)
    check("it goes down only once in 17 or more of the 21 (#684)", moments == 21 && once >= 17)
    check("taken up again, it walks, every time", walked_on == moments)
    if g_failures == 0 {
        println("struck walker: all checks passed (${g_checks})")
        return
    }
    println("struck walker: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
