// ci: optimised -- twenty-one walks of the mannequin with physics, CPU work -O0 makes several times slower
// A walker struck down (#860, #861), held to numbers. The UE5 mannequin on
// 100STYLE's neutral gaits (ae3d.character), its feet on ikrig's, walking at
// 1.2 m/s, knocked down at the hips (character.knock, its bodies physanim's)
// as the plaza's car strikes, at 21 moments of its stride (90 to 150 steps
// in, every 3). Each in an engine of its own; no window.
//
//   - handed over, its graph holds the state and the frame it is at
//     (animator.pause) every time, through 5 s on the ground: played on, a
//     walk went on stepping under the ragdoll (ae3d.locomotion's
//     set_paused before the pipeline).

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.physanim
import ae3d.character

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Struck after `walked` steps: whether it was knocked, the state and time
// its graph was at then, and the most either moved over 5 s after.
trial(walked: int) -> (bool, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(80.0, 0.5, 80.0), physics.material(0.8, 0.0))
    g = character.gaits(GAITS)
    c = character.humanoid(e, "Walker", MANNEQUIN, g)
    if c == null {
        println("  no walker: ${character.error()}")
        exit(1)
    }
    o = character.object_of(c)
    a = character.animator_of(c)
    _bodied = character.physical(c)
    pa = character.physanim_of(c)
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    k = 0
    while k < walked {
        character.move(c, core.v3_mul(ahead, 1.2), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    // Struck at the hips from the side, as the plaza's car strikes.
    hips = physanim.bone_named(pa, "Hips")
    at = behaviour.object_position(physics.ragdoll_bone(physanim.ragdoll_of(pa), hips))
    side = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    impulse = core.v3_add(core.v3_mul(side, 4.5 * physanim.mass(pa)), core.vec3(0.0, 0.96 * physanim.mass(pa), 0.0))
    knocked = character.knock(c, impulse, at, false, "Hips")
    state = animator.current(a)
    held = animator.state_time(a)
    moved = 0.0
    k = 0
    while k < 300 {
        engine.engine_update(e, STEP)
        d = core.abs_of(animator.state_time(a) - held)
        if animator.current(a) != state { d = 1000.0 }
        if d > moved { moved = d }
        k = k + 1
    }
    println("  struck after ${walked} steps: knocked ${knocked}, its graph in ${animator.state_name(a, state)} at ${held} s, moved ${moved} s off it at most; down ${character.down(c)}")
    character.character_free(c)
    character.gaits_free(g)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    return knocked, moved
}

main() {
    println("struck walker: the mannequin walking, knocked down at the hips")
    moments = 0
    held_all = 0
    walked = 90
    while walked <= 150 {
        knocked, moved = trial(walked)
        moments = moments + 1
        if knocked && moved == 0.0 { held_all = held_all + 1 }
        walked = walked + 3
    }
    println("  of ${moments} moments: knocked and its graph held where it was in ${held_all}")
    check("handed over, its graph holds the state and the frame it is at, every time", held_all == moments)
    if g_failures == 0 {
        println("struck walker: all checks passed (${g_checks})")
        return
    }
    println("struck walker: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
