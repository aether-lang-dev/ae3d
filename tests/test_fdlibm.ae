// ae3d.fdlibm (#911): sin, cos, atan, atan2, acos and exp in plain
// arithmetic, the same bits on every platform, held to this platform's
// libm: within an ulp of it over a sweep of each one's range (two
// functions each within half an ulp of the truth are within an ulp of each
// other), and exact where the value is known (sin 0, cos 0, atan2 of the
// axes, acos 1 and -1, exp 0). No window.

import std.mem
import ae3d.fdlibm

extern exit(code: int)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern atan(x: float) -> float
extern atan2(y: float, x: float) -> float
extern acos(x: float) -> float
extern exp(x: float) -> float

const SAMPLES = 200000

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// How many doubles apart two finite numbers are.
ulps(a: float, b: float) -> long {
    x = mem.bits_of_float(a)
    y = mem.bits_of_float(b)
    if x < (0 as long) { x = (0 as long) - (x & (9223372036854775807 as long)) }
    if y < (0 as long) { y = (0 as long) - (y & (9223372036854775807 as long)) }
    d = x - y
    if d < (0 as long) { d = (0 as long) - d }
    return d
}

// The k-th of SAMPLES numbers spread over [lo, hi].
at(k: int, lo: float, hi: float) -> float {
    return lo + (hi - lo) * (k as float) / ((SAMPLES - 1) as float)
}

sweep(name: string, which: int, lo: float, hi: float) -> long {
    most = 0 as long
    k = 0
    while k < SAMPLES {
        x = at(k, lo, hi)
        got = 0.0
        want = 0.0
        if which == 0 {
            got = fdlibm.sin(x)
            want = sin(x)
        } else if which == 1 {
            got = fdlibm.cos(x)
            want = cos(x)
        } else if which == 2 {
            got = fdlibm.atan(x)
            want = atan(x)
        } else if which == 3 {
            y = at((k * 7919) % SAMPLES, lo, hi)
            got = fdlibm.atan2(y, x)
            want = atan2(y, x)
        } else if which == 4 {
            got = fdlibm.acos(x)
            want = acos(x)
        } else {
            got = fdlibm.exp(x)
            want = exp(x)
        }
        d = ulps(got, want)
        if d > most { most = d }
        k = k + 1
    }
    println("  ${name} over [${lo}, ${hi}]: within ${most} ulp of libm")
    return most
}

main() {
    println("fdlibm: the same transcendental functions on every platform (#911)")
    worst = 0 as long
    sweeps = [sweep("sin", 0, 0.0 - 50.0, 50.0), sweep("sin near 0", 0, 0.0 - 0.8, 0.8), sweep("cos", 1, 0.0 - 50.0, 50.0),
              sweep("atan", 2, 0.0 - 20.0, 20.0), sweep("atan2", 3, 0.0 - 5.0, 5.0), sweep("acos", 4, 0.0 - 1.0, 1.0),
              sweep("exp", 5, 0.0 - 30.0, 30.0), sweep("exp near 0", 5, 0.0 - 1.0, 1.0)]
    k = 0
    while k < 8 {
        if sweeps[k] > worst { worst = sweeps[k] }
        k = k + 1
    }
    check("every function within an ulp of this platform's libm over its sweep", worst <= (1 as long))
    exact = fdlibm.sin(0.0) == 0.0 && fdlibm.cos(0.0) == 1.0 && fdlibm.exp(0.0) == 1.0 && fdlibm.acos(1.0) == 0.0 &&
            fdlibm.acos(0.0 - 1.0) == acos(0.0 - 1.0) && fdlibm.atan2(0.0, 1.0) == 0.0 && fdlibm.atan2(1.0, 0.0) == atan2(1.0, 0.0) &&
            fdlibm.atan2(0.0, 0.0 - 1.0) == atan2(0.0, 0.0 - 1.0) && fdlibm.atan2(0.0 - 1.0, 0.0) == atan2(0.0 - 1.0, 0.0)
    check("exact where the value is known: sin 0, cos 0, exp 0, acos 1 and -1, atan2 of the axes", exact)
    if g_failures == 0 {
        println("fdlibm: all checks passed (${g_checks})")
    } else {
        println("fdlibm: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
