// on_net_spawn (#508): a component is told once its object is on the
// network, on every peer, with its transform where the session put it and
// object_remote saying which side simulates it. A host and a client in one
// process over the loopback hub (30 ms each way): an object of the scene
// marked networked on both, one the host creates mid-run, and every
// player, each carrying a component that records what it was told.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.net

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// What a component heard of its spawn.
struct Spawned {
    told: int
    remote: bool
    at: Vec3
}

spawned_new() -> ptr { return heap.new(Spawned) as ptr }
spawned_free(p: ptr) { heap.free(p as *Spawned) }

on_spawn(p: ptr, go: *GameObject) {
    s = p as *Spawned
    s.told = s.told + 1
    s.remote = behaviour.object_remote(go)
    s.at = behaviour.object_position(go)
}

var g_kind: *ComponentKind = null

struct Side {
    world: *Engine
    session: *Net
    lamp: *GameObject
    lamp_heard: *Spawned
    crate: *GameObject
    crate_heard: *Spawned
    players: ptr                   // *GameObject[2], by client id
    player_heard: ptr              // *Spawned[2]
}

heard(o: *GameObject) -> *Spawned {
    return behaviour.component_state(component.find(o, g_kind)) as *Spawned
}

make_crate(context: @keep ptr, id: int) -> *GameObject {
    s = context as *Side
    o = behaviour.object_new("crate")
    component.add(o, g_kind)
    s.crate = o
    s.crate_heard = heard(o)
    return o
}

unmake_crate(context: ptr, o: *GameObject) {
    s = context as *Side
    if s.crate == o { s.crate = null }
    behaviour.object_free(o)
}

make_player(context: @keep ptr, client: int) -> *GameObject {
    s = context as *Side
    o = engine.object(s.world, "Player ${client}", null)
    behaviour.object_set_position(o, core.vec3((client as float) * 4.0, 0.0, 0.0 - 6.0))
    c = component.add(o, g_kind)
    // Switched off before it is on the network: told all the same.
    if client == 1 { behaviour.component_set_enabled(c, false) }
    (s.players as ptr[])[client] = o as ptr
    (s.player_heard as ptr[])[client] = heard(o) as ptr
    return o
}

side_new(session: *Net) -> *Side {
    s = calloc(1, sizeof(Side)) as *Side
    s.world = engine.engine_new()
    s.session = session
    s.players = calloc(2, 8)
    s.player_heard = calloc(2, 8)
    s.lamp = behaviour.object_new("lamp")
    behaviour.object_set_position(s.lamp, core.vec3(1.0, 2.0, 3.0))
    component.add(s.lamp, g_kind)
    s.lamp_heard = heard(s.lamp)
    net.networked(session, s.lamp)
    net.object_kind(session, "crate", make_crate, unmake_crate, s as ptr)
    net.set_player_object_maker(session, make_player, s as ptr)
    return s
}

side_free(s: *Side) {
    net.net_free(s.session)
    behaviour.object_free(s.lamp)
    if s.crate != null { behaviour.object_free(s.crate) }
    engine.engine_free(s.world)
    free(s.players)
    free(s.player_heard)
    free(s as ptr)
}

player_heard(s: *Side, client: int) -> *Spawned { return (s.player_heard as ptr[])[client] as *Spawned }

main() {
    println("net spawn: on_net_spawn on every peer, once")
    g_kind = component.kind("Spawned", "Tests", spawned_new, spawned_free)
    component.set_net_spawn(g_kind, on_spawn)
    hub = net.hub_new()
    net.hub_set_conditions(hub, 0.03, 0.0, 0.0)
    host = side_new(net.host_loopback(hub))
    one = side_new(net.join_loopback(hub))
    // The host plays too: its own player, client 0.
    net.host_play(host.session, 0.0)
    check("an object of the scene marked networked is told at once, on both sides",
          host.lamp_heard.told == 1 && one.lamp_heard.told == 1)
    check("the host simulates it and the client draws it", !host.lamp_heard.remote && one.lamp_heard.remote)
    check("told where it stands (${one.lamp_heard.at.y})", one.lamp_heard.at.x == 1.0 && one.lamp_heard.at.y == 2.0 && one.lamp_heard.at.z == 3.0)

    made = false
    step = 0
    while step < 240 {
        now = (step as float) * STEP
        if !made && net.snapshot_tick(one.session) > 0 {
            net.create_object(host.session, "crate", core.vec3(0.0, 1.5, 5.0), core.quat(0.0, 0.0, 0.0, 1.0), now)
            made = true
        }
        net.step(host.session, now)
        net.step(one.session, now)
        step = step + 1
    }
    check("an object the host creates is told on the host, once, as its own", host.crate_heard != null && host.crate_heard.told == 1 && !host.crate_heard.remote)
    check("and on the client, once, as the host's", one.crate_heard != null && one.crate_heard.told == 1 && one.crate_heard.remote)
    check("placed where the host made it before it is told (${one.crate_heard.at.y})",
          one.crate_heard.at.x == 0.0 && one.crate_heard.at.y == 1.5 && one.crate_heard.at.z == 5.0)
    check("each side's lamp was told once in all", host.lamp_heard.told == 1 && one.lamp_heard.told == 1)
    check("every player is told once on each side",
          player_heard(host, 0).told == 1 && player_heard(host, 1).told == 1 && player_heard(one, 0).told == 1 && player_heard(one, 1).told == 1)
    check("each side simulates its own player and draws the other's",
          !player_heard(host, 0).remote && player_heard(host, 1).remote && player_heard(one, 0).remote && !player_heard(one, 1).remote)
    check("a component switched off before its spawn is told all the same", player_heard(one, 1).told == 1)

    side_free(one)
    side_free(host)
    net.hub_free(hub)
    component.kinds_clear()
    if g_failures == 0 {
        println("net spawn: all checks passed (${g_checks})")
    } else {
        println("net spawn: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
