// ae3d.shaders.depth through ae3d.gpu: the depth copy and the depth resolve
// written with `quote`, depth fragment shaders (gpu.depth_fragment).
//
//   - depth_copy comes out as the GLSL in tests/fixtures/gpu/depth_copy.frag
//     for Vulkan and depth_copy_gl.frag for OpenGL 4.1: gl_FragDepth and no
//     colour output, no uniform block, its one sampler at binding 0,
//     frag_coord() as gl_FragCoord.xy and texel_fetch() as texelFetch of an
//     ivec2; glslang compiles the first (and its vertex shader) to SPIR-V that
//     spirv-val passes, and takes the second as OpenGL's GLSL;
//   - the CPU back end, given the target's size, copies every pixel's depth
//     exactly (to the f32 it is held at), as the body run as plain Aether does; without the size it
//     refuses, frag_coord() having no pixel to name;
//   - a depth shader returning a colour is refused;
//   - depth_resolve comes out as depth_resolve.frag / depth_resolve_gl.frag:
//     its sample count in the block, a sampler2DMS, texel_fetch_ms() as
//     texelFetch with the sample; glslang and spirv-val pass it; the CPU
//     takes the nearest of each pixel's samples exactly, as the body run as
//     plain Aether does, and only the samples it is told of.
//
// On a GPU, the copy is drawn when the frame has one sample (AE3D_MSAA=0)
// and the resolve when it has more: tests/test_backend_parity and the
// suites that read the scene's depth.
// AE3D_GPU_WRITE_GOLDEN=1 writes the fixtures from what is emitted.
import std.os
import std.fs
import std.file
import std.list
import std.string
import std.heap
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader, depth_fragment)
import ae3d.shaders.depth
import ae3d.shaderlib (vec2, vec4, Texture, ShaderImage, ShaderImageMS, frag_coord, texel_fetch, texel_fetch_ms,
                       set_frag_coord, image_new, image_set, image_channel, image_free, texture_of, image_ms_new,
                       image_ms_sample, image_ms_free, texture_ms_of)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }

// glslang -V over `text` (as `stage`), then spirv-val; or, for desktop
// OpenGL's GLSL (`opengl`), glslang's check of it. Skipped where they are
// not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the fixture at `path`; AE3D_GPU_WRITE_GOLDEN=1 writes it.
golden_is(text: string, path: string) {
    if os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    golden, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == golden)
    if text != golden {
        println("--- emitted ---")
        println(text)
    }
}


// A depth shader that returns a colour, for the emitter to refuse.
colour_as_depth(t: Texture) -> *GpuShader {
    return depth_fragment("colour_as_depth") quote | uv: vec2 | {
        return texel_fetch(t, frag_coord())
    }
}

// Depths that differ at every pixel, none a value bilinear filtering would
// land on by chance.
make_depth() -> *ShaderImage {
    W = 13
    H = 7
    img = image_new(W, H)
    y = 0
    while y < H {
        x = 0
        while x < W {
            image_set(img, x, y, 0.1 + 0.061 * x + 0.0097 * y * y, 0.0, 0.0, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

// Four samples a pixel, the nearest a different one from pixel to pixel,
// and the nearest of the first two not the nearest of all four.
make_depth_ms() -> *ShaderImageMS {
    W = 13
    H = 7
    ms = image_ms_new(W, H, 4)
    y = 0
    while y < H {
        x = 0
        while x < W {
            k = 0
            while k < 4 {
                // Sample (x + y) % 4 is the nearest; the rest farther by k.
                farther = ((k - x - y) % 4 + 4) % 4
                d = 0.2 + 0.047 * x + 0.0031 * y * y + 0.013 * farther
                image_set(image_ms_sample(ms, k), x, y, d, 0.0, 0.0, 1.0)
                k = k + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return ms
}

// The nearest of the first `n` samples at x, y, as the resolve should find.
nearest_of(ms: *ShaderImageMS, x: int, y: int, n: int) -> float {
    best = 1.0
    k = 0
    while k < n {
        d = image_channel(image_ms_sample(ms, k), x, y, 0)
        if d < best { best = d }
        k = k + 1
    }
    return best
}

// The resolve run on the CPU over every pixel for `n` samples: how many come
// out exactly the nearest of the first n (to the f32 it is held at).
resolved_exactly(ms: *ShaderImageMS, n: int) -> int {
    W = 13
    H = 7
    s = depth.depth_resolve(texture_ms_of(ms), n)
    cx = gpu.cpu_new(s)
    gpu.cpu_set_viewport(cx, W, H)
    exact = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            uv = gpu.v2((x + 0.5) / W, (y + 0.5) / H)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            want32 = (nearest_of(ms, x, y, n) as f32) as float
            if got != null {
                if gpu.val_n(got) == 1 && gpu.val_x(got) == want32 { exact = exact + 1 }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            x = x + 1
        }
        y = y + 1
    }
    gpu.cpu_free(cx)
    gpu.shader_free(s)
    return exact
}

check_resolve() {
    W = 13
    H = 7
    ms = make_depth_ms()
    s = depth.depth_resolve(texture_ms_of(ms), 4)
    check("the resolve writes depth", gpu.writes_depth(s))
    check("its sample count in the block, one sampler, the depth",
          gpu.params_count(s) == 1 && gpu.params_name(s, 0) == "samples" && gpu.samplers_count(s) == 1 &&
          gpu.samplers_name(s, 0) == "depth")
    frag = gpu.emit_glsl(s, gpu.VULKAN)
    if frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(frag, "tests/fixtures/gpu/depth_resolve.frag")
    check("a sampler2DMS read by texelFetch with the sample",
          string.contains(frag, "binding = 1) uniform sampler2DMS depth;") != 0 &&
          string.contains(frag, "texelFetch(depth, ivec2(gl_FragCoord.xy), s).x") != 0)
    compiles("depth_resolve", frag, "frag", false)
    gl_frag = gpu.emit_glsl(s, gpu.GL)
    if gl_frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(gl_frag, "tests/fixtures/gpu/depth_resolve_gl.frag")
    compiles("depth_resolve_gl", gl_frag, "frag", true)
    gpu.shader_free(s)

    all4 = resolved_exactly(ms, 4)
    check("the CPU resolves every pixel to its nearest sample (${all4} of ${W * H})", all4 == W * H)
    two = resolved_exactly(ms, 2)
    check("told of two samples, the nearest of those two (${two} of ${W * H})", two == W * H)
    // The body as plain Aether, at every pixel.
    plain = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            set_frag_coord(x + 0.5, y + 0.5)
            best = 1.0
            k = 0
            while k < 4 {
                d = texel_fetch_ms(texture_ms_of(ms), frag_coord(), k).x
                if d < best { best = d }
                k = k + 1
            }
            if absf(best - nearest_of(ms, x, y, 4)) < 0.000001 { plain = plain + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("as the body run as Aether does (${plain} of ${W * H})", plain == W * H)
    image_ms_free(ms)
}

main() {
    println("ae3d.gpu: depth_copy and depth_resolve written with quote")
    W = 13
    H = 7
    img = make_depth()
    s = depth.depth_copy(texture_of(img))
    check("it writes depth", gpu.writes_depth(s))
    check("no uniforms, one sampler, the depth",
          gpu.params_count(s) == 0 && gpu.samplers_count(s) == 1 && gpu.samplers_name(s, 0) == "depth")

    frag = gpu.emit_glsl(s, gpu.VULKAN)
    if frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(frag, "tests/fixtures/gpu/depth_copy.frag")
    check("gl_FragDepth from texelFetch at gl_FragCoord, no FragColor",
          string.contains(frag, "gl_FragDepth = texelFetch(depth, ivec2(gl_FragCoord.xy), 0).x;") != 0 &&
          string.contains(frag, "FragColor") == 0 && string.contains(frag, "binding = 0) uniform sampler2D depth;") != 0)
    compiles("depth_copy", frag, "frag", false)
    compiles("depth_copy", gpu.emit_screen_vertex(s, gpu.VULKAN), "vert", false)
    gl_frag = gpu.emit_glsl(s, gpu.GL)
    if gl_frag == "" { println("  emit: ${gpu.last_error()}") }
    golden_is(gl_frag, "tests/fixtures/gpu/depth_copy_gl.frag")
    compiles("depth_copy_gl", gl_frag, "frag", true)

    // ── The CPU: every pixel copied ──
    cx = gpu.cpu_new(s)
    uv0 = gpu.v2(0.5 / W, 0.5 / H)
    none_ = gpu.cpu_run(cx, uv0)
    heap.free(uv0)
    check("without the target's size it refuses (${gpu.last_error()})",
          none_ == null && string.contains(gpu.last_error(), "viewport") != 0)
    if none_ != null { heap.free(none_) }
    gpu.cpu_set_viewport(cx, W, H)
    exact = 0
    plain = 0
    y = 0
    while y < H {
        x = 0
        while x < W {
            uv = gpu.v2((x + 0.5) / W, (y + 0.5) / H)
            got = gpu.cpu_run(cx, uv)
            heap.free(uv)
            // Exact as the f32 a depth image holds, which the evaluator's
            // values are rounded to (gpu.f32r), as a GPU's are.
            want = image_channel(img, x, y, 0)
            want32 = (want as f32) as float
            if got != null {
                if gpu.val_n(got) == 1 && gpu.val_x(got) == want32 { exact = exact + 1 }
                heap.free(got)
            } else {
                println("  cpu_run failed: ${gpu.last_error()}")
            }
            // The body as plain Aether, at the same pixel.
            set_frag_coord(x + 0.5, y + 0.5)
            if absf(texel_fetch(texture_of(img), frag_coord()).x - want) < 0.000001 { plain = plain + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("the CPU copies every pixel's depth exactly (${exact} of ${W * H})", exact == W * H)
    check("as the body run as Aether does (${plain} of ${W * H})", plain == W * H)
    gpu.cpu_free(cx)
    gpu.shader_free(s)

    bad = colour_as_depth(texture_of(img))
    bad_text = gpu.emit_glsl(bad, gpu.VULKAN)
    check("a depth shader returning a colour writes no GLSL (${gpu.last_error()})",
          bad_text == "" && string.contains(gpu.last_error(), "a float, not a vec4") != 0)
    gpu.shader_free(bad)

    image_free(img)

    check_resolve()
    if g_failures > 0 {
        println("depth: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("depth: all checks passed (${g_checks})")
}
