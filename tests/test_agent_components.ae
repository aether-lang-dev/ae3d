// The agent's object and component ops, driven over a real socket against
// the engine they are attached to: what an agent building a game asks --
// which objects there are, what they carry, and what it changes on them --
// and what it gets back when it asks for something that is not there.
//
// One request a frame, its answer read on the next, as tests/test_agent.ae
// does: the engine answers in pump at the end of the frame on this thread.

import std.os
import std.tcp
import std.json
import std.string
import ae3d.core
import ae3d.engine
import ae3d.agent
import ae3d.loader
import ae3d.behaviour
import ae3d.component
import ae3d.components

// A game's own component, the way a script declares one.
struct Stamina {
    value: float
    sprinting: bool
}

stamina_new() -> ptr {
    s = heap.new(Stamina)
    s.value = 100.0
    return s as ptr
}

stamina_free(p: ptr) { heap.free(p as *Stamina) }

var g_sock: ptr = null
var g_stage = 0
var g_checks = 0
var g_failures = 0
var g_engine: ptr = null
var g_crate: ptr = null

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if !condition {
        g_failures = g_failures + 1
        println("FAIL ${name}")
    }
}

ask_send(line: string) {
    if g_sock != null { tcp.tcp_send_raw(g_sock, string.concat(line, "\n")) }
}

ask_receive() -> ptr {
    if g_sock == null { return null }
    if tcp.tcp_poll_raw(g_sock, 0) <= 0 { return null }
    text, _length, err = tcp.tcp_receive_n_raw(g_sock, 262144)
    if err != "" || text == null { return null }
    return json.parse_raw(text)
}

ok_of(doc: ptr) -> bool {
    if doc == null { return false }
    node = json.object_get_raw(doc, "ok")
    return node != null && json.get_bool(node) == 1
}

result_of(doc: ptr) -> ptr {
    if doc == null { return null }
    return json.object_get_raw(doc, "result")
}

// Whether a JSON array of strings has `name`.
has_name(names: ptr, name: string) -> bool {
    if names == null { return false }
    n = json.array_size(names)
    i = 0
    while i < n {
        if string.equals(json.get_string_raw(json.array_get_raw(names, i)), name) == 1 { return true }
        i = i + 1
    }
    return false
}

// The entry of object.list with this name.
listed(r: ptr, name: string) -> ptr {
    objects = json.object_get_raw(r, "objects")
    if objects == null { return null }
    n = json.array_size(objects)
    i = 0
    while i < n {
        o = json.array_get_raw(objects, i)
        if string.equals(json.get_string_raw(json.object_get_raw(o, "name")), name) == 1 { return o }
        i = i + 1
    }
    return null
}

field_number(r: ptr, name: string) -> float {
    fields = json.object_get_raw(r, "fields")
    if fields == null { return 0.0 - 1.0 }
    node = json.object_get_raw(fields, name)
    if node == null { return 0.0 - 1.0 }
    return json.get_number(node)
}

near(a: float, b: float) -> bool {
    d = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

main() {
    os.setenv("AE3D_AGENT", "auto")
    e = engine.engine_new()
    g_engine = e as ptr
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_frame_limit(e, 120)
    k = component.kind("Stamina", "Gameplay", stamina_new, stamina_free)
    component.float_field(k, "value", offsetof(Stamina, value), 0.0, 100.0)
    component.bool_field(k, "sprinting", offsetof(Stamina, sprinting))
    crate = engine.object(e, "Crate", loader.cube(1.0))
    g_crate = crate as ptr
    program = engine.behaviour_new("agent components test", null)
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)
    if !engine.engine_run(e) {
        println("SKIP no window")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    if g_stage < 22 {
        println("FAIL the exchange did not finish (stopped at stage ${g_stage})")
        g_failures = g_failures + 1
    }
    if g_failures == 0 {
        println("test_agent_components: all checks passed (${g_checks})")
        return
    }
    println("test_agent_components: ${g_failures} failure(s) of ${g_checks}")
}

on_render(state: ptr, e: *Engine, delta: float) {
    if g_stage == 0 {
        sock, _err = tcp.connect("127.0.0.1", agent.port())
        check("client connects", sock != null)
        g_sock = sock
        ask_send("{\"id\":1,\"op\":\"object.list\"}")
        g_stage = 1
        return
    }
    if g_sock == null { return }
    doc = ask_receive()
    if doc == null { return }
    r = result_of(doc)

    if g_stage == 1 {
        scene = listed(r, "Scene")
        check("object.list names the scene first, as -1", scene != null && json.get_int(json.object_get_raw(scene, "index")) == 0 - 1)
        check("the scene carries Environment and Rendering",
              scene != null && has_name(json.object_get_raw(scene, "components"), "Environment") &&
              has_name(json.object_get_raw(scene, "components"), "Rendering"))
        crate = listed(r, "Crate")
        check("the crate carries its transform, its renderer and its material",
              crate != null && has_name(json.object_get_raw(crate, "components"), "Transform") &&
              has_name(json.object_get_raw(crate, "components"), "Mesh Renderer") &&
              has_name(json.object_get_raw(crate, "components"), "Material"))
        ask_send("{\"id\":2,\"op\":\"component.kinds\"}")
    } else if g_stage == 2 {
        kinds = json.object_get_raw(r, "kinds")
        found = false
        n = json.array_size(kinds)
        i = 0
        while i < n {
            kind = json.array_get_raw(kinds, i)
            if string.equals(json.get_string_raw(json.object_get_raw(kind, "name")), "Light") == 1 {
                fields = json.object_get_raw(kind, "fields")
                first = json.array_get_raw(fields, 0)
                choices = json.object_get_raw(first, "choices")
                found = string.equals(json.get_string_raw(json.object_get_raw(first, "type")), "enum") == 1 &&
                        has_name(choices, "spot")
            }
            i = i + 1
        }
        check("component.kinds describes each field: the light's type is an enum with spot among its choices", found)
        ask_send("{\"id\":3,\"op\":\"component.add\",\"object\":\"Crate\",\"kind\":\"Stamina\",\"fields\":{\"value\":40}}")
    } else if g_stage == 3 {
        check("component.add adds the game's own kind with the fields given", ok_of(doc) && near(field_number(r, "value"), 40.0))
        ask_send("{\"id\":4,\"op\":\"component.add\",\"object\":\"Crate\",\"kind\":\"Transform\"}")
    } else if g_stage == 4 {
        check("a second transform is refused: one per object", !ok_of(doc))
        ask_send("{\"id\":5,\"op\":\"component.set\",\"object\":\"Crate\",\"kind\":\"Transform\",\"fields\":{\"position\":[1,2,3],\"nonsense\":1}}")
    } else if g_stage == 5 {
        m = behaviour.object_model(g_crate as *GameObject)
        check("component.set moves the model", near(m.position.x, 1.0) && near(m.position.y, 2.0) && near(m.position.z, 3.0))
        check("and counts the names the kind has no field for", json.get_int(json.object_get_raw(r, "unknown")) == 1)
        ask_send("{\"id\":6,\"op\":\"component.set\",\"object\":-1,\"kind\":\"Environment\",\"fields\":{\"fog\":true,\"fog end\":120}}")
    } else if g_stage == 6 {
        f = engine.engine_fog(e)
        check("the scene's Environment sets the engine's fog", f.enabled && near(f.end, 120.0))
        ask_send("{\"id\":7,\"op\":\"component.set\",\"object\":\"Scene\",\"kind\":\"Rendering\",\"fields\":{\"occlusion radius\":99}}")
    } else if g_stage == 7 {
        check("a field is held to its range", near(field_number(r, "occlusion radius"), 20.0))
        ask_send("{\"id\":8,\"op\":\"component.enable\",\"object\":\"Crate\",\"kind\":\"Stamina\",\"on\":false}")
    } else if g_stage == 8 {
        enabled = json.object_get_raw(r, "enabled")
        check("component.enable switches it off", enabled != null && json.get_bool(enabled) == 0)
        ask_send("{\"id\":9,\"op\":\"object.get\",\"object\":\"Crate\"}")
    } else if g_stage == 9 {
        detail = json.object_get_raw(r, "detail")
        check("object.get gives every component with its fields", detail != null && json.array_size(detail) == 4)
        ask_send("{\"id\":10,\"op\":\"component.remove\",\"object\":\"Crate\",\"kind\":\"Stamina\"}")
    } else if g_stage == 10 {
        check("component.remove takes it off", ok_of(doc) && !has_name(json.object_get_raw(r, "components"), "Stamina"))
        ask_send("{\"id\":11,\"op\":\"component.get\",\"object\":\"Nobody\",\"kind\":\"Transform\"}")
    } else if g_stage == 11 {
        check("an object that is not there is an error", !ok_of(doc))
        ask_send("{\"id\":12,\"op\":\"component.get\",\"object\":\"Crate\",\"kind\":\"Stamina\"}")
    } else if g_stage == 12 {
        check("a component the object does not have is an error", !ok_of(doc))
        ask_send("{\"id\":13,\"op\":\"component.get\",\"object\":\"Crate\",\"kind\":\"Nothing\"}")
    } else if g_stage == 13 {
        check("a kind that does not exist is an error", !ok_of(doc))
        ask_send("{\"id\":14,\"op\":\"object.list\",\"filter\":\"Cra\"}")
    } else if g_stage == 14 {
        objects = json.object_get_raw(r, "objects")
        check("object.list filters by name", objects != null && json.array_size(objects) == 1)
        ask_send("{\"id\":15,\"op\":\"quit\"}")
        g_stage = 22
        json.free(doc)
        return
    }
    json.free(doc)
    g_stage = g_stage + 1
}
