// A clip made at run time, played and blended as a file's own (#645, #650),
// held to numbers on the Fox fixture, no window: the figure stepped by hand
// at 60 Hz. "Turns" keys only each bone's rotation, as a retarget of motion
// capture does: from where the bone rests to a quarter radian on.
//
//   - figure.add_clip takes one clip a bone into the figure's animation
//     "Turns": the figure has one clip more, named "Turns", and plays it;
//   - a clip not named "Turns:..." and a node the figure has none of are
//     refused, and the figure is as it was;
//   - blended in over 0.3 s, from Walk and from the pose the file rests in
//     (nothing played yet), the figure comes to what a cut to it draws:
//     every bone within 1 mm of the cut's 2 s on. Out of the rest pose the
//     transition carried on from a pose never drawn -- every node at zero --
//     and its offsets were added each frame onto the bones' places, which a
//     clip keying only turns never puts back: they summed, and the limbs
//     went metres off and stayed there;
//   - and no bone's distance from its parent changes by more than 1 mm from
//     where it was, blending or after.

import ae3d.core
import ae3d.anim
import ae3d.skin
import ae3d.figure

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

const FOX = "tests/fixtures/gltf/Fox.glb"
const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// Each bone's "Turns" clip: its rotation from where it is to a quarter
// radian on about its own x, keyed at 0 and 1 s; rotations only.
add_turns(f: *Figure) -> bool {
    sk = figure.skeleton(f)
    all = true
    i = 0
    while i < skin.skeleton_count(sk) {
        bone = skin.skeleton_bone(sk, i)
        name = core.text(bone.name)
        c = anim.clip_new("Turns:${name}")
        ch = anim.channel_new(anim.ROTATION, anim.LINEAR)
        q = bone.rotation
        on = core.quat_normalize(core.quat_mul(q, core.quat_rotate(0.25, core.vec3(1.0, 0.0, 0.0))))
        anim.channel_add_key(ch, 0.0, q.x, q.y, q.z, q.w)
        anim.channel_add_key(ch, 1.0, on.x, on.y, on.z, on.w)
        anim.clip_add_channel(c, ch)
        if !figure.add_clip(f, "Turns", c, name) {
            all = false
            anim.clip_free(c)
        }
        i = i + 1
    }
    return all
}

// Every bone's world position, three floats a bone.
places(f: *Figure, out: ptr) {
    sk = figure.skeleton(f)
    p = out as float[]
    i = 0
    while i < skin.skeleton_count(sk) {
        bone = skin.skeleton_bone(sk, i)
        core.model_sync_transform(bone)
        p[i * 3] = bone.world_position.x
        p[i * 3 + 1] = bone.world_position.y
        p[i * 3 + 2] = bone.world_position.z
        i = i + 1
    }
}

// The furthest any bone is between two sets of places.
furthest(n: int, a: ptr, b: ptr) -> float {
    pa = a as float[]
    pb = b as float[]
    worst = 0.0
    i = 0
    while i < n {
        dx = pa[i * 3] - pb[i * 3]
        dy = pa[i * 3 + 1] - pb[i * 3 + 1]
        dz = pa[i * 3 + 2] - pb[i * 3 + 2]
        d = core.sqrt_of(dx * dx + dy * dy + dz * dz)
        if d > worst { worst = d }
        i = i + 1
    }
    return worst
}

// Each bone's distance from its parent, a float a bone (0 for a root).
lengths(f: *Figure, out: ptr) {
    sk = figure.skeleton(f)
    p = out as float[]
    i = 0
    while i < skin.skeleton_count(sk) {
        bone = skin.skeleton_bone(sk, i)
        v = bone.position
        p[i] = core.sqrt_of(v.x * v.x + v.y * v.y + v.z * v.z)
        i = i + 1
    }
}

most_changed(n: int, a: ptr, b: ptr) -> float {
    pa = a as float[]
    pb = b as float[]
    worst = 0.0
    i = 0
    while i < n {
        d = pa[i] - pb[i]
        if d < 0.0 { d = 0.0 - d }
        if d > worst { worst = d }
        i = i + 1
    }
    return worst
}

// A Fox walked half a second, with "Turns" added.
walked() -> *Figure {
    f = figure.figure_new(FOX, core.model_new())
    figure.play(f, "Walk", 1.0, true)
    k = 0
    while k < 30 {
        figure.advance(f, STEP)
        k = k + 1
    }
    return f
}

// A cut to "Turns" and a 0.3 s blend into it, side by side for 2 s, from
// Walk half a second in or from the pose the file rests in.
blend_case(name: string, from_walk: bool) {
    cut = figure.figure_new(FOX, core.model_new())
    blended = figure.figure_new(FOX, core.model_new())
    if from_walk {
        figure.figure_free(cut)
        figure.figure_free(blended)
        cut = walked()
        blended = walked()
    }
    n = skin.skeleton_count(figure.skeleton(cut))
    was_lengths = calloc(n, 8)
    now_lengths = calloc(n, 8)
    lengths(blended, was_lengths)
    add_turns(cut)
    add_turns(blended)
    figure.play(cut, "Turns", 1.0, true)
    figure.play_blended(blended, "Turns", 1.0, true, 0.3)
    stretched = 0.0
    k = 0
    while k < 120 {
        figure.advance(cut, STEP)
        figure.advance(blended, STEP)
        lengths(blended, now_lengths)
        s = most_changed(n, was_lengths, now_lengths)
        if s > stretched { stretched = s }
        k = k + 1
    }
    a = calloc(n * 3, 8)
    b = calloc(n * 3, 8)
    places(cut, a)
    places(blended, b)
    apart = furthest(n, a, b)
    println("  ${name}, 2 s on: blended in, the furthest bone ${apart * 1000.0} mm from the cut's; a bone's distance from its parent changed ${stretched * 1000.0} mm at most")
    check("${name}: blended in, the figure comes to what the cut draws, every bone within 1 mm", apart < 0.001)
    check("${name}: no bone's distance from its parent changes by more than 1 mm", stretched < 0.001)
    free(a)
    free(b)
    free(was_lengths)
    free(now_lengths)
    figure.figure_free(cut)
    figure.figure_free(blended)
}

main() {
    println("runtime_clip: a clip made at run time, played and blended as the file's own")
    f = figure.figure_new(FOX, core.model_new())
    before = figure.clip_count(f)
    c = anim.clip_new("Elsewhere:x")
    sk = figure.skeleton(f)
    first = core.text(skin.skeleton_bone(sk, 0).name)
    check("a clip not named \"Turns:...\" is refused", !figure.add_clip(f, "Turns", c, first))
    check("a node the figure has none of is refused", !figure.add_clip(f, "Elsewhere", c, "no such bone"))
    check("and the figure has the clips it had", figure.clip_count(f) == before)
    anim.clip_free(c)
    check("one clip a bone is added to \"Turns\"", add_turns(f))
    check("the figure has one clip more, named \"Turns\"", figure.clip_count(f) == before + 1 && figure.clip_name(f, before) == "Turns")
    check("and plays it", figure.play(f, "Turns", 1.0, true) && figure.duration(f) > 0.99)
    figure.figure_free(f)

    blend_case("from Walk", true)
    blend_case("from the rest pose", false)
    if g_failures == 0 {
        println("runtime_clip: all checks passed (${g_checks})")
        return
    }
    println("runtime_clip: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
