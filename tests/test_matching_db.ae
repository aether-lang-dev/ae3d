// Motion matching over a style's whole takes (#906): the UE5 mannequin's
// matcher over 100STYLE's eight neutral takes read whole (minutes each, the
// actor walking and running about a capture volume: tests/fixtures/people/
// 100style/whole, gzip'd) and the mirrors of the side, turning and idle
// ones. No window; stepped at 60 Hz.
//
//   - built: its frames, and how long its build takes, printed;
//   - its search, from where the figure plays as a mover walks it, finds the
//     frame brute force does every time; 2,000 searches take a measured time
//     (a search per figure), held under 0.25 ms each and faster than brute
//     force;
//   - a mover stands it, walks it ahead, steps it left facing ahead, walks
//     it round to its right, runs it and stops it: through every change no
//     joint turns faster than the takes' own fastest plus what easing out
//     the change's largest offset needs (as test_anim_pipeline holds the
//     short takes' matcher), and no toe skates 5 mm (ae3d.metrics).

import std.os
import ae3d.core
import ae3d.engine
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.ikrig
import ae3d.mover
import ae3d.metrics
import ae3d.bvh

extern exit(code: int)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const WHOLE = "tests/fixtures/people/100style/whole/"

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

turned_by(a: Quat, b: Quat) -> float {
    d = core.abs_of(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w)
    if d > 1.0 { d = 1.0 }
    return 2.0 * core.acos_of(d)
}

fastest_turn(r: *pose.Rig, p: ptr, q: ptr, dt: float) -> float {
    most = 0.0
    j = 0
    while j < pose.count(r) {
        t = turned_by(pose.rotation(p, j), pose.rotation(q, j)) / dt
        if t > most { most = t }
        j = j + 1
    }
    return most
}

// The fastest a joint turns in take `t` played alone, frame to frame.
own_fastest(r: *pose.Rig, t: *Take) -> float {
    most = 0.0
    f = 0
    while f + 1 < clips.frames(t) {
        x = fastest_turn(r, clips.frame(t, f), clips.frame(t, f + 1), 1.0 / clips.rate(t))
        if x > most { most = x }
        f = f + 1
    }
    return most
}

main() {
    println("matching_db: motion matching over 100STYLE's whole neutral takes (#906)")
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    o = figure.figure(e, "Person", MANNEQUIN)
    a = animator.attach(e, o)
    r = animator.rig(a)
    matcher = animator.add_matcher(a, "match")
    names = ["FW", "BW", "SW", "FR", "BR", "SR", "TR1", "ID"]
    mirrored = [false, false, true, false, false, true, true, true]
    own = 0.0
    held = 0
    started = os.now_monotonic_ns()
    k = 0
    while k < 8 {
        c = bvh.load("${WHOLE}Neutral_${names[k]}.bvh.gz", 0.0)
        if c == null {
            check("Neutral_${names[k]} reads: ${bvh.error()}", false)
            exit(1)
        }
        made = bvh.take(c, names[k], 0, 0 - 1)
        t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
        clips.take_free(made)
        bvh.capture_free(c)
        animator.matcher_add(a, matcher, t)
        held = held + clips.frames(t)
        x = own_fastest(r, t)
        if x > own { own = x }
        if mirrored[k] {
            back = animator.add_take(a, clips.mirror(t, r), false)
            animator.matcher_add(a, matcher, back)
            held = held + clips.frames(back)
        }
        k = k + 1
    }
    read_ms = (os.now_monotonic_ns() - started) as float / 1000000.0
    started = os.now_monotonic_ns()
    animator.matcher_build(a, matcher)
    build_ms = (os.now_monotonic_ns() - started) as float / 1000000.0
    frames = animator.matcher_frames(a, matcher)
    println("  ${frames} frames from 8 takes and 4 mirrors: read and retargeted in ${read_ms} ms, built in ${build_ms} ms; the takes' fastest joint turn ${own} rad/s")
    check("the database holds every frame of the style's whole takes and their mirrors (${held})", frames == held && held > 60000)
    feet = ikrig.feet_new(r, o)
    animator.set_feet(a, feet)
    m = mover.mover_new(a, o)
    mover.set_matcher(m, matcher)
    mover.set_follow(m, true)
    animator.play(a, matcher, 0.0)
    meter = metrics.meter_new(r, o)
    ahead = retarget.facing(r)
    left = core.vec3(ahead.z, 0.0, 0.0 - ahead.x)
    right_ahead = core.vec3(0.0 - left.x, 0.0, 0.0 - left.z)
    before = pose.new(r)
    target = pose.new(r)
    fastest = 0.0
    offset = 0.0
    seen_changes = 0
    compared = 0
    differed = 0
    k = 0
    while k < (14.0 / STEP) as int {
        now = (k as float) * STEP
        asked = core.vec3(0.0, 0.0, 0.0)
        if now >= 1.0 && now < 4.0 { asked = core.v3_mul(ahead, 0.8) }
        if now >= 4.0 && now < 6.0 {
            asked = core.v3_mul(left, 0.55)
            mover.face(m, core.atan2_of(ahead.x, ahead.z), true)
        }
        if now >= 6.0 && now < 8.5 {
            mover.face(m, 0.0, false)
            asked = core.v3_mul(right_ahead, 0.8)
        }
        if now >= 8.5 && now < 11.0 { asked = core.v3_mul(right_ahead, 1.8) }
        mover.ask(m, asked)
        mover.step(m, STEP)
        pose.copy(r, animator.pose_now(a), before)
        engine.engine_update(e, STEP)
        metrics.meter_take(meter, STEP)
        if k > 0 {
            x = fastest_turn(r, before, animator.pose_now(a), STEP)
            if x > fastest { fastest = x }
        }
        changed = animator.matcher_changes(a, matcher)
        if changed > seen_changes {
            seen_changes = changed
            clips.sample(animator.current_take(a), r, animator.state_time(a) - STEP, false, target)
            j = 0
            while j < pose.count(r) {
                d = turned_by(pose.rotation(before, j), pose.rotation(target, j))
                if d > offset { offset = d }
                j = j + 1
            }
        }
        // Every frame, from where the figure plays.
        compared = compared + 1
        if animator.matcher_find(a, matcher, false) != animator.matcher_find(a, matcher, true) { differed = differed + 1 }
        k = k + 1
    }
    skated = metrics.meter_worst(meter, metrics.SKATE)
    skated_at = metrics.meter_when(meter, metrics.SKATE)
    allowed = own + 1.875 * offset / animator.MATCH_BLEND
    // What a search costs: the fastest of three runs of 2,000.
    fast = 1000000000.0
    slow = 1000000000.0
    run = 0
    while run < 3 {
        started = os.now_monotonic_ns()
        n = 0
        while n < 2000 {
            animator.matcher_find(a, matcher, false)
            n = n + 1
        }
        took = (os.now_monotonic_ns() - started) as float
        if took < fast { fast = took }
        started = os.now_monotonic_ns()
        n = 0
        while n < 200 {
            animator.matcher_find(a, matcher, true)
            n = n + 1
        }
        took = (os.now_monotonic_ns() - started) as float * 10.0
        if took < slow { slow = took }
        run = run + 1
    }
    per = fast / 2000.0 / 1000000.0
    println("  walked, stepped aside, turned, run and stopped: ${animator.matcher_searches(a, matcher)} searches, ${seen_changes} changes; the fastest joint turn ${fastest} rad/s, the takes' own fastest plus the easing's ${allowed} (the largest offset at a change ${offset * 57.29578} degrees); a toe skated ${skated * 1000.0} mm at worst, at ${skated_at} s")
    println("  a search over ${frames} frames: ${per} ms (2,000 in ${fast / 1000000.0} ms), brute force ${slow / 2000.0 / 1000000.0} ms; ${differed} of ${compared} searches found another frame than brute force")
    check("its search finds the frame brute force does, every time", differed == 0 && compared > 300)
    check("a search over the whole style takes under 0.25 ms, and less than brute force", per < 0.25 && fast < slow)
    check("through every change no joint turns faster than the takes' own fastest plus the easing's", fastest <= allowed * 1.02)
    check("and no toe skates 5 mm (ae3d.metrics)", skated < 0.005)
    metrics.meter_free(meter)
    pose.release(before)
    pose.release(target)
    mover.mover_free(m)
    animator.animator_free(a)
    figure.figures_free(e)
    engine.engine_free(e)
    if g_failures == 0 {
        println("matching_db: all checks passed (${g_checks})")
        return
    }
    println("matching_db: ${g_failures} failure(s) of ${g_checks}")
    exit(1)
}
