// ae3d.shaders.composite through ae3d.gpu: the frame's tone curve, written
// with `quote` (step 6).
//
//   - the composite comes out as the GLSL in tests/fixtures/gpu/composite.frag
//     and its _gl twin, and glslang and spirv-val pass it;
//   - its block holds the captures at their std140 places, the haze a
//     captured struct of two vec4[4] arrays at a sixteen-byte stride, the
//     camera a mat4 at a sixteen-byte boundary, and its two textures are the
//     light and the bloom, in that order; params_write repacks the haze from
//     its cell to those places, and a struct of float[4] (doubles, eight
//     bytes apart in the cell) to sixteen apart; a field the body reads that
//     nothing placed is refused;
//   - haze_screen's `out float w` is a HazePoint, a GLSL struct its helper
//     returns;
//   - on the CPU it draws what the same shader written as plain Aether over
//     ae3d.shaderlib does, but for the grain (a hash of the pixel's place,
//     which f32 and doubles hash apart): the light alone, with the bloom
//     added, rippled by two columns of hot air and by four (a count of two
//     cutting the loop short of the rest), and a capture passed through as
//     data; the haze's noise is hashed the same way, so a pixel the hot air
//     moves is held to have moved, and every other to the reference;
//   - the tone curve is ACES, then the sRGB encoding.
//
// On a GPU, every frame either renderer draws goes through it
// (test_backend_parity, test_heat_haze, ...). AE3D_GPU_WRITE_GOLDEN=1 writes
// the fixtures.
import std.os
import std.fs
import std.file
import std.list
import std.string
import std.heap
import std.lanes
import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader, GpuVal)
import ae3d.shaders.composite
import ae3d.shaders.composite (Haze, HazePoint)
import ae3d.shaderlib
import ae3d.shaderlib (vec2, vec3, vec4, mat4, Texture, ShaderImage, texture, rgb, xy, xyz, dot_v2, mul, m4_at,
                       splat2, splat3, float_of, frag_coord, set_frag_coord, image_new, image_set, image_free,
                       texture_of, zero_mat4)

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

absf(a: float) -> float { if a < 0.0 { return 0.0 - a } return a }
maxf(a: float, b: float) -> float { if a > b { return a } return b }

// glslang -V over `text` (as `stage`), then spirv-val; or, for desktop
// OpenGL's GLSL (`opengl`), glslang's check of it. Skipped where they are
// not on PATH.
compiles(label: string, text: string, stage: string, opengl: bool) {
    if string.length(os.which("glslangValidator")) == 0 {
        println("  skip glslang (not on PATH)")
        return
    }
    tmp = os.temp_dir()
    src = "${tmp}/ae3d_gpu_${label}.${stage}"
    spv = "${tmp}/ae3d_gpu_${label}.${stage}.spv"
    _w = file.write(src, text)
    argv = list.new()
    if !opengl {
        list.add(argv, "-V")
        list.add(argv, "-o")
        list.add(argv, spv)
    }
    list.add(argv, src)
    out, status, _err = os.run_capture("glslangValidator", argv, null)
    list.free(argv)
    if opengl {
        check("glslang takes ${label}.${stage} as OpenGL's GLSL", status == 0)
        if status != 0 { println(out) }
        return
    }
    check("glslang compiles ${label}.${stage} to SPIR-V", status == 0)
    if status != 0 { println(out) }
    if string.length(os.which("spirv-val")) == 0 {
        println("  skip spirv-val (not on PATH)")
        return
    }
    vargv = list.new()
    list.add(vargv, spv)
    vout, vstatus, _verr = os.run_capture("spirv-val", vargv, null)
    check("spirv-val passes ${label}.${stage}", vstatus == 0)
    if vstatus != 0 { println(vout) }
    list.free(vargv)
}

// `text` is the fixture at `path`; AE3D_GPU_WRITE_GOLDEN=1 writes it.
golden_is(text: string, path: string) {
    if os.getenv("AE3D_GPU_WRITE_GOLDEN") != null {
        _m = fs.mkdir_p("tests/fixtures/gpu")
        werr = file.write(path, text)
        check("${path} written", werr == "")
    }
    golden, gerr = file.read(path)
    check("${path} is there", gerr == "")
    check("the GLSL written is ${path}", text == golden)
    if text != golden {
        println("--- emitted ---")
        println(text)
    }
}

// ── The pictures it reads ─────────────────────────────────────────────

// The light, 48 by 32: dark to bright across, a hot patch past one, and
// stripes, so a pixel pulled sideways by the haze reads otherwise.
light() -> *ShaderImage {
    img = image_new(48, 32)
    y = 0
    while y < 32 {
        x = 0
        while x < 48 {
            stripe = 0.0
            if x % 4 < 2 { stripe = 0.25 }
            hot = 0.0
            if x > 30 && x < 38 && y > 10 && y < 20 { hot = 2.5 }
            image_set(img, x, y, 0.02 + x * 0.03 + stripe + hot, 0.05 + y * 0.02 + hot * 0.6, 0.1 + stripe * 0.5, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

// The bloom's blur, 24 by 16, softer and lower.
glow() -> *ShaderImage {
    img = image_new(24, 16)
    y = 0
    while y < 16 {
        x = 0
        while x < 24 {
            image_set(img, x, y, 0.1 + 0.02 * x, 0.08 + 0.01 * y, 0.05, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

// A camera over the columns: a perspective looking down -z from (0, 1.5, 6),
// as column-major columns.
camera() -> mat4 {
    c = calloc(16, 8) as float[]
    // projection (fov ~60, aspect 1.5, near 0.1, far 100) times a view
    // translated by (0, -1.5, -6).
    f = 1.7320508
    a = 1.5
    p0 = f / a
    p5 = f
    p10 = 0.0 - 100.1 / 99.9
    p14 = 0.0 - 2.0 * 100.0 * 0.1 / 99.9
    c[0] = p0
    c[5] = p5
    c[10] = p10
    c[11] = 0.0 - 1.0
    c[14] = p14
    // the view's translation through the projection
    c[13] = p5 * (0.0 - 1.5)
    c[14] = p10 * (0.0 - 6.0) + p14
    c[15] = 6.0
    m = shaderlib.mat4_of(c as ptr)
    free(c as ptr)
    return m
}

// ── The composite as plain Aether ─────────────────────────────────────

// What the composite draws at `uv` (frag_coord set), written as Aether.
reference(screen: Texture, bloom: Texture, frame_exposure: float, capture_channel: int, bloom_on: int,
          bloom_intensity: float, h: Haze, vp: mat4, uv: vec2) -> vec4 {
    at = uv
    if h.count > 0 && capture_channel == 0 {
        offset = vec2(0.0, 0.0)
        k = 0
        while k < 4 {
            kk = k
            k = k + 1
            if kk >= h.count { break }
            column = h.column[kk]
            shape = h.shape[kk]
            hb = composite.haze_screen(vp, xyz(column))
            ht = composite.haze_screen(vp, xyz(column) + vec3(0.0, shape.x, 0.0))
            if hb.w <= 0.0 || ht.w <= 0.0 { continue }
            b = hb.at
            axis = ht.at - b
            len2 = dot_v2(axis, axis)
            if len2 < 1e-10 { continue }
            along = dot_v2(uv - b, axis) / len2
            width = column.w * shaderlib.abs(m4_at(vp, 0, 0)) / hb.w * 0.5 * (1.0 + 0.6 * along)
            across = shaderlib.abs(uv.x - (b.x + axis.x * along)) / shaderlib.max(width, 1e-6)
            if along < 0.0 || along > 1.0 || across > 1.0 { continue }
            amount = shape.y * shaderlib.smoothstep(0.0, 0.08, along) * (1.0 - along) * (1.0 - across * across)
            q = vec2(across * 3.0 + float_of(kk) * 7.1, along * 7.0 - shape.z)
            n = vec2(composite.haze_noise(q * 2.3), composite.haze_noise(q * 2.3 + vec2(17.3, 5.9))) - splat2(0.5)
            offset = offset + n * amount * width * 0.18
        }
        at = at + offset
    }
    radiance = rgb(texture(screen, at))
    if capture_channel != 0 { return vec4(radiance, 1.0) }
    if bloom_on != 0 { radiance = radiance + rgb(texture(bloom, at)) * bloom_intensity }
    shown = composite.aces(radiance * frame_exposure)
    shown = vec3(composite.srgb_encode(shown.x), composite.srgb_encode(shown.y), composite.srgb_encode(shown.z))
    noise = shaderlib.fract(shaderlib.sin(dot_v2(frag_coord(), vec2(12.9898, 78.233))) * 43758.5453) - 0.5
    return vec4(shown + splat3(noise / 255.0), 1.0)
}

// The grain is a hash of the pixel's place: fract(sin(...) * 43758.5453),
// which turns the last bit of its argument into any value at all, and the
// evaluator rounds to f32 as a GPU does where plain Aether holds doubles.
// So the two are held equal but for the grain: each colour lane apart by
// the same amount, and that amount within the grain's own range (a step of
// 255, the two grains being half a step either way). The heat haze hashes
// its noise the same way, so a pixel the hot air moves is only held to have
// moved; every pixel it leaves is held to the reference.
const GRAIN = 0.0040    // 1/255 and a little
const LANE = 0.0001

// Whether `got` is `want` but for the grain.
same_but_grain(got: *GpuVal, want: vec4) -> bool {
    w = want as f32x4
    dr = gpu.val_x(got) - w.x
    dg = gpu.val_y(got) - w.y
    db = gpu.val_z(got) - w.z
    return absf(dr - dg) < LANE && absf(dr - db) < LANE && absf(dr) < GRAIN && absf(gpu.val_w(got) - w.w) < LANE
}

// Whether two colours differ by more than the grain can make them.
apart_past_grain(a: vec4, b: vec4) -> bool {
    p = a as f32x4
    q = b as f32x4
    return absf(p.x - q.x) > 2.0 * GRAIN || absf(p.y - q.y) > 2.0 * GRAIN || absf(p.z - q.z) > 2.0 * GRAIN
}

// Whether `uv` lies in any of the first `count` columns: what the hot air
// can move, found from the columns' geometry alone (no hash).
in_haze(uv: vec2, h: Haze, vp: mat4) -> bool {
    k = 0
    while k < h.count && k < 4 {
        column = h.column[k]
        shape = h.shape[k]
        k = k + 1
        hb = composite.haze_screen(vp, xyz(column))
        ht = composite.haze_screen(vp, xyz(column) + vec3(0.0, shape.x, 0.0))
        if hb.w <= 0.0 || ht.w <= 0.0 { continue }
        axis = ht.at - hb.at
        len2 = dot_v2(axis, axis)
        if len2 < 1e-10 { continue }
        along = dot_v2(uv - hb.at, axis) / len2
        width = column.w * shaderlib.abs(m4_at(vp, 0, 0)) / hb.w * 0.5 * (1.0 + 0.6 * along)
        across = shaderlib.abs(uv.x - (hb.at.x + axis.x * along)) / shaderlib.max(width, 1e-6)
        if along >= 0.0 && along <= 1.0 && across <= 1.0 { return true }
    }
    return false
}

// One case on the CPU over a 24 by 16 grid of the frame, against the
// reference: `right`, the pixels drawn as it draws them (but for the grain);
// `clear`, the pixels outside every column; `clear_right`, those the
// evaluator draws as the reference does; `hazy`, the pixels in a column;
// `rippled`, those the evaluator draws past the grain from the reference
// with no haze; and `moved`, the pixels the reference draws past the grain
// from itself with `alt_count` columns and bloom `alt_bloom`.
struct Ran {
    right: int
    clear: int
    clear_right: int
    hazy: int
    rippled: int
    moved: int
}

run_case(screen: Texture, bloom: Texture, exposure: float, channel: int, bloom_on: int, intensity: float, count: int,
         h: Haze, vp: mat4, alt_count: int, alt_bloom: int) -> Ran {
    hc = with_count(h, count)
    ha = with_count(h, alt_count)
    calm_h = with_count(h, 0)
    s = composite.composite(screen, bloom, bloom, exposure, channel, bloom_on, intensity, 0, hc, vp)
    cx = gpu.cpu_new(s)
    r = Ran { right: 0, clear: 0, clear_right: 0, hazy: 0, rippled: 0, moved: 0 }
    y = 0
    while y < 16 {
        x = 0
        while x < 24 {
            fx = x * 2.0 + 0.5
            fy = y * 2.0 + 0.5
            uv = vec2(fx / 48.0, fy / 32.0)
            gpu.cpu_set_frag_coord(cx, fx, fy)
            set_frag_coord(fx, fy)
            pa = gpu.v2(fx / 48.0, fy / 32.0)
            got = gpu.cpu_run(cx, pa)
            heap.free(pa)
            want = reference(screen, bloom, exposure, channel, bloom_on, intensity, hc, vp, uv)
            other = reference(screen, bloom, exposure, channel, alt_bloom, intensity, ha, vp, uv)
            calm = reference(screen, bloom, exposure, channel, bloom_on, intensity, calm_h, vp, uv)
            if apart_past_grain(want, other) { r.moved = r.moved + 1 }
            hazy = channel == 0 && in_haze(uv, hc, vp)
            if hazy { r.hazy = r.hazy + 1 } else { r.clear = r.clear + 1 }
            if got == null {
                println("  cpu_run composite: ${gpu.last_error()}")
            } else {
                ok = same_but_grain(got, want)
                if ok { r.right = r.right + 1 }
                if !hazy && ok { r.clear_right = r.clear_right + 1 }
                g = vec4(vec3(gpu.val_x(got), gpu.val_y(got), gpu.val_z(got)), gpu.val_w(got))
                if hazy && apart_past_grain(g, calm) { r.rippled = r.rippled + 1 }
                gpu.val_free(got)
            }
            x = x + 1
        }
        y = y + 1
    }
    gpu.cpu_free(cx)
    gpu.shader_free(s)
    return r
}

// The haze `h` with `count` columns.
with_count(h: Haze, count: int) -> Haze {
    out = h
    out.count = count
    return out
}

// ── A captured struct's layout, apart from the composite ──────────────

// Four floats: doubles in the cell, eight bytes apart; sixteen apart in
// the block, as std140 strides any array.
struct Waves {
    gain: float
    amplitude: float[4]
}

waves_shader(w: Waves) -> *GpuShader {
    s = gpu.fragment("waves") quote | uv: vec2 | {
        return vec4(vec3(w.amplitude[1], w.amplitude[3], w.gain), uv.x)
    }
    _g = gpu.capture_field(s, "w", "gain", offsetof(Waves, gain))
    _a = gpu.capture_field(s, "w", "amplitude", offsetof(Waves, amplitude))
    return s
}

// The same shader with its amplitudes left unplaced: refused.
unplaced_shader(w: Waves) -> *GpuShader {
    s = gpu.fragment("unplaced") quote | uv: vec2 | {
        return vec4(vec3(w.amplitude[1], 0.0, w.gain), uv.x)
    }
    _g = gpu.capture_field(s, "w", "gain", offsetof(Waves, gain))
    return s
}

// The composite of one pixel (10.5, 6.5 of a 48 by 32 frame) with depth of
// field `dof_on` over the images given, the three channels and the alpha.
shade_dof(screen: Texture, bloom: Texture, blurred: Texture, dof_on: int, vp: mat4) -> f32x4 {
    s = composite.composite(screen, bloom, blurred, 1.4, 0, 1, 0.35, dof_on, Haze { count: 0 }, vp)
    cx = gpu.cpu_new(s)
    gpu.cpu_set_frag_coord(cx, 10.5, 6.5)
    pa = gpu.v2(10.5 / 48.0, 6.5 / 32.0)
    got = gpu.cpu_run(cx, pa)
    heap.free(pa)
    out = lanes.f32x4(0.0, 0.0, 0.0, 0.0)
    if got == null {
        println("  cpu_run composite: ${gpu.last_error()}")
    } else {
        out = lanes.f32x4(gpu.val_x(got), gpu.val_y(got), gpu.val_z(got), gpu.val_w(got))
        gpu.val_free(got)
    }
    gpu.cpu_free(cx)
    gpu.shader_free(s)
    return out
}

// A w by h picture of one colour and alpha.
flat_image(r: float, g: float, b: float, a: float) -> *ShaderImage {
    img = image_new(8, 8)
    y = 0
    while y < 8 {
        x = 0
        while x < 8 {
            image_set(img, x, y, r, g, b, a)
            x = x + 1
        }
        y = y + 1
    }
    return img
}

main() {
    println("composite: the frame's tone curve written with quote")
    blank = composite.composite(Texture { image: null }, Texture { image: null }, Texture { image: null }, 1.0, 0, 0, 0.0, 0, Haze { count: 0 },
                                zero_mat4())
    _l = gpu.link(gpu.screen_vertex(), blank)
    vk = gpu.emit_glsl(blank, gpu.VULKAN)
    gl = gpu.emit_glsl(blank, gpu.GL)
    if vk == "" || gl == "" { println("  emit composite: ${gpu.last_error()}") }
    golden_is(vk, "tests/fixtures/gpu/composite.frag")
    compiles("composite", vk, "frag", false)
    golden_is(gl, "tests/fixtures/gpu/composite_gl.frag")
    compiles("composite_gl", gl, "frag", true)

    // The block, in the order the body reads it: the haze first, a struct
    // of 144 bytes (its count, then its columns and shapes on sixteen-byte
    // boundaries), the capture channel after it, the camera a mat4 at the
    // next sixteen, the floats last.
    check("the block holds its seven captures (${gpu.params_count(blank)})", gpu.params_count(blank) == 7)
    check("the haze is a Haze at 0, the capture channel after its 144 bytes, the camera a mat4 at 160",
          gpu.params_name(blank, 0) == "haze" && gpu.params_type(blank, 0) == "Haze" && gpu.params_offset(blank, 0) == 0 &&
          gpu.params_name(blank, 1) == "capture_channel" && gpu.params_offset(blank, 1) == 144 &&
          gpu.params_type(blank, 2) == "mat4" && gpu.params_offset(blank, 2) == 160 && gpu.params_size(blank) == 240)
    check("the haze is declared a struct of a count and two vec4[4] arrays, before the block that holds it",
          string.contains(vk, "struct Haze {\n    int count;\n    vec4 column[4];\n    vec4 shape[4];\n};\nlayout(std140") != 0 &&
          string.contains(vk, "    Haze haze;\n") != 0 && string.contains(gl, "uniform Haze haze;\n") != 0)
    check("the loop reads a column and a shape by its index",
          string.contains(vk, "vec4 column = haze.column[kk];") != 0 && string.contains(vk, "vec4 shape = haze.shape[kk];") != 0)
    check("OpenGL sets it a value at a time: the count, then each column and shape at sixteen apart (${gpu.uniforms_count(blank)})",
          gpu.uniforms_count(blank) == 15 && gpu.uniforms_name(blank, 0) == "haze.count" &&
          gpu.uniforms_offset(blank, 0) == 0 && gpu.uniforms_type(blank, 0) == "int" &&
          gpu.uniforms_name(blank, 1) == "haze.column[0]" && gpu.uniforms_offset(blank, 1) == 16 &&
          gpu.uniforms_name(blank, 4) == "haze.column[3]" && gpu.uniforms_offset(blank, 4) == 64 &&
          gpu.uniforms_name(blank, 5) == "haze.shape[0]" && gpu.uniforms_offset(blank, 5) == 80 &&
          gpu.uniforms_name(blank, 8) == "haze.shape[3]" && gpu.uniforms_offset(blank, 8) == 128 &&
          gpu.uniforms_type(blank, 8) == "vec4" && gpu.uniforms_name(blank, 9) == "capture_channel" &&
          gpu.uniforms_offset(blank, 9) == 144)

    // params_write: the haze from its cell to its places in the block.
    _sh = composite.set_haze(blank, 3, null)
    hz = composite.haze_of(blank)
    hz.column[2] = vec4(vec3(1.5, 2.5, 3.5), 4.5)
    hz.shape[3] = vec4(vec3(-1.0, 7.25, 0.125), 9.0)
    block = calloc(1, gpu.params_size(blank))
    gpu.params_write(blank, block)
    bi = block as int[]
    bf = block as f32[]
    check("params_write puts the haze's count at 0, column 2 at 48 and shape 3 at 128",
          bi[0] == 3 && bf[12] == 1.5 && bf[13] == 2.5 && bf[14] == 3.5 && bf[15] == 4.5 && bf[32] == -1.0 &&
          bf[33] == 7.25 && bf[34] == 0.125 && bf[35] == 9.0 && bf[4] == 0.0)
    free(block)
    // set_haze: the columns' 16 words, then the shapes', word for word.
    words = calloc(32, 4) as f32[]
    wi = 0
    while wi < 32 {
        words[wi] = (wi * 0.5 + 0.25) as f32
        wi = wi + 1
    }
    _sw = composite.set_haze(blank, 2, words as ptr)
    sc = (hz.column[1]) as f32x4
    ss = (hz.shape[3]) as f32x4
    check("set_haze copies the columns, then the shapes, word for word (${sc.x}, ${ss.w})",
          hz.count == 2 && sc.x == 2.25 && sc.w == 3.75 && ss.x == 14.25 && ss.w == 15.75)
    free(words as ptr)

    // A struct of float[4]: doubles eight bytes apart in the cell, at
    // sixteen in the block; a field read but not placed, refused.
    wv = Waves { gain: 0.75 }
    wv.amplitude[0] = 0.5
    wv.amplitude[1] = 1.25
    wv.amplitude[2] = 2.5
    wv.amplitude[3] = -3.0
    ws = waves_shader(wv)
    wglsl = gpu.emit_glsl(ws, gpu.VULKAN)
    check("a captured struct of float[4] is a GLSL struct of a float[4]",
          string.contains(wglsl, "struct Waves {\n    float gain;\n    float amplitude[4];\n};") != 0)
    compiles("waves", wglsl, "frag", false)
    wb = calloc(1, gpu.params_size(ws))
    gpu.params_write(ws, wb)
    wf = wb as f32[]
    check("its floats are repacked sixteen bytes apart, after the gain (size ${gpu.params_size(ws)})",
          gpu.params_size(ws) == 80 && wf[0] == 0.75 && wf[4] == 0.5 && wf[8] == 1.25 && wf[12] == 2.5 && wf[16] == -3.0)
    free(wb)
    wcx = gpu.cpu_new(ws)
    wp = gpu.v2(0.25, 0.5)
    wgot = gpu.cpu_run(wcx, wp)
    if wgot == null { println("  cpu_run waves: ${gpu.last_error()}") }
    check("the CPU reads its elements from the cell",
          wgot != null && gpu.val_x(wgot) == 1.25 && gpu.val_y(wgot) == -3.0 && gpu.val_z(wgot) == 0.75)
    if wgot != null { gpu.val_free(wgot) }
    heap.free(wp)
    gpu.cpu_free(wcx)
    gpu.shader_free(ws)
    us = unplaced_shader(wv)
    refused = gpu.emit_glsl(us, gpu.VULKAN) == ""
    check("a field the body reads that nothing placed is refused (${gpu.last_error()})",
          refused && string.contains(gpu.last_error(), "placed no amplitude") != 0)
    gpu.shader_free(us)
    check("its three textures are the light, the bloom and the depth of field, in that order",
          gpu.samplers_count(blank) == 3 && gpu.samplers_name(blank, 0) == "screen" &&
          gpu.samplers_name(blank, 1) == "bloom" && gpu.samplers_name(blank, 2) == "dof")
    check("haze_screen's out float is a HazePoint it returns",
          string.contains(vk, "struct HazePoint {\n    vec2 at;\n    float w;\n};") != 0 &&
          string.contains(vk, "return HazePoint(c.xy / max(c.w, 0.0001) * 0.5 + vec2(0.5), c.w);") != 0)
    check("the grain is the hand-written one's, over gl_FragCoord",
          string.contains(vk, "fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5") != 0)

    // ── On the CPU ──
    li = light()
    gw = glow()
    screen = texture_of(li)
    bloom = texture_of(gw)
    vp = camera()
    // Two columns of hot air in front of the camera, a third and fourth that
    // a count of two leaves out.
    h = Haze { count: 0 }
    h.column[0] = vec4(vec3(-0.6, 0.0, 0.0), 1.5)
    h.column[1] = vec4(vec3(0.9, 0.2, -1.0), 1.2)
    h.column[2] = vec4(vec3(0.0, 0.0, 2.0), 0.8)
    h.column[3] = vec4(vec3(-2.0, 0.0, -3.0), 0.6)
    h.shape[0] = vec4(vec3(2.0, 5.0, 1.3), 0.0)
    h.shape[1] = vec4(vec3(1.5, 4.0, 0.4), 0.0)
    h.shape[2] = vec4(vec3(2.5, 4.5, 2.2), 0.0)
    h.shape[3] = vec4(vec3(1.0, 3.0, 0.1), 0.0)
    plain = run_case(screen, bloom, 1.4, 0, 0, 0.0, 0, h, vp, 0, 0)
    check("the CPU tones the light as the shader written as Aether does, but for the grain (${plain.right} of 384)",
          plain.right == 384)
    bloomed = run_case(screen, bloom, 1.4, 0, 1, 0.35, 0, h, vp, 0, 0)
    check("and with the bloom added (${bloomed.right} of 384)", bloomed.right == 384)
    check("the bloom brightens most of the frame (${bloomed.moved} of 384)", bloomed.moved > 200)
    hazed = run_case(screen, bloom, 1.4, 0, 1, 0.35, 2, h, vp, 0, 1)
    check("two columns of hot air stand over some of the frame (${hazed.hazy} of 384)", hazed.hazy > 8 && hazed.hazy < 200)
    check("the CPU draws every pixel outside them as Aether does (${hazed.clear_right} of ${hazed.clear})",
          hazed.clear_right == hazed.clear)
    check("and ripples most inside them (${hazed.rippled} of ${hazed.hazy}), as Aether's does (${hazed.moved})",
          hazed.rippled * 2 > hazed.hazy && hazed.moved * 2 > hazed.hazy)
    four = run_case(screen, bloom, 1.4, 0, 1, 0.35, 4, h, vp, 2, 1)
    check("four columns stand over more of it than two (${four.hazy} against ${hazed.hazy})", four.hazy > hazed.hazy)
    check("the CPU draws every pixel outside the four as Aether does (${four.clear_right} of ${four.clear})",
          four.clear_right == four.clear)
    check("a count of two leaves the other two out: their pixels move with four (${four.moved})", four.moved > 0)
    captured = run_case(screen, bloom, 1.4, 3, 1, 0.35, 2, h, vp, 0, 0)
    check("a capture is passed through as data, no haze, bloom, curve or grain (${captured.right} of 384)",
          captured.right == 384 && captured.moved == 0)


    // ── Depth of field (#870): the screen's light moved toward the blurred by its alpha ──
    zero = flat_image(0.8, 0.2, 0.1, 0.0)
    full = flat_image(0.8, 0.2, 0.1, 1.0)
    half = flat_image(0.8, 0.2, 0.1, 0.5)
    middle = flat_image(0.5, 0.35, 0.2, 1.0)
    off = shade_dof(screen, bloom, texture_of(zero), 0, vp)
    on_zero = shade_dof(screen, bloom, texture_of(zero), 1, vp)
    check("a depth of field of alpha 0 is the frame without it (${on_zero.x} against ${off.x})",
          absf(on_zero.x - off.x) < 0.000001 && absf(on_zero.y - off.y) < 0.000001 && absf(on_zero.z - off.z) < 0.000001)
    // Alpha 1: the blurred light in the screen's place, the bloom still added:
    // the composite of a screen that is the blurred light.
    as_screen = shade_dof(texture_of(full), bloom, texture_of(zero), 0, vp)
    on_full = shade_dof(screen, bloom, texture_of(full), 1, vp)
    check("alpha 1 shows the blurred light in the screen's place, with the bloom added as before (${on_full.x} against ${as_screen.x})",
          absf(on_full.x - as_screen.x) < 0.000001 && absf(on_full.y - as_screen.y) < 0.000001 && absf(on_full.z - as_screen.z) < 0.000001)
    check("and it is not the frame without it (${on_full.x} against ${off.x})", absf(on_full.x - off.x) > 0.001)
    // Alpha a half: the middle of the two lights, which is the composite of a
    // screen that is that middle (the screen's light here is the image's pixel).
    s_here = rgb(texture(screen, vec2(10.5 / 48.0, 6.5 / 32.0))) as f32x4
    mixed_light = flat_image((s_here.x + 0.8) * 0.5, (s_here.y + 0.2) * 0.5, (s_here.z + 0.1) * 0.5, 1.0)
    as_middle = shade_dof(texture_of(mixed_light), bloom, texture_of(zero), 0, vp)
    on_half = shade_dof(screen, bloom, texture_of(half), 1, vp)
    check("alpha a half is the middle of the screen's light and the blurred (${on_half.x} against ${as_middle.x})",
          absf(on_half.x - as_middle.x) < 0.00001 && absf(on_half.y - as_middle.y) < 0.00001 && absf(on_half.z - as_middle.z) < 0.00001)
    image_free(zero)
    image_free(full)
    image_free(half)
    image_free(middle)
    image_free(mixed_light)

    // The curve itself, at three points: black stays black, the grain aside;
    // ACES of one is 0.8038; the sRGB encoding of it is 0.9082.
    a1 = composite.aces(splat3(1.0)) as f32x4
    check("ACES of one is 0.8038 (${a1.x})", absf(a1.x - 0.80377) < 0.0001)
    check("the sRGB encoding is linear below 0.0031308 and a power above",
          absf(composite.srgb_encode(0.002) - 0.02584) < 0.00001 && absf(composite.srgb_encode(0.8038) - 0.9082) < 0.0005)

    gpu.shader_free(blank)
    image_free(gw)
    image_free(li)
    if g_failures > 0 {
        println("composite: ${g_failures} of ${g_checks} checks failed")
        exit(1)
    }
    println("composite: all checks passed (${g_checks})")
}
