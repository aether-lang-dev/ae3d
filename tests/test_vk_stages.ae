// The Vulkan frame's stages, each charged with its own work (AE3D_PERF, the
// agent's timing). The stamps that close "camera depth" and "occlusion"
// were written beside the next ones, so the opaque draws were reported as
// camera depth and every transparent draw as occlusion: a game of glTF
// props read "camdepth 31 ms", and one of particles "occlusion 34 ms", and
// went looking for the wrong thing.
//
// Ambient occlusion is on, so the frame resolves its depth between the
// opaque and the transparent draws: the scene pass ends there. A device
// layered over Metal (MoltenVK) times only at a pass's edges, so that is
// where its stages can be told apart; without the split its opaque stage is
// the whole scene pass (docs/performance.md, "Measuring").
//
// Two scenes, each heavy in one kind of draw (layers of large surfaces,
// filling the frame many times over):
//   - opaque: the opaque stage carries it; camera depth is nothing;
//   - transparent: the transparent stage carries it, more than the
//     occlusion stage before it.
// Compared stage against stage, not against a number of milliseconds, so a
// faster or slower device holds the same. Headless; SKIP without Vulkan.

import std.list
import ae3d.core
import ae3d.vulkan
import ae3d.loader

const WIDTH = 640
const HEIGHT = 360
const LAYERS = 120
const FRAMES = 18

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

extern exit(code: int)

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

// LAYERS large quads facing the camera, one behind another: opaque, or
// half see-through (drawn in the transparent pass, every layer blended).
layers(backend: *Backend, see_through: bool) -> ptr {
    out = list.new()
    i = 0
    while i < LAYERS {
        m = loader.quad(200.0, 200.0)
        core.model_rotate(m, 90.0, 0.0, 0.0)
        core.model_set_position(m, 0.0, 0.0, 0.0 - (i as float) * 0.5)
        core.model_matte(m, 0.5, 0.6, 0.7)
        if see_through { core.model_set_alpha(m, 0.5) }
        core.model_recalculate_bounds(m)
        core.backend_add_model(backend, m)
        list.add_raw(out, m as ptr)
        i = i + 1
    }
    return out
}

drop_layers(backend: *Backend, models: ptr) {
    i = 0
    while i < list.size(models) {
        m = list.get_raw(models, i) as *Model
        core.backend_remove_model(backend, m)
        core.model_free(m)
        i = i + 1
    }
    list.free(models)
}

// Each stage's milliseconds, the median of its frames after the first two
// (the stamps read back are the last finished frame's). A median and not a
// sum: under MoltenVK a stamp is sampled at an encoder's edge, and one frame
// in a few has a stage take in the wait before its pass began -- camera
// depth, two stamps side by side, read 18 ms on one frame of six -- which a
// sum hands to the whole.
measure(backend: *Backend, r: *VKRenderer, cam: *Camera, light: *Light, out: float[]) {
    n = FRAMES - 2
    block = calloc(n * vulkan.STAGE_COUNT, 8)
    seen = block as float[]
    frame = 0
    while frame < FRAMES {
        core.backend_render(backend, cam, light)
        if frame >= 2 {
            k = 0
            while k < vulkan.STAGE_COUNT {
                seen[k * n + frame - 2] = vulkan.renderer_stage_ms(r, k)
                k = k + 1
            }
        }
        frame = frame + 1
    }
    k = 0
    while k < vulkan.STAGE_COUNT {
        out[k] = median(seen, k * n, n)
        k = k + 1
    }
    free(block)
}

// The median of v[from .. from + n), sorted in place.
median(v: float[], from: int, n: int) -> float {
    a = 1
    while a < n {
        x = v[from + a]
        b = a - 1
        while b >= 0 && v[from + b] > x {
            v[from + b + 1] = v[from + b]
            b = b - 1
        }
        v[from + b + 1] = x
        a = a + 1
    }
    if n % 2 == 1 { return v[from + n / 2] }
    return (v[from + n / 2 - 1] + v[from + n / 2]) * 0.5
}

main() {
    println("vk_stages: each stage of the Vulkan frame charged with its own work")
    if !vulkan.available() {
        println("vk_stages: SKIP no Vulkan driver (${vulkan.last_error()})")
        return
    }
    r = vulkan.renderer_new()
    backend = vulkan.backend(r)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("vk_stages: SKIP Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(r)
        return
    }
    vulkan.renderer_set_ssao(r, true, 3.0, 1.0)
    // The prepass off: what is held here is which stage a cost is charged
    // to, and the opaque layers lit in full make a cost no other stage's
    // noise reaches (test_vk_prepass holds the prepass).
    vulkan.renderer_set_prepass(r, false)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 20.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    block = calloc(vulkan.STAGE_COUNT, 8)
    ms = block as float[]

    solid = layers(&backend, false)
    measure(&backend, r, cam, light, ms)
    opaque = ms[5]
    camdepth = ms[3]
    println("    opaque scene: camdepth ${camdepth}, opaque ${opaque}, occlusion ${ms[6]}, transparent ${ms[7]} ms a frame, the median of ${FRAMES - 2}")
    check("the opaque draws are the opaque stage's", opaque > 0.0 && opaque > ms[6] && opaque > ms[7])
    // Two stamps side by side: what they read is the timer's own step.
    check("and camera depth, a pass there is no more, costs nothing (under 0.1 ms a frame)", camdepth < 0.1)
    drop_layers(&backend, solid)

    glass = layers(&backend, true)
    measure(&backend, r, cam, light, ms)
    println("    transparent scene: camdepth ${ms[3]}, opaque ${ms[5]}, occlusion ${ms[6]}, transparent ${ms[7]} ms a frame, the median of ${FRAMES - 2}")
    check("the transparent draws are the transparent stage's, not the occlusion's", ms[7] > 0.0 && ms[7] > ms[6] && ms[7] > ms[5])
    drop_layers(&backend, glass)

    free(block)
    core.light_free(light)
    core.camera_free(cam)
    core.backend_cleanup(&backend)
    vulkan.renderer_free(r)
    if g_failures == 0 {
        println("vk_stages: all checks passed (${g_checks})")
    } else {
        println("vk_stages: ${g_failures} of ${g_checks} checks FAILED")
        exit(1)
    }
}
