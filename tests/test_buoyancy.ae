// Bodies that float on the Gerstner sea (#637), held to numbers. No window:
// the engine is stepped by hand at 60 Hz.
//
//   - the CPU's surface is the shader's: a vertex where the shader draws it
//     is at the height the query gives over it, to the millimetre;
//   - Archimedes: on a calm sea a box half water's density settles with
//     half of it under, its middle at the surface; a quarter's, a quarter;
//   - on a swell a floating box rises and falls with the water under it.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.water
import ae3d.buoyancy

extern exit(code: int)

const STEP = 0.016666666666666666

var g_checks = 0
var g_failures = 0

check(name: string, ok: bool) {
    g_checks = g_checks + 1
    if ok {
        println("  ok   ${name}")
    } else {
        g_failures = g_failures + 1
        println("  FAIL ${name}")
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// A sea 200 m across, its waves `amplitude` metres and some twenty long.
sea(amplitude: float) -> *Simulation {
    w = water.simulation_new(200.0, amplitude)
    water.simulation_set_wave_scale(w, 400.0)
    water.simulation_build(w, 32)
    return w
}

// A metre box of `density` kilograms a cubic metre, dropped at a height.
crate(e: *Engine, density: float, drop: float) -> *Rigidbody {
    box = engine.object(e, "crate", loader.cube(1.0))
    behaviour.object_set_position(box, core.vec3(0.0, drop, 0.0))
    rb = physics.rigidbody(box, physics.DYNAMIC)
    physics.box_collider(box, core.vec3(0.5, 0.5, 0.5), physics.material(0.5, 0.0), density)
    return rb
}

steps(e: *Engine, w: *Simulation, n: int) {
    k = 0
    while k < n {
        water.simulation_update(w, STEP)
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

// Where a box of `density` settles on a calm sea after ten seconds: its
// middle's height and the share of it under.
settle(density: float) -> (float, float) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    w = sea(0.0)
    rb = crate(e, density, 1.5)
    f = buoyancy.floater(w, rb, core.vec3(0.5, 0.5, 0.5))
    steps(e, w, 600)
    at = behaviour.object_position(rb.object as *GameObject).y
    under = buoyancy.floater_submerged(f)
    buoyancy.floater_free(f)
    water.simulation_free(w)
    engine.engine_free(e)
    return at, under
}

main() {
    println("buoyancy: bodies on the Gerstner sea (#637)")

    // The surface on the CPU, over a swell at some time: a vertex where the
    // shader draws it has the height the query says over it.
    w = sea(0.6)
    water.simulation_update(w, 3.7)
    worst = 0.0
    i = 0
    while i < 40 {
        drawn = water.simulation_displaced(w, (i as float) * 2.3 - 40.0, (i as float) * 1.7 - 30.0)
        off = abs_of(water.simulation_height_at(w, drawn.x, drawn.z) - drawn.y)
        if off > worst { worst = off }
        i = i + 1
    }
    println("  over a 0.6 m swell a drawn vertex is at most ${worst} m off the height the query gives over it")
    check("the surface's height is where the shader draws it, to the millimetre", worst < 0.001)
    water.simulation_free(w)

    // Archimedes on a calm sea.
    half_at, half_under = settle(500.0)
    quarter_at, quarter_under = settle(250.0)
    println("  calm: a box half water's density settles at ${half_at} m with ${half_under} under; a quarter's at ${quarter_at} m, ${quarter_under} under")
    check("a box half water's density floats half under, its middle at the surface", abs_of(half_under - 0.5) < 0.03 && abs_of(half_at) < 0.04)
    check("a quarter's floats a quarter under, higher", abs_of(quarter_under - 0.25) < 0.03 && quarter_at > half_at + 0.2)

    // On a swell.
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    w = sea(0.6)
    rb = crate(e, 500.0, 0.5)
    f = buoyancy.floater(w, rb, core.vec3(0.5, 0.5, 0.5))
    steps(e, w, 240)
    box_low = 100.0
    box_high = 0.0 - 100.0
    sea_low = 100.0
    sea_high = 0.0 - 100.0
    k = 0
    while k < 900 {
        steps(e, w, 1)
        p = behaviour.object_position(rb.object as *GameObject)
        h = water.simulation_height_at(w, p.x, p.z)
        if p.y < box_low { box_low = p.y }
        if p.y > box_high { box_high = p.y }
        if h < sea_low { sea_low = h }
        if h > sea_high { sea_high = h }
        k = k + 1
    }
    println("  on a 0.6 m swell for 15 s: the box rose and fell ${box_high - box_low} m, the water under it ${sea_high - sea_low} m")
    check("on a swell a floating box rises and falls with the water under it", box_high - box_low > (sea_high - sea_low) * 0.6 && sea_high - sea_low > 0.3)
    buoyancy.floater_free(f)
    water.simulation_free(w)
    engine.engine_free(e)

    if g_failures == 0 {
        println("buoyancy: all checks passed (${g_checks})")
    } else {
        println("buoyancy: ${g_failures} failure(s) of ${g_checks}")
        exit(1)
    }
}
