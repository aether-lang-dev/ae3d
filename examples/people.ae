// A person in a few lines (ae3d.character, #903): walked with the keys, a
// log to sit on, a pistol to aim. The README's animation example is this.
//
//   WASD walks, shift runs, E sits on the log when near it or gets up, the
//   right mouse button aims at what is ahead, the left drags the camera
//   round.
//
// Under the one call: motion capture retargeted onto the figure (100STYLE's
// neutral walks and runs as a 2D blend, a start and a stop that enter on
// their feet, a stand), feet locked on the ground and stepping as it turns,
// eyes where it goes, an aim offset from the figure's own pistol takes, and
// the log's slot walked to, turned at and sat on by warping its take.
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.input
import ae3d.loader
import ae3d.orbitcam
import ae3d.usable
import ae3d.character

const PEOPLE = "tests/fixtures/people/"
const WALK = 1.3
const RUN = 3.2
// Metres from a slot's approach point E sits from.
const NEAR = 2.5

struct People {
    hero: ptr                      // *Character
    usables: ptr                   // *Usables
    orbit: ptr                     // *Orbit
}

steer(state: ptr, e: *Engine, delta: float) {
    p = state as *People
    hero = p.hero as *Character
    keys = engine.engine_input(e)
    at = behaviour.object_position(character.object_of(hero))
    // The keys along the ground as the camera looks.
    eye = orbitcam.orbit_eye(p.orbit as *Orbit)
    ahead = core.vec3(at.x - eye.x, 0.0, at.z - eye.z)
    if core.v3_len(ahead) > 0.0001 { ahead = core.v3_normalize(ahead) }
    right = core.vec3(0.0 - ahead.z, 0.0, ahead.x)
    way = core.v3_add(core.v3_mul(ahead, input.axis(keys, "ahead")), core.v3_mul(right, input.axis(keys, "right")))
    if core.v3_len(way) > 1.0 { way = core.v3_normalize(way) }
    speed = WALK
    if input.held(keys, "run") { speed = RUN }
    character.move(hero, core.v3_mul(way, speed), core.vec3(0.0, 0.0, 0.0))
    // E: the nearest free seat within reach, or up from it.
    if input.pressed(keys, "use") {
        if character.using(hero) {
            character.leave(hero)
        } else {
            u = p.usables as *Usables
            s = usable.find(u, at, NEAR, "sit", hero as ptr)
            if s >= 0 { _sat = character.use(hero, u, s) }
        }
    }
    if input.held(keys, "aim") {
        character.aim(hero, core.vec3(at.x + ahead.x * 10.0, at.y + 1.4, at.z + ahead.z * 10.0))
    } else {
        character.aim_off(hero)
    }
    orbitcam.orbit_set_target(p.orbit as *Orbit, core.vec3(at.x, at.y + 1.2, at.z))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - people")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    light = core.light_sun(core.vec3(0.4, 0.8, 0.5))
    engine.engine_set_light(e, light)
    engine.engine_set_shadows(e, true)
    engine.engine_set_time_of_day(e, 16.0)
    keys = engine.engine_input(e)
    input.bind_axis(keys, "ahead", platform.KEY_W, platform.KEY_S)
    input.bind_axis(keys, "right", platform.KEY_D, platform.KEY_A)
    input.bind_key(keys, "run", platform.KEY_LEFT_SHIFT)
    input.bind_key(keys, "use", platform.KEY_E)
    input.bind_mouse(keys, "aim", platform.MOUSE_RIGHT)
    ground = loader.plane(2, 40.0)
    core.model_set_position(ground, 0.0 - 20.0, 0.0, 0.0 - 20.0)
    core.model_matte(ground, 0.34, 0.35, 0.33)
    engine.object(e, "Ground", ground)

    // The person: the figure, its gaits by role, and from then on asked.
    gaits = character.gaits("${PEOPLE}100style/neutral")
    character.gaits_set(gaits, character.GAIT_STOP, "${PEOPLE}100style/neutral_arrive.bvh")
    character.gaits_set(gaits, character.GAIT_START, "${PEOPLE}100style/startstop_start.bvh")
    hero = character.humanoid(e, "Hero", "${PEOPLE}ual1_rigify.glb", gaits)
    if hero == null {
        println("people: ${character.error()}")
        return
    }
    _armed = character.aims(hero, e, "${PEOPLE}ual1_rigify.glb", "Pistol_Aim_Neutral", "Pistol_Aim_Up", "Pistol_Aim_Down")

    // A log to sit on, 3 m ahead: its kind a data file of slots.
    u = usable.usables_new(2.0)
    log = engine.object(e, "Log", null)
    behaviour.object_set_position(log, core.vec3(0.0, 0.0, 3.0))
    kind = usable.kind_read("tests/fixtures/usable/log.usable")
    usable.add(u, log, kind)
    wood = loader.cube(1.0)
    core.model_matte(wood, 0.36, 0.25, 0.16)
    trunk = engine.object(e, "Log mesh", wood)
    behaviour.object_set_position(trunk, core.vec3(0.0, 0.2, 3.0))
    behaviour.object_set_scale(trunk, core.vec3(1.2, 0.4, 0.4))

    orbit = orbitcam.orbit_new(core.vec3(0.0, 1.2, 0.0), 5.0, 200.0, 0.0 - 15.0)
    orbitcam.orbit_set_button(orbit, platform.MOUSE_LEFT)
    orbitcam.attach(e, orbit, engine.engine_camera(e))
    people = People { hero: hero as ptr, usables: u as ptr, orbit: orbit as ptr }
    b = engine.behaviour_new("people", (&people) as ptr)
    b.update = steer
    engine.engine_add_behaviour(e, b)

    engine.engine_run(e)

    character.character_free(hero)
    character.gaits_free(gaits)
    usable.usables_free(u)
    usable.kind_free(kind)
    orbitcam.orbit_free(orbit)
    engine.engine_free(e)
    core.light_free(light)
}
