// Things afloat on a swell (#637): crates, a plank and a raft of different
// sizes and densities dropped on the Gerstner sea, each floated by
// ae3d.buoyancy on the waves as they are drawn -- the light ones riding high,
// the heavy ones low, all of them heaving, rolling and pitching with the
// water under them; and a boat driven round them in a circle, its wake and
// the crates' rings drawn as ripples over the swell (ae3d.ripples). Fly
// round them (WASD, the right mouse button to look).
//
//   ./build.sh examples/floating.ae && ./build/floating
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.water
import ae3d.buoyancy
import ae3d.ripples

const HOUR = 15.5
const CIRCLE = 11.0                    // metres round the crates the boat runs
var g_sea: ptr = null
var g_ripples: ptr = null
var g_boat: ptr = null                 // *Rigidbody
var g_turn = 0.0

// A box `half` extents about its middle, of `density`, dropped at (x, z).
floating(e: *Engine, sea: *Simulation, name: string, x: float, z: float, half: Vec3, density: float,
         r: float, g: float, b: float) -> *Rigidbody {
    m = loader.cube(1.0)
    core.model_set_diffuse(m, r, g, b)
    core.model_set_pbr(m, 0.0, 0.8)
    box = engine.object(e, name, m)
    behaviour.object_set_scale(box, core.vec3(half.x * 2.0, half.y * 2.0, half.z * 2.0))
    behaviour.object_set_position(box, core.vec3(x, 1.5, z))
    rb = physics.rigidbody(box, physics.DYNAMIC)
    physics.box_collider(box, half, physics.material(0.5, 0.0), density)
    buoyancy.floater(sea, rb, half)
    return rb
}

start(state: ptr, go: *GameObject) {
    e = engine.of(go)
    // Waves some twenty metres long and half a metre high: a harbour's
    // swell, not an ocean's.
    sea = water.simulation_new(600.0, 0.55)
    water.simulation_set_wave_scale(sea, 400.0)
    water.simulation_set_wave_height(sea, 1.0)
    water.simulation_set_color(sea, 0.03, 0.13, 0.19)
    // It mirrors the sky the engine draws for the hour (#742).
    water.simulation_set_sky_capture(sea, true)
    water.simulation_set_reflection(sea, 0.8)
    water.simulation_set_normal_strength(sea, 1.4)
    water.simulation_set_foam(sea, true, 0.25)
    water.simulation_set_opacity(sea, 0.95)
    // The small waves things make: 48 m round the middle, a cell a
    // fifth of a metre.
    waves = ripples.ripples_new(256, 48.0, 0.0, 0.0)
    g_ripples = waves as ptr
    water.simulation_set_ripples(sea, waves)
    surface = water.simulation_build(sea, 384)
    if surface == null {
        println("floating: could not build the sea")
        return
    }
    engine.engine_add_model(e, surface)
    g_sea = sea as ptr
    // Crates: pine (about 500 kg a cubic metre) rides half under, a light
    // one higher; a long plank and a wide raft roll and pitch on the swell.
    floating(e, sea, "crate", 0.0, 0.0, core.vec3(0.5, 0.5, 0.5), 500.0, 0.55, 0.38, 0.2)
    floating(e, sea, "light crate", 3.0, 1.5, core.vec3(0.4, 0.4, 0.4), 250.0, 0.7, 0.55, 0.3)
    floating(e, sea, "heavy crate", -2.5, 2.0, core.vec3(0.45, 0.45, 0.45), 800.0, 0.35, 0.25, 0.15)
    floating(e, sea, "plank", 1.5, -3.0, core.vec3(1.6, 0.08, 0.2), 450.0, 0.6, 0.45, 0.28)
    floating(e, sea, "raft", -4.0, -2.0, core.vec3(1.2, 0.15, 1.0), 400.0, 0.5, 0.4, 0.25)
    floating(e, sea, "buoy", 5.0, -1.5, core.vec3(0.3, 0.6, 0.3), 300.0, 0.85, 0.2, 0.12)
    g_boat = floating(e, sea, "boat", CIRCLE, 0.0, core.vec3(1.4, 0.25, 0.55), 300.0, 0.82, 0.8, 0.76) as ptr
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(14.0, 7.0, 17.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
}

// The boat driven round the circle: pulled toward the point a little ahead
// of it on the circle, so it runs round and leaves its wake.
update(state: ptr, go: *GameObject, delta: float) {
    if g_sea != null { water.simulation_update(g_sea as *Simulation, delta) }
    if g_boat == null { return }
    rb = g_boat as *Rigidbody
    g_turn = g_turn + delta * 0.32
    ahead = core.vec3(CIRCLE * core.cos_of(g_turn), 0.0, CIRCLE * core.sin_of(g_turn))
    at = behaviour.object_position(rb.object as *GameObject)
    pull = core.v3_sub(ahead, core.vec3(at.x, 0.0, at.z))
    if core.v3_len(pull) > 0.01 {
        physics.rigidbody_apply_force(rb, core.v3_mul(core.v3_normalize(pull), 2600.0))
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - floating")
    engine.engine_set_time_of_day(e, HOUR)
    engine.engine_set_camera_input(e, true)
    physics.attach(e)
    game = engine.object(e, "floating", null)
    engine.script(game, "floating", null, start, update)
    engine.engine_run(e)
    if g_sea != null { water.simulation_free(g_sea as *Simulation) }
    if g_ripples != null { ripples.ripples_free(g_ripples as *Ripples) }
    engine.engine_free(e)
}
