// Any glTF, on a ground, under a sun, playing one of its animations.
//
//   ./build/gltf_viewer path/to/model.glb [animation]
//   AE3D_ANIM=Run ./build/gltf_viewer Fox.glb
//
// A figure from Mixamo, Sketchfab, a Quaternius pack or another engine's
// export is dropped in and looked at, its skins bending and its clips
// playing, without passing through Blender first. With no animation named,
// the file's first one plays; the rest are listed.
//
// The camera frames the model whatever its size and wherever its origin
// (engine_frame_points, #471): every vertex where it is drawn, through the
// skin's pose at each of sixteen points of the clip, fills 55% of the frame's
// height from a three-quarter view a little above it, with the near and far
// planes fitted to it -- a fox a hundred units long, a centimetre-high arm and
// a giant are all seen whole, and the whole clip plays inside that framing.
// WASD and the right mouse fly from there; F frames it again.
import std.string
import std.os
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.input
import ae3d.loader
import ae3d.gltf
import ae3d.anim
import ae3d.skin
import ae3d.viewpoint

var g_path = ""
var g_animation = ""
var g_scene: ptr = null
var g_floor: ptr = null
var g_light: ptr = null
// What the camera frames: the model's vertices over its clip.
var g_framed: ptr = null

extern fmax(a: float, b: float) -> float

// The framing: 55% of the frame's height, from the model's front-right
// (a glTF figure faces +z) and a little above.
const SHARE = 0.55
const YAW = 0.0 - 115.0
const PITCH = 0.0 - 14.0
// Points of the clip the framing holds the model at.
const SAMPLES = 16

start(state: ptr, go: *GameObject) {
    e = engine.of(go)
    scene = gltf.load(g_path)
    if scene == null {
        println("gltf_viewer: ${gltf.last_error()}")
        return
    }
    g_scene = scene as ptr
    i = 0
    while i < gltf.warning_count(scene) {
        println("gltf_viewer: not read: ${gltf.warning(scene, i)}")
        i = i + 1
    }
    println("gltf_viewer: ${g_path}: ${gltf.model_count(scene)} nodes, ${gltf.primitive_count(scene)} meshes, ${gltf.skeleton_count(scene)} skins, ${gltf.animation_count(scene)} animations")

    // Every primitive into the scene.
    i = 0
    while i < gltf.primitive_count(scene) {
        m = gltf.primitive(scene, i)
        engine.engine_add_model(e, m)
        core.model_sync_transform(m)
        i = i + 1
    }

    // The animation: the one asked for, else the first.
    a = 0
    while a < gltf.animation_count(scene) {
        println("gltf_viewer: animation '${gltf.animation_name(scene, a)}'")
        a = a + 1
    }
    if gltf.animation_count(scene) > 0 {
        wanted = g_animation
        if wanted == "" { wanted = gltf.animation_name(scene, 0) }
        made = gltf.play(scene, wanted, engine.engine_animations(e) as *Registry, true)
        println("gltf_viewer: playing '${wanted}' on ${made} nodes")
    }

    // What is framed: every vertex where it is drawn -- a skin's through its
    // bones' pose -- at SAMPLES points of the clip, so the framing holds the
    // model through all of it and never has to chase it.
    pts = viewpoint.points_new()
    g_framed = pts as ptr
    gather_the_clip(e, scene, pts)
    if viewpoint.points_count(pts) == 0 {
        viewpoint.points_add_box(pts, core.vec3(0.0 - 1.0, 0.0, 0.0 - 1.0), core.vec3(1.0, 2.0, 1.0))
    }
    lo = viewpoint.points_lo(pts)
    hi = viewpoint.points_hi(pts)
    size = core.v3_sub(hi, lo)
    extent = fmax(size.x, fmax(size.y, size.z))
    centre = core.v3_mul(core.v3_add(lo, hi), 0.5)
    println("gltf_viewer: bounds ${lo.x},${lo.y},${lo.z} to ${hi.x},${hi.y},${hi.z}, over ${viewpoint.points_count(pts)} vertex positions")

    // A floor under the lowest point, a sun, and a camera that frames it.
    ground = loader.plane(2, extent * 6.0)
    core.model_set_position(ground, centre.x - extent * 3.0, lo.y, centre.z - extent * 3.0)
    core.model_matte(ground, 0.32, 0.33, 0.35)
    core.model_set_pbr(ground, 0.0, 0.85)
    engine.engine_add_model(e, ground)
    g_floor = ground as ptr

    light = core.light_directional(core.vec3(0.0 - 0.45, 0.0 - 1.0, 0.0 - 0.3), core.vec3(1.0, 0.97, 0.92), 2.4)
    engine.engine_set_light(e, light)
    g_light = light as ptr
    engine.engine_set_shadows(e, true)
    engine.engine_set_shadow_distance(e, extent * 4.0)
    engine.engine_set_time_of_day(e, 14.0)

    cam = engine.engine_camera(e)
    engine.engine_frame_points(e, pts, SHARE, YAW, PITCH, 0.0)
    core.camera_set_speed(cam, core.v3_distance(cam.position, centre) * 0.5)
    say_framing(cam, pts)
    input.bind_key(engine.engine_input(e), "frame", platform.KEY_F)
}

// F frames the model again, wherever the camera was flown.
update(state: ptr, go: *GameObject, delta: float) {
    e = engine.of(go)
    if g_framed == null { return }
    if input.pressed(engine.engine_input(e), "frame") {
        engine.engine_frame_points(e, g_framed as *Points, SHARE, YAW, PITCH, 0.0)
    }
}

// Every primitive's vertices where they are drawn, at SAMPLES points of the
// clip that plays (the pose as it stands when none does); the clip back at
// its start after.
gather_the_clip(e: *Engine, scene: *GltfScene, pts: *Points) {
    registry = engine.engine_animations(e) as *Registry
    duration = 0.0
    k = 0
    while k < anim.registry_count(registry) {
        length = anim.clip_duration(anim.player_clip(anim.binding_player(anim.registry_binding(registry, k))))
        if length > duration { duration = length }
        k = k + 1
    }
    samples = SAMPLES
    if duration <= 0.0 { samples = 1 }
    s = 0
    while s < samples {
        pose_at(registry, duration * (s as float) / (samples as float))
        i = 0
        while i < gltf.primitive_count(scene) {
            viewpoint.points_add_model(pts, gltf.primitive(scene, i))
            i = i + 1
        }
        s = s + 1
    }
    pose_at(registry, 0.0)
}

pose_at(registry: *Registry, time: float) {
    k = 0
    while k < anim.registry_count(registry) {
        binding = anim.registry_binding(registry, k)
        player = anim.binding_player(binding)
        anim.player_set_time(player, time)
        anim.apply(player, anim.binding_model(binding))
        k = k + 1
    }
}

// What the framing came to: the share of the frame's height and width the
// model spans, and the camera's planes.
say_framing(cam: *Camera, pts: *Points) {
    seen = viewpoint.coverage(cam, pts, cam.position, cam.front, cam.right, cam.up)
    println("gltf_viewer: framed from (${cam.position.x}, ${cam.position.y}, ${cam.position.z}): ${seen.x * 100.0}% of the frame's height, ${seen.y * 100.0}% of its width; near ${cam.near}, far ${cam.far}")
}

main() {
    g_path = "tests/fixtures/gltf/arm.glb"
    if os.aether_args_count() > 1 { g_path = os.aether_args_get(1) }
    if os.aether_args_count() > 2 { g_animation = os.aether_args_get(2) }
    env_anim = os.getenv("AE3D_ANIM")
    if env_anim != null { g_animation = core.text(env_anim) }

    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d: glTF")
    engine.engine_set_camera_input(e, true)
    engine.engine_set_post(e, true, true, 1.0, 0.5)
    game = engine.object(e, "Game", null)
    engine.script(game, "gltf viewer", null, start, update)
    if !engine.engine_run(e) { println("gltf_viewer: no window") }
    engine.engine_free(e)
    // After the engine: freeing the renderer released the GPU handles the
    // models were given.
    if g_scene != null { gltf.scene_destroy(g_scene as *GltfScene) }
    if g_floor != null { core.model_free(g_floor as *Model) }
    if g_light != null { core.light_free(g_light as *Light) }
    if g_framed != null { viewpoint.points_free(g_framed as *Points) }
}
