// ci: optimised -- its start-up builds its world on the CPU
// People on the street at the hour the light is longest: the zombie street
// (the same blocks street_drive drives, examples/lib/street) at half past
// five, its pavements walked and stood on by Quaternius's CC0 people
// (resources/people), every one of them on the animation pipeline.
//
//   ./build.sh examples/street_life.ae && ./build/street_life
//
// Each person's walk, jog and idle are the Rigify mannequin's authored clips,
// retargeted once for each skeleton the people come in and shared by everyone
// on it (animator.share_take): six people, two skeletons, six takes made.
// Their walk and jog are blended by the speed they are moved at, synced on
// their footfalls; their feet are held where they land and rest on the
// paving, the kerbs and the road as the physics world has them (ikrig, its
// ground read by ray); those who stand talk, their heads turned to each other.
// No bone is written by this file.
//
//   AE3D_TIME=HHMM     the hour (1730 by default; 1300 noon, 2200 night)
//   AE3D_PEOPLE=n      how many walk (12 by default)
//   AE3D_CAMX/Y/Z      where the camera stands, metres, and AE3D_AIMX/Y/Z what
//                      it looks at (by default from the pavement down the
//                      street, into the low sun; AE3D_AWAY=1 turns it to
//                      face away, the sun on the faces)

import std.list
import std.string
import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.assets
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.retarget
import ae3d.sky
import examples.lib.street

const MANIFEST = "resources/blender/zombie_street/manifest.json"
// The people's clips come from here: Quaternius's UAL1 on its Rigify rig.
const SOURCE = "tests/fixtures/people/ual1_rigify.glb"
const BLOCKS = 3
// The pavements' middles, either side of the road, and how far along the
// street the walkers go before they are put back at its other end, out of
// sight in the haze.
const PAVEMENT_Z = 5.1
const SPAN = 60.0

struct Person {
    object: ptr                    // *GameObject
    animator: ptr                  // *Animator
    gait: int                      // the blend of walk and jog, by speed
    speed: float                   // metres a second along x; 0 stands
    x: float
    z: float
    look: Vec3                     // where a stander looks: its partner's head
}

// The takes made for one skeleton (its joint count names it): every person
// on it shares them.
struct Takes {
    joints: int
    walk: ptr                      // *Take
    jog: ptr
    idle: ptr
}

struct Life {
    people: ptr                    // list of *Person
    takes: ptr                     // list of *Takes
    source_object: ptr             // *GameObject: the Rigify mannequin, kept out of sight
    seconds: float
}

hour() -> float {
    hhmm = core.env_int("AE3D_TIME", 1730)
    return ((hhmm / 100) as float) + ((hhmm % 100) as float) / 60.0
}

// The takes for animator `a`'s skeleton, made the first time a person on it
// is seen and shared after.
takes_for(life: *Life, e: *Engine, a: *Animator) -> *Takes {
    r = animator.rig(a)
    i = 0
    while i < list.size(life.takes) {
        t = list.get_raw(life.takes, i) as *Takes
        if t.joints == pose.count(r) { return t }
        i = i + 1
    }
    source_f = figure.figure_of(life.source_object as *GameObject)
    source = pose.of_skeleton(figure.skeleton(source_f))
    names = ["Walk_Loop", "Jog_Fwd_Loop", "Idle_Loop"]
    made = [null as ptr, null as ptr, null as ptr]
    k = 0
    while k < 3 {
        clip = clips.from_scene(source, figure.scene(source_f), names[k], 0.0)
        made[k] = retarget.retarget(source, clip, r) as ptr
        clips.take_free(clip)
        k = k + 1
    }
    pose.rig_free(source)
    t = heap.new(Takes)
    t.joints = pose.count(r)
    t.walk = made[0]
    t.jog = made[1]
    t.idle = made[2]
    list.add_raw(life.takes, t as ptr)
    return t
}

// A person from `path` at x on the pavement at z, walking at `speed` (one
// way or the other by its sign) or standing.
person(life: *Life, e: *Engine, title: string, path: string, x: float, z: float, speed: float) -> *Person {
    o = figure.figure(e, title, path)
    a = animator.attach(e, o)
    r = animator.rig(a)
    t = takes_for(life, e, a)
    gait = animator.add_blend(a, "gait")
    walk = animator.share_take(a, t.walk as *Take, false)
    jog = animator.share_take(a, t.jog as *Take, false)
    animator.blend_add(a, gait, walk, clips.speed(walk))
    animator.blend_add(a, gait, jog, clips.speed(jog))
    idle = animator.add_state(a, "idle", animator.share_take(a, t.idle as *Take, false), true)
    feet = ikrig.feet_new(r, o)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(a, feet)
    p = heap.new(Person)
    p.object = o as ptr
    p.animator = a as ptr
    p.gait = gait
    p.speed = speed
    p.x = x
    p.z = z
    if speed == 0.0 {
        animator.play(a, idle, 0.0)
    } else {
        animator.play(a, gait, 0.0)
        animator.set_param(a, gait, core.abs_of(speed))
    }
    place(p)
    list.add_raw(life.people, p as ptr)
    return p
}

// Where the person stands and the way it faces: along the street the way it
// walks (glTF's figures face +z; a quarter turn faces them along x).
place(p: *Person) {
    o = p.object as *GameObject
    behaviour.object_set_position(o, core.vec3(p.x, street.PAVEMENT_Y, p.z))
    if p.speed > 0.0 { behaviour.object_set_rotation(o, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0))) }
    if p.speed < 0.0 { behaviour.object_set_rotation(o, core.quat_rotate(0.0 - 1.5707963, core.vec3(0.0, 1.0, 0.0))) }
}

// Two people standing face to face, talking, each looking at the other.
pair(life: *Life, e: *Engine, a_path: string, b_path: string, x: float, z: float) {
    one = person(life, e, "Talker", a_path, x - 0.45, z, 0.0)
    two = person(life, e, "Talker", b_path, x + 0.45, z, 0.0)
    behaviour.object_set_rotation(one.object as *GameObject, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    behaviour.object_set_rotation(two.object as *GameObject, core.quat_rotate(0.0 - 1.5707963, core.vec3(0.0, 1.0, 0.0)))
    one.look = core.vec3(x + 0.45, street.PAVEMENT_Y + 1.6, z)
    two.look = core.vec3(x - 0.45, street.PAVEMENT_Y + 1.6, z)
    animator.look_at(one.animator as *Animator, one.look, 1.0)
    animator.look_at(two.animator as *Animator, two.look, 1.0)
}

start(state: ptr, go: *GameObject) {
    life = state as *Life
    e = engine.of(go)
    m = assets.manifest_load(MANIFEST)
    if m == null {
        println("street_life: ${assets.last_error()}")
        return
    }
    street.slab(e)
    b = 0
    while b < BLOCKS {
        k = b - BLOCKS / 2
        _ground, _props = street.block(e, m, "Block ${k}", street.BLOCK_LEN * (k as float), (k % 2) != 0)
        b = b + 1
    }
    // The clips' source, out of sight under the street.
    life.source_object = figure.figure(e, "Source", SOURCE) as ptr
    behaviour.object_set_position(life.source_object as *GameObject, core.vec3(0.0, 0.0 - 50.0, 0.0))

    // From the pavement, at a person's eyes, down the street toward the sun.
    h = hour()
    sun = sky.sun_direction(h)
    along = 1.0
    if sun.x < 0.0 { along = 0.0 - 1.0 }
    // Away from the sun, the light on the faces (AE3D_AWAY=1).
    if core.env_int("AE3D_AWAY", 0) == 1 { along = 0.0 - along }
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(core.env_float("AE3D_CAMX", 0.0 - along * 16.0), core.env_float("AE3D_CAMY", 1.55), core.env_float("AE3D_CAMZ", 3.4)))
    core.camera_look_at(cam, core.vec3(core.env_float("AE3D_AIMX", along * 20.0), core.env_float("AE3D_AIMY", 1.2), core.env_float("AE3D_AIMZ", 1.0)))

    paths = ["resources/people/man_casual.glb", "resources/people/woman_casual.glb", "resources/people/man_suit.glb",
             "resources/people/woman_formal.glb", "resources/people/man_worker.glb", "resources/people/woman_worker.glb"]
    count = core.env_int("AE3D_PEOPLE", 12)
    i = 0
    while i < count {
        side = 1.0
        if i % 2 == 1 { side = 0.0 - 1.0 }
        way = 1.0
        if (i / 2) % 2 == 1 { way = 0.0 - 1.0 }
        // Spread along the street and across the pavement, at a walk
        // between 1.1 and 1.7 m/s.
        x = 0.0 - SPAN + (2.0 * SPAN) * (((i * 37) % 100) as float) / 100.0
        z = side * (PAVEMENT_Z + 0.6 * (street.next_random() - 0.5))
        speed = way * (1.1 + 0.6 * street.next_random())
        person(life, e, "Walker ${i}", paths[i % 6], x, z, speed)
        i = i + 1
    }
    // Before the camera, on the near pavement: one coming toward it, two
    // talking a little beyond, one walking away.
    camx = core.env_float("AE3D_CAMX", 0.0 - along * 16.0)
    near = PAVEMENT_Z
    if core.env_float("AE3D_CAMZ", 3.4) < 0.0 { near = 0.0 - PAVEMENT_Z }
    person(life, e, "Coming", paths[1], camx + along * 13.0, near - 0.2, 0.0 - along * 1.25)
    pair(life, e, paths[0], paths[5], camx + along * 11.0, near + 0.35)
    person(life, e, "Going", paths[2], camx + along * 1.5, near - 0.5, along * 1.45)
    pair(life, e, paths[2], paths[3], 0.0 - 9.0, PAVEMENT_Z + 0.4)
    pair(life, e, paths[4], paths[1], 14.0, 0.0 - PAVEMENT_Z - 0.4)
}

// Every walker moved on along the street at its speed, the blend told the
// speed so its feet carry the ground at it, and put back at the other end
// past the haze, its feet let go of where they stood.
fixed_update(state: ptr, go: *GameObject, step: float) {
    life = state as *Life
    life.seconds = life.seconds + step
    i = 0
    while i < list.size(life.people) {
        p = list.get_raw(life.people, i) as *Person
        if p.speed != 0.0 {
            p.x = p.x + p.speed * step
            wrapped = false
            if p.x > SPAN {
                p.x = p.x - 2.0 * SPAN
                wrapped = true
            }
            if p.x < 0.0 - SPAN {
                p.x = p.x + 2.0 * SPAN
                wrapped = true
            }
            place(p)
            if wrapped { ikrig.feet_reset(animator.feet(p.animator as *Animator)) }
        }
        i = i + 1
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - street life")
    engine.engine_set_face_culling(e, true)
    engine.engine_set_camera_input(e, core.env_int("AE3D_HIDDEN", 0) == 0)
    engine.engine_set_post(e, true, true, 0.85, 0.6)
    h = hour()
    rim = sky.horizon_color(h)
    engine.engine_set_fog(e, core.fog_distance(30.0, 160.0, rim, 1.0))
    engine.engine_set_shadow_distance(e, 48.0)
    engine.engine_set_frustum_culling(e, true)
    if core.env_int("AE3D_RAYS", 1) == 1 {
        engine.engine_set_ray_shadows(e, true)
        engine.engine_set_sun_size(e, 0.5)
        engine.engine_set_ray_occlusion(e, core.env_int("AE3D_RAY_AO", 1) == 1)
    }
    engine.engine_set_ssr(e, core.env_int("AE3D_SSR", 1) == 1, street.ROAD_Y, 0.75)
    engine.engine_set_eye_adaptation(e, core.env_int("AE3D_EYE", 1) == 1)
    if core.env_int("AE3D_TAA", 1) == 1 { engine.engine_set_taa(e, true) }
    engine.engine_set_time_of_day(e, h)
    physics.attach(e)


    life = Life { people: list.new(), takes: list.new(), source_object: null, seconds: 0.0 }
    game = engine.object(e, "Life", null)
    engine.script(game, "street life", (&life) as ptr, start, null, fixed_update)
    engine.engine_run(e)
    println("street_life: ${list.size(life.people)} people on ${list.size(life.takes)} skeletons' takes, ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps")
    physics.physics_free(physics.of(e))
    engine.engine_free(e)
}
