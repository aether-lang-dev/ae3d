// ci: optimised -- its start-up builds its world on the CPU
// A dam breaks down a street (#744): a body of water standing at the top of
// a sloping street is let go, runs down it between the kerbs and round the
// blocks standing in it, piles up against the far end and sloshes back --
// ae3d.shallow, the shallow-water equations over the ground, drawn as
// water. Fly round it (WASD, the right mouse button to look); R lets the
// water go again.
//
//   ./build.sh examples/flood.ae && ./build/flood
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.input
import ae3d.platform
import ae3d.shallow

const CELLS = 128
const EXTENT = 64.0
const DAM_X = 0.0 - 20.0

var g_water: ptr = null                // *Shallow

// The street: falling a metre over its length toward +x, kerbs and
// pavements either side of a carriageway 10 m wide, banks rising past them,
// three blocks standing in the street.
ground_at(x: float, z: float) -> float {
    h = 0.0 - x * 0.016
    side = z
    if side < 0.0 { side = 0.0 - side }
    if side > 5.0 { h = h + 0.15 }
    if side > 8.0 { h = h + (side - 8.0) * 0.6 }
    if x > 4.0 && x < 8.0 && z > 0.0 - 3.5 && z < 0.0 - 0.5 { h = h + 2.0 }
    if x > 14.0 && x < 17.0 && z > 1.0 && z < 4.0 { h = h + 2.0 }
    if x > 22.0 && x < 25.0 && z > 0.0 - 2.0 && z < 1.0 { h = h + 2.0 }
    return h
}

street(context: ptr, x: float, z: float) -> float { return ground_at(x, z) }

street_model() -> *Model {
    n = CELLS
    m = core.model_new()
    core.mesh_reserve(m.mesh, n * n, (n - 1) * (n - 1) * 6)
    step = EXTENT / ((n - 1) as float)
    up = core.vec3(0.0, 1.0, 0.0)
    j = 0
    while j < n {
        i = 0
        while i < n {
            x = (i as float) * step - EXTENT * 0.5
            z = (j as float) * step - EXTENT * 0.5
            core.mesh_push_vertex(m.mesh, core.vec3(x, ground_at(x, z), z), x / 3.0, z / 3.0, up)
            i = i + 1
        }
        j = j + 1
    }
    j = 0
    while j < n - 1 {
        i = 0
        while i < n - 1 {
            a = j * n + i
            core.mesh_push_triangle(m.mesh, a, a + n, a + 1)
            core.mesh_push_triangle(m.mesh, a + 1, a + n, a + n + 1)
            i = i + 1
        }
        j = j + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// The street dry, and water standing 3.5 m deep at its top end, let go.
let_go(s: *Shallow) {
    shallow.shallow_clear(s)
    shallow.shallow_fill_box(s, 0.0 - EXTENT, 0.0 - 8.0, DAM_X, 8.0, 3.5)
}

start(state: ptr, go: *GameObject) {
    e = engine.of(go)
    road = street_model()
    core.model_set_texture(road, "resources/blender/zombie_street/PavingSlab.png")
    if road.material != null { core.material_set_normal_path(road.material, "resources/blender/zombie_street/PathPavingNormal.png") }
    core.model_set_pbr(road, 0.0, 0.85)
    engine.engine_add_model(e, road)
    input.bind_key(engine.engine_input(e), "again", platform.KEY_R)

    s = shallow.shallow_new(CELLS, EXTENT, 0.0, 0.0)
    g_water = s as ptr
    shallow.shallow_ground_from(s, street, null)
    let_go(s)
    engine.engine_add_model(e, shallow.shallow_model(s))

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0 - 34.0, 15.0, 22.0))
    core.camera_look_at(cam, core.vec3(2.0, 0.0, 0.0))
}

update(state: ptr, go: *GameObject, delta: float) {
    s = g_water as *Shallow
    if s == null { return }
    if input.pressed(engine.engine_input(engine.of(go)), "again") { let_go(s) }
    shallow.shallow_step(s, delta)
    shallow.shallow_refresh(s)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - flood")
    engine.engine_set_time_of_day(e, 13.0)
    engine.engine_set_camera_input(e, true)
    game = engine.object(e, "flood", null)
    engine.script(game, "flood", null, start, update)
    engine.engine_run(e)
    if g_water != null { shallow.shallow_free(g_water as *Shallow) }
    engine.engine_free(e)
}
