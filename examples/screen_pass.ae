// A program's own screen pass: a pixel shader written with `quote`, drawn by
// ae3d over every frame (engine_set_screen_pass), its colours shown as it
// writes them. Here it is the whole picture, made from its inputs alone;
// over a scene it is drawn after the scene's tone curve and FXAA.
//
//     ./build.sh examples/screen_pass.ae && ./build/screen_pass
//
// Vulkan draws it from SPIR-V made at build time, as it draws ae3d's own
// shaders: examples/lib/screenpass_spirv, written by
// tools/screen_pass_spirv.ae with ae3d.quotegen. OpenGL
// (AE3D_API=opengl) compiles the same tree's GLSL. The program keeps the
// shader, and sets its inputs between frames by name (gpu.set_vec2,
// gpu.set_float).

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.gpu
import ae3d.gpu (GpuShader)
import ae3d.shaderlib (vec2)
import examples.lib.screenpass
import examples.lib.screenpass_spirv

var g_pass: ptr = null
var g_time = 0.0

update(state: ptr, go: *GameObject, delta: float) {
    e = engine.of(go)
    s = g_pass as *GpuShader
    g_time = g_time + delta
    win = engine.engine_window(e)
    _r = gpu.set_vec2(s, "resolution", platform.window_fb_width(win) * 1.0, platform.window_fb_height(win) * 1.0)
    _t = gpu.set_float(s, "time", g_time)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 960, 600)
    engine.engine_set_title(e, "ae3d - a program's screen pass")
    s = screenpass.rings(vec2(960.0, 600.0), 0.0)
    g_pass = s as ptr
    engine.engine_set_screen_pass(e, s, screenpass_spirv.rings())
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0)
    engine.engine_set_light(e, light)
    game = engine.object(e, "Screen pass", null)
    engine.script(game, "rings", null, null, update)
    engine.engine_run(e)
    println("screen pass: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps")
    engine.engine_set_screen_pass(e, null, null)
    core.light_free(light)
    engine.engine_free(e)
    gpu.shader_free(s)
}
