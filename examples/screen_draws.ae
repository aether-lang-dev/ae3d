// A program's own quoted draws: pixel shaders written with `quote`, each
// drawn by ae3d in as many rectangles of the frame as the program queues
// (engine_screen_draw), each draw with its own inputs, blended over what is
// there as premultiplied colours are. Sprites: here a ruled backdrop, each
// line a draw of `fill`, and shaded discs of `ball` that drift across it, cut to
// a rectangle in the middle (engine_set_screen_clip).
//
//     ./build.sh examples/screen_draws.ae && ./build/screen_draws
//
// The draws stay queued, drawn every frame, until the program clears them
// (engine_screen_draws_clear) to queue the next frame's. Vulkan draws them
// from SPIR-V made at build time (examples/lib/screenpass_spirv, by
// tools/screen_pass_spirv.ae); OpenGL compiles the trees' GLSL.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.gpu
import ae3d.gpu (GpuShader)
import ae3d.shaderlib (vec3)
import examples.lib.screenpass
import examples.lib.screenpass_spirv

extern sin(x: float) -> float
extern cos(x: float) -> float

const BALLS = 40
const GAP = 32

var g_ball: ptr = null
var g_fill: ptr = null
var g_time = 0.0

update(state: ptr, go: *GameObject, delta: float) {
    e = engine.of(go)
    g_time = g_time + delta
    win = engine.engine_window(e)
    w = platform.window_fb_width(win)
    h = platform.window_fb_height(win)
    engine.engine_screen_draws_clear(e)
    // The backdrop: a line every GAP pixels each way, across the frame.
    engine.engine_set_screen_clip(e, 0, 0, 0, 0)
    fill = g_fill as *GpuShader
    _c = gpu.set_vec3(fill, "colour", 0.25, 0.25, 0.25)
    x = (w / 2) % GAP
    while x < w {
        engine.engine_screen_draw(e, fill, screenpass_spirv.fill(), x, 0, 1, h)
        x = x + GAP
    }
    y = (h / 2) % GAP
    while y < h {
        engine.engine_screen_draw(e, fill, screenpass_spirv.fill(), 0, y, w, 1)
        y = y + GAP
    }
    // The balls, cut to the middle of the frame, back to front.
    engine.engine_set_screen_clip(e, w / 8, h / 8, w * 3 / 4, h * 3 / 4)
    ball = g_ball as *GpuShader
    i = 0
    while i < BALLS {
        f = i * 1.0
        size = 24 + (i * 7) % 48
        cx = (w / 2) + ((w * 0.45) * cos(g_time * 0.3 + f * 0.7)) as int
        cy = (h / 2) + ((h * 0.45) * sin(g_time * 0.4 + f * 1.3)) as int
        _k = gpu.set_vec3(ball, "colour", 0.5 + 0.5 * cos(f), 0.5 + 0.5 * cos(f + 2.0), 0.5 + 0.5 * cos(f + 4.0))
        _s = gpu.set_float(ball, "size", size * 1.0)
        engine.engine_screen_draw(e, ball, screenpass_spirv.ball(), cx - size / 2, cy - size / 2, size, size)
        i = i + 1
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 960, 600)
    engine.engine_set_title(e, "ae3d - a program's quoted draws")
    engine.engine_set_clear_color(e, 0.0, 0.0, 0.0)
    b = screenpass.ball(vec3(1.0, 1.0, 1.0), 1.0)
    f = screenpass.fill(vec3(1.0, 1.0, 1.0))
    g_ball = b as ptr
    g_fill = f as ptr
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0)
    engine.engine_set_light(e, light)
    game = engine.object(e, "Screen draws", null)
    engine.script(game, "balls", null, null, update)
    engine.engine_run(e)
    println("screen draws: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps")
    engine.engine_screen_draws_clear(e)
    core.light_free(light)
    engine.engine_free(e)
    gpu.shader_free(b)
    gpu.shader_free(f)
}
