// docs/motion/performance.md: a figure's animation at its levels of detail.
// A pose bank baked from a walking person's own graph (the crowd's level),
// a budget that slows the graphs of the figures further off, and a figure
// handed between the crowd and its graph by pose snapshot.
//
//   ./build.sh examples/docs/lod.ae
//   ./build/lod
//
// No window: it steps the engine itself at 60 Hz and prints the plan.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.animlod

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/mannequin.glb"
const CAPTURES = "tests/fixtures/people/100style/neutral"
const PEOPLE = 6
const WALK = 1.2

// Steps `frames` frames, every person but the last walking ahead.
walk(e: *Engine, people: ptr[], frames: int) {
    k = 0
    while k < frames {
        i = 0
        while i < PEOPLE - 1 {                             // the last one stands
            character.move(people[i] as *Character, core.vec3(0.0, 0.0, WALK), core.vec3(0.0, 0.0, 0.0))
            i = i + 1
        }
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g = character.gaits(CAPTURES)
    people = calloc(PEOPLE, 8) as ptr[]
    i = 0
    while i < PEOPLE {
        c = character.humanoid(e, "Walker", FIGURE, g)
        if c == null {
            println("lod: ${character.error()}")
            exit(1)
        }
        behaviour.object_set_position(character.object_of(c), core.vec3(3.0 * (i as float), 0.0, 0.0))
        people[i] = c as ptr
        i = i + 1
    }
    // [budget]
    b = animlod.budget_new(e, 0.001)                       // the graphs' share of a step, seconds
    i = 0
    while i < PEOPLE {
        animlod.budget_add(b, character.animator_of(people[i] as *Character))
        i = i + 1
    }
    animlod.budget_view(b, core.vec3(0.0 - 2.0, 1.6, 0.0), core.vec3(1.0, 0.0, 0.0), 0.8)   // the eye, its way, its half angle
    // [budget]
    walk(e, people, 120)
    // [tighten]
    whole = 0.0
    i = 0
    while i < PEOPLE {
        whole = whole + animator.graph_cost(character.animator_of(people[i] as *Character))   // measured each evaluation
        i = i + 1
    }
    animlod.budget_set_seconds(b, whole * 0.4)             // 40% of what every graph every step costs
    // [tighten]
    walk(e, people, 60)
    nearest = animlod.budget_every(b, 0)
    farthest = animlod.budget_every(b, PEOPLE - 1)
    within = animlod.budget_planned(b) <= animlod.budget_seconds(b)
    println("lod: ${PEOPLE} graphs planned at ${animlod.budget_planned(b) * 1000000.0} us a step within ${animlod.budget_seconds(b) * 1000000.0}; the nearest every ${nearest} step, the farthest every ${farthest}")
    animlod.budget_free(b)                                 // every figure back to every step
    if !within || farthest < nearest { exit(1) }

    // [bank]
    walker = people[0] as *Character
    bank = animlod.bake(character.animator_of(walker), character.move_state(walker), 64)   // its move blend as it plays now
    // [bank]
    if bank == null { exit(1) }
    println("lod: a bank of ${animlod.bank_frames(bank)} frames, ${animlod.bank_cycle(bank)} s a cycle at ${animlod.bank_speed(bank)} m/s")

    // [handover]
    stood = people[PEOPLE - 1] as *Character
    animlod.enter_character(bank, stood, 0.37, core.vec3(0.0, 0.0, WALK), STEP, 0.3)   // from the instance at phase 0.37
    k = 0
    while k < 60 {
        character.move(stood, core.vec3(0.0, 0.0, WALK), core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
    phase = animlod.leave(bank, character.animator_of(stood))   // the phase the instance goes on from
    // [handover]
    println("lod: handed to its graph at phase 0.37 and back a second later at phase ${phase}")

    animlod.bank_free(bank)
    i = 0
    while i < PEOPLE {
        character.character_free(people[i] as *Character)
        i = i + 1
    }
    free(people as ptr)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
}
