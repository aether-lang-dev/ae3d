// docs/motion/physical.md: a person's ragdoll following its animation, a
// profile read from a file, a blow it walks through, a shove it steps out
// of, a knockdown it gets up from, and a death.
//
//   ./build.sh examples/docs/physical.ae
//   ./build/physical
//
// No window: it steps the engine itself at 60 Hz and prints what happened.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.physanim
import ae3d.motion

extern exit(code: int)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/mannequin.glb"
const CAPTURES = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const PROFILES = "tests/fixtures/physanim/people.profiles"

// Steps `seconds`, asking the character for `velocity`.
steps(e: *Engine, hero: *Character, seconds: float, velocity: Vec3) {
    k = 0
    while k < (seconds / STEP) as int {
        character.move(hero, velocity, core.vec3(0.0, 0.0, 0.0))
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

// Steps until the figure, knocked down, lies still (character.down), at
// most `seconds`; the seconds it took, or -1.
until_down(e: *Engine, hero: *Character, seconds: float) -> float {
    k = 0
    while k < (seconds / STEP) as int {
        if character.down(hero) { return (k as float) * STEP }
        engine.engine_update(e, STEP)
        k = k + 1
    }
    return 0.0 - 1.0
}

// Steps until it is up again and back on its stand, at most `seconds`.
until_up(e: *Engine, hero: *Character, seconds: float) -> float {
    k = 0
    while k < (seconds / STEP) as int {
        if !character.knocked(hero) && !character.acting(hero) && character.standing(hero) { return (k as float) * STEP }
        engine.engine_update(e, STEP)
        k = k + 1
    }
    return 0.0 - 1.0
}

main() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    gaits = character.gaits(CAPTURES)
    character.gaits_set(gaits, character.GAIT_STOP, STOP)
    hero = character.humanoid(e, "Hero", FIGURE, gaits)
    if hero == null {
        println("physical: ${character.error()}")
        exit(1)
    }
    o = character.object_of(hero)

    // [bodies]
    character.physical(hero)                               // its ragdoll on now: every body follows the animation, drawn at weight 0
    pa = character.physanim_of(hero)
    physanim.profiles_read(pa, PROFILES)                   // named sets of modes, anchor strengths and weights
    physanim.apply_profile(pa, physanim.profile_find(pa, "loose_arms"), 0.3)   // eased in over 0.3 s
    character.get_up_add(hero, "LayToIdle")                // a get-up take of the figure's file, and its mirror
    // [bodies]

    walk = core.vec3(0.0, 0.0, 1.0)
    steps(e, hero, 1.5, walk)
    // [hit]
    at = behaviour.object_position(o)
    character.hit(hero, "Chest", core.vec3(at.x, at.y + 1.35, at.z - 0.1), core.vec3(0.0, 0.0, 30.0))   // 30 N s from behind
    // [hit]
    steps(e, hero, 1.0, walk)
    println("physical: struck in the chest while walking; still knocked: ${character.knocked(hero)}")

    // [shove]
    at = behaviour.object_position(o)
    character.shove(hero, core.vec3(60.0, 0.0, 0.0), core.vec3(at.x, at.y + 1.3, at.z))   // 60 N s from its left
    // [shove]
    staggered = character.staggering(hero)
    steps(e, hero, 2.0, core.vec3(0.0, 0.0, 0.0))
    println("physical: shoved, it staggered: ${staggered}; knocked down: ${character.knocked(hero)}")

    // [knock]
    at = behaviour.object_position(o)
    character.knock(hero, core.vec3(0.0, 0.0, 0.0 - 300.0), core.vec3(at.x, at.y + 1.3, at.z), true)   // protected: hands out, head tucked
    lay = until_down(e, hero, 8.0)
    way = character.get_up(hero, null as *Motion, 0.4)     // chosen by how it lies, laid onto the body, played from the pose drawn
    rose = until_up(e, hero, 8.0)
    // [knock]
    println("physical: knocked down, lay still after ${lay} s, got up by ${animator.state_name(character.animator_of(hero), way)}, on its stand ${rose} s after get_up")
    if lay < 0.0 || way < 0 || rose < 0.0 { exit(1) }

    steps(e, hero, 1.0, walk)
    // [die]
    at = behaviour.object_position(o)
    character.die(hero, core.vec3(0.0, 0.0, 0.0 - 50.0), core.vec3(at.x, at.y + 1.3, at.z))   // a ragdoll for good
    // [die]
    steps(e, hero, 4.0, core.vec3(0.0, 0.0, 0.0))
    println("physical: dead ${character.dead(hero)}, its ragdoll at rest 4 s on: ${physanim.at_rest(pa)}")
    if !character.dead(hero) { exit(1) }

    character.character_free(hero)
    character.gaits_free(gaits)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}
