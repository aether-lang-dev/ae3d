// docs/motion/animator.md: the animator's graph built call by call on a
// figure's own takes, driven by a mover, its feet on the ground, a layer, an
// aim offset, a look and breathing over it; then the same graph read from a
// file (ae3d.animgraph).
//
//   ./build.sh examples/docs/graph.ae
//   ./build/graph
//
// No window: it steps the engine itself at 60 Hz and prints what it drew.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.animgraph
import ae3d.mover
import ae3d.ikrig

extern exit(code: int)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/ual1_rigify.glb"
const GRAPH = "tests/fixtures/graphs/gaits.graph"

// [fixed]
// The game's side of a mover: what it asks, stepped at the fixed step in
// the scripts' group, before the animators read the parameters it writes.
struct Walker {
    m: *Mover
    asked: Vec3
}

walker_fixed(state: ptr, e: *Engine, dt: float) {
    w = state as *Walker
    mover.ask(w.m, w.asked)
    mover.step(w.m, dt)
}
// [fixed]

run(e: *Engine, w: *Walker, frames: int, velocity: Vec3) {
    w.asked = velocity
    k = 0
    while k < frames {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

by_calls(e: *Engine) {
    // [graph]
    o = figure.figure(e, "Runner", FIGURE)
    a = animator.attach(e, o)                              // the figure's joints are the animator's now
    r = animator.rig(a)
    idle = animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true)
    move = animator.add_blend(a, "move")                   // one parameter: the speed
    names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    k = 0
    while k < 3 {
        t = animator.take(a, names[k], false)              // read once, freed with the animator
        animator.blend_add(a, move, t, clips.speed(t))     // each gait at its own measured speed
        k = k + 1
    }
    animator.bind(a, move, "speed")                        // the mover writes "speed"
    go = animator.add_transition(a, idle, move, 0.35)
    animator.transition_when(a, go, "speed", animator.ABOVE, 0.25)
    halt = animator.add_transition(a, move, idle, 0.4)
    animator.transition_when(a, halt, "speed", animator.BELOW, 0.1)
    animator.play(a, idle, 0.0)
    // [graph]

    // [over]
    animator.set_feet(a, ikrig.feet_new(r, o))             // feet locked on the floor while the take plants them
    animator.breathe_on(a, 1)                              // breath and weight shift while it stands
    flinch = animator.add_layer(a, animator.take(a, "Hit_Chest", false), 0 - 1, true, false)   // additive, once
    aim = animator.add_aim(a, pose.human(r, pose.SPINE_01))   // an aim offset over the spine
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Neutral", false), 0.0, 0.0)
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Up", false), 0.0, 0.7)
    animator.aim_add(a, aim, animator.take(a, "Pistol_Aim_Down", false), 0.0, 0.0 - 0.7)
    // [over]

    // [mover]
    w = heap.new(Walker)
    w.m = mover.mover_new(a, o)
    b = engine.behaviour_new("walker", w as ptr)
    b.fixed_update = walker_fixed
    engine.engine_add_behaviour(e, b)
    // [mover]

    run(e, w, 30, core.vec3(0.0, 0.0, 0.0))
    run(e, w, 120, core.vec3(0.0, 0.0, 3.0))
    println("graph: asked 3 m/s, the graph plays ${animator.state_name(a, animator.current(a))} at ${animator.ground_speed(a)} m/s")
    // [each_frame]
    animator.layer_weight(a, flinch, 1.0, 0.1)             // a flinch over the run
    animator.set_aim(a, aim, 0.0, 0.3, 1.0)                // aimed a little up
    animator.look_at(a, core.vec3(3.0, 1.6, 8.0), 1.0)     // the head on a point
    // [each_frame]
    run(e, w, 60, core.vec3(0.0, 0.0, 3.0))
    animator.look_off(a)
    animator.set_aim(a, aim, 0.0, 0.0, 0.0)
    run(e, w, 180, core.vec3(0.0, 0.0, 0.0))
    println("graph: let go, it plays ${animator.state_name(a, animator.current(a))}")
    if animator.current(a) != idle { exit(1) }
    engine.engine_remove_behaviour(e, b)
    mover.mover_free(w.m)
    heap.free(w)
    animator.animator_free(a)                              // its takes, feet and layers with it
}

by_file(e: *Engine) {
    // [file]
    o = figure.figure(e, "Filed", FIGURE)
    a = animator.attach(e, o)
    g = animgraph.load(a, GRAPH)                           // the same states, read from a file
    animator.set_feet(a, ikrig.feet_new(animator.rig(a), o))
    m = mover.mover_new(a, o)                              // writes "speed", which the file's blend reads
    // [file]
    if g == null { exit(1) }
    w = heap.new(Walker)
    w.m = m
    b = engine.behaviour_new("filed", w as ptr)
    b.fixed_update = walker_fixed
    engine.engine_add_behaviour(e, b)
    run(e, w, 120, core.vec3(0.0, 0.0, 3.0))
    println("graph: from ${GRAPH}, asked 3 m/s, it plays ${animator.state_name(a, animator.current(a))}")
    if animator.current(a) != animgraph.state_of(g, "move") { exit(1) }
    engine.engine_remove_behaviour(e, b)
    mover.mover_free(m)
    heap.free(w)
    animgraph.graph_free(g)
    animator.animator_free(a)
}

main() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    by_calls(e)
    by_file(e)
    figure.figures_free(e)
    engine.engine_free(e)
}
