// docs/motion/getting-started.md: a figure from its rig and its takes to a
// person that walks, turns and stops, in the fewest calls the engine has.
//
//   ./build.sh examples/docs/first_walk.ae
//   ./build/first_walk
//
// No window: it steps the engine itself at 60 Hz and prints what the figure
// did, each number read the way ae3d.metrics reads it for the suites.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.animator
import ae3d.character
import ae3d.metrics

extern exit(code: int)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/mannequin.glb"
const CAPTURES = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"

// Steps `frames` frames asking the character for `velocity` while facing
// `facing` (zero: the way it goes); the worst a planted toe slid, metres.
steps(e: *Engine, hero: *Character, m: *Meter, frames: int, velocity: Vec3, facing: Vec3) -> float {
    // [measure]
    metrics.meter_reset(m)                                 // a new window
    k = 0
    while k < frames {
        character.move(hero, velocity, facing)
        engine.engine_update(e, STEP)
        metrics.meter_take(m, STEP)                        // after the frame is drawn
        k = k + 1
    }
    return metrics.meter_worst(m, metrics.SKATE)           // the worst a planted toe slid, metres
    // [measure]
}

main() {
    // [world]
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(40.0, 0.5, 40.0), physics.material(0.8, 0.0))
    // [world]

    // [person]
    gaits = character.gaits(CAPTURES)                       // CAPTURES_fw.bvh, _bw, _sw, _fr, _br, _sr, _start, _stop
    character.gaits_set(gaits, character.GAIT_STOP, STOP)   // a straighter stop than the style's own
    character.gaits_set(gaits, character.GAIT_START, START)
    hero = character.humanoid(e, "Hero", FIGURE, gaits)
    if hero == null {
        println("first_walk: ${character.error()}")
        exit(1)
    }
    // [person]
    o = character.object_of(hero)
    // [meter]
    m = metrics.meter_new(animator.rig(character.animator_of(hero)), o)
    metrics.meter_ground_physics(m, physics.of(e))         // the soles read against the physics' static world
    // [meter]
    still = core.vec3(0.0, 0.0, 0.0)
    _settled = steps(e, hero, m, 30, still, still)

    // [walk]
    from = behaviour.object_position(o)
    walked = steps(e, hero, m, 240, core.vec3(0.0, 0.0, 1.2), still)    // 4 s ahead (+z) at 1.2 m/s
    went = core.v3_len(core.v3_sub(behaviour.object_position(o), from))
    // [walk]
    println("first_walk: walked ${went} m in 4 s at 1.2 m/s asked; a planted toe slid ${walked * 1000.0} mm at worst")

    // [turn]
    turned = steps(e, hero, m, 180, core.vec3(1.2, 0.0, 0.0), still)    // the same pace to +x: it turns as it goes
    // [turn]
    println("first_walk: turned a quarter and walked 3 s; a planted toe slid ${turned * 1000.0} mm at worst")

    // [stop]
    stopped = steps(e, hero, m, 180, still, still)                     // let go: it brakes, steps to a stand and stands
    // [stop]
    standing = character.standing(hero)
    println("first_walk: let go, standing after 3 s: ${standing}; a planted toe slid ${stopped * 1000.0} mm at worst")

    // [face]
    faced = steps(e, hero, m, 120, still, core.vec3(0.0 - 1.0, 0.0, 0.0))   // no velocity, a facing: it turns on the spot
    // [face]
    println("first_walk: turned round on the spot; a planted toe slid ${faced * 1000.0} mm at worst")

    // [free]
    metrics.meter_free(m)
    character.character_free(hero)
    character.gaits_free(gaits)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
    // [free]
    if !standing { exit(1) }
}
