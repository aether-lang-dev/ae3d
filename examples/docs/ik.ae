// docs/motion/ikrig.md: the animator's last word on a pose. Feet on the
// physics' ground and stepping as the body turns, the trunk aimed, a hand
// on a grip, the whole body reaching, and a limb solved by hand on a pose.
//
//   ./build.sh examples/docs/ik.ae
//   ./build/ik
//
// No window: it steps the engine itself at 60 Hz and prints where the ends
// came to.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.ikrig

extern exit(code: int)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/ual1_rigify.glb"

frames(e: *Engine, n: int) {
    k = 0
    while k < n {
        engine.engine_update(e, STEP)
        k = k + 1
    }
}

// Joint `j` of the pose drawn now, in the world.
drawn(a: *Animator, j: int, w: ptr) -> Vec3 {
    r = animator.rig(a)
    pose.world(r, animator.pose_shown(a), w)
    return clips.ground_point(r, pose.translation(w, j))
}

main() {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    floor = engine.object(e, "Floor", null)
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    o = figure.figure(e, "Reacher", FIGURE)
    a = animator.attach(e, o)
    r = animator.rig(a)
    animator.play(a, animator.add_state(a, "idle", animator.take(a, "Idle_Loop", false), true), 0.0)

    // [feet]
    f = ikrig.feet_new(r, o)
    ikrig.feet_ground_physics(f, physics.of(e))            // soles traced on the static world, not a flat floor
    ikrig.feet_set_steps(f, true)                          // a turn on the spot is stepped, one foot at a time
    animator.set_feet(a, f)                                // the animator's now, freed with it
    // [feet]

    ahead = retarget.facing(r)                             // the way the figure faces, level
    // [hands]
    h = ikrig.hands_new(r)
    animator.set_hands(a, h)
    grip = core.v3_add(core.vec3(0.0, 1.1, 0.0), core.v3_mul(ahead, 0.4))
    ikrig.hands_set(h, 1, grip, 1.0)                       // the right hand (1) on a grip in the world, 40 cm ahead
    // [hands]
    frames(e, 60)
    w = pose.new(r)
    pose.world(r, animator.pose_shown(a), w)
    held = ikrig.hands_grip(h, r, w, 1)
    gripped = core.v3_len(core.v3_sub(held, grip))
    println("ik: the right hand's grip is ${gripped * 1000.0} mm from the point asked")
    ikrig.hands_set(h, 1, grip, 0.0)

    // [aim]
    target = core.v3_add(core.vec3(0.0, 2.0, 0.0), core.v3_mul(ahead, 10.0))
    animator.aim_at(a, target, 1.0)                        // the chest's forward turned onto a point, shared up the spine
    animator.look_at(a, target, 1.0)                       // and the head onto it, within its limits
    // [aim]
    frames(e, 60)
    animator.aim_off(a)
    animator.look_off(a)

    // [body]
    b = ikrig.body_new(r)
    animator.set_body(a, b)
    low = core.v3_add(core.vec3(0.0, 0.4, 0.0), core.v3_mul(ahead, 0.6))
    ikrig.body_set(b, ikrig.BODY_HAND_L, low, 1.0)         // low and ahead: the spine bends, then the hips
    // [body]
    frames(e, 60)
    reach = drawn(a, pose.human(r, pose.HAND_L), w)
    reached_low = core.v3_len(core.v3_sub(reach, low))
    println("ik: reaching low, the left wrist is ${reached_low * 1000.0} mm from its point")

    // [limb]
    leg = ikrig.leg_limb(r, 0)                             // the left leg: thigh, calf, foot
    p = pose.new(r)
    pose.copy(r, animator.pose_now(a), p)
    pose.world(r, p, w)
    foot = pose.human(r, pose.FOOT_L)
    ankle = pose.translation(w, foot)                      // the rig's space
    ankle = core.v3_add(ankle, ikrig.dir_to_rig(r, core.vec3(0.0, 0.2, 0.0)))   // 20 cm up the ground's up
    reached = ikrig.limb_solve(leg, r, p, w, ankle, pose.rotation(w, foot))     // the foot kept as it was turned
    // [limb]
    println("ik: a leg solved by hand onto a point 20 cm higher: reached ${reached}")
    if gripped > 0.005 || reached_low > 0.005 || !reached { exit(1) }
    ikrig.limb_free(leg)
    pose.release(p)
    pose.release(w)
    animator.animator_free(a)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}
