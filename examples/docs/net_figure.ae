// docs/motion/networking.md: a figure owned by the host, seen by a client
// that joins late, over the loopback hub with a link's latency, jitter and
// loss. Every peer runs the same character from the same inputs; what
// crosses is what the owner's game asked, and a snapshot for the late
// joiner.
//
//   ./build.sh examples/docs/net_figure.ae
//   ./build/net_figure
//
// No window: both peers' engines are stepped here, a tick at a time.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.character
import ae3d.net
import ae3d.netanim

extern exit(code: int)

const STEP = 0.016666666666666666
const FIGURE = "tests/fixtures/people/mannequin.glb"
const CAPTURES = "tests/fixtures/people/100style/neutral"
const JOIN_AT = 90                     // the client joins at the host's tick 90
const TICKS = 420

// A peer's world: a floor and the person, made the same way on every peer.
world(g: *Gaits) -> (*Engine, *Character) {
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    physics.attach(e)
    ground = engine.object(e, "Floor", null)
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(60.0, 0.5, 60.0), physics.material(0.8, 0.0))
    c = character.humanoid(e, "Walker", FIGURE, g)
    if c == null {
        println("net_figure: ${character.error()}")
        exit(1)
    }
    character.physical(c)
    return e, c
}

world_free(e: *Engine, c: *Character) {
    character.character_free(c)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    engine.engine_free(e)
}

// What the owner's game asks at tick `t`: stand, walk, turn, stop.
ask(f: *NetFigure, t: int) {
    v = core.vec3(0.0, 0.0, 0.0)
    if t >= 30 && t < 200 { v = core.vec3(0.0, 0.0, 1.2) }
    if t >= 200 && t < 300 { v = core.vec3(1.2, 0.0, 0.0) }
    netanim.move(f, v, core.vec3(0.0, 0.0, 0.0))
}

main() {
    g = character.gaits(CAPTURES)
    // [sessions]
    hub = net.hub_new()
    host = net.host_loopback(hub)
    net.hub_set_conditions(hub, 0.15, 0.03, 0.05)          // 150 ms latency, 30 ms jitter, 5% lost
    nh = netanim.netanim_new(host)                         // every side, at the same point among its registrations
    oe, oc = world(g)
    owned = netanim.add(nh, oe, oc, true)                  // the host's own figure
    // [sessions]
    we, wc = world(g)
    client = null as *Net
    nc = null as *NetAnim
    seen = null as *NetFigure
    now = 0.0
    t = 0
    while t < TICKS || (nc != null && netanim.playing(nc) + 1 < t) {
        if t < TICKS {
            // [owner]
            ask(owned, t)                                  // as character.move, through netanim
            engine.engine_update(oe, STEP)
            netanim.sent(nh, now)                          // after the engine's step: the tick closed and streamed
            // [owner]
            t = t + 1
            if t == TICKS { netanim.flush(nh, now) }       // the last ticks streamed now
        }
        if t == JOIN_AT && client == null {
            // [join]
            client = net.join_loopback(hub)
            nc = netanim.netanim_new(client)
            seen = netanim.add(nc, we, wc, false)          // the host's figure, laid from its snapshot
            // [join]
        }
        net.step(host, now)
        if client != null { net.step(client, now) }
        // [peer]
        while nc != null && netanim.due(nc, now) && netanim.playing(nc) + 1 < t {
            netanim.play(nc)                               // the next tick's inputs and events to its figures
            engine.engine_update(we, STEP)
            netanim.played(nc)                             // held to the owner's state at that tick
        }
        // [peer]
        now = now + STEP
    }
    apart = core.v3_len(core.v3_sub(behaviour.object_position(character.object_of(oc)), behaviour.object_position(character.object_of(wc))))
    println("net_figure: joined at tick ${JOIN_AT}, ${netanim.snapshots_taken(nc)} snapshot taken, ${netanim.ticks_missed(seen)} ticks played without their inputs; at the end the client's figure is ${apart * 1000.0} mm from the host's")
    netanim.netanim_free(nh)
    netanim.netanim_free(nc)
    net.net_free(client)
    net.net_free(host)
    net.hub_free(hub)
    world_free(oe, oc)
    world_free(we, wc)
    character.gaits_free(g)
    if apart > 0.01 { exit(1) }
}
