// A game's HUD over a scene, and a pause menu over that, drawn by the
// engine's overlay (ae3d.ui2d and ae3d.hud, docs/ui.md) over the finished
// frame on either renderer:
// - top left, the frame rate; top right, a minimap the program redraws
//   every frame; bottom left, a health bar that drains and fills;
// - a crosshair, and a prompt under it;
// - Escape (or the pad's Start) opens the pause menu: Resume, subtitles, a
//   volume, a name to play under, Quit. While it is open the crates stop,
//   and the game's input hears nothing.
//
//   ./build.sh examples/game_hud.ae && ./build/game_hud
//   AE3D_API=opengl ./build/game_hud
//   AE3D_HUD_PAUSED=1 ./build/game_hud        opens with the menu up
//
// The HUD is made once, in a script's start, and anchored to the window's
// corners, so it holds its place at any size and scale; the script's update
// sets what changes -- the bar's fill, the numbers, the minimap's pixels.
// The frame rate is drawn through the overlay directly, the immediate way:
// a line that is new every frame.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.input
import ae3d.hud
import ae3d.ui2d
import std.mem
import std.string

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const MAP = 128                   // the minimap's pixels, a side

// Spinner: turns whatever it is on about the up axis, degrees a second --
// while the game is not paused.
struct Spinner { rate: float }

spin(state: ptr, go: *GameObject, delta: float) {
    if ui2d.depth(engine.engine_ui(engine.of(go))) > 0 { return }
    spinner = state as *Spinner
    core.model_rotate(behaviour.object_model(go), 0.0, spinner.rate * delta, 0.0)
}

// The HUD's own state: the health it shows and which way it is going, the
// frame time smoothed so it can be read, and what it made.
struct HudState {
    health: float
    draining: bool
    frame_ms: float
    radar: float                   // the minimap's sweep, radians
    bar: ptr                       // *UiNode
    points: ptr
    pause: ptr
    resume: ptr
    subtitles: ptr
    volume: ptr
    name: ptr
    quit: ptr
    minimap: int                   // the overlay's image
    map_pixels: ptr                // MAP * MAP RGBA
}

hud_start(state: ptr, go: *GameObject) {
    play = state as *HudState
    e = engine.of(go)
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 30.0, 110.0))
    core.camera_look_at(cam, core.vec3(0.0, 8.0, 0.0))
    keys = engine.engine_input(e)
    input.bind_key(keys, "pause", platform.KEY_ESCAPE)
    input.bind_button(keys, "pause", input.PAD_START)

    ui = engine.engine_ui(e)
    white = hud.rgba(1.0, 1.0, 1.0, 1.0)
    ink = hud.rgba(0.0, 0.0, 0.0, 0.85)
    layer = ui2d.layer(ui)

    // Bottom left: the health bar -- a light frame, a dark well, the fill
    // from green to red as it drains -- and the number beside it.
    ui2d.rect(layer, ui2d.BOTTOM_LEFT, 20.0, 0.0 - 30.0, 284.0, 26.0, hud.rgba(1.0, 1.0, 1.0, 0.75))
    bar = ui2d.rect(layer, ui2d.BOTTOM_LEFT, 22.0, 0.0 - 32.0, 280.0, 22.0, hud.rgba(0.2, 0.8, 0.15, 0.95))
    ui2d.set_back(bar, hud.rgba(0.05, 0.05, 0.07, 0.9))
    play.bar = bar as ptr
    points = ui2d.text(layer, ui2d.BOTTOM_LEFT, 316.0, 0.0 - 28.0, "100", 26.0)
    ui2d.set_outline(points, ink, 1.5)
    play.points = points as ptr

    // Top right: the minimap, drawn by the program into pixels of its own.
    play.map_pixels = calloc(MAP * MAP, 4)
    draw_map(play)
    play.minimap = ui2d.add_image(ui, MAP, MAP, play.map_pixels)
    ui2d.image(layer, ui2d.TOP_RIGHT, 0.0 - 20.0, 20.0, 160.0, 160.0, play.minimap)

    // The crosshair: four short strokes round the middle of the screen.
    hair = hud.rgba(1.0, 1.0, 1.0, 0.85)
    ui2d.rect(layer, ui2d.CENTER, 0.0 - 8.0, 0.0, 8.0, 2.0, hair)
    ui2d.rect(layer, ui2d.CENTER, 8.0, 0.0, 8.0, 2.0, hair)
    ui2d.rect(layer, ui2d.CENTER, 0.0, 0.0 - 8.0, 2.0, 8.0, hair)
    ui2d.rect(layer, ui2d.CENTER, 0.0, 8.0, 2.0, 8.0, hair)

    // A prompt under the middle, on a panel: the text centred in it.
    prompt = ui2d.panel(layer, ui2d.CENTER, 0.0, 110.0, 230.0, 40.0, hud.rgba(0.0, 0.0, 0.0, 0.45))
    ui2d.set_solid(prompt, false)
    words = ui2d.text(prompt, ui2d.CENTER, 0.0, 0.0, "Press E to open", 22.0)
    ui2d.set_colour(words, hud.rgba(1.0, 0.92, 0.6, 1.0))

    // The pause menu, opened by Escape: a card of widgets.
    pause = ui2d.menu(ui)
    card = ui2d.panel(pause, ui2d.CENTER, 0.0, 0.0, 340.0, 330.0, hud.rgba(0.08, 0.09, 0.11, 0.96))
    title = ui2d.text(card, ui2d.TOP, 0.0, 16.0, "Paused", 30.0)
    ui2d.set_colour(title, white)
    play.resume = ui2d.button(card, ui2d.TOP, 0.0, 66.0, 280.0, 40.0, "Resume") as ptr
    play.subtitles = ui2d.toggle(card, ui2d.TOP_LEFT, 30.0, 122.0, 280.0, 24.0, "Subtitles", true) as ptr
    ui2d.text(card, ui2d.TOP_LEFT, 30.0, 160.0, "Volume", 18.0)
    play.volume = ui2d.slider(card, ui2d.TOP_LEFT, 110.0, 160.0, 200.0, 22.0, 0.0, 1.0, 0.8) as ptr
    play.name = ui2d.field(card, ui2d.TOP_LEFT, 30.0, 200.0, 280.0, 36.0, "Your name") as ptr
    play.quit = ui2d.button(card, ui2d.TOP, 0.0, 262.0, 280.0, 40.0, "Quit") as ptr
    play.pause = pause as ptr
    if core.env_int("AE3D_HUD_PAUSED", 0) == 1 { ui2d.push(ui, pause) }
}

// A pixel as the image holds it, RGBA little-endian in one int: red first.
// The alpha goes into the top byte by a multiply, which wraps (the
// compiler's -fwrapv) where a constant would overflow.
pixel_of(r: int, g: int, b: int, a: int) -> int {
    return r + g * 256 + b * 65536 + a * 16777216
}

// The minimap: a dark disc with a light rim, its rings, the crates, and a
// sweep going round.
draw_map(play: *HudState) {
    pixels = play.map_pixels as int[]
    half = (MAP as float) * 0.5
    y = 0
    while y < MAP {
        x = 0
        while x < MAP {
            dx = (x as float) + 0.5 - half
            dy = (y as float) + 0.5 - half
            r = core.sqrt_of(dx * dx + dy * dy) / half
            colour = 0
            if r >= 0.96 && r < 1.0 {
                colour = pixel_of(225, 235, 225, 235)
            } else if r < 0.96 {
                green = 40
                ring = r * 4.0 - ((r * 4.0) as int) as float
                if ring < 0.06 { green = 90 }
                // How far the sweep has gone past this pixel's bearing: the
                // sweep is kept in [0, 2 pi) and a bearing is in (-pi, pi],
                // so the difference is within a turn of [0, 2 pi) and one
                // correction either way brings it there.
                behind = play.radar - core.atan2_of(dy, dx)
                if behind < 0.0 { behind = behind + 6.2831853 }
                if behind >= 6.2831853 { behind = behind - 6.2831853 }
                if behind < 0.8 { green = green + ((1.0 - behind / 0.8) * 110.0) as int }
                colour = pixel_of(18, green, 24, 220)
            }
            pixels[y * MAP + x] = colour
            x = x + 1
        }
        y = y + 1
    }
    // The three crates, where they stand, as bright squares.
    k = 0
    while k < 3 {
        cx = (half + ((k - 1) as float) * 30.0 * 0.9) as int
        cy = (half - 8.0) as int
        py = cy - 3
        while py <= cy + 3 {
            px = cx - 3
            while px <= cx + 3 {
                pixels[py * MAP + px] = pixel_of(250, 200, 90, 255)
                px = px + 1
            }
            py = py + 1
        }
        k = k + 1
    }
}

hud_update(state: ptr, go: *GameObject, delta: float) {
    play = state as *HudState
    e = engine.of(go)
    ui = engine.engine_ui(e)
    keys = engine.engine_input(e)
    o = engine.engine_hud(e)

    // The menu: Escape opens it; Resume, Escape or the pad's B close it;
    // Quit ends the game. Its widgets hold their own state.
    if input.pressed(keys, "pause") { ui2d.push(ui, play.pause as *UiNode) }
    if ui2d.clicked(play.resume as *UiNode) { ui2d.pop(ui) }
    if ui2d.clicked(play.quit as *UiNode) { engine.engine_stop(e) }
    paused = ui2d.depth(ui) > 0

    // The simulation of a fight, while it is not paused: health drains to a
    // fifth, then comes back.
    if !paused {
        if play.draining {
            play.health = play.health - 0.12 * delta
            if play.health <= 0.2 { play.draining = false }
        } else {
            play.health = play.health + 0.25 * delta
            if play.health >= 1.0 {
                play.health = 1.0
                play.draining = true
            }
        }
        play.radar = play.radar + 1.6 * delta
        if play.radar > 6.2831853 { play.radar = play.radar - 6.2831853 }
    }
    if delta > 0.0 { play.frame_ms = play.frame_ms * 0.9 + delta * 100.0 }

    bar = play.bar as *UiNode
    ui2d.set_fill(bar, play.health)
    ui2d.set_colour(bar, hud.rgba(0.9 - 0.75 * play.health, 0.2 + 0.6 * play.health, 0.15, 0.95))
    ui2d.set_text(play.points as *UiNode, "${(play.health * 100.0 + 0.5) as int}")
    draw_map(play)
    ui2d.update_image(ui, play.minimap, play.map_pixels)

    // Top left, the immediate way: the frame rate over a copy of itself a
    // pixel down and right, so it reads over the sky and the ground alike.
    white = hud.rgba(1.0, 1.0, 1.0, 1.0)
    shadow = hud.rgba(0.0, 0.0, 0.0, 0.7)
    fps = (engine.engine_fps(e) + 0.5) as int
    hud.text_shadowed(o, 20.0, 16.0, 26.0, "${fps} fps", white, shadow, 2.0)
    ms = tenths(play.frame_ms)
    hud.text_shadowed(o, 20.0, 46.0, 16.0, "${ms} ms a frame, ${engine.engine_backend_name(e)}",
                      hud.rgba(0.8, 0.85, 0.9, 1.0), shadow, 1.0)
    string.free(ms)
}

// A number to one decimal place, as text.
tenths(value: float) -> string {
    whole = value as int
    tenth = ((value - (whole as float)) * 10.0) as int
    return "${whole}.${tenth}"
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - hud")
    engine.engine_set_clear_color(e, 0.35, 0.5, 0.7)

    light = core.light_sun(core.vec3(0.4, 0.9, 0.3))
    light.ambient_strength = 0.35
    engine.engine_set_light(e, light)

    ground = loader.plane(8, 40.0)
    core.model_set_position(ground, 0.0 - 160.0, 0.0, 0.0 - 160.0)
    core.model_matte(ground, 0.45, 0.5, 0.42)
    engine.object(e, "Ground", ground)

    spinner = Spinner { rate: 40.0 }
    i = 0
    while i < 3 {
        crate = loader.cube(1.0)
        core.model_set_scale(crate, 12.0, 12.0, 12.0)
        core.model_set_position(crate, (i - 1) as float * 30.0, 8.0, 0.0)
        core.model_polished_metal(crate, 0.8, 0.45 + 0.15 * (i as float), 0.25)
        crate_object = engine.object(e, "Crate ${i}", crate)
        engine.script(crate_object, "Spinner", &spinner, null, spin)
        i = i + 1
    }

    play = HudState { health: 1.0, draining: true, frame_ms: 16.0, radar: 0.0 }
    manager = engine.object(e, "HUD", null)
    engine.script(manager, "HUD", &play, hud_start, hud_update)

    engine.engine_run(e)

    if play.map_pixels != null { free(play.map_pixels) }
    core.light_free(light)
    engine.engine_free(e)
}
