// Minimal end-to-end scene: one lit cube spinning in front of the camera.
// Run it to confirm the toolchain, the window and a backend all work.
//
//   ./build.sh examples/spinning_cube.ae && ./build/spinning_cube
//
// The shape every program here takes, the shape Unity and gopher3D gave a
// game: game objects in the engine's scene, and scripts on them whose
// phases the engine calls. The scene is written as the shape it is
// (ae3d.scenedsl, docs/scenes-in-code.md): what is in a block is on, or
// under, what the block belongs to.

import std.list
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.component
import ae3d.scenedsl
import ae3d.scenedsl (scene, sun, camera, look_at, cube, name, scale, polished_metal, component, field)

// Spinner: turns whatever it is on, a little faster about one axis than
// the other so the cube tumbles rather than rolls. Its fields are its
// struct's (@derive(schema)), so the scene sets them by name.
@derive(schema)
struct Spinner {
    pitch: float @range(0.0, 360.0) @tooltip("Degrees a second about x.")
    yaw: float @range(0.0, 360.0) @tooltip("Degrees a second about y.")
}

// Handed its state as `ptr`: the kind's update slot is a fn(ptr, ...).
update(p: ptr, go: *GameObject, delta: float) {
    spin = p as *Spinner
    core.model_rotate(behaviour.object_model(go), spin.pitch * delta, spin.yaw * delta, 0.0)
}

main() {
    spinner = component.schema_kind("Spinner", "Gameplay", Spinner_schema())
    component.phases(spinner, null, update, null, null)

    e = engine.engine_new()
    engine.engine_set_size(e, 1024, 768)
    engine.engine_set_title(e, "ae3d - spinning cube")

    s = scene() {
        sun(0.4, 0.8, 0.5)
        // Placing the camera above the cube without aiming it leaves the
        // cube in the bottom third of the frame: a new camera looks along
        // -z, not at anything in particular.
        camera(0.0, 20.0, 90.0) { look_at(0.0, 0.0, 0.0) }
        cube(1.0) {
            name("Cube")
            scale(20.0)
            polished_metal(0.85, 0.35, 0.2)
            component("Spinner") {
                field("pitch", 18.0)
                field("yaw", 30.0)
            }
        }
    }
    if scenedsl.errors(s) > 0 { println("spinning_cube: ${scenedsl.error(s)}") }
    objects = scenedsl.place(e, s)

    engine.engine_run(e)

    engine.engine_free(e)
    scenedsl.release(s)
    list.free(objects)
}
