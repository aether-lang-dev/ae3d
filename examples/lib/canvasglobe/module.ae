// The pair examples/canvas.ae draws its globe with, into a canvas of its own
// (engine_canvas_draw): a vertex shader that turns the globe and puts it in
// front of the eye, and a pixel shader that lights it by the sun, in bands
// of latitude. A pair of a program's own, its SPIR-V made by
// tools/canvas_spirv.ae (examples/lib/canvasglobe_spirv): run that after
// this changes.

import std.quote
import ae3d.gpu (GpuShader, vertex, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, mat4, mul, xyz, dot, normalize, max, fract)

exports (GlobeVertex, GlobeVaryings, globe_vertex, globe_lit)

// What the globe's mesh gives a vertex.
struct GlobeVertex {
    position: vec3
    uv: vec2
    normal: vec3
}

// What the vertex shader hands the pixel shader, and where the vertex is.
struct GlobeVaryings {
    position: vec4
    facing: vec3
    band: float
}

// `lens` the eye's projection and view, made the renderer's by
// engine_canvas_lens; `turn` the globe's own.
globe_vertex(lens: mat4, turn: mat4) -> *GpuShader {
    return vertex("canvas_globe_vertex") quote | v: GlobeVertex | {
        at = mul(turn, vec4(v.position, 1.0))
        return GlobeVaryings {
            position: mul(lens, at),
            facing: xyz(mul(turn, vec4(v.normal, 0.0))),
            band: v.uv.y
        }
    }
}

// Lit by `sun`, a way to it, in two colours a band of latitude each.
globe_lit(sun: vec3, warm: vec3, cool: vec3) -> *GpuShader {
    return fragment("canvas_globe_lit") quote | f: GlobeVaryings | {
        light = 0.15 + 0.85 * max(dot(normalize(f.facing), sun), 0.0)
        stripe = if fract(f.band * 8.0) < 0.5 { 0.0 } else { 1.0 }
        return vec4((warm + (cool - warm) * stripe) * light, 1.0)
    }
}
