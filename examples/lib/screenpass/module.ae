// The screen pass examples/screen_pass.ae draws: a quoted pixel shader of a
// program's own, made from its inputs alone (no texture), drawn by ae3d over
// the frame (engine_set_screen_pass). Rings spreading from a point that
// circles the screen, coloured by how far out they are.
//
// Its SPIR-V, for Vulkan, is examples/lib/screenpass_spirv, written by
// tools/screen_pass_spirv.ae with ae3d.quotegen: run that after this
// changes, or the example stops when its pass is made, naming the shader.

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, sin, cos, length_v2, clamp_v3, splat3, frag_coord, screen_y_sign)

exports (rings, ring_colour)

// The colour of rings `d` pixels out at time `t`.
@quotable
ring_colour(d: float, t: float) -> vec3 {
    wave = sin(d * 0.08 - t * 3.0) * 0.5 + 0.5
    fade = 1.0 / (1.0 + d * 0.004)
    return clamp_v3(vec3(wave, wave * 0.6 + 0.2, 1.0 - wave) * fade, splat3(0.0), splat3(1.0))
}

// The pass: `resolution` the frame's size in pixels, `time` in seconds.
rings(resolution: vec2, time: float) -> *GpuShader {
    return fragment("screen_rings") quote | uv: vec2 | {
        // frag_coord() is the backend's: y runs down the frame on Vulkan
        // and up on OpenGL. Measured down from the top on both, the
        // picture is the same on either.
        at = frag_coord()
        frag = vec2(at.x, if screen_y_sign() > 0.0 { resolution.y - at.y } else { at.y })
        centre = vec2(resolution.x * (0.5 + cos(time * 0.7) * 0.25), resolution.y * (0.5 + sin(time * 0.7) * 0.25))
        return vec4(ring_colour(length_v2(frag - centre), time), 1.0)
    }
}
