// A campfire, the engine's fire (#738): flames simulated by ae3d.flames and
// glowing as a black body, their smoke, embers drawn along their flight, and
// the flickering light it throws on the sand and the logs. Fly round it
// (WASD, the right mouse button to look).
//
//   ./build.sh examples/campfire.ae && ./build/campfire
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.particles

start(state: ptr, go: *GameObject) {
    e = engine.of(go)
    ground = loader.plane(40, 1.0)
    core.model_set_position(ground, 0.0 - 20.0, 0.0, 0.0 - 20.0)
    core.model_set_texture(ground, "resources/textures/sand.png")
    if ground.material != null { core.material_set_normal_path(ground.material, "resources/textures/sand_normal.png") }
    core.model_set_pbr(ground, 0.0, 0.95)
    core.model_set_specular(ground, 0.03, 0.03, 0.03)
    core.model_set_tile_breakup(ground, true, 0.0)
    core.model_set_detail(ground, 6.0, 0.5, 15.0)
    engine.engine_add_model(e, ground)
    k = 0
    while k < 3 {
        log = loader.cube(1.0)
        a = (k as float) * 2.094
        core.model_set_position(log, 0.25 * core.cos_of(a), 0.09, 0.25 * core.sin_of(a))
        core.model_set_scale(log, 0.9, 0.16, 0.16)
        core.model_set_rotation(log, core.quat_from_euler(0.0, 1.5708 - a, 0.0))
        core.model_set_diffuse(log, 0.16, 0.09, 0.05)
        core.model_set_pbr(log, 0.0, 0.9)
        engine.engine_add_model(e, log)
        k = k + 1
    }

    flames = particles.emitter(e, 260)
    particles.set_position(flames, core.vec3(0.0, 0.05, 0.0))
    particles.set_direction(flames, core.vec3(0.0, 1.0, 0.0), 0.12)
    particles.set_area(flames, 0.22)
    particles.set_rate(flames, 55.0)
    particles.set_speed(flames, 0.1, 0.25)
    particles.set_lifetime(flames, 0.9, 1.3)
    particles.set_gravity(flames, core.vec3(0.0, 0.3, 0.0))
    particles.set_size(flames, 1.0, 1.1)
    particles.set_fire(flames, 2300.0)
    particles.set_glow(flames, 3.0)
    particles.add_color_key(flames, 0.0, 1.0, 1.0, 1.0, 1.0)
    particles.add_color_key(flames, 0.8, 0.85, 1.0, 1.0, 0.8)
    particles.add_color_key(flames, 1.0, 0.7, 1.0, 1.0, 0.0)
    particles.set_seed(flames, 3)
    particles.set_light(flames, 1900.0, 1.1, 3.5, 0.45)

    smoke = particles.emitter(e, 160)
    particles.set_position(smoke, core.vec3(0.0, 0.9, 0.0))
    particles.set_direction(smoke, core.vec3(0.12, 1.0, 0.0), 0.3)
    particles.set_rate(smoke, 9.0)
    particles.set_speed(smoke, 0.4, 0.8)
    particles.set_lifetime(smoke, 4.0, 5.5)
    particles.set_gravity(smoke, core.vec3(0.12, 0.2, 0.0))
    particles.set_size(smoke, 0.8, 2.6)
    particles.set_smoke(smoke)
    particles.set_color(smoke, 0.32, 0.31, 0.3)
    particles.add_color_key(smoke, 0.0, 0.3, 0.29, 0.28, 0.0)
    particles.add_color_key(smoke, 0.15, 0.3, 0.29, 0.28, 0.55)
    particles.add_color_key(smoke, 1.0, 0.36, 0.36, 0.36, 0.0)
    particles.set_spin(smoke, 0.0 - 0.3, 0.3)
    particles.set_seed(smoke, 5)

    embers = particles.emitter(e, 200)
    particles.set_position(embers, core.vec3(0.0, 0.25, 0.0))
    particles.set_area(embers, 0.2)
    particles.set_direction(embers, core.vec3(0.0, 1.0, 0.0), 0.6)
    particles.set_rate(embers, 22.0)
    particles.set_speed(embers, 1.2, 2.8)
    particles.set_lifetime(embers, 1.0, 2.2)
    particles.set_gravity(embers, core.vec3(0.0, 0.0 - 0.5, 0.0))
    particles.set_drag(embers, 0.6)
    particles.set_size(embers, 0.018, 0.008)
    particles.set_blend(embers, core.BLEND_ADD)
    particles.set_glow(embers, 6.0)
    particles.set_stretch(embers, 0.05)
    particles.add_color_key(embers, 0.0, 1.0, 0.75, 0.3, 1.0)
    particles.add_color_key(embers, 1.0, 1.0, 0.15, 0.0, 0.0)
    particles.set_seed(embers, 9)

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 1.3, 3.2))
    core.camera_look_at(cam, core.vec3(0.0, 0.7, 0.0))
}

update(state: ptr, go: *GameObject, delta: float) { }

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 960, 540)
    engine.engine_set_title(e, "campfire")
    engine.engine_set_time_of_day(e, 20.2)
    engine.engine_set_camera_input(e, true)
    game = engine.object(e, "campfire", null)
    engine.script(game, "campfire", null, start, update)
    engine.engine_run(e)
}
