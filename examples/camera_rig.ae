// The engine's camera controllers (#823): an orbit camera you drag and zoom,
// and a keyframed path that flies the camera round the scene and back.
//
//   ./build.sh examples/camera_rig.ae && ./build/camera_rig
//
//   1        the orbit camera: drag the left button to turn, the wheel to zoom,
//            the arrow keys to turn
//   2        the camera path: a fly-through that loops
//   Space    pause and resume the path
//   R        the path from its start
//
// Both are behaviours the engine runs in its update (orbitcam.attach and
// campath.attach), so nothing here steps them by hand; the example only says
// which one has the camera.

import ae3d.core
import ae3d.platform
import ae3d.input
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.orbitcam
import ae3d.campath

const CENTRE_Y = 12.0

struct Rig {
    orbit: ptr
    path: ptr
    orbiting: bool
}

// The fly-through: round the scene at 90 units, rising and falling, the
// field of view narrowing at the far side, back to where it began so that it
// loops without a jump (the last key is the first again, and the spline is
// smooth through it only as far as a loop of one segment can be).
build_path() -> *CameraPath {
    p = campath.path_new()
    centre = core.vec3(0.0, CENTRE_Y, 0.0)
    campath.path_add_target(p, 0.0, core.vec3(0.0, 30.0, 95.0), centre, 45.0)
    campath.path_add_target(p, 3.0, core.vec3(90.0, 18.0, 40.0), centre, 40.0)
    campath.path_add_target(p, 6.0, core.vec3(70.0, 45.0, 0.0 - 70.0), centre, 32.0)
    campath.path_add_target(p, 9.0, core.vec3(0.0 - 80.0, 22.0, 0.0 - 60.0), centre, 40.0)
    campath.path_add_target(p, 12.0, core.vec3(0.0, 30.0, 95.0), centre, 45.0)
    campath.set_loop(p, true)
    return p
}

rig_start(state: ptr, e: *Engine) {
    rig = state as *Rig
    cam = engine.engine_camera(e)
    p = build_path()
    campath.attach(e, p, cam)
    campath.play(p)
    rig.path = p as ptr

    o = orbitcam.orbit_new(core.vec3(0.0, CENTRE_Y, 0.0), 100.0, 90.0, 20.0)
    orbitcam.attach(e, o, cam)
    orbitcam.orbit_set_active(o, false)
    rig.orbit = o as ptr

    keys = engine.engine_input(e)
    input.bind_key(keys, "orbit", platform.KEY_1)
    input.bind_key(keys, "path", platform.KEY_2)
    input.bind_key(keys, "pause", platform.KEY_SPACE)
    input.bind_key(keys, "restart", platform.KEY_R)
}

rig_update(state: ptr, e: *Engine, delta: float) {
    rig = state as *Rig
    p = rig.path as *CameraPath
    o = rig.orbit as *Orbit
    keys = engine.engine_input(e)
    cam = engine.engine_camera(e)
    if input.pressed(keys, "orbit") && !rig.orbiting {
        // The orbit takes the camera from where the path left it.
        campath.pause(p)
        orbitcam.orbit_from_camera(o, cam, 100.0)
        orbitcam.orbit_set_active(o, true)
        rig.orbiting = true
    }
    if input.pressed(keys, "path") && rig.orbiting {
        orbitcam.orbit_set_active(o, false)
        campath.play(p)
        rig.orbiting = false
    }
    if !rig.orbiting {
        if input.pressed(keys, "pause") {
            if campath.path_playing(p) { campath.pause(p) } else { campath.play(p) }
        }
        if input.pressed(keys, "restart") {
            campath.seek(p, 0.0)
            campath.play(p)
        }
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1024, 768)
    engine.engine_set_title(e, "ae3d - camera rig")

    light = core.light_sun(core.vec3(0.4, 0.8, 0.5))
    engine.engine_set_light(e, light)

    ground = loader.cube(1.0)
    core.model_set_scale(ground, 400.0, 2.0, 400.0)
    core.model_set_position(ground, 0.0, 0.0 - 1.0, 0.0)
    core.model_set_diffuse(ground, 0.35, 0.4, 0.35)
    engine.object(e, "Ground", ground)

    // Six pieces round the middle, each its own colour, so that the camera's
    // place can be told from the picture.
    k = 0
    while k < 6 {
        angle = (k as float) * 1.0471976
        piece = loader.cube(1.0)
        if k % 2 == 1 { piece = loader.sphere(0.5, 24, 16) }
        core.model_set_scale(piece, 16.0, 16.0 + (k as float) * 3.0, 16.0)
        core.model_set_position(piece, 38.0 * core.cos_of(angle), 8.0 + (k as float) * 1.5, 38.0 * core.sin_of(angle))
        core.model_polished_metal(piece, 0.3 + (k as float) * 0.12, 0.8 - (k as float) * 0.1, 0.4)
        engine.object(e, "Piece", piece)
        k = k + 1
    }

    rig = Rig { orbiting: false }
    b = engine.behaviour_new("rig", &rig)
    b.start = rig_start
    b.update = rig_update
    engine.engine_add_behaviour(e, b)

    println("camera rig: 1 orbit (drag, wheel, arrows), 2 path, Space pause, R restart")
    engine.engine_run(e)

    orbitcam.orbit_free(rig.orbit as *Orbit)
    campath.path_free(rig.path as *CameraPath)
    engine.engine_free(e)
    core.light_free(light)
}
