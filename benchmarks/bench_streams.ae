// Many small instance streams growing every frame, on Vulkan: a ground mist
// of EMITTERS emitters, each one particle fuller each frame up to MOST.
// What it costs a frame is what a game of small emitters pays for its
// streams: how often a ring is remade, and what each remaking waits for.
//
//   ./build.sh benchmarks/bench_streams.ae && ./build/bench_streams
//
// Headless, offscreen; prints milliseconds a frame over the growing frames
// and over as many frames after, when nothing grows.

import std.os
import ae3d.core
import ae3d.vulkan
import ae3d.loader

const WIDTH = 640
const HEIGHT = 360
const EMITTERS = 200
const MOST = 120

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

main() {
    if !vulkan.available() {
        println("bench_streams: SKIP no Vulkan driver")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("bench_streams: SKIP Vulkan would not start")
        vulkan.renderer_free(renderer)
        return
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 40.0, 120.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    block = calloc(EMITTERS, 8)
    emitters = block as ptr[]
    e = 0
    while e < EMITTERS {
        m = loader.cube(0.3)
        core.model_enable_instancing(m, MOST)
        core.model_set_instance_draw_count(m, 1)
        core.model_set_instance_position(m, 0, core.vec3(((e % 20) as float - 10.0) * 6.0, 0.0, ((e / 20) as float - 5.0) * 6.0))
        core.model_recalculate_bounds(m)
        core.backend_add_model(&backend, m)
        emitters[e] = m as ptr
        e = e + 1
    }
    // Warm: pipelines made, first uploads done.
    core.backend_render(&backend, cam, light)

    started = os.now_monotonic_ms()
    count = 2
    while count <= MOST {
        e = 0
        while e < EMITTERS {
            m = emitters[e] as *Model
            core.model_set_instance_draw_count(m, count)
            core.model_set_instance_position(m, count - 1, core.vec3(((e % 20) as float - 10.0) * 6.0, (count as float) * 0.05, ((e / 20) as float - 5.0) * 6.0))
            e = e + 1
        }
        core.backend_render(&backend, cam, light)
        count = count + 1
    }
    growing = os.now_monotonic_ms() - started

    started = os.now_monotonic_ms()
    frame = 2
    while frame <= MOST {
        e = 0
        while e < EMITTERS {
            m = emitters[e] as *Model
            core.model_set_instance_position(m, frame % MOST, core.vec3(((e % 20) as float - 10.0) * 6.0, (frame as float) * 0.05, ((e / 20) as float - 5.0) * 6.0))
            e = e + 1
        }
        core.backend_render(&backend, cam, light)
        frame = frame + 1
    }
    steady = os.now_monotonic_ms() - started

    frames = MOST - 1
    println("bench_streams: ${EMITTERS} streams growing by one a frame to ${MOST}: ${(growing as float) / (frames as float)} ms a frame")
    println("bench_streams: the same streams moving, not growing: ${(steady as float) / (frames as float)} ms a frame")

    e = 0
    while e < EMITTERS {
        m = emitters[e] as *Model
        core.backend_remove_model(&backend, m)
        core.model_free(m)
        e = e + 1
    }
    free(block)
    core.light_free(light)
    core.camera_free(cam)
    core.backend_cleanup(&backend)
    vulkan.renderer_free(renderer)
}
