// Motion matching at a crowd's scale (#509): what a database costs to build
// and free, over and over, and what 2,000 figures' searches cost a frame on
// the job system against one thread. No window, no engine: the Fox fixture's
// Survey, Walk and Run, posed headless.
//
//   ./build.sh benchmarks/bench_motion_matching.ae && ./build/bench_motion_matching
//
// The builds are 1,000 unless AE3D_BENCH_FRAMES says fewer (CI's smoke run);
// every one is freed, so the leak check at exit (ci.sh, macOS) holds them to
// leaving nothing behind. The frames are 100 of 2,000 searches, each figure
// asking for its own way and pace and facing its own way; the fastest frame
// is the number, against #509's 1 ms.

import ae3d.core
import ae3d.figure
import ae3d.matching
import ae3d.jobs

extern clock_ns() -> long
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const FOX = "tests/fixtures/gltf/Fox.glb"
const FIGURES = 2000
const GRAIN = 64
var BUILDS = 1000
var FRAMES = 100

struct SearchJob {
    matchers: ptr                    // *Matcher[FIGURES]
    found: ptr                       // int[FIGURES]
}

search_run(start: int, end: int, worker: int, context: ptr) {
    job = context as *SearchJob
    ms = job.matchers as ptr[]
    found = job.found as int[]
    i = start
    while i < end {
        found[i] = matching.search(ms[i] as *Matcher)
        i = i + 1
    }
}

// A database over the fox's three clips.
built(fig: *Figure, group: *Model) -> *Database {
    db = matching.database_new(fig, group)
    matching.add_clip(db, "Survey")
    matching.add_clip(db, "Walk")
    matching.add_clip(db, "Run")
    matching.build(db)
    return db
}

// Figure `i`'s own way, pace and facing, spread over the circle and from
// standing to a run, the same every run.
set_up(m: *Matcher, i: int, run: float) {
    a = (i as float) * 2.39996323           // the golden angle
    pace = run * ((i % 7) as float) / 6.0
    matching.set_input(m, core.vec3(core.sin_of(a) * pace, 0.0, core.cos_of(a) * pace))
    m.velocity = core.vec3(core.sin_of(a * 0.5) * pace * 0.5, 0.0, core.cos_of(a * 0.5) * pace * 0.5)
    m.heading = a * 0.3
    m.frame = (i * 37) % matching.frames(m.db as *Database)
}

main() {
    println("bench_motion_matching: motion matching at a crowd's scale (#509)")
    BUILDS = core.env_int("AE3D_BENCH_FRAMES", BUILDS)
    FRAMES = core.env_int("AE3D_BENCH_FRAMES", FRAMES)
    group = core.model_new()
    core.model_set_scale(group, 0.01, 0.01, 0.01)
    fig = figure.figure_new(FOX, group)
    if fig == null {
        println("  SKIP ${FOX} would not load")
        core.model_free(group)
        return
    }

    // Builds and frees.
    started = clock_ns()
    k = 0
    while k < BUILDS {
        matching.database_free(built(fig, group))
        k = k + 1
    }
    build_ns = clock_ns() - started
    println("  ${BUILDS} database builds and frees: ${(build_ns / 1000000) as int} ms, ${(build_ns / (BUILDS * 1000)) as int} us each")

    // 2,000 figures over one database.
    db = built(fig, group)
    run = matching.clip_speed(db, 2)
    block = calloc(FIGURES, 8)
    ms = block as ptr[]
    found_block = calloc(FIGURES, 4)
    i = 0
    while i < FIGURES {
        m = matching.matcher_new(db)
        set_up(m, i, run)
        ms[i] = m as ptr
        i = i + 1
    }
    job = SearchJob { matchers: block, found: found_block }

    // One thread, then the pool: the fastest frame of each.
    one = fastest(&job, FRAMES)
    jobs.start(0)
    pooled = fastest(&job, FRAMES)
    threads = jobs.threads()
    jobs.stop()
    println("  ${matching.frames(db)} frames in the database; ${FIGURES} searches a frame, the fastest of ${FRAMES}: one thread ${(one as float) / 1000000.0} ms, the job system's ${threads} threads ${(pooled as float) / 1000000.0} ms")
    within = "within"
    if pooled > 1000000 { within = "NOT within" }
    println("  ${within} #509's 1 ms for 2,000 figures")

    i = 0
    while i < FIGURES {
        matching.matcher_free(ms[i] as *Matcher)
        i = i + 1
    }
    free(block)
    free(found_block)
    matching.database_free(db)
    figure.figure_free(fig)
    core.model_free(group)
}

// The fastest of `frames` frames of every figure's search, nanoseconds.
fastest(job: *SearchJob, frames: int) -> long {
    best = 0 as long
    f = 0
    while f < frames {
        started = clock_ns()
        jobs.parallel_for(search_run, FIGURES, GRAIN, job as ptr)
        took = clock_ns() - started
        if f == 0 || took < best { best = took }
        f = f + 1
    }
    return best
}
