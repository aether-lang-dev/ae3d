// What text in the world costs a frame (#871), on both renderers.
//
// A scene of twenty-four spheres is drawn offscreen at 1280x720 and each frame
// is waited for (the readback), with no label, then with 10, 100 and 500
// labels of eight glyphs each over everything (so none is hidden, the dearest
// case for the pixel shader too). Each line is the mean wall time a frame
// takes, with the GPU's own scene-pass time beside it (three frames behind,
// as the backends read it), and the cost of the labels over the frame without.

import std.list
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.hud

extern clock_ns() -> long

const WIDTH = 1280
const HEIGHT = 720
var FRAMES = 200

build_scene(pass_backend: *Backend, models: ptr) {
    i = 0
    while i < 24 {
        m = loader.sphere(1.0, 24, 18)
        core.model_set_scale(m, 8.0, 8.0, 8.0)
        core.model_set_position(m, ((i % 6) * 1.0) * 26.0 - 65.0, 12.0, ((i / 6) * 1.0) * 26.0 - 39.0)
        core.model_polished_metal(m, 0.7, 0.5, 0.3)
        core.backend_add_model(pass_backend, m)
        list.add_raw(models, m)
        i = i + 1
    }
}

// `labels` labels asked for, in a grid in front of the spheres, as a game would
// every frame.
ask(h: *Hud, labels: int) {
    hud.clear(h)
    hud.world_text_depth(h, false)
    white = hud.rgba(1.0, 1.0, 1.0, 1.0)
    i = 0
    while i < labels {
        hud.world_text(h, ((i % 20) * 1.0) * 9.0 - 85.0, 4.0 + ((i / 20) * 1.0) * 4.0, 40.0, 3.0, "Grunt 07", white)
        i = i + 1
    }
}

// Mean microseconds a frame of the backend takes with `labels` labels, and the
// GPU's scene pass in microseconds; which 0 is OpenGL (the target to read), 1
// Vulkan.
measure(pass: *Backend, which: int, target: ptr, renderer: ptr, h: *Hud, cam: *Camera, light: *Light, labels: int) -> (int, int) {
    k = 0
    while k < 30 {
        ask(h, labels)
        core.backend_render(pass, cam, light)
        k = k + 1
    }
    started = clock_ns()
    scene = 0.0
    frame = 0
    while frame < FRAMES {
        ask(h, labels)
        core.backend_render(pass, cam, light)
        if which == 0 {
            offscreen.target_pixels(target)
            scene = scene + gl.renderer_scene_ms(renderer as *GLRenderer)
        } else {
            vulkan.offscreen_pixels()
            scene = scene + vulkan.renderer_scene_ms(renderer as *VKRenderer)
        }
        frame = frame + 1
    }
    elapsed = clock_ns() - started
    hud.clear(h)
    return (elapsed / 1000) as int / FRAMES, ((scene * 1000.0) / (FRAMES as float)) as int
}

report(name: string, pass: *Backend, which: int, target: ptr, renderer: ptr, h: *Hud, cam: *Camera, light: *Light) {
    // Twice, the better kept: the first runs a device still warming up.
    base, base_gpu = measure(pass, which, target, renderer, h, cam, light, 0)
    again, again_gpu = measure(pass, which, target, renderer, h, cam, light, 0)
    if again < base { base = again }
    if again_gpu < base_gpu { base_gpu = again_gpu }
    println("  ${name}: no labels ${base} us a frame, GPU scene pass ${base_gpu} us")
    counts = [10, 100, 500]
    k = 0
    while k < 3 {
        wall, gpu = measure(pass, which, target, renderer, h, cam, light, counts[k])
        println("  ${name}: ${counts[k]} labels ${wall} us a frame (${wall - base} over), GPU scene pass ${gpu} us (${gpu - base_gpu} over)")
        k = k + 1
    }
}

main() {
    FRAMES = core.env_int("AE3D_BENCH_FRAMES", FRAMES)
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("world text: SKIP no OpenGL context")
        return
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 40.0, 150.0))
    core.camera_look_at(cam, core.vec3(0.0, 8.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.7, 0.4))
    println("ae3d world text benchmark at ${WIDTH}x${HEIGHT}")

    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, WIDTH, HEIGHT) {
        println("world text: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    gl.renderer_set_clear_color(renderer, 0.05, 0.06, 0.08)
    models = list.new()
    build_scene(&backend, models)
    gl_hud = hud.hud_new()
    core.backend_set_overlay(&backend, gl_hud as ptr)
    report("OpenGL", &backend, 0, target, renderer as ptr, gl_hud, cam, light)
    core.backend_set_overlay(&backend, null)
    hud.hud_free(gl_hud)
    core.backend_cleanup(&backend)

    if vulkan.available() {
        vk_renderer = vulkan.renderer_new()
        vk_backend = vulkan.backend(vk_renderer)
        if core.backend_init(&vk_backend, null, WIDTH, HEIGHT) {
            vulkan.renderer_set_clear_color(vk_renderer, 0.05, 0.06, 0.08)
            vk_models = list.new()
            build_scene(&vk_backend, vk_models)
            vk_hud = hud.hud_new()
            core.backend_set_overlay(&vk_backend, vk_hud as ptr)
            report("Vulkan", &vk_backend, 1, null, vk_renderer as ptr, vk_hud, cam, light)
            core.backend_set_overlay(&vk_backend, null)
            hud.hud_free(vk_hud)
            core.backend_cleanup(&vk_backend)
            i = 0
            while i < list.size(vk_models) {
                core.model_free(list.get_raw(vk_models, i) as *Model)
                i = i + 1
            }
            list.free(vk_models)
        } else {
            println("world text: SKIP Vulkan would not start")
        }
        vulkan.renderer_free(vk_renderer)
    }

    i = 0
    while i < list.size(models) {
        core.model_free(list.get_raw(models, i) as *Model)
        i = i + 1
    }
    list.free(models)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)
    gl.renderer_free(renderer)
    core.camera_free(cam)
    core.light_free(light)
    println("done")
}
