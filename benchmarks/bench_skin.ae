// What a skinned vertex costs on the device (#855), on Vulkan, the default
// backend: the scene pass's own GPU time (its timestamps, renderer_stage_ms)
// for a grid of 262,144 vertices drawn skinned, each on four bones spread
// over a skeleton of 96 and of 256, against the same grid drawn rigid. What
// a vertex costs its skin is the difference over the vertices. The grid is
// far from the camera and small on screen, so its pixels cost next to
// nothing and the pass is its vertices.
//
// The palettes are read from the skin rows -- the frame's ring, a storage
// buffer -- since #855 lifted the 96-bone cap of the uniform array they were
// read from before; this is what holds the per-vertex cost of a 96-bone
// figure to what it was.
//
// The skinned and the rigid draw alternate block by block and each keeps its
// fastest block, as bench_shadow does: drift cancels, and the fastest block
// is the one least disturbed by the rest of the machine. AE3D_BENCH_FRAMES
// sets a block's frames, AE3D_BENCH_BLOCKS the blocks, AE3D_BENCH_BONES one
// skeleton's size alone (96 or 256).

import std.list
import ae3d.core
import ae3d.vulkan
import ae3d.loader
import ae3d.skin

const WIDTH = 640
const HEIGHT = 360
const SIDE = 512

frames() -> int { return core.env_int("AE3D_BENCH_FRAMES", 120) }
blocks() -> int { return core.env_int("AE3D_BENCH_BLOCKS", 6) }

// A flat grid of SIDE x SIDE vertices, skinned only where `skinned`: each on
// four of `bones` bones, picked by a hash of where it is where `spread`, so
// neighbouring vertices read all over the palette (the worst case for a
// read every lane of a wave makes at a different place), or the same four
// for a band of rows, as a body's limbs are.
grid(bones: int, skinned: bool, spread: bool) -> ptr {
    mesh = core.mesh_create()
    core.mesh_reserve(mesh, SIDE * SIDE, (SIDE - 1) * (SIDE - 1) * 6)
    y = 0
    while y < SIDE {
        x = 0
        while x < SIDE {
            core.mesh_push_vertex(mesh, core.vec3((x as float) / 256.0, (y as float) / 256.0, 0.0), 0.0, 0.0,
                                  core.vec3(0.0, 0.0, 1.0))
            x = x + 1
        }
        y = y + 1
    }
    y = 0
    while y < SIDE - 1 {
        x = 0
        while x < SIDE - 1 {
            a = y * SIDE + x
            core.mesh_push_index(mesh, a)
            core.mesh_push_index(mesh, a + 1)
            core.mesh_push_index(mesh, a + SIDE + 1)
            core.mesh_push_index(mesh, a)
            core.mesh_push_index(mesh, a + SIDE + 1)
            core.mesh_push_index(mesh, a + SIDE)
            x = x + 1
        }
        y = y + 1
    }
    if skinned {
        v = 0
        while v < SIDE * SIDE {
            if spread {
                h = ((v % 4096) * 7919 + (v / 4096) * 104729) % 1000003
                core.mesh_set_skin(mesh, v, h % bones, (h / 7) % bones, (h / 49) % bones, (h / 343) % bones,
                                   0.4, 0.3, 0.2, 0.1)
            } else {
                // A body's way: neighbours on the same bones, a band of
                // rows to a bone, as a limb's vertices are.
                j = (v / SIDE) * bones / SIDE
                core.mesh_set_skin(mesh, v, j, (j + 1) % bones, (j + 2) % bones, (j + 3) % bones, 0.4, 0.3, 0.2, 0.1)
            }
            v = v + 1
        }
    }
    return mesh
}

// The scene pass's mean GPU milliseconds over a block of frames, the bones
// turned a little each frame so the palette is written as a moving figure's.
time_block(backend: *Backend, r: *VKRenderer, cam: *Camera, light: *Light, bones: ptr, at: int) -> float {
    // A frame or two in flight: the first ones' timings are the block before's.
    k = 0
    while k < 3 {
        core.backend_render(backend, cam, light)
        k = k + 1
    }
    total = 0.0
    n = frames()
    f = 0
    while f < n {
        turn = ((at + f) % 64) * 0.001
        b = 0
        while b < list.size(bones) {
            core.model_set_rotation(list.get_raw(bones, b) as *Model, core.quat_rotate(turn, core.vec3(0.0, 0.0, 1.0)))
            b = b + 1
        }
        core.backend_render(backend, cam, light)
        total = total + vulkan.renderer_stage_ms(r, 1)
        f = f + 1
    }
    return total / (n as float)
}

bench_bones(backend: *Backend, r: *VKRenderer, cam: *Camera, light: *Light, count: int, spread: bool) {
    bones = list.new()
    sk = skin.skeleton_new()
    i = 0
    while i < count {
        bone = loader.cube(0.01)
        list.add_raw(bones, bone as ptr)
        skin.skeleton_add(sk, bone)
        i = i + 1
    }
    skin.skeleton_bind(sk)
    skinned = core.model_new()
    core.model_set_mesh(skinned, grid(count, true, spread))
    core.model_set_skeleton(skinned, sk as ptr)
    rigid = core.model_new()
    core.model_set_mesh(rigid, grid(count, false, spread))

    skinned_ms = 0.0
    rigid_ms = 0.0
    block = 0
    while block < blocks() {
        core.backend_add_model(backend, skinned)
        s = time_block(backend, r, cam, light, bones, block * 7)
        core.backend_remove_model(backend, skinned)
        core.backend_add_model(backend, rigid)
        g = time_block(backend, r, cam, light, bones, block * 7)
        core.backend_remove_model(backend, rigid)
        if block == 0 || s < skinned_ms { skinned_ms = s }
        if block == 0 || g < rigid_ms { rigid_ms = g }
        block = block + 1
    }
    vertices = SIDE * SIDE
    per_vertex = (skinned_ms - rigid_ms) * 1000000.0 / (vertices as float)
    layout = "a band of rows to a bone"
    if spread { layout = "bones spread by a hash" }
    println("  ${count} bones (${layout}), ${vertices} vertices: scene pass ${skinned_ms} ms skinned, ${rigid_ms} ms rigid; ${per_vertex} ns a skinned vertex")

    core.model_free(skinned)
    core.model_free(rigid)
    skin.skeleton_free(sk)
    i = 0
    while i < list.size(bones) {
        core.model_free(list.get_raw(bones, i) as *Model)
        i = i + 1
    }
    list.free(bones)
}

main() {
    println("bench_skin: a skinned vertex on the device (Vulkan)")
    if !vulkan.available() {
        println("  vulkan: SKIP no driver (${vulkan.last_error()})")
        return
    }
    renderer = vulkan.renderer_new()
    backend = vulkan.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("  vulkan: SKIP the backend would not initialise")
        vulkan.renderer_free(renderer)
        return
    }
    vulkan.renderer_set_shadows(renderer, false)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(1.0, 1.0, 40.0))
    core.camera_look_at(cam, core.vec3(1.0, 1.0, 0.0))
    core.camera_set_aspect(cam, (WIDTH * 1.0) / (HEIGHT * 1.0))
    light = core.light_directional(core.vec3(0.2, 0.4, 1.0), core.vec3(1.0, 1.0, 1.0), 1.0)

    only = core.env_int("AE3D_BENCH_BONES", 0)
    if only == 0 || only == 96 {
        bench_bones(&backend, renderer, cam, light, 96, false)
        bench_bones(&backend, renderer, cam, light, 96, true)
    }
    if only == 0 || only == 256 {
        bench_bones(&backend, renderer, cam, light, 256, false)
        bench_bones(&backend, renderer, cam, light, 256, true)
    }

    core.backend_cleanup(&backend)
    vulkan.renderer_free(renderer)
    core.light_free(light)
    core.camera_free(cam)
}
