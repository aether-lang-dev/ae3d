// Props placed by rule (ae3d.scatter) over a map a kingdom grows to: a
// 512 m square of ground sampled at a quarter metre, sixteen districts of
// two palettes each, a road through every row and column. What sampling
// the ground costs, what placing costs, and what building the instanced
// models costs, best of five, in milliseconds.
//
//   ./build.sh benchmarks/bench_scatter.ae && ./build/bench_scatter
//
// Headless.

import std.list
import std.os
import ae3d.core
import ae3d.loader
import ae3d.scatter

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const SIDE = 512.0
const DISTRICTS = 4          // a side
const RUNS = 5

rect(s: *Scatter, x0: float, z0: float, x1: float, z1: float, tags: string, wealth: float) {
    p = calloc(8, 8)
    v = p as float[]
    v[0] = x0
    v[1] = z0
    v[2] = x1
    v[3] = z0
    v[4] = x1
    v[5] = z1
    v[6] = x0
    v[7] = z1
    scatter.add_area(s, p, 4, tags, wealth)
    free(p)
}

road(s: *Scatter, x0: float, z0: float, x1: float, z1: float) {
    p = calloc(4, 8)
    v = p as float[]
    v[0] = x0
    v[1] = z0
    v[2] = x1
    v[3] = z1
    scatter.add_road(s, p, 2, 6.0)
    free(p)
}

map(a: *Model, b: *Model, c: *Model) -> *Scatter {
    s = scatter.scatter_new(7 as long)
    step = SIDE / (DISTRICTS as float)
    half = SIDE * 0.5
    i = 0
    while i < DISTRICTS {
        j = 0
        while j < DISTRICTS {
            x0 = (i as float) * step - half + 4.0
            z0 = (j as float) * step - half + 4.0
            tags = "residential"
            if (i + j) % 2 == 1 { tags = "industrial" }
            rect(s, x0, z0, x0 + step - 8.0, z0 + step - 8.0, tags, 0.5)
            j = j + 1
        }
        road(s, (i as float) * step - half, 0.0 - half, (i as float) * step - half, half)
        road(s, 0.0 - half, (i as float) * step - half, half, (i as float) * step - half)
        i = i + 1
    }
    clutter = scatter.palette_new("clutter", 0.05, 2.0)
    scatter.palette_tags(clutter, "residential", "")
    scatter.palette_slope(clutter, 0.0, 25.0)
    scatter.palette_align(clutter, scatter.ALIGN_ROAD)
    scatter.palette_prop(clutter, a, 2.0)
    scatter.palette_prop(clutter, b, 1.0)
    scatter.add_palette(s, clutter)
    crates = scatter.palette_new("crates", 0.03, 3.0)
    scatter.palette_tags(crates, "industrial", "")
    scatter.palette_align(crates, scatter.ALIGN_SURFACE)
    scatter.palette_prop(crates, c, 1.0)
    scatter.add_palette(s, crates)
    return s
}

main() {
    // 65 rows of vertices, 64 cells of 8 m; the plane starts at its origin.
    floor = loader.plane(65, SIDE / 64.0)
    core.model_set_position(floor, 0.0 - SIDE * 0.5, 0.0, 0.0 - SIDE * 0.5)
    core.model_update_matrix(floor)
    grounds = list.new()
    list.add_raw(grounds, floor as ptr)
    a = loader.cube(0.5)
    b = loader.sphere(0.4, 8, 6)
    c = loader.cube(0.8)

    best_ground = 1000000
    best_run = 1000000
    best_build = 1000000
    placed = 0
    models = 0
    k = 0
    while k < RUNS {
        t0 = os.now_monotonic_ms()
        g = scatter.ground_new(grounds, 0.25)
        t1 = os.now_monotonic_ms()
        s = map(a, b, c)
        placed = scatter.run(s, g)
        t2 = os.now_monotonic_ms()
        built = scatter.build_models(s)
        t3 = os.now_monotonic_ms()
        models = list.size(built)
        if t1 - t0 < best_ground { best_ground = (t1 - t0) as int }
        if t2 - t1 < best_run { best_run = (t2 - t1) as int }
        if t3 - t2 < best_build { best_build = (t3 - t2) as int }
        scatter.models_free(built)
        scatter.scatter_free(s)
        scatter.ground_free(g)
        k = k + 1
    }
    println("bench_scatter: ${placed} props over ${SIDE} m square, ${models} instanced models")
    println("  ground sampled (2048 x 2048 cells)  ${best_ground} ms")
    println("  placed                              ${best_run} ms")
    println("  instanced models built              ${best_build} ms")

    core.model_free(a)
    core.model_free(b)
    core.model_free(c)
    core.model_free(floor)
    list.free(grounds)
}
