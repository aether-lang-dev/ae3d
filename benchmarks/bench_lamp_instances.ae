// Placed props drawn as instances, standing still among shadowed lamps, on
// Vulkan: a town's kit. What each frame draws and what its shadow work
// costs once the lamps' faces have their static layers.
//
//   ./build.sh benchmarks/bench_lamp_instances.ae && ./build/bench_lamp_instances
//
// Headless, offscreen; prints draws a frame and the shadow stage's
// milliseconds, averaged over the frames after the first few.

import std.list
import std.os
import ae3d.core
import ae3d.vulkan
import ae3d.loader

const WIDTH = 1280
const HEIGHT = 720
const KINDS = 40
const EACH = 25
const LAMPS = 10
const FRAMES = 60
const WARM = 5

main() {
    if !vulkan.available() {
        println("bench_lamp_instances: SKIP no Vulkan driver")
        return
    }
    r = vulkan.renderer_new()
    backend = vulkan.backend(r)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("bench_lamp_instances: SKIP Vulkan would not start")
        vulkan.renderer_free(r)
        return
    }
    core.backend_set_shadows(&backend, true)
    core.backend_set_shadow_distance(&backend, 200.0)
    models = list.new()
    ground = loader.cube(1.0)
    core.model_set_scale(ground, 300.0, 0.2, 300.0)
    core.model_set_position(ground, 0.0, 0.0 - 0.1, 0.0)
    core.backend_add_model(&backend, ground)
    list.add_raw(models, ground as ptr)
    k = 0
    while k < KINDS {
        prop = loader.cube(0.8)
        core.model_enable_instancing(prop, EACH)
        i = 0
        while i < EACH {
            core.model_set_instance_position(prop, i, core.vec3(((k % 8) as float) * 10.0 - 40.0 + (i % 5) as float, 0.5, ((k / 8) as float) * 10.0 - 25.0 + (i / 5) as float))
            i = i + 1
        }
        core.model_set_instance_draw_count(prop, EACH)
        core.model_recalculate_bounds(prop)
        core.backend_add_model(&backend, prop)
        list.add_raw(models, prop as ptr)
        k = k + 1
    }
    lamps = list.new()
    k = 0
    while k < LAMPS {
        l = core.light_point(core.vec3(((k % 5) as float) * 18.0 - 36.0, 4.0, ((k / 5) as float) * 20.0 - 10.0), core.vec3(1.0, 0.9, 0.7), 4.0, 25.0)
        core.backend_add_light(&backend, l)
        list.add_raw(lamps, l as ptr)
        k = k + 1
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 45.0, 60.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    moon = core.light_directional(core.vec3(0.2, 1.0, 0.3), core.vec3(0.3, 0.3, 0.4), 0.1)

    draws = 0
    shadow = 0.0
    started = 0 as long
    frame = 0
    while frame < FRAMES {
        if frame == WARM { started = os.now_monotonic_ms() }
        core.backend_render(&backend, cam, moon)
        if frame >= WARM {
            draws = draws + vulkan.renderer_draw_calls(r)
            shadow = shadow + vulkan.renderer_shadow_ms(r)
        }
        frame = frame + 1
    }
    n = FRAMES - WARM
    wall = ((os.now_monotonic_ms() - started) as float) / (n as float)
    println("bench_lamp_instances: ${KINDS} instanced props of ${EACH}, ${LAMPS} lamps: ${draws / n} draws a frame, ${wall} ms a frame, shadow stage ${shadow / (n as float)} ms")

    i = 0
    while i < list.size(models) {
        m = list.get_raw(models, i) as *Model
        core.backend_remove_model(&backend, m)
        core.model_free(m)
        i = i + 1
    }
    list.free(models)
    i = 0
    while i < list.size(lamps) {
        core.light_free(list.get_raw(lamps, i) as *Light)
        i = i + 1
    }
    list.free(lamps)
    core.light_free(moon)
    core.camera_free(cam)
    core.backend_cleanup(&backend)
    vulkan.renderer_free(r)
}
