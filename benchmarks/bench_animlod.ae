// What a figure costs a frame at each level of detail (#862, ae3d.animlod),
// against the 2,000-figure budget: UE5 mannequins on 100STYLE's neutral
// gaits walking at 1.2 m/s, no window, the engine stepped by hand at 60 Hz.
//
//   ./build.sh benchmarks/bench_animlod.ae && ./build/bench_animlod
//
//   - the full figure (ae3d.character's humanoid: its mover, its graph, its
//     feet on the ground, its eyes): the engine's frame with FIGURES of them,
//     less its frame with none, over FIGURES; and its graph's own evaluation
//     (animator.graph_cost);
//   - the same figures with their graph evaluated one frame in 2, 4 and 8
//     (animator.set_every), drawn between;
//   - a crowd instance: the horde's step and its three-tier sort over CROWD
//     instances on a bank baked from the figure's own move blend
//     (animlod.bake), over CROWD, on one thread; its skinning is the GPU's
//     and not counted here;
//   - so what 2,000 figures cost a frame: as crowd instances; with the 100
//     nearest full figures (Siltreach's plan: 2 ms for 100 near and 2,000 in
//     the crowd); and every one a full figure at one frame in 8;
//   - what a figure holds (#990), from the heap's count as they are made:
//     the file's animations and the gaits' takes, made once and shared,
//     and each figure's own (its scene of the file, its meshes among it;
//     its figure, animator, graph, mover, feet and capsule), and at the end
//     its physical animation;
//   - a full figure's frame by system (animator.profile), on one thread;
//   - and the full figures with their animators evaluated on the engine's
//     job pool (AE3D_JOBS threads, or one a hardware thread), a figure's
//     share of that frame times the plan's 100.
//
// The figures stand on a floor in a physics world: their capsules move
// them and their feet read the ground by its rays. Everything but the last
// line is measured with the animators on this thread (animator.on_pool).
//
// Each number is the fastest of BLOCKS blocks of FRAMES frames' mean, so a
// run taken while the machine is busy reads the quiet blocks. AE3D_BENCH_
// FRAMES and AE3D_BENCH_BLOCKS make CI's smoke run short.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.skin
import ae3d.animator
import ae3d.character
import ae3d.crowd
import ae3d.animlod
import ae3d.jobs
import ae3d.gltf
import ae3d.clips
import ae3d.pose
import std.mem
import std.os

extern clock_ns() -> long
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
// The plan's 100. A mannequin held about 59 MB (its file's 43 animations
// read for each), and 100 of them peaked at 5.9 GB, so this ran 64; read
// once and shared (#990), a mannequin holds about 1.7 MB of its own.
const FIGURES = 100
const CROWD = 2000
const NEAR = 100
const BANK_FRAMES = 32
const WALK = 1.2
var FRAMES = 120
var BLOCKS = 5

var g_engine: ptr = null
var g_people: ptr = null
// The heap at each stage of making the figures (#990), bytes.
var g_base: long = 0             // the heap before any figure
var g_file_first: long = 0       // the file's first scene: its nodes, skeleton and meshes, and its animations
var g_first: long = 0            // the first figure: its own, and the gaits' takes made for its file
var g_instance: long = 0         // another scene of the file: its own nodes, skeleton and meshes
var g_after_first: long = 0      // the heap once the first figure stood alone
var g_made: long = 0             // and once every figure was made
var g_stepped: long = 0          // and after 90 frames of them walking

person(i: int) -> *Character { return (g_people as ptr[])[i] as *Character }

mib(bytes: long) -> float { return (bytes as float) / 1048576.0 }

// Where a figure's bytes go (#990), from the heap's own count
// (std.mem.heap_in_use) as the figures were made, and from the figure's
// meshes and the gaits' takes as they hold them: what is made once for a
// file and a skeleton and shared by every figure on them, and what each
// figure holds of its own.
memory_report() {
    own = (g_made - g_after_first) / ((FIGURES - 1) as long)
    animations = g_file_first - g_instance
    takes = g_first - own
    a = character.animator_of(person(0))
    r = animator.rig(a)
    long held = 0
    long raw = 0
    seen = 0
    s = 0
    while s < animator.state_count(a) {
        j = 0
        while j < animator.state_take_count(a, s) {
            t = animator.state_take_at(a, s, j)
            held = held + clips.take_bytes(t)
            raw = raw + (clips.frames(t) as long) * ((pose.size(r) * 8 + 64) as long)
            seen = seen + 1
            j = j + 1
        }
        s = s + 1
    }
    f = figure.figure_of(character.object_of(person(0)))
    long meshes = 0
    p = 0
    while p < figure.primitive_count(f) {
        m = figure.primitive(f, p)
        meshes = meshes + (core.mesh_vertex_count(m.mesh) as long) * (84 as long) + (core.mesh_index_count(m.mesh) as long) * (4 as long)
        p = p + 1
    }
    println("  memory (the heap's count, #990):")
    println("    shared, once a file and a skeleton: the file's ${gltf.animation_count(figure.scene(f))} animations ${mib(animations)} MB; the gaits' takes (made and kept by the gaits) ${mib(takes)} MB, of which their ${seen} state takes ${mib(held)} MB compressed (${mib(raw)} MB as they were)")
    println("    a figure's own: ${mib(own)} MB: its scene of the file (nodes, skeleton, meshes) ${mib(g_instance)} MB, the meshes ${mib(meshes)} MB of it; its figure, animator, graph, mover, feet and capsule ${mib(own - g_instance)} MB; ${mib((g_stepped - g_made) / (FIGURES as long))} MB more after 90 frames walking")
    println("    ${FIGURES} figures: ${mib(g_stepped - g_base)} MB on the heap; the process's private memory ${mib(os.memory_private())} MB")
}

// A figure's physical animation (ae3d.physanim) put on every figure, as at
// a first blow: what each holds, its ragdoll's bodies in the world among
// it, from the heap's count.
physanim_memory() {
    before = mem.heap_in_use()
    i = 0
    while i < FIGURES {
        _bodied = character.physical(person(i))
        i = i + 1
    }
    println("    a figure's physical animation (put on at its first blow): ${mib((mem.heap_in_use() - before) / (FIGURES as long))} MB more")
}

// One frame of every figure walking on.
step(count: int) {
    ahead = core.vec3(0.0, 0.0, WALK)
    still = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < count {
        character.move(person(i), ahead, still)
        i = i + 1
    }
    engine.engine_update(g_engine as *Engine, STEP)
}

// Where a full figure's frame goes, system by system (animator.profile):
// FRAMES frames of every figure at every frame, microseconds a figure a
// frame, and the skinning palette the renderer rebuilds before it draws
// (skin.skeleton_update, timed here: no renderer runs). What the sections
// do not hold is the engine's and the physics world's own step.
breakdown(frame: float) {
    animator.profile(true)
    animator.profile_reset()
    long skinning = 0
    started = clock_ns()
    k = 0
    while k < FRAMES {
        step(FIGURES)
        began = clock_ns()
        i = 0
        while i < FIGURES {
            f = figure.figure_of(character.object_of(person(i)))
            s = 0
            while s < figure.skeleton_count(f) {
                skin.skeleton_update(figure.skeleton_at(f, s))
                s = s + 1
            }
            i = i + 1
        }
        skinning = skinning + (clock_ns() - began)
        k = k + 1
    }
    animator.profile(false)
    per = 1000000.0 / ((FRAMES * FIGURES) as float)
    total = ((clock_ns() - started - skinning) as float) / 1000.0 / ((FRAMES * FIGURES) as float)
    println("  a full figure's frame by system (profiled, one pass of ${FRAMES} frames; the timers add their own cost):")
    held = 0.0
    sec = 0
    while sec < animator.PROF_SECTIONS {
        us = animator.profile_seconds(sec) * per
        held = held + us
        println("    ${animator.profile_name(sec)}: ${us} us")
        sec = sec + 1
    }
    println("    the engine's and the physics world's step (the rest of ${total} us, the empty frame's ${frame / (FIGURES as float)} us among it): ${total - held} us")
    println("    the skinning palette (the renderer's, besides): ${(skinning as float) / 1000.0 / ((FRAMES * FIGURES) as float)} us")
}

// The fastest block's mean frame, microseconds.
frame_us(count: int) -> float {
    best = 0.0
    b = 0
    while b < BLOCKS {
        started = clock_ns()
        k = 0
        while k < FRAMES {
            step(count)
            k = k + 1
        }
        took = ((clock_ns() - started) as float) / 1000.0 / (FRAMES as float)
        if b == 0 || took < best { best = took }
        b = b + 1
    }
    return best
}

set_rate(every: int) {
    i = 0
    while i < FIGURES {
        animator.set_every(character.animator_of(person(i)), every, i)
        i = i + 1
    }
}

graph_us() -> float {
    sum = 0.0
    i = 0
    while i < FIGURES {
        sum = sum + animator.graph_cost(character.animator_of(person(i)))
        i = i + 1
    }
    return sum / (FIGURES as float) * 1000000.0
}

// A crowd instance's step and sort a frame, nanoseconds an instance.
crowd_ns(bank: @keep ptr, cycle: float) -> float {
    pos = calloc(CROWD * 3, 8)
    vel = calloc(CROWD * 3, 8)
    yaw = calloc(CROWD, 8)
    phase = calloc(CROWD, 8)
    col = calloc(CROWD * 3, 8)
    tiers = calloc(CROWD * 8 * 3, 8)
    counts = calloc(3, 8)
    at = pos as float[]
    ph = phase as float[]
    yw = yaw as float[]
    i = 0
    while i < CROWD {
        at[i * 3] = ((i % 50) as float) * 1.5
        at[i * 3 + 2] = ((i / 50) as float) * 1.5
        yw[i] = (i as float) * 2.39996323
        ph[i] = ((i * 37) % 100) as float / 100.0
        i = i + 1
    }
    best = 0.0
    b = 0
    while b < BLOCKS {
        started = clock_ns()
        k = 0
        while k < FRAMES {
            crowd.crowd_wander(vel, yaw, CROWD, WALK)
            crowd.crowd_step_out(pos, vel, yaw, phase, null, 0, CROWD, STEP, WALK, 0.0, 75.0, 0.0, 60.0, 0.0, cycle, bank)
            crowd_sort(pos, yaw, phase, col, tiers, counts)
            k = k + 1
        }
        took = ((clock_ns() - started) as float) / (FRAMES as float) / (CROWD as float)
        if b == 0 || took < best { best = took }
        b = b + 1
    }
    free(pos)
    free(vel)
    free(yaw)
    free(phase)
    free(col)
    free(tiers)
    free(counts)
    return best
}

// The three tiers' buffers laid end to end in `tiers`: position (3), yaw,
// phase and colour (3) a figure, each tier CROWD long.
crowd_sort(pos: @keep ptr, yaw: @keep ptr, phase: @keep ptr, col: @keep ptr, tiers: @keep ptr, counts: ptr) {
    t = tiers
    n = CROWD * 8
    crowd.crowd_tiers(pos, yaw, phase, col, 0, CROWD, 37.0, 30.0, 15.0, 40.0, 0.0,
                      t, t + n * 3, t + n * 4, t + n * 5,
                      t + n * 8, t + n * 11, t + n * 12, t + n * 13,
                      t + n * 16, t + n * 19, t + n * 20, t + n * 21, counts)
}

main() {
    println("bench_animlod: a figure's cost a frame at each level of detail (#862)")
    FRAMES = core.env_int("AE3D_BENCH_FRAMES", FRAMES)
    BLOCKS = core.env_int("AE3D_BENCH_BLOCKS", BLOCKS)
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g_engine = e as ptr
    // On this thread until the pool's own measure, at the end.
    animator.on_pool(false)
    // A floor in a physics world, as a game's figures stand on: each
    // figure's capsule moves it, and its feet read the ground under them by
    // the world's rays.
    physics.attach(e)
    floor = engine.object(e, "Floor", loader.cube(1.0))
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(200.0, 0.5, 200.0), physics.material(0.8, 0.0))
    empty = frame_us(0)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    g_people = calloc(FIGURES, 8)
    // What a figure holds, from the heap's own count, made in stages (#990).
    g_base = mem.heap_in_use()
    file = gltf.load(MANNEQUIN)
    h1 = mem.heap_in_use()
    i = 0
    while i < FIGURES {
        c = character.humanoid(e, "Walker", MANNEQUIN, g)
        if c == null {
            println("  SKIP no walker: ${character.error()}")
            return
        }
        behaviour.object_set_position(character.object_of(c), core.vec3(((i % 8) as float) * 2.0, 0.0, ((i / 8) as float) * 2.0))
        (g_people as ptr[])[i] = c as ptr
        if i == 0 {
            h2 = mem.heap_in_use()
            // A second scene of the file: its own nodes, skeleton and meshes
            // over the animations the first read.
            other = gltf.load(MANNEQUIN)
            h3 = mem.heap_in_use()
            g_instance = h3 - h2
            g_file_first = h1 - g_base
            g_first = h2 - h1
            gltf.scene_destroy(other)
            gltf.scene_destroy(file)
            g_after_first = mem.heap_in_use()
        }
        i = i + 1
    }
    g_made = mem.heap_in_use()
    k = 0
    while k < 90 {
        step(FIGURES)
        k = k + 1
    }
    g_stepped = mem.heap_in_use()
    memory_report()
    breakdown(empty)
    rates = [1, 2, 4, 8]
    costs = calloc(4, 8) as float[]
    r = 0
    while r < 4 {
        set_rate(rates[r])
        k = 0
        while k < 16 {
            step(FIGURES)
            k = k + 1
        }
        costs[r] = (frame_us(FIGURES) - empty) / (FIGURES as float)
        println("  a full figure, its graph one frame in ${rates[r]}: ${costs[r]} us a frame (its graph's evaluation ${graph_us()} us)")
        r = r + 1
    }
    set_rate(1)
    a = character.animator_of(person(0))
    started = clock_ns()
    bank = animlod.bake(a, character.move_state(person(0)), BANK_FRAMES)
    baked = ((clock_ns() - started) as float) / 1000000.0
    instance = crowd_ns(animlod.bank_posebank(bank), animlod.bank_cycle(bank))
    println("  a crowd instance: ${instance} ns a frame (its step and sort, one thread; its skinning the GPU's); the bank of ${BANK_FRAMES} frames baked in ${baked} ms")
    crowd_ms = instance * (CROWD as float) / 1000000.0
    near_ms = costs[0] * (NEAR as float) / 1000.0
    eighth_ms = costs[3] * (CROWD as float) / 1000.0
    println("  2,000 figures a frame: as crowd instances ${crowd_ms} ms; with the ${NEAR} nearest full figures besides ${near_ms + crowd_ms} ms on one thread (Siltreach's plan: 2 ms); every one a full figure at one frame in 8 ${eighth_ms} ms")
    // The same frame with the figures' animators evaluated on the engine's
    // job pool at each fixed step (animator's evaluate_step_all), its threads AE3D_JOBS or one a
    // hardware thread.
    animator.on_pool(true)
    k = 0
    while k < 16 {
        step(FIGURES)
        k = k + 1
    }
    pooled = (frame_us(FIGURES) - empty) / (FIGURES as float)
    pooled_ms = pooled * (NEAR as float) / 1000.0
    println("  on the job pool (${jobs.threads()} threads): a full figure ${pooled} us a frame; the ${NEAR} nearest full figures ${pooled_ms} ms, with 2,000 in the crowd ${pooled_ms + crowd_ms} ms (Siltreach's plan: 2 ms)")
    physanim_memory()
    animlod.bank_free(bank)
    free(costs as ptr)
    i = 0
    while i < FIGURES {
        character.character_free(person(i))
        i = i + 1
    }
    free(g_people)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
}
