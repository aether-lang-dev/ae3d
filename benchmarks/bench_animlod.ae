// What a figure costs a frame at each level of detail (#862, ae3d.animlod),
// against the 2,000-figure budget: UE5 mannequins on 100STYLE's neutral
// gaits walking at 1.2 m/s, no window, the engine stepped by hand at 60 Hz.
//
//   ./build.sh benchmarks/bench_animlod.ae && ./build/bench_animlod
//
//   - the full figure (ae3d.character's humanoid: its mover, its graph, its
//     feet on the ground, its eyes): the engine's frame with FIGURES of them,
//     less its frame with none, over FIGURES; and its graph's own evaluation
//     (animator.graph_cost);
//   - the same figures with their graph evaluated one frame in 2, 4 and 8
//     (animator.set_every), drawn between;
//   - a crowd instance: the horde's step and its three-tier sort over CROWD
//     instances on a bank baked from the figure's own move blend
//     (animlod.bake), over CROWD, on one thread; its skinning is the GPU's
//     and not counted here;
//   - so what 2,000 figures cost a frame: as crowd instances; with the 100
//     nearest full figures (Siltreach's plan: 2 ms for 100 near and 2,000 in
//     the crowd); and every one a full figure at one frame in 8.
//
// Each number is the fastest of BLOCKS blocks of FRAMES frames' mean, so a
// run taken while the machine is busy reads the quiet blocks. AE3D_BENCH_
// FRAMES and AE3D_BENCH_BLOCKS make CI's smoke run short.

import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.skin
import ae3d.animator
import ae3d.character
import ae3d.crowd
import ae3d.animlod

extern clock_ns() -> long
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const STEP = 0.016666666666666666
const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const FIGURES = 64
const CROWD = 2000
const NEAR = 100
const BANK_FRAMES = 32
const WALK = 1.2
var FRAMES = 120
var BLOCKS = 5

var g_engine: ptr = null
var g_people: ptr = null

person(i: int) -> *Character { return (g_people as ptr[])[i] as *Character }

// One frame of every figure walking on.
step(count: int) {
    ahead = core.vec3(0.0, 0.0, WALK)
    still = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < count {
        character.move(person(i), ahead, still)
        i = i + 1
    }
    engine.engine_update(g_engine as *Engine, STEP)
}

// Where a full figure's frame goes, system by system (animator.profile):
// FRAMES frames of every figure at every frame, microseconds a figure a
// frame, and the skinning palette the renderer rebuilds before it draws
// (skin.skeleton_update, timed here: no renderer runs). What the sections
// do not hold is the engine's and the physics world's own step.
breakdown(frame: float) {
    animator.profile(true)
    animator.profile_reset()
    long skinning = 0
    started = clock_ns()
    k = 0
    while k < FRAMES {
        step(FIGURES)
        began = clock_ns()
        i = 0
        while i < FIGURES {
            f = figure.figure_of(character.object_of(person(i)))
            s = 0
            while s < figure.skeleton_count(f) {
                skin.skeleton_update(figure.skeleton_at(f, s))
                s = s + 1
            }
            i = i + 1
        }
        skinning = skinning + (clock_ns() - began)
        k = k + 1
    }
    animator.profile(false)
    per = 1000000.0 / ((FRAMES * FIGURES) as float)
    total = ((clock_ns() - started - skinning) as float) / 1000.0 / ((FRAMES * FIGURES) as float)
    println("  a full figure's frame by system (profiled, one pass of ${FRAMES} frames; the timers add their own cost):")
    held = 0.0
    sec = 0
    while sec < animator.PROF_SECTIONS {
        us = animator.profile_seconds(sec) * per
        held = held + us
        println("    ${animator.profile_name(sec)}: ${us} us")
        sec = sec + 1
    }
    println("    the engine's and the physics world's step (the rest of ${total} us, the empty frame's ${frame / (FIGURES as float)} us among it): ${total - held} us")
    println("    the skinning palette (the renderer's, besides): ${(skinning as float) / 1000.0 / ((FRAMES * FIGURES) as float)} us")
}

// The fastest block's mean frame, microseconds.
frame_us(count: int) -> float {
    best = 0.0
    b = 0
    while b < BLOCKS {
        started = clock_ns()
        k = 0
        while k < FRAMES {
            step(count)
            k = k + 1
        }
        took = ((clock_ns() - started) as float) / 1000.0 / (FRAMES as float)
        if b == 0 || took < best { best = took }
        b = b + 1
    }
    return best
}

set_rate(every: int) {
    i = 0
    while i < FIGURES {
        animator.set_every(character.animator_of(person(i)), every, i)
        i = i + 1
    }
}

graph_us() -> float {
    sum = 0.0
    i = 0
    while i < FIGURES {
        sum = sum + animator.graph_cost(character.animator_of(person(i)))
        i = i + 1
    }
    return sum / (FIGURES as float) * 1000000.0
}

// A crowd instance's step and sort a frame, nanoseconds an instance.
crowd_ns(bank: @keep ptr, cycle: float) -> float {
    pos = calloc(CROWD * 3, 8)
    vel = calloc(CROWD * 3, 8)
    yaw = calloc(CROWD, 8)
    phase = calloc(CROWD, 8)
    col = calloc(CROWD * 3, 8)
    tiers = calloc(CROWD * 8 * 3, 8)
    counts = calloc(3, 8)
    at = pos as float[]
    ph = phase as float[]
    yw = yaw as float[]
    i = 0
    while i < CROWD {
        at[i * 3] = ((i % 50) as float) * 1.5
        at[i * 3 + 2] = ((i / 50) as float) * 1.5
        yw[i] = (i as float) * 2.39996323
        ph[i] = ((i * 37) % 100) as float / 100.0
        i = i + 1
    }
    best = 0.0
    b = 0
    while b < BLOCKS {
        started = clock_ns()
        k = 0
        while k < FRAMES {
            crowd.crowd_wander(vel, yaw, CROWD, WALK)
            crowd.crowd_step_out(pos, vel, yaw, phase, null, 0, CROWD, STEP, WALK, 0.0, 75.0, 0.0, 60.0, 0.0, cycle, bank)
            crowd_sort(pos, yaw, phase, col, tiers, counts)
            k = k + 1
        }
        took = ((clock_ns() - started) as float) / (FRAMES as float) / (CROWD as float)
        if b == 0 || took < best { best = took }
        b = b + 1
    }
    free(pos)
    free(vel)
    free(yaw)
    free(phase)
    free(col)
    free(tiers)
    free(counts)
    return best
}

// The three tiers' buffers laid end to end in `tiers`: position (3), yaw,
// phase and colour (3) a figure, each tier CROWD long.
crowd_sort(pos: @keep ptr, yaw: @keep ptr, phase: @keep ptr, col: @keep ptr, tiers: @keep ptr, counts: ptr) {
    t = tiers
    n = CROWD * 8
    crowd.crowd_tiers(pos, yaw, phase, col, 0, CROWD, 37.0, 30.0, 15.0, 40.0, 0.0,
                      t, t + n * 3, t + n * 4, t + n * 5,
                      t + n * 8, t + n * 11, t + n * 12, t + n * 13,
                      t + n * 16, t + n * 19, t + n * 20, t + n * 21, counts)
}

main() {
    println("bench_animlod: a figure's cost a frame at each level of detail (#862)")
    FRAMES = core.env_int("AE3D_BENCH_FRAMES", FRAMES)
    BLOCKS = core.env_int("AE3D_BENCH_BLOCKS", BLOCKS)
    e = engine.engine_new()
    engine.engine_set_fixed_step(e, STEP)
    g_engine = e as ptr
    // A floor in a physics world, as a game's figures stand on: each
    // figure's capsule moves it, and its feet read the ground under them by
    // the world's rays.
    physics.attach(e)
    floor = engine.object(e, "Floor", loader.cube(1.0))
    behaviour.object_set_position(floor, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(floor, core.vec3(200.0, 0.5, 200.0), physics.material(0.8, 0.0))
    empty = frame_us(0)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    g_people = calloc(FIGURES, 8)
    i = 0
    while i < FIGURES {
        c = character.humanoid(e, "Walker", MANNEQUIN, g)
        if c == null {
            println("  SKIP no walker: ${character.error()}")
            return
        }
        behaviour.object_set_position(character.object_of(c), core.vec3(((i % 8) as float) * 2.0, 0.0, ((i / 8) as float) * 2.0))
        (g_people as ptr[])[i] = c as ptr
        i = i + 1
    }
    k = 0
    while k < 90 {
        step(FIGURES)
        k = k + 1
    }
    breakdown(empty)
    rates = [1, 2, 4, 8]
    costs = calloc(4, 8) as float[]
    r = 0
    while r < 4 {
        set_rate(rates[r])
        k = 0
        while k < 16 {
            step(FIGURES)
            k = k + 1
        }
        costs[r] = (frame_us(FIGURES) - empty) / (FIGURES as float)
        println("  a full figure, its graph one frame in ${rates[r]}: ${costs[r]} us a frame (its graph's evaluation ${graph_us()} us)")
        r = r + 1
    }
    set_rate(1)
    a = character.animator_of(person(0))
    started = clock_ns()
    bank = animlod.bake(a, character.move_state(person(0)), BANK_FRAMES)
    baked = ((clock_ns() - started) as float) / 1000000.0
    instance = crowd_ns(animlod.bank_posebank(bank), animlod.bank_cycle(bank))
    println("  a crowd instance: ${instance} ns a frame (its step and sort, one thread; its skinning the GPU's); the bank of ${BANK_FRAMES} frames baked in ${baked} ms")
    crowd_ms = instance * (CROWD as float) / 1000000.0
    near_ms = costs[0] * (NEAR as float) / 1000.0
    eighth_ms = costs[3] * (CROWD as float) / 1000.0
    println("  2,000 figures a frame: as crowd instances ${crowd_ms} ms; with the ${NEAR} nearest full figures besides ${near_ms + crowd_ms} ms (Siltreach's plan: 2 ms); every one a full figure at one frame in 8 ${eighth_ms} ms")
    animlod.bank_free(bank)
    free(costs as ptr)
    i = 0
    while i < FIGURES {
        character.character_free(person(i))
        i = i + 1
    }
    free(g_people)
    character.gaits_free(g)
    figure.figures_free(e)
    engine.engine_free(e)
}
