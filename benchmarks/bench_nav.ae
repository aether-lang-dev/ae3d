// What a flow field costs (#817, #819): the flood, the clearance and a
// model's footprint, on a field the size of a sandbox world.
//
// The field is 1024 x 1024 cells of a metre, a million cells, with a city of
// 24 m blocks on 32 m centres, each with a 4 m gap through its middle, so the
// flood has walls to go round and gaps to find. Each line is the best of
// AE3D_BENCH_FRAMES runs (5 when unset) in milliseconds:
//
// - the flood with every cell at the same price;
// - the flood with a clearance of two cells round every wall, the costs
//   uneven, so a step's price is not one of two;
// - the clearance itself (a distance transform over the field);
// - a wall put up with the clearance on: only its neighbourhood priced again;
// - a fence's footprint from its triangles (`flow_block_mesh`), a mesh of
//   panels and posts along 600 m.

import ae3d.core
import ae3d.geometry
import ae3d.loader
import ae3d.nav

extern clock_ns() -> long

const SIZE = 1024.0

city(f: *FlowField) {
    z = 8.0
    while z + 24.0 < SIZE {
        x = 8.0
        while x + 24.0 < SIZE {
            nav.flow_block(f, x, z, x + 10.0, z + 24.0)
            nav.flow_block(f, x + 14.0, z, x + 24.0, z + 24.0)
            x = x + 32.0
        }
        z = z + 32.0
    }
}

ms(ns: long) -> float { return (ns as float) / 1000000.0 }

best_flood(f: *FlowField, runs: int) -> (float, int) {
    best = 0.0
    reached = 0
    k = 0
    while k < runs {
        started = clock_ns()
        reached = nav.flow_build(f, core.vec3(SIZE * 0.5 + 2.0, 0.0, SIZE * 0.5 + 2.0))
        took = ms(clock_ns() - started)
        if k == 0 || took < best { best = took }
        k = k + 1
    }
    return (best, reached)
}

main() {
    runs = core.env_int("AE3D_BENCH_FRAMES", 5)
    if runs < 1 { runs = 1 }
    f = nav.flow_new(0.0, 0.0, SIZE - 1.0, SIZE - 1.0, 1.0)
    city(f)

    even, reached = best_flood(f, runs)
    println("  flood, every cell one price:     ${even} ms (${reached} cells reached)")

    clearance = 0.0
    k = 0
    while k < runs {
        started = clock_ns()
        nav.flow_clearance(f, 2, 20)
        nav.flow_price(f, 0.0, 0.0)          // the clearance is measured when first read
        took = ms(clock_ns() - started)
        if k == 0 || took < clearance { clearance = took }
        k = k + 1
    }
    println("  clearance of two cells:          ${clearance} ms")
    uneven, reached_uneven = best_flood(f, runs)
    println("  flood, with the clearance:       ${uneven} ms (${reached_uneven} cells reached)")

    // A wall put up and torn down again, as a sandbox does: the marks and the
    // clearance round them made again, not the field's.
    // Timed over a thousand, each too quick for the clock alone.
    started = clock_ns()
    k = 0
    while k < 1000 {
        nav.flow_block(f, 500.0, 500.0, 520.0, 500.5)
        nav.flow_price(f, 0.0, 0.0)
        nav.flow_open(f, 500.0, 500.0, 520.0, 500.5)
        nav.flow_price(f, 0.0, 0.0)
        k = k + 1
    }
    wall = ((clock_ns() - started) as float) / 2000.0 / 1000.0
    println("  a 20 m wall up or down, clearance on: ${wall} us")

    // A fence along the diagonal: 300 panels 1.4 m wide and 1.5 m high, a
    // post at each, as one cube instanced 600 times (12 triangles each).
    fence = loader.cube(1.0)
    core.model_enable_instancing(fence, 600)
    inst = fence.instances
    i = 0
    while i < 300 {
        x = 100.0 + (i as float) * 1.4
        geometry.inst_set_trs(inst, i * 2, x, 0.75, x, 1.4, 1.5, 0.1, 0.0, 0.3826834, 0.0, 0.9238795)
        geometry.inst_set_trs(inst, i * 2 + 1, x + 0.7, 0.9, x + 0.7, 0.12, 1.8, 0.12, 0.0, 0.0, 0.0, 1.0)
        i = i + 1
    }
    triangles = 600 * geometry.mesh_index_count(fence.mesh) / 3
    footprint = 0.0
    k = 0
    while k < runs {
        nav.flow_clear(f)
        started = clock_ns()
        nav.flow_block_mesh(f, fence, 0.0 - 0.3, 2.2, 1)
        took = ms(clock_ns() - started)
        if k == 0 || took < footprint { footprint = took }
        k = k + 1
    }
    println("  a fence's footprint (${triangles} triangles): ${footprint} ms")
    core.model_free(fence)
    nav.flow_free(f)
    println("bench_nav: done")
}
