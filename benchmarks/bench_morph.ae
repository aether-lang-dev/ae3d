// What morph targets cost (#910): on the device, a morphed vertex for each
// active target, and the import of a file's targets.
//
// The device's cost is timed by its own clock (ae3d.vkmorph.time_dispatch:
// timestamps around back-to-back morphs of one mesh, nothing else in the
// command buffer), for a grid of 262,144 vertices with 16 targets, 1, 4 and
// 16 of them active. What a vertex costs a target is the slope between them;
// what is left at none is the pass's own cost a vertex (its bind pose read
// and its vertex written). With no target active nothing is dispatched at all
// (test_morph holds that).
//
// The import is MorphStressTest.glb (eight targets on each of its two
// primitives) loaded again and again: the whole load, and that load over
// its target vertices, which bounds what reading a target vertex costs.
//
// AE3D_BENCH_FRAMES sets the repeats (CI runs it short, as a smoke test).

import ae3d.core
import ae3d.gltf
import ae3d.morph
import ae3d.platform
import ae3d.vulkan

const SIDE = 512
const TARGETS = 16

repeats() -> int { return core.env_int("AE3D_BENCH_FRAMES", 200) }

// A flat grid of SIDE x SIDE vertices with TARGETS targets, every vertex
// moved by every target (the dense worst case a face's whole-head shapes are).
grid() -> *Model {
    mesh = core.mesh_create()
    core.mesh_reserve(mesh, SIDE * SIDE, (SIDE - 1) * (SIDE - 1) * 6)
    y = 0
    while y < SIDE {
        x = 0
        while x < SIDE {
            core.mesh_push_vertex(mesh, core.vec3((x as float) / 64.0, 0.0, (y as float) / 64.0), 0.0, 0.0, core.vec3(0.0, 1.0, 0.0))
            x = x + 1
        }
        y = y + 1
    }
    y = 0
    while y < SIDE - 1 {
        x = 0
        while x < SIDE - 1 {
            a = y * SIDE + x
            core.mesh_push_triangle(mesh, a, a + SIDE, a + 1)
            core.mesh_push_triangle(mesh, a + 1, a + SIDE, a + SIDE + 1)
            x = x + 1
        }
        y = y + 1
    }
    m = core.model_new()
    core.model_set_mesh(m, mesh)
    set = morph.set_new(SIDE * SIDE)
    t = 0
    while t < TARGETS {
        morph.add_target(set, "t${t}", 0.0)
        v = 0
        while v < SIDE * SIDE {
            morph.set_delta(set, t, v, 0.0, 0.001 * ((v + t) % 7) as float, 0.0, 0.0, 0.0, 0.01)
            v = v + 1
        }
        t = t + 1
    }
    core.model_set_morph(m, set as ptr)
    return m
}

device(n: int) {
    renderer = vulkan.renderer_new()
    pass = vulkan.backend(renderer)
    if !core.backend_init(&pass, null, 64, 64) {
        println("  skip Vulkan would not start (${vulkan.last_error()})")
        vulkan.renderer_free(renderer)
        return
    }
    cam = core.camera_new(64, 64)
    light = core.light_directional(core.vec3(0.2, 1.0, 0.3), core.vec3(1.0, 1.0, 1.0), 1.0)
    m = grid()
    core.backend_add_model(&pass, m)
    vertices = SIDE * SIDE
    ms1 = 0.0
    ms16 = 0.0
    counts = 3
    c = 0
    while c < counts {
        k = 1
        if c == 1 { k = 4 }
        if c == 2 { k = 16 }
        t = 0
        while t < TARGETS {
            w = 0.0
            if t < k { w = 0.5 }
            core.model_set_morph_weight(m, t, w)
            t = t + 1
        }
        // Two frames, so each frame slot's active list is this one.
        core.backend_render(&pass, cam, light)
        core.backend_render(&pass, cam, light)
        // The best of five runs: the first wakes the device's clocks from
        // idle, and a run between frames is measured at whatever they are.
        ms = 0.0 - 1.0
        run = 0
        while run < 5 {
            got = vulkan.renderer_time_morph(renderer, m, k, n)
            if got >= 0.0 && (ms < 0.0 || got < ms) { ms = got }
            run = run + 1
        }
        if ms < 0.0 {
            println("  skip the queue keeps no time")
            c = counts
        } else {
            each = ms / (n as float)
            ns = each * 1000000.0 / (vertices as float)
            println("  ${k} of ${TARGETS} targets active: ${each} ms a morph of ${vertices} vertices, ${ns} ns a vertex")
            if k == 1 { ms1 = each }
            if k == 16 { ms16 = each }
        }
        c = c + 1
    }
    if ms16 > 0.0 {
        slope = (ms16 - ms1) * 1000000.0 / ((vertices as float) * 15.0)
        fixed = ms1 * 1000000.0 / (vertices as float) - slope
        println("  a vertex costs ${slope} ns an active target, and ${fixed} ns for the pass itself")
    }
    core.backend_remove_model(&pass, m)
    core.backend_cleanup(&pass)
    core.model_free(m)
    core.light_free(light)
    core.camera_free(cam)
    vulkan.renderer_free(renderer)
}

import_cost(n: int) {
    path = "tests/fixtures/gltf/MorphStressTest.glb"
    loads = n / 10
    if loads < 3 { loads = 3 }
    offsets = 0
    start = platform.time()
    i = 0
    while i < loads {
        scene = gltf.load(path)
        if scene == null {
            println("  skip ${path} would not load")
            return
        }
        if i == 0 {
            k = 0
            while k < gltf.primitive_count(scene) {
                set = core.model_morph(gltf.primitive(scene, k)) as *MorphSet
                offsets = offsets + morph.count(set) * morph.vertex_count(set)
                k = k + 1
            }
        }
        gltf.scene_destroy(scene)
        i = i + 1
    }
    seconds = platform.time() - start
    per = seconds * 1000.0 / (loads as float)
    println("  MorphStressTest.glb: ${per} ms a load, ${offsets} target vertices (each a position and a normal), ${per * 1000000.0 / (offsets as float)} ns a target vertex at most (the whole load over them)")
}

main() {
    n = repeats()
    println("bench_morph (#910): ${n} repeats")
    println("on the device (Vulkan):")
    device(n)
    println("import:")
    import_cost(n)
}
