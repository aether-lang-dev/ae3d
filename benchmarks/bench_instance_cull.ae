// An instanced model's copies culled by cluster (#19), at a tile builder's
// scale: 600 tiles of 16 m (a 384 x 400 m map), each tile a ground piece of
// 3,200 triangles and four props of 5,000, every kind one instanced
// model whose copies cover the map; the camera over a corner, seeing about
// fifty tiles. What the scene pass costs with the copies drawn whole and
// culled by cluster -- the scene pass and the shadow pass, its cascades
// drawing the copies over them -- measured in turns (off a frame, on the next) so
// whatever else the device is doing falls on both, each the median of its
// frames; and the triangles each draws.
//
//   ./build.sh benchmarks/bench_instance_cull.ae && ./build/bench_instance_cull
//
// Headless, offscreen, Vulkan.
//
// The timed sweep is skipped on a software rasteriser, as bench_black_hole
// and test_crowd_render_scale already do: on a CI runner's llvmpipe a frame
// of this scene with its shadow cascades takes seconds, the sweep ran up to
// the suite's 300 s timeout (#1087), and the timings would describe the
// software, not the hardware. The triangle counts, which check the culling
// itself, are printed either way.

import std.list
import ae3d.core
import ae3d.geometry
import ae3d.vulkan
import ae3d.loader

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 1280
const HEIGHT = 720
const TILES_X = 24
const TILES_Z = 25
const TILE = 16.0
const FRAMES = 40
// A scene pass slower than this is a software rasteriser: bench_black_hole's
// guard. On the hardware these numbers describe it takes milliseconds.
const SLOW_FRAME_MS = 250.0

// A kind laid on every tile, at `lift` and offset (dx, dz) within it.
kind(mesh: *Model, lift: float, dx: float, dz: float) -> *Model {
    n = TILES_X * TILES_Z
    core.model_enable_instancing(mesh, n)
    i = 0
    while i < n {
        x = ((i % TILES_X) as float) * TILE - (TILES_X as float) * TILE * 0.5 + dx
        z = ((i / TILES_X) as float) * TILE - (TILES_Z as float) * TILE * 0.5 + dz
        core.model_set_instance_position(mesh, i, core.vec3(x, lift, z))
        i = i + 1
    }
    core.model_update_matrix(mesh)
    core.model_recalculate_bounds(mesh)
    return mesh
}

median(v: float[], n: int) -> float {
    a = 1
    while a < n {
        x = v[a]
        b = a - 1
        while b >= 0 && v[b] > x {
            v[b + 1] = v[b]
            b = b - 1
        }
        v[b + 1] = x
        a = a + 1
    }
    return (v[n / 2 - 1] + v[n / 2]) * 0.5
}

main() {
    if !vulkan.available() {
        println("bench_instance_cull: SKIP no Vulkan driver")
        return
    }
    r = vulkan.renderer_new()
    backend = vulkan.backend(r)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("bench_instance_cull: SKIP Vulkan would not start")
        vulkan.renderer_free(r)
        return
    }
    models = list.new()
    // The ground: 40 x 40 cells of 0.4 m, 3,200 triangles a tile.
    ground = kind(loader.plane(41, 0.4), 0.0, 0.0 - 8.0, 0.0 - 8.0)
    core.model_matte(ground, 0.35, 0.45, 0.3)
    list.add_raw(models, ground as ptr)
    k = 0
    while k < 4 {
        prop = kind(loader.sphere(1.2, 50, 50), 1.2, 0.0 - 5.0 + (k as float) * 3.5, 2.0)
        core.model_matte(prop, 0.6, 0.5, 0.4)
        list.add_raw(models, prop as ptr)
        k = k + 1
    }
    i = 0
    while i < list.size(models) {
        core.backend_add_model(&backend, list.get_raw(models, i) as *Model)
        i = i + 1
    }
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0 - 140.0, 70.0, 0.0 - 110.0))
    core.camera_look_at(cam, core.vec3(0.0 - 140.0, 0.0, 0.0 - 170.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    // The sun's cascades, out to a builder's shadow distance.
    core.backend_set_shadows(&backend, true)
    vulkan.renderer_set_shadow_distance(r, 110.0)

    // Still: clustered.
    f = 0
    while f < 6 {
        core.backend_render(&backend, cam, light)
        f = f + 1
    }
    // The warm-up's own scene pass says what kind of renderer this is.
    probe_ms = vulkan.renderer_scene_ms(r)
    software = probe_ms > SLOW_FRAME_MS
    whole_ms = 0.0
    culled_ms = 0.0
    whole_shadow = 0.0
    culled_shadow = 0.0
    block = calloc(FRAMES * 2, 8)
    ms = block as float[]
    shadow_block = calloc(FRAMES * 2, 8)
    shadow = shadow_block as float[]
    got = calloc(2, 4) as int[]
    if !software {
        f = 0
        while f < FRAMES * 2 + 4 {
            on = f % 2 == 1
            core.set_frustum_culling(on)
            core.backend_render(&backend, cam, light)
            // The reading is of the frame two before, which had this setting.
            side = f % 2
            if f >= 4 && got[side] < FRAMES {
                ms[side * FRAMES + got[side]] = vulkan.renderer_scene_ms(r)
                shadow[side * FRAMES + got[side]] = vulkan.renderer_shadow_ms(r)
                got[side] = got[side] + 1
            }
            f = f + 1
        }
        whole_ms = median(ms, FRAMES)
        culled_ms = median((block + FRAMES * 8) as float[], FRAMES)
        whole_shadow = median(shadow, FRAMES)
        culled_shadow = median((shadow_block + FRAMES * 8) as float[], FRAMES)
    }
    core.set_frustum_culling(true)

    // The triangles each draws: every copy, or the copies of the runs.
    frustum = core.frustum_new()
    core.camera_fill_frustum(cam, frustum)
    firsts = calloc(core.RUN_LIMIT, 4) as int[]
    counts = calloc(core.RUN_LIMIT, 4) as int[]
    whole_tris = 0
    culled_tris = 0
    runs_all = 0
    i = 0
    while i < list.size(models) {
        m = list.get_raw(models, i) as *Model
        tris = core.mesh_index_count(m.mesh) / 3
        whole_tris = whole_tris + tris * core.model_instance_count(m)
        runs = core.instance_runs(m, frustum, firsts, counts)
        runs_all = runs_all + runs
        k = 0
        while k < runs {
            culled_tris = culled_tris + tris * counts[k]
            k = k + 1
        }
        i = i + 1
    }
    clustered = geometry.inst_clusters(ground.instances) != null
    println("bench_instance_cull: ${TILES_X * TILES_Z} tiles, ${list.size(models)} instanced kinds, clustered ${clustered}, ${WIDTH}x${HEIGHT}")
    if software {
        println("  timing SKIP: a scene pass took ${probe_ms} ms, a software renderer; run it on a GPU")
        println("  drawn whole        ${whole_tris} triangles")
        println("  culled by cluster  ${culled_tris} triangles in ${runs_all} runs")
    } else {
        println("  drawn whole        ${whole_ms} ms scene pass, ${whole_shadow} ms shadow pass, ${whole_tris} triangles")
        println("  culled by cluster  ${culled_ms} ms scene pass, ${culled_shadow} ms shadow pass, ${culled_tris} triangles in ${runs_all} runs")
    }

    free(firsts as ptr)
    free(counts as ptr)
    core.frustum_free(frustum)
    free(got as ptr)
    free(block)
    free(shadow_block)
    i = 0
    while i < list.size(models) {
        m = list.get_raw(models, i) as *Model
        core.backend_remove_model(&backend, m)
        core.model_free(m)
        i = i + 1
    }
    list.free(models)
    core.light_free(light)
    core.camera_free(cam)
    core.backend_cleanup(&backend)
    vulkan.renderer_free(r)
}
