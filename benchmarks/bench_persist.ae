// What a save costs (#507), and which part of it the frame pays: a scene of
// 2,000 objects, each moved and carrying a component of five fields changed
// from their defaults, saved to a slot and loaded back. Each line is the best
// of AE3D_BENCH_FRAMES runs (5 when unset), in milliseconds:
//
// - the capture: the scene read into flat slots (persist.capture), the part
//   that reads the objects and has to be on the frame;
// - the capture made the document (persist.capture_doc), off the frame;
// - a whole save, the capture to the file on disk (persist.save; save_async
//   pays only the capture on the frame);
// - the slot read, checked and applied over the scene (persist.load).

import std.json
import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.persist

extern clock_ns() -> long

const OBJECTS = 2000

struct Gauge {
    level: float
    rate: float
    on: bool
    count: int
    aim: Vec3
}

gauge_new() -> ptr {
    g = heap.new(Gauge)
    g.level = 1.0
    g.rate = 0.5
    g.on = true
    return g as ptr
}

gauge_free(p: ptr) { heap.free(p as *Gauge) }

ms(ns: long) -> float { return (ns as float) / 1000000.0 }

main() {
    runs = core.env_int("AE3D_BENCH_FRAMES", 5)
    if runs < 1 { runs = 1 }
    k = component.kind("Gauge", "Bench", gauge_new, gauge_free)
    component.float_field(k, "level", offsetof(Gauge, level), 0.0, 0.0)
    component.float_field(k, "rate", offsetof(Gauge, rate), 0.0, 0.0)
    component.bool_field(k, "on", offsetof(Gauge, on))
    component.int_field(k, "count", offsetof(Gauge, count), 0, 0)
    component.vec3_field(k, "aim", offsetof(Gauge, aim))
    s = behaviour.scene_new()
    i = 0
    while i < OBJECTS {
        o = behaviour.object_new("Gauge ${i}")
        behaviour.scene_add(s, o)
        component.add(o, k)
        i = i + 1
    }
    base = persist.baseline(s)
    i = 0
    while i < OBJECTS {
        o = behaviour.scene_object(s, i)
        behaviour.object_set_position(o, core.vec3((i as float) * 0.5, 1.0, (i % 7) as float))
        g = component.state_of(o, k) as *Gauge
        g.level = 0.25 + (i as float) * 0.001
        g.rate = 2.0
        g.on = i % 2 == 0
        g.count = i
        g.aim = core.vec3(0.0, 1.0, (i as float) * 0.01)
        i = i + 1
    }
    snapshot = 0.0
    render = 0.0
    whole = 0.0
    load = 0.0
    r = 0
    while r < runs {
        started = clock_ns()
        cap = persist.capture(s, base, false)
        took = ms(clock_ns() - started)
        if r == 0 || took < snapshot { snapshot = took }
        started = clock_ns()
        doc = persist.capture_doc(cap)
        took = ms(clock_ns() - started)
        if r == 0 || took < render { render = took }
        json.free(doc)
        component.capture_free(cap)
        started = clock_ns()
        persist.save(s, base, "build/bench_persist.save", "bench", 0.0, null)
        took = ms(clock_ns() - started)
        if r == 0 || took < whole { whole = took }
        started = clock_ns()
        persist.load(s, "build/bench_persist.save")
        took = ms(clock_ns() - started)
        if r == 0 || took < load { load = took }
        r = r + 1
    }
    println("  the capture of ${OBJECTS} objects (on the frame): ${snapshot} ms")
    println("  the capture as a document (off it):     ${render} ms")
    println("  a save in all, capture to disk:         ${whole} ms (save_async: the capture on the frame, the rest on a worker)")
    println("  a load:                                  ${load} ms")
    persist.baseline_free(base)
    behaviour.scene_free(s)
    component.kinds_clear()
    println("bench_persist: done")
}
