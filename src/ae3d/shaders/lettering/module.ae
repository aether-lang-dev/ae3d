// ae3d.shaders.lettering: text in the 3D world (#871), written with `quote`
// like every pass since the hand-written ones went (docs/aether_quote_design.md
// section 11): one source, for Vulkan's SPIR-V, OpenGL's GLSL and the MSL.
//
// A run of text (ae3d.worldtext) is quads of glyphs laid out in the atlas's
// pixels, drawn into the scene after its transparent surfaces, over its
// light and under its depth. The vertices carry the glyph (its layout pixel,
// its atlas place, its colour and alpha, in the slots of a mesh vertex's
// position, texture coordinate, normal and baked occlusion) and the run
// is the draw's one instance, in the slots of an instance's matrix: its
// right and up axes with the scale from layout pixels already in them, its
// point, whether it is drawn over everything, and the field's value its edge
// is drawn at. The renderer writes the axes (the camera's for a run that
// faces it, turned about the world's up for an upright one) and the scale
// (from the pixels on the screen, for a run sized in them), so the shader
// does not branch on what kind of run it is, and one pipeline and one set of
// values draw every run of a frame.
//
//   - world_text_vertex: a vertex's layout pixel (x, y down) becomes a place
//     in the world, `origin + right * x - up * y`. The clip position is this
//     frame's (jittered, as every scene shader's) and last frame's, so the
//     text has a motion vector the temporal pass can follow. A run drawn
//     over everything (`on_top` 1) has its depth moved to the near plane, so
//     the depth test the pipeline always makes passes whatever is nearer.
//
//   - world_text: the glyph's signed distance, the atlas's texel (0.5 the
//     outline, rising inside), against the run's edge (0.5, or lower for an
//     outline drawn under the text, as the HUD's text_outlined does) one
//     pixel wide: the field's
//     change over a pixel on the screen is how wide to blur, so the text is as
//     sharp as it can be at the size and distance it is seen from, and the
//     colour (display values, as the HUD's) is turned to the light the scene
//     is made of. A texel with no coverage is dropped, so it writes neither a
//     colour nor a motion vector over what it is in front of.

import std.quote
import ae3d.gpu
import ae3d.gpu (GpuShader, fragment, vertex)
import ae3d.shaders.skydome (display_radiance, velocity)
import ae3d.shaderlib (vec2, vec3, vec4, mat4, Texture, texture, mul, mix, abs, max, smoothstep, dfdx, dfdy,
                       depth_clip, discard, m4_col, xyz, int_of, float_of)

exports (TextVertex, TextVaryings, TextOut, world_text_vertex, world_text, coverage, text_place)

// The glyph's corner: its layout pixel in x and y (z unused), its place in
// the atlas, its colour (the normal's slot), its alpha (the baked occlusion's)
// and the run, an instance's matrix: right and up with the scale in them, and
// the point, in its first three columns, `on_top` in the first's w and the
// edge in the second's.
struct TextVertex {
    position: vec3
    uv: vec2
    normal: vec3
    occlusion: float
    instance_model: mat4
}

// What the vertex shader hands on: `position` is gl_Position; the atlas
// place; the colour and alpha; the clip positions this frame and last, for
// the motion vector; the edge in 65536ths, an int so it is flat (one value
// for the whole run, 0.5 exactly as 32768).
struct TextVaryings {
    position: vec4
    uv: vec2
    colour: vec3
    alpha: float
    clip_now: vec4
    clip_prev: vec4
    edge: int
}


// The two outputs, as the scene's: colour and motion vector.
struct TextOut {
    colour: vec4
    velocity: vec2
}

// A layout pixel's place in the world: the run's point, then along its
// axes by the pixel (the axes carry the scale). The layout's y runs down,
// the world's up does not.
@quotable
text_place(origin: vec3, right: vec3, up: vec3, x: float, y: float) -> vec3 {
    return origin + right * x - up * y
}

// How much of a pixel the glyph covers where the field reads `d`, over a
// pixel `w` wide in field units, with its edge at `edge`: 0 outside, 1
// inside, the edge between.
@quotable
coverage(d: float, w: float, edge: float) -> float {
    reach = max(w * 0.5, 0.00001)
    return smoothstep(edge - reach, edge + reach, d)
}

world_text_vertex(view_projection: mat4, prev_view_projection: mat4) -> *GpuShader {
    return vertex("world_text_vertex") quote | v: TextVertex | {
        right = m4_col(v.instance_model, 0)
        up = m4_col(v.instance_model, 1)
        world = text_place(xyz(m4_col(v.instance_model, 2)), xyz(right), xyz(up), v.position.x, v.position.y)
        now = mul(view_projection, vec4(world, 1.0))
        prev = mul(prev_view_projection, vec4(world, 1.0))
        z = mix(now.z, depth_clip(0.0001) * now.w, right.w)
        return TextVaryings { position: vec4(vec3(now.x, now.y, z), now.w), uv: v.uv, colour: v.normal,
                              alpha: v.occlusion, clip_now: now, clip_prev: prev,
                              edge: int_of(up.w * 65536.0 + 0.5) }
    }
}

// `atlas` is the HUD's field and `jitter` the frame's temporal nudge, in
// pixels.
world_text(atlas: Texture, jitter: vec2) -> *GpuShader {
    return fragment("world_text") quote | f: TextVaryings | {
        d = texture(atlas, f.uv).x
        w = abs(dfdx(d)) + abs(dfdy(d))
        a = coverage(d, w, float_of(f.edge) / 65536.0) * f.alpha
        if a < 0.002 {
            discard()
        }
        return TextOut { colour: vec4(display_radiance(f.colour), a), velocity: velocity(f.clip_now, f.clip_prev, jitter) }
    }
}
