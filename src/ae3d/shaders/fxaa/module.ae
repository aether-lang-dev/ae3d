// ae3d.shaders.fxaa: FXAA, the last pass of the frame, written with `quote`.
//
// The body is ordinary Aether, type-checked against ae3d.shaderlib, and
// handed to ae3d.gpu as a tree: written out as GLSL for the renderers
// (tools/generate_quoted_shaders.ae) or run on the CPU (tests/test_gpu.ae).
// There is no uniform block, sampler or in/out to declare: the function's
// parameters the body reads are its uniforms (the tree's captures, in the
// order the body first reads them: screen, texel, edge_min, edge,
// subpixel), the texture its sampler, `uv` its input and the value it
// returns its colour.
//
//   screen    the frame the composite made, display-ready
//   texel     one pixel of it, (1 / width, 1 / height)
//   edge      the local contrast, against the brightest of the five
//             pixels, below which a pixel is left alone (0.125)
//   edge_min  and the least contrast that is ever smoothed (0.0625)
//   subpixel  how far toward its steepest neighbour a pixel is moved (0.75)

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, Texture, texture, rgb, dot, min, max, abs, sign, clamp, smoothstep)

exports (fxaa, luma)

// A colour's luma, its brightness as the eye weighs the channels. A
// @quotable function: the quote below calls it, and ae3d.gpu writes it out as
// a GLSL function of its own (quote version 2); the CPU runs it as Aether.
@quotable
luma(c: vec3) -> float {
    return dot(c, vec3(0.299, 0.587, 0.114))
}

fxaa(screen: Texture, texel: vec2, edge: float, edge_min: float, subpixel: float) -> *GpuShader {
    return fragment("fxaa") quote | uv: vec2 | {
        c = rgb(texture(screen, uv))
        n = rgb(texture(screen, uv + vec2(0.0, -1.0) * texel))
        s = rgb(texture(screen, uv + vec2(0.0, 1.0) * texel))
        e = rgb(texture(screen, uv + vec2(1.0, 0.0) * texel))
        w = rgb(texture(screen, uv + vec2(-1.0, 0.0) * texel))
        lc = luma(c)
        ln = luma(n)
        ls = luma(s)
        le = luma(e)
        lw = luma(w)
        lo = min(lc, min(min(ln, ls), min(le, lw)))
        hi = max(lc, max(max(ln, ls), max(le, lw)))
        range = hi - lo
        if range < max(edge_min, hi * edge) {
            return vec4(c, 1.0)
        }
        avg = (ln + ls + le + lw) * 0.25
        blend = smoothstep(0.0, 1.0, clamp(abs(avg - lc) / range, 0.0, 1.0))
        blend = blend * blend * subpixel
        horiz = abs(-2.0 * lw + lc) + abs(-2.0 * lc + le) * 2.0 + abs(-2.0 * le + lc)
        vert = abs(-2.0 * ln + lc) + abs(-2.0 * lc + ls) * 2.0 + abs(-2.0 * ls + lc)
        along = horiz >= vert
        g1 = (if along { ls } else { le }) - lc
        g2 = (if along { ln } else { lw }) - lc
        // The parentheses: an `if` used as a value whose condition ends in
        // a call reads the `{` as the call's trailing block without them.
        dir = if (abs(g1) >= abs(g2)) { sign(g1) } else { sign(g2) }
        step = blend * dir
        off = if along { vec2(0.0, step * texel.y) } else { vec2(step * texel.x, 0.0) }
        return vec4(rgb(texture(screen, uv + off)), 1.0)
    }
}
