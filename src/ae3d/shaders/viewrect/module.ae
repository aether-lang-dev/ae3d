// ae3d.shaders.viewrect: a view's picture (#866) drawn into a rectangle of
// the frame, written with `quote`.
//
// A view is a texture of the sRGB format: what the composite wrote into it
// is already display-encoded, and sampling it gives the light that value
// stands for, as it does any colour texture. A material wants that light.
// The frame's image takes encoded values, so the rectangle takes the
// light back through the sRGB transfer function, exactly: eight bits
// decoded and encoded again come out the byte they went in as.
//
//   picture   the view's texture

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, Texture, texture, pow)

exports (view_blit)

@quotable
srgb_encode(x: float) -> float {
    if x <= 0.0031308 {
        return x * 12.92
    }
    return 1.055 * pow(x, 1.0 / 2.4) - 0.055
}

view_blit(picture: Texture) -> *GpuShader {
    return fragment("view_blit") quote | uv: vec2 | {
        c = texture(picture, uv)
        return vec4(vec3(srgb_encode(c.x), srgb_encode(c.y), srgb_encode(c.z)), c.w)
    }
}
