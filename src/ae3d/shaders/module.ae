// GLSL programs for the OpenGL backend.
//
// Every source here is a `#version 330 core` program: that is the highest GLSL
// version a macOS OpenGL 4.1 core context accepts, and it runs unchanged on the
// Linux and Windows drivers too. Sources are heredocs, so the GLSL is embedded
// verbatim with no escape processing.

import ae3d.core

exports (
    COMPUTE_DDGI_TRACE, COMPUTE_DDGI_IRRADIANCE, COMPUTE_DDGI_DISTANCE, COMPUTE_DDGI_QUERY,
    VERTEX_OVERLAY, FRAGMENT_OVERLAY, water_shader
)

// The scene's shaders are quoted (ae3d.shaders.lit, step 6), the ray-query
// pixel shader the last of them: what is here is the compute shaders, the
// overlay and the water's.

// The bloom pyramid, both ways, is written with quote: ae3d.shaders.bloom.

// The crowd sorted on the device. Each figure is eight floats -- where it
// stands, which way it faces, where it is in its walk, its tint -- and this
// pass, one thread a figure, finds its distance to the camera, drops it
// past the cull, picks its tier (near, mid, far), takes a slot in that
// tier's instance stream with an atomic on the tier's draw command, and
// writes the twenty floats the crowd's vertex shader reads (the matrix
// from its yaw and the model's scale, the colour, the phase) into that
// slot. The three draw commands' instance counts are what the tiers then
// draw by, indirectly, so nothing about the sort comes back to the CPU.
// Each tier's matrix takes that tier's model's scale: the near body, the
// far body and the impostor are different meshes at different sizes.
// What the CPU wrote each frame before -- every figure's matrix, colour
// and phase, sorted and packed, a hundred-odd megabytes at half a million
// -- is now the eight floats a figure and nothing else. Vulkan only:
// OpenGL 4.1 has no compute, and keeps the CPU sort.
const COMPUTE_CROWD_SORT = <<GLSL_END
#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer CrowdState { float figures[]; };
// The streams as vec4s: five a figure, each a sixteen-byte store.
layout(std430, set = 0, binding = 1) writeonly buffer NearTier { vec4 nearOut[]; };
layout(std430, set = 0, binding = 2) writeonly buffer MidTier { vec4 midOut[]; };
layout(std430, set = 0, binding = 3) writeonly buffer FarTier { vec4 farOut[]; };
// VkDrawIndexedIndirectCommands: indexCount, instanceCount, firstIndex,
// vertexOffset, firstInstance -- five uints a command, the second the
// counter. The first three commands are the tiers' lit draws, the ones the
// sort counts into; the three after are their shadow draws, over the same
// streams with the depth proxy's index count, given the counts afterwards.
layout(std430, set = 0, binding = 4) buffer Draws { uint draws[]; };
// The rays' instances (VkAccelerationStructureInstanceKHR, sixteen uints
// each): every figure kept in the near or far tier takes a slot after the
// static scene's, counted on the device (binding 7 holds the count; the
// CPU reads it back a frame or two later and sizes the next build's room
// by it, zeroing the room first so the slots past the count are inactive;
// a figure past the room is dropped from the rays for that frame), and
// points at the bottom-level structure of its tier's mesh baked at the
// frame of the walk the figure is at, one per frame of the bank: the far
// mesh's (binding 6) for the far tier, and for the near band the near
// mesh's (binding 8) where the crowd has them -- the shadow of the figure
// that is drawn, not of its stand-in -- and the far mesh's where it has
// not. Written only when rayFrames says so; a crowd without rays skips
// it. A picture past the impostor distance is twenty pixels tall and half
// fogged: its shadow is not seen, and it stays out.
layout(std430, set = 0, binding = 5) writeonly buffer RayInstances { uint rays[]; };
layout(std430, set = 0, binding = 6) readonly buffer PoseStructures { uvec2 poseAddress[]; };
layout(std430, set = 0, binding = 7) buffer RayRange { uint rayRange[]; };
layout(std430, set = 0, binding = 8) readonly buffer NearPoseStructures { uvec2 nearPoseAddress[]; };
// The near band's figures in the view's cone, written again into a stream
// of their own, counted on the seventh command: the near tier's lit draws
// read it, and its shadow draws and the rays the whole band, so a figure
// behind the camera is not drawn and still casts (#498).
layout(std430, set = 0, binding = 9) writeonly buffer SeenTier { vec4 seenOut[]; };

layout(push_constant) uniform CrowdParams {
    uint crowdCount;
    uint crowdThree;      // a mid tier as well as near and far
    float crowdCx;
    float crowdCz;
    float crowdNear2;
    float crowdMid2;
    float crowdCull2;
    float crowdRay2;      // the rays' reach from the camera, squared; 0 for all
    vec4 crowdScale[3];   // a tier's model's scale, xyz
    uint rayLimit;        // the slot the structure's room ends at: a figure past it is dropped this frame
    uint rayFrames;       // the bank's frames, one structure each; 0 for no rays
    uint rayNear;         // the near band has structures of its own mesh (binding 8)
    uint rayRecord;       // the probes' first record of the crowd's poses: the far mesh's frames, then the near band's
    vec4 crowdView;       // the camera's front, and the half angle round it that holds the frustum (0: no cone)
    vec4 crowdEye;        // the eye, and how far from a figure's feet all of it reaches
} params;

// Whether a figure standing at p, held in a sphere of its reach round its
// feet, can be in the frustum: inside the cone round the camera's front
// widened by the angle the sphere fills from the eye.
bool in_view(vec3 p) {
    if (params.crowdView.w <= 0.0) return true;
    vec3 d = p - params.crowdEye.xyz;
    float reach = params.crowdEye.w;
    float dl = length(d);
    if (dl <= reach) return true;
    float off = acos(clamp(dot(d, params.crowdView.xyz) / dl, -1.0, 1.0));
    return off <= params.crowdView.w + asin(reach / dl);
}

// A figure's ray instance: its tier's matrix as three rows of four (the
// near band's where it is traced as its own mesh, the far tier's where the
// far mesh stands in), the probes' record of its pose frame as its custom
// index (read by nothing else), every mask bit, no shader table, culling
// off, and the pose frame's structure.
void ray_instance(uint slot, uint tier, float c, float s, float x, float y, float z, float phase) {
    uint at = slot * 16u;
    bool near = tier == 0u && params.rayNear != 0u;
    vec3 sc = near ? params.crowdScale[0].xyz : params.crowdScale[1].xyz;
    rays[at + 0u] = floatBitsToUint(c * sc.x);  rays[at + 1u] = floatBitsToUint(0.0);  rays[at + 2u] = floatBitsToUint(s * sc.z);  rays[at + 3u] = floatBitsToUint(x);
    rays[at + 4u] = floatBitsToUint(0.0);       rays[at + 5u] = floatBitsToUint(sc.y); rays[at + 6u] = floatBitsToUint(0.0);       rays[at + 7u] = floatBitsToUint(y);
    rays[at + 8u] = floatBitsToUint(-s * sc.x); rays[at + 9u] = floatBitsToUint(0.0);  rays[at + 10u] = floatBitsToUint(c * sc.z); rays[at + 11u] = floatBitsToUint(z);
    uint frame = uint(fract(phase) * float(params.rayFrames)) % params.rayFrames;
    uint record = params.rayRecord + (near ? params.rayFrames : 0u) + frame;
    rays[at + 12u] = 0xFF000000u | (record & 0xFFFFFFu);
    rays[at + 13u] = 0x01000000u;
    uvec2 address = near ? nearPoseAddress[frame] : poseAddress[frame];
    rays[at + 14u] = address.x;
    rays[at + 15u] = address.y;
}

void put(uint tier, uint at, vec4 v) {
    if (tier == 0u) nearOut[at] = v;
    else if (tier == 1u) midOut[at] = v;
    else farOut[at] = v;
}

// The slots are taken a workgroup at a time: each thread counts into the
// group's own three tallies, the group takes one run of each tier's
// stream with one atomic on the draw command, and the thread's slot is
// its place in that run. Half a million atomics on three addresses,
// serialised across the device, were two milliseconds; two thousand are
// nothing. The order within a tier is then the workgroups' and not the
// figures', which the draw does not care about.
shared uint groupCount[3];
shared uint groupBase[3];
shared uint groupRays;
shared uint groupRayBase;
shared uint groupSeen;
shared uint groupSeenBase;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    if (lane < 3u) groupCount[lane] = 0u;
    if (lane == 0u) { groupRays = 0u; groupSeen = 0u; }
    barrier();
    bool keep = i < params.crowdCount;
    float x = 0.0, y = 0.0, z = 0.0, yaw = 0.0, phase = 0.0;
    uint f = i * 8u;
    uint tier = 0u;
    uint slot = 0u;
    float d2 = 0.0;
    if (keep) {
        x = figures[f]; y = figures[f + 1u]; z = figures[f + 2u];
        yaw = figures[f + 3u]; phase = figures[f + 4u];
        float dx = x - params.crowdCx, dz = z - params.crowdCz;
        d2 = dx * dx + dz * dz;
        if (params.crowdCull2 > 0.0 && d2 > params.crowdCull2) keep = false;
        if (d2 >= params.crowdNear2) tier = (params.crowdThree == 0u || d2 < params.crowdMid2) ? 1u : 2u;
    }
    if (keep) slot = atomicAdd(groupCount[tier], 1u);
    bool seen = keep && tier == 0u && in_view(vec3(x, y, z));
    uint seenSlot = 0u;
    if (seen) seenSlot = atomicAdd(groupSeen, 1u);
    // A figure past the rays' reach -- the shadow distance, what the map
    // covered -- shadows nothing the eye is looking at.
    bool traced = params.rayFrames > 0u && keep && tier < 2u && (params.crowdRay2 <= 0.0 || d2 <= params.crowdRay2);
    uint raySlot = 0u;
    if (traced) raySlot = atomicAdd(groupRays, 1u);
    barrier();
    if (lane < 3u && groupCount[lane] > 0u) groupBase[lane] = atomicAdd(draws[lane * 5u + 1u], groupCount[lane]);
    if (lane == 0u && groupRays > 0u) groupRayBase = atomicAdd(rayRange[0], groupRays);
    if (lane == 0u && groupSeen > 0u) groupSeenBase = atomicAdd(draws[6u * 5u + 1u], groupSeen);
    barrier();
    float c = cos(yaw), s = sin(yaw);
    if (traced && groupRayBase + raySlot < params.rayLimit) ray_instance(groupRayBase + raySlot, tier, c, s, x, y, z, phase);
    if (!keep) return;
    uint at = (groupBase[tier] + slot) * 5u;
    vec3 sc = params.crowdScale[tier].xyz;
    // The matrix the crowd's stream carries, column by column: yaw about
    // the world's up, the tier's scale, the figure's position -- the same
    // matrix geometry.inst_set_positions_yaw builds on the CPU -- then the
    // tint and the phase.
    vec4 m0 = vec4(c * sc.x, 0.0, -s * sc.x, 0.0);
    vec4 m1 = vec4(0.0, sc.y, 0.0, 0.0);
    vec4 m2 = vec4(s * sc.z, 0.0, c * sc.z, 0.0);
    vec4 m3 = vec4(x, y, z, 1.0);
    vec4 tint = vec4(figures[f + 5u], figures[f + 6u], figures[f + 7u], phase);
    put(tier, at + 0u, m0);
    put(tier, at + 1u, m1);
    put(tier, at + 2u, m2);
    put(tier, at + 3u, m3);
    put(tier, at + 4u, tint);
    if (seen) {
        uint into = (groupSeenBase + seenSlot) * 5u;
        seenOut[into + 0u] = m0;
        seenOut[into + 1u] = m1;
        seenOut[into + 2u] = m2;
        seenOut[into + 3u] = m3;
        seenOut[into + 4u] = tint;
    }
}
GLSL_END

// The probes' global illumination (#537), on Vulkan where the device
// traces: the probes' rays, and their rays folded into their irradiance and
// their distance (ae3d.vkddgi). Compiled as written; see the trace's and the
// update's own notes.
const COMPUTE_DDGI_TRACE = <<GLSL_END
// The probes' rays (#537): each a thread, a probe's DDGI_RAYS rays a row of
// the ray image -- the radiance the ray brings back and how far it went (a
// back face, which only a probe inside geometry sees, a fifth of its
// distance and negative). Spherical Fibonacci directions turned by this
// frame's random rotation, so over frames each probe sees every direction.
// At a hit the surface is shaded as the scene shader would light its
// diffuse: its emission, the sun and the lamps in reach through rays of
// their own, and the light the probes gathered last frame at that point --
// the bounce after this one, so the light bounces on over frames. A miss is
// the sky, the sky's light's sharpest level.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 64) in;
#define DDGI_PARAMS 32
#define DDGI_WAKE 4

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std140) uniform DdgiParams { vec4 params[DDGI_PARAMS]; };
// An instance's record, by its custom index: its vertex and index buffers'
// addresses, the floats a vertex spans, and its albedo and emission.
layout(set = 0, binding = 2, std430) readonly buffer Records { uvec4 records[]; };
layout(set = 0, binding = 3, std430) readonly buffer Lamps { vec4 lamps[]; };
layout(set = 0, binding = 4, std430) readonly buffer State { vec4 probeState[]; };
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D rayImage;
layout(set = 0, binding = 6) uniform sampler2D skyLight;
layout(set = 0, binding = 7) uniform sampler2D irradianceAtlas;
layout(set = 0, binding = 8) uniform sampler2D distanceAtlas;
layout(push_constant) uniform Batch { uint first; uint count; } batch;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint v[]; };

#define DDGI_DIMS params[0]
#define DDGI_BASE(c) params[1 + (c)].xyz
#define DDGI_SPACING(c) params[3][(c)]
#define DDGI_ATLAS params[4]
#define DDGI_DIRECTIONALS 10
#define DDGI_KEY_LAMP 18
#define DDGI_IRRADIANCE irradianceAtlas
#define DDGI_DISTANCE distanceAtlas
#define DDGI_STATE(i) probeState[(i)]
// The octahedral sky map (ae3d.skylight, whose arithmetic this must match):
// the upper hemisphere in the square's inner diamond, the lower folded into
// its corners, one texel of gutter around each level holding the sky just
// across the fold, so a filtered read at an edge is still the sky.
#define SKY_SIZE 256.0
#define SKY_LEVELS 6.0
#define SKY_IRRADIANCE_SIZE 16.0
vec3 oct_decode(vec2 p) {
    vec3 d = vec3(p.x, 1.0 - abs(p.x) - abs(p.y), p.y);
    if (d.y < 0.0) {
        vec2 folded = (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
        d.x = folded.x;
        d.z = folded.y;
    }
    return normalize(d);
}
vec2 oct_encode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 p = d.xz;
    if (d.y < 0.0) p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p;
}
// Where direction d is read in a level `size` texels a side.
vec2 oct_uv(vec3 d, float size) {
    return ((oct_encode(d) * 0.5 + 0.5) * (size - 2.0) + 1.0) / size;
}
// The direction a texel of a level `size` a side stands for, at texture
// coordinate uv: a gutter texel's folded back across the edge it lies past.
vec3 oct_texel_direction(vec2 uv, float size) {
    vec2 p = ((uv * size - 1.0) / (size - 2.0)) * 2.0 - 1.0;
    if (p.x > 1.0) { p.x = 2.0 - p.x; p.y = -p.y; }
    if (p.x < -1.0) { p.x = -2.0 - p.x; p.y = -p.y; }
    if (p.y > 1.0) { p.y = 2.0 - p.y; p.x = -p.x; }
    if (p.y < -1.0) { p.y = -2.0 - p.y; p.x = -p.x; }
    return oct_decode(p);
}

// v wrapped into 0 to d-1 on each axis (GLSL's % is undefined for a
// negative operand, and a grid west of the origin has negative cells).
ivec3 ddgi_wrap(ivec3 v, ivec3 d) {
    return v - d * ivec3(floor(vec3(v) / vec3(d)));
}

// The probe volume (#537, ae3d.vkddgi, whose layout this must match):
// DDGI_CASCADES grids of probes around the camera, each DDGI_DIMS probes
// DDGI_SPACING(c) apart, addressed toroidally -- a probe's slot is its
// world cell modulo the grid -- so the grid scrolls with the camera by whole
// cells and what a probe knows stays where it was learned. Each probe keeps
// its irradiance and its distance moments in octahedral texels in two
// atlases, a one-texel gutter round each, and its state -- the offset that
// moves it out of a wall, whether it is on -- in the state buffer.
//
// What a shader including this defines first: DDGI_DIMS (vec4: probes a
// side, x y z, and probes a cascade), DDGI_BASE(c) (vec3: the world cell of
// cascade c's first probe), DDGI_SPACING(c), DDGI_ATLAS (vec4: the
// irradiance atlas's size, then the distance atlas's), DDGI_IRRADIANCE and
// DDGI_DISTANCE (the atlases' samplers) and DDGI_STATE(i) (vec4 i of the
// state buffer).
#define DDGI_CASCADES 2
#define DDGI_IRR 6
#define DDGI_DIST 14

// A probe's index from its cascade and its slot in the grid.
int ddgi_index(int c, ivec3 slot) {
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    return c * int(DDGI_DIMS.w) + (slot.z * d.y + slot.y) * d.x + slot.x;
}

// The slot of the probe at grid coordinate g of cascade c (0 to DDGI_DIMS-1
// from the cascade's first cell).
ivec3 ddgi_slot(int c, ivec3 g) {
    return ddgi_wrap(ivec3(DDGI_BASE(c)) + g, ivec3(DDGI_DIMS.xyz));
}

// Whether probe `index`, at grid coordinate g of cascade c, is on: traced
// since it came to its cell (its stamp's w 1, not 0, nor 2 for woken with
// its texels not yet replaced), and neither inside anything (its state's w
// 0) nor asleep, with nothing near it to light (w 2).
bool ddgi_on(int c, ivec3 g, int index) {
    vec4 stamp = DDGI_STATE(index * 2 + 1);
    return abs(DDGI_STATE(index * 2).w - 1.0) < 0.5 && abs(stamp.w - 1.0) < 0.5 && all(equal(stamp.xyz, DDGI_BASE(c) + vec3(g)));
}

// Where the probe at grid coordinate g of cascade c belongs: its cell's
// centre, not its corner, so a floor or a wall at a whole number of cells
// does not run through a row of probes.
vec3 ddgi_home(int c, ivec3 g) {
    return (DDGI_BASE(c) + vec3(g) + 0.5) * DDGI_SPACING(c);
}

// Where probe `index` stands: its home and the offset its state keeps.
vec3 ddgi_probe_position(int c, ivec3 g, int index) {
    return ddgi_home(c, g) + DDGI_STATE(index * 2).xyz;
}

// Point P in cascade c's grid coordinates, a probe at each whole number.
vec3 ddgi_grid(int c, vec3 P) {
    return P / DDGI_SPACING(c) - DDGI_BASE(c) - 0.5;
}

// The atlas texel a probe's octahedron starts at (its gutter's corner).
vec2 ddgi_corner(int index, float side) {
    int c = index / int(DDGI_DIMS.w);
    int local = index - c * int(DDGI_DIMS.w);
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    int x = local % d.x;
    int y = (local / d.x) % d.y;
    int z = local / (d.x * d.y);
    return vec2(float(x + y * d.x), float(z + c * d.z)) * (side + 2.0);
}

// Where direction n is read in probe `index`'s octahedron of `side` texels.
vec2 ddgi_uv(int index, vec3 n, float side, vec2 atlas) {
    vec2 o = oct_encode(n) * 0.5 + 0.5;
    return (ddgi_corner(index, side) + 1.0 + o * side) / atlas;
}

// The irradiance onto a surface at P facing N, seen from V's side, from
// the eight probes of cascade c's cell around it: trilinear, each weighed
// by whether it faces the surface and by whether, by its distance moments,
// it can see it (Chebyshev). The irradiance the probes keep is the cosine
// average of the radiance, so pi times it is the irradiance; a weight sum of
// nothing returns -1, for the caller to take what lies beyond.
vec3 ddgi_cascade(int c, vec3 P, vec3 N, vec3 V, out float total) {
    float spacing = DDGI_SPACING(c);
    vec3 biased = P + (N * 0.2 + V * 0.8) * (0.3 * spacing);
    vec3 gridPos = ddgi_grid(c, biased);
    ivec3 g0 = ivec3(floor(gridPos));
    vec3 alpha = clamp(gridPos - vec3(g0), 0.0, 1.0);
    vec3 sum = vec3(0.0);
    total = 0.0;
    for (int i = 0; i < 8; i++) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 g = clamp(g0 + offset, ivec3(0), ivec3(DDGI_DIMS.xyz) - 1);
        int index = ddgi_index(c, ddgi_slot(c, g));
        if (!ddgi_on(c, g, index)) continue;
        vec3 probe = ddgi_probe_position(c, g, index);
        vec3 tri = mix(1.0 - alpha, alpha, vec3(offset));
        float weight = tri.x * tri.y * tri.z;
        vec3 toProbe = probe - P;
        vec3 dirToProbe = normalize(toProbe);
        float facing = (dot(dirToProbe, N) + 1.0) * 0.5;
        weight *= facing * facing + 0.2;
        vec3 fromProbe = biased - probe;
        float dist = length(fromProbe);
        vec2 moments = textureLod(DDGI_DISTANCE, ddgi_uv(index, fromProbe / max(dist, 1e-4), float(DDGI_DIST), DDGI_ATLAS.zw), 0.0).rg;
        float variance = abs(moments.x * moments.x - moments.y);
        float visible = 1.0;
        if (dist > moments.x) {
            float d = dist - moments.x;
            visible = variance / (variance + d * d);
            visible = max(visible * visible * visible, 0.0);
        }
        weight *= max(visible, 0.05);
        // Small weights crushed, so a probe that barely sees the point does
        // not tint it (Majercik et al.'s threshold).
        if (weight < 0.2) weight *= weight * weight / 0.04;
        vec3 irradiance = textureLod(DDGI_IRRADIANCE, ddgi_uv(index, N, float(DDGI_IRR), DDGI_ATLAS.xy), 0.0).rgb;
        sum += irradiance * weight;
        total += weight;
    }
    if (total <= 0.0) return vec3(0.0);
    return sum / total * 3.14159265;
}

// How far inside cascade c point P is, in cells from its nearest face: past
// one the cascade is whole; under it, the next one out takes over.
float ddgi_inside(int c, vec3 P) {
    vec3 gridPos = ddgi_grid(c, P);
    vec3 edge = min(gridPos, (DDGI_DIMS.xyz - 1.0) - gridPos);
    return min(edge.x, min(edge.y, edge.z));
}

// The probes' irradiance at P onto N, the nearest cascade that holds it
// blending into the next over its last cell, and beyond the last the
// `beyond` irradiance (the sky's) over the far cascade's last cell. From
// the near cascade out, so a point the near one holds whole reads its
// eight probes and no more.
vec3 ddgi_irradiance(vec3 P, vec3 N, vec3 V, vec3 beyond) {
    vec3 result = vec3(0.0);
    float left = 1.0;
    for (int c = 0; c < DDGI_CASCADES; c++) {
        float inside = ddgi_inside(c, P);
        if (inside <= 0.0) continue;
        float total;
        vec3 e = ddgi_cascade(c, P, N, V, total);
        if (total <= 0.0) continue;
        float share = clamp(inside, 0.0, 1.0) * left;
        result += e * share;
        left -= share;
        if (left <= 0.0) return result;
    }
    return result + beyond * left;
}
vec3 kelvinToRGB(float kelvin) {
    kelvin = clamp(kelvin, 1000.0, 12000.0);
    
    // Fast approximation for common temperatures (avoids expensive pow/log)
    if (kelvin < 3000.0) {
        return mix(vec3(1.0, 0.4, 0.0), vec3(1.0, 0.7, 0.3), (kelvin - 1000.0) / 2000.0);
    } else if (kelvin < 6500.0) {
        return mix(vec3(1.0, 0.7, 0.3), vec3(1.0, 1.0, 1.0), (kelvin - 3000.0) / 3500.0);
    } else {
        return mix(vec3(1.0, 1.0, 1.0), vec3(0.7, 0.8, 1.0), (kelvin - 6500.0) / 5500.0);
    }
}
// The i-th of n directions spread evenly over the sphere (spherical
// Fibonacci).
vec3 fibonacci_direction(uint i, uint n) {
    float golden = 2.39996323;
    float y = 1.0 - (float(i) + 0.5) * (2.0 / float(n));
    float r = sqrt(max(1.0 - y * y, 0.0));
    float phi = float(i) * golden;
    return vec3(cos(phi) * r, y, sin(phi) * r);
}

// Whether anything that casts a shadow (mask bit 1) lies within `far` of
// `from` along `dir`.
bool blocked(vec3 from, vec3 dir, float far) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0x01, from, 0.0, dir, far);
    while (rayQueryProceedEXT(q)) { }
    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// The light a lamp (packed as the clusters pack it, ae3d.lightgrid) brings
// to `hit` facing n, through a ray of its own.
vec3 lamp_light(vec4 a, vec4 b, vec4 cone, vec4 att, vec4 e, vec3 hit, vec3 n) {
    vec3 toLamp = a.xyz - hit;
    float dist = length(toLamp);
    if (dist >= a.w || dist <= 0.0) return vec3(0.0);
    vec3 l = toLamp / dist;
    float facing = dot(n, l);
    if (facing <= 0.0) return vec3(0.0);
    float attenuation = 1.0 / (att.x + att.y * dist + att.z * dist * dist);
    if (int(cone.w + 0.5) == 2) attenuation *= smoothstep(e.x, e.y, dot(-l, normalize(cone.xyz)));
    if (attenuation <= 0.0 || blocked(hit, l, dist)) return vec3(0.0);
    return b.rgb * kelvinToRGB(att.w) * b.a * attenuation * facing;
}

vec3 vertex_at(uvec2 address, uint stride, uint index, mat4x3 toWorld) {
    Floats f = Floats(address);
    uint at = index * stride;
    return toWorld * vec4(f.v[at], f.v[at + 1u], f.v[at + 2u], 1.0);
}

void main() {
    uint ray = gl_GlobalInvocationID.x;
    uint rays = uint(params[8].y);
    uint probe = batch.first + gl_WorkGroupID.y;
    if (ray >= rays || gl_WorkGroupID.y >= batch.count) return;
    int index = int(probe);
    int c = index / int(DDGI_DIMS.w);
    int local = index - c * int(DDGI_DIMS.w);
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    ivec3 slot = ivec3(local % d.x, (local / d.x) % d.y, local / (d.x * d.y));
    // The grid coordinate this slot holds now: the slot less the cascade's
    // first cell, wrapped.
    ivec3 g = ddgi_wrap(slot - ivec3(DDGI_BASE(c)), d);
    // A probe just come to its cell starts from its home: the offset it
    // keeps was for the cell it left.
    vec4 stamp = probeState[index * 2 + 1];
    bool fresh = stamp.w < 0.5 || any(notEqual(stamp.xyz, DDGI_BASE(c) + vec3(g)));
    // A probe asleep or inside something -- its light read by nothing --
    // traces one ray in DDGI_WAKE, spread over the sphere: enough to see
    // geometry come near it, or to find its way out, and wake.
    float mode = probeState[index * 2].w;
    if (!fresh && abs(mode - 1.0) > 0.5 && ray % uint(DDGI_WAKE) != 0u) return;
    vec3 origin = fresh ? ddgi_home(c, g) : ddgi_probe_position(c, g, index);
    mat3 turn = mat3(params[5].xyz, params[6].xyz, params[7].xyz);
    vec3 dir = normalize(turn * fibonacci_direction(ray, rays));
    float far = DDGI_SPACING(c) * float(DDGI_DIMS.x) * 0.5;

    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 0x02, origin, 0.0, dir, far);
    while (rayQueryProceedEXT(q)) { }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        vec3 sky = textureLod(skyLight, oct_uv(dir, SKY_SIZE), 0.0).rgb;
        imageStore(rayImage, ivec2(ray, probe), vec4(sky, 1e4));
        return;
    }
    float t = rayQueryGetIntersectionTEXT(q, true);
    uint record = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)) * 4u;
    uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
    mat4x3 toWorld = rayQueryGetIntersectionObjectToWorldEXT(q, true);
    uvec4 addresses = records[record];
    uvec4 shape = records[record + 1u];
    vec3 albedo = uintBitsToFloat(records[record + 2u].xyz);
    vec3 emission = uintBitsToFloat(records[record + 3u].xyz);
    Words indices = Words(addresses.zw);
    vec3 p0 = vertex_at(addresses.xy, shape.x, indices.v[primitive * 3u], toWorld);
    vec3 p1 = vertex_at(addresses.xy, shape.x, indices.v[primitive * 3u + 1u], toWorld);
    vec3 p2 = vertex_at(addresses.xy, shape.x, indices.v[primitive * 3u + 2u], toWorld);
    vec3 wound = normalize(cross(p1 - p0, p2 - p0));
    // Its back: a probe that sees backs is inside something.
    if (dot(wound, dir) > 0.0 && shape.y == 0u) {
        imageStore(rayImage, ivec2(ray, probe), vec4(0.0, 0.0, 0.0, -0.2 * t));
        return;
    }
    vec3 n = dot(wound, dir) > 0.0 ? -wound : wound;
    vec3 hit = origin + dir * t + n * 0.02;

    // The directional lights (the sun, the moon): each a direction toward
    // it and its temperature, then its colour by its intensity.
    vec3 direct = vec3(0.0);
    int directionals = int(params[8].w);
    for (int i = 0; i < directionals; i++) {
        vec4 toward = params[DDGI_DIRECTIONALS + i * 2];
        vec4 light = params[DDGI_DIRECTIONALS + i * 2 + 1];
        float facing = dot(n, toward.xyz);
        if (facing > 0.0 && !blocked(hit, toward.xyz, 1e4)) {
            direct += light.rgb * kelvinToRGB(toward.w) * facing;
        }
    }
    int lampCount = int(params[8].x);
    for (int i = 0; i < lampCount; i++) {
        direct += lamp_light(lamps[i * 5], lamps[i * 5 + 1], lamps[i * 5 + 2], lamps[i * 5 + 3], lamps[i * 5 + 4], hit, n);
    }
    // A key light that is a lamp, which the clusters leave out.
    if (params[9].z > 0.5) {
        direct += lamp_light(params[DDGI_KEY_LAMP], params[DDGI_KEY_LAMP + 1], params[DDGI_KEY_LAMP + 2],
                             params[DDGI_KEY_LAMP + 3], params[DDGI_KEY_LAMP + 4], hit, n);
    }
    // The light gathered here last frame, the bounce after this one.
    vec3 bounce = ddgi_irradiance(hit, n, -dir, vec3(0.0));
    vec3 radiance = emission + albedo * (direct + bounce) / 3.14159265;
    imageStore(rayImage, ivec2(ray, probe), vec4(radiance, t));
}
GLSL_END

const COMPUTE_DDGI_IRRADIANCE = <<GLSL_END
// A probe's rays folded into its octahedron (#537): every texel of it, the
// gutter's too -- a gutter texel is the direction across the fold it
// stands for -- the rays' DDGI_MODE weighted by their cosine to the texel's
// direction: for the irradiance, the radiance by the cosine; for the
// distance, the distance and its square by the cosine to the fiftieth, a
// sharp lobe, which is what the visibility test asks of them. Blended into
// what the texel held by the hysteresis, all at once when the probe has
// just come to a new cell. The irradiance pass also keeps the probe's
// state: whether it is on -- not where a quarter of its rays met backs, a
// probe inside a wall -- and how far it has moved out of the nearest one.
#version 450
#define DDGI_SIDE 6
#define DDGI_MODE 0
#define DDGI_PARAMS 32
#define DDGI_RAYS_MAX 256
#define DDGI_CLEARANCE 0.15
#define DDGI_WAKE 4
#define DDGI_REACH 1.5
layout(local_size_x = DDGI_SIDE + 2, local_size_y = DDGI_SIDE + 2) in;

layout(set = 0, binding = 1, std140) uniform DdgiParams { vec4 params[DDGI_PARAMS]; };
layout(set = 0, binding = 4, std430) buffer State { vec4 probeState[]; };
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D rayImage;
// The irradiance's atlas, or the distance's: its mean and its mean square.
#if DDGI_MODE == 0
layout(set = 0, binding = 9, rgba16f) uniform image2D atlas;
#else
layout(set = 0, binding = 9, rg16f) uniform image2D atlas;
#endif
layout(push_constant) uniform Batch { uint first; uint count; } batch;

#define DDGI_DIMS params[0]
#define DDGI_BASE(c) params[1 + (c)].xyz
#define DDGI_SPACING(c) params[3][(c)]
// The octahedral sky map (ae3d.skylight, whose arithmetic this must match):
// the upper hemisphere in the square's inner diamond, the lower folded into
// its corners, one texel of gutter around each level holding the sky just
// across the fold, so a filtered read at an edge is still the sky.
#define SKY_SIZE 256.0
#define SKY_LEVELS 6.0
#define SKY_IRRADIANCE_SIZE 16.0
vec3 oct_decode(vec2 p) {
    vec3 d = vec3(p.x, 1.0 - abs(p.x) - abs(p.y), p.y);
    if (d.y < 0.0) {
        vec2 folded = (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
        d.x = folded.x;
        d.z = folded.y;
    }
    return normalize(d);
}
vec2 oct_encode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 p = d.xz;
    if (d.y < 0.0) p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p;
}
// Where direction d is read in a level `size` texels a side.
vec2 oct_uv(vec3 d, float size) {
    return ((oct_encode(d) * 0.5 + 0.5) * (size - 2.0) + 1.0) / size;
}
// The direction a texel of a level `size` a side stands for, at texture
// coordinate uv: a gutter texel's folded back across the edge it lies past.
vec3 oct_texel_direction(vec2 uv, float size) {
    vec2 p = ((uv * size - 1.0) / (size - 2.0)) * 2.0 - 1.0;
    if (p.x > 1.0) { p.x = 2.0 - p.x; p.y = -p.y; }
    if (p.x < -1.0) { p.x = -2.0 - p.x; p.y = -p.y; }
    if (p.y > 1.0) { p.y = 2.0 - p.y; p.x = -p.x; }
    if (p.y < -1.0) { p.y = -2.0 - p.y; p.x = -p.x; }
    return oct_decode(p);
}

// v wrapped into 0 to d-1 on each axis (GLSL's % is undefined for a
// negative operand, and a grid west of the origin has negative cells).
ivec3 ddgi_wrap(ivec3 v, ivec3 d) {
    return v - d * ivec3(floor(vec3(v) / vec3(d)));
}
// The i-th of n directions spread evenly over the sphere (spherical
// Fibonacci).
vec3 fibonacci_direction(uint i, uint n) {
    float golden = 2.39996323;
    float y = 1.0 - (float(i) + 0.5) * (2.0 / float(n));
    float r = sqrt(max(1.0 - y * y, 0.0));
    float phi = float(i) * golden;
    return vec3(cos(phi) * r, y, sin(phi) * r);
}

// The probe's rays, read once into the group: each thread reads its share
// of the ray image and the directions, every texel then folds them all.
shared vec4 rayValue[DDGI_RAYS_MAX];
shared vec3 rayDirection[DDGI_RAYS_MAX];

void main() {
    if (gl_WorkGroupID.x >= batch.count) return;
    uint probe = batch.first + gl_WorkGroupID.x;
    int index = int(probe);
    uint rays = min(uint(params[8].y), uint(DDGI_RAYS_MAX));
    float side = float(DDGI_SIDE);
    int c = index / int(DDGI_DIMS.w);
    int local = index - c * int(DDGI_DIMS.w);
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    ivec3 slot = ivec3(local % d.x, (local / d.x) % d.y, local / (d.x * d.y));
    ivec3 g = ddgi_wrap(slot - ivec3(DDGI_BASE(c)), d);
    vec3 cell = DDGI_BASE(c) + vec3(g);
    vec4 stamp = probeState[index * 2 + 1];
    bool fresh = stamp.w < 0.5 || any(notEqual(stamp.xyz, cell));
    // Woken (stamp 2): its texels are from before it slept, replaced whole;
    // where it stands, it keeps.
    bool woken = !fresh && stamp.w > 1.5;
    float spacing = DDGI_SPACING(c);
    mat3 turn = mat3(params[5].xyz, params[6].xyz, params[7].xyz);
    // Asleep or inside something, it traced one ray in DDGI_WAKE: those
    // decide whether it wakes, and its texels keep what they had.
    bool asleep = !fresh && abs(probeState[index * 2].w - 1.0) > 0.5;
    uint stride = asleep ? uint(DDGI_WAKE) : 1u;

    uint threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    for (uint r = gl_LocalInvocationIndex; r < rays; r += threads) {
        rayValue[r] = imageLoad(rayImage, ivec2(r, probe));
        rayDirection[r] = normalize(turn * fibonacci_direction(r, rays));
    }
    barrier();

    ivec2 texel = ivec2(gl_LocalInvocationID.xy);
    vec2 uv = (vec2(texel) + 0.5) / (side + 2.0);
    vec3 n = oct_texel_direction(uv, side + 2.0);
    vec4 sum = vec4(0.0);
    float maxDistance = spacing * 1.5;
    for (uint r = 0u; r < rays && !asleep; r++) {
        float cosine = dot(n, rayDirection[r]);
        // A ray facing away from this texel's direction weighs nothing.
        if (cosine <= 0.0) continue;
        vec4 value = rayValue[r];
#if DDGI_MODE == 0
        if (value.a < 0.0) continue;
        sum += vec4(value.rgb * cosine, cosine);
#else
        // The cosine to the fiftieth by squaring, not by pow's exp and log.
        float c2 = cosine * cosine;
        float c4 = c2 * c2;
        float c8 = c4 * c4;
        float c16 = c8 * c8;
        float weight = c16 * c16 * c16 * c2;
        float dist = min(abs(value.a), maxDistance);
        sum += vec4(dist * weight, dist * dist * weight, 0.0, weight);
#endif
    }
    vec2 corner = vec2(float(slot.x + slot.y * d.x), float(slot.z + c * d.z)) * (side + 2.0);
    ivec2 at = ivec2(corner) + texel;
    vec4 result = sum.w > 1e-5 ? vec4(sum.xyz / sum.w, 1.0) : vec4(0.0, 0.0, 0.0, 1.0);
    if (!asleep) {
        vec4 old = imageLoad(atlas, at);
        float keep = fresh || woken ? 0.0 : params[9][DDGI_MODE];
        imageStore(atlas, at, mix(result, old, keep));
    }

#if DDGI_MODE == 0
    if (gl_LocalInvocationIndex == 0u) {
        // How many rays met backs and the nearest of them, the way out of
        // what the probe is in; and the nearest and the farthest front.
        int backs = 0;
        int traced = 0;
        bool near = false;
        float reach = DDGI_REACH * spacing;
        float nearestBack = 1e9;
        int backRay = -1;
        float nearestFront = 1e9;
        int nearFrontRay = -1;
        float farthestFront = -1.0;
        int farFrontRay = -1;
        for (uint r = 0u; r < rays; r += stride) {
            float distance = rayValue[r].a;
            traced++;
            // Anything the ray met within the probe's reach -- the box of
            // the cells round it, where the surfaces it lights are -- keeps
            // it awake.
            vec3 met = rayDirection[r] * abs(distance);
            if (all(lessThan(abs(met), vec3(reach)))) near = true;
            if (distance < 0.0) {
                backs++;
                if (-distance * 5.0 < nearestBack) {
                    nearestBack = -distance * 5.0;
                    backRay = int(r);
                }
                continue;
            }
            if (distance < nearestFront) {
                nearestFront = distance;
                nearFrontRay = int(r);
            }
            if (distance > farthestFront) {
                farthestFront = distance;
                farFrontRay = int(r);
            }
        }
        vec4 state = fresh ? vec4(0.0, 0.0, 0.0, 1.0) : probeState[index * 2];
        float share = float(backs) / float(max(traced, 1));
        float clearance = DDGI_CLEARANCE * spacing;
        vec3 moved = state.xyz;
        if (share > 0.25 && backRay >= 0) {
            // Inside something: through its nearest back, and a little past.
            moved += rayDirection[backRay] * (nearestBack + clearance * 0.5);
        } else if (nearestFront < clearance && nearFrontRay >= 0 && farFrontRay >= 0 &&
                   dot(rayDirection[nearFrontRay], rayDirection[farFrontRay]) <= 0.0) {
            // Too near a face for its light to be the room's: toward the
            // open side, as far as the farthest face lets it (Majercik et
            // al.'s relocation, as RTXGI moves a probe).
            moved += rayDirection[farFrontRay] * min(farthestFront, clearance);
        }
        // Within the cell, or it stands for another.
        if (all(lessThan(abs(moved), vec3(0.45 * spacing)))) state.xyz = moved;
        // Inside something (0), on (1), or asleep with nothing in reach (2).
        // A probe woken has texels from before: they are replaced whole the
        // next time its turn comes (its stamp 2 till then).
        state.w = share > 0.25 ? 0.0 : (near ? 1.0 : 2.0);
        probeState[index * 2] = state;
        probeState[index * 2 + 1] = vec4(cell, asleep && state.w == 1.0 ? 2.0 : 1.0);
    }
#endif
}
GLSL_END

const COMPUTE_DDGI_DISTANCE = <<GLSL_END
// A probe's rays folded into its octahedron (#537): every texel of it, the
// gutter's too -- a gutter texel is the direction across the fold it
// stands for -- the rays' DDGI_MODE weighted by their cosine to the texel's
// direction: for the irradiance, the radiance by the cosine; for the
// distance, the distance and its square by the cosine to the fiftieth, a
// sharp lobe, which is what the visibility test asks of them. Blended into
// what the texel held by the hysteresis, all at once when the probe has
// just come to a new cell. The irradiance pass also keeps the probe's
// state: whether it is on -- not where a quarter of its rays met backs, a
// probe inside a wall -- and how far it has moved out of the nearest one.
#version 450
#define DDGI_SIDE 14
#define DDGI_MODE 1
#define DDGI_PARAMS 32
#define DDGI_RAYS_MAX 256
#define DDGI_CLEARANCE 0.15
#define DDGI_WAKE 4
#define DDGI_REACH 1.5
layout(local_size_x = DDGI_SIDE + 2, local_size_y = DDGI_SIDE + 2) in;

layout(set = 0, binding = 1, std140) uniform DdgiParams { vec4 params[DDGI_PARAMS]; };
layout(set = 0, binding = 4, std430) buffer State { vec4 probeState[]; };
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D rayImage;
// The irradiance's atlas, or the distance's: its mean and its mean square.
#if DDGI_MODE == 0
layout(set = 0, binding = 9, rgba16f) uniform image2D atlas;
#else
layout(set = 0, binding = 9, rg16f) uniform image2D atlas;
#endif
layout(push_constant) uniform Batch { uint first; uint count; } batch;

#define DDGI_DIMS params[0]
#define DDGI_BASE(c) params[1 + (c)].xyz
#define DDGI_SPACING(c) params[3][(c)]
// The octahedral sky map (ae3d.skylight, whose arithmetic this must match):
// the upper hemisphere in the square's inner diamond, the lower folded into
// its corners, one texel of gutter around each level holding the sky just
// across the fold, so a filtered read at an edge is still the sky.
#define SKY_SIZE 256.0
#define SKY_LEVELS 6.0
#define SKY_IRRADIANCE_SIZE 16.0
vec3 oct_decode(vec2 p) {
    vec3 d = vec3(p.x, 1.0 - abs(p.x) - abs(p.y), p.y);
    if (d.y < 0.0) {
        vec2 folded = (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
        d.x = folded.x;
        d.z = folded.y;
    }
    return normalize(d);
}
vec2 oct_encode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 p = d.xz;
    if (d.y < 0.0) p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p;
}
// Where direction d is read in a level `size` texels a side.
vec2 oct_uv(vec3 d, float size) {
    return ((oct_encode(d) * 0.5 + 0.5) * (size - 2.0) + 1.0) / size;
}
// The direction a texel of a level `size` a side stands for, at texture
// coordinate uv: a gutter texel's folded back across the edge it lies past.
vec3 oct_texel_direction(vec2 uv, float size) {
    vec2 p = ((uv * size - 1.0) / (size - 2.0)) * 2.0 - 1.0;
    if (p.x > 1.0) { p.x = 2.0 - p.x; p.y = -p.y; }
    if (p.x < -1.0) { p.x = -2.0 - p.x; p.y = -p.y; }
    if (p.y > 1.0) { p.y = 2.0 - p.y; p.x = -p.x; }
    if (p.y < -1.0) { p.y = -2.0 - p.y; p.x = -p.x; }
    return oct_decode(p);
}

// v wrapped into 0 to d-1 on each axis (GLSL's % is undefined for a
// negative operand, and a grid west of the origin has negative cells).
ivec3 ddgi_wrap(ivec3 v, ivec3 d) {
    return v - d * ivec3(floor(vec3(v) / vec3(d)));
}
// The i-th of n directions spread evenly over the sphere (spherical
// Fibonacci).
vec3 fibonacci_direction(uint i, uint n) {
    float golden = 2.39996323;
    float y = 1.0 - (float(i) + 0.5) * (2.0 / float(n));
    float r = sqrt(max(1.0 - y * y, 0.0));
    float phi = float(i) * golden;
    return vec3(cos(phi) * r, y, sin(phi) * r);
}

// The probe's rays, read once into the group: each thread reads its share
// of the ray image and the directions, every texel then folds them all.
shared vec4 rayValue[DDGI_RAYS_MAX];
shared vec3 rayDirection[DDGI_RAYS_MAX];

void main() {
    if (gl_WorkGroupID.x >= batch.count) return;
    uint probe = batch.first + gl_WorkGroupID.x;
    int index = int(probe);
    uint rays = min(uint(params[8].y), uint(DDGI_RAYS_MAX));
    float side = float(DDGI_SIDE);
    int c = index / int(DDGI_DIMS.w);
    int local = index - c * int(DDGI_DIMS.w);
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    ivec3 slot = ivec3(local % d.x, (local / d.x) % d.y, local / (d.x * d.y));
    ivec3 g = ddgi_wrap(slot - ivec3(DDGI_BASE(c)), d);
    vec3 cell = DDGI_BASE(c) + vec3(g);
    vec4 stamp = probeState[index * 2 + 1];
    bool fresh = stamp.w < 0.5 || any(notEqual(stamp.xyz, cell));
    // Woken (stamp 2): its texels are from before it slept, replaced whole;
    // where it stands, it keeps.
    bool woken = !fresh && stamp.w > 1.5;
    float spacing = DDGI_SPACING(c);
    mat3 turn = mat3(params[5].xyz, params[6].xyz, params[7].xyz);
    // Asleep or inside something, it traced one ray in DDGI_WAKE: those
    // decide whether it wakes, and its texels keep what they had.
    bool asleep = !fresh && abs(probeState[index * 2].w - 1.0) > 0.5;
    uint stride = asleep ? uint(DDGI_WAKE) : 1u;

    uint threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    for (uint r = gl_LocalInvocationIndex; r < rays; r += threads) {
        rayValue[r] = imageLoad(rayImage, ivec2(r, probe));
        rayDirection[r] = normalize(turn * fibonacci_direction(r, rays));
    }
    barrier();

    ivec2 texel = ivec2(gl_LocalInvocationID.xy);
    vec2 uv = (vec2(texel) + 0.5) / (side + 2.0);
    vec3 n = oct_texel_direction(uv, side + 2.0);
    vec4 sum = vec4(0.0);
    float maxDistance = spacing * 1.5;
    for (uint r = 0u; r < rays && !asleep; r++) {
        float cosine = dot(n, rayDirection[r]);
        // A ray facing away from this texel's direction weighs nothing.
        if (cosine <= 0.0) continue;
        vec4 value = rayValue[r];
#if DDGI_MODE == 0
        if (value.a < 0.0) continue;
        sum += vec4(value.rgb * cosine, cosine);
#else
        // The cosine to the fiftieth by squaring, not by pow's exp and log.
        float c2 = cosine * cosine;
        float c4 = c2 * c2;
        float c8 = c4 * c4;
        float c16 = c8 * c8;
        float weight = c16 * c16 * c16 * c2;
        float dist = min(abs(value.a), maxDistance);
        sum += vec4(dist * weight, dist * dist * weight, 0.0, weight);
#endif
    }
    vec2 corner = vec2(float(slot.x + slot.y * d.x), float(slot.z + c * d.z)) * (side + 2.0);
    ivec2 at = ivec2(corner) + texel;
    vec4 result = sum.w > 1e-5 ? vec4(sum.xyz / sum.w, 1.0) : vec4(0.0, 0.0, 0.0, 1.0);
    if (!asleep) {
        vec4 old = imageLoad(atlas, at);
        float keep = fresh || woken ? 0.0 : params[9][DDGI_MODE];
        imageStore(atlas, at, mix(result, old, keep));
    }

#if DDGI_MODE == 0
    if (gl_LocalInvocationIndex == 0u) {
        // How many rays met backs and the nearest of them, the way out of
        // what the probe is in; and the nearest and the farthest front.
        int backs = 0;
        int traced = 0;
        bool near = false;
        float reach = DDGI_REACH * spacing;
        float nearestBack = 1e9;
        int backRay = -1;
        float nearestFront = 1e9;
        int nearFrontRay = -1;
        float farthestFront = -1.0;
        int farFrontRay = -1;
        for (uint r = 0u; r < rays; r += stride) {
            float distance = rayValue[r].a;
            traced++;
            // Anything the ray met within the probe's reach -- the box of
            // the cells round it, where the surfaces it lights are -- keeps
            // it awake.
            vec3 met = rayDirection[r] * abs(distance);
            if (all(lessThan(abs(met), vec3(reach)))) near = true;
            if (distance < 0.0) {
                backs++;
                if (-distance * 5.0 < nearestBack) {
                    nearestBack = -distance * 5.0;
                    backRay = int(r);
                }
                continue;
            }
            if (distance < nearestFront) {
                nearestFront = distance;
                nearFrontRay = int(r);
            }
            if (distance > farthestFront) {
                farthestFront = distance;
                farFrontRay = int(r);
            }
        }
        vec4 state = fresh ? vec4(0.0, 0.0, 0.0, 1.0) : probeState[index * 2];
        float share = float(backs) / float(max(traced, 1));
        float clearance = DDGI_CLEARANCE * spacing;
        vec3 moved = state.xyz;
        if (share > 0.25 && backRay >= 0) {
            // Inside something: through its nearest back, and a little past.
            moved += rayDirection[backRay] * (nearestBack + clearance * 0.5);
        } else if (nearestFront < clearance && nearFrontRay >= 0 && farFrontRay >= 0 &&
                   dot(rayDirection[nearFrontRay], rayDirection[farFrontRay]) <= 0.0) {
            // Too near a face for its light to be the room's: toward the
            // open side, as far as the farthest face lets it (Majercik et
            // al.'s relocation, as RTXGI moves a probe).
            moved += rayDirection[farFrontRay] * min(farthestFront, clearance);
        }
        // Within the cell, or it stands for another.
        if (all(lessThan(abs(moved), vec3(0.45 * spacing)))) state.xyz = moved;
        // Inside something (0), on (1), or asleep with nothing in reach (2).
        // A probe woken has texels from before: they are replaced whole the
        // next time its turn comes (its stamp 2 till then).
        state.w = share > 0.25 ? 0.0 : (near ? 1.0 : 2.0);
        probeState[index * 2] = state;
        probeState[index * 2 + 1] = vec4(cell, asleep && state.w == 1.0 ? 2.0 : 1.0);
    }
#endif
}
GLSL_END

const COMPUTE_DDGI_QUERY = <<GLSL_END
// The probes' irradiance at one point onto one normal (#537), for what the
// engine is asked about a surface (ae3d.agent's explain): the scene
// shader's own reading of the probes, and the share of it that is what lies
// beyond the volume, which the asker fills with the sky's.
#version 450
layout(local_size_x = 1) in;
#define DDGI_PARAMS 32
layout(set = 0, binding = 1, std140) uniform DdgiParams { vec4 params[DDGI_PARAMS]; };
layout(set = 0, binding = 4, std430) readonly buffer State { vec4 probeState[]; };
layout(set = 0, binding = 7) uniform sampler2D irradianceAtlas;
layout(set = 0, binding = 8) uniform sampler2D distanceAtlas;
layout(set = 0, binding = 10, std430) writeonly buffer Answer { vec4 answer; };
layout(push_constant) uniform Query { vec4 point; vec4 normal; vec4 view; } query;

#define DDGI_DIMS params[0]
#define DDGI_BASE(c) params[1 + (c)].xyz
#define DDGI_SPACING(c) params[3][(c)]
#define DDGI_ATLAS params[4]
#define DDGI_IRRADIANCE irradianceAtlas
#define DDGI_DISTANCE distanceAtlas
#define DDGI_STATE(i) probeState[(i)]
// The octahedral sky map (ae3d.skylight, whose arithmetic this must match):
// the upper hemisphere in the square's inner diamond, the lower folded into
// its corners, one texel of gutter around each level holding the sky just
// across the fold, so a filtered read at an edge is still the sky.
#define SKY_SIZE 256.0
#define SKY_LEVELS 6.0
#define SKY_IRRADIANCE_SIZE 16.0
vec3 oct_decode(vec2 p) {
    vec3 d = vec3(p.x, 1.0 - abs(p.x) - abs(p.y), p.y);
    if (d.y < 0.0) {
        vec2 folded = (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
        d.x = folded.x;
        d.z = folded.y;
    }
    return normalize(d);
}
vec2 oct_encode(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 p = d.xz;
    if (d.y < 0.0) p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p;
}
// Where direction d is read in a level `size` texels a side.
vec2 oct_uv(vec3 d, float size) {
    return ((oct_encode(d) * 0.5 + 0.5) * (size - 2.0) + 1.0) / size;
}
// The direction a texel of a level `size` a side stands for, at texture
// coordinate uv: a gutter texel's folded back across the edge it lies past.
vec3 oct_texel_direction(vec2 uv, float size) {
    vec2 p = ((uv * size - 1.0) / (size - 2.0)) * 2.0 - 1.0;
    if (p.x > 1.0) { p.x = 2.0 - p.x; p.y = -p.y; }
    if (p.x < -1.0) { p.x = -2.0 - p.x; p.y = -p.y; }
    if (p.y > 1.0) { p.y = 2.0 - p.y; p.x = -p.x; }
    if (p.y < -1.0) { p.y = -2.0 - p.y; p.x = -p.x; }
    return oct_decode(p);
}

// v wrapped into 0 to d-1 on each axis (GLSL's % is undefined for a
// negative operand, and a grid west of the origin has negative cells).
ivec3 ddgi_wrap(ivec3 v, ivec3 d) {
    return v - d * ivec3(floor(vec3(v) / vec3(d)));
}

// The probe volume (#537, ae3d.vkddgi, whose layout this must match):
// DDGI_CASCADES grids of probes around the camera, each DDGI_DIMS probes
// DDGI_SPACING(c) apart, addressed toroidally -- a probe's slot is its
// world cell modulo the grid -- so the grid scrolls with the camera by whole
// cells and what a probe knows stays where it was learned. Each probe keeps
// its irradiance and its distance moments in octahedral texels in two
// atlases, a one-texel gutter round each, and its state -- the offset that
// moves it out of a wall, whether it is on -- in the state buffer.
//
// What a shader including this defines first: DDGI_DIMS (vec4: probes a
// side, x y z, and probes a cascade), DDGI_BASE(c) (vec3: the world cell of
// cascade c's first probe), DDGI_SPACING(c), DDGI_ATLAS (vec4: the
// irradiance atlas's size, then the distance atlas's), DDGI_IRRADIANCE and
// DDGI_DISTANCE (the atlases' samplers) and DDGI_STATE(i) (vec4 i of the
// state buffer).
#define DDGI_CASCADES 2
#define DDGI_IRR 6
#define DDGI_DIST 14

// A probe's index from its cascade and its slot in the grid.
int ddgi_index(int c, ivec3 slot) {
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    return c * int(DDGI_DIMS.w) + (slot.z * d.y + slot.y) * d.x + slot.x;
}

// The slot of the probe at grid coordinate g of cascade c (0 to DDGI_DIMS-1
// from the cascade's first cell).
ivec3 ddgi_slot(int c, ivec3 g) {
    return ddgi_wrap(ivec3(DDGI_BASE(c)) + g, ivec3(DDGI_DIMS.xyz));
}

// Whether probe `index`, at grid coordinate g of cascade c, is on: traced
// since it came to its cell (its stamp's w 1, not 0, nor 2 for woken with
// its texels not yet replaced), and neither inside anything (its state's w
// 0) nor asleep, with nothing near it to light (w 2).
bool ddgi_on(int c, ivec3 g, int index) {
    vec4 stamp = DDGI_STATE(index * 2 + 1);
    return abs(DDGI_STATE(index * 2).w - 1.0) < 0.5 && abs(stamp.w - 1.0) < 0.5 && all(equal(stamp.xyz, DDGI_BASE(c) + vec3(g)));
}

// Where the probe at grid coordinate g of cascade c belongs: its cell's
// centre, not its corner, so a floor or a wall at a whole number of cells
// does not run through a row of probes.
vec3 ddgi_home(int c, ivec3 g) {
    return (DDGI_BASE(c) + vec3(g) + 0.5) * DDGI_SPACING(c);
}

// Where probe `index` stands: its home and the offset its state keeps.
vec3 ddgi_probe_position(int c, ivec3 g, int index) {
    return ddgi_home(c, g) + DDGI_STATE(index * 2).xyz;
}

// Point P in cascade c's grid coordinates, a probe at each whole number.
vec3 ddgi_grid(int c, vec3 P) {
    return P / DDGI_SPACING(c) - DDGI_BASE(c) - 0.5;
}

// The atlas texel a probe's octahedron starts at (its gutter's corner).
vec2 ddgi_corner(int index, float side) {
    int c = index / int(DDGI_DIMS.w);
    int local = index - c * int(DDGI_DIMS.w);
    ivec3 d = ivec3(DDGI_DIMS.xyz);
    int x = local % d.x;
    int y = (local / d.x) % d.y;
    int z = local / (d.x * d.y);
    return vec2(float(x + y * d.x), float(z + c * d.z)) * (side + 2.0);
}

// Where direction n is read in probe `index`'s octahedron of `side` texels.
vec2 ddgi_uv(int index, vec3 n, float side, vec2 atlas) {
    vec2 o = oct_encode(n) * 0.5 + 0.5;
    return (ddgi_corner(index, side) + 1.0 + o * side) / atlas;
}

// The irradiance onto a surface at P facing N, seen from V's side, from
// the eight probes of cascade c's cell around it: trilinear, each weighed
// by whether it faces the surface and by whether, by its distance moments,
// it can see it (Chebyshev). The irradiance the probes keep is the cosine
// average of the radiance, so pi times it is the irradiance; a weight sum of
// nothing returns -1, for the caller to take what lies beyond.
vec3 ddgi_cascade(int c, vec3 P, vec3 N, vec3 V, out float total) {
    float spacing = DDGI_SPACING(c);
    vec3 biased = P + (N * 0.2 + V * 0.8) * (0.3 * spacing);
    vec3 gridPos = ddgi_grid(c, biased);
    ivec3 g0 = ivec3(floor(gridPos));
    vec3 alpha = clamp(gridPos - vec3(g0), 0.0, 1.0);
    vec3 sum = vec3(0.0);
    total = 0.0;
    for (int i = 0; i < 8; i++) {
        ivec3 offset = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 g = clamp(g0 + offset, ivec3(0), ivec3(DDGI_DIMS.xyz) - 1);
        int index = ddgi_index(c, ddgi_slot(c, g));
        if (!ddgi_on(c, g, index)) continue;
        vec3 probe = ddgi_probe_position(c, g, index);
        vec3 tri = mix(1.0 - alpha, alpha, vec3(offset));
        float weight = tri.x * tri.y * tri.z;
        vec3 toProbe = probe - P;
        vec3 dirToProbe = normalize(toProbe);
        float facing = (dot(dirToProbe, N) + 1.0) * 0.5;
        weight *= facing * facing + 0.2;
        vec3 fromProbe = biased - probe;
        float dist = length(fromProbe);
        vec2 moments = textureLod(DDGI_DISTANCE, ddgi_uv(index, fromProbe / max(dist, 1e-4), float(DDGI_DIST), DDGI_ATLAS.zw), 0.0).rg;
        float variance = abs(moments.x * moments.x - moments.y);
        float visible = 1.0;
        if (dist > moments.x) {
            float d = dist - moments.x;
            visible = variance / (variance + d * d);
            visible = max(visible * visible * visible, 0.0);
        }
        weight *= max(visible, 0.05);
        // Small weights crushed, so a probe that barely sees the point does
        // not tint it (Majercik et al.'s threshold).
        if (weight < 0.2) weight *= weight * weight / 0.04;
        vec3 irradiance = textureLod(DDGI_IRRADIANCE, ddgi_uv(index, N, float(DDGI_IRR), DDGI_ATLAS.xy), 0.0).rgb;
        sum += irradiance * weight;
        total += weight;
    }
    if (total <= 0.0) return vec3(0.0);
    return sum / total * 3.14159265;
}

// How far inside cascade c point P is, in cells from its nearest face: past
// one the cascade is whole; under it, the next one out takes over.
float ddgi_inside(int c, vec3 P) {
    vec3 gridPos = ddgi_grid(c, P);
    vec3 edge = min(gridPos, (DDGI_DIMS.xyz - 1.0) - gridPos);
    return min(edge.x, min(edge.y, edge.z));
}

// The probes' irradiance at P onto N, the nearest cascade that holds it
// blending into the next over its last cell, and beyond the last the
// `beyond` irradiance (the sky's) over the far cascade's last cell. From
// the near cascade out, so a point the near one holds whole reads its
// eight probes and no more.
vec3 ddgi_irradiance(vec3 P, vec3 N, vec3 V, vec3 beyond) {
    vec3 result = vec3(0.0);
    float left = 1.0;
    for (int c = 0; c < DDGI_CASCADES; c++) {
        float inside = ddgi_inside(c, P);
        if (inside <= 0.0) continue;
        float total;
        vec3 e = ddgi_cascade(c, P, N, V, total);
        if (total <= 0.0) continue;
        float share = clamp(inside, 0.0, 1.0) * left;
        result += e * share;
        left -= share;
        if (left <= 0.0) return result;
    }
    return result + beyond * left;
}
void main() {
    // Beyond the volume as nothing and as one: the reading is linear in
    // it, so the difference is its share.
    vec3 none = ddgi_irradiance(query.point.xyz, query.normal.xyz, query.view.xyz, vec3(0.0));
    vec3 whole = ddgi_irradiance(query.point.xyz, query.normal.xyz, query.view.xyz, vec3(1.0));
    answer = vec4(none, whole.x - none.x);
}
GLSL_END

// A skinned figure posed for the rays (#492). The draw poses a skinned
// mesh in its vertex shader, so the pose is in no buffer a bottom-level
// structure can be built from; this pass writes it into one: every vertex
// of the bind pose (nine floats a vertex as the draws read them, the
// position first) skinned by its four joints and weights (eight floats a
// vertex, the skin stream) with the palette the draw is posed by this
// frame (a matrix a bone, column-major), into three floats a vertex -- the
// same sum the vertex shader makes, in the model's own space, so the
// structure's instance takes the model's matrix as the draw does. One
// thread a vertex; the structure is then refitted from what it wrote.
// Vulkan only, as the rays are.
const COMPUTE_SKIN = <<GLSL_END
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer BindVertices { float bindVertex[]; };
layout(std430, set = 0, binding = 1) readonly buffer Skin { vec4 skin[]; };
layout(std430, set = 0, binding = 2) readonly buffer Palette { mat4 bones[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Posed { float posed[]; };

layout(push_constant) uniform SkinParams {
    uint vertexCount;
    uint boneCount;
} params;

// A joint past the palette poses nothing, where the draw would read past
// its array.
mat4 bone(float joint) {
    uint j = uint(joint);
    return j < params.boneCount ? bones[j] : mat4(0.0);
}

void main() {
    uint v = gl_GlobalInvocationID.x;
    if (v >= params.vertexCount) return;
    vec4 bind = vec4(bindVertex[v * 9u], bindVertex[v * 9u + 1u], bindVertex[v * 9u + 2u], 1.0);
    // Three vec4s a vertex: joints, weights, the second UV set (#544).
    vec4 joints = skin[v * 3u];
    vec4 weights = skin[v * 3u + 1u];
    mat4 m = weights.x * bone(joints.x) + weights.y * bone(joints.y)
           + weights.z * bone(joints.z) + weights.w * bone(joints.w);
    vec3 p = (m * bind).xyz;
    posed[v * 3u] = p.x;
    posed[v * 3u + 1u] = p.y;
    posed[v * 3u + 2u] = p.z;
}
GLSL_END

// The cluster cut (#536), three passes over the cluster graphs of the
// frame's clustered models (ae3d.clusterlod builds them, ae3d.vkclusterlod
// keeps them on the device). The cull: a thread an instance's cluster,
// drawn where its own error is at most a pixel on the screen and its
// parent's more -- every sibling deciding by the same sphere and error, so
// a group is drawn whole or its parents are -- and where its sphere is in
// the view. A drawn cluster takes a slot in the visible list and its
// indices' room in its instance's command for its material, by atomics.
// The scan then lays the commands end to end in the frame's index buffer
// and the emit writes each visible cluster's triangles there, as the mesh's
// own vertex indices, so the draws are the scene's own pipelines over the
// mesh's vertex buffer, an indirect command an instance and material.
// Vulkan only: OpenGL 4.1 has no compute, and draws a cut chosen on the CPU.
//
// The three share a layout: a cluster's record is twenty words
// (clusterlod.RECORD_WORDS) -- its vertex references' and triangles' first
// (in the device's buffers of all of them) and counts, its own sphere, the
// sphere and error it is chosen by and its parent's -- an instance twenty
// floats as the draws read it, a command five words as an indexed indirect
// draw reads it, and the counters: the visible clusters, the indices asked
// for, and the emit's dispatch at the fifth word.
const COMPUTE_CLUSTER_CULL = <<GLSL_END
#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Records { uint record[]; };
layout(std430, set = 0, binding = 1) readonly buffer Instances { float instance[]; };
layout(std430, set = 0, binding = 2) buffer Commands { uint command[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Visible { uvec4 visible[]; };
layout(std430, set = 0, binding = 4) buffer Counters { uint counter[]; };
// The view: its six planes (inside where dot(normal, p) + w >= -radius),
// the eye and the pixels a unit spans a unit away, then the error a cut
// may make on the screen, in pixels, and the nearest distance measured.
layout(std430, set = 0, binding = 5) readonly buffer View { vec4 view[]; };
// A crowd's commands, where a pulled draw's count of instances is: the
// figures its tier's sort kept this frame, at word countAt / 4.
layout(std430, set = 0, binding = 9) readonly buffer Counted { uint counted[]; };

layout(push_constant) uniform Params {
    mat4 model;
    uint firstCluster;
    uint clusterCount;
    uint firstInstance;
    uint instanced;
    uint firstCommand;
    uint materials;
    uint commandCount;
    uint budget;
    uint visibleCapacity;
    uint countAt;
    uint pulled;
    uint vertexBits;
} params;

const uint WORDS = 20u;

vec4 sphereAt(uint at) {
    return vec4(uintBitsToFloat(record[at]), uintBitsToFloat(record[at + 1u]),
                uintBitsToFloat(record[at + 2u]), uintBitsToFloat(record[at + 3u]));
}

// An error in the model's units, at a sphere, as pixels on the screen: by
// the sphere's nearest point to the eye, so a cluster is never judged
// further than any of it is.
float onScreen(mat4 m, float scale, vec4 sphere, float error) {
    vec3 centre = (m * vec4(sphere.xyz, 1.0)).xyz;
    float d = max(distance(centre, view[6].xyz) - sphere.w * scale, view[7].y);
    return error * scale / d * view[6].w;
}

void main() {
    uint k = gl_GlobalInvocationID.x;
    uint i = params.firstInstance + gl_GlobalInvocationID.y;
    // A pulled draw -- a crowd's tier -- is one command a material for all
    // its instances: drawn once, each index its instance's slot above the
    // mesh's vertex.
    if (params.pulled != 0u) {
        if (k == 0u && i == 0u) {
            for (uint g = 0u; g < params.materials; g++) {
                uint c = (params.firstCommand + g) * 5u;
                command[c + 1u] = 1u;
                command[c + 3u] = 0u;
                command[c + 4u] = 0u;
            }
        }
        if (i >= counted[params.countAt / 4u]) return;
    }
    mat4 m = params.model;
    if (params.instanced != 0u) {
        uint at = i * 20u;
        m = m * mat4(instance[at], instance[at + 1u], instance[at + 2u], instance[at + 3u],
                     instance[at + 4u], instance[at + 5u], instance[at + 6u], instance[at + 7u],
                     instance[at + 8u], instance[at + 9u], instance[at + 10u], instance[at + 11u],
                     instance[at + 12u], instance[at + 13u], instance[at + 14u], instance[at + 15u]);
    }
    // The instance's commands, one a material: the draw it is reads its
    // own instance, and starts empty (the frame filled them with zero).
    if (k == 0u && params.pulled == 0u) {
        for (uint g = 0u; g < params.materials; g++) {
            uint c = (params.firstCommand + gl_GlobalInvocationID.y * params.materials + g) * 5u;
            command[c + 1u] = 1u;
            command[c + 3u] = 0u;
            command[c + 4u] = i;
        }
    }
    if (k >= params.clusterCount) return;
    uint cluster = params.firstCluster + k;
    uint at = cluster * WORDS;
    float scale = sqrt(max(dot(m[0].xyz, m[0].xyz), max(dot(m[1].xyz, m[1].xyz), dot(m[2].xyz, m[2].xyz))));
    float tau = view[7].x;
    if (onScreen(m, scale, sphereAt(at + 8u), uintBitsToFloat(record[at + 12u])) > tau) return;
    if (onScreen(m, scale, sphereAt(at + 13u), uintBitsToFloat(record[at + 17u])) <= tau) return;
    vec4 own = sphereAt(at + 4u);
    vec3 centre = (m * vec4(own.xyz, 1.0)).xyz;
    float radius = own.w * scale;
    for (uint p = 0u; p < 6u; p++) {
        if (dot(view[p].xyz, centre) + view[p].w < -radius) return;
    }
    uint slot = atomicAdd(counter[0], 1u);
    if (slot >= params.visibleCapacity) return;
    uint draw = params.firstCommand + gl_GlobalInvocationID.y * params.materials + record[at + 19u];
    uint high = 0u;
    if (params.pulled != 0u) {
        draw = params.firstCommand + record[at + 19u];
        high = i << params.vertexBits;
    }
    uint offset = atomicAdd(command[draw * 5u], record[at + 3u] * 3u);
    visible[slot] = uvec4(cluster, draw, offset, high);
}
GLSL_END

// The commands laid end to end: one group, each thread a run of them,
// summed, the sums scanned in shared memory, and each command's first index
// written; a command past the frame's index budget is cut short at it (and
// the indices asked for counted, for the budget to grow by next frame).
// Then the emit's dispatch, a group a visible cluster.
const COMPUTE_CLUSTER_SCAN = <<GLSL_END
#version 450

layout(local_size_x = 128) in;

layout(std430, set = 0, binding = 2) buffer Commands { uint command[]; };
layout(std430, set = 0, binding = 4) buffer Counters { uint counter[]; };

layout(push_constant) uniform Params {
    mat4 model;
    uint firstCluster;
    uint clusterCount;
    uint firstInstance;
    uint instanced;
    uint firstCommand;
    uint materials;
    uint commandCount;
    uint budget;
    uint visibleCapacity;
    uint countAt;
    uint pulled;
    uint vertexBits;
} params;

shared uint sums[128];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint per = (params.commandCount + 127u) / 128u;
    uint begin = min(t * per, params.commandCount);
    uint end = min(begin + per, params.commandCount);
    uint sum = 0u;
    for (uint c = begin; c < end; c++) sum += command[c * 5u];
    sums[t] = sum;
    barrier();
    for (uint o = 1u; o < 128u; o <<= 1u) {
        uint v = t >= o ? sums[t - o] : 0u;
        barrier();
        sums[t] += v;
        barrier();
    }
    uint at = t == 0u ? 0u : sums[t - 1u];
    for (uint c = begin; c < end; c++) {
        uint n = command[c * 5u];
        uint fits = at < params.budget ? min(n, params.budget - at) : 0u;
        command[c * 5u] = fits - fits % 3u;
        command[c * 5u + 2u] = at;
        at += n;
    }
    if (t == 127u) {
        counter[1] = sums[127];
        uint seen = min(counter[0], params.visibleCapacity);
        counter[4] = min(seen, 65535u);
        counter[5] = (seen + 65534u) / 65535u;
        counter[6] = 1u;
    }
}
GLSL_END

// Each visible cluster's triangles into its command's run of the index
// buffer: a group a cluster, a thread a triangle, its three corners the
// mesh's own vertices through the cluster's references. A triangle past
// its command's count -- the budget's cut -- is left out.
const COMPUTE_CLUSTER_EMIT = <<GLSL_END
#version 450

layout(local_size_x = 128) in;

layout(std430, set = 0, binding = 0) readonly buffer Records { uint record[]; };
layout(std430, set = 0, binding = 2) readonly buffer Commands { uint command[]; };
layout(std430, set = 0, binding = 3) readonly buffer Visible { uvec4 visible[]; };
layout(std430, set = 0, binding = 4) readonly buffer Counters { uint counter[]; };
layout(std430, set = 0, binding = 6) readonly buffer Refs { uint ref[]; };
layout(std430, set = 0, binding = 7) readonly buffer Triangles { uint triangle[]; };
layout(std430, set = 0, binding = 8) writeonly buffer Indices { uint index[]; };

layout(push_constant) uniform Params {
    mat4 model;
    uint firstCluster;
    uint clusterCount;
    uint firstInstance;
    uint instanced;
    uint firstCommand;
    uint materials;
    uint commandCount;
    uint budget;
    uint visibleCapacity;
    uint countAt;
    uint pulled;
    uint vertexBits;
} params;

const uint WORDS = 20u;

void main() {
    uint slot = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    if (slot >= min(counter[0], params.visibleCapacity)) return;
    uvec4 entry = visible[slot];
    uint at = entry.x * WORDS;
    uint t = gl_LocalInvocationID.x;
    if (t >= record[at + 3u]) return;
    uint into = entry.z + t * 3u;
    if (into + 3u > command[entry.y * 5u]) return;
    into += command[entry.y * 5u + 2u];
    uint packed = triangle[record[at + 2u] + t];
    uint refs = record[at];
    // A pulled draw's instance rides above the vertex (zero for the rest).
    index[into] = ref[refs + (packed & 255u)] | entry.w;
    index[into + 1u] = ref[refs + ((packed >> 8u) & 255u)] | entry.w;
    index[into + 2u] = ref[refs + ((packed >> 16u) & 255u)] | entry.w;
}
GLSL_END

// The overlay: text and rectangles drawn over the finished frame in the
// window's pixels (ae3d.hud, #449). One source for both renderers:
// OpenGL compiles it as it is, and tools/generate_shaders.ae compiles it
// for Vulkan at #version 450, where glslang defines VULKAN -- which picks
// the push constants the frame's two numbers arrive in there, and the
// explicit varying locations Vulkan needs and a 330 context refuses.
//
// A vertex is its pixel, its place in the glyph atlas, its colour and the
// distance field's threshold: 0.5 the glyph's own outline, lower a glyph
// grown outward (an outline drawn under the text), below zero a solid
// rectangle, which takes no ink from the atlas.
const VERTEX_OVERLAY = <<GLSL_END
#version 330 core

#ifdef VULKAN
#define VARYING(n) layout(location = n)
layout(push_constant) uniform OverlayFrame {
    vec4 overlayScreen;
    vec4 overlayStyle;
};
#else
#define VARYING(n)
uniform vec4 overlayScreen;
uniform vec4 overlayStyle;
#endif

layout(location = 0) in vec2 inPixel;
layout(location = 1) in vec2 inAtlas;
layout(location = 2) in vec4 inColour;
layout(location = 3) in float inEdge;

VARYING(0) out vec2 atlasCoord;
VARYING(1) out vec4 colour;
VARYING(2) out float edge;

void main() {
    // Pixels, y down from the top-left, to clip space: overlayScreen is
    // (2/width, -2/height, -1, 1) on OpenGL, whose clip y is up, and
    // (2/width, 2/height, -1, -1) on Vulkan, whose clip y is down.
    gl_Position = vec4(inPixel * overlayScreen.xy + overlayScreen.zw, 0.0, 1.0);
    atlasCoord = inAtlas;
    colour = inColour;
    edge = inEdge;
}
GLSL_END

const FRAGMENT_OVERLAY = <<GLSL_END
#version 330 core

#ifdef VULKAN
#define VARYING(n) layout(location = n)
layout(push_constant) uniform OverlayFrame {
    vec4 overlayScreen;
    vec4 overlayStyle;
};
layout(set = 0, binding = 0) uniform sampler2D glyphAtlas;
layout(set = 0, binding = 1) uniform sampler2D imagePage;
#else
#define VARYING(n)
uniform vec4 overlayScreen;
uniform vec4 overlayStyle;
uniform sampler2D glyphAtlas;
uniform sampler2D imagePage;
#endif

VARYING(0) in vec2 atlasCoord;
VARYING(1) in vec4 colour;
VARYING(2) in float edge;

layout(location = 0) out vec4 FragColor;

void main() {
    // The field's value, and how much it changes across one screen pixel:
    // the edge is blended over that pixel whatever size the glyph is drawn
    // at, which is what keeps text sharp at 12 px and at 120 from the one
    // atlas. Read for a rectangle too, outside any branch, so the
    // derivative is taken where every pixel of the quad takes it.
    float d = texture(glyphAtlas, atlasCoord).r;
    float w = max(fwidth(d) * 0.5, 1.0 / 255.0);
    float ink = edge < 0.0 ? 1.0 : smoothstep(edge - w, edge + w, d);
    vec3 rgb = colour.rgb;
    // An image (#459), below -1.5: the page's texel, tinted -- display
    // values, as the colours are.
    vec4 picture = texture(imagePage, atlasCoord);
    if (edge < -1.5) {
        rgb = picture.rgb * colour.rgb;
        ink = picture.a;
    }
    // A target that encodes what it is given (an _SRGB swapchain) gets the
    // colour decoded first, so it shows as the display value asked for.
    if (overlayStyle.x > 0.5) rgb = pow(rgb, vec3(2.2));
    FragColor = vec4(rgb, colour.a * ink);
}
GLSL_END

// The water's surface: a kind and no source, since ae3d.shaders.sea draws it
// on both renderers (its vertex and pixel quotes), each picking its pair by
// the kind.
water_shader() -> Shader {
    return core.shader_named(core.SHADER_WATER, "", "")
}
