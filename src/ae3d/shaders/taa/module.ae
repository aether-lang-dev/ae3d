// ae3d.shaders.taa: the temporal pass, written with `quote`.
//
// This frame folded into the history: the history read where this pixel's
// surface was last frame (the scene pass's motion vectors), held to the range
// of this frame's pixel and its eight neighbours, and blended in. It was
// shaders/module.ae's FRAGMENT_TAA.
//
// The frame is radiance, and a lamp is hundreds of times its neighbours:
// held and blended as it is, one bright pixel decides every pixel it reaches
// and the edge it sits on flickers. So the history is kept, clamped and
// blended in a space that shows as the screen does -- each colour over one
// plus how bright it shows (Karis) -- and taken back out after: `fold` and
// `unfold`, @quotable helpers handed the exposure (a helper reads only its
// parameters).
//
//   screen       this frame
//   velocity     the scene pass's motion vectors, the frame's nudge taken out
//   history      the history so far (this frame again when there is none)
//   screen_size  the frame's size in pixels
//   blend        how much of this frame goes in: 1 with no history, so the
//                history is weighed at nothing
//   exposure     the frame's exposure, which brightness is measured at

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, Texture, texture, rgb, xy, dot, max, clamp, min_v3, max_v3, clamp_v3, mix_v3,
                       length_v2)

exports (taa, fold, unfold)

// A colour over one plus how bright it shows at `exposure`.
@quotable
fold(c: vec3, exposure: float) -> vec3 {
    return c / (1.0 + dot(c * exposure, vec3(0.2126, 0.7152, 0.0722)))
}

// fold taken back out.
@quotable
unfold(c: vec3, exposure: float) -> vec3 {
    return c / max(1.0 - dot(c * exposure, vec3(0.2126, 0.7152, 0.0722)), 0.0001)
}

taa(screen: Texture, velocity: Texture, history: Texture, screen_size: vec2, blend: float, exposure: float) -> *GpuShader {
    return fragment("taa") quote | uv: vec2 | {
        px = vec2(1.0 / screen_size.x, 1.0 / screen_size.y)
        current = rgb(texture(screen, uv))
        if blend >= 0.999 {
            return vec4(current, 1.0)
        }
        // Where this pixel's surface was on the screen last frame: the scene
        // pass wrote its motion vector, the surface's own motion and the
        // camera's, with the frame's nudge already taken out -- so a surface
        // that has not moved under a camera that has not moved finds its
        // history at the pixel's own centre. A pixel nothing drew has a
        // vector of zero.
        prev_uv = uv - xy(texture(velocity, uv))
        if prev_uv.x < 0.0 || prev_uv.x > 1.0 || prev_uv.y < 0.0 || prev_uv.y > 1.0 {
            return vec4(current, 1.0)
        }
        past = fold(rgb(texture(history, prev_uv)), exposure)
        now = fold(current, exposure)
        // The neighbourhood's range this frame, and the history held to it:
        // the pixel itself and its eight neighbours.
        low = now
        high = now
        y = -1.0
        while y <= 1.0 {
            x = -1.0
            while x <= 1.0 {
                if x != 0.0 || y != 0.0 {
                    c = fold(rgb(texture(screen, uv + vec2(x, y) * px)), exposure)
                    low = min_v3(low, c)
                    high = max_v3(high, c)
                }
                x = x + 1.0
            }
            y = y + 1.0
        }
        past = clamp_v3(past, low, high)
        // A history that had to be moved far -- a fast pan -- is trusted less.
        travel = length_v2((prev_uv - uv) * screen_size)
        weight = clamp(blend + travel * 0.02, blend, 1.0)
        return vec4(unfold(mix_v3(past, now, weight), exposure), 1.0)
    }
}
