// ae3d.shaders.bloom: the bloom pyramid's passes, written with `quote`.
//
// bloom_down halves a level: thirteen taps in five overlapping groups of
// four (the centre group weighed a half, the corners an eighth each), each
// group weighed by brightness on the first level so a lone bright pixel does
// not flicker, and on the first level only the light past the threshold kept.
// It is shaders/module.ae's FRAGMENT_BLOOM_DOWN, written as Aether.
//
// The helpers are @quotable functions (quote version 2): ae3d.gpu writes each
// out as a GLSL function, and the CPU runs them as the Aether they are. A
// helper reads only its parameters, so `tap` is given the texture and the
// texel size the GLSL version read as uniforms.
//
//   screen     the level being halved (the HDR frame, on the first level)
//   texel      one texel of it, (1 / width, 1 / height)
//   first      1 on the first level: weigh the groups and keep the light
//              past the threshold; 0 after
//   exposure   the frame's exposure, which the threshold is measured at
//   threshold  how bright a pixel has to show to bloom

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, Texture, texture, rgb, dot, max, clamp)

exports (bloom_down, luma, tap, group, past_threshold)

// A colour's luma, by Rec. 709's weights.
@quotable
luma(c: vec3) -> float {
    return dot(c, vec3(0.2126, 0.7152, 0.0722))
}

// The texel `offset` texels from `uv`.
@quotable
tap(screen: Texture, uv: vec2, texel: vec2, offset: vec2) -> vec3 {
    return rgb(texture(screen, uv + offset * texel))
}

// A group of four taps: by brightness on the first level, plainly after.
@quotable
group(first: int, a: vec3, b: vec3, c: vec3, d: vec3) -> vec3 {
    if first == 0 {
        return (a + b + c + d) * 0.25
    }
    wa = 1.0 / (1.0 + luma(a))
    wb = 1.0 / (1.0 + luma(b))
    wc = 1.0 / (1.0 + luma(c))
    wd = 1.0 / (1.0 + luma(d))
    return (a * wa + b * wb + c * wc + d * wd) / (wa + wb + wc + wd)
}

// What of a colour's light is past the threshold, at the frame's exposure,
// eased in over a knee half the threshold wide below it.
@quotable
past_threshold(c: vec3, exposure: float, threshold: float) -> vec3 {
    light = luma(c) * exposure
    knee = max(threshold * 0.5, 0.0001)
    soft = clamp(light - threshold + knee, 0.0, 2.0 * knee)
    soft = soft * soft / (4.0 * knee)
    over = max(soft, light - threshold) / max(light, 0.0001)
    return c * over
}

bloom_down(screen: Texture, texel: vec2, first: int, exposure: float, threshold: float) -> *GpuShader {
    return fragment("bloom_down") quote | uv: vec2 | {
        a = tap(screen, uv, texel, vec2(-2.0, -2.0))
        b = tap(screen, uv, texel, vec2(0.0, -2.0))
        c = tap(screen, uv, texel, vec2(2.0, -2.0))
        d = tap(screen, uv, texel, vec2(-1.0, -1.0))
        e = tap(screen, uv, texel, vec2(1.0, -1.0))
        f = tap(screen, uv, texel, vec2(-2.0, 0.0))
        g = tap(screen, uv, texel, vec2(0.0, 0.0))
        h = tap(screen, uv, texel, vec2(2.0, 0.0))
        i = tap(screen, uv, texel, vec2(-1.0, 1.0))
        j = tap(screen, uv, texel, vec2(1.0, 1.0))
        k = tap(screen, uv, texel, vec2(-2.0, 2.0))
        l = tap(screen, uv, texel, vec2(0.0, 2.0))
        m = tap(screen, uv, texel, vec2(2.0, 2.0))
        sum = group(first, d, e, i, j) * 0.5 + group(first, a, b, f, g) * 0.125 + group(first, b, c, g, h) * 0.125 + group(first, f, g, k, l) * 0.125 + group(first, g, h, l, m) * 0.125
        if first != 0 {
            sum = past_threshold(sum, exposure, threshold)
        }
        return vec4(sum, 1.0)
    }
}
