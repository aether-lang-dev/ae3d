// ae3d.shaders.resolve: the multisampled scene's colour resolved, written
// with `quote`.
//
// color_resolve is each pixel's samples averaged, each weighed by how bright
// it shows at the frame's exposure (1 / (1 + its luma)), so that one very
// bright sample at an edge does not stand for the whole pixel and the edge
// keeps its antialiasing after tone mapping (Karis). It was shaders/
// module.ae's FRAGMENT_COLOR_RESOLVE. It reads its pixel by frag_coord() and
// texel_fetch_ms(), not by the uv it is given, since a resolve is pixel for
// pixel.
//
//   colour    the scene's multisampled colour
//   samples   how many samples it has
//   exposure  the frame's exposure, which brightness is measured at

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, TextureMS, frag_coord, texel_fetch_ms, rgb, dot, max)

exports (color_resolve)

color_resolve(colour: TextureMS, samples: int, exposure: float) -> *GpuShader {
    return fragment("color_resolve") quote | uv: vec2 | {
        sum = vec4(vec3(0.0, 0.0, 0.0), 0.0)
        weights = 0.0
        s = 0
        while s < samples {
            c = texel_fetch_ms(colour, frag_coord(), s)
            w = 1.0 / (1.0 + dot(rgb(c) * exposure, vec3(0.2126, 0.7152, 0.0722)))
            sum = sum + c * w
            weights = weights + w
            s = s + 1
        }
        return sum / max(weights, 0.000001)
    }
}
