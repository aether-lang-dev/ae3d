// ae3d.shaders.lit: the scene's shaders, written with `quote` (step 6,
// docs/aether_quote_design.md section 11). They were VERTEX_DEFAULT and
// FRAGMENT_DEFAULT (scene_vk.vert, scene_plain_vk.vert, its AE3D_UNSKINNED
// variant, scene_vk.frag and its ray-query variant, scene_rq_vk.frag, which
// lit_rq_pixel replaced last): every model's surface, its lights and shadows,
// the sky's light on it, its fog and its motion vector. The module is lit, not scene: ae3d.scene is the
// engine's, and two modules of one last name in a program name a quote's
// helpers by what else it imports.
//
//   - lit_vertex: a model's vertex placed, posed by its bones, turned to
//     the eye for a billboard, its flipbook frame picked, and handed on with
//     where it was last frame;
//   - lit_plain_vertex: the same for the plain pipelines, which name no
//     skin stream (ae3d.vkpipes): its joints and weights none, its mask's uv
//     its first;
//   - lit_pixel: the surface lit.
//
// What they read is three blocks of captured structs (ae3d.vkdesc):
//
//   - the draw's (set 0, draw_layout): its Draw (the model, its instances,
//     whether it is skinned), DrawMaterial, Surface (what a model carries by
//     name: ae3d.rendering's Config), Cut, Wounds, Damage and, last, its Skin
//     (the bone palettes, which a draw that is not skinned does not copy,
//     #726);
//   - the camera's (set 1, frame.view_layout): its Eye, ShadowCascades, Grid and
//     Probes;
//   - the world's (set 2, frame.world_layout): its WorldState (the lights) and
//     Weather.
//
// Each field is the scene block uniform it was (draw_uniform, and the
// frame's tables): Vulkan writes it at its place in its block, OpenGL sets it
// by its GLSL name. The images and buffers are where the hand-written
// shaders had them (place): the draw's colour, normal map, auxiliary image
// and damage mask in its set; the cascades' atlas, the clustered lamps and
// the cells' lists, the lamps' atlas, the screen's occlusion and the probes
// in the camera's; the sky's light in the world's.
//
// Each helper is the hand-written one in the same shape, the same
// operations in the same order, since a GPU that fuses and reorders what it
// may (MoltenVK's fast math) rounds by the shape, not by the value. A helper
// is handed the uniforms and varyings it reads, and reads them in place in
// the GLSL as the hand-written one did (gpu.read_in_place). What the
// hand-written shader kept in globals between its helpers (the hexagons and
// the triplanar planes, the normal's variance, the wet's mirror) is handed
// on in structs, and an `out` parameter is a struct returned.

import std.quote
import std.string
import ae3d.gpu
import ae3d.gpu (GpuShader, GpuLayout, vertex)
import ae3d.shaders.frame
import ae3d.shaders.frame (Eye, ShadowCascades, Grid, Probes, WorldLight, WorldState, Weather)
import ae3d.shaderlib (vec2, vec3, vec4, mat2, mat4, Texture, Floats, Vec4s, rgb, xy, xyz, xz, zx, dot, dot_v2, min, max,
                       abs, sign, clamp, smoothstep, mix, fract, floor, min_v3, max_v3, clamp_v3, mix_v3, mix_v4,
                       length_v2, length_v3, mul, normalize, normalize_v2, cross, distance, sqrt, sin, cos, tan, exp, pow,
                       log2, reflect, texture, texture_lod, texture_size, floor_v2, floor_v3, fract_v2, fract_v3, clamp_v2,
                       abs_v2, splat2, splat3, splat4, float_of, int_of, uint_of_int, float_of_uint, mat2_of, mul_m2,
                       mul_m4, m4_col, mul_m3, mul_fm4, add_m4, mat4_cols, frag_coord, depth_clip, clip_depth, discard,
                       dfdx_v2, dfdy_v2, dfdx_v3, dfdy_v3, fwidth_v3, texture_grad, abs_int, sin_v2, sin_v3, pow_v3,
                       abs_v3, step, mod, mod_v2, ceil, exp2, log, inversesqrt, mul_cols3, mat4_rows, mul_transpose_m2,
                       vec4s_at_i, floats_at_i, clamp_int, min_int, lane_at, lane_at_v3, vec3_xv, texel_fetch_at,
                       yzx, zy, zyx, xzy, xy_v3, vec3_of_v2, yx, AccelerationStructure, ray_query, ray_query_initialize,
                       ray_query_proceed, ray_query_committed_hit, ray_flag_opaque, ray_flag_terminate_on_first_hit, instance_index)

exports (
    Draw, DrawMaterial, Surface, Cut, Wounds, Damage, Skin, LitVertex, LitPlainVertex, LitVaryings, LitOut,
    LitDepthVertex, LitDepthPlainVertex, LitDepthVaryings, PickVertex, PickPlainVertex, PickVaryings,
    draw_layout, draw_count, draw_uniform, draw_capture, draw_field, draw_type, place, gl_name,
    lit_vertex, lit_plain_vertex, lit_pixel, lit_rq_pixel, lit_depth_vertex, lit_depth_plain_vertex, lit_depth_pixel, pick_vertex, pick_plain_vertex, pick_pixel, cloud_hash
)

// ── The draw's block ───────────────────────────────────────────────────

// A draw: its model matrix this frame and last, the light space a shadow
// draw is drawn into (cascade 0 for a lit one), and how its instances are
// drawn -- matrices or points, tinted or not, a billboard upright or full, a
// point's flipbook and how high it stands off its point -- whether it is
// skinned, and whether it is the crowd's far tier as pictures.
struct Draw {
    model: mat4
    prev_model: mat4
    light_space: mat4
    instanced: int
    instance_colour: int
    points: int
    billboard: int
    flip_columns: int
    flip_rows: int
    lift: float
    skinned: int
    impostor: int
    // What the pick pass writes for this draw: its model's id (0: none).
    pick: int
}

// Its material (ae3d.core's Material, as the renderer writes it).
struct DrawMaterial {
    diffuse: vec3
    specular: vec3
    metallic: float
    roughness: float
    exposure: float
    alpha: float
    cutout: float
    normal_strength: float
    tile_breakup: float
    tile_rotation: float
    variation: float
    variation_scale: float
    detail_scale: float
    detail_strength: float
    detail_fade: float
    fire: float
    triplanar: float
    soft: float
    glitter: float
    glitter_grains: float
    glitter_strength: float
    embers: float
    ember_cover: float
    ember_glow: float
    blend: int
    reflectivity: float
    normal_map: int
}

// What a model carries by name (ae3d.rendering's Config, the water's):
// its shadows, its coats, its light from the sky, its haze, its noise and
// its caustics.
struct Surface {
    shadows: int
    shadow_intensity: float
    shadow_softness: float
    clearcoat: int
    clearcoat_roughness: float
    clearcoat_intensity: float
    sheen: int
    sheen_colour: vec3
    sheen_roughness: float
    transmission: int
    transmission_factor: float
    multiple_scattering: int
    energy_conservation: int
    ibl: int
    ibl_intensity: float
    volumetric: int
    volumetric_intensity: float
    volumetric_steps: int
    volumetric_scattering: float
    perlin: int
    noise_scale: float
    noise_octaves: int
    noise_intensity: float
    caustics: int
    caustics_intensity: float
    caustics_scale: float
    caustics_speed: float
    caustics_water_level: float
    caustics_depth: float
}

// The model's cut (#545, #556): on, its plane in bind space, a severed
// limb's loose copy, the edge's noise, and the joints it is kept to.
struct Cut {
    on: int
    plane: vec4
    detached: int
    noise: float
    noise_scale: float
    joints0: int
    joints1: int
    joints2: int
}

// Its wounds and splats (#543, #546): three vec4s each, the layers a wound
// cuts down through, and the share of a wound's radius that is a hole.
struct Wounds {
    count: int
    data: vec4[96]
    layers: vec4[4]
    core: float
}

// The damage its mask keeps (#544): on, the four layers' colours, the mask's
// rectangle and how far in from its edges a read is held.
struct Damage {
    on: int
    colours: vec4[4]
    rect: vec4
    clamp: float
}

// Its bone palettes, this frame's and last frame's top three rows a bone
// (#639). Last in the block: a draw that is not skinned copies it no
// further than where they start (#726).
struct Skin {
    bones: mat4[96]
    prev_rows: vec4[288]
}

const DRAW_UNIFORMS[] = ["model", "prevModel", "lightSpaceMatrix", "isInstanced", "useInstanceColor", "instancePoints",
                         "instanceBillboard", "pointFlipbookColumns", "pointFlipbookRows", "pointLift", "isSkinned",
                         "impostor", "pickId",
                         "diffuseColor", "specularColor", "metallic", "roughness", "exposure", "materialAlpha",
                         "materialCutout", "materialNormalStrength", "materialTileBreakup", "materialTileRotation",
                         "materialVariation", "materialVariationScale", "materialDetailScale", "materialDetailStrength",
                         "materialDetailFade", "materialFire", "materialTriplanar", "materialSoft", "materialGlitter",
                         "materialGlitterGrains", "materialGlitterStrength", "materialEmbers", "materialEmberCover",
                         "materialEmberGlow", "surfaceBlend", "reflectivity", "hasNormalMap",
                         "enableShadows", "shadowIntensity", "shadowSoftness", "enableClearcoat", "clearcoatRoughness",
                         "clearcoatIntensity", "enableSheen", "sheenColor", "sheenRoughness", "enableTransmission",
                         "transmissionFactor", "enableMultipleScattering", "enableEnergyConservation",
                         "enableImageBasedLighting", "iblIntensity", "enableVolumetricLighting", "volumetricIntensity",
                         "volumetricSteps", "volumetricScattering", "enablePerlinNoise", "noiseScale", "noiseOctaves",
                         "noiseIntensity", "enableCaustics", "causticsIntensity", "causticsScale", "causticsSpeed",
                         "causticsWaterLevel", "causticsDepth",
                         "clipOn", "clipPlane", "clipDetached", "clipNoise", "clipNoiseScale", "clipJoints0",
                         "clipJoints1", "clipJoints2",
                         "woundCount", "woundData", "woundLayers", "woundCore",
                         "damageOn", "damageColours", "damageRect", "damageClamp",
                         "bones", "prevBoneRows"]
const DRAW_CAPTURES[] = ["draw", "draw", "draw", "draw", "draw", "draw",
                         "draw", "draw", "draw", "draw", "draw",
                         "draw", "draw",
                         "material", "material", "material", "material", "material", "material",
                         "material", "material", "material", "material",
                         "material", "material", "material", "material",
                         "material", "material", "material", "material", "material",
                         "material", "material", "material", "material",
                         "material", "material", "material", "material",
                         "shading", "shading", "shading", "shading", "shading",
                         "shading", "shading", "shading", "shading", "shading",
                         "shading", "shading", "shading",
                         "shading", "shading", "shading", "shading",
                         "shading", "shading", "shading", "shading", "shading",
                         "shading", "shading", "shading", "shading", "shading",
                         "shading", "shading",
                         "cut", "cut", "cut", "cut", "cut", "cut",
                         "cut", "cut",
                         "wounds", "wounds", "wounds", "wounds",
                         "damage", "damage", "damage", "damage",
                         "skin", "skin"]
const DRAW_FIELDS[] = ["model", "prev_model", "light_space", "instanced", "instance_colour", "points",
                       "billboard", "flip_columns", "flip_rows", "lift", "skinned",
                       "impostor", "pick",
                       "diffuse", "specular", "metallic", "roughness", "exposure", "alpha",
                       "cutout", "normal_strength", "tile_breakup", "tile_rotation",
                       "variation", "variation_scale", "detail_scale", "detail_strength",
                       "detail_fade", "fire", "triplanar", "soft", "glitter",
                       "glitter_grains", "glitter_strength", "embers", "ember_cover",
                       "ember_glow", "blend", "reflectivity", "normal_map",
                       "shadows", "shadow_intensity", "shadow_softness", "clearcoat", "clearcoat_roughness",
                       "clearcoat_intensity", "sheen", "sheen_colour", "sheen_roughness", "transmission",
                       "transmission_factor", "multiple_scattering", "energy_conservation",
                       "ibl", "ibl_intensity", "volumetric", "volumetric_intensity",
                       "volumetric_steps", "volumetric_scattering", "perlin", "noise_scale", "noise_octaves",
                       "noise_intensity", "caustics", "caustics_intensity", "caustics_scale", "caustics_speed",
                       "caustics_water_level", "caustics_depth",
                       "on", "plane", "detached", "noise", "noise_scale", "joints0",
                       "joints1", "joints2",
                       "count", "data", "layers", "core",
                       "on", "colours", "rect", "clamp",
                       "bones", "prev_rows"]
const DRAW_TYPES[] = ["mat4", "mat4", "mat4", "int", "int", "int",
                      "int", "int", "int", "float", "int",
                      "int", "int",
                      "vec3", "vec3", "float", "float", "float", "float",
                      "float", "float", "float", "float",
                      "float", "float", "float", "float",
                      "float", "float", "float", "float", "float",
                      "float", "float", "float", "float",
                      "float", "int", "float", "int",
                      "int", "float", "float", "int", "float",
                      "float", "int", "vec3", "float", "int",
                      "float", "int", "int",
                      "int", "float", "int", "float",
                      "int", "float", "int", "float", "int",
                      "float", "int", "float", "float", "float",
                      "float", "float",
                      "int", "vec4", "int", "float", "float", "int",
                      "int", "int",
                      "int", "vec4[96]", "vec4[4]", "float",
                      "int", "vec4[4]", "vec4", "float",
                      "mat4[96]", "vec4[288]"]
const DRAW_COUNT = 87

draw_count() -> int { return DRAW_COUNT }
draw_type(k: int) -> string { return DRAW_TYPES[k] }
draw_uniform(k: int) -> string { return DRAW_UNIFORMS[k] }
draw_capture(k: int) -> string { return DRAW_CAPTURES[k] }
draw_field(k: int) -> string { return DRAW_FIELDS[k] }

var g_draw_layout: ptr = null

// The draw's block: its Draw, DrawMaterial, Surface, Cut, Wounds, Damage and
// Skin, every field typed and placed in its struct's cell. Made once.
draw_layout() -> *GpuLayout {
    if g_draw_layout != null { return g_draw_layout as *GpuLayout }
    l = gpu.layout_new("DrawBlock")
    _d = gpu.layout_struct(l, "draw", "Draw")
    _m = gpu.layout_struct(l, "material", "DrawMaterial")
    _s = gpu.layout_struct(l, "shading", "Surface")
    _c = gpu.layout_struct(l, "cut", "Cut")
    _w = gpu.layout_struct(l, "wounds", "Wounds")
    _g = gpu.layout_struct(l, "damage", "Damage")
    _k = gpu.layout_struct(l, "skin", "Skin")
    k = 0
    while k < DRAW_COUNT {
        _f = gpu.layout_field(l, DRAW_CAPTURES[k], DRAW_FIELDS[k], draw_offset(k), DRAW_TYPES[k])
        k = k + 1
    }
    g_draw_layout = l as ptr
    return l
}

// Where the draw block's field `k` is in its struct's cell.
fn draw_offset(k: int) -> int {
    c = DRAW_CAPTURES[k]
    f = DRAW_FIELDS[k]
    if c == "draw" {
        if f == "model" { return offsetof(Draw, model) }
        if f == "prev_model" { return offsetof(Draw, prev_model) }
        if f == "light_space" { return offsetof(Draw, light_space) }
        if f == "instanced" { return offsetof(Draw, instanced) }
        if f == "instance_colour" { return offsetof(Draw, instance_colour) }
        if f == "points" { return offsetof(Draw, points) }
        if f == "billboard" { return offsetof(Draw, billboard) }
        if f == "flip_columns" { return offsetof(Draw, flip_columns) }
        if f == "flip_rows" { return offsetof(Draw, flip_rows) }
        if f == "lift" { return offsetof(Draw, lift) }
        if f == "skinned" { return offsetof(Draw, skinned) }
        if f == "pick" { return offsetof(Draw, pick) }
        return offsetof(Draw, impostor)
    }
    if c == "material" { return material_offset(f) }
    if c == "shading" { return surface_offset(f) }
    if c == "cut" {
        if f == "on" { return offsetof(Cut, on) }
        if f == "plane" { return offsetof(Cut, plane) }
        if f == "detached" { return offsetof(Cut, detached) }
        if f == "noise" { return offsetof(Cut, noise) }
        if f == "noise_scale" { return offsetof(Cut, noise_scale) }
        if f == "joints0" { return offsetof(Cut, joints0) }
        if f == "joints1" { return offsetof(Cut, joints1) }
        return offsetof(Cut, joints2)
    }
    if c == "wounds" {
        if f == "count" { return offsetof(Wounds, count) }
        if f == "data" { return offsetof(Wounds, data) }
        if f == "layers" { return offsetof(Wounds, layers) }
        return offsetof(Wounds, core)
    }
    if c == "damage" {
        if f == "on" { return offsetof(Damage, on) }
        if f == "colours" { return offsetof(Damage, colours) }
        if f == "rect" { return offsetof(Damage, rect) }
        return offsetof(Damage, clamp)
    }
    if f == "bones" { return offsetof(Skin, bones) }
    return offsetof(Skin, prev_rows)
}

fn material_offset(f: string) -> int {
    if f == "diffuse" { return offsetof(DrawMaterial, diffuse) }
    if f == "specular" { return offsetof(DrawMaterial, specular) }
    if f == "metallic" { return offsetof(DrawMaterial, metallic) }
    if f == "roughness" { return offsetof(DrawMaterial, roughness) }
    if f == "exposure" { return offsetof(DrawMaterial, exposure) }
    if f == "alpha" { return offsetof(DrawMaterial, alpha) }
    if f == "cutout" { return offsetof(DrawMaterial, cutout) }
    if f == "normal_strength" { return offsetof(DrawMaterial, normal_strength) }
    if f == "tile_breakup" { return offsetof(DrawMaterial, tile_breakup) }
    if f == "tile_rotation" { return offsetof(DrawMaterial, tile_rotation) }
    if f == "variation" { return offsetof(DrawMaterial, variation) }
    if f == "variation_scale" { return offsetof(DrawMaterial, variation_scale) }
    if f == "detail_scale" { return offsetof(DrawMaterial, detail_scale) }
    if f == "detail_strength" { return offsetof(DrawMaterial, detail_strength) }
    if f == "detail_fade" { return offsetof(DrawMaterial, detail_fade) }
    if f == "fire" { return offsetof(DrawMaterial, fire) }
    if f == "triplanar" { return offsetof(DrawMaterial, triplanar) }
    if f == "soft" { return offsetof(DrawMaterial, soft) }
    if f == "glitter" { return offsetof(DrawMaterial, glitter) }
    if f == "glitter_grains" { return offsetof(DrawMaterial, glitter_grains) }
    if f == "glitter_strength" { return offsetof(DrawMaterial, glitter_strength) }
    if f == "embers" { return offsetof(DrawMaterial, embers) }
    if f == "ember_cover" { return offsetof(DrawMaterial, ember_cover) }
    if f == "ember_glow" { return offsetof(DrawMaterial, ember_glow) }
    if f == "blend" { return offsetof(DrawMaterial, blend) }
    if f == "reflectivity" { return offsetof(DrawMaterial, reflectivity) }
    return offsetof(DrawMaterial, normal_map)
}

fn surface_offset(f: string) -> int {
    if f == "shadows" { return offsetof(Surface, shadows) }
    if f == "shadow_intensity" { return offsetof(Surface, shadow_intensity) }
    if f == "shadow_softness" { return offsetof(Surface, shadow_softness) }
    if f == "clearcoat" { return offsetof(Surface, clearcoat) }
    if f == "clearcoat_roughness" { return offsetof(Surface, clearcoat_roughness) }
    if f == "clearcoat_intensity" { return offsetof(Surface, clearcoat_intensity) }
    if f == "sheen" { return offsetof(Surface, sheen) }
    if f == "sheen_colour" { return offsetof(Surface, sheen_colour) }
    if f == "sheen_roughness" { return offsetof(Surface, sheen_roughness) }
    if f == "transmission" { return offsetof(Surface, transmission) }
    if f == "transmission_factor" { return offsetof(Surface, transmission_factor) }
    if f == "multiple_scattering" { return offsetof(Surface, multiple_scattering) }
    if f == "energy_conservation" { return offsetof(Surface, energy_conservation) }
    if f == "ibl" { return offsetof(Surface, ibl) }
    if f == "ibl_intensity" { return offsetof(Surface, ibl_intensity) }
    if f == "volumetric" { return offsetof(Surface, volumetric) }
    if f == "volumetric_intensity" { return offsetof(Surface, volumetric_intensity) }
    if f == "volumetric_steps" { return offsetof(Surface, volumetric_steps) }
    if f == "volumetric_scattering" { return offsetof(Surface, volumetric_scattering) }
    if f == "perlin" { return offsetof(Surface, perlin) }
    if f == "noise_scale" { return offsetof(Surface, noise_scale) }
    if f == "noise_octaves" { return offsetof(Surface, noise_octaves) }
    if f == "noise_intensity" { return offsetof(Surface, noise_intensity) }
    if f == "caustics" { return offsetof(Surface, caustics) }
    if f == "caustics_intensity" { return offsetof(Surface, caustics_intensity) }
    if f == "caustics_scale" { return offsetof(Surface, caustics_scale) }
    if f == "caustics_speed" { return offsetof(Surface, caustics_speed) }
    if f == "caustics_water_level" { return offsetof(Surface, caustics_water_level) }
    return offsetof(Surface, caustics_depth)
}

// The images and buffers, the hand-written shaders' names and the quoted
// ones'.
const IMAGE_UNIFORMS[] = ["textureSampler", "normalMap", "sceneDepth", "damageMask", "shadowMap", "clusterLights",
                          "clusterWords", "lampShadowMap", "occlusionMap", "skyLight", "brdfLut", "skyIrradiance"]
const IMAGE_NAMES[] = ["colour_map", "normal_map", "scene_depth", "damage_mask", "shadow_map", "cluster_lights",
                       "cluster_words", "lamp_shadow_map", "occlusion_map", "sky_light", "brdf_lut", "sky_irradiance"]
const IMAGE_COUNT = 12

// The GLSL name the quoted scene shaders give what the hand-written ones
// called `name`, which OpenGL sets it by: viewPos is eye.position,
// lights[3].color world.lights[3].colour, bones skin.bones[0] (an array's
// first element, the others after it), shadowMap shadow_map; the name itself
// for one they do not have.
gl_name(name: string) -> string {
    if string.starts_with(name, "lights[") == 1 {
        close = string.index_of(name, "]")
        dot_at = string.index_of(name, ".")
        if close > 0 && dot_at > close {
            part = string.substring(name, dot_at + 1, string.length(name))
            k = 0
            while k < frame.light_count() {
                if frame.light_uniform(k) == part {
                    return "world.lights${string.substring(name, 6, close + 1)}.${frame.light_field(k)}"
                }
                k = k + 1
            }
        }
        return name
    }
    k = 0
    while k < DRAW_COUNT {
        if DRAW_UNIFORMS[k] == name { return field_name(DRAW_CAPTURES[k], DRAW_FIELDS[k], DRAW_TYPES[k]) }
        k = k + 1
    }
    k = 0
    while k < frame.view_count() {
        if frame.view_uniform(k) == name { return field_name(frame.view_capture(k), frame.view_field(k), frame.view_type(k)) }
        k = k + 1
    }
    k = 0
    while k < frame.world_count() {
        if frame.world_uniform(k) == name { return field_name(frame.world_capture(k), frame.world_field(k), frame.world_type(k)) }
        k = k + 1
    }
    k = 0
    while k < IMAGE_COUNT {
        if IMAGE_UNIFORMS[k] == name { return IMAGE_NAMES[k] }
        k = k + 1
    }
    return name
}

fn field_name(capture: string, field: string, t: string) -> string {
    if string.ends_with(t, "]") == 1 { return "${capture}.${field}[0]" }
    return "${capture}.${field}"
}

// The scene's blocks and images for the shader `s` (its stage's own of
// them): the three layouts at sets 0, 1 and 2, the images and buffers
// where the hand-written shaders had them, its helpers reading in place.
place(s: *GpuShader) {
    _d = gpu.use_layout(s, 0, draw_layout())
    _v = gpu.use_layout(s, 1, frame.view_layout())
    _w = gpu.use_layout(s, 2, frame.world_layout())
    _t = gpu.capture_binding(s, "colour_map", 0, 1)
    _n = gpu.capture_binding(s, "normal_map", 0, 3)
    _x = gpu.capture_binding(s, "scene_depth", 0, 4)
    _m = gpu.capture_binding(s, "damage_mask", 0, 9)
    _c = gpu.capture_binding(s, "shadow_map", 1, 1)
    _l = gpu.capture_binding(s, "cluster_lights", 1, 2)
    _o = gpu.capture_binding(s, "cluster_words", 1, 3)
    _a = gpu.capture_binding(s, "lamp_shadow_map", 1, 4)
    _q = gpu.capture_binding(s, "occlusion_map", 1, 5)
    _y = gpu.capture_binding(s, "sky_light", 2, 1)
    _b = gpu.capture_binding(s, "brdf_lut", 2, 2)
    _i = gpu.capture_binding(s, "sky_irradiance", 2, 3)
    gpu.read_in_place(s)
}

// ── The pixel shader's structs ─────────────────────────────────────────

// What the vertex shader hands on, by FRAGMENT_DEFAULT's names, at its
// places (`position` is gl_Position).
struct LitVaryings {
    position: vec4
    fragTexCoord: vec2
    Normal: vec3
    FragPos: vec3
    InstanceColor: vec3
    FragPosLightSpace: vec4
    Occlusion: float
    ClipNow: vec4
    ClipPrev: vec4
    BindPos: vec3
    ClipLimb: float
    MaskUV: vec2
    ParticleAlpha: float
    FlipNext: vec3
}

// The surface's light at location 0 and its motion at 1.
struct LitOut {
    colour: vec4
    velocity: vec2
}

// A lamp of the clusters as the shading takes it, its reach and its own
// shadow's slot (-1 for none): clustered_light's two `out`s.
struct ClusterLamp {
    light: WorldLight
    reach: float
    slot: int
}

// One light's contribution and its back fill (direct_light's `out`).
struct DirectLight {
    lit: vec3
    back_fill: vec3
}

// The hexagons over a texel (hex_setup's globals): each one's coordinate
// and turn, the derivatives turned with them, and the blend's weights.
struct Hex {
    uv0: vec2
    uv1: vec2
    uv2: vec2
    turn0: mat2
    turn1: mat2
    turn2: mat2
    dx: vec2
    dy: vec2
    weights: vec3
}

// The colour read through them, and the weights it sharpened.
struct HexColour {
    colour: vec4
    weights: vec3
}

// The triplanar planes (tri_setup's globals): their weights and coordinates.
struct Tri {
    weights: vec3
    x: vec2
    y: vec2
    z: vec2
}

// A mapped normal and the variance its mips averaged away (normalVariance).
struct MappedNormal {
    normal: vec3
    variance: float
}

// The tangent frame: three columns.
struct Frame {
    tangent: vec3
    bitangent: vec3
    normal: vec3
}

// ── The pixel shader's helpers ─────────────────────────────────────────

// The light grid's cell of a point (ae3d.lightgrid's).
@quotable
cluster_of(p: vec3, grid_vp: mat4, depth_plane: vec4, dims_f: vec4, depth_range: vec4) -> int {
    clip = mul(grid_vp, vec4(p, 1.0))
    w = if (clip.w != 0.0) { clip.w } else { 1.0 }
    ndc = xy(clip) / w
    depth = dot(xyz(depth_plane), p) + depth_plane.w
    dims = xyz(dims_f) + splat3(0.5)
    dx = int_of(dims.x)
    dy = int_of(dims.y)
    dz = int_of(dims.z)
    x = clamp_int(int_of(floor((ndc.x * 0.5 + 0.5) * float_of(dx))), 0, dx - 1)
    y = clamp_int(int_of(floor((ndc.y * 0.5 + 0.5) * float_of(dy))), 0, dy - 1)
    z = 0
    if depth > depth_range.x {
        z = clamp_int(int_of(floor(log(depth) * depth_range.z + depth_range.w)), 0, dz - 1)
    }
    return (z * dy + y) * dx + x
}

// Lamp `i` of the clusters: five vec4s.
@quotable
clustered_light(lamps: Vec4s, i: int) -> ClusterLamp {
    a = vec4s_at_i(lamps, i * 5)
    b = vec4s_at_i(lamps, i * 5 + 1)
    c = vec4s_at_i(lamps, i * 5 + 2)
    d = vec4s_at_i(lamps, i * 5 + 3)
    e = vec4s_at_i(lamps, i * 5 + 4)
    return ClusterLamp { light: WorldLight { position: xyz(a), colour: rgb(b), intensity: b.w, temperature: d.w,
                                        kind: int_of(c.w + 0.5), direction: xyz(c), constant: d.x, linear: d.y,
                                        quadratic: d.z, cos_outer: e.x, cos_inner: e.y },
                         reach: a.w, slot: int_of(floor(e.z + 0.5)) }
}

// How much of a soft particle's alpha this fragment keeps.
@quotable
soft_fade(soft: float, depth_on: int, screen: vec2, scene_depth: Texture, inv_vp: mat4, eye_pos: vec3, frag_pos: vec3) -> float {
    if soft <= 0.0 || depth_on != 1 {
        return 1.0
    }
    suv = frag_coord() / screen
    d = texture(scene_depth, suv).x
    if d >= 0.99999 {
        return 1.0
    }
    sp = suv * 2.0 - splat2(1.0)
    clip = vec4(vec3(sp.x, sp.y, depth_clip(d)), 1.0)
    world = mul(inv_vp, clip)
    behind = xyz(world) / world.w
    gap = distance(eye_pos, behind) - distance(eye_pos, frag_pos)
    return clamp(gap / soft, 0.0, 1.0)
}

// How lit a point is in cascade `c`.
@quotable
cascade_lit(c: int, surface: vec3, slope: float, matrices: mat4[4], texel_world: vec4, frag_pos: vec3, shadow_map: Texture,
            softness: float) -> float {
    light_space = mul(matrices[c], vec4(frag_pos + surface * lane_at(texel_world, c) * (1.0 + slope), 1.0))
    projected = xyz(light_space) / light_space.w
    pxy = xy_v3(projected) * 0.5 + splat2(0.5)
    pz = clip_depth(projected.z)
    if pz > 1.0 {
        return 1.0
    }
    if pxy.x < 0.0 || pxy.x > 1.0 || pxy.y < 0.0 || pxy.y > 1.0 {
        return 1.0
    }
    texel = splat2(1.0) / texture_size(shadow_map)
    radius = max(softness, 1.0)
    tile = vec2(float_of(c % 2), float_of(c / 2)) * 0.5
    centre = tile + pxy * 0.5
    lo = tile + texel * (radius + 0.5)
    hi = tile + splat2(0.5) - texel * (radius + 0.5)
    bias = radius / (texture_size(shadow_map).x * 0.5)
    lit = 0.0
    for (sx = -1; sx <= 1; sx++) {
        for (sy = -1; sy <= 1; sy++) {
            at = clamp_v2(centre + vec2(float_of(sx), float_of(sy)) * texel * radius, lo, hi)
            closest = texture(shadow_map, at).x
            lit = lit + (if (pz - bias > closest) { 0.0 } else { 1.0 })
        }
    }
    return lit / 9.0
}

// The key light's shadow by its cascades.
@quotable
shadow_factor(normal: vec3, shadow_direction: vec3, depth_plane: vec4, frag_pos: vec3, count: int, splits: vec4,
              intensity: float, matrices: mat4[4], texel_world: vec4, shadow_map: Texture, softness: float) -> float {
    surface = normalize(normal)
    to_light = normalize(-shadow_direction)
    facing = max(dot(surface, to_light), 0.0)
    slope = min(sqrt(1.0 - facing * facing) / max(facing, 0.02), 32.0)
    depth = dot(xyz(depth_plane), frag_pos) + depth_plane.w
    c = -1
    for (i = 0; i < 4; i++) {
        if i < count && depth <= lane_at(splits, i) {
            c = i
            break
        }
    }
    if c < 0 {
        return 1.0
    }
    lit = cascade_lit(c, surface, slope, matrices, texel_world, frag_pos, shadow_map, softness)
    if c + 1 < count {
        start = if (c == 0) { 0.0 } else { lane_at(splits, c - 1) }
        band = (lane_at(splits, c) - start) * 0.1
        into = (lane_at(splits, c) - depth) / max(band, 0.0001)
        if into < 1.0 {
            lit = mix(cascade_lit(c + 1, surface, slope, matrices, texel_world, frag_pos, shadow_map, softness), lit, into)
        }
    }
    return mix(intensity, 1.0, lit)
}

// A depth a lamp's face stores as the distance along its axis.
@quotable
lamp_distance(depth: float, near: float, far: float) -> float {
    return near * far / (far - depth * (far - near))
}

// How much of lamp slot `slot`'s light reaches this point (ae3d.lampshadows).
@quotable
lamp_shadow(slot: int, surface: vec3, lamp_base: int, lamps: Vec4s, frag_pos: vec3, lamp_map: Texture, softness: float,
            intensity: float) -> float {
    base = lamp_base + slot * 26
    head = vec4s_at_i(lamps, base)
    more = vec4s_at_i(lamps, base + 1)
    v = frag_pos - xyz(head)
    far = head.w
    strength = more.x
    near = more.y
    a = abs_v3(v)
    face = 0
    along = 0.0
    if a.x >= a.y && a.x >= a.z {
        face = if (v.x > 0.0) { 0 } else { 1 }
        along = a.x
    } else if a.y >= a.z {
        face = if (v.y > 0.0) { 2 } else { 3 }
        along = a.y
    } else {
        face = if (v.z > 0.0) { 4 } else { 5 }
        along = a.z
    }
    if strength <= 0.0 || along >= far || along <= near {
        return 1.0
    }
    to_lamp = -v / max(length_v3(v), 0.0001)
    facing = max(dot(surface, to_lamp), 0.0)
    slope = min(sqrt(1.0 - facing * facing) / max(facing, 0.02), 32.0)
    texel_world = 2.0 * along / 512.0
    m = base + 2 + face * 4
    face_matrix = mat4_cols(vec4s_at_i(lamps, m), vec4s_at_i(lamps, m + 1), vec4s_at_i(lamps, m + 2), vec4s_at_i(lamps, m + 3))
    light_space = mul(face_matrix, vec4(frag_pos + surface * texel_world * (1.0 + slope), 1.0))
    projected = xyz(light_space) / light_space.w
    pxy = clamp_v2(xy_v3(projected) * 0.5 + splat2(0.5), splat2(0.0), splat2(1.0))
    mine = lamp_distance(clip_depth(projected.z), near, far)
    tile = slot * 6 + face
    share = 1.0 / 8.0
    origin = vec2(float_of(tile % 8), float_of(tile / 8)) * share
    texel = splat2(1.0) / texture_size(lamp_map)
    radius = max(softness, 1.0)
    centre = origin + pxy * share
    lo = origin + texel * (radius + 0.5)
    hi = origin + splat2(share) - texel * (radius + 0.5)
    bias = texel_world * 1.5
    lit = 0.0
    for (sx = -1; sx <= 1; sx++) {
        for (sy = -1; sy <= 1; sy++) {
            at = clamp_v2(centre + vec2(float_of(sx), float_of(sy)) * texel * radius, lo, hi)
            closest = lamp_distance(texture(lamp_map, at).x, near, far)
            lit = lit + (if (mine - bias > closest) { 0.0 } else { 1.0 })
        }
    }
    return mix(1.0, mix(intensity, 1.0, lit / 9.0), strength)
}

// A colour temperature as an RGB multiplier.
@quotable
kelvin_to_rgb(kelvin_in: float) -> vec3 {
    kelvin = clamp(kelvin_in, 1000.0, 12000.0)
    if kelvin < 3000.0 {
        return mix_v3(vec3(1.0, 0.4, 0.0), vec3(1.0, 0.7, 0.3), (kelvin - 1000.0) / 2000.0)
    } else if kelvin < 6500.0 {
        return mix_v3(vec3(1.0, 0.7, 0.3), vec3(1.0, 1.0, 1.0), (kelvin - 3000.0) / 3500.0)
    } else {
        return mix_v3(vec3(1.0, 1.0, 1.0), vec3(0.7, 0.8, 1.0), (kelvin - 6500.0) / 5500.0)
    }
}

// The colour a black body glows at `kelvin`.
@quotable
black_body(kelvin: float) -> vec3 {
    t = max(kelvin, 500.0) / 100.0
    g = if (t <= 6.6) { 0.0 } else { clamp((99.4708025861 * log(t) - 161.1195681661) / 255.0, 0.0, 1.0) }
    b = if (t <= 19.0) { 0.0 } else { clamp((138.5177312231 * log(t - 10.0) - 305.0447927307) / 255.0, 0.0, 1.0) }
    return pow_v3(vec3(1.0, g, b), splat3(2.2))
}

@quotable
ember_hash(c: vec3) -> float { return fract(sin(dot(c, vec3(41.3, 289.1, 157.7))) * 43758.5453) }

@quotable
ember_noise(p: vec3) -> float {
    i = floor_v3(p)
    f0 = p - i
    f = f0 * f0 * (splat3(3.0) - f0 * 2.0)
    a = mix(mix(ember_hash(i), ember_hash(i + vec3(1.0, 0.0, 0.0)), f.x),
            mix(ember_hash(i + vec3(0.0, 1.0, 0.0)), ember_hash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y)
    b = mix(mix(ember_hash(i + vec3(0.0, 0.0, 1.0)), ember_hash(i + vec3(1.0, 0.0, 1.0)), f.x),
            mix(ember_hash(i + vec3(0.0, 1.0, 1.0)), ember_hash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y)
    return mix(a, b, f.z)
}

// A burning surface's own light (#738).
@quotable
ember_light(frag_pos: vec3, time: float, cover: float, embers: float, glow: float) -> vec3 {
    p = frag_pos * 20.0
    i = floor_v3(p)
    f = p - i
    f1 = 8.0
    f2 = 8.0
    nearest = i
    for (z = -1; z <= 1; z++) {
        for (y = -1; y <= 1; y++) {
            for (x = -1; x <= 1; x++) {
                o = vec3(float_of(x), float_of(y), float_of(z))
                c = i + o
                h = fract_v3(sin_v3(vec3(dot(c, vec3(127.1, 311.7, 74.7)), dot(c, vec3(269.5, 183.3, 246.1)),
                                         dot(c, vec3(113.5, 271.9, 124.6)))) * 43758.5453)
                d = length_v3(o + h - f)
                if d < f1 {
                    f2 = f1
                    f1 = d
                    nearest = c
                } else if d < f2 {
                    f2 = d
                }
            }
        }
    }
    crack = 1.0 - smoothstep(0.0, 0.07, f2 - f1)
    hn = ember_hash(nearest)
    hot = ember_noise(nearest * 0.2) * 0.75 + hn * 0.25
    breath = 0.75 + 0.25 * sin(time * (0.9 + hn * 1.6) + hn * 37.0)
    heat = crack * 0.3
    if hot < cover {
        heat = mix(0.55, 1.0, crack) * breath * (0.8 + 0.2 * ember_noise(p * 0.7))
    }
    h2 = heat * heat
    return black_body(heat * embers) * (h2 * h2) * glow
}

// The key light glinting off the grains under this fragment (#741).
@quotable
glitter(n: vec3, v: vec3, l_in: WorldLight, frag_pos: vec3, grains: float, share: float, strength: float) -> vec3 {
    grid = frag_pos * grains
    footprint = max(length_v3(fwidth_v3(grid)), 1e-4)
    level = max(ceil(log2(footprint)), 0.0)
    if level > 7.0 {
        return splat3(0.0)
    }
    scale = exp2(level)
    cell = floor_v3(grid / scale)
    h = fract_v3(sin_v3(vec3(dot(cell, vec3(127.1, 311.7, 74.7)), dot(cell, vec3(269.5, 183.3, 246.1)),
                             dot(cell, vec3(113.5, 271.9, 124.6)))) * 43758.5453)
    chance = min(share * scale * scale, 1.0)
    if h.x > chance {
        return splat3(0.0)
    }
    l = normalize(l_in.direction)
    lit = max(dot(n, l), 0.0)
    if lit <= 0.0 {
        return splat3(0.0)
    }
    k = fract_v3(h * 13.731 + yzx(h) * 7.17)
    facet = normalize(n * 0.6 + (k * 2.0 - splat3(1.0)))
    flash = pow(max(dot(facet, normalize(l + v)), 0.0), 900.0)
    return l_in.colour * kelvin_to_rgb(l_in.temperature) * l_in.intensity * flash * lit * strength / (scale * scale)
}

@quotable
fresnel_schlick(cos_theta: float, f0: vec3) -> vec3 {
    inv = clamp(1.0 - cos_theta, 0.0, 1.0)
    inv2 = inv * inv
    inv5 = inv2 * inv2 * inv
    return f0 + (splat3(1.0) - f0) * inv5
}

@quotable
distribution_ggx(n: vec3, h: vec3, rough: float) -> float {
    a = rough * rough
    a2 = a * a
    ndoth = max(dot(n, h), 0.0)
    ndoth2 = ndoth * ndoth
    num = a2
    denom0 = (ndoth2 * (a2 - 1.0) + 1.0)
    denom = 3.14159265359 * denom0 * denom0
    result = num / denom
    return min(result, 10.0)
}

@quotable
geometry_schlick_ggx(ndotv: float, rough: float) -> float {
    r = (rough + 1.0)
    k = (r * r) / 8.0
    num = ndotv
    denom = ndotv * (1.0 - k) + k
    return num / denom
}

@quotable
geometry_smith(n: vec3, v: vec3, l: vec3, rough: float) -> float {
    ndotv = max(dot(n, v), 0.0)
    ndotl = max(dot(n, l), 0.0)
    ggx2 = geometry_schlick_ggx(ndotv, rough)
    ggx1 = geometry_schlick_ggx(ndotl, rough)
    return ggx1 * ggx2
}

@quotable
calculate_clearcoat(n: vec3, v: vec3, l: vec3, h: vec3, base_colour: vec3, on: int, rough: float, intensity: float) -> vec3 {
    if on == 0 {
        return splat3(0.0)
    }
    ndf = distribution_ggx(n, h, rough)
    g = geometry_smith(n, v, l, rough)
    f = fresnel_schlick(max(dot(h, v), 0.0), splat3(0.04))
    specular = (f * (ndf * g)) / (4.0 * max(dot(n, v), 0.0) * max(dot(n, l), 0.0) + 0.001)
    return specular * intensity
}

@quotable
calculate_sheen(n: vec3, v: vec3, l: vec3, h: vec3, on: int, rough: float, colour: vec3) -> vec3 {
    if on == 0 {
        return splat3(0.0)
    }
    ndoth = max(dot(n, h), 0.0)
    d = (2.0 + rough) * pow(ndoth, rough) / (2.0 * 3.14159265359)
    return colour * d * 0.25
}

@quotable
calculate_transmission(n: vec3, v: vec3, l: vec3, base_colour: vec3, on: int, factor: float) -> vec3 {
    if on == 0 {
        return splat3(0.0)
    }
    ndotv = max(dot(n, v), 0.0)
    ndotl = max(dot(n, l), 0.0)
    f0 = 0.04
    fresnel = f0 + (1.0 - f0) * pow(1.0 - ndotv, 5.0)
    transmission = (1.0 - fresnel) * factor
    transmitted = base_colour * transmission * ndotl
    scattering = base_colour * transmission * 0.1
    return transmitted + scattering
}

@quotable
compensate_energy_loss(colour: vec3, ndotv: float, rough: float, on: int) -> vec3 {
    if on == 0 {
        return colour
    }
    compensation = 1.0 + rough * (1.0 - ndotv) * 0.2
    return colour * compensation
}

@quotable
apply_energy_conservation(diffuse: vec3, specular: vec3, clearcoat: vec3, sheen: vec3, on: int) -> vec3 {
    if on == 0 {
        return diffuse + specular + clearcoat + sheen
    }
    total = diffuse + specular + clearcoat + sheen
    most = max(max(total.x, total.y), total.z)
    if most > 1.0 {
        return total / most
    }
    return total
}

// The haze a lamp lights on a wet night.
@quotable
calculate_volumetric_lighting(world_pos: vec3, light_pos: vec3, view_pos: vec3, on: int, steps_in: int, colour: vec3,
                              temperature: float, scattering: float, intensity: float) -> vec3 {
    if on == 0 {
        return splat3(0.0)
    }
    to_surface = world_pos - view_pos
    ray_length = length_v3(to_surface)
    if ray_length < 0.001 {
        return splat3(0.0)
    }
    ray_dir = to_surface / ray_length
    steps = clamp_int(steps_in, 8, 32)
    tint = colour * kelvin_to_rgb(temperature)
    scatter = 0.0
    step_size = ray_length / float_of(steps)
    for (i = 0; i < steps && i < 32; i++) {
        sample_pos = view_pos + ray_dir * (step_size * (float_of(i) + 0.5))
        d = length_v3(light_pos - sample_pos)
        scatter = scatter + step_size / (1.0 + d * d * scattering)
    }
    return tint * scatter * intensity
}

// GPU Gems chapter 5's noise, the hashed lattice.
@quotable
lattice_hash(x: int, y: int, z: int) -> int {
    n0 = x + y * 57 + z * 113
    n = (n0 << 13) ^ n0
    return abs_int((n * (n * n * 15731 + 789221) + 1376312589)) & 255
}

@quotable
fade(t: float) -> float { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }

@quotable
lerp(t: float, a: float, b: float) -> float { return a + t * (b - a) }

@quotable
get_gradient(hashed: int) -> vec3 {
    h = hashed & 15
    u = if (h < 8) { 1.0 } else { -1.0 }
    v = if ((h & 1) == 0) { 1.0 } else { -1.0 }
    w = if ((h & 2) == 0) { 1.0 } else { -1.0 }
    if h < 4 {
        return vec3(u, v, 0.0)
    } else if h < 8 {
        return vec3(u, 0.0, w)
    } else if h < 12 {
        return vec3(0.0, v, w)
    } else {
        return vec3(u, v, w)
    }
}

// The clouds over the ground, for their shadow (ae3d.cloudnoise's field).
@quotable
cloud_hash(p: vec3) -> float {
    // Constants past an int's are uint(the int of their bits): 3812015801u,
    // 2798796415u and 0x846ca68bu, folded by glslang to the same words.
    uint32 vx = uint_of_int(int_of(floor(p.x)))
    uint32 vy = uint_of_int(int_of(floor(p.y)))
    uint32 vz = uint_of_int(int_of(floor(p.z)))
    vx = vx * 0x5F356495
    vy = vy * uint_of_int(-482951495)
    vz = vz * uint_of_int(-1496170881)
    uint32 n5 = (vx ^ vy ^ vz) * 0x5F356495
    n5 = n5 ^ (n5 >> 16)
    n5 = n5 * 0x7FEB352D
    n5 = n5 ^ (n5 >> 15)
    n5 = n5 * uint_of_int(-2073254261)
    n5 = n5 ^ (n5 >> 16)
    return float_of_uint(n5) * (1.0 / 4294967296.0)
}

@quotable
cloud_noise2(x: vec2, period: float, seed: float) -> float {
    i = floor_v2(x)
    f0 = fract_v2(x)
    f = f0 * f0 * (splat2(3.0) - f0 * 2.0)
    i0 = mod_v2(i, period)
    i1 = mod_v2(i + splat2(1.0), period)
    a = cloud_hash(vec3(i0.x, i0.y, seed))
    b = cloud_hash(vec3(i1.x, i0.y, seed))
    c = cloud_hash(vec3(i0.x, i1.y, seed))
    d = cloud_hash(vec3(i1.x, i1.y, seed))
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y)
}

@quotable
cloud_weather_at(uv: vec2) -> vec2 {
    shape = 0.0
    amp = 0.5
    freq = 6.0
    for (o = 0; o < 5; o++) {
        shape = shape + amp * cloud_noise2(uv * freq, freq, float_of(41 + o * 17))
        amp = amp * 0.5
        freq = freq * 2.0
    }
    shaped = clamp((shape - 0.3) / 0.4, 0.0, 1.0)
    bank = cloud_noise2(uv * 3.0, 3.0, 8.0)
    return vec2(shaped, bank)
}

@quotable
cloud_weather_uv(at: vec2, t: float) -> vec2 { return at / 24000.0 + vec2(t * 0.00012, t * 0.00004) }

@quotable
cloud_coverage_from(weather: vec2, cover: float) -> float {
    threshold = 1.0 - cover * (0.45 + 1.1 * weather.y)
    return smoothstep(threshold, threshold + 0.5, weather.x) * 0.9
}

@quotable
cloud_coverage(at: vec2, cover: float, t: float) -> float {
    return cloud_coverage_from(cloud_weather_at(cloud_weather_uv(at, t)), cover)
}

@quotable
cloud_shadow(world_pos: vec3, cover: float, cloud_sun: vec3, t: float) -> float {
    if cover <= 0.0 || cloud_sun.y <= 0.05 {
        return 1.0
    }
    sun = normalize(cloud_sun)
    up = (1400.0 + (2600.0 - 1400.0) * 0.35 - world_pos.y) / max(sun.y, 0.05)
    at = xz(world_pos) + xz(sun) * up
    return 1.0 - 0.65 * cloud_coverage(at, cover, t)
}

@quotable
perlin_noise3d(p: vec3) -> float {
    ix = int_of(floor(p.x))
    iy = int_of(floor(p.y))
    iz = int_of(floor(p.z))
    f = p - vec3(float_of(ix), float_of(iy), float_of(iz))
    u = vec3(fade(f.x), fade(f.y), fade(f.z))
    n000 = lattice_hash(ix, iy, iz)
    n001 = lattice_hash(ix, iy, iz + 1)
    n010 = lattice_hash(ix, iy + 1, iz)
    n011 = lattice_hash(ix, iy + 1, iz + 1)
    n100 = lattice_hash(ix + 1, iy, iz)
    n101 = lattice_hash(ix + 1, iy, iz + 1)
    n110 = lattice_hash(ix + 1, iy + 1, iz)
    n111 = lattice_hash(ix + 1, iy + 1, iz + 1)
    d000 = dot(get_gradient(n000), f)
    d001 = dot(get_gradient(n001), f - vec3(0.0, 0.0, 1.0))
    d010 = dot(get_gradient(n010), f - vec3(0.0, 1.0, 0.0))
    d011 = dot(get_gradient(n011), f - vec3(0.0, 1.0, 1.0))
    d100 = dot(get_gradient(n100), f - vec3(1.0, 0.0, 0.0))
    d101 = dot(get_gradient(n101), f - vec3(1.0, 0.0, 1.0))
    d110 = dot(get_gradient(n110), f - vec3(1.0, 1.0, 0.0))
    d111 = dot(get_gradient(n111), f - vec3(1.0, 1.0, 1.0))
    return lerp(u.z, lerp(u.y, lerp(u.x, d000, d100), lerp(u.x, d010, d110)),
                lerp(u.y, lerp(u.x, d001, d101), lerp(u.x, d011, d111)))
}

@quotable
turbulence(p: vec3, octaves: int) -> float {
    value = 0.0
    amplitude = 1.0
    frequency = 1.0
    most = 0.0
    for (i = 0; i < octaves && i < 8; i++) {
        value = value + perlin_noise3d(p * frequency) * amplitude
        most = most + amplitude
        amplitude = amplitude * 0.5
        frequency = frequency * 2.0
    }
    return value / most
}

// The web a water surface casts on what lies under it (GPU Gems chapter 2).
@quotable
caustic_web(uv: vec2, t: float, speed: float) -> float {
    drift = vec2(0.7, 0.3) * speed * t
    a = perlin_noise3d(vec3_of_v2(uv + drift, t * speed * 0.5))
    b = perlin_noise3d(vec3_of_v2(uv * 1.7 - drift * 0.8, t * speed * 0.4 + 5.3))
    return pow(clamp(1.0 - abs(a - b) * 3.0, 0.0, 1.0), 8.0)
}

@quotable
caustic_light(world_pos: vec3, norm: vec3, on: int, water_level: float, scale: float, time: float, speed: float, depth_fall: float,
              key_colour: vec3, key_temperature: float, key_intensity: float, intensity: float) -> vec3 {
    if on == 0 {
        return splat3(0.0)
    }
    depth = water_level - world_pos.y
    if depth <= 0.0 {
        return splat3(0.0)
    }
    uv = xz(world_pos) * scale
    t = time
    fringe = vec2(0.006, 0.004)
    red = caustic_web(uv + fringe, t, speed) + 0.5 * caustic_web(uv * 2.3 + fringe * 2.0 + splat2(11.0), t, speed)
    green = caustic_web(uv, t, speed) + 0.5 * caustic_web(uv * 2.3 + splat2(11.0), t, speed)
    blue = caustic_web(uv - fringe, t, speed) + 0.5 * caustic_web(uv * 2.3 - fringe * 2.0 + splat2(11.0), t, speed)
    web = vec3(red, green, blue)
    facing = clamp(norm.y, 0.0, 1.0)
    attenuation = exp(-depth / max(depth_fall, 0.001))
    key = key_colour * kelvin_to_rgb(key_temperature)
    return key * key_intensity * web * facing * attenuation * intensity
}

// The tangent frame from the derivatives of the position and the uv.
@quotable
cotangent_frame(normal: vec3, position: vec3, uv: vec2) -> Frame {
    dpx = dfdx_v3(position)
    dpy = dfdy_v3(position)
    duvx = dfdx_v2(uv)
    duvy = dfdy_v2(uv)
    perp_y = cross(dpy, normal)
    perp_x = cross(normal, dpx)
    tangent = perp_y * duvx.x + perp_x * duvy.x
    bitangent = perp_y * duvx.y + perp_x * duvy.y
    handed = if (dot(dpx, perp_y) < 0.0) { -1.0 } else { 1.0 }
    scale = handed * inversesqrt(max(dot(tangent, tangent), dot(bitangent, bitangent)))
    return Frame { tangent: tangent * scale, bitangent: bitangent * scale, normal: normal }
}

// The tiling broken up (#737): hex-tiling (Mikkelsen, JCGT 2022).
@quotable
hex_offset(cx: int, cy: int) -> vec2 {
    q = vec2(float_of(cx), float_of(cy))
    return fract_v2(sin_v2(vec2(dot_v2(q, vec2(127.1, 311.7)), dot_v2(q, vec2(269.5, 183.3)))) * 43758.5453)
}

@quotable
hex_rotation(cx: int, cy: int, strength: float) -> mat2 {
    angle0 = abs(float_of(cx * cy)) + abs(float_of(cx + cy)) + 3.14159265
    angle1 = mod(angle0, 6.28318531)
    angle2 = angle1
    if angle1 > 3.14159265 {
        angle2 = angle1 - 6.28318531
    }
    angle = angle2 * strength
    c = cos(angle)
    s = sin(angle)
    return mat2_of(c, -s, s, c)
}

@quotable
hex_setup(uv: vec2, rotation: float) -> Hex {
    dx = dfdx_v2(uv)
    dy = dfdy_v2(uv)
    skewed = mul_m2(mat2_of(1.0, -0.57735027, 0.0, 1.15470054), uv * 3.46410162)
    bx = int_of(floor(skewed.x))
    by = int_of(floor(skewed.y))
    t = fract_v2(skewed)
    tz = 1.0 - t.x - t.y
    s = step(0.0, -tz)
    s2 = 2.0 * s - 1.0
    weights = vec3(-tz * s2, s - t.y * s2, s - t.x * s2)
    si = int_of(s)
    c0x = bx + si
    c0y = by + si
    c1x = bx + si
    c1y = by + (1 - si)
    c2x = bx + (1 - si)
    c2y = by + si
    turn0 = hex_rotation(c0x, c0y, rotation)
    middle0 = mul_m2(mat2_of(1.0, 0.0, 0.5, 0.86602540), vec2(float_of(c0x), float_of(c0y))) / 3.46410162
    uv0 = mul_m2(turn0, uv - middle0) + middle0 + hex_offset(c0x, c0y)
    turn1 = hex_rotation(c1x, c1y, rotation)
    middle1 = mul_m2(mat2_of(1.0, 0.0, 0.5, 0.86602540), vec2(float_of(c1x), float_of(c1y))) / 3.46410162
    uv1 = mul_m2(turn1, uv - middle1) + middle1 + hex_offset(c1x, c1y)
    turn2 = hex_rotation(c2x, c2y, rotation)
    middle2 = mul_m2(mat2_of(1.0, 0.0, 0.5, 0.86602540), vec2(float_of(c2x), float_of(c2y))) / 3.46410162
    uv2 = mul_m2(turn2, uv - middle2) + middle2 + hex_offset(c2x, c2y)
    return Hex { uv0: uv0, uv1: uv1, uv2: uv2, turn0: turn0, turn1: turn1, turn2: turn2, dx: dx, dy: dy, weights: weights }
}

@quotable
hex_texture(tex: Texture, hx: Hex) -> HexColour {
    c0 = texture_grad(tex, hx.uv0, mul_m2(hx.turn0, hx.dx), mul_m2(hx.turn0, hx.dy))
    c1 = texture_grad(tex, hx.uv1, mul_m2(hx.turn1, hx.dx), mul_m2(hx.turn1, hx.dy))
    c2 = texture_grad(tex, hx.uv2, mul_m2(hx.turn2, hx.dx), mul_m2(hx.turn2, hx.dy))
    luma = vec3(0.299, 0.587, 0.114)
    bright = mix_v3(splat3(1.0), vec3(dot(rgb(c0), luma), dot(rgb(c1), luma), dot(rgb(c2), luma)), 0.6)
    w0 = bright * pow_v3(hx.weights, splat3(7.0))
    w = w0 / max(w0.x + w0.y + w0.z, 1e-6)
    return HexColour { colour: c0 * w.x + c1 * w.y + c2 * w.z, weights: w }
}

@quotable
hex_normal(normal_map: Texture, hx: Hex, weights: vec3) -> vec3 {
    s0 = xyz(texture_grad(normal_map, hx.uv0, mul_m2(hx.turn0, hx.dx), mul_m2(hx.turn0, hx.dy))) * 2.0 - splat3(1.0)
    t0 = mul_transpose_m2(hx.turn0, xy_v3(s0))
    n0 = splat3(0.0) + vec3_of_v2(t0, s0.z) * weights.x
    s1 = xyz(texture_grad(normal_map, hx.uv1, mul_m2(hx.turn1, hx.dx), mul_m2(hx.turn1, hx.dy))) * 2.0 - splat3(1.0)
    t1 = mul_transpose_m2(hx.turn1, xy_v3(s1))
    n1 = n0 + vec3_of_v2(t1, s1.z) * weights.y
    s2 = xyz(texture_grad(normal_map, hx.uv2, mul_m2(hx.turn2, hx.dx), mul_m2(hx.turn2, hx.dy))) * 2.0 - splat3(1.0)
    t2 = mul_transpose_m2(hx.turn2, xy_v3(s2))
    return n1 + vec3_of_v2(t2, s2.z) * weights.z
}

// Triplanar mapping (#737).
@quotable
tri_setup(n: vec3, position: vec3, metres: float) -> Tri {
    w = pow_v3(abs_v3(n), splat3(4.0))
    q = position / metres
    return Tri { weights: w / max(w.x + w.y + w.z, 1e-6), x: zy(q), y: xz(q), z: xy_v3(q) }
}

@quotable
tri_texture(tex: Texture, tri: Tri) -> vec4 {
    return texture(tex, tri.x) * tri.weights.x + texture(tex, tri.y) * tri.weights.y + texture(tex, tri.z) * tri.weights.z
}

@quotable
toksvig(len: float, strength: float) -> float {
    l = clamp(len, 0.001, 1.0)
    return min((1.0 - l) / l * strength * strength, 1.0)
}

@quotable
tri_normal(n: vec3, strength: float, tri: Tri, normal_map: Texture) -> MappedNormal {
    tx0 = xyz(texture(normal_map, tri.x)) * 2.0 - splat3(1.0)
    ty0 = xyz(texture(normal_map, tri.y)) * 2.0 - splat3(1.0)
    tz0 = xyz(texture(normal_map, tri.z)) * 2.0 - splat3(1.0)
    variance = toksvig(length_v3(tx0) * tri.weights.x + length_v3(ty0) * tri.weights.y + length_v3(tz0) * tri.weights.z,
                       strength)
    txy = xy_v3(tx0) * strength
    tyy = xy_v3(ty0) * strength
    tzy = xy_v3(tz0) * strength
    tx = vec3_of_v2(txy + zy(n), abs(tx0.z) * n.x)
    ty = vec3_of_v2(tyy + xz(n), abs(ty0.z) * n.y)
    tz = vec3_of_v2(tzy + xy_v3(n), abs(tz0.z) * n.z)
    return MappedNormal { normal: normalize(zyx(tx) * tri.weights.x + xzy(ty) * tri.weights.y + tz * tri.weights.z),
                          variance: variance }
}

@quotable
mapped_normal(normal: vec3, position: vec3, uv: vec2, strength_global: float, strength_material: float, tri_on: int, tri: Tri,
              hex_on: int, hx: Hex, weights: vec3, detail_weight: float, detail_scale: float, normal_map: Texture) -> MappedNormal {
    strength = strength_global * strength_material
    if tri_on != 0 {
        return tri_normal(normal, strength, tri, normal_map)
    }
    sampled0 = if (hex_on != 0) { hex_normal(normal_map, hx, weights) } else { xyz(texture(normal_map, uv)) * 2.0 - splat3(1.0) }
    variance = toksvig(length_v3(sampled0), strength)
    sampled1 = sampled0
    if detail_weight > 0.0 {
        fine = xyz(texture(normal_map, uv * detail_scale)) * 2.0 - splat3(1.0)
        sampled1 = vec3_of_v2(xy_v3(sampled0) + xy_v3(fine) * detail_weight, sampled0.z)
    }
    sxy = xy_v3(sampled1) * strength
    sampled = vec3_of_v2(sxy, sampled1.z)
    fr = cotangent_frame(normal, position, uv)
    return MappedNormal { normal: normalize(mul_cols3(fr.tangent, fr.bitangent, fr.normal, sampled)), variance: variance }
}

// One light's contribution, and its back fill.
@quotable
direct_light(l: WorldLight, norm: vec3, view_dir: vec3, albedo: vec3, f0: vec3, ndotv: float, adjusted_roughness: float,
             wet_mirror: float, frag_pos: vec3, metallic: float, reflectivity: float, roughness: float, clearcoat_on: int,
             clearcoat_roughness: float, clearcoat_intensity: float, sheen_on: int, sheen_roughness: float,
             sheen_colour: vec3, transmission_on: int, transmission_factor: float, multiple_on: int,
             conservation_on: int) -> DirectLight {
    adjusted_colour = l.colour * kelvin_to_rgb(l.temperature)
    light_dir = splat3(0.0)
    attenuation = 1.0
    if l.kind == 1 {
        light_dir = normalize(l.direction)
    } else {
        light_vec = l.position - frag_pos
        dist = length_v3(light_vec)
        light_dir = light_vec / dist
        attenuation = 1.0 / (l.constant + l.linear * dist + l.quadratic * dist * dist)
        if l.kind == 2 {
            on_axis = dot(-light_dir, normalize(l.direction))
            attenuation = attenuation * smoothstep(l.cos_outer, l.cos_inner, on_axis)
        }
    }
    halfway = normalize(light_dir + view_dir)
    radiance = adjusted_colour * l.intensity * attenuation
    ndotl_raw = dot(norm, light_dir)
    hdotv = clamp(dot(halfway, view_dir), 0.001, 1.0)
    ndotl = max(ndotl_raw, 0.0)
    ndf = distribution_ggx(norm, halfway, adjusted_roughness)
    g = geometry_smith(norm, view_dir, light_dir, adjusted_roughness)
    f = fresnel_schlick(hdotv, f0)
    ks = f
    kd0 = splat3(1.0) - ks
    kd = kd0 * (1.0 - metallic)
    numerator = f * (ndf * g)
    denominator = 4.0 * ndotv * ndotl + 0.0001
    specular0 = numerator / denominator
    view_attenuation = pow(ndotv, 0.6)
    mirror = max(reflectivity, wet_mirror)
    specular1 = specular0
    if mirror > 0.001 {
        grazing = 1.0 - ndotv
        specular1 = specular0 * (mirror * (0.5 + grazing * grazing * 4.0))
    } else {
        specular1 = specular0 * (view_attenuation * 0.5)
    }
    clearcoat = calculate_clearcoat(norm, view_dir, light_dir, halfway, albedo, clearcoat_on, clearcoat_roughness,
                                    clearcoat_intensity)
    sheen = calculate_sheen(norm, view_dir, light_dir, halfway, sheen_on, sheen_roughness, sheen_colour)
    transmission = calculate_transmission(norm, view_dir, light_dir, albedo, transmission_on, transmission_factor)
    specular = compensate_energy_loss(specular1, ndotv, roughness, multiple_on)
    hemisphere = max(ndotl_raw, 0.0)
    fill = max(-ndotl_raw * 0.3, 0.0)
    back_fill = adjusted_colour * fill * albedo * 0.2 * attenuation
    lit = apply_energy_conservation(kd * albedo / 3.14159265359 * radiance * hemisphere, specular * radiance * hemisphere,
                                    clearcoat * radiance * hemisphere, sheen * radiance * hemisphere, conservation_on) +
          transmission
    return DirectLight { lit: lit, back_fill: back_fill }
}

// Where this pixel's surface was last frame, in texture space.
@quotable
velocity(now: vec4, prev: vec4, nudge: vec2) -> vec2 {
    if now.w <= 0.0 || prev.w <= 0.0 {
        return splat2(0.0)
    }
    uv_now = xy(now) / now.w * 0.5 + splat2(0.5) - nudge
    uv_prev = xy(prev) / prev.w * 0.5 + splat2(0.5)
    return uv_now - uv_prev
}

// The model's cut (#545).
@quotable
clip_hash(p_in: vec3) -> float {
    p0 = fract_v3(p_in * 0.3183099 + vec3(0.71, 0.113, 0.419))
    p = p0 * 17.0
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z))
}

@quotable
clip_value_noise(p: vec3) -> float {
    i = floor_v3(p)
    f0 = fract_v3(p)
    f = f0 * f0 * (splat3(3.0) - f0 * 2.0)
    return mix(mix(mix(clip_hash(i + vec3(0.0, 0.0, 0.0)), clip_hash(i + vec3(1.0, 0.0, 0.0)), f.x),
                   mix(clip_hash(i + vec3(0.0, 1.0, 0.0)), clip_hash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
               mix(mix(clip_hash(i + vec3(0.0, 0.0, 1.0)), clip_hash(i + vec3(1.0, 0.0, 1.0)), f.x),
                   mix(clip_hash(i + vec3(0.0, 1.0, 1.0)), clip_hash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y), f.z)
}

@quotable
clipped_away(bind_pos: vec3, on: int, limb: float, detached: int, plane: vec4, noise: float, noise_scale: float) -> bool {
    if on == 0 {
        return false
    }
    on_limb = limb >= 0.5
    if detached != 0 && !on_limb {
        return true
    }
    if !on_limb {
        return false
    }
    side0 = dot(xyz(plane), bind_pos) - plane.w
    side = side0
    if noise > 0.0 {
        side = side0 + noise * (clip_value_noise(bind_pos * noise_scale) * 2.0 - 1.0)
    }
    return side > 0.0
}

// Wounds (#543) and splats (#546).
@quotable
wound_unturn(q: vec4, v: vec3) -> vec3 {
    u = -xyz(q)
    t = cross(u, v) * 2.0
    return v + t * q.w + cross(u, t)
}

@quotable
wound_depth(p: vec3, count: int, data: vec4[96]) -> float {
    best = 2.0
    for (i = 0; i < 32; i++) {
        if i >= count {
            break
        }
        if data[i * 3].w > 0.5 {
            continue
        }
        r = max_v3(xyz(data[i * 3 + 1]), splat3(0.0001))
        local = wound_unturn(data[i * 3 + 2], p - xyz(data[i * 3])) / r
        best = min(best, length_v3(local))
    }
    return best
}

@quotable
splat_cover(p: vec3, count: int, data: vec4[96]) -> float {
    most = 0.0
    for (i = 0; i < 32; i++) {
        if i >= count {
            break
        }
        if data[i * 3].w < 0.5 {
            continue
        }
        r = max_v3(xyz(data[i * 3 + 1]), splat3(0.0001))
        local = wound_unturn(data[i * 3 + 2], p - xyz(data[i * 3])) / r
        edge = 1.0 + 0.35 * (clip_value_noise(local * 3.0 + xyz(data[i * 3]) * 7.0) * 2.0 - 1.0)
        cover = data[i * 3 + 1].w * (1.0 - smoothstep(0.8 * edge, edge, length_v3(local)))
        most = max(most, cover)
    }
    return most
}

// The screen's occlusion at this surface, from the last frame's.
@quotable
screen_occlusion(history: int, clip_prev: vec4, occlusion_map: Texture) -> float {
    if history == 0 || clip_prev.w <= 0.0 {
        return 1.0
    }
    uv = xy(clip_prev) / clip_prev.w * 0.5 + splat2(0.5)
    if uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 {
        return 1.0
    }
    found = xy(texture(occlusion_map, uv))
    if abs(found.y - clip_prev.w) > 0.05 * clip_prev.w {
        return 1.0
    }
    return found.x
}

// The octahedral sky map (ae3d.skylight's arithmetic).
@quotable
oct_encode(d_in: vec3) -> vec2 {
    d = d_in / (abs(d_in.x) + abs(d_in.y) + abs(d_in.z))
    p = xz(d)
    if d.y < 0.0 {
        p = (splat2(1.0) - abs_v2(yx(p))) * vec2(if (p.x >= 0.0) { 1.0 } else { -1.0 }, if (p.y >= 0.0) { 1.0 } else { -1.0 })
    }
    return p
}

@quotable
oct_uv(d: vec3, size: float) -> vec2 {
    return ((oct_encode(d) * 0.5 + splat2(0.5)) * (size - 2.0) + splat2(1.0)) / size
}

@quotable
sky_irradiance(n: vec3, sky_irradiance_map: Texture) -> vec3 {
    return rgb(texture(sky_irradiance_map, oct_uv(n, 16.0)))
}

@quotable
sky_reflection(r: vec3, rough: float, sky_light_map: Texture) -> vec3 {
    level = clamp(rough, 0.0, 1.0) * (6.0 - 1.0)
    return rgb(texture_lod(sky_light_map, oct_uv(r, 256.0), level))
}

@quotable
sky_lit(n: vec3, v: vec3, albedo: vec3, f0: vec3, rough: float, metal: float, ndotv: float, gi_off: int, ibl: int,
          ibl_intensity: float, sky_irradiance_map: Texture, sky_light_map: Texture, brdf_lut: Texture) -> vec3 {
    if gi_off != 0 {
        return splat3(0.0)
    }
    f = f0 + (max_v3(splat3(1.0 - rough), f0) - f0) * pow(1.0 - ndotv, 5.0)
    kd = (splat3(1.0) - f) * (1.0 - metal)
    irradiance = sky_irradiance(n, sky_irradiance_map)
    diffuse = kd * albedo * irradiance / 3.14159265
    if ibl == 0 {
        return diffuse
    }
    ab = xy(texture(brdf_lut, vec2(ndotv, rough)))
    specular = sky_reflection(reflect(-v, n), rough, sky_light_map) * (f0 * ab.x + splat3(ab.y))
    return diffuse + specular * ibl_intensity
}

// ── The pixel shader ───────────────────────────────────────────────────

// The surface lit: FRAGMENT_DEFAULT's main, in its order.
//
//   colour_map        the draw's colour (the scene set's binding 1 it was)
//   normal_map        its normal map (3)
//   scene_depth       the camera's depth, for a soft particle (4)
//   damage_mask       its damage mask (9)
//   shadow_map        the cascades' atlas (the camera set's)
//   cluster_lights    the clustered lamps and their shadows' slots
//   cluster_words     the cells' lists
//   lamp_shadow_map   the lamps' atlas
//   occlusion_map     the screen's occlusion, last frame's
//   sky_light         the sky's light, prefiltered (the world set's)
//   brdf_lut          the split-sum table
//   sky_irradiance    the sky's irradiance
lit_pixel(draw: Draw, material: DrawMaterial, shading: Surface, cut: Cut, wounds: Wounds, damage: Damage, eye: Eye,
          cascades: ShadowCascades, grid: Grid, world: WorldState, weather: Weather, colour_map: Texture, normal_map: Texture,
          scene_depth: Texture, damage_mask: Texture, shadow_map: Texture, cluster_lights: Vec4s, cluster_words: Floats,
          lamp_shadow_map: Texture, occlusion_map: Texture, sky_light: Texture, brdf_lut: Texture,
          sky_irradiance: Texture) -> *GpuShader {
    s = gpu.fragment("lit") quote | f: LitVaryings | {
        // A cut model's far side, not drawn (#545); a wound's core a hole (#543).
        if clipped_away(f.BindPos, cut.on, f.ClipLimb, cut.detached, cut.plane, cut.noise, cut.noise_scale) {
            discard()
        }
        wound_at = if (wounds.count > 0) { wound_depth(f.BindPos, wounds.count, wounds.data) } else { 2.0 }
        if wound_at < wounds.core {
            discard()
        }
        moved = velocity(f.ClipNow, f.ClipPrev, eye.jitter)

        tri_on = 0
        hex_on = 0
        tri = Tri { weights: vec3(0.0, 1.0, 0.0), x: splat2(0.0), y: splat2(0.0), z: splat2(0.0) }
        hx = Hex { uv0: splat2(0.0), uv1: splat2(0.0), uv2: splat2(0.0), turn0: mat2_of(1.0, 0.0, 0.0, 1.0),
                   turn1: mat2_of(1.0, 0.0, 0.0, 1.0), turn2: mat2_of(1.0, 0.0, 0.0, 1.0), dx: splat2(0.0),
                   dy: splat2(0.0), weights: vec3(1.0, 0.0, 0.0) }
        hex_weights = vec3(1.0, 0.0, 0.0)
        tex_colour = splat4(0.0)
        if material.triplanar > 0.0 {
            tri = tri_setup(normalize(f.Normal), f.FragPos, material.triplanar)
            tri_on = 1
            tex_colour = tri_texture(colour_map, tri)
        } else if material.tile_breakup > 0.0 {
            hx = hex_setup(f.fragTexCoord, material.tile_rotation)
            hex_on = 1
            hc = hex_texture(colour_map, hx)
            tex_colour = hc.colour
            hex_weights = hc.weights
        } else {
            tex_colour = texture(colour_map, f.fragTexCoord)
            if f.FlipNext.z >= 0.0 {
                tex_colour = mix_v4(tex_colour, texture(colour_map, xy_v3(f.FlipNext)), f.FlipNext.z)
            }
        }
        if tex_colour.w < material.cutout {
            discard()
        }
        detail_weight = 0.0
        if material.detail_scale > 0.0 && tri_on == 0 {
            away = length_v3(f.FragPos - eye.position)
            detail_weight = material.detail_strength * (1.0 - smoothstep(material.detail_fade * 0.5, material.detail_fade, away))
        }

        // Fire (#738) and the emissive: their own light.
        if material.fire > 0.0 {
            heat = clamp(tex_colour.x * f.InstanceColor.x, 0.0, 1.0)
            glowing = black_body(heat * material.fire) * (heat * heat * heat * heat) * max(material.exposure * 0.1, 1.0)
            return LitOut { colour: vec4(glowing * material.diffuse,
                                         tex_colour.w * material.alpha * f.ParticleAlpha *
                                         soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth,
                                                   eye.inv_view_projection, eye.position, f.FragPos)),
                            velocity: moved }
        }
        if material.exposure > 10.0 {
            glow_alpha = if (material.blend != 0) {
                tex_colour.w * material.alpha * f.ParticleAlpha *
                soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth, eye.inv_view_projection, eye.position,
                          f.FragPos)
            } else { 1.0 }
            return LitOut { colour: vec4(material.diffuse * rgb(tex_colour) * f.InstanceColor * (material.exposure * 0.1),
                                         glow_alpha),
                            velocity: moved }
        }

        norm = normalize(f.Normal)
        normal_variance = 0.0
        if draw.impostor != 0 {
            // The picture's normal, baked in the figure's frame, turned into
            // the world by the facing the vertex carried.
            if tex_colour.w < 0.5 {
                discard()
            }
            facing = normalize(f.Normal)
            baked = xyz(texture(normal_map, f.fragTexCoord)) * 2.0 - splat3(1.0)
            norm = normalize(facing * baked.x + vec3(0.0, baked.y, 0.0) + vec3(-facing.z, 0.0, facing.x) * baked.z)
        } else if material.normal_map != 0 {
            mn = mapped_normal(norm, f.FragPos, f.fragTexCoord, world.normal_strength, material.normal_strength, tri_on, tri,
                               hex_on, hx, hex_weights, detail_weight, material.detail_scale, normal_map)
            norm = mn.normal
            normal_variance = mn.variance
        }
        if eye.capture == 1 {
            return LitOut { colour: vec4(material.diffuse * rgb(tex_colour) * f.InstanceColor, tex_colour.w), velocity: moved }
        }
        if eye.capture == 2 {
            return LitOut { colour: vec4(norm * 0.5 + splat3(0.5), 1.0), velocity: moved }
        }
        if eye.capture == 3 {
            shown = moved * eye.screen_size / 200.0 + splat2(0.5)
            return LitOut { colour: vec4(vec3(shown.x, shown.y, 0.0), 1.0), velocity: moved }
        }
        view_dir = normalize(eye.position - f.FragPos)

        albedo0 = material.diffuse * rgb(tex_colour) * f.InstanceColor
        albedo1 = albedo0
        // Blood splashed on the skin (#546), and the damage the mask kept (#544).
        if wounds.count > 0 {
            albedo1 = mix_v3(albedo0, rgb(wounds.layers[0]), splat_cover(f.BindPos, wounds.count, wounds.data))
        }
        mask_at = xy(damage.rect) + clamp_v2(f.MaskUV, splat2(damage.clamp), splat2(1.0 - damage.clamp)) * vec2(damage.rect.z, damage.rect.w)
        damaged = texture(damage_mask, mask_at)
        albedo2 = albedo1
        if damage.on != 0 {
            for (k = 0; k < 4; k++) {
                albedo2 = mix_v3(albedo2, rgb(damage.colours[k]), clamp(lane_at(damaged, k) * damage.colours[k].w, 0.0, 1.0))
            }
        }
        albedo3 = albedo2
        if wound_at < 1.0 {
            layer = rgb(wounds.layers[0])
            for (j = 1; j < 4; j++) {
                if wound_at < wounds.layers[j].w {
                    layer = rgb(wounds.layers[j])
                }
            }
            albedo3 = mix_v3(albedo2, layer, smoothstep(1.0, 0.94, wound_at))
        }
        // The detail layer's colour, as a ratio to the texture's own mean.
        albedo4 = albedo3
        if detail_weight > 0.0 {
            fine = rgb(texture(colour_map, f.fragTexCoord * material.detail_scale))
            mean = max_v3(rgb(texture_lod(colour_map, f.fragTexCoord, 16.0)), splat3(0.02))
            albedo4 = albedo3 * mix_v3(splat3(1.0), clamp_v3(fine / mean, splat3(0.0), splat3(2.0)), detail_weight)
        }
        // Patches over the world.
        albedo5 = albedo4
        if material.variation > 0.0 {
            cell = f.FragPos / max(material.variation_scale, 0.01)
            v0 = clip_value_noise(cell) * 0.65 + clip_value_noise(cell * 2.7 + vec3(13.1, 7.3, 2.9)) * 0.35
            v1 = smoothstep(0.25, 0.75, v0)
            albedo5 = albedo4 * (1.0 + (v1 * 2.0 - 1.0) * material.variation)
        }
        // GPU Gems chapter 5's noise over the shading.
        albedo6 = albedo5
        if shading.perlin != 0 {
            noise_coord = f.FragPos * shading.noise_scale
            noise_value = turbulence(noise_coord, shading.noise_octaves)
            albedo6 = mix_v3(albedo5, albedo5 * (1.0 + noise_value * 0.3), shading.noise_intensity)
        }

        f0a = splat3(0.04) * material.specular
        f0 = f0a
        if material.metallic > 0.5 {
            metal_f0 = albedo6
            if albedo6.x > albedo6.y && albedo6.x > albedo6.z {
                metal_f0 = mix_v3(vec3(0.95, 0.64, 0.54), albedo6, 0.7)
            } else if albedo6.y > albedo6.x && albedo6.y > albedo6.z {
                metal_f0 = mix_v3(vec3(0.70, 0.78, 0.74), albedo6, 0.7)
            } else if albedo6.z > albedo6.x && albedo6.z > albedo6.y {
                metal_f0 = mix_v3(vec3(0.66, 0.73, 0.80), albedo6, 0.7)
            } else {
                metal_f0 = mix_v3(vec3(0.95, 0.93, 0.88), albedo6, 0.7)
            }
            f0 = mix_v3(f0a, metal_f0, material.metallic)
        } else {
            f0 = mix_v3(f0a, albedo6, material.metallic)
        }

        ndotv = clamp(dot(norm, view_dir), 0.001, 1.0)
        adjusted0 = max(sqrt(material.roughness * material.roughness + normal_variance), 0.08)
        adjusted = adjusted0
        wet0 = world.wetness * clamp(norm.y, 0.0, 1.0)
        wet = wet0 * wet0
        wet_mirror = 0.0
        albedo = albedo6
        if wet > 0.001 {
            albedo = albedo6 * (1.0 - 0.35 * wet)
            adjusted = max(mix(adjusted0, 0.05, wet), 0.08)
            wet_mirror = wet * 0.7
        } else {
            wet_mirror = 0.0
        }

        // The lights that reach everywhere, then the lamps of this cell.
        shaded0 = 1.0
        if cascades.on != 0 && shading.shadows != 0 {
            shaded0 = shadow_factor(f.Normal, world.shadow_direction, eye.depth_plane, f.FragPos, cascades.count,
                                    cascades.splits, shading.shadow_intensity, cascades.matrices, cascades.texel_world,
                                    shadow_map, shading.shadow_softness)
        }
        shaded = shaded0
        if grid.key_lamp >= 0 && grid.lamp_base >= 0 && shading.shadows != 0 {
            shaded = lamp_shadow(grid.key_lamp, normalize(f.Normal), grid.lamp_base, cluster_lights, f.FragPos,
                                 lamp_shadow_map, shading.shadow_softness, shading.shadow_intensity)
        }
        sunlit = cloud_shadow(f.FragPos, world.cloud_cover, world.cloud_sun, world.cloud_time)
        lo = splat3(0.0)
        for (i = 0; i < 16; i++) {
            if i >= world.light_count {
                break
            }
            if world.lights[i].kind != 1 {
                gap = world.lights[i].position - f.FragPos
                if dot(gap, gap) * world.lights[i].quadratic > 64.0 {
                    continue
                }
                if world.lights[i].kind == 2 &&
                   dot(normalize(-gap), normalize(world.lights[i].direction)) < world.lights[i].cos_outer {
                    continue
                }
            }
            dl = direct_light(world.lights[i], norm, view_dir, albedo, f0, ndotv, adjusted, wet_mirror, f.FragPos,
                              material.metallic, material.reflectivity, material.roughness, shading.clearcoat,
                              shading.clearcoat_roughness, shading.clearcoat_intensity, shading.sheen,
                              shading.sheen_roughness, shading.sheen_colour, shading.transmission,
                              shading.transmission_factor, shading.multiple_scattering, shading.energy_conservation)
            lo = lo + (if (i == 0) { dl.lit * sunlit * shaded } else { dl.lit }) + dl.back_fill
        }
        if material.glitter > 0.0 && world.light_count > 0 && world.lights[0].kind == 1 {
            lo = lo + glitter(norm, view_dir, world.lights[0], f.FragPos, material.glitter_grains, material.glitter,
                              material.glitter_strength) * sunlit * shaded
        }
        if grid.dims.w > 0.5 {
            cell_at = cluster_of(f.FragPos, grid.view_projection, eye.depth_plane, grid.dims, grid.depth)
            first = int_of(floats_at_i(cluster_words, cell_at * 2) + 0.5)
            count = int_of(floats_at_i(cluster_words, cell_at * 2 + 1) + 0.5)
            for (k2 = 0; k2 < count; k2++) {
                cl = clustered_light(cluster_lights, int_of(floats_at_i(cluster_words, first + k2) + 0.5))
                lamp = cl.light
                lgap = lamp.position - f.FragPos
                far2 = dot(lgap, lgap)
                if far2 >= cl.reach * cl.reach {
                    continue
                }
                if lamp.kind == 2 && dot(normalize(-lgap), normalize(lamp.direction)) < lamp.cos_outer {
                    continue
                }
                fade_out = 1.0 - smoothstep(0.75 * cl.reach, cl.reach, sqrt(far2))
                ldl = direct_light(lamp, norm, view_dir, albedo, f0, ndotv, adjusted, wet_mirror, f.FragPos,
                                   material.metallic, material.reflectivity, material.roughness, shading.clearcoat,
                                   shading.clearcoat_roughness, shading.clearcoat_intensity, shading.sheen,
                                   shading.sheen_roughness, shading.sheen_colour, shading.transmission,
                                   shading.transmission_factor, shading.multiple_scattering, shading.energy_conservation)
                lit = ldl.lit * fade_out
                lo = lo + ldl.back_fill * fade_out
                shade = 1.0
                if cl.slot >= 0 && grid.lamp_base >= 0 && shading.shadows != 0 && dot(lit, splat3(0.333)) > 0.002 {
                    shade = lamp_shadow(cl.slot, normalize(f.Normal), grid.lamp_base, cluster_lights, f.FragPos,
                                        lamp_shadow_map, shading.shadow_softness, shading.shadow_intensity)
                }
                lo = lo + lit * shade
            }
        }

        // The sky's light, scaled by what of the sky the point sees.
        shut = mix(1.0, f.Occlusion, world.occlusion_strength) * screen_occlusion(eye.history, f.ClipPrev, occlusion_map)
        colour0 = sky_lit(norm, view_dir, albedo, f0, adjusted, material.metallic, ndotv, world.gi_off, shading.ibl,
                            shading.ibl_intensity, sky_irradiance, sky_light, brdf_lut) * shut + lo

        distance_to_camera = length_v3(f.FragPos - eye.position)
        volumetric = calculate_volumetric_lighting(f.FragPos, world.lights[0].position, eye.position, shading.volumetric,
                                                   shading.volumetric_steps, world.lights[0].colour,
                                                   world.lights[0].temperature, shading.volumetric_scattering,
                                                   shading.volumetric_intensity)
        colour1 = colour0 + volumetric
        colour2 = colour1 + caustic_light(f.FragPos, norm, shading.caustics, shading.caustics_water_level, shading.caustics_scale,
                                          world.time, shading.caustics_speed, shading.caustics_depth,
                                          world.lights[0].colour, world.lights[0].temperature, world.lights[0].intensity,
                                          shading.caustics_intensity) * albedo
        colour3 = colour2 * material.exposure
        colour4 = colour3
        if material.embers > 0.0 {
            colour4 = colour3 + ember_light(f.FragPos, world.time, material.ember_cover, material.embers, material.ember_glow)
        }
        // The air between the eye and the shading.
        colour = colour4
        if weather.fog != 0 {
            haze = smoothstep(weather.fog_start, weather.fog_end, distance_to_camera) * weather.fog_intensity
            colour = mix_v3(colour4, weather.fog_radiance, clamp(haze, 0.0, 1.0))
        }

        final0 = tex_colour.w * material.alpha
        final1 = final0
        if material.alpha >= 0.99 {
            final1 = 1.0
        }
        final_alpha = final1
        if material.blend != 0 {
            final_alpha = tex_colour.w * material.alpha * f.ParticleAlpha *
                          soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth, eye.inv_view_projection,
                                    eye.position, f.FragPos)
        }
        return LitOut { colour: vec4(colour, final_alpha), velocity: moved }
    }
    place(s)
    hand_on(s)
    return s
}

// The pixel shader that traces rays: lit_pixel and the rays (see the section
// above). It is lit_pixel's body and nothing else changes: where the rays are
// off (world.rays 0, or past the eye's reach) and the probes are off
// (probes.on 0) it shades as lit_pixel does, which tests/test_gpu_lit_rq holds
// it to on the CPU, where no ray finds anything. What it reads beyond
// lit_pixel's:
//
//   probes            the probes round the eye (the camera's block)
//   scene             the scene's acceleration structure (the world's set, 4)
//   ddgi_irradiance   the probes' irradiance atlas (the camera's set, 6)
//   ddgi_distance     their distance moments (7)
//   ddgi_state        their state, two vec4s a probe (8, a storage buffer)
lit_rq_pixel(draw: Draw, material: DrawMaterial, shading: Surface, cut: Cut, wounds: Wounds, damage: Damage, eye: Eye,
          cascades: ShadowCascades, grid: Grid, probes: Probes, world: WorldState, weather: Weather, colour_map: Texture, normal_map: Texture,
          scene_depth: Texture, damage_mask: Texture, shadow_map: Texture, cluster_lights: Vec4s, cluster_words: Floats,
          lamp_shadow_map: Texture, occlusion_map: Texture, sky_light: Texture, brdf_lut: Texture,
          sky_irradiance: Texture, scene: AccelerationStructure, ddgi_irradiance: Texture, ddgi_distance: Texture,
          ddgi_state: Vec4s) -> *GpuShader {
    s = gpu.fragment("lit_rq") quote | f: LitVaryings | {
        // A cut model's far side, not drawn (#545); a wound's core a hole (#543).
        if clipped_away(f.BindPos, cut.on, f.ClipLimb, cut.detached, cut.plane, cut.noise, cut.noise_scale) {
            discard()
        }
        wound_at = if (wounds.count > 0) { wound_depth(f.BindPos, wounds.count, wounds.data) } else { 2.0 }
        if wound_at < wounds.core {
            discard()
        }
        moved = velocity(f.ClipNow, f.ClipPrev, eye.jitter)

        tri_on = 0
        hex_on = 0
        tri = Tri { weights: vec3(0.0, 1.0, 0.0), x: splat2(0.0), y: splat2(0.0), z: splat2(0.0) }
        hx = Hex { uv0: splat2(0.0), uv1: splat2(0.0), uv2: splat2(0.0), turn0: mat2_of(1.0, 0.0, 0.0, 1.0),
                   turn1: mat2_of(1.0, 0.0, 0.0, 1.0), turn2: mat2_of(1.0, 0.0, 0.0, 1.0), dx: splat2(0.0),
                   dy: splat2(0.0), weights: vec3(1.0, 0.0, 0.0) }
        hex_weights = vec3(1.0, 0.0, 0.0)
        tex_colour = splat4(0.0)
        if material.triplanar > 0.0 {
            tri = tri_setup(normalize(f.Normal), f.FragPos, material.triplanar)
            tri_on = 1
            tex_colour = tri_texture(colour_map, tri)
        } else if material.tile_breakup > 0.0 {
            hx = hex_setup(f.fragTexCoord, material.tile_rotation)
            hex_on = 1
            hc = hex_texture(colour_map, hx)
            tex_colour = hc.colour
            hex_weights = hc.weights
        } else {
            tex_colour = texture(colour_map, f.fragTexCoord)
            if f.FlipNext.z >= 0.0 {
                tex_colour = mix_v4(tex_colour, texture(colour_map, xy_v3(f.FlipNext)), f.FlipNext.z)
            }
        }
        if tex_colour.w < material.cutout {
            discard()
        }
        detail_weight = 0.0
        if material.detail_scale > 0.0 && tri_on == 0 {
            away = length_v3(f.FragPos - eye.position)
            detail_weight = material.detail_strength * (1.0 - smoothstep(material.detail_fade * 0.5, material.detail_fade, away))
        }

        // Fire (#738) and the emissive: their own light.
        if material.fire > 0.0 {
            heat = clamp(tex_colour.x * f.InstanceColor.x, 0.0, 1.0)
            glowing = black_body(heat * material.fire) * (heat * heat * heat * heat) * max(material.exposure * 0.1, 1.0)
            return LitOut { colour: vec4(glowing * material.diffuse,
                                         tex_colour.w * material.alpha * f.ParticleAlpha *
                                         soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth,
                                                   eye.inv_view_projection, eye.position, f.FragPos)),
                            velocity: moved }
        }
        if material.exposure > 10.0 {
            glow_alpha = if (material.blend != 0) {
                tex_colour.w * material.alpha * f.ParticleAlpha *
                soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth, eye.inv_view_projection, eye.position,
                          f.FragPos)
            } else { 1.0 }
            return LitOut { colour: vec4(material.diffuse * rgb(tex_colour) * f.InstanceColor * (material.exposure * 0.1),
                                         glow_alpha),
                            velocity: moved }
        }

        norm = normalize(f.Normal)
        normal_variance = 0.0
        if draw.impostor != 0 {
            // The picture's normal, baked in the figure's frame, turned into
            // the world by the facing the vertex carried.
            if tex_colour.w < 0.5 {
                discard()
            }
            facing = normalize(f.Normal)
            baked = xyz(texture(normal_map, f.fragTexCoord)) * 2.0 - splat3(1.0)
            norm = normalize(facing * baked.x + vec3(0.0, baked.y, 0.0) + vec3(-facing.z, 0.0, facing.x) * baked.z)
        } else if material.normal_map != 0 {
            mn = mapped_normal(norm, f.FragPos, f.fragTexCoord, world.normal_strength, material.normal_strength, tri_on, tri,
                               hex_on, hx, hex_weights, detail_weight, material.detail_scale, normal_map)
            norm = mn.normal
            normal_variance = mn.variance
        }
        if eye.capture == 1 {
            return LitOut { colour: vec4(material.diffuse * rgb(tex_colour) * f.InstanceColor, tex_colour.w), velocity: moved }
        }
        if eye.capture == 2 {
            return LitOut { colour: vec4(norm * 0.5 + splat3(0.5), 1.0), velocity: moved }
        }
        if eye.capture == 3 {
            shown = moved * eye.screen_size / 200.0 + splat2(0.5)
            return LitOut { colour: vec4(vec3(shown.x, shown.y, 0.0), 1.0), velocity: moved }
        }
        view_dir = normalize(eye.position - f.FragPos)

        albedo0 = material.diffuse * rgb(tex_colour) * f.InstanceColor
        albedo1 = albedo0
        // Blood splashed on the skin (#546), and the damage the mask kept (#544).
        if wounds.count > 0 {
            albedo1 = mix_v3(albedo0, rgb(wounds.layers[0]), splat_cover(f.BindPos, wounds.count, wounds.data))
        }
        mask_at = xy(damage.rect) + clamp_v2(f.MaskUV, splat2(damage.clamp), splat2(1.0 - damage.clamp)) * vec2(damage.rect.z, damage.rect.w)
        damaged = texture(damage_mask, mask_at)
        albedo2 = albedo1
        if damage.on != 0 {
            for (k = 0; k < 4; k++) {
                albedo2 = mix_v3(albedo2, rgb(damage.colours[k]), clamp(lane_at(damaged, k) * damage.colours[k].w, 0.0, 1.0))
            }
        }
        albedo3 = albedo2
        if wound_at < 1.0 {
            layer = rgb(wounds.layers[0])
            for (j = 1; j < 4; j++) {
                if wound_at < wounds.layers[j].w {
                    layer = rgb(wounds.layers[j])
                }
            }
            albedo3 = mix_v3(albedo2, layer, smoothstep(1.0, 0.94, wound_at))
        }
        // The detail layer's colour, as a ratio to the texture's own mean.
        albedo4 = albedo3
        if detail_weight > 0.0 {
            fine = rgb(texture(colour_map, f.fragTexCoord * material.detail_scale))
            mean = max_v3(rgb(texture_lod(colour_map, f.fragTexCoord, 16.0)), splat3(0.02))
            albedo4 = albedo3 * mix_v3(splat3(1.0), clamp_v3(fine / mean, splat3(0.0), splat3(2.0)), detail_weight)
        }
        // Patches over the world.
        albedo5 = albedo4
        if material.variation > 0.0 {
            cell = f.FragPos / max(material.variation_scale, 0.01)
            v0 = clip_value_noise(cell) * 0.65 + clip_value_noise(cell * 2.7 + vec3(13.1, 7.3, 2.9)) * 0.35
            v1 = smoothstep(0.25, 0.75, v0)
            albedo5 = albedo4 * (1.0 + (v1 * 2.0 - 1.0) * material.variation)
        }
        // GPU Gems chapter 5's noise over the shading.
        albedo6 = albedo5
        if shading.perlin != 0 {
            noise_coord = f.FragPos * shading.noise_scale
            noise_value = turbulence(noise_coord, shading.noise_octaves)
            albedo6 = mix_v3(albedo5, albedo5 * (1.0 + noise_value * 0.3), shading.noise_intensity)
        }

        f0a = splat3(0.04) * material.specular
        f0 = f0a
        if material.metallic > 0.5 {
            metal_f0 = albedo6
            if albedo6.x > albedo6.y && albedo6.x > albedo6.z {
                metal_f0 = mix_v3(vec3(0.95, 0.64, 0.54), albedo6, 0.7)
            } else if albedo6.y > albedo6.x && albedo6.y > albedo6.z {
                metal_f0 = mix_v3(vec3(0.70, 0.78, 0.74), albedo6, 0.7)
            } else if albedo6.z > albedo6.x && albedo6.z > albedo6.y {
                metal_f0 = mix_v3(vec3(0.66, 0.73, 0.80), albedo6, 0.7)
            } else {
                metal_f0 = mix_v3(vec3(0.95, 0.93, 0.88), albedo6, 0.7)
            }
            f0 = mix_v3(f0a, metal_f0, material.metallic)
        } else {
            f0 = mix_v3(f0a, albedo6, material.metallic)
        }

        ndotv = clamp(dot(norm, view_dir), 0.001, 1.0)
        adjusted0 = max(sqrt(material.roughness * material.roughness + normal_variance), 0.08)
        adjusted = adjusted0
        wet0 = world.wetness * clamp(norm.y, 0.0, 1.0)
        wet = wet0 * wet0
        wet_mirror = 0.0
        albedo = albedo6
        if wet > 0.001 {
            albedo = albedo6 * (1.0 - 0.35 * wet)
            adjusted = max(mix(adjusted0, 0.05, wet), 0.08)
            wet_mirror = wet * 0.7
        } else {
            wet_mirror = 0.0
        }

        // The lights that reach everywhere, then the lamps of this cell.
        shaded0 = 1.0
        if cascades.on != 0 && shading.shadows != 0 {
            shaded0 = shadow_factor(f.Normal, world.shadow_direction, eye.depth_plane, f.FragPos, cascades.count,
                                    cascades.splits, shading.shadow_intensity, cascades.matrices, cascades.texel_world,
                                    shadow_map, shading.shadow_softness)
        }
        shaded = shaded0
        if grid.key_lamp >= 0 && grid.lamp_base >= 0 && shading.shadows != 0 {
            shaded = lamp_shadow(grid.key_lamp, normalize(f.Normal), grid.lamp_base, cluster_lights, f.FragPos,
                                 lamp_shadow_map, shading.shadow_softness, shading.shadow_intensity)
        }
        // Rays, where they reach: past `ray_reach` from the eye a pixel is not traced.
        traced = world.rays == 1 && (eye.ray_reach <= 0.0 || distance(f.FragPos, eye.position) < eye.ray_reach)
        if traced && shading.shadows != 0 {
            shaded = min(shaded, ray_shadow_factor(scene, f.Normal, f.FragPos, world.shadow_direction, shading.shadow_intensity,
                                                   world.sun_angle, eye.ray_frame))
        }
        sunlit = cloud_shadow(f.FragPos, world.cloud_cover, world.cloud_sun, world.cloud_time)
        lo = splat3(0.0)
        for (i = 0; i < 16; i++) {
            if i >= world.light_count {
                break
            }
            if world.lights[i].kind != 1 {
                gap = world.lights[i].position - f.FragPos
                if dot(gap, gap) * world.lights[i].quadratic > 64.0 {
                    continue
                }
                if world.lights[i].kind == 2 &&
                   dot(normalize(-gap), normalize(world.lights[i].direction)) < world.lights[i].cos_outer {
                    continue
                }
            }
            dl = direct_light(world.lights[i], norm, view_dir, albedo, f0, ndotv, adjusted, wet_mirror, f.FragPos,
                              material.metallic, material.reflectivity, material.roughness, shading.clearcoat,
                              shading.clearcoat_roughness, shading.clearcoat_intensity, shading.sheen,
                              shading.sheen_roughness, shading.sheen_colour, shading.transmission,
                              shading.transmission_factor, shading.multiple_scattering, shading.energy_conservation)
            lo = lo + (if (i == 0) { dl.lit * sunlit * shaded } else { dl.lit }) + dl.back_fill
        }
        if material.glitter > 0.0 && world.light_count > 0 && world.lights[0].kind == 1 {
            lo = lo + glitter(norm, view_dir, world.lights[0], f.FragPos, material.glitter_grains, material.glitter,
                              material.glitter_strength) * sunlit * shaded
        }
        if grid.dims.w > 0.5 {
            cell_at = cluster_of(f.FragPos, grid.view_projection, eye.depth_plane, grid.dims, grid.depth)
            first = int_of(floats_at_i(cluster_words, cell_at * 2) + 0.5)
            count = int_of(floats_at_i(cluster_words, cell_at * 2 + 1) + 0.5)
            for (k2 = 0; k2 < count; k2++) {
                cl = clustered_light(cluster_lights, int_of(floats_at_i(cluster_words, first + k2) + 0.5))
                lamp = cl.light
                lgap = lamp.position - f.FragPos
                far2 = dot(lgap, lgap)
                if far2 >= cl.reach * cl.reach {
                    continue
                }
                if lamp.kind == 2 && dot(normalize(-lgap), normalize(lamp.direction)) < lamp.cos_outer {
                    continue
                }
                fade_out = 1.0 - smoothstep(0.75 * cl.reach, cl.reach, sqrt(far2))
                ldl = direct_light(lamp, norm, view_dir, albedo, f0, ndotv, adjusted, wet_mirror, f.FragPos,
                                   material.metallic, material.reflectivity, material.roughness, shading.clearcoat,
                                   shading.clearcoat_roughness, shading.clearcoat_intensity, shading.sheen,
                                   shading.sheen_roughness, shading.sheen_colour, shading.transmission,
                                   shading.transmission_factor, shading.multiple_scattering, shading.energy_conservation)
                lit = ldl.lit * fade_out
                lo = lo + ldl.back_fill * fade_out
                shade = 1.0
                if cl.slot >= 0 && grid.lamp_base >= 0 && shading.shadows != 0 && dot(lit, splat3(0.333)) > 0.002 {
                    shade = lamp_shadow(cl.slot, normalize(f.Normal), grid.lamp_base, cluster_lights, f.FragPos,
                                        lamp_shadow_map, shading.shadow_softness, shading.shadow_intensity)
                }
                // By ray a lamp throws its own shadow, where it reaches: past the
                // lamp's fall-off there is no light to shadow and no ray is cast.
                if traced && shading.shadows != 0 {
                    if dot(lit, splat3(0.333)) > 0.002 {
                        shade = ray_lamp_factor(scene, f.Normal, f.FragPos, lamp.position, world.ray_lamp_radius, eye.ray_frame,
                                                shading.shadow_intensity)
                    } else {
                        shade = 1.0
                    }
                }
                lo = lo + lit * shade
            }
        }

        // The sky's light, scaled by what of the sky the point sees.
        shut0 = mix(1.0, f.Occlusion, world.occlusion_strength) * screen_occlusion(eye.history, f.ClipPrev, occlusion_map)
        shut = shut0
        if traced && world.ray_occlusion > 0.0 {
            shut = shut0 * ray_occlusion_factor(scene, f.Normal, f.FragPos, eye.ray_frame, world.ray_occlusion,
                                                world.ray_occlusion_strength)
        }
        colour0 = sky_lit_probed(norm, view_dir, albedo, f0, adjusted, material.metallic, ndotv, world.gi_off, shading.ibl,
                                 shading.ibl_intensity, sky_irradiance, sky_light, brdf_lut, f.FragPos, probes.on, probes.dims,
                                 probes.base, probes.spacing, probes.atlas, ddgi_irradiance, ddgi_distance, ddgi_state) * shut + lo

        distance_to_camera = length_v3(f.FragPos - eye.position)
        volumetric = calculate_volumetric_lighting(f.FragPos, world.lights[0].position, eye.position, shading.volumetric,
                                                   shading.volumetric_steps, world.lights[0].colour,
                                                   world.lights[0].temperature, shading.volumetric_scattering,
                                                   shading.volumetric_intensity)
        colour1 = colour0 + volumetric
        colour2 = colour1 + caustic_light(f.FragPos, norm, shading.caustics, shading.caustics_water_level, shading.caustics_scale,
                                          world.time, shading.caustics_speed, shading.caustics_depth,
                                          world.lights[0].colour, world.lights[0].temperature, world.lights[0].intensity,
                                          shading.caustics_intensity) * albedo
        colour3 = colour2 * material.exposure
        colour4 = colour3
        if material.embers > 0.0 {
            colour4 = colour3 + ember_light(f.FragPos, world.time, material.ember_cover, material.embers, material.ember_glow)
        }
        // The air between the eye and the shading.
        colour = colour4
        if weather.fog != 0 {
            haze = smoothstep(weather.fog_start, weather.fog_end, distance_to_camera) * weather.fog_intensity
            colour = mix_v3(colour4, weather.fog_radiance, clamp(haze, 0.0, 1.0))
        }

        final0 = tex_colour.w * material.alpha
        final1 = final0
        if material.alpha >= 0.99 {
            final1 = 1.0
        }
        final_alpha = final1
        if material.blend != 0 {
            final_alpha = tex_colour.w * material.alpha * f.ParticleAlpha *
                          soft_fade(material.soft, eye.depth_on, eye.screen_size, scene_depth, eye.inv_view_projection,
                                    eye.position, f.FragPos)
        }
        return LitOut { colour: vec4(colour, final_alpha), velocity: moved }
    }
    place_rays(s)
    hand_on(s)
    return s
}



// The scene's ray-query pixel shader's own bindings beside the others': the
// structure and the probes' images and state.
fn place_rays(s: *GpuShader) {
    place(s)
    _s = gpu.capture_binding(s, "scene", 2, 4)
    _i = gpu.capture_binding(s, "ddgi_irradiance", 1, 6)
    _d = gpu.capture_binding(s, "ddgi_distance", 1, 7)
    _t = gpu.capture_binding(s, "ddgi_state", 1, 8)
}

// The parameters the hand-written helpers took as parameters, which stay
// parameters though every call hands them alike: what the GLSL is written
// as, which MoltenVK's fast math rounds by.
fn hand_on(s: *GpuShader) {
    gpu.hand_on(s, "velocity", "now")
    gpu.hand_on(s, "velocity", "prev")
    gpu.hand_on(s, "velocity", "nudge")
    gpu.hand_on(s, "mapped_normal", "position")
    gpu.hand_on(s, "mapped_normal", "uv")
    gpu.hand_on(s, "tri_setup", "position")
    gpu.hand_on(s, "tri_setup", "metres")
    gpu.hand_on(s, "hex_setup", "uv")
    gpu.hand_on(s, "hex_setup", "rotation")
    gpu.hand_on(s, "tri_texture", "tex")
    gpu.hand_on(s, "hex_texture", "tex")
    gpu.hand_on(s, "calculate_volumetric_lighting", "world_pos")
    gpu.hand_on(s, "calculate_volumetric_lighting", "light_pos")
    gpu.hand_on(s, "calculate_volumetric_lighting", "view_pos")
    gpu.hand_on(s, "caustic_light", "world_pos")
    gpu.hand_on(s, "cloud_shadow", "world_pos")
    gpu.hand_on(s, "cloud_coverage", "cover")
    gpu.hand_on(s, "cloud_coverage", "t")
    gpu.hand_on(s, "turbulence", "octaves")
    gpu.hand_on(s, "sky_lit", "metal")
    gpu.hand_on(s, "wound_depth", "p")
    gpu.hand_on(s, "splat_cover", "p")
    gpu.hand_on(s, "clipped_away", "bind_pos")
    gpu.hand_on(s, "glitter", "l_in")
    gpu.hand_on(s, "compensate_energy_loss", "rough")
    gpu.hand_on(s, "cluster_of", "p")
}

// ── The ray-query pixel shader (scene_rq_vk.frag, quoted) ───────────────
//
// Where the device traces (VK_KHR_ray_query), the scene's pixel shader is
// lit_rq_pixel: lit_pixel's body with the rays the hand-written
// FRAGMENT_DEFAULT cast under AE3D_RAY_QUERY, in the order it cast them:
//
//   - the key light's shadow by ray, the sun a disc of rays on a spiral
//     (ray_shadow_factor), taken with the shadow map's, the nearer;
//   - each lamp's by one ray to a spot on its face (ray_lamp_factor);
//   - the sky's occlusion by rays over the hemisphere (ray_occlusion_factor);
//   - and the probes' irradiance (#537, ae3d.vkddgi) in place of the sky's
//     where the probes are on (ddgi_irradiance).
//
// The rays are ray_hit: a ray query from just off the surface, opaque
// geometry only, stopped at the first hit, meeting what casts a shadow (mask
// bit 1, ae3d.vkrays' RAY_SHADOW) and not what only the probes see. A
// helper is handed the scene's acceleration structure (set 2, binding 4) and
// reads it in place, as the hand-written one read its global; the probes'
// atlases (set 1, bindings 6 and 7) and state (8) the same.
//
// The probe volume's layout is ae3d.vkddgi's, and these helpers are the
// hand-written ones' arithmetic in their order: a grid cell is three ints
// (GLSL's ivec3), written out an axis at a time.

// Whether anything the ray meets, from `near` to `far` along `direction`
// (a unit vector) out of `origin`.
@quotable
ray_hit(scene: AccelerationStructure, origin: vec3, near: float, direction: vec3, far: float) -> bool {
    q = ray_query()
    ray_query_initialize(q, scene, ray_flag_terminate_on_first_hit() | ray_flag_opaque(), 1, origin, near, direction, far)
    ray_query_proceed(q)
    return ray_query_committed_hit(q)
}

// One ray toward `direction` from just off the surface: the origin steps out
// along the normal by a little more than the surface's own tessellation
// error, so a face does not shadow itself.
@quotable
ray_blocked_to(scene: AccelerationStructure, origin: vec3, direction: vec3, far: float) -> bool {
    return ray_hit(scene, origin, 0.01, direction, far)
}

@quotable
ray_blocked(scene: AccelerationStructure, origin: vec3, direction: vec3) -> bool {
    return ray_blocked_to(scene, origin, direction, 500.0)
}

// A sun with a size: four rays into the cone the sun's disc subtends, on a
// spiral turned by a per-pixel noise and by the frame's jitter, so the
// temporal pass folds successive frames' taps into a smooth penumbra and a
// still frame reads as a fine grain rather than a band. What stands close to
// its shadow blocks every tap; what stands far blocks some.
@quotable
ray_shadow_factor(scene: AccelerationStructure, normal: vec3, frag_pos: vec3, shadow_direction: vec3,
                  shadow_intensity: float, sun_angle: float, ray_frame: int) -> float {
    surface = normalize(normal)
    to_light = normalize(-shadow_direction)
    if dot(surface, to_light) <= 0.0 {
        return shadow_intensity
    }
    origin = frag_pos + surface * 0.02
    if sun_angle <= 0.0 {
        if ray_blocked(scene, origin, to_light) {
            return shadow_intensity
        }
        return 1.0
    }
    side = normalize(cross(to_light, if (abs(to_light.y) < 0.9) { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }))
    up = cross(side, to_light)
    spread = tan(sun_angle)
    pixel = frag_coord()
    grain = fract(52.9829189 * fract(0.06711056 * pixel.x + 0.00583715 * pixel.y))
    turn = 6.2831853 * fract(grain + float_of(ray_frame) * 0.6180339887)
    blocked = 0.0
    for (i = 0; i < 4; i++) {
        radius = spread * sqrt((float_of(i) + 0.5) / 4.0)
        angle = float_of(i) * 2.3999632 + turn
        direction = normalize(to_light + side * (radius * cos(angle)) + up * (radius * sin(angle)))
        if ray_blocked(scene, origin, direction) {
            blocked = blocked + 1.0
        }
    }
    return mix(1.0, shadow_intensity, blocked / 4.0)
}

// Ambient occlusion by ray: four rays into the hemisphere over the surface,
// cosine-weighted (a ray near the normal counts for the sky it stands for),
// on a spiral turned by a per-pixel noise and the frame's jitter as the sun's
// taps are, each stopped at the occlusion's reach. The share that hit is how
// much of the sky the point does not see: the same number the screen-space
// pass estimates from the depth, from the scene itself, with no screen edge
// or hidden surface to miss. From a hand's breadth out: a figure is drawn from
// its near mesh and traced against its far one, a few centimetres apart, so a
// ray that started at the skin found the proxy and dotted every figure with
// its own shadow.
@quotable
ray_occlusion_factor(scene: AccelerationStructure, normal: vec3, frag_pos: vec3, ray_frame: int, reach: float,
                     strength: float) -> float {
    surface = normalize(normal)
    origin = frag_pos + surface * 0.02
    side = normalize(cross(surface, if (abs(surface.y) < 0.9) { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }))
    up = cross(side, surface)
    pixel = frag_coord()
    grain = fract(52.9829189 * fract(0.06711056 * pixel.x + 0.00583715 * pixel.y) + 0.37)
    turn = 6.2831853 * fract(grain + float_of(ray_frame) * 0.6180339887)
    blocked = 0.0
    for (i = 0; i < 4; i++) {
        u = (float_of(i) + 0.5) / 4.0
        sin_theta = sqrt(u)
        cos_theta = sqrt(1.0 - u)
        angle = float_of(i) * 2.3999632 + turn
        direction = side * (cos(angle) * sin_theta) + up * (sin(angle) * sin_theta) + surface * cos_theta
        if ray_hit(scene, origin, 0.12, direction, reach) {
            blocked = blocked + 1.0
        }
    }
    return clamp(1.0 - strength * blocked / 4.0, 0.0, 1.0)
}

// A lamp's shadow: one ray from the surface to the lamp, stopped short of
// it, on a spot of the lamp's face picked by the pixel's noise and the
// frame's jitter -- a lamp has a size, and the temporal pass folds the frames
// into its penumbra. A lamp has no shadow map, so on the map path the key
// light's shadow stands in for every lamp's; by ray each lamp throws its own:
// the figure under the street lamp is the one thing on a night street the eye
// asks for, and it was missing.
@quotable
ray_lamp_factor(scene: AccelerationStructure, normal: vec3, frag_pos: vec3, lamp: vec3, radius: float, ray_frame: int,
                shadow_intensity: float) -> float {
    surface = normalize(normal)
    to_lamp0 = lamp - frag_pos
    span = length_v3(to_lamp0)
    if span < 0.05 {
        return 1.0
    }
    to_lamp = to_lamp0 / span
    if dot(surface, to_lamp) <= 0.0 {
        return 1.0
    }
    side = normalize(cross(to_lamp, if (abs(to_lamp.y) < 0.9) { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }))
    up = cross(side, to_lamp)
    pixel = frag_coord()
    grain = fract(52.9829189 * fract(0.06711056 * pixel.x + 0.00583715 * pixel.y) + 0.71)
    seed = fract(grain + float_of(ray_frame) * 0.6180339887)
    turn = 6.2831853 * seed
    reach = radius * sqrt(fract(seed * 7.0))
    spot = lamp + side * (reach * cos(turn)) + up * (reach * sin(turn))
    toward = spot - frag_pos
    far = length_v3(toward)
    direction = toward / far
    origin = frag_pos + surface * 0.02
    // Stopped well short of the lamp: the fitting the light hangs from -- its
    // head, its arm -- stands right over it, and a ray run to the light itself
    // found the head and shadowed half the street's walls with a grain.
    if ray_blocked_to(scene, origin, direction, max(far - 0.6, 0.05)) {
        return shadow_intensity
    }
    return 1.0
}

// The probe volume (#537, ae3d.vkddgi, whose layout this must match): two
// cascades of probes round the camera, each `dims` probes (x y z, and probes
// a cascade in w) `spacing` apart, addressed toroidally -- a probe's slot is
// its world cell modulo the grid -- so the grid scrolls with the camera by
// whole cells and what a probe knows stays where it was learned. Each probe
// keeps its irradiance and its distance moments in octahedral texels in two
// atlases (`atlas`: the irradiance atlas's size, then the distance atlas's),
// a one-texel gutter round each, and its state -- the offset that moves it
// out of a wall, whether it is on -- in the state buffer (`state`, two vec4s
// a probe). `base` is the world cell of each cascade's first probe.

// A cell's slot on a side of `d` probes: v wrapped into 0 to d-1 (GLSL's %
// is undefined for a negative operand, and a grid west of the origin has
// negative cells).
@quotable
ddgi_wrap(v: int, d: int) -> int {
    return v - d * int_of(floor(float_of(v) / float_of(d)))
}

// Probe index of the grid cell (gx, gy, gz) of cascade c.
@quotable
ddgi_index(c: int, gx: int, gy: int, gz: int, dims: vec4, base: vec4[2]) -> int {
    b = base[c]
    sx = ddgi_wrap(int_of(b.x) + gx, int_of(dims.x))
    sy = ddgi_wrap(int_of(b.y) + gy, int_of(dims.y))
    sz = ddgi_wrap(int_of(b.z) + gz, int_of(dims.z))
    return c * int_of(dims.w) + (sz * int_of(dims.y) + sy) * int_of(dims.x) + sx
}

// Whether probe `index`, at grid coordinate g of cascade c, is on: traced
// since it came to its cell (its stamp's w 1, not 0, nor 2 for woken with its
// texels not yet replaced), and neither inside anything (its state's w 0) nor
// asleep, with nothing near it to light (w 2).
@quotable
ddgi_on(c: int, gx: int, gy: int, gz: int, index: int, base: vec4[2], state: Vec4s) -> bool {
    stamp = vec4s_at_i(state, index * 2 + 1)
    b = base[c]
    return abs(vec4s_at_i(state, index * 2).w - 1.0) < 0.5 && abs(stamp.w - 1.0) < 0.5 &&
           stamp.x == b.x + float_of(gx) && stamp.y == b.y + float_of(gy) && stamp.z == b.z + float_of(gz)
}

// Where the probe at grid coordinate g of cascade c belongs: its cell's
// centre, not its corner, so a floor or a wall at a whole number of cells does
// not run through a row of probes.
@quotable
ddgi_home(c: int, gx: int, gy: int, gz: int, base: vec4[2], spacing: vec4) -> vec3 {
    b = base[c]
    return (xyz(b) + vec3(float_of(gx), float_of(gy), float_of(gz)) + splat3(0.5)) * lane_at(spacing, c)
}

// Where probe `index` stands: its home and the offset its state keeps.
@quotable
ddgi_probe_position(c: int, gx: int, gy: int, gz: int, index: int, base: vec4[2], spacing: vec4, state: Vec4s) -> vec3 {
    return ddgi_home(c, gx, gy, gz, base, spacing) + xyz(vec4s_at_i(state, index * 2))
}

// Point P in cascade c's grid coordinates, a probe at each whole number.
@quotable
ddgi_grid(c: int, p: vec3, base: vec4[2], spacing: vec4) -> vec3 {
    return p / lane_at(spacing, c) - xyz(base[c]) - splat3(0.5)
}

// The atlas texel a probe's octahedron starts at (its gutter's corner).
@quotable
ddgi_corner(index: int, side: float, dims: vec4) -> vec2 {
    c = index / int_of(dims.w)
    within = index - c * int_of(dims.w)
    dx = int_of(dims.x)
    dy = int_of(dims.y)
    dz = int_of(dims.z)
    x = within % dx
    y = (within / dx) % dy
    z = within / (dx * dy)
    return vec2(float_of(x + y * dx), float_of(z + c * dz)) * (side + 2.0)
}

// Where direction n is read in probe `index`'s octahedron of `side` texels.
@quotable
ddgi_uv(index: int, n: vec3, side: float, atlas: vec2, dims: vec4) -> vec2 {
    o = oct_encode(n) * 0.5 + splat2(0.5)
    return (ddgi_corner(index, side, dims) + splat2(1.0) + o * side) / atlas
}

// What a cascade gives a point: the irradiance and the weights' sum.
struct Probed {
    irradiance: vec3
    total: float
}

// The irradiance onto a surface at P facing N, seen from V's side, from the
// eight probes of cascade c's cell around it: trilinear, each weighed by
// whether it faces the surface and by whether, by its distance moments, it can
// see it (Chebyshev). The irradiance the probes keep is the cosine average of
// the radiance, so pi times it is the irradiance; a weight sum of nothing is
// for the caller to take what lies beyond.
@quotable
ddgi_cascade(c: int, p: vec3, n: vec3, v: vec3, dims: vec4, base: vec4[2], spacing: vec4, atlas: vec4,
             irradiance_map: Texture, distance_map: Texture, state: Vec4s) -> Probed {
    cell = lane_at(spacing, c)
    biased = p + (n * 0.2 + v * 0.8) * (0.3 * cell)
    grid_pos = ddgi_grid(c, biased, base, spacing)
    g0x = int_of(floor(grid_pos.x))
    g0y = int_of(floor(grid_pos.y))
    g0z = int_of(floor(grid_pos.z))
    alpha = clamp_v3(grid_pos - vec3(float_of(g0x), float_of(g0y), float_of(g0z)), splat3(0.0), splat3(1.0))
    sum = splat3(0.0)
    total = 0.0
    for (i = 0; i < 8; i++) {
        ox = i & 1
        oy = (i >> 1) & 1
        oz = (i >> 2) & 1
        gx = clamp_int(g0x + ox, 0, int_of(dims.x) - 1)
        gy = clamp_int(g0y + oy, 0, int_of(dims.y) - 1)
        gz = clamp_int(g0z + oz, 0, int_of(dims.z) - 1)
        index = ddgi_index(c, gx, gy, gz, dims, base)
        if !ddgi_on(c, gx, gy, gz, index, base, state) {
            continue
        }
        probe = ddgi_probe_position(c, gx, gy, gz, index, base, spacing, state)
        tri = vec3(mix(1.0 - alpha.x, alpha.x, float_of(ox)), mix(1.0 - alpha.y, alpha.y, float_of(oy)),
                   mix(1.0 - alpha.z, alpha.z, float_of(oz)))
        weight = tri.x * tri.y * tri.z
        to_probe = probe - p
        dir_to_probe = normalize(to_probe)
        facing = (dot(dir_to_probe, n) + 1.0) * 0.5
        weight = weight * (facing * facing + 0.2)
        from_probe = biased - probe
        far = length_v3(from_probe)
        moments = xy(texture_lod(distance_map, ddgi_uv(index, from_probe / max(far, 0.0001), 14.0,
                                                       vec2(atlas.z, atlas.w), dims), 0.0))
        variance = abs(moments.x * moments.x - moments.y)
        visible = 1.0
        if far > moments.x {
            gap = far - moments.x
            visible = variance / (variance + gap * gap)
            visible = max(visible * visible * visible, 0.0)
        }
        weight = weight * max(visible, 0.05)
        // Small weights crushed, so a probe that barely sees the point does
        // not tint it (Majercik et al.'s threshold).
        if weight < 0.2 {
            weight = weight * (weight * weight / 0.04)
        }
        light = rgb(texture_lod(irradiance_map, ddgi_uv(index, n, 6.0, vec2(atlas.x, atlas.y), dims), 0.0))
        sum = sum + light * weight
        total = total + weight
    }
    if total <= 0.0 {
        return Probed { irradiance: splat3(0.0), total: total }
    }
    return Probed { irradiance: sum / total * 3.14159265, total: total }
}

// How far inside cascade c point P is, in cells from its nearest face: past
// one the cascade is whole; under it, the next one out takes over.
@quotable
ddgi_inside(c: int, p: vec3, dims: vec4, base: vec4[2], spacing: vec4) -> float {
    grid_pos = ddgi_grid(c, p, base, spacing)
    edge = min_v3(grid_pos, (xyz(dims) - splat3(1.0)) - grid_pos)
    return min(edge.x, min(edge.y, edge.z))
}

// The probes' irradiance at P onto N, the nearest cascade that holds it
// blending into the next over its last cell, and beyond the last the `beyond`
// irradiance (the sky's) over the far cascade's last cell. From the near
// cascade out, so a point the near one holds whole reads its eight probes and
// no more.
@quotable
ddgi_irradiance(p: vec3, n: vec3, v: vec3, beyond: vec3, dims: vec4, base: vec4[2], spacing: vec4, atlas: vec4,
                irradiance_map: Texture, distance_map: Texture, state: Vec4s) -> vec3 {
    result = splat3(0.0)
    left = 1.0
    for (c = 0; c < 2; c++) {
        inside = ddgi_inside(c, p, dims, base, spacing)
        if inside <= 0.0 {
            continue
        }
        found = ddgi_cascade(c, p, n, v, dims, base, spacing, atlas, irradiance_map, distance_map, state)
        if found.total <= 0.0 {
            continue
        }
        share = clamp(inside, 0.0, 1.0) * left
        result = result + found.irradiance * share
        left = left - share
        if left <= 0.0 {
            return result
        }
    }
    return result + beyond * left
}

// What the sky gives a surface where the probes may add to it: sky_lit, with
// the irradiance the probes' where they are on (#537).
@quotable
sky_lit_probed(n: vec3, v: vec3, albedo: vec3, f0: vec3, rough: float, metal: float, ndotv: float, gi_off: int, ibl: int,
               ibl_intensity: float, sky_irradiance_map: Texture, sky_light_map: Texture, brdf_lut: Texture, frag_pos: vec3,
               probes_on: int, dims: vec4, base: vec4[2], spacing: vec4, atlas: vec4, irradiance_map: Texture,
               distance_map: Texture, state: Vec4s) -> vec3 {
    if gi_off != 0 {
        return splat3(0.0)
    }
    f = f0 + (max_v3(splat3(1.0 - rough), f0) - f0) * pow(1.0 - ndotv, 5.0)
    kd = (splat3(1.0) - f) * (1.0 - metal)
    irradiance = sky_irradiance(n, sky_irradiance_map)
    if probes_on != 0 {
        irradiance = ddgi_irradiance(frag_pos, n, v, irradiance, dims, base, spacing, atlas, irradiance_map, distance_map, state)
    }
    diffuse = kd * albedo * irradiance / 3.14159265
    if ibl == 0 {
        return diffuse
    }
    ab = xy(texture(brdf_lut, vec2(ndotv, rough)))
    specular = sky_reflection(reflect(-v, n), rough, sky_light_map) * (f0 * ab.x + splat3(ab.y))
    return diffuse + specular * ibl_intensity
}

// ── The vertex shaders ─────────────────────────────────────────────────

// A vertex and its instance: the mesh's position, uv and normal, the
// instance's matrix (or point) and tint, the sky it sees, the four bones it
// hangs off and how much of each, its second uv set (#544, (-1, -1) for
// none), and a point's alpha, life, turn and stretch (#728).
struct LitVertex {
    position: vec3
    uv: vec2
    normal: vec3
    instance_model: mat4
    instance_color: vec3
    occlusion: float
    joints: vec4
    weights: vec4
    mask_uv: vec2
    instance_extras: vec4
}

// The same for the plain pipelines, which name no skin stream.
struct LitPlainVertex {
    position: vec3
    uv: vec2
    normal: vec3
    instance_model: mat4
    instance_color: vec3
    occlusion: float
    instance_extras: vec4
}

// Last frame's palette, bone `joint`: its three rows (#639).
@quotable
prev_bone(joint: float, rows: vec4[288]) -> mat4 {
    j = int_of(joint + 0.5) * 3
    return mat4_rows(rows[j], rows[j + 1], rows[j + 2], vec4(vec3(0.0, 0.0, 0.0), 1.0))
}

// Whether joint `joint` is one the cut is kept to (#556).
@quotable
clip_joint_on(joint: float, joints0: int, joints1: int, joints2: int) -> float {
    j = int_of(joint + 0.5)
    word = if (j < 32) { joints0 } else { if (j < 64) { joints1 } else { joints2 } }
    return float_of((word >> (j & 31)) & 1)
}

// The share of the vertex's weight on the cut's joints.
@quotable
clip_limb_of(joints: vec4, weights: vec4, skinned: int, joints0: int, joints1: int, joints2: int) -> float {
    if skinned == 0 || (joints0 | joints1 | joints2) == 0 {
        return 1.0
    }
    return weights.x * clip_joint_on(joints.x, joints0, joints1, joints2) + weights.y * clip_joint_on(joints.y, joints0, joints1, joints2) +
           weights.z * clip_joint_on(joints.z, joints0, joints1, joints2) + weights.w * clip_joint_on(joints.w, joints0, joints1, joints2)
}

// A model's vertex: VERTEX_DEFAULT's main, in its order.
lit_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("lit_vertex") quote | v: LitVertex | {
        clip_limb = clip_limb_of(v.joints, v.weights, draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        mask_uv = if (v.mask_uv.x < -0.5) { v.uv } else { v.mask_uv }
        model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        model_matrix = model_matrix0
        particle_alpha = 1.0
        flip_next = vec3(0.0, 0.0, -1.0)
        tex_coord = v.uv
        if draw.instanced != 0 && draw.points != 0 {
            point = m4_col(v.instance_model, 0)
            particle_alpha = v.instance_extras.x
            if draw.flip_columns > 0 && draw.flip_rows > 0 {
                frames = draw.flip_columns * draw.flip_rows
                at = clamp(v.instance_extras.y, 0.0, 1.0) * float_of(frames - 1)
                frame = min_int(int_of(at), frames - 1)
                next = min_int(frame + 1, frames - 1)
                column = float_of(frame - (frame / draw.flip_columns) * draw.flip_columns)
                row = float_of(frame / draw.flip_columns)
                tex_coord = vec2((column + v.uv.x) / float_of(draw.flip_columns),
                                 1.0 - (row + 1.0 - v.uv.y) / float_of(draw.flip_rows))
                next_column = float_of(next - (next / draw.flip_columns) * draw.flip_columns)
                next_row = float_of(next / draw.flip_columns)
                flip_next = vec3((next_column + v.uv.x) / float_of(draw.flip_columns),
                                 1.0 - (next_row + 1.0 - v.uv.y) / float_of(draw.flip_rows), at - float_of(frame))
            }
            model_matrix = mat4_cols(m4_col(draw.model, 0) * point.w, m4_col(draw.model, 1) * point.w,
                                     m4_col(draw.model, 2) * point.w, vec4(xyz(point), 1.0))
            if draw.billboard > 0 {
                to_eye = eye.position - xyz(point)
                up0 = vec3(0.0, 1.0, 0.0)
                forward = splat3(0.0)
                if draw.billboard == 1 {
                    forward = normalize(vec3(to_eye.x, 0.0, to_eye.z))
                } else {
                    forward = normalize(to_eye)
                }
                right0 = normalize(cross(up0, forward))
                up1 = cross(forward, right0)
                cn = cos(v.instance_extras.z)
                sn = sin(v.instance_extras.z)
                turned = right0 * cn + up1 * sn
                up = up1 * cn - right0 * sn
                right = turned * max(v.instance_extras.w, 1.0)
                sx = length_v3(xyz(m4_col(draw.model, 0))) * point.w
                sy = length_v3(xyz(m4_col(draw.model, 1))) * point.w
                sz = length_v3(xyz(m4_col(draw.model, 2))) * point.w
                model_matrix = mat4_cols(vec4(right * sx, 0.0), vec4(up * sy, 0.0), vec4(forward * sz, 0.0),
                                         vec4(xyz(point) + up * (sy * draw.lift), 1.0))
            }
        }

        posed0 = vec4(v.position, 1.0)
        posed = posed0
        posed_prev = posed0
        posed_normal = v.normal
        if draw.skinned != 0 {
            skin_now = add_m4(add_m4(add_m4(mul_fm4(v.weights.x, skin.bones[int_of(v.joints.x)]),
                                            mul_fm4(v.weights.y, skin.bones[int_of(v.joints.y)])),
                                     mul_fm4(v.weights.z, skin.bones[int_of(v.joints.z)])),
                              mul_fm4(v.weights.w, skin.bones[int_of(v.joints.w)]))
            skin_prev = add_m4(add_m4(add_m4(mul_fm4(v.weights.x, prev_bone(v.joints.x, skin.prev_rows)),
                                             mul_fm4(v.weights.y, prev_bone(v.joints.y, skin.prev_rows))),
                                      mul_fm4(v.weights.z, prev_bone(v.joints.z, skin.prev_rows))),
                               mul_fm4(v.weights.w, prev_bone(v.joints.w, skin.prev_rows)))
            posed_prev = mul(skin_prev, posed0)
            posed = mul(skin_now, posed0)
            posed_normal = mul_m3(skin_now, v.normal)
        }
        prev_model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.prev_model, v.instance_model) } else { draw.prev_model }
        prev_model_matrix = prev_model_matrix0
        if draw.instanced != 0 && draw.points != 0 {
            prev_model_matrix = model_matrix
        }
        frag_pos = xyz(mul(model_matrix, posed))
        normal_out = normalize(mul_m3(model_matrix, posed_normal))
        instance_colour = if (draw.instanced != 0 && draw.instance_colour != 0) { v.instance_color } else { vec3(1.0, 1.0, 1.0) }
        light_space = mul(draw.light_space, vec4(frag_pos, 1.0))
        clip_now = mul(mul_m4(eye.view_projection, model_matrix), posed)
        clip_prev = mul(mul_m4(eye.prev_view_projection, prev_model_matrix), posed_prev)
        return LitVaryings { position: clip_now, fragTexCoord: tex_coord, Normal: normal_out, FragPos: frag_pos,
                             InstanceColor: instance_colour, FragPosLightSpace: light_space, Occlusion: v.occlusion,
                             ClipNow: clip_now, ClipPrev: clip_prev, BindPos: v.position, ClipLimb: clip_limb,
                             MaskUV: mask_uv, ParticleAlpha: particle_alpha, FlipNext: flip_next }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

// The same for the plain pipelines (VERTEX_DEFAULT with AE3D_UNSKINNED):
// no skin stream, its joints and weights none and its mask's uv (-1, -1).
lit_plain_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("lit_plain_vertex") quote | v: LitPlainVertex | {
        clip_limb = clip_limb_of(splat4(0.0), splat4(0.0), draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        mask_uv = if (splat2(-1.0).x < -0.5) { v.uv } else { splat2(-1.0) }
        model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        model_matrix = model_matrix0
        particle_alpha = 1.0
        flip_next = vec3(0.0, 0.0, -1.0)
        tex_coord = v.uv
        if draw.instanced != 0 && draw.points != 0 {
            point = m4_col(v.instance_model, 0)
            particle_alpha = v.instance_extras.x
            if draw.flip_columns > 0 && draw.flip_rows > 0 {
                frames = draw.flip_columns * draw.flip_rows
                at = clamp(v.instance_extras.y, 0.0, 1.0) * float_of(frames - 1)
                frame = min_int(int_of(at), frames - 1)
                next = min_int(frame + 1, frames - 1)
                column = float_of(frame - (frame / draw.flip_columns) * draw.flip_columns)
                row = float_of(frame / draw.flip_columns)
                tex_coord = vec2((column + v.uv.x) / float_of(draw.flip_columns),
                                 1.0 - (row + 1.0 - v.uv.y) / float_of(draw.flip_rows))
                next_column = float_of(next - (next / draw.flip_columns) * draw.flip_columns)
                next_row = float_of(next / draw.flip_columns)
                flip_next = vec3((next_column + v.uv.x) / float_of(draw.flip_columns),
                                 1.0 - (next_row + 1.0 - v.uv.y) / float_of(draw.flip_rows), at - float_of(frame))
            }
            model_matrix = mat4_cols(m4_col(draw.model, 0) * point.w, m4_col(draw.model, 1) * point.w,
                                     m4_col(draw.model, 2) * point.w, vec4(xyz(point), 1.0))
            if draw.billboard > 0 {
                to_eye = eye.position - xyz(point)
                up0 = vec3(0.0, 1.0, 0.0)
                forward = splat3(0.0)
                if draw.billboard == 1 {
                    forward = normalize(vec3(to_eye.x, 0.0, to_eye.z))
                } else {
                    forward = normalize(to_eye)
                }
                right0 = normalize(cross(up0, forward))
                up1 = cross(forward, right0)
                cn = cos(v.instance_extras.z)
                sn = sin(v.instance_extras.z)
                turned = right0 * cn + up1 * sn
                up = up1 * cn - right0 * sn
                right = turned * max(v.instance_extras.w, 1.0)
                sx = length_v3(xyz(m4_col(draw.model, 0))) * point.w
                sy = length_v3(xyz(m4_col(draw.model, 1))) * point.w
                sz = length_v3(xyz(m4_col(draw.model, 2))) * point.w
                model_matrix = mat4_cols(vec4(right * sx, 0.0), vec4(up * sy, 0.0), vec4(forward * sz, 0.0),
                                         vec4(xyz(point) + up * (sy * draw.lift), 1.0))
            }
        }

        posed0 = vec4(v.position, 1.0)
        posed = posed0
        posed_prev = posed0
        posed_normal = v.normal
        if draw.skinned != 0 {
            weights = splat4(0.0)
            joints = splat4(0.0)
            skin_now = add_m4(add_m4(add_m4(mul_fm4(weights.x, skin.bones[int_of(joints.x)]),
                                            mul_fm4(weights.y, skin.bones[int_of(joints.y)])),
                                     mul_fm4(weights.z, skin.bones[int_of(joints.z)])),
                              mul_fm4(weights.w, skin.bones[int_of(joints.w)]))
            skin_prev = add_m4(add_m4(add_m4(mul_fm4(weights.x, prev_bone(joints.x, skin.prev_rows)),
                                             mul_fm4(weights.y, prev_bone(joints.y, skin.prev_rows))),
                                      mul_fm4(weights.z, prev_bone(joints.z, skin.prev_rows))),
                               mul_fm4(weights.w, prev_bone(joints.w, skin.prev_rows)))
            posed_prev = mul(skin_prev, posed0)
            posed = mul(skin_now, posed0)
            posed_normal = mul_m3(skin_now, v.normal)
        }
        prev_model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.prev_model, v.instance_model) } else { draw.prev_model }
        prev_model_matrix = prev_model_matrix0
        if draw.instanced != 0 && draw.points != 0 {
            prev_model_matrix = model_matrix
        }
        frag_pos = xyz(mul(model_matrix, posed))
        normal_out = normalize(mul_m3(model_matrix, posed_normal))
        instance_colour = if (draw.instanced != 0 && draw.instance_colour != 0) { v.instance_color } else { vec3(1.0, 1.0, 1.0) }
        light_space = mul(draw.light_space, vec4(frag_pos, 1.0))
        clip_now = mul(mul_m4(eye.view_projection, model_matrix), posed)
        clip_prev = mul(mul_m4(eye.prev_view_projection, prev_model_matrix), posed_prev)
        return LitVaryings { position: clip_now, fragTexCoord: tex_coord, Normal: normal_out, FragPos: frag_pos,
                             InstanceColor: instance_colour, FragPosLightSpace: light_space, Occlusion: v.occlusion,
                             ClipNow: clip_now, ClipPrev: clip_prev, BindPos: v.position, ClipLimb: clip_limb,
                             MaskUV: mask_uv, ParticleAlpha: particle_alpha, FlipNext: flip_next }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

fn vertex_hand_on(s: *GpuShader) {
    gpu.hand_on(s, "clip_limb_of", "joints")
    gpu.hand_on(s, "clip_limb_of", "weights")
}

// ── The shadow pass's shaders ─────────────────────────────────────────
//
// VERTEX_DEPTH (depth_vk.vert, depth_plain_vk.vert) and FRAGMENT_DEPTH
// (depth_vk.frag): a model into a shadow map, placed and posed as the lit
// pass places and poses it, and cut by its cut and its wounds so a hole is
// a hole in its shadow too. The depth is the rasteriser's.

struct LitDepthVertex {
    position: vec3
    instance_model: mat4
    joints: vec4
    weights: vec4
}

struct LitDepthPlainVertex {
    position: vec3
    instance_model: mat4
}

// What the depth pixel shader reads: the bind position the cut is made in,
// and the share of the vertex on the cut's joints.
struct LitDepthVaryings {
    position: vec4
    BindPos: vec3
    ClipLimb: float
}

lit_depth_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("lit_depth_vertex") quote | v: LitDepthVertex | {
        clip_limb = clip_limb_of(v.joints, v.weights, draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        model_matrix = model_matrix0
        if draw.instanced != 0 && draw.points != 0 {
            point = m4_col(v.instance_model, 0)
            model_matrix = mat4_cols(m4_col(draw.model, 0) * point.w, m4_col(draw.model, 1) * point.w,
                                     m4_col(draw.model, 2) * point.w, vec4(xyz(point), 1.0))
            if draw.billboard > 0 {
                to_eye = eye.position - xyz(point)
                up0 = vec3(0.0, 1.0, 0.0)
                forward = splat3(0.0)
                if draw.billboard == 1 {
                    forward = normalize(vec3(to_eye.x, 0.0, to_eye.z))
                } else {
                    forward = normalize(to_eye)
                }
                right = normalize(cross(up0, forward))
                up = cross(forward, right)
                sx = length_v3(xyz(m4_col(draw.model, 0))) * point.w
                sy = length_v3(xyz(m4_col(draw.model, 1))) * point.w
                sz = length_v3(xyz(m4_col(draw.model, 2))) * point.w
                model_matrix = mat4_cols(vec4(right * sx, 0.0), vec4(up * sy, 0.0), vec4(forward * sz, 0.0),
                                         vec4(xyz(point) + up * (sy * draw.lift), 1.0))
            }
        }
        posed0 = vec4(v.position, 1.0)
        posed = posed0
        if draw.skinned != 0 {
            skin_now = add_m4(add_m4(add_m4(mul_fm4(v.weights.x, skin.bones[int_of(v.joints.x)]),
                                            mul_fm4(v.weights.y, skin.bones[int_of(v.joints.y)])),
                                     mul_fm4(v.weights.z, skin.bones[int_of(v.joints.z)])),
                              mul_fm4(v.weights.w, skin.bones[int_of(v.joints.w)]))
            posed = mul(skin_now, posed0)
        }
        return LitDepthVaryings { position: mul(mul_m4(draw.light_space, model_matrix), posed), BindPos: v.position,
                                  ClipLimb: clip_limb }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

lit_depth_plain_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("lit_depth_plain_vertex") quote | v: LitDepthPlainVertex | {
        clip_limb = clip_limb_of(splat4(0.0), splat4(0.0), draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        model_matrix0 = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        model_matrix = model_matrix0
        if draw.instanced != 0 && draw.points != 0 {
            point = m4_col(v.instance_model, 0)
            model_matrix = mat4_cols(m4_col(draw.model, 0) * point.w, m4_col(draw.model, 1) * point.w,
                                     m4_col(draw.model, 2) * point.w, vec4(xyz(point), 1.0))
            if draw.billboard > 0 {
                to_eye = eye.position - xyz(point)
                up0 = vec3(0.0, 1.0, 0.0)
                forward = splat3(0.0)
                if draw.billboard == 1 {
                    forward = normalize(vec3(to_eye.x, 0.0, to_eye.z))
                } else {
                    forward = normalize(to_eye)
                }
                right = normalize(cross(up0, forward))
                up = cross(forward, right)
                sx = length_v3(xyz(m4_col(draw.model, 0))) * point.w
                sy = length_v3(xyz(m4_col(draw.model, 1))) * point.w
                sz = length_v3(xyz(m4_col(draw.model, 2))) * point.w
                model_matrix = mat4_cols(vec4(right * sx, 0.0), vec4(up * sy, 0.0), vec4(forward * sz, 0.0),
                                         vec4(xyz(point) + up * (sy * draw.lift), 1.0))
            }
        }
        posed0 = vec4(v.position, 1.0)
        posed = posed0
        if draw.skinned != 0 {
            weights = splat4(0.0)
            joints = splat4(0.0)
            skin_now = add_m4(add_m4(add_m4(mul_fm4(weights.x, skin.bones[int_of(joints.x)]),
                                            mul_fm4(weights.y, skin.bones[int_of(joints.y)])),
                                     mul_fm4(weights.z, skin.bones[int_of(joints.z)])),
                              mul_fm4(weights.w, skin.bones[int_of(joints.w)]))
            posed = mul(skin_now, posed0)
        }
        return LitDepthVaryings { position: mul(mul_m4(draw.light_space, model_matrix), posed), BindPos: v.position,
                                  ClipLimb: clip_limb }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

// The casters' pixel shader: a cut model's far side and a wound's core
// dropped, nothing written.
lit_depth_pixel(cut: Cut, wounds: Wounds) -> *GpuShader {
    s = gpu.cut_fragment("lit_depth") quote | f: LitDepthVaryings | {
        if clipped_away(f.BindPos, cut.on, f.ClipLimb, cut.detached, cut.plane, cut.noise, cut.noise_scale) {
            discard()
        }
        if wounds.count > 0 && wound_depth(f.BindPos, wounds.count, wounds.data) < wounds.core {
            discard()
        }
        return 0.0
    }
    place(s)
    gpu.hand_on(s, "wound_depth", "p")
    gpu.hand_on(s, "clipped_away", "bind_pos")
    return s
}

// ── The pick pass's shaders (#865) ───────────────────────────────────────
//
// What is at a pixel, asked of the GPU: the scene's surfaces drawn again
// from the camera into a target that holds, in place of colour, which model
// each pixel is, which of its instances, and how deep. A model is placed and
// posed as the lit pass places and poses it (the draw's block is the same),
// and a pixel the lit pass would not draw -- a cut model's far side, a
// wound's core, a cutout's hole -- is not written either, so a skinned,
// instanced or alpha-tested surface answers for what is seen and not for its
// bind-pose bounds, which is all a ray on the CPU has.
//
// The target's four channels: the model's id (Draw.pick), the instance's
// index (0 for a model that is not instanced), the depth the rasteriser
// gives the pixel (0..1, as the scene's own) and 1 for covered: a pixel
// nothing wrote is all zeros. Floats hold whole numbers exactly to 2^24.

struct PickVertex {
    position: vec3
    uv: vec2
    normal: vec3
    instance_model: mat4
    joints: vec4
    weights: vec4
}

struct PickPlainVertex {
    position: vec3
    uv: vec2
    normal: vec3
    instance_model: mat4
}

// What the pick pixel shader reads: the surface's place and uv for its
// cutout, the bind position its cut is made in, and the instance.
struct PickVaryings {
    position: vec4
    fragTexCoord: vec2
    Normal: vec3
    FragPos: vec3
    BindPos: vec3
    ClipLimb: float
    Instance: float
}

pick_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("pick_vertex") quote | v: PickVertex | {
        clip_limb = clip_limb_of(v.joints, v.weights, draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        model_matrix = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        posed0 = vec4(v.position, 1.0)
        posed = posed0
        posed_normal = v.normal
        if draw.skinned != 0 {
            skin_now = add_m4(add_m4(add_m4(mul_fm4(v.weights.x, skin.bones[int_of(v.joints.x)]),
                                            mul_fm4(v.weights.y, skin.bones[int_of(v.joints.y)])),
                                     mul_fm4(v.weights.z, skin.bones[int_of(v.joints.z)])),
                              mul_fm4(v.weights.w, skin.bones[int_of(v.joints.w)]))
            posed = mul(skin_now, posed0)
            posed_normal = mul_m3(skin_now, v.normal)
        }
        frag_pos = xyz(mul(model_matrix, posed))
        normal_out = normalize(mul_m3(model_matrix, posed_normal))
        clip_now = mul(mul_m4(eye.view_projection, model_matrix), posed)
        return PickVaryings { position: clip_now, fragTexCoord: v.uv, Normal: normal_out, FragPos: frag_pos,
                              BindPos: v.position, ClipLimb: clip_limb, Instance: float_of(instance_index()) }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

// The plain pipelines' (no skin stream): its joints and weights none.
pick_plain_vertex(draw: Draw, cut: Cut, skin: Skin, eye: Eye) -> *GpuShader {
    s = vertex("pick_plain_vertex") quote | v: PickPlainVertex | {
        clip_limb = clip_limb_of(splat4(0.0), splat4(0.0), draw.skinned, cut.joints0, cut.joints1, cut.joints2)
        model_matrix = if (draw.instanced != 0) { mul_m4(draw.model, v.instance_model) } else { draw.model }
        posed0 = vec4(v.position, 1.0)
        posed = posed0
        posed_normal = v.normal
        if draw.skinned != 0 {
            weights = splat4(0.0)
            joints = splat4(0.0)
            skin_now = add_m4(add_m4(add_m4(mul_fm4(weights.x, skin.bones[int_of(joints.x)]),
                                            mul_fm4(weights.y, skin.bones[int_of(joints.y)])),
                                     mul_fm4(weights.z, skin.bones[int_of(joints.z)])),
                              mul_fm4(weights.w, skin.bones[int_of(joints.w)]))
            posed = mul(skin_now, posed0)
            posed_normal = mul_m3(skin_now, v.normal)
        }
        frag_pos = xyz(mul(model_matrix, posed))
        normal_out = normalize(mul_m3(model_matrix, posed_normal))
        clip_now = mul(mul_m4(eye.view_projection, model_matrix), posed)
        return PickVaryings { position: clip_now, fragTexCoord: v.uv, Normal: normal_out, FragPos: frag_pos,
                              BindPos: v.position, ClipLimb: clip_limb, Instance: float_of(instance_index()) }
    }
    place(s)
    vertex_hand_on(s)
    return s
}

// The pick pixel: lit_pixel's discards (the cut, the wounds, the texture's
// cutout) and nothing of its shading, then the id. A blended surface counts
// where it is at least half opaque.
pick_pixel(draw: Draw, material: DrawMaterial, cut: Cut, wounds: Wounds, eye: Eye, colour_map: Texture) -> *GpuShader {
    s = gpu.fragment("pick") quote | f: PickVaryings | {
        if clipped_away(f.BindPos, cut.on, f.ClipLimb, cut.detached, cut.plane, cut.noise, cut.noise_scale) {
            discard()
        }
        wound_at = if (wounds.count > 0) { wound_depth(f.BindPos, wounds.count, wounds.data) } else { 2.0 }
        if wound_at < wounds.core {
            discard()
        }
        tri = Tri { weights: vec3(0.0, 1.0, 0.0), x: splat2(0.0), y: splat2(0.0), z: splat2(0.0) }
        hx = Hex { uv0: splat2(0.0), uv1: splat2(0.0), uv2: splat2(0.0), turn0: mat2_of(1.0, 0.0, 0.0, 1.0),
                   turn1: mat2_of(1.0, 0.0, 0.0, 1.0), turn2: mat2_of(1.0, 0.0, 0.0, 1.0), dx: splat2(0.0),
                   dy: splat2(0.0), weights: vec3(1.0, 0.0, 0.0) }
        tex_colour = splat4(0.0)
        if material.triplanar > 0.0 {
            tri = tri_setup(normalize(f.Normal), f.FragPos, material.triplanar)
            tex_colour = tri_texture(colour_map, tri)
        } else if material.tile_breakup > 0.0 {
            hx = hex_setup(f.fragTexCoord, material.tile_rotation)
            tex_colour = hex_texture(colour_map, hx).colour
        } else {
            tex_colour = texture(colour_map, f.fragTexCoord)
        }
        if tex_colour.w < material.cutout {
            discard()
        }
        if material.blend != 0 && tex_colour.w * material.alpha < 0.5 {
            discard()
        }
        ndc = mul(eye.view_projection, vec4(f.FragPos, 1.0))
        return vec4(vec3(float_of(draw.pick), f.Instance, clip_depth(ndc.z / ndc.w)), 1.0)
    }
    place(s)
    gpu.hand_on(s, "tri_setup", "position")
    gpu.hand_on(s, "tri_setup", "metres")
    gpu.hand_on(s, "hex_setup", "uv")
    gpu.hand_on(s, "hex_setup", "rotation")
    gpu.hand_on(s, "tri_texture", "tex")
    gpu.hand_on(s, "hex_texture", "tex")
    gpu.hand_on(s, "wound_depth", "p")
    gpu.hand_on(s, "clipped_away", "bind_pos")
    return s
}
