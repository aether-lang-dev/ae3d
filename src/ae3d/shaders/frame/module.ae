// ae3d.shaders.frame: what a mesh shader written with `quote` reads of the
// frame it is drawn in, as structs it captures (step 6, the scene block in
// docs/aether_quote_design.md section 11). The scene block every
// hand-written shader shares is split by what changes together; these three
// are set once a frame:
//
//   - Eye: the camera's: the view-projection the frame is drawn through (jittered),
//     last frame's unjittered one, the inverse a stored depth is turned back
//     into a world position by, where the eye is and how far it sees, the
//     jitter, the size of the frame in pixels, and whether the camera's depth
//     was captured for a surface to read;
//   - KeyLight: the light the scene is shaded and shadowed by, a sun's
//     direction pointing at it (zero for a lamp, whose position is used);
//   - Weather: the fog (on, from where to where, its light, how thick) and
//     the sky's overcast, which a surface mirroring the sky shows;
//   - Shadow: the light space a shadow map is drawn in and read through
//     (the cascade's, or a lamp's face while it is drawn), and how far from
//     where a figure may stand and still cast into it (shadowReach: xyz the
//     lamp, w the reach, 0 for everywhere). Set for each map drawn.
//
// place() tells ae3d.gpu where each field a shader reads is in its cell, by
// the names the shader captures them as. Each field is the scene block
// uniform it was (uniform_of, by the struct: eye, key, weather), so a
// renderer still filling that block
// copies a frame's values word for word (gpu.set_field_words) until the
// last shader reading it has moved; the Lights (Light[16]) and the cascades
// come with the scene shader.

import ae3d.gpu
import ae3d.gpu (GpuShader, GpuLayout)
import ae3d.shaderlib (vec2, vec3, vec4, mat4)

exports (Eye, KeyLight, Weather, Shadow, ShadowCascades, Grid, Probes, WorldLight, WorldState, SCENE_SETS, MAX_LIGHTS, place, place_shadow,
         fields, field_of, uniform_of, view_layout, world_layout, view_count, view_uniform, view_capture, view_field,
         world_count, world_uniform, world_capture, world_field, light_count, light_uniform, light_field)

// The scene's descriptor sets on Vulkan, which a shader drawn beside them
// has its own after: the draw's (0), the camera's (1) and the world's (2).
const SCENE_SETS = 3

struct Eye {
    view_projection: mat4
    prev_view_projection: mat4
    inv_view_projection: mat4
    position: vec3
    far: float
    jitter: vec2
    screen_size: vec2
    depth_on: int
    // The scene's (step 6): the view's depth plane (a point's depth along
    // the view is dot(xyz, p) + w), whether the occlusion map holds last
    // frame's, what a capture reads back instead of the lit picture, how far
    // from the eye a pixel is traced and the frame's number for the rays.
    depth_plane: vec4
    history: int
    capture: int
    ray_reach: float
    ray_frame: int
}

// The camera's shadow (ae3d.cascades, #469): whether the key light is
// shadowed by cascades this frame, their matrices (Vulkan's clip correction
// in them), the view depth each ends at, the world one texel of each
// covers, and how many there are. Fitted to the view, so the camera's.
struct ShadowCascades {
    on: int
    matrices: mat4[4]
    splits: vec4
    texel_world: vec4
    count: int
}

// The light grid cut from the view (ae3d.lightgrid, #468): columns, rows,
// slices and cells; near, far, the log scale and bias; the view-projection
// it was cut with; and the lamps given shadows by their distance from the
// eye (ae3d.lampshadows, #490): where their slots start in the lamps' data,
// and the key light's slot when it is a lamp (-1 for neither).
struct Grid {
    dims: vec4
    depth: vec4
    view_projection: mat4
    lamp_base: int
    key_lamp: int
}

// The probes round the eye (#537, ae3d.vkddgi), where the device traces:
// whether they are on, their grid, each cascade's first cell, their
// spacing and the atlases' sizes.
struct Probes {
    on: int
    dims: vec4
    base: vec4[2]
    spacing: vec4
    atlas: vec4
}

// A light that reaches everywhere: the key light and the directional fills
// (ae3d.core's Light, as the scene shades by it). A lamp of the clusters
// is one too, made from its words.
struct WorldLight {
    position: vec3
    colour: vec3
    intensity: float
    temperature: float
    kind: int
    direction: vec3
    constant: float
    linear: float
    quadratic: float
    cos_outer: float
    cos_inner: float
}

const MAX_LIGHTS = 16

// The world as every view sees it: its lights (the key light first), the
// way the key light's shadow was drawn, the clouds over it, the time, the
// rain on it, and the renderer's settings that hold for every view (how
// strong the normal maps and the baked occlusion are, the global
// illumination off, the rays on, the sun's size, the occlusion and the
// lamps' faces by ray).
struct WorldState {
    lights: WorldLight[16]
    light_count: int
    shadow_direction: vec3
    cloud_cover: float
    cloud_time: float
    cloud_sun: vec3
    time: float
    wetness: float
    normal_strength: float
    occlusion_strength: float
    gi_off: int
    rays: int
    sun_angle: float
    ray_occlusion: float
    ray_occlusion_strength: float
    ray_lamp_radius: float
}

struct KeyLight {
    position: vec3
    direction: vec3
    colour: vec3
    intensity: float
}

struct Weather {
    fog: int
    fog_start: float
    fog_end: float
    fog_radiance: vec3
    fog_intensity: float
    overcast: float
    overcast_colour: vec3
}

struct Shadow {
    light_space: mat4
    reach: vec4
}

// The structs, each field, and the scene block uniform it was.
const EYE_FIELDS[] = ["view_projection", "prev_view_projection", "inv_view_projection", "position", "far", "jitter",
                         "screen_size", "depth_on"]
const EYE_UNIFORMS[] = ["viewProjection", "prevViewProjection", "invViewProjection", "viewPos", "viewDistance",
                           "jitter", "screenSize", "hasSceneDepth"]
const KEY_FIELDS[] = ["position", "direction", "colour", "intensity"]
const KEY_UNIFORMS[] = ["lightPos", "lightDirection", "lightColor", "lightIntensity"]
const WEATHER_FIELDS[] = ["fog", "fog_start", "fog_end", "fog_radiance", "fog_intensity", "overcast", "overcast_colour"]
const WEATHER_UNIFORMS[] = ["enableFog", "fogStart", "fogEnd", "fogRadiance", "fogIntensity", "skyOvercast",
                            "skyOvercastColor"]
const SHADOW_FIELDS[] = ["light_space", "reach"]
const SHADOW_UNIFORMS[] = ["lightSpaceMatrix", "shadowReach"]

// How many fields the struct `capture` (eye, key, weather or shadow) has;
// 0 for a name that is not one.
fields(capture: string) -> int {
    if capture == "eye" { return 8 }
    if capture == "key" { return 4 }
    if capture == "weather" { return 7 }
    if capture == "shadow" { return 2 }
    return 0
}

field_of(capture: string, k: int) -> string {
    if capture == "eye" { return EYE_FIELDS[k] }
    if capture == "key" { return KEY_FIELDS[k] }
    if capture == "shadow" { return SHADOW_FIELDS[k] }
    return WEATHER_FIELDS[k]
}

uniform_of(capture: string, k: int) -> string {
    if capture == "eye" { return EYE_UNIFORMS[k] }
    if capture == "key" { return KEY_UNIFORMS[k] }
    if capture == "shadow" { return SHADOW_UNIFORMS[k] }
    return WEATHER_UNIFORMS[k]
}

// Where each field of the frame's three captures is in its cell, for the
// shader `s`, which names them `eye`, `key` and `weather` ("" for one it
// does not capture; a capture it does not have is passed over too).
place(s: *GpuShader, eye: string, key: string, weather: string) {
    _a = gpu.capture_field(s, eye, "view_projection", offsetof(Eye, view_projection))
    _b = gpu.capture_field(s, eye, "prev_view_projection", offsetof(Eye, prev_view_projection))
    _c = gpu.capture_field(s, eye, "inv_view_projection", offsetof(Eye, inv_view_projection))
    _d = gpu.capture_field(s, eye, "position", offsetof(Eye, position))
    _e = gpu.capture_field(s, eye, "far", offsetof(Eye, far))
    _f = gpu.capture_field(s, eye, "jitter", offsetof(Eye, jitter))
    _g = gpu.capture_field(s, eye, "screen_size", offsetof(Eye, screen_size))
    _h = gpu.capture_field(s, eye, "depth_on", offsetof(Eye, depth_on))
    _i = gpu.capture_field(s, key, "position", offsetof(KeyLight, position))
    _j = gpu.capture_field(s, key, "direction", offsetof(KeyLight, direction))
    _k = gpu.capture_field(s, key, "colour", offsetof(KeyLight, colour))
    _l = gpu.capture_field(s, key, "intensity", offsetof(KeyLight, intensity))
    _m = gpu.capture_field(s, weather, "fog", offsetof(Weather, fog))
    _n = gpu.capture_field(s, weather, "fog_start", offsetof(Weather, fog_start))
    _o = gpu.capture_field(s, weather, "fog_end", offsetof(Weather, fog_end))
    _p = gpu.capture_field(s, weather, "fog_radiance", offsetof(Weather, fog_radiance))
    _q = gpu.capture_field(s, weather, "fog_intensity", offsetof(Weather, fog_intensity))
    _r = gpu.capture_field(s, weather, "overcast", offsetof(Weather, overcast))
    _t = gpu.capture_field(s, weather, "overcast_colour", offsetof(Weather, overcast_colour))
}

// Where each field of a Shadow is in its cell, for the shader `s`, which
// names it `shadow` ("" when it does not capture one).
place_shadow(s: *GpuShader, shadow: string) {
    _a = gpu.capture_field(s, shadow, "light_space", offsetof(Shadow, light_space))
    _b = gpu.capture_field(s, shadow, "reach", offsetof(Shadow, reach))
}

// ── The scene's camera and world blocks (step 6) ─────────────────────────
//
// The scene's uniforms are three blocks (ae3d.vkdesc): the draw's
// (ae3d.shaders.lit), the camera's and the world's. A camera's is its Eye,
// ShadowCascades, Grid and Probes; the world's its WorldState and Weather. Each field
// is the scene block uniform it was (view_uniform, world_uniform: the name
// the renderer writes it by, ae3d.vkscene's), so OpenGL sets it by that name
// and Vulkan writes it at its place in the block. A second camera is a
// second camera block, bound in the first one's place; nothing else changes.

const VIEW_UNIFORMS[] = ["viewProjection", "prevViewProjection", "invViewProjection", "viewPos", "viewDistance",
                         "jitter", "screenSize", "hasSceneDepth", "viewDepth", "occlusionHistory",
                         "captureChannel", "rayReach", "rayFrame",
                         "hasShadowMap", "cascadeMatrices", "cascadeSplits", "cascadeTexelWorld", "cascadeCount",
                         "clusterDims", "clusterDepth", "clusterViewProjection", "lampShadowBase", "keyLampSlot",
                         "ddgiOn", "ddgiDims", "ddgiBase", "ddgiSpacing", "ddgiAtlas"]
const VIEW_CAPTURES[] = ["eye", "eye", "eye", "eye", "eye",
                         "eye", "eye", "eye", "eye", "eye",
                         "eye", "eye", "eye",
                         "cascades", "cascades", "cascades", "cascades", "cascades",
                         "grid", "grid", "grid", "grid", "grid",
                         "probes", "probes", "probes", "probes", "probes"]
const VIEW_FIELDS[] = ["view_projection", "prev_view_projection", "inv_view_projection", "position", "far",
                       "jitter", "screen_size", "depth_on", "depth_plane", "history",
                       "capture", "ray_reach", "ray_frame",
                       "on", "matrices", "splits", "texel_world", "count",
                       "dims", "depth", "view_projection", "lamp_base", "key_lamp",
                       "on", "dims", "base", "spacing", "atlas"]
const VIEW_TYPES[] = ["mat4", "mat4", "mat4", "vec3", "float",
                      "vec2", "vec2", "int", "vec4", "int",
                      "int", "float", "int",
                      "int", "mat4[4]", "vec4", "vec4", "int",
                      "vec4", "vec4", "mat4", "int", "int",
                      "int", "vec4", "vec4[2]", "vec4", "vec4"]
const VIEW_COUNT = 28

const WORLD_UNIFORMS[] = ["lights", "lightCount", "shadowDirection", "cloudCover", "cloudTime", "cloudSun",
                          "causticsTime", "wetness", "normalStrength", "occlusionStrength", "giOff", "rayShadows",
                          "sunAngle", "rayOcclusion", "rayOcclusionStrength", "rayLampRadius",
                          "enableFog", "fogStart", "fogEnd", "fogRadiance", "fogIntensity"]
const WORLD_CAPTURES[] = ["world", "world", "world", "world", "world", "world",
                          "world", "world", "world", "world", "world", "world",
                          "world", "world", "world", "world",
                          "weather", "weather", "weather", "weather", "weather"]
const WORLD_FIELDS[] = ["lights", "light_count", "shadow_direction", "cloud_cover", "cloud_time", "cloud_sun",
                        "time", "wetness", "normal_strength", "occlusion_strength", "gi_off", "rays",
                        "sun_angle", "ray_occlusion", "ray_occlusion_strength", "ray_lamp_radius",
                        "fog", "fog_start", "fog_end", "fog_radiance", "fog_intensity"]
const WORLD_TYPES[] = ["WorldLight[16]", "int", "vec3", "float", "float", "vec3",
                       "float", "float", "float", "float", "int", "int",
                       "float", "float", "float", "float",
                       "int", "float", "float", "vec3", "float"]
const WORLD_COUNT = 21

// A Light's fields, and the hand-written Light's members they were.
const LIGHT_FIELDS[] = ["position", "colour", "intensity", "temperature", "kind", "direction", "constant", "linear",
                        "quadratic", "cos_outer", "cos_inner"]
const LIGHT_UNIFORMS[] = ["position", "color", "intensity", "temperature", "isDirectional", "direction",
                          "constantAtten", "linearAtten", "quadraticAtten", "spotCosOuter", "spotCosInner"]
const LIGHT_TYPES[] = ["vec3", "vec3", "float", "float", "int", "vec3", "float", "float", "float", "float", "float"]
const LIGHT_COUNT = 11

view_count() -> int { return VIEW_COUNT }
view_uniform(k: int) -> string { return VIEW_UNIFORMS[k] }
view_capture(k: int) -> string { return VIEW_CAPTURES[k] }
view_field(k: int) -> string { return VIEW_FIELDS[k] }
world_count() -> int { return WORLD_COUNT }
world_uniform(k: int) -> string { return WORLD_UNIFORMS[k] }
world_capture(k: int) -> string { return WORLD_CAPTURES[k] }
world_field(k: int) -> string { return WORLD_FIELDS[k] }
light_count() -> int { return LIGHT_COUNT }
light_uniform(k: int) -> string { return LIGHT_UNIFORMS[k] }
light_field(k: int) -> string { return LIGHT_FIELDS[k] }

var g_view_layout: ptr = null
var g_world_layout: ptr = null

// The camera's block: its Eye, ShadowCascades, Grid and Probes, every field typed
// and placed in its struct's cell. Made once, kept for the program.
view_layout() -> *GpuLayout {
    if g_view_layout != null { return g_view_layout as *GpuLayout }
    l = gpu.layout_new("CameraBlock")
    _e = gpu.layout_struct(l, "eye", "Eye")
    _c = gpu.layout_struct(l, "cascades", "ShadowCascades")
    _g = gpu.layout_struct(l, "grid", "Grid")
    _p = gpu.layout_struct(l, "probes", "Probes")
    k = 0
    while k < VIEW_COUNT {
        _f = gpu.layout_field(l, VIEW_CAPTURES[k], VIEW_FIELDS[k], view_offset(k), VIEW_TYPES[k])
        k = k + 1
    }
    g_view_layout = l as ptr
    return l
}

// Where the camera block's field `k` is in its struct's cell.
fn view_offset(k: int) -> int {
    c = VIEW_CAPTURES[k]
    f = VIEW_FIELDS[k]
    if c == "eye" {
        if f == "view_projection" { return offsetof(Eye, view_projection) }
        if f == "prev_view_projection" { return offsetof(Eye, prev_view_projection) }
        if f == "inv_view_projection" { return offsetof(Eye, inv_view_projection) }
        if f == "position" { return offsetof(Eye, position) }
        if f == "far" { return offsetof(Eye, far) }
        if f == "jitter" { return offsetof(Eye, jitter) }
        if f == "screen_size" { return offsetof(Eye, screen_size) }
        if f == "depth_on" { return offsetof(Eye, depth_on) }
        if f == "depth_plane" { return offsetof(Eye, depth_plane) }
        if f == "history" { return offsetof(Eye, history) }
        if f == "capture" { return offsetof(Eye, capture) }
        if f == "ray_reach" { return offsetof(Eye, ray_reach) }
        return offsetof(Eye, ray_frame)
    }
    if c == "cascades" {
        if f == "on" { return offsetof(ShadowCascades, on) }
        if f == "matrices" { return offsetof(ShadowCascades, matrices) }
        if f == "splits" { return offsetof(ShadowCascades, splits) }
        if f == "texel_world" { return offsetof(ShadowCascades, texel_world) }
        return offsetof(ShadowCascades, count)
    }
    if c == "grid" {
        if f == "dims" { return offsetof(Grid, dims) }
        if f == "depth" { return offsetof(Grid, depth) }
        if f == "view_projection" { return offsetof(Grid, view_projection) }
        if f == "lamp_base" { return offsetof(Grid, lamp_base) }
        return offsetof(Grid, key_lamp)
    }
    if f == "on" { return offsetof(Probes, on) }
    if f == "dims" { return offsetof(Probes, dims) }
    if f == "base" { return offsetof(Probes, base) }
    if f == "spacing" { return offsetof(Probes, spacing) }
    return offsetof(Probes, atlas)
}

// The world's block: its WorldState (the lights an array of WorldLight) and Weather.
world_layout() -> *GpuLayout {
    if g_world_layout != null { return g_world_layout as *GpuLayout }
    l = gpu.layout_new("WorldBlock")
    _w = gpu.layout_struct(l, "world", "WorldState")
    _f = gpu.layout_struct(l, "weather", "Weather")
    k = 0
    while k < WORLD_COUNT {
        _a = gpu.layout_field(l, WORLD_CAPTURES[k], WORLD_FIELDS[k], world_offset(k), WORLD_TYPES[k])
        k = k + 1
    }
    k = 0
    while k < LIGHT_COUNT {
        _p = gpu.layout_element_field(l, "world", "lights", sizeof(WorldLight), LIGHT_FIELDS[k], light_offset(k), LIGHT_TYPES[k])
        k = k + 1
    }
    g_world_layout = l as ptr
    return l
}

fn world_offset(k: int) -> int {
    f = WORLD_FIELDS[k]
    if WORLD_CAPTURES[k] == "weather" {
        if f == "fog" { return offsetof(Weather, fog) }
        if f == "fog_start" { return offsetof(Weather, fog_start) }
        if f == "fog_end" { return offsetof(Weather, fog_end) }
        if f == "fog_radiance" { return offsetof(Weather, fog_radiance) }
        return offsetof(Weather, fog_intensity)
    }
    if f == "lights" { return offsetof(WorldState, lights) }
    if f == "light_count" { return offsetof(WorldState, light_count) }
    if f == "shadow_direction" { return offsetof(WorldState, shadow_direction) }
    if f == "cloud_cover" { return offsetof(WorldState, cloud_cover) }
    if f == "cloud_time" { return offsetof(WorldState, cloud_time) }
    if f == "cloud_sun" { return offsetof(WorldState, cloud_sun) }
    if f == "time" { return offsetof(WorldState, time) }
    if f == "wetness" { return offsetof(WorldState, wetness) }
    if f == "normal_strength" { return offsetof(WorldState, normal_strength) }
    if f == "occlusion_strength" { return offsetof(WorldState, occlusion_strength) }
    if f == "gi_off" { return offsetof(WorldState, gi_off) }
    if f == "rays" { return offsetof(WorldState, rays) }
    if f == "sun_angle" { return offsetof(WorldState, sun_angle) }
    if f == "ray_occlusion" { return offsetof(WorldState, ray_occlusion) }
    if f == "ray_occlusion_strength" { return offsetof(WorldState, ray_occlusion_strength) }
    return offsetof(WorldState, ray_lamp_radius)
}

fn light_offset(k: int) -> int {
    f = LIGHT_FIELDS[k]
    if f == "position" { return offsetof(WorldLight, position) }
    if f == "colour" { return offsetof(WorldLight, colour) }
    if f == "intensity" { return offsetof(WorldLight, intensity) }
    if f == "temperature" { return offsetof(WorldLight, temperature) }
    if f == "kind" { return offsetof(WorldLight, kind) }
    if f == "direction" { return offsetof(WorldLight, direction) }
    if f == "constant" { return offsetof(WorldLight, constant) }
    if f == "linear" { return offsetof(WorldLight, linear) }
    if f == "quadratic" { return offsetof(WorldLight, quadratic) }
    if f == "cos_outer" { return offsetof(WorldLight, cos_outer) }
    return offsetof(WorldLight, cos_inner)
}
