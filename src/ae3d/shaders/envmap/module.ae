// ae3d.shaders.envmap: a user's environment map as the scene's sky light
// (#869), written with `quote`.
//
// The sky is captured each frame into an octahedral map (ae3d.shaders.skyprobe,
// ae3d.skylight), and the irradiance and the GGX-prefiltered reflections are
// made from that capture. With an environment map in place of the sky the
// capture is not drawn from the sky model but read from the map, once, and
// everything after it -- the mips, the irradiance, the prefiltered levels, the
// split-sum table, the probes' sky -- is the sky's own path unchanged.
//
// env_capture: each texel of the 256-texel octahedral level 0 (the same
// texel-to-direction rule as the sky's capture, gutter and folds included)
// reads the equirectangular map in that direction, with the longitude
// u = (atan2(z, x) + pi) / 2 pi and the latitude v = (asin(y) + pi/2) / pi
// the painted sky uses, so a picture sits in the world the way a painted sky
// does, its rows stored bottom first. Wrapping in u is the sampler's (repeat),
// so the seam at -x is no seam; v is held a half texel in from the poles. A
// map of many texels is read from a mip chosen for the octahedral texel's
// share of the sphere (`lod`, from the map's width), so a bright small sun
// spreads over the texels it belongs to and does not alias.
//
//   env        the map, RGB(A) light in the engine's units, a mip chain
//   lod        the mip level to read
//   half_v     half a texel of the map's height in v, 0.5 / height
//   intensity  a scale on the light (1 for the map as it is)
//   yaw        the map turned about up by this many radians, in the sense the
//              camera's yaw turns: a feature of the map at azimuth a (the
//              atan2(z, x) of its direction) is seen at azimuth a + yaw. 0 is
//              the map as placed above (Nic, 875-6: one uniform).
//
// Light, not a colour: there is no display curve in it, a value of 1 is the
// engine's radiance 1.

import std.quote
import ae3d.gpu (GpuShader, fragment)
import ae3d.shaders.skyprobe (oct_texel_direction)
import ae3d.shaderlib (vec2, vec3, vec4, Texture, frag_coord, rgb, asin, atan2, clamp, max_v3, splat3, texture_lod)

exports (env_capture, equirect_uv)

// Where direction d is in an equirectangular map turned by `yaw` radians,
// (u, v) with v up.
@quotable
equirect_uv(d: vec3, half_v: float, yaw: float) -> vec2 {
    u = (atan2(d.z, d.x) + 3.14159265 - yaw) / 6.28318531
    v = (asin(clamp(d.y, -1.0, 1.0)) + 1.57079633) / 3.14159265
    return vec2(u, clamp(v, half_v, 1.0 - half_v))
}

env_capture(env: Texture, lod: float, half_v: float, intensity: float, yaw: float) -> *GpuShader {
    return fragment("env_capture") quote | uv_in: vec2 | {
        fc = frag_coord()
        dir = oct_texel_direction(vec2(fc.x / 256.0, fc.y / 256.0), 256.0)
        light = rgb(texture_lod(env, equirect_uv(dir, half_v, yaw), lod))
        return vec4(max_v3(light * intensity, splat3(0.0)), 1.0)
    }
}
