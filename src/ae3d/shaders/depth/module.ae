// ae3d.shaders.depth: the passes over the scene's depth, written with `quote`.
//
// depth_copy is the scene's depth copied into the camera-depth target that
// the occlusion, the reflection and the water read, when the frame has one
// sample: each pixel's depth, as the scene's depth image holds it, unfiltered.
// It was shaders/module.ae's FRAGMENT_DEPTH_COPY.
//
// depth_resolve is the same for a frame with more samples: of each pixel's
// samples, the nearest (the least depth), so what the passes after it read
// is in front of anything a sample saw. It was FRAGMENT_DEPTH_RESOLVE.
//
// It is a depth fragment shader (gpu.depth_fragment): what the quote returns
// is the pixel's depth, written to gl_FragDepth, and it has no colour. It
// reads its pixel by frag_coord() (gl_FragCoord.xy) and texel_fetch()
// (texelFetch; texel_fetch_ms for the multisampled one), not by the uv it
// is given, since a copy is pixel for pixel.
//
//   depth    the scene's depth image (multisampled, for depth_resolve)
//   samples  depth_resolve: how many samples it has

import std.quote
import ae3d.gpu (GpuShader, depth_fragment)
import ae3d.shaderlib (vec2, vec4, Texture, TextureMS, frag_coord, texel_fetch, texel_fetch_ms, min)

exports (depth_copy, depth_resolve)

depth_copy(depth: Texture) -> *GpuShader {
    return depth_fragment("depth_copy") quote | uv: vec2 | {
        return texel_fetch(depth, frag_coord()).x
    }
}

depth_resolve(depth: TextureMS, samples: int) -> *GpuShader {
    return depth_fragment("depth_resolve") quote | uv: vec2 | {
        nearest = 1.0
        s = 0
        while s < samples {
            nearest = min(nearest, texel_fetch_ms(depth, frag_coord(), s).x)
            s = s + 1
        }
        return nearest
    }
}
