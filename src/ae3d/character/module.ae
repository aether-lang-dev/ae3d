// A character (#903): a moving, aiming, looking person in a few lines, the
// way Unity's Animator and CharacterController read together.
//
//     hero = character.humanoid(e, "Hero", "people/mannequin.glb", character.gaits("people/100style/neutral"))
//     character.move(hero, velocity, facing)      // every frame, from the game
//     character.look(hero, point)
//     character.aim(hero, target)
//
// Under it, set up as a person needs, the pipeline's own parts, each still
// the game's to reach (character.animator, mover, feet):
//   - the figure (ae3d.figure) and its animator;
//   - locomotion from motion capture read by a name's prefix: `prefix`_fw,
//     _bw, _sw, _fr, _br and _sr (walks and runs ahead, back and to the
//     side; each side's mirror for the other) as one 2D blend by velocity,
//     each a loop on its axis; a start (`prefix`_start) played by the
//     distance gone, a stop (`prefix`_stop) and its mirror played by the
//     distance left, the one entering with its feet where the figure's are;
//     the stand at the stop's end. Retargeted onto the figure, feet kept.
//     Or, given a database of whole captures (match_add), motion matching
//     over it in their place; or a graph of states read from a file
//     (graphed, ae3d.animgraph), its blends driven by the mover's
//     parameters;
//   - a capsule to move by where there is physics (a CharacterController);
//   - a mover (ae3d.mover): the velocity and facing a game asks for followed
//     on springs, the figure moved by them, the graph's parameters written;
//   - feet locked on the ground and stepping as it turns on the spot
//     (ikrig), on the physics' static world when there is one;
//   - eyes ahead where it goes, or on what it is told to look at;
//   - an aim offset over the spine from a file's pistol aims (aims), on a
//     ready pose (the level aim over the upper body) while it aims.
// The showcase's figure on a stick was 96 lines and 56 calls across seven
// modules; through this it is the three above.

import std.heap
import std.list
import std.os
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.ikrig
import ae3d.mover
import ae3d.bvh
import ae3d.usable
import ae3d.animgraph
import ae3d.physanim
import ae3d.motion
import ae3d.items

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

exports (
    Character, Gaits, gaits, gaits_set, gaits_free, GAIT_FW, GAIT_BW, GAIT_SW, GAIT_FR, GAIT_BR, GAIT_SR, GAIT_START, GAIT_STOP, GAIT_STAND,
    humanoid, graphed, graph_of, character_free, capsule_off, match_add, matching, use_takes, use, leave, using, pause, resume, paused, seated, use_phase, use_contact, use_enter_state,
    USE_NONE, USE_GO, USE_TURN, USE_ENTER, USE_LOOP, USE_EXIT, move, look, look_ahead, look_free, aim, aim_off, aims,
    act, act_stop, acting, ACT_OUT, swing, get_up_add, get_up, get_up_waiting, room_to_rise, get_up_count, get_up_state, get_up_cost, set_avoidance, avoiding, set_ledges, project_goal, hit, physical, physanim_of, animator_of, mover_of, feet_of, object_of, idle_state, move_state, standing, error,
    die, dead, DEATH_FALL, STATE_FLOATS, state_write, state_read, knock, knocked, down, shove, staggering, STAGGER_MOST, STAGGER_BASE, STAGGER_PER, STAGGER_SWAY
)

// Seconds a character's look and aim ease on and off.
const EASE = 0.4
// How far ahead it looks, metres, and how high over its feet.
const LOOK_AHEAD = 6.0
const EYE_HIGH = 1.6
// How much the stick's way through its stop the mover takes to brake by.
const FACING_HALF_LIFE = 0.6
// Seconds either side of where a stop or a start would enter it searches for
// the entry whose feet match (animator.transition_match).
const STOP_WINDOW = 0.5
const START_WINDOW = 0.3
// Seconds after it stands a stop's cut ends, and the stand begins.
const STOP_AFTER = 0.3
// Of the speed its stop brakes from (clips.braking_speed), the fastest it is
// played from, and the mover brakes from: faster, the figure slows on its
// springs to that first, through its gaits (a run to a walk).
const STOP_SERVES = 1.25
// The most a figure setting off outpaces its start's take, times the take's
// own pace (mover.set_start_pace), as UE5's distance matching clamps a
// start's play rate. At 1.0 a figure stood up from an act and asked to walk
// off to its side went 0.86 m in 2 s (it walked off as slowly as the
// StartStop take's 0.72 m in its 1.3 s); at 1.25, 1.11 m, its fastest
// joint setting off 95% of the takes' own plus the easing's.
const START_PACE = 1.25
// The share of its fastest a start's walk-off is up to pace at: it ends at
// its first footfall from there (start_end).
const START_NEAR_PEAK = 0.9
// Seconds of a capture's calmest stretch a stand is cut from.
const STAND_SECONDS = 2.5
// Metres a second under which a frame of a database is taken to stand.
const STOOD = 0.1
// Metres a character's capsule is round, and how far it reaches over the
// top of its head joint.
const CAPSULE_RADIUS = 0.3
const HEAD_TOP = 0.12

struct Character {
    object: ptr                    // *GameObject
    animator: ptr                  // *Animator
    mover: ptr                     // *Mover
    feet: ptr                      // *Feet
    idle: int                      // its states
    walk: int
    start: int
    stop: int
    stop_m: int
    idle_m: int                    // the stand, mirrored
    start_m: int
    aim: int                       // its aim offset, -1 none
    ready: int                     // the level aim over its upper body, -1 none
    asked: Vec3                    // the velocity asked, the world's
    facing: Vec3                   // the way asked to face, or none (zero): the way it goes
    looking: bool                  // told where to look
    eyes_free: bool                // no look at all: the take's own head (look_free)
    look_at: Vec3
    aiming: bool
    target: Vec3
    engine: ptr                    // *Engine
    use_source: ptr                // a string.keep reference: the file a slot's takes are read from (use_takes), or null
    use_names: ptr                 // ptr[USE_TAKES]: the takes made into states, by name
    use_states: ptr                // int[USE_TAKES]: and their states
    use_count: int
    use_u: ptr                     // *Usables of the slot in use
    use_slot: int
    use_phase: int                 // USE_NONE to USE_EXIT
    use_t: float                   // seconds in the phase
    use_enter: int                 // the slot's states
    use_loop: int
    use_exit: int
    use_contact: float             // the enter take's time its part lands at
    leaving: bool
    paused: bool                   // held by something else (pause): the mover, look and aim left alone
    act_state: int                 // the state act plays once, -1 none
    acting: bool
    matcher: int                   // its database's matcher state (match_add), -1 none
    match_built: bool
    capsule: ptr                   // *CharacterController it made itself, or null
    gaits: ptr                     // *Gaits whose shared takes its states play, or null
    avoid_off: bool                // it does not steer round others (set_avoidance)
    avoid_weight: float            // how much of a meeting it takes on (1: half, as each of two does)
    steered: Vec3                  // the velocity it steered to last step
    steered_known: bool
    physanim: ptr                  // *Physanim put on at its first blow (hit), or null
    get_ups: ptr                   // int[GET_UPS]: the get-up states it chooses among (get_up_add)
    get_up_count: int
    planned: ptr                   // *Planned: its get-up's hand-over (get_up), made at its first
    getting_up: bool               // its act is a get-up (get_up): its head the take's own
    up_paths: ptr                  // ptr[GET_UPS]: each get-up's way, sampled about its object (way_of)
    up_path_n: ptr                 // int[GET_UPS]: how many samples each
    up_index: int                  // the get-up it plays, its place in get_ups; -1 none
    up_at: Vec3                    // where its first frame was laid (lay_onto) and the way it faced
    up_facing: Vec3
    up_waiting: bool               // told to get up, waiting for room (get_up)
    up_motion: ptr                 // *Motion it lies in while it waits
    up_blend: float                // the blend it was told
    up_waited: float               // seconds it has waited
    up_look: float                 // seconds to its next look for room
    up_shift: Vec3                 // the way up laid this far off the body (choose_get_up)
    up_blocked: bool               // no room to stand up at all at its last look (room_to_rise): waits past WAIT_MOST
    up_into: float                 // metre-seconds its best way went into what is near, at its last look (way_overlap)
    graph: ptr                     // *Graph read from a file (graphed), or null
    stepper: ptr                   // *Behaviour: its step in the engine's loop
    dead: bool                     // died (die): a ragdoll for good
    knocked: bool                  // knocked down (knock) and not yet up again
    staggering: bool               // stepping out a shove (shove)
    stagger_v: Vec3                // the velocity the shove gave the whole body, level
    stagger_t: float               // seconds into the stagger, and how long it lasts
    stagger_for: float
    stagger_face: float            // the yaw it faced as it was shoved, held through the stagger
}

var g_error: string = ""

// What the last humanoid that failed said.
error() -> string { return g_error }

// --- gaits ------------------------------------------------------------------------------------------

// The captures a humanoid moves by, one file each role: walks and runs ahead,
// back and to the side, a start, a stop, and a stand. gaits(prefix) names
// them `prefix`_fw.bvh, _bw, _sw, _fr, _br, _sr, _start and _stop (the stand
// from the stop's end); gaits_set changes one. A style's own stop may be a
// poor one (100STYLE's neutral style has none that is straight: its stop,
// cut from its idles, slides its planted foot 17 cm), so a stop from another
// style can be given.
struct Gaits {
    paths: ptr                     // ptr[GAIT_ROLES]: string.keep references
    figures: ptr                   // ptr[room]: the figure files its takes were made for (string.keep)
    made: ptr                      // ptr[room]: each one's GAIT_TAKES takes (a ptr[]), the gaits' own
    figure_count: int
    room: int
    users: int                     // characters made on its takes and not yet freed
    released: bool                 // let go of by the game (gaits_free): freed with its last user
}

// The takes a character's gaits come to (make_gait_takes), in order: the
// stand; the forward, back and side walk, the side walk's mirror, the
// forward, back and side run and its mirror; the start and its mirror, the
// stop and its mirror; the stand's mirror. Made once for each figure file
// a character of the gaits wears, and shared by every character of it
// (animator.share_take): a camp of 20 settlers read and retargeted every
// capture 20 times (#944).
const GAIT_TAKES = 14

const GAIT_FW = 0
const GAIT_BW = 1
const GAIT_SW = 2
const GAIT_FR = 3
const GAIT_BR = 4
const GAIT_SR = 5
const GAIT_START = 6
const GAIT_STOP = 7
const GAIT_STAND = 8
const GAIT_ROLES = 9

gaits(prefix: string) -> *Gaits {
    g = heap.new(Gaits)
    g.paths = calloc(GAIT_ROLES, 8)
    suffixes = ["_fw", "_bw", "_sw", "_fr", "_br", "_sr", "_start", "_stop", "_stop"]
    k = 0
    while k < GAIT_ROLES {
        path = "${prefix}${suffixes[k]}.bvh"
        (g.paths as ptr[])[k] = string.keep(path)
        k = k + 1
    }
    return g
}

// Role `role`'s capture read from `path` instead. Set before the gaits'
// first character: the takes made from the old capture are let go.
gaits_set(g: *Gaits, role: int, path: string) {
    if g == null || role < 0 || role >= GAIT_ROLES { return }
    string.release_kept((g.paths as ptr[])[role])
    (g.paths as ptr[])[role] = string.keep(path)
    gaits_unmade(g)
}

// The gaits let go of, and the takes made from them: after every character
// on them (their takes are the gaits', shared by those characters).
// Let go of by the game. The takes its characters share stay while any of
// them is still made (gaits_states holds a use, character_free lets it
// go): freed at once, as a game may well free them once its characters
// are made, every character on them sampled freed takes (the showcase's
// stick figure and swordsman crashed on their first frame since #944).
gaits_free(g: *Gaits) {
    if g == null { return }
    g.released = true
    if g.users > 0 { return }
    gaits_free_now(g)
}

// A character's use of its gaits' takes let go of; the gaits freed with the
// last, once the game has let them go.
gaits_drop(g: *Gaits) {
    if g == null { return }
    g.users = g.users - 1
    if g.users <= 0 && g.released { gaits_free_now(g) }
}

gaits_free_now(g: *Gaits) {
    k = 0
    while k < GAIT_ROLES {
        string.release_kept((g.paths as ptr[])[k])
        k = k + 1
    }
    free(g.paths)
    gaits_unmade(g)
    if g.figures != null { free(g.figures) }
    if g.made != null { free(g.made) }
    heap.free(g)
}

// The takes made for each figure let go of.
gaits_unmade(g: *Gaits) {
    k = 0
    while k < g.figure_count {
        string.release_kept((g.figures as ptr[])[k])
        free_takes((g.made as ptr[])[k], GAIT_TAKES)
        k = k + 1
    }
    g.figure_count = 0
}

// The first `count` takes of a ptr[] of them freed, and the array.
free_takes(takes: ptr, count: int) {
    k = 0
    while k < count {
        t = (takes as ptr[])[k]
        if t != null { clips.take_free(t as *Take) }
        k = k + 1
    }
    free(takes)
}

// The gaits' takes for the figure file `figure`, on rig `r`: made the first
// time a character of it asks, kept for the rest. Null when a capture cannot
// be read (error() says which).
gait_takes(g: *Gaits, figure: string, r: *pose.Rig) -> ptr {
    k = 0
    while k < g.figure_count {
        known, _why = string.from_ptr((g.figures as ptr[])[k])
        if string.equals(known, figure) == 1 { return (g.made as ptr[])[k] }
        k = k + 1
    }
    takes = make_gait_takes(g, r)
    if takes == null { return null }
    if g.figure_count >= g.room {
        room = g.room * 2
        if room < 4 { room = 4 }
        figures = calloc(room, 8) as ptr[]
        made = calloc(room, 8) as ptr[]
        k = 0
        while k < g.figure_count {
            figures[k] = (g.figures as ptr[])[k]
            made[k] = (g.made as ptr[])[k]
            k = k + 1
        }
        if g.figures != null { free(g.figures) }
        if g.made != null { free(g.made) }
        g.figures = figures as ptr
        g.made = made as ptr
        g.room = room
    }
    (g.figures as ptr[])[g.figure_count] = string.keep(figure)
    (g.made as ptr[])[g.figure_count] = takes
    g.figure_count = g.figure_count + 1
    return takes
}

// The GAIT_TAKES takes, in their order, made on rig `r` from the gaits'
// captures: each read and retargeted, cut and looped as the graph plays it,
// the side gaits, the start, the stop and the stand mirrored. Null when a
// capture cannot be read.
make_gait_takes(g: *Gaits, r: *pose.Rig) -> ptr {
    takes = calloc(GAIT_TAKES, 8) as ptr[]
    // The stand: the capture's calmest STAND_SECONDS (clips.calmest), a
    // loop. Cut where its root first stood still, 100STYLE's neutral stand
    // began as its actor lifted its arms out to 78 degrees, and the figure
    // stood with them held out like a gorilla.
    stood = gait_capture(r, gait_path(g, GAIT_STAND))
    if stood == null {
        free_takes(takes as ptr, 0)
        return null
    }
    calm = clips.calmest(stood, r, STAND_SECONDS)
    from = (calm * clips.rate(stood)) as int
    to = ((calm + STAND_SECONDS) * clips.rate(stood)) as int
    if to > clips.frames(stood) - 1 { to = clips.frames(stood) - 1 }
    standing = clips.crop(stood, r, from, to, false)
    idle_t = clips.loop_cut(standing, r)
    clips.take_free(standing)
    clips.take_free(stood)
    takes[0] = idle_t as ptr
    // The gaits, each a loop on its axis; the side ones mirrored too.
    roles = [GAIT_FW, GAIT_BW, GAIT_SW, GAIT_FR, GAIT_BR, GAIT_SR]
    sides = [false, false, true, false, false, true]
    at = 1
    k = 0
    while k < 6 {
        t = gait_capture(r, gait_path(g, roles[k]))
        if t == null {
            free_takes(takes as ptr, GAIT_TAKES)
            return null
        }
        clips.straighten(t, r, true)
        looped = clips.loop_cut(t, r)
        clips.take_free(t)
        clips.straighten(looped, r, true)
        takes[at] = looped as ptr
        at = at + 1
        mirrored = null as ptr
        if sides[k] {
            mirrored = clips.mirror(looped, r) as ptr
            takes[at] = mirrored
            at = at + 1
        }
        // Each loop's root at an even speed, its sway in its pose, as the
        // mover moves it (#970); the mirror its own, its sway its side's.
        clips.even_root(looped)
        if mirrored != null { clips.even_root(mirrored as *Take) }
        k = k + 1
    }
    // The start by the way come and the stop by the way left, cut about
    // where each moves off and comes to rest, and their mirrors.
    starting = gait_capture(r, gait_path(g, GAIT_START))
    if starting == null {
        free_takes(takes as ptr, GAIT_TAKES)
        return null
    }
    clips.straighten(starting, r, true)
    start_t = crop_start(r, starting, 0.3, 1.6)
    clips.take_free(starting)
    takes[9] = start_t as ptr
    takes[10] = clips.mirror(start_t, r) as ptr
    stopping = gait_capture(r, gait_path(g, GAIT_STOP))
    if stopping == null {
        free_takes(takes as ptr, GAIT_TAKES)
        return null
    }
    clips.straighten(stopping, r, true)
    stop_t = crop_about(r, stopping, 0.0 - 1.6, STOP_AFTER, false)
    clips.take_free(stopping)
    takes[11] = stop_t as ptr
    takes[12] = clips.mirror(stop_t, r) as ptr
    takes[13] = clips.mirror(idle_t, r) as ptr
    // Each compressed (#990), within clips.COMPRESS_ERROR of the skin, as
    // every character of the gaits samples it.
    k = 0
    while k < GAIT_TAKES {
        _err = clips.compress(takes[k] as *Take, r)
        k = k + 1
    }
    return takes as ptr
}

// The capture at `path` read and retargeted onto rig `r`, its root motion
// taken out (as animator.add_take takes it out): the caller's.
gait_capture(r: *pose.Rig, path: string) -> *Take {
    c = bvh.load(path, 0.0)
    if c == null {
        g_error = "cannot read ${path}: ${bvh.error()}"
        return null
    }
    made = bvh.take(c, path, 0, 0 - 1)
    t = retarget.retarget(bvh.rig(c), made, r)
    if t != null && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

gait_path(g: *Gaits, role: int) -> string {
    text, _why = string.from_ptr((g.paths as ptr[])[role])
    return text
}

// A person: the figure in the glTF file at `path` named `name`, on its
// gaits read from the captures `prefix`_fw.bvh and the rest (see the top),
// or, `g` null, on a database given by match_add before its first step.
// At `scale` of its file's size (its object scaled so before anything is
// made from it): its capsule, its gaits' strides and its feet all at that
// size. Made at its file's size and scaled after, a figure kept a capsule and
// gaits for the size it was made at (Siltreach's people, scaled to 1.75 m,
// #943). Null when the file or a capture cannot be read (error() says
// which).
humanoid(e: *Engine, name: string, path: string, g: *Gaits, scale: float = 1.0) -> *Character {
    g_error = ""
    o = figure.figure(e, name, path)
    if o == null {
        g_error = "cannot read ${path}"
        return null
    }
    if scale != 1.0 { behaviour.object_set_scale(o, core.vec3(scale, scale, scale)) }
    a = animator.attach(e, o)
    r = animator.rig(a)
    c = heap.new(Character)
    c.object = o as ptr
    c.animator = a as ptr
    c.aim = 0 - 1
    c.engine = e as ptr
    c.use_names = calloc(USE_TAKES, 8)
    c.use_states = calloc(USE_TAKES, 4)
    c.get_ups = calloc(GET_UPS, 4)
    c.up_paths = calloc(GET_UPS, 8)
    c.up_path_n = calloc(GET_UPS, 4)
    c.up_index = 0 - 1
    c.ready = 0 - 1
    c.matcher = 0 - 1
    c.idle = 0 - 1
    c.idle_m = 0 - 1
    c.walk = 0 - 1
    c.start = 0 - 1
    c.start_m = 0 - 1
    c.stop = 0 - 1
    c.act_state = 0 - 1
    c.stop_m = 0 - 1
    // Its gaits' takes are its file's at its scale: the same file at another
    // size is another set.
    if g != null && !gaits_states(c, g, "${path} x${scale}") { return failed(c) }
    feet = ikrig.feet_new(r, o)
    if physics.of(e) != null { ikrig.feet_ground_physics(feet, physics.of(e)) }
    ikrig.feet_set_steps(feet, true)
    animator.set_feet(a, feet)
    c.feet = feet as ptr
    // Its file's own spring bones (a VRM's hair, skirt, bust) on as its
    // maker set them (#989); more by animator.springs_of.
    animator.springs_from_file(a)
    // A capsule to move by where there is physics, as Unity's Animator goes
    // with a CharacterController: a wall stops it, a stair lifts it (the
    // mover's springs and the takes' root motion both move it by its
    // capsule), as tall as the figure.
    if physics.of(e) != null && physics.character_of(o) == null {
        c.capsule = physics.character_controller(o, CAPSULE_RADIUS * scale, standing_height(r, o)) as ptr
        // A person keeps to the ground it walks on: it stops at a ledge, or
        // walks along it, unless let over it (set_ledges) (#981).
        physics.character_set_ledges(c.capsule as *CharacterController, false)
    }
    m = mover.mover_new(a, o)
    if c.stop >= 0 {
        mover.set_braking(m, clips.braking(animator.state_take(a, c.stop)))
        mover.set_braking_below(m, STOP_SERVES * clips.braking_speed(animator.state_take(a, c.stop)))
    }
    // Set off at its start's own pace, as it stops at its stop's.
    if c.start >= 0 { mover.set_start_pace(m, START_PACE) }
    mover.set_half_lives(m, mover.HALF_LIFE, FACING_HALF_LIFE)
    c.mover = m as ptr
    if c.idle >= 0 { animator.play(a, c.idle, 0.0) }
    b = engine.behaviour_new("character", c as ptr)
    b.fixed_update = character_fixed
    engine.engine_add_behaviour(e, b)
    c.stepper = b as ptr
    c.avoid_weight = 1.0
    people_add(c)
    return c
}

// The gaits' states and the graph between them: the stand, the 2D blend,
// the starts and the stops, on the takes the gaits keep for the figure file
// `figure` (gait_takes), shared. False when a capture cannot be read.
gaits_states(c: *Character, g: *Gaits, figure: string) -> bool {
    a = c.animator as *Animator
    r = animator.rig(a)
    made = gait_takes(g, figure, r)
    if made == null { return false }
    // A use of its takes, let go of as the character is freed.
    g.users = g.users + 1
    c.gaits = g as ptr
    shared = calloc(GAIT_TAKES, 8) as ptr[]
    k = 0
    while k < GAIT_TAKES {
        s = animator.share_take(a, (made as ptr[])[k] as *Take, false)
        if s == null {
            g_error = "the gaits' takes were made for another rig than ${figure}'s"
            free(shared as ptr)
            return false
        }
        shared[k] = s as ptr
        k = k + 1
    }
    idle_t = shared[0] as *Take
    c.idle = animator.add_state(a, "idle", idle_t, true)
    // The gaits, each a loop on its axis, set in the space at its velocity.
    c.walk = animator.add_blend2(a, "move")
    k = 1
    while k <= 8 {
        t = shared[k] as *Take
        went = clips.travel(t, clips.duration(t))
        animator.blend_add2(a, c.walk, t, went.x / clips.duration(t), went.y / clips.duration(t))
        k = k + 1
    }
    animator.bind2(a, c.walk, "vx", "vz")
    // The start by the way come, the stop by the way left; each with its
    // mirror and the stand with its own, so whichever foot the figure has
    // down there is one whose feet match. A transition into any of them
    // enters where the feet match best (transition_match): a stop within
    // half a stride of where the distance left puts it, a stand anywhere
    // in its loop.
    // A start's distance come counted from its move-off, not its first
    // frame: the cut's stand before it is never raced through.
    c.start = animator.add_state(a, "start", shared[9] as *Take, false)
    animator.clock_by(a, c.start, "travelled", false)
    animator.clock_from(a, c.start, clips.moving_at(shared[9] as *Take, 0.1))
    c.start_m = animator.add_state(a, "start", shared[10] as *Take, false)
    animator.clock_by(a, c.start_m, "travelled", false)
    animator.clock_from(a, c.start_m, clips.moving_at(shared[10] as *Take, 0.1))
    stop_t = shared[11] as *Take
    c.stop = animator.add_state(a, "stop", stop_t, false)
    animator.clock_by(a, c.stop, "rest", true)
    c.stop_m = animator.add_state(a, "stop", shared[12] as *Take, false)
    animator.clock_by(a, c.stop_m, "rest", true)
    c.idle_m = animator.add_state(a, "idle", shared[13] as *Take, true)
    free(shared as ptr)
    stands = [c.idle, c.idle_m]
    starts = [c.start, c.start_m]
    stops = [c.stop, c.stop_m]
    k = 0
    while k < 2 {
        go = animator.add_transition(a, stands[k], c.start, 0.2)
        animator.transition_when(a, go, "go", animator.IS, 0.0)
        animator.transition_or(a, go, c.start_m)
        animator.transition_match(a, go, START_WINDOW)
        on = animator.add_transition(a, starts[k], c.walk, 0.3)
        animator.transition_when(a, on, "", animator.ENDED, 0.0)
        animator.transition_synced(a, on, true)
        rested = animator.add_transition(a, stops[k], c.idle, 0.3)
        animator.transition_when(a, rested, "", animator.ENDED, 0.0)
        animator.transition_or(a, rested, c.idle_m)
        animator.transition_match(a, rested, STOP_WINDOW)
        // A stop asked for while it starts.
        early = animator.add_transition(a, starts[k], c.idle, 0.3)
        animator.transition_when(a, early, "go", animator.IS_NOT, 0.0)
        animator.transition_when(a, early, "speed", animator.BELOW, 0.1)
        animator.transition_or(a, early, c.idle_m)
        animator.transition_match(a, early, STOP_WINDOW)
        k = k + 1
    }
    halt = animator.add_transition(a, c.walk, c.stop, 0.25)
    animator.transition_when(a, halt, "go", animator.IS_NOT, 0.0)
    animator.transition_when(a, halt, "rest", animator.BELOW, clips.travel_length(stop_t))
    // Stopped from the speeds its stop serves: from a run, slowed to them first.
    animator.transition_when(a, halt, "speed", animator.BELOW, STOP_SERVES * clips.braking_speed(stop_t) + 0.01)
    animator.transition_or(a, halt, c.stop_m)
    animator.transition_match(a, halt, STOP_WINDOW)
    return true
}

// A person on a graph of states read from a file (ae3d.animgraph): the
// figure in the glTF file at `path` named `name`, its takes, states, blends
// and transitions as the file at `graph` declares them (its own clips, or
// another file's retargeted), driven by the parameters its mover writes
// ("speed", "vx" and "vz", "go", "moving", "turning", "travelled",
// "rest"): a runner's walk, jog and sprint blended by speed. Its stand is
// the graph's state "idle", its moving one "move"; its feet, eyes, aim,
// capsule and use are humanoid's, and so is its `scale`. Null when either
// file cannot be read (error() says which, and where in the graph).
graphed(e: *Engine, name: string, path: string, graph: string, scale: float = 1.0) -> *Character {
    c = humanoid(e, name, path, null as *Gaits, scale)
    if c == null { return null }
    a = c.animator as *Animator
    gr = animgraph.load(a, graph)
    if gr == null {
        g_error = "${graph}: ${animgraph.error()}"
        character_free(c)
        return null
    }
    c.graph = gr as ptr
    c.idle = animgraph.state_of(gr, "idle")
    c.walk = animgraph.state_of(gr, "move")
    if c.idle >= 0 && animator.current(a) != c.idle { animator.play(a, c.idle, 0.0) }
    return c
}

// Its capsule taken off: the figure stands and goes where its mover and its
// takes put it, through anything. One stood with a foot up on a block its
// capsule would put it on top of, or one a game moves itself.
capsule_off(c: *Character) {
    if c.capsule == null { return }
    physics.character_free(c.capsule as *CharacterController)
    c.capsule = null
}

// A blow (#903): `impulse` (newton seconds) at `point` on the body named
// `bone` (physanim's: "Hips", "Spine", "Chest", "Neck", "ShoulderL",
// "ElbowL", "ThighL", "KneeL" and the right's; "" the body nearest
// `point`, as a ray's hit gives it). The figure's ragdoll (ae3d.physanim,
// put on it at its first blow where the engine has physics, or before by
// physical) takes the blow and is drawn from where it goes, then eased
// back onto the animation, the figure walking on as it was; and where its
// graph has a flinch for the
// part struck, a layer "hit_head" (the neck), "hit_legs" (a thigh or a
// knee) or "hit_chest" (the rest), that is played from its start over
// the figure, the others eased out. A hit reaction in Unreal is the same
// two: a physical blend on the struck bodies and an additive hit take.
// False when nothing could take it: no physics and no flinch.
hit(c: *Character, bone: string, point: Vec3, impulse: Vec3) -> bool {
    if c == null { return false }
    _bodied = physical(c)
    struck = ""
    // Dead, the blow moves the body and nothing plays.
    if c.dead {
        pa = c.physanim as *Physanim
        k = physanim.nearest(pa, point)
        if bone != "" { k = physanim.bone_named(pa, bone) }
        if k >= 0 { physanim.hit(pa, k, point, impulse) }
        return k >= 0
    }
    if c.physanim != null {
        pa = c.physanim as *Physanim
        k = physanim.nearest(pa, point)
        if bone != "" { k = physanim.bone_named(pa, bone) }
        if k >= 0 {
            physanim.hit(pa, k, point, impulse)
            struck = physics.humanoid_bone(k)
        }
    } else {
        struck = bone
    }
    return flinch(c, struck) || struck != ""
}

// The figure's physical animation, null before its first blow (hit) or
// where the engine has no physics.
physanim_of(c: *Character) -> *Physanim { return c.physanim as *Physanim }

// The figure's ragdoll put on it now (ae3d.physanim), where the engine has
// physics, rather than at its first blow: its bodies follow its animation
// (each at weight 0, drawn as the animation has it), so what sweeps for
// bodies meets them before anything has struck it. Put on at the first blow
// alone, an unhurt person had no bodies, and ae3d.items' edge, which meets
// only moving bodies, passed through it (#940). True when it has them.
physical(c: *Character) -> bool {
    if c == null { return false }
    e = c.engine as *Engine
    if c.physanim == null && physics.of(e) != null {
        c.physanim = physanim.attach(e, c.animator as *Animator) as ptr
        // A person's weight for its standing height, whatever it is doing
        // as it is made physical (seated, it measured shorter).
        o = c.object as *GameObject
        if c.physanim != null { physanim.set_mass(c.physanim as *Physanim, physics.person_mass(standing_height(animator.rig(c.animator as *Animator), o))) }
    }
    return c.physanim != null
}

// Seconds a death's muscles ease out over (die): a person going down holds
// itself a moment rather than dropping as a puppet whose strings are cut.
const DEATH_FALL = 0.3

// Its death (#859): the figure a full ragdoll for good, as UE5's death
// ragdoll and PuppetMaster's dead state make it. Every body let go from the
// pose drawn and moving as the animation moved it (physanim.go_limp: each
// body's velocity from its last two poses), its muscles holding that pose
// and easing out over `fall` seconds (0: at once); then the blow,
// `impulse` newton seconds at `at` on the body nearest it (none for a
// zero impulse). Its graph and its mover stop where they are (its animator
// paused, reading the figure back as the bodies draw it, the character
// paused), and it never gets up: get_up, act, resume refuse it. Its capsule
// stays where it stood but no longer blocks others (not solid) unless
// `keep_capsule`. Puts its ragdoll on it first where it has none
// (physical). False when it has no physics, is dead already, or its bodies
// are another writer's (a knockdown's motion).
die(c: *Character, impulse: Vec3, at: Vec3, fall: float = DEATH_FALL, keep_capsule: bool = false) -> bool {
    if c == null || c.dead || !physical(c) { return false }
    pa = c.physanim as *Physanim
    if physanim.released(pa) { return false }
    a = c.animator as *Animator
    // Killed while knocked down (knock): let go wholly already, it lies on
    // as it goes, a ragdoll for good.
    if c.knocked && physanim.limp(pa) {
        c.knocked = false
        c.acting = false
        c.getting_up = false
        c.up_waiting = false
        c.dead = true
        if core.v3_len(impulse) > 0.0 {
            k = physanim.nearest(pa, at)
            if k >= 0 { physanim.hit(pa, k, at, impulse) }
        }
        if !keep_capsule && c.capsule != null { physics.character_set_solid(c.capsule as *CharacterController, false) }
        return true
    }
    c.staggering = false
    c.acting = false
    c.getting_up = false
    c.up_waiting = false
    c.up_index = 0 - 1
    c.act_state = 0 - 1
    c.asked = core.vec3(0.0, 0.0, 0.0)
    c.paused = true
    animator.pause(a)
    if !physanim.go_limp(pa, fall) { return false }
    c.dead = true
    if core.v3_len(impulse) > 0.0 {
        k = physanim.nearest(pa, at)
        if k >= 0 { physanim.hit(pa, k, at, impulse) }
    }
    if !keep_capsule && c.capsule != null { physics.character_set_solid(c.capsule as *CharacterController, false) }
    return true
}

// Whether it has died (die).
dead(c: *Character) -> bool { return c != null && c.dead }

// Floats state_write writes.
const STATE_FLOATS = 48

// What the character itself carries from one step to the next, into `out`
// from `at` (float[STATE_FLOATS]): what it was asked (the velocity, the
// facing, the look, the aim), what it is doing (paused, an act, a get-up
// and where it was laid, dead) and the way it last steered. Its object,
// mover, animator and ragdoll have their own (ae3d.netanim's snapshot puts
// them together, #911). Returns where it ended.
state_write(c: *Character, out: float[], at: int) -> int {
    v = [c.asked.x, c.asked.y, c.asked.z, c.facing.x, c.facing.y, c.facing.z, flag_of(c.looking), flag_of(c.eyes_free), c.look_at.x, c.look_at.y,
         c.look_at.z, flag_of(c.aiming), c.target.x, c.target.y, c.target.z, flag_of(c.paused), c.act_state as float, flag_of(c.acting), c.steered.x, c.steered.y,
         c.steered.z, flag_of(c.steered_known), flag_of(c.getting_up), c.up_index as float, c.up_at.x, c.up_at.y, c.up_at.z, c.up_facing.x, c.up_facing.y, c.up_facing.z,
         flag_of(c.up_waiting), c.up_blend, c.up_waited, c.up_look, c.up_into, flag_of(c.dead), flag_of(c.leaving), flag_of(c.knocked), flag_of(c.staggering), c.stagger_v.x,
         c.stagger_v.y, c.stagger_v.z, c.stagger_t, c.stagger_for, c.stagger_face, 0.0, 0.0, 0.0]
    k = 0
    while k < STATE_FLOATS {
        out[at + k] = v[k]
        k = k + 1
    }
    return at + STATE_FLOATS
}

// A state state_write wrote, from `at`; returns where it ended.
state_read(c: *Character, s: float[], at: int) -> int {
    n = at
    c.asked = core.vec3(s[n], s[n + 1], s[n + 2])
    c.facing = core.vec3(s[n + 3], s[n + 4], s[n + 5])
    c.looking = s[n + 6] > 0.5
    c.eyes_free = s[n + 7] > 0.5
    c.look_at = core.vec3(s[n + 8], s[n + 9], s[n + 10])
    c.aiming = s[n + 11] > 0.5
    c.target = core.vec3(s[n + 12], s[n + 13], s[n + 14])
    c.paused = s[n + 15] > 0.5
    c.act_state = s[n + 16] as int
    c.acting = s[n + 17] > 0.5
    c.steered = core.vec3(s[n + 18], s[n + 19], s[n + 20])
    c.steered_known = s[n + 21] > 0.5
    c.getting_up = s[n + 22] > 0.5
    c.up_index = s[n + 23] as int
    c.up_at = core.vec3(s[n + 24], s[n + 25], s[n + 26])
    c.up_facing = core.vec3(s[n + 27], s[n + 28], s[n + 29])
    c.up_waiting = s[n + 30] > 0.5
    c.up_blend = s[n + 31]
    c.up_waited = s[n + 32]
    c.up_look = s[n + 33]
    c.up_into = s[n + 34]
    c.dead = s[n + 35] > 0.5
    c.leaving = s[n + 36] > 0.5
    // Knocked down (knock) or stepping out a shove (shove).
    c.knocked = s[n + 37] > 0.5
    c.staggering = s[n + 38] > 0.5
    c.stagger_v = core.vec3(s[n + 39], s[n + 40], s[n + 41])
    c.stagger_t = s[n + 42]
    c.stagger_for = s[n + 43]
    c.stagger_face = s[n + 44]
    return at + STATE_FLOATS
}

flag_of(b: bool) -> float {
    if b { return 1.0 }
    return 0.0
}

// Seconds a knockdown's muscles ease out over once it has landed (knock).
const KNOCK_EASE = 0.3

// Knocked down (#861): from whatever it was doing to a physical fall on
// its own bodies (physanim.knock), powered as it goes down, its legs giving
// and, with `protect`, its hands reaching for the ground and its head
// tucked; landed, its muscles eased out and a ragdoll until it lies still
// (down); then up again by get_up (with no motion: get_up(c, null, blend)),
// as UE's and Unity's knockdowns go: ragdoll, rest, get-up. The blow,
// `impulse` newton seconds at `at`, on body `bone` (physanim's names; ""
// the body nearest `at`). Its graph and its mover stop where they are (its
// animator paused, reading the figure back as its bodies draw it, the
// character paused) until it is up. Knocked again while down, the blow
// alone. No ae3d.motion in it: its state is the figure's bodies and
// physanim's own. Puts its ragdoll on it first where it has none
// (physical). False when it has no physics, is dead, uses a slot, or its
// bodies are another writer's.
//
// The reach is not on by default. Over 24 blows (test_balance) it brought
// the head down at 1.44 m/s on average against 1.68 without it and 2.22 for
// the full ragdoll at once, and the trunk at 1.15 against 2.56 and 1.76;
// but over test_knockdowns' 100 knockdowns one (seed 26) landed with a hand
// under its body, and the get-up's hand-over drew a finger 25.8 cm under
// the floor and a joint 27.7 rad/s past the clip's own. Without it every
// bound held, as with ae3d.motion LIMP.
knock(c: *Character, impulse: Vec3, at: Vec3, protect: bool = false, bone: string = "") -> bool {
    if c == null || c.dead || c.use_phase != USE_NONE || !physical(c) { return false }
    pa = c.physanim as *Physanim
    if physanim.released(pa) { return false }
    k = physanim.nearest(pa, at)
    if bone != "" { k = physanim.bone_named(pa, bone) }
    if physanim.limp(pa) {
        if k >= 0 { physanim.hit(pa, k, at, impulse) }
        return k >= 0
    }
    a = c.animator as *Animator
    c.staggering = false
    c.acting = false
    c.getting_up = false
    c.up_waiting = false
    c.up_index = 0 - 1
    c.act_state = 0 - 1
    c.asked = core.vec3(0.0, 0.0, 0.0)
    c.paused = true
    animator.pause(a)
    if !physanim.knock(pa, KNOCK_EASE, protect) { return false }
    c.knocked = true
    if k >= 0 && core.v3_len(impulse) > 0.0 { physanim.hit(pa, k, at, impulse) }
    return true
}

// Whether it is knocked down (knock) and not yet up again.
knocked(c: *Character) -> bool { return c != null && c.knocked }

// Whether, knocked down, it has landed and lies still: ready to get up.
down(c: *Character) -> bool { return c != null && c.knocked && physanim.down(c.physanim as *Physanim) }

// A shove (#861): `impulse` newton seconds at `at` on body `bone` ("" the
// body nearest `at`), answered as a person answers one. Within what its
// catch steps take (the speed it gives the whole body, its level share over
// the figure's mass, no more than STAGGER_MOST), it staggers: that speed
// asked of its mover on top of what the game asks, easing out over
// STAGGER_BASE plus STAGGER_PER a metre a second of it, held facing as it
// faced, so its gaits step it out, each step under where its body is going
// (a step back, aside, or a quicker one ahead), its feet planted between
// them. Put on the mover at once instead (its springs' velocity set), the
// gaits' blend jumped with it, a calf was drawn turning 53 rad/s and a
// planted toe slid 7 mm (test_balance). The bodies struck sway with
// STAGGER_SWAY of the blow (physanim.hit) and ease back, the trunk going
// first and the feet stepping after it, as a person's do; the legs stay on
// the animation, their feet as it and its IK put them (#1000).
// Past it, it is knocked down (knock). Held by something
// else (acting, using a slot, paused), the blow alone (hit). False as hit
// and knock are.
const STAGGER_MOST = 1.5
const STAGGER_BASE = 0.4
const STAGGER_PER = 0.4
const STAGGER_SWAY = 0.35

shove(c: *Character, impulse: Vec3, at: Vec3, bone: string = "") -> bool {
    if c == null || c.dead || !physical(c) { return false }
    pa = c.physanim as *Physanim
    if physanim.released(pa) || physanim.limp(pa) { return knock(c, impulse, at, false, bone) }
    if c.paused || c.acting || c.use_phase != USE_NONE { return hit(c, bone, at, impulse) }
    v = core.v3_mul(core.vec3(impulse.x, 0.0, impulse.z), 1.0 / physanim.mass(pa))
    if c.staggering { v = core.v3_add(v, stagger_left(c)) }
    if core.v3_len(v) > STAGGER_MOST { return knock(c, impulse, at, false, bone) }
    k = physanim.nearest(pa, at)
    if bone != "" { k = physanim.bone_named(pa, bone) }
    if k >= 0 { physanim.hit(pa, k, at, core.v3_mul(impulse, STAGGER_SWAY)) }
    if !c.staggering { c.stagger_face = mover.facing_of(c.mover as *Mover) }
    c.stagger_v = v
    c.stagger_t = 0.0
    c.stagger_for = STAGGER_BASE + STAGGER_PER * core.v3_len(v)
    c.staggering = true
    return true
}

// What is left of a stagger's speed now.
stagger_left(c: *Character) -> Vec3 {
    if !c.staggering || c.stagger_for <= 0.0 { return core.vec3(0.0, 0.0, 0.0) }
    u = core.clampf(c.stagger_t / c.stagger_for, 0.0, 1.0)
    return core.v3_mul(c.stagger_v, 1.0 - u * u * (3.0 - 2.0 * u))
}

// Whether it is stepping out a shove (shove).
staggering(c: *Character) -> bool { return c != null && c.staggering }

const FLINCH_OUT = 0.2

// The graph's flinch for body `struck` played from its start, the other
// flinches eased out. False when the graph has none for it.
flinch(c: *Character, struck: string) -> bool {
    gr = c.graph as *Graph
    if gr == null { return false }
    a = c.animator as *Animator
    wanted = "hit_chest"
    if string.equals(struck, "Neck") == 1 { wanted = "hit_head" }
    if string.starts_with(struck, "Thigh") == 1 || string.starts_with(struck, "Knee") == 1 { wanted = "hit_legs" }
    names = ["hit_chest", "hit_head", "hit_legs"]
    played = false
    i = 0
    while i < 3 {
        layer = animgraph.layer_of(gr, names[i])
        if layer >= 0 {
            if string.equals(names[i], wanted) == 1 {
                animator.layer_restart(a, layer)
                animator.layer_weight(a, layer, 1.0, 0.0)
                played = true
            } else {
                animator.layer_weight(a, layer, 0.0, FLINCH_OUT)
            }
        }
        i = i + 1
    }
    return played
}

// The graph a graphed character was read from, its parts by name; null for
// one on gaits or a database.
graph_of(c: *Character) -> *Graph { return c.graph as *Graph }

failed(c: *Character) -> *Character {
    if g_error == "" { g_error = "a capture could not be read" }
    character_free(c)
    return null
}

// The capture at `path` retargeted onto `a`'s figure, its feet kept and its
// root motion taken out; the animator's. Null (and error() says which)
// when it cannot be read.
captured(a: *Animator, path: string) -> *Take {
    c = bvh.load(path, 0.0)
    if c == null {
        g_error = "cannot read ${path}: ${bvh.error()}"
        return null
    }
    made = bvh.take(c, path, 0, 0 - 1)
    t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, animator.rig(a)), true)
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

// Take `t` cut from `from` to `to` seconds about its root's first move (or,
// not `around_move`, its first stand after its fastest): a new take, the
// caller's.
crop_about(r: *pose.Rig, t: *Take, from: float, to: float, around_move: bool) -> *Take {
    mark = clips.moving_at(t, 0.1)
    if !around_move { mark = clips.still_at(t, 0.1) }
    a0 = ((mark + from) * clips.rate(t)) as int
    b0 = ((mark + to) * clips.rate(t)) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    return clips.crop(t, r, a0, b0, false)
}

// Start take `t` cut from `before` seconds before its root's first move to
// where its walk-off is up to pace (start_end), at most `after` seconds
// after the move: a new take, the caller's.
crop_start(r: *pose.Rig, t: *Take, before: float, after: float) -> *Take {
    mark = clips.moving_at(t, 0.1)
    a0 = ((mark - before) * clips.rate(t)) as int
    b0 = (start_end(t, mark, after) * clips.rate(t) + 0.5) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    return clips.crop(t, r, a0, b0, false)
}

// Where start take `t`, moving off at `mark` seconds, ends: at its first
// footfall once its root is within START_NEAR_PEAK of the fastest it goes
// in the `after` seconds from its move (its walk-off up to pace), else
// `after` seconds on. A take of starts and stops in a row slows into its
// next stop after its peak: 100STYLE's StartStop start peaks at 0.47 m/s
// 0.65 s after its move-off and is down to 0.14 m/s 1.6 s after it, and
// kept to its pace (mover.set_start_pace) the figure slowed with it, handed
// over to its walk at 0.23 m/s, and a planted toe skated 20 mm in the
// walk's blend (#937). Ended at its left footfall 0.52 s after its
// move-off, at 0.44 m/s, it hands over with that step in the air, the walk
// landing it, and no toe skates 1 mm. Handed over at the footfall itself
// instead (the take ended 0.3 s after it), the landing played in the start
// skated 5.2 to 6.0 mm.
start_end(t: *Take, mark: float, after: float) -> float {
    last = mark + after
    if last > clips.duration(t) { last = clips.duration(t) }
    peak = 0.0
    at = mark
    while at <= last {
        v = clips.speed_at(t, at)
        if v > peak { peak = v }
        at = at + 1.0 / clips.rate(t)
    }
    up = mark
    while up < last && clips.speed_at(t, up) < START_NEAR_PEAK * peak { up = up + 1.0 / clips.rate(t) }
    k = 0
    while k < clips.event_count(t) {
        e = clips.event_time(t, k)
        foot = string.equals(clips.event_name(t, k), clips.FOOT_LEFT) == 1 || string.equals(clips.event_name(t, k), clips.FOOT_RIGHT) == 1
        if foot && e >= up && e <= last { return e }
        k = k + 1
    }
    return last
}

// How tall the figure stands: its head joint's height in its rest pose over
// its feet, and HEAD_TOP at the figure's scale.
standing_height(r: *pose.Rig, o: *GameObject) -> float {
    w = pose.new(r)
    pose.rest_world(r, w)
    high = clips.ground_point(r, pose.translation(w, pose.human(r, pose.HEAD))).y - behaviour.object_position(o).y
    pose.release(w)
    return high + HEAD_TOP * behaviour.object_scale(o).y
}

character_free(c: *Character) {
    if c == null { return }
    people_remove(c)
    // Out of the engine's loop first, as an animator is: freed while the
    // engine runs, its step would read freed memory.
    if c.stepper != null {
        engine.engine_remove_behaviour(c.engine as *Engine, c.stepper as *Behaviour)
        heap.free(c.stepper as *Behaviour)
    }
    // Its physical animation before the animator it steps after.
    if c.physanim != null { physanim.physanim_free(c.physanim as *Physanim) }
    if c.capsule != null { physics.character_free(c.capsule as *CharacterController) }
    k = 0
    while k < c.use_count {
        string.release_kept((c.use_names as ptr[])[k])
        k = k + 1
    }
    free(c.use_names)
    free(c.use_states)
    free(c.get_ups)
    k = 0
    while k < c.get_up_count {
        free((c.up_paths as ptr[])[k])
        k = k + 1
    }
    free(c.up_paths)
    free(c.up_path_n)
    planned_free(c.planned as *Planned)
    if c.use_source != null { string.release_kept(c.use_source) }
    if c.mover != null { mover.mover_free(c.mover as *Mover) }
    if c.graph != null { animgraph.graph_free(c.graph as *Graph) }
    // The animator it attached, with the feet, hands and look it set on it.
    if c.animator != null { animator.animator_free(c.animator as *Animator) }
    // Its use of its gaits' takes let go of, after the animator playing them.
    if c.gaits != null { gaits_drop(c.gaits as *Gaits) }
    heap.free(c)
}

// --- moving by a database (#906) --------------------------------------------------------------------

// The capture at `path` (BVH, gzip'd or not) read whole into the character's
// database, and its mirror when `mirrored`: motion matching, as UE5's Pose
// Search database under its Motion Matching node. Once it has one, the
// character moves by the frame of it whose pose and way ahead best match
// the mover's (animator.add_matcher), the figure carried by the takes' own
// root motion (mover.set_follow), in place of its gaits' blend, starts and
// stops; its look, aim and use are the same. Built at its first step after
// the last is added. False when the file cannot be read (error() says why).
match_add(c: *Character, path: string, mirrored: bool) -> bool {
    a = c.animator as *Animator
    t = captured(a, path)
    if t == null { return false }
    if c.matcher < 0 { c.matcher = animator.add_matcher(a, "match") }
    animator.matcher_add(a, c.matcher, t)
    if mirrored { animator.matcher_add(a, c.matcher, animator.add_take(a, clips.mirror(t, animator.rig(a)), false)) }
    c.match_built = false
    return true
}

// Whether it moves by a database (match_add).
matching(c: *Character) -> bool { return c.matcher >= 0 }

// The database built and played, the mover asking it for the way ahead.
match_start(c: *Character) {
    a = c.animator as *Animator
    m = c.mover as *Mover
    animator.matcher_build(a, c.matcher)
    mover.set_matcher(m, c.matcher)
    mover.set_follow(m, true)
    mover.settle(m)
    if c.use_phase == USE_NONE { animator.play(a, c.matcher, 0.3) }
    c.match_built = true
}

// What it stands and moves in when it does nothing else: its database, or
// its stand.
rest_state(c: *Character) -> int {
    if c.matcher >= 0 { return c.matcher }
    return c.idle
}

// --- asking -----------------------------------------------------------------------------------------

// Go at `velocity` (the world's, over the ground, metres a second), facing
// `facing` (level; zero to face the way it goes). Every frame, from the game.
// Held by something else (ae3d.motion's fall and get-up, a cutscene): the
// character leaves its object, its mover and its capsule alone, and asks
// for no look or aim, until resume. Stepped on through it, a figure's mover
// walked its object on at the last speed asked, under the body a fall held
// (Siltreach's settlers, #942).
pause(c: *Character) {
    if c == null { return }
    c.paused = true
}

// Its own again, standing at `at` facing `facing` (level; none keeps the
// object's own), where the body that held it left it: the object put there,
// the mover settled on it at rest, nothing asked, and the feet planted
// afresh where they are drawn (ikrig.feet_reset), as Unity's
// CharacterController is put where a ragdoll got up before it is enabled
// again.
resume(c: *Character, at: Vec3, facing: Vec3) {
    if c == null || c.dead { return }
    o = c.object as *GameObject
    behaviour.object_set_position(o, at)
    level = core.vec3(facing.x, 0.0, facing.z)
    if core.v3_len(level) > 0.0001 { behaviour.object_set_rotation(o, core.quat_rotate(core.atan2_of(level.x, level.z), core.vec3(0.0, 1.0, 0.0))) }
    c.asked = core.vec3(0.0, 0.0, 0.0)
    c.facing = core.vec3(0.0, 0.0, 0.0)
    mover.settle(c.mover as *Mover)
    if c.feet != null { ikrig.feet_reset(c.feet as *Feet) }
    c.paused = false
}

// Whether it is paused.
paused(c: *Character) -> bool { return c != null && c.paused }

// Play graph state `state` once, eased in over `blend` seconds (#958): a
// knock-down, a stagger, a death, any action between its gaits. Its root
// motion moves the figure through its capsule (a wall stops it), and the
// mover is left alone meanwhile, whatever is asked. At its end (a take that
// does not loop), at act_stop, or when the graph's own transitions take it
// out of the state, the character takes up its stand where it got to, the
// mover settled there: as UE's PlayAnimMontage on a Character moves the
// capsule by the montage's root motion and goes back to locomotion. Paused
// and resumed around it by hand, a game had to get that order right itself.
// A state with no take (a snapshot, animator.snapshot: a body lying where it
// fell between a knock-down and its get-up) is held until act_stop or the
// next act: knocked down, out for a while and up again are three acts.
// False while it uses a slot (the use holds it), or for no such state.
act(c: *Character, state: int, blend: float) -> bool {
    if c == null || c.dead || state < 0 || c.use_phase != USE_NONE { return false }
    a = c.animator as *Animator
    if state >= animator.state_count(a) { return false }
    c.acting = true
    c.getting_up = false
    c.up_waiting = false
    c.up_index = 0 - 1
    c.act_state = state
    animator.set_root_motion(a, true)
    animator.play(a, state, blend)
    return true
}

// Its act ended now, its stand taken up over `blend` seconds.
act_stop(c: *Character, blend: float) {
    if c == null || !c.acting { return }
    a = c.animator as *Animator
    animator.set_root_motion(a, false)
    animator.play(a, rest_state(c), blend)
    mover.settle(c.mover as *Mover)
    c.acting = false
    c.getting_up = false
    c.up_waiting = false
    c.up_index = 0 - 1
    c.act_state = 0 - 1
}

// Swing `which` of held item `it` with the whole body (#945), at `rate`
// times the rate its weight gives, eased in over `blend`: its take played as
// an act, so a step-in moves the figure by the take's root motion through its
// capsule (a wall stops it), the mover left alone meanwhile, and the stand
// taken up where it got to; its edge swept for hits as items.swing's is.
// Played in place (items.swing), a step-in's feet slid under a figure that
// stayed put. A swing over a gait is items.swing_over. False when the item
// is not held, the figure has no such take, or it uses a slot.
swing(c: *Character, it: *Item, which: int, rate: float, blend: float) -> bool {
    if c == null || c.use_phase != USE_NONE { return false }
    state = items.swing_ready(it, which, rate)
    if state < 0 { return false }
    return act(c, state, blend)
}

// Whether it is still playing its act.
acting(c: *Character) -> bool { return c != null && c.acting }

// Seconds a finished act's stand is eased in over.
const ACT_OUT = 0.3

// Its act played on: ended at its take's end, or once the graph has left it.
act_step(c: *Character) -> bool {
    if !c.acting { return false }
    a = c.animator as *Animator
    t = animator.state_take(a, c.act_state)
    over = animator.current(a) != c.act_state
    if !over && t != null && !clips.looping(t) && animator.state_time(a) >= clips.duration(t) - 0.0001 { over = true }
    if over { act_stop(c, ACT_OUT) }
    return c.acting
}

// --- getting up (#859) ------------------------------------------------------------------------------

// The most get-ups a character chooses among.
const GET_UPS = 8

// Take `title` of the figure's own file made one of its get-ups (get_up
// chooses among them): its root motion taken from its pelvis
// (clips.root_under_pelvis), so its capsule stands under the body through
// the get-up, and a state played once. Its state; -1 when the file has no
// such take, or it has GET_UPS already. Its mirror is made a get-up too
// (named with "_Mirror"), as the gaits' side steps are: the same way up
// the other way round, for a body lying as the take's mirror does.
get_up_add(c: *Character, title: string) -> int {
    if c == null || c.get_up_count + 2 > GET_UPS { return 0 - 1 }
    a = c.animator as *Animator
    r = animator.rig(a)
    t = animator.take(a, title, true)
    if t == null { return 0 - 1 }
    clips.root_under_pelvis(t, r)
    ground_take(c, t)
    state = get_up_state_of(c, title, t)
    mirrored = animator.add_take(a, clips.mirror(t, r), false)
    _mirror = get_up_state_of(c, clips.name(mirrored), mirrored)
    return state
}

get_up_state_of(c: *Character, title: string, t: *Take) -> int {
    state = animator.add_state(c.animator as *Animator, title, t, false)
    (c.get_ups as int[])[c.get_up_count] = state
    way, n = way_of(c, t)
    (c.up_paths as ptr[])[c.get_up_count] = way
    (c.up_path_n as int[])[c.get_up_count] = n
    c.get_up_count = c.get_up_count + 1
    return state
}

// How many get-ups it has, and the state of the `i`th.
get_up_count(c: *Character) -> int { return c.get_up_count }
get_up_state(c: *Character, i: int) -> int {
    if i < 0 || i >= c.get_up_count { return 0 - 1 }
    return (c.get_ups as int[])[i]
}

// Up from where it lies: knocked down (knock, `m` null) and lying still
// (down), or its ragdoll let go to ae3d.motion for a fall
// (physanim.release, motion LIMP) and come to rest there (motion.down), and
// one of its get-ups (get_up_add) played from the pose it lies in, as UE's
// and Unity's get-ups go from a ragdoll. In this order:
//   - the motion's bodies set to follow the rig and the motion let go of
//     (motion.release frees it; `m` null when nothing else held them);
//   - its object, capsule and mover upright on the ground under the pelvis,
//     the rig drawn from the bodies about it (resume, keeping the root);
//   - the get-up chosen by how the body lies (choose_get_up: face up, face
//     down or on a side, then the nearest pose);
//   - its first frame laid onto the body (lay_onto), the object put there
//     and the rig drawn about it again, rooted as the get-up roots it
//     (rooted_as);
//   - the pose drawn read back as the animator's last two frames, still
//     (animator.read_drawn), the bodies taken back (physanim.retake);
//   - the get-up played as an act (act) inertialized over `blend` seconds
//     from the pose drawn (longer where the pelvis drawn would go faster
//     than the get-up's own, get_up_blend), its root motion moving the capsule, and at its end
//     the stand taken up.
// Done by hand in another order, the drawn pelvis jumped 1.3 m.
//
// A person getting up keeps off another's body, struck or standing (#835):
// each get-up, laid onto the body and turned on the ground about the pelvis
// (UP_TURNS), is scored by its way up against what moves near it
// (way_overlap, choose_get_up): it goes into other figures' bodies where
// they lie or stand as little as it can, and never into the way up of one
// already getting up, at the moment that one will be there. When every way
// meets another's, the figure lies on where it is (acting meanwhile,
// get_up_waiting) and looks again every WAIT_LOOK seconds, as a person waits
// for the one in the way to get up first; after WAIT_MOST it gets up by the
// way that meets the other's least. Figures told to get up together are
// so ordered, whichever is told first: one whose best way goes into a body
// near looks again at the next step and yields to one waiting near whose
// way goes into what is near it less (yields_to), so the clearer goes
// first; the other then waits while its way would cross the first's. Two
// lying against each other were drawn up to 7.3 cm inside each other,
// each way up laid as if alone; none now (test_get_up_pair). Its state
// (the one it would play now, waiting); -1 when it has no get-up or no
// ragdoll.
//
// The same wait holds while something that moves, not a figure, stands
// where it would stand up (room_to_rise: a car stopped over it), and for
// as long as it stands there: WAIT_MOST does not end it. Got up under the
// plaza's car, its capsule stood up inside the car was pushed out 0.85 to
// 1.3 m in a step, its hips and legs went with it at 48 to 75 m/s, and the
// car was thrown off at 45 m/s (#982).
get_up(c: *Character, m: *Motion, blend: float) -> int {
    if c == null || c.dead || c.get_up_count == 0 || c.physanim == null { return 0 - 1 }
    c.up_waited = 0.0
    return get_up_try(c, m, blend, false)
}

// Whether a figure whose best way goes `into` metre-seconds into what is
// near yields to another waiting to get up near it whose own best way goes
// in less (its last look's, up_into).
yields_to(c: *Character, into: float) -> bool {
    if g_people == null { return false }
    here = behaviour.object_position(c.object as *GameObject)
    i = 0
    while i < list.size(g_people) {
        other = list.get_raw(g_people, i) as *Character
        if other != c && other.engine == c.engine && other.up_waiting && other.up_into < into {
            there = behaviour.object_position(other.object as *GameObject)
            if core.v3_len(flat_of(core.v3_sub(there, here))) < NEAR_REACH * 2.0 { return true }
        }
        i = i + 1
    }
    return false
}

// Whether it was told to get up and waits for room (get_up): lying on, its
// act not begun.
get_up_waiting(c: *Character) -> bool { return c != null && c.up_waiting }

// Seconds between a waiting figure's looks for room, and the most it waits.
const WAIT_LOOK = 0.1
const WAIT_MOST = 6.0

// Lying on as the motion `m` holds it, the character paused again, told to
// get up over `blend` and looking again in `look` seconds (up_wait).
up_wait_set(c: *Character, m: *Motion, blend: float, look: float) {
    c.paused = true
    c.acting = true
    c.getting_up = true
    c.up_waiting = true
    c.up_motion = m as ptr
    c.up_blend = blend
    c.up_look = look
    c.up_index = 0 - 1
}

// get_up's choice, and the get-up begun when its way is clear or it has
// waited WAIT_MOST; else the figure set waiting (up_wait).
get_up_try(c: *Character, m: *Motion, blend: float, looking: bool) -> int {
    // No room to stand up at all (a car over it): it lies on and looks
    // again, however long it has waited, its way not chosen yet.
    if !room_to_rise(c) {
        up_wait_set(c, m, blend, WAIT_LOOK)
        c.up_blocked = true
        return (c.get_ups as int[])[0]
    }
    c.up_blocked = false
    a = c.animator as *Animator
    pa = c.physanim as *Physanim
    r = animator.rig(a)
    w = pose.new(r)
    p = pose.new(r)
    first = pose.new(r)
    pl = planned_of(c)
    under_body(c, p)
    pl.score_s = 0.0
    state, extra, clear, into = choose_get_up(c, p, w, first)
    c.up_into = into
    // Its way clear of the ways up but into a body near: told, it looks
    // again at the next step, when every figure told with it this step
    // waits too; looking, it yields to one waiting near whose way goes
    // into what is near it less (yields_to). The clearer goes first.
    wait = !clear
    look = WAIT_LOOK
    if clear && into > 0.0 {
        if !looking {
            wait = true
            look = 0.0
        } else if yields_to(c, into) {
            wait = true
        }
    }
    if wait && c.up_waited < WAIT_MOST {
        up_wait_set(c, m, blend, look)
        pose.release(w)
        pose.release(p)
        pose.release(first)
        return state
    }
    c.up_waiting = false
    c.knocked = false
    if m != null {
        motion.set_mode(m, motion.ANIMATED)
        motion.release(m)
    }
    take = animator.state_take(a, state)
    at, facing = lay_onto(r, c.object as *GameObject, p, take, w, first, extra)
    at = core.v3_add(at, c.up_shift)
    c.up_index = get_up_index(c, state)
    c.up_at = at
    c.up_facing = facing
    resume(c, at, facing)
    physics.ragdoll_show_pose(physanim.ragdoll_of(pa), null, true)
    pose.read(r, p)
    rooted_as(r, p, first)
    pose.apply(r, p)
    pose.copy(r, p, pl.snap)
    pl.turn = blend
    pl.fresh = true
    pl.lower = joint_ground(r, p, w, pose.PELVIS).y - joint_ground(r, first, w, pose.PELVIS).y
    pl.drop = get_up_blend(r, c.object as *GameObject, take, p, first, w, blend)
    began = os.now_monotonic_ns()
    plan_lift(pl, r, take)
    pl.plan_s = ((os.now_monotonic_ns() - began) as float) * 0.000000001 + pl.score_s
    pl.step_s = 0.0
    pl.steps = 0
    // Drawn from its first moment as planned, its lifts already on: what
    // the animator eases on from (the ragdoll draws the fingers through the
    // floor, a thumb up to 8 cm).
    clips.sample(take, r, 0.0, false, p)
    plan_step(pl as ptr, a, p, 0.0)
    pose.apply(r, p)
    pose.release(w)
    pose.release(p)
    pose.release(first)
    animator.read_drawn(a)
    physanim.retake(pa)
    animator.resume(a, 0.0)
    _acted = act_planned(c, state, pl)
    return state
}

// Play get-up `state` as an act (act), its change from the pose drawn
// planned (plan_step) in place of the animator's easing.
act_planned(c: *Character, state: int, pl: *Planned) -> bool {
    if c.use_phase != USE_NONE { return false }
    a = c.animator as *Animator
    c.acting = true
    c.getting_up = true
    c.act_state = state
    animator.set_root_motion(a, true)
    animator.play_shaped(a, state, pl.drop, plan_step, pl as ptr)
    return true
}

// --- the get-up's hand-over planned (#841) ------------------------------------------------------------

// The pelvis lowered onto a get-up's over this many times the turn's
// seconds, at the least: the body rolls before it drops.
const PLAN_DROP = 1.5
// Metres a joint is kept over the ground under it: on it.
const GROUND_CLEAR = 0.0
// Metres over the figure's floor the ground under a point is looked for from.
const GROUND_LOOK = 0.6
// The moments a second a hand-over's lifts are planned at (plan_lift), read
// between them as drawn; the most moments planned; and the seconds either
// side of each moment's need a lift is eased over. Planned at the engine's
// 60 a second, a get-up's planning took 1.2 ms (-O2).
const PLAN_RATE = 30.0
const LIFT_MOST = 121
const LIFT_EASE = 0.25
// Metres over the ground each limb's lift is planned to (plan_lift), over
// what the hand-over itself needs: the take's root moves the figure while it
// plays and the plan's moments are a 60th of a second apart, so the pose
// drawn is not quite the pose planned. Planned onto the ground itself, a
// knuckle went 3.0 cm under it.
const LIFT_SPARE = 0.02
// A limb's lifts off the ground (lift_point): its middle joint about its
// root, its end about its middle joint, what its end carries about the end;
// four limbs.
const LIFTS = 12
// The most times a hand-over's plan is played back and its lifts raised
// where a limb still goes under the ground (plan_check), and the metres
// over the ground a joint found under it is then lifted to. Lifted the full
// LIFT_SPARE, a hand raised more turned faster as it eased: past
// LayToIdle's own fastest (3.2 rad/s, test_knockdowns' seed 2).
const PLAN_CHECKS = 2
const CHECK_SPARE = 0.005

// A get-up's hand-over from the pose a body lies in (get_up): that pose,
// the take's as it plays and the limbs it plans.
struct Planned {
    engine: ptr
    object: ptr
    snap: ptr                      // the pose it lay in, about its object, rooted as the get-up roots it
    clip: ptr                      // the get-up's own pose this frame
    clip_w: ptr                    // and in the rig's space
    worlds: ptr                    // the pose planned, in the rig's space
    kept: ptr                      // each joint's turn in the take as last turned toward (blend_locals)
    lift: ptr                      // float[]: metres the hips are raised at each 60th of a second (plan_lift)
    lift_n: int                    // how many
    lift_axes: ptr                 // float[LIFTS * 3]: each limb's three lifts' axes last frame (lift_point)
    limb_lift: ptr                 // float[LIFTS * LIFT_MOST]: each lift's turn planned at each 60th of a second (plan_lift)
    limb_need: ptr                 // float[LIFTS * LIFT_MOST]: and the turn each moment needs, eased into it (lifts_eased)
    limb_list: ptr                 // int[4 * joints]: each limb's joints from its root, parents first (joints_under)
    limb_n: ptr                    // int[4]: how many
    end_list: ptr                  // int[4 * joints]: each limb's end and what it carries, parents first
    end_n: ptr                     // int[4]: how many
    limb_axes: ptr                 // float[LIFTS * LIFT_MOST * 3]: and the axis it turns about
    recording: bool                // plan_lift is reading each lift's need (lift_point)
    sample: int                    // at that moment
    last_t: float                  // the time into the hand-over planned last
    fresh: bool                    // no frame planned yet
    plan_s: float                  // seconds the last get-up's planning took (plan_lift and its way scored clear, way_overlap), get_up_cost
    score_s: float                 // of which its way scored (way_overlap, with the bodies near gathered)
    step_s: float                  // seconds its frames' planning took (plan_step), summed
    steps: int                     // and how many frames
    turn: float                    // seconds the joints turn over
    drop: float                    // seconds the pelvis comes down over (get_up_blend)
    lower: float                   // metres the pelvis lay over the get-up's first frame's
}

planned_of(c: *Character) -> *Planned {
    if c.planned != null { return c.planned as *Planned }
    r = animator.rig(c.animator as *Animator)
    pl = heap.new(Planned)
    pl.engine = c.engine
    pl.object = c.object
    pl.snap = pose.new(r)
    pl.clip = pose.new(r)
    pl.clip_w = pose.new(r)
    pl.worlds = pose.new(r)
    pl.kept = pose.new(r)
    pl.lift = calloc(LIFT_MOST, 8)
    pl.lift_axes = calloc(LIFTS * 3, 8)
    pl.limb_lift = calloc(LIFTS * LIFT_MOST, 8)
    pl.limb_need = calloc(LIFTS * LIFT_MOST, 8)
    pl.limb_axes = calloc(LIFTS * LIFT_MOST * 3, 8)
    // Each limb's joints, and its end's, parents first (world_under).
    count = pose.count(r)
    pl.limb_list = calloc(4 * count, 4)
    pl.limb_n = calloc(4, 4)
    pl.end_list = calloc(4 * count, 4)
    pl.end_n = calloc(4, 4)
    k = 0
    while k < 4 {
        (pl.limb_n as int[])[k] = joints_under(r, pose.human(r, limb_slot(k, 0)), pl.limb_list as int[], k * count)
        (pl.end_n as int[])[k] = joints_under(r, pose.human(r, limb_slot(k, 2)), pl.end_list as int[], k * count)
        k = k + 1
    }
    c.planned = pl as ptr
    return pl
}

// Limb `k`'s (plan_step's order: the left arm, the right, the left leg, the
// right) `i`th joint: 0 its root, 1 its middle joint, 2 its end.
limb_slot(k: int, i: int) -> int {
    slots = [pose.UPPERARM_L, pose.LOWERARM_L, pose.HAND_L, pose.UPPERARM_R, pose.LOWERARM_R, pose.HAND_R,
             pose.THIGH_L, pose.CALF_L, pose.FOOT_L, pose.THIGH_R, pose.CALF_R, pose.FOOT_R]
    return slots[k * 3 + i]
}

// Joint `top` and every joint under it, each after its parent, into `out`
// from `from`: how many (0 for no joint).
joints_under(r: *pose.Rig, top: int, out: int[], from: int) -> int {
    if top < 0 { return 0 }
    out[from] = top
    n = 1
    at = 0
    while at < n {
        up = out[from + at]
        j = 0
        while j < pose.count(r) {
            if pose.parent(r, j) == up {
                out[from + n] = j
                n = n + 1
            }
            j = j + 1
        }
        at = at + 1
    }
    return n
}

// The rig-space pose `w` of pose `p` made again for `n` joints of `list`
// from `from`, each after its parent (joints_under), as pose.world makes
// it: what a limb's own turns moved, the rest of `w` as it was.
world_under(r: *pose.Rig, p: ptr, w: ptr, list: int[], from: int, n: int) {
    i = 0
    while i < n {
        j = list[from + i]
        up = pose.parent(r, j)
        if up < 0 {
            pose.set_translation(w, j, pose.translation(p, j))
            pose.set_rotation(w, j, pose.rotation(p, j))
            pose.set_scale(w, j, pose.scale(p, j))
        } else {
            ps = pose.scale(w, up)
            t = pose.translation(p, j)
            local = core.vec3(t.x * ps.x, t.y * ps.y, t.z * ps.z)
            pose.set_translation(w, j, core.v3_add(pose.translation(w, up), core.quat_apply(pose.rotation(w, up), local)))
            pose.set_rotation(w, j, core.quat_normalize(core.quat_mul(pose.rotation(w, up), pose.rotation(p, j))))
            s = pose.scale(p, j)
            pose.set_scale(w, j, core.vec3(s.x * ps.x, s.y * ps.y, s.z * ps.z))
        }
        i = i + 1
    }
}

planned_free(pl: *Planned) {
    if pl == null { return }
    pose.release(pl.snap)
    pose.release(pl.clip)
    pose.release(pl.clip_w)
    pose.release(pl.worlds)
    pose.release(pl.kept)
    free(pl.lift)
    free(pl.lift_axes)
    free(pl.limb_lift)
    free(pl.limb_need)
    free(pl.limb_axes)
    free(pl.limb_list)
    free(pl.limb_n)
    free(pl.end_list)
    free(pl.end_n)
    heap.free(pl)
}

// The smoothest way from 0 to 1 over 0 to 1 (its speed and its
// acceleration 0 at both ends).
smoothest(x: float) -> float {
    u = core.clampf(x, 0.0, 1.0)
    return u * u * u * (u * (u * 6.0 - 15.0) + 10.0)
}

// A get-up's hand-over (animator.play_shaped), `t` seconds in: the take's
// pose `out` made the pose planned from the one the body lay in. Eased out
// of the pose lying, joint by joint, the animator swept a body's limbs
// through the floor: a forearm 35 cm under it at the worst over 100
// knockdowns, mean 20 cm (test_knockdowns), as each joint's turn went the
// shortest way and the pelvis dropped while the trunk turned over. Planned:
//   - every joint turned from the pose lying to the take's over `turn`,
//     each the way round it began (blend_locals);
//   - the pelvis lowered onto the take's over the longer `drop`, so the
//     body rolls before it drops;
//   - the hips raised on a lift planned ahead (plan_lift) as far as the
//     trunk turning over would be under the ground;
//   - each arm and leg's elbow or knee, end, and fingers or toes turned up
//     off the ground on lifts planned ahead too (plan_limb, lift_point).
// Over 100 knockdowns the deepest joint is now 0.95 cm under the floor, and
// 0.92 cm over the 300 landings test_knockdowns sweeps (plan_check).
plan_step(st: ptr, a: *Animator, out: ptr, t: float) {
    pl = st as *Planned
    began = os.now_monotonic_ns()
    plan_frame(pl, animator.rig(a), out, t)
    pl.step_s = pl.step_s + ((os.now_monotonic_ns() - began) as float) * 0.000000001
    pl.steps = pl.steps + 1
}

// What a get-up's hand-over costs (get_up), seconds: its planning as it
// began (its lifts, plan_lift, and its way scored against the bodies near,
// way_overlap), and each frame of it after on average. 0 for none yet.
get_up_cost(c: *Character) -> (float, float) {
    if c == null || c.planned == null { return 0.0, 0.0 }
    pl = c.planned as *Planned
    per = 0.0
    if pl.steps > 0 { per = pl.step_s / (pl.steps as float) }
    return pl.plan_s, per
}

// plan_step's frame: `out` (the take's pose `t` seconds in) made the pose
// planned.
plan_frame(pl: *Planned, r: *pose.Rig, out: ptr, t: float) {
    u = smoothest(t / pl.turn)
    pl.last_t = t
    pose.copy(r, out, pl.clip)
    pose.world(r, pl.clip, pl.clip_w)
    blend_locals(pl, r, pl.snap, pl.clip, u, out)
    plan_drop(pl, r, out, smoothest(t / pl.drop), lift_at(pl, t))
    pose.world(r, out, pl.worlds)
    k = 0
    while k < 4 {
        plan_limb(pl, r, out, k, false)
        k = k + 1
    }
    pl.fresh = false
}

// Each joint's place and turn from pose `a` to pose `b`, `u` of the way,
// into `out`. Each turn goes the way round it went the frame before
// (kept_way): turned the shortest way each frame, a joint the take has
// half a turn from where it lay went round one way and then the other as
// the take moved on, and a body rolled over in two frames, a hand at 188
// rad/s.
blend_locals(pl: *Planned, r: *pose.Rig, a_pose: ptr, b_pose: ptr, u: float, out: ptr) {
    j = 0
    while j < pose.count(r) {
        from = pose.rotation(a_pose, j)
        to = kept_way(from, pose.rotation(b_pose, j), pose.rotation(pl.kept, j), pl.fresh)
        pose.set_rotation(pl.kept, j, to)
        pose.set_rotation(out, j, slerp_as_is(from, to, u))
        pose.set_translation(out, j, core.v3_lerp(pose.translation(a_pose, j), pose.translation(b_pose, j), u))
        j = j + 1
    }
}

// Turn `to` as the quaternion of its two that lies on the side of `was`
// (the one chosen the frame before), or, `fresh`, of `from`: so a turn
// from `from` keeps going the way round it began.
kept_way(from: Quat, to: Quat, was: Quat, fresh: bool) -> Quat {
    near = was
    if fresh { near = from }
    if near.x * to.x + near.y * to.y + near.z * to.z + near.w * to.w < 0.0 {
        return core.quat(0.0 - to.x, 0.0 - to.y, 0.0 - to.z, 0.0 - to.w)
    }
    return to
}

// From `a` to `b`, `u` of the way, the way round their signs give (no
// shortest way taken).
slerp_as_is(a: Quat, b: Quat, u: float) -> Quat {
    d = core.clampf(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w, 0.0 - 1.0, 1.0)
    if core.abs_of(d) > 0.9995 {
        return core.quat_normalize(core.quat(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, a.z + (b.z - a.z) * u, a.w + (b.w - a.w) * u))
    }
    angle = core.acos_of(d)
    s = core.sin_of(angle)
    s0 = core.sin_of(angle * (1.0 - u)) / s
    s1 = core.sin_of(angle * u) / s
    return core.quat(a.x * s0 + b.x * s1, a.y * s0 + b.y * s1, a.z * s0 + b.z * s1, a.w * s0 + b.w * s1)
}

// The pelvis of pose `out` put at the take's height plus what it lay over
// the take's first frame, `v` of it eased out, and `lift` higher.
plan_drop(pl: *Planned, r: *pose.Rig, out: ptr, v: float, lift: float) {
    pelvis = pose.human(r, pose.PELVIS)
    if pelvis < 0 { return }
    pose.world(r, out, pl.worlds)
    now = ikrig.to_ground(r, pose.translation(pl.worlds, pelvis)).y
    want = ikrig.to_ground(r, pose.translation(pl.clip_w, pelvis)).y + pl.lower * (1.0 - v) + lift
    move_ground(r, out, pl.worlds, pelvis, core.vec3(0.0, want - now, 0.0))
}

// How far the deepest of the trunk's joints of pose `out` (the pelvis, the
// spine, the neck, the head, the shoulders and the hips) is under the
// ground; 0 when none is.
trunk_under(pl: *Planned, r: *pose.Rig, out: ptr) -> float {
    pose.world(r, out, pl.worlds)
    slots = [pose.PELVIS, pose.SPINE_01, pose.SPINE_02, pose.SPINE_03, pose.NECK, pose.HEAD,
             pose.CLAVICLE_L, pose.CLAVICLE_R, pose.UPPERARM_L, pose.UPPERARM_R, pose.THIGH_L, pose.THIGH_R]
    deepest = 0.0
    k = 0
    while k < 12 {
        j = pose.human(r, slots[k])
        if j >= 0 {
            g = ikrig.to_ground(r, pose.translation(pl.worlds, j))
            d = ground_under(pl, g, false) + GROUND_CLEAR - g.y
            if d > deepest { deepest = d }
        }
        k = k + 1
    }
    return deepest
}

// The hips' lift planned for the hand-over into take `t` (get_up), at each
// 60th of a second: its trunk turned and lowered as plan_step will (no
// limbs), the depth its trunk would go under the ground at each moment,
// and over them the least smooth rise and fall that covers every one,
// eased over LIFT_EASE either side (each depth times the smoothest bump
// about its moment, the most of them). Lifted by the depth itself, frame
// by frame, the hips jumped up and down again as a shoulder rolled under
// the floor and out: the pelvis at 1.9 m/s against LayToIdle's own 1.22.
plan_lift(pl: *Planned, r: *pose.Rig, t: *Take) {
    n = (pl.drop * PLAN_RATE) as int + 2
    if n > LIFT_MOST { n = LIFT_MOST }
    pl.lift_n = n
    scratch = pose.new(r)
    // The trunk first, its limbs left as the turn has them.
    i = 0
    while i < n {
        planned_trunk(pl, r, t, i, scratch, 0.0)
        (pl.limb_lift as float[])[i] = trunk_under(pl, r, scratch)
        i = i + 1
    }
    envelope(pl.limb_lift as float[], 0, pl.lift as float[], n, LIFT_EASE)
    // Then the limbs, on the trunk lifted so: each lift's turn as deep as
    // its joint would go under the ground at each moment (lift_point,
    // recording), each eased into one smooth rise and fall the same way. The
    // trunk of each moment kept for plan_check.
    pl.recording = true
    i = 0
    while i < LIFTS * 3 {
        (pl.lift_axes as float[])[i] = 0.0
        i = i + 1
    }
    trunks = calloc(n, 8) as ptr[]
    i = 0
    while i < n {
        planned_trunk(pl, r, t, i, scratch, (pl.lift as float[])[i])
        trunks[i] = pose.new(r)
        pose.copy(r, scratch, trunks[i])
        pl.sample = i
        pose.world(r, scratch, pl.worlds)
        k = 0
        while k < 4 {
            plan_limb(pl, r, scratch, k, false)
            k = k + 1
        }
        i = i + 1
    }
    pl.recording = false
    rec = pl.limb_lift as float[]
    need = pl.limb_need as float[]
    s = 0
    while s < LIFTS {
        steady_axes(pl, rec, s, n, LIFT_EASE)
        i = 0
        while i < n {
            need[s * LIFT_MOST + i] = rec[s * LIFT_MOST + i]
            i = i + 1
        }
        s = s + 1
    }
    lifts_eased(pl, n)
    // Then played back as plan_step will play it, and where a limb still
    // goes under the ground its lifts' needs raised by what it lacks and
    // eased again (plan_check).
    check = 0
    while check < PLAN_CHECKS && plan_check(pl, r, trunks, scratch, n) {
        lifts_eased(pl, n)
        check = check + 1
    }
    i = 0
    while i < n {
        pose.release(trunks[i])
        i = i + 1
    }
    free(trunks as ptr)
    pl.fresh = true
    pose.release(scratch)
}

// Each limb lift's turn planned (limb_lift) made the least smooth rise and
// fall over its needs (limb_need; envelope), its `n` moments.
lifts_eased(pl: *Planned, n: int) {
    work = calloc(n, 8) as float[]
    rec = pl.limb_lift as float[]
    s = 0
    while s < LIFTS {
        envelope(pl.limb_need as float[], s * LIFT_MOST, work, n, LIFT_EASE)
        i = 0
        while i < n {
            rec[s * LIFT_MOST + i] = work[i]
            i = i + 1
        }
        s = s + 1
    }
    free(work as ptr)
}

// The hand-over played back as plan_step will play it, at each of its `n`
// moments (PLAN_RATE a second) a limb's lift is under way: its trunk as
// plan_lift planned it (`trunks`), its limbs lifted as planned now
// (plan_limb, into `out`). Every limb whose middle joint, end or what its
// end carries still goes under the ground there has its lift's need at that
// moment raised by the turn it lacks (check_limb), so the plan's lifts are
// the ones the pose drawn needs. Whether any was. The needs are read off a
// pose planned with LIFT_SPARE over the ground, its lifts then eased (more
// turn than a moment needs) and their axes steadied (about another axis),
// and the forearm lifted further turns the hand it carries: played so, a
// landing put a little finger's knuckle 2.5 cm under the floor
// (test_knockdowns' landings swept).
plan_check(pl: *Planned, r: *pose.Rig, trunks: ptr[], out: ptr, n: int) -> bool {
    raised = false
    i = 0
    while i < n - 1 {
        at = (i as float) / PLAN_RATE
        if lifting(pl, at) {
            pose.copy(r, trunks[i], out)
            pl.last_t = at
            pl.fresh = false
            pose.world(r, out, pl.worlds)
            k = 0
            while k < 4 {
                plan_limb(pl, r, out, k, false)
                k = k + 1
            }
            k = 0
            while k < 4 {
                if check_limb(pl, r, pl.worlds, k, at, i) { raised = true }
                k = k + 1
            }
        }
        i = i + 1
    }
    return raised
}

// Whether any limb lift is planned to turn `t` seconds into the hand-over.
lifting(pl: *Planned, t: float) -> bool {
    s = 0
    while s < LIFTS {
        if limb_lift_at(pl, s, t) > 0.0 { return true }
        s = s + 1
    }
    return false
}

// Limb `k` of the rig-space pose `w` (the hand-over as planned at moment
// `m`, `t` seconds in): its middle joint's lift raised where that joint is
// under the ground, its lower bone's where its end or what the end carries
// is (check_lift), CHECK_SPARE over it. Whether any was.
check_limb(pl: *Planned, r: *pose.Rig, w: ptr, k: int, t: float, m: int) -> bool {
    upper = pose.human(r, limb_slot(k, 0))
    middle = pose.human(r, limb_slot(k, 1))
    end = pose.human(r, limb_slot(k, 2))
    if upper < 0 || middle < 0 || end < 0 { return false }
    root = ikrig.to_ground(r, pose.translation(w, upper))
    knee = ikrig.to_ground(r, pose.translation(w, middle))
    tip = ikrig.to_ground(r, pose.translation(w, end))
    under = ground_under(pl, knee, false) + GROUND_CLEAR - knee.y
    raised = false
    if under > 0.0 && check_lift(pl, k * 3, root, knee, knee.y + under + CHECK_SPARE, t, m) { raised = true }
    // The end, and what it carries, lifted on the lower bone by as much as
    // the deepest of them is under: the lower bone's reach lifts a knuckle
    // near the wrist with little turn. Pitched up about the wrist instead,
    // the hand's lift grew to 2 rad and turned it at 44 rad/s against
    // LayToIdle's own 26.5 (seed 40 struck 6 steps later).
    least = ground_under(pl, tip, false) + GROUND_CLEAR
    deepest = least - tip.y
    list = pl.end_list as int[]
    from = k * pose.count(r)
    i = 1
    while i < (pl.end_n as int[])[k] {
        d = least - ikrig.to_ground(r, pose.translation(w, list[from + i])).y
        if d > deepest { deepest = d }
        i = i + 1
    }
    if deepest > 0.0 && check_lift(pl, k * 3 + 1, knee, tip, tip.y + deepest + CHECK_SPARE, t, m) { raised = true }
    return raised
}

// Point `p` of lift `slot` (about `pivot`), the hand-over as planned at
// moment `m`, `t` seconds in, to be raised to `least`: the lift's need at
// that moment raised to the turn planned now and the turn about its planned
// axis it lacks (or, none planned, the one lift_turn would take, then
// planned there). Whether it was.
check_lift(pl: *Planned, slot: int, pivot: Vec3, p: Vec3, least: float, t: float, m: int) -> bool {
    axis = limb_axis_at(pl, slot, t)
    if core.v3_len(axis) < 0.000001 {
        _angle, own = ikrig.lift_turn(pivot, p, p.y + 1.0, core.vec3(0.0, 0.0, 0.0))
        axis = own
    }
    lack = ikrig.lift_about(pivot, p, least, axis)
    if lack <= 0.0 { return false }
    want = limb_lift_at(pl, slot, t) + lack
    need = pl.limb_need as float[]
    if want > need[slot * LIFT_MOST + m] { need[slot * LIFT_MOST + m] = want }
    axes = pl.limb_axes as float[]
    at = (slot * LIFT_MOST + m) * 3
    if axes[at] == 0.0 && axes[at + 1] == 0.0 && axes[at + 2] == 0.0 {
        axes[at] = axis.x
        axes[at + 1] = axis.y
        axes[at + 2] = axis.z
    }
    return true
}

// Moment `i` (PLAN_RATE a second) of the hand-over into take `t`, the
// joints turned and the pelvis lowered (and `lift` higher), into `out`; the
// limbs as the turn has them.
planned_trunk(pl: *Planned, r: *pose.Rig, t: *Take, i: int, out: ptr, lift: float) {
    at = (i as float) / PLAN_RATE
    pl.fresh = i == 0
    clips.sample(t, r, at, false, pl.clip)
    pose.world(r, pl.clip, pl.clip_w)
    blend_locals(pl, r, pl.snap, pl.clip, smoothest(at / pl.turn), out)
    pl.fresh = false
    plan_drop(pl, r, out, smoothest(at / pl.drop), lift)
}

// The least smooth rise and fall over `n` needs (`need` from `from`) that
// covers each: each need times the smoothest bump LIFT_EASE either side of
// its moment, the most of them, into `out`.
envelope(need: float[], from: int, out: float[], n: int, ease: float) {
    width = ease * PLAN_RATE
    i = 0
    while i < n {
        most = 0.0
        j = 0
        while j < n {
            x = core.abs_of((i - j) as float) / width
            if x < 1.0 && need[from + j] * smoothest(1.0 - x) > most { most = need[from + j] * smoothest(1.0 - x) }
            j = j + 1
        }
        out[i] = most
        i = i + 1
    }
}

// Lift `s`'s axes, one a moment as recorded (plan_lift), made each the
// mean of those about it, weighted as the envelope weighs their needs
// (`need`, not yet eased): the axis the planned turn is made about moves on
// as smoothly as the turn. Turned about the axis each frame read off the
// bone, a lift planned for a moment the bone was under the floor turned it
// about a bone swinging over the top: an upper arm at 65 rad/s.
steady_axes(pl: *Planned, need: float[], s: int, n: int, ease: float) {
    rec = pl.limb_axes as float[]
    out = calloc(n * 3, 8) as float[]
    width = ease * PLAN_RATE
    i = 0
    while i < n {
        sum = core.vec3(0.0, 0.0, 0.0)
        j = 0
        while j < n {
            x = core.abs_of((i - j) as float) / width
            if x < 1.0 {
                at = (s * LIFT_MOST + j) * 3
                sum = core.v3_add(sum, core.v3_mul(core.vec3(rec[at], rec[at + 1], rec[at + 2]), need[s * LIFT_MOST + j] * smoothest(1.0 - x)))
            }
            j = j + 1
        }
        if core.v3_len(sum) > 0.000001 { sum = core.v3_normalize(sum) }
        out[i * 3] = sum.x
        out[i * 3 + 1] = sum.y
        out[i * 3 + 2] = sum.z
        i = i + 1
    }
    i = 0
    while i < n * 3 {
        rec[s * LIFT_MOST * 3 + i] = out[i]
        i = i + 1
    }
    free(out as ptr)
}

// Lift `slot`'s planned axis `t` seconds into the hand-over (plan_lift);
// zero where none is planned.
limb_axis_at(pl: *Planned, slot: int, t: float) -> Vec3 {
    x = t * PLAN_RATE
    i = x as int
    if i < 0 || i >= pl.lift_n - 1 { return core.vec3(0.0, 0.0, 0.0) }
    rec = pl.limb_axes as float[]
    at = (slot * LIFT_MOST + i) * 3
    u = x - (i as float)
    v = core.v3_lerp(core.vec3(rec[at], rec[at + 1], rec[at + 2]), core.vec3(rec[at + 3], rec[at + 4], rec[at + 5]), u)
    if core.v3_len(v) < 0.000001 { return v }
    return core.v3_normalize(v)
}

// Lift `slot`'s planned turn `t` seconds into the hand-over (plan_lift).
limb_lift_at(pl: *Planned, slot: int, t: float) -> float {
    x = t * PLAN_RATE
    i = x as int
    if i < 0 || i >= pl.lift_n - 1 { return 0.0 }
    rec = pl.limb_lift as float[]
    u = x - (i as float)
    return rec[slot * LIFT_MOST + i] + (rec[slot * LIFT_MOST + i + 1] - rec[slot * LIFT_MOST + i]) * u
}

// The hips' planned lift `t` seconds into the hand-over (plan_lift).
lift_at(pl: *Planned, t: float) -> float {
    x = t * PLAN_RATE
    i = x as int
    if i < 0 || i >= pl.lift_n - 1 { return 0.0 }
    lift = pl.lift as float[]
    u = x - (i as float)
    return lift[i] + (lift[i + 1] - lift[i]) * u
}

// Joint `j` of pose `p` moved by `by` (the ground's space); `worlds` is `p`
// in the rig's space.
move_ground(r: *pose.Rig, p: ptr, worlds: ptr, j: int, by: Vec3) {
    d = ikrig.dir_to_rig(r, by)
    parent = pose.parent(r, j)
    if parent >= 0 {
        d = core.quat_apply(core.quat_conjugate(pose.rotation(worlds, parent)), d)
        s = pose.scale(worlds, parent)
        d = core.vec3(d.x / s.x, d.y / s.y, d.z / s.z)
    }
    pose.set_translation(p, j, core.v3_add(pose.translation(p, j), d))
}

// Limb `k` (plan_step's order) of pose `out` kept out of the ground: its
// middle joint and its end where the pose has them, each turned up onto the
// ground about the joint before it (aim_bones), and the end pitched up about
// itself until what it carries (the fingers, the toes) is on it
// (pitch_carried). `only_under`: a take's own frame on the figure's flat
// floor (ground_take), left alone unless some of the limb is under it.
// pl.worlds is `out` in the rig's space, before and after: the limbs
// touch none of each other's joints, so one pose.world serves all four.
plan_limb(pl: *Planned, r: *pose.Rig, out: ptr, k: int, only_under: bool) {
    upper = pose.human(r, limb_slot(k, 0))
    middle = pose.human(r, limb_slot(k, 1))
    end = pose.human(r, limb_slot(k, 2))
    if upper < 0 || middle < 0 || end < 0 || pose.parent(r, middle) != upper || pose.parent(r, end) != middle { return }
    w = pl.worlds
    // In the ground's space: the middle joint and the end where the pose
    // turned joint by joint has them, the end on or over the ground.
    knee = ikrig.to_ground(r, pose.translation(w, middle))
    goal = ikrig.to_ground(r, pose.translation(w, end))
    // A take's own frame is left alone where none of the limb is under the
    // floor; planned live, every frame is solved, so each lift eases off
    // as it eased on (lift_point).
    if only_under && !(goal.y < ground_under(pl, goal, true) + GROUND_CLEAR) && !middle_under(pl, r, w, middle, true) && carried_under(pl, r, w, k, true) <= 0.0 { return }
    aim_bones(pl, r, out, k, upper, middle, end, knee, goal, only_under)
    // What the end carries (the fingers, the toes) kept out of the ground by
    // pitching the end up about its own joint.
    pitch_carried(pl, r, out, k, end, only_under)
}

// Joint `end` (of limb `k`) of pose `out` turned up about itself until
// every joint it carries is on the ground: about the axis that lifts the
// lowest (ikrig.lift_turn), as far as the one that needs the most turn
// about it (ikrig.lift_about), and turned so, about that axis, as planned
// (lift_planned). An arm at its full reach cannot raise its end: LayToIdle's
// own frames held a fingertip 2.2 cm under the floor so. Turned only as far
// as brought its lowest joint up, by the shortest turn onto where that one
// went (about another axis than the one planned), a joint nearer the wrist
// (a little finger's knuckle) could stay under: the deepest joint over 100
// knockdowns was 1.34 cm under the floor, 0.95 turned so (test_knockdowns).
// pl.worlds is `out` in the rig's space, before and after.
pitch_carried(pl: *Planned, r: *pose.Rig, out: ptr, k: int, end: int, flat: bool) {
    w = pl.worlds
    list = pl.end_list as int[]
    from = k * pose.count(r)
    n = (pl.end_n as int[])[k]
    if n < 2 { return }
    pivot = ikrig.to_ground(r, pose.translation(w, end))
    lowest = ikrig.to_ground(r, pose.translation(w, list[from + 1]))
    i = 2
    while i < n {
        q = ikrig.to_ground(r, pose.translation(w, list[from + i]))
        if q.y < lowest.y { lowest = q }
        i = i + 1
    }
    slot = k * 3 + 2
    least = lift_least(pl, lowest, flat)
    angle, axis = ikrig.lift_turn(pivot, lowest, least, lift_kept(pl, slot, flat))
    i = 1
    while i < n {
        need = ikrig.lift_about(pivot, ikrig.to_ground(r, pose.translation(w, list[from + i])), least, axis)
        if need > angle { angle = need }
        i = i + 1
    }
    angle, axis = lift_planned(pl, slot, angle, axis, flat)
    if angle <= 0.0 { return }
    turn = ikrig.turn_to_rig(r, core.quat_rotate(angle, axis))
    pose.set_rotation(out, end, pose.local_rotation_of(r, w, end, core.quat_normalize(core.quat_mul(turn, pose.rotation(w, end)))))
    world_under(r, out, w, list, from, n)
}

// Whether joint `j` of the rig-space pose `w` is under the ground.
middle_under(pl: *Planned, r: *pose.Rig, w: ptr, j: int, flat: bool) -> bool {
    g = ikrig.to_ground(r, pose.translation(w, j))
    return g.y < ground_under(pl, g, flat) + GROUND_CLEAR
}

// The limb `upper`, `middle`, `end` of pose `out` laid along its planned
// points (the ground's space): its upper bone turned onto `knee` (kept on
// or over the ground about its root), its lower bone onto `goal` (its end
// kept on or over the ground about the middle joint; lift_point), the end
// carried as it is on its bone. Each bone follows a point that moves on
// smoothly, so the limb does. Solved as a two-bone limb onto the end (the
// middle joint's side read off the planned way), an elbow or a knee whose
// side in the pose lying and in the take's lay either side of the line to
// the end swung across it in a frame or two: a calf at up to 162 rad/s, a
// hand at 112, against LayToIdle's own 27.9. pl.worlds is `out` in the
// rig's space, before and after.
aim_bones(pl: *Planned, r: *pose.Rig, out: ptr, k: int, upper: int, middle: int, end: int, knee_in: Vec3, goal: Vec3, flat: bool) {
    w = pl.worlds
    hr = pose.translation(w, upper)
    er = pose.translation(w, middle)
    ar = pose.translation(w, end)
    h = ikrig.to_ground(r, hr)
    knee_g = lift_point(pl, k * 3, h, knee_in, flat)
    lower = core.v3_len(core.v3_sub(ikrig.to_ground(r, ar), ikrig.to_ground(r, er)))
    toward = core.v3_sub(goal, knee_g)
    if core.v3_len(toward) < 0.000001 || lower < 0.000001 { return }
    tip_g = lift_point(pl, k * 3 + 1, knee_g, core.v3_add(knee_g, core.v3_mul(core.v3_normalize(toward), lower)), flat)
    knee = ikrig.to_rig(r, knee_g)
    tip = ikrig.to_rig(r, tip_g)
    q1 = core.quat_from_to(core.v3_sub(er, hr), core.v3_sub(knee, hr))
    upper_w = core.quat_normalize(core.quat_mul(q1, pose.rotation(w, upper)))
    middle_w = core.quat_normalize(core.quat_mul(q1, pose.rotation(w, middle)))
    moved = core.v3_add(knee, core.quat_apply(q1, core.v3_sub(ar, er)))
    q2 = core.quat_from_to(core.v3_sub(moved, knee), core.v3_sub(tip, knee))
    middle_w = core.quat_normalize(core.quat_mul(q2, middle_w))
    pose.set_rotation(out, upper, pose.local_rotation_of(r, w, upper, upper_w))
    pose.set_rotation(out, middle, core.quat_normalize(core.quat_mul(core.quat_conjugate(upper_w), middle_w)))
    // The end carried by its bone as it is lifted, its own turn on it as the
    // pose has it (its fingers or toes then kept out by its pitch). Held to
    // its turn in the world, a hand turned against its forearm's lift at the
    // lift's own speed: 26.95 rad/s against LayToIdle's own 26.55.
    world_under(r, out, w, pl.limb_list as int[], k * pose.count(r), (pl.limb_n as int[])[k])
}

// Point `p` (the ground's space) kept on or over the ground, as far from
// `pivot` as it is: turned up about `pivot` (ikrig.lift_turn) until it is on
// the ground, or as high as it can come. In a hand-over (not `flat`), lift
// `slot` keeps its axis from frame to frame, and turns by what plan_lift
// planned for the moment (its need read here while plan_lift records):
// one smooth rise and fall over every moment's need. Each lift as deep as
// the joint was under the floor that frame, an upper arm turned up to 80
// rad/s past LayToIdle's own 27.9 in one frame; each limited to 12 rad/s,
// a forearm still went 25 rad/s past it on 53 of 100 knockdowns.
lift_point(pl: *Planned, slot: int, pivot: Vec3, p: Vec3, flat: bool) -> Vec3 {
    angle, axis = ikrig.lift_turn(pivot, p, lift_least(pl, p, flat), lift_kept(pl, slot, flat))
    angle, axis = lift_planned(pl, slot, angle, axis, flat)
    if angle <= 0.0 { return p }
    return core.v3_add(pivot, core.quat_apply(core.quat_rotate(angle, axis), core.v3_sub(p, pivot)))
}

// The height a lift brings point `p` (the ground's space) up to: the ground
// under it, and LIFT_SPARE over it while plan_lift records.
lift_least(pl: *Planned, p: Vec3, flat: bool) -> float {
    least = ground_under(pl, p, flat) + GROUND_CLEAR
    if pl.recording && !flat { least = least + LIFT_SPARE }
    return least
}

// Lift `slot`'s axis last frame, held to (ikrig.lift_turn's `keep`); zero
// for a take's own frame (`flat`) or the hand-over's first.
lift_kept(pl: *Planned, slot: int, flat: bool) -> Vec3 {
    if flat || pl.fresh { return core.vec3(0.0, 0.0, 0.0) }
    axes = pl.lift_axes as float[]
    return core.vec3(axes[slot * 3], axes[slot * 3 + 1], axes[slot * 3 + 2])
}

// Lift `slot`'s turn this frame: in a hand-over (not `flat`), while
// plan_lift records, the turn `angle` about `axis` this moment needs,
// recorded; after, the turn and axis planned for the moment (one smooth
// rise and fall over every moment's need). Its axis kept for the next frame.
lift_planned(pl: *Planned, slot: int, angle_in: float, axis_in: Vec3, flat: bool) -> (float, Vec3) {
    angle = angle_in
    axis = axis_in
    if flat { return angle, axis }
    if pl.recording {
        (pl.limb_lift as float[])[slot * LIFT_MOST + pl.sample] = angle
        at = (slot * LIFT_MOST + pl.sample) * 3
        (pl.limb_axes as float[])[at] = axis.x
        (pl.limb_axes as float[])[at + 1] = axis.y
        (pl.limb_axes as float[])[at + 2] = axis.z
    } else {
        angle = limb_lift_at(pl, slot, pl.last_t)
        planned = limb_axis_at(pl, slot, pl.last_t)
        if core.v3_len(planned) > 0.000001 { axis = planned }
    }
    axes = pl.lift_axes as float[]
    axes[slot * 3] = axis.x
    axes[slot * 3 + 1] = axis.y
    axes[slot * 3 + 2] = axis.z
    return angle, axis
}

// How far the deepest joint carried by limb `k`'s end (not itself) of the
// rig-space pose `w` is under the ground under the end; 0 when none is.
carried_under(pl: *Planned, r: *pose.Rig, w: ptr, k: int, flat: bool) -> float {
    list = pl.end_list as int[]
    from = k * pose.count(r)
    n = (pl.end_n as int[])[k]
    if n < 1 { return 0.0 }
    at = ikrig.to_ground(r, pose.translation(w, list[from]))
    least = ground_under(pl, at, flat) + GROUND_CLEAR
    deepest = 0.0
    i = 1
    while i < n {
        d = least - ikrig.to_ground(r, pose.translation(w, list[from + i])).y
        if d > deepest { deepest = d }
        i = i + 1
    }
    return deepest
}

// The ground's height under point `g` (the ground's space): the figure's
// floor when `flat` or with no physics, else the first surface down a foot
// could stand on.
ground_under(pl: *Planned, g: Vec3, flat: bool) -> float {
    floor = behaviour.object_position(pl.object as *GameObject).y
    e = pl.engine as *Engine
    if flat || physics.of(e) == null { return floor }
    hit = physics.ground_below(physics.of(e), core.vec3(g.x, floor + GROUND_LOOK, g.z), 0.1, GROUND_LOOK + 1.0, 0.5)
    if !hit.hit { return floor }
    return hit.point.y
}

// A get-up's own frames kept out of the ground, as a take lying on the
// ground was meant to be (get_up_add): in each frame, each arm and leg
// with its middle joint, its end or what its end carries under the floor
// it was taken on solved with them on it (plan_limb), its root left as it
// is. LayToIdle has a forearm 5.4 cm under the floor, the fingers 3.4 and
// the balls of the feet 3.4.
ground_take(c: *Character, t: *Take) {
    pl = planned_of(c)
    r = animator.rig(c.animator as *Animator)
    f = 0
    while f < clips.frames(t) {
        p = clips.frame(t, f)
        pose.world(r, p, pl.worlds)
        k = 0
        while k < 4 {
            plan_limb(pl, r, p, k, true)
            k = k + 1
        }
        f = f + 1
    }
}

// Metres round its capsule kept clear of what moves, standing up: a
// get-up's root carries the capsule up to 0.24 m from under the pelvis
// (LayToIdle's), and its arms swing past it.
const RISE_ROOM = 0.25

// Whether a figure lying where its ragdoll's pelvis is has room to stand
// up there: its capsule, RISE_ROOM wider, on the ground under the pelvis,
// clear of everything that moves but the figures (physics.capsule_room).
room_to_rise(c: *Character) -> bool {
    if c == null || c.physanim == null || c.capsule == null { return true }
    e = c.engine as *Engine
    ph = physics.of(e)
    rag = physanim.ragdoll_of(c.physanim as *Physanim)
    pelvis = behaviour.object_position(physics.ragdoll_bone(rag, 0))
    ground = physics.ground_below(ph, pelvis, 0.1, 3.0, 0.5).point.y
    cap = c.capsule as *CharacterController
    return physics.capsule_room(ph, core.vec3(pelvis.x, ground, pelvis.z), physics.character_radius(cap) + RISE_ROOM, physics.character_height(cap))
}

// Pose `p` rooted as pose `first` (a get-up's first frame) roots it: its
// root joint's place and turn taken from `first`, the joints under it put
// back where they were, so nothing drawn moves. A get-up's take has its root
// joint under its pelvis (clips.root_under_pelvis: LayToIdle's 0.24 m off the
// object, the pelvis 0.24 m back over it) while the body lying has it at the
// object; inertialized from there, the root's offset and the pelvis's eased
// out against each other along different curves, and the drawn pelvis
// wandered off the capsule as it eased: up to 2.8 mm (mean 1.4) over 100
// knockdowns, 0.08 mm on every one rooted so (test_knockdowns).
rooted_as(r: *pose.Rig, p: ptr, first: ptr) {
    root = pose.human(r, pose.ROOT)
    if root < 0 || root == pose.human(r, pose.PELVIS) || pose.parent(r, root) >= 0 { return }
    was_t = pose.translation(p, root)
    was_q = pose.rotation(p, root)
    s = pose.scale(p, root)
    now_t = pose.translation(first, root)
    now_q = pose.rotation(first, root)
    back = core.quat_conjugate(now_q)
    j = 0
    while j < pose.count(r) {
        if pose.parent(r, j) == root {
            t = pose.translation(p, j)
            at = core.v3_add(was_t, core.quat_apply(was_q, core.vec3(t.x * s.x, t.y * s.y, t.z * s.z)))
            local = core.quat_apply(back, core.v3_sub(at, now_t))
            pose.set_translation(p, j, core.vec3(local.x / s.x, local.y / s.y, local.z / s.z))
            pose.set_rotation(p, j, core.quat_normalize(core.quat_mul(back, core.quat_mul(was_q, pose.rotation(p, j)))))
        }
        j = j + 1
    }
    pose.set_translation(p, root, now_t)
    pose.set_rotation(p, root, now_q)
}

// Seconds a get-up's easing is lengthened by at a time (get_up_blend), and
// the most it is eased over.
const EASE_MORE = 0.05
const EASE_MOST = 2.0

// The seconds a get-up's pelvis is lowered over from pose `drawn` (about
// the object as it stands, laid under the body) onto take `t`'s (plan_step):
// PLAN_DROP times `blend` (the turn's), or as much longer as keeps the drawn
// pelvis within the take's own fastest pelvis while it comes down. The
// pelvis drawn goes as the take's own (frame to frame, where its root
// carries it) and its height off the take's first frame's (`first`) eased
// out on the plan's curve. A body lying on its side has its pelvis up to
// 0.27 m over LayToIdle's first frame's on its back (0.03 m): lowered over
// 0.4 s by the animator's inertialization it went at 1.217 m/s against the
// clip's own fastest 1.221 (test_knockdowns, seed 48), and past it on
// another platform's fall (0.13 m/s past, macOS). `w` a pose to work in.
get_up_blend(r: *pose.Rig, o: *GameObject, t: *Take, drawn: ptr, first: ptr, w: ptr, blend: float) -> float {
    seconds = blend * PLAN_DROP
    off = joint_ground(r, drawn, w, pose.PELVIS).y - joint_ground(r, first, w, pose.PELVIS).y
    frames = clips.frames(t)
    if core.abs_of(off) < 0.000001 || frames < 2 { return seconds }
    // Up or down, in the object's frame, as the take's pelvis is read.
    way = core.vec3(0.0, 1.0, 0.0)
    if off < 0.0 {
        way = core.vec3(0.0, 0.0 - 1.0, 0.0)
        off = 0.0 - off
    }
    speeds = take_pelvis_speeds(r, o, t, w, drawn)
    v = speeds as float[]
    most = 0.0
    f = 0
    while f < frames - 1 {
        s = core.v3_len(core.vec3(v[f * 3], v[f * 3 + 1], v[f * 3 + 2]))
        if s > most { most = s }
        f = f + 1
    }
    while seconds < EASE_MOST && eased_fastest(v, frames, clips.rate(t), way, off, seconds) > most {
        seconds = seconds + EASE_MORE
    }
    free(speeds)
    return seconds
}

// The fastest the pelvis drawn goes while an offset `off` along `way` (unit)
// eases out over `seconds` (plan_step's curve) on top of the take's own pelvis
// velocities `v` (`frames` - 1 of them, 3 floats each, at `rate`): sampled
// at 60 Hz, as the engine steps.
eased_fastest(v: float[], frames: int, rate: float, way: Vec3, off: float, seconds: float) -> float {
    most = 0.0
    k = 1
    while (k as float) / 60.0 <= seconds {
        at = (k as float) / 60.0
        // The offset eased out on the plan's curve (smoothest): off times one
        // less it, its speed off times its slope.
        u = at / seconds
        eased = 0.0 - off * 30.0 * u * u * (1.0 - u) * (1.0 - u) / seconds
        f = (at * rate) as int
        if f > frames - 2 { f = frames - 2 }
        own = core.vec3(v[f * 3], v[f * 3 + 1], v[f * 3 + 2])
        s = core.v3_len(core.v3_add(own, core.v3_mul(way, eased)))
        if s > most { most = s }
        k = k + 1
    }
    return most
}

// Take `t`'s pelvis velocity frame to frame where its root carries it, about
// the object as it stands, in its frame, metres a second: frames - 1 of
// them, 3 floats each, the caller's to free. `w` and `p` poses to work in
// (`p` overwritten).
take_pelvis_speeds(r: *pose.Rig, o: *GameObject, t: *Take, w: ptr, p: ptr) -> ptr {
    frames = clips.frames(t)
    speeds = calloc(frames * 3, 8)
    v = speeds as float[]
    rate = clips.rate(t)
    was = take_pelvis_at(r, o, t, 0, w, p)
    f = 1
    while f < frames {
        now = take_pelvis_at(r, o, t, f, w, p)
        d = core.v3_mul(core.v3_sub(now, was), rate)
        v[(f - 1) * 3] = d.x
        v[(f - 1) * 3 + 1] = d.y
        v[(f - 1) * 3 + 2] = d.z
        was = now
        f = f + 1
    }
    return speeds
}

// Frame `f`'s pelvis where take `t`'s root motion has carried it, about the
// object as it stands, in its frame.
take_pelvis_at(r: *pose.Rig, o: *GameObject, t: *Take, f: int, w: ptr, p: ptr) -> Vec3 {
    clips.sample_frame(t, r, f, p)
    went = clips.travel(t, (f as float) / clips.rate(t))
    zero = clips.ground_point(r, core.vec3(0.0, 0.0, 0.0))
    ground = core.v3_sub(clips.ground_point(r, core.vec3(went.x, 0.0, went.y)), zero)
    carried = core.quat_apply(core.quat_conjugate(behaviour.object_rotation(o)), ground)
    turned = core.quat_apply(core.quat_rotate(went.z, core.vec3(0.0, 1.0, 0.0)), joint_about(r, o, p, w, pose.PELVIS))
    return core.v3_add(carried, turned)
}

// The object upright on the ground under the ragdoll's pelvis, facing as it
// did, and the rig drawn from the bodies about it, read into `p`. Lying
// LIMP, the ragdoll drew the object where its pelvis carried it, turned as
// the pelvis lies.
under_body(c: *Character, p: ptr) {
    o = c.object as *GameObject
    e = c.engine as *Engine
    rag = physanim.ragdoll_of(c.physanim as *Physanim)
    pelvis = behaviour.object_position(physics.ragdoll_bone(rag, 0))
    ground = physics.ground_below(physics.of(e), pelvis, 0.1, 3.0, 0.5).point.y
    ahead = flat_of(core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)))
    resume(c, core.vec3(pelvis.x, ground, pelvis.z), ahead)
    physics.ragdoll_show_pose(rag, null, true)
    pose.read(animator.rig(c.animator as *Animator), p)
}

flat_of(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

// How a body lies: face up, face down, on its left side (its right
// shoulder over its left) or on its right.
const LIES_UP = 0
const LIES_DOWN = 1
const LIES_LEFT = 2
const LIES_RIGHT = 3

// What a get-up lying the other way scores against one lying as the body
// does (choose_get_up): more than any pose's distance.
const LIES_OTHER = 1000.0

// The joints a get-up's first frame is matched to the body by.
const MATCH_JOINTS = 9

// The get-up to play from pose `drawn` (about the object as it stands): of
// those whose first frame lies as the body does (lies), the one whose first
// frame, laid onto the body (lay_onto), has its head, elbows, hands, knees
// and feet nearest the body's (summed squared distances, as a motion
// matcher's pose cost); the nearest of all when none lies that way. The
// bodies near weigh in (way_overlap): each metre-second its way goes into
// them costs INTO_COST more, and a way that meets another figure's way up
// is not taken. Laid as the body lies first, then turned about the pelvis
// by each of UP_TURNS while the best yet still meets a body. The state,
// the turn off the body's own (lay_onto's `extra`), whether its way is
// clear of the ways up (when none is, the one that meets them least), and
// how far it goes into the bodies near (metre-seconds). `w` and `first`
// poses to work in.
choose_get_up(c: *Character, drawn: ptr, w: ptr, first: ptr) -> (int, float, bool, float) {
    a = c.animator as *Animator
    r = animator.rig(a)
    o = c.object as *GameObject
    body_lies = lies(r, drawn, w)
    began = os.now_monotonic_ns()
    near = near_new(c)
    pl = c.planned as *Planned
    pl.score_s = pl.score_s + ((os.now_monotonic_ns() - began) as float) * 0.000000001
    turns = [0.0, UP_TURN, 0.0 - UP_TURN, 2.0 * UP_TURN, 0.0 - 2.0 * UP_TURN]
    best = (c.get_ups as int[])[0]
    best_extra = 0.0
    best_cost = 0.0
    best_into = 0.0
    found = false
    least = 0.0
    least_state = best
    least_extra = 0.0
    least_into = 0.0
    looked = false
    k = 0
    while k < UP_TURNS && (!found || best_into > 0.0) {
        i = 0
        while i < c.get_up_count {
            state = (c.get_ups as int[])[i]
            t = animator.state_take(a, state)
            at, facing = lay_onto(r, o, drawn, t, w, first, turns[k])
            cost = laid_distance(r, o, drawn, first, w, at, facing)
            if lies(r, first, w) != body_lies { cost = cost + LIES_OTHER }
            // A way only adds to its pose's cost: one already dearer than
            // the best clear one is not scored.
            into = 0.0
            crossed = 0.0 - 1.0
            if !found || cost < best_cost {
                began = os.now_monotonic_ns()
                into, crossed = way_overlap(c, near, i, at, facing)
                pl.score_s = pl.score_s + ((os.now_monotonic_ns() - began) as float) * 0.000000001
            }
            cost = cost + into * INTO_COST
            if crossed <= 0.0 && (!found || cost < best_cost) {
                best = state
                best_extra = turns[k]
                best_cost = cost
                best_into = into
                found = true
            }
            // Meeting a way up least, by how deep, the cost breaking a tie.
            meets = crossed * LIES_OTHER + cost
            if !looked || meets < least {
                least = meets
                least_state = state
                least_extra = turns[k]
                least_into = into
                looked = true
            }
            i = i + 1
        }
        k = k + 1
    }
    // Still into a body near at every turn: the way laid off the body
    // (up_shift), SHIFT_STEP at a time up to SHIFT_MOST, each of SHIFT_WAYS
    // ways round, as a person lying against another shifts off it before
    // rising; the shift is paid for in the pose's distance (laid_distance),
    // and the hand-over eases the body there (get_up_blend reads the
    // pelvis's offset). Two lying 0.5 m apart, one across the other's hips,
    // had every way and turn 0.10 to 0.27 metre-seconds into the other: the
    // one that went first drew its hips 7.8 cm into the other's body
    // (test_get_up_pair); shifted, no way goes in.
    c.up_shift = core.vec3(0.0, 0.0, 0.0)
    if found && best_into > 0.0 {
        m = 1
        while m * SHIFT_STEP <= SHIFT_MOST + 0.0001 && best_into > 0.0 {
            h = 0
            while h < SHIFT_WAYS {
                ang = 6.2831853 * (h as float) / (SHIFT_WAYS as float)
                shift = core.vec3(core.sin_of(ang) * SHIFT_STEP * (m as float), 0.0, core.cos_of(ang) * SHIFT_STEP * (m as float))
                k = 0
                while k < UP_TURNS {
                    i = 0
                    while i < c.get_up_count {
                        state = (c.get_ups as int[])[i]
                        t = animator.state_take(a, state)
                        at, facing = lay_onto(r, o, drawn, t, w, first, turns[k])
                        at = core.v3_add(at, shift)
                        cost = laid_distance(r, o, drawn, first, w, at, facing)
                        if lies(r, first, w) != body_lies { cost = cost + LIES_OTHER }
                        into, crossed = way_overlap(c, near, i, at, facing)
                        cost = cost + into * INTO_COST
                        if crossed <= 0.0 && cost < best_cost {
                            best = state
                            best_extra = turns[k]
                            best_cost = cost
                            best_into = into
                            c.up_shift = shift
                        }
                        i = i + 1
                    }
                    k = k + 1
                }
                h = h + 1
            }
            m = m + 1
        }
    }
    near_free(near)
    if found { return best, best_extra, true, best_into }
    return least_state, least_extra, false, least_into
}

// Metres a way up is laid off the body at a time and at the most, and how
// many ways round it is tried (choose_get_up).
const SHIFT_STEP = 0.15
const SHIFT_MOST = 0.45
const SHIFT_WAYS = 8

// Which of its get-ups state `state` is (its place in get_ups); -1 none.
get_up_index(c: *Character, state: int) -> int {
    i = 0
    while i < c.get_up_count {
        if (c.get_ups as int[])[i] == state { return i }
        i = i + 1
    }
    return 0 - 1
}

// --- a get-up's way clear of other bodies (#835) -----------------------------------------------------

// Each get-up's way up sampled this many times a second (way_of), at most
// PATH_MOST samples (10 s).
const PATH_RATE = 10.0
const PATH_MOST = 100
// The joints a way follows, in this order (way_slot): the pelvis, the
// spine's, the neck and the head, each leg's hip, knee and ankle, each arm's
// shoulder, elbow and wrist.
const PATH_JOINTS = 17
// Floats a sample keeps: each joint about the object (3 each), then a
// sphere about them all (its centre and radius).
const PATH_STRIDE = 55
// The parts a way is scored by: the ragdoll's bones in the human's order
// (pelvis, spine, chest, neck, each thigh and calf, each upper and lower
// arm), each between two of the way's joints (Near's `from` and `to`),
// as thick as its bone's capsule.
const PATH_SEGS = 12
// The most bodies near and figures getting up a way is scored against, and
// metres about the pelvis bodies are looked for.
const NEAR_MOST = 256
const RISERS_MOST = 16
const NEAR_REACH = 2.5
// Metres a way's parts may go into another's, touching: the give of two
// bodies pressed together.
const WAY_GIVE = 0.02
// Radians a get-up is turned about the pelvis when laid as the body lies is
// not clear (choose_get_up): at most twice, either way, as a person lying
// in another's way first turns from it.
const UP_TURN = 0.5
const UP_TURNS = 5
// What a metre-second of a way into a body near costs against the pose's
// nearness (choose_get_up: summed squared metres, 0.3 to 3 for the turns):
// a centimetre in for a second weighs as a pose a metre off. At a tenth of
// that, a way 19 cm-seconds into a body lying beside it was taken over a
// clear one turned a radian, and its hips went 6.8 cm into the other's.
const INTO_COST = 100.0

way_slot(k: int) -> int {
    slots = [pose.PELVIS, pose.SPINE_01, pose.SPINE_03, pose.NECK, pose.HEAD,
             pose.THIGH_L, pose.CALF_L, pose.FOOT_L, pose.THIGH_R, pose.CALF_R, pose.FOOT_R,
             pose.UPPERARM_L, pose.LOWERARM_L, pose.HAND_L, pose.UPPERARM_R, pose.LOWERARM_R, pose.HAND_R]
    return slots[k]
}

// Take `t`'s way: at PATH_RATE samples a second over it, each of its
// PATH_JOINTS joints where its root motion carries it, about the object as
// it stands, in its frame (the object at the origin facing +z), and the
// sphere about them. The samples (the caller's to free) and how many.
way_of(c: *Character, t: *Take) -> (ptr, int) {
    a = c.animator as *Animator
    r = animator.rig(a)
    o = c.object as *GameObject
    n = (clips.duration(t) * PATH_RATE) as int + 1
    if n > PATH_MOST { n = PATH_MOST }
    way = calloc(n * PATH_STRIDE, 8)
    v = way as float[]
    p = pose.new(r)
    w = pose.new(r)
    back = core.quat_conjugate(behaviour.object_rotation(o))
    here = behaviour.object_position(o)
    zero = clips.ground_point(r, core.vec3(0.0, 0.0, 0.0))
    s = 0
    while s < n {
        at = (s as float) / PATH_RATE
        if at > clips.duration(t) { at = clips.duration(t) }
        clips.sample(t, r, at, false, p)
        pose.world(r, p, w)
        went = clips.travel(t, at)
        carried = core.quat_apply(back, core.v3_sub(clips.ground_point(r, core.vec3(went.x, 0.0, went.y)), zero))
        turn = core.quat_rotate(went.z, core.vec3(0.0, 1.0, 0.0))
        b = s * PATH_STRIDE
        centre = core.vec3(0.0, 0.0, 0.0)
        k = 0
        while k < PATH_JOINTS {
            j = pose.human(r, way_slot(k))
            about = core.vec3(0.0, 0.0, 0.0)
            if j >= 0 { about = core.quat_apply(back, core.v3_sub(clips.ground_point(r, pose.translation(w, j)), here)) }
            q = core.v3_add(carried, core.quat_apply(turn, about))
            v[b + k * 3] = q.x
            v[b + k * 3 + 1] = q.y
            v[b + k * 3 + 2] = q.z
            centre = core.v3_add(centre, q)
            k = k + 1
        }
        centre = core.v3_mul(centre, 1.0 / (PATH_JOINTS as float))
        reach = 0.0
        k = 0
        while k < PATH_JOINTS {
            d = core.v3_len(core.v3_sub(core.vec3(v[b + k * 3], v[b + k * 3 + 1], v[b + k * 3 + 2]), centre))
            if d > reach { reach = d }
            k = k + 1
        }
        v[b + 51] = centre.x
        v[b + 52] = centre.y
        v[b + 53] = centre.z
        v[b + 54] = reach
        s = s + 1
    }
    pose.release(p)
    pose.release(w)
    return way, n
}

// What a get-up's way is scored against (way_overlap): the capsules of what
// moves near (physics.moving_capsules), past the figure's own bodies and
// those of figures getting up; and those figures, by their ways ahead.
struct Near {
    caps: ptr                      // float[NEAR_MOST * physics.CAPSULE_STRIDE]
    owners: ptr                    // ptr[NEAR_MOST]
    count: int
    risers: ptr                    // ptr[RISERS_MOST]: *Character getting up
    riser_t: ptr                   // float[RISERS_MOST]: seconds into its get-up now
    riser_r: ptr                   // float[RISERS_MOST * PATH_SEGS]: its parts' thickness
    riser_n: int
    radii: ptr                     // float[PATH_SEGS]: the figure's own parts' thickness
    thickest: float
    pts: ptr                       // float[PATH_JOINTS * 3]: a sample's joints placed
    other: ptr                     // and another's
    from: ptr                      // int[PATH_SEGS]: each part's first joint in a way
    to: ptr                        // int[PATH_SEGS]: and its second
}

// The bodies near `c` gathered (Near), as it lies now.
near_new(c: *Character) -> *Near {
    n = heap.new(Near)
    n.caps = calloc(NEAR_MOST * physics.CAPSULE_STRIDE, 8)
    n.owners = calloc(NEAR_MOST, 8)
    n.risers = calloc(RISERS_MOST, 8)
    n.riser_t = calloc(RISERS_MOST, 8)
    n.riser_r = calloc(RISERS_MOST * PATH_SEGS, 8)
    n.radii = calloc(PATH_SEGS, 8)
    n.pts = calloc(PATH_JOINTS * 3, 8)
    n.other = calloc(PATH_JOINTS * 3, 8)
    n.from = calloc(PATH_SEGS, 4)
    n.to = calloc(PATH_SEGS, 4)
    from = [0, 1, 2, 3, 5, 6, 8, 9, 11, 12, 14, 15]
    to = [1, 2, 3, 4, 6, 7, 9, 10, 12, 13, 15, 16]
    own = physanim.ragdoll_of(c.physanim as *Physanim)
    radii = n.radii as float[]
    j = 0
    while j < PATH_SEGS {
        (n.from as int[])[j] = from[j]
        (n.to as int[])[j] = to[j]
        radii[j] = physics.ragdoll_bone_radius(own, j)
        if radii[j] > n.thickest { n.thickest = radii[j] }
        j = j + 1
    }
    e = c.engine as *Engine
    here = behaviour.object_position(c.object as *GameObject)
    reach = core.vec3(NEAR_REACH, NEAR_REACH, NEAR_REACH)
    n.count = physics.moving_capsules(physics.of(e), core.v3_sub(here, reach), core.v3_add(here, reach), own as ptr, n.caps, n.owners, NEAR_MOST)
    // Figures getting up are scored by their ways ahead, not where their
    // bodies are now; figures with no ragdoll by their capsules.
    if g_people != null {
        i = 0
        while i < list.size(g_people) {
            other = list.get_raw(g_people, i) as *Character
            if other != c && other.engine == c.engine {
                there = behaviour.object_position(other.object as *GameObject)
                apart = core.v3_len(flat_of(core.v3_sub(there, here)))
                if other.physanim == null {
                    if apart < NEAR_REACH * 2.0 && n.count < NEAR_MOST { near_upright(n, other) }
                } else if other.acting && other.getting_up && !other.up_waiting && other.up_index >= 0 && apart < NEAR_REACH * 2.0 && n.riser_n < RISERS_MOST {
                    near_riser(n, other)
                }
            }
            i = i + 1
        }
    }
    return n
}

// A figure with no ragdoll as its upright capsule.
near_upright(n: *Near, other: *Character) {
    o = other.object as *GameObject
    feet = behaviour.object_position(o)
    s = behaviour.object_scale(o).y
    radius = CAPSULE_RADIUS * s
    tall = standing_height(animator.rig(other.animator as *Animator), o)
    caps = n.caps as float[]
    k = n.count * physics.CAPSULE_STRIDE
    caps[k] = feet.x
    caps[k + 1] = feet.y + radius
    caps[k + 2] = feet.z
    caps[k + 3] = feet.x
    top = tall - radius
    if top < radius { top = radius }
    caps[k + 4] = feet.y + top
    caps[k + 5] = feet.z
    caps[k + 6] = radius
    (n.owners as ptr[])[n.count] = other as ptr
    n.count = n.count + 1
}

// A figure getting up as its way ahead: its bodies dropped from the
// capsules, its time into the get-up and its parts' thickness kept.
near_riser(n: *Near, other: *Character) {
    body = physanim.ragdoll_of(other.physanim as *Physanim)
    rag = body as ptr
    caps = n.caps as float[]
    owners = n.owners as ptr[]
    kept = 0
    i = 0
    while i < n.count {
        if owners[i] != rag {
            if kept != i {
                f = 0
                while f < physics.CAPSULE_STRIDE {
                    caps[kept * physics.CAPSULE_STRIDE + f] = caps[i * physics.CAPSULE_STRIDE + f]
                    f = f + 1
                }
                owners[kept] = owners[i]
            }
            kept = kept + 1
        }
        i = i + 1
    }
    n.count = kept
    a = other.animator as *Animator
    t = 0.0
    if animator.current(a) == other.act_state { t = animator.state_time(a) }
    (n.risers as ptr[])[n.riser_n] = other as ptr
    (n.riser_t as float[])[n.riser_n] = t
    r = n.riser_r as float[]
    j = 0
    while j < PATH_SEGS {
        r[n.riser_n * PATH_SEGS + j] = physics.ragdoll_bone_radius(body, j)
        j = j + 1
    }
    n.riser_n = n.riser_n + 1
}

near_free(n: *Near) {
    free(n.caps)
    free(n.owners)
    free(n.risers)
    free(n.riser_t)
    free(n.riser_r)
    free(n.radii)
    free(n.pts)
    free(n.other)
    free(n.from)
    free(n.to)
    heap.free(n)
}

// Sample `s` of way `v` placed: laid at `base` (the object's place) turned
// `q`, its joints into `out`.
way_place(v: float[], s: int, base: Vec3, q: Quat, out: float[]) {
    b = s * PATH_STRIDE
    k = 0
    while k < PATH_JOINTS {
        p = core.v3_add(base, core.quat_apply(q, core.vec3(v[b + k * 3], v[b + k * 3 + 1], v[b + k * 3 + 2])))
        out[k * 3] = p.x
        out[k * 3 + 1] = p.y
        out[k * 3 + 2] = p.z
        k = k + 1
    }
}

way_point(v: float[], k: int) -> Vec3 { return core.vec3(v[k * 3], v[k * 3 + 1], v[k * 3 + 2]) }

// How far get-up `i`'s way, its first frame laid at `at` facing `facing`
// (lay_onto), goes into what is near (`near`), at each sample, part by
// part: its depth past touching (the two thicknesses less the distance),
// less WAY_GIVE. Two answers, as the two are met differently:
//   - into the bodies near (lying, standing): the depths summed over the
//     way, metre-seconds. A body lying limp is shoved aside by a way that
//     meets it, so the way that meets it least is chosen, not none;
//   - into a figure getting up, where its way will have it then: the
//     deepest (-1 for none). Two ways up are both drawn as planned, through
//     each other (#835), so one that meets another's is not taken.
way_overlap(c: *Character, near: *Near, i: int, at: Vec3, facing: Vec3) -> (float, float) {
    v = (c.up_paths as ptr[])[i] as float[]
    n = (c.up_path_n as int[])[i]
    if v == null || n == 0 { return 0.0, 0.0 - 1.0 }
    base = core.vec3(at.x, behaviour.object_position(c.object as *GameObject).y, at.z)
    q = core.quat_rotate(core.atan2_of(facing.x, facing.z), core.vec3(0.0, 1.0, 0.0))
    caps = near.caps as float[]
    radii = near.radii as float[]
    pts = near.pts as float[]
    from = near.from as int[]
    to = near.to as int[]
    into = 0.0
    crossed = 0.0 - 1.0
    s = 0
    while s < n {
        b = s * PATH_STRIDE
        centre = core.v3_add(base, core.quat_apply(q, core.vec3(v[b + 51], v[b + 52], v[b + 53])))
        reach = v[b + 54] + near.thickest
        placed = false
        depth = 0.0
        k = 0
        while k < near.count {
            f = k * physics.CAPSULE_STRIDE
            p1 = core.vec3(caps[f], caps[f + 1], caps[f + 2])
            p2 = core.vec3(caps[f + 3], caps[f + 4], caps[f + 5])
            rk = caps[f + 6]
            if physics.segments_apart(centre, centre, p1, p2) <= reach + rk {
                if !placed {
                    way_place(v, s, base, q, pts)
                    placed = true
                }
                j = 0
                while j < PATH_SEGS {
                    d = radii[j] + rk - WAY_GIVE - physics.segments_apart(way_point(pts, from[j]), way_point(pts, to[j]), p1, p2)
                    if d > depth { depth = d }
                    j = j + 1
                }
            }
            k = k + 1
        }
        into = into + depth / PATH_RATE
        h = 0
        while h < near.riser_n {
            d = riser_depth(near, h, s, centre, reach, base, q, v) - WAY_GIVE
            if d > crossed { crossed = d }
            h = h + 1
        }
        s = s + 1
    }
    return into, crossed
}

// The depth of sample `s` of the figure's way (placed at `base` turned `q`,
// its sphere about `centre` `reach` wide) into riser `h` of `near` where
// its own way will have it then; -1 when they are apart.
riser_depth(near: *Near, h: int, s: int, centre: Vec3, reach: float, base: Vec3, q: Quat, v: float[]) -> float {
    other = (near.risers as ptr[])[h] as *Character
    ov = (other.up_paths as ptr[])[other.up_index] as float[]
    on = (other.up_path_n as int[])[other.up_index]
    if ov == null || on == 0 { return 0.0 - 1.0 }
    then = ((near.riser_t as float[])[h] * PATH_RATE + 0.5) as int + s
    if then > on - 1 { then = on - 1 }
    obase = core.vec3(other.up_at.x, behaviour.object_position(other.object as *GameObject).y, other.up_at.z)
    oq = core.quat_rotate(core.atan2_of(other.up_facing.x, other.up_facing.z), core.vec3(0.0, 1.0, 0.0))
    ob = then * PATH_STRIDE
    ocentre = core.v3_add(obase, core.quat_apply(oq, core.vec3(ov[ob + 51], ov[ob + 52], ov[ob + 53])))
    oradii = near.riser_r as float[]
    if core.v3_len(core.v3_sub(centre, ocentre)) > reach + ov[ob + 54] + near.thickest { return 0.0 - 1.0 }
    pts = near.pts as float[]
    other_pts = near.other as float[]
    radii = near.radii as float[]
    way_place(v, s, base, q, pts)
    way_place(ov, then, obase, oq, other_pts)
    from = near.from as int[]
    to = near.to as int[]
    depth = 0.0 - 1.0
    j = 0
    while j < PATH_SEGS {
        a1 = way_point(pts, from[j])
        a2 = way_point(pts, to[j])
        k = 0
        while k < PATH_SEGS {
            d = radii[j] + oradii[h * PATH_SEGS + k] - physics.segments_apart(a1, a2, way_point(other_pts, from[k]), way_point(other_pts, to[k]))
            if d > depth { depth = d }
            k = k + 1
        }
        j = j + 1
    }
    return depth
}

// A figure told to get up while its way was not clear (get_up), lying on:
// every WAIT_LOOK seconds it looks again (get_up_try), and gets up once its
// way is clear, or once it has waited WAIT_MOST.
up_wait(c: *Character, dt: float) {
    c.up_waited = c.up_waited + dt
    c.up_look = c.up_look - dt
    if c.up_look > 0.0 && (c.up_waited < WAIT_MOST || c.up_blocked) { return }
    _state = get_up_try(c, c.up_motion as *Motion, c.up_blend, true)
}

// How pose `p` lies (LIES_UP to LIES_RIGHT), by its chest's front and the
// line across its shoulders in the ground's space: the front up or down,
// or the line across more upright than the front. The front is the spine
// (pelvis to neck) crossed with the line across, its sign the one that
// points it the way the rest pose's feet do.
lies(r: *pose.Rig, p: ptr, w: ptr) -> int {
    front, across = chest_front(r, p, w)
    rest_front, _rest_across = chest_front(r, pose.rest(r), w)
    pose.world(r, pose.rest(r), w)
    toes = core.v3_sub(clips.ground_point(r, pose.translation(w, pose.human(r, pose.BALL_L))), clips.ground_point(r, pose.translation(w, pose.human(r, pose.FOOT_L))))
    if core.v3_dot(flat_of(rest_front), flat_of(toes)) < 0.0 { front = core.v3_mul(front, 0.0 - 1.0) }
    if core.abs_of(front.y) >= core.abs_of(across.y) {
        if front.y >= 0.0 { return LIES_UP }
        return LIES_DOWN
    }
    if across.y > 0.0 { return LIES_LEFT }
    return LIES_RIGHT
}

// The spine crossed with the line from the left shoulder to the right, and
// that line, both unit, in the ground's space.
chest_front(r: *pose.Rig, p: ptr, w: ptr) -> (Vec3, Vec3) {
    pelvis = joint_ground(r, p, w, pose.PELVIS)
    spine = core.v3_sub(joint_ground(r, p, w, pose.NECK), pelvis)
    across = core.v3_sub(joint_ground(r, p, w, pose.UPPERARM_R), joint_ground(r, p, w, pose.UPPERARM_L))
    front = core.v3_cross(spine, across)
    if core.v3_len(front) > 0.000001 { front = core.v3_normalize(front) }
    if core.v3_len(across) > 0.000001 { across = core.v3_normalize(across) }
    return front, across
}

// Pose `first` (about the object as it stands) laid at `at` facing `facing`,
// against pose `drawn` where it is: the summed squared distances of their
// MATCH_JOINTS joints.
laid_distance(r: *pose.Rig, o: *GameObject, drawn: ptr, first: ptr, w: ptr, at: Vec3, facing: Vec3) -> float {
    slots = [pose.HEAD, pose.LOWERARM_L, pose.LOWERARM_R, pose.HAND_L, pose.HAND_R, pose.CALF_L, pose.CALF_R, pose.FOOT_L, pose.FOOT_R]
    turn = core.quat_rotate(core.atan2_of(facing.x, facing.z), core.vec3(0.0, 1.0, 0.0))
    here = behaviour.object_position(o)
    sum = 0.0
    k = 0
    while k < MATCH_JOINTS {
        if pose.human(r, slots[k]) >= 0 {
            about = joint_about(r, o, first, w, slots[k])
            laid = core.v3_add(core.vec3(at.x, here.y, at.z), core.quat_apply(turn, about))
            d = core.v3_sub(laid, joint_ground(r, drawn, w, slots[k]))
            sum = sum + core.v3_dot(d, d)
        }
        k = k + 1
    }
    return sum
}

// Joint `slot`'s place in the ground's space in pose `p` (locals), the
// figure as its object stands now; `w` a pose to work in.
joint_ground(r: *pose.Rig, p: ptr, w: ptr, slot: int) -> Vec3 {
    pose.world(r, p, w)
    return clips.ground_point(r, pose.translation(w, pose.human(r, slot)))
}

// Joint `slot` in pose `p` about the object, in its frame (its yaw taken
// off): where it would be, the object at the origin facing +z.
joint_about(r: *pose.Rig, o: *GameObject, p: ptr, w: ptr, slot: int) -> Vec3 {
    off = core.v3_sub(joint_ground(r, p, w, slot), behaviour.object_position(o))
    return core.quat_apply(core.quat_conjugate(behaviour.object_rotation(o)), off)
}

// Take `t`'s first frame laid onto the body as it lies (`drawn`, about the
// object as it stands): where the object goes and the way it faces, so the
// take's pelvis is on the drawn pelvis and its spine (pelvis to neck, level)
// lies along the drawn one, turned `extra` radians more about the pelvis
// (choose_get_up: the body turned on the ground from another's way). `w`
// and `first` poses to work in.
lay_onto(r: *pose.Rig, o: *GameObject, drawn: ptr, t: *Take, w: ptr, first: ptr, extra: float = 0.0) -> (Vec3, Vec3) {
    pelvis = joint_ground(r, drawn, w, pose.PELVIS)
    spine = flat_of(core.v3_sub(joint_ground(r, drawn, w, pose.NECK), pelvis))
    clips.sample(t, r, 0.0, false, first)
    clip_pelvis = joint_about(r, o, first, w, pose.PELVIS)
    clip_spine = flat_of(core.v3_sub(joint_about(r, o, first, w, pose.NECK), clip_pelvis))
    yaw = core.atan2_of(spine.x, spine.z) - core.atan2_of(clip_spine.x, clip_spine.z) + extra
    turn = core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0))
    at = core.v3_sub(pelvis, core.quat_apply(turn, flat_of(clip_pelvis)))
    at = core.vec3(at.x, behaviour.object_position(o).y, at.z)
    return at, core.quat_apply(turn, core.vec3(0.0, 0.0, 1.0))
}

move(c: *Character, velocity: Vec3, facing: Vec3) {
    c.asked = core.vec3(velocity.x, 0.0, velocity.z)
    c.facing = core.vec3(facing.x, 0.0, facing.z)
}

// Eyes on `point` (the world's) until look_ahead.
look(c: *Character, point: Vec3) {
    c.eyes_free = false
    c.looking = true
    c.look_at = point
}

// Eyes ahead where it goes again.
look_ahead(c: *Character) {
    c.looking = false
    c.eyes_free = false
}

// No look at all, until look or look_ahead: the head as the take has it.
// Struck, a head goes where the blow sends it; held on what it watched, a
// head hit tipped the head back 16 degrees where its take tips it 80.
look_free(c: *Character) {
    c.looking = false
    c.eyes_free = true
}

// The pistol aims of the file at `path` (named `neutral`, `up` and `down`,
// level and 0.7 rad up and down) retargeted onto the figure as its aim
// offset over the spine, the level one also its ready pose. False when the
// file has none of them.
aims(c: *Character, e: *Engine, path: string, neutral: string, up: string, down: string) -> bool {
    a = c.animator as *Animator
    r = animator.rig(a)
    source_o = figure.figure(e, "aims", path)
    if source_o == null { return false }
    behaviour.object_set_position(source_o, core.vec3(0.0, 0.0 - 60.0, 0.0))
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    c.aim = animator.add_aim(a, pose.human(r, pose.SPINE_01))
    names = [neutral, up, down]
    pitches = [0.0, 0.7, 0.0 - 0.7]
    good = true
    k = 0
    while k < 3 {
        made = clips.from_scene(source, figure.scene(source_f), names[k], 0.0)
        if made == null {
            good = false
        } else {
            aimed = animator.add_take(a, retarget.retarget(source, made, r), false)
            animator.aim_add(a, c.aim, aimed, 0.0, pitches[k])
            if k == 0 { c.ready = animator.add_layer(a, aimed, pose.human(r, pose.SPINE_01), false, true) }
            clips.take_free(made)
        }
        k = k + 1
    }
    pose.rig_free(source)
    animator.set_aim(a, c.aim, 0.0, 0.0, 0.0)
    return good
}

// Aim at `target` (the world's): the ready pose over the upper body, the
// aim offset pitched at it, the trunk turned to it, the eyes on it.
aim(c: *Character, target: Vec3) {
    c.aiming = true
    c.target = target
}

aim_off(c: *Character) { c.aiming = false }

// --- using things (#908) ----------------------------------------------------------------------------

// What it is doing with a slot.
const USE_NONE = 0
const USE_GO = 1                   // walking to the slot's approach point
const USE_TURN = 2                 // turning on the spot to face the slot's way
const USE_ENTER = 3                // its enter take, warped onto the slot
const USE_LOOP = 4                 // its loop take, until it leaves
const USE_EXIT = 5                 // its exit take, and the slot let go
// Metres from the approach point it starts to turn at, and how near facing
// the slot's way (radians) it must be to enter.
const ARRIVED = 0.3
const FACED = 0.17
// Metres a second it walks to a slot at.
const USE_WALK = 0.9
// Seconds a hand's IK eases onto a slot's point before its take's contact,
// and off it after.
const REACH_IN = 0.25
const REACH_OUT = 0.35
// And how long before the contact it is all on: the hands' weight follows on
// a spring, and eased in to the contact itself it was still short of whole
// there, the hand 2.2 cm off the tool.
const REACH_HELD = 0.25
// The most takes a character's slots make states of.
const USE_TAKES = 32

// The file a slot's takes are read from when the figure's own has none of
// them (UAL1's sitting takes for the UE5 mannequin), retargeted onto it.
use_takes(c: *Character, path: string) {
    if c.use_source != null { string.release_kept(c.use_source) }
    c.use_source = string.keep(path)
}

// Use slot `slot` of `u`: walk to its approach point, turn there to face its
// way, enter it (the enter take warped so its part lands on the slot at the
// take's contact: animator.warp), then play its loop until leave. False if
// another holds the slot or it is using one already.
use(c: *Character, u: *Usables, slot: int) -> bool {
    if c.use_phase != USE_NONE { return false }
    if !usable.claim(u, slot, c as ptr) { return false }
    c.use_u = u as ptr
    c.use_slot = slot
    c.use_phase = USE_GO
    c.use_t = 0.0
    return true
}

// Leave the slot in use: its exit take, then the slot let go and the figure
// standing.
leave(c: *Character) { c.leaving = true }

using(c: *Character) -> bool { return c.use_phase != USE_NONE }
seated(c: *Character) -> bool { return c.use_phase == USE_LOOP }
use_phase(c: *Character) -> int { return c.use_phase }
// The enter take's time its part lands at, for the slot in use.
use_contact(c: *Character) -> float { return c.use_contact }
use_enter_state(c: *Character) -> int { return c.use_enter }

// The state playing the take named `title`, made the first time: from the
// file `from` retargeted where a slot names one (usable.slot_enter_from and
// the rest, #950), else from the figure's own file or use_takes'. -1 when
// none has it.
take_state(c: *Character, title: string, loop: bool, from: string) -> int {
    a = c.animator as *Animator
    if string.length(title) == 0 { return 0 - 1 }
    key = title
    if string.length(from) > 0 { key = "${from}#${title}" }
    k = 0
    while k < c.use_count {
        if string.equals(name_of_use(c, k), key) == 1 { return (c.use_states as int[])[k] }
        k = k + 1
    }
    r = animator.rig(a)
    t = null as *Take
    if string.length(from) == 0 { t = animator.take(a, title, true) }
    source_path = from
    if t == null && string.length(from) == 0 && c.use_source != null {
        known, _why = string.from_ptr(c.use_source)
        source_path = known
    }
    if t == null && string.length(source_path) > 0 {
        e = c.engine as *Engine
        so = figure.figure(e, "takes", source_path)
        if so != null {
            behaviour.object_set_position(so, core.vec3(0.0, 0.0 - 80.0, 0.0))
            sf = figure.figure_of(so)
            source = pose.of_skeleton(figure.skeleton(sf))
            made = clips.from_scene(source, figure.scene(sf), title, 0.0)
            if made != null {
                t = animator.add_take(a, retarget.retarget(source, made, r), true)
                clips.take_free(made)
            }
            pose.rig_free(source)
        }
    }
    if t == null { return 0 - 1 }
    s = animator.add_state(a, title, t, loop)
    if c.use_count >= USE_TAKES { return s }
    (c.use_names as ptr[])[c.use_count] = string.keep(key)
    (c.use_states as int[])[c.use_count] = s
    c.use_count = c.use_count + 1
    return s
}

name_of_use(c: *Character, k: int) -> string {
    text, _why = string.from_ptr((c.use_names as ptr[])[k])
    return text
}

// When take `t`'s part `lands` (usable.LANDS_*) lands: a pelvis when it
// first comes within 1 cm of its height at the take's end (sat down); a
// hand when it has gone furthest from where it was at the take's start (its
// reach: measured from the pelvis, a hand hanging at the side counted as
// reaching at the take's first frame); the feet at the end.
contact_of(t: *Take, r: *pose.Rig, lands: int) -> float {
    if lands == usable.LANDS_FEET { return clips.duration(t) }
    w = pose.new(r)
    pelvis = pose.human(r, pose.PELVIS)
    found = clips.duration(t)
    if lands == usable.LANDS_PELVIS {
        pose.world(r, clips.frame(t, clips.frames(t) - 1), w)
        last = clips.ground_point(r, pose.translation(w, pelvis)).y
        f = 0
        while f < clips.frames(t) {
            pose.world(r, clips.frame(t, f), w)
            if core.abs_of(clips.ground_point(r, pose.translation(w, pelvis)).y - last) < 0.01 {
                found = (f as float) / clips.rate(t)
                f = clips.frames(t)
            }
            f = f + 1
        }
    } else {
        hand = pose.human(r, pose.HAND_R)
        if lands == usable.LANDS_HAND_L { hand = pose.human(r, pose.HAND_L) }
        most = 0.0 - 1.0
        pose.world(r, clips.frame(t, 0), w)
        start = core.v3_sub(clips.ground_point(r, pose.translation(w, hand)), clips.ground_point(r, pose.translation(w, pelvis)))
        f = 0
        while f < clips.frames(t) {
            pose.world(r, clips.frame(t, f), w)
            d = core.v3_sub(clips.ground_point(r, pose.translation(w, hand)), clips.ground_point(r, pose.translation(w, pelvis)))
            reach = core.v3_len(core.v3_sub(d, start))
            if reach > most {
                most = reach
                found = (f as float) / clips.rate(t)
            }
            f = f + 1
        }
    }
    pose.release(w)
    return found
}

// A step of using a slot (see use). True while the figure is the slot's.
use_step(c: *Character, dt: float) -> bool {
    if c.use_phase == USE_NONE { return false }
    a = c.animator as *Animator
    m = c.mover as *Mover
    o = c.object as *GameObject
    u = c.use_u as *Usables
    at = behaviour.object_position(o)
    c.use_t = c.use_t + dt
    if c.use_phase == USE_GO {
        to = core.v3_sub(usable.slot_approach(u, c.use_slot), at)
        to = core.vec3(to.x, 0.0, to.z)
        d = core.v3_len(to)
        ask = core.vec3(0.0, 0.0, 0.0)
        // Asked on until the springs would bring it to rest there.
        if d > ARRIVED && mover.rest_distance(m) < d { ask = core.v3_mul(core.v3_normalize(to), USE_WALK) }
        mover.face(m, 0.0, false)
        mover.ask(m, ask)
        mover.step(m, dt)
        now = animator.current(a)
        // Stood: not in a stop, nor, moving by a database, still carried by a
        // frame that walks.
        still = now != c.stop && now != c.stop_m
        if c.matcher >= 0 { still = animator.ground_speed(a) < STOOD }
        if d <= ARRIVED && core.v3_len(mover.velocity(m)) < 0.05 && still {
            c.use_phase = USE_TURN
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_TURN {
        way = usable.slot_facing(u, c.use_slot)
        yaw = core.atan2_of(way.x, way.z)
        mover.face(m, yaw, true)
        mover.ask(m, core.vec3(0.0, 0.0, 0.0))
        mover.step(m, dt)
        ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
        off = core.abs_of(wrap_angle(yaw - core.atan2_of(ahead.x, ahead.z)))
        // And its feet done turning it (#976): entered with a turn's step
        // still under way, its toe skated 9.8 mm as it sat.
        if off < FACED && c.use_t > 0.3 && !ikrig.feet_turn_busy(c.feet as *Feet) {
            // Entered: the take's own root motion moves it, warped onto the slot.
            c.use_enter = take_state(c, usable.slot_enter(u, c.use_slot), false, usable.slot_enter_from(u, c.use_slot))
            c.use_loop = take_state(c, usable.slot_loop(u, c.use_slot), true, usable.slot_loop_from(u, c.use_slot))
            c.use_exit = take_state(c, usable.slot_exit(u, c.use_slot), false, usable.slot_exit_from(u, c.use_slot))
            if c.use_enter < 0 {
                // A slot that names no takes (a spot to stand at, a bedroll the
                // game lies down on by other means): held as it is reached,
                // facing its way, until it leaves. Refused, a slot with no
                // takes could not even be claimed and walked to (#949).
                if string.length(usable.slot_enter(u, c.use_slot)) == 0 {
                    // Its loop played there if it names one (chopping at a
                    // block, warming the hands at a fire).
                    if c.use_loop >= 0 { animator.play(a, c.use_loop, 0.3) }
                    c.use_phase = USE_LOOP
                    c.use_t = 0.0
                    return true
                }
                usable.release(u, c.use_slot, c as ptr)
                c.use_phase = USE_NONE
                return false
            }
            lands = usable.slot_lands(u, c.use_slot)
            enter_t = animator.state_take(a, c.use_enter)
            c.use_contact = contact_of(enter_t, animator.rig(a), lands)
            animator.set_root_motion(a, true)
            animator.play(a, c.use_enter, 0.3)
            part = pose.PELVIS
            if lands == usable.LANDS_HAND_R { part = pose.HAND_R }
            if lands == usable.LANDS_HAND_L { part = pose.HAND_L }
            if lands != usable.LANDS_FEET { animator.warp(a, c.use_enter, c.use_contact, usable.slot_at(u, c.use_slot), way, part) }
            c.use_phase = USE_ENTER
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_ENTER {
        // A hand's slot: the hand drawn onto it about the take's contact by the
        // whole body (ikrig's full-body reach, the feet held where the take has
        // them), eased in over REACH_IN to REACH_HELD before it and out over
        // REACH_OUT after, as a reach is fitted to what it reaches for. The warp
        // moves the body over the ground only: by it alone, a hand fell 3.2 cm
        // short of a bench's tool; by the arm alone, its reach near full
        // stretch, 1.3 cm.
        lands = usable.slot_lands(u, c.use_slot)
        if lands == usable.LANDS_HAND_L || lands == usable.LANDS_HAND_R {
            side = 1
            if lands == usable.LANDS_HAND_L { side = 0 }
            b = animator.body(a)
            if b == null {
                b = ikrig.body_new(animator.rig(a))
                ikrig.body_hold_feet(b, true)
                animator.set_body(a, b)
            }
            now = animator.state_time(a)
            w = 0.0
            if now < c.use_contact {
                u_in = core.clampf(1.0 - (c.use_contact - REACH_HELD - now) / REACH_IN, 0.0, 1.0)
                w = u_in * u_in * (3.0 - 2.0 * u_in)
            } else {
                u_out = core.clampf(1.0 - (now - c.use_contact) / REACH_OUT, 0.0, 1.0)
                w = u_out * u_out * (3.0 - 2.0 * u_out)
            }
            which = ikrig.BODY_HAND_R
            if side == 0 { which = ikrig.BODY_HAND_L }
            if b != null { ikrig.body_set(b, which, usable.slot_at(u, c.use_slot), w) }
        }
        if animator.current(a) == c.use_enter && animator.state_time(a) >= clips.duration(animator.state_take(a, c.use_enter)) - 0.0001 {
            if c.use_loop >= 0 { animator.play(a, c.use_loop, 0.3) }
            c.use_phase = USE_LOOP
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_LOOP {
        if c.leaving {
            c.leaving = false
            animator.lift_to(a, 0.0, 0.6)
            if c.use_exit >= 0 {
                animator.play(a, c.use_exit, 0.3)
                c.use_phase = USE_EXIT
            } else {
                done_using(c)
            }
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_EXIT {
        if animator.current(a) != c.use_exit || animator.state_time(a) >= clips.duration(animator.state_take(a, c.use_exit)) - 0.0001 {
            done_using(c)
        }
        return true
    }
    return false
}

// The slot let go, the figure standing on its own again, the mover's
// springs where it is.
done_using(c: *Character) {
    a = c.animator as *Animator
    usable.release(c.use_u as *Usables, c.use_slot, c as ptr)
    animator.set_root_motion(a, false)
    animator.lift_to(a, 0.0, 0.3)
    animator.play(a, rest_state(c), 0.4)
    mover.settle(c.mover as *Mover)
    c.use_phase = USE_NONE
}

wrap_angle(x: float) -> float {
    y = x
    while y > 3.141592653589793 { y = y - 6.283185307179586 }
    while y < 0.0 - 3.141592653589793 { y = y + 6.283185307179586 }
    return y
}

// --- each step --------------------------------------------------------------------------------------

character_fixed(state: ptr, e: *Engine, dt: float) {
    c = state as *Character
    if c.up_waiting {
        up_wait(c, dt)
        return
    }
    if c.paused { return }
    a = c.animator as *Animator
    m = c.mover as *Mover
    o = c.object as *GameObject
    at = behaviour.object_position(o)
    clock = animator.profile_now()
    if c.matcher >= 0 && !c.match_built { match_start(c) }
    using_now = use_step(c, dt) || act_step(c)
    asked = c.asked
    if c.staggering {
        // Stepping out a shove (shove): the speed it gave the body on what is
        // asked, easing out, held facing as it faced.
        c.stagger_t = c.stagger_t + dt
        asked = core.v3_add(asked, stagger_left(c))
        if c.stagger_t >= c.stagger_for || using_now { c.staggering = false }
    }
    if !using_now {
        if core.v3_len(c.facing) > 0.0001 {
            mover.face(m, core.atan2_of(c.facing.x, c.facing.z), true)
        } else if c.staggering {
            mover.face(m, c.stagger_face, true)
        } else {
            mover.face(m, 0.0, false)
        }
        clock = animator.profile_add(animator.PROF_CHARACTER, clock)
        steered = steer(c, asked)
        clock = animator.profile_add(animator.PROF_STEER, clock)
        mover.ask(m, steered)
        mover.step(m, dt)
        clock = animator.profile_add(animator.PROF_MOVER, clock)
    }
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    // Turning on the spot, the eyes lead: along the way it is to face, the
    // head, the chest and then the body following (#976).
    if mover.turning_on_spot(m) {
        g = mover.turn_goal(m)
        ahead = core.vec3(core.sin_of(g), 0.0, core.cos_of(g))
    }
    eyes = core.vec3(at.x + ahead.x * LOOK_AHEAD, at.y + EYE_HIGH, at.z + ahead.z * LOOK_AHEAD)
    if c.looking { eyes = c.look_at }
    if c.aiming { eyes = c.target }
    // Eyes ahead lightly; on what it is told to look at or aim at, fully.
    weight = 0.8
    if c.looking || c.aiming { weight = 1.0 }
    if c.eyes_free && !c.aiming { weight = 0.0 }
    // A get-up's head is its take's own (get_up): looked ahead while still
    // crouched, the chest turned with the eyes and pressed a fingertip 2.3
    // cm into the floor (test_knockdowns, every knockdown).
    if c.acting && c.getting_up { weight = 0.0 }
    animator.look_at(a, eyes, weight)
    if c.aim >= 0 {
        w = 0.0
        pitch = 0.0
        if c.aiming {
            w = 1.0
            to = core.v3_sub(c.target, core.vec3(at.x, at.y + EYE_HIGH, at.z))
            pitch = core.atan2_of(to.y, core.v3_len(core.vec3(to.x, 0.0, to.z)))
        }
        animator.set_aim(a, c.aim, 0.0, pitch, w)
        animator.layer_weight(a, c.ready, w, EASE)
    }
    animator.profile_add(animator.PROF_CHARACTER, clock)
}

// --- underneath -------------------------------------------------------------------------------------

animator_of(c: *Character) -> *Animator { return c.animator as *Animator }
mover_of(c: *Character) -> *Mover { return c.mover as *Mover }
feet_of(c: *Character) -> *Feet { return c.feet as *Feet }
object_of(c: *Character) -> *GameObject { return c.object as *GameObject }
idle_state(c: *Character) -> int { return c.idle }
// Whether it stands: in either stand (the stand or its mirror), or, moving
// by a database, on a frame that hardly goes anywhere, nor asked to.
standing(c: *Character) -> bool {
    now = animator.current(c.animator as *Animator)
    if c.matcher >= 0 { return now == c.matcher && animator.ground_speed(c.animator as *Animator) < STOOD && core.v3_len(c.asked) < 0.05 }
    return now == c.idle || now == c.idle_m
}
move_state(c: *Character) -> int { return c.walk }

// --- avoidance (#956) ---------------------------------------------------------------------------------

// Seconds ahead a meeting is looked for, in steps of AVOID_DT (AVOID_SAMPLES
// of them), and the room kept between two capsules beyond their radii. A
// neighbour is one that could meet it within the horizon at the speeds they
// go. The horizon is the time a walker's curve needs to clear another: its
// way turns about 20 degrees a second (ae3d.mover's curve), so two walkers
// meeting head on need some two seconds of turning to pass a capsule apart:
// looking 2.5 s ahead, two walkers in the plaza still touched for 25 steps.
const AVOID_HORIZON = 4.0
const AVOID_DT = 0.1
const AVOID_SAMPLES = 40
// A neighbour as steer reads it: the distance their centres keep, its offset
// now, and its way ahead (AVOID_SAMPLES x and z pairs), all from here.
const AVOID_STRIDE = 83
const AVOID_ROOM = 0.06
// What turning off the way asked costs (a whole turn of the asked speed: 1),
// what a meeting `t` seconds ahead costs (AVOID_MEET * (1 / t - 1 / the
// horizon), nothing at the horizon so a meeting coming into it does not
// jolt the choice), and the small lean
// to the right two walkers meeting head on share so they pass, not mirror.
const AVOID_TURN = 1.0
const AVOID_MEET = 1.2
const AVOID_RIGHT = 0.02
// And what leaving the way it chose last step costs (a whole turn: AVOID_KEEP).
const AVOID_KEEP = 0.6
// The share of the way to its new choice a steered velocity goes each step.
const AVOID_EASE = 0.12

var g_people: ptr = null                // list of *Character: every character, for avoidance

// A body lying (#979): a character paused, its ragdoll let go to another
// writer (a fall, struck), is no capsule but its bodies on the ground, and
// a walker steps round them: each body's capsule, its two ends and its
// middle, a neighbour standing still as wide as the capsule, the body met
// when any of them is. Skipped as paused, walkers walked through the
// struck; by the bodies' middles alone, a walker clipped a thigh's end.
const LYING_MOST = 48

// Body `other`'s lying bodies, as steer's neighbours from `n` on, those a
// walker at `here` going `going` could reach within the horizon: the count
// of neighbours after them. `group` names them all one neighbour.
lying_near(other: *Character, here: Vec3, going: float, r_mine: float, near: float[], groups: int[], stills: int[], n: int, group: int) -> int {
    r = physanim.ragdoll_of(other.physanim as *Physanim)
    if r == null { return n }
    count = n
    q = 0
    while q < physics.ragdoll_bone_count(r) * 3 && q < LYING_MOST {
        a, b, radius = physics.ragdoll_bone_segment(r, q / 3)
        there = core.v3_mul(core.v3_add(a, b), 0.5)
        if q % 3 == 1 { there = a }
        if q % 3 == 2 { there = b }
        reach = r_mine + radius + AVOID_ROOM
        closing = going * AVOID_HORIZON + reach
        dx = there.x - here.x
        dz = there.z - here.z
        q = q + 1
        if dx * dx + dz * dz < closing * closing {
            at = count * AVOID_STRIDE
            groups[count] = group
            stills[count] = 1
            near[at] = reach
            near[at + 1] = dx
            near[at + 2] = dz
            j = 0
            while j < AVOID_SAMPLES {
                near[at + 3 + j * 2] = dx
                near[at + 4 + j * 2] = dz
                j = j + 1
            }
            count = count + 1
        }
    }
    return count
}

// Whether it steers round the other solid characters near it, and how much
// of a meeting it takes on (1: half, as each of two does; 0: none), as UE's
// CharacterMovementComponent's RVO avoidance (bUseRVOAvoidance, its weight).
// On by default for a character whose capsule is solid.
set_avoidance(c: *Character, on: bool, weight: float) {
    if c == null { return }
    c.avoid_off = !on
    c.avoid_weight = core.clampf(weight, 0.0, 4.0)
}

avoiding(c: *Character) -> bool { return c != null && !c.avoid_off }

// Whether a walk takes it over a ledge (`walk_off`), or it keeps to the
// ground it walks on (its default, #981): its capsule stops at an edge
// (physics.character_set_ledges) and its steering turns or stops it short
// of one (steer), as UE keeps an AI to its navmesh.
set_ledges(c: *Character, walk_off: bool) {
    if c == null || c.capsule == null { return }
    physics.character_set_ledges(c.capsule as *CharacterController, walk_off)
}

// A goal for it brought onto ground it can stand on, kept off any edge: the
// nearest such point within `reach` of `point` (physics.character_project,
// UE's ProjectPointToNavigation), and whether there was one. With no
// capsule, the point as it is.
project_goal(c: *Character, point: Vec3, reach: float) -> (bool, Vec3) {
    if c == null || c.capsule == null { return true, point }
    return physics.character_project(c.capsule as *CharacterController, point, reach)
}

people_add(c: *Character) {
    if g_people == null { g_people = list.new() }
    list.add_raw(g_people, c as ptr)
}

people_remove(c: *Character) {
    if g_people == null { return }
    i = 0
    while i < list.size(g_people) {
        if list.get_raw(g_people, i) == c as ptr {
            list.remove(g_people, i)
            return
        }
        i = i + 1
    }
}

// The velocity asked, steered round the other solid characters near it
// (#956): a velocity sampled near the one asked, up to 90 degrees off it and
// no faster, scored by how far it turns and by how soon it would meet each
// neighbour's capsule, the meeting read reciprocally (RVO: the relative
// velocity 2v - v_mine - v_theirs, as if each takes half the turn), the
// lowest kept. Two solid walkers asked straight at each other walked into
// each other and stopped 0.56 m apart.
// Each way is weighed by where the figure would really go asked it: its
// mover's springs and curve run ahead (mover.path), not the velocity taken
// at once. Read as taken at once, a way 30 degrees off cleared a meeting the
// curve, turning the way about 20 degrees a second, had not cleared when the
// two met: walkers' capsules touched in 156 to 211 steps of a 20 s plaza,
// and the shove carried a body across its locked foot (feet crossed 140 mm).
// Kept to the ground it walks on (#981; a capsule that does not walk off
// ledges, physics.character_set_ledges): when the way it is asked would take
// it over an edge within LEDGE_HORIZON, each way is weighed by how soon its
// path does too, as a meeting is, and standing still is one of the ways: it
// turns along the edge or stops short of it, as an AI on UE's navmesh keeps
// to it. Its capsule's keeping to the ground is the last word, stopping it
// at the edge as a wall does; the steering keeps it from coming to that.
steer(c: *Character, asked: Vec3) -> Vec3 {
    speed = core.sqrt_of(asked.x * asked.x + asked.z * asked.z)
    if speed < 0.05 || c.capsule == null || c.mover == null { return asked }
    mine = c.capsule as *CharacterController
    people = !c.avoid_off && c.avoid_weight > 0.0 && g_people != null && physics.character_solid(mine)
    ledges = !physics.character_walks_off(mine)
    if !people && !ledges { return asked }
    m = c.mover as *Mover
    o = c.object as *GameObject
    here = behaviour.object_position(o)
    feet = physics.character_feet(mine)
    v_mine = mover.velocity(m)
    r_mine = physics.character_radius(mine)
    going = core.sqrt_of(v_mine.x * v_mine.x + v_mine.z * v_mine.z)
    if going < speed { going = speed }
    way = calloc(AVOID_SAMPLES * 2, 8) as float[]
    // The ledge ahead of the way asked.
    edge = false
    if ledges {
        mover.path(m, asked, AVOID_DT, AVOID_SAMPLES, way)
        edge = ground_left(mine, feet, way) < LEDGE_HORIZON
    }
    // Its neighbours, read once: those it could meet within the horizon,
    // each's way ahead from here (mover.path_on: doing as it does) and the
    // distance their centres keep.
    n = 0
    count = 0
    if people { count = list.size(g_people) }
    most = count * (1 + LYING_MOST) + 1
    near = calloc(most * AVOID_STRIDE, 8) as float[]
    // Each neighbour's group: a person's own, or every point of one body
    // lying; and whether it stands still (a body lying: the whole turn is
    // this walker's, not half).
    groups = calloc(most, 4) as int[]
    stills = calloc(most, 4) as int[]
    ahead = calloc(AVOID_SAMPLES * 2, 8) as float[]
    i = 0
    while i < count {
        other = list.get_raw(g_people, i) as *Character
        if other != c && other.engine == c.engine && other.paused && other.physanim != null && physanim.released(other.physanim as *Physanim) {
            n = lying_near(other, here, going, r_mine, near, groups, stills, n, i)
        } else if other != c && other.engine == c.engine && other.capsule != null && !other.paused {
            cap = other.capsule as *CharacterController
            there = behaviour.object_position(other.object as *GameObject)
            v_other = physics.character_velocity(cap)
            dx = there.x - here.x
            dz = there.z - here.z
            reach = r_mine + physics.character_radius(cap) + AVOID_ROOM
            closing = (going + core.sqrt_of(v_other.x * v_other.x + v_other.z * v_other.z)) * AVOID_HORIZON + reach
            if physics.character_solid(cap) && dx * dx + dz * dz < closing * closing {
                at = n * AVOID_STRIDE
                groups[n] = i
                stills[n] = 0
                near[at] = reach
                near[at + 1] = dx
                near[at + 2] = dz
                if other.mover != null { mover.path_on(other.mover as *Mover, AVOID_DT, AVOID_SAMPLES, ahead) }
                j = 0
                while j < AVOID_SAMPLES {
                    t = (j + 1) as float * AVOID_DT
                    if other.mover == null {
                        ahead[j * 2] = v_other.x * t
                        ahead[j * 2 + 1] = v_other.z * t
                    }
                    near[at + 3 + j * 2] = dx + ahead[j * 2]
                    near[at + 4 + j * 2] = dz + ahead[j * 2 + 1]
                    j = j + 1
                }
                n = n + 1
            }
        }
        i = i + 1
    }
    free(ahead as ptr)
    if n == 0 && !edge {
        free(near as ptr)
        free(way as ptr)
        free(groups as ptr)
        free(stills as ptr)
        c.steered_known = false
        return asked
    }
    // Where it goes doing as it does, and where each way would take it.
    base = calloc(AVOID_SAMPLES * 2, 8) as float[]
    mover.path_on(m, AVOID_DT, AVOID_SAMPLES, base)
    best = asked
    best_cost = 1000000000.0
    stopping = false
    angles = [0.0, -0.2618, 0.2618, -0.5236, 0.5236, -0.7854, 0.7854, -1.0472, 1.0472, -1.309, 1.309, -1.5708, 1.5708]
    // At a ledge, standing still too (a share of none).
    shares = [1.0, 0.6, 0.0]
    a = 0
    while a < 13 {
        cs = core.cos_of(angles[a])
        sn = core.sin_of(angles[a])
        s = 0
        while s < 3 {
            if s == 2 && (!edge || a > 0) {
                s = s + 1
                continue
            }
            vx = (asked.x * cs + asked.z * sn) * shares[s]
            vz = (asked.z * cs - asked.x * sn) * shares[s]
            ox = vx - asked.x
            oz = vz - asked.z
            cost = AVOID_TURN * core.sqrt_of(ox * ox + oz * oz) / speed
            if angles[a] > 0.0 { cost = cost + AVOID_RIGHT }
            // Kept to the way it chose last step, as a person commits to a side:
            // chosen afresh every step, a heading flipping between two samples
            // skated a toe 5.3 mm through four crossing.
            if c.steered_known {
                kx = vx - c.steered.x
                kz = vz - c.steered.z
                cost = cost + AVOID_KEEP * core.sqrt_of(kx * kx + kz * kz) / speed
            }
            mover.path(m, core.vec3(vx, 0.0, vz), AVOID_DT, AVOID_SAMPLES, way)
            // Each neighbour once: a body lying by the soonest any of its
            // points is met.
            k = 0
            while k < n {
                t = meet_on(near, k, base, way, stills[k] == 1)
                g = groups[k]
                whole = stills[k] == 1
                k = k + 1
                while k < n && groups[k] == g {
                    u = meet_on(near, k, base, way, stills[k] == 1)
                    if u < t { t = u }
                    k = k + 1
                }
                if t < 0.05 { t = 0.05 }
                // A body lying turns no way: the meeting is all this walker's
                // to clear, twice a person's share (avoid_weight 1: half).
                share = c.avoid_weight
                if whole { share = 2.0 * share }
                if t < AVOID_HORIZON { cost = cost + share * AVOID_MEET * (1.0 / t - 1.0 / AVOID_HORIZON) }
            }
            // The ledge, met as a meeting is, its own to keep clear of (an
            // edge does not turn half the way), weighed so that meeting it
            // LEDGE_STOP ahead costs what standing still does.
            if edge {
                t = ground_left(mine, feet, way)
                if t < 0.05 { t = 0.05 }
                if t < LEDGE_HORIZON { cost = cost + (1.0 / t - 1.0 / LEDGE_HORIZON) / (1.0 / LEDGE_STOP - 1.0 / LEDGE_HORIZON) }
            }
            if cost < best_cost {
                best_cost = cost
                best = core.vec3(vx, 0.0, vz)
                stopping = s == 2
            }
            s = s + 1
        }
        a = a + 1
    }
    free(near as ptr)
    free(groups as ptr)
    free(stills as ptr)
    free(base as ptr)
    free(way as ptr)
    // Eased toward what it chose, a share AVOID_EASE a step: taken at once,
    // a fifteen degree turn as a meeting began skated a toe 5.3 mm. A stop
    // short of a ledge is not eased: let go at once, the mover brakes at its
    // stop's own pace and its stop plays by the distance left; eased, the
    // velocity asked shrank over 25 steps, the walk slowed through its own
    // clip and the stop entered mid stride at 0.7 m/s.
    if stopping {
        c.steered = core.vec3(0.0, 0.0, 0.0)
        c.steered_known = true
        return c.steered
    }
    if c.steered_known { best = core.v3_lerp(c.steered, best, AVOID_EASE) }
    c.steered = best
    c.steered_known = true
    return best
}

// Seconds ahead a ledge is looked for (#981): time for a runner to slow and
// curve away, short of the avoidance's 4 s, over which a runner's path
// reaches 10 m and a ledge would bend its way from across a plaza; and the
// metres apart its path is read at. A way meeting the ledge LEDGE_STOP
// seconds ahead costs what standing still does (a whole turn of the speed),
// sooner more, later less: LEDGE_STOP is the time a walk takes to brake to
// a stand at its stop's own pace and some, so a person heading for an edge
// stops while it still can (a walker at 1.2 m/s stands 1.2 m back from it).
// Costed as a meeting is, a walker chose to stop 1.2 s short of the edge,
// too late to brake at its stop's pace, and slowed through its walk
// instead, a toe thrown 2 m/s; at 1.6 s its stop did not fit, its capsule
// stopped it at the edge, and a toe was thrown 2.9 m/s.
const LEDGE_HORIZON = 3.0
const LEDGE_STOP = 2.0
const LEDGE_SPACING = 0.5

// Seconds until the path `way` (mover.path's offsets from `feet`, a sample
// each AVOID_DT) takes the capsule `cap` within its keep of an edge
// (physics.character_ledge_share), read a LEDGE_SPACING at a time out to
// LEDGE_HORIZON, each read from the ground's height the one before found
// (down a stair, its steps are not ledges); LEDGE_HORIZON twice where it
// does not, or where it stands on no ground to keep to.
ground_left(cap: *CharacterController, feet: Vec3, way: float[]) -> float {
    stands, y = physics.character_ground_at(cap, feet)
    if !stands { return LEDGE_HORIZON * 2.0 }
    samples = (LEDGE_HORIZON / AVOID_DT) as int
    if samples > AVOID_SAMPLES { samples = AVOID_SAMPLES }
    px = 0.0
    pz = 0.0
    t_was = 0.0
    j = 0
    while j < samples {
        dx = way[j * 2] - px
        dz = way[j * 2 + 1] - pz
        if dx * dx + dz * dz >= LEDGE_SPACING * LEDGE_SPACING || j == samples - 1 {
            t = (j + 1) as float * AVOID_DT
            share, ny = physics.character_ledge_share(cap, core.vec3(feet.x + px, y, feet.z + pz), core.vec3(dx, 0.0, dz), false)
            if share < 1.0 { return t_was + (t - t_was) * share }
            y = ny
            px = way[j * 2]
            pz = way[j * 2 + 1]
            t_was = t
        }
        j = j + 1
    }
    return LEDGE_HORIZON * 2.0
}

// Seconds until it meets neighbour `k` of `near` (steer's: the distance
// their centres keep, then the neighbour's way ahead from here) going the
// way whose path is `way`, where doing as it does is `base`; AVOID_HORIZON
// and more when it does not (moving apart, passing). Read reciprocally, as
// RVO's 2v - v_mine - v_theirs: its own turn off `base` counted twice, as if
// the other turns as much the other way, the other otherwise doing as it
// does. The time between two samples is read where the gap crosses the
// reach, so the cost changes smoothly from one way to the next. A neighbour
// standing `still` (a body lying) turns no way: the whole turn is this
// walker's, its own way read as it is.
meet_on(near: float[], k: int, base: float[], way: float[], still: bool) -> float {
    at = k * AVOID_STRIDE
    reach = near[at]
    was = core.sqrt_of(near[at + 1] * near[at + 1] + near[at + 2] * near[at + 2])
    within = was < reach
    j = 0
    while j < AVOID_SAMPLES {
        t = (j + 1) as float * AVOID_DT
        mx = 2.0 * way[j * 2] - base[j * 2]
        mz = 2.0 * way[j * 2 + 1] - base[j * 2 + 1]
        if still {
            mx = way[j * 2]
            mz = way[j * 2 + 1]
        }
        gx = near[at + 3 + j * 2] - mx
        gz = near[at + 4 + j * 2] - mz
        gap = core.sqrt_of(gx * gx + gz * gz)
        if within {
            // Already within: a meeting now, unless going apart.
            if j == 0 && gap < was { return 0.0 }
            if gap >= reach { within = false }
        } else {
            if gap < reach { return t - AVOID_DT + AVOID_DT * (was - reach) / (was - gap) }
        }
        was = gap
        j = j + 1
    }
    return AVOID_HORIZON * 2.0
}
