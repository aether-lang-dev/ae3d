// A character (#903): a moving, aiming, looking person in a few lines, the
// way Unity's Animator and CharacterController read together.
//
//     hero = character.humanoid(e, "Hero", "people/mannequin.glb", character.gaits("people/100style/neutral"))
//     character.move(hero, velocity, facing)      // every frame, from the game
//     character.look(hero, point)
//     character.aim(hero, target)
//
// Under it, set up as a person needs, the pipeline's own parts, each still
// the game's to reach (character.animator, mover, feet):
//   - the figure (ae3d.figure) and its animator;
//   - locomotion from motion capture read by a name's prefix: `prefix`_fw,
//     _bw, _sw, _fr, _br and _sr (walks and runs ahead, back and to the
//     side; each side's mirror for the other) as one 2D blend by velocity,
//     each a loop on its axis; a start (`prefix`_start) played by the
//     distance gone, a stop (`prefix`_stop) and its mirror played by the
//     distance left, the one entering with its feet where the figure's are;
//     the stand at the stop's end. Retargeted onto the figure, feet kept.
//     Or, given a database of whole captures (match_add), motion matching
//     over it in their place; or a graph of states read from a file
//     (graphed, ae3d.animgraph), its blends driven by the mover's
//     parameters;
//   - a capsule to move by where there is physics (a CharacterController);
//   - a mover (ae3d.mover): the velocity and facing a game asks for followed
//     on springs, the figure moved by them, the graph's parameters written;
//   - feet locked on the ground and stepping as it turns on the spot
//     (ikrig), on the physics' static world when there is one;
//   - eyes ahead where it goes, or on what it is told to look at;
//   - an aim offset over the spine from a file's pistol aims (aims), on a
//     ready pose (the level aim over the upper body) while it aims.
// The showcase's figure on a stick was 96 lines and 56 calls across seven
// modules; through this it is the three above.

import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.ikrig
import ae3d.mover
import ae3d.bvh
import ae3d.usable
import ae3d.animgraph
import ae3d.physanim
import ae3d.motion
import ae3d.items

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

exports (
    Character, Gaits, gaits, gaits_set, gaits_free, GAIT_FW, GAIT_BW, GAIT_SW, GAIT_FR, GAIT_BR, GAIT_SR, GAIT_START, GAIT_STOP, GAIT_STAND,
    humanoid, graphed, graph_of, character_free, capsule_off, match_add, matching, use_takes, use, leave, using, pause, resume, paused, seated, use_phase, use_contact, use_enter_state,
    USE_NONE, USE_GO, USE_TURN, USE_ENTER, USE_LOOP, USE_EXIT, move, look, look_ahead, look_free, aim, aim_off, aims,
    act, act_stop, acting, ACT_OUT, swing, get_up_add, get_up, get_up_count, get_up_state, set_avoidance, avoiding, hit, physical, physanim_of, animator_of, mover_of, feet_of, object_of, idle_state, move_state, standing, error
)

// Seconds a character's look and aim ease on and off.
const EASE = 0.4
// How far ahead it looks, metres, and how high over its feet.
const LOOK_AHEAD = 6.0
const EYE_HIGH = 1.6
// How much the stick's way through its stop the mover takes to brake by.
const FACING_HALF_LIFE = 0.6
// Seconds either side of where a stop or a start would enter it searches for
// the entry whose feet match (animator.transition_match).
const STOP_WINDOW = 0.5
const START_WINDOW = 0.3
// Seconds after it stands a stop's cut ends, and the stand begins.
const STOP_AFTER = 0.3
// Of the speed its stop brakes from (clips.braking_speed), the fastest it is
// played from, and the mover brakes from: faster, the figure slows on its
// springs to that first, through its gaits (a run to a walk).
const STOP_SERVES = 1.25
// The most a figure setting off outpaces its start's take, times the take's
// own pace (mover.set_start_pace), as UE5's distance matching clamps a
// start's play rate. At 1.0 a figure stood up from an act and asked to walk
// off to its side went 0.86 m in 2 s (it walked off as slowly as the
// StartStop take's 0.72 m in its 1.3 s); at 1.25, 1.11 m, its fastest
// joint setting off 95% of the takes' own plus the easing's.
const START_PACE = 1.25
// The share of its fastest a start's walk-off is up to pace at: it ends at
// its first footfall from there (start_end).
const START_NEAR_PEAK = 0.9
// Seconds of a capture's calmest stretch a stand is cut from.
const STAND_SECONDS = 2.5
// Metres a second under which a frame of a database is taken to stand.
const STOOD = 0.1
// Metres a character's capsule is round, and how far it reaches over the
// top of its head joint.
const CAPSULE_RADIUS = 0.3
const HEAD_TOP = 0.12

struct Character {
    object: ptr                    // *GameObject
    animator: ptr                  // *Animator
    mover: ptr                     // *Mover
    feet: ptr                      // *Feet
    idle: int                      // its states
    walk: int
    start: int
    stop: int
    stop_m: int
    idle_m: int                    // the stand, mirrored
    start_m: int
    aim: int                       // its aim offset, -1 none
    ready: int                     // the level aim over its upper body, -1 none
    asked: Vec3                    // the velocity asked, the world's
    facing: Vec3                   // the way asked to face, or none (zero): the way it goes
    looking: bool                  // told where to look
    eyes_free: bool                // no look at all: the take's own head (look_free)
    look_at: Vec3
    aiming: bool
    target: Vec3
    engine: ptr                    // *Engine
    use_source: ptr                // a string.keep reference: the file a slot's takes are read from (use_takes), or null
    use_names: ptr                 // ptr[USE_TAKES]: the takes made into states, by name
    use_states: ptr                // int[USE_TAKES]: and their states
    use_count: int
    use_u: ptr                     // *Usables of the slot in use
    use_slot: int
    use_phase: int                 // USE_NONE to USE_EXIT
    use_t: float                   // seconds in the phase
    use_enter: int                 // the slot's states
    use_loop: int
    use_exit: int
    use_contact: float             // the enter take's time its part lands at
    leaving: bool
    paused: bool                   // held by something else (pause): the mover, look and aim left alone
    act_state: int                 // the state act plays once, -1 none
    acting: bool
    matcher: int                   // its database's matcher state (match_add), -1 none
    match_built: bool
    capsule: ptr                   // *CharacterController it made itself, or null
    gaits: ptr                     // *Gaits whose shared takes its states play, or null
    avoid_off: bool                // it does not steer round others (set_avoidance)
    avoid_weight: float            // how much of a meeting it takes on (1: half, as each of two does)
    steered: Vec3                  // the velocity it steered to last step
    steered_known: bool
    physanim: ptr                  // *Physanim put on at its first blow (hit), or null
    get_ups: ptr                   // int[GET_UPS]: the get-up states it chooses among (get_up_add)
    get_up_count: int
    graph: ptr                     // *Graph read from a file (graphed), or null
    stepper: ptr                   // *Behaviour: its step in the engine's loop
}

var g_error: string = ""

// What the last humanoid that failed said.
error() -> string { return g_error }

// --- gaits ------------------------------------------------------------------------------------------

// The captures a humanoid moves by, one file each role: walks and runs ahead,
// back and to the side, a start, a stop, and a stand. gaits(prefix) names
// them `prefix`_fw.bvh, _bw, _sw, _fr, _br, _sr, _start and _stop (the stand
// from the stop's end); gaits_set changes one. A style's own stop may be a
// poor one (100STYLE's neutral style has none that is straight: its stop,
// cut from its idles, slides its planted foot 17 cm), so a stop from another
// style can be given.
struct Gaits {
    paths: ptr                     // ptr[GAIT_ROLES]: string.keep references
    figures: ptr                   // ptr[room]: the figure files its takes were made for (string.keep)
    made: ptr                      // ptr[room]: each one's GAIT_TAKES takes (a ptr[]), the gaits' own
    figure_count: int
    room: int
    users: int                     // characters made on its takes and not yet freed
    released: bool                 // let go of by the game (gaits_free): freed with its last user
}

// The takes a character's gaits come to (make_gait_takes), in order: the
// stand; the forward, back and side walk, the side walk's mirror, the
// forward, back and side run and its mirror; the start and its mirror, the
// stop and its mirror; the stand's mirror. Made once for each figure file
// a character of the gaits wears, and shared by every character of it
// (animator.share_take): a camp of 20 settlers read and retargeted every
// capture 20 times (#944).
const GAIT_TAKES = 14

const GAIT_FW = 0
const GAIT_BW = 1
const GAIT_SW = 2
const GAIT_FR = 3
const GAIT_BR = 4
const GAIT_SR = 5
const GAIT_START = 6
const GAIT_STOP = 7
const GAIT_STAND = 8
const GAIT_ROLES = 9

gaits(prefix: string) -> *Gaits {
    g = heap.new(Gaits)
    g.paths = calloc(GAIT_ROLES, 8)
    suffixes = ["_fw", "_bw", "_sw", "_fr", "_br", "_sr", "_start", "_stop", "_stop"]
    k = 0
    while k < GAIT_ROLES {
        path = "${prefix}${suffixes[k]}.bvh"
        (g.paths as ptr[])[k] = string.keep(path)
        k = k + 1
    }
    return g
}

// Role `role`'s capture read from `path` instead. Set before the gaits'
// first character: the takes made from the old capture are let go.
gaits_set(g: *Gaits, role: int, path: string) {
    if g == null || role < 0 || role >= GAIT_ROLES { return }
    string.release_kept((g.paths as ptr[])[role])
    (g.paths as ptr[])[role] = string.keep(path)
    gaits_unmade(g)
}

// The gaits let go of, and the takes made from them: after every character
// on them (their takes are the gaits', shared by those characters).
// Let go of by the game. The takes its characters share stay while any of
// them is still made (gaits_states holds a use, character_free lets it
// go): freed at once, as a game may well free them once its characters
// are made, every character on them sampled freed takes (the showcase's
// stick figure and swordsman crashed on their first frame since #944).
gaits_free(g: *Gaits) {
    if g == null { return }
    g.released = true
    if g.users > 0 { return }
    gaits_free_now(g)
}

// A character's use of its gaits' takes let go of; the gaits freed with the
// last, once the game has let them go.
gaits_drop(g: *Gaits) {
    if g == null { return }
    g.users = g.users - 1
    if g.users <= 0 && g.released { gaits_free_now(g) }
}

gaits_free_now(g: *Gaits) {
    k = 0
    while k < GAIT_ROLES {
        string.release_kept((g.paths as ptr[])[k])
        k = k + 1
    }
    free(g.paths)
    gaits_unmade(g)
    if g.figures != null { free(g.figures) }
    if g.made != null { free(g.made) }
    heap.free(g)
}

// The takes made for each figure let go of.
gaits_unmade(g: *Gaits) {
    k = 0
    while k < g.figure_count {
        string.release_kept((g.figures as ptr[])[k])
        free_takes((g.made as ptr[])[k], GAIT_TAKES)
        k = k + 1
    }
    g.figure_count = 0
}

// The first `count` takes of a ptr[] of them freed, and the array.
free_takes(takes: ptr, count: int) {
    k = 0
    while k < count {
        t = (takes as ptr[])[k]
        if t != null { clips.take_free(t as *Take) }
        k = k + 1
    }
    free(takes)
}

// The gaits' takes for the figure file `figure`, on rig `r`: made the first
// time a character of it asks, kept for the rest. Null when a capture cannot
// be read (error() says which).
gait_takes(g: *Gaits, figure: string, r: *pose.Rig) -> ptr {
    k = 0
    while k < g.figure_count {
        known, _why = string.from_ptr((g.figures as ptr[])[k])
        if string.equals(known, figure) == 1 { return (g.made as ptr[])[k] }
        k = k + 1
    }
    takes = make_gait_takes(g, r)
    if takes == null { return null }
    if g.figure_count >= g.room {
        room = g.room * 2
        if room < 4 { room = 4 }
        figures = calloc(room, 8) as ptr[]
        made = calloc(room, 8) as ptr[]
        k = 0
        while k < g.figure_count {
            figures[k] = (g.figures as ptr[])[k]
            made[k] = (g.made as ptr[])[k]
            k = k + 1
        }
        if g.figures != null { free(g.figures) }
        if g.made != null { free(g.made) }
        g.figures = figures as ptr
        g.made = made as ptr
        g.room = room
    }
    (g.figures as ptr[])[g.figure_count] = string.keep(figure)
    (g.made as ptr[])[g.figure_count] = takes
    g.figure_count = g.figure_count + 1
    return takes
}

// The GAIT_TAKES takes, in their order, made on rig `r` from the gaits'
// captures: each read and retargeted, cut and looped as the graph plays it,
// the side gaits, the start, the stop and the stand mirrored. Null when a
// capture cannot be read.
make_gait_takes(g: *Gaits, r: *pose.Rig) -> ptr {
    takes = calloc(GAIT_TAKES, 8) as ptr[]
    // The stand: the capture's calmest STAND_SECONDS (clips.calmest), a
    // loop. Cut where its root first stood still, 100STYLE's neutral stand
    // began as its actor lifted its arms out to 78 degrees, and the figure
    // stood with them held out like a gorilla.
    stood = gait_capture(r, gait_path(g, GAIT_STAND))
    if stood == null {
        free_takes(takes as ptr, 0)
        return null
    }
    calm = clips.calmest(stood, r, STAND_SECONDS)
    from = (calm * clips.rate(stood)) as int
    to = ((calm + STAND_SECONDS) * clips.rate(stood)) as int
    if to > clips.frames(stood) - 1 { to = clips.frames(stood) - 1 }
    standing = clips.crop(stood, r, from, to, false)
    idle_t = clips.loop_cut(standing, r)
    clips.take_free(standing)
    clips.take_free(stood)
    takes[0] = idle_t as ptr
    // The gaits, each a loop on its axis; the side ones mirrored too.
    roles = [GAIT_FW, GAIT_BW, GAIT_SW, GAIT_FR, GAIT_BR, GAIT_SR]
    sides = [false, false, true, false, false, true]
    at = 1
    k = 0
    while k < 6 {
        t = gait_capture(r, gait_path(g, roles[k]))
        if t == null {
            free_takes(takes as ptr, GAIT_TAKES)
            return null
        }
        clips.straighten(t, r, true)
        looped = clips.loop_cut(t, r)
        clips.take_free(t)
        clips.straighten(looped, r, true)
        takes[at] = looped as ptr
        at = at + 1
        mirrored = null as ptr
        if sides[k] {
            mirrored = clips.mirror(looped, r) as ptr
            takes[at] = mirrored
            at = at + 1
        }
        // Each loop's root at an even speed, its sway in its pose, as the
        // mover moves it (#970); the mirror its own, its sway its side's.
        clips.even_root(looped)
        if mirrored != null { clips.even_root(mirrored as *Take) }
        k = k + 1
    }
    // The start by the way come and the stop by the way left, cut about
    // where each moves off and comes to rest, and their mirrors.
    starting = gait_capture(r, gait_path(g, GAIT_START))
    if starting == null {
        free_takes(takes as ptr, GAIT_TAKES)
        return null
    }
    clips.straighten(starting, r, true)
    start_t = crop_start(r, starting, 0.3, 1.6)
    clips.take_free(starting)
    takes[9] = start_t as ptr
    takes[10] = clips.mirror(start_t, r) as ptr
    stopping = gait_capture(r, gait_path(g, GAIT_STOP))
    if stopping == null {
        free_takes(takes as ptr, GAIT_TAKES)
        return null
    }
    clips.straighten(stopping, r, true)
    stop_t = crop_about(r, stopping, 0.0 - 1.6, STOP_AFTER, false)
    clips.take_free(stopping)
    takes[11] = stop_t as ptr
    takes[12] = clips.mirror(stop_t, r) as ptr
    takes[13] = clips.mirror(idle_t, r) as ptr
    return takes as ptr
}

// The capture at `path` read and retargeted onto rig `r`, its root motion
// taken out (as animator.add_take takes it out): the caller's.
gait_capture(r: *pose.Rig, path: string) -> *Take {
    c = bvh.load(path, 0.0)
    if c == null {
        g_error = "cannot read ${path}: ${bvh.error()}"
        return null
    }
    made = bvh.take(c, path, 0, 0 - 1)
    t = retarget.retarget(bvh.rig(c), made, r)
    if t != null && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

gait_path(g: *Gaits, role: int) -> string {
    text, _why = string.from_ptr((g.paths as ptr[])[role])
    return text
}

// A person: the figure in the glTF file at `path` named `name`, on its
// gaits read from the captures `prefix`_fw.bvh and the rest (see the top),
// or, `g` null, on a database given by match_add before its first step.
// At `scale` of its file's size (its object scaled so before anything is
// made from it): its capsule, its gaits' strides and its feet all at that
// size. Made at its file's size and scaled after, a figure kept a capsule and
// gaits for the size it was made at (Siltreach's people, scaled to 1.75 m,
// #943). Null when the file or a capture cannot be read (error() says
// which).
humanoid(e: *Engine, name: string, path: string, g: *Gaits, scale: float = 1.0) -> *Character {
    g_error = ""
    o = figure.figure(e, name, path)
    if o == null {
        g_error = "cannot read ${path}"
        return null
    }
    if scale != 1.0 { behaviour.object_set_scale(o, core.vec3(scale, scale, scale)) }
    a = animator.attach(e, o)
    r = animator.rig(a)
    c = heap.new(Character)
    c.object = o as ptr
    c.animator = a as ptr
    c.aim = 0 - 1
    c.engine = e as ptr
    c.use_names = calloc(USE_TAKES, 8)
    c.use_states = calloc(USE_TAKES, 4)
    c.get_ups = calloc(GET_UPS, 4)
    c.ready = 0 - 1
    c.matcher = 0 - 1
    c.idle = 0 - 1
    c.idle_m = 0 - 1
    c.walk = 0 - 1
    c.start = 0 - 1
    c.start_m = 0 - 1
    c.stop = 0 - 1
    c.act_state = 0 - 1
    c.stop_m = 0 - 1
    // Its gaits' takes are its file's at its scale: the same file at another
    // size is another set.
    if g != null && !gaits_states(c, g, "${path} x${scale}") { return failed(c) }
    feet = ikrig.feet_new(r, o)
    if physics.of(e) != null { ikrig.feet_ground_physics(feet, physics.of(e)) }
    ikrig.feet_set_steps(feet, true)
    animator.set_feet(a, feet)
    c.feet = feet as ptr
    // A capsule to move by where there is physics, as Unity's Animator goes
    // with a CharacterController: a wall stops it, a stair lifts it (the
    // mover's springs and the takes' root motion both move it by its
    // capsule), as tall as the figure.
    if physics.of(e) != null && physics.character_of(o) == null {
        c.capsule = physics.character_controller(o, CAPSULE_RADIUS * scale, standing_height(r, o)) as ptr
    }
    m = mover.mover_new(a, o)
    if c.stop >= 0 {
        mover.set_braking(m, clips.braking(animator.state_take(a, c.stop)))
        mover.set_braking_below(m, STOP_SERVES * clips.braking_speed(animator.state_take(a, c.stop)))
    }
    // Set off at its start's own pace, as it stops at its stop's.
    if c.start >= 0 { mover.set_start_pace(m, START_PACE) }
    mover.set_half_lives(m, mover.HALF_LIFE, FACING_HALF_LIFE)
    c.mover = m as ptr
    if c.idle >= 0 { animator.play(a, c.idle, 0.0) }
    b = engine.behaviour_new("character", c as ptr)
    b.fixed_update = character_fixed
    engine.engine_add_behaviour(e, b)
    c.stepper = b as ptr
    c.avoid_weight = 1.0
    people_add(c)
    return c
}

// The gaits' states and the graph between them: the stand, the 2D blend,
// the starts and the stops, on the takes the gaits keep for the figure file
// `figure` (gait_takes), shared. False when a capture cannot be read.
gaits_states(c: *Character, g: *Gaits, figure: string) -> bool {
    a = c.animator as *Animator
    r = animator.rig(a)
    made = gait_takes(g, figure, r)
    if made == null { return false }
    // A use of its takes, let go of as the character is freed.
    g.users = g.users + 1
    c.gaits = g as ptr
    shared = calloc(GAIT_TAKES, 8) as ptr[]
    k = 0
    while k < GAIT_TAKES {
        s = animator.share_take(a, (made as ptr[])[k] as *Take, false)
        if s == null {
            g_error = "the gaits' takes were made for another rig than ${figure}'s"
            free(shared as ptr)
            return false
        }
        shared[k] = s as ptr
        k = k + 1
    }
    idle_t = shared[0] as *Take
    c.idle = animator.add_state(a, "idle", idle_t, true)
    // The gaits, each a loop on its axis, set in the space at its velocity.
    c.walk = animator.add_blend2(a, "move")
    k = 1
    while k <= 8 {
        t = shared[k] as *Take
        went = clips.travel(t, clips.duration(t))
        animator.blend_add2(a, c.walk, t, went.x / clips.duration(t), went.y / clips.duration(t))
        k = k + 1
    }
    animator.bind2(a, c.walk, "vx", "vz")
    // The start by the way come, the stop by the way left; each with its
    // mirror and the stand with its own, so whichever foot the figure has
    // down there is one whose feet match. A transition into any of them
    // enters where the feet match best (transition_match): a stop within
    // half a stride of where the distance left puts it, a stand anywhere
    // in its loop.
    // A start's distance come counted from its move-off, not its first
    // frame: the cut's stand before it is never raced through.
    c.start = animator.add_state(a, "start", shared[9] as *Take, false)
    animator.clock_by(a, c.start, "travelled", false)
    animator.clock_from(a, c.start, clips.moving_at(shared[9] as *Take, 0.1))
    c.start_m = animator.add_state(a, "start", shared[10] as *Take, false)
    animator.clock_by(a, c.start_m, "travelled", false)
    animator.clock_from(a, c.start_m, clips.moving_at(shared[10] as *Take, 0.1))
    stop_t = shared[11] as *Take
    c.stop = animator.add_state(a, "stop", stop_t, false)
    animator.clock_by(a, c.stop, "rest", true)
    c.stop_m = animator.add_state(a, "stop", shared[12] as *Take, false)
    animator.clock_by(a, c.stop_m, "rest", true)
    c.idle_m = animator.add_state(a, "idle", shared[13] as *Take, true)
    free(shared as ptr)
    stands = [c.idle, c.idle_m]
    starts = [c.start, c.start_m]
    stops = [c.stop, c.stop_m]
    k = 0
    while k < 2 {
        go = animator.add_transition(a, stands[k], c.start, 0.2)
        animator.transition_when(a, go, "go", animator.IS, 0.0)
        animator.transition_or(a, go, c.start_m)
        animator.transition_match(a, go, START_WINDOW)
        on = animator.add_transition(a, starts[k], c.walk, 0.3)
        animator.transition_when(a, on, "", animator.ENDED, 0.0)
        animator.transition_synced(a, on, true)
        rested = animator.add_transition(a, stops[k], c.idle, 0.3)
        animator.transition_when(a, rested, "", animator.ENDED, 0.0)
        animator.transition_or(a, rested, c.idle_m)
        animator.transition_match(a, rested, STOP_WINDOW)
        // A stop asked for while it starts.
        early = animator.add_transition(a, starts[k], c.idle, 0.3)
        animator.transition_when(a, early, "go", animator.IS_NOT, 0.0)
        animator.transition_when(a, early, "speed", animator.BELOW, 0.1)
        animator.transition_or(a, early, c.idle_m)
        animator.transition_match(a, early, STOP_WINDOW)
        k = k + 1
    }
    halt = animator.add_transition(a, c.walk, c.stop, 0.25)
    animator.transition_when(a, halt, "go", animator.IS_NOT, 0.0)
    animator.transition_when(a, halt, "rest", animator.BELOW, clips.travel_length(stop_t))
    // Stopped from the speeds its stop serves: from a run, slowed to them first.
    animator.transition_when(a, halt, "speed", animator.BELOW, STOP_SERVES * clips.braking_speed(stop_t) + 0.01)
    animator.transition_or(a, halt, c.stop_m)
    animator.transition_match(a, halt, STOP_WINDOW)
    return true
}

// A person on a graph of states read from a file (ae3d.animgraph): the
// figure in the glTF file at `path` named `name`, its takes, states, blends
// and transitions as the file at `graph` declares them (its own clips, or
// another file's retargeted), driven by the parameters its mover writes
// ("speed", "vx" and "vz", "go", "moving", "turning", "travelled",
// "rest"): a runner's walk, jog and sprint blended by speed. Its stand is
// the graph's state "idle", its moving one "move"; its feet, eyes, aim,
// capsule and use are humanoid's, and so is its `scale`. Null when either
// file cannot be read (error() says which, and where in the graph).
graphed(e: *Engine, name: string, path: string, graph: string, scale: float = 1.0) -> *Character {
    c = humanoid(e, name, path, null as *Gaits, scale)
    if c == null { return null }
    a = c.animator as *Animator
    gr = animgraph.load(a, graph)
    if gr == null {
        g_error = "${graph}: ${animgraph.error()}"
        character_free(c)
        return null
    }
    c.graph = gr as ptr
    c.idle = animgraph.state_of(gr, "idle")
    c.walk = animgraph.state_of(gr, "move")
    if c.idle >= 0 && animator.current(a) != c.idle { animator.play(a, c.idle, 0.0) }
    return c
}

// Its capsule taken off: the figure stands and goes where its mover and its
// takes put it, through anything. One stood with a foot up on a block its
// capsule would put it on top of, or one a game moves itself.
capsule_off(c: *Character) {
    if c.capsule == null { return }
    physics.character_free(c.capsule as *CharacterController)
    c.capsule = null
}

// A blow (#903): `impulse` (newton seconds) at `point` on the body named
// `bone` (physanim's: "Hips", "Spine", "Chest", "Neck", "ShoulderL",
// "ElbowL", "ThighL", "KneeL" and the right's; "" the body nearest
// `point`, as a ray's hit gives it). The figure's ragdoll (ae3d.physanim,
// put on it at its first blow where the engine has physics, or before by
// physical) takes the blow and is drawn from where it goes, then eased
// back onto the animation, the figure walking on as it was; and where its
// graph has a flinch for the
// part struck, a layer "hit_head" (the neck), "hit_legs" (a thigh or a
// knee) or "hit_chest" (the rest), that is played from its start over
// the figure, the others eased out. A hit reaction in Unreal is the same
// two: a physical blend on the struck bodies and an additive hit take.
// False when nothing could take it: no physics and no flinch.
hit(c: *Character, bone: string, point: Vec3, impulse: Vec3) -> bool {
    if c == null { return false }
    _bodied = physical(c)
    struck = ""
    if c.physanim != null {
        pa = c.physanim as *Physanim
        k = physanim.nearest(pa, point)
        if bone != "" { k = physanim.bone_named(pa, bone) }
        if k >= 0 {
            physanim.hit(pa, k, point, impulse)
            struck = physics.humanoid_bone(k)
        }
    } else {
        struck = bone
    }
    return flinch(c, struck) || struck != ""
}

// The figure's physical animation, null before its first blow (hit) or
// where the engine has no physics.
physanim_of(c: *Character) -> *Physanim { return c.physanim as *Physanim }

// The figure's ragdoll put on it now (ae3d.physanim), where the engine has
// physics, rather than at its first blow: its bodies follow its animation
// (each at weight 0, drawn as the animation has it), so what sweeps for
// bodies meets them before anything has struck it. Put on at the first blow
// alone, an unhurt person had no bodies, and ae3d.items' edge, which meets
// only moving bodies, passed through it (#940). True when it has them.
physical(c: *Character) -> bool {
    if c == null { return false }
    e = c.engine as *Engine
    if c.physanim == null && physics.of(e) != null {
        c.physanim = physanim.attach(e, c.animator as *Animator) as ptr
        // A person's weight for its standing height, whatever it is doing
        // as it is made physical (seated, it measured shorter).
        o = c.object as *GameObject
        if c.physanim != null { physanim.set_mass(c.physanim as *Physanim, physics.person_mass(standing_height(animator.rig(c.animator as *Animator), o))) }
    }
    return c.physanim != null
}

const FLINCH_OUT = 0.2

// The graph's flinch for body `struck` played from its start, the other
// flinches eased out. False when the graph has none for it.
flinch(c: *Character, struck: string) -> bool {
    gr = c.graph as *Graph
    if gr == null { return false }
    a = c.animator as *Animator
    wanted = "hit_chest"
    if string.equals(struck, "Neck") == 1 { wanted = "hit_head" }
    if string.starts_with(struck, "Thigh") == 1 || string.starts_with(struck, "Knee") == 1 { wanted = "hit_legs" }
    names = ["hit_chest", "hit_head", "hit_legs"]
    played = false
    i = 0
    while i < 3 {
        layer = animgraph.layer_of(gr, names[i])
        if layer >= 0 {
            if string.equals(names[i], wanted) == 1 {
                animator.layer_restart(a, layer)
                animator.layer_weight(a, layer, 1.0, 0.0)
                played = true
            } else {
                animator.layer_weight(a, layer, 0.0, FLINCH_OUT)
            }
        }
        i = i + 1
    }
    return played
}

// The graph a graphed character was read from, its parts by name; null for
// one on gaits or a database.
graph_of(c: *Character) -> *Graph { return c.graph as *Graph }

failed(c: *Character) -> *Character {
    if g_error == "" { g_error = "a capture could not be read" }
    character_free(c)
    return null
}

// The capture at `path` retargeted onto `a`'s figure, its feet kept and its
// root motion taken out; the animator's. Null (and error() says which)
// when it cannot be read.
captured(a: *Animator, path: string) -> *Take {
    c = bvh.load(path, 0.0)
    if c == null {
        g_error = "cannot read ${path}: ${bvh.error()}"
        return null
    }
    made = bvh.take(c, path, 0, 0 - 1)
    t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, animator.rig(a)), true)
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

// Take `t` cut from `from` to `to` seconds about its root's first move (or,
// not `around_move`, its first stand after its fastest): a new take, the
// caller's.
crop_about(r: *pose.Rig, t: *Take, from: float, to: float, around_move: bool) -> *Take {
    mark = clips.moving_at(t, 0.1)
    if !around_move { mark = clips.still_at(t, 0.1) }
    a0 = ((mark + from) * clips.rate(t)) as int
    b0 = ((mark + to) * clips.rate(t)) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    return clips.crop(t, r, a0, b0, false)
}

// Start take `t` cut from `before` seconds before its root's first move to
// where its walk-off is up to pace (start_end), at most `after` seconds
// after the move: a new take, the caller's.
crop_start(r: *pose.Rig, t: *Take, before: float, after: float) -> *Take {
    mark = clips.moving_at(t, 0.1)
    a0 = ((mark - before) * clips.rate(t)) as int
    b0 = (start_end(t, mark, after) * clips.rate(t) + 0.5) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    return clips.crop(t, r, a0, b0, false)
}

// Where start take `t`, moving off at `mark` seconds, ends: at its first
// footfall once its root is within START_NEAR_PEAK of the fastest it goes
// in the `after` seconds from its move (its walk-off up to pace), else
// `after` seconds on. A take of starts and stops in a row slows into its
// next stop after its peak: 100STYLE's StartStop start peaks at 0.47 m/s
// 0.65 s after its move-off and is down to 0.14 m/s 1.6 s after it, and
// kept to its pace (mover.set_start_pace) the figure slowed with it, handed
// over to its walk at 0.23 m/s, and a planted toe skated 20 mm in the
// walk's blend (#937). Ended at its left footfall 0.52 s after its
// move-off, at 0.44 m/s, it hands over with that step in the air, the walk
// landing it, and no toe skates 1 mm. Handed over at the footfall itself
// instead (the take ended 0.3 s after it), the landing played in the start
// skated 5.2 to 6.0 mm.
start_end(t: *Take, mark: float, after: float) -> float {
    last = mark + after
    if last > clips.duration(t) { last = clips.duration(t) }
    peak = 0.0
    at = mark
    while at <= last {
        v = clips.speed_at(t, at)
        if v > peak { peak = v }
        at = at + 1.0 / clips.rate(t)
    }
    up = mark
    while up < last && clips.speed_at(t, up) < START_NEAR_PEAK * peak { up = up + 1.0 / clips.rate(t) }
    k = 0
    while k < clips.event_count(t) {
        e = clips.event_time(t, k)
        foot = string.equals(clips.event_name(t, k), clips.FOOT_LEFT) == 1 || string.equals(clips.event_name(t, k), clips.FOOT_RIGHT) == 1
        if foot && e >= up && e <= last { return e }
        k = k + 1
    }
    return last
}

// How tall the figure stands: its head joint's height in its rest pose over
// its feet, and HEAD_TOP at the figure's scale.
standing_height(r: *pose.Rig, o: *GameObject) -> float {
    w = pose.new(r)
    pose.rest_world(r, w)
    high = clips.ground_point(r, pose.translation(w, pose.human(r, pose.HEAD))).y - behaviour.object_position(o).y
    pose.release(w)
    return high + HEAD_TOP * behaviour.object_scale(o).y
}

character_free(c: *Character) {
    if c == null { return }
    people_remove(c)
    // Out of the engine's loop first, as an animator is: freed while the
    // engine runs, its step would read freed memory.
    if c.stepper != null {
        engine.engine_remove_behaviour(c.engine as *Engine, c.stepper as *Behaviour)
        heap.free(c.stepper as *Behaviour)
    }
    // Its physical animation before the animator it steps after.
    if c.physanim != null { physanim.physanim_free(c.physanim as *Physanim) }
    if c.capsule != null { physics.character_free(c.capsule as *CharacterController) }
    k = 0
    while k < c.use_count {
        string.release_kept((c.use_names as ptr[])[k])
        k = k + 1
    }
    free(c.use_names)
    free(c.use_states)
    free(c.get_ups)
    if c.use_source != null { string.release_kept(c.use_source) }
    if c.mover != null { mover.mover_free(c.mover as *Mover) }
    if c.graph != null { animgraph.graph_free(c.graph as *Graph) }
    // The animator it attached, with the feet, hands and look it set on it.
    if c.animator != null { animator.animator_free(c.animator as *Animator) }
    // Its use of its gaits' takes let go of, after the animator playing them.
    if c.gaits != null { gaits_drop(c.gaits as *Gaits) }
    heap.free(c)
}

// --- moving by a database (#906) --------------------------------------------------------------------

// The capture at `path` (BVH, gzip'd or not) read whole into the character's
// database, and its mirror when `mirrored`: motion matching, as UE5's Pose
// Search database under its Motion Matching node. Once it has one, the
// character moves by the frame of it whose pose and way ahead best match
// the mover's (animator.add_matcher), the figure carried by the takes' own
// root motion (mover.set_follow), in place of its gaits' blend, starts and
// stops; its look, aim and use are the same. Built at its first step after
// the last is added. False when the file cannot be read (error() says why).
match_add(c: *Character, path: string, mirrored: bool) -> bool {
    a = c.animator as *Animator
    t = captured(a, path)
    if t == null { return false }
    if c.matcher < 0 { c.matcher = animator.add_matcher(a, "match") }
    animator.matcher_add(a, c.matcher, t)
    if mirrored { animator.matcher_add(a, c.matcher, animator.add_take(a, clips.mirror(t, animator.rig(a)), false)) }
    c.match_built = false
    return true
}

// Whether it moves by a database (match_add).
matching(c: *Character) -> bool { return c.matcher >= 0 }

// The database built and played, the mover asking it for the way ahead.
match_start(c: *Character) {
    a = c.animator as *Animator
    m = c.mover as *Mover
    animator.matcher_build(a, c.matcher)
    mover.set_matcher(m, c.matcher)
    mover.set_follow(m, true)
    mover.settle(m)
    if c.use_phase == USE_NONE { animator.play(a, c.matcher, 0.3) }
    c.match_built = true
}

// What it stands and moves in when it does nothing else: its database, or
// its stand.
rest_state(c: *Character) -> int {
    if c.matcher >= 0 { return c.matcher }
    return c.idle
}

// --- asking -----------------------------------------------------------------------------------------

// Go at `velocity` (the world's, over the ground, metres a second), facing
// `facing` (level; zero to face the way it goes). Every frame, from the game.
// Held by something else (ae3d.motion's fall and get-up, a cutscene): the
// character leaves its object, its mover and its capsule alone, and asks
// for no look or aim, until resume. Stepped on through it, a figure's mover
// walked its object on at the last speed asked, under the body a fall held
// (Siltreach's settlers, #942).
pause(c: *Character) {
    if c == null { return }
    c.paused = true
}

// Its own again, standing at `at` facing `facing` (level; none keeps the
// object's own), where the body that held it left it: the object put there,
// the mover settled on it at rest, nothing asked, and the feet planted
// afresh where they are drawn (ikrig.feet_reset), as Unity's
// CharacterController is put where a ragdoll got up before it is enabled
// again.
resume(c: *Character, at: Vec3, facing: Vec3) {
    if c == null { return }
    o = c.object as *GameObject
    behaviour.object_set_position(o, at)
    level = core.vec3(facing.x, 0.0, facing.z)
    if core.v3_len(level) > 0.0001 { behaviour.object_set_rotation(o, core.quat_rotate(core.atan2_of(level.x, level.z), core.vec3(0.0, 1.0, 0.0))) }
    c.asked = core.vec3(0.0, 0.0, 0.0)
    c.facing = core.vec3(0.0, 0.0, 0.0)
    mover.settle(c.mover as *Mover)
    if c.feet != null { ikrig.feet_reset(c.feet as *Feet) }
    c.paused = false
}

// Whether it is paused.
paused(c: *Character) -> bool { return c != null && c.paused }

// Play graph state `state` once, eased in over `blend` seconds (#958): a
// knock-down, a stagger, a death, any action between its gaits. Its root
// motion moves the figure through its capsule (a wall stops it), and the
// mover is left alone meanwhile, whatever is asked. At its end (a take that
// does not loop), at act_stop, or when the graph's own transitions take it
// out of the state, the character takes up its stand where it got to, the
// mover settled there: as UE's PlayAnimMontage on a Character moves the
// capsule by the montage's root motion and goes back to locomotion. Paused
// and resumed around it by hand, a game had to get that order right itself.
// A state with no take (a snapshot, animator.snapshot: a body lying where it
// fell between a knock-down and its get-up) is held until act_stop or the
// next act: knocked down, out for a while and up again are three acts.
// False while it uses a slot (the use holds it), or for no such state.
act(c: *Character, state: int, blend: float) -> bool {
    if c == null || state < 0 || c.use_phase != USE_NONE { return false }
    a = c.animator as *Animator
    if state >= animator.state_count(a) { return false }
    c.acting = true
    c.act_state = state
    animator.set_root_motion(a, true)
    animator.play(a, state, blend)
    return true
}

// Its act ended now, its stand taken up over `blend` seconds.
act_stop(c: *Character, blend: float) {
    if c == null || !c.acting { return }
    a = c.animator as *Animator
    animator.set_root_motion(a, false)
    animator.play(a, rest_state(c), blend)
    mover.settle(c.mover as *Mover)
    c.acting = false
    c.act_state = 0 - 1
}

// Swing `which` of held item `it` with the whole body (#945), at `rate`
// times the rate its weight gives, eased in over `blend`: its take played as
// an act, so a step-in moves the figure by the take's root motion through its
// capsule (a wall stops it), the mover left alone meanwhile, and the stand
// taken up where it got to; its edge swept for hits as items.swing's is.
// Played in place (items.swing), a step-in's feet slid under a figure that
// stayed put. A swing over a gait is items.swing_over. False when the item
// is not held, the figure has no such take, or it uses a slot.
swing(c: *Character, it: *Item, which: int, rate: float, blend: float) -> bool {
    if c == null || c.use_phase != USE_NONE { return false }
    state = items.swing_ready(it, which, rate)
    if state < 0 { return false }
    return act(c, state, blend)
}

// Whether it is still playing its act.
acting(c: *Character) -> bool { return c != null && c.acting }

// Seconds a finished act's stand is eased in over.
const ACT_OUT = 0.3

// Its act played on: ended at its take's end, or once the graph has left it.
act_step(c: *Character) -> bool {
    if !c.acting { return false }
    a = c.animator as *Animator
    t = animator.state_take(a, c.act_state)
    over = animator.current(a) != c.act_state
    if !over && t != null && !clips.looping(t) && animator.state_time(a) >= clips.duration(t) - 0.0001 { over = true }
    if over { act_stop(c, ACT_OUT) }
    return c.acting
}

// --- getting up (#859) ------------------------------------------------------------------------------

// The most get-ups a character chooses among.
const GET_UPS = 8

// Take `title` of the figure's own file made one of its get-ups (get_up
// chooses among them): its root motion taken from its pelvis
// (clips.root_under_pelvis), so its capsule stands under the body through
// the get-up, and a state played once. Its state; -1 when the file has no
// such take, or it has GET_UPS already.
get_up_add(c: *Character, title: string) -> int {
    if c == null || c.get_up_count >= GET_UPS { return 0 - 1 }
    a = c.animator as *Animator
    t = animator.take(a, title, true)
    if t == null { return 0 - 1 }
    clips.root_under_pelvis(t, animator.rig(a))
    state = animator.add_state(a, title, t, false)
    (c.get_ups as int[])[c.get_up_count] = state
    c.get_up_count = c.get_up_count + 1
    return state
}

// How many get-ups it has, and the state of the `i`th.
get_up_count(c: *Character) -> int { return c.get_up_count }
get_up_state(c: *Character, i: int) -> int {
    if i < 0 || i >= c.get_up_count { return 0 - 1 }
    return (c.get_ups as int[])[i]
}

// Up from where it lies: its ragdoll let go to ae3d.motion for a fall
// (physanim.release, motion LIMP) and come to rest there (motion.down), and
// one of its get-ups (get_up_add) played from the pose it lies in, as UE's
// and Unity's get-ups go from a ragdoll. In this order:
//   - the motion's bodies set to follow the rig and the motion let go of
//     (motion.release frees it; `m` null when nothing else held them);
//   - its object, capsule and mover upright on the ground under the pelvis,
//     the rig drawn from the bodies about it (resume, keeping the root);
//   - the get-up's first frame laid onto the body (lay_onto), the object put
//     there and the rig drawn about it again;
//   - the pose drawn read back as the animator's last two frames, still
//     (animator.read_drawn), the bodies taken back (physanim.retake);
//   - the get-up played as an act (act) inertialized over `blend` seconds
//     from the pose drawn, its root motion moving the capsule, and at its end
//     the stand taken up.
// Done by hand in another order, the drawn pelvis jumped 1.3 m. Its state;
// -1 when it has no get-up or no ragdoll.
get_up(c: *Character, m: *Motion, blend: float) -> int {
    if c == null || c.get_up_count == 0 || c.physanim == null { return 0 - 1 }
    a = c.animator as *Animator
    pa = c.physanim as *Physanim
    if m != null {
        motion.set_mode(m, motion.ANIMATED)
        motion.release(m)
    }
    r = animator.rig(a)
    w = pose.new(r)
    p = pose.new(r)
    first = pose.new(r)
    under_body(c, p)
    state = (c.get_ups as int[])[0]
    at, facing = lay_onto(r, c.object as *GameObject, p, animator.state_take(a, state), w, first)
    resume(c, at, facing)
    physics.ragdoll_show_pose(physanim.ragdoll_of(pa), null, true)
    pose.release(w)
    pose.release(p)
    pose.release(first)
    animator.read_drawn(a)
    physanim.retake(pa)
    animator.resume(a, 0.0)
    _acted = act(c, state, blend)
    return state
}

// The object upright on the ground under the ragdoll's pelvis, facing as it
// did, and the rig drawn from the bodies about it, read into `p`. Lying
// LIMP, the ragdoll drew the object where its pelvis carried it, turned as
// the pelvis lies.
under_body(c: *Character, p: ptr) {
    o = c.object as *GameObject
    e = c.engine as *Engine
    rag = physanim.ragdoll_of(c.physanim as *Physanim)
    pelvis = behaviour.object_position(physics.ragdoll_bone(rag, 0))
    ground = physics.ground_below(physics.of(e), pelvis, 0.1, 3.0, 0.5).point.y
    ahead = flat_of(core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)))
    resume(c, core.vec3(pelvis.x, ground, pelvis.z), ahead)
    physics.ragdoll_show_pose(rag, null, true)
    pose.read(animator.rig(c.animator as *Animator), p)
}

flat_of(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

// Joint `slot`'s place in the ground's space in pose `p` (locals), the
// figure as its object stands now; `w` a pose to work in.
joint_ground(r: *pose.Rig, p: ptr, w: ptr, slot: int) -> Vec3 {
    pose.world(r, p, w)
    return clips.ground_point(r, pose.translation(w, pose.human(r, slot)))
}

// Joint `slot` in pose `p` about the object, in its frame (its yaw taken
// off): where it would be, the object at the origin facing +z.
joint_about(r: *pose.Rig, o: *GameObject, p: ptr, w: ptr, slot: int) -> Vec3 {
    off = core.v3_sub(joint_ground(r, p, w, slot), behaviour.object_position(o))
    return core.quat_apply(core.quat_conjugate(behaviour.object_rotation(o)), off)
}

// Take `t`'s first frame laid onto the body as it lies (`drawn`, about the
// object as it stands): where the object goes and the way it faces, so the
// take's pelvis is on the drawn pelvis and its spine (pelvis to neck, level)
// lies along the drawn one. `w` and `first` poses to work in.
lay_onto(r: *pose.Rig, o: *GameObject, drawn: ptr, t: *Take, w: ptr, first: ptr) -> (Vec3, Vec3) {
    pelvis = joint_ground(r, drawn, w, pose.PELVIS)
    spine = flat_of(core.v3_sub(joint_ground(r, drawn, w, pose.NECK), pelvis))
    clips.sample(t, r, 0.0, false, first)
    clip_pelvis = joint_about(r, o, first, w, pose.PELVIS)
    clip_spine = flat_of(core.v3_sub(joint_about(r, o, first, w, pose.NECK), clip_pelvis))
    yaw = core.atan2_of(spine.x, spine.z) - core.atan2_of(clip_spine.x, clip_spine.z)
    turn = core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0))
    at = core.v3_sub(pelvis, core.quat_apply(turn, flat_of(clip_pelvis)))
    at = core.vec3(at.x, behaviour.object_position(o).y, at.z)
    return at, core.quat_apply(turn, core.vec3(0.0, 0.0, 1.0))
}

move(c: *Character, velocity: Vec3, facing: Vec3) {
    c.asked = core.vec3(velocity.x, 0.0, velocity.z)
    c.facing = core.vec3(facing.x, 0.0, facing.z)
}

// Eyes on `point` (the world's) until look_ahead.
look(c: *Character, point: Vec3) {
    c.eyes_free = false
    c.looking = true
    c.look_at = point
}

// Eyes ahead where it goes again.
look_ahead(c: *Character) {
    c.looking = false
    c.eyes_free = false
}

// No look at all, until look or look_ahead: the head as the take has it.
// Struck, a head goes where the blow sends it; held on what it watched, a
// head hit tipped the head back 16 degrees where its take tips it 80.
look_free(c: *Character) {
    c.looking = false
    c.eyes_free = true
}

// The pistol aims of the file at `path` (named `neutral`, `up` and `down`,
// level and 0.7 rad up and down) retargeted onto the figure as its aim
// offset over the spine, the level one also its ready pose. False when the
// file has none of them.
aims(c: *Character, e: *Engine, path: string, neutral: string, up: string, down: string) -> bool {
    a = c.animator as *Animator
    r = animator.rig(a)
    source_o = figure.figure(e, "aims", path)
    if source_o == null { return false }
    behaviour.object_set_position(source_o, core.vec3(0.0, 0.0 - 60.0, 0.0))
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    c.aim = animator.add_aim(a, pose.human(r, pose.SPINE_01))
    names = [neutral, up, down]
    pitches = [0.0, 0.7, 0.0 - 0.7]
    good = true
    k = 0
    while k < 3 {
        made = clips.from_scene(source, figure.scene(source_f), names[k], 0.0)
        if made == null {
            good = false
        } else {
            aimed = animator.add_take(a, retarget.retarget(source, made, r), false)
            animator.aim_add(a, c.aim, aimed, 0.0, pitches[k])
            if k == 0 { c.ready = animator.add_layer(a, aimed, pose.human(r, pose.SPINE_01), false, true) }
            clips.take_free(made)
        }
        k = k + 1
    }
    pose.rig_free(source)
    animator.set_aim(a, c.aim, 0.0, 0.0, 0.0)
    return good
}

// Aim at `target` (the world's): the ready pose over the upper body, the
// aim offset pitched at it, the trunk turned to it, the eyes on it.
aim(c: *Character, target: Vec3) {
    c.aiming = true
    c.target = target
}

aim_off(c: *Character) { c.aiming = false }

// --- using things (#908) ----------------------------------------------------------------------------

// What it is doing with a slot.
const USE_NONE = 0
const USE_GO = 1                   // walking to the slot's approach point
const USE_TURN = 2                 // turning on the spot to face the slot's way
const USE_ENTER = 3                // its enter take, warped onto the slot
const USE_LOOP = 4                 // its loop take, until it leaves
const USE_EXIT = 5                 // its exit take, and the slot let go
// Metres from the approach point it starts to turn at, and how near facing
// the slot's way (radians) it must be to enter.
const ARRIVED = 0.3
const FACED = 0.17
// Metres a second it walks to a slot at.
const USE_WALK = 0.9
// Seconds a hand's IK eases onto a slot's point before its take's contact,
// and off it after.
const REACH_IN = 0.25
const REACH_OUT = 0.35
// And how long before the contact it is all on: the hands' weight follows on
// a spring, and eased in to the contact itself it was still short of whole
// there, the hand 2.2 cm off the tool.
const REACH_HELD = 0.25
// The most takes a character's slots make states of.
const USE_TAKES = 32

// The file a slot's takes are read from when the figure's own has none of
// them (UAL1's sitting takes for the UE5 mannequin), retargeted onto it.
use_takes(c: *Character, path: string) {
    if c.use_source != null { string.release_kept(c.use_source) }
    c.use_source = string.keep(path)
}

// Use slot `slot` of `u`: walk to its approach point, turn there to face its
// way, enter it (the enter take warped so its part lands on the slot at the
// take's contact: animator.warp), then play its loop until leave. False if
// another holds the slot or it is using one already.
use(c: *Character, u: *Usables, slot: int) -> bool {
    if c.use_phase != USE_NONE { return false }
    if !usable.claim(u, slot, c as ptr) { return false }
    c.use_u = u as ptr
    c.use_slot = slot
    c.use_phase = USE_GO
    c.use_t = 0.0
    return true
}

// Leave the slot in use: its exit take, then the slot let go and the figure
// standing.
leave(c: *Character) { c.leaving = true }

using(c: *Character) -> bool { return c.use_phase != USE_NONE }
seated(c: *Character) -> bool { return c.use_phase == USE_LOOP }
use_phase(c: *Character) -> int { return c.use_phase }
// The enter take's time its part lands at, for the slot in use.
use_contact(c: *Character) -> float { return c.use_contact }
use_enter_state(c: *Character) -> int { return c.use_enter }

// The state playing the take named `title`, made the first time: from the
// file `from` retargeted where a slot names one (usable.slot_enter_from and
// the rest, #950), else from the figure's own file or use_takes'. -1 when
// none has it.
take_state(c: *Character, title: string, loop: bool, from: string) -> int {
    a = c.animator as *Animator
    if string.length(title) == 0 { return 0 - 1 }
    key = title
    if string.length(from) > 0 { key = "${from}#${title}" }
    k = 0
    while k < c.use_count {
        if string.equals(name_of_use(c, k), key) == 1 { return (c.use_states as int[])[k] }
        k = k + 1
    }
    r = animator.rig(a)
    t = null as *Take
    if string.length(from) == 0 { t = animator.take(a, title, true) }
    source_path = from
    if t == null && string.length(from) == 0 && c.use_source != null {
        known, _why = string.from_ptr(c.use_source)
        source_path = known
    }
    if t == null && string.length(source_path) > 0 {
        e = c.engine as *Engine
        so = figure.figure(e, "takes", source_path)
        if so != null {
            behaviour.object_set_position(so, core.vec3(0.0, 0.0 - 80.0, 0.0))
            sf = figure.figure_of(so)
            source = pose.of_skeleton(figure.skeleton(sf))
            made = clips.from_scene(source, figure.scene(sf), title, 0.0)
            if made != null {
                t = animator.add_take(a, retarget.retarget(source, made, r), true)
                clips.take_free(made)
            }
            pose.rig_free(source)
        }
    }
    if t == null { return 0 - 1 }
    s = animator.add_state(a, title, t, loop)
    if c.use_count >= USE_TAKES { return s }
    (c.use_names as ptr[])[c.use_count] = string.keep(key)
    (c.use_states as int[])[c.use_count] = s
    c.use_count = c.use_count + 1
    return s
}

name_of_use(c: *Character, k: int) -> string {
    text, _why = string.from_ptr((c.use_names as ptr[])[k])
    return text
}

// When take `t`'s part `lands` (usable.LANDS_*) lands: a pelvis when it
// first comes within 1 cm of its height at the take's end (sat down); a
// hand when it has gone furthest from where it was at the take's start (its
// reach: measured from the pelvis, a hand hanging at the side counted as
// reaching at the take's first frame); the feet at the end.
contact_of(t: *Take, r: *pose.Rig, lands: int) -> float {
    if lands == usable.LANDS_FEET { return clips.duration(t) }
    w = pose.new(r)
    pelvis = pose.human(r, pose.PELVIS)
    found = clips.duration(t)
    if lands == usable.LANDS_PELVIS {
        pose.world(r, clips.frame(t, clips.frames(t) - 1), w)
        last = clips.ground_point(r, pose.translation(w, pelvis)).y
        f = 0
        while f < clips.frames(t) {
            pose.world(r, clips.frame(t, f), w)
            if core.abs_of(clips.ground_point(r, pose.translation(w, pelvis)).y - last) < 0.01 {
                found = (f as float) / clips.rate(t)
                f = clips.frames(t)
            }
            f = f + 1
        }
    } else {
        hand = pose.human(r, pose.HAND_R)
        if lands == usable.LANDS_HAND_L { hand = pose.human(r, pose.HAND_L) }
        most = 0.0 - 1.0
        pose.world(r, clips.frame(t, 0), w)
        start = core.v3_sub(clips.ground_point(r, pose.translation(w, hand)), clips.ground_point(r, pose.translation(w, pelvis)))
        f = 0
        while f < clips.frames(t) {
            pose.world(r, clips.frame(t, f), w)
            d = core.v3_sub(clips.ground_point(r, pose.translation(w, hand)), clips.ground_point(r, pose.translation(w, pelvis)))
            reach = core.v3_len(core.v3_sub(d, start))
            if reach > most {
                most = reach
                found = (f as float) / clips.rate(t)
            }
            f = f + 1
        }
    }
    pose.release(w)
    return found
}

// A step of using a slot (see use). True while the figure is the slot's.
use_step(c: *Character, dt: float) -> bool {
    if c.use_phase == USE_NONE { return false }
    a = c.animator as *Animator
    m = c.mover as *Mover
    o = c.object as *GameObject
    u = c.use_u as *Usables
    at = behaviour.object_position(o)
    c.use_t = c.use_t + dt
    if c.use_phase == USE_GO {
        to = core.v3_sub(usable.slot_approach(u, c.use_slot), at)
        to = core.vec3(to.x, 0.0, to.z)
        d = core.v3_len(to)
        ask = core.vec3(0.0, 0.0, 0.0)
        // Asked on until the springs would bring it to rest there.
        if d > ARRIVED && mover.rest_distance(m) < d { ask = core.v3_mul(core.v3_normalize(to), USE_WALK) }
        mover.face(m, 0.0, false)
        mover.ask(m, ask)
        mover.step(m, dt)
        now = animator.current(a)
        // Stood: not in a stop, nor, moving by a database, still carried by a
        // frame that walks.
        still = now != c.stop && now != c.stop_m
        if c.matcher >= 0 { still = animator.ground_speed(a) < STOOD }
        if d <= ARRIVED && core.v3_len(mover.velocity(m)) < 0.05 && still {
            c.use_phase = USE_TURN
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_TURN {
        way = usable.slot_facing(u, c.use_slot)
        yaw = core.atan2_of(way.x, way.z)
        mover.face(m, yaw, true)
        mover.ask(m, core.vec3(0.0, 0.0, 0.0))
        mover.step(m, dt)
        ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
        off = core.abs_of(wrap_angle(yaw - core.atan2_of(ahead.x, ahead.z)))
        if off < FACED && c.use_t > 0.3 {
            // Entered: the take's own root motion moves it, warped onto the slot.
            c.use_enter = take_state(c, usable.slot_enter(u, c.use_slot), false, usable.slot_enter_from(u, c.use_slot))
            c.use_loop = take_state(c, usable.slot_loop(u, c.use_slot), true, usable.slot_loop_from(u, c.use_slot))
            c.use_exit = take_state(c, usable.slot_exit(u, c.use_slot), false, usable.slot_exit_from(u, c.use_slot))
            if c.use_enter < 0 {
                // A slot that names no takes (a spot to stand at, a bedroll the
                // game lies down on by other means): held as it is reached,
                // facing its way, until it leaves. Refused, a slot with no
                // takes could not even be claimed and walked to (#949).
                if string.length(usable.slot_enter(u, c.use_slot)) == 0 {
                    // Its loop played there if it names one (chopping at a
                    // block, warming the hands at a fire).
                    if c.use_loop >= 0 { animator.play(a, c.use_loop, 0.3) }
                    c.use_phase = USE_LOOP
                    c.use_t = 0.0
                    return true
                }
                usable.release(u, c.use_slot, c as ptr)
                c.use_phase = USE_NONE
                return false
            }
            lands = usable.slot_lands(u, c.use_slot)
            enter_t = animator.state_take(a, c.use_enter)
            c.use_contact = contact_of(enter_t, animator.rig(a), lands)
            animator.set_root_motion(a, true)
            animator.play(a, c.use_enter, 0.3)
            part = pose.PELVIS
            if lands == usable.LANDS_HAND_R { part = pose.HAND_R }
            if lands == usable.LANDS_HAND_L { part = pose.HAND_L }
            if lands != usable.LANDS_FEET { animator.warp(a, c.use_enter, c.use_contact, usable.slot_at(u, c.use_slot), way, part) }
            c.use_phase = USE_ENTER
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_ENTER {
        // A hand's slot: the hand drawn onto it about the take's contact by the
        // whole body (ikrig's full-body reach, the feet held where the take has
        // them), eased in over REACH_IN to REACH_HELD before it and out over
        // REACH_OUT after, as a reach is fitted to what it reaches for. The warp
        // moves the body over the ground only: by it alone, a hand fell 3.2 cm
        // short of a bench's tool; by the arm alone, its reach near full
        // stretch, 1.3 cm.
        lands = usable.slot_lands(u, c.use_slot)
        if lands == usable.LANDS_HAND_L || lands == usable.LANDS_HAND_R {
            side = 1
            if lands == usable.LANDS_HAND_L { side = 0 }
            b = animator.body(a)
            if b == null {
                b = ikrig.body_new(animator.rig(a))
                ikrig.body_hold_feet(b, true)
                animator.set_body(a, b)
            }
            now = animator.state_time(a)
            w = 0.0
            if now < c.use_contact {
                u_in = core.clampf(1.0 - (c.use_contact - REACH_HELD - now) / REACH_IN, 0.0, 1.0)
                w = u_in * u_in * (3.0 - 2.0 * u_in)
            } else {
                u_out = core.clampf(1.0 - (now - c.use_contact) / REACH_OUT, 0.0, 1.0)
                w = u_out * u_out * (3.0 - 2.0 * u_out)
            }
            which = ikrig.BODY_HAND_R
            if side == 0 { which = ikrig.BODY_HAND_L }
            if b != null { ikrig.body_set(b, which, usable.slot_at(u, c.use_slot), w) }
        }
        if animator.current(a) == c.use_enter && animator.state_time(a) >= clips.duration(animator.state_take(a, c.use_enter)) - 0.0001 {
            if c.use_loop >= 0 { animator.play(a, c.use_loop, 0.3) }
            c.use_phase = USE_LOOP
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_LOOP {
        if c.leaving {
            c.leaving = false
            animator.lift_to(a, 0.0, 0.6)
            if c.use_exit >= 0 {
                animator.play(a, c.use_exit, 0.3)
                c.use_phase = USE_EXIT
            } else {
                done_using(c)
            }
            c.use_t = 0.0
        }
        return true
    }
    if c.use_phase == USE_EXIT {
        if animator.current(a) != c.use_exit || animator.state_time(a) >= clips.duration(animator.state_take(a, c.use_exit)) - 0.0001 {
            done_using(c)
        }
        return true
    }
    return false
}

// The slot let go, the figure standing on its own again, the mover's
// springs where it is.
done_using(c: *Character) {
    a = c.animator as *Animator
    usable.release(c.use_u as *Usables, c.use_slot, c as ptr)
    animator.set_root_motion(a, false)
    animator.lift_to(a, 0.0, 0.3)
    animator.play(a, rest_state(c), 0.4)
    mover.settle(c.mover as *Mover)
    c.use_phase = USE_NONE
}

wrap_angle(x: float) -> float {
    y = x
    while y > 3.141592653589793 { y = y - 6.283185307179586 }
    while y < 0.0 - 3.141592653589793 { y = y + 6.283185307179586 }
    return y
}

// --- each step --------------------------------------------------------------------------------------

character_fixed(state: ptr, e: *Engine, dt: float) {
    c = state as *Character
    if c.paused { return }
    a = c.animator as *Animator
    m = c.mover as *Mover
    o = c.object as *GameObject
    at = behaviour.object_position(o)
    if c.matcher >= 0 && !c.match_built { match_start(c) }
    using_now = use_step(c, dt) || act_step(c)
    if !using_now {
        if core.v3_len(c.facing) > 0.0001 {
            mover.face(m, core.atan2_of(c.facing.x, c.facing.z), true)
        } else {
            mover.face(m, 0.0, false)
        }
        mover.ask(m, steer(c, c.asked))
        mover.step(m, dt)
    }
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    eyes = core.vec3(at.x + ahead.x * LOOK_AHEAD, at.y + EYE_HIGH, at.z + ahead.z * LOOK_AHEAD)
    if c.looking { eyes = c.look_at }
    if c.aiming { eyes = c.target }
    // Eyes ahead lightly; on what it is told to look at or aim at, fully.
    weight = 0.8
    if c.looking || c.aiming { weight = 1.0 }
    if c.eyes_free && !c.aiming { weight = 0.0 }
    animator.look_at(a, eyes, weight)
    if c.aim >= 0 {
        w = 0.0
        pitch = 0.0
        if c.aiming {
            w = 1.0
            to = core.v3_sub(c.target, core.vec3(at.x, at.y + EYE_HIGH, at.z))
            pitch = core.atan2_of(to.y, core.v3_len(core.vec3(to.x, 0.0, to.z)))
        }
        animator.set_aim(a, c.aim, 0.0, pitch, w)
        animator.layer_weight(a, c.ready, w, EASE)
    }
}

// --- underneath -------------------------------------------------------------------------------------

animator_of(c: *Character) -> *Animator { return c.animator as *Animator }
mover_of(c: *Character) -> *Mover { return c.mover as *Mover }
feet_of(c: *Character) -> *Feet { return c.feet as *Feet }
object_of(c: *Character) -> *GameObject { return c.object as *GameObject }
idle_state(c: *Character) -> int { return c.idle }
// Whether it stands: in either stand (the stand or its mirror), or, moving
// by a database, on a frame that hardly goes anywhere, nor asked to.
standing(c: *Character) -> bool {
    now = animator.current(c.animator as *Animator)
    if c.matcher >= 0 { return now == c.matcher && animator.ground_speed(c.animator as *Animator) < STOOD && core.v3_len(c.asked) < 0.05 }
    return now == c.idle || now == c.idle_m
}
move_state(c: *Character) -> int { return c.walk }

// --- avoidance (#956) ---------------------------------------------------------------------------------

// Seconds ahead a meeting is looked for, in steps of AVOID_DT (AVOID_SAMPLES
// of them), and the room kept between two capsules beyond their radii. A
// neighbour is one that could meet it within the horizon at the speeds they
// go. The horizon is the time a walker's curve needs to clear another: its
// way turns about 20 degrees a second (ae3d.mover's curve), so two walkers
// meeting head on need some two seconds of turning to pass a capsule apart:
// looking 2.5 s ahead, two walkers in the plaza still touched for 25 steps.
const AVOID_HORIZON = 4.0
const AVOID_DT = 0.1
const AVOID_SAMPLES = 40
// A neighbour as steer reads it: the distance their centres keep, its offset
// now, and its way ahead (AVOID_SAMPLES x and z pairs), all from here.
const AVOID_STRIDE = 83
const AVOID_ROOM = 0.06
// What turning off the way asked costs (a whole turn of the asked speed: 1),
// what a meeting `t` seconds ahead costs (AVOID_MEET * (1 / t - 1 / the
// horizon), nothing at the horizon so a meeting coming into it does not
// jolt the choice), and the small lean
// to the right two walkers meeting head on share so they pass, not mirror.
const AVOID_TURN = 1.0
const AVOID_MEET = 1.2
const AVOID_RIGHT = 0.02
// And what leaving the way it chose last step costs (a whole turn: AVOID_KEEP).
const AVOID_KEEP = 0.6
// The share of the way to its new choice a steered velocity goes each step.
const AVOID_EASE = 0.12

var g_people: ptr = null                // list of *Character: every character, for avoidance

// Whether it steers round the other solid characters near it, and how much
// of a meeting it takes on (1: half, as each of two does; 0: none), as UE's
// CharacterMovementComponent's RVO avoidance (bUseRVOAvoidance, its weight).
// On by default for a character whose capsule is solid.
set_avoidance(c: *Character, on: bool, weight: float) {
    if c == null { return }
    c.avoid_off = !on
    c.avoid_weight = core.clampf(weight, 0.0, 4.0)
}

avoiding(c: *Character) -> bool { return c != null && !c.avoid_off }

people_add(c: *Character) {
    if g_people == null { g_people = list.new() }
    list.add_raw(g_people, c as ptr)
}

people_remove(c: *Character) {
    if g_people == null { return }
    i = 0
    while i < list.size(g_people) {
        if list.get_raw(g_people, i) == c as ptr {
            list.remove(g_people, i)
            return
        }
        i = i + 1
    }
}

// The velocity asked, steered round the other solid characters near it
// (#956): a velocity sampled near the one asked, up to 90 degrees off it and
// no faster, scored by how far it turns and by how soon it would meet each
// neighbour's capsule, the meeting read reciprocally (RVO: the relative
// velocity 2v - v_mine - v_theirs, as if each takes half the turn), the
// lowest kept. Two solid walkers asked straight at each other walked into
// each other and stopped 0.56 m apart.
// Each way is weighed by where the figure would really go asked it: its
// mover's springs and curve run ahead (mover.path), not the velocity taken
// at once. Read as taken at once, a way 30 degrees off cleared a meeting the
// curve, turning the way about 20 degrees a second, had not cleared when the
// two met: walkers' capsules touched in 156 to 211 steps of a 20 s plaza,
// and the shove carried a body across its locked foot (feet crossed 140 mm).
steer(c: *Character, asked: Vec3) -> Vec3 {
    speed = core.sqrt_of(asked.x * asked.x + asked.z * asked.z)
    if c.avoid_off || c.avoid_weight <= 0.0 || speed < 0.05 || g_people == null || c.capsule == null || c.mover == null { return asked }
    mine = c.capsule as *CharacterController
    if !physics.character_solid(mine) { return asked }
    m = c.mover as *Mover
    o = c.object as *GameObject
    here = behaviour.object_position(o)
    v_mine = mover.velocity(m)
    r_mine = physics.character_radius(mine)
    going = core.sqrt_of(v_mine.x * v_mine.x + v_mine.z * v_mine.z)
    if going < speed { going = speed }
    // Its neighbours, read once: those it could meet within the horizon,
    // each's way ahead from here (mover.path_on: doing as it does) and the
    // distance their centres keep.
    n = 0
    near = calloc(list.size(g_people) * AVOID_STRIDE, 8) as float[]
    ahead = calloc(AVOID_SAMPLES * 2, 8) as float[]
    i = 0
    while i < list.size(g_people) {
        other = list.get_raw(g_people, i) as *Character
        if other != c && other.engine == c.engine && other.capsule != null && !other.paused {
            cap = other.capsule as *CharacterController
            there = behaviour.object_position(other.object as *GameObject)
            v_other = physics.character_velocity(cap)
            dx = there.x - here.x
            dz = there.z - here.z
            reach = r_mine + physics.character_radius(cap) + AVOID_ROOM
            closing = (going + core.sqrt_of(v_other.x * v_other.x + v_other.z * v_other.z)) * AVOID_HORIZON + reach
            if physics.character_solid(cap) && dx * dx + dz * dz < closing * closing {
                at = n * AVOID_STRIDE
                near[at] = reach
                near[at + 1] = dx
                near[at + 2] = dz
                if other.mover != null { mover.path_on(other.mover as *Mover, AVOID_DT, AVOID_SAMPLES, ahead) }
                j = 0
                while j < AVOID_SAMPLES {
                    t = (j + 1) as float * AVOID_DT
                    if other.mover == null {
                        ahead[j * 2] = v_other.x * t
                        ahead[j * 2 + 1] = v_other.z * t
                    }
                    near[at + 3 + j * 2] = dx + ahead[j * 2]
                    near[at + 4 + j * 2] = dz + ahead[j * 2 + 1]
                    j = j + 1
                }
                n = n + 1
            }
        }
        i = i + 1
    }
    free(ahead as ptr)
    if n == 0 {
        free(near as ptr)
        c.steered_known = false
        return asked
    }
    // Where it goes doing as it does, and where each way would take it.
    base = calloc(AVOID_SAMPLES * 2, 8) as float[]
    way = calloc(AVOID_SAMPLES * 2, 8) as float[]
    mover.path_on(m, AVOID_DT, AVOID_SAMPLES, base)
    best = asked
    best_cost = 1000000000.0
    angles = [0.0, -0.2618, 0.2618, -0.5236, 0.5236, -0.7854, 0.7854, -1.0472, 1.0472, -1.309, 1.309, -1.5708, 1.5708]
    shares = [1.0, 0.6]
    a = 0
    while a < 13 {
        cs = core.cos_of(angles[a])
        sn = core.sin_of(angles[a])
        s = 0
        while s < 2 {
            vx = (asked.x * cs + asked.z * sn) * shares[s]
            vz = (asked.z * cs - asked.x * sn) * shares[s]
            ox = vx - asked.x
            oz = vz - asked.z
            cost = AVOID_TURN * core.sqrt_of(ox * ox + oz * oz) / speed
            if angles[a] > 0.0 { cost = cost + AVOID_RIGHT }
            // Kept to the way it chose last step, as a person commits to a side:
            // chosen afresh every step, a heading flipping between two samples
            // skated a toe 5.3 mm through four crossing.
            if c.steered_known {
                kx = vx - c.steered.x
                kz = vz - c.steered.z
                cost = cost + AVOID_KEEP * core.sqrt_of(kx * kx + kz * kz) / speed
            }
            mover.path(m, core.vec3(vx, 0.0, vz), AVOID_DT, AVOID_SAMPLES, way)
            k = 0
            while k < n {
                t = meet_on(near, k, base, way)
                if t < 0.05 { t = 0.05 }
                if t < AVOID_HORIZON { cost = cost + c.avoid_weight * AVOID_MEET * (1.0 / t - 1.0 / AVOID_HORIZON) }
                k = k + 1
            }
            if cost < best_cost {
                best_cost = cost
                best = core.vec3(vx, 0.0, vz)
            }
            s = s + 1
        }
        a = a + 1
    }
    free(near as ptr)
    free(base as ptr)
    free(way as ptr)
    // Eased toward what it chose, a share AVOID_EASE a step: taken at once,
    // a fifteen degree turn as a meeting began skated a toe 5.3 mm.
    if c.steered_known { best = core.v3_lerp(c.steered, best, AVOID_EASE) }
    c.steered = best
    c.steered_known = true
    return best
}

// Seconds until it meets neighbour `k` of `near` (steer's: the distance
// their centres keep, then the neighbour's way ahead from here) going the
// way whose path is `way`, where doing as it does is `base`; AVOID_HORIZON
// and more when it does not (moving apart, passing). Read reciprocally, as
// RVO's 2v - v_mine - v_theirs: its own turn off `base` counted twice, as if
// the other turns as much the other way, the other otherwise doing as it
// does. The time between two samples is read where the gap crosses the
// reach, so the cost changes smoothly from one way to the next.
meet_on(near: float[], k: int, base: float[], way: float[]) -> float {
    at = k * AVOID_STRIDE
    reach = near[at]
    was = core.sqrt_of(near[at + 1] * near[at + 1] + near[at + 2] * near[at + 2])
    within = was < reach
    j = 0
    while j < AVOID_SAMPLES {
        t = (j + 1) as float * AVOID_DT
        gx = near[at + 3 + j * 2] - (2.0 * way[j * 2] - base[j * 2])
        gz = near[at + 4 + j * 2] - (2.0 * way[j * 2 + 1] - base[j * 2 + 1])
        gap = core.sqrt_of(gx * gx + gz * gz)
        if within {
            // Already within: a meeting now, unless going apart.
            if j == 0 && gap < was { return 0.0 }
            if gap >= reach { within = false }
        } else {
            if gap < reach { return t - AVOID_DT + AVOID_DT * (was - reach) / (was - gap) }
        }
        was = gap
        j = j + 1
    }
    return AVOID_HORIZON * 2.0
}
