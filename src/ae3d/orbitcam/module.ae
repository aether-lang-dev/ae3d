// ae3d.orbitcam -- a camera that orbits a point (#823): a target, a distance,
// a yaw and a pitch, with limits, turned by a mouse drag, zoomed by the
// wheel, turned by the arrow keys. Lifted from the editor's viewport, which
// now uses this one; nothing about how it moves was changed in the lift.
//
//   o = orbitcam.orbit_new(target, 12.0, 0.0 - 55.0, 26.0)  // target, distance, yaw, pitch (degrees)
//   orbitcam.attach(e, o, engine.engine_camera(e))          // the engine's loop drives it from its input
//
// or by hand, the way the editor does from its own canvas events:
//
//   orbitcam.orbit_turn(o, dx, dy)                          // a drag, in pixels
//   orbitcam.orbit_zoom_step(o, true)                       // one notch in
//   orbitcam.orbit_apply(o, cam)                            // the camera put where the orbit says
//
// The eye stands `distance` from the target at the yaw and pitch, and looks
// at the target. Yaw is degrees about the up axis from +x toward +z (the
// camera's own yaw plus 180 when it looks at the target), pitch is degrees
// above the horizontal. Pitch is held to [min_pitch, max_pitch] (-85..85 by
// default, so the up vector never flips) and the distance to
// [min_distance, max_distance] (0.1..10000); orbit_apply clamps what it
// reads, so a limit narrowed later takes hold at the next apply.
//
// Input, when attached (orbitcam.attach): the left mouse button dragged
// turns the orbit, ORBIT_SPEED degrees a pixel, after the cursor has moved
// DRAG_SLOP pixels from where it went down (so a click is not a drag), the
// wheel pushed away zooms in by ZOOM_STEP a notch, the arrow keys turn it at
// key_turn degrees a second. A menu that has the input blocked (input.blocked)
// moves nothing. Zoom keys are unbound until orbit_bind_zoom_keys.
//
// The camera's own fly controls are the engine's when the camera is the
// engine's; attach switches them off for that camera.
import std.heap
import ae3d.core
import ae3d.platform
import ae3d.input
import ae3d.engine

exports (
    Orbit, ORBIT_SPEED, ZOOM_STEP, DRAG_SLOP, ORBIT_AHEAD,
    orbit_new, orbit_free, orbit_set_target, orbit_set_limits, orbit_set_pose,
    orbit_set_button, orbit_set_speed, orbit_set_zoom_step, orbit_set_key_turn, orbit_bind_zoom_keys,
    orbit_turn, orbit_zoom_step, orbit_zoom, orbit_apply, orbit_from_camera, orbit_eye, orbit_update,
    orbit_dragging, orbit_set_active, attach, detach
)

extern pow(x: float, y: float) -> float

const ORBIT_SPEED = 0.35             // degrees of turn a pixel of drag
const ZOOM_STEP = 1.12               // the distance's factor a wheel notch
const DRAG_SLOP = 3.0                // pixels before a press is a drag
const ORBIT_AHEAD = 40.0             // orbit_from_camera's usual pivot distance

struct Orbit {
    target: Vec3
    distance: float
    yaw: float                       // degrees
    pitch: float                     // degrees
    min_distance: float
    max_distance: float
    min_pitch: float
    max_pitch: float
    speed: float                     // degrees a pixel
    zoom_step: float
    key_turn: float                  // degrees a second on an arrow key
    zoom_in_key: int                 // -1 for none
    zoom_out_key: int
    key_zoom: float                  // notches a second on a zoom key
    button: int                      // the mouse button that drags
    // The drag, as the input saw it.
    down: bool
    moved: bool
    press_x: float
    press_y: float
    // Attached to an engine (attach), or not.
    engine: ptr
    behaviour: ptr
    camera: ptr
}

orbit_new(target: Vec3, distance: float, yaw: float, pitch: float) -> *Orbit {
    o = heap.new(Orbit)
    o.target = target
    o.distance = distance
    o.yaw = yaw
    o.pitch = pitch
    o.min_distance = 0.1
    o.max_distance = 10000.0
    o.min_pitch = 0.0 - 85.0
    o.max_pitch = 85.0
    o.speed = ORBIT_SPEED
    o.zoom_step = ZOOM_STEP
    o.key_turn = 90.0
    o.zoom_in_key = 0 - 1
    o.zoom_out_key = 0 - 1
    o.key_zoom = 4.0
    o.button = platform.MOUSE_LEFT
    return o
}

orbit_free(o: *Orbit) {
    if o == null { return }
    detach(o)
    heap.free(o)
}

orbit_set_target(o: *Orbit, target: Vec3) { o.target = target }

orbit_set_pose(o: *Orbit, distance: float, yaw: float, pitch: float) {
    o.distance = distance
    o.yaw = yaw
    o.pitch = pitch
}

// The limits, kept in order: a minimum above its maximum is swapped.
orbit_set_limits(o: *Orbit, min_distance: float, max_distance: float, min_pitch: float, max_pitch: float) {
    o.min_distance = min_distance
    o.max_distance = max_distance
    if min_distance > max_distance {
        o.min_distance = max_distance
        o.max_distance = min_distance
    }
    o.min_pitch = min_pitch
    o.max_pitch = max_pitch
    if min_pitch > max_pitch {
        o.min_pitch = max_pitch
        o.max_pitch = min_pitch
    }
}

orbit_set_button(o: *Orbit, button: int) { o.button = button }
orbit_set_speed(o: *Orbit, degrees_per_pixel: float) { o.speed = degrees_per_pixel }
orbit_set_zoom_step(o: *Orbit, step: float) {
    if step > 1.0 { o.zoom_step = step }
}
orbit_set_key_turn(o: *Orbit, degrees_per_second: float) { o.key_turn = degrees_per_second }
orbit_bind_zoom_keys(o: *Orbit, zoom_in: int, zoom_out: int) {
    o.zoom_in_key = zoom_in
    o.zoom_out_key = zoom_out
}

// A drag of (dx, dy) pixels: right turns the view with the cursor, down
// looks down on the target.
orbit_turn(o: *Orbit, dx: float, dy: float) {
    o.yaw = o.yaw + dx * o.speed
    o.pitch = o.pitch - dy * o.speed
}

// One wheel notch: in brings the eye closer by the zoom step, out away.
orbit_zoom_step(o: *Orbit, closer: bool) {
    if closer {
        o.distance = o.distance / o.zoom_step
    } else {
        o.distance = o.distance * o.zoom_step
    }
}

// Notches, positive in: whole ones are steps (exactly orbit_zoom_step's),
// the rest of a trackpad's fraction is a fraction of one.
orbit_zoom(o: *Orbit, notches: float) {
    n = notches
    while n >= 1.0 {
        orbit_zoom_step(o, true)
        n = n - 1.0
    }
    while n <= 0.0 - 1.0 {
        orbit_zoom_step(o, false)
        n = n + 1.0
    }
    if n != 0.0 { o.distance = o.distance * pow(o.zoom_step, 0.0 - n) }
}

orbit_hold_limits(o: *Orbit) {
    o.pitch = core.clampf(o.pitch, o.min_pitch, o.max_pitch)
    if o.distance < o.min_distance { o.distance = o.min_distance }
    if o.distance > o.max_distance { o.distance = o.max_distance }
}

// Where the eye is, with the limits held.
orbit_eye(o: *Orbit) -> Vec3 {
    orbit_hold_limits(o)
    yaw = core.deg_to_rad(o.yaw)
    pitch = core.deg_to_rad(o.pitch)
    horizontal = o.distance * core.cos_of(pitch)
    return core.vec3(o.target.x + horizontal * core.cos_of(yaw),
                     o.target.y + o.distance * core.sin_of(pitch),
                     o.target.z + horizontal * core.sin_of(yaw))
}

// The camera put on the orbit, looking at the target.
orbit_apply(o: *Orbit, cam: *Camera) {
    if cam == null { return }
    eye = orbit_eye(o)
    core.camera_set_position(cam, eye)
    core.camera_look_at(cam, o.target)
}

// The orbit from where the camera stands and looks: its pivot `ahead` along
// its line of sight (ORBIT_AHEAD is the editor's), the eye behind it on that
// line. A scene's own view is kept this way, or the next turn of the orbit
// would snap the camera back to the orbit's default. The camera is then put
// on the orbit, which holds the limits.
orbit_from_camera(o: *Orbit, cam: *Camera, ahead: float) {
    core.camera_update_vectors(cam)
    front = cam.front
    o.target = core.vec3(cam.position.x + front.x * ahead,
                         cam.position.y + front.y * ahead,
                         cam.position.z + front.z * ahead)
    o.distance = ahead
    o.yaw = cam.yaw + 180.0
    o.pitch = 0.0 - cam.pitch
    orbit_apply(o, cam)
}

// Whether a drag is under way (the press has moved past the slop).
orbit_dragging(o: *Orbit) -> bool { return o.down && o.moved }

// One frame of the input: the drag, the wheel and the keys, then the camera
// put on the orbit. A blocked input (a menu is open) moves nothing and drops
// a press that was under way.
orbit_update(o: *Orbit, inp: *Input, cam: *Camera, delta: float) {
    if inp != null && !input.blocked(inp) {
        pressed = input.raw_mouse(inp, o.button)
        if pressed && !o.down {
            o.down = true
            o.moved = false
            o.press_x = input.mouse_x(inp)
            o.press_y = input.mouse_y(inp)
        }
        if pressed && o.down {
            if !o.moved {
                if core.abs_of(input.mouse_x(inp) - o.press_x) > DRAG_SLOP ||
                   core.abs_of(input.mouse_y(inp) - o.press_y) > DRAG_SLOP {
                    o.moved = true
                }
            }
            // The frame that crosses the slop turns by its own move, as the
            // editor's canvas does: the cursor's last place is kept every
            // frame, before the slop and after it.
            if o.moved { orbit_turn(o, input.mouse_dx(inp), input.mouse_dy(inp)) }
        }
        if !pressed {
            o.down = false
            o.moved = false
        }

        notches = input.scroll(inp)
        if notches != 0.0 { orbit_zoom(o, notches) }

        turn = o.key_turn * delta
        if input.raw_key(inp, platform.KEY_LEFT) { o.yaw = o.yaw - turn }
        if input.raw_key(inp, platform.KEY_RIGHT) { o.yaw = o.yaw + turn }
        if input.raw_key(inp, platform.KEY_UP) { o.pitch = o.pitch + turn }
        if input.raw_key(inp, platform.KEY_DOWN) { o.pitch = o.pitch - turn }
        if o.zoom_in_key >= 0 && input.raw_key(inp, o.zoom_in_key) { orbit_zoom(o, o.key_zoom * delta) }
        if o.zoom_out_key >= 0 && input.raw_key(inp, o.zoom_out_key) { orbit_zoom(o, 0.0 - o.key_zoom * delta) }
    } else {
        o.down = false
        o.moved = false
    }
    orbit_apply(o, cam)
}

// Whether the attached orbit is driving its camera: off, the behaviour stays
// in the engine and does nothing (another controller, a path, has the camera).
// A press under way is dropped.
orbit_set_active(o: *Orbit, on: bool) {
    o.down = false
    o.moved = false
    if o.behaviour != null { (o.behaviour as *Behaviour).enabled = on }
}

update_orbit(state: ptr, e: *Engine, delta: float) {
    o = state as *Orbit
    if o.camera == null { return }
    orbit_update(o, engine.engine_input(e), o.camera as *Camera, delta)
}

// The engine's loop drives the orbit: every update reads the engine's input
// and puts `cam` on the orbit. The engine's own camera loses its fly controls
// (engine_set_camera_input off); a camera of the program's own (a view's)
// has none to lose. An orbit is attached to one engine at a time.
attach(e: *Engine, o: *Orbit, cam: *Camera) {
    if e == null || o == null || cam == null { return }
    detach(o)
    if cam == engine.engine_camera(e) { engine.engine_set_camera_input(e, false) }
    b = engine.behaviour_new("orbitcam", o as ptr)
    b.update = update_orbit
    engine.engine_add_behaviour(e, b)
    o.engine = e as ptr
    o.behaviour = b as ptr
    o.camera = cam as ptr
}

detach(o: *Orbit) {
    if o == null || o.behaviour == null { return }
    e = o.engine as *Engine
    engine.engine_remove_behaviour(e, o.behaviour as *Behaviour)
    heap.free(o.behaviour as *Behaviour)
    o.behaviour = null
    o.engine = null
    o.camera = null
}
