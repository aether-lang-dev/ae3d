// ae3d.gpu: a shader written with `quote`, written out as GLSL or run on the
// CPU.
//
// A shader is a function whose body is a quote (ae3d.shaders.fxaa):
//
//   fxaa(screen: Texture, texel: vec2, edge: float, ...) -> *GpuShader {
//       return fragment("fxaa") quote | uv: vec2 | { ... return vec4(c, 1.0) }
//   }
//
// The compiler type-checks the body against ae3d.shaderlib and hands
// fragment() the tree (std.quote), every node carrying its type. A back end
// only ever walks that tree:
//
//   - emit_glsl writes a fragment shader, for Vulkan (#version 450: the
//     captures that are not textures in a std140 uniform block, `Params`, at
//     binding 0, each texture a sampler at the next binding) or for desktop
//     OpenGL 4.1 (each a uniform by name); the parameter is its input and
//     the value returned its colour. params_* give the uniforms' names,
//     types and std140 layout, and params_write fills a block from the
//     captures' cells, which are the variables themselves: what the program
//     last set is what the next frame reads. emit_screen_vertex writes the
//     vertex shader a full-screen pass draws it with.
//   - cpu_run runs the tree for one pixel over vec values (doubles,
//     rounded to f32 as each is made, as a GPU holds them), the captures
//     read from their cells, texture() reading a Texture's ShaderImage.
//
// The tree's kinds this version takes: BLOCK, LET, ASSIGN, RETURN, IF,
// WHILE, FOR, BREAK, CONTINUE, EXPR, LIT, LOCAL, CAPTURE, UNARY, BINARY,
// CHOOSE, CALL, FIELD and HELPER_CALL (a @quotable function, written out as a
// GLSL function, quote version 2); INDEX is written as GLSL but not run, and MAKE
// (a struct literal) is refused with the node's line. A shader owns its
// tree: shader_free gives it back.

import std.heap
import std.list
import std.lanes
import std.quote
import std.string
import std.strbuilder
import ae3d.shaderlib (Texture, ShaderImage, image_w, image_h, image_channel)

exports (
    GpuShader, GpuVal, GpuRun,
    VULKAN, GL,
    fragment, depth_fragment, writes_depth, shader_free, shader_name, shader_tree, shader_hash,
    emit_glsl, emit_screen_vertex,
    params_count, params_name, params_type, params_offset, params_size, params_write,
    set_float, set_int, set_vec2,
    call_glsl, call_args,
    samplers_count, samplers_name,
    v1, v2, v3, v4, val_n, val_x, val_y, val_z, val_w, val_bool,
    cpu_new, cpu_run, cpu_free, cpu_set_viewport, last_error
)

// A shader: its name and the tree its quote made, which it owns, and
// whether what it returns is the pixel's depth (a float, to gl_FragDepth)
// rather than its colour (a vec4, to FragColor).
struct GpuShader {
    name: string
    tree: quote.Tree
    depth: bool
}

var g_error = ""

// Why the last emit or run failed.
last_error() -> string { return g_error }

// The fragment shader `name`, of the quote's tree.
fragment(name: string, t: quote.Tree) -> *GpuShader {
    s = heap.new(GpuShader)
    s.name = name
    s.tree = t
    s.depth = false
    return s
}

// The fragment shader `name` whose quote returns the pixel's depth, a float
// written to gl_FragDepth; it has no colour output (FRAGMENT_DEPTH_COPY).
depth_fragment(name: string, t: quote.Tree) -> *GpuShader {
    s = fragment(name, t)
    s.depth = true
    return s
}

writes_depth(s: *GpuShader) -> bool { return s.depth }

shader_name(s: *GpuShader) -> string { return s.name }
shader_tree(s: *GpuShader) -> quote.Tree { return s.tree }
// The tree's hash (quote.hash): the same for the same shader in every
// build, what its generated SPIR-V is checked against.
shader_hash(s: *GpuShader) -> long { return quote.hash(s.tree) }

// The shader and its tree. Its name is its own copy, as a struct's string
// field is, and goes with it.
shader_free(s: *GpuShader) {
    if s == null { return }
    quote.free(s.tree)
    s.name = ""
    heap.free(s)
}

// ── Types ──────────────────────────────────────────────────────────────

// A tree's type as GLSL spells it; "" for one GLSL has no word for. A
// vector's component is an f32 to Aether and a float to GLSL; a Texture is
// a sampler.
fn glsl_type(t: string) -> string {
    if t == "float" || t == "f32" { return "float" }
    if t == "int" || t == "bool" || t == "vec2" || t == "vec3" || t == "vec4" { return t }
    if t == "Texture" { return "sampler2D" }
    return ""
}

fn is_texture(t: string) -> bool { return t == "Texture" }

// std140: a scalar four bytes on four, a vec2 eight on eight, a vec3
// twelve on sixteen, a vec4 sixteen on sixteen.
fn std140_align(t: string) -> int {
    if t == "vec2" { return 8 }
    if t == "vec3" || t == "vec4" { return 16 }
    return 4
}
fn std140_size(t: string) -> int {
    if t == "vec2" { return 8 }
    if t == "vec3" { return 12 }
    if t == "vec4" { return 16 }
    return 4
}

// A name GLSL keeps for itself, given a trailing underscore where a
// shader uses it: a local called `sample` or `input` is Aether's to use.
fn glsl_name(n: string) -> string {
    if n == "sample" || n == "input" || n == "output" || n == "filter" || n == "common" || n == "partition" ||
        n == "active" || n == "smooth" || n == "flat" || n == "noperspective" || n == "patch" ||
        n == "uniform" || n == "buffer" || n == "shared" || n == "precise" || n == "invariant" ||
        n == "attribute" || n == "varying" || n == "layout" || n == "centroid" || n == "texture" ||
        n == "FragColor" || n == "main" || n == "discard" || n == "half" || n == "fixed" || n == "unsigned" ||
        n == "lowp" || n == "mediump" || n == "highp" || n == "precision" || n == "subroutine" ||
        n == "goto" || n == "inline" || n == "noinline" || n == "public" || n == "static" || n == "extern" ||
        n == "external" || n == "interface" || n == "long" || n == "short" || n == "double" || n == "cast" ||
        n == "namespace" || n == "using" || n == "union" || n == "enum" || n == "typedef" || n == "template" ||
        n == "this" || n == "resource" || n == "asm" || n == "class" || n == "volatile" || n == "coherent" ||
        n == "restrict" || n == "readonly" || n == "writeonly" || n == "in" || n == "out" || n == "inout" {
        return "${n}_"
    }
    if string.starts_with(n, "gl_") == 1 { return "${n}_" }
    return n
}

// ── Calls: the one table ─────────────────────────────────────────────
//
// Every function a quoted shader may call: its name in Aether (an
// ae3d.shaderlib export), what GLSL writes for it, and how many arguments it
// takes. GLSL is written from here and nowhere else, and a call not here is
// refused by both back ends rather than written as a GLSL call that does not
// exist. The CPU runs each by its Aether name (cpu_call), so a wrong GLSL
// entry shows as the CPU and the GPU disagreeing (tests/test_gpu_fxaa,
// test_backend_parity). One entry a name: Aether overloads nothing here, and
// where it does a second name maps to the same GLSL (Nic's option A).
//
// A GLSL form is a function's name (an identifier), called with the
// arguments as they are, or else a template, where $0, $1 ... are the arguments: rgb(c) is "$0.rgb"
// (Aether has no field of three lanes), texel_fetch(t, p) is
// "texelFetch($0, ivec2($1), 0)", frag_coord() is "gl_FragCoord.xy".
// Arguments -1: a vector constructor, from lanes and vectors (checked by
// the CPU, counting lanes).
const CALL_AETHER[] = ["vec2", "vec3", "vec4", "texture", "rgb", "dot", "min", "max", "abs", "sign", "clamp",
                       "smoothstep", "mix", "fract", "floor", "frag_coord", "texel_fetch"]
const CALL_GLSL[] = ["vec2", "vec3", "vec4", "texture", "$0.rgb", "dot", "min", "max", "abs", "sign", "clamp",
                     "smoothstep", "mix", "fract", "floor", "gl_FragCoord.xy", "texelFetch($0, ivec2($1), 0)"]
const CALL_ARGS: int[] = [-1, -1, -1, 2, 1, 2, 2, 2, 1, 1, 3, 3, 3, 1, 1, 0, 2]
const CALL_COUNT = 17

fn call_index(name: string) -> int {
    i = 0
    while i < CALL_COUNT {
        if CALL_AETHER[i] == name { return i }
        i = i + 1
    }
    return -1
}

// What GLSL writes for the function `name` ("" when a shader cannot call
// it): a function's name, or a template ("$0.rgb").
call_glsl(name: string) -> string {
    i = call_index(name)
    if i < 0 { return "" }
    return CALL_GLSL[i]
}

// How many arguments `name` takes; -1 for a vector constructor (any), -2
// for a name not in the table.
call_args(name: string) -> int {
    i = call_index(name)
    if i < 0 { return -2 }
    return CALL_ARGS[i]
}

// Why the call `n` cannot be written or run: "" when the table has it with
// that many arguments.
fn call_refused(n: quote.Node) -> string {
    name = bare_call(quote.name(n))
    want = call_args(name)
    if want == -2 { return "${quote.name(n)}() is not a function a shader can call: not an ae3d.shaderlib function in ae3d.gpu's call table, nor @quotable" }
    got = quote.child_count(n)
    if want >= 0 && got != want { return "${name}() takes ${want} arguments in a shader, not ${got}" }
    return ""
}

// Whether a table form is a function's name (letters, digits, `_`) rather
// than a template ("$0.rgb", "gl_FragCoord.xy").
fn is_identifier(g: string) -> bool {
    i = 0
    while i < string.length(g) {
        c = string.char_at(g, i)
        letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
        digit = c >= 48 && c <= 57
        if !letter && !(digit && i > 0) { return false }
        i = i + 1
    }
    return string.length(g) > 0
}

// A call written from its table template: each $k the k-th argument,
// parenthesised as a postfix operand would be (a swizzle binds tightest).
fn glsl_template(t: quote.Tree, n: quote.Node, g: string) -> string {
    sb = strbuilder.new(32)
    i = 0
    len = string.length(g)
    while i < len {
        ch = string.char_at(g, i)
        if ch == 36 && i + 1 < len {
            d = string.char_at(g, i + 1) - 48
            strbuilder.append(sb, glsl_expr(t, quote.child(n, d), PREC_POSTFIX, 0))
            i = i + 2
        } else {
            strbuilder.append(sb, string.substring(g, i, i + 1))
            i = i + 1
        }
    }
    return strbuilder.finish(sb)
}

// A called function's name without its module ("shaderlib.dot" is dot).
fn bare_call(n: string) -> string {
    at = string.length(n) - 1
    while at >= 0 && string.char_at(n, at) != 46 { at = at - 1 }
    if at < 0 { return n }
    return string.substring(n, at + 1, string.length(n))
}

// ── The uniform block ──────────────────────────────────────────────────
//
// The captures that are not textures, in the tree's order (the order the
// body first reads them), at their std140 offsets. The renderer fills a
// buffer of params_size() with params_write each frame; the generator
// holds these offsets to the ones glslang reports.

params_count(s: *GpuShader) -> int {
    n = 0
    i = 0
    while i < quote.capture_count(s.tree) {
        if !is_texture(quote.capture_type(quote.capture(s.tree, i))) { n = n + 1 }
        i = i + 1
    }
    return n
}

// The k-th of them, as a Capture.
fn param_capture(s: *GpuShader, k: int) -> quote.Capture {
    n = 0
    i = 0
    while i < quote.capture_count(s.tree) {
        c = quote.capture(s.tree, i)
        if !is_texture(quote.capture_type(c)) {
            if n == k { return c }
            n = n + 1
        }
        i = i + 1
    }
    return null as quote.Capture
}

params_name(s: *GpuShader, k: int) -> string { return glsl_name(quote.capture_name(param_capture(s, k))) }
params_type(s: *GpuShader, k: int) -> string { return glsl_type(quote.capture_type(param_capture(s, k))) }

fn round_up(v: int, to: int) -> int { return (v + to - 1) / to * to }

params_offset(s: *GpuShader, k: int) -> int {
    at = 0
    j = 0
    while j <= k {
        t = quote.capture_type(param_capture(s, j))
        at = round_up(at, std140_align(t))
        if j < k { at = at + std140_size(t) }
        j = j + 1
    }
    return at
}

// The block's size, rounded up to sixteen as a buffer of it is; 0 when the
// shader has no uniforms.
params_size(s: *GpuShader) -> int {
    n = params_count(s)
    if n == 0 { return 0 }
    last = quote.capture_type(param_capture(s, n - 1))
    return round_up(params_offset(s, n - 1) + std140_size(last), 16)
}

// Each uniform's current value, read through its capture's cell, written
// at its offset in `dst` (params_size bytes) as the GPU reads it: floats as
// f32, ints and bools as 32-bit ints, vectors as their lanes.
params_write(s: *GpuShader, dst: ptr) {
    n = params_count(s)
    k = 0
    while k < n {
        c = param_capture(s, k)
        t = quote.capture_type(c)
        at = params_offset(s, k)
        if t == "float" {
            ((dst + at) as f32[])[0] = quote.get_float(c) as f32
        } else if t == "f32" {
            ((dst + at) as f32[])[0] = quote.get_f32(c)
        } else if t == "int" {
            ((dst + at) as int[])[0] = quote.get_int(c)
        } else if t == "bool" {
            b = 0
            if quote.get_bool(c) { b = 1 }
            ((dst + at) as int[])[0] = b
        } else {
            v = quote.get_f32x4(c)
            p = (dst + at) as f32[]
            p[0] = v.x
            p[1] = v.y
            if t == "vec3" || t == "vec4" { p[2] = v.z }
            if t == "vec4" { p[3] = v.w }
        }
        k = k + 1
    }
}

// A capture's value changed from outside the quote, through its cell (the
// variable it captured): the next params_write and cpu_run read it. One
// shader drawn several times a frame with other values (the bloom's levels)
// sets them before each draw. False when the shader has no capture `name` of
// that type.
set_float(s: *GpuShader, name: string, v: float) -> bool {
    cell = typed_cell(s, name, "float")
    if cell == null { return false }
    (cell as float[])[0] = v
    return true
}

set_int(s: *GpuShader, name: string, v: int) -> bool {
    cell = typed_cell(s, name, "int")
    if cell == null { return false }
    (cell as int[])[0] = v
    return true
}

set_vec2(s: *GpuShader, name: string, x: float, y: float) -> bool {
    cell = typed_cell(s, name, "vec2")
    if cell == null { return false }
    lanes4 = cell as f32[]
    lanes4[0] = x as f32
    lanes4[1] = y as f32
    return true
}

fn typed_cell(s: *GpuShader, name: string, t: string) -> ptr {
    i = 0
    while i < quote.capture_count(s.tree) {
        c = quote.capture(s.tree, i)
        if quote.capture_name(c) == name {
            if quote.capture_type(c) != t { return null }
            return quote.cell(c)
        }
        i = i + 1
    }
    return null
}

// The textures, in order: the samplers at bindings 1, 2, ... (0 when the
// shader has no uniform block).
samplers_count(s: *GpuShader) -> int {
    n = 0
    i = 0
    while i < quote.capture_count(s.tree) {
        if is_texture(quote.capture_type(quote.capture(s.tree, i))) { n = n + 1 }
        i = i + 1
    }
    return n
}
samplers_name(s: *GpuShader, k: int) -> string {
    n = 0
    i = 0
    while i < quote.capture_count(s.tree) {
        c = quote.capture(s.tree, i)
        if is_texture(quote.capture_type(c)) {
            if n == k { return glsl_name(quote.capture_name(c)) }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

// ── GLSL ───────────────────────────────────────────────────────────────

// How tightly an operator binds, as GLSL has it (higher binds tighter).
fn prec(op: string) -> int {
    if op == "||" { return 1 }
    if op == "^^" { return 2 }
    if op == "&&" { return 3 }
    if op == "|" { return 4 }
    if op == "^" { return 5 }
    if op == "&" { return 6 }
    if op == "==" || op == "!=" { return 7 }
    if op == "<" || op == "<=" || op == ">" || op == ">=" { return 8 }
    if op == "<<" || op == ">>" { return 9 }
    if op == "+" || op == "-" { return 10 }
    return 11
}
const PREC_UNARY = 12
const PREC_POSTFIX = 13

// Where a node is first refused, for last_error.
fn refuse(t: quote.Tree, n: quote.Node, what: string) {
    if g_error == "" { g_error = "${quote.source(t)}: line ${quote.line(n)}: ${what}" }
}

// An expression, parenthesised only where the operator around it binds
// tighter than its own (`outer`), or as tightly on the right (`right`).
fn glsl_expr(t: quote.Tree, n: quote.Node, outer: int, right: int) -> string {
    k = quote.kind(n)
    if k == quote.LIT { return quote.lit(n) }
    if k == quote.LOCAL || k == quote.CAPTURE { return glsl_name(quote.name(n)) }
    if k == quote.FIELD {
        return "${glsl_expr(t, quote.child(n, 0), PREC_POSTFIX, 0)}.${quote.name(n)}"
    }
    if k == quote.INDEX {
        return "${glsl_expr(t, quote.child(n, 0), PREC_POSTFIX, 0)}[${glsl_expr(t, quote.child(n, 1), 0, 0)}]"
    }
    if k == quote.CALL {
        why = call_refused(n)
        if why != "" {
            refuse(t, n, why)
            return ""
        }
        g = call_glsl(bare_call(quote.name(n)))
        if !is_identifier(g) { return glsl_template(t, n, g) }
        sb = strbuilder.new(32)
        strbuilder.append(sb, g)
        strbuilder.append(sb, "(")
        j = 0
        while j < quote.child_count(n) {
            if j > 0 { strbuilder.append(sb, ", ") }
            strbuilder.append(sb, glsl_expr(t, quote.child(n, j), 0, 0))
            j = j + 1
        }
        strbuilder.append(sb, ")")
        return strbuilder.finish(sb)
    }
    if k == quote.HELPER_CALL {
        // A @quotable function: written out above main by emit_helpers.
        sb = strbuilder.new(32)
        strbuilder.append(sb, glsl_name(quote.name(n)))
        strbuilder.append(sb, "(")
        j = 0
        while j < quote.child_count(n) {
            if j > 0 { strbuilder.append(sb, ", ") }
            strbuilder.append(sb, glsl_expr(t, quote.child(n, j), 0, 0))
            j = j + 1
        }
        strbuilder.append(sb, ")")
        return strbuilder.finish(sb)
    }
    if k == quote.UNARY {
        return "${quote.op(n)}${glsl_expr(t, quote.child(n, 0), PREC_UNARY, 0)}"
    }
    if k == quote.CHOOSE {
        e = "${glsl_expr(t, quote.child(n, 0), 1, 0)} ? ${glsl_expr(t, quote.child(n, 1), 1, 0)} : ${glsl_expr(t, quote.child(n, 2), 1, 0)}"
        if outer > 0 { return "(${e})" }
        return e
    }
    if k == quote.BINARY {
        p = prec(quote.op(n))
        e = "${glsl_expr(t, quote.child(n, 0), p, 0)} ${quote.op(n)} ${glsl_expr(t, quote.child(n, 1), p, 1)}"
        if p < outer || (p == outer && right == 1) { return "(${e})" }
        return e
    }
    refuse(t, n, "a ${quote.kind_name(k)} is not written as GLSL")
    return "0"
}

fn indent(sb: ptr, depth: int) {
    d = 0
    while d < depth {
        strbuilder.append(sb, "    ")
        d = d + 1
    }
}

// A block's statements at `depth`; `top` is main's own block, where a
// return that is its last statement needs no `return;` after it.
fn glsl_block(t: quote.Tree, sb: ptr, blk: quote.Node, depth: int, top: bool) {
    n = quote.child_count(blk)
    j = 0
    while j < n {
        glsl_stmt(t, sb, quote.child(blk, j), depth, top && j == n - 1)
        j = j + 1
    }
}

// A statement where a for loop's header has one: no indent, no `;`.
fn glsl_clause(t: quote.Tree, s: quote.Node) -> string {
    k = quote.kind(s)
    if k == quote.LET {
        ty = glsl_type(quote.type_of(s))
        if ty == "" { refuse(t, s, "a local of type ${quote.type_of(s)} has no GLSL type") }
        return "${ty} ${glsl_name(quote.name(s))} = ${glsl_expr(t, quote.child(s, 0), 0, 0)}"
    }
    if k == quote.ASSIGN {
        return "${glsl_expr(t, quote.child(s, 0), 0, 0)} ${quote.op(s)} ${glsl_expr(t, quote.child(s, 1), 0, 0)}"
    }
    if k == quote.EXPR { return glsl_expr(t, quote.child(s, 0), 0, 0) }
    refuse(t, s, "a ${quote.kind_name(k)} is not a clause")
    return ""
}

fn glsl_if(t: quote.Tree, sb: ptr, s: quote.Node, depth: int) {
    strbuilder.append(sb, "if (${glsl_expr(t, quote.child(s, 0), 0, 0)}) {\n")
    glsl_block(t, sb, quote.child(s, 1), depth + 1, false)
    indent(sb, depth)
    if quote.child_count(s) > 2 {
        e = quote.child(s, 2)
        if quote.kind(e) == quote.IF {
            strbuilder.append(sb, "} else ")
            glsl_if(t, sb, e, depth)
            return
        }
        strbuilder.append(sb, "} else {\n")
        glsl_block(t, sb, e, depth + 1, false)
        indent(sb, depth)
    }
    strbuilder.append(sb, "}\n")
}

fn glsl_stmt(t: quote.Tree, sb: ptr, s: quote.Node, depth: int, last: bool) {
    indent(sb, depth)
    k = quote.kind(s)
    if k == quote.LET || k == quote.ASSIGN || k == quote.EXPR {
        strbuilder.append(sb, "${glsl_clause(t, s)};\n")
    } else if k == quote.RETURN {
        if quote.child_count(s) == 0 {
            refuse(t, s, "a fragment shader returns its colour")
            return
        }
        if g_in_helper {
            strbuilder.append(sb, "return ${glsl_expr(t, quote.child(s, 0), 0, 0)};\n")
            return
        }
        if g_depth {
            rt = quote.type_of(quote.child(s, 0))
            if rt != "float" && rt != "f32" {
                refuse(t, s, "a depth fragment shader returns the depth, a float, not a ${rt}")
                return
            }
            strbuilder.append(sb, "gl_FragDepth = ${glsl_expr(t, quote.child(s, 0), 0, 0)};\n")
        } else {
            strbuilder.append(sb, "FragColor = ${glsl_expr(t, quote.child(s, 0), 0, 0)};\n")
        }
        if !last {
            indent(sb, depth)
            strbuilder.append(sb, "return;\n")
        }
    } else if k == quote.IF {
        glsl_if(t, sb, s, depth)
    } else if k == quote.WHILE {
        strbuilder.append(sb, "while (${glsl_expr(t, quote.child(s, 0), 0, 0)}) {\n")
        glsl_block(t, sb, quote.child(s, 1), depth + 1, false)
        indent(sb, depth)
        strbuilder.append(sb, "}\n")
    } else if k == quote.FOR {
        h = "for (${glsl_clause(t, quote.child(s, 0))}; ${glsl_expr(t, quote.child(s, 1), 0, 0)}; ${glsl_clause(t, quote.child(s, 2))})"
        strbuilder.append(sb, "${h} {\n")
        glsl_block(t, sb, quote.child(s, 3), depth + 1, false)
        indent(sb, depth)
        strbuilder.append(sb, "}\n")
    } else if k == quote.BREAK {
        strbuilder.append(sb, "break;\n")
    } else if k == quote.CONTINUE {
        strbuilder.append(sb, "continue;\n")
    } else if k == quote.BLOCK {
        strbuilder.append(sb, "{\n")
        glsl_block(t, sb, s, depth + 1, false)
        indent(sb, depth)
        strbuilder.append(sb, "}\n")
    } else {
        refuse(t, s, "a ${quote.kind_name(k)} is not written as GLSL")
    }
}

// Writing a @quotable function's body: a return is the function's, not
// FragColor.
var g_in_helper = false
// Whether the shader being written returns its depth (depth_fragment).
var g_depth = false

// The @quotable functions the tree reaches (quote version 2), each a GLSL
// function, callees first as the tree lists them, so each is declared
// before its use. The same text for both dialects. Errors name the shader's
// quote, which is where the call that reached the helper is.
fn emit_helpers(t: quote.Tree, sb: ptr) {
    i = 0
    while i < quote.helper_count(t) {
        h = quote.helper(t, i)
        ret = glsl_type(quote.return_type(h))
        if ret == "" { refuse(t, quote.body(h), "${quote.function_name(h)} returns a ${quote.return_type(h)}, which GLSL has no type for") }
        strbuilder.append(sb, "\n${ret} ${glsl_name(quote.function_name(h))}(")
        k = 0
        while k < quote.param_count(h) {
            if k > 0 { strbuilder.append(sb, ", ") }
            pt = glsl_type(quote.param_type(h, k))
            if pt == "" { refuse(t, quote.body(h), "${quote.function_name(h)}'s ${quote.param_name(h, k)} is a ${quote.param_type(h, k)}, which GLSL has no type for") }
            strbuilder.append(sb, "${pt} ${glsl_name(quote.param_name(h, k))}")
            k = k + 1
        }
        strbuilder.append(sb, ") {\n")
        g_in_helper = true
        glsl_block(t, sb, quote.body(h), 1, false)
        g_in_helper = false
        strbuilder.append(sb, "}\n")
        i = i + 1
    }
}

// What every emit checks first: one parameter, a type GLSL has for each
// capture, the version of the tree this reads.
fn emit_ready(s: *GpuShader) -> bool {
    g_error = ""
    t = s.tree
    if quote.version(t) < 1 || quote.version(t) > 2 {
        g_error = "${quote.source(t)}: a tree of version ${quote.version(t)}; ae3d.gpu reads versions 1 and 2"
        return false
    }
    if quote.param_count(t) != 1 || glsl_type(quote.param_type(t, 0)) == "" {
        g_error = "${quote.source(t)}: a fragment shader takes one parameter, its varying"
        return false
    }
    i = 0
    while i < quote.capture_count(t) {
        c = quote.capture(t, i)
        if glsl_type(quote.capture_type(c)) == "" {
            g_error = "${quote.source(t)}: ${quote.capture_name(c)} is a ${quote.capture_type(c)}, which a shader cannot read"
            return false
        }
        i = i + 1
    }
    return true
}

// The two GLSL dialects a tree is written in. VULKAN: #version 450, the
// uniforms in a std140 block at set 0, binding 0, each texture a sampler
// at the next binding, the varyings by location. GL: desktop OpenGL 4.1
// (#version 410 core, what macOS has), with no set or binding qualifiers:
// each uniform and each sampler by its name, set by name (a sampler to the
// unit of its place among the textures), the varyings by name.
const VULKAN = 0
const GL = 1

// The fragment shader's GLSL in `dialect`: the uniforms, the textures,
// the parameter as its input, and FragColor. "" when the tree has
// something GLSL is not written for (last_error says what and where).
emit_glsl(s: *GpuShader, dialect: int) -> string {
    if !emit_ready(s) { return "" }
    t = s.tree
    sb = strbuilder.new(4096)
    if dialect == GL {
        strbuilder.append(sb, "#version 410 core\n")
    } else {
        strbuilder.append(sb, "#version 450\n")
    }
    strbuilder.append(sb, "// ${s.name}: written by ae3d.gpu from its quote.\n\n")
    binding = 0
    np = params_count(s)
    if np > 0 && dialect == GL {
        k = 0
        while k < np {
            strbuilder.append(sb, "uniform ${params_type(s, k)} ${params_name(s, k)};\n")
            k = k + 1
        }
    } else if np > 0 {
        strbuilder.append(sb, "layout(std140, set = 0, binding = 0) uniform Params {\n")
        k = 0
        while k < np {
            strbuilder.append(sb, "    ${params_type(s, k)} ${params_name(s, k)};\n")
            k = k + 1
        }
        strbuilder.append(sb, "};\n")
        binding = 1
    }
    k = 0
    while k < samplers_count(s) {
        if dialect == GL {
            strbuilder.append(sb, "uniform sampler2D ${samplers_name(s, k)};\n")
        } else {
            strbuilder.append(sb, "layout(set = 0, binding = ${binding}) uniform sampler2D ${samplers_name(s, k)};\n")
        }
        binding = binding + 1
        k = k + 1
    }
    input = "${glsl_type(quote.param_type(t, 0))} ${glsl_name(quote.param_name(t, 0))}"
    emit_helpers(t, sb)
    // A depth shader has no colour output: what it returns is gl_FragDepth.
    colour = "out vec4 FragColor;\n"
    if dialect != GL { colour = "layout(location = 0) ${colour}" }
    if s.depth { colour = "" }
    if dialect == GL {
        strbuilder.append(sb, "\nin ${input};\n${colour}\nvoid main() {\n")
    } else {
        strbuilder.append(sb, "\nlayout(location = 0) in ${input};\n${colour}\nvoid main() {\n")
    }
    g_depth = s.depth
    glsl_block(t, sb, quote.body(t), 1, true)
    g_depth = false
    strbuilder.append(sb, "}\n")
    text = strbuilder.finish(sb)
    if g_error != "" { return "" }
    return text
}

// The vertex shader a full-screen pass draws the shader with, in
// `dialect`: the screen quad's position and texture coordinate at
// locations 0 and 1 (Vulkan's quad is the scene's vertex input, a vec3
// position; OpenGL's screen quad has a vec2), the coordinate handed on as
// the fragment's parameter.
emit_screen_vertex(s: *GpuShader, dialect: int) -> string {
    if !emit_ready(s) { return "" }
    t = s.tree
    if glsl_type(quote.param_type(t, 0)) != "vec2" {
        g_error = "${quote.source(t)}: a full-screen pass hands its shader a vec2"
        return ""
    }
    name = glsl_name(quote.param_name(t, 0))
    sb = strbuilder.new(512)
    if dialect == GL {
        strbuilder.append(sb, "#version 410 core\n// ${s.name}'s full-screen pass: written by ae3d.gpu.\n\n")
        strbuilder.append(sb, "layout(location = 0) in vec2 inPosition;\nlayout(location = 1) in vec2 inTexCoord;\n\n")
        strbuilder.append(sb, "out vec2 ${name};\n\nvoid main() {\n")
        strbuilder.append(sb, "    ${name} = inTexCoord;\n    gl_Position = vec4(inPosition, 0.0, 1.0);\n}\n")
        return strbuilder.finish(sb)
    }
    strbuilder.append(sb, "#version 450\n// ${s.name}'s full-screen pass: written by ae3d.gpu.\n\n")
    strbuilder.append(sb, "layout(location = 0) in vec3 inPosition;\nlayout(location = 1) in vec2 inTexCoord;\n\n")
    strbuilder.append(sb, "layout(location = 0) out vec2 ${name};\n\nvoid main() {\n")
    strbuilder.append(sb, "    ${name} = inTexCoord;\n    gl_Position = vec4(inPosition.xy, 0.0, 1.0);\n}\n")
    return strbuilder.finish(sb)
}

// ── The CPU back end ───────────────────────────────────────────────────
//
// Its own lane-wise builtins in doubles, not ae3d.shaderlib's: a CALL
// names a function as text, and Aether has no call by name, so running the
// library's would mean a table from each name to a closure of one
// signature, one entry per overload GLSL has and Aether does not (vec4 of
// a vec3 and a float, of a float, of two vec2s, ...): as much code as the
// lanes below, and with f32's ops where this works between roundings in
// doubles.

// A value: n lanes of a float, vec2, vec3 or vec4 (n 1 to 4), or a bool
// (n 0, in x).
struct GpuVal {
    n: int
    x: float
    y: float
    z: float
    w: float
}

v1(x: float) -> *GpuVal { return mkval(1, x, 0.0, 0.0, 0.0) }
v2(x: float, y: float) -> *GpuVal { return mkval(2, x, y, 0.0, 0.0) }
v3(x: float, y: float, z: float) -> *GpuVal { return mkval(3, x, y, z, 0.0) }
v4(x: float, y: float, z: float, w: float) -> *GpuVal { return mkval(4, x, y, z, w) }
val_n(v: *GpuVal) -> int { return v.n }
val_x(v: *GpuVal) -> float { return v.x }
val_y(v: *GpuVal) -> float { return v.y }
val_z(v: *GpuVal) -> float { return v.z }
val_w(v: *GpuVal) -> float { return v.w }
val_bool(v: *GpuVal) -> bool { return v.x != 0.0 }

fn mkval(n: int, x: float, y: float, z: float, w: float) -> *GpuVal {
    v = heap.new(GpuVal)
    v.n = n
    v.x = f32r(x)
    v.y = f32r(y)
    v.z = f32r(z)
    v.w = f32r(w)
    return v
}

// A GLSL float is 32 bits: every value a run makes is rounded to one, as
// the GPU holds it. Against the GPU's FXAA (tests/test_gpu_fxaa.ae) more
// pixels come out to the bit, 6127 of 6144 on Apple's Vulkan for 6122 in
// doubles; the arithmetic between roundings is still in doubles, where a
// GPU may fuse a multiply and an add.
fn f32r(x: float) -> float { return (x as f32) as float }

fn lane(v: *GpuVal, k: int) -> float {
    if v.n == 1 { return v.x }   // a scalar splats
    if k == 0 { return v.x }
    if k == 1 { return v.y }
    if k == 2 { return v.z }
    return v.w
}

fn set_lane(v: *GpuVal, k: int, x: float) {
    r = f32r(x)
    if k == 0 { v.x = r } else if k == 1 { v.y = r } else if k == 2 { v.z = r } else { v.w = r }
}

fn floori(v: float) -> int {
    t = v as int
    if v < 0.0 && t * 1.0 != v { return t - 1 }
    return t
}

fn clampi(v: int, lo: int, hi: int) -> int {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

struct GpuBinding {
    name: string
    val: *GpuVal
    img: ptr         // a texture's *shaderlib.ShaderImage
}

// A run of a shader: the captures' values as the run began, the locals as
// it goes, and every value it makes (freed after each pixel).
struct GpuRun {
    s: *GpuShader
    caps: ptr        // list of *GpuBinding
    locals: ptr      // list of *GpuBinding
    arena: ptr       // list of *GpuVal made during a run
    flow: int        // 0 on, 1 returned, 2 a break, 3 a continue
    out: *GpuVal
    failed: int
    param: *GpuVal   // this run's parameter, the pixel's uv
    view_w: int      // the target's size frag_coord() is a pixel of; 0 unset
    view_h: int
}

const FLOW_ON = 0
const FLOW_RETURN = 1
const FLOW_BREAK = 2
const FLOW_CONTINUE = 3

// A run of `s`, its captures read from their cells at each cpu_run.
cpu_new(s: *GpuShader) -> *GpuRun {
    cx = heap.new(GpuRun)
    cx.s = s
    cx.caps = list.new()
    cx.locals = list.new()
    cx.arena = list.new()
    cx.flow = FLOW_ON
    cx.out = null
    cx.failed = 0
    cx.param = null
    cx.view_w = 0
    cx.view_h = 0
    return cx
}

// The size of the target the CPU draws into, `w` by `h` pixels: what
// frag_coord() reads its pixel against (the parameter, at that pixel's
// centre, times the size). A shader that calls frag_coord() fails to run
// without it.
cpu_set_viewport(cx: *GpuRun, w: int, h: int) {
    cx.view_w = w
    cx.view_h = h
}

fn bind(lst: ptr, name: string, v: *GpuVal, img: @keep ptr) {
    bd = heap.new(GpuBinding)
    bd.name = name
    bd.val = v
    bd.img = img
    list.add_raw(lst, bd as ptr)
}

// A binding alone, its name with it (kept as its own copy).
fn binding_free(bd: *GpuBinding) {
    bd.name = ""
    heap.free(bd)
}

fn find(lst: ptr, name: string) -> *GpuBinding {
    k = list.size(lst) - 1
    while k >= 0 {
        bd = list.get_raw(lst, k) as *GpuBinding
        if bd.name == name { return bd }
        k = k - 1
    }
    return null
}

fn keep(cx: *GpuRun, v: *GpuVal) -> *GpuVal {
    list.add_raw(cx.arena, v as ptr)
    return v
}

fn fail(cx: *GpuRun, n: quote.Node, what: string) -> *GpuVal {
    if cx.failed == 0 { g_error = "${quote.source(cx.s.tree)}: line ${quote.line(n)}: ${what}" }
    cx.failed = 1
    return keep(cx, v1(0.0))
}

// Every capture's value now, through its cell, into the run's bindings.
fn read_captures(cx: *GpuRun) {
    t = cx.s.tree
    i = 0
    while i < quote.capture_count(t) {
        c = quote.capture(t, i)
        ty = quote.capture_type(c)
        name = quote.capture_name(c)
        if ty == "Texture" {
            tex = quote.cell(c) as *Texture
            bind(cx.caps, name, null, tex.image)
        } else if ty == "float" {
            bind(cx.caps, name, keep(cx, v1(quote.get_float(c))), null)
        } else if ty == "f32" {
            bind(cx.caps, name, keep(cx, v1(quote.get_f32(c) as float)), null)
        } else if ty == "int" {
            bind(cx.caps, name, keep(cx, v1(quote.get_int(c) * 1.0)), null)
        } else if ty == "bool" {
            on = 0.0
            if quote.get_bool(c) { on = 1.0 }
            bind(cx.caps, name, keep(cx, mkval(0, on, 0.0, 0.0, 0.0)), null)
        } else {
            n = 4
            if ty == "vec2" { n = 2 }
            if ty == "vec3" { n = 3 }
            v = quote.get_f32x4(c)
            bind(cx.caps, name, keep(cx, mkval(n, v.x as float, v.y as float, v.z as float, v.w as float)), null)
        }
        i = i + 1
    }
}

// Run the shader for one value of its parameter: the colour it returns, a
// fresh value the caller frees (heap.free), or null when it could not run
// (last_error says why).
cpu_run(cx: *GpuRun, param: *GpuVal) -> *GpuVal {
    g_error = ""
    cx.flow = FLOW_ON
    cx.out = null
    cx.failed = 0
    t = cx.s.tree
    read_captures(cx)
    cx.param = param
    bind(cx.locals, quote.param_name(t, 0), param, null)
    cpu_block(cx, quote.body(t))
    ok = cx.out != null && cx.failed == 0
    rn = 0
    rx = 0.0
    ry = 0.0
    rz = 0.0
    rw = 0.0
    if ok {
        rn = cx.out.n
        rx = cx.out.x
        ry = cx.out.y
        rz = cx.out.z
        rw = cx.out.w
    } else if cx.failed == 0 {
        g_error = "${quote.source(t)}: the shader ended without returning a colour"
    }
    // Everything this run made goes, the bindings with it.
    k = 0
    while k < list.size(cx.locals) {
        binding_free(list.get_raw(cx.locals, k) as *GpuBinding)
        k = k + 1
    }
    list.clear(cx.locals)
    k = 0
    while k < list.size(cx.caps) {
        binding_free(list.get_raw(cx.caps, k) as *GpuBinding)
        k = k + 1
    }
    list.clear(cx.caps)
    k = 0
    while k < list.size(cx.arena) {
        heap.free(list.get_raw(cx.arena, k))
        k = k + 1
    }
    list.clear(cx.arena)
    if !ok { return null }
    return mkval(rn, rx, ry, rz, rw)
}

cpu_free(cx: *GpuRun) {
    list.free(cx.caps)
    list.free(cx.locals)
    list.free(cx.arena)
    heap.free(cx)
}

fn cpu_block(cx: *GpuRun, blk: quote.Node) {
    mark = list.size(cx.locals)
    j = 0
    while j < quote.child_count(blk) && cx.flow == FLOW_ON && cx.failed == 0 {
        cpu_stmt(cx, quote.child(blk, j))
        j = j + 1
    }
    // The block's own locals go out of scope.
    while list.size(cx.locals) > mark {
        last = list.size(cx.locals) - 1
        binding_free(list.get_raw(cx.locals, last) as *GpuBinding)
        list.remove(cx.locals, last)
    }
}

fn truth(v: *GpuVal) -> bool { return v.x != 0.0 }

// A loop's body run once: false when the loop is to stop (a break, a
// return, a failure), a continue cleared.
fn loop_body(cx: *GpuRun, body: quote.Node) -> bool {
    cpu_block(cx, body)
    if cx.flow == FLOW_BREAK {
        cx.flow = FLOW_ON
        return false
    }
    if cx.flow == FLOW_CONTINUE { cx.flow = FLOW_ON }
    return cx.flow == FLOW_ON && cx.failed == 0
}

fn cpu_stmt(cx: *GpuRun, s: quote.Node) {
    k = quote.kind(s)
    if k == quote.LET {
        bind(cx.locals, quote.name(s), cpu_expr(cx, quote.child(s, 0)), null)
    } else if k == quote.ASSIGN {
        target = quote.child(s, 0)
        if quote.kind(target) != quote.LOCAL { _f = fail(cx, s, "an assignment to a ${quote.kind_name(quote.kind(target))}"); return }
        bd = find(cx.locals, quote.name(target))
        if bd == null { _f2 = fail(cx, s, "an assignment to ${quote.name(target)}, which is not a local"); return }
        v = cpu_expr(cx, quote.child(s, 1))
        op = quote.op(s)
        if op != "=" {
            v = cpu_binary(cx, s, string.substring(op, 0, string.length(op) - 1), quote.type_of(target), bd.val, v)
        }
        bd.val = v
    } else if k == quote.EXPR {
        _e = cpu_expr(cx, quote.child(s, 0))
    } else if k == quote.RETURN {
        if quote.child_count(s) == 0 { _f3 = fail(cx, s, "a fragment shader returns its colour"); return }
        cx.out = cpu_expr(cx, quote.child(s, 0))
        cx.flow = FLOW_RETURN
    } else if k == quote.IF {
        if truth(cpu_expr(cx, quote.child(s, 0))) {
            cpu_block(cx, quote.child(s, 1))
        } else if quote.child_count(s) > 2 {
            e = quote.child(s, 2)
            if quote.kind(e) == quote.IF { cpu_stmt(cx, e) } else { cpu_block(cx, e) }
        }
    } else if k == quote.WHILE {
        going = true
        while going && cx.failed == 0 && truth(cpu_expr(cx, quote.child(s, 0))) {
            going = loop_body(cx, quote.child(s, 1))
        }
    } else if k == quote.FOR {
        // The header's local is the loop's: it goes when the loop does.
        mark = list.size(cx.locals)
        cpu_stmt(cx, quote.child(s, 0))
        going = true
        while going && cx.failed == 0 && truth(cpu_expr(cx, quote.child(s, 1))) {
            going = loop_body(cx, quote.child(s, 3))
            if going { cpu_stmt(cx, quote.child(s, 2)) }
        }
        while list.size(cx.locals) > mark {
            last = list.size(cx.locals) - 1
            binding_free(list.get_raw(cx.locals, last) as *GpuBinding)
            list.remove(cx.locals, last)
        }
    } else if k == quote.BREAK {
        cx.flow = FLOW_BREAK
    } else if k == quote.CONTINUE {
        cx.flow = FLOW_CONTINUE
    } else if k == quote.BLOCK {
        cpu_block(cx, s)
    } else {
        _f4 = fail(cx, s, "a ${quote.kind_name(k)} is not run on the CPU")
    }
}

fn cpu_lit(cx: *GpuRun, n: quote.Node) -> *GpuVal {
    ty = quote.type_of(n)
    text = quote.lit(n)
    if ty == "bool" {
        on = 0.0
        if text == "true" { on = 1.0 }
        return keep(cx, mkval(0, on, 0.0, 0.0, 0.0))
    }
    if ty == "float" || ty == "f32" || ty == "int" {
        v, err = string.to_float(text)
        if err != "" { return fail(cx, n, "the literal ${text} is not a number") }
        return keep(cx, v1(v))
    }
    return fail(cx, n, "a ${ty} literal is not run on the CPU")
}

fn cpu_expr(cx: *GpuRun, n: quote.Node) -> *GpuVal {
    k = quote.kind(n)
    if k == quote.LIT { return cpu_lit(cx, n) }
    if k == quote.LOCAL {
        bd = find(cx.locals, quote.name(n))
        if bd == null { return fail(cx, n, "no local ${quote.name(n)}") }
        return bd.val
    }
    if k == quote.CAPTURE {
        bd = find(cx.caps, quote.name(n))
        if bd == null || bd.val == null { return fail(cx, n, "no value for the capture ${quote.name(n)}") }
        return bd.val
    }
    if k == quote.FIELD { return cpu_field(cx, n, cpu_expr(cx, quote.child(n, 0)), quote.name(n)) }
    if k == quote.CHOOSE {
        if truth(cpu_expr(cx, quote.child(n, 0))) { return cpu_expr(cx, quote.child(n, 1)) }
        return cpu_expr(cx, quote.child(n, 2))
    }
    if k == quote.UNARY {
        a = cpu_expr(cx, quote.child(n, 0))
        if quote.op(n) == "!" {
            if truth(a) { return keep(cx, mkval(0, 0.0, 0.0, 0.0, 0.0)) }
            return keep(cx, mkval(0, 1.0, 0.0, 0.0, 0.0))
        }
        if quote.op(n) != "-" { return fail(cx, n, "the operator ${quote.op(n)} is not run on the CPU") }
        return keep(cx, mkval(a.n, 0.0 - a.x, 0.0 - a.y, 0.0 - a.z, 0.0 - a.w))
    }
    if k == quote.BINARY {
        op = quote.op(n)
        // && and || take their right side only when it decides.
        if op == "&&" || op == "||" {
            a = truth(cpu_expr(cx, quote.child(n, 0)))
            on = a
            if op == "&&" && a { on = truth(cpu_expr(cx, quote.child(n, 1))) }
            if op == "||" && !a { on = truth(cpu_expr(cx, quote.child(n, 1))) }
            r = 0.0
            if on { r = 1.0 }
            return keep(cx, mkval(0, r, 0.0, 0.0, 0.0))
        }
        return cpu_binary(cx, n, op, quote.type_of(n), cpu_expr(cx, quote.child(n, 0)), cpu_expr(cx, quote.child(n, 1)))
    }
    if k == quote.CALL { return cpu_call(cx, n) }
    if k == quote.HELPER_CALL { return cpu_helper_call(cx, n) }
    return fail(cx, n, "a ${quote.kind_name(k)} is not run on the CPU")
}

// A component or a swizzle: x y z w, or r g b a.
// A @quotable function's call: its arguments in the caller's scope, then its
// body in a scope of its own parameters alone, its return the call's value.
// The helper is ordinary Aether too, so a shader's CPU-against-Aether check
// covers it as it covers the rest.
fn cpu_helper_call(cx: *GpuRun, n: quote.Node) -> *GpuVal {
    h = quote.helper_named(cx.s.tree, quote.name(n))
    if (h as ptr) == null { return fail(cx, n, "no helper ${quote.name(n)} in the tree") }
    if quote.param_count(h) != quote.child_count(n) { return fail(cx, n, "${quote.name(n)} takes ${quote.param_count(h)} arguments") }
    // A texture argument passes its image; any other its value.
    args = list.new()
    imgs = list.new()
    j = 0
    while j < quote.child_count(n) {
        a = quote.child(n, j)
        if is_texture(quote.param_type(h, j)) {
            img = texture_image(cx, a)
            if img == null { list.free(args); list.free(imgs); return fail(cx, n, "${quote.name(n)} is given a texture with no image") }
            list.add_raw(args, null)
            list.add_raw(imgs, img)
        } else {
            list.add_raw(args, cpu_expr(cx, a) as ptr)
            list.add_raw(imgs, null)
        }
        j = j + 1
    }
    saved_locals = cx.locals
    saved_out = cx.out
    cx.locals = list.new()
    j = 0
    while j < quote.param_count(h) {
        bind(cx.locals, quote.param_name(h, j), list.get_raw(args, j) as *GpuVal, list.get_raw(imgs, j))
        j = j + 1
    }
    list.free(args)
    list.free(imgs)
    cx.out = null
    cpu_block(cx, quote.body(h))
    result = cx.out
    while list.size(cx.locals) > 0 {
        last = list.size(cx.locals) - 1
        binding_free(list.get_raw(cx.locals, last) as *GpuBinding)
        list.remove(cx.locals, last)
    }
    list.free(cx.locals)
    cx.locals = saved_locals
    cx.out = saved_out
    if cx.failed != 0 { return keep(cx, v1(0.0)) }
    if cx.flow != FLOW_RETURN || result == null { return fail(cx, n, "${quote.name(n)} ended without a return") }
    cx.flow = FLOW_ON
    return result
}

fn cpu_field(cx: *GpuRun, n: quote.Node, v: *GpuVal, name: string) -> *GpuVal {
    m = string.length(name)
    if m < 1 || m > 4 { return fail(cx, n, "no field .${name}") }
    out = keep(cx, mkval(m, 0.0, 0.0, 0.0, 0.0))
    j = 0
    while j < m {
        ch = string.char_at(name, j)
        at = 0 - 1
        if ch == 120 || ch == 114 { at = 0 }    // x r
        if ch == 121 || ch == 103 { at = 1 }    // y g
        if ch == 122 || ch == 98 { at = 2 }     // z b
        if ch == 119 || ch == 97 { at = 3 }     // w a
        if at < 0 || at >= v.n { return fail(cx, n, "no field .${name} on a value of ${v.n} lanes") }
        set_lane(out, j, lane(v, at))
        j = j + 1
    }
    return out
}

// a op c, of type `ty`: lane-wise, a scalar splatting; a comparison of
// scalars (GLSL's are; a vector's are calls). An int's division and
// remainder are whole.
fn cpu_binary(cx: *GpuRun, n: quote.Node, op: string, ty: string, a: *GpuVal, c: *GpuVal) -> *GpuVal {
    p = prec(op)
    if p == 7 || p == 8 {
        on = false
        if op == "<" { on = a.x < c.x }
        if op == "<=" { on = a.x <= c.x }
        if op == ">" { on = a.x > c.x }
        if op == ">=" { on = a.x >= c.x }
        if op == "==" { on = a.x == c.x }
        if op == "!=" { on = a.x != c.x }
        r = 0.0
        if on { r = 1.0 }
        return keep(cx, mkval(0, r, 0.0, 0.0, 0.0))
    }
    if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" {
        return fail(cx, n, "the operator ${op} is not run on the CPU")
    }
    whole = ty == "int"
    m = a.n
    if c.n > m { m = c.n }
    out = keep(cx, mkval(m, 0.0, 0.0, 0.0, 0.0))
    j = 0
    while j < m {
        x = lane(a, j)
        y = lane(c, j)
        r = 0.0
        if op == "+" { r = x + y }
        if op == "-" { r = x - y }
        if op == "*" { r = x * y }
        if op == "/" {
            r = x / y
            if whole { r = (r as int) * 1.0 }
        }
        if op == "%" { r = x - ((x / y) as int) * y }
        set_lane(out, j, r)
        j = j + 1
    }
    return out
}

fn minf(a: float, c: float) -> float {
    if a < c { return a }
    return c
}
fn maxf(a: float, c: float) -> float {
    if a > c { return a }
    return c
}

// The fraction of a texel a GPU's sampler weighs its neighbours by, in
// bits. Vulkan asks for four at least (subTexelPrecisionBits); Apple's GPUs
// and lavapipe have eight. A coordinate a rounding off a texel's centre --
// uv plus an f32 texel -- reads that texel alone there, where in doubles it
// takes a millionth of the next: enough, on a pixel whose contrast sits on
// FXAA's threshold, to land on the other side of it (one pixel of a frame
// on an Apple GPU, five steps of 255 out).
const SUBTEXEL = 256.0

// texture(img, uv): bilinear, texel centres at (i + 0.5) / size, the
// weights to the sampler's precision, clamped at the edges, as a linear
// sampler with clamp-to-edge reads.
fn sample(cx: *GpuRun, img: *ShaderImage, u: float, v: float) -> *GpuVal {
    w = image_w(img)
    h = image_h(img)
    fx = floori((u * w - 0.5) * SUBTEXEL + 0.5) / SUBTEXEL
    fy = floori((v * h - 0.5) * SUBTEXEL + 0.5) / SUBTEXEL
    x0 = floori(fx)
    y0 = floori(fy)
    tx = fx - x0
    ty = fy - y0
    xa = clampi(x0, 0, w - 1)
    xb = clampi(x0 + 1, 0, w - 1)
    ya = clampi(y0, 0, h - 1)
    yb = clampi(y0 + 1, 0, h - 1)
    out = keep(cx, mkval(4, 0.0, 0.0, 0.0, 0.0))
    ch = 0
    while ch < 4 {
        top = image_channel(img, xa, ya, ch) * (1.0 - tx) + image_channel(img, xb, ya, ch) * tx
        bottom = image_channel(img, xa, yb, ch) * (1.0 - tx) + image_channel(img, xb, yb, ch) * tx
        set_lane(out, ch, top * (1.0 - ty) + bottom * ty)
        ch = ch + 1
    }
    return out
}

// A builtin of one, two or three values, lane by lane; null for a name
// that is not one.
fn cpu_lanes(cx: *GpuRun, n: quote.Node, fname: string, a: *GpuVal, c: *GpuVal, d: *GpuVal) -> *GpuVal {
    m = a.n
    if c != null && c.n > m { m = c.n }
    if d != null && d.n > m { m = d.n }
    out = keep(cx, mkval(m, 0.0, 0.0, 0.0, 0.0))
    j = 0
    while j < m {
        x = lane(a, j)
        y = 0.0
        if c != null { y = lane(c, j) }
        z = 0.0
        if d != null { z = lane(d, j) }
        r = 0.0
        if fname == "min" {
            r = minf(x, y)
        } else if fname == "max" {
            r = maxf(x, y)
        } else if fname == "abs" {
            r = x
            if x < 0.0 { r = 0.0 - x }
        } else if fname == "sign" {
            if x > 0.0 { r = 1.0 } else if x < 0.0 { r = 0.0 - 1.0 }
        } else if fname == "clamp" {
            r = minf(maxf(x, y), z)
        } else if fname == "smoothstep" {
            // smoothstep(edge0 = x, edge1 = y, value = z)
            t = minf(maxf((z - x) / (y - x), 0.0), 1.0)
            r = t * t * (3.0 - 2.0 * t)
        } else if fname == "mix" {
            r = x * (1.0 - z) + y * z
        } else if fname == "fract" {
            r = x - floori(x) * 1.0
        } else if fname == "floor" {
            r = floori(x) * 1.0
        } else {
            return fail(cx, n, "${fname}() is not run on the CPU")
        }
        set_lane(out, j, r)
        j = j + 1
    }
    return out
}

// The image a texture expression names: a captured texture, or a helper's
// parameter a texture was passed in as; null when it names neither.
fn texture_image(cx: *GpuRun, tex: quote.Node) -> ptr {
    k = quote.kind(tex)
    if k == quote.CAPTURE {
        cb = find(cx.caps, quote.name(tex))
        if cb == null { return null }
        return cb.img
    }
    if k == quote.LOCAL {
        lb = find(cx.locals, quote.name(tex))
        if lb == null { return null }
        return lb.img
    }
    return null
}

// A coordinate as ivec2() takes it, truncated toward zero, then clamped to
// an image's `size` (texelFetch outside it is undefined; this reads the edge).
fn clamp_index(v: float, size: int) -> int {
    i = v as int
    if i < 0 { return 0 }
    if i > size - 1 { return size - 1 }
    return i
}

fn cpu_call(cx: *GpuRun, n: quote.Node) -> *GpuVal {
    // The same calls the GLSL can be written with, and no others.
    why = call_refused(n)
    if why != "" { return fail(cx, n, why) }
    name = bare_call(quote.name(n))
    argc = quote.child_count(n)
    if name == "texture" && argc == 2 {
        tex = quote.child(n, 0)
        img = texture_image(cx, tex)
        if img == null {
            return fail(cx, n, "texture() of ${quote.name(tex)}, which has no image")
        }
        uv = cpu_expr(cx, quote.child(n, 1))
        return sample(cx, img as *ShaderImage, uv.x, uv.y)
    }
    if name == "rgb" && argc == 1 { return cpu_field(cx, n, cpu_expr(cx, quote.child(n, 0)), "rgb") }
    if name == "frag_coord" {
        if cx.view_w <= 0 || cx.view_h <= 0 { return fail(cx, n, "frag_coord() with no viewport (cpu_set_viewport)") }
        uv = cx.param
        return keep(cx, mkval(2, uv.x * cx.view_w, uv.y * cx.view_h, 0.0, 0.0))
    }
    if name == "texel_fetch" {
        tex = quote.child(n, 0)
        img = texture_image(cx, tex)
        if img == null { return fail(cx, n, "texel_fetch() of ${quote.name(tex)}, which has no image") }
        p = cpu_expr(cx, quote.child(n, 1))
        si = img as *ShaderImage
        x = clamp_index(p.x, image_w(si))
        y = clamp_index(p.y, image_h(si))
        return keep(cx, mkval(4, image_channel(si, x, y, 0), image_channel(si, x, y, 1), image_channel(si, x, y, 2),
                              image_channel(si, x, y, 3)))
    }
    // Constructors: from scalars and vectors in order, or one scalar
    // splatted.
    if name == "vec2" || name == "vec3" || name == "vec4" {
        want = 2
        if name == "vec3" { want = 3 }
        if name == "vec4" { want = 4 }
        out = keep(cx, mkval(want, 0.0, 0.0, 0.0, 0.0))
        if argc == 1 {
            a = cpu_expr(cx, quote.child(n, 0))
            if a.n == 1 {
                out.x = a.x
                out.y = a.x
                out.z = a.x
                out.w = a.x
                return out
            }
        }
        at = 0
        j = 0
        while j < argc && at < want {
            a = cpu_expr(cx, quote.child(n, j))
            q = 0
            while q < a.n && at < want {
                set_lane(out, at, lane(a, q))
                at = at + 1
                q = q + 1
            }
            j = j + 1
        }
        if at < want { return fail(cx, n, "${name}() given ${at} of its ${want} lanes") }
        return out
    }
    if name == "dot" && argc == 2 {
        a = cpu_expr(cx, quote.child(n, 0))
        c = cpu_expr(cx, quote.child(n, 1))
        s = 0.0
        j = 0
        while j < a.n {
            s = s + lane(a, j) * lane(c, j)
            j = j + 1
        }
        return keep(cx, v1(s))
    }
    if argc == 1 {
        return cpu_lanes(cx, n, name, cpu_expr(cx, quote.child(n, 0)), null, null)
    }
    if argc == 2 {
        return cpu_lanes(cx, n, name, cpu_expr(cx, quote.child(n, 0)), cpu_expr(cx, quote.child(n, 1)), null)
    }
    if argc == 3 {
        return cpu_lanes(cx, n, name, cpu_expr(cx, quote.child(n, 0)), cpu_expr(cx, quote.child(n, 1)),
                         cpu_expr(cx, quote.child(n, 2)))
    }
    return fail(cx, n, "${name}() is not run on the CPU")
}
