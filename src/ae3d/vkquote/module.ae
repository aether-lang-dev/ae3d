// ae3d.vkquote -- a full-screen pass the Vulkan backend draws with a shader
// written with `quote` (ae3d.gpu): FXAA, the frame's last pass.
//
// Such a shader brings its own uniforms, its captures, so it does not read
// the scene block every other pass shares. Its descriptor set is its own: a
// uniform buffer of its Params block at binding 0 (ae3d.gpu's std140
// layout, the one ae3d.vkspirv's generator held to glslang's) and its
// textures at bindings 1, 2, ... in the order the shader names them
// (gpu.samplers_name); a shader with no uniforms (the depth copy) has no
// block, and its textures start at binding 0. A depth shader
// (gpu.writes_depth) is drawn depth-tested and depth-written, into a pass
// with no colour; set_image_layout names the layout its images are read in
// (a depth image's, for the depth copy). A pass is drawn up to `draws` times a frame (FXAA
// once; the bloom's down pass once a level, its values changed between), so
// each frame slot has that many buffers and sets, a buffer each so every
// block is at offset 0 and no device's uniform-offset alignment matters.
// Before a draw, prepare() copies every capture's current value out of its
// cell into that draw's buffer (gpu.params_write) and names the image to
// sample, both only once the slot's fence has passed, as the frame's other
// sets. A draw past the ring is refused, never wrapped onto a set the GPU
// may still be reading.
//
// The words come from ae3d.vkspirv, made from a tree of the hash given. A
// shader whose tree hashes otherwise ends the program (fresh): its uniforms
// would be laid out for one shader and read by another, and the build that
// made it -- a quoted shader edited and the generator not rebuilt and rerun
// -- is the mistake, not the device. It used to be refused with one line and
// the pass left out of the frame, so a negative control on a quoted shader,
// or a real bug, rendered the frame without it and could pass unseen. There
// is no fallback: the trees and the words are compiled into the same
// program, so a released one can only differ by being built from a tree
// that was never regenerated.
//
// A pair (pair_new, step 6) is a vertex shader written with quote as well
// as its pixel shader, linked by their varyings' names (gpu.link): the sky,
// drawn over its cube in the scene pass, depth-tested and not written, into
// both of the pass's attachments (its colour and its motion vector). The
// vertex shader's captures are a block of their own, VertexParams, at set
// 1, binding 0, a buffer and a set per draw of each frame slot as the pixel
// shader's are, filled by the same prepare().
//
// A mesh pair (mesh_pair_new) is a pair drawn over a model's mesh as the
// scene's pipelines draw it, the water's surface: opaque (depth-tested and
// written, back faces kept or culled) or blended over the frame (not
// writing depth), the three pipelines on the pair's layout (mesh_pipeline).
//
// A vertex ring (vertex_ring_new) is a vertex shader written with quote
// drawn with a hand-written pixel shader over the scene's sets: the crowd's,
// until the scene's own shader moves. Its layout is the scene's three sets
// (the draw's, the camera's, the world's), then, for a shader reading
// storage buffers (the cluster cut's), the pulled set vkpipes makes, then
// its own: its block at binding 0, a dynamic uniform
// buffer -- each draw's values at their own offset in its frame slot's ring
// of `draws` blocks, filled by ring_bind as the scene's ring is -- and its
// textures at the bindings after it. A set is named, per frame slot, for
// each set of images a frame draws it with (RING_SETS at most), once that
// slot's fence has passed; a draw past the ring, or past the sets, is
// refused and said once.

import contrib.vulkan.vk
import ae3d.vkhost
import ae3d.vkhost (HostBuffer)
import ae3d.vkdesc
import ae3d.vkdevice
import ae3d.vkpipes
import ae3d.gpu
import ae3d.gpu (GpuShader)
import std.io

exports (
    QuotedPass, pass_new, pair_new, mesh_pair_new, mesh_pipeline, pass_free, set_shader, shader, vertex_shader, vertex_set, prepare, pipeline, layout,
    textures, set_image_layout, fresh,
    VertexRing, vertex_ring_new, ring_pipeline, ring_frame, ring_bind, ring_shader, ring_layout, vertex_ring_free
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern exit(code: int)

struct QuotedPass {
    shader: ptr           // *gpu.GpuShader, the pass's
    hash: long
    set_layout: ptr
    layout: ptr           // VkPipelineLayout
    pipeline: ptr
    pool: ptr
    sets: ptr             // VkDescriptorSet[FRAMES * draws], a slot's together
    blocks: ptr           // *HostBuffer[FRAMES * draws]
    size: int             // the Params block's bytes
    draws: int            // draws a frame slot has a set and a block for
    textures: int         // the textures it samples, at bindings base..
    base: int             // the first texture's binding: 1 after the block, 0 with none
    image_layout: int     // the layout its images are read in
    overrun: bool         // a draw past the ring has been reported
    vshader: ptr          // a pair's: *gpu.GpuShader, its vertex shader; null for a screen pass
    vhash: long
    vset_layout: ptr      // set 1: the vertex shader's block
    vpool: ptr
    vsets: ptr            // VkDescriptorSet[FRAMES * draws]
    vblocks: ptr          // *HostBuffer[FRAMES * draws]
    vsize: int            // the VertexParams block's bytes
    culled: ptr           // a mesh pair's: opaque with back faces culled; null otherwise
    blended: ptr          // a mesh pair's: alpha-blended, depth-tested and not written
}

// The pass of `s` (which it then owns) drawn into `render_pass` up to
// `draws` times a frame, with the vertex and fragment words `vert` and
// `frag` of ae3d.vkspirv made from a tree hashing to `hash` (a tree hashing
// otherwise ends the program: fresh). Null, `s` freed, when the shader
// samples no texture, or the device would not make what it needs.
pass_new(s: *GpuShader, vert: int, frag: int, hash: long, render_pass: @keep ptr, draws: int) -> *QuotedPass {
    fresh(s, hash)
    if gpu.samplers_count(s) < 1 {
        io.stderr_write("ae3d: ${gpu.shader_name(s)}: a quoted pass samples a texture\n")
        gpu.shader_free(s)
        return null
    }
    p = calloc(1, sizeof(QuotedPass)) as *QuotedPass
    p.shader = s as ptr
    p.hash = hash
    p.size = gpu.params_size(s)
    p.textures = gpu.samplers_count(s)
    p.base = 0
    if p.size > 0 { p.base = 1 }
    p.image_layout = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    p.draws = draws
    if p.draws < 1 { p.draws = 1 }
    p.sets = calloc(vkdesc.FRAMES * p.draws, 8)
    p.blocks = calloc(vkdesc.FRAMES * p.draws, 8)
    if !make_layouts(p) || !make_sets(p) {
        pass_free(p)
        return null
    }
    if !make_pipeline(p, vert, frag, render_pass, gpu.writes_depth(s), gpu.writes_depth(s)) {
        pass_free(p)
        return null
    }
    return p
}

// The sky's pair: the vertex shader `vs` and the pixel shader `ps` (which it
// then owns, both), linked by their varyings, drawn into `render_pass` up to
// `draws` times a frame, depth-tested against what is there and not
// writing it. `vert` and `frag` are ae3d.vkspirv's words, made from trees
// hashing to `vhash` and `phash` (either hashing otherwise ends the
// program: fresh). Null, both freed, when they do not link, the vertex
// shader has no block or the pixel shader samples nothing, or the device
// would not make what it needs.
pair_new(vs: *GpuShader, ps: *GpuShader, vert: int, frag: int, vhash: long, phash: long, render_pass: @keep ptr,
         draws: int) -> *QuotedPass {
    fresh(vs, vhash)
    fresh(ps, phash)
    why = ""
    if !gpu.link(vs, ps) { why = gpu.last_error() }
    if why == "" && (gpu.params_size(vs) < 1 || gpu.samplers_count(ps) < 1) {
        why = "${gpu.shader_name(ps)}: a quoted pair's vertex shader has captures and its pixel shader samples a texture"
    }
    if why != "" {
        io.stderr_write("ae3d: ${why}\n")
        gpu.shader_free(vs)
        gpu.shader_free(ps)
        return null
    }
    p = calloc(1, sizeof(QuotedPass)) as *QuotedPass
    p.shader = ps as ptr
    p.hash = phash
    p.vshader = vs as ptr
    p.vhash = vhash
    p.size = gpu.params_size(ps)
    p.vsize = gpu.params_size(vs)
    p.textures = gpu.samplers_count(ps)
    p.base = 0
    if p.size > 0 { p.base = 1 }
    p.image_layout = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    p.draws = draws
    if p.draws < 1 { p.draws = 1 }
    p.sets = calloc(vkdesc.FRAMES * p.draws, 8)
    p.blocks = calloc(vkdesc.FRAMES * p.draws, 8)
    p.vsets = calloc(vkdesc.FRAMES * p.draws, 8)
    p.vblocks = calloc(vkdesc.FRAMES * p.draws, 8)
    if !make_layouts(p) || !make_sets(p) || !make_vertex_sets(p) || !make_pipeline(p, vert, frag, render_pass, true, false) {
        pass_free(p)
        return null
    }
    return p
}

// A model's surface drawn by the pair `vs` and `ps` (which it then owns,
// both), linked by their varyings, into `render_pass` up to `draws` times a
// frame, as the scene's pipelines draw a mesh: opaque, its back faces kept
// (pipeline) or culled, or blended (mesh_pipeline). `vert` and `frag` are
// ae3d.vkspirv's words, made from trees hashing to `vhash` and `phash`. Null,
// both freed, as pair_new.
mesh_pair_new(vs: *GpuShader, ps: *GpuShader, vert: int, frag: int, vhash: long, phash: long, render_pass: @keep ptr,
              draws: int) -> *QuotedPass {
    p = pair_new(vs, ps, vert, frag, vhash, phash, render_pass, draws)
    if p == null { return null }
    // pair_new's is the sky's (depth-tested, not written): the opaque
    // surface's in its place, and the culled and blended ones beside it.
    vk.vkDestroyPipeline(vkhost.device(), p.pipeline, null)
    p.pipeline = null
    v = vkpipes.shader(vert)
    f = vkpipes.shader(frag)
    if v != null && f != null {
        p.pipeline = vkpipes.build_on(v, f, 0, true, true, render_pass, false, false, false, p.layout, false)
        p.culled = vkpipes.build_on(v, f, 0, true, true, render_pass, true, false, false, p.layout, false)
        p.blended = vkpipes.build_on(v, f, 1, true, false, render_pass, false, false, false, p.layout, false)
    }
    if v != null { vk.vkDestroyShaderModule(vkhost.device(), v, null) }
    if f != null { vk.vkDestroyShaderModule(vkhost.device(), f, null) }
    if p.pipeline == null || p.culled == null || p.blended == null {
        pass_free(p)
        return null
    }
    return p
}

// A mesh pair's pipeline: blended over the frame, or opaque with its back
// faces culled or kept.
mesh_pipeline(p: *QuotedPass, blended: bool, culled: bool) -> ptr {
    if blended { return p.blended }
    if culled { return p.culled }
    return p.pipeline
}

// The pipeline over the words `vert` and `frag`, on the pass's layout, into
// `render_pass`, depth-tested and depth-written as asked.
make_pipeline(p: *QuotedPass, vert: int, frag: int, render_pass: @keep ptr, depth_test: bool, depth_write: bool) -> bool {
    v = vkpipes.shader(vert)
    f = vkpipes.shader(frag)
    if v != null && f != null {
        p.pipeline = vkpipes.build_on(v, f, 0, depth_test, depth_write, render_pass, false, false, false, p.layout, false)
    }
    if v != null { vk.vkDestroyShaderModule(vkhost.device(), v, null) }
    if f != null { vk.vkDestroyShaderModule(vkhost.device(), f, null) }
    return p.pipeline != null
}

// The set layout (the block at 0, the textures at 1.., all read by the
// fragment stage) and the pipeline layout over it.
make_layouts(p: *QuotedPass) -> bool {
    d = vkhost.device()
    bindings = calloc(p.base + p.textures, sizeof(VkDescriptorSetLayoutBinding))
    if p.base == 1 {
        b0 = bindings as *VkDescriptorSetLayoutBinding
        b0.binding = 0
        b0.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
        b0.descriptorCount = 1
        b0.stageFlags = vk.SHADER_STAGE_FRAGMENT_BIT
    }
    t = p.base
    while t < p.base + p.textures {
        bt = (bindings + t * sizeof(VkDescriptorSetLayoutBinding)) as *VkDescriptorSetLayoutBinding
        bt.binding = t
        bt.descriptorType = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        bt.descriptorCount = 1
        bt.stageFlags = vk.SHADER_STAGE_FRAGMENT_BIT
        t = t + 1
    }
    info = calloc(1, sizeof(VkDescriptorSetLayoutCreateInfo)) as *VkDescriptorSetLayoutCreateInfo
    info.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO
    info.bindingCount = p.base + p.textures
    info.pBindings = bindings
    cell = calloc(1, 8)
    r = vk.vkCreateDescriptorSetLayout(d, info as ptr, null, cell)
    p.set_layout = (cell as ptr[])[0]
    free(info as ptr)
    free(bindings)
    if r != vk.SUCCESS {
        p.set_layout = null
        free(cell)
        return false
    }
    free(cell)
    // A pair's vertex block, read by the vertex stage, at set 1.
    sets = 1
    if p.vshader != null {
        vb = calloc(1, sizeof(VkDescriptorSetLayoutBinding)) as *VkDescriptorSetLayoutBinding
        vb.binding = 0
        vb.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
        vb.descriptorCount = 1
        vb.stageFlags = vk.SHADER_STAGE_VERTEX_BIT
        vinfo = calloc(1, sizeof(VkDescriptorSetLayoutCreateInfo)) as *VkDescriptorSetLayoutCreateInfo
        vinfo.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO
        vinfo.bindingCount = 1
        vinfo.pBindings = vb as ptr
        vcell = calloc(1, 8)
        vr = vk.vkCreateDescriptorSetLayout(d, vinfo as ptr, null, vcell)
        p.vset_layout = (vcell as ptr[])[0]
        free(vcell)
        free(vinfo as ptr)
        free(vb as ptr)
        if vr != vk.SUCCESS {
            p.vset_layout = null
            return false
        }
        sets = 2
    }
    cell = calloc(sets, 8)
    (cell as ptr[])[0] = p.set_layout
    if sets == 2 { (cell as ptr[])[1] = p.vset_layout }
    pl = calloc(1, sizeof(VkPipelineLayoutCreateInfo)) as *VkPipelineLayoutCreateInfo
    pl.sType = vk.STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO
    pl.setLayoutCount = sets
    pl.pSetLayouts = cell
    out = calloc(1, 8)
    r = vk.vkCreatePipelineLayout(d, pl as ptr, null, out)
    p.layout = (out as ptr[])[0]
    free(out)
    free(pl as ptr)
    free(cell)
    if r != vk.SUCCESS {
        p.layout = null
        return false
    }
    return true
}

// A set and a mapped block per draw of each frame slot, each set naming its
// block at 0 for good; the images at 1.. are named before each draw.
make_sets(p: *QuotedPass) -> bool {
    d = vkhost.device()
    count = vkdesc.FRAMES * p.draws
    sizes = calloc(2, sizeof(VkDescriptorPoolSize))
    s0 = sizes as *VkDescriptorPoolSize
    s0.type = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
    s0.descriptorCount = count * p.textures
    s1 = (sizes + sizeof(VkDescriptorPoolSize)) as *VkDescriptorPoolSize
    s1.type = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
    s1.descriptorCount = count
    info = calloc(1, sizeof(VkDescriptorPoolCreateInfo)) as *VkDescriptorPoolCreateInfo
    info.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO
    info.maxSets = count
    // The uniform buffers' size only where there is a block to bind.
    info.poolSizeCount = 1 + p.base
    info.pPoolSizes = sizes
    cell = calloc(1, 8)
    r = vk.vkCreateDescriptorPool(d, info as ptr, null, cell)
    p.pool = (cell as ptr[])[0]
    free(info as ptr)
    free(sizes)
    if r != vk.SUCCESS {
        p.pool = null
        free(cell)
        return false
    }
    ok = true
    at = 0
    while at < count && ok {
        (cell as ptr[])[0] = p.set_layout
        alloc = calloc(1, sizeof(VkDescriptorSetAllocateInfo)) as *VkDescriptorSetAllocateInfo
        alloc.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
        alloc.descriptorPool = p.pool
        alloc.descriptorSetCount = 1
        alloc.pSetLayouts = cell
        out = calloc(1, 8)
        r = vk.vkAllocateDescriptorSets(d, alloc as ptr, out)
        set = (out as ptr[])[0]
        free(out)
        free(alloc as ptr)
        block = null as *HostBuffer
        if p.base == 1 { block = vkhost.mapped_buffer(p.size, vk.BUFFER_USAGE_UNIFORM_BUFFER_BIT) }
        if r != vk.SUCCESS || (p.base == 1 && block == null) {
            if block != null { vkhost.host_buffer_free(block) }
            ok = false
        } else if p.base == 0 {
            (p.sets as ptr[])[at] = set
        } else {
            (p.sets as ptr[])[at] = set
            (p.blocks as ptr[])[at] = block as ptr
            buffer = calloc(1, sizeof(VkDescriptorBufferInfo)) as *VkDescriptorBufferInfo
            buffer.buffer = block.buffer
            buffer.offset = 0
            buffer.range = p.size
            write = calloc(1, sizeof(VkWriteDescriptorSet)) as *VkWriteDescriptorSet
            write.sType = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
            write.dstSet = set
            write.dstBinding = 0
            write.descriptorCount = 1
            write.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
            write.pBufferInfo = buffer as ptr
            vk.vkUpdateDescriptorSets(d, 1, write as ptr, 0, null)
            free(write as ptr)
            free(buffer as ptr)
        }
        at = at + 1
    }
    free(cell)
    return ok
}

// A pair's vertex sets: a set and a mapped block per draw of each frame
// slot, each set naming its block at 0 for good.
make_vertex_sets(p: *QuotedPass) -> bool {
    d = vkhost.device()
    count = vkdesc.FRAMES * p.draws
    size = calloc(1, sizeof(VkDescriptorPoolSize)) as *VkDescriptorPoolSize
    size.type = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
    size.descriptorCount = count
    info = calloc(1, sizeof(VkDescriptorPoolCreateInfo)) as *VkDescriptorPoolCreateInfo
    info.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO
    info.maxSets = count
    info.poolSizeCount = 1
    info.pPoolSizes = size as ptr
    cell = calloc(1, 8)
    r = vk.vkCreateDescriptorPool(d, info as ptr, null, cell)
    p.vpool = (cell as ptr[])[0]
    free(info as ptr)
    free(size as ptr)
    if r != vk.SUCCESS {
        p.vpool = null
        free(cell)
        return false
    }
    ok = true
    at = 0
    while at < count && ok {
        (cell as ptr[])[0] = p.vset_layout
        alloc = calloc(1, sizeof(VkDescriptorSetAllocateInfo)) as *VkDescriptorSetAllocateInfo
        alloc.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
        alloc.descriptorPool = p.vpool
        alloc.descriptorSetCount = 1
        alloc.pSetLayouts = cell
        out = calloc(1, 8)
        r = vk.vkAllocateDescriptorSets(d, alloc as ptr, out)
        set = (out as ptr[])[0]
        free(out)
        free(alloc as ptr)
        block = vkhost.mapped_buffer(p.vsize, vk.BUFFER_USAGE_UNIFORM_BUFFER_BIT)
        if r != vk.SUCCESS || block == null {
            if block != null { vkhost.host_buffer_free(block) }
            ok = false
        } else {
            (p.vsets as ptr[])[at] = set
            (p.vblocks as ptr[])[at] = block as ptr
            buffer = calloc(1, sizeof(VkDescriptorBufferInfo)) as *VkDescriptorBufferInfo
            buffer.buffer = block.buffer
            buffer.offset = 0
            buffer.range = p.vsize
            write = calloc(1, sizeof(VkWriteDescriptorSet)) as *VkWriteDescriptorSet
            write.sType = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
            write.dstSet = set
            write.dstBinding = 0
            write.descriptorCount = 1
            write.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER
            write.pBufferInfo = buffer as ptr
            vk.vkUpdateDescriptorSets(d, 1, write as ptr, 0, null)
            free(write as ptr)
            free(buffer as ptr)
        }
        at = at + 1
    }
    free(cell)
    return ok
}

// The pass's shader now `s`, the one it had freed: the same shader with
// other values captured (FXAA's texel, at a new size). Another tree ends
// the program, as one hashing otherwise does at pass_new.
set_shader(p: *QuotedPass, s: *GpuShader) {
    fresh(s, p.hash)
    gpu.shader_free(p.shader as *GpuShader)
    p.shader = s as ptr
}

// Nothing when `s`'s tree hashes to `made_from`, the hash ae3d.vkspirv's
// words for it were made from. Otherwise the program ends, non-zero, naming
// the shader, both hashes and what regenerates the words: a pass drawn with
// SPIR-V made from another tree reads its uniforms at another shader's
// offsets, and one left out of the frame hides the change that was made.
fresh(s: *GpuShader, made_from: long) {
    got = gpu.shader_hash(s)
    if got == made_from { return }
    io.stderr_write("ae3d: quoted shader ${gpu.shader_name(s)} is stale: ae3d.vkspirv's SPIR-V for it was made from a tree hashing to ${made_from}, and its tree in this program hashes to ${got}\n")
    io.stderr_write("ae3d: regenerate it -- ./build.sh tools/generate_shaders.ae && ./build/generate_shaders (the generator compiles the trees in, so rebuild it first) -- then rebuild this program\n")
    exit(1)
}

shader(p: *QuotedPass) -> *GpuShader { return p.shader as *GpuShader }
// A pair's vertex shader, whose captures the caller sets before a draw.
vertex_shader(p: *QuotedPass) -> *GpuShader { return p.vshader as *GpuShader }

// A pair's set 1 for frame slot `slot`'s draw `draw`, its block filled by
// the prepare() of that draw; null for a screen pass or past the ring.
vertex_set(p: *QuotedPass, slot: int, draw: int) -> ptr {
    if p.vshader == null || draw < 0 || draw >= p.draws { return null }
    return (p.vsets as ptr[])[slot * p.draws + draw]
}
pipeline(p: *QuotedPass) -> ptr { return p.pipeline }
textures(p: *QuotedPass) -> int { return p.textures }

// The layout the pass's images are read in: SHADER_READ_ONLY_OPTIMAL, or a
// depth image's (DEPTH_STENCIL_READ_ONLY_OPTIMAL) for the depth copy.
set_image_layout(p: *QuotedPass, image_layout: int) { p.image_layout = image_layout }
layout(p: *QuotedPass) -> ptr { return p.layout }

// Frame slot `slot`'s set for its draw `draw` (0, 1, ... in the frame),
// ready for a draw sampling `views[i]` through `samplers[i]` (ptr arrays, one
// per texture the shader names, in its order): the captures' values now in
// its block, the images named at 1... Called once the slot's fence has
// passed. Null, said once, for a draw past the pass's ring.
prepare(p: *QuotedPass, slot: int, draw: int, views: ptr, samplers: ptr) -> ptr {
    if draw < 0 || draw >= p.draws {
        if !p.overrun {
            io.stderr_write("ae3d: ${gpu.shader_name(p.shader as *GpuShader)} drawn ${draw + 1} times in a frame; its pass has sets for ${p.draws}\n")
            p.overrun = true
        }
        return null
    }
    at = slot * p.draws + draw
    set = (p.sets as ptr[])[at]
    block = (p.blocks as ptr[])[at] as *HostBuffer
    if set == null || (p.base == 1 && block == null) || views == null || samplers == null { return null }
    // The count in a local, never below 0, so the allocations below are not
    // sized by a negative int widened (gcc's -Walloc-size-larger-than).
    n = p.textures
    if n < 0 { return null }
    t = 0
    while t < n {
        if (views as ptr[])[t] == null || (samplers as ptr[])[t] == null { return null }
        t = t + 1
    }
    if block != null { gpu.params_write(p.shader as *GpuShader, block.mapped) }
    if p.vshader != null {
        vblock = (p.vblocks as ptr[])[at] as *HostBuffer
        if vblock == null { return null }
        gpu.params_write(p.vshader as *GpuShader, vblock.mapped)
    }
    images = calloc(n, sizeof(VkDescriptorImageInfo))
    writes = calloc(n, sizeof(VkWriteDescriptorSet))
    t = 0
    while t < n {
        image = (images + t * sizeof(VkDescriptorImageInfo)) as *VkDescriptorImageInfo
        image.imageLayout = p.image_layout
        image.imageView = (views as ptr[])[t]
        image.sampler = (samplers as ptr[])[t]
        write = (writes + t * sizeof(VkWriteDescriptorSet)) as *VkWriteDescriptorSet
        write.sType = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
        write.dstSet = set
        write.dstBinding = p.base + t
        write.descriptorCount = 1
        write.descriptorType = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        write.pImageInfo = image as ptr
        t = t + 1
    }
    vk.vkUpdateDescriptorSets(vkhost.device(), n, writes, 0, null)
    free(writes)
    free(images)
    return set
}

// Everything the pass made, and its shader, gone; the device idle.
pass_free(p: *QuotedPass) {
    if p == null { return }
    d = vkhost.device()
    if p.pipeline != null { vk.vkDestroyPipeline(d, p.pipeline, null) }
    if p.culled != null { vk.vkDestroyPipeline(d, p.culled, null) }
    if p.blended != null { vk.vkDestroyPipeline(d, p.blended, null) }
    at = 0
    while at < vkdesc.FRAMES * p.draws {
        block = (p.blocks as ptr[])[at]
        if block != null { vkhost.host_buffer_free(block as *HostBuffer) }
        at = at + 1
    }
    if p.vblocks != null {
        at = 0
        while at < vkdesc.FRAMES * p.draws {
            vblock = (p.vblocks as ptr[])[at]
            if vblock != null { vkhost.host_buffer_free(vblock as *HostBuffer) }
            at = at + 1
        }
    }
    // The sets go with their pool.
    if p.pool != null { vk.vkDestroyDescriptorPool(d, p.pool, null) }
    if p.vpool != null { vk.vkDestroyDescriptorPool(d, p.vpool, null) }
    if p.layout != null { vk.vkDestroyPipelineLayout(d, p.layout, null) }
    if p.set_layout != null { vk.vkDestroyDescriptorSetLayout(d, p.set_layout, null) }
    if p.vset_layout != null { vk.vkDestroyDescriptorSetLayout(d, p.vset_layout, null) }
    free(p.sets)
    free(p.blocks)
    free(p.vsets)
    free(p.vblocks)
    gpu.shader_free(p.shader as *GpuShader)
    gpu.shader_free(p.vshader as *GpuShader)
    free(p as ptr)
}

// ── Vertex rings ────────────────────────────────────────────────────────

struct VertexRing {
    shader: ptr          // *gpu.GpuShader, the vertex shader's
    hash: long
    set_layout: ptr      // its own set's
    layout: ptr          // VkPipelineLayout: the scene's three sets, (the pulled set,) its own
    index: int           // its own set's place in the layout: after the scene's three, and after the pulled set
    pool: ptr
    rings: ptr           // *HostBuffer[FRAMES], `draws` blocks each
    sets: ptr            // VkDescriptorSet[FRAMES * RING_SETS]
    views: ptr           // ptr[FRAMES * RING_SETS * textures]: the images each set names now
    samplers: ptr
    named: ptr           // int[FRAMES]: the sets named in the slot's frame
    used: ptr            // int[FRAMES]: the draws in the slot's frame
    size: int            // its block's bytes
    stride: int          // a block's place in the ring: the size, to the device's offset alignment
    draws: int
    textures: int
    pipelines: ptr       // VkPipeline[RING_PIPELINES] built on its layout
    built: int
    overrun: bool
}

const RING_SETS = 16
const RING_PIPELINES = 8

// The ring of `vs` (which it then owns), its words made from a tree
// hashing to `vhash` (one hashing otherwise ends the program: fresh), up
// to `draws` draws a frame slot. Null, `vs` freed, when it has no block, or
// the device would not make what it needs.
vertex_ring_new(vs: *GpuShader, vhash: long, draws: int) -> *VertexRing {
    fresh(vs, vhash)
    why = ""
    if gpu.params_size(vs) < 1 { why = "${gpu.shader_name(vs)}: a vertex ring's shader has captures" }
    if why == "" && gpu.buffers_count(vs) > 0 && vkpipes.pull_set_layout() == null {
        why = "${gpu.shader_name(vs)}: no pulled set layout to read its buffers through"
    }
    if why != "" {
        io.stderr_write("ae3d: ${why}\n")
        gpu.shader_free(vs)
        return null
    }
    r = calloc(1, sizeof(VertexRing)) as *VertexRing
    r.shader = vs as ptr
    r.hash = vhash
    r.size = gpu.params_size(vs)
    align = vkdevice.uniform_alignment()
    if align < 16 { align = 16 }
    r.stride = (r.size + align - 1) / align * align
    r.draws = draws
    if r.draws < 1 { r.draws = 1 }
    r.textures = gpu.samplers_count(vs)
    r.index = gpu.vertex_set(vs)
    r.rings = calloc(vkdesc.FRAMES, 8)
    r.sets = calloc(vkdesc.FRAMES * RING_SETS, 8)
    n = r.textures
    if n < 1 { n = 1 }
    r.views = calloc(vkdesc.FRAMES * RING_SETS * n, 8)
    r.samplers = calloc(vkdesc.FRAMES * RING_SETS * n, 8)
    r.named = calloc(vkdesc.FRAMES, 4)
    r.used = calloc(vkdesc.FRAMES, 4)
    r.pipelines = calloc(RING_PIPELINES, 8)
    if !ring_layouts(r) || !ring_sets(r) {
        vertex_ring_free(r)
        return null
    }
    return r
}

// Its set layout -- the block at 0, the textures at 1.., read by the
// vertex stage -- and the pipeline layout over the scene's three sets (and
// the pulled one) and it.
ring_layouts(r: *VertexRing) -> bool {
    d = vkhost.device()
    count = 1 + r.textures
    bindings = calloc(count, sizeof(VkDescriptorSetLayoutBinding))
    k = 0
    while k < count {
        b = (bindings + k * sizeof(VkDescriptorSetLayoutBinding)) as *VkDescriptorSetLayoutBinding
        b.binding = k
        b.descriptorType = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        if k == 0 { b.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC }
        b.descriptorCount = 1
        b.stageFlags = vk.SHADER_STAGE_VERTEX_BIT
        k = k + 1
    }
    info = calloc(1, sizeof(VkDescriptorSetLayoutCreateInfo)) as *VkDescriptorSetLayoutCreateInfo
    info.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO
    info.bindingCount = count
    info.pBindings = bindings
    cell = calloc(1, 8)
    res = vk.vkCreateDescriptorSetLayout(d, info as ptr, null, cell)
    r.set_layout = (cell as ptr[])[0]
    free(cell)
    free(info as ptr)
    free(bindings)
    if res != vk.SUCCESS {
        r.set_layout = null
        return false
    }
    layouts = calloc(r.index + 1, 8)
    vkpipes.scene_layouts(layouts)
    if r.index == vkdesc.SCENE_SETS + 1 { (layouts as ptr[])[vkdesc.SCENE_SETS] = vkpipes.pull_set_layout() }
    (layouts as ptr[])[r.index] = r.set_layout
    pl = calloc(1, sizeof(VkPipelineLayoutCreateInfo)) as *VkPipelineLayoutCreateInfo
    pl.sType = vk.STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO
    pl.setLayoutCount = r.index + 1
    pl.pSetLayouts = layouts
    out = calloc(1, 8)
    res = vk.vkCreatePipelineLayout(d, pl as ptr, null, out)
    r.layout = (out as ptr[])[0]
    free(out)
    free(pl as ptr)
    free(layouts)
    if res != vk.SUCCESS {
        r.layout = null
        return false
    }
    return true
}

// Each frame slot's ring of blocks, and its sets, each naming the slot's
// ring at 0 for good (a draw's block at its dynamic offset).
ring_sets(r: *VertexRing) -> bool {
    d = vkhost.device()
    count = vkdesc.FRAMES * RING_SETS
    sizes = calloc(2, sizeof(VkDescriptorPoolSize))
    s0 = sizes as *VkDescriptorPoolSize
    s0.type = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC
    s0.descriptorCount = count
    s1 = (sizes + sizeof(VkDescriptorPoolSize)) as *VkDescriptorPoolSize
    s1.type = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
    s1.descriptorCount = count * r.textures
    info = calloc(1, sizeof(VkDescriptorPoolCreateInfo)) as *VkDescriptorPoolCreateInfo
    info.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO
    info.maxSets = count
    info.poolSizeCount = 1
    if r.textures > 0 { info.poolSizeCount = 2 }
    info.pPoolSizes = sizes
    cell = calloc(1, 8)
    res = vk.vkCreateDescriptorPool(d, info as ptr, null, cell)
    r.pool = (cell as ptr[])[0]
    free(info as ptr)
    free(sizes)
    if res != vk.SUCCESS {
        r.pool = null
        free(cell)
        return false
    }
    ok = true
    slot = 0
    while slot < vkdesc.FRAMES && ok {
        ring = vkhost.mapped_buffer(r.stride * r.draws, vk.BUFFER_USAGE_UNIFORM_BUFFER_BIT)
        if ring == null {
            ok = false
        } else {
            (r.rings as ptr[])[slot] = ring as ptr
            k = 0
            while k < RING_SETS && ok {
                (cell as ptr[])[0] = r.set_layout
                alloc = calloc(1, sizeof(VkDescriptorSetAllocateInfo)) as *VkDescriptorSetAllocateInfo
                alloc.sType = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
                alloc.descriptorPool = r.pool
                alloc.descriptorSetCount = 1
                alloc.pSetLayouts = cell
                out = calloc(1, 8)
                res = vk.vkAllocateDescriptorSets(d, alloc as ptr, out)
                set = (out as ptr[])[0]
                free(out)
                free(alloc as ptr)
                if res != vk.SUCCESS {
                    ok = false
                } else {
                    (r.sets as ptr[])[slot * RING_SETS + k] = set
                    buffer = calloc(1, sizeof(VkDescriptorBufferInfo)) as *VkDescriptorBufferInfo
                    buffer.buffer = ring.buffer
                    buffer.offset = 0
                    buffer.range = r.size
                    write = calloc(1, sizeof(VkWriteDescriptorSet)) as *VkWriteDescriptorSet
                    write.sType = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
                    write.dstSet = set
                    write.dstBinding = 0
                    write.descriptorCount = 1
                    write.descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC
                    write.pBufferInfo = buffer as ptr
                    vk.vkUpdateDescriptorSets(d, 1, write as ptr, 0, null)
                    free(write as ptr)
                    free(buffer as ptr)
                }
                k = k + 1
            }
        }
        slot = slot + 1
    }
    free(cell)
    return ok
}

// A pipeline over the ring's vertex shader (ae3d.vkspirv's words `vert`)
// and the pixel shader `frag`, on the ring's layout, as vkpipes.build_on
// makes one; kept with the ring, which destroys it. Null when it would not
// build.
ring_pipeline(r: *VertexRing, vert: int, frag: int, blend: int, depth_test: bool, depth_write: bool, pass: @keep ptr,
              cull: bool, is_skinned: bool, pulled: bool) -> ptr {
    if r == null || r.built >= RING_PIPELINES { return null }
    v = vkpipes.shader(vert)
    f = vkpipes.shader(frag)
    p = null
    if v != null && f != null {
        p = vkpipes.build_on(v, f, blend, depth_test, depth_write, pass, cull, is_skinned, false, r.layout, pulled)
    }
    if v != null { vk.vkDestroyShaderModule(vkhost.device(), v, null) }
    if f != null { vk.vkDestroyShaderModule(vkhost.device(), f, null) }
    if p != null {
        (r.pipelines as ptr[])[r.built] = p
        r.built = r.built + 1
    }
    return p
}

// Frame slot `slot`'s draws begin: its blocks and its sets free to be named
// again (its fence has passed).
ring_frame(r: *VertexRing, slot: int) {
    if r == null { return }
    (r.used as int[])[slot] = 0
    (r.named as int[])[slot] = 0
}

// A draw's values -- the shader's captures now -- into the next block of
// frame slot `slot`'s ring, and its set bound at the ring's place in its
// layout, at that block, naming `views[i]` through `samplers[i]` (one per
// texture the shader names, in its order). False, said once, past the ring
// or its sets: the draw is not to be made.
ring_bind(r: *VertexRing, commands: ptr, slot: int, views: ptr, samplers: ptr) -> bool {
    draw = (r.used as int[])[slot]
    if draw >= r.draws {
        if !r.overrun {
            io.stderr_write("ae3d: ${gpu.shader_name(r.shader as *GpuShader)} drawn ${draw + 1} times in a frame; its ring has ${r.draws}\n")
            r.overrun = true
        }
        return false
    }
    t = 0
    while t < r.textures {
        if (views as ptr[])[t] == null || (samplers as ptr[])[t] == null { return false }
        t = t + 1
    }
    // The set already naming these images in this frame, or the next.
    named = (r.named as int[])[slot]
    found = 0 - 1
    k = 0
    while k < named && found < 0 {
        same = true
        t = 0
        while t < r.textures {
            at = (slot * RING_SETS + k) * r.textures + t
            if (r.views as ptr[])[at] != (views as ptr[])[t] || (r.samplers as ptr[])[at] != (samplers as ptr[])[t] {
                same = false
            }
            t = t + 1
        }
        if same { found = k }
        k = k + 1
    }
    if found < 0 {
        if named >= RING_SETS {
            if !r.overrun {
                io.stderr_write("ae3d: ${gpu.shader_name(r.shader as *GpuShader)} drawn with more than ${RING_SETS} sets of images in a frame\n")
                r.overrun = true
            }
            return false
        }
        found = named
        (r.named as int[])[slot] = named + 1
        name_images(r, slot, found, views, samplers)
    }
    ring = (r.rings as ptr[])[slot] as *HostBuffer
    gpu.params_write(r.shader as *GpuShader, ring.mapped + draw * r.stride)
    (r.used as int[])[slot] = draw + 1
    cell = calloc(1, 8)
    (cell as ptr[])[0] = (r.sets as ptr[])[slot * RING_SETS + found]
    dynamic = calloc(1, 4)
    (dynamic as uint32[])[0] = (draw * r.stride) as uint32
    vk.vkCmdBindDescriptorSets(commands, vk.PIPELINE_BIND_POINT_GRAPHICS, r.layout, r.index, 1, cell, 1, dynamic)
    free(dynamic)
    free(cell)
    return true
}

// Set `k` of frame slot `slot` names the images, at 1.., from now on.
fn name_images(r: *VertexRing, slot: int, k: int, views: ptr, samplers: ptr) {
    n = r.textures
    if n < 1 { return }
    set = (r.sets as ptr[])[slot * RING_SETS + k]
    images = calloc(n, sizeof(VkDescriptorImageInfo))
    writes = calloc(n, sizeof(VkWriteDescriptorSet))
    t = 0
    while t < n {
        at = (slot * RING_SETS + k) * n + t
        (r.views as ptr[])[at] = (views as ptr[])[t]
        (r.samplers as ptr[])[at] = (samplers as ptr[])[t]
        image = (images + t * sizeof(VkDescriptorImageInfo)) as *VkDescriptorImageInfo
        image.imageLayout = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
        image.imageView = (views as ptr[])[t]
        image.sampler = (samplers as ptr[])[t]
        write = (writes + t * sizeof(VkWriteDescriptorSet)) as *VkWriteDescriptorSet
        write.sType = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
        write.dstSet = set
        write.dstBinding = 1 + t
        write.descriptorCount = 1
        write.descriptorType = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
        write.pImageInfo = image as ptr
        t = t + 1
    }
    vk.vkUpdateDescriptorSets(vkhost.device(), n, writes, 0, null)
    free(writes)
    free(images)
}

ring_shader(r: *VertexRing) -> *GpuShader { return r.shader as *GpuShader }
ring_layout(r: *VertexRing) -> ptr { return r.layout }

// Everything the ring made, its pipelines and its shader, gone; the device
// idle.
vertex_ring_free(r: *VertexRing) {
    if r == null { return }
    d = vkhost.device()
    k = 0
    while k < r.built {
        vk.vkDestroyPipeline(d, (r.pipelines as ptr[])[k], null)
        k = k + 1
    }
    slot = 0
    while slot < vkdesc.FRAMES {
        ring = (r.rings as ptr[])[slot]
        if ring != null { vkhost.host_buffer_free(ring as *HostBuffer) }
        slot = slot + 1
    }
    if r.pool != null { vk.vkDestroyDescriptorPool(d, r.pool, null) }
    if r.layout != null { vk.vkDestroyPipelineLayout(d, r.layout, null) }
    if r.set_layout != null { vk.vkDestroyDescriptorSetLayout(d, r.set_layout, null) }
    free(r.rings)
    free(r.sets)
    free(r.views)
    free(r.samplers)
    free(r.named)
    free(r.used)
    free(r.pipelines)
    gpu.shader_free(r.shader as *GpuShader)
    free(r as ptr)
}
