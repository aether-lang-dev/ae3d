// ae3d.ripples -- the small waves things make in water (#637): a damped wave
// equation over a square of the sea, N cells a side, disturbed where a body
// moves through the surface or drops into it, and spreading from there at
// the speed of a ripple. A boat leaves a wake, a crate that bobs rings the
// water round it, a splash spreads and dies. The sea draws its slopes over
// the swell (water.simulation_set_ripples).
//
//   r = ripples.ripples_new(256, 64.0, 0.0, 0.0)  // 64 m round the origin
//   ripples.ripples_disturb(r, x, z, 0.5, 0.05)   // a dip half a metre wide
//   ripples.ripples_step(r, delta)
//
// The scheme is the leapfrog second-order one, stepped as many times a frame
// as the speed and the cell size let it stay stable, and damped so a wake
// fades over seconds instead of ringing for good. Non-dispersive: a wake is
// the Mach V of the speed it is made at, not Kelvin's 19.5 degrees, a
// trade a few hundred thousand cell updates a frame can afford and wave
// packets would not.
import std.heap

exports (
    Ripples, ripples_new, ripples_free, ripples_disturb, ripples_step, ripples_height, ripples_slope,
    ripples_encode, ripples_cells, ripples_extent, ripples_origin_x, ripples_origin_z, ripples_set_speed,
    ripples_set_damping, ripples_energy, SLOPE_RANGE, HEIGHT_RANGE
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float
extern floor(x: float) -> float
extern exp(x: float) -> float

// What a texel's 8 bits stand for: slopes either way up to SLOPE_RANGE, a
// height either way up to HEIGHT_RANGE metres.
const SLOPE_RANGE = 0.6
const HEIGHT_RANGE = 0.25

struct Ripples {
    n: int
    extent: float                      // metres a side
    x0: float                          // its corner in the world
    z0: float
    h: ptr                             // float[n * n], now
    prev: ptr                          // float[n * n], a step ago
    speed: float                       // metres a second a ripple travels
    damping: float                     // the share of its height a ripple loses a second
}

ripples_new(n: int, extent: float, centre_x: float, centre_z: float) -> *Ripples {
    r = heap.new(Ripples)
    r.n = n
    r.extent = extent
    r.x0 = centre_x - extent * 0.5
    r.z0 = centre_z - extent * 0.5
    r.h = calloc(n * n, 8)
    r.prev = calloc(n * n, 8)
    r.speed = 1.6
    r.damping = 0.6
    return r
}

ripples_free(r: *Ripples) {
    if r == null { return }
    free(r.h)
    free(r.prev)
    heap.free(r)
}

ripples_cells(r: *Ripples) -> int { return r.n }
ripples_extent(r: *Ripples) -> float { return r.extent }
ripples_origin_x(r: *Ripples) -> float { return r.x0 }
ripples_origin_z(r: *Ripples) -> float { return r.z0 }
ripples_set_speed(r: *Ripples, metres_a_second: float) { r.speed = metres_a_second }
ripples_set_damping(r: *Ripples, share_a_second: float) { r.damping = share_a_second }

// The surface pushed down by `depth` metres over a dip `radius` metres
// across at (x, z), smoothly, as a body sinking into it pushes it; the water
// round it rises back and the ring spreads. A negative depth lifts it.
ripples_disturb(r: *Ripples, x: float, z: float, radius: float, depth: float) {
    cell = r.extent / (r.n as float)
    cx = (x - r.x0) / cell
    cz = (z - r.z0) / cell
    reach = radius / cell + 1.0
    if reach < 1.0 { reach = 1.0 }
    h = r.h as float[]
    p = r.prev as float[]
    y0 = floor(cz - reach) as int
    y1 = floor(cz + reach) as int + 1
    x0 = floor(cx - reach) as int
    x1 = floor(cx + reach) as int + 1
    j = y0
    while j <= y1 {
        i = x0
        while i <= x1 {
            if i >= 1 && j >= 1 && i < r.n - 1 && j < r.n - 1 {
                dx = ((i as float) - cx) * cell / radius
                dz = ((j as float) - cz) * cell / radius
                q = dx * dx + dz * dz
                if q < 1.0 {
                    fall = (1.0 - q) * (1.0 - q)
                    at = j * r.n + i
                    // The two time levels alike: a dip now, not a velocity.
                    h[at] = h[at] - depth * fall
                    p[at] = p[at] - depth * fall
                }
            }
            i = i + 1
        }
        j = j + 1
    }
}

// The field `seconds` on: as many leapfrog steps as keep c dt / dx under a
// half, each damped, the square's rim held still (it absorbs nothing; the
// damping takes a wake before it comes back).
ripples_step(r: *Ripples, seconds: float) {
    if seconds <= 0.0 { return }
    cell = r.extent / (r.n as float)
    most = 0.5 * cell / r.speed
    steps = (seconds / most) as int + 1
    dt = seconds / (steps as float)
    k = (r.speed * dt / cell) * (r.speed * dt / cell)
    keep = exp(0.0 - r.damping * dt)
    n = r.n
    s = 0
    while s < steps {
        h = r.h as float[]
        p = r.prev as float[]
        j = 1
        while j < n - 1 {
            i = 1
            while i < n - 1 {
                at = j * n + i
                lap = h[at - 1] + h[at + 1] + h[at - n] + h[at + n] - 4.0 * h[at]
                // Into the old level, which then is the new one.
                p[at] = (2.0 * h[at] - p[at] + k * lap) * keep
                i = i + 1
            }
            j = j + 1
        }
        held = r.h
        r.h = r.prev
        r.prev = held
        s = s + 1
    }
}

// The ripples' height over (x, z), bilinearly; 0 off the square.
ripples_height(r: *Ripples, x: float, z: float) -> float {
    cell = r.extent / (r.n as float)
    fx = (x - r.x0) / cell
    fz = (z - r.z0) / cell
    if fx < 0.0 || fz < 0.0 || fx >= (r.n - 1) as float || fz >= (r.n - 1) as float { return 0.0 }
    i = floor(fx) as int
    j = floor(fz) as int
    tx = fx - i as float
    tz = fz - j as float
    h = r.h as float[]
    a = h[j * r.n + i] + (h[j * r.n + i + 1] - h[j * r.n + i]) * tx
    b = h[(j + 1) * r.n + i] + (h[(j + 1) * r.n + i + 1] - h[(j + 1) * r.n + i]) * tx
    return a + (b - a) * tz
}

// Its slope along x and z there, by central differences.
ripples_slope(r: *Ripples, x: float, z: float) -> (float, float) {
    d = r.extent / (r.n as float)
    sx = (ripples_height(r, x + d, z) - ripples_height(r, x - d, z)) / (2.0 * d)
    sz = (ripples_height(r, x, z + d) - ripples_height(r, x, z - d)) / (2.0 * d)
    return sx, sz
}

// The field's energy, the sum of its heights squared: what a test watches
// spread and die.
ripples_energy(r: *Ripples) -> float {
    h = r.h as float[]
    e = 0.0
    i = 0
    while i < r.n * r.n {
        e = e + h[i] * h[i]
        i = i + 1
    }
    return e
}

byte_of(v: float) -> int {
    b = ((v * 0.5 + 0.5) * 255.0 + 0.5) as int
    if b < 0 { return 0 }
    if b > 255 { return 255 }
    return b
}

// The field into `pixels` (RGBA, n * n): its slope along x in red and along
// z in green, over SLOPE_RANGE, its height in blue over HEIGHT_RANGE.
ripples_encode(r: *Ripples, pixels: ptr) {
    n = r.n
    cell = r.extent / (n as float)
    h = r.h as float[]
    out = pixels as byte[]
    j = 0
    while j < n {
        i = 0
        while i < n {
            at = j * n + i
            left = h[at]
            right = h[at]
            down = h[at]
            up = h[at]
            if i > 0 { left = h[at - 1] }
            if i < n - 1 { right = h[at + 1] }
            if j > 0 { down = h[at - n] }
            if j < n - 1 { up = h[at + n] }
            sx = (right - left) / (2.0 * cell)
            sz = (up - down) / (2.0 * cell)
            out[at * 4] = byte_of(sx / SLOPE_RANGE)
            out[at * 4 + 1] = byte_of(sz / SLOPE_RANGE)
            out[at * 4 + 2] = byte_of(h[at] / HEIGHT_RANGE)
            out[at * 4 + 3] = 255
            i = i + 1
        }
        j = j + 1
    }
}
