// Physical animation (#858): a figure's ragdoll following its animated pose
// body by body. Each body has a mode, what moves it: kinematic (exactly
// where the animation has it), driven (pulled there by its anchor at a
// strength) or simulated (let go). And a weight, how it is drawn: 0 as the
// animation has it, exactly; 1 wholly from its body; between, that share of
// the way. As Unreal's Physical Animation component (its profiles'
// strengths, its physics blend weights) and PuppetMaster's pin and muscle
// weights read: the animation drives the bodies, and the bodies are drawn
// as much as the game asks. The hips and legs begin kinematic and the rest
// driven, every body at weight 0 (the
// profile "animated").
//
//     pa = physanim.attach(e, animator)          // every body animated
//     physanim.hit(pa, physanim.bone_named(pa, "Chest"), point, impulse)
//     physanim.set_weight(pa, bone, 1.0, 0.3)    // a body drawn from its body over 0.3 s
//     physanim.profiles_read(pa, "people/physanim.profiles")
//     physanim.apply_profile(pa, physanim.profile_find(pa, "guard"), 0.25)
//
// A hit (#859), a partial ragdoll: the body struck and its chain, the bodies
// up the figure from it toward the hips and down from it to its ends, let
// go of their anchors, pushed, and drawn from their bodies at once, each by
// its share of the blow: the blow's newton seconds over what lets the
// struck body go wholly (its `give`), halved (HIT_SPREAD) at each link
// away from it, bodies under HIT_LEAST left as they were. A body let go
// wholly hangs limp; one let go by less is on its own muscles, driven
// toward the animation at what its share leaves of its `muscle`. A
// stronger blow takes a longer chain: 10 N s on the forearm takes the arm,
// 40 takes the chest as well. The hips are never let go and the chain does
// not pass them, so a walking figure struck in the chest, an arm or the
// head keeps walking: its legs stay on the animation, its feet planted.
// After HIT_HOLD the chain is anchored again where it is and eased back to
// its weights over HIT_RECOVER (set_hit_times; the anchors' strengths and
// the gives and muscles are the profiles'), as PuppetMaster's pin weight
// comes back after a blow.
//
// A death (#859, go_limp): every body let go, the pelvis too, from the
// pose drawn and moving as it moved (each body's velocity from the
// animation's last two poses, a struck body's from its own), its muscles
// holding that pose and easing out over a fraction of a second rather than
// a puppet's strings cut; the figure then a ragdoll until it is freed.
//
// The order: the animator's graph poses the figure; this, a step after the
// graph (animator.add_post), reads the animated pose and the bodies' and
// draws the blend, shown as the animator's pose_shown, which what follows
// the figure as it is seen reads (its held items, a meter). The graph goes
// on from its own pose (pose_now). The physics steps in the fixed step, the
// bodies following the animated pose.

import std.fs
import std.heap
import std.list
import std.string
import aephysics.human
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.animator

exports (
    Physanim, attach, physanim_free, ragdoll_of, bones, set_mass, mass, bone_named, parent_of, nearest,
    set_weight, weight_of, hit, hit_count, set_hit_times, HIT_HOLD, HIT_RECOVER, set_hit_spread, HIT_SPREAD, HIT_LEAST, share_of, give_of, muscle_of,
    MODE_KINEMATIC, MODE_DRIVEN, MODE_SIMULATED, set_mode, mode_of, profile_add, profile_find, profile_set, profile_set_below, profile_set_hit,
    apply_profile, profiles_read, profile_count, release, retake, released, error,
    go_limp, limp, at_rest, LIMP_FALL, REST_SPEED, knock, falling, down,
    state_size, state_write, state_read
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// Seconds a body struck is let go, and how long it eases back.
const HIT_HOLD = 0.15
const HIT_RECOVER = 0.6
// The share of a blow a body passes to the next along its chain, and the
// least share that takes a body (set_hit_spread).
const HIT_SPREAD = 0.5
const HIT_LEAST = 0.2
// Seconds a death's muscles take to ease out (go_limp's own, the game's
// to give), and how slow every body must go, metres a second, for
// REST_STEPS steps for it to lie at rest (at_rest).
const LIMP_FALL = 0.3
const REST_SPEED = 0.1
const REST_STEPS = 20
// Seconds a figure let go is drawn onto its bodies over: physics's powered
// blend (physics POWER_BLEND), kept powered at least that long.
const LIMP_BLEND = 0.25
// Seconds a hit's chain is drawn onto its bodies over from where it was
// drawn: the difference eased out (inertialized) rather than jumped. At
// once, a struck walker's forearm was drawn turning 57 rad/s in the step.
const HIT_IN = 0.1
// A knockdown (knock, #861). Landed once its pelvis is within GROUNDED of
// its lowest point for LAND_STEPS steps, or, a hand within HAND_DOWN of it,
// its trunk slower than CAUGHT_SPEED for CAUGHT_STEPS (caught on its hands
// and knees); powered FALL_MOST seconds at the most. Lying once its pelvis
// and chest are slower than REST_SPEED for DOWN_STEPS (down). Its legs on
// FALL_LEGS of their muscle as it goes; protecting, its arms reach
// REACH_DOWN down to 1 toward the fall on REACH_STRENGTH times their muscle
// and its head tucks TUCK radians, over FALL_IN: ae3d.motion's protective
// fall's (#479), chosen over its thirty falls each way.
const GROUNDED = 0.25
const LAND_STEPS = 10
const HAND_DOWN = 0.05
const CAUGHT_SPEED = 0.3
const CAUGHT_STEPS = 20
const FALL_MOST = 2.0
const DOWN_STEPS = 10
const FALL_LEGS = 0.3
const REACH_DOWN = 0.7
const REACH_STRENGTH = 5.0
const TUCK = 0.8
const FALL_IN = 0.15

// A person's bodies' gives, newton seconds (a blow that lets the body go
// wholly), and muscles, newton metres (what drives a body let go of in
// part, or a falling one, toward its pose): ae3d.motion's muscles, the
// trunk stiffest and the head and arms lightest.
body_give(name: string) -> float {
    if string.equals(name, "Spine") == 1 || string.equals(name, "Chest") == 1 { return 20.0 }
    if string.equals(name, "Neck") == 1 { return 8.0 }
    if string.starts_with(name, "Shoulder") == 1 { return 10.0 }
    if string.starts_with(name, "Elbow") == 1 { return 6.0 }
    if string.starts_with(name, "Thigh") == 1 { return 25.0 }
    if string.starts_with(name, "Knee") == 1 { return 15.0 }
    if string.starts_with(name, "Foot") == 1 { return 10.0 }
    return 20.0
}

// Body `k`'s name: physics.humanoid_bone's, and a fitted foot's (the two
// past the twelve) as such.
body_name(k: int) -> string {
    if k == 12 { return "FootL" }
    if k == 13 { return "FootR" }
    return physics.humanoid_bone(k)
}

body_muscle(name: string) -> float {
    if string.equals(name, "Spine") == 1 || string.equals(name, "Chest") == 1 { return 250.0 }
    if string.equals(name, "Neck") == 1 { return 40.0 }
    if string.starts_with(name, "Shoulder") == 1 { return 80.0 }
    if string.starts_with(name, "Elbow") == 1 { return 60.0 }
    if string.starts_with(name, "Thigh") == 1 { return 300.0 }
    if string.starts_with(name, "Knee") == 1 { return 250.0 }
    if string.equals(name, "Hips") == 1 { return 0.0 }
    return 120.0
}

// What drives a body (set_mode, a profile's): moved exactly onto the
// animation (a kinematic body, which pushes what it meets and is not
// pushed), pulled onto it by its anchor at a strength, or simulated, no
// anchor, as a ragdoll's. The pelvis is never simulated: the figure
// stays on its feet (a fall is ae3d.motion's).
const MODE_KINEMATIC = 0
const MODE_DRIVEN = 1
const MODE_SIMULATED = 2

// A named set of every body's mode, anchor strength and weight, as
// Unreal's physical animation profiles and PuppetMaster's pin and muscle
// weights are: applied at once to the bodies, the weights eased.
struct Profile {
    name: string
    modes: ptr                     // int[count]
    pins: ptr                      // float[count * 3]: hertz (0 the default's), most force, most torque (0 unbounded)
    weights: ptr                   // float[count]
    gives: ptr                     // float[count]: newton seconds that let the body go wholly
    muscles: ptr                   // float[count]: newton metres it is driven toward its pose by, let go of
}

var g_error: string = ""

// What the last profiles_read that failed said.
error() -> string { return g_error }

struct Physanim {
    engine: ptr                    // *Engine
    animator: ptr                  // *Animator
    ragdoll: ptr                   // *Ragdoll
    count: int                     // its bodies
    weights: ptr                   // float[count]: each body's weight now
    froms: ptr                     // float[count]: where its easing began
    goals: ptr                     // float[count]: where it is going
    times: ptr                     // float[count]: seconds the easing takes (0 at once)
    gone: ptr                      // float[count]: seconds into it
    holds: ptr                     // float[count]: seconds a hit keeps it let go, 0 none
    modes: ptr                     // int[count]: each body's MODE_
    bases: ptr                     // float[count]: the weight it is set to (set_weight, a profile), what a hit eases back to
    struck: ptr                    // int[count]: 1 from a hit until it is eased back
    profiles: ptr                  // list of *Profile
    parents: ptr                   // int[count]: the body above it, -1 the pelvis's
    order: ptr                     // int[count]: the bodies, each after the one above it
    anim: ptr                      // float[count * POSE_STRIDE]: the animated pose
    body: ptr                      // float[count * POSE_STRIDE]: the bodies'
    shown: ptr                     // float[count * POSE_STRIDE]: what is drawn
    hold: float                    // a hit's HIT_HOLD and HIT_RECOVER, the game's to set
    recover: float
    hits: int
    was_fixed: bool                // its animator at the fixed step before (animator.set_fixed)
    stepper: ptr                   // *Behaviour
    released: bool                 // its bodies let go to another writer (release): nothing driven, nothing drawn
    gives: ptr                     // float[count]: each body's give and muscle (a profile's)
    muscles: ptr
    shares: ptr                    // float[count]: each body's share of the last blow that took it, 0 none
    spread: float                  // a blow's share passed on a link (set_hit_spread)
    least: float                   // and the least that takes a body
    was_w: ptr                     // float[count]: its weight as a blow took it
    easing: ptr                    // int[count]: 1 a blow's ease-in to begin at the next drawing, 2 easing
    ease_q: ptr                    // float[count * 4]: the turn, and the place (float[count * 3]), it is drawn off its blend by
    ease_p: ptr
    ease_t: ptr                    // float[count]: seconds into the ease-in
    limp: bool                     // let go wholly (go_limp)
    fall: float                    // seconds its muscles ease out over, and how far it is into them
    fallen: float
    still_steps: int               // steps every body has gone slower than REST_SPEED
    falling: bool                  // knocked down (knock): powered as it goes down, until it lands
    protect: bool                  // and reaching for the ground as it goes (its arms, its head tucked)
    fall_t: float                  // seconds into the fall
    low_steps: int                 // steps its pelvis has been within GROUNDED of its lowest point
    caught_steps: int              // steps its trunk has gone slower than CAUGHT_SPEED, once a hand is down
    trunk_still: int               // steps its pelvis and chest have gone slower than REST_SPEED, let go wholly
}

// A figure's ragdoll on animator `a`'s figure, every body on the animation
// (weight 0). Null when the figure's rig is no humanoid the engine knows.
attach(e: *Engine, a: *Animator) -> *Physanim {
    o = animator.figure_object(a)
    f = figure.figure_of(o)
    if f == null { return null }
    sk = figure.skeleton(f)
    if sk == null || physics.humanoid_scheme(sk) < 0 { return null }
    if physics.of(e) == null { physics.attach(e) }
    group = behaviour.object_model(o)
    at = behaviour.object_position(o)
    if group != null {
        core.model_sync_transform(group)
        at = group.world_position
    }
    r = physics.ragdoll(e, core.text(o.name), at, 8.0, 8.0, 1.0)
    if r == null { return null }
    if !physics.ragdoll_dress_humanoid_in_place(r, sk) {
        physics.ragdoll_free(r)
        return null
    }
    physics.ragdoll_set_object(r, o)
    physics.ragdoll_follow(r)
    // A person's weight for how tall it stands as it is put on (#626's
    // physics.person_mass; set_mass gives it its own). Dressed in place, its
    // capsules kept the reference human's densities, and a mannequin
    // weighed half a person (Siltreach: 38.5 kg).
    physics.ragdoll_set_mass(r, physics.person_mass(physics.ragdoll_height(r)))
    pa = heap.new(Physanim)
    pa.engine = e as ptr
    pa.animator = a as ptr
    pa.ragdoll = r as ptr
    n = physics.ragdoll_bone_count(r)
    if n <= 0 {
        physics.ragdoll_free(r)
        heap.free(pa)
        return null
    }
    pa.count = n
    pa.weights = calloc(n, 8)
    pa.froms = calloc(n, 8)
    pa.goals = calloc(n, 8)
    pa.times = calloc(n, 8)
    pa.gone = calloc(n, 8)
    pa.holds = calloc(n, 8)
    pa.modes = calloc(n, 4)
    pa.bases = calloc(n, 8)
    pa.struck = calloc(n, 4)
    pa.profiles = list.new()
    pa.parents = calloc(n, 4)
    pa.order = calloc(n, 4)
    pa.anim = calloc(n * physics.POSE_STRIDE, 8)
    pa.body = calloc(n * physics.POSE_STRIDE, 8)
    pa.shown = calloc(n * physics.POSE_STRIDE, 8)
    pa.hold = HIT_HOLD
    pa.recover = HIT_RECOVER
    pa.gives = calloc(n, 8)
    pa.muscles = calloc(n, 8)
    pa.shares = calloc(n, 8)
    pa.was_w = calloc(n, 8)
    pa.easing = calloc(n, 4)
    pa.ease_q = calloc(n * 4, 8)
    pa.ease_p = calloc(n * 3, 8)
    pa.ease_t = calloc(n, 8)
    pa.spread = HIT_SPREAD
    pa.least = HIT_LEAST
    find_parents(pa)
    find_order(pa)
    k = 0
    while k < n {
        (pa.modes as int[])[k] = MODE_DRIVEN
        k = k + 1
    }
    animated = profile_add(pa, "animated")
    // The hips and legs kinematic, the trunk, neck and arms driven, as
    // Unreal's physical animation is set up (the bodies below the spine on
    // the animation, the rest simulated toward it). Driven, the legs' shapes,
    // fitted thicker than the soles, met the floor in 60 to 72% of a walk's
    // frames and held the shins 54 to 64 mm off the pose, the spine 13; the
    // hips and legs kinematic, 0.000005 mm and 0.7. A blow lets them go as it
    // does any body.
    profile_set(pa, animated, bone_named(pa, "Hips"), MODE_KINEMATIC, 0.0, 0.0, 0.0, 0.0)
    profile_set_below(pa, animated, bone_named(pa, "ThighL"), MODE_KINEMATIC, 0.0, 0.0, 0.0, 0.0)
    profile_set_below(pa, animated, bone_named(pa, "ThighR"), MODE_KINEMATIC, 0.0, 0.0, 0.0, 0.0)
    apply_profile(pa, animated, 0.0)
    b = engine.behaviour_new("physanim", pa as ptr)
    b.fixed_update = physanim_step
    engine.engine_add_behaviour(e, b)
    pa.stepper = b as ptr
    animator.add_post(a, physanim_post, pa as ptr)
    // Its graph before the step's physics: the anchors chase this step's
    // pose. Posed after the physics (in the pose phase, as it once was, or
    // after the step's physics, as a figure is by default), every body
    // chased the step before's.
    pa.was_fixed = animator.fixed(a)
    animator.set_fixed(a, true)
    return pa
}

physanim_free(pa: *Physanim) {
    if pa == null { return }
    animator.remove_post(pa.animator as *Animator, pa as ptr)
    animator.set_fixed(pa.animator as *Animator, pa.was_fixed)
    if pa.stepper != null {
        engine.engine_remove_behaviour(pa.engine as *Engine, pa.stepper as *Behaviour)
        heap.free(pa.stepper as *Behaviour)
    }
    physics.ragdoll_free(pa.ragdoll as *Ragdoll)
    free(pa.weights)
    free(pa.froms)
    free(pa.goals)
    free(pa.times)
    free(pa.gone)
    free(pa.holds)
    free(pa.modes)
    free(pa.bases)
    free(pa.struck)
    free(pa.gives)
    free(pa.muscles)
    free(pa.shares)
    free(pa.was_w)
    free(pa.easing)
    free(pa.ease_q)
    free(pa.ease_p)
    free(pa.ease_t)
    i = 0
    while i < list.size(pa.profiles) {
        p = list.get_raw(pa.profiles, i) as *Profile
        string.free(p.name)
        free(p.modes)
        free(p.pins)
        free(p.weights)
        free(p.gives)
        free(p.muscles)
        heap.free(p)
        i = i + 1
    }
    list.free(pa.profiles)
    free(pa.parents)
    free(pa.order)
    free(pa.anim)
    free(pa.body)
    free(pa.shown)
    heap.free(pa)
}

ragdoll_of(pa: *Physanim) -> *Ragdoll { return pa.ragdoll as *Ragdoll }
bones(pa: *Physanim) -> int { return pa.count }

// The figure's bodies weighing `kg` in all, each its share of a person
// (physics.ragdoll_set_mass): what a blow moves and a carrier lifts. Not
// mid-step.
set_mass(pa: *Physanim, kg: float) { physics.ragdoll_set_mass(pa.ragdoll as *Ragdoll, kg) }
mass(pa: *Physanim) -> float { return physics.ragdoll_mass(pa.ragdoll as *Ragdoll) }
hit_count(pa: *Physanim) -> int { return pa.hits }

// The body named `name` (physics.humanoid_bone's names: "Hips", "Spine",
// "Chest", "Neck", "ShoulderL", "ElbowL", "ThighL", "KneeL"), or -1.
bone_named(pa: *Physanim, name: string) -> int {
    k = 0
    while k < pa.count {
        if string.equals(physics.humanoid_bone(k), name) == 1 { return k }
        k = k + 1
    }
    return 0 - 1
}

// The body above body `k` in the figure's hierarchy, -1 for the pelvis.
parent_of(pa: *Physanim, k: int) -> int { return (pa.parents as int[])[k] }

// The body nearest `point`: the one whose bone, from its joint to its far
// end as the bodies stand now, passes closest. What a blow known only by
// where it landed strikes (a ray's hit point).
nearest(pa: *Physanim, point: Vec3) -> int {
    r = pa.ragdoll as *Ragdoll
    physics.ragdoll_body_pose(r, pa.body)
    best = 0 - 1
    best_d = 1000000.0
    k = 0
    while k < pa.count {
        _q, head = bone_at(pa.body, k)
        tail = physics.ragdoll_pose_end(r, pa.body, k)
        d = core.v3_len(core.v3_sub(point, closest_on(head, tail, point)))
        if d < best_d {
            best_d = d
            best = k
        }
        k = k + 1
    }
    return best
}

// The point of segment `a` `b` nearest `p`.
closest_on(a: Vec3, b: Vec3, p: Vec3) -> Vec3 {
    ab = core.v3_sub(b, a)
    len2 = core.v3_dot(ab, ab)
    if len2 < 0.0000001 { return a }
    t = core.clampf(core.v3_dot(core.v3_sub(p, a), ab) / len2, 0.0, 1.0)
    return core.v3_add(a, core.v3_mul(ab, t))
}

// Each body's parent: the nearest of the ragdoll's bones up the figure's own
// joints from the one it follows.
find_parents(pa: *Physanim) {
    r = pa.ragdoll as *Ragdoll
    parents = pa.parents as int[]
    k = 0
    while k < pa.count {
        parents[k] = 0 - 1
        m = core.model_parent(physics.ragdoll_rig_bone(r, k))
        while m != null && parents[k] < 0 {
            j = 0
            while j < pa.count {
                if j != k && physics.ragdoll_rig_bone(r, j) == m { parents[k] = j }
                j = j + 1
            }
            m = core.model_parent(m)
        }
        k = k + 1
    }
}

// Body `k`'s weight toward `w` (0 drawn as the animation has it, 1 drawn
// wholly from its body, as its mode moves it), over `seconds` (0: at
// once), eased (a smooth step from where it is). What a hit eases back to.
set_weight(pa: *Physanim, k: int, w: float, seconds: float) {
    if k < 0 || k >= pa.count { return }
    (pa.froms as float[])[k] = (pa.weights as float[])[k]
    (pa.goals as float[])[k] = core.clampf(w, 0.0, 1.0)
    (pa.times as float[])[k] = seconds
    (pa.gone as float[])[k] = 0.0
    (pa.holds as float[])[k] = 0.0
    (pa.struck as int[])[k] = 0
    (pa.shares as float[])[k] = 0.0
    (pa.easing as int[])[k] = 0
    (pa.bases as float[])[k] = core.clampf(w, 0.0, 1.0)
    if seconds <= 0.0 { (pa.weights as float[])[k] = core.clampf(w, 0.0, 1.0) }
    limp_by(pa, k)
}

weight_of(pa: *Physanim, k: int) -> float { return (pa.weights as float[])[k] }

// A hit's let go and its easing back (HIT_HOLD and HIT_RECOVER by default).
set_hit_times(pa: *Physanim, hold: float, recover: float) {
    pa.hold = hold
    pa.recover = recover
}

// A blow: `impulse` (newton seconds) at `point` on body `k`, a partial
// ragdoll (#859). The body and its chain are let go, each by its share
// (share_of): the blow over the struck body's give, times the spread for
// each link along the chain, up toward the hips and down to the ends, a
// body taken from the least share on (set_hit_spread), the struck one
// always. Taken, a body is off its anchor and drawn from its body at once:
// limp at a whole share, on its own muscles at what the share leaves of
// its muscle under it. Held so for the hit's hold, then driven by their
// anchors again where they are and eased back to their weights over its
// recovery, and kinematic again, if they were, once there. The pelvis is
// struck and pushed but never let go, and the chain does not pass it: the
// figure stays on its feet, its legs on the animation unless a leg is
// struck. A body already let go by a stronger share keeps it. On a figure
// let go wholly (go_limp), the blow alone.
hit(pa: *Physanim, k: int, point: Vec3, impulse: Vec3) {
    if k < 0 || k >= pa.count { return }
    r = pa.ragdoll as *Ragdoll
    if pa.limp {
        physics.ragdoll_apply_impulse(r, k, impulse, point)
        pa.hits = pa.hits + 1
        return
    }
    pelvis = bone_named(pa, "Hips")
    give = (pa.gives as float[])[k]
    if give < 0.0001 { give = 0.0001 }
    amount = core.v3_len(impulse) / give
    shares = pa.shares as float[]
    j = 0
    while j < pa.count {
        links = chain_links(pa, j, k)
        if links >= 0 && j != pelvis {
            share = amount
            n = 0
            while n < links {
                share = share * pa.spread
                n = n + 1
            }
            share = core.clampf(share, 0.0, 1.0)
            if j == k && share < pa.least { share = pa.least }
            if share >= pa.least {
                if (pa.holds as float[])[j] > 0.0 && shares[j] > share { share = shares[j] }
                shares[j] = share
                // Drawn from where it was: its blend's turn and place at the
                // weight it had, eased onto its body's (HIT_IN).
                if (pa.weights as float[])[j] < 1.0 && (pa.easing as int[])[j] == 0 {
                    (pa.was_w as float[])[j] = (pa.weights as float[])[j]
                    (pa.easing as int[])[j] = 1
                }
                (pa.weights as float[])[j] = 1.0
                (pa.goals as float[])[j] = 1.0
                (pa.froms as float[])[j] = 1.0
                (pa.times as float[])[j] = 0.0
                (pa.holds as float[])[j] = pa.hold
                (pa.struck as int[])[j] = 1
                limp_by(pa, j)
            }
        }
        j = j + 1
    }
    physics.ragdoll_apply_impulse(r, k, impulse, point)
    pa.hits = pa.hits + 1
}

// The links from body `k` to body `j` along `k`'s chain: up from it toward
// the hips, or down from it; -1 when `j` is on neither (a sibling, the
// other arm).
chain_links(pa: *Physanim, j: int, k: int) -> int {
    parents = pa.parents as int[]
    links = 0
    at = j
    while at >= 0 {
        if at == k { return links }
        at = parents[at]
        links = links + 1
    }
    links = 0
    at = k
    while at >= 0 {
        if at == j { return links }
        at = parents[at]
        links = links + 1
    }
    return 0 - 1
}

// Body `k`'s share of the last blow that took it, while it is held or
// easing back from it; 0 for none.
share_of(pa: *Physanim, k: int) -> float {
    if k < 0 || k >= pa.count || (pa.struck as int[])[k] == 0 { return 0.0 }
    return (pa.shares as float[])[k]
}

// A blow's share passed on along a chain at each link, and the least share
// that takes a body (HIT_SPREAD and HIT_LEAST by default). A spread of 0
// takes the struck body alone.
set_hit_spread(pa: *Physanim, spread: float, least: float) {
    pa.spread = core.clampf(spread, 0.0, 1.0)
    pa.least = core.clampf(least, 0.0, 1.0)
}

give_of(pa: *Physanim, k: int) -> float { return (pa.gives as float[])[k] }
muscle_of(pa: *Physanim, k: int) -> float { return (pa.muscles as float[])[k] }

// Its body as its mode has it: let go while a hit holds it (limp at a whole
// share, on its own muscles at less) or it is simulated; kinematic only when
// it is not easing back from a hit, where it would be carried onto the
// animation in a step while it is drawn.
limp_by(pa: *Physanim, k: int) {
    if pa.limp { return }
    r = pa.ragdoll as *Ragdoll
    mode = (pa.modes as int[])[k]
    held = (pa.holds as float[])[k] > 0.0
    share = (pa.shares as float[])[k]
    limp = (held && share >= 1.0) || mode == MODE_SIMULATED
    own = held && !limp
    if physics.ragdoll_bone_is_limp(r, k) != limp { physics.ragdoll_set_bone_limp(r, k, limp) }
    if physics.ragdoll_bone_is_own(r, k) != own { physics.ragdoll_set_bone_own(r, k, own) }
    if own { physics.ragdoll_set_bone_drive(r, k, (pa.muscles as float[])[k] * (1.0 - share)) }
    kinematic = !limp && !own && mode == MODE_KINEMATIC && (pa.struck as int[])[k] == 0
    if physics.ragdoll_bone_is_kinematic(r, k) != kinematic { physics.ragdoll_set_bone_kinematic(r, k, kinematic) }
}

smooth(u: float) -> float {
    v = core.clampf(u, 0.0, 1.0)
    return v * v * (3.0 - 2.0 * v)
}

// A fixed step: the hits' holds run out, and the weights ease.
physanim_step(state: ptr, e: *Engine, dt: float) {
    pa = state as *Physanim
    if pa.released { return }
    if pa.limp {
        limp_step(pa, dt)
        return
    }
    // The arms pass the hips, the lower spine and the thighs while the figure
    // keeps to its animation, as ae3d.motion's figures do (#600): met, the
    // upper arms touched the lower spine in every frame of a walk.
    physics.ragdoll_free_flanks(pa.ragdoll as *Ragdoll, true)
    w = pa.weights as float[]
    froms = pa.froms as float[]
    goals = pa.goals as float[]
    times = pa.times as float[]
    gone = pa.gone as float[]
    holds = pa.holds as float[]
    easing = pa.easing as int[]
    k = 0
    while k < pa.count {
        if easing[k] == 2 {
            (pa.ease_t as float[])[k] = (pa.ease_t as float[])[k] + dt
            if (pa.ease_t as float[])[k] >= HIT_IN { easing[k] = 0 }
        }
        if holds[k] > 0.0 {
            holds[k] = holds[k] - dt
            if holds[k] <= 0.0 {
                // Anchored again as its weight leaves 1, and eased back onto
                // the animation as its anchor carries the body there. Left
                // limp until it was drawn no more, the chest went on falling
                // as it eased, 64 degrees off the twin's rather than 38, and
                // its fastest joint turned 18.9 rad/s, not 14.8 (the walk's
                // own 15.8), measured with the bodies chasing the frame
                // before's pose (before animator.set_fixed).
                holds[k] = 0.0
                froms[k] = 1.0
                goals[k] = (pa.bases as float[])[k]
                times[k] = pa.recover
                gone[k] = 0.0
                if w[k] == goals[k] { (pa.struck as int[])[k] = 0 }
                limp_by(pa, k)
            }
        } else if w[k] != goals[k] {
            gone[k] = gone[k] + dt
            if times[k] <= 0.0 {
                w[k] = goals[k]
            } else {
                w[k] = froms[k] + (goals[k] - froms[k]) * smooth(gone[k] / times[k])
                if gone[k] >= times[k] { w[k] = goals[k] }
            }
            if w[k] == goals[k] { (pa.struck as int[])[k] = 0 }
            limp_by(pa, k)
        }
        k = k + 1
    }
}

// After the graph (animator.add_post): the figure drawn between its
// animated pose and its bodies, body by body down the figure from its hips,
// each its own turn and place off the body above it blended by its weight
// (the hips in the world's), and shown (animator.show). So a body at 0 keeps
// the bend the animation gives it under a body above it that is thrown: a
// forearm stays bent at the elbow as animated under a struck upper arm, where
// blended in the world's it would hold the world's turn the animation gives
// it and its elbow bend by however far the arm above it went. The graph goes
// on from its own pose. With every weight 0 it is left as the graph drew it.
physanim_post(state: ptr, a: *Animator) {
    pa = state as *Physanim
    if pa.released || pa.limp { return }
    w = pa.weights as float[]
    any = false
    k = 0
    while k < pa.count {
        if w[k] > 0.0 { any = true }
        k = k + 1
    }
    if !any { return }
    r = pa.ragdoll as *Ragdoll
    // A body on its own muscles (a blow's share) is driven toward its
    // joint's turn as this step's animation has it, read off the rig before
    // it is drawn from the bodies: left at the turn it had when struck, a
    // forearm was driven back to where the walk had it a stride before.
    k = 1
    while k < pa.count {
        if physics.ragdoll_bone_is_own(r, k) { physics.ragdoll_set_bone_clip(r, k, physics.ragdoll_rig_bone(r, k).rotation) }
        k = k + 1
    }
    if !physics.ragdoll_animation_pose(r, pa.anim) { return }
    physics.ragdoll_body_pose(r, pa.body)
    parents = pa.parents as int[]
    order = pa.order as int[]
    n = 0
    while n < pa.count {
        k = order[n]
        up = parents[k]
        qa, pa_at = bone_at(pa.anim, k)
        qb, pb_at = bone_at(pa.body, k)
        if up < 0 {
            put(pa.shown, k, core.quat_slerp(qa, qb, w[k]), core.v3_lerp(pa_at, pb_at, w[k]))
        } else {
            uqa, upa = bone_at(pa.anim, up)
            uqb, upb = bone_at(pa.body, up)
            uqs, ups = bone_at(pa.shown, up)
            // Its own off the body above it, in the animation and in the bodies.
            la_q = core.quat_mul(core.quat_conjugate(uqa), qa)
            la_p = core.quat_apply(core.quat_conjugate(uqa), core.v3_sub(pa_at, upa))
            lb_q = core.quat_mul(core.quat_conjugate(uqb), qb)
            lb_p = core.quat_apply(core.quat_conjugate(uqb), core.v3_sub(pb_at, upb))
            lq = core.quat_slerp(la_q, lb_q, w[k])
            lp = core.v3_lerp(la_p, lb_p, w[k])
            lq, lp = eased_in(pa, k, la_q, la_p, lb_q, lb_p, lq, lp)
            put(pa.shown, k, core.quat_normalize(core.quat_mul(uqs, lq)), core.v3_add(ups, core.quat_apply(uqs, lp)))
        }
        n = n + 1
    }
    // A leg drawn as its animation has it keeps its foot as the animation and
    // its IK put it (#1000): only a leg drawn off its bodies has its toe
    // lifted off the ground.
    physics.ragdoll_show_pose(r, pa.shown, true, leg_drawn(pa, 0), leg_drawn(pa, 1))
    animator.show(a)
}

// Whether side `side`'s leg (0 left, 1 right) is drawn off its bodies at
// all: its thigh, its calf, its foot or the pelvis it hangs from at a
// weight over 0.
leg_drawn(pa: *Physanim, side: int) -> bool {
    w = pa.weights as float[]
    thigh = human.BONE_THIGH_L
    calf = human.BONE_CALF_L
    foot = human.BONE_FOOT_L
    if side == 1 {
        thigh = human.BONE_THIGH_R
        calf = human.BONE_CALF_R
        foot = human.BONE_FOOT_R
    }
    if w[human.BONE_PELVIS] > 0.0 || w[thigh] > 0.0 || w[calf] > 0.0 { return true }
    return foot < pa.count && w[foot] > 0.0
}

// Body `k`'s blend `lq` `lp` (its own off the body above it) drawn off by
// what is left of a blow's ease-in: taken at the first drawing after the
// blow (once the step has moved the bodies, whose joints may have pushed
// them off where they were), as the blend at the weight it had less the
// blend now, and eased out over HIT_IN, as an inertialized transition is.
eased_in(pa: *Physanim, k: int, la_q: Quat, la_p: Vec3, lb_q: Quat, lb_p: Vec3, lq: Quat, lp: Vec3) -> (Quat, Vec3) {
    easing = pa.easing as int[]
    if easing[k] == 0 { return lq, lp }
    oq = pa.ease_q as float[]
    op = pa.ease_p as float[]
    if easing[k] == 1 {
        was = (pa.was_w as float[])[k]
        from_q = core.quat_slerp(la_q, lb_q, was)
        from_p = core.v3_lerp(la_p, lb_p, was)
        off = core.quat_normalize(core.quat_mul(from_q, core.quat_conjugate(lq)))
        if off.w < 0.0 { off = core.quat(0.0 - off.x, 0.0 - off.y, 0.0 - off.z, 0.0 - off.w) }
        oq[k * 4] = off.x
        oq[k * 4 + 1] = off.y
        oq[k * 4 + 2] = off.z
        oq[k * 4 + 3] = off.w
        d = core.v3_sub(from_p, lp)
        op[k * 3] = d.x
        op[k * 3 + 1] = d.y
        op[k * 3 + 2] = d.z
        (pa.ease_t as float[])[k] = 0.0
        easing[k] = 2
    }
    left = 1.0 - smooth((pa.ease_t as float[])[k] / HIT_IN)
    off_q = core.quat_slerp(core.quat(0.0, 0.0, 0.0, 1.0), core.quat(oq[k * 4], oq[k * 4 + 1], oq[k * 4 + 2], oq[k * 4 + 3]), left)
    return core.quat_normalize(core.quat_mul(off_q, lq)), core.v3_add(lp, core.v3_mul(core.vec3(op[k * 3], op[k * 3 + 1], op[k * 3 + 2]), left))
}

// Body `k` of a ragdoll pose: its turn and its place.
bone_at(p: ptr, k: int) -> (Quat, Vec3) {
    f = p as float[]
    at = k * physics.POSE_STRIDE
    return core.quat(f[at], f[at + 1], f[at + 2], f[at + 3]), core.vec3(f[at + 4], f[at + 5], f[at + 6])
}

put(p: ptr, k: int, q: Quat, at: Vec3) {
    f = p as float[]
    i = k * physics.POSE_STRIDE
    f[i] = q.x
    f[i + 1] = q.y
    f[i + 2] = q.z
    f[i + 3] = q.w
    f[i + 4] = at.x
    f[i + 5] = at.y
    f[i + 6] = at.z
}

// The bodies in an order that has each after the one above it.
find_order(pa: *Physanim) {
    parents = pa.parents as int[]
    order = pa.order as int[]
    if pa.count <= 0 { return }
    placed = calloc(pa.count, 4) as int[]
    n = 0
    passes = 0
    while n < pa.count && passes <= pa.count {
        passes = passes + 1
        k = 0
        while k < pa.count {
            if placed[k] == 0 && (parents[k] < 0 || placed[parents[k]] == 1) {
                order[n] = k
                placed[k] = 1
                n = n + 1
            }
            k = k + 1
        }
    }
    free(placed as ptr)
}

// --- modes and profiles ----------------------------------------------------------------------------

// Body `k` moved by `mode` (MODE_KINEMATIC, MODE_DRIVEN, MODE_SIMULATED), at
// once.
// Its bodies let go to another writer (#941): ae3d.motion acting on this
// ragdoll for a fall and a get-up (motion.active_ragdoll(ragdoll_of(pa))),
// every body simulated, the pelvis too, nothing driven toward the animation
// and nothing drawn from them. A figure on physanim given motion's own ragdoll
// for a fall wore two sets of bodies, each in the other.
release(pa: *Physanim) {
    if pa == null || pa.released { return }
    pa.released = true
    r = pa.ragdoll as *Ragdoll
    k = 0
    while k < pa.count {
        if physics.ragdoll_bone_is_kinematic(r, k) { physics.ragdoll_set_bone_kinematic(r, k, false) }
        k = k + 1
    }
}

// Its bodies taken back from the other writer: each on its own mode again
// (kinematic, driven or simulated) at the weight it had, eased from where
// the bodies are as a hit eases back. Or from lying let go wholly (knock):
// on the animation again, as unlimp has it.
retake(pa: *Physanim) {
    if pa == null { return }
    if pa.limp && !pa.released {
        unlimp(pa)
        return
    }
    if !pa.released { return }
    pa.released = false
    k = 0
    while k < pa.count {
        limp_by(pa, k)
        k = k + 1
    }
}

// Whether its bodies are let go to another writer.
released(pa: *Physanim) -> bool { return pa != null && pa.released }

// --- let go wholly (#859) ---------------------------------------------------------------------------

// Every body let go, the pelvis too: the figure a ragdoll from here, as a
// death makes it (UE5's death ragdoll: the physics blend weight at 1 on
// every body, all simulated). Each body is set moving as the figure moves
// where it is drawn: at the velocity the animation's
// last two poses give it (physics.ragdoll_animation_velocity), a body drawn
// from its body (a blow's) at its own, one between at its weight's share of
// each. So a runner killed mid-stride falls on with its stride's momentum,
// its swinging arm swinging on. Its muscles hold the pose it was drawn in
// and ease out over `seconds` (LIMP_FALL is a person's), so it does not drop
// as a puppet whose strings are cut; 0 lets it go at once. Its animator is
// the caller's to pause (animator.pause), which then reads the figure back
// as the bodies draw it. False when it is let go already, or its bodies are
// another writer's (release).
go_limp(pa: *Physanim, seconds: float) -> bool {
    if pa == null || pa.limp || pa.released { return false }
    r = pa.ragdoll as *Ragdoll
    w = pa.weights as float[]
    moving = calloc(pa.count * 6, 8) as float[]
    k = 0
    while k < pa.count {
        va, sa = physics.ragdoll_animation_velocity(r, k)
        vb, sb = physics.ragdoll_bone_velocity(r, k)
        v = core.v3_lerp(va, vb, w[k])
        s = core.v3_lerp(sa, sb, w[k])
        moving[k * 6] = v.x
        moving[k * 6 + 1] = v.y
        moving[k * 6 + 2] = v.z
        moving[k * 6 + 3] = s.x
        moving[k * 6 + 4] = s.y
        moving[k * 6 + 5] = s.z
        // Off a blow's hold: the bodies' own state is the ragdoll's now.
        (pa.holds as float[])[k] = 0.0
        (pa.struck as int[])[k] = 0
        (pa.shares as float[])[k] = 0.0
        (pa.easing as int[])[k] = 0
        if physics.ragdoll_bone_is_own(r, k) { physics.ragdoll_set_bone_own(r, k, false) }
        if physics.ragdoll_bone_is_limp(r, k) { physics.ragdoll_set_bone_limp(r, k, false) }
        k = k + 1
    }
    // Its joints' motors on the pose drawn (physics.ragdoll_power: its
    // animation's pose is the rig's, which the paused animator leaves),
    // nothing holding it up: no balance. Powered, the figure is drawn from
    // the pose it was drawn in onto its bodies over the power's blend, where
    // they trail the pose at their anchors' strength. Put onto the pose
    // drawn instead, the bodies were pushed off it again by their joints in
    // the step (a forearm's roll its elbow's hinge does not have), and the
    // forearm was drawn turning 33 rad/s at a walk's death, 71 at a run's.
    physics.ragdoll_power(r, 0.0, 0.0)
    physics.ragdoll_set_balance_assist(r, 0.0)
    k = 1
    while k < pa.count {
        held = 0.0
        if seconds > 0.0 { held = (pa.muscles as float[])[k] }
        physics.ragdoll_set_bone_drive(r, k, held)
        k = k + 1
    }
    k = 0
    while k < pa.count {
        physics.ragdoll_set_bone_velocity(r, k, core.vec3(moving[k * 6], moving[k * 6 + 1], moving[k * 6 + 2]), core.vec3(moving[k * 6 + 3], moving[k * 6 + 4], moving[k * 6 + 5]))
        (pa.weights as float[])[k] = 1.0
        (pa.goals as float[])[k] = 1.0
        k = k + 1
    }
    free(moving as ptr)
    pa.limp = true
    pa.fall = seconds
    pa.fallen = 0.0
    pa.still_steps = 0
    return true
}

// Whether it is let go wholly (go_limp).
limp(pa: *Physanim) -> bool { return pa != null && pa.limp }

// A knockdown (#861): let go wholly as go_limp lets it go, but powered as
// it goes down rather than holding the pose it was drawn in, until it has
// landed (landing), then its muscles eased out over `seconds` and a
// ragdoll. Its legs give (FALL_LEGS of their muscle), a person's knees
// buckling under a blow rather than a statue toppling on locked ones. With
// `protect` it reaches for the ground (protect_step): each arm turned
// straight down toward the way it falls and a little out to its own side,
// on REACH_STRENGTH times its muscle, the head tucked away from the fall,
// coming in over FALL_IN as ae3d.motion's protective fall does; so its
// hands meet the ground first and take the trunk and head down slower.
// Knocked again while down, the blow alone (hit). False as go_limp is.
knock(pa: *Physanim, seconds: float, protect: bool) -> bool {
    if !go_limp(pa, seconds) { return false }
    pa.falling = true
    pa.protect = protect
    pa.fall_t = 0.0
    pa.low_steps = 0
    pa.caught_steps = 0
    pa.trunk_still = 0
    r = pa.ragdoll as *Ragdoll
    k = 1
    while k < pa.count {
        drive = (pa.muscles as float[])[k]
        if is_leg(k) { drive = drive * FALL_LEGS }
        physics.ragdoll_set_bone_drive(r, k, drive)
        k = k + 1
    }
    return true
}

// Whether it is going down, knocked (knock), not yet landed.
falling(pa: *Physanim) -> bool { return pa != null && pa.limp && pa.falling }

// Whether, knocked or let go wholly, it lies down: landed, and its pelvis
// and chest slower than REST_SPEED for DOWN_STEPS steps. What a get-up
// waits for (character.down).
down(pa: *Physanim) -> bool { return pa != null && pa.limp && !pa.falling && pa.trunk_still >= DOWN_STEPS }

is_leg(k: int) -> bool { return k == human.BONE_THIGH_L || k == human.BONE_CALF_L || k == human.BONE_THIGH_R || k == human.BONE_CALF_R || k >= human.BONE_COUNT }

// A knocked figure's fall, a fixed step: landed (on its back, front or
// side, or caught on its hands and knees and still), its aims let go and
// its muscles left to ease out (limp_step); else, protecting, reaching.
fall_step(pa: *Physanim, dt: float) {
    r = pa.ragdoll as *Ragdoll
    pa.fall_t = pa.fall_t + dt
    pelvis = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS)).y
    lowest = physics.ragdoll_pose_lowest(r, null)
    if pelvis - lowest < GROUNDED { pa.low_steps = pa.low_steps + 1 } else { pa.low_steps = 0 }
    hand = physics.ragdoll_pose_bone_lowest(r, null, human.BONE_LOWER_ARM_L)
    other = physics.ragdoll_pose_bone_lowest(r, null, human.BONE_LOWER_ARM_R)
    if other < hand { hand = other }
    trunk = physics.ragdoll_bone_speed(r, human.BONE_PELVIS)
    upper = physics.ragdoll_bone_speed(r, human.BONE_SPINE_03)
    if upper > trunk { trunk = upper }
    if hand - lowest < HAND_DOWN && trunk < CAUGHT_SPEED { pa.caught_steps = pa.caught_steps + 1 } else { pa.caught_steps = 0 }
    if pa.low_steps >= LAND_STEPS || pa.caught_steps >= CAUGHT_STEPS || pa.fall_t >= FALL_MOST {
        pa.falling = false
        pa.fallen = 0.0
        physics.ragdoll_clear_aims(r)
        return
    }
    if pa.protect { protect_step(pa) }
}

// The reach: each arm turned straight down toward the way the figure falls,
// a little out to its own side so the hands land apart, on REACH_STRENGTH
// times its muscle as it leans; the head tucked away from the fall. A
// straight arm takes the landing through its joints, where a bent one
// folds on its elbow's muscle (ae3d.motion's reach, #479).
protect_step(pa: *Physanim) {
    r = pa.ragdoll as *Ragdoll
    way = fall_way(r)
    if core.v3_len(way) < 0.5 { return }
    into = smooth(pa.fall_t / FALL_IN)
    reach_arm(pa, human.BONE_UPPER_ARM_L, human.BONE_LOWER_ARM_L, way, into)
    reach_arm(pa, human.BONE_UPPER_ARM_R, human.BONE_LOWER_ARM_R, way, into)
    across = core.v3_cross(core.vec3(0.0, 1.0, 0.0), way)
    if core.v3_len(across) > 0.001 {
        across = core.v3_normalize(across)
        physics.ragdoll_aim(r, human.BONE_NECK, core.quat_mul(core.quat_rotate(0.0 - TUCK * into, across), carried(r, human.BONE_NECK, human.BONE_SPINE_03)))
    }
}

reach_arm(pa: *Physanim, arm: int, forearm: int, way: Vec3, into: float) {
    r = pa.ragdoll as *Ragdoll
    shoulder = behaviour.object_position(physics.ragdoll_bone(r, arm))
    chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
    side = core.v3_sub(shoulder, chest)
    side = core.vec3(side.x, 0.0, side.z)
    if core.v3_len(side) > 0.001 { side = core.v3_normalize(side) }
    want = core.v3_normalize(core.vec3(way.x + side.x * 0.3, 0.0 - REACH_DOWN, way.z + side.z * 0.3))
    aim_coming(r, arm, want, into)
    aim_coming(r, forearm, want, into)
    strength = 1.0 + (REACH_STRENGTH - 1.0) * into
    physics.ragdoll_set_bone_drive(r, arm, (pa.muscles as float[])[arm] * strength)
    physics.ragdoll_set_bone_drive(r, forearm, (pa.muscles as float[])[forearm] * strength)
}

// The way the figure falls, level: where its pelvis's up leans to (the
// figure's up, not the pelvis body's +y, which the reference's pelvis has
// turned a half turn about x). Zero while it hardly leans.
fall_way(r: *Ragdoll) -> Vec3 {
    rest = human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q
    up = core.quat_apply(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS), core.quat_apply(core.quat_conjugate(rest), core.vec3(0.0, 1.0, 0.0)))
    way = core.vec3(up.x, 0.0, up.z)
    if core.v3_len(way) < 0.05 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(way)
}

// A bone aimed `into` (0 to 1) of the way from where it points now to `want`.
aim_coming(r: *Ragdoll, k: int, want: Vec3, into: float) {
    now = physics.ragdoll_bone_rotation(r, k)
    points = core.quat_apply(now, physics.ragdoll_bone_axis(r, k))
    toward = core.v3_add(points, core.v3_mul(core.v3_sub(want, points), into))
    if core.v3_len(toward) < 0.001 { toward = want }
    physics.ragdoll_aim(r, k, core.quat_mul(core.quat_from_to(points, core.v3_normalize(toward)), now))
}

// Where body `k` would be held at its rest pose to body `by` as `by` is now.
carried(r: *Ragdoll, k: int, by: int) -> Quat {
    h = physics.ragdoll_human(r)
    by_rest = human.bone_at(h, by).reference_frame.q
    rest = human.bone_at(h, k).reference_frame.q
    return core.quat_normalize(core.quat_mul(physics.ragdoll_bone_rotation(r, by), core.quat_mul(core.quat_conjugate(by_rest), rest)))
}

// Taken back from lying let go wholly (knock, go_limp): its bodies on the
// animation again, each on its mode at the weight it is set to, its aims
// and held shape let go. What a get-up does once the pose it lies in is read
// (character.get_up).
unlimp(pa: *Physanim) {
    r = pa.ragdoll as *Ragdoll
    pa.limp = false
    pa.falling = false
    pa.still_steps = 0
    pa.trunk_still = 0
    physics.ragdoll_clear_aims(r)
    physics.ragdoll_let_go_shape(r)
    physics.ragdoll_follow(r)
    k = 0
    while k < pa.count {
        set_weight(pa, k, (pa.bases as float[])[k], 0.0)
        k = k + 1
    }
}

// Whether, let go wholly, it has come to rest: every body slower than
// REST_SPEED for REST_STEPS steps.
at_rest(pa: *Physanim) -> bool { return pa != null && pa.limp && pa.still_steps >= REST_STEPS }

// A fixed step let go wholly: its muscles easing out, then a ragdoll; and
// whether it lies still.
limp_step(pa: *Physanim, dt: float) {
    r = pa.ragdoll as *Ragdoll
    // Falling and lying, the arms meet the hips and thighs again
    // (physics.ragdoll_free_flanks): passing them, an arm went through the
    // hip it fell on.
    physics.ragdoll_free_flanks(r, false)
    // Knocked, powered as it goes down until it lands (fall_step).
    if pa.falling { fall_step(pa, dt) }
    // Powered until its muscles have eased out and its drawing is on its
    // bodies (LIMP_BLEND), then a ragdoll.
    lasts = pa.fall
    if lasts < LIMP_BLEND { lasts = LIMP_BLEND }
    if !pa.falling && pa.fallen < lasts {
        pa.fallen = pa.fallen + dt
        if pa.fallen >= lasts {
            physics.ragdoll_release(r)
        } else if pa.fall > 0.0 {
            left = 1.0 - smooth(pa.fallen / pa.fall)
            k = 1
            while k < pa.count {
                physics.ragdoll_set_bone_drive(r, k, (pa.muscles as float[])[k] * left)
                k = k + 1
            }
        }
    }
    still = true
    k = 0
    while k < pa.count {
        if physics.ragdoll_bone_speed(r, k) >= REST_SPEED { still = false }
        k = k + 1
    }
    if still { pa.still_steps = pa.still_steps + 1 } else { pa.still_steps = 0 }
    if physics.ragdoll_bone_speed(r, human.BONE_PELVIS) < REST_SPEED && physics.ragdoll_bone_speed(r, human.BONE_SPINE_03) < REST_SPEED {
        pa.trunk_still = pa.trunk_still + 1
    } else {
        pa.trunk_still = 0
    }
}

set_mode(pa: *Physanim, k: int, mode: int) {
    if k < 0 || k >= pa.count || mode < MODE_KINEMATIC || mode > MODE_SIMULATED { return }
    (pa.modes as int[])[k] = mode
    limp_by(pa, k)
}

mode_of(pa: *Physanim, k: int) -> int { return (pa.modes as int[])[k] }

profile_count(pa: *Physanim) -> int { return list.size(pa.profiles) }

// The profile named `name`, made if there is none: as "animated" is (the
// hips and legs kinematic, the rest driven at the anchors' own strength,
// every body drawn at weight 0), or, making "animated", every body driven.
profile_add(pa: *Physanim, name: string) -> int {
    found = profile_find(pa, name)
    if found >= 0 { return found }
    p = heap.new(Profile)
    p.name = string.copy(name)
    p.modes = calloc(pa.count, 4)
    p.pins = calloc(pa.count * 3, 8)
    p.weights = calloc(pa.count, 8)
    p.gives = calloc(pa.count, 8)
    p.muscles = calloc(pa.count, 8)
    k = 0
    while k < pa.count {
        (p.modes as int[])[k] = MODE_DRIVEN
        (p.gives as float[])[k] = body_give(body_name(k))
        (p.muscles as float[])[k] = body_muscle(body_name(k))
        k = k + 1
    }
    if list.size(pa.profiles) > 0 {
        first = list.get_raw(pa.profiles, 0) as *Profile
        k = 0
        while k < pa.count {
            (p.modes as int[])[k] = (first.modes as int[])[k]
            (p.weights as float[])[k] = (first.weights as float[])[k]
            (p.gives as float[])[k] = (first.gives as float[])[k]
            (p.muscles as float[])[k] = (first.muscles as float[])[k]
            j = 0
            while j < 3 {
                (p.pins as float[])[k * 3 + j] = (first.pins as float[])[k * 3 + j]
                j = j + 1
            }
            k = k + 1
        }
    }
    list.add_raw(pa.profiles, p as ptr)
    return list.size(pa.profiles) - 1
}

// The profile named `name`, or -1.
profile_find(pa: *Physanim, name: string) -> int {
    i = 0
    while i < list.size(pa.profiles) {
        if string.equals((list.get_raw(pa.profiles, i) as *Profile).name, name) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// In profile `profile`, body `k` moved by `mode`, its anchor at `hertz`
// (0: the anchors' own) within `max_force` newtons and `max_torque` newton
// metres (0: no bound), and drawn at `weight`.
profile_set(pa: *Physanim, profile: int, k: int, mode: int, hertz: float, max_force: float, max_torque: float, weight: float) {
    if profile < 0 || profile >= list.size(pa.profiles) || k < 0 || k >= pa.count { return }
    p = list.get_raw(pa.profiles, profile) as *Profile
    (p.modes as int[])[k] = mode
    pins = p.pins as float[]
    pins[k * 3] = hertz
    pins[k * 3 + 1] = max_force
    pins[k * 3 + 2] = max_torque
    (p.weights as float[])[k] = core.clampf(weight, 0.0, 1.0)
}

// As profile_set, for body `k` and every body below it (an arm from its
// shoulder, the trunk and all from the hips), as Unreal's profiles are
// applied below a bone.
profile_set_below(pa: *Physanim, profile: int, k: int, mode: int, hertz: float, max_force: float, max_torque: float, weight: float) {
    j = 0
    while j < pa.count {
        if below(pa, j, k) { profile_set(pa, profile, j, mode, hertz, max_force, max_torque, weight) }
        j = j + 1
    }
}

// In profile `profile`, body `k` (and with `all_below` every body below it)
// let go wholly by a blow of `give` newton seconds, and driven toward its
// pose by `muscle` newton metres while a blow lets it go in part or the
// figure falls (go_limp); a value of 0 or less leaves it as it is.
profile_set_hit(pa: *Physanim, profile: int, k: int, give: float, muscle: float, all_below: bool) {
    if profile < 0 || profile >= list.size(pa.profiles) || k < 0 || k >= pa.count { return }
    p = list.get_raw(pa.profiles, profile) as *Profile
    j = 0
    while j < pa.count {
        if j == k || (all_below && below(pa, j, k)) {
            if give > 0.0 { (p.gives as float[])[j] = give }
            if muscle > 0.0 { (p.muscles as float[])[j] = muscle }
        }
        j = j + 1
    }
}

// Whether body `j` is `k` or hangs from it.
below(pa: *Physanim, j: int, k: int) -> bool {
    parents = pa.parents as int[]
    at = j
    while at >= 0 {
        if at == k { return true }
        at = parents[at]
    }
    return false
}

// Every body to profile `profile`: its mode and its anchor's strength at
// once, its weight eased there over `seconds`. A hit holding a body is let
// go of; the profile is what it is now.
apply_profile(pa: *Physanim, profile: int, seconds: float) {
    if profile < 0 || profile >= list.size(pa.profiles) { return }
    p = list.get_raw(pa.profiles, profile) as *Profile
    r = pa.ragdoll as *Ragdoll
    pins = p.pins as float[]
    k = 0
    while k < pa.count {
        (pa.modes as int[])[k] = (p.modes as int[])[k]
        (pa.gives as float[])[k] = (p.gives as float[])[k]
        (pa.muscles as float[])[k] = (p.muscles as float[])[k]
        physics.ragdoll_set_bone_pin(r, k, pins[k * 3], pins[k * 3 + 1], pins[k * 3 + 2])
        set_weight(pa, k, (p.weights as float[])[k], seconds)
        k = k + 1
    }
}

// Profiles from a file, added to the figure's (a name already there is
// set again). A line each, # a comment:
//
//     profile guard
//     body Chest driven hertz 12 weight 0.2
//     below ShoulderL driven hertz 3 force 400 torque 60 weight 0.5
//     body Neck kinematic
//     below ElbowR simulated weight 1
//
//     below ShoulderL driven give 15 muscle 120
//
// `body` sets one body, `below` it and every body below it; the mode is
// kinematic, driven or simulated, and hertz, force, torque and weight
// follow as they are wanted (0 hertz, force and torque, and weight, by
// default), and a blow's give and the body's muscle (profile_set_hit; a
// person's by default). A profile starts as "animated" is. False on a line
// it cannot read (error() says which).
profiles_read(pa: *Physanim, path: string) -> bool {
    g_error = ""
    content, err = fs.read(path)
    if err != "" {
        g_error = "cannot read ${path}"
        return false
    }
    lines = string.split(content, "\n")
    count = string.array_size(lines)
    profile = 0 - 1
    good = true
    i = 0
    while i < count && good {
        line = string.trim(field(lines, i))
        i = i + 1
        if string.length(line) == 0 || string.char_at(line, 0) == 35 { continue }
        words = string.split(line, " ")
        n = word_count(words)
        first = word(words, 0)
        if string.equals(first, "profile") == 1 && n == 2 {
            profile = profile_add(pa, word(words, 1))
        } else if (string.equals(first, "body") == 1 || string.equals(first, "below") == 1) && n >= 3 && profile >= 0 {
            good = body_line(pa, profile, words, n, string.equals(first, "below") == 1, i)
        } else {
            g_error = "${path}:${i}: `${line}` is no profile line"
            good = false
        }
        string.array_free(words)
    }
    string.array_free(lines)
    string.free(content)
    return good
}

body_line(pa: *Physanim, profile: int, words: ptr, n: int, all_below: bool, line: int) -> bool {
    name = word(words, 1)
    k = bone_named(pa, name)
    if k < 0 {
        g_error = "line ${line}: no body `${name}`"
        return false
    }
    mode_word = word(words, 2)
    mode = 0 - 1
    if string.equals(mode_word, "kinematic") == 1 { mode = MODE_KINEMATIC }
    if string.equals(mode_word, "driven") == 1 { mode = MODE_DRIVEN }
    if string.equals(mode_word, "simulated") == 1 { mode = MODE_SIMULATED }
    if mode < 0 {
        g_error = "line ${line}: `${mode_word}` is not kinematic, driven or simulated"
        return false
    }
    hertz = 0.0
    most_force = 0.0
    most_torque = 0.0
    weight = 0.0
    give = 0.0
    muscle = 0.0
    w = 3
    while w + 1 < n {
        key = word(words, w)
        value, bad = string.to_float(word(words, w + 1))
        if bad != "" {
            g_error = "line ${line}: `${word(words, w + 1)}` is not a number"
            return false
        }
        if string.equals(key, "hertz") == 1 {
            hertz = value
        } else if string.equals(key, "force") == 1 {
            most_force = value
        } else if string.equals(key, "torque") == 1 {
            most_torque = value
        } else if string.equals(key, "weight") == 1 {
            weight = value
        } else if string.equals(key, "give") == 1 {
            give = value
        } else if string.equals(key, "muscle") == 1 {
            muscle = value
        } else {
            g_error = "line ${line}: `${key}` is not hertz, force, torque, weight, give or muscle"
            return false
        }
        w = w + 2
    }
    if w < n {
        g_error = "line ${line}: `${word(words, w)}` has no value"
        return false
    }
    if all_below {
        profile_set_below(pa, profile, k, mode, hertz, most_force, most_torque, weight)
    } else {
        profile_set(pa, profile, k, mode, hertz, most_force, most_torque, weight)
    }
    profile_set_hit(pa, profile, k, give, muscle, all_below)
    return true
}

// std.string hands back a borrowed C string as a `ptr`; returned from a
// function declared `-> string` it is one.
field(fields: ptr, index: int) -> string { return string.array_get(fields, index) }

// A line's words, split on spaces: the runs of them leave empty fields,
// which are skipped.
word_count(fields: ptr) -> int {
    count = 0
    i = 0
    while i < string.array_size(fields) {
        if string.length(field(fields, i)) > 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

word(fields: ptr, index: int) -> string {
    seen = 0
    i = 0
    while i < string.array_size(fields) {
        value = field(fields, i)
        if string.length(value) > 0 {
            if seen == index { return value }
            seen = seen + 1
        }
        i = i + 1
    }
    return ""
}

// --- whole state (#911) -----------------------------------------------------------------------------

// Floats state_write writes for `pa`.
state_size(pa: *Physanim) -> int { return 22 + pa.count * (24 + 3 * physics.POSE_STRIDE) }

// Everything it carries from one step to the next, into `out` from `at`
// (its bodies' places are the ragdoll's, its profiles the game's): each
// body's weight, its easing and hit, its blend and ease-in, and the three
// poses it draws between, so a copy of the figure on another peer takes a
// blow, eases back and lets go as this one does (ae3d.netanim). Returns
// where it ended.
state_write(pa: *Physanim, out: float[], at: int) -> int {
    n = at
    floats = [pa.weights, pa.froms, pa.goals, pa.times, pa.gone, pa.holds, pa.bases, pa.gives, pa.muscles, pa.shares, pa.was_w, pa.ease_t]
    k = 0
    while k < 12 {
        n = put_floats(out, n, floats[k], pa.count)
        k = k + 1
    }
    ints = [pa.modes, pa.struck, pa.easing]
    k = 0
    while k < 3 {
        a = ints[k] as int[]
        j = 0
        while j < pa.count {
            out[n + j] = a[j] as float
            j = j + 1
        }
        n = n + pa.count
        k = k + 1
    }
    n = put_floats(out, n, pa.ease_q, pa.count * 4)
    n = put_floats(out, n, pa.ease_p, pa.count * 3)
    n = put_floats(out, n, pa.anim, pa.count * physics.POSE_STRIDE)
    n = put_floats(out, n, pa.body, pa.count * physics.POSE_STRIDE)
    n = put_floats(out, n, pa.shown, pa.count * physics.POSE_STRIDE)
    s = [pa.hold, pa.recover, pa.hits as float, flag(pa.was_fixed), flag(pa.released), pa.spread, pa.least, flag(pa.limp), pa.fall, pa.fallen, pa.still_steps as float,
         flag(pa.falling), flag(pa.protect), pa.fall_t, pa.low_steps as float, pa.caught_steps as float, pa.trunk_still as float]
    k = 0
    while k < 17 {
        out[n + k] = s[k]
        k = k + 1
    }
    return n + 17
}

// A state state_write wrote, from `at`; returns where it ended.
state_read(pa: *Physanim, s: float[], at: int) -> int {
    n = at
    floats = [pa.weights, pa.froms, pa.goals, pa.times, pa.gone, pa.holds, pa.bases, pa.gives, pa.muscles, pa.shares, pa.was_w, pa.ease_t]
    k = 0
    while k < 12 {
        n = get_floats(s, n, floats[k], pa.count)
        k = k + 1
    }
    ints = [pa.modes, pa.struck, pa.easing]
    k = 0
    while k < 3 {
        a = ints[k] as int[]
        j = 0
        while j < pa.count {
            a[j] = s[n + j] as int
            j = j + 1
        }
        n = n + pa.count
        k = k + 1
    }
    n = get_floats(s, n, pa.ease_q, pa.count * 4)
    n = get_floats(s, n, pa.ease_p, pa.count * 3)
    n = get_floats(s, n, pa.anim, pa.count * physics.POSE_STRIDE)
    n = get_floats(s, n, pa.body, pa.count * physics.POSE_STRIDE)
    n = get_floats(s, n, pa.shown, pa.count * physics.POSE_STRIDE)
    pa.hold = s[n]
    pa.recover = s[n + 1]
    pa.hits = s[n + 2] as int
    pa.was_fixed = s[n + 3] > 0.5
    pa.released = s[n + 4] > 0.5
    pa.spread = s[n + 5]
    pa.least = s[n + 6]
    pa.limp = s[n + 7] > 0.5
    pa.fall = s[n + 8]
    pa.fallen = s[n + 9]
    pa.still_steps = s[n + 10] as int
    // A knockdown's fall (knock): a copy knocked down goes on falling,
    // reaching and landing as this one does.
    pa.falling = s[n + 11] > 0.5
    pa.protect = s[n + 12] > 0.5
    pa.fall_t = s[n + 13]
    pa.low_steps = s[n + 14] as int
    pa.caught_steps = s[n + 15] as int
    pa.trunk_still = s[n + 16] as int
    return n + 17
}

put_floats(out: float[], at: int, p: ptr, count: int) -> int {
    a = p as float[]
    k = 0
    while k < count {
        out[at + k] = a[k]
        k = k + 1
    }
    return at + count
}

get_floats(s: float[], at: int, p: ptr, count: int) -> int {
    a = p as float[]
    k = 0
    while k < count {
        a[k] = s[at + k]
        k = k + 1
    }
    return at + count
}

flag(b: bool) -> float {
    if b { return 1.0 }
    return 0.0
}
