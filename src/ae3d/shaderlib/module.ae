// ae3d.shaderlib: what a shader written with `quote` is written against.
//
// A quoted shader (ae3d.shaders.fxaa) is ordinary Aether to the compiler:
// it type-checks its body against the functions and types here, and hands
// ae3d.gpu the tree, every node carrying the type it was given. So these are
// declared once, as GLSL has them, and the tree's types are GLSL's:
//
//   - vec2, vec3 and vec4 are distinct types over f32x4: they keep its
//     arithmetic, and a vec3 added to a vec4 is a type error, as in GLSL;
//   - Texture is what a sampler2D is in a shader: captured, it becomes the
//     shader's sampler binding; TextureMS is a sampler2DMS, a multisampled
//     image, read only a sample at a time (texel_fetch_ms);
//   - texture, dot, min, max, abs, sign, clamp, smoothstep, mix, fract,
//     floor and the constructors are GLSL's builtins, and rgb(c) is c.rgb and
//     xy(c) c.xy (a swizzle of more than one lane is not an Aether field);
//   - mat4 is GLSL's mat4, four vec4 columns, std140's layout; mul(m, v) is
//     m * v, the matrix applied to a vector (a captured matrix: the camera's);
//   - depth_clip(d) is a stored depth (0..1) as clip-space z, and
//     screen_y_sign() 1 where the screen's y runs up, -1 where it runs down:
//     each the dialect's own in GLSL (OpenGL's z runs -1..1 and its y up,
//     Vulkan's z is 0..1 and its y down); run as plain Aether, Vulkan's;
//   - a builtin GLSL overloads has a name for each further signature, by the
//     naming convention (Nic's option A): min_v3 is min of two vec3s, and
//     max_v3, clamp_v3, mix_v3 (two vec3s and a float) and length_v2 the
//     same; each is GLSL's one name in ae3d.gpu's call table;
//   - frag_coord() is gl_FragCoord.xy, the pixel being drawn (its centre:
//     x + 0.5, y + 0.5), and texel_fetch(t, p) is texelFetch(t, ivec2(p),
//     0), the one texel at pixel p, unfiltered; texel_fetch_ms(t, p, s) is
//     texelFetch(t, ivec2(p), s), sample s of it. Run as plain Aether, the
//     pixel is the one set_frag_coord names: there is no rasteriser to say.
//
// Their bodies are what each means, in f32x4, so a quote's body runs as
// plain Aether too (tests/test_gpu.ae runs FXAA that way, as the reference
// the CPU evaluator is held to). ae3d.gpu's evaluator does not call them: it
// works in doubles, over every overload GLSL has (Aether has no overloading,
// so each builtin here takes the one signature its shaders use: min and max
// of floats, vec4 of a vec3 and a float).
//
//   - Texture3D is a sampler3D, read by texture_3d(t, p) (GLSL's texture),
//     its ShaderImage3D trilinear across the slices and wrapped at the
//     edges, as the clouds' tileable noise is sampled (a REPEAT sampler);
//   - mul_m4(a, b) is a * b of two matrices, m4_at(m, c, r) is m[c][r] and
//     mul_transpose3(m, v) transpose(mat3(m)) * v: a view's turn taken back;
//   - splat2/3/4(x) are vec2/3/4(x), every lane x.
//   - vec3_xv(x, v) is vec3(x, v), a float then a vec2's lanes;
//   - mat2 is GLSL's mat2, two vec2 columns in four lanes (a local, never a
//     uniform here): mat2_of(a, b, c, d) is mat2(a, b, c, d), columns (a, b)
//     and (c, d), and mul_m2(m, v) is m * v (the water's turned octaves).
//
// A ShaderImage is a picture on the CPU for texture() to read: RGBA in
// doubles, read bilinearly with texel centres at (i + 0.5) / size, the
// weights to 1/256 of a texel and clamped at the edges, as a GPU's linear
// clamp-to-edge sampler reads. A ShaderImageMS is a multisampled one, a
// ShaderImage a sample.

import std.lanes

exports (
    vec2, vec3, vec4, mat4, Texture, TextureMS, Texture3D, ShaderImage, ShaderImageMS, ShaderImage3D,
    texture, rgb, xy, dot, min, max, abs, sign, clamp, smoothstep, mix, fract, floor,
    min_v3, max_v3, clamp_v3, mix_v3, length_v2, mul, mat4_of, zero_mat4,
    xyz, dot_v2, normalize, cross, distance, sqrt, sin, cos, depth_clip, screen_y_sign,
    texture_size, floor_v2, fract_v2, clamp_v2, length_v3, reflect, pow,
    texture_lod, texel_fetch_lod, log2, image_mip_chain, image_level, float_of, zx, yx, abs_v2,
    uint_of, float_of_uint,
    frag_coord, texel_fetch, texel_fetch_ms, set_frag_coord,
    image_new, image_set, image_channel, image_w, image_h, image_free, texture_of,
    image_ms_new, image_ms_sample, image_ms_samples, image_ms_free, texture_ms_of,
    image3d_new, image3d_set, image3d_channel, image3d_free, texture3d_of, texture_3d,
    exp, acos, asin, atan2, tan, floor_v3, splat2, splat3, splat4, mix_v4, mul_m4, m4_at, mul_transpose3,
    normalize_v2, xz, mat2, mat2_of, mul_m2, fract_v3, vec3_xv
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
@extern("sqrt") c_sqrt(x: float) -> float
@extern("sin") c_sin(x: float) -> float
@extern("cos") c_cos(x: float) -> float
@extern("pow") c_pow(x: float, y: float) -> float
@extern("log2") c_log2(x: float) -> float
@extern("exp") c_exp(x: float) -> float
@extern("acos") c_acos(x: float) -> float
@extern("asin") c_asin(x: float) -> float
@extern("atan2") c_atan2(y: float, x: float) -> float
@extern("tan") c_tan(x: float) -> float

type vec2 = distinct f32x4
type vec3 = distinct f32x4
type vec4 = distinct f32x4
// A 2x2 matrix: lanes x and y its first column, z and w its second.
type mat2 = distinct f32x4

// A 4x4 matrix as GLSL holds one: four columns, each a vec4, so its 64
// bytes are std140's mat4 as they are.
struct mat4 {
    c0: vec4
    c1: vec4
    c2: vec4
    c3: vec4
}

// A texture a shader samples. `image` is what texture() reads on the CPU;
// a renderer binds the texture it draws from at the sampler's binding.
struct Texture {
    image: ptr       // *ShaderImage
}

struct ShaderImage {
    w: int
    h: int
    px: ptr          // w * h * 4 doubles, RGBA
    levels: int      // its mips, level 0 itself; 1 until image_mip_chain
    mips: ptr        // *ShaderImage[levels]: [0] the image, then each half
}

// A multisampled texture a shader reads a sample at a time. `image` is the
// *ShaderImageMS texel_fetch_ms() reads on the CPU.
struct TextureMS {
    image: ptr       // *ShaderImageMS
}

struct ShaderImageMS {
    samples: int
    images: ptr      // *ShaderImage[samples], one picture a sample
}

// A 3D texture a shader samples (a sampler3D): `image` is the
// *ShaderImage3D texture_3d() reads on the CPU.
struct Texture3D {
    image: ptr       // *ShaderImage3D
}

struct ShaderImage3D {
    w: int
    h: int
    d: int
    px: ptr          // w * h * d * 4 doubles, RGBA, x fastest, then y, then z
}

texture_of(img: *ShaderImage) -> Texture { return Texture { image: img as ptr } }
texture3d_of(img: *ShaderImage3D) -> Texture3D { return Texture3D { image: img as ptr } }

// A 3D picture, w by h by d, every texel transparent black.
image3d_new(w: int, h: int, d: int) -> *ShaderImage3D {
    img = calloc(1, sizeof(ShaderImage3D)) as *ShaderImage3D
    img.w = w
    img.h = h
    img.d = d
    img.px = calloc(w * h * d * 4, 8)
    return img
}
image3d_set(img: *ShaderImage3D, x: int, y: int, z: int, r: float, g: float, b: float, a: float) {
    at = ((z * img.h + y) * img.w + x) * 4
    p = img.px as float[]
    p[at] = r
    p[at + 1] = g
    p[at + 2] = b
    p[at + 3] = a
}
// Channel `c` of the texel at x, y, z.
image3d_channel(img: *ShaderImage3D, x: int, y: int, z: int, c: int) -> float {
    return (img.px as float[])[((z * img.h + y) * img.w + x) * 4 + c]
}
image3d_free(img: *ShaderImage3D) {
    if img == null { return }
    free(img.px)
    free(img as ptr)
}
texture_ms_of(img: *ShaderImageMS) -> TextureMS { return TextureMS { image: img as ptr } }

image_new(w: int, h: int) -> *ShaderImage {
    img = calloc(1, sizeof(ShaderImage)) as *ShaderImage
    img.w = w
    img.h = h
    img.px = calloc(w * h * 4, 8)
    img.levels = 1
    k = 0
    while k < w * h {
        (img.px as float[])[k * 4 + 3] = 1.0
        k = k + 1
    }
    return img
}
image_set(img: *ShaderImage, x: int, y: int, r: float, g: float, b: float, a: float) {
    at = (y * img.w + x) * 4
    p = img.px as float[]
    p[at] = r
    p[at + 1] = g
    p[at + 2] = b
    p[at + 3] = a
}
// Channel `c` (0 red .. 3 alpha) of the pixel at x, y.
image_channel(img: *ShaderImage, x: int, y: int, c: int) -> float {
    return (img.px as float[])[(y * img.w + x) * 4 + c]
}
image_w(img: *ShaderImage) -> int { return img.w }
image_h(img: *ShaderImage) -> int { return img.h }
image_free(img: *ShaderImage) {
    if img == null { return }
    if img.mips != null {
        k = 1
        while k < img.levels {
            sub = (img.mips as ptr[])[k] as *ShaderImage
            free(sub.px)
            free(sub as ptr)
            k = k + 1
        }
        free(img.mips)
    }
    free(img.px)
    free(img as ptr)
}

// The image's mips made, `levels` of them counting itself: each half the
// one above, a texel the mean of the four it covers -- a linear blit's
// halving of a power-of-two image, as the GPU's mip chains are made
// (vktexture.mip_chain). A side of one stays one.
image_mip_chain(img: *ShaderImage, levels: int) {
    if img == null || levels < 1 || img.mips != null { return }
    img.mips = calloc(levels, 8)
    (img.mips as ptr[])[0] = img as ptr
    img.levels = levels
    above = img
    k = 1
    while k < levels {
        w = above.w / 2
        h = above.h / 2
        if w < 1 { w = 1 }
        if h < 1 { h = 1 }
        sub = image_new(w, h)
        y = 0
        while y < h {
            x = 0
            while x < w {
                xa = clampi(x * 2, above.w - 1)
                xb = clampi(x * 2 + 1, above.w - 1)
                ya = clampi(y * 2, above.h - 1)
                yb = clampi(y * 2 + 1, above.h - 1)
                c = 0
                while c < 4 {
                    v = (image_channel(above, xa, ya, c) + image_channel(above, xb, ya, c) +
                         image_channel(above, xa, yb, c) + image_channel(above, xb, yb, c)) * 0.25
                    (sub.px as float[])[(y * w + x) * 4 + c] = v
                    c = c + 1
                }
                x = x + 1
            }
            y = y + 1
        }
        (img.mips as ptr[])[k] = sub as ptr
        above = sub
        k = k + 1
    }
}

// Level `k` of the image's mips (clamped to those it has).
image_level(img: *ShaderImage, k: int) -> *ShaderImage {
    if img.mips == null || k <= 0 { return img }
    if k >= img.levels { return (img.mips as ptr[])[img.levels - 1] as *ShaderImage }
    return (img.mips as ptr[])[k] as *ShaderImage
}

// A multisampled picture of `samples` samples, each w by h, as image_new
// makes one.
image_ms_new(w: int, h: int, samples: int) -> *ShaderImageMS {
    ms = calloc(1, sizeof(ShaderImageMS)) as *ShaderImageMS
    ms.samples = samples
    ms.images = calloc(samples, 8)          // a pointer each
    s = 0
    while s < samples {
        (ms.images as ptr[])[s] = image_new(w, h) as ptr
        s = s + 1
    }
    return ms
}
// Sample `s`'s picture, for image_set and image_channel.
image_ms_sample(ms: *ShaderImageMS, s: int) -> *ShaderImage { return (ms.images as ptr[])[s] as *ShaderImage }
image_ms_samples(ms: *ShaderImageMS) -> int { return ms.samples }
image_ms_free(ms: *ShaderImageMS) {
    if ms == null { return }
    s = 0
    while s < ms.samples {
        image_free(image_ms_sample(ms, s))
        s = s + 1
    }
    free(ms.images)
    free(ms as ptr)
}

// ── Constructors ───────────────────────────────────────────────────────

vec2(x: float, y: float) -> vec2 { return lanes.f32x4(x, y, 0.0, 0.0) as vec2 }
vec3(x: float, y: float, z: float) -> vec3 { return lanes.f32x4(x, y, z, 0.0) as vec3 }
vec4(c: vec3, w: float) -> vec4 {
    v = c as f32x4
    return lanes.f32x4(v.x, v.y, v.z, w) as vec4
}
rgb(c: vec4) -> vec3 {
    v = c as f32x4
    return lanes.f32x4(v.x, v.y, v.z, 0.0) as vec3
}

// A mat4 of sixteen doubles in column order (ae3d.core's Mat4's).
mat4_of(m: ptr) -> mat4 {
    d = m as float[]
    return mat4 {
        c0: lanes.f32x4(d[0], d[1], d[2], d[3]) as vec4,
        c1: lanes.f32x4(d[4], d[5], d[6], d[7]) as vec4,
        c2: lanes.f32x4(d[8], d[9], d[10], d[11]) as vec4,
        c3: lanes.f32x4(d[12], d[13], d[14], d[15]) as vec4
    }
}

// A mat4 of zeros, for a shader built before its matrix is known.
zero_mat4() -> mat4 {
    z = lanes.splat4(0.0) as vec4
    return mat4 { c0: z, c1: z, c2: z, c3: z }
}

// m * v: each column weighed by its lane of v.
mul(m: mat4, v: vec4) -> vec4 {
    p = v as f32x4
    return ((m.c0 as f32x4) * lanes.splat4(p.x) + (m.c1 as f32x4) * lanes.splat4(p.y) +
            (m.c2 as f32x4) * lanes.splat4(p.z) + (m.c3 as f32x4) * lanes.splat4(p.w)) as vec4
}

xy(c: vec4) -> vec2 {
    v = c as f32x4
    return lanes.f32x4(v.x, v.y, 0.0, 0.0) as vec2
}

// ── Builtins ───────────────────────────────────────────────────────────

dot(a: vec3, b: vec3) -> float {
    p = (a as f32x4) * (b as f32x4)
    return p.x + p.y + p.z
}
min(a: float, b: float) -> float { return if a < b { a } else { b } }
max(a: float, b: float) -> float { return if a > b { a } else { b } }
abs(a: float) -> float { return if a < 0.0 { -a } else { a } }
sign(a: float) -> float {
    if a > 0.0 { return 1.0 }
    if a < 0.0 { return -1.0 }
    return 0.0
}
clamp(x: float, lo: float, hi: float) -> float { return min(max(x, lo), hi) }
smoothstep(e0: float, e1: float, x: float) -> float {
    t = clamp((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}
mix(a: float, b: float, t: float) -> float { return a * (1.0 - t) + b * t }
floor(x: float) -> float {
    t = (x as int) * 1.0
    if x < 0.0 && t != x { return t - 1.0 }
    return t
}
fract(x: float) -> float { return x - floor(x) }
sqrt(x: float) -> float { return c_sqrt(x) }
sin(x: float) -> float { return c_sin(x) }
cos(x: float) -> float { return c_cos(x) }

// Vulkan's: clip z is the stored depth, and the screen's y runs down.
depth_clip(d: float) -> float { return d }
screen_y_sign() -> float { return 0.0 - 1.0 }

xyz(c: vec4) -> vec3 {
    v = c as f32x4
    return lanes.f32x4(v.x, v.y, v.z, 0.0) as vec3
}
dot_v2(a: vec2, b: vec2) -> float {
    p = (a as f32x4) * (b as f32x4)
    return p.x + p.y
}
normalize(v: vec3) -> vec3 {
    p = v as f32x4
    inv = 1.0 / c_sqrt(p.x * p.x + p.y * p.y + p.z * p.z)
    return vec3(p.x * inv, p.y * inv, p.z * inv)
}
cross(a: vec3, b: vec3) -> vec3 {
    p = a as f32x4
    q = b as f32x4
    return vec3(p.y * q.z - p.z * q.y, p.z * q.x - p.x * q.z, p.x * q.y - p.y * q.x)
}
pow(x: float, y: float) -> float { return c_pow(x, y) }
floor_v2(v: vec2) -> vec2 {
    p = v as f32x4
    return vec2(floor(p.x), floor(p.y))
}
fract_v2(v: vec2) -> vec2 {
    p = v as f32x4
    return vec2(fract(p.x), fract(p.y))
}
clamp_v2(x: vec2, lo: vec2, hi: vec2) -> vec2 {
    p = x as f32x4
    a = lo as f32x4
    b = hi as f32x4
    return vec2(clamp(p.x, a.x, b.x), clamp(p.y, a.y, b.y))
}
length_v3(v: vec3) -> float {
    p = v as f32x4
    return c_sqrt(p.x * p.x + p.y * p.y + p.z * p.z)
}
// i reflected about the normal n: i - 2 dot(n, i) n.
reflect(i: vec3, n: vec3) -> vec3 {
    d = dot(n, i)
    return ((i as f32x4) - (n as f32x4) * lanes.splat4(2.0 * d)) as vec3
}
// The size of the picture behind `t`, in texels (textureSize(t, 0)).
texture_size(t: Texture) -> vec2 {
    img = t.image as *ShaderImage
    if img == null { return vec2(0.0, 0.0) }
    return vec2(img.w * 1.0, img.h * 1.0)
}

distance(a: vec3, b: vec3) -> float {
    d = (a as f32x4) - (b as f32x4)
    return c_sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
}

// The vector signatures, lane by lane.
min_v3(a: vec3, b: vec3) -> vec3 {
    p = a as f32x4
    q = b as f32x4
    return vec3(min(p.x, q.x), min(p.y, q.y), min(p.z, q.z))
}
max_v3(a: vec3, b: vec3) -> vec3 {
    p = a as f32x4
    q = b as f32x4
    return vec3(max(p.x, q.x), max(p.y, q.y), max(p.z, q.z))
}
clamp_v3(x: vec3, lo: vec3, hi: vec3) -> vec3 { return min_v3(max_v3(x, lo), hi) }
mix_v3(a: vec3, b: vec3, t: float) -> vec3 { return a * (1.0 - t) + b * t }
length_v2(v: vec2) -> float {
    p = v as f32x4
    return c_sqrt(p.x * p.x + p.y * p.y)
}

fn clampi(v: int, hi: int) -> int {
    if v < 0 { return 0 }
    if v > hi { return hi }
    return v
}

// The pixel frag_coord() reports when a shader's body runs as plain Aether.
var g_frag_x = 0.5
var g_frag_y = 0.5

set_frag_coord(x: float, y: float) {
    g_frag_x = x
    g_frag_y = y
}

// frag_coord(): the pixel being drawn, at its centre (gl_FragCoord.xy).
frag_coord() -> vec2 { return vec2(g_frag_x, g_frag_y) }

// texel_fetch(t, p): the texel of the ShaderImage behind `t` at pixel p,
// truncated toward zero as ivec2() truncates, unfiltered; clamped at the
// edges, where GLSL's texelFetch is undefined.
texel_fetch(t: Texture, pixel: vec2) -> vec4 {
    img = t.image as *ShaderImage
    if img == null { return lanes.splat4(0.0) as vec4 }
    p = pixel as f32x4
    x = clampi(p.x as int, img.w - 1)
    y = clampi(p.y as int, img.h - 1)
    return lanes.f32x4(image_channel(img, x, y, 0), image_channel(img, x, y, 1), image_channel(img, x, y, 2),
                       image_channel(img, x, y, 3)) as vec4
}

// texel_fetch_ms(t, p, s): sample s of the ShaderImageMS behind `t` at pixel
// p, as texel_fetch reads a texel; the sample clamped to the image's too.
texel_fetch_ms(t: TextureMS, pixel: vec2, sample: int) -> vec4 {
    ms = t.image as *ShaderImageMS
    if ms == null || ms.samples < 1 { return lanes.splat4(0.0) as vec4 }
    return texel_fetch(texture_of(image_ms_sample(ms, clampi(sample, ms.samples - 1))), pixel)
}

// texture(t, uv): the ShaderImage behind `t`, bilinear, clamped at the edges.
texture(t: Texture, uv: vec2) -> vec4 {
    img = t.image as *ShaderImage
    if img == null { return lanes.splat4(0.0) as vec4 }
    return bilinear(img, uv)
}

// textureLod(t, uv, lod): trilinear, the two levels about `lod` each read
// bilinearly and mixed by its fraction (to 1/256, as a sampler's is),
// `lod` clamped to the levels the image has.
texture_lod(t: Texture, uv: vec2, lod: float) -> vec4 {
    img = t.image as *ShaderImage
    if img == null { return lanes.splat4(0.0) as vec4 }
    top = (img.levels - 1) * 1.0
    l = clamp(lod, 0.0, top)
    k = floor(l) as int
    f = floor((l - k) * 256.0 + 0.5) / 256.0
    a = bilinear(image_level(img, k), uv) as f32x4
    if f <= 0.0 { return a as vec4 }
    b = bilinear(image_level(img, k + 1), uv) as f32x4
    return (a * lanes.splat4(1.0 - f) + b * lanes.splat4(f)) as vec4
}

// texelFetch(t, ivec2(x, y), int(level)): one texel of a level, unfiltered,
// clamped at its edges. Floats, each truncated as ivec2() and int() do: a
// quote has no cast, and a loop that counts in floats hands them over as
// they are.
texel_fetch_lod(t: Texture, x: float, y: float, level: float) -> vec4 {
    img = t.image as *ShaderImage
    if img == null { return lanes.splat4(0.0) as vec4 }
    m = image_level(img, level as int)
    xi = clampi(x as int, m.w - 1)
    yi = clampi(y as int, m.h - 1)
    return lanes.f32x4(image_channel(m, xi, yi, 0), image_channel(m, xi, yi, 1), image_channel(m, xi, yi, 2),
                       image_channel(m, xi, yi, 3)) as vec4
}

log2(x: float) -> float { return c_log2(x) }
exp(x: float) -> float { return c_exp(x) }
acos(x: float) -> float { return c_acos(x) }
asin(x: float) -> float { return c_asin(x) }
// atan(y, x), GLSL's two-argument arctangent.
atan2(y: float, x: float) -> float { return c_atan2(y, x) }
tan(x: float) -> float { return c_tan(x) }
floor_v3(v: vec3) -> vec3 {
    p = v as f32x4
    return vec3(floor(p.x), floor(p.y), floor(p.z))
}
splat2(x: float) -> vec2 { return lanes.f32x4(x, x, 0.0, 0.0) as vec2 }
splat3(x: float) -> vec3 { return lanes.f32x4(x, x, x, 0.0) as vec3 }
splat4(x: float) -> vec4 { return lanes.splat4(x) as vec4 }
mix_v4(a: vec4, b: vec4, t: float) -> vec4 { return ((a as f32x4) * lanes.splat4(1.0 - t) + (b as f32x4) * lanes.splat4(t)) as vec4 }
normalize_v2(v: vec2) -> vec2 {
    p = v as f32x4
    inv = 1.0 / c_sqrt(p.x * p.x + p.y * p.y)
    return vec2(p.x * inv, p.y * inv)
}
xz(v: vec3) -> vec2 {
    p = v as f32x4
    return vec2(p.x, p.z)
}

// vec3(x, v): a float and a vec2's two lanes.
vec3_xv(x: float, v: vec2) -> vec3 {
    p = v as f32x4
    return vec3(x, p.x, p.y)
}

fract_v3(v: vec3) -> vec3 {
    p = v as f32x4
    return vec3(fract(p.x), fract(p.y), fract(p.z))
}

// mat2(a, b, c, d): columns (a, b) and (c, d).
mat2_of(a: float, b: float, c: float, d: float) -> mat2 { return lanes.f32x4(a, b, c, d) as mat2 }

// m * v: each column weighed by its lane of v.
mul_m2(m: mat2, v: vec2) -> vec2 {
    c = m as f32x4
    p = v as f32x4
    return vec2(c.x * p.x + c.z * p.y, c.y * p.x + c.w * p.y)
}

// a * b: each column of b turned by a.
mul_m4(a: mat4, b: mat4) -> mat4 {
    return mat4 { c0: mul(a, b.c0), c1: mul(a, b.c1), c2: mul(a, b.c2), c3: mul(a, b.c3) }
}

// m[c][r]: column c's lane r.
m4_at(m: mat4, c: int, r: int) -> float {
    col = m.c0 as f32x4
    if c == 1 { col = m.c1 as f32x4 }
    if c == 2 { col = m.c2 as f32x4 }
    if c == 3 { col = m.c3 as f32x4 }
    if r == 0 { return col.x }
    if r == 1 { return col.y }
    if r == 2 { return col.z }
    return col.w
}

// transpose(mat3(m)) * v: lane i the dot of column i's first three with v.
mul_transpose3(m: mat4, v: vec3) -> vec3 {
    return vec3(dot(xyz(m.c0), v), dot(xyz(m.c1), v), dot(xyz(m.c2), v))
}

// texture(t, p) of a sampler3D: trilinear, wrapped at the edges.
texture_3d(t: Texture3D, p: vec3) -> vec4 {
    img = t.image as *ShaderImage3D
    if img == null { return lanes.splat4(0.0) as vec4 }
    q = p as f32x4
    fx = floor((q.x * img.w - 0.5) * 256.0 + 0.5) / 256.0
    fy = floor((q.y * img.h - 0.5) * 256.0 + 0.5) / 256.0
    fz = floor((q.z * img.d - 0.5) * 256.0 + 0.5) / 256.0
    x0 = floor(fx) as int
    y0 = floor(fy) as int
    z0 = floor(fz) as int
    tx = fx - x0
    ty = fy - y0
    tz = fz - z0
    xa = wrap(x0, img.w)
    xb = wrap(x0 + 1, img.w)
    ya = wrap(y0, img.h)
    yb = wrap(y0 + 1, img.h)
    za = wrap(z0, img.d)
    zb = wrap(z0 + 1, img.d)
    r = 0.0
    g = 0.0
    b = 0.0
    a = 0.0
    c = 0
    while c < 4 {
        near = (image3d_channel(img, xa, ya, za, c) * (1.0 - tx) + image3d_channel(img, xb, ya, za, c) * tx) * (1.0 - ty) +
               (image3d_channel(img, xa, yb, za, c) * (1.0 - tx) + image3d_channel(img, xb, yb, za, c) * tx) * ty
        far = (image3d_channel(img, xa, ya, zb, c) * (1.0 - tx) + image3d_channel(img, xb, ya, zb, c) * tx) * (1.0 - ty) +
              (image3d_channel(img, xa, yb, zb, c) * (1.0 - tx) + image3d_channel(img, xb, yb, zb, c) * tx) * ty
        v = near * (1.0 - tz) + far * tz
        if c == 0 { r = v } else if c == 1 { g = v } else if c == 2 { b = v } else { a = v }
        c = c + 1
    }
    return lanes.f32x4(r, g, b, a) as vec4
}

fn wrap(v: int, size: int) -> int {
    m = v % size
    if m < 0 { m = m + size }
    return m
}

// float(i): a whole number as a float. A call, since a quote has no cast.
float_of(i: int) -> float { return i * 1.0 }
// uint(x): a float as GLSL's uint, truncated toward zero; and float(u), a
// uint as the nearest float. Calls, since a quote has no cast.
uint_of(x: float) -> uint32 { return (x as long) as uint32 }
float_of_uint(u: uint32) -> float { return u * 1.0 }

// v.zx and v.yx: two lanes in another order.
zx(v: vec3) -> vec2 {
    p = v as f32x4
    return vec2(p.z, p.x)
}
yx(v: vec2) -> vec2 {
    p = v as f32x4
    return vec2(p.y, p.x)
}
abs_v2(v: vec2) -> vec2 {
    p = v as f32x4
    return vec2(abs(p.x), abs(p.y))
}

fn bilinear(img: *ShaderImage, uv: vec2) -> vec4 {
    u = uv as f32x4
    // The weights to 1/256 of a texel, as a GPU's sampler has them
    // (ae3d.gpu's SUBTEXEL says why that matters).
    fx = floor((u.x * img.w - 0.5) * 256.0 + 0.5) / 256.0
    fy = floor((u.y * img.h - 0.5) * 256.0 + 0.5) / 256.0
    x0 = floor(fx) as int
    y0 = floor(fy) as int
    tx = fx - x0
    ty = fy - y0
    xa = clampi(x0, img.w - 1)
    xb = clampi(x0 + 1, img.w - 1)
    ya = clampi(y0, img.h - 1)
    yb = clampi(y0 + 1, img.h - 1)
    r = 0.0
    g = 0.0
    b = 0.0
    a = 0.0
    c = 0
    while c < 4 {
        top = image_channel(img, xa, ya, c) * (1.0 - tx) + image_channel(img, xb, ya, c) * tx
        bottom = image_channel(img, xa, yb, c) * (1.0 - tx) + image_channel(img, xb, yb, c) * tx
        v = top * (1.0 - ty) + bottom * ty
        if c == 0 { r = v } else if c == 1 { g = v } else if c == 2 { b = v } else { a = v }
        c = c + 1
    }
    return lanes.f32x4(r, g, b, a) as vec4
}
