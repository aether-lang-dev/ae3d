// Vulkan backend.
//
// Feature for feature with the OpenGL backend, and running the same lighting
// model: the Vulkan shaders are generated from the OpenGL ones, so there is one
// source for the PBR pass rather than two that drift.
//
// The loader is opened at runtime, so a program built with this backend still
// starts where no driver exists: available() reports false and says why.

import std.list
import std.heap
import std.string
import ae3d.core
import ae3d.png
import ae3d.platform
import ae3d.rendering
import ae3d.vkscene
import ae3d.skin
import ae3d.shaders
import ae3d.vkmeter
import ae3d.vkreadback
import ae3d.vkoverlay
import ae3d.vktexture
import ae3d.vkmesh
import ae3d.vkdevice
import ae3d.vkrays
import ae3d.vkcrowd
import ae3d.posing
import ae3d.geometry
import ae3d.picture
import ae3d.lightgrid
import ae3d.cascades
import ae3d.lampshadows

exports (
    VKRenderer,
    renderer_new, renderer_free, backend,
    available, device_name, last_error,
    renderer_model_count, renderer_model, renderer_light_count, renderer_light, renderer_draw_calls, renderer_set_clear_color,
    renderer_shadow_ms, renderer_scene_ms, renderer_post_ms, renderer_stage_ms, STAGE_COUNT, stage_name, renderer_cpu_work_ms, renderer_post_active, renderer_program_binds, renderer_material_binds,
    renderer_set_normal_strength, renderer_set_occlusion_strength, renderer_set_capture_channel, renderer_set_wetness, renderer_set_frame_exposure, renderer_set_meter, renderer_meter, renderer_material_texture_size,
    renderer_load_texture, renderer_release_texture, renderer_sample_count, renderer_set_post,
    renderer_set_bloom_intensity, renderer_bloom_intensity,
    renderer_set_shadows, renderer_shadows, renderer_set_ssr, renderer_ssr, renderer_set_ssr_params, renderer_set_taa, renderer_taa, request_dlss, renderer_set_dlss, renderer_dlss, set_samples, renderer_ray_query, renderer_set_ray_shadows, renderer_ray_shadows, renderer_set_sun_size, renderer_sun_size, renderer_set_ray_occlusion, renderer_ray_occlusion, renderer_set_lamp_size, renderer_set_ray_budget, renderer_ray_budget, renderer_ray_figures, renderer_ray_reach, renderer_add_light, renderer_remove_light,
    renderer_set_fog, renderer_fog, renderer_set_clouds, renderer_set_sky_overcast, renderer_set_shadow_distance, renderer_shadow_distance,
    renderer_set_ssao, renderer_ssao,
    skybox_create, skybox_free,
    offscreen_pixels, offscreen_width, offscreen_height,
    request_capture, capture_ready, capture_pixels, capture_width, capture_height, snapshot,
    live_shadow_targets, renderer_add_model, renderer_remove_model, renderer_set_overlay
)

