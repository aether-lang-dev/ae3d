// Named apart from the OpenGL backend's equivalent: struct names are global
// across every imported module, so two backends cannot both call it the same
// thing.
struct VulkanTexture {
    path: string
    handle: int
    refs: int
    width: int
    height: int
}

// One merged draw: the geometry every member shares, the surface they all have,
// and the matrices that say where each copy goes.
struct VKBatch {
    mesh: int
    material: ptr
    first: ptr
    instances: ptr
    members: ptr
    handle: int
    count: int
    stale: bool
    // The sum of the members' world stamps when the instances were last
    // written: a batch whose members moved has another.
    stamps: long
}

struct VKRenderer {
    // The scene's lamps, cut into the view's clusters every frame
    // (ae3d.lightgrid, #468), written into this frame slot's storage
    // buffers at bindings 6 and 7.
    light_grid: ptr
    models: ptr
    lights: ptr
    // Counts the frames, so a crowd two models draw tiers of is sorted once a frame.
    sort_serial: int
    // The last frame's time, for the seconds between frames a crowd's
    // motion vectors are worked out over.
    last_scene_time: float
    // Last frame's view and projection, for DLSS's reprojection.
    prev_view: Mat4
    prev_projection: Mat4
    prev_camera_valid: bool
    // How hard normal maps push, for the whole scene. A look, not a surface.
    normal_strength: float
    occlusion_strength: float
    capture_channel: int
    wetness: float
    frame_exposure: float              // the eye adaptation's, 1 when it is off
    // The sun's angular radius in radians, for the rays' penumbra; zero
    // is a point sun.
    sun_angle: float
    // Occlusion by ray while the rays are on, in the screen-space pass's
    // place: asked for or not; its reach and strength are the occlusion's.
    ray_occlusion: bool
    // The radius of a lamp's face in metres, for the rays' lamp shadows.
    lamp_radius: float
    textures: ptr
    frustum: ptr
    skybox: ptr
    shadow_space: Mat4
    batches: ptr
    batch_count: int
    // The depth pass merges by mesh alone -- a shadow has no material -- so
    // it keeps batches of its own rather than sharing the scene pass's, which
    // are keyed on the material as well.
    shadow_batches: ptr
    shadow_batch_count: int
    // What the lamps' faces draw, where the rays are on: the cascades leave
    // out what the rays shade, and a lamp's face is read past the rays'
    // reach, where they shade nothing. Rays off, the lamps draw the
    // cascades' own casters.
    lamp_singles: ptr
    lamp_batches: ptr
    lamp_batch_count: int
    screen_mesh: ptr
    screen_handle: int
    initialized: bool
    failed_frames: int      // frames the device refused, reported once
    // Temporal anti-aliasing: the frame's count, for the jitter sequence,
    // and the last frame's view-projection, unjittered, for the temporal
    // pass to find each pixel's history by.
    taa_frame: int
    prev_vp: Mat4
    prev_vp_valid: bool
    jitter_x: float
    jitter_y: float
    last_draw_calls: int
    last_shadow_ms: float
    last_scene_ms: float
    last_post_ms: float
    last_cpu_work_ms: float
    // The clouds' noise as textures, made with the first sky and kept.
    cloud_shape_texture: int
    cloud_weather_texture: int
    cloud_textures_real: bool      // the noise, not the placeholders
    last_pipeline_binds: int
    last_set_binds: int
    clear_r: float
    clear_g: float
    clear_b: float
    fog: Fog
    shadow_distance: float
    shadow_direction: Vec3
    // The key light's cascades this frame (ae3d.cascades, #469), and the
    // single casters the shadow pass draws into each.
    cascades: ptr
    shadow_singles: ptr
    // The lamps' own shadows (ae3d.lampshadows, #490): which lamps have one
    // this frame, whether the key light's shadow is its cascades (it is the
    // sun or the moon) or its slot's cube (it is a lamp), and which making
    // of the atlas the faces were drawn into.
    lamp_shadows: ptr
    key_cascaded: bool
    key_lamp_slot: int
    lamp_generation: int
    // Per face this frame (lampshadows' SLOTS * FACES): whether its static
    // layer is copied up, whether something moving is drawn over it, and
    // the corners of the tiles copied.
    lamp_copy: ptr
    lamp_move: ptr
    lamp_corners: ptr
    scene_start: float
    scene_time: float
    cloud_cover: float
    cloud_wind: float
    sky_overcast: float
    sky_overcast_color: Vec3
    defaults: ptr
    loaded_names: ptr
    shading_loaded: ptr
}

available() -> bool {
    return vkdevice.available()
}

device_name() -> string {
    return vkdevice.name()
}

last_error() -> string {
    return ae3d_vk_last_error()
}

// What the backend is holding, so a test can see that a rebuild replaced the
// shadow target rather than piling another one up.
live_shadow_targets() -> int {
    return ae3d_vk_live_shadow_targets()
}

renderer_sample_count() -> int {
    return ae3d_vk_sample_count()
}

// Valid after a frame has been rendered offscreen; the buffer belongs to the
// renderer and the next frame overwrites it.
offscreen_pixels() -> ptr {
    return vkreadback.offscreen_pixels()
}

// Arm a capture of the next presented frame. False when the surface will not
// give a frame back, so a caller can say so rather than write nothing.
request_capture() -> bool {
    return vkreadback.request_capture()
}

capture_ready() -> bool {
    return vkreadback.capture_ready()
}

// The captured frame as RGBA for the agent to read numerically -- the same
// pixels a grid or a pixel read is answered from, so the agent sees the Vulkan
// frame the way it already sees the OpenGL one.
capture_pixels() -> ptr {
    return vkreadback.capture_pixels()
}

capture_width() -> int { return vkreadback.capture_width() }
capture_height() -> int { return vkreadback.capture_height() }

// Write the captured frame to a PNG. The frame has to have been asked for and
// drawn first, so request_capture one frame ahead of this.
snapshot(path: string) -> bool {
    if !vkreadback.capture_ready() {
        println("ae3d: no Vulkan frame was captured (the capture was not armed, or the surface cannot be read back)")
        return false
    }
    pixels = vkreadback.capture_pixels()
    if pixels == null {
        println("ae3d: the captured Vulkan frame could not be read")
        return false
    }
    return png.write(path, pixels, vkreadback.capture_width(), vkreadback.capture_height())
}

offscreen_width() -> int {
    return ae3d_vk_offscreen_width()
}

offscreen_height() -> int {
    return ae3d_vk_offscreen_height()
}

renderer_new() -> *VKRenderer {
    r = heap.new(VKRenderer)
    r.failed_frames = 0
    r.taa_frame = 0
    r.prev_vp_valid = false
    r.models = list.new()
    r.lights = list.new()
    r.textures = list.new()
    r.frustum = core.frustum_new()
    r.shadow_space = core.mat4_ident()
    r.normal_strength = 2.5
    r.occlusion_strength = 1.0
    r.capture_channel = 0
    r.wetness = 0.0
    r.frame_exposure = 1.0
    r.sun_angle = 0.0
    r.ray_occlusion = false
    r.lamp_radius = 0.12
    r.batches = list.new()
    r.shadow_batches = list.new()
    r.shadow_batch_count = 0
    r.lamp_batches = list.new()
    r.lamp_batch_count = 0
    r.key_lamp_slot = 0 - 1
    r.batch_count = 0
    r.fog = core.fog_none()
    r.scene_start = platform.time()
    r.scene_time = 0.0
    r.defaults = rendering.defaults_model() as ptr
    r.loaded_names = calloc(ae3d_vk_program_count(), 8)
    // Nothing has been written into these blocks yet, so what they hold is not
    // what a default is.
    r.shading_loaded = calloc(ae3d_vk_program_count(), 4)
    return r
}

renderer_free(r: *VKRenderer) {
    if r == null { return }
    if r.initialized { renderer_cleanup(r) }
    // Made with the renderer, not with its device: one never initialized,
    // an engine that opened no window, still has both.
    free_batches(r.batches)
    free_batches(r.shadow_batches)
    free_batches(r.lamp_batches)
    if r.light_grid != null { lightgrid.grid_free(r.light_grid as *LightGrid) }
    if r.cascades != null { cascades.cascades_free(r.cascades as *Cascades) }
    if r.shadow_singles != null { list.free(r.shadow_singles) }
    if r.lamp_singles != null { list.free(r.lamp_singles) }
    if r.lamp_shadows != null { lampshadows.lamps_free(r.lamp_shadows as *LampShadows) }
    if r.lamp_copy != null { free(r.lamp_copy) }
    if r.lamp_move != null { free(r.lamp_move) }
    if r.lamp_corners != null { free(r.lamp_corners) }
    if r.models != null { list.free(r.models) }
    if r.lights != null { list.free(r.lights) }
    if r.textures != null {
        count = list.size(r.textures)
        i = 0
        while i < count {
            entry = list.get_raw(r.textures, i) as *VulkanTexture
            if entry != null {
            heap.free(entry)
            }
            i = i + 1
        }
        list.free(r.textures)
    }
    if r.defaults != null { core.model_free(r.defaults as *Model) }
    if r.loaded_names != null { free(r.loaded_names) }
    if r.shading_loaded != null { free(r.shading_loaded) }
    if r.frustum != null { core.frustum_free(r.frustum) }
    heap.free(r)
}

// The scene drawn at `scale` of the frame (0.25..1) into targets of that
// size -- its colour, depth and motion vectors, and the occlusion, the
// reflection and the temporal pass over them -- and the composite drawing
// it to the frame at the frame's size: the scene's cost is its pixels, and
// an upscaler sits where the composite samples. The targets are remade at
// the next frame. Returns the scale in force.
vtable_set_render_scale(r: *VKRenderer, scale: float) -> float {
    return ae3d_vk_set_render_scale(scale)
}

backend(r: *VKRenderer) -> Backend {
    return Backend {
        state: r,
        name: "vulkan",
        init: renderer_init as fn(ptr, ptr, int, int) -> int,
        render: renderer_render as fn(ptr, ptr, ptr),
        add_model: renderer_add_model as fn(ptr, ptr),
        remove_model: renderer_remove_model as fn(ptr, ptr),
        load_texture: renderer_load_texture as fn(ptr, string) -> int,
        set_skybox: renderer_set_skybox as fn(ptr, ptr),
        update_viewport: renderer_update_viewport as fn(ptr, int, int),
        set_post: renderer_set_post as fn(ptr, int, int, float, float),
        set_render_scale: vtable_set_render_scale as fn(ptr, float) -> float,
        set_clear_color: renderer_set_clear_color as fn(ptr, float, float, float),
        set_fog: renderer_set_fog as fn(ptr, ptr),
        set_shadow_distance: renderer_set_shadow_distance as fn(ptr, float),
        set_shadows: vtable_set_shadows as fn(ptr, int),
        shadows: vtable_shadows as fn(ptr) -> int,
        add_light: renderer_add_light as fn(ptr, ptr),
        remove_light: renderer_remove_light as fn(ptr, ptr),
        draw_calls: renderer_draw_calls as fn(ptr) -> int,
        frame_pixels: vtable_frame_pixels as fn(ptr) -> ptr,
        set_overlay: renderer_set_overlay as fn(ptr, ptr),
        cleanup: renderer_cleanup as fn(ptr)
    }
}

renderer_init(r: *VKRenderer, window: ptr, width: int, height: int) -> int {
    if !vkdevice.available() {
        println("ae3d: no Vulkan driver (${ae3d_vk_last_error()})")
        return 0
    }
    // The frame read back from the first frame on (ae3d.vkreadback): an
    // offscreen one is copied out every frame, a windowed one when asked.
    vkreadback.attach()
    // Textures are made in Aether; the backend makes its default one while
    // it starts.
    vktexture.install()
    // The device first (ae3d.vkdevice), then the backend on it, then the
    // rays' structures and the crowds' sort on the device.
    if !vkdevice.open(window) || ae3d_vk_init(width, height) != 1 {
        println("ae3d: Vulkan init failed (${ae3d_vk_last_error()})")
        return 0
    }
    vkrays.start()
    if !vkcrowd.start() {
        println("ae3d: Vulkan init failed (${ae3d_vk_last_error()})")
        return 0
    }
    println("ae3d: Vulkan on ${vkdevice.name()}, ${ae3d_vk_sample_count()}x MSAA")
    r.initialized = true

    r.screen_mesh = core.mesh_create()
    core.mesh_push_screen_quad(r.screen_mesh)
    r.screen_handle = vkmesh.mesh_upload(r.screen_mesh)
    ae3d_vk_set_screen_quad(r.screen_handle)
    return 1
}

renderer_add_light(r: *VKRenderer, light: *Light) {
    list.add_raw(r.lights, light)
}

renderer_light_count(r: *VKRenderer) -> int {
    return list.size(r.lights)
}

renderer_light(r: *VKRenderer, index: int) -> *Light {
    if index < 0 || index >= list.size(r.lights) { return null }
    return list.get_raw(r.lights, index) as *Light
}

renderer_remove_light(r: *VKRenderer, light: *Light) {
    count = list.size(r.lights)
    i = 0
    while i < count {
        if list.get_raw(r.lights, i) == light {
            list.remove(r.lights, i)
            return
        }
        i = i + 1
    }
}

vtable_shadows(r: *VKRenderer) -> int {
    if renderer_shadows(r) { return 1 }
    return 0
}

vtable_set_shadows(r: *VKRenderer, on: int) {
    renderer_set_shadows(r, on == 1)
}

vtable_frame_pixels(r: *VKRenderer) -> ptr {
    return vkreadback.offscreen_pixels()
}

// What is drawn over every frame from now on (an ae3d.hud, or null):
// recorded by ae3d.vkoverlay after the post chain, from the device's one
// frame, so it is the process's rather than this renderer's.
renderer_set_overlay(r: *VKRenderer, o: ptr) {
    vkoverlay.set_overlay(o)
}

renderer_set_shadows(r: *VKRenderer, on: bool) {
    flag = 0
    if on { flag = 1 }
    ae3d_vk_set_shadows(flag)
}

renderer_shadows(r: *VKRenderer) -> bool {
    return ae3d_vk_shadows() == 1
}

renderer_set_clouds(r: *VKRenderer, cover: float, wind: float) {
    r.cloud_cover = cover
    if cover > 0.0 { ensure_cloud_textures(r, true) }
    r.cloud_wind = wind
}

renderer_set_sky_overcast(r: *VKRenderer, amount: float, color: Vec3) {
    r.sky_overcast = amount
    r.sky_overcast_color = color
}

// The clouds' textures. The noise behind them is 161 ms of CPU for the
// shape and 5 for the weather (core.cloud_shape_bytes, measured), and
// every sky made them whether the scene had clouds or not -- the whole
// of the 168 ms a scene's sky cost to open in the editor, and the same in
// every program with a sky and no clouds. With no cover the sky shader
// never samples them (cloudsAlong returns before the march), but the
// draw still binds a texture of each kind, so a sky without clouds gets
// two placeholders of the right types -- a 2x2x2 volume and a 1x1 image
// -- and the noise is made the first time the cover is above zero.
// On Vulkan a texture is made outside any frame, so the upgrade happens
// when the cover is set rather than where the sky is drawn.
ensure_cloud_textures(r: *VKRenderer, real: bool) {
    if r.cloud_textures_real { return }
    if !real {
        if r.cloud_shape_texture == 0 || r.cloud_weather_texture == 0 {
            blank = calloc(2 * 2 * 2 * 4, 1)
            // depth 2, not 1: the native side makes a volume only past one layer.
            if r.cloud_shape_texture == 0 { r.cloud_shape_texture = vktexture.texture_create_rgba(2, 2, 2, blank) }
            if r.cloud_weather_texture == 0 { r.cloud_weather_texture = vktexture.texture_create_rgba(1, 1, 1, blank) }
            free(blank)
        }
        return
    }
    shape = core.cloud_shape_bytes()
    weather = core.cloud_weather_bytes()
    if shape == null || weather == null { return }
    if r.cloud_shape_texture != 0 { ae3d_vk_texture_destroy(r.cloud_shape_texture) }
    if r.cloud_weather_texture != 0 { ae3d_vk_texture_destroy(r.cloud_weather_texture) }
    r.cloud_shape_texture = vktexture.texture_create_rgba(core.CLOUD_SHAPE_SIZE, core.CLOUD_SHAPE_SIZE, core.CLOUD_SHAPE_SIZE, shape)
    r.cloud_weather_texture = vktexture.texture_create_rgba(core.CLOUD_WEATHER_SIZE, core.CLOUD_WEATHER_SIZE, 1, weather)
    r.cloud_textures_real = true
}

// The impostor's atlas grid and size, for the crowd draw; off for every
// other model, since the block is shared across draws.
set_impostor_uniforms(m: *Model) {
    on = 0
    if m != null && core.model_is_impostor(m) { on = 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_IMPOSTOR, on)
    if on == 1 {
        ae3d_vk_scene_set_int(vkscene.OFF_IMPOSTORCOLS, m.impostor_cols)
        ae3d_vk_scene_set_int(vkscene.OFF_IMPOSTORROWS, m.impostor_rows)
        ae3d_vk_scene_set_float(vkscene.OFF_IMPOSTORWIDTH, m.impostor_width)
        ae3d_vk_scene_set_float(vkscene.OFF_IMPOSTORHEIGHT, m.impostor_height)
    }
}

renderer_set_ssr(r: *VKRenderer, on: bool) {
    flag = 0
    if on { flag = 1 }
    ae3d_vk_set_ssr(flag)
}

// Temporal anti-aliasing on or off: the projection nudged a fraction of a
// pixel each frame through an eight-frame Halton sequence, and each frame
// folded into a history the temporal pass reprojects by the scene's
// depth. On, the post chain runs.
renderer_set_taa(r: *VKRenderer, on: bool) {
    flag = 0
    if on { flag = 1 }
    ae3d_vk_set_taa(flag)
    if !on { r.prev_vp_valid = false }
}

renderer_taa(r: *VKRenderer) -> bool { return ae3d_vk_taa() == 1 }

// DLSS, through NVIDIA Streamline, asked for before the backend starts:
// the runtime is loaded from `directory` (empty: AE3D_STREAMLINE, or beside
// the program) and its interposer becomes the Vulkan loader. False, with
// last_error saying why, where it was not built in or is not there.
request_dlss(directory: string) -> bool {
    return vkdevice.request_dlss(directory)
}

// Whether the device traces rays (VK_KHR_ray_query): what shadows by ray
// and, later, occlusion and reflections by ray are built on.
renderer_ray_query(r: *VKRenderer) -> bool { return vkrays.query() }

// Shadows by ray: a ray from every lit surface toward the sun through
// the scene's acceleration structure, built each frame from the models
// that cast -- exact at any distance, with no map's texel to fit the
// world into. What the structure does not hold (a skinned figure, a
// crowd, points) keeps the shadow map, and the two are combined, the
// darker winning. On where the device traces; otherwise nothing changes.
renderer_set_ray_shadows(r: *VKRenderer, on: bool) {
    vkrays.set_shadows(on)
}

renderer_ray_shadows(r: *VKRenderer) -> bool { return vkrays.shadows() }

// How many of a crowd's figures the rays take a frame: the nearest that
// many, the reach following the crowd's density so they stay about that
// many (0: no limit but the shadow distance). 2048 unless set. What the
// rays last took, and the reach that took them, for a benchmark to report.
renderer_set_ray_budget(r: *VKRenderer, figures: int) { vkrays.set_budget(figures) }
renderer_ray_budget(r: *VKRenderer) -> int { return vkrays.budget() }
renderer_ray_figures(r: *VKRenderer) -> int { return vkrays.figures() }
renderer_ray_reach(r: *VKRenderer) -> float { return vkrays.reach_now() }

// The sun's size for the rays' shadows, as the angle its disc subtends in
// degrees: zero is a point sun and a hard edge, the real sun is about
// half a degree, and more is a softer, wider penumbra. The map is not
// affected; only what the rays shadow takes it.
renderer_set_sun_size(r: *VKRenderer, degrees: float) {
    if r == null { return }
    if degrees < 0.0 { degrees = 0.0 }
    r.sun_angle = core.deg_to_rad(degrees * 0.5)
}

renderer_sun_size(r: *VKRenderer) -> float {
    if r == null { return 0.0 }
    return core.rad_to_deg(r.sun_angle) * 2.0
}

// Occlusion by ray, with the occlusion's own reach and strength
// (renderer_set_ssao), while the rays are on: the scene shader traces the
// hemisphere over every lit pixel and the screen-space pass is not drawn.
// Off, or with the rays off, the screen-space pass stands.
renderer_set_ray_occlusion(r: *VKRenderer, on: bool) {
    if r != null { r.ray_occlusion = on }
}

renderer_ray_occlusion(r: *VKRenderer) -> bool {
    if r == null { return false }
    return r.ray_occlusion && vkrays.shadows() && ae3d_vk_ssao() == 1
}

// How big a lamp's face is, in metres, for the shadow the rays throw from
// it: a bare bulb is a few centimetres and throws a hard shadow, a shaded
// street lamp a hand's width and a soft one. Twelve centimetres unless set.
renderer_set_lamp_size(r: *VKRenderer, metres: float) {
    if r == null { return }
    if metres < 0.0 { metres = 0.0 }
    r.lamp_radius = metres * 0.5
}

// A model whose shadow the rays cast: a static mesh drawn on its own or
// through a matrix stream, with its shadow on. A skinned figure, a crowd
// and a point stream have no structure to trace and keep the map.
traced(m: *Model) -> bool {
    if m == null || !m.visible || !m.casts_shadow || m.vbo == 0 { return false }
    if m.skeleton != null || m.pose_bank != null || m.device_crowd != null { return false }
    if m.is_instanced && core.model_instance_points(m) { return false }
    if m.depth_proxy != null { return false }
    return true
}

// A crowd model whose figures the rays hold: its crowd has pose
// structures, so the sort writes their instances.
crowd_traced(m: *Model) -> bool {
    if m == null || !m.visible || m.device_crowd == null { return false }
    dc = m.device_crowd as *DeviceCrowd
    return dc.poses != 0
}

// Room in the frame's structure for everything that will be in it -- the
// crowds' figures, which the sorts write, and the static scene's
// instances -- before any sort records into it, since the buffer cannot
// be remade once one has.
reserve_ray_scene(r: *VKRenderer) {
    if !vkrays.shadows() { return }
    // The crowd's figures in the rays reach as far as the map did.
    vkrays.set_reach(r.shadow_distance)
    statics = 0
    figures = 0
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if traced(m) {
            if m.is_instanced { statics = statics + core.model_instance_count(m) } else { statics = statics + 1 }
        } else if crowd_traced(m) {
            dc = m.device_crowd as *DeviceCrowd
            if dc.reserved_serial != r.sort_serial + 1 {
                dc.reserved_serial = r.sort_serial + 1
                figures = figures + dc.count
            }
        }
        i = i + 1
    }
    if statics + figures > 0 { vkrays.reserve(statics + figures, statics) }
}

// The frame's instances into the scene's structure, and the structure
// built, before any pass: every traced model with its matrix -- one, or
// its stream's -- after the sorts wrote the crowds', and the flag the
// shader reads set for every program.
build_ray_scene(r: *VKRenderer) {
    // Not traced this frame: the slot still has a structure, empty if it
    // never had another, for the pipelines' binding.
    if !vkrays.shadows() {
        vkrays.empty()
        return
    }
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if traced(m) {
            core.model_sync_transform(m)
            if m.is_instanced && core.model_instance_count(m) > 0 {
                vkrays.add(vkmesh.blas_address(m.vbo), geometry.inst_matrix_data(m.instances), core.model_instance_count(m))
            } else if !m.is_instanced {
                vkrays.add_one(vkmesh.blas_address(m.vbo), (&m.model_matrix) as ptr)
            }
        }
        i = i + 1
    }
    // Nothing traced in view this frame: an empty structure all the same.
    if !vkrays.build() { vkrays.empty() }
}

// The multisampling the frame takes, asked for before the backend starts:
// the most it will use (4 by default); 0 or 1 is none.
set_samples(samples: int) {
    ae3d_vk_set_samples(samples)
}

// DLSS at `mode` (0 off, 1 performance, 2 balanced, 3 quality, 4 ultra
// performance, 5 ultra quality, 6 DLAA): the scene is drawn at the render
// size the mode wants and DLSS writes the frame from it, its depth and its
// motion vectors, in the temporal pass's place, with the projection nudged
// as the temporal pass nudges it. Returns the mode in force: 0 where DLSS
// is not available (not asked for before the start, not built in, no
// runtime beside the program, or no card for it).
renderer_set_dlss(r: *VKRenderer, mode: int) -> int {
    got = ae3d_vk_set_dlss(mode)
    r.prev_vp_valid = false
    r.prev_camera_valid = false
    return got
}

renderer_dlss(r: *VKRenderer) -> int { return ae3d_vk_dlss() }

// The frame's camera handed to DLSS: this frame's view and projection and
// last frame's, the frame's nudge, and the lens. Before the frame's draws.
dlss_camera(r: *VKRenderer, cam: *Camera) {
    view = core.camera_view(cam)
    projection = core.camera_projection(cam)
    prev_view = view
    prev_projection = projection
    if r.prev_camera_valid {
        prev_view = r.prev_view
        prev_projection = r.prev_projection
    }
    forward = cam.front
    ae3d_vk_dlss_camera(&view, &projection, &prev_view, &prev_projection, r.jitter_x, r.jitter_y,
                        cam.near, cam.far, core.deg_to_rad(cam.fov), cam.aspect,
                        &cam.position, &cam.up, &cam.right, &forward)
    r.prev_view = view
    r.prev_projection = projection
    r.prev_camera_valid = true
}

// The Halton sequence: the k-th point of the base, in 0..1, spread as
// evenly as k points can be. Bases 2 and 3 give a pixel's eight offsets.
halton(index: int, base: int) -> float {
    result = 0.0
    f = 1.0 / (base as float)
    i = index
    while i > 0 {
        result = result + f * ((i % base) as float)
        i = i / base
        f = f / (base as float)
    }
    return result
}

// The frame's view-projection: the camera's, nudged this frame's fraction
// of a pixel when the temporal pass is on, so that over eight frames every
// pixel sees its surface at eight points within itself. The nudge is a
// translation in clip space, applied after the projection.
// The seconds between this frame and the last, for the motion vectors of
// a crowd: kept here for pose(), which has the model and not the renderer.
var g_frame_seconds = 0.0

frame_view_projection(r: *VKRenderer, cam: *Camera) -> Mat4 {
    vp = core.camera_view_projection(cam)
    if ae3d_vk_taa() != 1 && ae3d_vk_dlss() == 0 {
        r.jitter_x = 0.0
        r.jitter_y = 0.0
        return vp
    }
    width = ae3d_vk_render_width() as float
    height = ae3d_vk_render_height() as float
    if width <= 0.0 || height <= 0.0 { return vp }
    // Eight points a pixel for the temporal pass; an upscaler wants more,
    // as many as the pixels it makes of one -- the square of the scale,
    // eight times -- or its picture is what those eight points reach.
    phases = 8
    if ae3d_vk_dlss() > 0 {
        scale = ae3d_vk_frame_width() as float / width
        phases = (8.0 * scale * scale + 0.5) as int
        if phases < 8 { phases = 8 }
        if phases > 64 { phases = 64 }
    }
    k = r.taa_frame % phases + 1
    jx = (halton(k, 2) - 0.5) * 2.0 / width
    jy = (halton(k, 3) - 0.5) * 2.0 / height
    // Kept for the temporal pass, in texture space; Vulkan's y runs down.
    r.jitter_x = jx * 0.5
    r.jitter_y = 0.0 - jy * 0.5
    return core.mat4_mul(core.mat4_translate(jx, jy, 0.0), vp)
}

// Ambient occlusion on or off: `radius` is how far, in metres, a thing
// shadows what stands beside it, `intensity` how dark that shadow goes
// (1.0 is the full occlusion the depth finds, 0 none).
renderer_set_ssao(r: *VKRenderer, on: bool, radius: float, intensity: float) {
    flag = 0
    if on { flag = 1 }
    ae3d_vk_set_ssao(flag, radius, intensity)
}

renderer_ssao(r: *VKRenderer) -> bool { return ae3d_vk_ssao() == 1 }

renderer_ssr(r: *VKRenderer) -> bool { return ae3d_vk_ssr() == 1 }

renderer_set_ssr_params(r: *VKRenderer, road_height: float, strength: float) {
    ae3d_vk_set_ssr_params(road_height, strength)
}

// The camera-space depth prepass, when screen-space reflection is on. Depth of
// all visible geometry from the camera, into the target the SSR pass samples.
// The depth shader transforms by the light-space slot, so the camera's own
// view-projection goes there for the length of the pass and the light's is put
// back after, since the scene pass samples the shadow map through it.
// Whether any model draws through the water program: the one shader that
// reads the scene's depth, for its shore.
wants_scene_depth(r: *VKRenderer) -> bool {
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && core.shader_valid(&m.shader) && m.shader.kind == core.SHADER_WATER {
            return true
        }
        i = i + 1
    }
    return false
}

// Whether a water surface -- the one shader that reads the scene's depth
// for its shore -- is drawn this frame. Said to the device before the frame
// begins: a frame that anything reads the depth of is drawn in two halves,
// the depth resolved between them (ae3d_vk_resolve_scene_depth).
declare_scene_depth(r: *VKRenderer) {
    wanted = 0
    if wants_scene_depth(r) { wanted = 1 }
    ae3d_vk_set_scene_depth(wanted)
}

// The key light's shadow for this frame, in cascades (ae3d.cascades,
// #469): the same fit the OpenGL backend makes, from the same scene, so the
// two backends shadow a scene identically.
fit_cascades(r: *VKRenderer, light: *Light, cam: *Camera) {
    if r.cascades == null { r.cascades = cascades.cascades_new() as ptr }
    c = r.cascades as *Cascades
    sphere = cascades.scene_sphere(r.models)
    centre = core.vec3(sphere.x, sphere.y, sphere.z)
    travel = cascades.travel_of(light, centre)
    r.shadow_direction = travel
    range = r.shadow_distance
    if range <= 0.0 {
        range = core.v3_len(core.v3_sub(centre, cam.position)) + sphere.w
        if range > cam.far { range = cam.far }
    }
    cascades.fit(c, cam, travel, range, centre, sphere.w)
    r.shadow_space = cascades.matrix(c, 0)
}

// The shadow pipeline a caster is drawn by, as ae3d_vk_shadow_draw and
// the draw under shadow_draw_model choose it: the pass draws the casters
// kind by kind, so each pipeline is bound once however many cascades.
const SHADOW_PLAIN = 0
const SHADOW_SKINNED = 1
const SHADOW_CROWD = 2
const SHADOW_POINTS = 3
const SHADOW_KINDS = 4

shadow_kind(m: *Model) -> int {
    if m.device_crowd != null || m.pose_bank != null { return SHADOW_CROWD }
    if m.is_instanced && core.model_instance_count(m) > 0 && core.model_instance_points(m) { return SHADOW_POINTS }
    if m.skeleton != null { return SHADOW_SKINNED }
    return SHADOW_PLAIN
}

render_shadow_pass(r: *VKRenderer, light: *Light, cam: *Camera) {
    r.key_cascaded = false
    if light == null || ae3d_vk_shadows() != 1 { return }

    // The depth pass has a block of its own to write into, and which one that
    // is must not depend on whichever program the last draw of the previous
    // frame happened to leave selected.
    ae3d_vk_set_program(core.SHADER_CUSTOM)

    gather_casters(r, false)
    // The key light's cascades when it is the sun or the moon. A lamp that
    // is the key light has a cube of its own below, like every lamp.
    if light.mode == core.MODE_DIRECTIONAL {
        fit_cascades(r, light, cam)
        c = r.cascades as *Cascades
        if ae3d_vk_shadow_begin() == 1 {
            r.key_cascaded = true
            // The casters by the pipeline that draws them -- the plain ones
            // and the instanced batches, then the skinned, the crowds and
            // the point streams (shadow_kind) -- and each kind into every
            // cascade in turn: taken cascade by cascade, the kinds bound
            // their pipelines over again in every one.
            kind = 0
            while kind < SHADOW_KINDS {
                k = 0
                while k < cascades.COUNT {
                    // Cascade k's tile of the atlas, two by two, and its
                    // matrix: every draw copies the block as it stands, so
                    // the draws that follow cast into this cascade.
                    ae3d_vk_shadow_viewport((k % 2) * cascades.SIZE, (k / 2) * cascades.SIZE, cascades.SIZE)
                    space = cascades.matrix(c, k)
                    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &space)
                    draw_casters(r, false, kind, 0, k, 0, LAYER_ALL)
                    k = k + 1
                }
                kind = kind + 1
            }
            // The lit pass's vertex stage reads the nearest cascade's matrix.
            r.shadow_space = cascades.matrix(c, 0)
            ae3d_vk_shadow_end()
        }
    }
    draw_lamp_faces(r)
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &r.shadow_space)
}

// What casts, gathered once a frame: the casters that share a mesh drawn
// as one instanced draw, the way the OpenGL backend draws them -- one by
// one, a street of kerb stones and lamp posts cost this pass four draws
// more than the same street on the other renderer, for the same shadow --
// and the rest one by one. For the cascades, what the rays shadow this
// frame is left out: the map is left with the skinned, the points, and a
// crowd that is not in the rays. For the lamps' faces, where the rays are
// on, nothing is: a face is read past the rays' reach.
gather_casters(r: *VKRenderer, lamps: bool) {
    rays = vkrays.shadows_now()
    if lamps && !rays { return }
    if lamps {
        if r.lamp_singles == null { r.lamp_singles = list.new() }
        if r.lamp_batches == null { r.lamp_batches = list.new() }
        list.clear(r.lamp_singles)
        r.lamp_batch_count = 0
    } else {
        if r.shadow_singles == null { r.shadow_singles = list.new() }
        list.clear(r.shadow_singles)
        r.shadow_batch_count = 0
    }
    singles = caster_singles(r, lamps)
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m == null || !m.visible || !m.casts_shadow || m.vbo == 0 {
            i = i + 1
            continue
        }
        if !lamps && rays && (traced(m) || crowd_traced(m)) {
            i = i + 1
            continue
        }
        core.model_sync_transform(m)
        if shadow_batchable(m) {
            moved = m.shadow_stamp != m.world_stamp
            if !lamps { m.shadow_stamp = m.world_stamp }
            b = shadow_batch_for(r, lamps, m)
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            list.add_raw(singles, m as ptr)
        }
        i = i + 1
    }
    batches = caster_batches(r, lamps)
    i = 0
    while i < caster_batch_count(r, lamps) {
        b = list.get_raw(batches, i) as *VKBatch
        if b.count != list.size(b.members) { b.stale = true }
        // A member that moved since the instances were written: its own
        // shadow stamp is the cascades' to keep, so the batch keeps a sum.
        stamps = 0 as long
        j = 0
        while j < b.count {
            stamps = stamps + ((list.get_raw(b.members, j) as *Model).world_stamp as long)
            j = j + 1
        }
        if stamps != b.stamps { b.stale = true }
        b.stamps = stamps
        if b.count > 1 { sync_batch_instances(b) }
        i = i + 1
    }
}

// Whether a caster in the sphere at `centre` of `radius` goes into the tile
// being drawn: cascade `a` (mode 0), or lamp slot `a`'s face `b` (mode 1).
reaches_tile(r: *VKRenderer, mode: int, a: int, b: int, centre: Vec3, radius: float) -> bool {
    if mode == 0 { return cascades.casts_into(r.cascades as *Cascades, a, centre, radius) }
    return lampshadows.casts_onto(r.lamp_shadows as *LampShadows, a, b, centre, radius)
}

// A caster's sphere as a tile tests it: a crowd posed on the CPU stands
// where its instances do, and its bounds are one figure's.
caster_sphere(m: *Model) -> Vec4 {
    if m.pose_bank != null && m.device_crowd == null && m.is_instanced && core.model_instance_count(m) > 0 {
        geometry.inst_compute_bounds(m.instances)
        return Vec4 { x: geometry.inst_bound_x(m.instances) + m.world_position.x,
                      y: geometry.inst_bound_y(m.instances) + m.world_position.y,
                      z: geometry.inst_bound_z(m.instances) + m.world_position.z,
                      w: geometry.inst_bound_radius(m.instances) + 2.0 }
    }
    return Vec4 { x: m.bounding_center.x, y: m.bounding_center.y, z: m.bounding_center.z, w: m.bounding_radius }
}

caster_reaches(r: *VKRenderer, mode: int, a: int, b: int, m: *Model) -> bool {
    sphere = caster_sphere(m)
    return reaches_tile(r, mode, a, b, core.vec3(sphere.x, sphere.y, sphere.z), sphere.w)
}

batch_reaches(r: *VKRenderer, mode: int, a: int, b: int, batch: *VKBatch) -> bool {
    i = 0
    while i < batch.count {
        if caster_reaches(r, mode, a, b, list.get_raw(batch.members, i) as *Model) { return true }
        i = i + 1
    }
    return false
}

// Whether a caster moves on its own, where no world stamp says so: a
// skinned figure, a crowd, an instance stream. A lamp's face draws it over
// its static layer every frame it is there.
moves_itself(m: *Model) -> bool {
    return m.is_instanced || m.skeleton != null || m.pose_bank != null || m.device_crowd != null
}

// The layers a tile is drawn in: everything (a cascade), a lamp face's
// static layer, or what moves over it.
const LAYER_ALL = 0
const LAYER_STATIC = 1
const LAYER_MOVING = 2

// The gathered casters of one pipeline's kind and of `layer` that reach
// the tile, into it: the light's matrix is already in the block.
draw_casters(r: *VKRenderer, lamps: bool, kind: int, mode: int, a: int, b: int, layer: int) {
    singles = caster_singles(r, lamps)
    i = 0
    while i < list.size(singles) {
        m = list.get_raw(singles, i) as *Model
        in_layer = layer == LAYER_ALL || (layer == LAYER_MOVING) == moves_itself(m)
        if in_layer && shadow_kind(m) == kind && caster_reaches(r, mode, a, b, m) { shadow_draw_model(m) }
        i = i + 1
    }
    if kind != SHADOW_PLAIN || layer == LAYER_MOVING { return }
    batches = caster_batches(r, lamps)
    i = 0
    while i < caster_batch_count(r, lamps) {
        batch = list.get_raw(batches, i) as *VKBatch
        if batch.count == 1 {
            first = batch.first as *Model
            if caster_reaches(r, mode, a, b, first) { shadow_draw_model(first) }
        } else if batch.count > 1 && batch.handle != 0 && batch_reaches(r, mode, a, b, batch) {
            identity = core.mat4_ident()
            ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &identity)
            ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, 1)
            ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEPOINTS, 0)
            ae3d_vk_scene_set_int(vkscene.OFF_ISSKINNED, 0)
            ae3d_vk_shadow_draw(batch.mesh, batch.handle, batch.count)
        }
        i = i + 1
    }
}

// The lamps that have a shadow this frame: within the lamps' range of the
// camera -- the shadow distance where one is set, and never less than
// LAMP_RANGE -- and, where the device traces, not those whose light lies
// wholly within the rays' reach, since the rays shade every pixel there.
const LAMP_RANGE = 50.0

choose_lamps(r: *VKRenderer, key: *Light, cam: *Camera) {
    r.key_lamp_slot = 0 - 1
    if r.lamp_shadows == null { r.lamp_shadows = lampshadows.lamps_new() as ptr }
    ls = r.lamp_shadows as *LampShadows
    // A new atlas holds none of the faces drawn into the last.
    generation = ae3d_vk_lamp_shadow_generation()
    if generation != r.lamp_generation {
        lampshadows.lamps_free(ls)
        ls = lampshadows.lamps_new()
        r.lamp_shadows = ls as ptr
        r.lamp_generation = generation
    }
    if ae3d_vk_shadows() != 1 || generation == 0 {
        lampshadows.choose(ls, null, null, cam, 0.0, 0.0)
        return
    }
    range = LAMP_RANGE
    if r.shadow_distance > range { range = r.shadow_distance }
    inner = 0.0
    if vkrays.shadows_now() {
        inner = r.shadow_distance
        // With no reach set the rays shade every pixel: no lamp needs a map.
        if inner <= 0.0 { inner = cam.far * 4.0 }
    }
    lampshadows.choose(ls, r.lights, key, cam, range, inner)
    if key != null && key.mode != core.MODE_DIRECTIONAL { r.key_lamp_slot = lampshadows.slot_of(ls, key) }
}

// Each chosen lamp's six faces, in two layers (ae3d.lampshadows): the
// static layer drawn where what stands still in the face changed since it
// was, every face whose static layer was drawn or that has or had
// something moving in it copied up into the atlas the shader reads, and
// what moves drawn over the copy -- kind by kind across the faces, so each
// pipeline is bound once.
draw_lamp_faces(r: *VKRenderer) {
    if r.lamp_shadows == null { return }
    ls = r.lamp_shadows as *LampShadows
    if lampshadows.slot_count(ls) == 0 { return }
    gather_casters(r, true)
    faces = lampshadows.SLOTS * lampshadows.FACES
    if r.lamp_copy == null {
        r.lamp_copy = calloc(faces, 4)
        r.lamp_move = calloc(faces, 4)
        r.lamp_corners = calloc(faces * 2, 4)
    }
    copy = r.lamp_copy as int[]
    move = r.lamp_move as int[]
    corners = r.lamp_corners as int[]

    opened = false
    moving_faces = 0
    slot = 0
    while slot < lampshadows.SLOTS {
        f = 0
        while f < lampshadows.FACES {
            tile = lampshadows.face_tile(slot, f)
            copy[tile] = 0
            move[tile] = 0
            if lampshadows.lamp_of(ls, slot) != null {
                sig, moving = face_contents(r, ls, slot, f)
                if lampshadows.static_stale(ls, slot, f, sig) {
                    if !opened {
                        if ae3d_vk_lamp_static_begin() != 1 { return }
                        opened = true
                    }
                    ae3d_vk_lamp_shadow_tile((tile % lampshadows.ACROSS) * lampshadows.FACE,
                                             (tile / lampshadows.ACROSS) * lampshadows.FACE, lampshadows.FACE)
                    space = lampshadows.face_matrix(ls, slot, f)
                    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &space)
                    draw_casters(r, true, SHADOW_PLAIN, 1, slot, f, LAYER_STATIC)
                    lampshadows.static_drawn(ls, slot, f, sig)
                    copy[tile] = 1
                }
                // A face that had something moving over it last frame is
                // copied too: the copy is what takes it back out.
                if moving || lampshadows.moving_was(ls, slot, f) { copy[tile] = 1 }
                if moving {
                    move[tile] = 1
                    moving_faces = moving_faces + 1
                }
                lampshadows.set_moving(ls, slot, f, moving)
            }
            f = f + 1
        }
        slot = slot + 1
    }
    if opened { ae3d_vk_shadow_end() }

    count = 0
    tile = 0
    while tile < faces {
        if copy[tile] == 1 {
            corners[count * 2] = (tile % lampshadows.ACROSS) * lampshadows.FACE
            corners[count * 2 + 1] = (tile / lampshadows.ACROSS) * lampshadows.FACE
            count = count + 1
        }
        tile = tile + 1
    }
    if count > 0 { ae3d_vk_lamp_copy(r.lamp_corners, count, lampshadows.FACE) }

    if moving_faces == 0 || ae3d_vk_lamp_shadow_begin() != 1 { return }
    kind = 0
    while kind < SHADOW_KINDS {
        tile = 0
        while tile < faces {
            if move[tile] == 1 {
                slot = tile / lampshadows.FACES
                f = tile % lampshadows.FACES
                ae3d_vk_shadow_viewport((tile % lampshadows.ACROSS) * lampshadows.FACE,
                                        (tile / lampshadows.ACROSS) * lampshadows.FACE, lampshadows.FACE)
                space = lampshadows.face_matrix(ls, slot, f)
                ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &space)
                draw_casters(r, true, kind, 1, slot, f, LAYER_MOVING)
            }
            tile = tile + 1
        }
        kind = kind + 1
    }
    ae3d_vk_shadow_end()
}

// What stands in a lamp's face: a signature of what stands still in it
// and how often each has moved, and whether anything that moves on its own
// is there.
face_contents(r: *VKRenderer, ls: *LampShadows, slot: int, f: int) -> (long, bool) {
    sig = 0 as long
    moving = false
    singles = caster_singles(r, true)
    i = 0
    while i < list.size(singles) {
        m = list.get_raw(singles, i) as *Model
        if caster_reaches(r, 1, slot, f, m) {
            if moves_itself(m) {
                moving = true
            } else {
                sig = lampshadows.face_signature(sig, m.id as long, m.world_stamp as long)
            }
        }
        i = i + 1
    }
    batches = caster_batches(r, true)
    i = 0
    while i < caster_batch_count(r, true) {
        batch = list.get_raw(batches, i) as *VKBatch
        j = 0
        while j < batch.count {
            m = list.get_raw(batch.members, j) as *Model
            if caster_reaches(r, 1, slot, f, m) {
                sig = lampshadows.face_signature(sig, m.id as long, m.world_stamp as long)
            }
            j = j + 1
        }
        i = i + 1
    }
    return sig, moving
}

// The crowds sorted on the device, once a frame each, before any pass
// opens: each tier's model says its scale and its index counts (its own
// for the lit draw, its depth proxy's for the shadow), then the crowd's
// figures go into the frame's state buffer and the sort is recorded. The
// tier draws that follow, lit and shadow, read the streams and the counts
// it wrote.
sort_device_crowds(r: *VKRenderer) {
    r.sort_serial = r.sort_serial + 1
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && m.device_crowd != null {
            dc = m.device_crowd as *DeviceCrowd
            core.model_sync_transform(m)
            shadow_mesh = m.mesh
            if m.depth_proxy != null {
                proxy = m.depth_proxy as *Model
                shadow_mesh = proxy.mesh
            }
            vkcrowd.set_tier(dc.handle, m.device_tier, m.device_part, m.scale.x, m.scale.y, m.scale.z,
                                   core.mesh_index_count(m.mesh), core.mesh_index_count(shadow_mesh))
        }
        i = i + 1
    }
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && m.device_crowd != null {
            dc = m.device_crowd as *DeviceCrowd
            if dc.sorted_serial != r.sort_serial {
                dc.sorted_serial = r.sort_serial
                if dc.count > 0 && vkcrowd.fill(dc.handle, dc.pos, dc.yaw, dc.phase, dc.col, dc.start, dc.count) > 0 {
                    vkcrowd.sort(dc.handle, dc.cx, dc.cz, dc.near_dist, dc.mid_dist, dc.cull_dist)
                }
            }
        }
        i = i + 1
    }
}

shadow_draw_model(m: *Model) {
    instances = 0
    if m.is_instanced { instances = core.model_instance_count(m) }
    // An instanced model with no instances casts nothing: drawn, it was one
    // copy of its mesh at its own place (the draw's identity instance).
    if m.is_instanced && instances <= 0 && m.device_crowd == null { return }
    instanced = 0
    if instances > 0 { instanced = 1 }
    if m.device_crowd != null { instanced = 1 }
    // The same rule as the lit draw: an instanced model's transform is
    // already in every instance, so the model matrix goes as the identity
    // or the scale is applied twice. Sent as the model's own, a grid of
    // nine-metre cubes cast the shadows of eighty-one-metre ones, and the
    // camera depth the reflection, the shore and the occlusion read had
    // those in it and not the cubes.
    points = 0
    if instanced == 1 && core.model_instance_points(m) { points = 1 }
    if points == 1 {
        placed = point_frame(m)
        ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &placed)
    } else if instanced == 1 {
        identity = core.mat4_ident()
        ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &identity)
    } else {
        ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &m.model_matrix)
    }
    ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, instanced)
    ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEPOINTS, points)
    ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEBILLBOARD, points * m.billboard)
    pose(m)
    // The shadow pass takes the proxy's mesh where the model has one: a
    // crowd's near tier casts from the far tier's hundred and sixty-eight
    // triangles instead of its twenty-six thousand, which at twenty thousand
    // figures is the shadow pass halved. A shadow is soft, and a silhouette
    // a few pixels out is not seen in one; the camera depth, which the
    // occlusion reads at the pixel, is the frame's own and never a proxy's.
    vbo = m.vbo
    if m.depth_proxy != null {
        proxy = m.depth_proxy as *Model
        if proxy.vbo != 0 { vbo = proxy.vbo }
    }
    if m.device_crowd != null {
        dc = m.device_crowd as *DeviceCrowd
        vkcrowd.shadow_draw(vbo, dc.handle, m.device_tier, m.device_part)
        return
    }
    ae3d_vk_shadow_draw(vbo, m.instance_vbo, instances)
}

// A model's matrix without its translation: what a point instance is
// placed by, before the point's own position is put in the last column.
point_frame(m: *Model) -> Mat4 {
    frame = m.model_matrix
    frame.m12 = 0.0
    frame.m13 = 0.0
    frame.m14 = 0.0
    return frame
}

// A caster joins a merged depth draw when its mesh is one that other models
// draw too. Asked of the upload cache rather than of a flag set when the
// model was added: the first model built from a mesh is alone at that moment
// and shares it with every one added after.
//
// A skinned model's vertices are carried by its bones, and an instanced draw
// carries only a matrix, so a merged skinned caster would throw the shadow
// of its bind pose; it draws on its own.
shadow_batchable(m: *Model) -> bool {
    if m.skeleton != null || !vkmesh.mesh_shared(m.vbo) { return false }
    if m.device_crowd != null { return false }
    return !m.is_instanced
}

shadow_batch_for(r: *VKRenderer, lamps: bool, m: *Model) -> *VKBatch {
    batches = caster_batches(r, lamps)
    count = caster_batch_count(r, lamps)
    i = 0
    while i < count {
        b = list.get_raw(batches, i) as *VKBatch
        if b.mesh == m.vbo { return b }
        i = i + 1
    }

    if count >= list.size(batches) {
        fresh = heap.new(VKBatch)
        fresh.instances = geometry.inst_create()
        fresh.members = list.new()
        fresh.handle = 0
        fresh.count = 0
        fresh.mesh = 0
        fresh.material = null
        fresh.stale = true
        list.add_raw(batches, fresh)
    }
    b = list.get_raw(batches, count) as *VKBatch
    if b.mesh != m.vbo { b.stale = true }
    b.mesh = m.vbo
    b.material = null
    b.first = m as ptr
    b.count = 0
    if lamps { r.lamp_batch_count = count + 1 } else { r.shadow_batch_count = count + 1 }
    return b
}

// The cascades' casters, or the lamps' own where the rays are on.
lamp_set(r: *VKRenderer, lamps: bool) -> bool { return lamps && vkrays.shadows_now() }
caster_singles(r: *VKRenderer, lamps: bool) -> ptr {
    if lamp_set(r, lamps) { return r.lamp_singles }
    return r.shadow_singles
}
caster_batches(r: *VKRenderer, lamps: bool) -> ptr {
    if lamp_set(r, lamps) { return r.lamp_batches }
    return r.shadow_batches
}
caster_batch_count(r: *VKRenderer, lamps: bool) -> int {
    if lamp_set(r, lamps) { return r.lamp_batch_count }
    return r.shadow_batch_count
}

renderer_set_post(r: *VKRenderer, fxaa: int, bloom: int, threshold: float, intensity: float) {
    ae3d_vk_set_post(fxaa, bloom, threshold, intensity)
}

renderer_set_bloom_intensity(r: *VKRenderer, intensity: float) {
    ae3d_vk_set_bloom_intensity(intensity)
}

renderer_bloom_intensity(r: *VKRenderer) -> float { return ae3d_vk_bloom_intensity() }

renderer_set_skybox(r: *VKRenderer, skybox: ptr) {
    r.skybox = skybox
    sky = skybox as *Skybox
    if sky != null && sky.texture == 0 {
        renderer_set_clear_color(r, sky.red, sky.green, sky.blue)
    }
}

skybox_create(r: *VKRenderer, path: string) -> *Skybox {
    if path == "" { return core.skybox_solid(0.5, 0.7, 1.0) }

    // The sky drawn from the sun binds the renderer's own default texture,
    // since the pipeline reads one whether or not it is used.
    procedural = string.equals(path, core.SKY_PROCEDURAL) == 1
    texture = ae3d_vk_default_texture()
    if !procedural { texture = renderer_load_texture(r, path) }
    if texture == 0 {
        println("ae3d: skybox texture unavailable, falling back to a solid sky")
        return core.skybox_solid(0.5, 0.7, 1.0)
    }

    sky = core.skybox_solid(0.5, 0.7, 1.0)
    sky.texture = texture
    sky.procedural = procedural
    ensure_cloud_textures(r, r.cloud_cover > 0.0)
    sky.mesh = core.mesh_create()
    core.mesh_push_skybox_cube(sky.mesh, sky.size)
    sky.vbo = vkmesh.mesh_upload(sky.mesh)
    return sky
}

skybox_free(r: *VKRenderer, sky: *Skybox) {
    if sky == null { return }
    if sky.vbo != 0 { vkmesh.mesh_free(sky.vbo) }
    if sky.texture != 0 && !sky.procedural { renderer_release_texture(r, sky.texture) }
    if sky.mesh != null { core.mesh_destroy(sky.mesh) }
    heap.free(sky)
}

// The sky sits behind everything, so the camera's translation is stripped from
// the view matrix and the shader pushes it to the far plane.
draw_skybox(r: *VKRenderer, cam: *Camera) {
    sky = r.skybox as *Skybox
    if sky == null || sky.texture == 0 || sky.vbo == 0 { return }

    view = core.camera_view(cam)
    view.m12 = 0.0
    view.m13 = 0.0
    view.m14 = 0.0
    projection = core.camera_projection(cam)

    ae3d_vk_scene_set_mat4(vkscene.OFF_VIEW, &view)
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_PROJECTION, &projection)
    procedural = 0
    if sky.procedural { procedural = 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_SKYPROCEDURAL, procedural)
    ae3d_vk_draw_sky(sky.vbo, sky.texture, r.cloud_weather_texture, r.cloud_shape_texture)
}

renderer_load_texture(r: *VKRenderer, path: string) -> int {
    if path == "" { return 0 }

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *VulkanTexture
        if entry != null && string.equals(entry.path, path) == 1 {
            entry.refs = entry.refs + 1
            return entry.handle
        }
        i = i + 1
    }

    image = core.take_preloaded_image(path)
    if image == null { image = picture.load(path) }
    if image == null {
        println("ae3d: texture load failed: ${picture.error()}")
        return 0
    }
    // Larger than the device takes (a 21,600-wide map on a device whose
    // textures stop at 16,384): drawn at the most it has, not refused.
    halvings = picture.fit(image, ae3d_vk_max_texture_size())
    if halvings > 0 { println("ae3d: ${path} is larger than this device's textures; halved ${halvings} time(s) to fit") }
    tex_w = picture.width(image)
    tex_h = picture.height(image)
    handle = vktexture.texture_create(tex_w, tex_h, picture.pixels(image))
    picture.dispose(image)
    if handle == 0 { return 0 }

    entry = heap.new(VulkanTexture)
    texture_entry_set_path(entry, path)
    entry.handle = handle
    entry.refs = 1
    entry.width = tex_w
    entry.height = tex_h
    list.add_raw(r.textures, entry)
    return handle
}

texture_entry_set_path(entry: *VulkanTexture, path: string) {
    entry.path = core.set_owned(entry.path, path)
}

renderer_release_texture(r: *VKRenderer, handle: int) {
    if handle == 0 { return }
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *VulkanTexture
        if entry != null && entry.handle == handle {
            entry.refs = entry.refs - 1
            if entry.refs <= 0 {
                ae3d_vk_texture_destroy(entry.handle)
                list.remove(r.textures, i)
            heap.free(entry)
            }
            return
        }
        i = i + 1
    }
}

renderer_add_model(r: *VKRenderer, m: *Model) {
    if m == null || !r.initialized { return }

    // A shader written as GLSL text by the program (core.shader_new) has no
    // SPIR-V: this backend compiles nothing at run time, and the model
    // would be drawn by the scene program in silence -- the black hole
    // was a black frame at 150 fps for as long as Vulkan had been the
    // default. Said once per model instead.
    if core.shader_valid(&m.shader) && m.shader.kind == core.SHADER_CUSTOM &&
       m.shader.fragment_source != shaders.FRAGMENT_DEFAULT {
        who = core.text(m.name)
        if who == "" { who = "a model" }
        println("ae3d: ${who} carries a custom GLSL shader, which the Vulkan backend cannot compile at run time; it is drawn with the scene shader instead. Run the program with AE3D_API=opengl, or make the engine with engine_new_with(platform.API_GL).")
    }

    // A group -- a transform and nothing to draw, what a figure or a
    // scene's hierarchy hangs its children from -- is a model the renderer
    // knows and never draws.
    if core.mesh_vertex_count(m.mesh) == 0 && !m.is_instanced {
        list.add_raw(r.models, m)
        return
    }

    handle = vkmesh.mesh_upload(m.mesh)
    if handle == 0 {
        println("ae3d: Vulkan mesh upload failed (${ae3d_vk_last_error()})")
        return
    }
    m.vbo = handle
    // For the channel's report of the model. What the depth pass merges is
    // asked of the cache at draw time, since this is only true of the second
    // model built from a mesh and every one after.
    m.shares_geometry = vkmesh.mesh_shared(handle)
    // Building a mesh marks it dirty, and what was just uploaded is not an edit
    // waiting to be sent.
    geometry.mesh_clear_dirty(m.mesh)

    if m.is_instanced && core.model_instance_count(m) > 0 {
        m.instance_vbo = ae3d_vk_upload_instances(m.instances)
        m.instances_updated = false
        m.instance_colors_updated = false
        m.instance_phases_updated = false
    }

    resolve_textures(r, m)
    list.add_raw(r.models, m)
}

resolve_textures(r: *VKRenderer, m: *Model) {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null && group.material != null { resolve_one(r, group.material) }
            i = i + 1
        }
        return
    }
    if m.material != null { resolve_one(r, m.material) }
}

resolve_one(r: *VKRenderer, material: *Material) {
    material.texture_stale = false
    if core.text(material.texture_path) != "" && material.texture_id == 0 {
        material.texture_id = renderer_load_texture(r, material.texture_path)
    }
    // The normal too, here rather than at first draw. A rooftop tank is culled
    // for the whole clip, so a normal loaded lazily would never load, and a map
    // named and never loaded is what the critique catches.
    material.normal_stale = false
    if core.text(material.normal_path) != "" && material.normal_id == 0 {
        material.normal_id = renderer_load_texture(r, material.normal_path)
    }
}

// The path was changed after this material had already been given a texture, so
// what it is holding is the one it used to want.
texture_for(r: *VKRenderer, material: *Material) -> int {
    if material == null { return 0 }
    if material.texture_stale {
        if material.texture_id != 0 { renderer_release_texture(r, material.texture_id) }
        material.texture_id = 0
        resolve_one(r, material)
    }
    return material.texture_id
}

// The surface's shape, loaded through the same cache its colour is. A material
// without one binds nothing and the shader is told not to look.
renderer_set_normal_strength(r: *VKRenderer, strength: float) {
    if r != null { r.normal_strength = strength }
}

// What the frame is drawn as: 0 the lit picture, 1 every surface's albedo,
// 2 its normals -- what a bake reads back, and a view for finding out why
// a surface lights the way it does.
renderer_set_capture_channel(r: *VKRenderer, channel: int) {
    if r == null { return }
    r.capture_channel = channel
    // The channel is the surfaces' own numbers: no effect runs over them.
    bypass = 0
    if channel != 0 { bypass = 1 }
    ae3d_vk_set_capture_bypass(bypass)
}

// How wet the scene is, 0..1: rain on every surface that faces up.
renderer_set_wetness(r: *VKRenderer, amount: float) {
    if r != null { r.wetness = amount }
}

// The frame's exposure over every material's (eye adaptation; 1 is off).
renderer_set_frame_exposure(r: *VKRenderer, exposure: float) {
    if r != null { r.frame_exposure = exposure }
}

// Measure every frame's light (a blit and a copy after the last pass,
// ae3d.vkmeter), and the latest measure: the mean linear luminance and the
// near-white share into out[0] and out[1], false until the first is back.
renderer_set_meter(r: *VKRenderer, on: bool) { vkmeter.set_on(on) }

renderer_meter(r: *VKRenderer, out: ptr) -> bool { return vkmeter.measured(out) }

renderer_set_occlusion_strength(r: *VKRenderer, strength: float) {
    if r != null { r.occlusion_strength = strength }
}

// The pixel size of a material's colour texture, for the agent's texel-density
// read, the same figure the OpenGL renderer reports from its own texture list.
renderer_material_texture_size(r: *VKRenderer, material: *Material) -> Vec3 {
    if r == null || material == null { return core.vec3(0.0, 0.0, 0.0) }
    id = texture_for(r, material)
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *VulkanTexture
        if entry != null && entry.handle == id {
            return core.vec3(entry.width * 1.0, entry.height * 1.0, 0.0)
        }
        i = i + 1
    }
    return core.vec3(0.0, 0.0, 0.0)
}

normal_for(r: *VKRenderer, material: *Material) -> int {
    if material == null { return 0 }
    if material.normal_stale {
        if material.normal_id != 0 { renderer_release_texture(r, material.normal_id) }
        material.normal_id = 0
        material.normal_stale = false
        if core.text(material.normal_path) != "" {
            material.normal_id = renderer_load_texture(r, material.normal_path)
        }
    }
    return material.normal_id
}

// Set together, because they are one fact about a surface: a map, and whether
// there is one.
apply_normal_map(r: *VKRenderer, material: *Material) {
    normal = normal_for(r, material)
    ae3d_vk_set_normal_map(normal)
    ae3d_vk_scene_set_int(vkscene.OFF_HASNORMALMAP, normal != 0)
    ae3d_vk_scene_set_float(vkscene.OFF_NORMALSTRENGTH, r.normal_strength)
    ae3d_vk_scene_set_float(vkscene.OFF_OCCLUSIONSTRENGTH, r.occlusion_strength)
    ae3d_vk_scene_set_int(vkscene.OFF_CAPTURECHANNEL, r.capture_channel)
    ae3d_vk_scene_set_float(vkscene.OFF_WETNESS, r.wetness)
    ae3d_vk_scene_set_float(vkscene.OFF_FRAMEEXPOSURE, r.frame_exposure)
}

renderer_remove_model(r: *VKRenderer, m: *Model) {
    if m == null { return }
    if m.vbo != 0 { vkmesh.mesh_free(m.vbo) ; m.vbo = 0 }
    if m.instance_vbo != 0 { vkmesh.mesh_free(m.instance_vbo) ; m.instance_vbo = 0 }

    count = list.size(r.models)
    i = 0
    while i < count {
        if list.get_raw(r.models, i) == m {
            list.remove(r.models, i)
            return
        }
        i = i + 1
    }
}

// The same uniforms the OpenGL renderer sets, written into the block the
// generated shader reads.
// The staging block keeps its contents between draws, so anything the whole
// frame shares is written once here rather than once per model.
// Every program keeps its own copy of the block, so what the whole frame shares
// is written into each of them.
set_frame_uniforms(r: *VKRenderer, light: *Light, cam: *Camera) {
    programs = ae3d_vk_program_count()
    i = 0
    while i < programs {
        ae3d_vk_set_program(i)
        write_frame_uniforms(r, light, cam)
        i = i + 1
    }
    ae3d_vk_set_program(core.SHADER_CUSTOM)
}

write_frame_uniforms(r: *VKRenderer, light: *Light, cam: *Camera) {
    ae3d_vk_scene_set_vec3(vkscene.OFF_VIEWPOS, cam.position.x, cam.position.y, cam.position.z)
    ae3d_vk_scene_set_float(vkscene.OFF_VIEWDISTANCE, core.camera_far(cam))
    // The view's depth plane: what the lamps' clusters and the shadow's
    // cascades both find a pixel by, the frame's whatever else is on.
    forward = core.v3_normalize(cam.front)
    ae3d_vk_scene_set_vec3(vkscene.OFF_VIEWDEPTH, forward.x, forward.y, forward.z)
    ae3d_vk_scene_set_float(vkscene.OFF_VIEWDEPTH + 12, 0.0 - core.v3_dot(forward, cam.position))
    upload_lights(r, key_light(r, light))
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &r.shadow_space)
    ae3d_vk_scene_set_vec3(vkscene.OFF_SHADOWDIRECTION, r.shadow_direction.x,
                           r.shadow_direction.y, r.shadow_direction.z)
    cascade_uniforms(r)
    // The cascades are the key light's shadow only when it is the sun or
    // the moon; a lamp that is the key light is shadowed by its own cube.
    has_cascades = 0
    if ae3d_vk_shadows() == 1 && r.key_cascaded { has_cascades = 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_HASSHADOWMAP, has_cascades)
    lamp_base = 0 - 1
    key_slot = 0 - 1
    if ae3d_vk_shadows() == 1 && r.lamp_shadows != null && r.light_grid != null {
        if lampshadows.slot_count(r.lamp_shadows as *LampShadows) > 0 {
            lamp_base = lightgrid.light_count(r.light_grid as *LightGrid) * 5
            key_slot = r.key_lamp_slot
        }
    }
    ae3d_vk_scene_set_int(vkscene.OFF_LAMPSHADOWBASE, lamp_base)
    ae3d_vk_scene_set_int(vkscene.OFF_KEYLAMPSLOT, key_slot)
    ae3d_vk_scene_set_float(vkscene.OFF_CAUSTICSTIME, r.scene_time)
    // The clouds, for the sky that draws them and the ground they shadow.
    ae3d_vk_scene_set_float(vkscene.OFF_CLOUDCOVER, r.cloud_cover)
    ae3d_vk_scene_set_float(vkscene.OFF_SKYOVERCAST, r.sky_overcast)
    ae3d_vk_scene_set_vec3(vkscene.OFF_SKYOVERCASTCOLOR, r.sky_overcast_color.x, r.sky_overcast_color.y, r.sky_overcast_color.z)
    ae3d_vk_scene_set_float(vkscene.OFF_CLOUDTIME, r.scene_time * r.cloud_wind)
    // The frame for the march's dither only when a temporal pass (TAA or
    // DLSS) will fold it; still otherwise.
    cloud_frame = 0
    if ae3d_vk_taa() == 1 || ae3d_vk_dlss() > 0 { cloud_frame = r.sort_serial % 64 + 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_CLOUDFRAME, cloud_frame)
    sun = key_light(r, light)
    if sun != null {
        ae3d_vk_scene_set_vec3(vkscene.OFF_CLOUDSUN, sun.direction.x, sun.direction.y, sun.direction.z)
        // The colour times the intensity: a sun the sky module has set
        // below the horizon lights the clouds as little as it lights the
        // ground, where its colour alone lit them at noon all night.
        ae3d_vk_scene_set_vec3(vkscene.OFF_CLOUDSUNCOLOR, sun.color.x * sun.intensity, sun.color.y * sun.intensity, sun.color.z * sun.intensity)
    } else {
        ae3d_vk_scene_set_vec3(vkscene.OFF_CLOUDSUN, 0.0, 1.0, 0.0)
        ae3d_vk_scene_set_vec3(vkscene.OFF_CLOUDSUNCOLOR, 1.0, 1.0, 1.0)
    }

    fog_on = 0
    if r.fog.enabled { fog_on = 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_ENABLEFOG, fog_on)
    // The air that hazes distance is the air that scatters a lamp's light, so
    // the volumetric glow rides on the fog: on when there is fog, and lit at
    // the fog's own strength. Steps are the march resolution; scattering is how
    // hard the glow gathers to the lamp, in inverse metres squared.
    ae3d_vk_scene_set_int(vkscene.OFF_ENABLEVOLUMETRICLIGHTING, fog_on)
    ae3d_vk_scene_set_float(vkscene.OFF_VOLUMETRICINTENSITY, r.fog.intensity * 0.010)
    ae3d_vk_scene_set_int(vkscene.OFF_VOLUMETRICSTEPS, 24)
    ae3d_vk_scene_set_float(vkscene.OFF_VOLUMETRICSCATTERING, 0.16)
    ae3d_vk_scene_set_float(vkscene.OFF_FOGSTART, r.fog.start)
    ae3d_vk_scene_set_float(vkscene.OFF_FOGEND, r.fog.end)
    ae3d_vk_scene_set_vec3(vkscene.OFF_FOGCOLOR, r.fog.color.x, r.fog.color.y, r.fog.color.z)
    ae3d_vk_scene_set_float(vkscene.OFF_FOGINTENSITY, r.fog.intensity)

    // The water program predates the light array and reads one light from flat
    // names, the same four the OpenGL backend fills for it.
    first = light
    if list.size(r.lights) > 0 { first = list.get_raw(r.lights, 0) as *Light }
    if first != null {
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTPOS, first.position.x, first.position.y,
                               first.position.z)
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTCOLOR, first.color.x, first.color.y,
                               first.color.z)
        ae3d_vk_scene_set_float(vkscene.OFF_LIGHTINTENSITY, first.intensity)
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTDIRECTION, first.direction.x,
                               first.direction.y, first.direction.z)
    }
}

// A draw has to shade with what its own model asked for and nothing else. The
// block keeps whatever the draw before it wrote, so before a model whose set of
// settings differs from what is loaded, the defaults go in first and wipe the
// difference. Models configured alike agree on the set, which is the common
// case and costs nothing.
apply_shading(r: *VKRenderer, m: *Model, program: int) {
    names = 0 as uint64
    if m != null { names = core.model_uniform_names(m) }
    loaded = r.loaded_names as uint64[]
    ready = r.shading_loaded as int[]
    if ready[program] == 0 || loaded[program] != names {
        set_model_uniforms(r.defaults as *Model)
        loaded[program] = names
        ready[program] = 1
    }
    if m != null { set_model_uniforms(m) }
}

// A mesh edited after the model was registered. Identical geometry is uploaded
// once and shared by everything built from it, so the old handle is let go and
// the new shape uploaded on its own: writing over the shared one would reshape
// every other model drawing what this one used to be.
refresh_geometry(m: *Model) {
    if m.vbo == 0 || geometry.mesh_dirty(m.mesh) != 1 { return }

    vkmesh.mesh_free(m.vbo)
    m.vbo = vkmesh.mesh_upload(m.mesh)
    geometry.mesh_clear_dirty(m.mesh)
    core.model_recalculate_bounds(m)
}

// An instance stream that has moved or changed colour since it was uploaded has
// to be sent again, or a particle system draws its first frame forever.
refresh_instances(m: *Model) {
    if !m.is_instanced { return }
    // A stream that was empty when the model was added -- a weather that
    // starts clear, a crowd not yet spawned -- has no buffer yet; it gets
    // one the first time it has instances to send.
    if m.instance_vbo == 0 {
        if core.model_instance_count(m) == 0 { return }
        m.instance_vbo = ae3d_vk_upload_instances(m.instances)
        m.instances_updated = false
        m.instance_colors_updated = false
        m.instance_phases_updated = false
        return
    }
    // The phase rides in the one stream with the matrix and the colour, so
    // a phase set on its own -- a figure's walk moved without the figure --
    // sends the stream as well. It did not, and a crowd whose only change
    // was its phases stood still.
    if !m.instances_updated && !m.instance_colors_updated && !m.instance_phases_updated { return }
    if ae3d_vk_update_instances(m.instance_vbo, m.instances) == 1 {
        m.instances_updated = false
        m.instance_colors_updated = false
        m.instance_phases_updated = false
    }
}

set_scene_uniforms(r: *VKRenderer, m: *Model) {
    instanced = 0
    if m.is_instanced && core.model_instance_count(m) > 0 { instanced = 1 }
    // A device crowd's tier has its instances on the device, however many
    // the sort counted: an instanced draw with an empty CPU stream.
    if m.device_crowd != null { instanced = 1 }

    // CRITICAL: an instanced model's transform is already in every instance.
    // model_set_instance_position fills each instance's matrix from the model's
    // own scale and rotation, and the shader multiplies the model matrix by the
    // instance's, so sending both applied the scale and the rotation twice: a
    // model scaled 2.4 drew its instances at 5.76.
    points = 0
    if instanced == 1 && core.model_instance_points(m) { points = 1 }
    sent = m.model_matrix
    if points == 1 {
        // Points carry a position and a scale only: the model's rotation
        // and scale go in the model matrix with its translation taken out,
        // and each point puts its own back.
        sent = point_frame(m)
    } else if instanced == 1 {
        sent = core.mat4_ident()
    }
    ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &sent)
    // And last frame's, for the motion vectors.
    previous = core.model_prev_matrix(m, sent)
    ae3d_vk_scene_set_mat4(vkscene.OFF_PREVMODEL, &previous)

    ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, instanced)
    ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEPOINTS, points)
    ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEBILLBOARD, points * m.billboard)
    // This backend draws a model's own instances and nothing else, so a model
    // that has instances always has a colour for each of them.
    ae3d_vk_scene_set_int(vkscene.OFF_USEINSTANCECOLOR, instanced)
    pose(m)

    apply_shading(r, m, active_program(m))
}

// The palette a skinned model is drawn by, into the scene block. A skeleton is
// asked to bring its own up to date first: it rebuilds only the bones whose
// world transform changed, so a figure standing still computes nothing.
pose(m: *Model) {
    // A crowd is posed from its pose bank, a float texture of baked frames
    // uploaded the first time the model draws, by each instance's own phase
    // in the instance stream; the crowd pipeline reads the bank at binding 4
    // and the skeleton's palette is not consulted. The bank is bound for
    // this draw and let go after it, so the next model, skinned or not,
    // draws through its own pipeline.
    if m.pose_bank != null {
        if m.pose_bank_texture == 0 {
            m.pose_bank_texture = vktexture.texture_create_float(posing.posebank_bones(m.pose_bank) * 4,
                                                               posing.posebank_frames(m.pose_bank),
                                                               posing.posebank_data(m.pose_bank))
        }
        ae3d_vk_set_pose_bank(m.pose_bank_texture)
        ae3d_vk_scene_set_int(vkscene.OFF_POSEBANKFRAMES, m.pose_bank_frames)
        ae3d_vk_scene_set_int(vkscene.OFF_ISSKINNED, 1)
        set_impostor_uniforms(m)
        // For the motion vectors: how far a figure's walk and its position
        // moved this frame, from the model's walk cycle and the bank's
        // travel over it.
        travel = 0.0
        step = 0.0
        if m.crowd_walk > 0.0 {
            step = g_frame_seconds / m.crowd_walk
            travel = posing.posebank_travel(m.pose_bank, m.pose_bank_frames) * step
        }
        ae3d_vk_scene_set_float(vkscene.OFF_CROWDTRAVEL, travel)
        ae3d_vk_scene_set_float(vkscene.OFF_CROWDPHASESTEP, step)
        return
    }
    // A water surface takes the camera depth at the same binding, to read
    // the ground under it by.
    set_impostor_uniforms(null)
    aux = 0
    if core.shader_valid(&m.shader) && m.shader.kind == core.SHADER_WATER && ae3d_vk_scene_depth_ready() == 1 {
        aux = 0 - 1
    }
    ae3d_vk_set_pose_bank(aux)
    if m.skeleton == null {
        ae3d_vk_scene_set_int(vkscene.OFF_ISSKINNED, 0)
        return
    }
    sk = m.skeleton as *Skeleton
    skin.skeleton_update(sk)
    ae3d_vk_scene_set_int(vkscene.OFF_ISSKINNED, 1)
    ae3d_vk_scene_set_mat4v(vkscene.OFF_BONES, skin.skeleton_count(sk),
                            core.palette_data(skin.skeleton_palette(sk)))
}

active_program(m: *Model) -> int {
    if m != null && core.shader_valid(&m.shader) { return m.shader.kind }
    return core.SHADER_CUSTOM
}

// The same array the OpenGL backend fills, at the offsets the generator derived
// from the one shader source, so the two cannot disagree about the layout.
// The key light takes slot zero and the registered ones fill what is left, the
// same order the OpenGL backend uploads them in: the two have to agree about
// which light a scene is shadowed by.
// The key light first, then the registered lights nearest the camera
// until the slots are full: a scene may hold more lights than a frame
// takes, and the ones a pixel can see are the ones near it.
// The lights that reach every pixel: the key light in slot zero, then any
// other directional light. The scene's point and spot lights are clustered
// (prepare_clusters) rather than picked here, so each lights what it reaches
// wherever the camera is.
upload_lights(r: *VKRenderer, key: *Light) {
    count = 0
    if key != null {
        upload_light(0, key)
        count = 1
    }
    i = 0
    while i < list.size(r.lights) && count < vkscene.MAX_LIGHTS {
        l = list.get_raw(r.lights, i) as *Light
        if l != key && l.mode == core.MODE_DIRECTIONAL {
            upload_light(count, l)
            count = count + 1
        }
        i = i + 1
    }
    ae3d_vk_scene_set_int(vkscene.OFF_LIGHTCOUNT, count)
    cluster_uniforms(r)
}

// The cascades the lit pass picks a pixel's shadow from: their matrices,
// where each ends along the view and a texel's width in each.
cascade_uniforms(r: *VKRenderer) {
    if r.cascades == null { return }
    c = r.cascades as *Cascades
    k = 0
    while k < cascades.COUNT {
        m = cascades.matrix(c, k)
        ae3d_vk_scene_set_clip_mat4(vkscene.OFF_CASCADEMATRICES + k * 64, &m)
        ae3d_vk_scene_set_float(vkscene.OFF_CASCADESPLITS + k * 4, cascades.split(c, k))
        ae3d_vk_scene_set_float(vkscene.OFF_CASCADETEXELWORLD + k * 4, cascades.texel_world(c, k))
        k = k + 1
    }
    ae3d_vk_scene_set_int(vkscene.OFF_CASCADECOUNT, cascades.COUNT)
}

// The lamps' clusters for this frame, into this frame slot's buffers. After
// ae3d_vk_frame_begin, when the slot's last frame is done with them.
prepare_clusters(r: *VKRenderer, key: *Light, cam: *Camera) {
    if r.light_grid == null { r.light_grid = lightgrid.grid_new() as ptr }
    g = r.light_grid as *LightGrid
    lightgrid.set_tail(g, lampshadows.SLOTS * lampshadows.SLOT_VEC4S * 4)
    lightgrid.build(g, r.lights, key, cam)
    ls = r.lamp_shadows as *LampShadows
    i = 0
    while i < lightgrid.light_count(g) {
        lightgrid.set_shadow_slot(g, i, lampshadows.slot_of(ls, lightgrid.placed_light(g, i)))
        i = i + 1
    }
    // What the shader reads of the lamps' shadows, after the lamps, in
    // Vulkan's clip space.
    lampshadows.write_slots(ls, lightgrid.tail_data(g), true)
    light_bytes = lightgrid.data_floats(g) * 4
    word_bytes = lightgrid.word_count(g) * 4
    if ae3d_vk_clusters_reserve(light_bytes as long, word_bytes as long) != 1 {
        // Without its buffers the frame lists no lamps rather than read
        // past what was made.
        g.light_total = 0
        return
    }
    if light_bytes > 0 { memcpy(ae3d_vk_clusters_lights(), lightgrid.light_data(g), light_bytes as long) }
    memcpy(ae3d_vk_clusters_words(), lightgrid.word_data(g), word_bytes as long)
}

// The grid's shape and the matrices a pixel finds its cell by.
cluster_uniforms(r: *VKRenderer) {
    cells = 0
    if r.light_grid != null {
        g = r.light_grid as *LightGrid
        if lightgrid.light_count(g) > 0 { cells = lightgrid.cell_count(g) }
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDIMS, g.columns as float)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDIMS + 4, g.rows as float)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDIMS + 8, g.slices as float)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDEPTH, g.near)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDEPTH + 4, g.far)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDEPTH + 8, g.depth_scale)
        ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDEPTH + 12, g.depth_bias)
        ae3d_vk_scene_set_mat4(vkscene.OFF_CLUSTERVIEWPROJECTION, (&g.view_projection) as ptr)
    }
    ae3d_vk_scene_set_float(vkscene.OFF_CLUSTERDIMS + 12, cells as float)
}

key_light(r: *VKRenderer, key: *Light) -> *Light {
    if key != null { return key }
    if list.size(r.lights) > 0 { return list.get_raw(r.lights, 0) as *Light }
    return null
}

upload_light(index: int, l: *Light) {
    if l == null { return }
    base = index * vkscene.LIGHT_STRIDE
    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_POSITION, l.position.x, l.position.y, l.position.z)
    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_COLOR, l.color.x, l.color.y, l.color.z)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_INTENSITY, l.intensity)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_AMBIENTSTRENGTH, l.ambient_strength)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_TEMPERATURE, l.temperature)

    kind = 0
    if l.mode == core.MODE_DIRECTIONAL { kind = 1 }
    if l.mode == core.MODE_SPOT { kind = 2 }
    ae3d_vk_scene_set_int(base + vkscene.LIGHT_ISDIRECTIONAL, kind)

    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_DIRECTION, l.direction.x, l.direction.y, l.direction.z)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_CONSTANTATTEN, l.constant_atten)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_LINEARATTEN, l.linear_atten)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_QUADRATICATTEN, l.quadratic_atten)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_SPOTCOSOUTER, l.spot_cos_outer)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_SPOTCOSINNER, l.spot_cos_inner)
}

// A model's own uniforms, written straight into the block. The offset is
// resolved from the name once and kept on the uniform; a name the block has no
// member for stays at -1 and is skipped for the life of the model.
set_model_uniforms(m: *Model) {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        uniform = core.model_uniform(m, i)
        if uniform != null {
            if uniform.block_offset == 0 - 2 {
                uniform.block_offset = ae3d_vk_scene_offset(uniform.name)
            }
            if uniform.block_offset >= 0 {
                if uniform.kind == core.UNIFORM_FLOAT {
                    ae3d_vk_scene_set_float(uniform.block_offset, uniform.number)
                } else if uniform.kind == core.UNIFORM_INT {
                    ae3d_vk_scene_set_int(uniform.block_offset, uniform.integer)
                } else if uniform.kind == core.UNIFORM_VEC3 {
                    ae3d_vk_scene_set_vec3(uniform.block_offset, uniform.vector.x,
                                           uniform.vector.y, uniform.vector.z)
                } else if uniform.kind == core.UNIFORM_FLOAT_ARRAY {
                    ae3d_vk_scene_set_float_array(uniform.block_offset, uniform.array)
                } else if uniform.kind == core.UNIFORM_VEC3_ARRAY {
                    ae3d_vk_scene_set_vec3_array(uniform.block_offset, uniform.array)
                }
            }
        }
        i = i + 1
    }
}

set_material_uniforms(material: *Material) {
    if material == null {
        ae3d_vk_scene_set_vec3(vkscene.OFF_DIFFUSECOLOR, 1.0, 1.0, 1.0)
        ae3d_vk_scene_set_vec3(vkscene.OFF_SPECULARCOLOR, 1.0, 1.0, 1.0)
        ae3d_vk_scene_set_float(vkscene.OFF_METALLIC, 0.0)
        ae3d_vk_scene_set_float(vkscene.OFF_ROUGHNESS, 0.5)
        ae3d_vk_scene_set_float(vkscene.OFF_EXPOSURE, 1.0)
        ae3d_vk_scene_set_float(vkscene.OFF_REFLECTIVITY, 0.0)
        ae3d_vk_scene_set_float(vkscene.OFF_MATERIALALPHA, 1.0)
        return
    }
    ae3d_vk_scene_set_vec3(vkscene.OFF_DIFFUSECOLOR, material.diffuse.x, material.diffuse.y, material.diffuse.z)
    ae3d_vk_scene_set_vec3(vkscene.OFF_SPECULARCOLOR, material.specular.x, material.specular.y, material.specular.z)
    ae3d_vk_scene_set_float(vkscene.OFF_METALLIC, material.metallic)
    ae3d_vk_scene_set_float(vkscene.OFF_ROUGHNESS, material.roughness)
    ae3d_vk_scene_set_float(vkscene.OFF_EXPOSURE, material.exposure)
    ae3d_vk_scene_set_float(vkscene.OFF_REFLECTIVITY, material.reflectivity)
    ae3d_vk_scene_set_float(vkscene.OFF_MATERIALALPHA, material.alpha)
}

// A frame the device would not take is said once, not once a frame: a lost
// device answers every acquire after it with "not ready", and a program that
// keeps running at full speed drawing nothing is the worst way to find out.
report_failed_frame(r: *VKRenderer) {
    r.failed_frames = r.failed_frames + 1
    if r.failed_frames == 1 {
        println("ae3d: Vulkan dropped a frame: ${ae3d_vk_last_error()}")
    }
}

renderer_render(r: *VKRenderer, cam: *Camera, light: *Light) {
    if !r.initialized { return }
    r.scene_time = platform.time() - r.scene_start

    active_light = key_light(r, light)

    declare_scene_depth(r)
    if ae3d_vk_frame_begin(r.clear_r, r.clear_g, r.clear_b, 1.0) != 1 {
        report_failed_frame(r)
        return
    }
    // The frame's structure starts empty and every crowd unsorted.
    vkrays.begin()
    vkcrowd.frame_start()
    // Which lamps have a shadow of their own this frame, before the clusters
    // are cut: each clustered lamp carries its slot.
    choose_lamps(r, active_light, cam)
    prepare_clusters(r, active_light, cam)
    // The engine's own CPU cost is the command building and submission below,
    // not the fence-and-acquire wait frame_begin just blocked on -- that wait
    // is the display pacing the frame, and folding it into "the CPU frame"
    // makes a vsync-limited scene read as CPU-bound when the work is a fraction
    // of a millisecond. Timed from here, after the wait.
    work_started = platform.time()

    // Everything edited since the last frame goes to the device before a
    // single draw is recorded. A refresh replaces the buffer, and the shadow
    // pass had already recorded a draw of the old one when the lit pass
    // replaced it: the submit then read a freed buffer and the device was
    // lost -- silently, since a lost device answers every acquire with "not
    // ready" and the program ran on at full speed drawing nothing.
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            refresh_geometry(m)
            refresh_instances(m)
        }
        i = i + 1
    }

    reserve_ray_scene(r)
    sort_device_crowds(r)
    build_ray_scene(r)

    render_shadow_pass(r, active_light, cam)
    // Filled from this camera every frame rather than cached behind a flag. The
    // flag was one boolean for the whole program while the frustum it guarded
    // belongs to a renderer, so a second camera drawing after a first was culled
    // against the first camera's frustum: the flag was already clear and nothing
    // refilled. A minimap, a reflection or a second viewport is exactly that.
    // Six planes out of one matrix multiply is not worth a cache.
    if core.frustum_culling() { core.camera_fill_frustum(cam, r.frustum) }

    set_frame_uniforms(r, active_light, cam)

    culling = 0
    if core.face_culling() { culling = 1 }
    ae3d_vk_set_face_culling(culling)

    // The seconds since the last frame, for the crowd's motion vectors;
    // a pause or a first frame counts as a short one.
    g_frame_seconds = r.scene_time - r.last_scene_time
    if g_frame_seconds < 0.0 || g_frame_seconds > 0.25 { g_frame_seconds = 0.0 }
    r.last_scene_time = r.scene_time

    unjittered = core.camera_view_projection(cam)
    view_projection = frame_view_projection(r, cam)
    if ae3d_vk_dlss() > 0 { dlss_camera(r, cam) }
    // The last frame's view-projection, for the motion vectors and the
    // temporal pass to find each pixel's history by; this frame's, when
    // there was no last frame.
    previous = unjittered
    if r.prev_vp_valid { previous = r.prev_vp }
    programs = ae3d_vk_program_count()
    i = 0
    ssr_on = ae3d_vk_ssr() == 1
    ssao_on = ae3d_vk_ssao() == 1
    // By ray, the occlusion is the scene shader's and the pass is skipped.
    traced_occlusion = ssao_on && r.ray_occlusion && vkrays.shadows_now()
    if traced_occlusion { ssao_on = false }
    taa_on = ae3d_vk_taa() == 1
    depth_ready = ae3d_vk_scene_depth_ready() == 1 && (ssr_on || ssao_on || taa_on || wants_scene_depth(r))
    while i < programs {
        ae3d_vk_set_program(i)
        ae3d_vk_scene_set_clip_mat4(vkscene.OFF_VIEWPROJECTION, &view_projection)
        if ssr_on || depth_ready {
            ae3d_vk_scene_set_inv_viewproj(vkscene.OFF_INVVIEWPROJECTION, &view_projection)
        }
        // Into every program's block, as the view-projection is: every
        // scene shader writes its motion vector from last frame's view and
        // this frame's nudge, and the temporal pass reads the scene
        // program's.
        ae3d_vk_scene_set_clip_mat4(vkscene.OFF_PREVVIEWPROJECTION, &previous)
        ae3d_vk_scene_set_float(vkscene.OFF_JITTER, r.jitter_x)
        ae3d_vk_scene_set_float(vkscene.OFF_JITTER + 4, r.jitter_y)
        traced_now = 0
        if vkrays.shadows_now() { traced_now = 1 }
        ae3d_vk_scene_set_int(vkscene.OFF_RAYSHADOWS, traced_now)
        ae3d_vk_scene_set_float(vkscene.OFF_SUNANGLE, r.sun_angle)
        reach = 0.0
        if traced_occlusion { reach = ae3d_vk_ssao_radius() }
        ae3d_vk_scene_set_float(vkscene.OFF_RAYOCCLUSION, reach)
        ae3d_vk_scene_set_float(vkscene.OFF_RAYOCCLUSIONSTRENGTH, ae3d_vk_ssao_intensity())
        ae3d_vk_scene_set_float(vkscene.OFF_RAYLAMPRADIUS, r.lamp_radius)
        // The rays trace within the shadow distance, as the map covers.
        ae3d_vk_scene_set_float(vkscene.OFF_RAYREACH, r.shadow_distance)
        ae3d_vk_scene_set_int(vkscene.OFF_RAYFRAME, r.sort_serial)
        // What a water surface needs to read the depth under it back into
        // a position: whether there is one, and the frame's size in pixels.
        has_depth = 0
        if depth_ready { has_depth = 1 }
        ae3d_vk_scene_set_int(vkscene.OFF_HASSCENEDEPTH, has_depth)
        ae3d_vk_scene_set_float(vkscene.OFF_SCREENSIZE, ae3d_vk_render_width() as float)
        ae3d_vk_scene_set_float(vkscene.OFF_SCREENSIZE + 4, ae3d_vk_render_height() as float)
        i = i + 1
    }
    // The sky, first into the pass, after the blocks carry the frame's
    // matrices: its motion vector is the camera's turn since last frame.
    // Its own matrices go into the scene program's block, which it draws
    // from, so that program is current before they are set.
    ae3d_vk_set_program(core.SHADER_CUSTOM)
    draw_skybox(r, cam)
    ae3d_vk_mark_sky_done()

    draw_opaque(r)
    ae3d_vk_mark_opaque_done()
    // The depth the opaque draws left, resolved for the occlusion, the
    // reflection and the water: the frame's own depth, so a figure's
    // silhouette is the one drawn and a picture of a figure is in it too.
    ae3d_vk_resolve_scene_depth()
    // The occlusion over what the opaque pass drew, before the transparent
    // one, so the water is not darkened by the ground it hides.
    if ssao_on && depth_ready { ae3d_vk_draw_ssao() }

    count = list.size(r.models)
    pass = 1
    while pass < 2 {
        i = 0
        while i < count {
            m = list.get_raw(r.models, i) as *Model
            draw_model(r, m, pass == 1)
            i = i + 1
        }
        pass = pass + 1
    }

    r.last_draw_calls = ae3d_vk_draw_calls()
    r.last_pipeline_binds = ae3d_vk_pipeline_binds()
    r.last_set_binds = ae3d_vk_set_binds()
    if ae3d_vk_frame_end() != 1 { report_failed_frame(r) }
    r.prev_vp = unjittered
    r.prev_vp_valid = true
    // Every model's matrix of this frame is last frame's now.
    i = 0
    while i < list.size(r.models) {
        m = list.get_raw(r.models, i) as *Model
        if m != null { core.model_frame_done(m) }
        i = i + 1
    }
    r.taa_frame = r.taa_frame + 1
    r.last_cpu_work_ms = (platform.time() - work_started) * 1000.0
    // The stamps read back at the start of this frame describe the frame that
    // used this slot last, which is the most recent one the GPU has finished.
    r.last_shadow_ms = ae3d_vk_pass_ms(0)
    r.last_scene_ms = ae3d_vk_pass_ms(1)
    r.last_post_ms = ae3d_vk_pass_ms(2)
}

// The same rule the OpenGL backend uses: a model joins a merged draw when
// nothing about it is per-model except where it sits. Transparency stays out,
// since merging would fix the order those surfaces blend in.
batchable(m: *Model) -> bool {
    if !core.draw_merging() { return false }
    if m == null || !m.visible || m.vbo == 0 { return false }
    // An instanced model is its instances, however many: with none it draws
    // nothing, not its mesh once where it stands.
    if m.is_instanced { return false }
    // A skinned figure draws on its own: its vertices are carried by its
    // bones and a merged draw carries a matrix, and the merge pass culls by
    // the model's own bounds, which for a skinned mesh are the bind pose's
    // at the origin -- a figure that had walked up the street vanished the
    // moment the origin left the view, and stood in view while it did.
    if m.skeleton != null { return false }
    if m.device_crowd != null { return false }
    if core.model_group_count(m) > 0 { return false }
    if core.model_uniform_count(m) > 0 { return false }
    if core.shader_valid(&m.shader) { return false }
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    return alpha >= 0.99
}

batch_for(r: *VKRenderer, m: *Model) -> *VKBatch {
    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *VKBatch
        if b.mesh == m.vbo && core.material_equals(b.material as *Material, m.material) {
            return b
        }
        i = i + 1
    }

    if r.batch_count >= list.size(r.batches) {
        fresh = heap.new(VKBatch)
        fresh.instances = geometry.inst_create()
        fresh.members = list.new()
        fresh.handle = 0
        fresh.count = 0
        fresh.mesh = 0
        fresh.material = null
        fresh.stale = true
        list.add_raw(r.batches, fresh)
    }
    b = list.get_raw(r.batches, r.batch_count) as *VKBatch
    if b.mesh != m.vbo || b.material != m.material as ptr { b.stale = true }
    b.mesh = m.vbo
    b.material = m.material as ptr
    b.first = m as ptr
    b.count = 0
    r.batch_count = r.batch_count + 1
    return b
}

draw_opaque(r: *VKRenderer) {
    r.batch_count = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if batchable(m) {
            core.model_sync_transform(m)
            if core.frustum_culling() &&
               !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
                i = i + 1
                continue
            }
            moved = m.draw_stamp != m.world_stamp
            m.draw_stamp = m.world_stamp
            b = batch_for(r, m)
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            draw_model(r, m, false)
        }
        i = i + 1
    }

    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *VKBatch
        if b.count != list.size(b.members) { b.stale = true }
        if b.count == 1 {
            draw_model(r, b.first as *Model, false)
        } else if b.count > 1 {
            draw_batch(r, b)
        }
        i = i + 1
    }
}

// An instance stream is a buffer of its own on this backend. A group that
// has not changed keeps the buffer it already sent; one that has is written
// into its ring, one slot a frame in flight, the way a model's own stream
// is. It used to free the buffer and upload a fresh one, and freeing a
// buffer the device may still be reading waits for the whole device: a
// scene with one spinning sphere in a batch stalled seven milliseconds a
// frame on that wait, at 144 frames a second.
sync_batch_instances(b: *VKBatch) {
    if !b.stale { return }
    while list.size(b.members) > b.count { list.remove(b.members, list.size(b.members) - 1) }
    geometry.inst_resize(b.instances, b.count)
    i = 0
    while i < b.count {
        m = list.get_raw(b.members, i) as *Model
        geometry.inst_set_matrix(b.instances, i, &m.model_matrix)
        i = i + 1
    }
    if b.handle == 0 || ae3d_vk_update_instances(b.handle, b.instances) != 1 {
        if b.handle != 0 { vkmesh.mesh_free(b.handle) }
        b.handle = ae3d_vk_upload_instances(b.instances)
    }
    b.stale = false
}

draw_batch(r: *VKRenderer, b: *VKBatch) {
    sync_batch_instances(b)
    if b.handle == 0 { return }

    first = b.first as *Model
    ae3d_vk_set_program(core.SHADER_CUSTOM)
    identity = core.mat4_ident()
    ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &identity)
    // A merged batch's members stand still: last frame's matrix is this
    // frame's, or the block would carry whichever model set it last and
    // the whole street would read as moving.
    ae3d_vk_scene_set_mat4(vkscene.OFF_PREVMODEL, &identity)
    ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, 1)
    ae3d_vk_scene_set_int(vkscene.OFF_INSTANCEPOINTS, 0)
    // The merged stream carries no per-instance colour, and its members already
    // share one material, so the shader is told to leave the tint alone.
    ae3d_vk_scene_set_int(vkscene.OFF_USEINSTANCECOLOR, 0)

    // A batch's members carry no settings of their own, so the block must not
    // still be holding the ones the model before them asked for.
    apply_shading(r, null, core.SHADER_CUSTOM)
    set_material_uniforms(first.material)

    texture = 0
    if first.material != null { texture = texture_for(r, first.material) }
    blend = 0
    ae3d_vk_set_blend(blend)
    ae3d_vk_draw(b.mesh, texture, b.handle, b.count)
}

// What a group is made of. A group carries its own material only when the file
// it came from gave it one: an OBJ whose mtllib line is commented out, or which
// names a material no mtl defines, produces groups with none. Those fall back
// to the model's own material, which is the only thing a caller can set from
// outside, so model_set_diffuse and its friends reach a loaded model instead of
// being silently dropped for having groups at all.
group_material(m: *Model, group: *MaterialGroup) -> *Material {
    if group == null { return m.material }
    if group.material != null { return group.material }
    return m.material
}

draw_model(r: *VKRenderer, m: *Model, transparent_pass: bool) {
    if m == null || !m.visible || m.vbo == 0 { return }

    // The pass filter first, off the one cheap read it needs. A model on the
    // wrong side of the opaque/transparent split takes no part in this pass, so
    // it is dropped here rather than after its transform, its skin and its cull
    // have been recomputed for a frame it never draws in -- the transparent
    // pass would otherwise re-fit every skinned mesh in the scene and throw the
    // result away.
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    is_transparent = alpha < 0.99
    if is_transparent != transparent_pass { return }

    core.model_sync_transform(m)
    // Before the cull, because a skinned mesh's own bounds are the bind pose's
    // and say nothing about where its bones have carried it.
    if m.skeleton != null { skin.skeleton_fit(m.skeleton as *Skeleton, m) }
    // A device crowd's bounds are its figures', which the CPU never sees:
    // the sort's distance cull is its cull, and the sphere test is skipped.
    if m.device_crowd == null && core.frustum_culling() &&
       !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
        return
    }

    instances = 0
    if m.is_instanced { instances = core.model_instance_count(m) }
    // As on OpenGL: an instanced model with nothing active draws nothing.
    // The draw gave it the identity instance, one copy of its mesh where it
    // stands, appearing and vanishing as its instances came and went.
    if m.is_instanced && instances <= 0 && m.device_crowd == null { return }

    program = core.SHADER_CUSTOM
    if core.shader_valid(&m.shader) { program = m.shader.kind }
    ae3d_vk_set_program(program)

    set_scene_uniforms(r, m)
    blend = 0
    if is_transparent { blend = 1 }
    ae3d_vk_set_blend(blend)

    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null {
                material = group_material(m, group)
                set_material_uniforms(material)
                texture = 0
                if material != null { texture = texture_for(r, material) }
                draw_instances(m, texture, instances)
            }
            i = i + 1
        }
        return
    }

    set_material_uniforms(m.material)
    apply_normal_map(r, m.material)
    texture = 0
    if m.material != null { texture = texture_for(r, m.material) }
    draw_instances(m, texture, instances)
}

// The draw itself: a device crowd's tier by the count the sort wrote, or
// the model's own instances.
draw_instances(m: *Model, texture: int, instances: int) {
    if m.device_crowd != null {
        dc = m.device_crowd as *DeviceCrowd
        vkcrowd.draw(m.vbo, texture, dc.handle, m.device_tier, m.device_part)
        return
    }
    ae3d_vk_draw(m.vbo, texture, m.instance_vbo, instances)
}

renderer_update_viewport(r: *VKRenderer, width: int, height: int) {
    if r.initialized { ae3d_vk_resize(width, height) }
}

free_batches(batches: ptr) {
    if batches == null { return }
    i = 0
    while i < list.size(batches) {
        b = list.get_raw(batches, i) as *VKBatch
        if b != null {
            if b.handle != 0 { vkmesh.mesh_free(b.handle) }
            if b.instances != null { geometry.inst_destroy(b.instances) }
            if b.members != null { list.free(b.members) }
            heap.free(b)
        }
        i = i + 1
    }
    list.free(batches)
}

renderer_cleanup(r: *VKRenderer) {
    free_batches(r.batches)
    free_batches(r.shadow_batches)
    free_batches(r.lamp_batches)
    r.batches = null
    r.shadow_batches = null
    r.lamp_batches = null
    r.batch_count = 0
    r.shadow_batch_count = 0
    r.lamp_batch_count = 0

    if r == null || !r.initialized { return }
    if r.skybox != null { skybox_free(r, r.skybox as *Skybox) ; r.skybox = null }
    if r.cloud_shape_texture != 0 { ae3d_vk_texture_destroy(r.cloud_shape_texture) ; r.cloud_shape_texture = 0 }
    if r.cloud_weather_texture != 0 { ae3d_vk_texture_destroy(r.cloud_weather_texture) ; r.cloud_weather_texture = 0 }
    if r.screen_handle != 0 { vkmesh.mesh_free(r.screen_handle) ; r.screen_handle = 0 }
    if r.screen_mesh != null { core.mesh_destroy(r.screen_mesh) ; r.screen_mesh = null }
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null {
            if m.vbo != 0 { vkmesh.mesh_free(m.vbo) ; m.vbo = 0 }
            if m.instance_vbo != 0 { vkmesh.mesh_free(m.instance_vbo) ; m.instance_vbo = 0 }
        }
        i = i + 1
    }
    list.clear(r.models)
    vkcrowd.stop()
    vkrays.stop()
    ae3d_vk_shutdown()
    // The backend's mesh table went with it, and the device goes after it.
    vkmesh.mesh_forget()
    vkdevice.close()
    r.initialized = false
}

renderer_model_count(r: *VKRenderer) -> int {
    return list.size(r.models)
}

// The OpenGL renderer has had this since it had a model list; Vulkan carried
// the count and no way to reach what was counted, so anything walking the scene
// worked on one backend and returned nothing on the other.
renderer_model(r: *VKRenderer, index: int) -> *Model {
    return list.get_raw(r.models, index) as *Model
}

renderer_draw_calls(r: *VKRenderer) -> int {
    return r.last_draw_calls
}

renderer_post_active(r: *VKRenderer) -> bool { return ae3d_vk_post_active() == 1 }
renderer_shadow_ms(r: *VKRenderer) -> float { return r.last_shadow_ms }

// The frame's stages, as the device timed them: 0 shadow, 1 scene (the
// whole of 3 to 7), 2 post, 3 camera depth (nothing now: the depth is
// resolved after the opaque draws, inside the occlusion stage), 4 sky, 5
// opaque, 6 occlusion (the depth resolve and the occlusion over it), 7
// transparent. What a change to the engine changes, stage by stage.
const STAGE_COUNT = 8
renderer_stage_ms(r: *VKRenderer, stage: int) -> float { return ae3d_vk_pass_ms(stage) }
stage_name(stage: int) -> string {
    if stage == 0 { return "shadow" }
    if stage == 1 { return "scene" }
    if stage == 2 { return "post" }
    if stage == 3 { return "camdepth" }
    if stage == 4 { return "sky" }
    if stage == 5 { return "opaque" }
    if stage == 6 { return "occlusion" }
    if stage == 7 { return "transparent" }
    return "?"
}
renderer_scene_ms(r: *VKRenderer) -> float { return r.last_scene_ms }
renderer_cpu_work_ms(r: *VKRenderer) -> float { return r.last_cpu_work_ms }
renderer_post_ms(r: *VKRenderer) -> float { return r.last_post_ms }
renderer_program_binds(r: *VKRenderer) -> int { return r.last_pipeline_binds }
renderer_material_binds(r: *VKRenderer) -> int { return r.last_set_binds }

renderer_set_fog(r: *VKRenderer, f: *Fog) {
    if f == null { r.fog = core.fog_none() ; return }
    r.fog.color = f.color
    r.fog.start = f.start
    r.fog.end = f.end
    r.fog.intensity = f.intensity
    r.fog.enabled = f.enabled
}

renderer_fog(r: *VKRenderer) -> Fog { return r.fog }

// The same bound the OpenGL backend keeps: zero fits the map to the scene,
// anything else fits it to what the camera can see.
renderer_set_shadow_distance(r: *VKRenderer, metres: float) {
    r.shadow_distance = metres
}

renderer_shadow_distance(r: *VKRenderer) -> float { return r.shadow_distance }

renderer_set_clear_color(r: *VKRenderer, red: float, green: float, blue: float) {
    r.clear_r = red
    r.clear_g = green
    r.clear_b = blue
}
