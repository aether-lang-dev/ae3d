// Motion capture in BVH files (#855).
//
// A BVH file (Biovision hierarchy, what motion capture systems export: Xsens,
// Vicon, OptiTrack, the CMU and 100STYLE libraries) is a skeleton and then
// its motion. The skeleton is joints in braces, each with its offset from
// its parent and the channels that drive it (positions and rotations about
// x, y and z, in the order they are applied). The motion is one line of
// numbers a frame, every joint's channels in the order the skeleton listed
// them, rotations in degrees.
//
// A capture read here is a rig no skin wears (pose.of_joints) and its frames
// as a take for that rig, which the retargeter carries onto a figure. The
// skeleton's rest pose is its offsets with no turn, the pose its channels
// turn from. A joint's "End Site" (the tip of a head, a toe or a finger) is
// a joint of its own, named after its parent with "_end", so the tip a foot
// rolls about is there for the feet to find.

import std.fs
import std.heap
import std.string
import std.bytes
import ae3d.core
import ae3d.pose
import ae3d.clips
import ae3d.inflate

exports (
    Capture, load, load_asf, capture_free, rig, take, frames, frame_time, unit, error
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// The most joints a skeleton may have, End Sites included.
const MOST_JOINTS = 512
// Channel kinds.
const X_POSITION = 0
const Y_POSITION = 1
const Z_POSITION = 2
const X_ROTATION = 3
const Y_ROTATION = 4
const Z_ROTATION = 5

struct Capture {
    rig: ptr                       // *Rig
    joints: int
    frames: int
    frame_time: float              // seconds a frame
    unit: float                    // metres a file unit
    channels: int                  // numbers a frame
    offsets: ptr                   // float[joints * 3]: each joint's offset from its parent, in file units
    first: ptr                     // int[joints]: each joint's first channel in a frame
    counts: ptr                    // int[joints]: and how many it has
    kinds: ptr                     // int[channels]: what each channel drives
    data: ptr                      // float[frames * channels]
    turns: ptr                     // float[frames * joints * 4]: each joint's turn a frame, or null (an ASF/AMC capture's)
    places: ptr                    // float[frames * 3]: and the root's place, in file units
}

var g_text: string = ""
var g_at = 0
var g_length = 0
var g_error: string = ""
var g_number: ptr = null           // one double, the parser's out-value

// What the last load that failed said, "" after one that did not.
error() -> string { return g_error }

// A file's text: as it is, or a gzip'd one (`.gz`) inflated (ae3d.inflate).
// Whole captures run to megabytes of numbers; gzip'd, a third of that.
read_text(path: string) -> (string, string) {
    n = string.length(path)
    if n < 3 || string.equals(string.substring(path, n - 3, n), ".gz") != 1 { return fs.read(path) }
    packed, length, err = fs.read_binary(path)
    if err != "" { return "", err }
    buffer = bytes.new(length + 4)
    bytes.copy_from_string(buffer, 0, packed, length)
    z = inflate.gzip(bytes.data(buffer), length, length * 4 + 1024, 0)
    bytes.free(buffer)
    if inflate.failed(z) {
        why = inflate.reason(inflate.error_code(z))
        inflate.done(z)
        return "", "not a gzip file: ${why}"
    }
    plain = inflate.size(z)
    raw = inflate.take(z)
    inflate.done(z)
    text = bytes.string_from_ptr(raw, plain)
    free(raw)
    return text, ""
}

// The capture in the BVH file at `path` (gzip'd when it ends in .gz), with
// lengths in metres:
// `metres_per_unit` of them a file unit, or, given 0, read from the
// skeleton's height (a figure 3 to 300 units tall is taken to be in
// centimetres, one under 3 in metres, and one taller in millimetres; give
// 0.0254 for a file in inches). Null when the file cannot be read or is not
// a BVH file (error() says why).
load(path: string, metres_per_unit: float) -> *Capture {
    g_error = ""
    content, err = read_text(path)
    if err != "" {
        g_error = "cannot read the file"
        return null
    }
    g_text = content
    g_at = 0
    g_length = string.length(content)
    if g_number == null { g_number = calloc(1, 8) }
    c = heap.new(Capture)
    names = calloc(MOST_JOINTS, 8)
    parents = calloc(MOST_JOINTS, 4) as int[]
    c.offsets = calloc(MOST_JOINTS * 3, 8)
    c.first = calloc(MOST_JOINTS, 4)
    c.counts = calloc(MOST_JOINTS, 4)
    kind_room = MOST_JOINTS * 6
    c.kinds = calloc(kind_room, 4)
    good = read_skeleton(c, names, parents)
    if good { good = read_motion(c) }
    if good && c.joints > 0 {
        c.unit = metres_per_unit
        if c.unit <= 0.0 { c.unit = unit_of_height(c, parents) }
        rest = calloc(c.joints * pose.FLOATS, 8)
        offsets = c.offsets as float[]
        j = 0
        while j < c.joints {
            pose.set_translation(rest, j, core.vec3(offsets[j * 3] * c.unit, offsets[j * 3 + 1] * c.unit, offsets[j * 3 + 2] * c.unit))
            pose.set_rotation(rest, j, core.quat_ident())
            pose.set_scale(rest, j, core.vec3(1.0, 1.0, 1.0))
            j = j + 1
        }
        c.rig = pose.of_joints(c.joints, names, parents, rest) as ptr
        free(rest)
    }
    j = 0
    while j < c.joints {
        string.release_kept((names as ptr[])[j])
        j = j + 1
    }
    free(names)
    free(parents as ptr)
    string.free(content)
    g_text = ""
    if !good || c.rig == null {
        if g_error == "" { g_error = "no skeleton" }
        capture_free(c)
        return null
    }
    return c
}

capture_free(c: *Capture) {
    if c == null { return }
    if c.rig != null { pose.rig_free(c.rig as *Rig) }
    free(c.offsets)
    free(c.first)
    free(c.counts)
    free(c.kinds)
    if c.data != null { free(c.data) }
    if c.turns != null { free(c.turns) }
    if c.places != null { free(c.places) }
    heap.free(c)
}

rig(c: *Capture) -> *Rig { return c.rig as *Rig }
frames(c: *Capture) -> int { return c.frames }
frame_time(c: *Capture) -> float { return c.frame_time }
unit(c: *Capture) -> float { return c.unit }

// --- the skeleton ---------------------------------------------------------------------------------

// The joints, their parents, offsets and channels, up to MOTION.
read_skeleton(c: *Capture, names: ptr, parents: int[]) -> bool {
    stack = calloc(MOST_JOINTS, 4) as int[]
    depth = 0
    pending = 0 - 1                // the joint named, its brace not yet open
    offsets = c.offsets as float[]
    first = c.first as int[]
    counts = c.counts as int[]
    kinds = c.kinds as int[]
    good = true
    while good {
        word = next_token()
        if string.length(word) == 0 {
            g_error = "the file ends before its MOTION"
            good = false
        } else if string.equals(word, "MOTION") == 1 {
            string.free(word)
            break
        } else if string.equals(word, "ROOT") == 1 || string.equals(word, "JOINT") == 1 || string.equals(word, "End") == 1 {
            title = next_token()
            if string.equals(word, "End") == 1 {
                string.free(title)
                up = 0 - 1
                if depth > 0 { up = stack[depth - 1] }
                if up >= 0 {
                    above, _why = string.from_ptr((names as ptr[])[up])
                    title = string.concat(above, "_end")
                } else {
                    title = string.copy("end")
                }
            }
            if c.joints >= MOST_JOINTS {
                g_error = "more joints than a skeleton may have"
                string.free(title)
                good = false
            } else {
                j = c.joints
                (names as ptr[])[j] = string.keep(title)
                string.free(title)
                parents[j] = 0 - 1
                if depth > 0 { parents[j] = stack[depth - 1] }
                first[j] = c.channels
                counts[j] = 0
                c.joints = j + 1
                pending = j
            }
        } else if string.equals(word, "{") == 1 {
            if pending >= 0 {
                stack[depth] = pending
                depth = depth + 1
                pending = 0 - 1
            }
        } else if string.equals(word, "}") == 1 {
            if depth > 0 { depth = depth - 1 }
        } else if string.equals(word, "OFFSET") == 1 {
            if depth > 0 {
                j = stack[depth - 1]
                offsets[j * 3] = next_number()
                offsets[j * 3 + 1] = next_number()
                offsets[j * 3 + 2] = next_number()
            }
        } else if string.equals(word, "CHANNELS") == 1 {
            n = next_number() as int
            if depth == 0 || n < 0 || n > 6 {
                g_error = "a CHANNELS line outside a joint, or with more than six"
                good = false
            } else {
                j = stack[depth - 1]
                first[j] = c.channels
                counts[j] = n
                k = 0
                while k < n {
                    kind_word = next_token()
                    kinds[c.channels] = kind_of(kind_word)
                    string.free(kind_word)
                    c.channels = c.channels + 1
                    k = k + 1
                }
            }
        }
        string.free(word)
    }
    free(stack as ptr)
    return good
}

kind_of(word: string) -> int {
    kinds = ["Xposition", "Yposition", "Zposition", "Xrotation", "Yrotation", "Zrotation"]
    k = 0
    while k < 6 {
        if string.equals(word, kinds[k]) == 1 { return k }
        k = k + 1
    }
    g_error = "a channel of a kind BVH has none of"
    return X_ROTATION
}

// The metres a unit by the skeleton's height at rest (see load).
unit_of_height(c: *Capture, parents: int[]) -> float {
    offsets = c.offsets as float[]
    ys = calloc(c.joints, 8) as float[]
    low = 0.0
    high = 0.0
    j = 0
    while j < c.joints {
        y = offsets[j * 3 + 1]
        if parents[j] >= 0 { y = y + ys[parents[j]] }
        ys[j] = y
        if j == 0 || y < low { low = y }
        if j == 0 || y > high { high = y }
        j = j + 1
    }
    free(ys as ptr)
    height = high - low
    if height < 3.0 { return 1.0 }
    if height <= 300.0 { return 0.01 }
    return 0.001
}

// --- the motion -----------------------------------------------------------------------------------

// "Frames: n", "Frame Time: s", then n frames of numbers.
read_motion(c: *Capture) -> bool {
    word = next_token()
    if string.equals(word, "Frames:") != 1 {
        string.free(word)
        g_error = "no Frames: after MOTION"
        return false
    }
    string.free(word)
    c.frames = next_number() as int
    a = next_token()
    b = next_token()
    good = string.equals(a, "Frame") == 1 && string.equals(b, "Time:") == 1
    string.free(a)
    string.free(b)
    if !good || c.frames <= 0 {
        g_error = "no Frame Time:, or no frames"
        return false
    }
    c.frame_time = next_number()
    if c.frame_time <= 0.0 {
        g_error = "a frame time of no length"
        return false
    }
    total = c.frames * c.channels
    c.data = calloc(total + 1, 8)
    data = c.data as float[]
    i = 0
    while i < total {
        skip_blanks()
        if g_at >= g_length {
            g_error = "the file ends before its last frame"
            return false
        }
        data[i] = next_number()
        i = i + 1
    }
    return true
}

// --- the take -----------------------------------------------------------------------------------

// Frames `from` to `to` (inclusive; -1 for the last) of the capture as a
// take named `title` for its rig, at the capture's own rate, its contacts,
// speed and footfalls found. The caller owns it (clips.take_free).
take(c: *Capture, title: string, from: int, to: int) -> *Take {
    r = c.rig as *Rig
    a = from
    if a < 0 { a = 0 }
    b = to
    if b < 0 || b >= c.frames { b = c.frames - 1 }
    if b < a { b = a }
    t = clips.from_frames(r, title, b - a + 1, 1.0 / c.frame_time)
    f = a
    while f <= b {
        pose_of(c, f, clips.frame(t, f - a))
        f = f + 1
    }
    clips.find_contacts(t, r)
    return t
}

// Frame `f` as a pose: each joint at its offset, or where its position
// channels put it, turned by its rotation channels in the order the file
// lists them (Z, X, Y is the turn Rz Rx Ry).
pose_of(c: *Capture, f: int, out: ptr) {
    if c.turns != null {
        turned_of(c, f, out)
        return
    }
    offsets = c.offsets as float[]
    first = c.first as int[]
    counts = c.counts as int[]
    kinds = c.kinds as int[]
    data = c.data as float[]
    row = f * c.channels
    j = 0
    while j < c.joints {
        x = offsets[j * 3]
        y = offsets[j * 3 + 1]
        z = offsets[j * 3 + 2]
        q = core.quat_ident()
        k = 0
        while k < counts[j] {
            at = first[j] + k
            v = data[row + at]
            kind = kinds[at]
            if kind == X_POSITION { x = v }
            if kind == Y_POSITION { y = v }
            if kind == Z_POSITION { z = v }
            if kind >= X_ROTATION {
                axis = core.vec3(1.0, 0.0, 0.0)
                if kind == Y_ROTATION { axis = core.vec3(0.0, 1.0, 0.0) }
                if kind == Z_ROTATION { axis = core.vec3(0.0, 0.0, 1.0) }
                q = core.quat_mul(q, core.quat_rotate(v * 0.017453292519943295, axis))
            }
            k = k + 1
        }
        pose.set_translation(out, j, core.vec3(x * c.unit, y * c.unit, z * c.unit))
        pose.set_rotation(out, j, core.quat_normalize(q))
        pose.set_scale(out, j, core.vec3(1.0, 1.0, 1.0))
        j = j + 1
    }
}

// Frame `f` of a capture read as turns (load_asf): each joint at its
// offset turned as the frame has it, the root where the frame puts it.
turned_of(c: *Capture, f: int, out: ptr) {
    offsets = c.offsets as float[]
    turns = c.turns as float[]
    places = c.places as float[]
    j = 0
    while j < c.joints {
        at = (f * c.joints + j) * 4
        x = offsets[j * 3]
        y = offsets[j * 3 + 1]
        z = offsets[j * 3 + 2]
        if j == 0 {
            x = places[f * 3]
            y = places[f * 3 + 1]
            z = places[f * 3 + 2]
        }
        pose.set_translation(out, j, core.vec3(x * c.unit, y * c.unit, z * c.unit))
        pose.set_rotation(out, j, core.quat_normalize(core.quat(turns[at], turns[at + 1], turns[at + 2], turns[at + 3])))
        pose.set_scale(out, j, core.vec3(1.0, 1.0, 1.0))
        j = j + 1
    }
}

// --- reading the text -----------------------------------------------------------------------------

is_blank(ch: int) -> bool { return ch == 32 || ch == 9 || ch == 10 || ch == 13 }

skip_blanks() {
    while g_at < g_length && is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
}

// The next run of characters that are not blank, made for this call; ""
// at the end of the text.
next_token() -> string {
    skip_blanks()
    start = g_at
    while g_at < g_length && !is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
    if g_at == start { return string.copy("") }
    return string.substring(g_text, start, g_at)
}

next_number() -> float {
    word = next_token()
    value = 0.0
    if string.length(word) > 0 && string.to_double_raw(word, g_number) != 0 { value = (g_number as float[])[0] }
    string.free(word)
    return value
}

// --- Acclaim ASF/AMC (#912) ------------------------------------------------------------------------

// A skeleton in an ASF file and a take of it in an AMC file: CMU's motion
// capture library's own format. The ASF gives each bone the way it points
// and its length at rest (in the world's frame), its own axis frame (`axis`,
// angles about the world's axes in the order given), and the channels the
// AMC drives it by (`dof`). The AMC gives a frame number, then each moving
// bone's channel values. A bone turns about its axis frame: its turn in its
// parent's frame is C E C^-1, C its axis frame and E its channels' angles
// taken in turn about x, y and z. The root carries the place. Lengths are in
// units of 1/length inches (`:units length 0.45` is 5.64 cm a unit), angles
// in degrees unless `:units angle rad`.
//
// It is read into the same Capture a BVH file is: a joint at each bone's
// start (its parent's end), its offset its parent bone's length along its
// direction, the rest pose turned nowhere; a bone with nothing hanging from
// it has an end joint of its own (name_end), as a BVH End Site does. So
// retargeting and everything after it take a CMU capture as they take any
// other. Its humanoid map is pose's SCHEME_ASF.

// What ASF channels drive.
const DOF_RX = 0
const DOF_RY = 1
const DOF_RZ = 2
const DOF_TX = 3
const DOF_TY = 4
const DOF_TZ = 5
const DOF_LENGTH = 6
// The most bones an ASF skeleton may have.
const MOST_BONES = 256

// An ASF skeleton as read: its bones' rest and channels, the root's.
struct Asf {
    bones: int
    names: ptr                     // ptr[MOST_BONES]: string.keep references
    directions: ptr                // float[bones * 3]
    lengths: ptr                   // float[bones]
    axes: ptr                      // float[bones * 4]: each bone's axis frame, a turn
    dofs: ptr                      // int[bones * 7]: its channels in the AMC's order
    dof_counts: ptr                // int[bones]
    parents: ptr                   // int[bones]: its parent bone, -1 for the root's children
    root_dofs: ptr                 // int[7]
    root_dof_count: int
    root_place: Vec3               // where the root stands at rest, in units
    root_axis: Quat                // its axis frame (`orientation`)
    length: float                  // the `:units length`
    degrees: bool
}

// The capture in the ASF skeleton at `asf_path` and the AMC take at
// `amc_path`, `fps` frames a second (CMU's are 120), with lengths in metres:
// `metres_per_unit` of them a file unit, or, given 0, as the ASF's units
// say. Null when either cannot be read (error() says why).
load_asf(asf_path: string, amc_path: string, fps: float, metres_per_unit: float) -> *Capture {
    g_error = ""
    if fps <= 0.0 {
        g_error = "no frame rate"
        return null
    }
    if g_number == null { g_number = calloc(1, 8) }
    s = read_asf(asf_path)
    if s == null { return null }
    unit = metres_per_unit
    if unit <= 0.0 { unit = 0.0254 / s.length }
    c = heap.new(Capture)
    c.unit = unit
    c.frame_time = 1.0 / fps
    c.offsets = calloc(MOST_JOINTS * 3, 8)
    c.first = calloc(MOST_JOINTS, 4)
    c.counts = calloc(MOST_JOINTS, 4)
    c.kinds = calloc(1, 4)
    // The joints: the root, a joint at each bone's start, parents first, and
    // an end joint for each bone nothing hangs from.
    names = calloc(MOST_JOINTS, 8)
    parents = calloc(MOST_JOINTS, 4) as int[]
    joint_of = calloc(MOST_BONES, 4) as int[]
    offsets = c.offsets as float[]
    (names as ptr[])[0] = string.keep("root")
    parents[0] = 0 - 1
    offsets[0] = s.root_place.x
    offsets[1] = s.root_place.y
    offsets[2] = s.root_place.z
    c.joints = 1
    directions = s.directions as float[]
    lengths = s.lengths as float[]
    bone_parents = s.parents as int[]
    b = 0
    while b < s.bones {
        joint_of[b] = 0 - 1
        b = b + 1
    }
    placed = 0
    pass = 0
    while placed < s.bones && pass < s.bones + 1 {
        b = 0
        while b < s.bones {
            up = bone_parents[b]
            if joint_of[b] < 0 && (up < 0 || joint_of[up] >= 0) && c.joints < MOST_JOINTS {
                j = c.joints
                joint_of[b] = j
                (names as ptr[])[j] = string.keep(name_at(s, b))
                if up < 0 {
                    parents[j] = 0
                } else {
                    parents[j] = joint_of[up]
                    offsets[j * 3] = directions[up * 3] * lengths[up]
                    offsets[j * 3 + 1] = directions[up * 3 + 1] * lengths[up]
                    offsets[j * 3 + 2] = directions[up * 3 + 2] * lengths[up]
                }
                c.joints = j + 1
                placed = placed + 1
            }
            b = b + 1
        }
        pass = pass + 1
    }
    b = 0
    while b < s.bones {
        leaf = true
        k = 0
        while k < s.bones {
            if bone_parents[k] == b { leaf = false }
            k = k + 1
        }
        if leaf && joint_of[b] >= 0 && c.joints < MOST_JOINTS {
            j = c.joints
            end_name = string.concat(name_at(s, b), "_end")
            (names as ptr[])[j] = string.keep(end_name)
            string.free(end_name)
            parents[j] = joint_of[b]
            offsets[j * 3] = directions[b * 3] * lengths[b]
            offsets[j * 3 + 1] = directions[b * 3 + 1] * lengths[b]
            offsets[j * 3 + 2] = directions[b * 3 + 2] * lengths[b]
            c.joints = j + 1
        }
        b = b + 1
    }
    good = placed == s.bones
    if !good { g_error = "a bone hangs from no bone the hierarchy reaches" }
    if good { good = read_amc(c, s, amc_path, joint_of) }
    if good {
        rest = calloc(c.joints * pose.FLOATS, 8)
        j = 0
        while j < c.joints {
            pose.set_translation(rest, j, core.vec3(offsets[j * 3] * unit, offsets[j * 3 + 1] * unit, offsets[j * 3 + 2] * unit))
            pose.set_rotation(rest, j, core.quat_ident())
            pose.set_scale(rest, j, core.vec3(1.0, 1.0, 1.0))
            j = j + 1
        }
        c.rig = pose.of_joints(c.joints, names, parents, rest) as ptr
        free(rest)
    }
    j = 0
    while j < c.joints {
        string.release_kept((names as ptr[])[j])
        j = j + 1
    }
    free(names)
    free(parents as ptr)
    free(joint_of as ptr)
    asf_free(s)
    if !good || c.rig == null {
        if g_error == "" { g_error = "no skeleton" }
        capture_free(c)
        return null
    }
    return c
}

name_at(s: *Asf, b: int) -> string {
    text, _why = string.from_ptr((s.names as ptr[])[b])
    return text
}

asf_free(s: *Asf) {
    if s == null { return }
    b = 0
    while b < s.bones {
        string.release_kept((s.names as ptr[])[b])
        b = b + 1
    }
    free(s.names)
    free(s.directions)
    free(s.lengths)
    free(s.axes)
    free(s.dofs)
    free(s.dof_counts)
    free(s.parents)
    free(s.root_dofs)
    heap.free(s)
}

// The ASF file at `path`, or null (g_error says why).
read_asf(path: string) -> *Asf {
    content, err = fs.read(path)
    if err != "" {
        g_error = "cannot read the ASF file"
        return null
    }
    g_text = content
    g_at = 0
    g_length = string.length(content)
    s = heap.new(Asf)
    s.names = calloc(MOST_BONES, 8)
    s.directions = calloc(MOST_BONES * 3, 8)
    s.lengths = calloc(MOST_BONES, 8)
    s.axes = calloc(MOST_BONES * 4, 8)
    s.dofs = calloc(MOST_BONES * 7, 4)
    s.dof_counts = calloc(MOST_BONES, 4)
    s.parents = calloc(MOST_BONES, 4)
    s.root_dofs = calloc(7, 4)
    s.root_axis = core.quat_ident()
    s.length = 1.0
    s.degrees = true
    directions = s.directions as float[]
    lengths = s.lengths as float[]
    axes = s.axes as float[]
    dofs = s.dofs as int[]
    dof_counts = s.dof_counts as int[]
    parents = s.parents as int[]
    section = 0                    // 1 units, 2 root, 3 bonedata, 4 hierarchy, 0 anything else
    bone = 0 - 1
    good = true
    while good {
        word = next_token()
        if string.length(word) == 0 {
            string.free(word)
            break
        }
        if string.starts_with(word, ":") == 1 {
            section = 0
            if string.equals(word, ":units") == 1 { section = 1 }
            if string.equals(word, ":root") == 1 { section = 2 }
            if string.equals(word, ":bonedata") == 1 { section = 3 }
            if string.equals(word, ":hierarchy") == 1 { section = 4 }
        } else if section == 1 {
            if string.equals(word, "length") == 1 { s.length = next_number() }
            if string.equals(word, "angle") == 1 {
                kind = next_token()
                s.degrees = string.starts_with(kind, "rad") != 1
                string.free(kind)
            }
        } else if section == 2 {
            if string.equals(word, "order") == 1 { s.root_dof_count = read_dofs(s.root_dofs as int[], 0) }
            if string.equals(word, "position") == 1 {
                x = next_number()
                y = next_number()
                z = next_number()
                s.root_place = core.vec3(x, y, z)
            }
            if string.equals(word, "orientation") == 1 { s.root_axis = read_axis(s, true) }
        } else if section == 3 {
            if string.equals(word, "begin") == 1 {
                if s.bones >= MOST_BONES {
                    g_error = "more bones than a skeleton may have"
                    good = false
                } else {
                    bone = s.bones
                    s.bones = s.bones + 1
                    parents[bone] = 0 - 1
                    axes[bone * 4 + 3] = 1.0
                    (s.names as ptr[])[bone] = string.keep("")
                }
            } else if bone >= 0 {
                if string.equals(word, "name") == 1 {
                    title = next_token()
                    string.release_kept((s.names as ptr[])[bone])
                    (s.names as ptr[])[bone] = string.keep(title)
                    string.free(title)
                }
                if string.equals(word, "direction") == 1 {
                    directions[bone * 3] = next_number()
                    directions[bone * 3 + 1] = next_number()
                    directions[bone * 3 + 2] = next_number()
                }
                if string.equals(word, "length") == 1 { lengths[bone] = next_number() }
                if string.equals(word, "axis") == 1 {
                    q = read_axis(s, false)
                    axes[bone * 4] = q.x
                    axes[bone * 4 + 1] = q.y
                    axes[bone * 4 + 2] = q.z
                    axes[bone * 4 + 3] = q.w
                }
                if string.equals(word, "dof") == 1 { dof_counts[bone] = read_dofs(dofs, bone * 7) }
                if string.equals(word, "end") == 1 { bone = 0 - 1 }
            }
        } else if section == 4 {
            if string.equals(word, "begin") == 1 {
                // Each line a parent, then the bones hanging from it.
                more = true
                while more {
                    up_name = next_token()
                    if string.length(up_name) == 0 || string.equals(up_name, "end") == 1 {
                        more = false
                    } else {
                        up = bone_named(s, up_name)
                        while !at_line_end() {
                            child_name = next_token()
                            child = bone_named(s, child_name)
                            if child >= 0 { parents[child] = up }
                            string.free(child_name)
                        }
                    }
                    string.free(up_name)
                }
                section = 0
            }
        }
        string.free(word)
    }
    string.free(content)
    g_text = ""
    if !good {
        asf_free(s)
        return null
    }
    if s.bones == 0 {
        g_error = "no bones in the ASF file"
        asf_free(s)
        return null
    }
    return s
}

// The bone named `title`, or -1 (the root, or none).
bone_named(s: *Asf, title: string) -> int {
    b = 0
    while b < s.bones {
        if string.equals(name_at(s, b), title) == 1 { return b }
        b = b + 1
    }
    return 0 - 1
}

// The channel names to the line's end into `out` from `at`; how many.
read_dofs(out: int[], at: int) -> int {
    n = 0
    while !at_line_end() && n < 7 {
        word = next_token()
        low = string.to_lower(word)
        kind = 0 - 1
        if string.equals(low, "rx") == 1 { kind = DOF_RX }
        if string.equals(low, "ry") == 1 { kind = DOF_RY }
        if string.equals(low, "rz") == 1 { kind = DOF_RZ }
        if string.equals(low, "tx") == 1 { kind = DOF_TX }
        if string.equals(low, "ty") == 1 { kind = DOF_TY }
        if string.equals(low, "tz") == 1 { kind = DOF_TZ }
        if string.equals(low, "l") == 1 { kind = DOF_LENGTH }
        if kind >= 0 {
            out[at + n] = kind
            n = n + 1
        }
        string.free(low)
        string.free(word)
    }
    return n
}

// Three angles and, but for the root's `orientation`, the order they turn
// in (about the world's axes, the first first): a bone's axis frame.
read_axis(s: *Asf, root: bool) -> Quat {
    angles = [next_number(), next_number(), next_number()]
    order = "XYZ"
    owned = false
    if !root && !at_line_end() {
        order = next_token()
        owned = true
    }
    q = turn_in_order(angles, order, s.degrees)
    if owned { string.free(order) }
    return q
}

// Angles about x, y and z turned in `order` ("XYZ": x first), each about
// the world's axis: the last turn the outermost.
turn_in_order(angles: float[], order: string, degrees: bool) -> Quat {
    scale = 1.0
    if degrees { scale = 0.017453292519943295 }
    q = core.quat_ident()
    k = 0
    while k < string.length(order) && k < 3 {
        ch = string.char_at(order, k)
        if ch == 88 || ch == 120 { q = core.quat_mul(core.quat_rotate(angles[0] * scale, core.vec3(1.0, 0.0, 0.0)), q) }
        if ch == 89 || ch == 121 { q = core.quat_mul(core.quat_rotate(angles[1] * scale, core.vec3(0.0, 1.0, 0.0)), q) }
        if ch == 90 || ch == 122 { q = core.quat_mul(core.quat_rotate(angles[2] * scale, core.vec3(0.0, 0.0, 1.0)), q) }
        k = k + 1
    }
    return core.quat_normalize(q)
}

// Whether only spaces and tabs are left before the line's end.
at_line_end() -> bool {
    while g_at < g_length {
        ch = string.char_at(g_text, g_at)
        if ch != 32 && ch != 9 && ch != 13 { return ch == 10 }
        g_at = g_at + 1
    }
    return true
}

// Past the end of the line `g_at` is on.
skip_line() {
    while g_at < g_length && string.char_at(g_text, g_at) != 10 { g_at = g_at + 1 }
    if g_at < g_length { g_at = g_at + 1 }
}

// Whether `word` is a whole number: an AMC frame's number.
is_whole(word: string) -> bool {
    n = string.length(word)
    if n == 0 { return false }
    k = 0
    while k < n {
        ch = string.char_at(word, k)
        if ch < 48 || ch > 57 { return false }
        k = k + 1
    }
    return true
}

// The AMC take at `path` for skeleton `s`: counted, then read, each frame
// each joint's turn (C E C^-1) and the root's place.
read_amc(c: *Capture, s: *Asf, path: string, joint_of: int[]) -> bool {
    content, err = fs.read(path)
    if err != "" {
        g_error = "cannot read the AMC file"
        return false
    }
    g_text = content
    g_length = string.length(content)
    good = true
    pass = 0
    while pass < 2 && good {
        g_at = 0
        frame = 0 - 1
        while good {
            word = next_token()
            if string.length(word) == 0 {
                string.free(word)
                break
            }
            if string.starts_with(word, "#") == 1 {
                skip_line()
            } else if string.starts_with(word, ":") == 1 {
                // :FULLY-SPECIFIED, :DEGREES
            } else if is_whole(word) {
                frame = frame + 1
                if pass == 1 && frame < c.frames { frame_rest(c, frame) }
            } else if frame >= 0 {
                good = read_amc_line(c, s, word, joint_of, frame, pass == 1 && frame < c.frames)
            }
            string.free(word)
        }
        if pass == 0 {
            c.frames = frame + 1
            if c.frames <= 0 {
                g_error = "no frames in the AMC file"
                good = false
            } else {
                c.turns = calloc(c.frames * c.joints * 4, 8)
                c.places = calloc(c.frames * 3, 8)
            }
        }
        pass = pass + 1
    }
    string.free(content)
    g_text = ""
    return good
}

// Frame `f` turned nowhere and the root at its rest place, before its lines.
frame_rest(c: *Capture, f: int) {
    turns = c.turns as float[]
    j = 0
    while j < c.joints {
        turns[(f * c.joints + j) * 4 + 3] = 1.0
        j = j + 1
    }
    offsets = c.offsets as float[]
    places = c.places as float[]
    places[f * 3] = offsets[0]
    places[f * 3 + 1] = offsets[1]
    places[f * 3 + 2] = offsets[2]
}

// One AMC line, its bone's name read: its channel values, kept (`keep`)
// as the bone's joint's turn in frame `frame`.
read_amc_line(c: *Capture, s: *Asf, name: string, joint_of: int[], frame: int, keep: bool) -> bool {
    root = string.equals(name, "root") == 1
    b = 0 - 1
    if !root { b = bone_named(s, name) }
    if !root && b < 0 {
        // A bone the ASF does not have: its values passed over.
        while !at_line_end() {
            _ignored = next_number()
        }
        return true
    }
    kinds = s.root_dofs as int[]
    count = s.root_dof_count
    at = 0
    if !root {
        kinds = s.dofs as int[]
        count = (s.dof_counts as int[])[b]
        at = b * 7
    }
    angles = [0.0, 0.0, 0.0]
    place = [0.0, 0.0, 0.0]
    moved = false
    k = 0
    while k < count {
        v = next_number()
        kind = kinds[at + k]
        if kind <= DOF_RZ { angles[kind] = v }
        if kind >= DOF_TX && kind <= DOF_TZ {
            place[kind - DOF_TX] = v
            moved = true
        }
        k = k + 1
    }
    if !keep { return true }
    axis = s.root_axis
    j = 0
    if !root {
        axes = s.axes as float[]
        axis = core.quat(axes[b * 4], axes[b * 4 + 1], axes[b * 4 + 2], axes[b * 4 + 3])
        j = joint_of[b]
    }
    if j < 0 { return true }
    e = turn_in_order(angles, "XYZ", s.degrees)
    q = core.quat_normalize(core.quat_mul(axis, core.quat_mul(e, core.quat_conjugate(axis))))
    turns = c.turns as float[]
    at_t = (frame * c.joints + j) * 4
    turns[at_t] = q.x
    turns[at_t + 1] = q.y
    turns[at_t + 2] = q.z
    turns[at_t + 3] = q.w
    if root && moved {
        places = c.places as float[]
        places[frame * 3] = place[0]
        places[frame * 3 + 1] = place[1]
        places[frame * 3 + 2] = place[2]
    }
    return true
}
