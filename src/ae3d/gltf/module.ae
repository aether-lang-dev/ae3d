// glTF 2.0: meshes, materials, the node tree, skins and animations, loaded
// into the same models, skeletons and clips the Blender pipeline produces,
// so a figure from anywhere -- Mixamo, Sketchfab, a Quaternius pack, another
// engine's export -- stands in a scene, bends on its skeleton and plays its
// clips exactly as the pipeline's own zombie does.
//
//   scene = gltf.load("figure.glb")            // .gltf with a .bin beside it, or .glb
//   gltf.add_to_engine(e, scene)               // every mesh, placed by its node
//   players = gltf.play(scene, "Walk", registry, true)
//   bank = gltf.bake_bank(scene, "Walk", 48)  // the walk as a crowd's pose bank
//
// What is read: every node as a model (its TRS, or its matrix decomposed),
// parented as the tree says; every mesh primitive as a model of its own under
// the node that carries it, triangles only, with position, normal, texture
// coordinate, joints and weights (a primitive with no normals gets flat
// ones); the material's base colour, its texture where it is a file, its
// metallic and roughness; every skin as a skeleton whose bones are the joint
// nodes, with the inverse bind matrices the file gives; every animation as
// one clip per node it drives, named "<animation>:<node>", STEP, LINEAR and
// CUBICSPLINE alike. Buffers come from files beside the .gltf, from the
// .glb's binary chunk, or from a base64 data: URI; images from files, from a
// buffer view (every .glb's) or from a data: URI, PNG, JPEG, TGA or BMP by
// what the bytes are, not by the MIME type. A sparse accessor (#868) is made
// whole when it is opened: the base values (zeros where it has no buffer
// view), then the sparse elements written over them, so every reader of an
// accessor sees the substituted values. Morph targets (#910): every
// primitive's targets, their POSITION, NORMAL and TANGENT offsets (sparse
// or not), named by the mesh's extras.targetNames, onto the primitive's
// model (core.model_set_morph), drawn by its node's weights -- the node's
// `weights`, else the mesh's -- which a "weights" animation channel plays
// (anim.WEIGHTS, one number a target a key). A VRM's spring bones (#989):
// VRM 0.x's secondaryAnimation and VRM 1.0's VRMC_springBone, their
// springs' joints and numbers and their colliders, as the file gives them
// (spring_count, spring_collider_count), for ae3d.springs to make chains
// of. Not read: cameras and lights
// -- each is named in the warnings when met, and none of them stops the
// rest of the file from loading.
import std.heap
import std.json
import std.list
import std.string
import std.file as fs
import std.bytes
import std.mem
import ae3d.core
import ae3d.geometry
import ae3d.blob
import ae3d.morph
import ae3d.skin
import ae3d.anim
import ae3d.crowd
import ae3d.picture
import ae3d.checksum

exports (
    GltfScene, load, scene_free, scene_destroy, last_error, anims_users, parses,
    model_count, model, find, root_count, root,
    skeleton_count, skeleton,
    animation_count, animation_name, clip_count, clip, clip_node,
    play, add_clip, add_to_engine_models, warning_count, warning, primitive_count, primitive,
    animation_duration, bake_bank, bake_root,
    VrmSpring, VrmSpringJoint, VrmCollider, spring_count, spring, spring_joint, spring_collider_count, spring_collider
)

extern calloc(count: int, size: int) -> ptr
extern malloc(size: long) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr

const COMPONENT_BYTE = 5120
const COMPONENT_UBYTE = 5121
const COMPONENT_SHORT = 5122
const COMPONENT_USHORT = 5123
const COMPONENT_UINT = 5125
const COMPONENT_FLOAT = 5126

const GLB_MAGIC = 0x46546C67        // "glTF"
const GLB_CHUNK_JSON = 0x4E4F534A   // "JSON"
const GLB_CHUNK_BIN = 0x004E4942    // "BIN\0"

struct GltfScene {
    // Every node, in the file's order, as a model; a node carrying a mesh
    // has one child model per primitive, which are in `models` as well.
    nodes: ptr
    models: ptr
    // The models that draw: one per mesh primitive, each under its node,
    // and the node each came from.
    primitives: ptr
    primitive_nodes: ptr
    roots: ptr
    // One skeleton per skin, in the file's order.
    skeletons: ptr
    // The animations' names, and every clip of every animation, each named
    // "<animation>:<node>" and carrying the node it drives.
    animation_names: ptr
    clips: ptr
    clip_nodes: ptr
    source: string
    directory: string
    // What could not be read, if anything; the rest loaded.
    warnings: ptr
    // The names the file's embedded images are registered under.
    registered: ptr
    // The animations read from the file's bytes, shared with every other
    // scene loaded from the same bytes (#990), or null: the first
    // `shared_clips` of `clips` are theirs, the rest (add_clip) the scene's.
    anims: ptr
    shared_clips: int
    // A VRM's spring bones (#989): VRM 0.x's extensions.VRM.secondaryAnimation
    // or VRM 1.0's extensions.VRMC_springBone, read as they are, for
    // ae3d.springs to make chains of. Lists of *VrmSpring and *VrmCollider.
    springs: ptr
    spring_colliders: ptr
    // The file's parse it was made from (#992), *GltfFile: its meshes are
    // that parse's, shared.
    file: ptr
    // int[skins]: 1 where the file gave the skin's inverse binds
    // (skeleton_settle), 0 for one bound as it rests; or null.
    settled: ptr
}

// A file as parsed (#992), kept while any scene made from it is held: a
// scene of it, never handed out and never moved (the nodes at rest, the
// meshes every scene of it draws), and where each primitive's node and
// each spring's joints are among its nodes, so a scene is made from it by
// index. Keyed by the file's size and CRC-32, as its animations are.
struct GltfFile {
    size: long
    crc: long
    scene: ptr                     // *GltfScene, its own
    primitive_nodes: ptr           // int[primitives]: each primitive's node, its index
    anims: ptr                     // *GltfAnims: its animations, held by its scenes (not by it), or null
    users: int                  // scenes made from it and not yet freed
}

var g_files: ptr = null            // list of *GltfFile
var g_parses = 0

// How many files load has parsed since the program began: a scene of a
// file another scene holds parses none (#992).
parses() -> int { return g_parses }

// A spring bone's numbers, as VRM gives them (a 60 Hz step's): its joint's
// node, its stiffness, its drag (the share of its speed a step loses), its
// gravity's power and way, and its hit radius (metres).
struct VrmSpringJoint {
    node: ptr                      // *Model
    stiffness: float
    drag: float
    gravity_power: float
    gravity_dir: Vec3
    hit_radius: float
}

// A VRM spring: its joints (VRM 0.x: roots, each with every joint under it,
// `tree`; VRM 1.0: one chain, root first, each joint its own numbers) and
// the collider groups it is held out of.
struct VrmSpring {
    joints: ptr                    // list of *VrmSpringJoint
    joint_count: int
    collider_groups: ptr           // int[collider_group_count]
    collider_group_count: int
    tree: bool
}

// A collider on a node: a sphere (offset == tail) or a capsule from offset
// to tail, in the node's frame; in group `group`.
struct VrmCollider {
    node: ptr                      // *Model
    offset: Vec3
    tail: Vec3
    radius: float
    group: int
}

// A file's animations as read from its bytes (#990): every clip, the node
// each drives by its index in the file, and the animations' names. Read
// once and shared by every scene loaded from the same bytes, as UE5 loads
// an AnimSequence once for every instance that plays it: 100 UE5
// mannequins each holding its file's 43 animations held 416,325 keys, 51 MB,
// apiece.
struct GltfAnims {
    size: long                     // the file's bytes, how many
    crc: long                      // and their CRC-32
    names: ptr                     // list of *Text
    clips: ptr                     // list of *Clip
    nodes: ptr                     // int[clips]: the node each drives, its index in the file
    users: int                     // scenes holding them
}

var g_anims: ptr = null            // list of *GltfAnims

var g_error = ""
var g_error_owned = false

last_error() -> string { return g_error }

set_error(reason: string, detail: string) {
    if g_error_owned { string.free(g_error) }
    g_error = string.concat(reason, detail)
    g_error_owned = true
}

// ---------------------------------------------------------------------------
// The buffers behind the accessors.
// ---------------------------------------------------------------------------

struct GltfBuffer {
    bytes: ptr
    size: long
}

// A string in a list: a warning, an animation's name.
struct Text {
    text: string
}

text_new(value: string) -> ptr {
    t = heap.new(Text)
    t.text = string.copy(value)
    return t as ptr
}

text_of(item: ptr) -> string {
    return (item as *Text).text
}

// heap.free releases the struct's string with it (docs/writing-aether.md).
text_free(item: ptr) {
    heap.free(item as *Text)
}

struct Reader {
    root: ptr
    buffers: ptr        // list of *GltfBuffer, in the file's order
    scene: *GltfScene
}

warn(r: *Reader, what: string) {
    list.add_raw(r.scene.warnings, text_new(what))
}

directory_of(path: string) -> string {
    cut = 0 - 1
    i = 0
    length = string.length(path)
    while i < length {
        c = string.char_at(path, i)
        if c == 47 || c == 92 { cut = i }
        i = i + 1
    }
    if cut < 0 { return string.copy("") }
    return string.substring(path, 0, cut + 1)
}

join(directory: string, name: string) -> string {
    if directory == "" { return string.copy(name) }
    return string.concat(directory, name)
}

text_field(node: ptr, name: string) -> string {
    if node == null { return "" }
    found = json.object_get_raw(node, name)
    if found == null { return "" }
    return string.copy(json.get_string_raw(found))
}

int_field(node: ptr, name: string, fallback: int) -> int {
    if node == null { return fallback }
    found = json.object_get_raw(node, name)
    if found == null { return fallback }
    return json.get_int(found)
}

number_field(node: ptr, name: string, fallback: float) -> float {
    if node == null { return fallback }
    found = json.object_get_raw(node, name)
    if found == null { return fallback }
    return json.get_number(found)
}

component(values: ptr, index: int, fallback: float) -> float {
    if values == null { return fallback }
    if index >= json.array_size(values) { return fallback }
    return json.get_number(json.array_get_raw(values, index))
}

array_field(root: ptr, name: string) -> ptr {
    if root == null { return null }
    return json.object_get_raw(root, name)
}

array_count(node: ptr) -> int {
    if node == null { return 0 }
    return json.array_size(node)
}

// ---------------------------------------------------------------------------
// data: URIs (RFC 2397, base64 only, as glTF 2.0 requires).
// ---------------------------------------------------------------------------

var g_data_size: long = 0

// The size of the bytes the last data_uri_bytes made.
data_uri_size() -> long { return g_data_size }

// The value of a base64 character (RFC 4648 section 4), 0 - 1 for one that
// is not in the alphabet, 0 - 2 for the padding. Both alphabets are taken
// (the URL-safe one is what some exporters write, though the standard says
// the other).
base64_value(c: int) -> int {
    if c >= 65 && c <= 90 { return c - 65 }
    if c >= 97 && c <= 122 { return c - 97 + 26 }
    if c >= 48 && c <= 57 { return c - 48 + 52 }
    if c == 43 || c == 45 { return 62 }
    if c == 47 || c == 95 { return 63 }
    if c == 61 { return 0 - 2 }
    return 0 - 1
}

// The bytes a "data:<mime>;base64,<payload>" URI holds, malloc'd for the
// caller (blob.free_bytes), zero-terminated after the last; null for one
// that is not base64 or whose payload is not. Whitespace in the payload is
// skipped and the padding may be left off.
data_uri_bytes(uri: string) -> ptr {
    g_data_size = 0 as long
    length = string.length(uri)
    comma = 0 - 1
    i = 0
    while i < length && comma < 0 {
        if string.char_at(uri, i) == 44 { comma = i }
        i = i + 1
    }
    if comma < 0 { return null }
    header = string.substring(uri, 0, comma)
    is_base64 = string.ends_with(header, ";base64") == 1
    string.free(header)
    if !is_base64 { return null }
    out = malloc(((length - comma) as long) * (3 as long) / (4 as long) + (4 as long)) as ptr
    if out == null { return null }
    bits = 0
    held = 0
    n = 0
    padded = false
    i = comma + 1
    while i < length {
        c = string.char_at(uri, i)
        v = base64_value(c)
        if v == 0 - 2 {
            padded = true
        } else if v >= 0 {
            if padded {
                free(out)
                return null
            }
            bits = (bits << 6) | v
            held = held + 6
            if held >= 8 {
                held = held - 8
                mem.set_uint8(out, n, (bits >> held) & 255)
                n = n + 1
                bits = bits & ((1 << held) - 1)
            }
        } else if c != 10 && c != 13 && c != 32 && c != 9 {
            free(out)
            return null
        }
        i = i + 1
    }
    mem.set_uint8(out, n, 0)
    g_data_size = n as long
    return out
}

// A buffer's bytes: the .glb's binary chunk for a buffer with no uri, else
// the file the uri names beside the .gltf.
load_buffers(r: *Reader, glb_bin: @keep ptr, glb_bin_size: long) {
    buffers = array_field(r.root, "buffers")
    count = array_count(buffers)
    i = 0
    while i < count {
        node = json.array_get_raw(buffers, i)
        uri = text_field(node, "uri")
        b = heap.new(GltfBuffer)
        b.bytes = null
        b.size = 0
        if uri == "" {
            if glb_bin != null && i == 0 {
                b.bytes = glb_bin
                b.size = glb_bin_size
            } else {
                warn(r, "a buffer with no uri and no binary chunk")
            }
        } else if string.starts_with(uri, "data:") == 1 {
            b.bytes = data_uri_bytes(uri)
            b.size = data_uri_size()
            if b.bytes == null { warn(r, string.concat("a data: uri buffer that is not base64: buffer ", string.from_int(i))) }
        } else {
            path = join(r.scene.directory, uri)
            b.bytes = blob.read(path)
            b.size = blob.last_size()
            if b.bytes == null { warn(r, string.concat("cannot read buffer ", uri)) }
            string.free(path)
        }
        string.free(uri)
        list.add_raw(r.buffers, b as ptr)
        i = i + 1
    }
}

// Where an accessor's elements are: the buffer, the byte offset of the
// first, the stride between them, the component type and the components an
// element has. Returns false for an accessor that cannot be read here.
struct Accessor {
    bytes: ptr
    size: long
    offset: long
    stride: long
    component_type: int
    components: int
    count: int
    normalized: bool
    component_size: int
    // The bytes of a sparse (or buffer-less) accessor made whole, which
    // `bytes` then points at; freed with the accessor.
    owned: ptr
}

type_components(kind: string) -> int {
    if kind == "SCALAR" { return 1 }
    if kind == "VEC2" { return 2 }
    if kind == "VEC3" { return 3 }
    if kind == "VEC4" { return 4 }
    if kind == "MAT4" { return 16 }
    if kind == "MAT3" { return 9 }
    if kind == "MAT2" { return 4 }
    return 0
}

component_bytes(component_type: int) -> int {
    if component_type == COMPONENT_BYTE || component_type == COMPONENT_UBYTE { return 1 }
    if component_type == COMPONENT_SHORT || component_type == COMPONENT_USHORT { return 2 }
    return 4
}

// Where a buffer view's bytes are, checked against its buffer: the buffer's
// bytes at the view's first byte, how many the view has, its stride (0 for
// tightly packed). `ok` is false for a view that is not there, whose buffer
// is not there, or that reaches past it.
struct ViewSpan {
    bytes: ptr
    length: long
    stride: int
    ok: bool
}

view_span(r: *Reader, view_index: int) -> ViewSpan {
    absent = ViewSpan { bytes: null, length: 0 as long, stride: 0, ok: false }
    views = array_field(r.root, "bufferViews")
    if view_index < 0 || view_index >= array_count(views) { return absent }
    view = json.array_get_raw(views, view_index)
    buffer_index = int_field(view, "buffer", 0)
    if buffer_index < 0 || buffer_index >= list.size(r.buffers) { return absent }
    b = list.get_raw(r.buffers, buffer_index) as *GltfBuffer
    if b.bytes == null { return absent }
    offset = int_field(view, "byteOffset", 0) as long
    length = int_field(view, "byteLength", 0) as long
    if offset < (0 as long) || length < (0 as long) || offset + length > b.size { return absent }
    return ViewSpan { bytes: b.bytes + (offset as int), length: length, stride: int_field(view, "byteStride", 0), ok: true }
}

// The accessor, on the heap for the caller to free, or null for one that
// cannot be read here.
accessor_open(r: *Reader, index: int) -> *Accessor {
    accessors = array_field(r.root, "accessors")
    if index < 0 || index >= array_count(accessors) { return null }
    node = json.array_get_raw(accessors, index)
    sparse = json.object_get_raw(node, "sparse")
    view_index = int_field(node, "bufferView", 0 - 1)
    out = heap.new(Accessor)
    kind = text_field(node, "type")
    out.components = type_components(kind)
    string.free(kind)
    out.component_type = int_field(node, "componentType", COMPONENT_FLOAT)
    out.component_size = component_bytes(out.component_type)
    out.count = int_field(node, "count", 0)
    out.normalized = int_field(node, "normalized", 0) == 1
    if out.components == 0 || out.count < 0 {
        heap.free(out)
        return null
    }
    element = out.components * out.component_size
    if view_index < 0 {
        // No buffer view: all zeros, which a sparse accessor then writes
        // over (the specification's way to say "mostly nothing").
        if sparse == null {
            heap.free(out)
            return null
        }
        out.owned = calloc(out.count + 1, element)
        out.bytes = out.owned
        out.size = (out.count * element) as long
        out.offset = 0 as long
        out.stride = element as long
    } else {
        span = view_span(r, view_index)
        if !span.ok {
            heap.free(out)
            return null
        }
        out.bytes = span.bytes
        out.size = span.length
        out.offset = int_field(node, "byteOffset", 0) as long
        stride = span.stride
        if stride == 0 { stride = element }
        out.stride = stride as long
        needed = out.offset + ((out.count - 1) as long) * out.stride + element as long
        if out.count > 0 && needed > out.size {
            warn(r, "an accessor reaching past its buffer")
            heap.free(out)
            return null
        }
    }
    if sparse != null && !apply_sparse(r, out, sparse) {
        accessor_close(out)
        return null
    }
    return out
}

accessor_close(a: *Accessor) {
    if a == null { return }
    if a.owned != null { free(a.owned) }
    heap.free(a)
}

// A sparse accessor's substitution (#868): its elements, which `out` has
// read from the base view (or zeroed), copied into a packed copy of their
// own and the sparse ones written over them. The sparse part names the
// indices of the elements it replaces (an unsigned byte, short or int
// each) and their values, in two buffer views. False, with a warning, for
// one that cannot be read; the accessor is then not used at all, since half
// its values would be a wrong mesh.
apply_sparse(r: *Reader, out: *Accessor, sparse: ptr) -> bool {
    element = out.components * out.component_size
    count = int_field(sparse, "count", 0)
    indices = json.object_get_raw(sparse, "indices")
    values = json.object_get_raw(sparse, "values")
    if indices == null || values == null || count < 0 || count > out.count {
        warn(r, "a sparse accessor with no indices or values, or more of them than it has elements")
        return false
    }
    index_type = int_field(indices, "componentType", 0)
    if index_type != COMPONENT_UBYTE && index_type != COMPONENT_USHORT && index_type != COMPONENT_UINT {
        warn(r, "a sparse accessor whose indices are not unsigned")
        return false
    }
    index_size = component_bytes(index_type)
    index_span = view_span(r, int_field(indices, "bufferView", 0 - 1))
    value_span = view_span(r, int_field(values, "bufferView", 0 - 1))
    index_at = int_field(indices, "byteOffset", 0) as long
    value_at = int_field(values, "byteOffset", 0) as long
    short = !index_span.ok || !value_span.ok
    if !short {
        short = index_at + ((count * index_size) as long) > index_span.length ||
                value_at + ((count * element) as long) > value_span.length
    }
    if short {
        warn(r, "a sparse accessor reaching past its buffer")
        return false
    }
    // Packed, a copy of the base for the elements it keeps.
    packed = calloc(out.count + 1, element)
    i = 0
    while i < out.count {
        memcpy(packed + i * element, out.bytes + ((out.offset + (i as long) * out.stride) as int), element as long)
        i = i + 1
    }
    i = 0
    while i < count {
        at = index_at + ((i * index_size) as long)
        target = 0
        if index_type == COMPONENT_UBYTE { target = blob.u8(index_span.bytes, at) }
        if index_type == COMPONENT_USHORT { target = blob.u16(index_span.bytes, at) }
        if index_type == COMPONENT_UINT { target = blob.u32(index_span.bytes, at) }
        if target < 0 || target >= out.count {
            free(packed)
            warn(r, "a sparse accessor naming an element it does not have")
            return false
        }
        memcpy(packed + target * element, value_span.bytes + ((value_at + ((i * element) as long)) as int), element as long)
        i = i + 1
    }
    if out.owned != null { free(out.owned) }
    out.owned = packed
    out.bytes = packed
    out.size = (out.count * element) as long
    out.offset = 0 as long
    out.stride = element as long
    return true
}

// Component `c` of element `i`, as a number: floats as they are, integers
// as themselves, or scaled to 0..1 (-1..1) when the accessor is normalized.
accessor_get(a: *Accessor, i: int, c: int) -> float {
    at = a.offset + (i as long) * a.stride + (c * a.component_size) as long
    if a.component_type == COMPONENT_FLOAT { return blob.f32(a.bytes, at) }
    if a.component_type == COMPONENT_UINT { return blob.u32(a.bytes, at) as float }
    if a.component_type == COMPONENT_USHORT {
        v = blob.u16(a.bytes, at) as float
        if a.normalized { return v / 65535.0 }
        return v
    }
    if a.component_type == COMPONENT_UBYTE {
        v = blob.u8(a.bytes, at) as float
        if a.normalized { return v / 255.0 }
        return v
    }
    if a.component_type == COMPONENT_SHORT {
        v = blob.i16(a.bytes, at) as float
        if a.normalized { return core.clampf(v / 32767.0, 0.0 - 1.0, 1.0) }
        return v
    }
    v = blob.i8(a.bytes, at) as float
    if a.normalized { return core.clampf(v / 127.0, 0.0 - 1.0, 1.0) }
    return v
}

accessor_get_int(a: *Accessor, i: int, c: int) -> int {
    at = a.offset + (i as long) * a.stride + (c * a.component_size) as long
    if a.component_type == COMPONENT_UINT { return blob.u32(a.bytes, at) }
    if a.component_type == COMPONENT_USHORT { return blob.u16(a.bytes, at) }
    if a.component_type == COMPONENT_UBYTE { return blob.u8(a.bytes, at) }
    if a.component_type == COMPONENT_SHORT { return blob.i16(a.bytes, at) }
    if a.component_type == COMPONENT_BYTE { return blob.i8(a.bytes, at) }
    return blob.f32(a.bytes, at) as int
}

// ---------------------------------------------------------------------------
// Meshes and materials.
// ---------------------------------------------------------------------------

// A primitive as a model: its vertices pushed once each (glTF vertices are
// already unique per attribute set, the way the mesh wants them), its
// triangles from the index accessor or from the vertex order, its skin from
// JOINTS_0 and WEIGHTS_0, its material's factors and texture.
load_primitive(r: *Reader, primitive: ptr, mesh_node: ptr, name: string) -> *Model {
    mode = int_field(primitive, "mode", 4)
    if mode != 4 {
        warn(r, string.concat("a primitive that is not triangles: ", name))
        return null
    }
    attributes = json.object_get_raw(primitive, "attributes")
    if attributes == null { return null }
    positions = accessor_open(r, int_field(attributes, "POSITION", 0 - 1))
    if positions == null {
        warn(r, string.concat("a primitive with no readable POSITION: ", name))
        return null
    }
    normals = accessor_open(r, int_field(attributes, "NORMAL", 0 - 1))
    has_normals = normals != null
    uvs = accessor_open(r, int_field(attributes, "TEXCOORD_0", 0 - 1))
    has_uvs = uvs != null
    // The second UV set (#544): a damage mask's unwrap.
    uvs1 = accessor_open(r, int_field(attributes, "TEXCOORD_1", 0 - 1))
    joints = accessor_open(r, int_field(attributes, "JOINTS_0", 0 - 1))
    weights = accessor_open(r, int_field(attributes, "WEIGHTS_0", 0 - 1))
    has_skin = joints != null && weights != null

    mesh = core.mesh_create()
    core.mesh_reserve(mesh, positions.count, positions.count)
    i = 0
    while i < positions.count {
        p = core.vec3(accessor_get(positions, i, 0), accessor_get(positions, i, 1), accessor_get(positions, i, 2))
        n = core.vec3(0.0, 1.0, 0.0)
        if has_normals {
            n = core.vec3(accessor_get(normals, i, 0), accessor_get(normals, i, 1), accessor_get(normals, i, 2))
        }
        u = 0.0
        v = 0.0
        if has_uvs {
            u = accessor_get(uvs, i, 0)
            // glTF's v runs down the image, the engine's up: the same flip
            // the OBJ loader makes.
            v = 1.0 - accessor_get(uvs, i, 1)
        }
        core.mesh_push_vertex(mesh, p, u, v, n)
        if uvs1 != null { core.mesh_set_uv1(mesh, i, accessor_get(uvs1, i, 0), 1.0 - accessor_get(uvs1, i, 1)) }
        if has_skin {
            core.mesh_set_skin(mesh, i,
                accessor_get_int(joints, i, 0), accessor_get_int(joints, i, 1),
                accessor_get_int(joints, i, 2), accessor_get_int(joints, i, 3),
                accessor_get(weights, i, 0), accessor_get(weights, i, 1),
                accessor_get(weights, i, 2), accessor_get(weights, i, 3))
        }
        i = i + 1
    }
    indices = accessor_open(r, int_field(primitive, "indices", 0 - 1))
    if indices != null {
        i = 0
        while i + 2 < indices.count {
            core.mesh_push_triangle(mesh, accessor_get_int(indices, i, 0),
                                    accessor_get_int(indices, i + 1, 0),
                                    accessor_get_int(indices, i + 2, 0))
            i = i + 3
        }
    } else {
        i = 0
        while i + 2 < positions.count {
            core.mesh_push_triangle(mesh, i, i + 1, i + 2)
            i = i + 3
        }
    }
    if !has_normals { core.mesh_recalculate_normals(mesh) }
    accessor_close(positions)
    accessor_close(normals)
    accessor_close(uvs)
    accessor_close(uvs1)
    accessor_close(joints)
    accessor_close(weights)
    accessor_close(indices)

    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_mesh(m, mesh)
    apply_material(r, m, int_field(primitive, "material", 0 - 1))
    load_targets(r, primitive, mesh_node, m, name)
    return m
}

// A primitive's morph targets (#910) onto its model: each target's
// POSITION, NORMAL and TANGENT offsets (any of them may be missing, and
// any may be sparse: accessor_open has made it whole), named by the mesh's
// extras.targetNames where it has them, each starting at the mesh's own
// `weights`. A target whose accessor cannot be read keeps its place, as
// the weights count targets by index, and moves nothing.
load_targets(r: *Reader, primitive: ptr, mesh_node: ptr, m: *Model, name: string) {
    targets = json.object_get_raw(primitive, "targets")
    count = array_count(targets)
    if count == 0 { return }
    vertices = core.mesh_vertex_count(m.mesh)
    set = morph.set_new(vertices)
    names = null
    extras = json.object_get_raw(mesh_node, "extras")
    if extras != null { names = json.object_get_raw(extras, "targetNames") }
    // Some exporters (UniVRM's, VRoid Studio's) put them on the primitive.
    if names == null {
        own = json.object_get_raw(primitive, "extras")
        if own != null { names = json.object_get_raw(own, "targetNames") }
    }
    defaults = json.object_get_raw(mesh_node, "weights")
    t = 0
    while t < count {
        target = json.array_get_raw(targets, t)
        label = ""
        if names != null && t < array_count(names) { label = json.get_string_raw(json.array_get_raw(names, t)) }
        index = morph.add_target(set, label, component(defaults, t, 0.0))
        positions = accessor_open(r, int_field(target, "POSITION", 0 - 1))
        normals = accessor_open(r, int_field(target, "NORMAL", 0 - 1))
        tangents = accessor_open(r, int_field(target, "TANGENT", 0 - 1))
        if positions != null && positions.count != vertices {
            warn(r, string.concat("a morph target whose POSITION count is not its primitive's: ", name))
            accessor_close(positions)
            positions = null
        }
        if normals != null && normals.count != vertices {
            warn(r, string.concat("a morph target whose NORMAL count is not its primitive's: ", name))
            accessor_close(normals)
            normals = null
        }
        if tangents != null && tangents.count != vertices {
            accessor_close(tangents)
            tangents = null
        }
        if index >= 0 && (positions != null || normals != null) {
            v = 0
            while v < vertices {
                px = 0.0
                py = 0.0
                pz = 0.0
                nx = 0.0
                ny = 0.0
                nz = 0.0
                if positions != null {
                    px = accessor_get(positions, v, 0)
                    py = accessor_get(positions, v, 1)
                    pz = accessor_get(positions, v, 2)
                }
                if normals != null {
                    nx = accessor_get(normals, v, 0)
                    ny = accessor_get(normals, v, 1)
                    nz = accessor_get(normals, v, 2)
                }
                morph.set_delta(set, index, v, px, py, pz, nx, ny, nz)
                v = v + 1
            }
        }
        if index >= 0 && tangents != null {
            v = 0
            while v < vertices {
                morph.set_tangent(set, index, v, accessor_get(tangents, v, 0), accessor_get(tangents, v, 1), accessor_get(tangents, v, 2))
                v = v + 1
            }
        }
        accessor_close(positions)
        accessor_close(normals)
        accessor_close(tangents)
        t = t + 1
    }
    core.model_set_morph(m, set as ptr)
}

apply_material(r: *Reader, m: *Model, index: int) {
    materials = array_field(r.root, "materials")
    if index < 0 || index >= array_count(materials) {
        core.model_matte(m, 0.8, 0.8, 0.8)
        return
    }
    material = json.array_get_raw(materials, index)
    pbr = json.object_get_raw(material, "pbrMetallicRoughness")
    colour = null
    if pbr != null { colour = json.object_get_raw(pbr, "baseColorFactor") }
    core.model_set_diffuse(m, component(colour, 0, 1.0), component(colour, 1, 1.0), component(colour, 2, 1.0))
    alpha = component(colour, 3, 1.0)
    if alpha < 1.0 { core.model_set_alpha(m, alpha) }
    core.model_set_pbr(m, number_field(pbr, "metallicFactor", 1.0), number_field(pbr, "roughnessFactor", 1.0))
    texture = null
    if pbr != null { texture = json.object_get_raw(pbr, "baseColorTexture") }
    if texture != null {
        path = image_path(r, int_field(texture, "index", 0 - 1))
        if path != "" { core.model_set_texture(m, path) }
        string.free(path)
    }
    normal_map = json.object_get_raw(material, "normalTexture")
    if normal_map != null {
        path = image_path(r, int_field(normal_map, "index", 0 - 1))
        if path != "" {
            core.model_ensure_material(m)
            core.material_set_normal_path(m.material, path)
        }
        string.free(path)
    }
}

// What a texture's image is, as a path a material takes: the file beside
// the .gltf, or, for an image embedded in a buffer (every .glb's), the
// name it is registered under once decoded -- "<file>#image<n>", which
// any texture path resolves to the pixels in memory, as the engine's own
// painted images are.
image_path(r: *Reader, texture_index: int) -> string {
    textures = array_field(r.root, "textures")
    if texture_index < 0 || texture_index >= array_count(textures) { return string.copy("") }
    source = int_field(json.array_get_raw(textures, texture_index), "source", 0 - 1)
    images = array_field(r.root, "images")
    if source < 0 || source >= array_count(images) { return string.copy("") }
    image = json.array_get_raw(images, source)
    uri = text_field(image, "uri")
    if uri != "" && string.starts_with(uri, "data:") == 0 {
        path = join(r.scene.directory, uri)
        string.free(uri)
        return path
    }
    name = string.concat(r.scene.source, string.concat("#image", string.from_int(source)))
    if list_has_text(r.scene.registered, name) {
        string.free(uri)
        return name
    }
    // The image's bytes: a data: uri's payload (malloc'd here), or a view
    // of a buffer (the .glb's, or any other).
    owned = null
    bytes = null
    length = 0
    if uri != "" {
        owned = data_uri_bytes(uri)
        bytes = owned
        length = data_uri_size() as int
        if owned == null {
            warn(r, string.concat("an image as a data: uri that is not base64: ", name))
        }
    } else {
        span = view_span(r, int_field(image, "bufferView", 0 - 1))
        if span.ok {
            bytes = span.bytes
            length = span.length as int
        } else {
            warn(r, string.concat("an image with no readable uri or buffer view: ", name))
        }
    }
    string.free(uri)
    if bytes == null {
        string.free(name)
        return string.copy("")
    }
    decoded = picture.from_memory(bytes, length)
    if owned != null { free(owned) }
    if decoded == null {
        warn(r, string.concat("an image that would not decode: ", name))
        string.free(name)
        return string.copy("")
    }
    ok = picture.register_rgba(name, picture.pixels(decoded), picture.width(decoded), picture.height(decoded)) == 1
    picture.dispose(decoded)
    if !ok {
        warn(r, string.concat("an image that would not register: ", name))
        string.free(name)
        return string.copy("")
    }
    list.add_raw(r.scene.registered, text_new(name))
    return name
}

list_has_text(items: ptr, value: string) -> bool {
    i = 0
    while i < list.size(items) {
        if text_of(list.get_raw(items, i)) == value { return true }
        i = i + 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Nodes.
// ---------------------------------------------------------------------------

// A node's transform onto its model: TRS where the file gives them, else
// its matrix decomposed -- translation from the last column, scale from the
// length of each axis, rotation from the axes with the scale taken out.
place_node(node: ptr, m: *Model) {
    matrix = json.object_get_raw(node, "matrix")
    if matrix != null && json.array_size(matrix) == 16 {
        c0 = core.vec3(component(matrix, 0, 1.0), component(matrix, 1, 0.0), component(matrix, 2, 0.0))
        c1 = core.vec3(component(matrix, 4, 0.0), component(matrix, 5, 1.0), component(matrix, 6, 0.0))
        c2 = core.vec3(component(matrix, 8, 0.0), component(matrix, 9, 0.0), component(matrix, 10, 1.0))
        sx = core.v3_len(c0)
        sy = core.v3_len(c1)
        sz = core.v3_len(c2)
        if sx > 0.0 { c0 = core.v3_mul(c0, 1.0 / sx) }
        if sy > 0.0 { c1 = core.v3_mul(c1, 1.0 / sy) }
        if sz > 0.0 { c2 = core.v3_mul(c2, 1.0 / sz) }
        core.model_set_position(m, component(matrix, 12, 0.0), component(matrix, 13, 0.0), component(matrix, 14, 0.0))
        core.model_set_scale(m, sx, sy, sz)
        core.model_set_rotation(m, core.quat_from_axes(c0, c1, c2))
        return
    }
    t = json.object_get_raw(node, "translation")
    core.model_set_position(m, component(t, 0, 0.0), component(t, 1, 0.0), component(t, 2, 0.0))
    s = json.object_get_raw(node, "scale")
    core.model_set_scale(m, component(s, 0, 1.0), component(s, 1, 1.0), component(s, 2, 1.0))
    q = json.object_get_raw(node, "rotation")
    core.model_set_rotation(m, core.quat(component(q, 0, 0.0), component(q, 1, 0.0), component(q, 2, 0.0), component(q, 3, 1.0)))
}

load_nodes(r: *Reader) {
    nodes = array_field(r.root, "nodes")
    count = array_count(nodes)
    meshes = array_field(r.root, "meshes")
    i = 0
    while i < count {
        node = json.array_get_raw(nodes, i)
        m = core.model_new()
        name = text_field(node, "name")
        if name == "" {
            string.free(name)
            name = string.concat("node_", string.from_int(i))
        }
        core.model_set_name(m, name)
        place_node(node, m)
        list.add_raw(r.scene.nodes, m as ptr)
        list.add_raw(r.scene.models, m as ptr)
        // The node's mesh: one model per primitive, each a child at the
        // node's origin, so the node moves them all and a skin poses them.
        mesh_index = int_field(node, "mesh", 0 - 1)
        skinned = int_field(node, "skin", 0 - 1) >= 0
        if mesh_index >= 0 && mesh_index < array_count(meshes) {
            mesh = json.array_get_raw(meshes, mesh_index)
            primitives = json.object_get_raw(mesh, "primitives")
            pcount = array_count(primitives)
            p = 0
            while p < pcount {
                pname = name
                if pcount > 1 { pname = string.concat(name, string.concat("/", string.from_int(p))) }
                part = load_primitive(r, json.array_get_raw(primitives, p), mesh, pname)
                if part != null && core.model_morph(part) != null {
                    // Its weights are the node's (#910): the node's own
                    // `weights` where it has them, else the mesh's, and
                    // what an animation's weights channel writes.
                    set = core.model_morph(part) as *MorphSet
                    if core.model_morph_weight_count(m) == 0 {
                        own = json.object_get_raw(node, "weights")
                        k = 0
                        while k < morph.count(set) {
                            core.model_set_morph_weight(m, k, component(own, k, morph.default_weight(set, k)))
                            k = k + 1
                        }
                    }
                    core.model_set_morph_driver(part, m as ptr)
                }
                if part != null {
                    // A skinned primitive stands at the origin and is placed
                    // by its joints alone: the file's rule is that the
                    // transform of a skinned mesh's node is ignored, the
                    // joints' world transforms carrying everything. Under
                    // its node as well, a Mixamo figure whose armature is
                    // scaled to centimetres came out a hundredth its size.
                    if !skinned { core.model_set_parent(part, m) }
                    list.add_raw(r.scene.models, part as ptr)
                    list.add_raw(r.scene.primitives, part as ptr)
                    list.add_raw(r.scene.primitive_nodes, m as ptr)
                }
                p = p + 1
            }
        }
        string.free(name)
        i = i + 1
    }
    // Parents after every node exists.
    i = 0
    while i < count {
        node = json.array_get_raw(nodes, i)
        children = json.object_get_raw(node, "children")
        ccount = array_count(children)
        c = 0
        while c < ccount {
            child = json.get_int(json.array_get_raw(children, c))
            if child >= 0 && child < count {
                core.model_set_parent(list.get_raw(r.scene.nodes, child) as *Model,
                                      list.get_raw(r.scene.nodes, i) as *Model)
            }
            c = c + 1
        }
        i = i + 1
    }
    i = 0
    while i < count {
        m = list.get_raw(r.scene.nodes, i) as *Model
        if m.parent == null { list.add_raw(r.scene.roots, m as ptr) }
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Skins.
// ---------------------------------------------------------------------------

// Every skin as a skeleton over the joint nodes, in the skin's order (which
// is the order the vertices' joint indices count in), with the inverse bind
// matrices the file gives, and every primitive of a node that names the skin
// posed by it.
load_skins(r: *Reader) {
    skins = array_field(r.root, "skins")
    count = array_count(skins)
    nodes = array_field(r.root, "nodes")
    r.scene.settled = calloc(count + 1, 4)
    i = 0
    while i < count {
        skin_node = json.array_get_raw(skins, i)
        joints = json.object_get_raw(skin_node, "joints")
        jcount = array_count(joints)
        s = skin.skeleton_new()
        if jcount > skin.MAX_BONES {
            warn(r, string.concat("a skin with more joints than the palette holds: ", string.from_int(jcount)))
        }
        ibm = accessor_open(r, int_field(skin_node, "inverseBindMatrices", 0 - 1))
        has_ibm = ibm != null
        j = 0
        while j < jcount {
            node_index = json.get_int(json.array_get_raw(joints, j))
            if node_index >= 0 && node_index < list.size(r.scene.nodes) {
                bone = list.get_raw(r.scene.nodes, node_index) as *Model
                index = skin.skeleton_add(s, bone)
                if index >= 0 && has_ibm && j < ibm.count {
                    inverse = core.mat4_ident()
                    inverse.m0 = accessor_get(ibm, j, 0)
                    inverse.m1 = accessor_get(ibm, j, 1)
                    inverse.m2 = accessor_get(ibm, j, 2)
                    inverse.m3 = accessor_get(ibm, j, 3)
                    inverse.m4 = accessor_get(ibm, j, 4)
                    inverse.m5 = accessor_get(ibm, j, 5)
                    inverse.m6 = accessor_get(ibm, j, 6)
                    inverse.m7 = accessor_get(ibm, j, 7)
                    inverse.m8 = accessor_get(ibm, j, 8)
                    inverse.m9 = accessor_get(ibm, j, 9)
                    inverse.m10 = accessor_get(ibm, j, 10)
                    inverse.m11 = accessor_get(ibm, j, 11)
                    inverse.m12 = accessor_get(ibm, j, 12)
                    inverse.m13 = accessor_get(ibm, j, 13)
                    inverse.m14 = accessor_get(ibm, j, 14)
                    inverse.m15 = accessor_get(ibm, j, 15)
                    skin.skeleton_set_inverse_bind(s, index, inverse)
                }
            }
            j = j + 1
        }
        if has_ibm { skin.skeleton_settle(s) } else { skin.skeleton_bind(s) }
        if has_ibm { (r.scene.settled as int[])[i] = 1 }
        accessor_close(ibm)
        list.add_raw(r.scene.skeletons, s as ptr)
        i = i + 1
    }
    // The primitives of every skinned node take their skin.
    ncount = array_count(nodes)
    n = 0
    while n < ncount {
        skin_index = int_field(json.array_get_raw(nodes, n), "skin", 0 - 1)
        if skin_index >= 0 && skin_index < list.size(r.scene.skeletons) {
            s = list.get_raw(r.scene.skeletons, skin_index) as *Skeleton
            owner = list.get_raw(r.scene.nodes, n) as *Model
            skin.skeleton_set_space(s, owner)
            k = 0
            pcount = list.size(r.scene.primitives)
            while k < pcount {
                if list.get_raw(r.scene.primitive_nodes, k) == owner as ptr {
                    primitive = list.get_raw(r.scene.primitives, k) as *Model
                    core.model_set_skeleton(primitive, s as ptr)
                    if primitive.mesh != null && core.mesh_is_skinned(primitive.mesh) { skin.skeleton_add_mesh(s, primitive.mesh) }
                }
                k = k + 1
            }
        }
        n = n + 1
    }
}

// ---------------------------------------------------------------------------
// Animations.
// ---------------------------------------------------------------------------

// A sampler's keys onto a channel: STEP and LINEAR as they are, CUBICSPLINE
// with the in-tangent, the value and the out-tangent the output holds for
// each key, in that order.
read_sampler(r: *Reader, sampler: ptr, target: int) -> *AnimChannel {
    input = accessor_open(r, int_field(sampler, "input", 0 - 1))
    if input == null { return null }
    output = accessor_open(r, int_field(sampler, "output", 0 - 1))
    if output == null {
        accessor_close(input)
        return null
    }
    mode = text_field(sampler, "interpolation")
    interpolation = anim.LINEAR
    if mode == "STEP" { interpolation = anim.STEP }
    if mode == "CUBICSPLINE" { interpolation = anim.CUBIC }
    string.free(mode)
    c = anim.channel_new(target, interpolation)
    width = output.components
    k = 0
    while k < input.count {
        t = accessor_get(input, k, 0)
        if interpolation == anim.CUBIC {
            base = k * 3
            if base + 2 < output.count {
                anim.channel_add_cubic_key(c, t,
                    accessor_get(output, base + 1, 0), accessor_get(output, base + 1, 1),
                    accessor_get(output, base + 1, 2), value_w(output, base + 1, width),
                    accessor_get(output, base, 0), accessor_get(output, base, 1),
                    accessor_get(output, base, 2), value_w(output, base, width),
                    accessor_get(output, base + 2, 0), accessor_get(output, base + 2, 1),
                    accessor_get(output, base + 2, 2), value_w(output, base + 2, width))
            }
        } else if k < output.count {
            anim.channel_add_key(c, t, accessor_get(output, k, 0), accessor_get(output, k, 1),
                                 accessor_get(output, k, 2), value_w(output, k, width))
        }
        k = k + 1
    }
    accessor_close(input)
    accessor_close(output)
    return c
}

// A weights sampler (#910) onto a channel of the node's mesh's targets: the
// output holds `width` numbers a key -- one a target, the mesh's target
// count -- and for CUBICSPLINE three runs of them a key, the in-tangents,
// the values and the out-tangents. Null, with a warning, for a node with no
// mesh targets or an output that is not a whole number of keys.
read_weights(r: *Reader, sampler: ptr, node_index: int) -> *AnimChannel {
    nodes = array_field(r.root, "nodes")
    meshes = array_field(r.root, "meshes")
    node = json.array_get_raw(nodes, node_index)
    mesh_index = int_field(node, "mesh", 0 - 1)
    width = 0
    if mesh_index >= 0 && mesh_index < array_count(meshes) {
        primitives = json.object_get_raw(json.array_get_raw(meshes, mesh_index), "primitives")
        if array_count(primitives) > 0 {
            width = array_count(json.object_get_raw(json.array_get_raw(primitives, 0), "targets"))
        }
    }
    if width <= 0 {
        warn(r, "a weights animation on a node with no morph targets")
        return null
    }
    input = accessor_open(r, int_field(sampler, "input", 0 - 1))
    if input == null { return null }
    output = accessor_open(r, int_field(sampler, "output", 0 - 1))
    if output == null {
        accessor_close(input)
        return null
    }
    mode = text_field(sampler, "interpolation")
    interpolation = anim.LINEAR
    if mode == "STEP" { interpolation = anim.STEP }
    if mode == "CUBICSPLINE" { interpolation = anim.CUBIC }
    string.free(mode)
    runs = 1
    if interpolation == anim.CUBIC { runs = 3 }
    if output.count != input.count * width * runs {
        warn(r, "a weights animation whose output is not its keys times its targets")
        accessor_close(input)
        accessor_close(output)
        return null
    }
    c = anim.channel_new_weights(width, interpolation)
    values = calloc(width, 8)
    ins = calloc(width, 8)
    outs = calloc(width, 8)
    k = 0
    while k < input.count {
        base = k * width * runs
        j = 0
        while j < width {
            if interpolation == anim.CUBIC {
                (ins as float[])[j] = accessor_get(output, base + j, 0)
                (values as float[])[j] = accessor_get(output, base + width + j, 0)
                (outs as float[])[j] = accessor_get(output, base + width * 2 + j, 0)
            } else {
                (values as float[])[j] = accessor_get(output, base + j, 0)
            }
            j = j + 1
        }
        if interpolation == anim.CUBIC {
            anim.channel_add_weights(c, accessor_get(input, k, 0), values, ins, outs)
        } else {
            anim.channel_add_weights(c, accessor_get(input, k, 0), values, null, null)
        }
        k = k + 1
    }
    free(values)
    free(ins)
    free(outs)
    accessor_close(input)
    accessor_close(output)
    return c
}

value_w(a: *Accessor, i: int, width: int) -> float {
    if width < 4 { return 0.0 }
    return accessor_get(a, i, 3)
}

load_animations(r: *Reader) {
    animations = array_field(r.root, "animations")
    count = array_count(animations)
    a = 0
    while a < count {
        animation = json.array_get_raw(animations, a)
        name = text_field(animation, "name")
        if name == "" {
            string.free(name)
            name = string.concat("animation_", string.from_int(a))
        }
        list.add_raw(r.scene.animation_names, text_new(name))
        samplers = json.object_get_raw(animation, "samplers")
        channels = json.object_get_raw(animation, "channels")
        ccount = array_count(channels)
        // One clip per node the animation drives, gathering its channels.
        c = 0
        while c < ccount {
            channel = json.array_get_raw(channels, c)
            target = json.object_get_raw(channel, "target")
            node_index = int_field(target, "node", 0 - 1)
            path = text_field(target, "path")
            kind = 0 - 1
            if path == "translation" { kind = anim.TRANSLATION }
            if path == "rotation" { kind = anim.ROTATION }
            if path == "scale" { kind = anim.SCALE }
            if path == "weights" { kind = anim.WEIGHTS }
            string.free(path)
            sampler_index = int_field(channel, "sampler", 0 - 1)
            if kind >= 0 && node_index >= 0 && node_index < list.size(r.scene.nodes) &&
               sampler_index >= 0 && sampler_index < array_count(samplers) {
                track = null
                if kind == anim.WEIGHTS {
                    track = read_weights(r, json.array_get_raw(samplers, sampler_index), node_index)
                } else {
                    track = read_sampler(r, json.array_get_raw(samplers, sampler_index), kind)
                }
                if track != null {
                    node = list.get_raw(r.scene.nodes, node_index) as *Model
                    clip = clip_for(r, name, node)
                    anim.clip_add_channel(clip, track)
                }
            }
            c = c + 1
        }
        string.free(name)
        a = a + 1
    }
}

// The clip of `animation` driving `node`, made on first use.
clip_for(r: *Reader, animation: string, node: *Model) -> *Clip {
    full = string.concat(animation, string.concat(":", node.name))
    i = 0
    count = list.size(r.scene.clips)
    while i < count {
        existing = list.get_raw(r.scene.clips, i) as *Clip
        if list.get_raw(r.scene.clip_nodes, i) == node as ptr && anim.clip_name(existing) == full {
            string.free(full)
            return existing
        }
        i = i + 1
    }
    clip = anim.clip_new(full)
    string.free(full)
    list.add_raw(r.scene.clips, clip as ptr)
    list.add_raw(r.scene.clip_nodes, node as ptr)
    return clip
}

// ---------------------------------------------------------------------------
// The file.
// ---------------------------------------------------------------------------

// The scene in the file at `path`: its nodes, meshes, skins and animations.
// A file is parsed once while any scene of it is held (#992): a scene of
// bytes read before (the same size and CRC-32) is made from what that parse
// left -- its own nodes, skeletons, morph weights and springs, the file's
// meshes shared (a morphed one copied: each figure's targets reshape their
// own), its animations shared -- without reading the JSON again. A
// mannequin's 8 MB file was parsed for every figure of it, and each held
// its own 0.84 MB of meshes.
load(path: string) -> *GltfScene {
    file_bytes = blob.read(path)
    size = blob.last_size()
    if file_bytes == null {
        set_error("cannot read ", path)
        return null
    }
    crc = checksum.crc32(0 as long, file_bytes, size as int)
    held = file_find(size, crc)
    if held == null {
        made = parse(path, file_bytes, size, crc)
        if made == null { return null }
        held = file_keep(made, size, crc)
    } else {
        blob.free_bytes(file_bytes)
    }
    return instance(held, path)
}

// The file's bytes (`size` of them, their CRC-32 `crc`), freed here, parsed
// into a scene.
parse(path: string, file_bytes: @keep ptr, size: long, crc: long) -> *GltfScene {
    g_parses = g_parses + 1
    text = ""
    glb_bin = null
    glb_bin_size = 0 as long
    if size >= 12 && blob.u32(file_bytes, 0) == GLB_MAGIC {
        // A .glb: a 12-byte header, then chunks, each a length, a type and
        // its bytes; the JSON first, the binary buffer after.
        at = 12 as long
        while at + 8 <= size {
            length = blob.u32(file_bytes, at) as long
            kind = blob.u32(file_bytes, at + 4)
            if at + 8 + length > size { at = size } else {
                if kind == GLB_CHUNK_JSON && text == "" { text = bytes.string_from_ptr(blob.slice(file_bytes, at + 8), length as int) }
                if kind == GLB_CHUNK_BIN && glb_bin == null {
                    // The chunk stays where it is in the file's bytes; the
                    // scene keeps the whole file for as long as it needs it.
                    glb_bin = blob.slice(file_bytes, at + 8)
                    glb_bin_size = length
                }
                at = at + 8 + length
            }
        }
        if text == "" {
            blob.free_bytes(file_bytes)
            set_error("no JSON chunk in ", path)
            return null
        }
    } else {
        text = bytes.string_from_ptr(file_bytes, size as int)
    }
    root = json.parse_raw(text)
    // The text is the runtime's (std.bytes), freed with this function's scope.
    if root == null {
        blob.free_bytes(file_bytes)
        set_error("cannot parse ", path)
        return null
    }

    scene = heap.new(GltfScene)
    scene.nodes = list.new()
    scene.models = list.new()
    scene.primitives = list.new()
    scene.primitive_nodes = list.new()
    scene.roots = list.new()
    scene.skeletons = list.new()
    scene.animation_names = list.new()
    scene.clips = list.new()
    scene.clip_nodes = list.new()
    scene.warnings = list.new()
    scene.registered = list.new()
    scene.springs = list.new()
    scene.spring_colliders = list.new()
    scene.source = string.copy(path)
    scene.directory = directory_of(path)

    r = heap.new(Reader)
    r.root = root
    r.buffers = list.new()
    r.scene = scene
    load_buffers(r, glb_bin, glb_bin_size)
    load_nodes(r)
    load_skins(r)
    // The animations: another scene's from the same bytes where there is
    // one, read from the file otherwise and offered to the scenes after.
    held = anims_find(size, crc)
    if held != null {
        anims_take(scene, held)
    } else {
        load_animations(r)
        anims_offer(scene, size, crc)
    }
    load_springs(r)

    // The buffers are read into the meshes and clips; nothing keeps them.
    i = 0
    while i < list.size(r.buffers) {
        b = list.get_raw(r.buffers, i) as *GltfBuffer
        if b.bytes != null && b.bytes != glb_bin { blob.free_bytes(b.bytes) }
        heap.free(b)
        i = i + 1
    }
    list.free(r.buffers)
    heap.free(r)
    json.free(root)
    blob.free_bytes(file_bytes)
    return scene
}

// The animations read from `size` bytes whose CRC-32 is `crc`, held by a
// scene now; null for none.
anims_find(size: long, crc: long) -> *GltfAnims {
    if g_anims == null { return null }
    i = 0
    while i < list.size(g_anims) {
        a = list.get_raw(g_anims, i) as *GltfAnims
        if a.size == size && a.crc == crc { return a }
        i = i + 1
    }
    return null
}

// Scene `s` on the animations `a` holds: its own list of their clips, each
// driving its own node of the same index, and their names.
anims_take(s: *GltfScene, a: *GltfAnims) {
    a.users = a.users + 1
    s.anims = a as ptr
    i = 0
    while i < list.size(a.names) {
        list.add_raw(s.animation_names, text_new(text_of(list.get_raw(a.names, i))))
        i = i + 1
    }
    nodes = a.nodes as int[]
    i = 0
    while i < list.size(a.clips) {
        list.add_raw(s.clips, list.get_raw(a.clips, i))
        list.add_raw(s.clip_nodes, list.get_raw(s.nodes, nodes[i]))
        i = i + 1
    }
    s.shared_clips = list.size(a.clips)
}

// The animations scene `s` has just read from its file, offered to the
// scenes loaded from the same bytes after it. A file with none offers none.
anims_offer(s: *GltfScene, size: long, crc: long) {
    count = list.size(s.clips)
    if count == 0 { return }
    a = heap.new(GltfAnims)
    a.size = size
    a.crc = crc
    a.names = list.new()
    a.clips = list.new()
    a.nodes = calloc(count, 4)
    nodes = a.nodes as int[]
    i = 0
    while i < list.size(s.animation_names) {
        list.add_raw(a.names, text_new(text_of(list.get_raw(s.animation_names, i))))
        i = i + 1
    }
    i = 0
    while i < count {
        list.add_raw(a.clips, list.get_raw(s.clips, i))
        node = list.get_raw(s.clip_nodes, i)
        k = 0
        while k < list.size(s.nodes) {
            if list.get_raw(s.nodes, k) == node {
                nodes[i] = k
                break
            }
            k = k + 1
        }
        i = i + 1
    }
    a.users = 1
    s.anims = a as ptr
    s.shared_clips = count
    if g_anims == null { g_anims = list.new() }
    list.add_raw(g_anims, a as ptr)
}

// A scene's hold on its shared animations let go of; they go with the last.
anims_drop(s: *GltfScene) {
    a = s.anims as *GltfAnims
    s.anims = null
    if a == null { return }
    a.users = a.users - 1
    if a.users > 0 { return }
    k = 0
    while k < list.size(g_anims) {
        if list.get_raw(g_anims, k) == a as ptr {
            list.remove(g_anims, k)
            break
        }
        k = k + 1
    }
    i = 0
    while i < list.size(a.clips) {
        anim.clip_free(list.get_raw(a.clips, i) as *Clip)
        i = i + 1
    }
    list.free(a.clips)
    i = 0
    while i < list.size(a.names) {
        text_free(list.get_raw(a.names, i))
        i = i + 1
    }
    list.free(a.names)
    free(a.nodes)
    heap.free(a)
}

// How many scenes hold the animations scene `s` reads from its file: 1 for
// its own alone, 0 for a file with none (#990).
anims_users(s: *GltfScene) -> int {
    if s == null || s.anims == null { return 0 }
    return (s.anims as *GltfAnims).users
}

scene_free(s: *GltfScene) {
    if s == null { return }
    // The clips added to it (add_clip) are its own; the file's are shared.
    i = s.shared_clips
    while i < list.size(s.clips) {
        anim.clip_free(list.get_raw(s.clips, i) as *Clip)
        i = i + 1
    }
    anims_drop(s)
    list.free(s.clips)
    list.free(s.clip_nodes)
    i = 0
    while i < list.size(s.skeletons) {
        skin.skeleton_free(list.get_raw(s.skeletons, i) as *Skeleton)
        i = i + 1
    }
    list.free(s.skeletons)
    i = 0
    while i < list.size(s.animation_names) {
        text_free(list.get_raw(s.animation_names, i))
        i = i + 1
    }
    list.free(s.animation_names)
    i = 0
    while i < list.size(s.warnings) {
        text_free(list.get_raw(s.warnings, i))
        i = i + 1
    }
    list.free(s.warnings)
    i = 0
    while i < list.size(s.registered) {
        text_free(list.get_raw(s.registered, i))
        i = i + 1
    }
    list.free(s.registered)
    i = 0
    while i < list.size(s.springs) {
        g = list.get_raw(s.springs, i) as *VrmSpring
        k = 0
        while k < list.size(g.joints) {
            heap.free(list.get_raw(g.joints, k) as *VrmSpringJoint)
            k = k + 1
        }
        list.free(g.joints)
        if g.collider_groups != null { free(g.collider_groups) }
        heap.free(g)
        i = i + 1
    }
    list.free(s.springs)
    i = 0
    while i < list.size(s.spring_colliders) {
        heap.free(list.get_raw(s.spring_colliders, i) as *VrmCollider)
        i = i + 1
    }
    list.free(s.spring_colliders)
    // The models are the caller's once handed to an engine; the lists go,
    // the models stay, as with a manifest's. scene_destroy frees them too.
    list.free(s.models)
    list.free(s.primitives)
    list.free(s.primitive_nodes)
    list.free(s.nodes)
    list.free(s.roots)
    if s.settled != null { free(s.settled) }
    // Its hold on the file's parse let go of: the parse goes with the last
    // scene of it. A model of it an engine still draws keeps its share of
    // the meshes (core.model_share_mesh).
    file = s.file as *GltfFile
    heap.free(s)
    if file != null { file_drop(file) }
}

// --- a file parsed once (#992) -------------------------------------------------------------------

// The file parsed from `size` bytes whose CRC-32 is `crc`, held by a scene
// now; null for none.
file_find(size: long, crc: long) -> *GltfFile {
    if g_files == null { return null }
    i = 0
    while i < list.size(g_files) {
        f = list.get_raw(g_files, i) as *GltfFile
        if f.size == size && f.crc == crc { return f }
        i = i + 1
    }
    return null
}

// Scene `s`, just parsed, kept as its file's parse: the scenes of the file
// are made from it.
file_keep(s: *GltfScene, size: long, crc: long) -> *GltfFile {
    f = heap.new(GltfFile)
    f.size = size
    f.crc = crc
    f.scene = s as ptr
    f.anims = s.anims
    count = list.size(s.primitives)
    f.primitive_nodes = calloc(count + 1, 4)
    k = 0
    while k < count {
        (f.primitive_nodes as int[])[k] = node_index(s, list.get_raw(s.primitive_nodes, k))
        k = k + 1
    }
    if g_files == null { g_files = list.new() }
    list.add_raw(g_files, f as ptr)
    return f
}

// Node `node`'s index among scene `s`'s, -1 for none.
node_index(s: *GltfScene, node: ptr) -> int {
    if node == null { return 0 - 1 }
    i = 0
    while i < list.size(s.nodes) {
        if list.get_raw(s.nodes, i) == node { return i }
        i = i + 1
    }
    return 0 - 1
}

// A scene's hold on its file's parse let go of; with the last, the parse
// goes: its scene's models and its share of the meshes.
file_drop(f: *GltfFile) {
    f.users = f.users - 1
    if f.users > 0 { return }
    k = 0
    while k < list.size(g_files) {
        if list.get_raw(g_files, k) == f as ptr {
            list.remove(g_files, k)
            break
        }
        k = k + 1
    }
    scene_destroy(f.scene as *GltfScene)
    free(f.primitive_nodes)
    heap.free(f)
}

// A scene of the file parsed into `f`, read from `path`: its own nodes
// (each as the file places it, its morph weights the file's), its own
// skeletons over them with the file's inverse binds, its own springs; the
// file's meshes shared, a morphed one copied with its targets; the file's
// animations shared (anims_take).
instance(f: *GltfFile, path: string) -> *GltfScene {
    from = f.scene as *GltfScene
    f.users = f.users + 1
    s = heap.new(GltfScene)
    s.nodes = list.new()
    s.models = list.new()
    s.primitives = list.new()
    s.primitive_nodes = list.new()
    s.roots = list.new()
    s.skeletons = list.new()
    s.animation_names = list.new()
    s.clips = list.new()
    s.clip_nodes = list.new()
    s.warnings = list.new()
    s.registered = list.new()
    s.springs = list.new()
    s.spring_colliders = list.new()
    s.source = string.copy(path)
    s.directory = directory_of(path)
    s.file = f as ptr
    // The nodes, each placed as the file places it, and their primitives.
    n = list.size(from.nodes)
    i = 0
    while i < n {
        src = list.get_raw(from.nodes, i) as *Model
        m = core.model_new()
        core.model_set_name(m, src.name)
        core.model_set_position(m, src.position.x, src.position.y, src.position.z)
        core.model_set_scale(m, src.scale.x, src.scale.y, src.scale.z)
        core.model_set_rotation(m, src.rotation)
        k = 0
        while k < core.model_morph_weight_count(src) {
            core.model_set_morph_weight(m, k, core.model_morph_weight(src, k))
            k = k + 1
        }
        list.add_raw(s.nodes, m as ptr)
        list.add_raw(s.models, m as ptr)
        i = i + 1
    }
    nodes_at = f.primitive_nodes as int[]
    p = 0
    while p < list.size(from.primitives) {
        src = list.get_raw(from.primitives, p) as *Model
        node = list.get_raw(s.nodes, nodes_at[p]) as *Model
        part = share_primitive(src)
        if src.morph_driver != null { core.model_set_morph_driver(part, node as ptr) }
        if src.parent != null { core.model_set_parent(part, node) }
        list.add_raw(s.models, part as ptr)
        list.add_raw(s.primitives, part as ptr)
        list.add_raw(s.primitive_nodes, node as ptr)
        p = p + 1
    }
    // Parents after every node exists, then the roots.
    i = 0
    while i < n {
        up = node_index(from, (list.get_raw(from.nodes, i) as *Model).parent)
        if up >= 0 { core.model_set_parent(list.get_raw(s.nodes, i) as *Model, list.get_raw(s.nodes, up) as *Model) }
        i = i + 1
    }
    i = 0
    while i < n {
        m = list.get_raw(s.nodes, i) as *Model
        if m.parent == null { list.add_raw(s.roots, m as ptr) }
        i = i + 1
    }
    instance_skins(from, s)
    instance_springs(from, s)
    // The file's animations, shared.
    if f.anims != null { anims_take(s, f.anims as *GltfAnims) }
    i = 0
    while i < list.size(from.warnings) {
        list.add_raw(s.warnings, text_new(text_of(list.get_raw(from.warnings, i))))
        i = i + 1
    }
    i = 0
    while i < list.size(from.registered) {
        list.add_raw(s.registered, text_new(text_of(list.get_raw(from.registered, i))))
        i = i + 1
    }
    // The parse holds no use of the animations: they go with the last
    // scene that plays them, as the parse does.
    if f.users == 1 && from.anims != null { anims_drop(from) }
    return s
}

// A primitive of the file's as a model of a scene's: the mesh shared, or,
// morphed, copied with its targets (a morphed mesh is reshaped per figure,
// and never shared); its material its own copy; its name.
share_primitive(src: *Model) -> *Model {
    part = core.model_new()
    core.model_set_name(part, src.name)
    if src.morph != null {
        core.model_set_mesh(part, geometry.mesh_clone(src.mesh))
        core.model_set_morph(part, morph.set_clone(src.morph as *MorphSet) as ptr)
        k = 0
        while k < core.model_morph_weight_count(src) {
            core.model_set_morph_weight(part, k, core.model_morph_weight(src, k))
            k = k + 1
        }
    } else {
        core.model_share_mesh(part, src)
    }
    if src.material != null { part.material = core.model_own_material(part, core.material_clone(src.material)) }
    return part
}

// Scene `s`'s skeletons, as `from`'s: each over `s`'s nodes of the same
// index, its inverse binds the file's (or bound as the nodes rest), in
// the space of the node of the same index, posing the primitives `from`'s
// pose.
instance_skins(from: *GltfScene, s: *GltfScene) {
    k = 0
    while k < list.size(from.skeletons) {
        src = list.get_raw(from.skeletons, k) as *Skeleton
        sk = skin.skeleton_new()
        b = 0
        while b < skin.skeleton_count(src) {
            at = node_index(from, skin.skeleton_bone(src, b) as ptr)
            index = skin.skeleton_add(sk, list.get_raw(s.nodes, at) as *Model)
            bone = list.get_raw(src.bones, b) as *Bone
            if index >= 0 { skin.skeleton_set_inverse_bind(sk, index, bone.inverse_bind) }
            b = b + 1
        }
        if from.settled != null && (from.settled as int[])[k] == 1 { skin.skeleton_settle(sk) } else { skin.skeleton_bind(sk) }
        space = node_index(from, src.space)
        if space >= 0 { skin.skeleton_set_space(sk, list.get_raw(s.nodes, space) as *Model) }
        list.add_raw(s.skeletons, sk as ptr)
        k = k + 1
    }
    p = 0
    while p < list.size(from.primitives) {
        sk_from = (list.get_raw(from.primitives, p) as *Model).skeleton
        if sk_from != null {
            k = 0
            while k < list.size(from.skeletons) {
                if list.get_raw(from.skeletons, k) == sk_from {
                    sk = list.get_raw(s.skeletons, k) as *Skeleton
                    part = list.get_raw(s.primitives, p) as *Model
                    core.model_set_skeleton(part, sk as ptr)
                    if part.mesh != null && core.mesh_is_skinned(part.mesh) { skin.skeleton_add_mesh(sk, part.mesh) }
                }
                k = k + 1
            }
        }
        p = p + 1
    }
}

// Scene `s`'s spring bones and colliders, as `from`'s, on `s`'s nodes.
instance_springs(from: *GltfScene, s: *GltfScene) {
    i = 0
    while i < list.size(from.springs) {
        src = list.get_raw(from.springs, i) as *VrmSpring
        g = heap.new(VrmSpring)
        g.joints = list.new()
        k = 0
        while k < list.size(src.joints) {
            sj = list.get_raw(src.joints, k) as *VrmSpringJoint
            j = heap.new(VrmSpringJoint)
            j.node = node_model_of(from, s, sj.node)
            j.stiffness = sj.stiffness
            j.drag = sj.drag
            j.gravity_power = sj.gravity_power
            j.gravity_dir = sj.gravity_dir
            j.hit_radius = sj.hit_radius
            list.add_raw(g.joints, j as ptr)
            k = k + 1
        }
        g.joint_count = src.joint_count
        g.collider_group_count = src.collider_group_count
        if src.collider_groups != null {
            g.collider_groups = calloc(src.collider_group_count + 1, 8)
            k = 0
            while k < src.collider_group_count {
                (g.collider_groups as int[])[k] = (src.collider_groups as int[])[k]
                k = k + 1
            }
        }
        g.tree = src.tree
        list.add_raw(s.springs, g as ptr)
        i = i + 1
    }
    i = 0
    while i < list.size(from.spring_colliders) {
        held = list.get_raw(from.spring_colliders, i) as *VrmCollider
        c = heap.new(VrmCollider)
        c.node = node_model_of(from, s, held.node)
        c.offset = held.offset
        c.tail = held.tail
        c.radius = held.radius
        c.group = held.group
        list.add_raw(s.spring_colliders, c as ptr)
        i = i + 1
    }
}

// `node`, one of `from`'s nodes, as `s`'s node of the same index; null for none.
node_model_of(from: *GltfScene, s: *GltfScene, node: ptr) -> ptr {
    at = node_index(from, node)
    if at < 0 { return null }
    return list.get_raw(s.nodes, at)
}

// The scene and every model in it: for a program that never handed them
// to an engine, or has freed the engine that held them. The primitives go
// first, then the nodes from the leaves up, since a node is a parent to
// the ones after it in the file.
scene_destroy(s: *GltfScene) {
    if s == null { return }
    i = list.size(s.primitives) - 1
    while i >= 0 {
        core.model_free(list.get_raw(s.primitives, i) as *Model)
        i = i - 1
    }
    i = list.size(s.nodes) - 1
    while i >= 0 {
        core.model_free(list.get_raw(s.nodes, i) as *Model)
        i = i - 1
    }
    scene_free(s)
}

// --- a VRM's spring bones (#989) ------------------------------------------------------------------

spring_count(s: *GltfScene) -> int { return list.size(s.springs) }
spring(s: *GltfScene, i: int) -> *VrmSpring { return list.get_raw(s.springs, i) as *VrmSpring }
spring_joint(g: *VrmSpring, k: int) -> *VrmSpringJoint { return list.get_raw(g.joints, k) as *VrmSpringJoint }
spring_collider_count(s: *GltfScene) -> int { return list.size(s.spring_colliders) }
spring_collider(s: *GltfScene, i: int) -> *VrmCollider { return list.get_raw(s.spring_colliders, i) as *VrmCollider }

node_model(r: *Reader, index: int) -> ptr {
    if index < 0 || index >= list.size(r.scene.nodes) { return null }
    return list.get_raw(r.scene.nodes, index)
}

// An {x, y, z} object (VRM 0.x's), its z turned about as VRM 0.x's are
// (UniVRM writes them in Unity's left-handed space, the file's nodes
// with their z reversed).
vrm0_vec(node: ptr, fallback: Vec3) -> Vec3 {
    if node == null { return fallback }
    return core.vec3(number_field(node, "x", 0.0), number_field(node, "y", 0.0), 0.0 - number_field(node, "z", 0.0))
}

// A [x, y, z] array (VRM 1.0's).
vrm1_vec(values: ptr, fallback: Vec3) -> Vec3 {
    if values == null { return fallback }
    return core.vec3(component(values, 0, fallback.x), component(values, 1, fallback.y), component(values, 2, fallback.z))
}

int_array(values: ptr) -> ptr {
    n = array_count(values)
    out = calloc(n + 1, 8)
    k = 0
    while k < n {
        (out as int[])[k] = json.get_int(json.array_get_raw(values, k))
        k = k + 1
    }
    return out
}

load_springs(r: *Reader) {
    extensions = json.object_get_raw(r.root, "extensions")
    if extensions == null { return }
    vrm1 = json.object_get_raw(extensions, "VRMC_springBone")
    if vrm1 != null {
        load_springs_vrm1(r, vrm1)
        return
    }
    vrm0 = json.object_get_raw(extensions, "VRM")
    if vrm0 == null { return }
    secondary = json.object_get_raw(vrm0, "secondaryAnimation")
    if secondary == null { return }
    groups = array_field(secondary, "colliderGroups")
    g = 0
    while g < array_count(groups) {
        group = json.array_get_raw(groups, g)
        node = node_model(r, int_field(group, "node", 0 - 1))
        colliders = array_field(group, "colliders")
        k = 0
        while k < array_count(colliders) {
            c = json.array_get_raw(colliders, k)
            vc = heap.new(VrmCollider)
            vc.node = node
            vc.offset = vrm0_vec(json.object_get_raw(c, "offset"), core.vec3(0.0, 0.0, 0.0))
            vc.tail = vc.offset
            vc.radius = number_field(c, "radius", 0.0)
            vc.group = g
            list.add_raw(r.scene.spring_colliders, vc as ptr)
            k = k + 1
        }
        g = g + 1
    }
    bone_groups = array_field(secondary, "boneGroups")
    g = 0
    while g < array_count(bone_groups) {
        bg = json.array_get_raw(bone_groups, g)
        sg = heap.new(VrmSpring)
        sg.joints = list.new()
        sg.tree = true
        uses = array_field(bg, "colliderGroups")
        sg.collider_groups = int_array(uses)
        sg.collider_group_count = array_count(uses)
        // "stiffiness" is VRM 0.x's own spelling; "stiffness" read too.
        stiffness = number_field(bg, "stiffiness", number_field(bg, "stiffness", 1.0))
        bones = array_field(bg, "bones")
        k = 0
        while k < array_count(bones) {
            jt = heap.new(VrmSpringJoint)
            jt.node = node_model(r, json.get_int(json.array_get_raw(bones, k)))
            jt.stiffness = stiffness
            jt.drag = number_field(bg, "dragForce", 0.4)
            jt.gravity_power = number_field(bg, "gravityPower", 0.0)
            jt.gravity_dir = vrm0_vec(json.object_get_raw(bg, "gravityDir"), core.vec3(0.0, 0.0 - 1.0, 0.0))
            jt.hit_radius = number_field(bg, "hitRadius", 0.02)
            list.add_raw(sg.joints, jt as ptr)
            k = k + 1
        }
        sg.joint_count = list.size(sg.joints)
        list.add_raw(r.scene.springs, sg as ptr)
        g = g + 1
    }
}

load_springs_vrm1(r: *Reader, ext: ptr) {
    shapes = array_field(ext, "colliders")
    groups = array_field(ext, "colliderGroups")
    g = 0
    while g < array_count(groups) {
        members = array_field(json.array_get_raw(groups, g), "colliders")
        k = 0
        while k < array_count(members) {
            c = json.array_get_raw(shapes, json.get_int(json.array_get_raw(members, k)))
            if c != null {
                shape = json.object_get_raw(c, "shape")
                sphere = null as ptr
                capsule = null as ptr
                if shape != null {
                    sphere = json.object_get_raw(shape, "sphere")
                    capsule = json.object_get_raw(shape, "capsule")
                }
                vc = heap.new(VrmCollider)
                vc.node = node_model(r, int_field(c, "node", 0 - 1))
                vc.group = g
                if capsule != null {
                    vc.offset = vrm1_vec(json.object_get_raw(capsule, "offset"), core.vec3(0.0, 0.0, 0.0))
                    vc.tail = vrm1_vec(json.object_get_raw(capsule, "tail"), vc.offset)
                    vc.radius = number_field(capsule, "radius", 0.0)
                } else if sphere != null {
                    vc.offset = vrm1_vec(json.object_get_raw(sphere, "offset"), core.vec3(0.0, 0.0, 0.0))
                    vc.tail = vc.offset
                    vc.radius = number_field(sphere, "radius", 0.0)
                }
                list.add_raw(r.scene.spring_colliders, vc as ptr)
            }
            k = k + 1
        }
        g = g + 1
    }
    springs = array_field(ext, "springs")
    s = 0
    while s < array_count(springs) {
        sj = json.array_get_raw(springs, s)
        sg = heap.new(VrmSpring)
        sg.joints = list.new()
        sg.tree = false
        uses = array_field(sj, "colliderGroups")
        sg.collider_groups = int_array(uses)
        sg.collider_group_count = array_count(uses)
        joints = array_field(sj, "joints")
        k = 0
        while k < array_count(joints) {
            j = json.array_get_raw(joints, k)
            jt = heap.new(VrmSpringJoint)
            jt.node = node_model(r, int_field(j, "node", 0 - 1))
            jt.stiffness = number_field(j, "stiffness", 1.0)
            jt.drag = number_field(j, "dragForce", 0.5)
            jt.gravity_power = number_field(j, "gravityPower", 0.0)
            jt.gravity_dir = vrm1_vec(json.object_get_raw(j, "gravityDir"), core.vec3(0.0, 0.0 - 1.0, 0.0))
            jt.hit_radius = number_field(j, "hitRadius", 0.0)
            list.add_raw(sg.joints, jt as ptr)
            k = k + 1
        }
        sg.joint_count = list.size(sg.joints)
        list.add_raw(r.scene.springs, sg as ptr)
        s = s + 1
    }
}

model_count(s: *GltfScene) -> int { return list.size(s.models) }
primitive_count(s: *GltfScene) -> int { return list.size(s.primitives) }
primitive(s: *GltfScene, index: int) -> *Model { return list.get_raw(s.primitives, index) as *Model }
model(s: *GltfScene, index: int) -> *Model { return list.get_raw(s.models, index) as *Model }
root_count(s: *GltfScene) -> int { return list.size(s.roots) }
root(s: *GltfScene, index: int) -> *Model { return list.get_raw(s.roots, index) as *Model }
skeleton_count(s: *GltfScene) -> int { return list.size(s.skeletons) }
skeleton(s: *GltfScene, index: int) -> *Skeleton { return list.get_raw(s.skeletons, index) as *Skeleton }
animation_count(s: *GltfScene) -> int { return list.size(s.animation_names) }
animation_name(s: *GltfScene, index: int) -> string { return text_of(list.get_raw(s.animation_names, index)) }
clip_count(s: *GltfScene) -> int { return list.size(s.clips) }
clip(s: *GltfScene, index: int) -> *Clip { return list.get_raw(s.clips, index) as *Clip }
// The node clip `index` drives.
clip_node(s: *GltfScene, index: int) -> *Model { return list.get_raw(s.clip_nodes, index) as *Model }
warning_count(s: *GltfScene) -> int { return list.size(s.warnings) }
warning(s: *GltfScene, index: int) -> string { return text_of(list.get_raw(s.warnings, index)) }

// The first model of that name, node or primitive.
find(s: *GltfScene, name: string) -> *Model {
    i = 0
    count = list.size(s.models)
    while i < count {
        m = list.get_raw(s.models, i) as *Model
        if m.name == name { return m }
        i = i + 1
    }
    return null
}

// Every clip of the named animation bound to the node it drives, as players
// in the registry, looping or not. Returns how many were made.
play(s: *GltfScene, animation: string, registry: *Registry, looping: bool) -> int {
    made = 0
    prefix = string.concat(animation, ":")
    i = 0
    count = list.size(s.clips)
    while i < count {
        c = list.get_raw(s.clips, i) as *Clip
        if string.starts_with(anim.clip_name(c), prefix) == 1 {
            p = anim.player_new(c)
            anim.player_set_looping(p, looping)
            anim.player_play(p)
            anim.registry_add(registry, anim.clip_name(c), p, list.get_raw(s.clip_nodes, i) as *Model)
            made = made + 1
        }
        i = i + 1
    }
    string.free(prefix)
    return made
}

// A clip made at run time -- captured, retargeted, generated -- added to
// the file's animation `animation` as the clip driving `node`, as the
// file's own are (#645): counted and named with them (animation_count,
// animation_name), played, blended and layered by its name. The clip must
// be named "<animation>:<anything>", the file's convention, which play()
// finds an animation's clips by, and `node` must be one of the file's own;
// false otherwise, and the clip still the caller's. Added, it is the
// file's, freed with it.
add_clip(s: *GltfScene, animation: string, clip: *Clip, node: *Model) -> bool {
    if s == null || clip == null || node == null || animation == "" { return false }
    prefix = string.concat(animation, ":")
    named = string.starts_with(anim.clip_name(clip), prefix) == 1
    string.free(prefix)
    if !named { return false }
    owned = false
    i = 0
    while i < list.size(s.models) {
        if list.get_raw(s.models, i) == node as ptr { owned = true }
        i = i + 1
    }
    if !owned { return false }
    known = false
    i = 0
    while i < list.size(s.animation_names) {
        if text_of(list.get_raw(s.animation_names, i)) == animation { known = true }
        i = i + 1
    }
    if !known { list.add_raw(s.animation_names, text_new(animation)) }
    list.add_raw(s.clips, clip as ptr)
    list.add_raw(s.clip_nodes, node as ptr)
    return true
}

// How long an animation runs: the longest of its clips, one per node.
animation_duration(s: *GltfScene, animation: string) -> float {
    longest = 0.0
    prefix = string.concat(animation, ":")
    i = 0
    count = list.size(s.clips)
    while i < count {
        c = list.get_raw(s.clips, i) as *Clip
        if string.starts_with(anim.clip_name(c), prefix) == 1 {
            d = anim.clip_duration(c)
            if d > longest { longest = d }
        }
        i = i + 1
    }
    string.free(prefix)
    return longest
}

// The bone that carries a figure's travel, for a bake in place: a Root or
// a Hips by name, as Mixamo, Blender and most packs call it, else the
// skin's first joint, which is the root of the tree it lists. -1 without
// a skeleton.
bake_root(s: *GltfScene) -> int {
    if list.size(s.skeletons) == 0 { return 0 - 1 }
    skel = list.get_raw(s.skeletons, 0) as *Skeleton
    root = skin.skeleton_find(skel, "Root")
    if root < 0 { root = skin.skeleton_find(skel, "Hips") }
    if root < 0 { root = skin.skeleton_find(skel, "mixamorig:Hips") }
    if root < 0 { root = skin.skeleton_find(skel, "root") }
    if root < 0 { root = 0 }
    return root
}

// One of the file's animations baked into a pose bank of `frames` poses
// over the first skin, in place -- the travel on the root bone taken out
// and recorded, the way the pipeline's zombie is baked -- so a figure from
// anywhere joins a crowd: every primitive of the file, instanced with the
// bank (`model_set_pose_bank`), is posed by its own phase in the vertex
// shader. The clip's whole length is the cycle; a walk exported as one
// cycle loops without a seam. Null, with the error set, when the file has
// no skin or no animation of that name; the caller frees the bank
// (`crowd.posebank_free`).
bake_bank(s: *GltfScene, animation: string, frames: int) -> ptr {
    if s == null { return null }
    if list.size(s.skeletons) == 0 {
        set_error("bake_bank: ", "the file has no skin to bake a bank over")
        return null
    }
    skel = list.get_raw(s.skeletons, 0) as *Skeleton
    reg = anim.registry_new()
    made = play(s, animation, reg, true)
    if made == 0 {
        anim.registry_free(reg)
        set_error("bake_bank: no animation named ", animation)
        return null
    }
    duration = animation_duration(s, animation)
    if duration <= 0.0 { duration = 1.0 }
    // The nodes as they stood, put back after: the bake reads the clip off
    // them, and left them on its last pose, where a clip played next that
    // does not key a node left it (#673).
    held = hold_nodes(s)
    bank = crowd.posebank_bake_in_place(reg, skel, frames, 0.0, duration, bake_root(s))
    put_nodes_back(s, held)
    anim.registry_free(reg)
    return bank
}

// Every node's place, turn and scale, ten floats a node, to put back with
// put_nodes_back, which frees them.
hold_nodes(s: *GltfScene) -> ptr {
    count = model_count(s)
    held = calloc(count * 10 + 1, 8)
    h = held as float[]
    i = 0
    while i < count {
        m = model(s, i)
        at = i * 10
        h[at] = m.position.x
        h[at + 1] = m.position.y
        h[at + 2] = m.position.z
        h[at + 3] = m.rotation.x
        h[at + 4] = m.rotation.y
        h[at + 5] = m.rotation.z
        h[at + 6] = m.rotation.w
        h[at + 7] = m.scale.x
        h[at + 8] = m.scale.y
        h[at + 9] = m.scale.z
        i = i + 1
    }
    return held
}

put_nodes_back(s: *GltfScene, held: ptr) {
    h = held as float[]
    i = 0
    while i < model_count(s) {
        m = model(s, i)
        at = i * 10
        core.model_set_position(m, h[at], h[at + 1], h[at + 2])
        core.model_set_rotation(m, core.quat(h[at + 3], h[at + 4], h[at + 5], h[at + 6]))
        core.model_set_scale(m, h[at + 7], h[at + 8], h[at + 9])
        i = i + 1
    }
    free(held)
}

// The models that draw -- the primitives -- in a list the caller adds to an
// engine; the nodes above them carry no mesh and need no adding, the
// primitives compose onto them.
add_to_engine_models(s: *GltfScene) -> ptr {
    out = list.new()
    i = 0
    count = list.size(s.primitives)
    while i < count {
        list.add_raw(out, list.get_raw(s.primitives, i))
        i = i + 1
    }
    return out
}
