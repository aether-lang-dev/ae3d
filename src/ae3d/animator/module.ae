// The animator (#853, layer 2): a figure's joints, owned.
//
// One animator per figure evaluates the frame's pose and writes it to the
// figure's joints once, in the engine's pose phase, after every update has run.
// Nothing else writes those joints. A game sets parameters (a state to play, a
// speed, a layer's weight, a point to look at) and never touches a bone.
//
// What it evaluates, in order:
//   - the current state: a take (looping or not, with or without its root
//     motion), or a blend space of takes along one parameter. A locomotion
//     blend keeps its takes in step by phase (each take's phase runs from its
//     left foot's first touchdown, a sync marker found at import). It picks
//     its weights from the takes' measured speeds over the ground, and sets
//     its pace so its feet carry the ground at the speed the figure is moved
//     at: the feet do not skate;
//   - the transition into it, inertialized (Bollo, GDC 2018: Gears of War
//     4). At a change the new state plays from where it enters. The offset
//     from the pose drawn the frame before, and the speed that offset was
//     changing at, decay to nothing along a quintic over the blend time. A
//     cross-fade of two poses drags a foot between two strides and plays two
//     clips for the length of the fade; this plays one, and carries the
//     motion through;
//   - layers over it: a take blended over a mask of joints (an upper body
//     waving or aiming over the legs walking), or added over it as a
//     difference from its first frame (a flinch over anything);
//   - inverse kinematics (ae3d.ikrig): feet onto the ground, the head turned
//     to a point;
//   - root motion, when it is on: the state's root travel and turn moved onto
//     the figure's object;
//   - secondary motion (ae3d.springs, springs_of): spring chains and jiggle
//     on what the takes do not drive, carried by the figure's world motion.

import std.heap
import std.list
import std.string
import std.os
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.ikrig
import ae3d.face
import ae3d.visemes
import ae3d.gltf
import ae3d.physics
import ae3d.jobs
import ae3d.springs

exports (
    springs_of, springs_from_file,
    Animator, STATE_TAKE, STATE_BLEND, STATE_BLEND2, STATE_POSE, add_blend2, blend_add2, set_velocity, blend_weight,
    ANY, ABOVE, BELOW, IS, IS_NOT, TRIGGERED, ENDED, set_float, set_bool, trigger, float_param,
    add_transition, transition_count, transition_from, transition_when, transition_crossfade, bind, bind2, snapshot, add_aim, aim_add, set_aim, set_time, clock_by, clock_from, clock_pace, transition_synced, transition_or, transition_match,
    STATE_MATCH, add_matcher, matcher_add, matcher_build, match_trajectory, matcher_searches, matcher_changes, matcher_find, matcher_frames, MATCH_BLEND, state_take, state_count, state_take_count, state_take_at, warp, warp_off, warping, lift_to, lift_now,
    attach, animator_free, rig, take, add_take, share_take, pause, paused, resume, read_drawn, add_state, add_blend, blend_add, set_param, param, play, play_at, play_synced, play_shaped, shaping, phase,
    current, current_take, state_name, find_state, state_time, set_rate, rate, transitioning, transition_offset, transition_seconds, transition_need, set_root_motion,
    root_moved, ground_speed, add_layer, layer_weight, layer_restart, layer_time, layer_rate, layer_done,
    face_on, face_off, blink, blinker, saccades, look, speak, speak_off,
    set_feet, feet, set_hands, hands, look_at, look_off, aim_at, aim_off, trunk_aim, set_body, body, evaluate, pose_now, pose_graph, pose_unheld, pose_shown, add_post, remove_post, show, set_fixed, fixed,
    contact_weight, plant_weight, figure_object, update_now,
    event_count, event_name, fired,
    take_over, set_every, update_every, graph_cost, state_sample,
    on_pool, profile, profile_reset, profile_now, profile_add, profile_seconds, profile_name, PROF_SECTIONS, PROF_MOVER, PROF_STEER, PROF_CHARACTER, state_cycle, state_speed, cycle_time, cycle_phase,
    state_size, state_write, state_read
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const STATE_TAKE = 0
const STATE_BLEND = 1
const STATE_BLEND2 = 2
const STATE_POSE = 3               // a pose held (animator.snapshot)
const STATE_MATCH = 4              // motion matching (add_matcher)
// Motion matching: features a frame (two feet's places and velocities, the
// hips' velocity, the way ahead at three times), the way ahead's share,
// seconds between searches, how near the take playing a best frame may be
// and play on, the change's blend, and the way ahead's weight against the pose.
const MATCH_DIM = 26
const MATCH_TRAJ = 12
const MATCH_EVERY = 0.1
const MATCH_NEAR = 0.2
const MATCH_BLEND = 0.2
const MATCH_WAY = 1.5
// A change is made only for a frame this share of the playing one's cost or less.
const MATCH_GAIN = 0.9
// Metres a candidate's planted foot may lie from the planted foot playing.
const MATCH_FOOT = 0.15
// The search's boxes (Holden's, as #588's): runs of frames whose features'
// least and most bound what any of them can cost.
const MATCH_SMALL = 16
const MATCH_LARGE = 64
// Metres a warped take must have left to travel for the warp to go by its
// travel rather than by the time.
const WARP_TRAVEL = 0.02
// What a foot down now and up in a transition's choice as it would enter
// adds to the distance between their feet (squared metres: as much as all
// four foot points 25 cm off, so a choice far off is not taken for it).
const FOOT_DOWN_COST = 0.25
// A matched transition's cost for an entry at its window's edge (squared
// metres, as the feet's), and the step its search takes, seconds.
const MATCH_DRIFT = 0.01
const MATCH_STEP = 0.0333333
// Seconds a layer that plays once (not looping) eases out over at its end.
const LAYER_OUT = 0.25
// A transition from any state.
const ANY = 0 - 1
// Conditions: a parameter above or below a value, a switch on or off, a
// trigger set, the state's take at its end (less the transition's time).
const ABOVE = 0
const BELOW = 1
const IS = 2
const IS_NOT = 3
const TRIGGERED = 4
const ENDED = 5
// The gradient bands' weight of a turn against a change of speed (Johansen's
// and Unity's: a radian counts as two of the speeds' relative difference).
const TURN_WEIGHT = 2.0
// Floats a joint's transition takes: the rotation's axis (3), then four
// quintics of QUINTIC floats (the angle about that axis, then x, y, z).
const QUINTIC = 7
const INERTIA_FLOATS = 31
// A blend's pace is bent to its speed within these, beyond which it plays at
// the nearest (a gait pushed far past its own speed looks wrong however it
// is timed: the next take up should be playing).
const PACE_LEAST = 0.5
const PACE_MOST = 1.75

struct State {
    name: string
    kind: int
    takes: ptr                     // list of *Take
    values: ptr                    // float[]: each take's place on the parameter (its speed, for a gait)
    values2: ptr                   // float[]: and its second, for a 2D blend (x is values, z this)
    count: int
    room: int
    time: float                    // a take's seconds; a blend's phase, 0 to 1
    rate: float                    // the game's pace on top of the state's own
    loop: bool
    root_motion: bool
    param: float
    param2: float                  // a 2D blend's second parameter (param is its x)
    bind: int                      // the parameter set as its own each frame, -1 none
    bind2: int                     // and its second, for a 2D blend
    held: ptr                      // the pose a STATE_POSE holds
    clock: int                     // the parameter its take is played by, by distance (clock_by), -1 none
    clock_left: bool               // the distance left to its end, not the distance from its start
    clock_zero: float              // the take's time its distance come counts from (clock_from)
    clock_zero_d: float            // and the metres its root has gone by then
    matcher: ptr                   // *Matcher, a STATE_MATCH's
    weights: ptr                   // float[]: each take's weight now (a blend)
    pace: float                    // the blend's own pace, to its parameter
    entered: bool                  // played since its clock last ran: an event where it starts fires
    offset: float                  // seconds its distance clock runs ahead of the distance, as a matched
                                   // transition entered it, fading out as the distance runs out
    offset_room: float             // the distance it had to run when it was entered
    entry_at: float                // the time a matched transition chose to enter it at, -1 none
    chosen: bool                   // its entry chosen by the transition entering it now
}

struct Layer {
    take: ptr                      // *Take
    mask: ptr                      // float[count]: per joint, how much of the layer it takes
    additive: bool
    loop: bool
    time: float
    weight: float
    goal: float
    fade: float                    // weight a second it moves toward its goal at
    base: ptr                      // the take's first frame (an additive layer's reference)
    rate: float                    // its clock's rate (layer_rate), 1 by default
}

struct Animator {
    rig: ptr                       // *pose.Rig
    object: ptr                    // *GameObject, the figure's
    engine: ptr                    // *Engine
    out: ptr                       // the pose drawn this frame
    before: ptr                    // and the frame before
    graph_out: ptr                 // the graph's own pose last frame, before its layers, aims, lift and feet
    graph_before: ptr              // and the frame before: what a transition eases out of
    unheld: ptr                    // the pose last frame as the hands' solve began (pose_unheld), made with the hands
    work: ptr                      // scratch poses
    work2: ptr
    worlds: ptr                    // rig-space scratch for IK
    states: ptr                    // list of *State
    current: int
    inertia: ptr                   // float[count * INERTIA_FLOATS]
    blend_t: float
    eased_from: float              // the largest joint offset the last transition eased out of, radians
    eased_need: float              // the fastest its easing turns a joint, radians a second
    blend_time: float
    layers: ptr                    // list of *Layer
    takes: ptr                     // list of *Take this animator loaded and frees
    root_motion: bool
    moved: Vec3                    // last frame's root motion on the object: world x, z and the turn about up
    ground_speed: float            // the current state's ground speed now, metres a second
    feet: ptr                      // *Feet (ikrig), or null
    hands: ptr                     // *Hands (ikrig), or null
    look: ptr                      // *Look (ikrig), or null
    // The face (#910, face_on): procedural blinks laid over the curves of
    // the eyes' blink shapes, and saccades the look turns the eyes by;
    // null with no face.
    blinker: ptr                   // *Blinker (ae3d.face)
    saccades: ptr                  // *Saccades (ae3d.face)
    blink_left: int                // the rig's eyeBlinkLeft curve, -1 for none
    blink_right: int
    // A line being spoken (speak): its visemes (*Track, ae3d.visemes,
    // borrowed), seconds into it, and how much each viseme drives each of
    // the rig's curves (float[curves * VISEMES]).
    speech: ptr
    speech_t: float
    speech_drive: ptr
    aim: ptr                       // *Aim (ikrig), or null
    body: ptr                      // *Body (ikrig), or null
    dt_before: float
    evaluated: bool
    stepper: ptr                   // the behaviour
    paused: bool                   // handed to another writer (pause): nothing written
    drawn: bool                    // a pose read back from the figure while paused
    fired_takes: ptr               // ptr[]: the take of each event fired this frame
    fired_at: ptr                  // int[]: and its index in the take
    fired_count: int
    fired_room: int
    params: ptr                    // list of *Param: the graph's named parameters
    transitions: ptr               // list of *Transition, tried in order each frame
    fade_from: int                 // the state cross-faded from, -1 none
    down_from: ptr                 // float[2]: each foot's contact weight as a transition began (contact_weight)
    plant_from: ptr                // float[2]: and its plant weight
    down_drawn: ptr                // float[2]: each foot's contact weight as the feet were last given it
    plant_drawn: ptr               // float[2]: and its plant weight
    ease_feet: bool                // the transition under way is a state's (play): the feet's contacts ease through it
    fade_t: float
    fade_time: float
    work3: ptr                     // the faded-from state's pose
    blend_work: ptr                // a blend's scratch as it samples its takes (sample_state), its own:
                                   // a transition samples its target into work and work2
    aims: ptr                      // list of *Aim: aim offsets, after the layers
    // Motion warping (warp): a state's root motion bent so a part of the
    // figure lands on a point, facing a way, at a time in it.
    warp_state: int                // the state warped, -1 none
    warp_until: float              // its time the part lands at
    warp_root: Vec3                // where the object stands then (the world's, level)
    warp_yaw: float                // and the way it faces, radians about up from +z
    lift: float                    // the pelvis raised (or, below 0, lowered) now, metres
    lift_from: float               // as it was when the lift began easing
    lift_goal: float               // and where it eases to
    lift_t: float                  // seconds into the easing
    lift_time: float               // its length
    // Steps after the graph (add_post): the pose drawn made from the graph's
    // -- physical animation, ae3d.physanim -- without being the pose the
    // graph goes on from.
    posts: ptr                     // list of *Post
    shown: ptr                     // the pose a step after the graph drew (show)
    showing: bool                  // shown is this frame's
    fixed: bool                    // its graph evaluated before the step's physics (set_fixed), not after it
    // The graph advances by the fixed steps (#985) and is drawn between the
    // poses of the last two, by the frame's share of the next.
    stepping: bool                 // evaluated by a step now: its posts wait for the pose phase
    step_now: ptr                  // the pose the last step drew (pose_shown after it)
    step_before: ptr               // and the one before it
    steps_drawn: int               // steps it has drawn, up to 2: both above are a step's
    frame_shown: ptr               // the pose shown this frame, between those two
    framed: bool                   // frame_shown is this frame's
    // Update-rate LOD (set_every): the graph evaluated one frame in `every`,
    // ahead of the frame, and the frames between drawn between its last two
    // evaluations.
    every: int                     // frames an evaluation serves, 1 every frame
    lod_phase: int                 // frames the first evaluation at a new rate serves instead, 0 none
    ahead: float                   // seconds the pose evaluated last (out) is ahead of the frame
    span: float                    // and ahead of the one before it (before)
    lod_moved: Vec3                // the last evaluation's root motion a second, spread over the frames it serves
    lod_at: Vec3                   // where the object stood at the last evaluation
    lod_yaw: float                 // and the way it faced, radians about up from +z
    lod_turned: Quat               // its rotation then
    lod_elapsed: float             // seconds since
    lod_known: bool                // lod_at and lod_yaw are an evaluation's at this rate
    cost: float                    // seconds an evaluation of the graph takes, averaged
    shaper: ptr                    // *Shaper: a change drawn by its owner in place of the inertialization (play_shaped), or null
    // Evaluated with its step group's other animators on the engine's job
    // pool (evaluate_step_all) this step: what its own turn has left to do.
    batched: bool
    batch_kind: int                // what evaluate_write has left to write
    // Secondary motion (#989, springs_of): spring chains and jiggle solved
    // after the IK; null with none.
    springs: ptr                   // *Springs (ae3d.springs)
}

// A step after the graph, and what it steps with (add_post).
struct Post {
    run: fn(ptr, *Animator)
    state: ptr
}

// A change into a state drawn by its owner (play_shaped): `run(state, a,
// out, t)` given the state's pose at `t` seconds into it, `time` long.
struct Shaper {
    run: fn(ptr, *Animator, ptr, float)
    state: ptr
    t: float
    time: float
}

// A named parameter of the graph: a number, a switch (0 or 1), or a trigger
// (1 until a transition takes it).
struct Param {
    name: string
    value: float
    trigger: bool
}

// A change of state the graph makes by itself when all its conditions hold.
struct Transition {
    from: int                      // the state it leaves, ANY for any
    to: int
    seconds: float
    crossfade: bool                // the two states' poses blended; inertialized otherwise
    synced: bool                   // entered at the stride phase the current state is at (play_synced)
    window: float                  // seconds either side of its nominal entry it searches (transition_match), 0 none
    others: ptr                    // int[]: states it may go to instead, the one whose feet match best (transition_or)
    other_count: int
    conditions: ptr                // list of *Condition
}

struct Condition {
    param: int                     // the parameter tested, -1 for ENDED
    test: int                      // ABOVE, BELOW, IS, IS_NOT, TRIGGERED, ENDED
    value: float
}

// An aim offset (Unreal's): poses that aim a figure up, down and to the sides,
// each at its yaw and pitch, blended at the aim asked by gradient bands and
// added over the joints under one, as their difference from the neutral one.
// A matcher's database and where it is playing.
struct Matcher {
    features: ptr                  // float[frames * MATCH_DIM]
    owner: ptr                     // int[frames]: each frame's take
    at: ptr                        // int[frames]: and its frame in it
    frames: int
    mean: ptr                      // float[MATCH_DIM]
    spread: ptr                    // float[MATCH_DIM]
    query: ptr                     // float[MATCH_TRAJ]: the way ahead asked
    norm: ptr                      // float[frames * MATCH_DIM]: the features over their spreads, weighted
    small: ptr                     // float[]: each MATCH_SMALL frames' box in `norm` (least, most)
    large: ptr                     // and each MATCH_LARGE frames'
    asked: ptr                     // float[MATCH_DIM]: a search's query, as `norm` has it
    playing: int                   // the take playing
    since: float                   // seconds since its last search
    searches: int
    changes: int
}

struct Aim {
    mask: ptr                      // float[count]
    poses: ptr                     // list of poses (ptr): each sample's
    yaws: ptr                      // float[]
    pitches: ptr                   // float[]
    count: int
    room: int
    reference: ptr                 // the pose the samples are differences from
    yaw: float
    pitch: float
    weight: float
}

// --- making -------------------------------------------------------------------------------------

// An animator for the figure on `o`, stepped by the engine in its pose phase.
// Null when `o` wears no figure, or its figure no skin.
attach(e: *Engine, o: *GameObject) -> *Animator {
    f = figure.figure_of(o)
    if f == null { return null }
    rig = pose.of_skeleton(figure.skeleton(f))
    if rig == null { return null }
    // A figure made in parts (a skin a body part, all on these joints) has
    // its flesh in every skin: the feet measure theirs from it.
    k = 1
    while k < figure.skeleton_count(f) {
        pose.add_skin(rig, figure.skeleton_at(f, k))
        k = k + 1
    }
    // Its faces' morph targets as curves (#910), before any pose is made:
    // a take's weights channels play them, blends and transitions carry
    // them, and the face's blinks go over them (face_on). Each node's
    // weights once, however many primitives draw by them.
    scene = figure.scene(f)
    if scene != null {
        k = 0
        while k < gltf.primitive_count(scene) {
            part = gltf.primitive(scene, k)
            if core.model_morph(part) != null && !curves_driving(rig, part) { pose.add_morph_curves(rig, part) }
            k = k + 1
        }
    }
    figure.stop(f)
    a = heap.new(Animator)
    a.rig = rig as ptr
    a.object = o as ptr
    a.engine = e as ptr
    a.out = pose.new(rig)
    a.before = pose.new(rig)
    a.graph_out = pose.new(rig)
    a.graph_before = pose.new(rig)
    a.work = pose.new(rig)
    a.work2 = pose.new(rig)
    a.worlds = pose.new(rig)
    a.states = list.new()
    a.layers = list.new()
    a.takes = list.new()
    a.current = 0 - 1
    // A joint's offsets, then a quintic a curve (#910).
    a.inertia = calloc(pose.count(rig) * INERTIA_FLOATS + pose.curve_count(rig) * QUINTIC + 1, 8)
    a.dt_before = 1.0 / 60.0
    a.fired_room = 16
    a.fired_takes = calloc(a.fired_room, 8)
    a.fired_at = calloc(a.fired_room, 4)
    a.params = list.new()
    a.transitions = list.new()
    a.aims = list.new()
    a.fade_from = 0 - 1
    a.warp_state = 0 - 1
    a.down_from = calloc(2, 8)
    a.plant_from = calloc(2, 8)
    a.down_drawn = calloc(2, 8)
    a.plant_drawn = calloc(2, 8)
    // A figure starts standing, both feet down.
    (a.down_drawn as float[])[0] = 1.0
    (a.down_drawn as float[])[1] = 1.0
    (a.plant_drawn as float[])[0] = 1.0
    (a.plant_drawn as float[])[1] = 1.0
    a.work3 = pose.new(rig)
    a.blend_work = pose.new(rig)
    a.posts = list.new()
    a.shown = pose.new(rig)
    a.every = 1
    a.step_now = pose.new(rig)
    a.step_before = pose.new(rig)
    a.frame_shown = pose.new(rig)
    // Its graph a step on at each fixed step, after the step's physics: posed
    // where the step left its capsule and the ground under its feet, as the
    // pose phase posed it on a fixed tick. Its posts in the pose phase.
    b = engine.behaviour_new("Animator", a as ptr)
    b.fixed_update = animator_fixed
    b.fixed_group = engine.FIXED_POSE
    b.pose = animator_pose
    engine.engine_add_behaviour(e, b)
    a.stepper = b as ptr
    if g_animators == null { g_animators = list.new() }
    list.add_raw(g_animators, a as ptr)
    return a
}

animator_free(a: *Animator) {
    if a == null { return }
    if g_animators != null {
        k = list.size(g_animators) - 1
        while k >= 0 {
            if list.get_raw(g_animators, k) == a as ptr { list.remove(g_animators, k) }
            k = k - 1
        }
    }
    // Out of the engine's loop first: freed while the engine ran, the pose
    // phase went on calling it on freed memory (Siltreach, 2026-11-01).
    if a.stepper != null {
        engine.engine_remove_behaviour(a.engine as *Engine, a.stepper as *Behaviour)
        heap.free(a.stepper as *Behaviour)
        a.stepper = null
    }
    i = 0
    while i < list.size(a.states) {
        s = list.get_raw(a.states, i) as *State
        list.free(s.takes)
        free(s.values)
        free(s.values2)
        free(s.weights)
        pose.release(s.held)
        if s.matcher != null { matcher_free(s.matcher as *Matcher) }
        string.free(s.name)
        heap.free(s)
        i = i + 1
    }
    list.free(a.states)
    i = 0
    while i < list.size(a.layers) {
        l = list.get_raw(a.layers, i) as *Layer
        pose.mask_free(l.mask)
        pose.release(l.base)
        heap.free(l)
        i = i + 1
    }
    list.free(a.layers)
    i = 0
    while i < list.size(a.takes) {
        clips.take_free(list.get_raw(a.takes, i) as *Take)
        i = i + 1
    }
    list.free(a.takes)
    if a.feet != null { ikrig.feet_free(a.feet as *Feet) }
    if a.shaper != null { heap.free(a.shaper as *Shaper) }
    if a.hands != null { ikrig.hands_free(a.hands as *Hands) }
    if a.look != null { ikrig.look_free(a.look as *Look) }
    face_off(a)
    speak_off(a)
    if a.aim != null { ikrig.aim_free(a.aim as *ikrig.Aim) }
    if a.body != null { ikrig.body_free(a.body as *Body) }
    if a.springs != null { springs.springs_free(a.springs as *Springs) }
    pose.release(a.out)
    pose.release(a.before)
    pose.release(a.graph_out)
    pose.release(a.graph_before)
    if a.unheld != null { pose.release(a.unheld) }
    pose.release(a.work)
    pose.release(a.work2)
    pose.release(a.worlds)
    pose.release(a.shown)
    pose.release(a.step_now)
    pose.release(a.step_before)
    pose.release(a.frame_shown)
    i = 0
    while i < list.size(a.posts) {
        heap.free(list.get_raw(a.posts, i) as *Post)
        i = i + 1
    }
    list.free(a.posts)
    free(a.inertia)
    free(a.fired_takes)
    free(a.fired_at)
    free(a.down_from)
    free(a.plant_from)
    free(a.down_drawn)
    free(a.plant_drawn)
    free_graph(a)
    pose.rig_free(a.rig as *pose.Rig)
    heap.free(a)
}

rig(a: *Animator) -> *pose.Rig { return a.rig as *pose.Rig }
figure_object(a: *Animator) -> *GameObject { return a.object as *GameObject }

// The figure's animation `animation` as a take for this animator's rig,
// loaded once and freed with the animator; null when the figure's file has
// none by that name. With root motion taken out when `root` (the figure is
// moved by it, or it plays in place).
take(a: *Animator, animation: string, root: bool) -> *Take {
    i = 0
    while i < list.size(a.takes) {
        t = list.get_raw(a.takes, i) as *Take
        if string.equals(clips.name(t), animation) == 1 { return t }
        i = i + 1
    }
    f = figure.figure_of(a.object as *GameObject)
    r = a.rig as *pose.Rig
    t = clips.from_scene(r, figure.scene(f), animation, 0.0)
    if t == null { return null }
    if root { clips.extract_root(t, r, clips.up_of(r)) }
    list.add_raw(a.takes, t as ptr)
    return t
}

// A take made elsewhere for this animator's rig (a retarget, a capture),
// given to it: freed with the animator. Root motion taken out when `root`.
add_take(a: *Animator, t: *Take, root: bool) -> *Take {
    if t == null { return null }
    r = a.rig as *pose.Rig
    if root && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
    list.add_raw(a.takes, t as ptr)
    return t
}

// A state playing `t`, looping or not. Its index.
add_state(a: *Animator, title: string, t: *Take, loop: bool) -> int {
    s = new_state(title, STATE_TAKE)
    s.loop = loop
    add_to_state(s, t, 0.0)
    list.add_raw(a.states, s as ptr)
    return list.size(a.states) - 1
}

// A blend space along one parameter: takes added with blend_add, each at a
// value of the parameter (a gait at its speed). It loops, its takes in step.
add_blend(a: *Animator, title: string) -> int {
    s = new_state(title, STATE_BLEND)
    s.loop = true
    list.add_raw(a.states, s as ptr)
    return list.size(a.states) - 1
}

// A blend space over the ground's two directions: takes added with
// blend_add2, each at its velocity relative to the figure's facing (x
// across to its left, z ahead), the figure's own velocity its parameter
// (set_velocity). Weights by polar gradient band interpolation (Johansen
// 2009, Unity's freeform directional blend): a direction between two
// samples of one speed blends them at that speed, where weights linear in
// x and z would slow it down. Its takes play in step by their footfalls,
// paced so their blended velocity carries the ground at the speed asked.
add_blend2(a: *Animator, title: string) -> int {
    s = new_state(title, STATE_BLEND2)
    s.loop = true
    list.add_raw(a.states, s as ptr)
    return list.size(a.states) - 1
}

blend_add2(a: *Animator, state: int, t: *Take, x: float, z: float) {
    s = state_at(a, state)
    if s == null || t == null || s.kind != STATE_BLEND2 { return }
    make_room(s)
    (s.values as float[])[s.count] = x
    (s.values2 as float[])[s.count] = z
    list.add_raw(s.takes, t as ptr)
    s.count = s.count + 1
}

// Take `k`'s weight in blend `state` at its parameter now (in the order
// they were added; a 1D blend's in order of value).
blend_weight(a: *Animator, state: int, k: int) -> float {
    s = state_at(a, state)
    if s == null || k < 0 || k >= s.count || s.kind == STATE_TAKE { return 0.0 }
    blend_weights(s)
    return (s.weights as float[])[k]
}

// The figure's velocity a 2D blend space plays at: x across to its left,
// z ahead, metres a second.
set_velocity(a: *Animator, state: int, x: float, z: float) {
    s = state_at(a, state)
    if s == null { return }
    s.param = x
    s.param2 = z
}

blend_add(a: *Animator, state: int, t: *Take, value: float) {
    s = state_at(a, state)
    if s == null || t == null { return }
    add_to_state(s, t, value)
}

new_state(title: string, kind: int) -> *State {
    s = heap.new(State)
    s.name = string.copy(title)
    s.kind = kind
    s.takes = list.new()
    s.room = 8
    s.values = calloc(s.room, 8)
    s.values2 = calloc(s.room, 8)
    s.weights = calloc(s.room, 8)
    s.rate = 1.0
    s.bind = 0 - 1
    s.bind2 = 0 - 1
    s.clock = 0 - 1
    s.pace = 1.0
    s.entry_at = 0.0 - 1.0
    return s
}

// Room for one more take in `s`.
make_room(s: *State) {
    if s.count < s.room { return }
    bigger = s.room * 2
    values = calloc(bigger, 8) as float[]
    values2 = calloc(bigger, 8) as float[]
    weights = calloc(bigger, 8) as float[]
    old_v = s.values as float[]
    old_v2 = s.values2 as float[]
    k = 0
    while k < s.count {
        values[k] = old_v[k]
        values2[k] = old_v2[k]
        k = k + 1
    }
    free(s.values)
    free(s.values2)
    free(s.weights)
    s.values = values as ptr
    s.values2 = values2 as ptr
    s.weights = weights as ptr
    s.room = bigger
}

add_to_state(s: *State, t: *Take, value: float) {
    make_room(s)
    // Kept in order of value.
    v = s.values as float[]
    at = s.count
    while at > 0 && v[at - 1] > value {
        v[at] = v[at - 1]
        at = at - 1
    }
    v[at] = value
    list.add_raw(s.takes, t as ptr)
    k = s.count
    while k > at {
        list.set(s.takes, k, list.get_raw(s.takes, k - 1))
        k = k - 1
    }
    list.set(s.takes, at, t as ptr)
    s.count = s.count + 1
}

state_at(a: *Animator, state: int) -> *State {
    if state < 0 || state >= list.size(a.states) { return null }
    return list.get_raw(a.states, state) as *State
}

find_state(a: *Animator, title: string) -> int {
    i = 0
    while i < list.size(a.states) {
        if string.equals((list.get_raw(a.states, i) as *State).name, title) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

current(a: *Animator) -> int { return a.current }

// State `state`'s take (a take's, a matcher's playing one), or null.
state_take(a: *Animator, state: int) -> *Take {
    s = state_at(a, state)
    if s == null || s.count == 0 { return null }
    if s.kind == STATE_MATCH { return matched_take(s) }
    return list.get_raw(s.takes, 0) as *Take
}

// How many states the graph has.
state_count(a: *Animator) -> int { return list.size(a.states) }

// How many takes state `state` plays, and its `k`th: a take's own, each of
// a blend's, each of a matcher's captures (null past them). What a figure's
// own motion is judged by: metrics.animator_fastest reads every one. Only
// the take a state played was listed, and a blend's others were missed (a
// cycle's pop reference read the stand's and the first gait's, 14.66 rad/s).
state_take_count(a: *Animator, state: int) -> int {
    s = state_at(a, state)
    if s == null { return 0 }
    return s.count
}

state_take_at(a: *Animator, state: int, k: int) -> *Take {
    s = state_at(a, state)
    if s == null || k < 0 || k >= s.count { return null }
    return list.get_raw(s.takes, k) as *Take
}

// The take the current state plays: its own, or a blend's heaviest now;
// null when nothing plays.
current_take(a: *Animator) -> *Take {
    s = state_at(a, a.current)
    if s == null || s.count == 0 { return null }
    if s.kind == STATE_MATCH { return matched_take(s) }
    if s.kind == STATE_TAKE { return list.get_raw(s.takes, 0) as *Take }
    w = s.weights as float[]
    heaviest = 0
    k = 1
    while k < s.count {
        if w[k] > w[heaviest] { heaviest = k }
        k = k + 1
    }
    return list.get_raw(s.takes, heaviest) as *Take
}

state_name(a: *Animator, state: int) -> string {
    s = state_at(a, state)
    if s == null { return "" }
    return s.name
}

state_time(a: *Animator) -> float {
    s = state_at(a, a.current)
    if s == null { return 0.0 }
    return s.time
}

set_param(a: *Animator, state: int, value: float) {
    s = state_at(a, state)
    if s != null { s.param = value }
}

param(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    return s.param
}

set_rate(a: *Animator, state: int, r: float) {
    s = state_at(a, state)
    if s != null { s.rate = r }
}

rate(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    return s.rate
}

// The figure is moved by its states' root motion (on) or plays them in place.
set_root_motion(a: *Animator, on: bool) { a.root_motion = on }

// Last frame's root motion put on the object: x and z over the ground in the
// world, and its turn about up in z.
root_moved(a: *Animator) -> Vec3 { return a.moved }

// The current state's speed over the ground as it plays now.
ground_speed(a: *Animator) -> float { return a.ground_speed }

transitioning(a: *Animator) -> bool { return a.blend_t < a.blend_time }

// The largest joint offset, radians, the last transition eased out of (play
// inertializes from what was drawn). A transition's own pop is judged
// against it (#906, #937).
transition_offset(a: *Animator) -> float { return a.eased_from }

// The fastest the last transition's easing turns any joint, radians a
// second: its quintics' steepest, over their own seconds. Eased from rest,
// Bollo's quintic (its first acceleration -20 x0 / t1^2) peaks at 135/64
// of the offset over its seconds, a quarter of the way in, not the 1.875 of
// one that starts from rest unaccelerated; one eased from the speed the
// pose drawn had keeps that speed at its start and may end sooner
// (quintic). A change is no faster than its takes' own plus this.
transition_need(a: *Animator) -> float { return a.eased_need }

// The seconds the last transition eases over (0: a cut).
transition_seconds(a: *Animator) -> float { return a.blend_time }

// --- playing ------------------------------------------------------------------------------------

// Play `state` from its start, inertialized over `seconds` from what is
// drawn now (0: a cut).
play(a: *Animator, state: int, seconds: float) { play_at(a, state, 0.0, seconds) }

// As play, entered `at` seconds in (a blend: at that phase, 0 to 1).
play_at(a: *Animator, state: int, at: float, seconds: float) {
    s = state_at(a, state)
    if s == null { return }
    s.time = at
    if !s.chosen { s.offset = 0.0 }
    if s.kind == STATE_TAKE && s.clock >= 0 { s.time = distance_time(a, s) }
    if s.chosen && s.entry_at >= 0.0 { s.time = s.entry_at }
    s.entry_at = 0.0 - 1.0
    s.chosen = false
    s.entered = true
    // Any change ends a shaped one (play_shaped).
    if a.shaper != null { (a.shaper as *Shaper).time = 0.0 }
    was = a.current
    a.current = state
    if was < 0 || seconds <= 0.0 || !a.evaluated {
        a.blend_t = 0.0
        a.blend_time = 0.0
        return
    }
    // Where the new state starts, against what was drawn the last two frames.
    sample_state(a, s, a.work)
    sample_ahead(a, s, a.work2)
    inertialize(a, a.graph_out, a.graph_before, a.work, a.work2, seconds)
    // A state's transition: the feet ease out of their contacts as drawn.
    a.ease_feet = true
}

// Play `state` from its start, the change into it drawn over `seconds` by
// `run(st, a, out, t)` in place of the inertialization: given the state's
// own pose `t` seconds in, before the layers, the aims and the IK, it
// writes the pose drawn (a get-up planned from a pose snapshot,
// ae3d.character's get_up, where easing each joint's offset out swept a
// body's limbs through the floor). Another change ends it.
play_shaped(a: *Animator, state: int, seconds: float, run: fn(ptr, *Animator, ptr, float), st: @keep ptr) {
    if a == null { return }
    play(a, state, 0.0)
    if run == null || seconds <= 0.0 { return }
    if a.shaper == null { a.shaper = heap.new(Shaper) as ptr }
    sh = a.shaper as *Shaper
    sh.run = run
    sh.state = st
    sh.t = 0.0
    sh.time = seconds
}

// The shaped change under way (play_shaped) drawn into `out`, `dt` on.
shape(a: *Animator, out: ptr, dt: float) {
    if a.shaper == null { return }
    sh = a.shaper as *Shaper
    if sh.t >= sh.time { return }
    sh.t = sh.t + dt
    if sh.t < sh.time { sh.run(sh.state, a, out, sh.t) }
}

// Whether a shaped change is under way (play_shaped).
shaping(a: *Animator) -> bool {
    if a == null || a.shaper == null { return false }
    sh = a.shaper as *Shaper
    return sh.t < sh.time
}

// State `s` as it will be a frame on (at the last frame's step), into `out`:
// the target's own speed, for inertialize.
sample_ahead(a: *Animator, s: *State, out: ptr) {
    keep = s.time
    s.time = s.time + a.dt_before
    if s.kind == STATE_BLEND || s.kind == STATE_BLEND2 {
        // A blend's time is its phase: a frame on is the frame's share of
        // its cycle at its pace, as advance carries it (a frame's seconds
        // added to the phase were right only for a cycle a second long,
        // played at its own pace).
        blend_weights(s)
        cycle = blend_cycle(s)
        s.time = keep
        if cycle > 0.0 {
            s.time = keep + a.dt_before * blend_pace(s, cycle) * s.rate / cycle
            s.time = s.time - floor_of(s.time)
        }
    }
    sample_state(a, s, out)
    s.time = keep
}

// The current state's stride phase, 0 to 1 from its left foot's first
// touchdown: a blend's own, a take's from its clock.
phase(a: *Animator) -> float {
    s = state_at(a, a.current)
    if s == null { return 0.0 }
    if s.kind == STATE_POSE { return 0.0 }
    if s.kind == STATE_MATCH { return clips.phase_of(matched_take(s), s.time) }
    if s.kind != STATE_TAKE { return s.time }
    return clips.phase_of(list.get_raw(s.takes, 0) as *Take, s.time)
}

// Play `state` in step with the stride now: entered at the phase the
// current state is at, so a gait hands over to another with its feet where
// they were in the cycle. Entered at its first frame, a jog handed to the
// sprint mid-stride swung a shin 39 rad/s against the sprint's own 35.5.
play_synced(a: *Animator, state: int, seconds: float) {
    s = state_at(a, state)
    if s == null { return }
    at = phase(a)
    if s.kind == STATE_TAKE { at = take_time_at(list.get_raw(s.takes, 0) as *Take, at) }
    play_at(a, state, at, seconds)
}

// Each joint's offset from `target` to the pose drawn now, and the speed it
// was changing at, as quintics (Bollo's, Gears of War). The speed is the
// offset's own: the pose drawn's (from the frame before) less the
// target's (from `ahead`, the target a frame on), so the pose drawn keeps
// the speed it had and eases into the target's. Taken against a target
// held still, a change started at the target's speed and the old pose's
// together: motion matching's changes turned joints at 25.7 rad/s
// against its takes' own 17.6 (#906).
inertialize(a: *Animator, now: ptr, before: ptr, target: ptr, ahead: ptr, seconds: float) {
    r = a.rig as *pose.Rig
    inertia = a.inertia as float[]
    dt = a.dt_before
    if dt <= 0.0 { dt = 1.0 / 60.0 }
    a.eased_from = 0.0
    a.eased_need = 0.0
    a.ease_feet = false
    // The feet's contacts as last drawn, eased into the new state's through
    // this transition (#966), whatever began it: taken in play alone, a
    // matcher's change eased from a stale weight, a foot in the air read as
    // down, and its lock pulled it to the floor (a thigh at 34.7 rad/s, #935).
    k = 0
    while k < 2 {
        (a.down_from as float[])[k] = (a.down_drawn as float[])[k]
        (a.plant_from as float[])[k] = (a.plant_drawn as float[])[k]
        k = k + 1
    }
    j = 0
    while j < pose.count(r) {
        off = j * INERTIA_FLOATS
        new_q = pose.rotation(target, j)
        q = core.quat_normalize(core.quat_mul(pose.rotation(now, j), core.quat_conjugate(new_q)))
        if q.w < 0.0 { q = core.quat(0.0 - q.x, 0.0 - q.y, 0.0 - q.z, 0.0 - q.w) }
        half_sin = core.sqrt_of(q.x * q.x + q.y * q.y + q.z * q.z)
        angle = 2.0 * core.atan2_of(half_sin, q.w)
        if angle > a.eased_from { a.eased_from = angle }
        axis = core.vec3(0.0, 1.0, 0.0)
        if half_sin > 0.0000001 { axis = core.vec3(q.x / half_sin, q.y / half_sin, q.z / half_sin) }
        // The target a frame back, from its step a frame on: the offset then.
        back = core.quat_normalize(core.quat_mul(pose.rotation(ahead, j), core.quat_conjugate(new_q)))
        then_q = core.quat_normalize(core.quat_mul(core.quat_conjugate(back), new_q))
        qb = core.quat_normalize(core.quat_mul(pose.rotation(before, j), core.quat_conjugate(then_q)))
        if qb.w < 0.0 { qb = core.quat(0.0 - qb.x, 0.0 - qb.y, 0.0 - qb.z, 0.0 - qb.w) }
        angle_before = 2.0 * core.atan2_of(qb.x * axis.x + qb.y * axis.y + qb.z * axis.z, qb.w)
        inertia[off] = axis.x
        inertia[off + 1] = axis.y
        inertia[off + 2] = axis.z
        quintic(inertia, off + 3, angle, (angle - angle_before) / dt, seconds)
        need = quintic_steepest(inertia, off + 3)
        if need > a.eased_need { a.eased_need = need }
        p = pose.translation(now, j)
        pb = pose.translation(before, j)
        np = pose.translation(target, j)
        na = pose.translation(ahead, j)
        nb = core.v3_sub(core.v3_mul(np, 2.0), na)
        quintic(inertia, off + 3 + QUINTIC, p.x - np.x, ((p.x - np.x) - (pb.x - nb.x)) / dt, seconds)
        quintic(inertia, off + 3 + 2 * QUINTIC, p.y - np.y, ((p.y - np.y) - (pb.y - nb.y)) / dt, seconds)
        quintic(inertia, off + 3 + 3 * QUINTIC, p.z - np.z, ((p.z - np.z) - (pb.z - nb.z)) / dt, seconds)
        j = j + 1
    }
    // The curves (#910) as the translations are: the offset of the number
    // drawn from the target's, and the speed it was changing at, eased out
    // over the same quintic, so a blink or a smile cut into goes on from
    // where the face was rather than jumping.
    c = 0
    while c < pose.curve_count(r) {
        off = pose.count(r) * INERTIA_FLOATS + c * QUINTIC
        x = pose.curve(r, now, c) - pose.curve(r, target, c)
        xb = pose.curve(r, before, c) - (2.0 * pose.curve(r, target, c) - pose.curve(r, ahead, c))
        quintic(inertia, off, x, (x - xb) / dt, seconds)
        c = c + 1
    }
    a.blend_t = 0.0
    a.blend_time = seconds
}

// Bollo's quintic for an offset of x0 changing at v0, to rest at t1: its
// t^5..t^2 coefficients, v0, x0 and t1 into `q` at `at`. An offset growing
// away from rest is taken as still (it would overshoot); one falling fast
// reaches rest no later than its own speed allows (figure's, over poses).
quintic(q: float[], at: int, x0_in: float, v0_in: float, t1_in: float) {
    x0 = x0_in
    v0 = v0_in
    flip = x0 < 0.0
    if flip {
        x0 = 0.0 - x0
        v0 = 0.0 - v0
    }
    if v0 > 0.0 { v0 = 0.0 }
    t1 = t1_in
    if v0 < 0.0 {
        limit = 0.0 - 5.0 * x0 / v0
        if limit < t1 { t1 = limit }
    }
    if t1 <= 0.000001 || x0 <= 0.0 {
        k = 0
        while k < QUINTIC {
            q[at + k] = 0.0
            k = k + 1
        }
        return
    }
    a0 = (0.0 - 8.0 * v0 * t1 - 20.0 * x0) / (t1 * t1)
    t2 = t1 * t1
    t3 = t2 * t1
    t4 = t3 * t1
    t5 = t4 * t1
    sign = 1.0
    if flip { sign = 0.0 - 1.0 }
    q[at] = sign * (0.0 - (a0 * t2 + 6.0 * v0 * t1 + 12.0 * x0) / (2.0 * t5))
    q[at + 1] = sign * ((3.0 * a0 * t2 + 16.0 * v0 * t1 + 30.0 * x0) / (2.0 * t4))
    q[at + 2] = sign * (0.0 - (3.0 * a0 * t2 + 12.0 * v0 * t1 + 20.0 * x0) / (2.0 * t3))
    q[at + 3] = sign * (a0 * 0.5)
    q[at + 4] = sign * v0
    q[at + 5] = sign * x0
    q[at + 6] = t1
}

// Samples quintic_steepest reads a quintic's speed at over its seconds.
const STEEPEST_SAMPLES = 256

// The fastest quintic `q` at `at` changes over its seconds, its start and
// end among them: |x'(t)|, x' = 5A t^4 + 4B t^3 + 3C t^2 + 2D t + v0.
quintic_steepest(q: float[], at: int) -> float {
    t1 = q[at + 6]
    if t1 <= 0.0 { return 0.0 }
    most = 0.0
    k = 0
    while k <= STEEPEST_SAMPLES {
        t = t1 * (k as float) / (STEEPEST_SAMPLES as float)
        v = core.abs_of((((5.0 * q[at] * t + 4.0 * q[at + 1]) * t + 3.0 * q[at + 2]) * t + 2.0 * q[at + 3]) * t + q[at + 4])
        if v > most { most = v }
        k = k + 1
    }
    return most
}

quintic_at(q: float[], at: int, t: float) -> float {
    if t >= q[at + 6] { return 0.0 }
    return (((q[at] * t + q[at + 1]) * t + q[at + 2]) * t + q[at + 3]) * t * t + q[at + 4] * t + q[at + 5]
}

// The transition's offsets at `t` laid over `p`, in place.
apply_inertia(a: *Animator, p: ptr, t: float) {
    r = a.rig as *pose.Rig
    inertia = a.inertia as float[]
    j = 0
    while j < pose.count(r) {
        off = j * INERTIA_FLOATS
        angle = quintic_at(inertia, off + 3, t)
        if angle != 0.0 {
            axis = core.vec3(inertia[off], inertia[off + 1], inertia[off + 2])
            pose.set_rotation(p, j, core.quat_normalize(core.quat_mul(core.quat_rotate(angle, axis), pose.rotation(p, j))))
        }
        d = core.vec3(quintic_at(inertia, off + 3 + QUINTIC, t), quintic_at(inertia, off + 3 + 2 * QUINTIC, t),
                      quintic_at(inertia, off + 3 + 3 * QUINTIC, t))
        pose.set_translation(p, j, core.v3_add(pose.translation(p, j), d))
        j = j + 1
    }
    c = 0
    while c < pose.curve_count(r) {
        off = pose.count(r) * INERTIA_FLOATS + c * QUINTIC
        pose.set_curve(r, p, c, pose.curve(r, p, c) + quintic_at(inertia, off, t))
        c = c + 1
    }
}

// --- states -------------------------------------------------------------------------------------

// The blend's weights at its parameter: the two takes around it, linear by
// value; at or past either end, that end alone. A 2D blend's by gradient
// bands (weights_2d).
blend_weights(s: *State) {
    if s.kind == STATE_BLEND2 {
        weights_2d(s)
        return
    }
    w = s.weights as float[]
    v = s.values as float[]
    k = 0
    while k < s.count {
        w[k] = 0.0
        k = k + 1
    }
    if s.count == 0 { return }
    if s.param <= v[0] {
        w[0] = 1.0
        return
    }
    if s.param >= v[s.count - 1] {
        w[s.count - 1] = 1.0
        return
    }
    k = 0
    while k < s.count - 1 && s.param > v[k + 1] { k = k + 1 }
    span = v[k + 1] - v[k]
    u = 1.0
    if span > 0.0000001 { u = (s.param - v[k]) / span }
    w[k] = 1.0 - u
    w[k + 1] = u
}

// A 2D blend's weights at its velocity, by polar gradient band
// interpolation (Johansen, "Automated Semi-Procedural Animation for
// Character Locomotion", 2009): each sample's weight is the least, over
// every other sample, of how far the velocity has not yet gone from it
// toward that one, the way measured in speed relative to the two speeds'
// mean and in the angle between them (TURN_WEIGHT to a radian); a pair with
// a sample standing still is measured in metres a second. A sample is
// alone at its own velocity, and the weights change continuously.
weights_2d(s: *State) {
    w = s.weights as float[]
    xs = s.values as float[]
    zs = s.values2 as float[]
    n = s.count
    if n == 0 { return }
    px = s.param
    pz = s.param2
    pm = core.sqrt_of(px * px + pz * pz)
    total = 0.0
    i = 0
    while i < n {
        mi = core.sqrt_of(xs[i] * xs[i] + zs[i] * zs[i])
        least = 1.0
        j = 0
        while j < n {
            if j != i {
                mj = core.sqrt_of(xs[j] * xs[j] + zs[j] * zs[j])
                ij_a = 0.0
                ij_b = 0.0
                ip_a = 0.0
                ip_b = 0.0
                if mi > 0.000001 && mj > 0.000001 {
                    mean = (mi + mj) * 0.5
                    ij_a = (mj - mi) / mean
                    ij_b = TURN_WEIGHT * turn_between(xs[i], zs[i], xs[j], zs[j])
                    ip_a = (pm - mi) / mean
                    if pm > 0.000001 { ip_b = TURN_WEIGHT * turn_between(xs[i], zs[i], px, pz) }
                } else {
                    ij_a = xs[j] - xs[i]
                    ij_b = zs[j] - zs[i]
                    ip_a = px - xs[i]
                    ip_b = pz - zs[i]
                }
                apart = ij_a * ij_a + ij_b * ij_b
                if apart > 0.0000000001 {
                    h = 1.0 - (ip_a * ij_a + ip_b * ij_b) / apart
                    if h < least { least = h }
                }
            }
            j = j + 1
        }
        if least < 0.0 { least = 0.0 }
        w[i] = least
        total = total + least
        i = i + 1
    }
    if total > 0.0 {
        i = 0
        while i < n {
            w[i] = w[i] / total
            i = i + 1
        }
        return
    }
    // Outside every band (a velocity far past the samples): the nearest alone.
    nearest = 0
    best = 1000000000.0
    i = 0
    while i < n {
        d = (xs[i] - px) * (xs[i] - px) + (zs[i] - pz) * (zs[i] - pz)
        if d < best {
            best = d
            nearest = i
        }
        w[i] = 0.0
        i = i + 1
    }
    w[nearest] = 1.0
}

// The signed angle from direction (ax, az) to (bx, bz), radians.
turn_between(ax: float, az: float, bx: float, bz: float) -> float {
    return core.atan2_of(ax * bz - az * bx, ax * bx + az * bz)
}

// A blend's cycle in seconds, its takes' lengths weighted.
blend_cycle(s: *State) -> float {
    w = s.weights as float[]
    cycle = 0.0
    k = 0
    while k < s.count {
        cycle = cycle + w[k] * clips.duration(list.get_raw(s.takes, k) as *Take)
        k = k + 1
    }
    return cycle
}

// A take's time at the blend's phase: its own phase origin (its left foot's
// first touchdown) carried on by the phase.
take_time_at(t: *Take, phase: float) -> float { return clips.time_at_phase(t, phase) }

// The blend's speed over the ground at its pace now: each take's speed, as
// fast as the blend plays it (its length over the cycle), weighted.
blend_speed(s: *State, cycle: float) -> float {
    if cycle <= 0.0 { return 0.0 }
    w = s.weights as float[]
    if s.kind == STATE_BLEND2 {
        // Its takes' velocities (where they stand in the space), summed: a
        // walk ahead and a walk across go the way between, slower than either.
        xs = s.values as float[]
        zs = s.values2 as float[]
        vx = 0.0
        vz = 0.0
        k = 0
        while k < s.count {
            t = list.get_raw(s.takes, k) as *Take
            share = w[k] * clips.duration(t) / cycle
            vx = vx + share * xs[k]
            vz = vz + share * zs[k]
            k = k + 1
        }
        return core.sqrt_of(vx * vx + vz * vz)
    }
    speed = 0.0
    k = 0
    while k < s.count {
        t = list.get_raw(s.takes, k) as *Take
        speed = speed + w[k] * clips.speed(t) * clips.duration(t) / cycle
        k = k + 1
    }
    return speed
}

// State `s`'s pose now into `out`.
sample_state(a: *Animator, s: *State, out: ptr) {
    r = a.rig as *pose.Rig
    if s.kind == STATE_POSE {
        pose.copy(r, s.held, out)
        return
    }
    if s.kind == STATE_MATCH {
        clips.sample(matched_take(s), r, s.time, clips.looping(matched_take(s)), out)
        return
    }
    if s.kind == STATE_TAKE {
        clips.sample(list.get_raw(s.takes, 0) as *Take, r, s.time, s.loop, out)
        return
    }
    blend_weights(s)
    w = s.weights as float[]
    first = true
    total = 0.0
    k = 0
    while k < s.count {
        if w[k] > 0.0 {
            t = list.get_raw(s.takes, k) as *Take
            if first {
                clips.sample(t, r, take_time_at(t, s.time), true, out)
                total = w[k]
                first = false
            } else {
                // Its own scratch. Sampled into work2, which a transition
                // samples its target a frame on into (sample_ahead), the
                // blend's pose a frame on was its last take's alone, and
                // the easing into the gaits took the gap for a joint's
                // speed: a start's switch into a run eased a forearm from
                // a "speed" of 56 rad/s, the 0.3 s easing cut to 0.09 s,
                // and it turned 58 rad/s against the takes' own 14.7 (#937).
                clips.sample(t, r, take_time_at(t, s.time), true, a.blend_work)
                total = total + w[k]
                pose.blend(r, out, a.blend_work, w[k] / total, out)
            }
        }
        k = k + 1
    }
}

// The current state carried on `dt` seconds: a take's clock, or a blend's
// phase at its pace, bent so its feet carry the ground at the parameter's
// speed. Its root motion over the step, as the take gives it (x, z, turn), or
// nothing.
advance(a: *Animator, s: *State, dt: float) -> Vec3 {
    if s.kind == STATE_POSE {
        s.time = s.time + dt
        a.ground_speed = 0.0
        return core.vec3(0.0, 0.0, 0.0)
    }
    if s.kind == STATE_MATCH {
        t = matched_take(s)
        from = s.time
        s.time = s.time + dt * s.rate
        // A take that loops plays on round; one that does not holds its end.
        looping = clips.looping(t)
        if looping && s.time >= clips.duration(t) { s.time = s.time - clips.duration(t) }
        if !looping && s.time > clips.duration(t) { s.time = clips.duration(t) }
        a.ground_speed = clips.speed(t) * s.rate
        if clips.has_root_motion(t) && a.root_motion { return clips.root_delta(t, from, s.time, looping) }
        return core.vec3(0.0, 0.0, 0.0)
    }
    if s.kind == STATE_TAKE {
        t = list.get_raw(s.takes, 0) as *Take
        from = s.time
        if s.clock >= 0 {
            // Played by distance: never back, and the step's own speed.
            s.time = distance_time(a, s)
            if s.time < from { s.time = from }
            a.ground_speed = 0.0
            if dt > 0.0 && s.time > from {
                d = clips.root_delta(t, from, s.time, false)
                a.ground_speed = core.sqrt_of(d.x * d.x + d.y * d.y) / dt
            }
            if clips.has_root_motion(t) && a.root_motion { return clips.root_delta(t, from, s.time, false) }
            return core.vec3(0.0, 0.0, 0.0)
        }
        s.time = s.time + dt * s.rate
        if !s.loop && s.time > clips.duration(t) { s.time = clips.duration(t) }
        // Played backward (#947): held at its start.
        if !s.loop && s.time < 0.0 { s.time = 0.0 }
        a.ground_speed = clips.speed(t) * s.rate
        if clips.has_root_motion(t) && a.root_motion { return clips.root_delta(t, from, s.time, s.loop) }
        return core.vec3(0.0, 0.0, 0.0)
    }
    blend_weights(s)
    cycle = blend_cycle(s)
    if cycle <= 0.0 { return core.vec3(0.0, 0.0, 0.0) }
    natural = blend_speed(s, cycle)
    pace = blend_pace(s, cycle)
    s.pace = pace
    a.ground_speed = natural * pace * s.rate
    from = s.time
    s.time = s.time + dt * pace * s.rate / cycle
    s.time = s.time - floor_of(s.time)
    if !a.root_motion { return core.vec3(0.0, 0.0, 0.0) }
    // Its takes' root motion over the step, weighted.
    w = s.weights as float[]
    moved = core.vec3(0.0, 0.0, 0.0)
    k = 0
    while k < s.count {
        t = list.get_raw(s.takes, k) as *Take
        if w[k] > 0.0 && clips.has_root_motion(t) {
            d = clips.root_delta(t, take_time_at(t, from), take_time_at(t, s.time), true)
            moved = core.v3_add(moved, core.v3_mul(d, w[k]))
        }
        k = k + 1
    }
    return moved
}

// The pace blend `s` (its weights set) plays its cycle of `cycle` seconds
// at: its parameter's speed over its own, within PACE_LEAST and PACE_MOST.
blend_pace(s: *State, cycle: float) -> float {
    natural = blend_speed(s, cycle)
    asked = s.param
    if s.kind == STATE_BLEND2 { asked = core.sqrt_of(s.param * s.param + s.param2 * s.param2) }
    pace = 1.0
    if natural > 0.0001 && asked > 0.0 {
        pace = asked / natural
        if pace < PACE_LEAST { pace = PACE_LEAST }
        if pace > PACE_MOST { pace = PACE_MOST }
    }
    return pace
}

floor_of(x: float) -> float {
    i = x as int
    f = i as float
    if f > x { f = f - 1.0 }
    return f
}

// How far foot `side` is down now, 0 to 1: the current state's contacts,
// its takes weighted, and through a transition what was drawn going into
// it, eased into them as the pose is (#966). What foot placement locks a
// foot by. Read off the new state alone, a foot the stand held down was let
// go on a transition's first frame, and the transition carried it across
// the floor: an act from a walk's stand skated a toe 117 mm.
contact_weight(a: *Animator, side: int) -> float { return through_transition(a, side, false) }

// How planted foot `side` is now, 0 to 1 (flat, or on its ball for a gait
// run on it), as contact_weight eases it through a transition.
plant_weight(a: *Animator, side: int) -> float { return through_transition(a, side, true) }

through_transition(a: *Animator, side: int, plant: bool) -> float {
    s = state_at(a, a.current)
    if s == null { return 1.0 }
    now = state_down(a, s, side, plant)
    if a.fade_from >= 0 && a.fade_time > 0.0 {
        old = state_at(a, a.fade_from)
        if old != null {
            u = core.clampf(a.fade_t / a.fade_time, 0.0, 1.0)
            w = u * u * (3.0 - 2.0 * u)
            return state_down(a, old, side, plant) * (1.0 - w) + now * w
        }
    }
    // Only through a state's transition (play), not a matcher's change: its
    // frames are re-picked every few tenths of a second, and eased there a
    // foot stayed locked as the frame picked lifted it, its leg turning
    // 32.2 rad/s (#906's check, 14.1 with its frames' own contacts).
    if a.ease_feet && a.blend_t < a.blend_time {
        u = core.clampf(a.blend_t / a.blend_time, 0.0, 1.0)
        w = u * u * (3.0 - 2.0 * u)
        from = a.down_from
        if plant { from = a.plant_from }
        return (from as float[])[side] * (1.0 - w) + now * w
    }
    return now
}

// What `s` alone has foot `side` down by (or planted by, `plant`), its takes
// weighted.
state_down(a: *Animator, s: *State, side: int, plant: bool) -> float {
    if s.kind == STATE_POSE { return 0.0 }
    if s.kind == STATE_MATCH { return down_in(matched_take(s), side, s.time, clips.looping(matched_take(s)), plant) }
    if s.kind == STATE_TAKE { return down_in(list.get_raw(s.takes, 0) as *Take, side, s.time, s.loop, plant) }
    w = s.weights as float[]
    down = 0.0
    k = 0
    while k < s.count {
        if w[k] > 0.0 {
            t = list.get_raw(s.takes, k) as *Take
            down = down + down_in(t, side, take_time_at(t, s.time), true, plant) * w[k]
        }
        k = k + 1
    }
    return down
}

down_in(t: *Take, side: int, at: float, loop: bool, plant: bool) -> float {
    if plant {
        if clips.planted(t, side, at, loop) { return 1.0 }
        return 0.0
    }
    if clips.contact(t, side, at, loop) { return 1.0 }
    return 0.0
}

// --- layers -------------------------------------------------------------------------------------

// A layer playing `t` over the joints under `from` (a mask; -1: the whole
// figure), blended over the state, or added to it as its difference from its
// first frame. It starts at weight 0. Its index.
add_layer(a: *Animator, t: *Take, from: int, additive: bool, loop: bool) -> int {
    r = a.rig as *pose.Rig
    l = heap.new(Layer)
    l.take = t as ptr
    top = from
    if top < 0 { top = pose.order(r, 0) }
    l.mask = pose.mask(r, top, 1.0)
    if from < 0 {
        m = l.mask as float[]
        j = 0
        while j < pose.count(r) {
            m[j] = 1.0
            j = j + 1
        }
    }
    l.additive = additive
    l.loop = loop
    l.rate = 1.0
    l.base = pose.new(r)
    clips.sample_frame(t, r, 0, l.base)
    list.add_raw(a.layers, l as ptr)
    return list.size(a.layers) - 1
}

// The layer's weight toward `w`, reached over `seconds` (0: at once).
layer_weight(a: *Animator, layer: int, w: float, seconds: float) {
    if layer < 0 || layer >= list.size(a.layers) { return }
    l = list.get_raw(a.layers, layer) as *Layer
    l.goal = w
    if seconds <= 0.0 {
        l.weight = w
        l.fade = 0.0
    } else {
        l.fade = core.abs_of(w - l.weight) / seconds
    }
}

layer_restart(a: *Animator, layer: int) {
    if layer < 0 || layer >= list.size(a.layers) { return }
    (list.get_raw(a.layers, layer) as *Layer).time = 0.0
}

layer_time(a: *Animator, layer: int) -> float {
    if layer < 0 || layer >= list.size(a.layers) { return 0.0 }
    return (list.get_raw(a.layers, layer) as *Layer).time
}

// The layer's clock at `rate` times its take's own (#945): a swing played
// lighter or heavier, a combo's step quicker.
layer_rate(a: *Animator, layer: int, rate: float) {
    if layer < 0 || layer >= list.size(a.layers) { return }
    (list.get_raw(a.layers, layer) as *Layer).rate = rate
}

// Whether a layer that plays once has played to its end.
layer_done(a: *Animator, layer: int) -> bool {
    if layer < 0 || layer >= list.size(a.layers) { return true }
    l = list.get_raw(a.layers, layer) as *Layer
    if l.loop { return false }
    return l.time >= clips.duration(l.take as *Take) - 0.0001
}

apply_layers(a: *Animator, dt: float) {
    r = a.rig as *pose.Rig
    i = 0
    while i < list.size(a.layers) {
        l = list.get_raw(a.layers, i) as *Layer
        if l.weight < l.goal {
            l.weight = l.weight + l.fade * dt
            if l.weight > l.goal || l.fade <= 0.0 { l.weight = l.goal }
        } else if l.weight > l.goal {
            l.weight = l.weight - l.fade * dt
            if l.weight < l.goal || l.fade <= 0.0 { l.weight = l.goal }
        }
        t = l.take as *Take
        was = l.time
        l.time = l.time + dt * l.rate
        if !l.loop && l.time > clips.duration(t) { l.time = clips.duration(t) }
        // A layer that plays once eases out over its last LAYER_OUT seconds,
        // as a montage blends out. Held at its end, a head hit's layer kept
        // the head thrown back 80 degrees until the next hit.
        w = l.weight
        if !l.loop {
            u = core.clampf((clips.duration(t) - l.time) / LAYER_OUT, 0.0, 1.0)
            w = w * u * u * (3.0 - 2.0 * u)
        }
        if l.weight > 0.0 && (l.loop || l.time >= was) { pass_events(a, t, was, l.time, l.loop, false) }
        if w > 0.0 {
            clips.sample(t, r, l.time, l.loop, a.work)
            if l.additive {
                pose.difference(r, a.work, l.base, a.work2)
                pose.add_weighted(r, a.out, a.work2, l.mask, w, a.out)
            } else {
                pose.blend_weighted(r, a.out, a.work, l.mask, w, a.out)
            }
        }
        i = i + 1
    }
}

// --- inverse kinematics -----------------------------------------------------------------------

// Feet placed on the ground by `f` (ae3d.ikrig.feet_new), taken by the
// animator and freed with it. Put on a figure before its first frame,
// they stand on the ground under it from that frame (ikrig.feet_stand);
// on one already seen, they ease onto it.
set_feet(a: *Animator, f: *Feet) {
    a.feet = f as ptr
    if !a.evaluated { ikrig.feet_stand(f) }
}

// Hands put on grips by `h` (ae3d.ikrig.hands_new), taken by the animator and
// freed with it; the game moves the grips (ikrig.hands_set).
set_hands(a: *Animator, h: *Hands) { a.hands = h as ptr }
hands(a: *Animator) -> *Hands { return a.hands as *Hands }
feet(a: *Animator) -> *Feet { return a.feet as *Feet }

// The head and neck turned toward `point` (the world's), `weight` of the way.
look_at(a: *Animator, point: Vec3, weight: float) {
    if a.look == null { a.look = ikrig.look_new(a.rig as *pose.Rig) as ptr }
    ikrig.look_set(a.look as *Look, point, weight)
}

look_off(a: *Animator) {
    if a.look != null { ikrig.look_set(a.look as *Look, core.vec3(0.0, 0.0, 0.0), 0.0) }
}

// The look's solver (ikrig), made the first time it is asked for.
look(a: *Animator) -> *Look {
    if a.look == null { a.look = ikrig.look_new(a.rig as *pose.Rig) as ptr }
    return a.look as *Look
}

// A living face (#910): blinks at human timing over the rig's eyeBlinkLeft
// and eyeBlinkRight curves (found by name as ae3d.face maps ARKit's shapes:
// add the head's morph curves to the rig first, pose.add_morph_curves), a
// blink with a third of the gaze shifts over 30 degrees, and saccades over
// what the look is on where the rig has eyes. A layer over the frame's pose:
// a blink shuts the lids however the take holds them (the larger of the
// two), and goes through the pose to the weights with everything else.
// Deterministic from `seed`. Whether the rig has blink curves or eyes.
face_on(a: *Animator, seed: int) -> bool {
    face_off(a)
    r = a.rig as *pose.Rig
    a.blink_left = 0 - 1
    a.blink_right = 0 - 1
    c = 0
    while c < pose.curve_count(r) {
        slot = face.shape_of(pose.curve_name(r, c))
        if slot == face.EYE_BLINK_LEFT && a.blink_left < 0 { a.blink_left = c }
        if slot == face.EYE_BLINK_RIGHT && a.blink_right < 0 { a.blink_right = c }
        c = c + 1
    }
    eyes = pose.human(r, pose.EYE_L) >= 0 || pose.human(r, pose.EYE_R) >= 0
    a.blinker = face.blinker_new(seed) as ptr
    a.saccades = face.saccades_new(seed * 7 + 3) as ptr
    return a.blink_left >= 0 || a.blink_right >= 0 || eyes
}

face_off(a: *Animator) {
    if a.blinker != null { face.blinker_free(a.blinker as *Blinker) }
    if a.saccades != null { face.saccades_free(a.saccades as *Saccades) }
    a.blinker = null
    a.saccades = null
}

// Whether the rig has curves on the weights `part` draws by already (its
// node's, which another primitive of it brought in).
curves_driving(r: *pose.Rig, part: *Model) -> bool {
    owner = part
    if part.morph_driver != null { owner = part.morph_driver as *Model }
    c = 0
    while c < pose.curve_count(r) {
        if pose.curve_model(r, c) == owner { return true }
        c = c + 1
    }
    return false
}

// A blink now, unless one is under way.
blink(a: *Animator) -> bool {
    if a.blinker == null { return false }
    return face.blink_now(a.blinker as *Blinker)
}

blinker(a: *Animator) -> *Blinker { return a.blinker as *Blinker }
saccades(a: *Animator) -> *Saccades { return a.saccades as *Saccades }

// A line spoken: `track`'s visemes (ae3d.visemes.analyse of its sound,
// borrowed, kept until it has played) played from `seconds` into it onto
// the mouth's curves -- VRoid's vowels, or ARKit's jaw and mouth shapes
// (visemes.drive) -- as a layer over the frame's pose, the larger of the
// take's and the line's. Start it with the sound. Whether the rig has a
// curve speech poses.
speak(a: *Animator, track: @keep ptr, seconds: float) -> bool {
    r = a.rig as *pose.Rig
    if a.speech_drive != null { free(a.speech_drive) }
    a.speech_drive = calloc(pose.curve_count(r) * visemes.VISEMES + 1, 8)
    any = false
    c = 0
    while c < pose.curve_count(r) {
        if visemes.drive(pose.curve_name(r, c), a.speech_drive + c * visemes.VISEMES * 8) { any = true }
        c = c + 1
    }
    a.speech = track
    a.speech_t = seconds
    return any
}

// The line let go of: the mouth the take's again.
speak_off(a: *Animator) {
    a.speech = null
    if a.speech_drive != null { free(a.speech_drive) }
    a.speech_drive = null
}

apply_speech(a: *Animator, dt: float) {
    if a.speech == null { return }
    track = a.speech as *visemes.Track
    a.speech_t = a.speech_t + dt
    if a.speech_t > visemes.duration(track) + 0.1 {
        speak_off(a)
        return
    }
    r = a.rig as *pose.Rig
    now = calloc(visemes.VISEMES, 8)
    visemes.sample(track, a.speech_t, now)
    w = now as float[]
    drive = a.speech_drive as float[]
    c = 0
    while c < pose.curve_count(r) {
        value = 0.0
        driven = false
        v = 0
        while v < visemes.VISEMES {
            d = drive[c * visemes.VISEMES + v]
            if d != 0.0 {
                value = value + d * w[v]
                driven = true
            }
            v = v + 1
        }
        if driven && pose.curve(r, a.out, c) < value { pose.set_curve(r, a.out, c, value) }
        c = c + 1
    }
    free(now)
}

// The face's layer on the frame's pose, after the look: the blink with a
// large shift the look began, the blink's lids over the curves.
apply_face(a: *Animator, dt: float) {
    apply_speech(a, dt)
    if a.blinker == null { return }
    r = a.rig as *pose.Rig
    b = a.blinker as *Blinker
    if a.look != null {
        shift = ikrig.look_shift(a.look as *Look)
        if shift > 0.0 {
            _blinked = face.blink_on_shift(b, shift)
            if a.saccades != null { face.saccades_reset(a.saccades as *Saccades) }
        }
    }
    face.blink_step(b, dt)
    w = face.blink_weight(b)
    if a.blink_left >= 0 && pose.curve(r, a.out, a.blink_left) < w { pose.set_curve(r, a.out, a.blink_left, w) }
    if a.blink_right >= 0 && pose.curve(r, a.out, a.blink_right) < w { pose.set_curve(r, a.out, a.blink_right, w) }
}

// The trunk turned so the line it holds (ikrig.aim_set_line: a rifle's,
// the chest's forward by default) points at `point` (the world's),
// `weight` of the way: solved after the feet, before the hands go on what
// it holds.
aim_at(a: *Animator, point: Vec3, weight: float) {
    ikrig.aim_set(trunk_aim(a), point, weight)
}

aim_off(a: *Animator) {
    if a.aim != null { ikrig.aim_set(a.aim as *ikrig.Aim, core.vec3(0.0, 0.0, 0.0), 0.0) }
}

trunk_aim(a: *Animator) -> *ikrig.Aim {
    if a.aim == null { a.aim = ikrig.aim_new(a.rig as *pose.Rig) as ptr }
    return a.aim as *ikrig.Aim
}

// Whole-body reach by `b` (ae3d.ikrig.body_new), taken by the animator and
// freed with it: solved after the feet and the aim, before the hands.
set_body(a: *Animator, b: *Body) { a.body = b as ptr }
body(a: *Animator) -> *Body { return a.body as *Body }

// The figure's spring chains and jiggle (ae3d.springs, #989), made on first
// use and freed with the animator: solved last in each evaluation, after
// the IK, carried by the figure's world motion.
springs_of(a: *Animator) -> *Springs {
    if a == null { return null }
    if a.springs == null { a.springs = springs.springs_new(a.rig as *pose.Rig) as ptr }
    return a.springs as *Springs
}

// The figure's file's own spring bones (a VRM's) as its chains and
// colliders: how many chains were made.
springs_from_file(a: *Animator) -> int {
    if a == null { return 0 }
    f = figure.figure_of(a.object as *GameObject)
    if f == null { return 0 }
    s = figure.scene(f)
    if s == null || gltf.spring_count(s) == 0 { return 0 }
    return springs.from_scene(springs_of(a), s)
}

// --- the graph's parameters and transitions -----------------------------------------------------

// The parameter named `title`, made when `create` and it is new; -1 when it is
// not there and not made.
param_index(a: *Animator, title: string, create: bool) -> int {
    i = 0
    while i < list.size(a.params) {
        if string.equals((list.get_raw(a.params, i) as *Param).name, title) == 1 { return i }
        i = i + 1
    }
    if !create { return 0 - 1 }
    p = heap.new(Param)
    p.name = string.copy(title)
    list.add_raw(a.params, p as ptr)
    return list.size(a.params) - 1
}

param_at(a: *Animator, i: int) -> *Param { return list.get_raw(a.params, i) as *Param }

// A number the graph reads: a blend space's speed or velocity, a condition's.
set_float(a: *Animator, title: string, value: float) { param_at(a, param_index(a, title, true)).value = value }

set_bool(a: *Animator, title: string, on: bool) {
    v = 0.0
    if on { v = 1.0 }
    param_at(a, param_index(a, title, true)).value = v
}

// A trigger: set until a transition that tests it is taken.
trigger(a: *Animator, title: string) {
    p = param_at(a, param_index(a, title, true))
    p.value = 1.0
    p.trigger = true
}

float_param(a: *Animator, title: string) -> float {
    i = param_index(a, title, false)
    if i < 0 { return 0.0 }
    return param_at(a, i).value
}

// A transition from `from` (or ANY state) to `to` over `seconds`, taken by
// the graph itself the first frame all its conditions hold (transition_when),
// in the order they were added. Inertialized, unless cross-faded. Its index.
add_transition(a: *Animator, from: int, to: int, seconds: float) -> int {
    t = heap.new(Transition)
    t.from = from
    t.to = to
    t.seconds = seconds
    t.conditions = list.new()
    list.add_raw(a.transitions, t as ptr)
    return list.size(a.transitions) - 1
}

// How many transitions the graph has: the next one added is this one's
// index. A layer of states put over a graph (ae3d.stance's crouch and prone)
// gives each transition before it a condition of its own.
transition_count(a: *Animator) -> int { return list.size(a.transitions) }

// The state transition `tr` leaves (ANY for any), -1 for none.
transition_from(a: *Animator, tr: int) -> int {
    if tr < 0 || tr >= list.size(a.transitions) { return 0 - 1 }
    return (list.get_raw(a.transitions, tr) as *Transition).from
}

// A condition of transition `tr`: parameter `title` ABOVE or BELOW `value`,
// a switch that IS or IS_NOT on, a trigger TRIGGERED; or the state's take
// ENDED (`title` unread), the transition's time before its end.
transition_when(a: *Animator, tr: int, title: string, test: int, value: float) {
    if tr < 0 || tr >= list.size(a.transitions) { return }
    t = list.get_raw(a.transitions, tr) as *Transition
    c = heap.new(Condition)
    c.param = 0 - 1
    if test != ENDED { c.param = param_index(a, title, true) }
    c.test = test
    c.value = value
    list.add_raw(t.conditions, c as ptr)
}

// Transition `tr` cross-fades: both states play through it, their poses
// blended (for two takes made to be blended, a turn into a walk); one
// inertialized plays the new state alone from the pose drawn.
transition_crossfade(a: *Animator, tr: int, on: bool) {
    if tr < 0 || tr >= list.size(a.transitions) { return }
    (list.get_raw(a.transitions, tr) as *Transition).crossfade = on
}

// Blend space `state` takes parameter `title` as its own every frame (its
// speed), or for a 2D blend `title` and `title2` (its velocity across and
// ahead).
bind(a: *Animator, state: int, title: string) {
    s = state_at(a, state)
    if s != null { s.bind = param_index(a, title, true) }
}

bind2(a: *Animator, state: int, title: string, title2: string) {
    s = state_at(a, state)
    if s == null { return }
    s.bind = param_index(a, title, true)
    s.bind2 = param_index(a, title2, true)
}

apply_bindings(a: *Animator) {
    i = 0
    while i < list.size(a.states) {
        s = list.get_raw(a.states, i) as *State
        if s.bind >= 0 { s.param = param_at(a, s.bind).value }
        if s.bind2 >= 0 { s.param2 = param_at(a, s.bind2).value }
        i = i + 1
    }
}

condition_holds(a: *Animator, c: *Condition) -> bool {
    if c.test == ENDED { return false }
    v = param_at(a, c.param).value
    if c.test == ABOVE { return v > c.value }
    if c.test == BELOW { return v < c.value }
    if c.test == IS || c.test == TRIGGERED { return v > 0.5 }
    if c.test == IS_NOT { return v < 0.5 }
    return false
}

// The first transition whose conditions all hold, taken; its triggers spent.
take_transitions(a: *Animator) {
    i = 0
    while i < list.size(a.transitions) {
        t = list.get_raw(a.transitions, i) as *Transition
        if (t.from == ANY || t.from == a.current) && t.to != a.current && list.size(t.conditions) > 0 {
            holds = true
            k = 0
            while k < list.size(t.conditions) && holds {
                c = list.get_raw(t.conditions, k) as *Condition
                if c.test == ENDED {
                    holds = ended(a, t.seconds)
                } else {
                    holds = condition_holds(a, c)
                }
                k = k + 1
            }
            if holds {
                k = 0
                while k < list.size(t.conditions) {
                    c = list.get_raw(t.conditions, k) as *Condition
                    if c.test == TRIGGERED { param_at(a, c.param).value = 0.0 }
                    k = k + 1
                }
                to = best_target(a, t)
                if t.synced {
                    play_synced(a, to, t.seconds)
                } else if t.crossfade {
                    crossfade_to(a, to, t.seconds)
                } else {
                    play(a, to, t.seconds)
                }
                return
            }
        }
        i = i + 1
    }
}

// Whether the current state's take has `before` seconds or less left to
// play (a take that does not loop; a blend never ends).
ended(a: *Animator, before: float) -> bool {
    s = state_at(a, a.current)
    if s == null || s.kind != STATE_TAKE || s.loop { return false }
    // Played backward (set_rate below 0), it ends at its start (#947).
    if s.rate < 0.0 { return s.time <= before }
    return s.time >= clips.duration(list.get_raw(s.takes, 0) as *Take) - before
}

// The current state cross-faded into `state` over `seconds`: both play, the
// old one's weight falling as the new one's rises.
crossfade_to(a: *Animator, state: int, seconds: float) {
    s = state_at(a, state)
    if s == null { return }
    if seconds <= 0.0 || a.current < 0 {
        play(a, state, 0.0)
        return
    }
    a.fade_from = a.current
    a.fade_t = 0.0
    a.fade_time = seconds
    s.time = 0.0
    // Entered where a matching transition chose (transition_match), as
    // play_at enters it, and the choice spent. Left set, a cross-fade's
    // match was never used, and a later play of the state entered it at
    // that stale time: a crouch idle played as a way up from the prone
    // ended came in 2.45 s into its loop, a foot turning 80 rad/s (#988).
    if !s.chosen { s.offset = 0.0 }
    if s.chosen && s.entry_at >= 0.0 { s.time = s.entry_at }
    s.entry_at = 0.0 - 1.0
    s.chosen = false
    s.entered = true
    a.current = state
    a.blend_t = 0.0
    a.blend_time = 0.0
}

free_graph(a: *Animator) {
    i = 0
    while i < list.size(a.params) {
        p = list.get_raw(a.params, i) as *Param
        string.free(p.name)
        heap.free(p)
        i = i + 1
    }
    list.free(a.params)
    i = 0
    while i < list.size(a.transitions) {
        t = list.get_raw(a.transitions, i) as *Transition
        k = 0
        while k < list.size(t.conditions) {
            heap.free(list.get_raw(t.conditions, k) as *Condition)
            k = k + 1
        }
        list.free(t.conditions)
        if t.others != null { free(t.others) }
        heap.free(t)
        i = i + 1
    }
    list.free(a.transitions)
    i = 0
    while i < list.size(a.aims) {
        m = list.get_raw(a.aims, i) as *Aim
        k = 0
        while k < list.size(m.poses) {
            pose.release(list.get_raw(m.poses, k))
            k = k + 1
        }
        list.free(m.poses)
        free(m.yaws)
        free(m.pitches)
        pose.mask_free(m.mask)
        pose.release(m.reference)
        heap.free(m)
        i = i + 1
    }
    list.free(a.aims)
    pose.release(a.work3)
    pose.release(a.blend_work)
}

// --- a pose held --------------------------------------------------------------------------------

// A state that holds the pose drawn now (a ragdoll's as it lands, the last
// frame of a dive), to be played and blended from like any other: what a
// get-up blends out of. Taken again under the same name, the state's pose
// is taken again. Its index.
snapshot(a: *Animator, title: string) -> int {
    r = a.rig as *pose.Rig
    i = find_state(a, title)
    s = state_at(a, i)
    if s == null {
        s = new_state(title, STATE_POSE)
        s.held = pose.new(r)
        list.add_raw(a.states, s as ptr)
        i = list.size(a.states) - 1
    }
    pose.copy(r, a.out, s.held)
    return i
}

// --- aim offsets --------------------------------------------------------------------------------

// An aim offset over the joints under `from` (a figure's spine, for a gun
// held in both hands): poses added with aim_add, each at the yaw and pitch
// it aims at (radians, yaw to the figure's left, pitch up), the first at
// (0, 0) or the one there its reference. Its index.
add_aim(a: *Animator, from: int) -> int {
    r = a.rig as *pose.Rig
    m = heap.new(Aim)
    top = from
    if top < 0 { top = pose.order(r, 0) }
    m.mask = pose.mask(r, top, 1.0)
    m.poses = list.new()
    m.room = 8
    m.yaws = calloc(m.room, 8)
    m.pitches = calloc(m.room, 8)
    m.reference = pose.new(r)
    m.weight = 1.0
    list.add_raw(a.aims, m as ptr)
    return list.size(a.aims) - 1
}

// Take `t`'s first frame as the aim at `yaw` and `pitch`.
aim_add(a: *Animator, aim: int, t: *Take, yaw: float, pitch: float) {
    if aim < 0 || aim >= list.size(a.aims) || t == null { return }
    r = a.rig as *pose.Rig
    m = list.get_raw(a.aims, aim) as *Aim
    if m.count >= m.room {
        bigger = m.room * 2
        ys = calloc(bigger, 8) as float[]
        ps = calloc(bigger, 8) as float[]
        k = 0
        while k < m.count {
            ys[k] = (m.yaws as float[])[k]
            ps[k] = (m.pitches as float[])[k]
            k = k + 1
        }
        free(m.yaws)
        free(m.pitches)
        m.yaws = ys as ptr
        m.pitches = ps as ptr
        m.room = bigger
    }
    p = pose.new(r)
    clips.sample_frame(t, r, 0, p)
    list.add_raw(m.poses, p)
    (m.yaws as float[])[m.count] = yaw
    (m.pitches as float[])[m.count] = pitch
    if m.count == 0 || yaw * yaw + pitch * pitch < 0.000001 { pose.copy(r, p, m.reference) }
    m.count = m.count + 1
}

// Aim offset `aim` aimed at `yaw` and `pitch`, `weight` deep.
set_aim(a: *Animator, aim: int, yaw: float, pitch: float, weight: float) {
    if aim < 0 || aim >= list.size(a.aims) { return }
    m = list.get_raw(a.aims, aim) as *Aim
    m.yaw = yaw
    m.pitch = pitch
    m.weight = weight
}

// Each aim offset's samples blended at its aim by cartesian gradient bands
// (an aim's yaw and pitch are angles alike), their difference from its
// reference added over its joints.
apply_aims(a: *Animator) {
    r = a.rig as *pose.Rig
    i = 0
    while i < list.size(a.aims) {
        m = list.get_raw(a.aims, i) as *Aim
        if m.count > 0 && m.weight > 0.0 {
            ys = m.yaws as float[]
            ps = m.pitches as float[]
            first = true
            total = 0.0
            k = 0
            while k < m.count {
                w = band_weight(ys, ps, m.count, k, m.yaw, m.pitch)
                if w > 0.0 {
                    if first {
                        pose.copy(r, list.get_raw(m.poses, k), a.work)
                        total = w
                        first = false
                    } else {
                        total = total + w
                        pose.blend(r, a.work, list.get_raw(m.poses, k), w / total, a.work)
                    }
                }
                k = k + 1
            }
            if !first {
                pose.difference(r, a.work, m.reference, a.work2)
                pose.add_weighted(r, a.out, a.work2, m.mask, m.weight, a.out)
            }
        }
        i = i + 1
    }
}

// Sample `i`'s gradient band weight among `n` at (x, y) (cartesian, not
// normalized: a share of the weights' sum).
band_weight(xs: float[], ys: float[], n: int, i: int, x: float, y: float) -> float {
    least = 1.0
    j = 0
    while j < n {
        if j != i {
            dx = xs[j] - xs[i]
            dy = ys[j] - ys[i]
            apart = dx * dx + dy * dy
            if apart > 0.0000000001 {
                h = 1.0 - ((x - xs[i]) * dx + (y - ys[i]) * dy) / apart
                if h < least { least = h }
            }
        }
        j = j + 1
    }
    if least < 0.0 { return 0.0 }
    return least
}

// --- events -------------------------------------------------------------------------------------

// The events the last frame's clocks passed: the current state's (a blend's
// from its heaviest take, as Unreal fires a blend's notifies by default: two
// gaits' footfalls are one footfall) and every weighted layer's, in the order
// the frame met them. A game reads them after the pose phase, until the next.
event_count(a: *Animator) -> int { return a.fired_count }

event_name(a: *Animator, i: int) -> string {
    if i < 0 || i >= a.fired_count { return "" }
    return clips.event_name((a.fired_takes as ptr[])[i] as *Take, (a.fired_at as int[])[i])
}

// Whether an event named `title` fired last frame.
fired(a: *Animator, title: string) -> bool {
    i = 0
    while i < a.fired_count {
        if string.equals(event_name(a, i), title) == 1 { return true }
        i = i + 1
    }
    return false
}

events_clear(a: *Animator) { a.fired_count = 0 }

event_fire(a: *Animator, t: *Take, index: int) {
    if a.fired_count >= a.fired_room {
        bigger = a.fired_room * 2
        takes = calloc(bigger, 8) as ptr[]
        at = calloc(bigger, 4) as int[]
        old_t = a.fired_takes as ptr[]
        old_a = a.fired_at as int[]
        k = 0
        while k < a.fired_count {
            takes[k] = old_t[k]
            at[k] = old_a[k]
            k = k + 1
        }
        free(a.fired_takes)
        free(a.fired_at)
        a.fired_takes = takes as ptr
        a.fired_at = at as ptr
        a.fired_room = bigger
    }
    (a.fired_takes as ptr[])[a.fired_count] = t as ptr
    (a.fired_at as int[])[a.fired_count] = index
    a.fired_count = a.fired_count + 1
}

// The current state's events its clock passed this frame, from `from`.
pass_state(a: *Animator, s: *State, from: float) {
    entered = s.entered
    s.entered = false
    if s.kind == STATE_MATCH {
        pass_events(a, matched_take(s), from, s.time, clips.looping(matched_take(s)), entered)
        return
    }
    if s.kind == STATE_TAKE {
        // Back only when it plays backward: a take started again is not played
        // back over its events.
        if s.rate < 0.0 || s.time >= from || s.loop { pass_events(a, list.get_raw(s.takes, 0) as *Take, from, s.time, s.loop, entered) }
        return
    }
    w = s.weights as float[]
    heaviest = 0 - 1
    k = 0
    while k < s.count {
        if heaviest < 0 || w[k] > w[heaviest] { heaviest = k }
        k = k + 1
    }
    if heaviest < 0 { return }
    t = list.get_raw(s.takes, heaviest) as *Take
    pass_events(a, t, take_time_at(t, from), take_time_at(t, s.time), true, entered)
}

// The events of `t` passed going from `from` to `to` seconds, wrapping when
// it loops: those after `from` (at it too, when the clock has just been
// started there) up to `to`.
pass_events(a: *Animator, t: *Take, from: float, to: float, loop: bool, entered: bool) {
    n = clips.event_count(t)
    if n == 0 || to == from && !entered { return }
    // Going back (a take that does not loop, played at a rate below 0): the
    // events before `from` down to `to`, as it passes them (#947).
    if !loop && to < from {
        i = 0
        while i < n {
            at = clips.event_time(t, i)
            if (at < from || entered && at == from) && at >= to { event_fire(a, t, i) }
            i = i + 1
        }
        return
    }
    whole = loop && to - from >= clips.duration(t)
    fw = clips.time_of(t, from, loop)
    tw = clips.time_of(t, to, loop)
    wrapped = loop && tw < fw
    i = 0
    while i < n {
        at = clips.event_time(t, i)
        after = at > fw || entered && at == fw
        passed = false
        if whole {
            passed = true
        } else if wrapped {
            passed = after || at <= tw
        } else {
            passed = after && at <= tw
        }
        if passed { event_fire(a, t, i) }
        i = i + 1
    }
}

// --- the frame ----------------------------------------------------------------------------------

// The pose phase: the graph has gone on at the frame's steps
// (animator_fixed); here the pose shown this frame is taken between the
// last two steps' by the frame's share of the next, as its joints are drawn
// (core.interp_apply), and its steps after the graph run, drawing from the
// bodies as the physics left them. A figure another writer has (pause) is
// read back as that writer drew it this frame.
animator_pose(state: ptr, e: *Engine) {
    a = state as *Animator
    if a.paused {
        if !a.fixed { evaluate(a, engine.engine_delta_time(e)) }
        return
    }
    // Made since the frame's steps: its graph's pose at no time on (its
    // state's and its layers'), not its rest pose, and the graph left for
    // the next step to begin, as it begins on a fixed tick. Evaluated here
    // (its feet, its transitions), a people plaza made in a frame that ran
    // no step went another way than on the tick.
    if !a.evaluated {
        s = state_at(a, a.current)
        if s != null {
            sample_state(a, s, a.out)
            apply_layers(a, 0.0)
            pose.apply(a.rig as *pose.Rig, a.out)
        }
    }
    alpha = core.interp_frame()
    if alpha >= 0.0 && a.steps_drawn >= 2 {
        if alpha > 1.0 { alpha = 1.0 }
        pose.blend(a.rig as *pose.Rig, a.step_before, a.step_now, alpha, a.frame_shown)
        a.framed = true
    }
    clock = profile_now()
    run_posts(a)
    profile_add(PROF_POSTS, clock)
}

// The pose `dt` seconds on, written to the figure's joints. Each fixed step
// calls it (animator_fixed); a program posing a figure with no engine
// stepping it calls it (or update_now) itself, and its posts run with it.
evaluate(a: *Animator, dt: float) {
    a.framed = false
    if a.paused {
        a.showing = false
        read_paused(a, dt)
        return
    }
    if evaluate_pose(a, dt) { evaluate_posts(a) }
}

// The steps after the graph, where the graph draws them: not at the fixed
// step, whose animators run them in the pose phase.
evaluate_posts(a: *Animator) {
    if a.fixed || a.stepping { return }
    clock = profile_now()
    run_posts(a)
    profile_add(PROF_POSTS, clock)
}

// The graph evaluated and its pose written to the joints: all of the frame
// but its steps after the graph. False when nothing was drawn.
evaluate_pose(a: *Animator, dt: float) -> bool {
    return evaluate_write(a, evaluate_graph_now(a, dt), dt)
}

// What evaluate_graph_now leaves to write.
const DREW_NONE = 0                // nothing evaluated: nothing to draw
const DREW_OUT = 1                 // the graph's pose, this frame's
const DREW_BETWEEN = 2             // drawn between the last two evaluations (set_every)

// Whether the frame takes the graph's every-frame path (evaluate_graph_now's
// first): one that moves no object as it is evaluated.
every_frame_now(a: *Animator) -> bool {
    return (a.every <= 1 && a.ahead <= 0.0) || !a.evaluated
}

// The pose written: the graph's, or the frame's drawn between two (moved
// first by its root motion at a slower rate). False when nothing was drawn.
evaluate_write(a: *Animator, drew: int, dt: float) -> bool {
    if drew == DREW_OUT {
        clock = profile_now()
        pose.apply(a.rig as *pose.Rig, a.out)
        profile_add(PROF_APPLY, clock)
        return true
    }
    if drew == DREW_BETWEEN {
        if a.root_motion { move_object(a, core.v3_mul(a.lod_moved, dt), dt) }
        draw_between(a)
        return true
    }
    return false
}

// The frame's graph evaluated, its pose not yet written to the joints
// (evaluate_write).
evaluate_graph_now(a: *Animator, dt: float) -> int {
    a.showing = false
    // Every frame, as by default: the graph carried on by the frame and its
    // pose drawn.
    if every_frame_now(a) {
        if !graph_timed(a, dt, dt, false) { return DREW_NONE }
        a.ahead = 0.0
        a.span = dt
        a.lod_moved = core.vec3(0.0, 0.0, 0.0)
        // Where it stands, for the speed a first evaluation at a slower rate
        // places it ahead by (lod_place_ahead).
        o = a.object as *GameObject
        a.lod_at = behaviour.object_position(o)
        a.lod_yaw = yaw_of(behaviour.object_rotation(o))
        a.lod_elapsed = 0.0
        a.lod_known = true
        return DREW_OUT
    }
    // One frame in `every` (set_every): the graph evaluated ahead to the
    // last frame its pose serves, and each frame drawn between the pose
    // evaluated for the frame before this one and that. The frame is drawn
    // at its own time, not an interval late as Unreal's update-rate
    // optimisation draws it; a figure taken back to every frame finishes
    // the interval it is in first, so the rate changes without a jump.
    a.ahead = a.ahead - dt
    a.lod_elapsed = a.lod_elapsed + dt
    if a.ahead < 0.0 - 0.5 * dt {
        serves = a.every
        if a.lod_phase > 0 {
            serves = a.lod_phase
            a.lod_phase = 0
        }
        if serves < 1 { serves = 1 }
        step = ((serves - 1) as float) * dt - a.ahead
        // Its feet and eyes solved where the figure will stand when the
        // pose is drawn. Solved where it stood, a walker at 1.2 m/s one
        // frame in 4 bent a knee 0.16 rad off the same walker's every frame
        // (its planted foot reached for from 6 cm behind).
        lod_place_ahead(a, ((serves - 1) as float) * dt)
        // And the feet on the ground as the clip sets them down, not locked
        // where they land, as Unreal's foot IK is turned off on its lower
        // LODs: sampled one frame in 8, a foot was locked where the clip had
        // it up to 133 ms after it landed, and the knee reaching for that
        // spot was 1.0 rad off the walker's every frame.
        locks = a.feet != null && serves > 1 && (a.feet as *Feet).lock
        if locks { ikrig.feet_set_lock(a.feet as *Feet, false) }
        drew = graph_timed(a, step, dt, true)
        if locks { ikrig.feet_set_lock(a.feet as *Feet, true) }
        lod_place_back(a)
        if !drew { return DREW_NONE }
        a.ahead = ((serves - 1) as float) * dt
        a.span = step
    }
    return DREW_BETWEEN
}

// The figure's object put where it will be `lead` seconds on, at the speed
// and turn it has gone at since the evaluation before; where it stood kept
// for lod_place_back.
lod_place_ahead(a: *Animator, lead: float) {
    o = a.object as *GameObject
    at = behaviour.object_position(o)
    q = behaviour.object_rotation(o)
    yaw = yaw_of(q)
    v = core.vec3(0.0, 0.0, 0.0)
    turn = 0.0
    if a.lod_known && a.lod_elapsed > 0.0 {
        v = core.v3_mul(core.vec3(at.x - a.lod_at.x, 0.0, at.z - a.lod_at.z), 1.0 / a.lod_elapsed)
        turn = wrap_turn(yaw - a.lod_yaw) / a.lod_elapsed
    }
    a.lod_at = at
    a.lod_yaw = yaw
    a.lod_turned = q
    a.lod_elapsed = 0.0
    a.lod_known = true
    if lead <= 0.0 { return }
    behaviour.object_set_position(o, core.v3_add(at, core.v3_mul(v, lead)))
    behaviour.object_set_rotation(o, core.quat_normalize(core.quat_mul(core.quat_rotate(turn * lead, core.vec3(0.0, 1.0, 0.0)), q)))
}

lod_place_back(a: *Animator) {
    o = a.object as *GameObject
    behaviour.object_set_position(o, a.lod_at)
    behaviour.object_set_rotation(o, a.lod_turned)
}

// The pose drawn between two evaluations: the one before turned toward the
// last by how far the frame has come between them.
draw_between(a: *Animator) {
    r = a.rig as *pose.Rig
    clock = profile_now()
    u = 1.0
    if a.span > 0.0 { u = 1.0 - a.ahead / a.span }
    pose.blend(r, a.before, a.out, u, a.shown)
    a.showing = true
    pose.apply(r, a.shown)
    profile_add(PROF_APPLY, clock)
}

// The graph evaluated over `step` seconds, timed into `cost` (an average
// over about ten evaluations): what an allocator of the frame's animation
// budget (ae3d.animlod) spends.
graph_timed(a: *Animator, step: float, frame: float, spread: bool) -> bool {
    began = os.now_monotonic_ns()
    drew = evaluate_graph(a, step, frame, spread)
    took = ((os.now_monotonic_ns() - began) as float) * 0.000000001
    if a.cost <= 0.0 { a.cost = took } else { a.cost = a.cost * 0.9 + took * 0.1 }
    return drew
}

// Paused: the figure is another writer's (pause). Nothing is written;
// what that writer drew is read back, the last two frames kept, so
// resume eases out of it at the speed it was moving.
read_paused(a: *Animator, dt: float) {
    r = a.rig as *pose.Rig
    pose.copy(r, a.out, a.before)
    pose.read(r, a.out)
    if !a.drawn { pose.copy(r, a.out, a.before) }
    pose.copy(r, a.graph_out, a.graph_before)
    pose.copy(r, a.out, a.graph_out)
    if !a.drawn { pose.copy(r, a.out, a.graph_before) }
    a.drawn = true
    a.ahead = 0.0
    if dt > 0.0 { a.dt_before = dt }
}

// The graph carried on `dt` seconds: its pose into `out`, not drawn.
// `spread`: its root motion moved a frame of `frame` seconds at a time over
// the frames the evaluation serves (set_every), not at once.
// False with no state to play: nothing evaluated, and nothing to draw.
evaluate_graph(a: *Animator, dt: float, frame: float, spread: bool) -> bool {
    r = a.rig as *pose.Rig
    clock = profile_now()
    apply_bindings(a)
    if a.evaluated { take_transitions(a) }
    s = state_at(a, a.current)
    if s == null { return false }
    // A matcher searches before the frame moves on, from the two poses drawn last.
    if s.kind == STATE_MATCH { match_due(a, s, dt) }
    pose.copy(r, a.out, a.before)
    events_clear(a)
    from = s.time
    moved = advance(a, s, dt)
    moved = warp_step(a, s, from, moved)
    pass_state(a, s, from)
    sample_state(a, s, a.out)
    clock = profile_add(PROF_GRAPH, clock)
    if a.blend_t < a.blend_time {
        a.blend_t = a.blend_t + dt
        if a.blend_t < a.blend_time { apply_inertia(a, a.out, a.blend_t) }
    }
    shape(a, a.out, dt)
    clock = profile_add(PROF_INERTIA, clock)
    // A cross-fade: the state left still playing, its pose blended out.
    if a.fade_from >= 0 {
        a.fade_t = a.fade_t + dt
        old = state_at(a, a.fade_from)
        if old == null || a.fade_t >= a.fade_time || a.fade_from == a.current {
            a.fade_from = 0 - 1
        } else {
            speed_now = a.ground_speed
            old_moved = advance(a, old, dt)
            sample_state(a, old, a.work3)
            u = a.fade_t / a.fade_time
            w = u * u * (3.0 - 2.0 * u)
            pose.blend(r, a.work3, a.out, w, a.out)
            moved = core.v3_add(core.v3_mul(old_moved, 1.0 - w), core.v3_mul(moved, w))
            a.ground_speed = a.ground_speed * (1.0 - w) + speed_now * w
        }
    }
    clock = profile_add(PROF_GRAPH, clock)
    // The graph's own pose, kept for the transitions that ease out of it:
    // the layers, aims, lift and feet go on after it, and on whatever comes
    // next. Eased out of the pose drawn, a transition took its lift and
    // laid it on again: a seated figure's pelvis dropped 15 to 18 cm for a
    // frame at its loop's start and its exit's, 10.7 m/s at the exit
    // (Siltreach's settlers on a 0.38 m log; 28.7 cm on test_use's seats,
    // 2.5 cm in a frame at the most eased out of the graph's).
    pose.copy(r, a.graph_out, a.graph_before)
    pose.copy(r, a.out, a.graph_out)
    apply_layers(a, dt)
    apply_aims(a)
    apply_lift(a, a.out, dt)
    if !a.root_motion {
        a.moved = core.vec3(0.0, 0.0, 0.0)
    } else if spread && dt > 0.0 {
        // Moved a frame at a time by evaluate, from where the figure stands.
        a.lod_moved = core.v3_mul(moved, 1.0 / dt)
    } else {
        move_object(a, moved, dt)
    }
    clock = profile_add(PROF_LAYERS, clock)
    if a.feet != null {
        // What the feet are given, kept: a transition eases out of it (#966).
        // As much as the trunk stands (ikrig.trunk_upright): a foot is not
        // stood on by a figure lying, and locked there a get-up's foot was
        // thrown up to 127 rad/s as the clip lifted it.
        pose.world(r, a.out, a.worlds)
        clock = profile_add(PROF_WORLD, clock)
        standing = ikrig.trunk_upright(r, a.worlds)
        drawn_down = a.down_drawn as float[]
        drawn_plant = a.plant_drawn as float[]
        drawn_down[0] = contact_weight(a, 0) * standing
        drawn_down[1] = contact_weight(a, 1) * standing
        drawn_plant[0] = plant_weight(a, 0) * standing
        drawn_plant[1] = plant_weight(a, 1) * standing
        ikrig.feet_set_upright(a.feet as *Feet, standing)
        ikrig.feet_solve(a.feet as *Feet, r, a.out, a.worlds, drawn_down[0], drawn_down[1], drawn_plant[0], drawn_plant[1], dt)
        clock = profile_add(PROF_FEET, clock)
    }
    if a.aim != null { ikrig.aim_solve(a.aim as *ikrig.Aim, r, a.out, a.worlds, dt) }
    clock = profile_add(PROF_REST, clock)
    // The look before the body's reach and the hands: it turns the upper
    // spine, and solved after them it carried a hand off what it was put on
    // (a bench's tool by 1.2 cm, a rifle's grips as the eyes turned).
    // An aimed trunk is the aim's: the look leaves it what the aim leaves.
    if a.look != null {
        spine = 1.0
        if a.aim != null { spine = 1.0 - ikrig.aim_weight(a.aim as *ikrig.Aim) }
        ikrig.look_spine(a.look as *Look, spine)
        // The saccades' scan over what is looked at, the eyes turned by it.
        if a.saccades != null && ikrig.look_eyes(a.look as *Look) {
            face.saccades_step(a.saccades as *Saccades, dt)
            ikrig.look_eye_offsets(a.look as *Look, face.saccade_yaw(a.saccades as *Saccades), face.saccade_pitch(a.saccades as *Saccades))
        }
        ikrig.look_solve(a.look as *Look, r, a.out, a.worlds, dt)
    }
    clock = profile_add(PROF_LOOK, clock)
    apply_face(a, dt)
    if a.body != null { ikrig.body_solve(a.body as *Body, r, a.out, a.worlds) }
    if a.hands != null {
        if a.unheld == null { a.unheld = pose.new(r) }
        pose.copy(r, a.out, a.unheld)
        ikrig.hands_solve(a.hands as *Hands, r, a.out, a.worlds, dt)
    }
    // Secondary motion last, on the pose as the IK left it: the chains
    // carried by the figure's world motion this step. Off between
    // evaluations at a slower rate (`spread`): each tail on its pose.
    if a.springs != null { springs.solve(a.springs as *Springs, a.out, dt, !spread) }
    profile_add(PROF_REST, clock)
    if dt > 0.0 { a.dt_before = dt }
    a.evaluated = true
    return true
}

update_now(a: *Animator, dt: float) { evaluate(a, dt) }

// The figure handed to another writer for a while (motion's sit and get-up,
// a cutscene, a ragdoll): the animator writes none of its joints until
// resume, and keeps reading what the other writer draws.
pause(a: *Animator) {
    if a == null || a.paused { return }
    a.paused = true
    a.drawn = false
}

paused(a: *Animator) -> bool { return a != null && a.paused }

// The figure taken back after pause: the graph's pose eased in over
// `seconds` from the pose the other writer drew last, inertialized as a
// transition is (each joint's offset and the speed it was changing at
// decayed to nothing), so taking the figure back does not snap it. The feet
// let go of what they held before the pause: the figure has moved since.
resume(a: *Animator, seconds: float) {
    if a == null || !a.paused { return }
    a.paused = false
    if a.feet != null { ikrig.feet_reset(a.feet as *Feet) }
    springs.reset(a.springs as *Springs)
    s = state_at(a, a.current)
    if s == null || !a.drawn || seconds <= 0.0 { return }
    sample_state(a, s, a.work)
    sample_ahead(a, s, a.work2)
    inertialize(a, a.out, a.before, a.work, a.work2, seconds)
}

// The pose drawn now taken as a paused animator's last two frames, still:
// what resume and play ease out of. For a writer that moves the figure
// between steps and draws it again where it is (a get-up's object put
// under a body lying still, ae3d.character's get_up): read only at the next
// step, the last frame was the pose about where the object had been, and a
// test had to step its engine twice before playing the get-up.
read_drawn(a: *Animator) {
    if a == null || !a.paused { return }
    r = a.rig as *pose.Rig
    pose.read(r, a.out)
    pose.copy(r, a.out, a.before)
    pose.copy(r, a.out, a.graph_out)
    pose.copy(r, a.out, a.graph_before)
    a.drawn = true
}

// The figure taken over from another drawer by a snapshot of what it drew:
// `now` this frame and `before` the frame `dt` seconds earlier (poses on
// this rig). `state` plays from `at` (its clock, cycle_time) and the
// difference between the snapshot and it, and the speed that difference was
// changing at, ease out over `seconds` as a transition's do. A crowd
// figure handed to its full graph (ae3d.animlod) is drawn from the bank's
// two poses about its phase, so the first frame the graph draws goes on
// from the crowd's last at the speed the crowd's was moving.
take_over(a: *Animator, now: ptr, before: ptr, dt: float, state: int, at: float, seconds: float) {
    if a == null || now == null || before == null { return }
    r = a.rig as *pose.Rig
    pose.copy(r, now, a.out)
    pose.copy(r, before, a.before)
    pose.copy(r, now, a.graph_out)
    pose.copy(r, before, a.graph_before)
    if dt > 0.0 { a.dt_before = dt }
    a.paused = false
    a.ahead = 0.0
    a.span = 0.0
    a.blend_t = 0.0
    a.blend_time = 0.0
    a.fade_from = 0 - 1
    a.lod_known = false
    if a.feet != null { ikrig.feet_reset(a.feet as *Feet) }
    springs.reset(a.springs as *Springs)
    a.evaluated = true
    // The state eased into at the parameters it will play at (a gait blend's
    // velocity), not the ones it last played at.
    apply_bindings(a)
    play_at(a, state, at, seconds)
}

// --- the cost of a figure -------------------------------------------------------------------

// The graph evaluated one fixed step in `every` (1 every step, the
// default), as Unreal's update-rate optimisation and its animation budget
// allocator run a distant figure's: evaluated ahead to the last step it
// serves, each step drawn between that and the pose before, so the step is
// drawn at its own time (and a frame between two steps between theirs).
// "Frame" below is such a step. `phase` (0 to every - 1) puts this figure's evaluations on other
// frames than another's of the same rate: N figures at every 4 are N / 4
// evaluations a frame, not N every fourth frame. The rate changes without a
// jump either way (the interval under way is finished first).
set_every(a: *Animator, every: int, phase: int) {
    if a == null { return }
    n = every
    if n < 1 { n = 1 }
    if n == a.every { return }
    a.every = n
    a.lod_phase = 0
    if n > 1 {
        p = phase
        while p < 0 { p = p + n }
        a.lod_phase = p - (p / n) * n
    }
}

update_every(a: *Animator) -> int {
    if a == null { return 1 }
    return a.every
}

// Seconds an evaluation of the graph has taken, averaged over about the last
// ten (its feet's ground rays, aims, look and hands among them).
graph_cost(a: *Animator) -> float {
    if a == null { return 0.0 }
    return a.cost
}

// --- a frame's cost by system -----------------------------------------------------------------------

// Where a figure's frame goes, system by system, as UE's stat anim and
// Unity's profiler markers split it: nanoseconds summed over every figure
// evaluated since profile_reset, while profile is on (off, a section costs a
// branch). The sections of ae3d.character's own step are added here too
// (profile_add), so one table holds the figure's frame. Read on one thread:
// figures evaluated on workers (evaluate_step_all) are summed into the same
// table without a lock, so a profile is taken on one.
const PROF_GRAPH = 0               // bindings, transitions, the clocks, the states' samples and blends
const PROF_INERTIA = 1             // a transition's offsets decayed
const PROF_LAYERS = 2              // layers, aim poses, lift, root motion
const PROF_WORLD = 3               // the pose into the rig's space for the solvers
const PROF_FEET = 4                // ikrig's feet, their ground rays among them
const PROF_LOOK = 5                // the look and the eyes
const PROF_REST = 6                // face, body reach, hands, aim's IK
const PROF_APPLY = 7               // the pose written to the joints, or drawn between two
const PROF_POSTS = 8               // the steps after the graph
const PROF_MOVER = 9               // ae3d.character: the mover's step
const PROF_STEER = 10              // ae3d.character: the steering round the others
const PROF_CHARACTER = 11          // ae3d.character: the rest of its step (uses, acts, the look's point)
const PROF_SECTIONS = 12

var g_prof_on = false
var g_prof: ptr = null             // long[PROF_SECTIONS]

profile(on: bool) {
    if g_prof == null { g_prof = calloc(PROF_SECTIONS, 8) }
    g_prof_on = on
}

profile_reset() {
    if g_prof == null { return }
    p = g_prof as long[]
    k = 0
    while k < PROF_SECTIONS {
        p[k] = 0
        k = k + 1
    }
}

// The clock when profiling, 0 when not: what a section's start reads.
profile_now() -> long {
    if !g_prof_on { return 0 }
    return os.now_monotonic_ns()
}

// The time since `began` (profile_now) added to `section`; the clock now,
// the next section's start.
profile_add(section: int, began: long) -> long {
    if !g_prof_on { return 0 }
    now = os.now_monotonic_ns()
    p = g_prof as long[]
    p[section] = p[section] + (now - began)
    return now
}

profile_seconds(section: int) -> float {
    if g_prof == null || section < 0 || section >= PROF_SECTIONS { return 0.0 }
    return ((g_prof as long[])[section] as float) * 0.000000001
}

const PROF_NAMES[] = ["graph: states sampled and blended", "inertialization", "layers, aims, lift, root motion", "pose to rig space",
                      "feet (ikrig, ground rays)", "look and eyes", "face, body, hands, aim IK", "pose written or drawn between",
                      "steps after the graph", "mover", "steering", "character's own step"]

profile_name(section: int) -> string {
    if section < 0 || section >= PROF_SECTIONS { return "" }
    return PROF_NAMES[section]
}

// --- a state's cycle --------------------------------------------------------------------------

// State `state`'s pose at `at` on its clock (a take's seconds, a blend's
// phase) into `out`, the graph's own: no layers, aims or feet, and its
// clock left where it is. What a crowd's pose bank is baked from.
state_sample(a: *Animator, state: int, at: float, out: ptr) {
    s = state_at(a, state)
    if s == null || out == null { return }
    keep = s.time
    s.time = at
    sample_state(a, s, out)
    s.time = keep
}

// The take a take's or a matcher's state plays now.
cycle_take(s: *State) -> *Take {
    if s.kind == STATE_MATCH { return matched_take(s) }
    return list.get_raw(s.takes, 0) as *Take
}

// Seconds a cycle of `state` takes as it would play now: a take's length at
// its rate, a blend's cycle at the pace its parameter sets.
state_cycle(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    rate = core.abs_of(s.rate)
    if rate < 0.000001 { return 0.0 }
    if s.kind == STATE_TAKE || s.kind == STATE_MATCH {
        return clips.duration(cycle_take(s)) / rate
    }
    if s.kind != STATE_BLEND && s.kind != STATE_BLEND2 { return 0.0 }
    blend_weights(s)
    cycle = blend_cycle(s)
    if cycle <= 0.0 { return 0.0 }
    return cycle / (blend_pace(s, cycle) * rate)
}

// Its speed over the ground as it would play now, metres a second.
state_speed(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    if s.kind == STATE_TAKE || s.kind == STATE_MATCH {
        return clips.speed(cycle_take(s)) * core.abs_of(s.rate)
    }
    if s.kind != STATE_BLEND && s.kind != STATE_BLEND2 { return 0.0 }
    blend_weights(s)
    cycle = blend_cycle(s)
    if cycle <= 0.0 { return 0.0 }
    return blend_speed(s, cycle) * blend_pace(s, cycle) * core.abs_of(s.rate)
}

// The clock of `state` (play_at's `at`) at `phase` of its cycle, 0 to 1
// from the clock's zero; and the phase its clock is at now.
cycle_time(a: *Animator, state: int, phase: float) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    if s.kind == STATE_TAKE || s.kind == STATE_MATCH {
        return phase * clips.duration(cycle_take(s))
    }
    return phase
}

cycle_phase(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 0.0 }
    if s.kind == STATE_TAKE || s.kind == STATE_MATCH {
        length = clips.duration(cycle_take(s))
        if length <= 0.0 { return 0.0 }
        p = s.time / length
        return p - floor_of(p)
    }
    if s.kind == STATE_POSE { return 0.0 }
    return s.time - floor_of(s.time)
}

// A take its owner keeps, used by this animator too and not freed with it.
// Retargeted once for a rig, one take serves every figure on that rig: a
// camp's settlers each retargeting eight captures per walk paid for its own
// copy every time. Null when the take was made for a rig of another size.
// Its owner frees it after every animator using it. Root motion taken out
// when `root`, once for all of them.
share_take(a: *Animator, t: *Take, root: bool) -> *Take {
    if a == null || t == null { return null }
    r = a.rig as *pose.Rig
    if t.count != pose.count(r) { return null }
    if root && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
    return t
}

// The steps after the graph, in the order added (add_post).
run_posts(a: *Animator) {
    k = 0
    while k < list.size(a.posts) {
        step = list.get_raw(a.posts, k) as *Post
        step.run(step.state, a)
        k = k + 1
    }
}

// Its graph evaluated in the step's animation group (`on`,
// engine.FIXED_ANIMATION): after the game's scripts and before the
// physics, as Unity's animators that animate physics are, so the bodies a
// figure's pose drives (ae3d.physanim) are stepped toward this step's pose,
// not the last step's; while another writer has it (pause), read back at
// the step too. Off, as by default, it is evaluated after the step's
// physics (engine.FIXED_POSE). At the fixed step either way; its steps
// after the graph run in the pose phase, after the physics.
set_fixed(a: *Animator, on: bool) {
    if a == null || a.fixed == on { return }
    a.fixed = on
    a.batched = false
    b = a.stepper as *Behaviour
    if b == null { return }
    b.fixed_group = engine.FIXED_POSE
    if on { b.fixed_group = engine.FIXED_ANIMATION }
}

fixed(a: *Animator) -> bool { return a != null && a.fixed }

// The graph a fixed step on (#985): its clocks, transitions, root motion,
// feet locks and solves in the steps' time, the time the capsule and the
// mover move in. Posed once a frame with the frame's length, a figure on a
// display that ran zero, one or two steps a frame had its pose and its
// capsule disagree, and its toes skated up to 43 mm in the people plaza
// (3 on a fixed tick). The pose each step draws is kept with the one before,
// for the frames between (animator_pose).
animator_fixed(state: ptr, e: *Engine, step: float) {
    a = state as *Animator
    // Another writer's figure is read back as it draws it, in the pose phase.
    if a.paused && !a.fixed { return }
    // The step group's animators evaluated together on the job pool at the
    // first one's turn: their graphs on the workers, each pose written at
    // its own turn, on this thread (a joint moved in a fixed step is noted
    // for drawing between steps, in one list).
    if first_in_step(a) { evaluate_step_all(a.engine as *Engine, step, a.fixed) }
    a.framed = false
    a.stepping = true
    if a.batched {
        a.batched = false
        evaluate_write(a, a.batch_kind, step)
    } else {
        evaluate(a, step)
    }
    a.stepping = false
    r = a.rig as *pose.Rig
    kept = a.step_before
    a.step_before = a.step_now
    a.step_now = kept
    pose.copy(r, pose_shown(a), a.step_now)
    if a.steps_drawn < 2 { a.steps_drawn = a.steps_drawn + 1 }
}

// --- the fixed step on the job pool ------------------------------------------------------------------

// The engine's animators evaluated on its job pool (ae3d.jobs), as UE5's
// and Unity's animation runs on worker threads: each figure's graph, its
// IK and its pose are its own, and its feet read the static world by rays
// that only read it (no physics runs while they are evaluated: the step's
// physics is before the pose group and after the animation group). Each
// step group's animators (set_fixed's before the physics, the rest after
// it) at the first one's turn in the step, its pose written to its joints
// at its own turn, on this thread. Not one:
//   - paused (another writer's), which keeps its turn;
//   - moved by its root motion, whose capsule moves in the physics world
//     as its graph is evaluated, before its feet are solved;
//   - between evaluations at a slower rate (set_every), which moves its
//     object to where it will be drawn as it is evaluated.
// Every figure's evaluation reads only its own state and the static world,
// so the poses are the same to the bit whatever the pool's size, and the
// same with no pool (the loop then runs here, in order).
var g_animators: ptr = null        // list of every *Animator attached
var g_batch: ptr = null            // ptr[g_batch_room]: the step group's animators
var g_batch_room = 0
var g_on_pool = true               // on_pool

struct BatchPass {
    animators: ptr                 // ptr[count]
    dt: float
}

// Off, a step group's animators are evaluated together on this thread
// alone, in the same order to the same poses: what a profile (profile) is
// taken on, and what the pool is measured against. On by default.
on_pool(on: bool) { g_on_pool = on }

// Whether `a` is the first animator of its engine's step group (set_fixed's
// or the rest) to take its turn.
first_in_step(a: *Animator) -> bool {
    k = 0
    while k < list.size(g_animators) {
        o = list.get_raw(g_animators, k) as *Animator
        if o.engine == a.engine && o.fixed == a.fixed && (o.fixed || !o.paused) && o.stepper != null && (o.stepper as *Behaviour).enabled { return o == a }
        k = k + 1
    }
    return false
}

step_batched_now(a: *Animator, e: *Engine, fixed: bool) -> bool {
    if a.engine != e as ptr || a.fixed != fixed || a.paused || a.root_motion || !every_frame_now(a) { return false }
    b = a.stepper as *Behaviour
    return b != null && b.enabled
}

evaluate_step_all(e: *Engine, step: float, fixed: bool) {
    count = list.size(g_animators)
    if count > g_batch_room {
        if g_batch != null { free(g_batch) }
        g_batch_room = count * 2
        g_batch = calloc(g_batch_room, 8)
    }
    chosen = g_batch as ptr[]
    n = 0
    k = 0
    while k < count {
        a = list.get_raw(g_animators, k) as *Animator
        if a.engine == e as ptr && a.fixed == fixed { a.batched = false }
        if step_batched_now(a, e, fixed) {
            chosen[n] = a as ptr
            n = n + 1
        }
        k = k + 1
    }
    if n == 0 { return }
    pass = BatchPass { animators: g_batch, dt: step }
    if g_on_pool {
        jobs.parallel_for(evaluate_step_block, n, 1, (&pass) as ptr)
    } else {
        evaluate_step_block(0, n, 0, (&pass) as ptr)
    }
}

evaluate_step_block(start: int, end: int, worker: int, context: ptr) {
    pass = context as *BatchPass
    chosen = pass.animators as ptr[]
    k = start
    while k < end {
        a = chosen[k] as *Animator
        a.batch_kind = evaluate_graph_now(a, pass.dt)
        a.batched = true
        k = k + 1
    }
}

// The pose the graph drew this frame: what it goes on from next frame.
pose_now(a: *Animator) -> ptr { return a.out }

// The graph's own pose this frame, its states and blends as they play,
// before the layers, aims, lift, feet and hands go on: what its takes have
// the figure do. A two-handed item lines its handle up along it, the
// blend's hands and not one take's (#959).
pose_graph(a: *Animator) -> ptr { return a.graph_out }

// The pose this frame as the hands' solve began: the graph's with its
// layers, aims, lift, feet, look and body reach on, the hands not yet on
// what they hold (pose_now where the figure has no hands). Where a held
// item's second hand is put from: a bowl's carry pose is a layer over the
// arms, and lined up along the graph's own pose (a seated take's hands on
// its thighs) the second grip was 145 mm past where that hand could reach.
pose_unheld(a: *Animator) -> ptr {
    if a.unheld != null { return a.unheld }
    return a.out
}

// The pose drawn this frame: the graph's (pose_now), or what a step after
// it drew (show); on a frame drawn between two steps, between their two
// poses as the joints are drawn. What follows the figure as it is seen
// reads it: a held item, a meter.
pose_shown(a: *Animator) -> ptr {
    // In the pose phase and after it: a step reads the steps' own pose.
    if a.framed && core.interp_frame() >= 0.0 { return a.frame_shown }
    if a.showing { return a.shown }
    return a.out
}

// A step after the graph: `run(state, a)` every frame once the graph has
// posed the figure, in the order added, as Unreal's post-process animation
// runs after its graph. What it draws is shown (show), not the pose the
// graph goes on from: its inertialization, its matcher and its feet carry on
// from pose_now. Drawn back into it, a walker struck in the chest
// (ae3d.physanim) walked on from the blow's pose, 1.7 rad off a twin's, and
// a knee turned 87 rad/s. Not run while paused: the figure is another
// writer's.
add_post(a: *Animator, run: fn(ptr, *Animator), state: @keep ptr) {
    if a == null || run == null { return }
    step = heap.new(Post)
    step.run = run
    step.state = state
    list.add_raw(a.posts, step as ptr)
}

// The steps after the graph added with `state`, taken off.
remove_post(a: *Animator, state: ptr) {
    if a == null { return }
    i = list.size(a.posts) - 1
    while i >= 0 {
        step = list.get_raw(a.posts, i) as *Post
        if step.state == state {
            heap.free(step)
            list.remove(a.posts, i)
        }
        i = i - 1
    }
}

// The figure's joints as a step after the graph has drawn them, read back
// as this frame's pose shown (pose_shown).
show(a: *Animator) {
    if a == null { return }
    pose.read(a.rig as *pose.Rig, a.shown)
    a.showing = true
    a.framed = false
}

// The root's motion over the step put on the figure's object: its travel
// turned into the world through the armature the rig hangs from, and its
// turn about the world's up. A figure with a character controller
// (physics.character_controller) is moved by its capsule: the travel asked
// as that step's velocity, so a wall stops it and a kerb lifts it, and what
// it moved is what the capsule went. One with none is set where the travel
// puts it.
move_object(a: *Animator, d: Vec3, dt: float) {
    o = a.object as *GameObject
    r = a.rig as *pose.Rig
    capsule = physics.character_of(o)
    if d.x == 0.0 && d.y == 0.0 && d.z == 0.0 {
        if capsule != null && dt > 0.0 { physics.character_move(capsule, core.vec3(0.0, 0.0, 0.0), 0.0, dt) }
        a.moved = d
        return
    }
    base = pose.base_model(r)
    step = core.vec3(d.x, 0.0, d.y)
    if base != null {
        core.model_sync_transform(base)
        s = base.world_scale
        step = core.quat_apply(base.world_rotation, core.vec3(d.x * s.x, 0.0, d.y * s.z))
    } else {
        step = core.quat_apply(behaviour.object_rotation(o), step)
    }
    step = core.vec3(step.x, 0.0, step.z)
    at = behaviour.object_position(o)
    if capsule != null && dt > 0.0 {
        physics.character_move(capsule, core.v3_mul(step, 1.0 / dt), 0.0, dt)
        went = core.v3_sub(behaviour.object_position(o), at)
        step = core.vec3(went.x, 0.0, went.z)
    } else {
        behaviour.object_set_position(o, core.v3_add(at, step))
    }
    if d.z != 0.0 {
        q = core.quat_normalize(core.quat_mul(core.quat_rotate(d.z, core.vec3(0.0, 1.0, 0.0)), behaviour.object_rotation(o)))
        behaviour.object_set_rotation(o, q)
    }
    a.moved = core.vec3(step.x, step.z, d.z)
}

// State `state`'s clock set to `seconds` (a blend's phase, 0 to 1): what a
// game playing a start or a stop by distance sets each frame, its rate 0.
set_time(a: *Animator, state: int, seconds: float) {
    s = state_at(a, state)
    if s != null { s.time = seconds }
}

// State `state` (a take with root motion) played by distance: its clock the
// time its root has gone parameter `title` metres along its path, or, when
// `left`, the time `title` metres are left before its end. A start played
// by the distance the figure has come, a stop by the distance to where it
// comes to rest (Paragon's distance matching, GDC 2016): its feet plant
// where the clip planted them, whatever the figure's braking. From the
// frame it is entered.
clock_by(a: *Animator, state: int, title: string, left: bool) {
    s = state_at(a, state)
    if s == null { return }
    s.clock = param_index(a, title, true)
    s.clock_left = left
}

// State `state`'s distance come (clock_by, not `left`) counted from `at`
// seconds into its take, not from its first frame: a start take that stands
// before it moves off is entered at its move-off, the frame drawn first the
// stand just before it moves, and its stand is never raced through. Counted
// from its first frame, the people's StartStop start (a stand of 0.3 s, its
// root swaying a few millimetres, before its move-off) played its stand in a
// frame or two as the figure set off, and its clock ran up to 28 times its
// pace; held to its pace instead (a7bed32e), the take fell 0.26 s behind the
// figure within the stand and handed over to the walk mid-stand, and the
// walk's first step lunged 0.69 m (#937).
clock_from(a: *Animator, state: int, at: float) {
    s = state_at(a, state)
    if s == null || s.kind != STATE_TAKE { return }
    t = list.get_raw(s.takes, 0) as *Take
    s.clock_zero = core.clampf(at, 0.0, clips.duration(t))
    s.clock_zero_d = clips.distance_at(t, s.clock_zero)
}

// The pace, metres a second, of the take the current state plays by the
// distance come (a start, clock_by not `left`) where its clock is now: what
// a mover keeps a start to (mover.set_start_pace) so the take plays at its
// own pace. -1 when the current state is not played so.
clock_pace(a: *Animator) -> float {
    s = state_at(a, a.current)
    if s == null || s.kind != STATE_TAKE || s.clock < 0 || s.clock_left { return 0.0 - 1.0 }
    return clips.speed_at(list.get_raw(s.takes, 0) as *Take, s.time)
}

distance_time(a: *Animator, s: *State) -> float {
    t = list.get_raw(s.takes, 0) as *Take
    d = param_at(a, s.clock).value
    at = clips.time_at_distance(t, d)
    if s.clock_left { at = clips.time_at_distance_left(t, d) }
    if !s.clock_left && s.clock_zero > 0.0 {
        at = clips.time_at_distance(t, s.clock_zero_d + d)
        if at < s.clock_zero { at = s.clock_zero }
    }
    if s.offset == 0.0 { return at }
    // A matched entry's offset, fading as the distance it had runs out, so
    // the take still ends where the distance does.
    f = 0.0
    if s.offset_room > 0.000001 { f = core.clampf(clock_room(a, s) / s.offset_room, 0.0, 1.0) }
    least = 0.0
    if !s.clock_left { least = s.clock_zero }
    return core.clampf(at + s.offset * f, least, clips.duration(t))
}

// The distance state `s`'s clock has yet to run: the distance left, or what
// is left of its take's travel from the distance gone.
clock_room(a: *Animator, s: *State) -> float {
    t = list.get_raw(s.takes, 0) as *Take
    d = param_at(a, s.clock).value
    if s.clock_left { return d }
    room = clips.travel_length(t) - s.clock_zero_d - d
    if room < 0.0 { room = 0.0 }
    return room
}

// Transition `tr` enters its state (or the one of its others, transition_or)
// at the time whose feet best match the pose drawn: within `window` seconds
// of where it would enter (a take played by distance: where the distance
// puts it, the offset then fading as the distance runs out, so it still ends
// where the distance does), or anywhere in a loop. A drift from where it
// would enter costs MATCH_DRIFT at the window's edge. Played by the distance
// left alone, a stop entered with its planted foot 47 cm from the walk's,
// and the lock let it go (Siltreach's arrivals, 383 to 586 mm); a stand
// entered at its first frame after a stop moved a locked foot 25 cm.
transition_match(a: *Animator, tr: int, window: float) {
    if tr < 0 || tr >= list.size(a.transitions) { return }
    (list.get_raw(a.transitions, tr) as *Transition).window = window
}

// Transition `tr` enters its state in step: at the stride phase the state
// it leaves is at (play_synced), so a gait hands its feet over where they
// are in the stride. Entered at its first frame, the walk taking over from
// a start put the planted foot a third of a metre from where the start had
// it, and the lock held it there and let go.
transition_synced(a: *Animator, tr: int, on: bool) {
    if tr < 0 || tr >= list.size(a.transitions) { return }
    (list.get_raw(a.transitions, tr) as *Transition).synced = on
}

// Transition `tr` may go to `state` instead of its own, whichever of them
// enters with its feet nearer where they are now, and down where they are
// down now (pose matching at a transition): a stop and its mirror, one for
// each foot, as Paragon picked its stops by the foot down. One stop for
// both feet entered with its planted foot a third of a metre from the
// walk's, and the lock let go.
transition_or(a: *Animator, tr: int, state: int) {
    if tr < 0 || tr >= list.size(a.transitions) { return }
    t = list.get_raw(a.transitions, tr) as *Transition
    if t.others == null { t.others = calloc(8, 4) }
    if t.other_count >= 8 { return }
    (t.others as int[])[t.other_count] = state
    t.other_count = t.other_count + 1
}

// The state transition `t` goes to: its own, or of its others the one whose
// feet (balls and ankles about the root, in the rig's space) at the time it
// would enter lie nearest the pose drawn now's.
best_target(a: *Animator, t: *Transition) -> int {
    if t.other_count == 0 && t.window <= 0.0 { return t.to }
    r = a.rig as *pose.Rig
    pose.world(r, a.out, a.worlds)
    best = t.to
    best_cost = 1000000000.0
    best_time = 0.0 - 1.0
    k = 0 - 1
    while k < t.other_count {
        candidate = t.to
        if k >= 0 { candidate = (t.others as int[])[k] }
        s = state_at(a, candidate)
        if s != null && t.window > 0.0 && s.kind == STATE_TAKE {
            take = list.get_raw(s.takes, 0) as *Take
            s.offset = 0.0
            nominal = 0.0
            if s.clock >= 0 { nominal = distance_time(a, s) }
            lo = nominal - t.window
            hi = nominal + t.window
            whole = s.loop && s.clock < 0
            if whole {
                lo = 0.0
                hi = clips.duration(take)
            }
            if lo < 0.0 { lo = 0.0 }
            // A take played by the distance come is not entered before
            // where its distance counts from (clock_from): there it would
            // stand while the figure moves.
            if s.clock >= 0 && !s.clock_left && lo < s.clock_zero { lo = s.clock_zero }
            if hi > clips.duration(take) { hi = clips.duration(take) }
            at = lo
            while at <= hi + 0.000001 {
                cost = feet_cost_at(a, candidate, at)
                if !whole { cost = cost + MATCH_DRIFT * core.abs_of(at - nominal) / t.window }
                if cost < best_cost {
                    best_cost = cost
                    best = candidate
                    best_time = at
                }
                at = at + MATCH_STEP
            }
        } else if s != null {
            cost = feet_cost(a, candidate)
            if cost < best_cost {
                best_cost = cost
                best = candidate
                best_time = 0.0 - 1.0
            }
        }
        k = k + 1
    }
    if best_time >= 0.0 {
        s = state_at(a, best)
        if s.clock >= 0 {
            // Its distance clock entered `best_time - nominal` ahead, the
            // offset fading as the distance runs out (distance_time).
            s.offset = 0.0
            s.offset = best_time - distance_time(a, s)
            s.offset_room = clock_room(a, s)
        } else {
            s.entry_at = best_time
        }
        s.chosen = true
    }
    return best
}

// How far state `state`'s feet, as it would enter now, lie from the feet of
// the pose drawn now (a.worlds, already placed): squared metres.
feet_cost(a: *Animator, state: int) -> float {
    s = state_at(a, state)
    if s == null { return 1000000.0 }
    at = s.time
    if s.kind == STATE_TAKE {
        at = 0.0
        if s.clock >= 0 { at = distance_time(a, s) }
    }
    return feet_cost_at(a, state, at)
}

// As feet_cost, the state entered `at` seconds in (a take's time, a blend's
// phase).
feet_cost_at(a: *Animator, state: int, at: float) -> float {
    s = state_at(a, state)
    if s == null { return 1000000.0 }
    r = a.rig as *pose.Rig
    keep = s.time
    s.time = at
    entry = at
    sample_state(a, s, a.work)
    s.time = keep
    pose.world(r, a.work, a.work2)
    slots = [pose.FOOT_L, pose.BALL_L, pose.FOOT_R, pose.BALL_R]
    root = pose.human(r, pose.ROOT)
    if root < 0 { root = pose.human(r, pose.PELVIS) }
    cost = 0.0
    k = 0
    while k < 4 {
        j = pose.human(r, slots[k])
        if j >= 0 && root >= 0 {
            now = core.v3_sub(pose.translation(a.worlds, j), pose.translation(a.worlds, root))
            then = core.v3_sub(pose.translation(a.work2, j), pose.translation(a.work2, root))
            d = core.v3_sub(now, then)
            cost = cost + core.v3_dot(d, d)
        }
        k = k + 1
    }
    // A foot down now and up in the state as it would enter costs as much as
    // its feet 25 cm off: entered so, a walk's planted foot was
    // the stop's swinging one and was dragged along the ground at 6 m/s
    // until the stop lifted it (Siltreach's arrivals, 383 to 575 mm).
    if s.kind == STATE_TAKE {
        t = list.get_raw(s.takes, 0) as *Take
        side = 0
        while side < 2 {
            down_now = contact_weight(a, side) >= 0.5
            down_then = clips.contact(t, side, entry, clips.looping(t))
            if down_now && !down_then { cost = cost + FOOT_DOWN_COST }
            side = side + 1
        }
    }
    return cost
}

// --- motion warping -----------------------------------------------------------------------------

// State `state` (playing now, its root motion moving the figure:
// set_root_motion) warped so that `until` seconds into it the figure's part
// in humanoid slot `slot` (pose.PELVIS on a seat, pose.HAND_R on a grip) is
// at `point`, the figure facing `facing` (level): UE5's Motion Warping,
// skew-warped. Where the part is about the root then is the take's own; the
// root's motion over the rest of the way is the take's plus, each step, a
// share of what the take lacks: as much of it as the take travels in that
// step of what it has left to travel, or of the time left where it hardly
// travels (a take with no root motion leaves all of it to the warp). So the
// part lands on the point at that time, and not before. The way it faces is
// turned the same way, by the time. For a pelvis, the height the take does
// not give is a lift eased in over the same time (lift_to), the feet kept
// where they stand by their locks: a lower seat bends the knees further, a
// higher one less.
warp(a: *Animator, state: int, until: float, point: Vec3, facing: Vec3, slot: int) {
    s = state_at(a, state)
    if s == null || s.kind != STATE_TAKE { return }
    r = a.rig as *pose.Rig
    o = a.object as *GameObject
    j = pose.human(r, slot)
    if j < 0 || o == null { return }
    t = list.get_raw(s.takes, 0) as *Take
    lands_at = core.clampf(until, s.time, clips.duration(t))
    clips.sample(t, r, lands_at, false, a.work3)
    pose.world(r, a.work3, a.worlds)
    part = clips.ground_point(r, pose.translation(a.worlds, j))
    at = behaviour.object_position(o)
    yaw_now = yaw_of(behaviour.object_rotation(o))
    // The part about the object then, in the object's frame: the take plays
    // in place about its root, so as it would stand now.
    off = core.v3_sub(part, at)
    local = core.quat_apply(core.quat_rotate(0.0 - yaw_now, core.vec3(0.0, 1.0, 0.0)), core.vec3(off.x, 0.0, off.z))
    yaw = yaw_now
    if core.v3_len(core.vec3(facing.x, 0.0, facing.z)) > 0.0001 { yaw = core.atan2_of(facing.x, facing.z) }
    there = core.v3_sub(point, core.quat_apply(core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)), local))
    a.warp_root = core.vec3(there.x, at.y, there.z)
    a.warp_yaw = yaw
    a.warp_until = lands_at
    a.warp_state = state
    if slot == pose.PELVIS { lift_to(a, a.lift + point.y - part.y, lands_at - s.time) }
}

// No warp: the state's root motion as it is.
warp_off(a: *Animator) { a.warp_state = 0 - 1 }

// Whether a warp is still bending the motion.
warping(a: *Animator) -> bool { return a.warp_state >= 0 }

// The pelvis raised `goal` metres (lowered, below 0) from where the take
// has it, eased there over `seconds` from where it is now; the feet held
// where they stand (their locks), the legs bending to keep them.
lift_to(a: *Animator, goal: float, seconds: float) {
    a.lift_from = a.lift
    a.lift_goal = goal
    a.lift_t = 0.0
    a.lift_time = seconds
    if a.lift_time < 0.0001 { a.lift_time = 0.0001 }
}

lift_now(a: *Animator) -> float { return a.lift }

// A step of root motion `moved` (from `from` seconds into `s`) bent by the
// warp (see warp), in the same frame: the root's at `from`, x across, z
// ahead, and the turn.
warp_step(a: *Animator, s: *State, from: float, moved: Vec3) -> Vec3 {
    if a.warp_state < 0 || !a.root_motion || state_at(a, a.warp_state) != s { return moved }
    if from >= a.warp_until {
        a.warp_state = 0 - 1
        return moved
    }
    r = a.rig as *pose.Rig
    o = a.object as *GameObject
    t = list.get_raw(s.takes, 0) as *Take
    left = core.vec3(0.0, 0.0, 0.0)
    if clips.has_root_motion(t) { left = clips.root_delta(t, from, a.warp_until, false) }
    at = behaviour.object_position(o)
    need_world = core.vec3(a.warp_root.x - at.x, 0.0, a.warp_root.z - at.z)
    need = need_world
    base = pose.base_model(r)
    if base != null {
        core.model_sync_transform(base)
        sc = base.world_scale
        local = core.quat_apply(core.quat_conjugate(base.world_rotation), need_world)
        need = core.vec3(local.x / sc.x, 0.0, local.z / sc.z)
    } else {
        need = core.quat_apply(core.quat_conjugate(behaviour.object_rotation(o)), need_world)
    }
    span = a.warp_until - from
    gone = s.time
    if gone > a.warp_until { gone = a.warp_until }
    by_time = core.clampf((gone - from) / span, 0.0, 1.0)
    by_travel = by_time
    left_len = core.sqrt_of(left.x * left.x + left.y * left.y)
    if left_len > WARP_TRAVEL { by_travel = core.clampf(core.sqrt_of(moved.x * moved.x + moved.y * moved.y) / left_len, 0.0, 1.0) }
    if by_time >= 1.0 { by_travel = 1.0 }
    turn_need = wrap_turn(a.warp_yaw - yaw_of(behaviour.object_rotation(o)))
    d = core.vec3(moved.x + (need.x - left.x) * by_travel, moved.y + (need.z - left.y) * by_travel, moved.z + wrap_turn(turn_need - left.z) * by_time)
    if s.time >= a.warp_until { a.warp_state = 0 - 1 }
    return d
}

// The lift eased on by `dt` and laid on the pelvis of pose `p` (local).
apply_lift(a: *Animator, p: ptr, dt: float) {
    if a.lift_t < a.lift_time {
        a.lift_t = a.lift_t + dt
        u = core.clampf(a.lift_t / a.lift_time, 0.0, 1.0)
        e = u * u * (3.0 - 2.0 * u)
        a.lift = a.lift_from + (a.lift_goal - a.lift_from) * e
    }
    // The feet kept where the take puts them over the ground (ikrig.feet_set_raise).
    if a.feet != null { ikrig.feet_set_raise(a.feet as *Feet, 0.0 - a.lift) }
    if core.abs_of(a.lift) < 0.000001 { return }
    r = a.rig as *pose.Rig
    j = pose.human(r, pose.PELVIS)
    if j < 0 { return }
    pose.world(r, p, a.worlds)
    up = ikrig.dir_to_rig(r, core.vec3(0.0, a.lift, 0.0))
    parent = pose.parent(r, j)
    if parent >= 0 {
        ps = pose.scale(a.worlds, parent)
        v = core.quat_apply(core.quat_conjugate(pose.rotation(a.worlds, parent)), up)
        up = core.vec3(v.x / ps.x, v.y / ps.y, v.z / ps.z)
    }
    pose.set_translation(p, j, core.v3_add(pose.translation(p, j), up))
}

// The way a rotation turns +z, radians about up.
yaw_of(q: Quat) -> float {
    f = core.quat_apply(q, core.vec3(0.0, 0.0, 1.0))
    return core.atan2_of(f.x, f.z)
}

wrap_turn(x: float) -> float {
    y = x
    while y > 3.141592653589793 { y = y - 6.283185307179586 }
    while y < 0.0 - 3.141592653589793 { y = y + 6.283185307179586 }
    return y
}

// --- motion matching ----------------------------------------------------------------------------

// A state that plays whichever moment of its takes best fits the pose drawn
// now and the way the figure is asked to go (motion matching: Clavet's,
// GDC 2016, For Honor; Holden's, as Unreal's pose search does it): the
// takes' frames are known by their features, and every MATCH_EVERY seconds
// the frame nearest the query is played, through an inertialized change
// unless it is where the take playing already is. A frame's features, in its
// root's frame (x across to the left, z ahead), each scaled by its spread
// over the database:
//   - each foot's place and velocity about the root, and the hips' velocity;
//   - the way ahead: where the root will be and the way it will face
//     MATCH_AHEAD seconds on (a third, two thirds and a whole), from the
//     take's own root motion (held at its end for a take that stops).
// The query is the playing frame's own pose features and the way ahead a
// game asks for (match_trajectory; ae3d.mover sets it from its springs).
// Each take must have its root motion taken out (animator.take with root,
// or add_take), so its way ahead is known.
add_matcher(a: *Animator, title: string) -> int {
    s = new_state(title, STATE_MATCH)
    m = heap.new(Matcher)
    m.query = calloc(MATCH_TRAJ, 8)
    m.mean = calloc(MATCH_DIM, 8)
    m.spread = calloc(MATCH_DIM, 8)
    s.matcher = m as ptr
    s.loop = false
    list.add_raw(a.states, s as ptr)
    return list.size(a.states) - 1
}

// Take `t` (its root motion taken out) into matcher `state`'s database.
matcher_add(a: *Animator, state: int, t: *Take) {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH || t == null { return }
    make_room(s)
    list.add_raw(s.takes, t as ptr)
    s.count = s.count + 1
}

// Matcher `state`'s features found for every frame of its takes, and their
// spreads: once its takes are in, before it plays.
matcher_build(a: *Animator, state: int) {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH { return }
    r = a.rig as *pose.Rig
    m = s.matcher as *Matcher
    total = 0
    k = 0
    while k < s.count {
        total = total + clips.frames(list.get_raw(s.takes, k) as *Take)
        k = k + 1
    }
    if m.features != null {
        free(m.features)
        free(m.owner)
        free(m.at)
    }
    m.features = calloc(total * MATCH_DIM, 8)
    m.owner = calloc(total, 4)
    m.at = calloc(total, 4)
    m.frames = total
    features = m.features as float[]
    owner = m.owner as int[]
    ats = m.at as int[]
    w = pose.new(r)
    w2 = pose.new(r)
    n = 0
    k = 0
    while k < s.count {
        t = list.get_raw(s.takes, k) as *Take
        f = 0
        while f < clips.frames(t) {
            frame_features(r, t, f, w, w2, features, n * MATCH_DIM)
            owner[n] = k
            ats[n] = f
            n = n + 1
            f = f + 1
        }
        k = k + 1
    }
    pose.release(w)
    pose.release(w2)
    // The spreads: each feature's standard deviation over the database.
    mean = m.mean as float[]
    spread = m.spread as float[]
    d = 0
    while d < MATCH_DIM {
        sum = 0.0
        i = 0
        while i < total {
            sum = sum + features[i * MATCH_DIM + d]
            i = i + 1
        }
        mean[d] = sum / (total as float)
        var2 = 0.0
        i = 0
        while i < total {
            x = features[i * MATCH_DIM + d] - mean[d]
            var2 = var2 + x * x
            i = i + 1
        }
        spread[d] = core.sqrt_of(var2 / (total as float))
        if spread[d] < 0.0001 { spread[d] = 0.0001 }
        d = d + 1
    }
    // Each feature over its spread, the way ahead's by the root of its
    // weight: a frame's cost is then its plain squared distance from the
    // query, and the boxes bound it.
    if m.norm != null {
        free(m.norm)
        free(m.small)
        free(m.large)
    }
    m.norm = calloc(total * MATCH_DIM + 1, 8)
    norm = m.norm as float[]
    i = 0
    while i < total {
        d = 0
        while d < MATCH_DIM {
            norm[i * MATCH_DIM + d] = features[i * MATCH_DIM + d] / spread[d] * match_weight(d)
            d = d + 1
        }
        i = i + 1
    }
    m.small = match_boxes(norm, total, MATCH_SMALL)
    m.large = match_boxes(norm, total, MATCH_LARGE)
    if m.asked == null { m.asked = calloc(MATCH_DIM, 8) }
    m.playing = 0
    s.time = 0.0
}

// Feature `d`'s weight in a frame's cost, as its root: the pose's 1, the
// way ahead's MATCH_WAY.
match_weight(d: int) -> float {
    if d < 14 { return 1.0 }
    return core.sqrt_of(MATCH_WAY)
}

// Each run of `run` frames' least and most of every feature: a box the
// run's frames all lie in.
match_boxes(norm: float[], frames: int, run: int) -> ptr {
    runs = (frames + run - 1) / run
    block = calloc(runs * MATCH_DIM * 2 + 1, 8)
    b = block as float[]
    r = 0
    while r < runs {
        d = 0
        while d < MATCH_DIM {
            low = 1000000000.0
            high = 0.0 - 1000000000.0
            i = r * run
            while i < frames && i < (r + 1) * run {
                x = norm[i * MATCH_DIM + d]
                if x < low { low = x }
                if x > high { high = x }
                i = i + 1
            }
            b[(r * MATCH_DIM + d) * 2] = low
            b[(r * MATCH_DIM + d) * 2 + 1] = high
            d = d + 1
        }
        r = r + 1
    }
    return block
}

// The least cost any frame in run `r`'s box could have against query `q`.
match_bound(box: float[], r: int, q: float[]) -> float {
    cost = 0.0
    d = 0
    while d < MATCH_DIM {
        low = box[(r * MATCH_DIM + d) * 2]
        high = box[(r * MATCH_DIM + d) * 2 + 1]
        x = 0.0
        if q[d] < low { x = low - q[d] }
        if q[d] > high { x = q[d] - high }
        cost = cost + x * x
        d = d + 1
    }
    return cost
}

// Frame `i`'s cost against query `q` (both as `norm` has them), stopped
// once it passes `most`.
match_dist(norm: float[], i: int, q: float[], most: float) -> float {
    cost = 0.0
    row = i * MATCH_DIM
    d = 0
    while d < MATCH_DIM && cost <= most {
        x = norm[row + d] - q[d]
        cost = cost + x * x
        d = d + 1
    }
    return cost
}

// Frame `f` of take `t`'s features into `out` at `at` (see add_matcher).
frame_features(r: *pose.Rig, t: *Take, f: int, w: ptr, w2: ptr, out: float[], at: int) {
    root = pose.human(r, pose.ROOT)
    if root < 0 { root = pose.human(r, pose.PELVIS) }
    feet = [pose.human(r, pose.FOOT_L), pose.human(r, pose.FOOT_R)]
    pelvis = pose.human(r, pose.PELVIS)
    a0 = f - 1
    if a0 < 0 { a0 = 0 }
    b0 = f + 1
    if b0 >= clips.frames(t) { b0 = clips.frames(t) - 1 }
    span = ((b0 - a0) as float) / clips.rate(t)
    pose.world(r, clips.frame(t, a0), w)
    pose.world(r, clips.frame(t, b0), w2)
    // The root's own velocity over the span, in its frame then.
    move = clips.root_delta(t, (a0 as float) / clips.rate(t), (b0 as float) / clips.rate(t), false)
    side = 0
    while side < 2 {
        if feet[side] >= 0 && root >= 0 {
            p0 = core.v3_sub(pose.translation(w, feet[side]), pose.translation(w, root))
            p1 = core.v3_sub(pose.translation(w2, feet[side]), pose.translation(w2, root))
            mid = core.v3_mul(core.v3_add(p0, p1), 0.5)
            out[at + side * 6] = mid.x
            out[at + side * 6 + 1] = mid.y
            out[at + side * 6 + 2] = mid.z
            if span > 0.0 {
                out[at + side * 6 + 3] = (p1.x - p0.x) / span + move.x / span
                out[at + side * 6 + 4] = (p1.y - p0.y) / span
                out[at + side * 6 + 5] = (p1.z - p0.z) / span + move.y / span
            }
        }
        side = side + 1
    }
    if pelvis >= 0 && span > 0.0 {
        h0 = pose.translation(w, pelvis)
        h1 = pose.translation(w2, pelvis)
        out[at + 12] = (h1.x - h0.x) / span + move.x / span
        out[at + 13] = (h1.z - h0.z) / span + move.y / span
    }
    // The way ahead, from the take's root motion.
    now = (f as float) / clips.rate(t)
    ahead = [0.33, 0.67, 1.0]
    k = 0
    while k < 3 {
        d = clips.root_delta(t, now, now + ahead[k], clips.looping(t))
        out[at + 14 + k * 4] = d.x
        out[at + 14 + k * 4 + 1] = d.y
        out[at + 14 + k * 4 + 2] = core.sin_of(d.z)
        out[at + 14 + k * 4 + 3] = core.cos_of(d.z)
        k = k + 1
    }
}

// The way ahead a game asks matcher `state` for, `k` (0, 1, 2) of MATCH_AHEAD
// seconds on: the root's place (x across to the figure's left, z ahead, in
// its frame now) and its facing then (`turn`, radians to the left).
match_trajectory(a: *Animator, state: int, k: int, x: float, z: float, turn: float) {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH || k < 0 || k > 2 { return }
    q = (s.matcher as *Matcher).query as float[]
    q[k * 4] = x
    q[k * 4 + 1] = z
    q[k * 4 + 2] = core.sin_of(turn)
    q[k * 4 + 3] = core.cos_of(turn)
}

// The searches and the changes matcher `state` has made.
matcher_searches(a: *Animator, state: int) -> int {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH { return 0 }
    return (s.matcher as *Matcher).searches
}

matcher_changes(a: *Animator, state: int) -> int {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH { return 0 }
    return (s.matcher as *Matcher).changes
}

// The playing frame's index in matcher `s`'s database.
playing_index(s: *State) -> int {
    m = s.matcher as *Matcher
    playing_t = list.get_raw(s.takes, m.playing) as *Take
    pf = (s.time * clips.rate(playing_t) + 0.5) as int
    if pf >= clips.frames(playing_t) { pf = clips.frames(playing_t) - 1 }
    base = 0
    k = 0
    while k < m.playing {
        base = base + clips.frames(list.get_raw(s.takes, k) as *Take)
        k = k + 1
    }
    return base + pf
}

// The frame of matcher `s`'s database nearest its query now, or -1: the
// playing frame's pose features and the game's way ahead (match_cost's,
// as `norm` has them). The feet down now: a frame is only a candidate with
// each of them down too, within MATCH_FOOT of where it is about the root
// (half the lock's slip, what the lock takes up as the change is
// inertialized; a change to a frame with a planted foot elsewhere drags
// that foot off its lock; a matcher changing into a stop had it a third of
// a metre off). At a take's end, a change forced, any frame when none is.
// Searched as #588's: the playing frame the first best, runs of frames
// whose box is no nearer than the best passed over, a frame's cost stopped
// once it passes the best; of frames as near, the first. `brute` looks at
// every frame and feature: the same frame, for the test to hold it to.
match_best(s: *State, forced: bool, brute: bool) -> int {
    m = s.matcher as *Matcher
    features = m.features as float[]
    spread = m.spread as float[]
    norm = m.norm as float[]
    q = m.query as float[]
    asked = m.asked as float[]
    p = playing_index(s)
    now = p * MATCH_DIM
    d = 0
    while d < MATCH_DIM {
        if d < 14 { asked[d] = norm[now + d] } else { asked[d] = q[d - 14] / spread[d] * match_weight(d) }
        d = d + 1
    }
    playing_t = list.get_raw(s.takes, m.playing) as *Take
    downs = [clips.contact(playing_t, 0, s.time, clips.looping(playing_t)), clips.contact(playing_t, 1, s.time, clips.looping(playing_t))]
    small = m.small as float[]
    large = m.large as float[]
    per = MATCH_LARGE / MATCH_SMALL
    best = 0 - 1
    best_cost = 1000000000.0
    pass = 0
    while pass < 2 && best < 0 {
        if pass == 1 && !forced { pass = 2 }
        if pass < 2 && !brute && (pass == 1 || feet_fit(s, features, now, p, downs)) {
            best = p
            best_cost = match_dist(norm, p, asked, 1000000000.0)
        }
        lr = 0
        while pass < 2 && lr * MATCH_LARGE < m.frames {
            if brute || match_bound(large, lr, asked) <= best_cost {
                sr = lr * per
                while sr < (lr + 1) * per && sr * MATCH_SMALL < m.frames {
                    if brute || match_bound(small, sr, asked) <= best_cost {
                        i = sr * MATCH_SMALL
                        while i < m.frames && i < (sr + 1) * MATCH_SMALL {
                            if pass == 1 || feet_fit(s, features, now, i, downs) {
                                cost = match_dist(norm, i, asked, best_cost)
                                if cost < best_cost || (cost == best_cost && i < best) {
                                    best_cost = cost
                                    best = i
                                }
                            }
                            i = i + 1
                        }
                    }
                    sr = sr + 1
                }
            }
            lr = lr + 1
        }
        pass = pass + 1
    }
    return best
}

// Matcher `state`'s best frame for its query now, without changing to it:
// the box search's, or brute force's (`brute`), for a test to hold one to
// the other and time them. -1 with none.
matcher_find(a: *Animator, state: int, brute: bool) -> int {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH || (s.matcher as *Matcher).frames == 0 { return 0 - 1 }
    return match_best(s, false, brute)
}

// Frames in matcher `state`'s database.
matcher_frames(a: *Animator, state: int) -> int {
    s = state_at(a, state)
    if s == null || s.kind != STATE_MATCH { return 0 }
    return (s.matcher as *Matcher).frames
}

// The best frame for the query: the playing frame's pose features and the
// game's way ahead, against every frame of the database. A change made to
// it, inertialized, unless it is the take playing within MATCH_NEAR.
match_search(a: *Animator, s: *State, forced: bool) {
    m = s.matcher as *Matcher
    if m.frames == 0 { return }
    r = a.rig as *pose.Rig
    features = m.features as float[]
    spread = m.spread as float[]
    q = m.query as float[]
    owner = m.owner as int[]
    ats = m.at as int[]
    now = playing_index(s) * MATCH_DIM
    best = match_best(s, forced, false)
    m.searches = m.searches + 1
    if best < 0 { return }
    best_cost = match_dist(m.norm as float[], best, m.asked as float[], 1000000000.0)
    take_i = owner[best]
    t = list.get_raw(s.takes, take_i) as *Take
    time = (ats[best] as float) / clips.rate(t)
    if take_i == m.playing && core.abs_of(time - s.time) < MATCH_NEAR { return }
    // Played on unless the change is a clear gain: the frame playing's own
    // cost (its pose is the query's, so only its way ahead counts) against
    // the best's. Changed whenever the best was elsewhere, the matcher went
    // into a stop mid-stride with its planted foot a third of a metre off.
    stay = 0.0
    d = 14
    while d < MATCH_DIM {
        x = (q[d - 14] - features[now + d]) / spread[d]
        stay = stay + MATCH_WAY * x * x
        d = d + 1
    }
    if best_cost > stay * MATCH_GAIN { return }
    // The change: from the pose drawn, inertialized.
    m.playing = take_i
    s.time = time
    m.changes = m.changes + 1
    clips.sample(t, r, time, false, a.work)
    clips.sample(t, r, time + a.dt_before, false, a.work2)
    inertialize(a, a.graph_out, a.graph_before, a.work, a.work2, MATCH_BLEND)
}

matcher_free(m: *Matcher) {
    if m == null { return }
    if m.features != null {
        free(m.features)
        free(m.owner)
        free(m.at)
    }
    if m.norm != null {
        free(m.norm)
        free(m.small)
        free(m.large)
    }
    if m.asked != null { free(m.asked) }
    free(m.query)
    free(m.mean)
    free(m.spread)
    heap.free(m)
}

// The take a matcher plays now.
matched_take(s: *State) -> *Take { return list.get_raw(s.takes, (s.matcher as *Matcher).playing) as *Take }

// Matcher `s` searches when MATCH_EVERY has gone since it last did, or its
// take is at its end.
match_due(a: *Animator, s: *State, dt: float) {
    m = s.matcher as *Matcher
    m.since = m.since + dt
    at_end = !clips.looping(matched_take(s)) && s.time >= clips.duration(matched_take(s)) - 0.0001
    if m.since >= MATCH_EVERY || at_end {
        m.since = 0.0
        match_search(a, s, at_end)
    }
}

// Whether frame `i` keeps each foot down now down, within MATCH_FOOT of where
// it is (features at `now`).
feet_fit(s: *State, features: float[], now: int, i: int, downs: bool[]) -> bool {
    m = s.matcher as *Matcher
    t = list.get_raw(s.takes, (m.owner as int[])[i]) as *Take
    at = ((m.at as int[])[i] as float) / clips.rate(t)
    side = 0
    while side < 2 {
        if downs[side] {
            if !clips.contact(t, side, at, clips.looping(t)) { return false }
            dx = features[now + side * 6] - features[i * MATCH_DIM + side * 6]
            dz = features[now + side * 6 + 2] - features[i * MATCH_DIM + side * 6 + 2]
            if dx * dx + dz * dz > MATCH_FOOT * MATCH_FOOT { return false }
        }
        side = side + 1
    }
    return true
}

// --- whole state (#911) -----------------------------------------------------------------------------

// Floats state_write writes for `a` at most.
state_size(a: *Animator) -> int {
    r = a.rig as *pose.Rig
    n = 256 + 9 * (pose.size(r) + 1) + pose.count(r) * INERTIA_FLOATS + pose.curve_count(r) * QUINTIC
    i = 0
    while i < list.size(a.states) {
        n = n + 16 + (list.get_raw(a.states, i) as *State).count
        i = i + 1
    }
    n = n + 8 * list.size(a.layers) + 2 * list.size(a.params) + 16 * (list.size(a.aims) + 1)
    n = n + ikrig.FEET_STATE_MOST + 64
    if a.springs != null { n = n + springs.state_size(a.springs as *Springs) }
    return n
}

// Everything the animator carries from one step to the next, into `out`
// from `at`: the poses it drew and eases from, its inertialization, its
// states' times and blends, its layers, its parameters, its fades, lift
// and warp, and its feet, look, aims and springs whole (ikrig's and
// springs' state_write). What a copy of the figure on another peer takes
// to draw as this one does from here (ae3d.netanim's snapshot, #911); its
// graph, takes and rig are its own, made the same way. Returns where it
// ended.
state_write(a: *Animator, out: float[], at: int) -> int {
    r = a.rig as *pose.Rig
    size = pose.size(r)
    n = at
    poses = [a.out, a.before, a.graph_out, a.graph_before, a.unheld, a.shown, a.step_now, a.step_before, a.frame_shown]
    k = 0
    while k < 9 {
        n = state_floats(out, n, poses[k], size, true)
        k = k + 1
    }
    n = state_floats(out, n, a.inertia, pose.count(r) * INERTIA_FLOATS + pose.curve_count(r) * QUINTIC, true)
    // The lists, each its length first (a state made since, as a knocked
    // figure's lying snapshot is, is the writer's alone), each state its
    // takes' weights' too.
    out[n] = list.size(a.states) as float
    n = n + 1
    i = 0
    while i < list.size(a.states) {
        s = list.get_raw(a.states, i) as *State
        v = [s.time, s.rate, s.param, s.param2, s.pace, state_flag(s.entered), s.offset, s.offset_room, s.entry_at, state_flag(s.chosen)]
        k = 0
        while k < 10 {
            out[n + k] = v[k]
            k = k + 1
        }
        n = n + 10
        out[n] = 0.0
        if s.weights != null { out[n] = s.count as float }
        n = n + 1
        n = state_floats(out, n, s.weights, s.count, true)
        i = i + 1
    }
    out[n] = list.size(a.layers) as float
    n = n + 1
    i = 0
    while i < list.size(a.layers) {
        l = list.get_raw(a.layers, i) as *Layer
        out[n] = l.time
        out[n + 1] = l.weight
        out[n + 2] = l.goal
        out[n + 3] = l.fade
        out[n + 4] = l.rate
        n = n + 5
        i = i + 1
    }
    out[n] = list.size(a.params) as float
    n = n + 1
    i = 0
    while i < list.size(a.params) {
        p = list.get_raw(a.params, i) as *Param
        out[n] = p.value
        out[n + 1] = state_flag(p.trigger)
        n = n + 2
        i = i + 1
    }
    n = state_floats(out, n, a.down_from, 2, true)
    n = state_floats(out, n, a.plant_from, 2, true)
    n = state_floats(out, n, a.down_drawn, 2, true)
    n = state_floats(out, n, a.plant_drawn, 2, true)
    scalars = [a.current as float, a.blend_t, a.eased_from, a.blend_time, state_flag(a.root_motion), a.moved.x, a.moved.y, a.moved.z, a.ground_speed, a.dt_before,
         state_flag(a.evaluated), state_flag(a.paused), state_flag(a.drawn), a.fade_from as float, state_flag(a.ease_feet), a.fade_t, a.fade_time, a.warp_state as float, a.warp_until, a.warp_root.x,
         a.warp_root.y, a.warp_root.z, a.warp_yaw, a.lift, a.lift_from, a.lift_goal, a.lift_t, a.lift_time, state_flag(a.showing), state_flag(a.stepping),
         a.steps_drawn as float, state_flag(a.framed), a.ahead, a.span, a.lod_moved.x, a.lod_moved.y, a.lod_moved.z, a.lod_at.x, a.lod_at.y, a.lod_at.z,
         a.lod_yaw, a.lod_turned.x, a.lod_turned.y, a.lod_turned.z, a.lod_turned.w, a.lod_elapsed, state_flag(a.lod_known), a.lod_phase as float]
    k = 0
    while k < 48 {
        out[n + k] = scalars[k]
        k = k + 1
    }
    n = n + 48
    // The parts it solves after the graph, each with whether it has it
    // (a look and an aim are made at their first use).
    out[n] = state_flag(a.feet != null)
    n = n + 1
    if a.feet != null { n = ikrig.feet_state_write(a.feet as *Feet, out, n) }
    out[n] = state_flag(a.look != null)
    n = n + 1
    if a.look != null { n = ikrig.look_state_write(a.look as *Look, out, n) }
    out[n] = state_flag(a.aim != null)
    n = n + 1
    if a.aim != null { n = ikrig.aim_state_write(a.aim as *ikrig.Aim, out, n) }
    out[n] = list.size(a.aims) as float
    n = n + 1
    i = 0
    while i < list.size(a.aims) {
        o = list.get_raw(a.aims, i) as *Aim
        out[n] = o.yaw
        out[n + 1] = o.pitch
        out[n + 2] = o.weight
        n = n + 3
        i = i + 1
    }
    out[n] = state_flag(a.springs != null)
    n = n + 1
    if a.springs != null { n = springs.state_write(a.springs as *Springs, out, n) }
    return n
}

// A state state_write wrote, from `at`; returns where it ended. With
// `blend` over 0 the change from what it drew is inertialized over that
// many seconds, as play_at's is (a copy put back on its owner's, drawn
// from where it was); 0 takes it whole, as for a figure not yet seen.
state_read(a: *Animator, saved: float[], at: int, blend: float) -> int {
    r = a.rig as *pose.Rig
    size = pose.size(r)
    was = pose.new(r)
    was_before = pose.new(r)
    pose.copy(r, a.graph_out, was)
    pose.copy(r, a.graph_before, was_before)
    seen = a.evaluated
    n = at
    poses = [a.out, a.before, a.graph_out, a.graph_before, a.unheld, a.shown, a.step_now, a.step_before, a.frame_shown]
    k = 0
    while k < 9 {
        n = state_floats(saved, n, poses[k], size, false)
        k = k + 1
    }
    n = state_floats(saved, n, a.inertia, pose.count(r) * INERTIA_FLOATS + pose.curve_count(r) * QUINTIC, false)
    // The lists as long as both have them; the writer's others passed.
    count = saved[n] as int
    n = n + 1
    i = 0
    while i < count {
        weights = saved[n + 10] as int
        if i < list.size(a.states) {
            s = list.get_raw(a.states, i) as *State
            s.time = saved[n]
            s.rate = saved[n + 1]
            s.param = saved[n + 2]
            s.param2 = saved[n + 3]
            s.pace = saved[n + 4]
            s.entered = saved[n + 5] > 0.5
            s.offset = saved[n + 6]
            s.offset_room = saved[n + 7]
            s.entry_at = saved[n + 8]
            s.chosen = saved[n + 9] > 0.5
            if s.weights != null && s.count == weights { _w = state_floats(saved, n + 11, s.weights, weights, false) }
        }
        n = n + 11 + weights
        i = i + 1
    }
    count = saved[n] as int
    n = n + 1
    i = 0
    while i < count {
        if i < list.size(a.layers) {
            l = list.get_raw(a.layers, i) as *Layer
            l.time = saved[n]
            l.weight = saved[n + 1]
            l.goal = saved[n + 2]
            l.fade = saved[n + 3]
            l.rate = saved[n + 4]
        }
        n = n + 5
        i = i + 1
    }
    count = saved[n] as int
    n = n + 1
    i = 0
    while i < count {
        if i < list.size(a.params) {
            p = list.get_raw(a.params, i) as *Param
            p.value = saved[n]
            p.trigger = saved[n + 1] > 0.5
        }
        n = n + 2
        i = i + 1
    }
    n = state_floats(saved, n, a.down_from, 2, false)
    n = state_floats(saved, n, a.plant_from, 2, false)
    n = state_floats(saved, n, a.down_drawn, 2, false)
    n = state_floats(saved, n, a.plant_drawn, 2, false)
    a.current = saved[n] as int
    a.blend_t = saved[n + 1]
    a.eased_from = saved[n + 2]
    a.blend_time = saved[n + 3]
    a.root_motion = saved[n + 4] > 0.5
    a.moved = core.vec3(saved[n + 5], saved[n + 6], saved[n + 7])
    a.ground_speed = saved[n + 8]
    a.dt_before = saved[n + 9]
    a.evaluated = saved[n + 10] > 0.5
    a.paused = saved[n + 11] > 0.5
    a.drawn = saved[n + 12] > 0.5
    a.fade_from = saved[n + 13] as int
    a.ease_feet = saved[n + 14] > 0.5
    a.fade_t = saved[n + 15]
    a.fade_time = saved[n + 16]
    a.warp_state = saved[n + 17] as int
    a.warp_until = saved[n + 18]
    a.warp_root = core.vec3(saved[n + 19], saved[n + 20], saved[n + 21])
    a.warp_yaw = saved[n + 22]
    a.lift = saved[n + 23]
    a.lift_from = saved[n + 24]
    a.lift_goal = saved[n + 25]
    a.lift_t = saved[n + 26]
    a.lift_time = saved[n + 27]
    a.showing = saved[n + 28] > 0.5
    a.stepping = saved[n + 29] > 0.5
    a.steps_drawn = saved[n + 30] as int
    a.framed = saved[n + 31] > 0.5
    a.ahead = saved[n + 32]
    a.span = saved[n + 33]
    a.lod_moved = core.vec3(saved[n + 34], saved[n + 35], saved[n + 36])
    a.lod_at = core.vec3(saved[n + 37], saved[n + 38], saved[n + 39])
    a.lod_yaw = saved[n + 40]
    a.lod_turned = core.quat(saved[n + 41], saved[n + 42], saved[n + 43], saved[n + 44])
    a.lod_elapsed = saved[n + 45]
    a.lod_known = saved[n + 46] > 0.5
    a.lod_phase = saved[n + 47] as int
    n = n + 48
    if saved[n] > 0.5 {
        n = ikrig.feet_state_read(a.feet as *Feet, saved, n + 1)
    } else {
        n = n + 1
    }
    if saved[n] > 0.5 {
        if a.look == null { a.look = ikrig.look_new(r) as ptr }
        n = ikrig.look_state_read(a.look as *Look, saved, n + 1)
    } else {
        n = n + 1
    }
    if saved[n] > 0.5 {
        if a.aim == null { a.aim = ikrig.aim_new(r) as ptr }
        n = ikrig.aim_state_read(a.aim as *ikrig.Aim, saved, n + 1)
    } else {
        n = n + 1
    }
    count = saved[n] as int
    n = n + 1
    i = 0
    while i < count {
        if i < list.size(a.aims) {
            o = list.get_raw(a.aims, i) as *Aim
            o.yaw = saved[n]
            o.pitch = saved[n + 1]
            o.weight = saved[n + 2]
        }
        n = n + 3
        i = i + 1
    }
    if saved[n] > 0.5 {
        n = springs.state_read(springs_of(a), saved, n + 1)
    } else {
        n = n + 1
    }
    // Drawn from where it was: the change inertialized as a state's is.
    s = state_at(a, a.current)
    if blend > 0.0 && seen && s != null {
        sample_state(a, s, a.work)
        sample_ahead(a, s, a.work2)
        inertialize(a, was, was_before, a.work, a.work2, blend)
        a.ease_feet = true
    }
    pose.release(was)
    pose.release(was_before)
    return n
}

state_floats(s: float[], at: int, p: ptr, count: int, writing: bool) -> int {
    if p == null || count <= 0 { return at }
    a = p as float[]
    k = 0
    while k < count {
        if writing { s[at + k] = a[k] } else { a[k] = s[at + k] }
        k = k + 1
    }
    return at + count
}

state_flag(b: bool) -> float {
    if b { return 1.0 }
    return 0.0
}
