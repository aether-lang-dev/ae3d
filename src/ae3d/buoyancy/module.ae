// ae3d.buoyancy -- bodies that float on the Gerstner sea (#637): a body's
// box as four columns over its bottom corners, each pushed up by the water
// it displaces where it is under the surface (ae3d.water's height there,
// the waves as they are drawn) -- Archimedes, a column at a time -- and
// held back by the water it moves through. At the corners, so a hull rights
// itself, rolls with a swell and pitches over a crest rather than rising
// flat.
//
//   f = buoyancy.floater(sea, physics.rigidbody_of(crate), core.vec3(0.5, 0.5, 0.5))
//
// A body lighter than the water it could displace floats with the share of
// it under that its density is of water's: a box of half water's density
// rides half under. Stepped after each physics step, on the engine's fixed
// step, the force it sets acting through the next.
import std.heap
import std.list
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.water
import ae3d.physics

exports (
    Floater, floater, floater_free, floater_submerged, WATER_DENSITY
)

const WATER_DENSITY = 1000.0           // kilograms a cubic metre
const GRAVITY = 9.81
// How hard the water holds a column back, as a share of the damping that
// would stop its bob dead (critical, 2 sqrt(k m) for the column's
// buoyancy k and its share of the mass): a box dropped in still water rides
// its bob down in a couple of seconds, as the waves it pushes away carry it
// off, where at a few percent it bounced on for good.
const DAMPING = 0.35

struct Floater {
    sea: ptr                           // *Simulation
    body: ptr                          // *Rigidbody
    half: Vec3                         // the box's half extents, in the body's frame
    submerged: float                   // the share of the box under the water, last step
    behaviour: ptr
    engine: ptr
}

// `rb` floating on `sea`: its box `half` extents about its middle, in its
// own frame. Freed with floater_free.
floater(sea: *Simulation, rb: *Rigidbody, half: Vec3) -> *Floater {
    f = heap.new(Floater)
    f.sea = sea as ptr
    f.body = rb as ptr
    f.half = half
    e = engine.of(rb.object as *GameObject)
    f.engine = e as ptr
    b = engine.behaviour_new("floater", f as ptr)
    b.fixed_update = on_step
    engine.engine_add_behaviour(e, b)
    f.behaviour = b as ptr
    return f
}

floater_free(f: *Floater) {
    if f == null { return }
    if f.behaviour != null {
        engine.engine_remove_behaviour(f.engine as *Engine, f.behaviour as *Behaviour)
        heap.free(f.behaviour as *Behaviour)
    }
    heap.free(f)
}

// The share of the box under the water at the last step, 0 to 1.
floater_submerged(f: *Floater) -> float { return f.submerged }

on_step(state: ptr, e: *Engine, step: float) {
    f = state as *Floater
    rb = f.body as *Rigidbody
    sea = f.sea as *Simulation
    h = f.half
    // The box as four quarter columns, each over one of its bottom
    // corners: 2 hx hy hz of water each, wholly under.
    column = 2.0 * h.x * h.y * h.z
    tall = 2.0 * h.y
    // A column's buoyancy as a spring: its footprint's water weight a metre.
    stiffness = WATER_DENSITY * GRAVITY * h.x * h.z
    held = DAMPING * 2.0 * core.sqrt_of(stiffness * physics.rigidbody_mass(rb) * 0.25)
    under = 0.0
    k = 0
    while k < 4 {
        // The four bottom corners, each the foot of a quarter column of the
        // box: how much of its height is under the surface over it.
        sx = 1.0
        if (k & 1) != 0 { sx = 0.0 - 1.0 }
        sz = 1.0
        if (k & 2) != 0 { sz = 0.0 - 1.0 }
        foot = physics.rigidbody_world_point(rb, core.vec3(sx * h.x, 0.0 - h.y, sz * h.z))
        surface = water.simulation_height_at(sea, foot.x, foot.z)
        wet = core.clampf((surface - foot.y) / tall, 0.0, 1.0)
        if wet > 0.0 {
            // Archimedes: the water the quarter column displaces, weighed;
            // pushed up through the column's middle under the water.
            lift = WATER_DENSITY * GRAVITY * column * wet
            middle = physics.rigidbody_world_point(rb, core.vec3(sx * h.x, 0.0 - h.y + tall * wet * 0.5, sz * h.z))
            moving = physics.rigidbody_point_velocity(rb, middle)
            // Held back, the more of the column is in the water.
            drag = core.v3_mul(moving, 0.0 - held * core.clampf(wet * 4.0, 0.0, 1.0))
            physics.rigidbody_apply_force_at(rb, core.v3_add(core.vec3(0.0, lift, 0.0), drag), middle)
        }
        under = under + wet * 0.25
        k = k + 1
    }
    f.submerged = under
}
