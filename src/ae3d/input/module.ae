// The input as a game names it: actions and axes, bound once to keys,
// mouse buttons and a gamepad, read by name from any script -- Unity's
// Input, gopher3D's input manager.
//
//     in = engine.engine_input(e)
//     input.bind_key(in, "jump", platform.KEY_SPACE)
//     input.bind_button(in, "jump", input.PAD_A)
//     input.bind_axis(in, "throttle", platform.KEY_W, platform.KEY_S)
//     input.bind_pad_axis(in, "throttle", input.PAD_LEFT_Y, -1.0)
//
//     if input.pressed(in, "jump") { ... }       // went down this frame
//     if input.held(in, "fire") { ... }           // down now
//     speed = input.axis(in, "throttle")          // -1 to 1, keys or stick
//     turn = input.mouse_dx(in)                   // pixels this frame
//
// The engine polls it once a frame, before the scripts' updates, so
// `pressed` and `released` are edges between two frames and every script
// in the frame reads the same state. The engine's own bindings -- the
// camera's forward, strafe, rise, sprint, look -- are actions like any
// other, so a gamepad flies every example and a game can rebind them.
//
// Anything can be injected: a test with no window, an agent over the
// channel (`input.set`), a replay, the editor's viewport in play mode. An
// injected key is down until it is released, on top of whatever the
// keyboard says.
//
// Besides the actions, a frame carries what happened in it as events, in
// order: the keys pressed (and repeated while held), the characters typed,
// the mouse buttons pressed and released. A key tapped down and up between
// two polls, or a click inside one frame, is never down when the keyboard
// or the mouse is read, and was lost; a press seen as an event counts as
// down for the poll that takes it, so an action sees the tap once. The
// events and the pointer (the cursor in the framebuffer's pixels) are what
// a menu reads (ae3d.ui2d).
//
// While a menu is open the game's actions are blocked (set_blocked): every
// action reads as nothing -- not down, not pressed, not released, zero --
// and the mouse's movement and wheel read zero. A key or button that is
// down while blocked stays swallowed until it is released, so the click
// that pressed "Resume" does not fire a shot on the frame the menu closes;
// a click a menu took on a frame the game was not blocked is swallowed the
// same way (swallow_mouse).
import std.list
import std.heap
import std.string
import ae3d.core
import ae3d.platform

exports (
    Input, Action,
    PAD_A, PAD_B, PAD_X, PAD_Y, PAD_LEFT_BUMPER, PAD_RIGHT_BUMPER, PAD_BACK, PAD_START,
    PAD_LEFT_THUMB, PAD_RIGHT_THUMB, PAD_UP, PAD_RIGHT, PAD_DOWN, PAD_LEFT,
    PAD_LEFT_X, PAD_LEFT_Y, PAD_RIGHT_X, PAD_RIGHT_Y, PAD_LEFT_TRIGGER, PAD_RIGHT_TRIGGER,
    MOUSE_X, MOUSE_Y,
    input_new, input_free, input_set_window, input_set_deadzone,
    bind_key, bind_mouse, bind_button, bind_axis, bind_pad_axis, bind_mouse_axis, unbind,
    poll, held, pressed, released, axis, mouse_x, mouse_y, mouse_dx, mouse_dy, scroll,
    gamepad_present, action_count, action_at, action_named,
    inject_key, inject_key_press, inject_char, inject_mouse, inject_button, inject_pad_axis,
    inject_cursor, release_cursor, inject_scroll, inject_clear,
    set_blocked, blocked, swallow_mouse, swallow_key, swallow_button,
    pointer_x, pointer_y, pointer_scroll,
    key_event_count, key_event, char_count, char_at, mouse_event_count, mouse_event,
    device_key, device_mouse, device_button, device_button_pressed, device_pad_axis
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// GLFW's gamepad buttons and axes, by their names.
const PAD_A = 0
const PAD_B = 1
const PAD_X = 2
const PAD_Y = 3
const PAD_LEFT_BUMPER = 4
const PAD_RIGHT_BUMPER = 5
const PAD_BACK = 6
const PAD_START = 7
const PAD_LEFT_THUMB = 9
const PAD_RIGHT_THUMB = 10
const PAD_UP = 11
const PAD_RIGHT = 12
const PAD_DOWN = 13
const PAD_LEFT = 14
const PAD_LEFT_X = 0
const PAD_LEFT_Y = 1
const PAD_RIGHT_X = 2
const PAD_RIGHT_Y = 3
const PAD_LEFT_TRIGGER = 4
const PAD_RIGHT_TRIGGER = 5
// The mouse's movement as an axis, in pixels a frame.
const MOUSE_X = 0
const MOUSE_Y = 1

const NONE = 0 - 1
const PAD_BUTTONS = 15
const PAD_AXES = 6
// Below this a stick at rest reads as nothing: a worn stick reports a few
// percent off centre and a camera that took it drifted.
const DEADZONE = 0.15
// A key event's flags: the modifiers in the low byte, and this bit for the
// keyboard repeating a held key.
const REPEAT_BIT = 256

// One named thing a game asks about. A button-like action is down when any
// of its keys, mouse buttons or pad buttons is; an axis is the sum of its
// key pairs (+1/-1), its pad axes (scaled) and its mouse axis, clamped to
// -1..1 for the sticks and keys and left in pixels for the mouse.
struct Action {
    name: string
    keys: ptr           // int[] of key codes (the positive side of an axis)
    key_count: int
    negatives: ptr      // int[] of key codes, the negative side
    negative_count: int
    mouse_buttons: ptr  // int[]
    mouse_count: int
    buttons: ptr        // int[] of pad buttons
    button_count: int
    pad_axis: int       // NONE or a PAD_* axis
    pad_scale: float
    mouse_axis: int     // NONE, MOUSE_X or MOUSE_Y
    mouse_scale: float
    // What the last two polls read.
    down: bool
    was_down: bool
    value: float
}

struct Input {
    window: ptr
    actions: ptr        // list of *Action
    gamepad: int        // the joystick id polled, 0
    deadzone: float
    // The mouse, this frame and last, in the window's units; `ratio` is
    // how many framebuffer pixels one of them is (2 on a Retina display).
    mx: float
    my: float
    last_mx: float
    last_my: float
    dx: float
    dy: float
    scroll_y: float
    ratio: float
    first: bool
    // Injected state, on top of the platform's: keys and mouse buttons by
    // code, pad buttons and axes by index, the cursor in framebuffer pixels.
    injected_keys: ptr      // int[512]
    injected_mouse: ptr     // int[8]
    injected_buttons: ptr   // int[PAD_BUTTONS]
    injected_axes: ptr      // float[PAD_AXES]
    injected_axis_set: ptr  // int[PAD_AXES]: whether an axis was injected
    cursor_set: bool
    cursor_x: float
    cursor_y: float
    pending_scroll: float
    // Events injected since the last poll, and the ones this frame took --
    // those and the window's, in that order. A key is its code and flags,
    // a mouse event its button and 1 for down; platform.EVENTS of each.
    pending_keys: ptr
    pending_key_count: int
    pending_chars: ptr
    pending_char_count: int
    pending_mouse: ptr
    pending_mouse_count: int
    frame_keys: ptr
    frame_key_count: int
    frame_chars: ptr
    frame_char_count: int
    frame_mouse: ptr
    frame_mouse_count: int
    // What went down this frame as an event (a press, not a repeat): down
    // for this poll even if it is up again already.
    tapped_keys: ptr        // int[KEY_CODES]
    tapped_mouse: ptr       // int[MOUSE_CODES]
    // The gamepad's buttons at this poll and the last, for the edges a
    // menu navigates by.
    pad_now: ptr            // int[PAD_BUTTONS]
    pad_last: ptr
    // The game blocked (a menu open), and what stays swallowed until it is
    // released: the codes down while blocked, and the clicks a menu took.
    is_blocked: bool
    swallowed_keys: ptr     // int[KEY_CODES]
    swallowed_mouse: ptr    // int[MOUSE_CODES]
    swallowed_buttons: ptr  // int[PAD_BUTTONS]
    swallowing: int         // how many codes are swallowed
}

const KEY_CODES = 512
const MOUSE_CODES = 8
const SLOTS = 8

input_new(window: ptr) -> *Input {
    i = heap.new(Input)
    i.window = window
    i.actions = list.new()
    i.gamepad = 0
    i.deadzone = DEADZONE
    i.ratio = 1.0
    i.first = true
    i.injected_keys = calloc(KEY_CODES, 4)
    i.injected_mouse = calloc(MOUSE_CODES, 4)
    i.injected_buttons = calloc(PAD_BUTTONS, 4)
    i.injected_axes = calloc(PAD_AXES, 8)
    i.injected_axis_set = calloc(PAD_AXES, 4)
    i.pending_keys = calloc(platform.EVENTS * 2, 4)
    i.pending_chars = calloc(platform.EVENTS, 4)
    i.pending_mouse = calloc(platform.EVENTS * 2, 4)
    i.frame_keys = calloc(platform.EVENTS * 2, 4)
    i.frame_chars = calloc(platform.EVENTS, 4)
    i.frame_mouse = calloc(platform.EVENTS * 2, 4)
    i.tapped_keys = calloc(KEY_CODES, 4)
    i.tapped_mouse = calloc(MOUSE_CODES, 4)
    i.pad_now = calloc(PAD_BUTTONS, 4)
    i.pad_last = calloc(PAD_BUTTONS, 4)
    i.swallowed_keys = calloc(KEY_CODES, 4)
    i.swallowed_mouse = calloc(MOUSE_CODES, 4)
    i.swallowed_buttons = calloc(PAD_BUTTONS, 4)
    return i
}

input_free(i: *Input) {
    if i == null { return }
    count = list.size(i.actions)
    k = 0
    while k < count {
        action_free(list.get_raw(i.actions, k) as *Action)
        k = k + 1
    }
    list.free(i.actions)
    free(i.injected_keys)
    free(i.injected_mouse)
    free(i.injected_buttons)
    free(i.injected_axes)
    free(i.injected_axis_set)
    free(i.pending_keys)
    free(i.pending_chars)
    free(i.pending_mouse)
    free(i.frame_keys)
    free(i.frame_chars)
    free(i.frame_mouse)
    free(i.tapped_keys)
    free(i.tapped_mouse)
    free(i.pad_now)
    free(i.pad_last)
    free(i.swallowed_keys)
    free(i.swallowed_mouse)
    free(i.swallowed_buttons)
    heap.free(i)
}

// The window the keys and the mouse are read from; none reads nothing but
// what is injected, which is how a test drives it.
input_set_window(i: *Input, window: ptr) { i.window = window }
input_set_deadzone(i: *Input, deadzone: float) { i.deadzone = deadzone }

action_new(name: string) -> *Action {
    a = heap.new(Action)
    a.name = string.copy(name)
    a.keys = calloc(SLOTS, 4)
    a.negatives = calloc(SLOTS, 4)
    a.mouse_buttons = calloc(SLOTS, 4)
    a.buttons = calloc(SLOTS, 4)
    a.pad_axis = NONE
    a.pad_scale = 1.0
    a.mouse_axis = NONE
    a.mouse_scale = 1.0
    return a
}

action_free(a: *Action) {
    if a == null { return }
    free(a.keys)
    free(a.negatives)
    free(a.mouse_buttons)
    free(a.buttons)
    heap.free(a)
}

action_count(i: *Input) -> int { return list.size(i.actions) }
action_at(i: *Input, index: int) -> *Action {
    if index < 0 || index >= list.size(i.actions) { return null }
    return list.get_raw(i.actions, index) as *Action
}

action_named(i: *Input, name: string) -> *Action {
    count = list.size(i.actions)
    k = 0
    while k < count {
        a = list.get_raw(i.actions, k) as *Action
        if string.equals(a.name, name) == 1 { return a }
        k = k + 1
    }
    return null
}

// The action by name, made on first mention: binding is naming.
action_for(i: *Input, name: string) -> *Action {
    a = action_named(i, name)
    if a != null { return a }
    a = action_new(name)
    list.add_raw(i.actions, a)
    return a
}

add_code(codes: ptr, count: int, code: int) -> int {
    if count >= SLOTS { return count }
    slots = codes as int[]
    k = 0
    while k < count {
        if slots[k] == code { return count }
        k = k + 1
    }
    slots[count] = code
    return count + 1
}

bind_key(i: *Input, name: string, key: int) {
    a = action_for(i, name)
    a.key_count = add_code(a.keys, a.key_count, key)
}

bind_mouse(i: *Input, name: string, button: int) {
    a = action_for(i, name)
    a.mouse_count = add_code(a.mouse_buttons, a.mouse_count, button)
}

bind_button(i: *Input, name: string, button: int) {
    a = action_for(i, name)
    a.button_count = add_code(a.buttons, a.button_count, button)
}

// A key pair as an axis: `positive` reads +1, `negative` -1, both nothing.
bind_axis(i: *Input, name: string, positive: int, negative: int) {
    a = action_for(i, name)
    a.key_count = add_code(a.keys, a.key_count, positive)
    a.negative_count = add_code(a.negatives, a.negative_count, negative)
}

// A gamepad axis, scaled: -1.0 turns a stick whose up is negative into an
// axis whose forward is positive.
bind_pad_axis(i: *Input, name: string, pad_axis: int, scale: float) {
    a = action_for(i, name)
    a.pad_axis = pad_axis
    a.pad_scale = scale
}

// The mouse's movement, in pixels a frame times the scale.
bind_mouse_axis(i: *Input, name: string, mouse_axis: int, scale: float) {
    a = action_for(i, name)
    a.mouse_axis = mouse_axis
    a.mouse_scale = scale
}

// The action gone with every binding it had.
unbind(i: *Input, name: string) {
    count = list.size(i.actions)
    k = 0
    while k < count {
        a = list.get_raw(i.actions, k) as *Action
        if string.equals(a.name, name) == 1 {
            list.remove(i.actions, k)
            action_free(a)
            return
        }
        k = k + 1
    }
}

gamepad_present(i: *Input) -> bool { return platform.gamepad_present(i.gamepad) }

// What the platform and the injections say about one code, and what a
// press seen as an event this frame adds: the device as it is, whatever
// the game is blocked from.
key_is_down(i: *Input, key: int) -> bool {
    if key < 0 || key >= KEY_CODES { return false }
    keys = i.injected_keys as int[]
    if keys[key] == 1 { return true }
    tapped = i.tapped_keys as int[]
    if tapped[key] == 1 { return true }
    if i.window == null { return false }
    return platform.key_down(i.window, key)
}

mouse_is_down(i: *Input, button: int) -> bool {
    if button < 0 || button >= MOUSE_CODES { return false }
    buttons = i.injected_mouse as int[]
    if buttons[button] == 1 { return true }
    tapped = i.tapped_mouse as int[]
    if tapped[button] == 1 { return true }
    if i.window == null { return false }
    return platform.mouse_down(i.window, button)
}

button_is_down(i: *Input, button: int) -> bool {
    if button < 0 || button >= PAD_BUTTONS { return false }
    buttons = i.injected_buttons as int[]
    if buttons[button] == 1 { return true }
    return platform.gamepad_button(i.gamepad, button)
}

pad_axis_value(i: *Input, pad_axis: int) -> float {
    if pad_axis < 0 || pad_axis >= PAD_AXES { return 0.0 }
    value = 0.0
    marks = i.injected_axis_set as int[]
    if marks[pad_axis] == 1 {
        axes = i.injected_axes as float[]
        value = axes[pad_axis]
    } else {
        value = platform.gamepad_axis(i.gamepad, pad_axis)
    }
    if value > 0.0 - i.deadzone && value < i.deadzone { return 0.0 }
    return value
}

// One code as the game's actions see it: down on the device and not
// swallowed. kind: 0 a key, 1 a mouse button, 2 a pad button.
code_down(i: *Input, kind: int, code: int) -> bool {
    if kind == 0 {
        if !key_is_down(i, code) { return false }
        return (i.swallowed_keys as int[])[code] == 0
    }
    if kind == 1 {
        if !mouse_is_down(i, code) { return false }
        return (i.swallowed_mouse as int[])[code] == 0
    }
    if code < 0 || code >= PAD_BUTTONS { return false }
    if (i.pad_now as int[])[code] == 0 { return false }
    return (i.swallowed_buttons as int[])[code] == 0
}

any_down(i: *Input, codes: ptr, count: int, kind: int) -> bool {
    slots = codes as int[]
    k = 0
    while k < count {
        if code_down(i, kind, slots[k]) { return true }
        k = k + 1
    }
    return false
}

// The modifiers held now, as a key event carries them.
modifiers(i: *Input) -> int {
    mods = 0
    if key_is_down(i, platform.KEY_LEFT_SHIFT) || key_is_down(i, platform.KEY_RIGHT_SHIFT) { mods = mods | platform.MOD_SHIFT }
    if key_is_down(i, platform.KEY_LEFT_CONTROL) || key_is_down(i, platform.KEY_RIGHT_CONTROL) { mods = mods | platform.MOD_CONTROL }
    if key_is_down(i, platform.KEY_LEFT_ALT) || key_is_down(i, platform.KEY_RIGHT_ALT) { mods = mods | platform.MOD_ALT }
    if key_is_down(i, platform.KEY_LEFT_SUPER) || key_is_down(i, platform.KEY_RIGHT_SUPER) { mods = mods | platform.MOD_SUPER }
    return mods
}

// Two ints onto a queue of pairs, if there is room: its new count.
push_pair(q: ptr, count: int, a: int, b: int) -> int {
    if count >= platform.EVENTS { return count }
    slots = q as int[]
    slots[count * 2] = a
    slots[count * 2 + 1] = b
    return count + 1
}

push_one(q: ptr, count: int, a: int) -> int {
    if count >= platform.EVENTS { return count }
    (q as int[])[count] = a
    return count + 1
}

// This frame's events: what was injected since the last poll, then what
// the window gathered, both taken and cleared; and what they pressed.
take_events(i: *Input) {
    i.frame_key_count = 0
    i.frame_char_count = 0
    i.frame_mouse_count = 0
    pending = i.pending_keys as int[]
    k = 0
    while k < i.pending_key_count {
        i.frame_key_count = push_pair(i.frame_keys, i.frame_key_count, pending[k * 2], pending[k * 2 + 1])
        k = k + 1
    }
    chars = i.pending_chars as int[]
    k = 0
    while k < i.pending_char_count {
        i.frame_char_count = push_one(i.frame_chars, i.frame_char_count, chars[k])
        k = k + 1
    }
    clicks = i.pending_mouse as int[]
    k = 0
    while k < i.pending_mouse_count {
        i.frame_mouse_count = push_pair(i.frame_mouse, i.frame_mouse_count, clicks[k * 2], clicks[k * 2 + 1])
        k = k + 1
    }
    i.pending_key_count = 0
    i.pending_char_count = 0
    i.pending_mouse_count = 0
    if i.window != null {
        n = platform.key_event_count(i.window)
        k = 0
        while k < n {
            key, mods, repeat = platform.key_event(i.window, k)
            flags = mods
            if repeat { flags = flags | REPEAT_BIT }
            i.frame_key_count = push_pair(i.frame_keys, i.frame_key_count, key, flags)
            k = k + 1
        }
        n = platform.char_event_count(i.window)
        k = 0
        while k < n {
            i.frame_char_count = push_one(i.frame_chars, i.frame_char_count, platform.char_event(i.window, k))
            k = k + 1
        }
        n = platform.button_event_count(i.window)
        k = 0
        while k < n {
            button, down = platform.button_event(i.window, k)
            flag = 0
            if down { flag = 1 }
            i.frame_mouse_count = push_pair(i.frame_mouse, i.frame_mouse_count, button, flag)
            k = k + 1
        }
        platform.events_clear(i.window)
    }

    tapped = i.tapped_keys as int[]
    k = 0
    while k < KEY_CODES { tapped[k] = 0 ; k = k + 1 }
    tapped_mouse = i.tapped_mouse as int[]
    k = 0
    while k < MOUSE_CODES { tapped_mouse[k] = 0 ; k = k + 1 }
    keys = i.frame_keys as int[]
    k = 0
    while k < i.frame_key_count {
        code = keys[k * 2]
        if code >= 0 && code < KEY_CODES && (keys[k * 2 + 1] & REPEAT_BIT) == 0 { tapped[code] = 1 }
        k = k + 1
    }
    clicks = i.frame_mouse as int[]
    k = 0
    while k < i.frame_mouse_count {
        code = clicks[k * 2]
        if code >= 0 && code < MOUSE_CODES && clicks[k * 2 + 1] == 1 { tapped_mouse[code] = 1 }
        k = k + 1
    }
}

// What stays swallowed: while blocked, everything down; after, until it
// is released. A code swallowed and up again is let go.
update_swallowed(i: *Input) {
    if !i.is_blocked && i.swallowing == 0 { return }
    count = 0
    keys = i.swallowed_keys as int[]
    k = 0
    while k < KEY_CODES {
        if i.is_blocked || keys[k] == 1 {
            keys[k] = 0
            if key_is_down(i, k) { keys[k] = 1 }
        }
        count = count + keys[k]
        k = k + 1
    }
    mouse = i.swallowed_mouse as int[]
    k = 0
    while k < MOUSE_CODES {
        if i.is_blocked || mouse[k] == 1 {
            mouse[k] = 0
            if mouse_is_down(i, k) { mouse[k] = 1 }
        }
        count = count + mouse[k]
        k = k + 1
    }
    pads = i.swallowed_buttons as int[]
    now = i.pad_now as int[]
    k = 0
    while k < PAD_BUTTONS {
        if i.is_blocked || pads[k] == 1 {
            pads[k] = now[k]
        }
        count = count + pads[k]
        k = k + 1
    }
    i.swallowing = count
}

// An action's state from its bindings, its edges' last state kept.
evaluate(i: *Input, a: *Action) {
    if i.is_blocked {
        a.down = false
        a.was_down = false
        a.value = 0.0
        return
    }
    positive = any_down(i, a.keys, a.key_count, 0) ||
               any_down(i, a.mouse_buttons, a.mouse_count, 1) ||
               any_down(i, a.buttons, a.button_count, 2)
    negative = any_down(i, a.negatives, a.negative_count, 0)
    value = 0.0
    if positive { value = value + 1.0 }
    if negative { value = value - 1.0 }
    if a.pad_axis != NONE { value = value + pad_axis_value(i, a.pad_axis) * a.pad_scale }
    if a.mouse_axis == MOUSE_X { value = value + i.dx * a.mouse_scale }
    if a.mouse_axis == MOUSE_Y { value = value + i.dy * a.mouse_scale }
    // Keys and sticks add up to at most a full deflection; the mouse is
    // pixels and keeps them.
    if a.mouse_axis == NONE {
        if value > 1.0 { value = 1.0 }
        if value < 0.0 - 1.0 { value = 0.0 - 1.0 }
    }
    a.value = value
    a.down = positive || (a.pad_axis != NONE && value > 0.5)
}

// Once a frame, before anything reads: the events since the last poll,
// every action's state from the keyboard, the mouse, the gamepad and the
// injections, and the mouse's movement since the last poll.
poll(i: *Input) {
    if i.window != null {
        i.mx = platform.cursor_x(i.window)
        i.my = platform.cursor_y(i.window)
        i.scroll_y = platform.scroll_delta(i.window)
        units = platform.window_width(i.window)
        pixels = platform.window_fb_width(i.window)
        i.ratio = 1.0
        if units > 0 && pixels > 0 { i.ratio = (pixels as float) / (units as float) }
    } else {
        i.scroll_y = 0.0
    }
    i.scroll_y = i.scroll_y + i.pending_scroll
    i.pending_scroll = 0.0
    // An injected cursor is in framebuffer pixels, what the pointer is.
    if i.cursor_set {
        i.mx = i.cursor_x / i.ratio
        i.my = i.cursor_y / i.ratio
    }
    if i.first {
        i.last_mx = i.mx
        i.last_my = i.my
        i.first = false
    }
    i.dx = i.mx - i.last_mx
    i.dy = i.my - i.last_my
    i.last_mx = i.mx
    i.last_my = i.my

    take_events(i)
    last = i.pad_last as int[]
    now = i.pad_now as int[]
    k = 0
    while k < PAD_BUTTONS {
        last[k] = now[k]
        now[k] = 0
        if button_is_down(i, k) { now[k] = 1 }
        k = k + 1
    }
    update_swallowed(i)

    count = list.size(i.actions)
    k = 0
    while k < count {
        a = list.get_raw(i.actions, k) as *Action
        a.was_down = a.down
        evaluate(i, a)
        k = k + 1
    }
}

held(i: *Input, name: string) -> bool {
    a = action_named(i, name)
    if a == null { return false }
    return a.down
}

pressed(i: *Input, name: string) -> bool {
    a = action_named(i, name)
    if a == null { return false }
    return a.down && !a.was_down
}

released(i: *Input, name: string) -> bool {
    a = action_named(i, name)
    if a == null { return false }
    return !a.down && a.was_down
}

axis(i: *Input, name: string) -> float {
    a = action_named(i, name)
    if a == null { return 0.0 }
    return a.value
}

// The cursor in the window's units, where it is whether or not the game
// is blocked: a position is not an event. Its movement and the wheel are
// the game's, and read nothing while it is blocked.
mouse_x(i: *Input) -> float { return i.mx }
mouse_y(i: *Input) -> float { return i.my }
mouse_dx(i: *Input) -> float {
    if i.is_blocked { return 0.0 }
    return i.dx
}
mouse_dy(i: *Input) -> float {
    if i.is_blocked { return 0.0 }
    return i.dy
}
scroll(i: *Input) -> float {
    if i.is_blocked { return 0.0 }
    return i.scroll_y
}

// --- blocking: a menu open over the game ------------------------------------------------------------

// Whether the game's actions read nothing from the next poll on (a menu
// is open). Set before the poll it is to apply to.
set_blocked(i: *Input, on: bool) { i.is_blocked = on }
blocked(i: *Input) -> bool { return i.is_blocked }

// A mouse button, key or pad button a menu took this frame: out of the
// game's actions now and until it is released. The actions are read again
// with it gone and their last state kept, so no edge is made or lost.
swallow_mouse(i: *Input, button: int) {
    if button < 0 || button >= MOUSE_CODES { return }
    swallowed = i.swallowed_mouse as int[]
    if swallowed[button] == 1 { return }
    swallowed[button] = 1
    i.swallowing = i.swallowing + 1
    reevaluate(i)
}

swallow_key(i: *Input, key: int) {
    if key < 0 || key >= KEY_CODES { return }
    swallowed = i.swallowed_keys as int[]
    if swallowed[key] == 1 { return }
    swallowed[key] = 1
    i.swallowing = i.swallowing + 1
    reevaluate(i)
}

swallow_button(i: *Input, button: int) {
    if button < 0 || button >= PAD_BUTTONS { return }
    swallowed = i.swallowed_buttons as int[]
    if swallowed[button] == 1 { return }
    swallowed[button] = 1
    i.swallowing = i.swallowing + 1
    reevaluate(i)
}

reevaluate(i: *Input) {
    count = list.size(i.actions)
    k = 0
    while k < count {
        evaluate(i, list.get_raw(i.actions, k) as *Action)
        k = k + 1
    }
}

// --- the devices as they are: what a menu reads -----------------------------------------------------

// The cursor in the framebuffer's pixels, the overlay's space: y down
// from the top-left.
pointer_x(i: *Input) -> float { return i.mx * i.ratio }
pointer_y(i: *Input) -> float { return i.my * i.ratio }
// The wheel's turns this frame, blocked or not.
pointer_scroll(i: *Input) -> float { return i.scroll_y }

key_event_count(i: *Input) -> int { return i.frame_key_count }

// A key pressed this frame: its code, the modifiers held (platform.MOD_*)
// and whether it was the keyboard repeating a held key.
key_event(i: *Input, index: int) -> (int, int, bool) {
    if index < 0 || index >= i.frame_key_count { return 0 - 1, 0, false }
    keys = i.frame_keys as int[]
    flags = keys[index * 2 + 1]
    return keys[index * 2], flags & 255, (flags & REPEAT_BIT) != 0
}

// The characters typed this frame, as codepoints.
char_count(i: *Input) -> int { return i.frame_char_count }
char_at(i: *Input, index: int) -> int {
    if index < 0 || index >= i.frame_char_count { return 0 }
    return (i.frame_chars as int[])[index]
}

// The mouse buttons pressed and released this frame, in order.
mouse_event_count(i: *Input) -> int { return i.frame_mouse_count }
mouse_event(i: *Input, index: int) -> (int, bool) {
    if index < 0 || index >= i.frame_mouse_count { return 0 - 1, false }
    clicks = i.frame_mouse as int[]
    return clicks[index * 2], clicks[index * 2 + 1] == 1
}

device_key(i: *Input, key: int) -> bool { return key_is_down(i, key) }
device_mouse(i: *Input, button: int) -> bool { return mouse_is_down(i, button) }

device_button(i: *Input, button: int) -> bool {
    if button < 0 || button >= PAD_BUTTONS { return false }
    return (i.pad_now as int[])[button] == 1
}

// A pad button that went down at this poll.
device_button_pressed(i: *Input, button: int) -> bool {
    if button < 0 || button >= PAD_BUTTONS { return false }
    return (i.pad_now as int[])[button] == 1 && (i.pad_last as int[])[button] == 0
}

device_pad_axis(i: *Input, pad_axis: int) -> float { return pad_axis_value(i, pad_axis) }

// --- injection: what a test, a replay, an agent or the editor presses -------------------------------
//
// Held until released; read at the next poll like a real key.

inject_key(i: *Input, key: int, down: bool) {
    if key < 0 || key >= KEY_CODES { return }
    keys = i.injected_keys as int[]
    if down {
        // Pressed again while held is the keyboard repeating it.
        flags = modifiers(i)
        if keys[key] == 1 { flags = flags | REPEAT_BIT }
        keys[key] = 1
        i.pending_key_count = push_pair(i.pending_keys, i.pending_key_count, key, flags)
    } else {
        keys[key] = 0
    }
}

// A key tapped: pressed and let go before the next poll, with these
// modifiers. Down for the one poll that takes it.
inject_key_press(i: *Input, key: int, mods: int) {
    if key < 0 || key >= KEY_CODES { return }
    i.pending_key_count = push_pair(i.pending_keys, i.pending_key_count, key, mods & 255)
}

// A character typed, as a codepoint.
inject_char(i: *Input, codepoint: int) {
    i.pending_char_count = push_one(i.pending_chars, i.pending_char_count, codepoint)
}

inject_mouse(i: *Input, button: int, down: bool) {
    if button < 0 || button >= MOUSE_CODES { return }
    buttons = i.injected_mouse as int[]
    flag = 0
    if down { flag = 1 }
    if buttons[button] != flag {
        i.pending_mouse_count = push_pair(i.pending_mouse, i.pending_mouse_count, button, flag)
    }
    buttons[button] = flag
}

inject_button(i: *Input, button: int, down: bool) {
    if button < 0 || button >= PAD_BUTTONS { return }
    flag = 0
    if down { flag = 1 }
    buttons = i.injected_buttons as int[]
    buttons[button] = flag
}

// A stick held at a value; `set` false hands the axis back to the gamepad.
inject_pad_axis(i: *Input, pad_axis: int, value: float, set: bool) {
    if pad_axis < 0 || pad_axis >= PAD_AXES { return }
    flag = 0
    if set { flag = 1 }
    marks = i.injected_axis_set as int[]
    marks[pad_axis] = flag
    axes = i.injected_axes as float[]
    axes[pad_axis] = value
}

// The cursor held at a place, in the framebuffer's pixels, over whatever
// the mouse says, until release_cursor gives it back.
inject_cursor(i: *Input, x: float, y: float) {
    i.cursor_set = true
    i.cursor_x = x
    i.cursor_y = y
}

release_cursor(i: *Input) { i.cursor_set = false }

// The wheel turned, in its steps (positive away from the user).
inject_scroll(i: *Input, steps: float) { i.pending_scroll = i.pending_scroll + steps }

// Everything injected released, and every injected event not yet polled
// dropped.
inject_clear(i: *Input) {
    keys = i.injected_keys as int[]
    k = 0
    while k < KEY_CODES { keys[k] = 0 ; k = k + 1 }
    mouse = i.injected_mouse as int[]
    k = 0
    while k < MOUSE_CODES { mouse[k] = 0 ; k = k + 1 }
    buttons = i.injected_buttons as int[]
    k = 0
    while k < PAD_BUTTONS { buttons[k] = 0 ; k = k + 1 }
    marks = i.injected_axis_set as int[]
    k = 0
    while k < PAD_AXES { marks[k] = 0 ; k = k + 1 }
    i.pending_key_count = 0
    i.pending_char_count = 0
    i.pending_mouse_count = 0
    i.pending_scroll = 0.0
    i.cursor_set = false
}
