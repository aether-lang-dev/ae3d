// ae3d.net -- multiplayer in the engine (#413).
//
// A game marks what is networked and the engine keeps it in step. One side
// hosts, the others join; the host owns the objects it marks and sends
// their state a network tick at a time (30 a second by default), and a
// client draws them from what arrived, a little in the past, interpolated
// between two snapshots so a late or lost one is not a jump.
//
// The layers, bottom up:
//
//   - a transport moves messages between the host and each peer: loopback
//     (in-process, with a conditions simulator -- latency, jitter, loss --
//     for tests and the editor's host-and-clients play), TCP over std.tcp,
//     and UDP over std.udp (ae3d.netudp: a handshake, a reliable ordered
//     channel of its own with acknowledgements and resends, unreliable
//     sequenced channels, fragments, and the same conditions simulator).
//     A message is reliable (never lost, in order: the handshake, events,
//     objects created) or not (a snapshot, an input: the next one
//     supersedes it, so waiting for a lost one would only make it later);
//   - the protocol: a hello, a welcome with the client's id, snapshots,
//     inputs, and events (a game's own messages, reliable, either way,
//     four numbers or a block of bytes);
//   - replication: net ids by the order objects are marked networked, the
//     same on both sides for a scene both build, then by the order the host
//     creates objects mid-game (a rocket, a car), told to each client as it
//     does; a history of samples a client interpolates from, and an error
//     that decays where the samples moved an object the view had held; and
//     who simulates each object -- its scripts' fixed_update and its body
//     run only there, remote everywhere else;
//   - what each client is sent, a tick at a time: its objects' states
//     quantised (a tenth of a millimetre, a rotation in 48 bits), as a delta
//     against the newest snapshot it has acknowledged (the host keeps the
//     last 32 it sent each client, and one older than that is sent whole);
//     only what is relevant to it (near its player, or always, never); and
//     within its budget of bytes a tick, the most urgent first, by a
//     priority that grows while an object waits unsent -- faster for what
//     the client can see (its view, sent with its inputs, and a ray from
//     its eye against the host's static world), slower for what it can't;
//   - fields of a script's state replicated beside an object's transform
//     (health, a speed, a flag, a place, a short text): in the same record,
//     as a delta against what the client has, only when they change;
//   - the link measured on every transport, both ways (a ping ten times a
//     second: the round trip, its jitter, what is lost) and every byte
//     counted by peer and kind, which the agent channel reads (net.stats).
//
// Time is passed in (seconds, any origin): the engine passes its clock, a
// test a clock of its own, so a run under simulated conditions is the same
// every time.

import std.bytes
import std.heap
import std.json
import std.list
import std.mem
import std.string
import std.tcp
import ae3d.core
import ae3d.agent
import ae3d.behaviour
import ae3d.engine
import ae3d.netudp
import ae3d.platform
import ae3d.physics

exports (
    Net, NetObject, LoopHub,
    ROLE_HOST, ROLE_CLIENT,
    hub_new, hub_free, hub_set_conditions,
    host_loopback, join_loopback, host_tcp, join_tcp, tcp_port,
    host_udp, join_udp, udp_port, set_conditions, set_timeout, last_heard, flush,
    networked, networked_count, step, attach, connected, disconnected, hosting, client_id, peer_count, view_time,
    set_tick_rate, set_interpolation_delay, set_precision, precision, set_deltas,
    set_relevance, set_relevant, RELEVANT_NEAR, RELEVANT_ALWAYS, RELEVANT_NEVER, set_priority,
    set_budget, set_client_budget, worst_wait, largest_snapshot, snapshot_bytes, snapshots_sent, whole_snapshots,
    objects_sent, bytes_sent, bytes_received, snapshots_received, stale_snapshots,
    host_tick, snapshot_tick, known, state_at,
    traffic, TRAFFIC_SNAPSHOTS, TRAFFIC_EVENTS, TRAFFIC_INPUTS, TRAFFIC_ACKS, TRAFFIC_HEADERS,
    TRAFFIC_ACK_PACKETS, TRAFFIC_RESENT, TRAFFIC_HANDSHAKE, datagrams_sent, largest_datagram, round_trip,
    NetPlayer, set_player_maker, host_play, player_input, my_player, player_of, player_count, prediction_error, input_sent,
    commands_asked,
    NetCall, HOST, EVERYONE, on_event, send_event, send_event_bytes, on_join, on_leave,
    object_kind, create_object, destroy_object, object_of, id_of,
    NetChange, REPLICATE_INT, REPLICATE_FLOAT, REPLICATE_BOOL, REPLICATE_VEC3, REPLICATE_TEXT, TEXT_BYTES,
    replicate, on_changed, set_text, text, field_count, fields_known, fields_tick, on_snapshot,
    set_view, set_camera_view, has_view, view_tick, set_occluders, set_visibility, set_bounds, sight, last_sent, rays_cast,
    SIGHT_NONE, SIGHT_SEEN, SIGHT_OUT, SIGHT_HIDDEN, view_bytes, hidden_bytes, worst_wait_sight,
    TRAFFIC_LINK, TRAFFIC_ALL, SENT, RECEIVED, rate, link_bytes, window_us, round_trip_us, jitter, jitter_us,
    loss, loss_ppm, pings, budget_of, worst_wait_any, last_correction, correction_um,
    set_link, link_latency, link_jitter, link_loss, set_smoothing, set_extrapolation, release,
    transport_name, session_count, session_at, session_index,
    net_free, alive, last_error
)

extern calloc(count: int, size: int) -> ptr
extern malloc(size: long) -> ptr
extern realloc(p: ptr, size: long) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern memmove(dst: ptr, src: ptr, n: long) -> ptr
extern sqrt(x: float) -> float
extern floor(x: float) -> float
// A client's view, judged on the host, is not state every peer has to hold
// to the bit (the horde is, and keeps to sqrt and floor): libm's own do.
extern sin(x: float) -> float
extern cos(x: float) -> float
extern tan(x: float) -> float
extern atan(x: float) -> float
extern atan2(y: float, x: float) -> float
extern asin(x: float) -> float
extern exp(x: float) -> float
extern log(x: float) -> float

const PI = 3.141592653589793
const ROLE_HOST = 1
const ROLE_CLIENT = 2

const HOST = 0                       // an event's recipient: the host, the only one a client sends to
const EVERYONE = 0 - 1               // an event's recipients: every client the host has welcomed

// Whether an object is relevant to a client: by its distance from the
// client's player (the session's relevance radius), always, or never.
const RELEVANT_NEAR = 0
const RELEVANT_ALWAYS = 1
const RELEVANT_NEVER = 2

// What traffic counts, a kind at a time: the messages by what they are,
// and what the UDP transport adds around them.
const TRAFFIC_SNAPSHOTS = 1          // snapshot messages
const TRAFFIC_EVENTS = 2             // reliable messages: the handshake's, events, spawns, objects created and destroyed
const TRAFFIC_INPUTS = 3             // input messages, and the acknowledgements riding on them
const TRAFFIC_ACKS = 4               // acknowledgements of snapshots sent on their own
const TRAFFIC_HEADERS = 5            // UDP: every datagram's header (which carries its acknowledgements); TCP: the length frames
const TRAFFIC_ACK_PACKETS = 6        // UDP: datagrams with nothing but acknowledgements, whole (a part of the headers)
const TRAFFIC_RESENT = 7             // UDP: reliable messages sent again
const TRAFFIC_HANDSHAKE = 8          // UDP: the connection's handshake and its disconnects
const TRAFFIC_LINK = 9               // the link's pings and their answers
const TRAFFIC_ALL = 0                // a peer's: every kind at once

// A peer's traffic, one way or the other.
const SENT = 1
const RECEIVED = 2

// 2: snapshots are deltas against an acknowledged one; 3: events, objects
// created mid-game; 4: events carrying bytes; 5: quantised, prioritised
// snapshots, acknowledgements riding on inputs, every unacknowledged
// command in each input (a repeated one a bit), the welcome's precision;
// 6: fields of a script's state in the records, the client's view on its
// inputs and acknowledgements, the link's pings; 7: each command in as many
// inputs as the link's loss asks, the host asking for one it lacks, a
// command's change from the change before, a jump a bit where there is none,
// the eye from the client's player.
const PROTOCOL = 7
const MSG_HELLO = 1                  // client -> host: [u8][u32 protocol]
const MSG_WELCOME = 2                // host -> client: [u8][u32 client id][u32 tick rate][f64 precision]
// host -> client, unreliable: [u8][u32 tick][f32 time][u32 ack][u8 base gap][varint objects][varint records]
// [u8 flags]; with flag 1 the client's player at full precision, [f32 x y z][f32 vy][u8 grounded]; with
// flag 2 the previous tick's time, [f32]; with flag 4 the oldest command the host lacks while it holds a
// later one, [varint its seq less the ack]; then a record each: [varint index gap][u8 fields], and the
// fields it names -- x, y, z as zigzag varints of their change in steps of the precision (the value
// itself when the base does not have the object), the rotation as 48 bits; then, with FIELD_STATE, its
// replicated fields: with FIELD_STATE_WHOLE [varint count], a [u8 kind] each (and [f64 precision] for a
// quantised one) and every value; without, [varint mask] of the ones that changed and their changes. An
// object with no record is as it was in the base (gap 0: none).
const MSG_SNAPSHOT = 3
// client -> host, unreliable: [u8][u16 newest snapshot][u8 flags], with flag 1 the view (VIEW_BYTES), its
// eye from the client's player's place with flag 2; [u32 first seq][u8 count][(count + 7) / 8 bytes, bit
// k of byte k / 8 set where command k is sent], then each command sent: its walk's x and z in
// millimetres a second, each a zigzag varint of what it is less the one before it and that one's own
// change (the first as it is; a command not sent changed by 0), the z's shifted up a bit whose 1 says a
// jump follows, in 64ths of a metre a second, a varint; one not sent is the one before it again (the
// first is always sent). The snapshot is the client's acknowledgement, riding on its commands: its
// tick's low 16 bits, which the host puts back beside its own tick.
const MSG_INPUT = 4
const MSG_SPAWN = 5                  // host -> client, reliable: [u8][u32 net id][u32 owner]
// client -> host, unreliable: [u8][u16 tick][u8 flags], with flag 1 the view (and flag 2 as an input's):
// a snapshot it has, when no input carried it.
const MSG_ACK = 6
const MSG_EVENT = 7                  // either way, reliable: [u8][u16 event][u8 count], then count f32 values
// host -> client, reliable: [u8][u32 net id][u16 kind][f32 host time][f32 x y z][f32 qx qy qz qw],
// an object the host created, where it has it now.
const MSG_CREATE = 8
// host -> client, reliable: [u8][u32 net id][f32 host time][f32 x y z][f32 qx qy qz qw], a created
// object gone, and where it was last.
const MSG_DESTROY = 9
const MSG_EVENT_BYTES = 10           // either way, reliable: [u8][u16 event][u32 length], then length bytes
// Either way, unreliable, unsequenced: [u8][u16 ping], ten a second; the other side answers each at
// once with a pong, [u8][u16 ping]. What the round trip, its jitter and the loss are measured by, the
// same on every transport.
const MSG_PING = 11
const MSG_PONG = 12

// A snapshot's flags.
const SNAP_OWN = 1                   // the client's own player follows
const SNAP_PREVIOUS = 2              // the previous tick's time follows
const SNAP_WANTED = 4                // the oldest command the host lacks follows
const SNAP_GONE = 8                  // the last fields of objects destroyed since the base follow the records

// A record's fields.
const FIELD_X = 1
const FIELD_Y = 2
const FIELD_Z = 4
const FIELD_ROTATION = 8
const FIELD_WHOLE = 16               // the base does not have it: every field, as its value
const FIELD_HELD = 32                // the base's state was still its state at the previous tick
const FIELD_STATE = 64               // its replicated fields follow: the ones that changed
const FIELD_STATE_WHOLE = 128        // and the base has none of them: their kinds, and every value

// A field of a script's state, by kind (#486). A float and a Vec3 go in
// whole steps of a precision, or as their 64 bits where it is 0; an int as
// a zigzag varint; a text up to TEXT_BYTES bytes.
const REPLICATE_INT = 1
const REPLICATE_FLOAT = 2
const REPLICATE_BOOL = 3
const REPLICATE_VEC3 = 4
const REPLICATE_TEXT = 5
const KIND_STEPPED = 8               // on the wire, a kind's bit: its values are steps of the precision that follows
const TEXT_BYTES = 31                // a text field's bytes at most
const TEXT_WORDS = 4                 // the words a text takes in a snapshot: its length, then its bytes
const FIELDS_MOST = 32               // the fields one object replicates at most: a record's mask is a varint of 32 bits

// What a client can see of an object, by the view it sent (#487).
const SIGHT_NONE = 0                 // no view to judge by: distance alone
const SIGHT_SEEN = 1                 // in the view's frustum, and a ray from the eye reaches it
const SIGHT_OUT = 2                  // outside the frustum: behind the camera, or off to the side
const SIGHT_HIDDEN = 3               // in the frustum, and the static world is in the way
const SIGHT_BOOST = 4.0              // what seeing an object multiplies the priority it gathers by
const SIGHT_CUT = 4.0                // and not seeing it divides it by
// The view's frustum is widened by this much each way, radians: a view is
// sent only once it has turned a degree (VIEW_TURN), so the host's may be
// that far behind the camera's.
const SIGHT_MARGIN = 0.035
const SIGHT_EVERY = 6                // ticks between the rays for an object that stays in view (a fifth of a second)
const OVERDUE = 1000000000.0         // what a seen object that has waited a tick is sorted ahead by: past any priority gathered
const SIGHT_STALE = 45               // ticks an unseen object waits at most before it goes ahead too (a second and a half)
const VIEW_BYTES = 18                // [f32 x y z][u16 yaw][u16 pitch][u8 degrees of vertical view][u8 aspect * 32]
const VIEW_MOVE = 0.25               // metres the eye moves before the view is sent again
const VIEW_TURN = 0.0175             // radians it turns (a degree), or its view widens
const VIEW_REFRESH = 0.5             // seconds after which the view is sent again anyway: a lost one is not kept for long

// The link's measure (#488).
const PING_EVERY = 0.1               // seconds between pings, each way
const PINGS = 64                     // pings kept in flight, by their number
const PING_LOST = 1.0                // seconds after which an unanswered ping is lost
const LOSS_PINGS = 50                // the pings the loss is judged over: the last five seconds
const LINK_KINDS = 10                // a peer's traffic counters, by TRAFFIC_*: [0] unused, 1..9
const WINDOW = 1.0                   // seconds a rate is taken over

const KIND_LOOP = 1
const KIND_TCP = 2
const KIND_UDP = 3

const EVENT_CONNECTED = 1
const EVENT_DISCONNECTED = 2
const EVENT_MESSAGE = 3

const HISTORY = 32                   // samples an object keeps: a second at 30 a second
const SMOOTHING = 0.1                // seconds a remote object's drawing error takes to fall to a third
const TELEPORT = 4.0                 // metres: an error past this is the object moved, taken at once
const EXTRAPOLATION = 0.1            // seconds a moving object is carried on past the newest snapshot, by default
const CARRIED_SPAN = 0.25            // seconds its last two samples may be apart for their motion to be carried on
const KEPT = 33                      // snapshots each side keeps to delta against: the 32 newest, and the one being built
const STATE = 4                      // numbers an object's quantised state: x y z in steps, the rotation's 48 bits
const OWN = 5                        // numbers the client's own player: x y z, vy, grounded
const SAMPLE = 8                     // floats a sample: the host's time, x y z, qx qy qz qw
const TCP_CHUNK = 65536
const HUB_ENDPOINTS = 64
const COMMANDS = 128                 // a client's commands kept until the host has applied them
const COMMAND = 5                    // floats a command: seq, walk x, walk z, jump, the input messages it went in
const INPUTS_MOST = 64               // the commands an input message carries at most, the oldest: a second of them
const CARRIED = 3                    // the input messages a command goes in at least: it is lost only when all of them are
const CARRIED_LOST = 0.000001        // at the link's measured loss, the share of commands every message of which may be lost
const PLAYER_STEP = 0.016666666666666666   // a command's step, seconds: the fixed step's
const WALK_STEPS = 1000.0            // a command's walk in steps of a millimetre a second
const JUMP_STEPS = 64.0              // its jump in steps of a 64th of a metre a second
const QUEUE_DEPTH = 3                // host: the commands a client's queue holds before it catches up
const EVENT_VALUES = 4               // the numbers an event carries at most
const HALF_ROOT_TWO = 0.7071067811865476   // a unit quaternion's second largest component is at most this
const ROTATION_STEPS = 32767.0       // a component of the three smallest in 15 bits
const NEAR_WEIGHT = 10.0             // metres: an object this close to a client's player waits a tenth as long

var g_error = ""
var g_error_owned = false            // g_error was made for it: freed when the next replaces it
var g_alive = 0                      // sessions made and not yet freed
var g_hubs = 0
// Every session made and not yet freed, in the order they were made: what
// the agent channel's net.* ops answer about (net.stats names a session by
// its place here), a program's host and its clients alike.
var g_sessions: ptr = null
var g_answering = false              // net.* ops handed to the agent channel

last_error() -> string { return g_error }

// What last_error says next: a text made for it -- an interpolation, which
// the module then owns, and frees when the next replaces it -- or one it
// only borrows, a literal or another module's.
error_made(text: string) {
    if g_error_owned { string.free(g_error) }
    g_error = text
    g_error_owned = true
}

error_borrowed(text: string) {
    if g_error_owned { string.free(g_error) }
    g_error = text
    g_error_owned = false
}

// Sessions and hubs made and not yet freed: what a program that tears its
// play down checks it let go of.
alive() -> int { return g_alive + g_hubs }

// --- bytes ---------------------------------------------------------------------------------

// A growable byte buffer a message is written into.
struct NetBuf {
    data: ptr
    length: int
    capacity: int
}

buf_new(capacity: int) -> *NetBuf {
    b = calloc(1, sizeof(NetBuf)) as *NetBuf
    b.data = malloc(capacity as long)
    b.capacity = capacity
    return b
}

buf_free(b: *NetBuf) {
    if b == null { return }
    free(b.data)
    free(b as ptr)
}

buf_reserve(b: *NetBuf, more: int) {
    if b.length + more <= b.capacity { return }
    wanted = b.capacity * 2
    while wanted < b.length + more { wanted = wanted * 2 }
    b.data = realloc(b.data, wanted as long)
    b.capacity = wanted
}

put_u8(b: *NetBuf, value: int) {
    buf_reserve(b, 1)
    mem.set_byte(b.data, b.length, value)
    b.length = b.length + 1
}

put_u16(b: *NetBuf, value: int) {
    buf_reserve(b, 2)
    mem.set_u16_le(b.data, b.length, value)
    b.length = b.length + 2
}

put_u32(b: *NetBuf, value: int) {
    buf_reserve(b, 4)
    mem.set_u32_le(b.data, b.length, value as long)
    b.length = b.length + 4
}

put_f32(b: *NetBuf, value: float) {
    buf_reserve(b, 4)
    mem.set_float32(b.data, b.length, value)
    b.length = b.length + 4
}

put_f64(b: *NetBuf, value: float) {
    buf_reserve(b, 8)
    mem.set_float64(b.data, b.length, value)
    b.length = b.length + 8
}

// An unsigned number seven bits a byte, low first, the top bit saying
// another follows (LEB128): a change of a few steps is one byte.
put_varint(b: *NetBuf, value: long) {
    v = value
    while v >= (128 as long) {
        put_u8(b, ((v % (128 as long)) as int) + 128)
        v = v / (128 as long)
    }
    put_u8(b, v as int)
}

varint_size(value: long) -> int {
    size = 1
    v = value
    while v >= (128 as long) {
        v = v / (128 as long)
        size = size + 1
    }
    return size
}

// A signed number folded onto the unsigned ones, small either way first:
// 0, -1, 1, -2, 2 ... as 0, 1, 2, 3, 4 ...
zigzag(value: long) -> long {
    if value >= (0 as long) { return value * (2 as long) }
    return (0 as long) - value * (2 as long) - (1 as long)
}

unzigzag(value: long) -> long {
    if value % (2 as long) == (0 as long) { return value / (2 as long) }
    return (0 as long) - (value + (1 as long)) / (2 as long)
}

// A message read from the front: `at` moves on, and a read past the end
// leaves `ok` false rather than reading what is not there.
struct NetReader {
    data: ptr
    length: int
    at: int
    ok: bool
}

get_u8(r: *NetReader) -> int {
    if r.at + 1 > r.length { r.ok = false ; return 0 }
    v = mem.get_byte(r.data, r.at)
    r.at = r.at + 1
    return v
}

get_u16(r: *NetReader) -> int {
    if r.at + 2 > r.length { r.ok = false ; return 0 }
    v = mem.get_u16_le(r.data, r.at)
    r.at = r.at + 2
    return v
}

get_u32(r: *NetReader) -> int {
    if r.at + 4 > r.length { r.ok = false ; return 0 }
    v = (mem.get_u32_le(r.data, r.at)) as int
    r.at = r.at + 4
    return v
}

get_f32(r: *NetReader) -> float {
    if r.at + 4 > r.length { r.ok = false ; return 0.0 }
    v = mem.get_float32(r.data, r.at)
    r.at = r.at + 4
    return v
}

get_f64(r: *NetReader) -> float {
    if r.at + 8 > r.length { r.ok = false ; return 0.0 }
    v = mem.get_float64(r.data, r.at)
    r.at = r.at + 8
    return v
}

get_varint(r: *NetReader) -> long {
    value = 0 as long
    scale = 1 as long
    k = 0
    while k < 10 {
        octet = get_u8(r)
        if !r.ok { return 0 as long }
        value = value + ((octet % 128) as long) * scale
        if octet < 128 { return value }
        scale = scale * (128 as long)
        k = k + 1
    }
    r.ok = false
    return 0 as long
}

// --- the loopback transport ------------------------------------------------------------------
//
// Every loopback endpoint of a session shares a hub, and a message is a
// parcel on the hub until the clock passes the time it lands. The hub's
// conditions are a link's: a latency, a jitter on top of it, and a share
// of unreliable parcels lost. A reliable parcel is never lost and never
// lands before one sent ahead of it to the same endpoint.

struct Parcel {
    lands: float
    from: int                        // endpoint ids
    to: int
    data: ptr
    length: int
}

struct LoopHub {
    parcels: ptr                     // list of *Parcel
    endpoints: int                   // ids handed out; the host is 1
    host_open: bool
    latency: float                   // seconds, one way
    jitter: float                    // up to this much more, uniformly
    loss: float                      // the share of unreliable parcels dropped
    seed: long
    last_reliable: ptr               // float[HUB_ENDPOINTS]: when the last reliable parcel to each lands
    joining: ptr                     // int[HUB_ENDPOINTS]: endpoints the host has not seen yet
    joining_count: int
}

hub_new() -> *LoopHub {
    h = calloc(1, sizeof(LoopHub)) as *LoopHub
    h.parcels = list.new()
    h.joining = calloc(HUB_ENDPOINTS, 4)
    h.last_reliable = calloc(HUB_ENDPOINTS, 8)
    h.seed = 12345
    g_hubs = g_hubs + 1
    return h
}

hub_free(h: *LoopHub) {
    if h == null { return }
    i = 0
    while i < list.size(h.parcels) {
        p = list.get_raw(h.parcels, i) as *Parcel
        free(p.data)
        free(p as ptr)
        i = i + 1
    }
    list.free(h.parcels)
    free(h.joining)
    free(h.last_reliable)
    free(h as ptr)
    g_hubs = g_hubs - 1
}

// The link every parcel crosses: `latency` and up to `jitter` more seconds
// one way, and `loss` of the unreliable ones (0..1) never arriving.
hub_set_conditions(h: *LoopHub, latency: float, jitter: float, loss: float) {
    h.latency = latency
    h.jitter = jitter
    h.loss = loss
}

// A uniform number in [0, 1) from the hub's own generator: the same
// conditions give the same run.
hub_random(h: *LoopHub) -> float {
    h.seed = h.seed * 6364136223846793005 + 1442695040888963407
    bits = (h.seed / 4294967296) % 16777216
    if bits < 0 { bits = 0 - bits }
    return (bits as float) / 16777216.0
}

hub_post(h: *LoopHub, from: int, to: int, reliable: bool, data: ptr, length: int, now: float) {
    if !reliable && h.loss > 0.0 && hub_random(h) < h.loss { return }
    lands = now + h.latency
    if h.jitter > 0.0 { lands = lands + h.jitter * hub_random(h) }
    ends = h.last_reliable as float[]
    if reliable && to >= 0 && to < HUB_ENDPOINTS {
        if lands < ends[to] { lands = ends[to] }
        ends[to] = lands
    }
    p = calloc(1, sizeof(Parcel)) as *Parcel
    p.lands = lands
    p.from = from
    p.to = to
    p.data = malloc(length as long)
    memcpy(p.data, data, length as long)
    p.length = length
    list.add_raw(h.parcels, p as ptr)
}

// --- a session -------------------------------------------------------------------------------

struct Peer {
    id: int                          // the session's id for it: 1, 2, ... on the host; 0 is the host on a client
    endpoint: int                    // loopback: its hub endpoint
    socket: ptr                      // tcp: the connection
    conn: int                        // udp: the endpoint's connection
    pending: ptr                     // tcp: bytes read and not yet a whole message
    pending_length: int
    pending_capacity: int
    welcomed: bool
    open: bool
    last_input: int                  // host: the newest command of this client's it has applied
    player: ptr                      // host: this client's *NetPlayer
    // Host: the client's commands received and not yet applied, a ring of
    // float[COMMANDS * COMMAND] by sequence. One is applied a host step, so
    // a player moves in the host's world at the pace it walked, whatever the
    // link's jitter did to when the commands arrived; one that arrives
    // after a later one (a UDP link reorders) is applied in its turn.
    queued: ptr
    last_queued: int                 // the newest command received
    // Host: the snapshots told it, a ring of KEPT, and the newest it has
    // acknowledged, which the next is a delta against.
    ring: ptr                        // ptr[KEPT]: *Snapshot
    acked_tick: int
    // Host: what the priority works with, an entry an object: the
    // priority it has gathered waiting, the ticks it has waited changed
    // and unsent, the most it ever waited, and the tick it was last sent.
    capacity: int
    accum: ptr                       // float[capacity]
    waits: ptr                       // int[capacity]
    worst: ptr                       // int[capacity]
    marked: ptr                      // int[capacity]: the tick it was chosen for
    budget: int                      // bytes a snapshot at most, this client's own; 0 the session's
    largest: int                     // the largest snapshot it was sent
    snapshot_bytes: long
    snapshots: int
    wholes: int                      // of them, whole: no base the client was known to hold
    worst_any: int                   // the most any object waited
    // Host: what the client can see (#487), by the newest view it sent:
    // its eye, the way it looks and the frustum's axes across it, and the
    // cosines and sines of the frustum's half angles, widened by
    // SIGHT_MARGIN; and what that made of each object -- its sight
    // (SIGHT_*), the tick a ray was last cast to it, and how many ticks in
    // a row it has waited unsent in the sight it has now.
    view_known: bool
    view_tick: int                   // the first tick judged by the newest view
    eye: Vec3
    eye_offset: Vec3                 // an eye sent from the client's player: from its place
    eye_follows: bool                // and put there again each tick, the player's place on the host
    forward: Vec3
    right: Vec3
    upward: Vec3
    cos_side: float
    sin_side: float
    cos_up: float
    sin_up: float
    sights: ptr                      // int[capacity]
    sighted: ptr                     // int[capacity]
    sight_waits: ptr                 // int[capacity]
    worst_sight: ptr                 // int[4]: the most an object waited in a row in each sight
    view_bytes: long                 // record bytes of objects it could see when they went
    hidden_bytes: long               // and of the ones it could not (outside the view, or occluded)
    rays: long                       // rays cast for it
    // The link, measured the same on every transport (#488): a ping ten
    // times a second, each answered at once, gives the round trip, its
    // variance -- integer microseconds, smoothed as RFC 6298 (and TCP)
    // smooths them, in the units the channel reports exactly -- and, over
    // the last LOSS_PINGS judged, the share lost. And every byte to the
    // peer and from it, by kind, with each kind's rate over the last
    // window of a second.
    ping_times: ptr                  // float[PINGS]: when each went, by its number
    ping_states: ptr                 // int[PINGS]: 0 none, 1 in flight, 2 answered, 3 lost
    next_ping: int
    ping_at: float                   // when the last went; below 0 never
    srtt_us: int
    rttvar_us: int
    rtt_known: bool
    outcomes: ptr                    // int[LOSS_PINGS]: 1 lost, 0 answered, a ring
    outcome_count: int
    outcome_next: int
    pings_sent: int
    pings_answered: int
    pings_lost: int
    sent_bytes: ptr                  // long[LINK_KINDS], by TRAFFIC_*
    recv_bytes: ptr                  // long[LINK_KINDS]
    window_sent: ptr                 // long[LINK_KINDS]: the counts when the window began
    window_recv: ptr
    rate_sent: ptr                   // long[LINK_KINDS]: whole bytes a second over the last window
    rate_recv: ptr
    window_start: float              // below 0: not begun
    window_us: long                  // the last window's length, microseconds
}

// A snapshot as one side keeps it: every object's quantised state at a
// tick, and whether that state is known -- to the client, whether it has
// been told; to the host, whether it has told this client (an object
// outside the client's relevance, or past its budget, keeps what it was
// last told). And the client's own player, at full precision.
struct Snapshot {
    tick: int
    time: float                      // the host's time at it
    count: int
    capacity: int
    states: ptr                      // float[capacity * STATE]
    known: ptr                       // int[capacity]
    own: ptr                         // float[OWN]
    own_known: bool
    used: bool
    // The replicated fields: every object's as words (NetLayout.at), a
    // number a word -- an int, a float's steps or bits, a bool, a text's
    // length and bytes -- and whether an object's are known, apart from
    // its transform (a client's own player has fields told it, never its
    // transform).
    fvalues: ptr                     // long[fcapacity]
    fcapacity: int
    fknown: ptr                      // int[capacity]
    // Client: the tick of the record that last brought an object's fields.
    // A snapshot cannot say an object is gone, so after the host destroys
    // one its fields are the base's again, older than the ones applied:
    // only what is at least as new as those is written.
    fticks: ptr                      // int[capacity]
}

struct NetEvent {
    kind: int
    peer: int
    data: ptr
    length: int
}

// A player: a character controller on a networked object, owned by a
// client. The host moves it by the client's commands; the owning client
// moves its own ahead of the host (prediction) and puts it back where the
// host says it was, replaying what the host has not applied yet
// (reconciliation); every other client draws it interpolated.
struct NetPlayer {
    client: int
    net_id: int
    controller: *CharacterController
}

struct NetObject {
    id: int
    object: *GameObject
    history: ptr                     // float[HISTORY * SAMPLE], a ring
    count: int                       // samples held
    newest: int                      // the newest one's slot
    kind: int                        // a created object's kind id; 0 for one the scene marked, or a player
    leaving: bool                    // client: the host has destroyed it, and it goes at `leaves`
    leaves: float                    // the host's time it was destroyed
    relevance: int                   // host: RELEVANT_NEAR, _ALWAYS or _NEVER
    priority: float                  // host: how fast its priority grows while it waits (1 by default)
    captured: bool                   // host: a tick has taken its state, so its fields are fixed
    fields: ptr                      // list of *NetField, its own in their order; null for none
    // Another peer simulates it (behaviour.object_remote): what the
    // session set, and whether it made a dynamic body on it kinematic --
    // both given back when the session lets it go.
    remote: bool
    body_driven: bool
    // Client: where it was drawn last, and the error it is drawn off where
    // its samples put it by, decaying: the view that ran past the newest
    // sample carried it on or held it there, and the samples that came
    // after put it elsewhere -- corrected over the smoothing's time, never
    // at once. What it was last drawn from while the view was past its
    // samples: the two samples' slots in its history and their times.
    drawn: Vec3
    drawn_known: bool
    held: bool
    carried: bool
    from_a: int
    from_c: int
    from_a_time: float
    from_c_time: float
    error: Vec3
    // The sphere a client's view is judged against (#487): its centre from
    // the object's place, on the world's axes, and its radius.
    bound_centre: Vec3
    bound_radius: float
}

// A field of a script's state, replicated (#486): which object's, its
// order among that object's fields, what it is, and where the game keeps
// it. The host reads it every tick; a client writes it from every
// snapshot and calls the hook when that changes it. A text is the
// session's to keep (`text`): a string field of the game's own has an
// owner already, the setter that assigned it.
struct NetField {
    object: *GameObject
    id: int                          // its object's net id; 0 until the object is networked
    order: int
    name: string
    kind: int
    precision: float                 // a float's, a Vec3's: a step; 0, its 64 bits
    field: ptr                       // the game's int, float, bool or Vec3; null for a text
    value: string                    // a text's, the session's
    packed: ptr                      // a text's as a snapshot holds it: TEXT_WORDS words
    applied_tick: int                // client: the tick of the record its value was last written from
    hook: fn(ptr, *NetChange)
    context: ptr
}

// What a field is on the wire, an object's at a time: learned from its
// registrations on the host, and from the first whole record on a client
// (which may come before the object is made there: a snapshot is not held
// up behind the reliable word that makes it). Where its words start in
// every snapshot's block, and each field's kind, precision and words.
struct NetLayout {
    count: int
    at: int
    words: int
    kinds: ptr                       // int[FIELDS_MOST]
    offsets: ptr                     // int[FIELDS_MOST]: words from `at`
    precisions: ptr                  // float[FIELDS_MOST]
}

// Host: an object destroyed with fields, as they were when it went: the
// snapshots leave it out from then on, so they carry these instead, to
// every client that has not yet acknowledged a snapshot of `tick`.
struct NetGone {
    id: int
    tick: int                        // the first tick without it
    lay: *NetLayout                  // its layout, at 0
    words: ptr                       // long[lay.words]
}

// What a field's hook is told: the object, the field (its name and its
// order among the object's), the snapshot's tick that changed it, and this
// side's time in the step it arrived.
struct NetChange {
    object: *GameObject
    id: int
    name: string
    order: int
    tick: int
    now: float
}

// What an event brings its handler: which event it is, who sent it (a
// client's id on the host; HOST, 0, on a client), and the numbers it
// carries, 0 where the sender gave fewer. An event sent with bytes
// (send_event_bytes) carries them instead: `data` and `length`, the
// session's until the handler returns; null and 0 for one with numbers.
// `now` is this side's time in the step it arrived, what a reply sends at.
struct NetCall {
    event: int
    sender: int
    a: float
    b: float
    c: float
    d: float
    data: ptr
    length: int
    now: float
}

// Called on the host with every client it welcomes, or that leaves.
struct NetJoinHook {
    hook: fn(ptr, int, float)
    context: ptr
}

// An event a game has registered: its name, and what is called with every
// one that arrives.
struct NetHandler {
    name: string
    handler: fn(ptr, *NetCall)
    context: ptr
}

// A kind of object the host creates mid-game: its name, and how the game
// makes one and lets one go, the same on both sides.
struct NetKind {
    name: string
    maker: fn(ptr, int) -> *GameObject
    unmaker: fn(ptr, *GameObject)
    context: ptr
}

struct Net {
    role: int
    kind: int
    hub: *LoopHub
    endpoint: int                    // loopback: this side's
    server: ptr                      // tcp host: the listener
    udp: *UdpEndpoint                // udp: the socket and its connections
    port: int
    peers: ptr                       // list of *Peer
    events: ptr                      // list of *NetEvent, this step's
    objects: ptr                     // list of *NetObject, by id - 1
    tick_rate: float
    since_tick: float
    tick: int
    last_step: float
    interpolation_delay: float
    offset: float                    // client: the host's time minus ours, from the least-delayed snapshot
    offset_known: bool
    my_id: int                       // client: the id the host gave it, 0 before
    closed: bool                     // client: the link to the host is gone
    out: *NetBuf
    measured: *NetBuf                // host: a record measured before it goes
    sent: long
    got: long
    snapshots: int
    stale: int                       // client: snapshots dropped for arriving after a newer one
    scratch: ptr                     // 8 bytes: a number rounded through f32
    // Replication: the precision positions go in, and the host's states
    // this tick and the tick before (whether an object that starts to move
    // was still where the client last had it).
    unit: float
    deltas: bool
    current: *Snapshot
    previous: *Snapshot
    candidates: ptr                  // host: int[scratch_capacity]
    urgency: ptr                     // host: float[scratch_capacity], what the candidates are sorted by
    records: ptr                     // client: int[scratch_capacity], the indices a snapshot carried
    fields: ptr                      // client: int[scratch_capacity], their fields
    scratch_capacity: int
    budget: int                      // host: bytes a snapshot at most, every client's that has none of its own; 0 no limit
    // Traffic, a kind at a time (TRAFFIC_*), and what the UDP transport
    // adds is read off it.
    traffic: ptr                     // long[9]
    // Players: made by the game's maker, on the host for every client it
    // welcomes and on a client for every spawn it is told of.
    player_maker: fn(ptr, int) -> *CharacterController
    maker_context: ptr
    players: ptr                     // list of *NetPlayer
    mine: ptr                        // client: its own *NetPlayer, or null
    commands: ptr                    // client: float[COMMANDS * COMMAND], a ring of the unacknowledged
    command_count: int
    command_first: int               // the ring's oldest slot
    next_seq: int
    acked: int                       // client: the host's newest applied command
    wanted: int                      // client: the oldest command the host lacks, as its newest snapshot said; 0 for none
    asked: int                       // client: the times the host said it lacked one
    worst_correction: float          // client: the most a reconciliation moved its player, metres
    inputs_sent: int
    player_clock: float              // host: time since the first step, less the player steps taken
    player_started: bool
    received: ptr                    // client: ptr[KEPT], *Snapshot rebuilt from their deltas
    newest_tick: int                 // client: the newest snapshot it holds
    ack_due: bool                    // client: it holds a snapshot it has not acknowledged
    ack_since: float                 // client: since when
    relevance: float                 // host: metres around a client's player beyond which it is not sent anything; 0 for all
    objects_sent: long               // host: records written, all clients
    handlers: ptr                    // list of *NetHandler, by event id - 1
    kinds: ptr                       // list of *NetKind, by kind id - 1
    joins: ptr                       // host: list of *NetJoinHook
    leaves: ptr                      // host: list of *NetJoinHook
    takes: ptr                       // client: list of *NetJoinHook, told of every snapshot taken
    // Replicated fields (#486): every one registered, in order; each
    // object's layout on the wire, by id - 1; the words a snapshot's block
    // takes for them all.
    replicated: ptr                  // list of *NetField
    layouts: ptr                     // list of *NetLayout, null where an object has none
    field_words: int
    spare_words: ptr                 // list of *NetLayout let go, whose words a new one of their size takes
    gone: ptr                        // host: list of *NetGone some client has not had
    // Client: the view it sends (#487), what it last sent, and when.
    view_set: bool
    view_eye: Vec3
    view_dir: Vec3
    view_fov: float                  // radians, vertical
    view_aspect: float
    view_sent: bool
    sent_eye: Vec3                   // from its player's place, where it sent it so
    sent_follows: bool
    sent_dir: Vec3
    sent_fov: float
    sent_aspect: float
    view_sent_at: float
    // Host: the static world a client's view is occluded by, and whether
    // what a client sees weighs on its priority (by default, once it sends
    // a view).
    occluders: *Physics
    sighted: bool
    last_correction: float           // client: what the newest reconciliation moved its player, metres
    smoothing: float                 // client: seconds a remote object's error takes to fall to a third (0: at once)
    extrapolation: float             // client: seconds a moving object is carried on past the newest snapshot (0: held)
    newest_time: float               // client: the host's time of its newest snapshot
    last_draw: float                 // client: when the objects were last drawn; below 0 never
}

net_new(role: int, kind: int) -> *Net {
    n = calloc(1, sizeof(Net)) as *Net
    n.role = role
    n.kind = kind
    n.peers = list.new()
    n.events = list.new()
    n.objects = list.new()
    n.tick_rate = 30.0
    n.interpolation_delay = 0.1
    n.last_step = 0.0 - 1.0
    n.out = buf_new(2048)
    n.measured = buf_new(64)
    n.scratch = calloc(1, 8)
    n.unit = 0.0001
    n.deltas = true
    n.current = snapshot_new()
    n.previous = snapshot_new()
    n.traffic = calloc(LINK_KINDS, 8)
    n.players = list.new()
    n.commands = calloc(COMMANDS * COMMAND, 8)
    n.next_seq = 1
    n.received = calloc(KEPT, 8)
    n.handlers = list.new()
    n.kinds = list.new()
    n.joins = list.new()
    n.leaves = list.new()
    n.takes = list.new()
    n.replicated = list.new()
    n.layouts = list.new()
    n.spare_words = list.new()
    n.gone = list.new()
    n.sighted = true
    n.view_sent_at = 0.0 - 1.0
    n.smoothing = SMOOTHING
    n.extrapolation = EXTRAPOLATION
    n.last_draw = 0.0 - 1.0
    g_alive = g_alive + 1
    if g_sessions == null { g_sessions = list.new() }
    list.add_raw(g_sessions, n as ptr)
    // The agent channel asks every session there is (net.stats): handed
    // the net.* ops once, by the first session a program makes.
    if !g_answering {
        agent.provide("net.", answer_op, null)
        g_answering = true
    }
    return n
}

// A number as a 32-bit float carries it.
as_f32(n: *Net, x: float) -> float {
    mem.set_float32(n.scratch, 0, x)
    return mem.get_float32(n.scratch, 0)
}

snapshot_new() -> *Snapshot {
    shot = calloc(1, sizeof(Snapshot)) as *Snapshot
    shot.own = calloc(OWN, 8)
    return shot
}

snapshot_free(shot: *Snapshot) {
    if shot == null { return }
    if shot.states != null { free(shot.states) }
    if shot.known != null { free(shot.known) }
    if shot.fknown != null { free(shot.fknown) }
    if shot.fticks != null { free(shot.fticks) }
    if shot.fvalues != null { free(shot.fvalues) }
    free(shot.own)
    free(shot as ptr)
}

// A snapshot made ready for `count` objects and `words` of their fields at
// a tick, nothing known.
snapshot_reset(shot: *Snapshot, tick: int, time: float, count: int, words: int) {
    if count > shot.capacity || shot.states == null {
        wanted = shot.capacity * 2
        if wanted < 16 { wanted = 16 }
        while wanted < count { wanted = wanted * 2 }
        if shot.states != null { free(shot.states) }
        if shot.known != null { free(shot.known) }
        if shot.fknown != null { free(shot.fknown) }
        if shot.fticks != null { free(shot.fticks) }
        shot.states = calloc(wanted * STATE, 8)
        shot.known = calloc(wanted, 4)
        shot.fknown = calloc(wanted, 4)
        shot.fticks = calloc(wanted, 4)
        shot.capacity = wanted
    }
    if words > shot.fcapacity || shot.fvalues == null {
        wanted = shot.fcapacity * 2
        if wanted < 16 { wanted = 16 }
        while wanted < words { wanted = wanted * 2 }
        if shot.fvalues != null { free(shot.fvalues) }
        shot.fvalues = calloc(wanted, 8)
        shot.fcapacity = wanted
    }
    shot.tick = tick
    shot.time = time
    shot.count = count
    mem.set(shot.known, 0, (count * 4) as long)
    mem.set(shot.fknown, 0, (count * 4) as long)
    mem.set(shot.fticks, 0, (count * 4) as long)
    shot.own_known = false
    shot.used = true
}

// A ring of KEPT snapshots: the one at a tick, and one to write the next
// into -- never the base the next is a delta against.
ring_find(ring: ptr, tick: int) -> *Snapshot {
    if tick <= 0 { return null }
    slots = ring as ptr[]
    k = 0
    while k < KEPT {
        shot = slots[k] as *Snapshot
        if shot != null && shot.used && shot.tick == tick { return shot }
        k = k + 1
    }
    return null
}

ring_take(ring: ptr, keep: *Snapshot) -> *Snapshot {
    slots = ring as ptr[]
    best = 0 - 1
    k = 0
    while k < KEPT {
        shot = slots[k] as *Snapshot
        if shot == null {
            slots[k] = snapshot_new() as ptr
            return slots[k] as *Snapshot
        }
        if shot != keep {
            if !shot.used { return shot }
            if best < 0 || shot.tick < (slots[best] as *Snapshot).tick { best = k }
        }
        k = k + 1
    }
    return slots[best] as *Snapshot
}

ring_free(ring: ptr) {
    if ring == null { return }
    slots = ring as ptr[]
    k = 0
    while k < KEPT {
        snapshot_free(slots[k] as *Snapshot)
        k = k + 1
    }
    free(ring)
}

// Objects farther than `metres` from a client's player are not sent to it:
// what it has of them stays as it was, and costs nothing, until they come
// back within reach. 0 sends everything to everyone (the default).
set_relevance(n: *Net, metres: float) { n.relevance = metres }

// One object's relevance, whatever the radius: RELEVANT_ALWAYS (a
// scoreboard, the ball), RELEVANT_NEVER (what only the host needs), or
// RELEVANT_NEAR (the default: by its distance).
set_relevant(n: *Net, o: *GameObject, mode: int) {
    no = net_object_of(n, o)
    if no != null { no.relevance = mode }
}

// How fast an object's priority grows while it waits unsent: 1 by
// default; 2 is sent twice as often as its neighbours when the budget is
// tight.
set_priority(n: *Net, o: *GameObject, priority: float) {
    no = net_object_of(n, o)
    if no != null && priority > 0.0 { no.priority = priority }
}

// The bytes a snapshot may take, every client's that has no budget of its
// own: what does not fit goes next tick, first. 0 (the default) sends all
// that changed.
set_budget(n: *Net, bytes: int) {
    if bytes >= 0 { n.budget = bytes }
}

// One client's budget, over the session's.
set_client_budget(n: *Net, client: int, bytes: int) {
    p = peer_by_id(n, client)
    if p != null && bytes >= 0 { p.budget = bytes }
}

// The precision positions are sent at, metres (a tenth of a millimetre by
// default). The host's, before any client joins: a client takes it from
// its welcome.
set_precision(n: *Net, metres: float) {
    if n.role == ROLE_HOST && metres > 0.0 { n.unit = metres }
}

precision(n: *Net) -> float { return n.unit }

// Whether snapshots are deltas against what each client has acknowledged
// (the default), or whole, every relevant object every tick: what the
// deltas save is measured against the second.
set_deltas(n: *Net, on: bool) { n.deltas = on }

// Records the host has written into snapshots, every client's.
objects_sent(n: *Net) -> long { return n.objects_sent }

peer_new(id: int) -> *Peer {
    p = calloc(1, sizeof(Peer)) as *Peer
    p.id = id
    p.open = true
    p.ring = calloc(KEPT, 8)
    p.worst_sight = calloc(4, 4)
    p.ping_times = calloc(PINGS, 8)
    p.ping_states = calloc(PINGS, 4)
    p.ping_at = 0.0 - 1.0
    p.outcomes = calloc(LOSS_PINGS, 4)
    p.sent_bytes = calloc(LINK_KINDS, 8)
    p.recv_bytes = calloc(LINK_KINDS, 8)
    p.window_sent = calloc(LINK_KINDS, 8)
    p.window_recv = calloc(LINK_KINDS, 8)
    p.rate_sent = calloc(LINK_KINDS, 8)
    p.rate_recv = calloc(LINK_KINDS, 8)
    p.window_start = 0.0 - 1.0
    return p
}

peer_free(p: *Peer) {
    if p.socket != null { tcp.tcp_close(p.socket) }
    if p.pending != null { free(p.pending) }
    if p.queued != null { free(p.queued) }
    ring_free(p.ring)
    if p.accum != null { free(p.accum) }
    if p.waits != null { free(p.waits) }
    if p.worst != null { free(p.worst) }
    if p.marked != null { free(p.marked) }
    if p.sights != null { free(p.sights) }
    if p.sighted != null { free(p.sighted) }
    if p.sight_waits != null { free(p.sight_waits) }
    free(p.worst_sight)
    free(p.ping_times)
    free(p.ping_states)
    free(p.outcomes)
    free(p.sent_bytes)
    free(p.recv_bytes)
    free(p.window_sent)
    free(p.window_recv)
    free(p.rate_sent)
    free(p.rate_recv)
    free(p as ptr)
}

// A peer's per-object entries grown to `count` objects, the new ones empty.
peer_grow(p: *Peer, count: int) {
    if count <= p.capacity { return }
    wanted = p.capacity * 2
    if wanted < 64 { wanted = 64 }
    while wanted < count { wanted = wanted * 2 }
    p.accum = grown(p.accum, p.capacity, wanted, 8)
    p.waits = grown(p.waits, p.capacity, wanted, 4)
    p.worst = grown(p.worst, p.capacity, wanted, 4)
    p.marked = grown(p.marked, p.capacity, wanted, 4)
    p.sights = grown(p.sights, p.capacity, wanted, 4)
    p.sighted = grown(p.sighted, p.capacity, wanted, 4)
    p.sight_waits = grown(p.sight_waits, p.capacity, wanted, 4)
    p.capacity = wanted
}

// An array of `had` entries of `size` bytes as one of `wanted`, the new
// ones zero; the old one let go.
grown(old: ptr, had: int, wanted: int, size: int) -> ptr {
    fresh = calloc(wanted, size)
    if old != null {
        if had > 0 { memcpy(fresh, old, (had * size) as long) }
        free(old)
    }
    return fresh
}

peer_by_id(n: *Net, id: int) -> *Peer {
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.id == id { return p }
        i = i + 1
    }
    return null
}

// The session's scratch index lists grown to `count` objects.
scratch_grow(n: *Net, count: int) {
    if count <= n.scratch_capacity { return }
    wanted = n.scratch_capacity * 2
    if wanted < 64 { wanted = 64 }
    while wanted < count { wanted = wanted * 2 }
    if n.candidates != null { free(n.candidates) }
    if n.records != null { free(n.records) }
    if n.fields != null { free(n.fields) }
    if n.urgency != null { free(n.urgency) }
    n.candidates = calloc(wanted, 4)
    n.records = calloc(wanted, 4)
    n.fields = calloc(wanted, 4)
    n.urgency = calloc(wanted, 8)
    n.scratch_capacity = wanted
}

// Host a session on a loopback hub: clients join the same hub.
host_loopback(h: *LoopHub) -> *Net {
    n = net_new(ROLE_HOST, KIND_LOOP)
    n.hub = h
    h.endpoints = 1
    h.host_open = true
    n.endpoint = 1
    return n
}

// Join a session hosted on a loopback hub. The host sees the client on its
// next step, and welcomes it once the client's hello crosses the link.
join_loopback(h: *LoopHub) -> *Net {
    if !h.host_open {
        error_borrowed("no host on the hub")
        return null
    }
    if h.joining_count >= HUB_ENDPOINTS || h.endpoints >= HUB_ENDPOINTS - 1 {
        error_borrowed("the hub is full")
        return null
    }
    n = net_new(ROLE_CLIENT, KIND_LOOP)
    n.hub = h
    h.endpoints = h.endpoints + 1
    n.endpoint = h.endpoints
    host = peer_new(0)
    host.endpoint = 1
    list.add_raw(n.peers, host as ptr)
    waiting = h.joining as int[]
    waiting[h.joining_count] = n.endpoint
    h.joining_count = h.joining_count + 1
    push_event(n, EVENT_CONNECTED, 0, null, 0)
    return n
}

// Host a session over TCP on `address` ("0.0.0.0" for every interface, as
// a game does; "127.0.0.1" for this machine only, as a test does) and
// `port` (0 for one the system picks; tcp_port says which).
host_tcp(address: string, port: int) -> *Net {
    server, err = tcp.listen_on(address, port)
    if err != "" {
        error_made("cannot listen on ${port}: ${err}")
        return null
    }
    n = net_new(ROLE_HOST, KIND_TCP)
    n.server = server
    n.port = tcp.server_port(server)
    return n
}

tcp_port(n: *Net) -> int { return n.port }

// Join a session hosted over TCP.
join_tcp(host: string, port: int) -> *Net {
    socket, err = tcp.connect(host, port)
    if err != "" {
        error_made("cannot connect to ${host}:${port}: ${err}")
        return null
    }
    tcp.set_nodelay(socket, true)
    n = net_new(ROLE_CLIENT, KIND_TCP)
    link = peer_new(0)
    link.socket = socket
    list.add_raw(n.peers, link as ptr)
    push_event(n, EVENT_CONNECTED, 0, null, 0)
    return n
}

// Host a session over UDP on `address` and `port` (0 for one the system
// picks; udp_port says which): clients are welcomed as their handshakes
// complete (ae3d.netudp).
host_udp(address: string, port: int) -> *Net {
    ep = netudp.listen(address, port)
    if ep == null {
        error_borrowed(netudp.last_error())
        return null
    }
    n = net_new(ROLE_HOST, KIND_UDP)
    n.udp = ep
    n.port = netudp.port(ep)
    unsequenced_channels(ep)
    return n
}

// A client's inputs are handed over late or not: each carries every
// command the host had not acknowledged when it was sent, so an older one
// the link reordered behind a newer holds nothing the newer did not, and
// the host keeps only the ones it has not queued. A ping and its answer
// likewise: one the link reordered is still a round trip, and dropping it
// would count it lost. Snapshots and acknowledgements stay sequenced.
unsequenced_channels(ep: *UdpEndpoint) {
    netudp.set_sequenced(ep, MSG_INPUT, false)
    netudp.set_sequenced(ep, MSG_PING, false)
    netudp.set_sequenced(ep, MSG_PONG, false)
}

// Join a session hosted over UDP. The handshake starts at the first step;
// the hello follows it, and the welcome the hello. A host that does not
// answer within the timeout leaves the session disconnected.
join_udp(host: string, port: int) -> *Net {
    ep = netudp.connect(host, port)
    if ep == null {
        error_borrowed(netudp.last_error())
        return null
    }
    n = net_new(ROLE_CLIENT, KIND_UDP)
    n.udp = ep
    unsequenced_channels(ep)
    link = peer_new(0)
    link.conn = 1
    list.add_raw(n.peers, link as ptr)
    return n
}

udp_port(n: *Net) -> int { return n.port }

// UDP: the link every datagram this side sends crosses -- `latency` and up
// to `jitter` more seconds, and a share `loss` lost -- for a test or the
// editor's play, as a hub's conditions are for loopback.
set_conditions(n: *Net, latency: float, jitter: float, loss: float) {
    if n.udp != null { netudp.set_conditions(n.udp, latency, jitter, loss) }
}

// UDP: seconds the other side is heard from nothing before its connection
// is closed (5 by default), and a client's handshake given up.
set_timeout(n: *Net, seconds: float) {
    if n.udp != null { netudp.set_timeout(n.udp, seconds) }
}

push_event(n: *Net, kind: int, peer: int, data: ptr, length: int) {
    ev = calloc(1, sizeof(NetEvent)) as *NetEvent
    ev.kind = kind
    ev.peer = peer
    if length > 0 {
        ev.data = malloc(length as long)
        memcpy(ev.data, data, length as long)
    }
    ev.length = length
    list.add_raw(n.events, ev as ptr)
}

clear_events(n: *Net) {
    i = 0
    while i < list.size(n.events) {
        ev = list.get_raw(n.events, i) as *NetEvent
        if ev.data != null { free(ev.data) }
        free(ev as ptr)
        i = i + 1
    }
    list.clear(n.events)
}

// The traffic a message is counted as: every reliable one an event (the
// handshake's, spawns, objects created); an unreliable one by what it is.
// The receiver counts the same way by the message alone: only these kinds
// go unreliably.
traffic_kind(reliable: bool, what: int) -> int {
    if reliable { return TRAFFIC_EVENTS }
    if what == MSG_SNAPSHOT { return TRAFFIC_SNAPSHOTS }
    if what == MSG_INPUT { return TRAFFIC_INPUTS }
    if what == MSG_PING || what == MSG_PONG { return TRAFFIC_LINK }
    return TRAFFIC_ACKS
}

received_kind(what: int) -> int {
    return traffic_kind(what != MSG_SNAPSHOT && what != MSG_INPUT && what != MSG_ACK && what != MSG_PING && what != MSG_PONG, what)
}

// A message to one peer.
deliver(n: *Net, p: *Peer, reliable: bool, data: ptr, length: int, now: float) {
    if p == null || !p.open { return }
    n.sent = n.sent + (length as long)
    kind = traffic_kind(reliable, mem.get_byte(data, 0))
    counts = n.traffic as long[]
    counts[kind] = counts[kind] + (length as long)
    mine = p.sent_bytes as long[]
    mine[kind] = mine[kind] + (length as long)
    if n.kind == KIND_LOOP {
        hub_post(n.hub, n.endpoint, p.endpoint, reliable, data, length, now)
        return
    }
    if n.kind == KIND_UDP {
        // The reliable channel, or an unreliable one of the message's own
        // kind: a snapshot is never dropped for an input, only for a newer
        // snapshot.
        channel = netudp.RELIABLE
        if !reliable { channel = mem.get_byte(data, 0) }
        netudp.post(n.udp, p.conn, channel, data, length)
        return
    }
    // TCP: the length, then the message, in one write. The stream keeps the
    // order and loses nothing, so reliable or not is the same here.
    counts[TRAFFIC_HEADERS] = counts[TRAFFIC_HEADERS] + 4
    mine[TRAFFIC_HEADERS] = mine[TRAFFIC_HEADERS] + 4
    total = length + 4
    frame = malloc(total as long)
    mem.set_u32_le(frame, 0, length as long)
    memcpy(frame + 4, data, length as long)
    written = 0
    while written < total {
        part = bytes.string_from_ptr(frame + written, total - written)
        count, err = tcp.write_n(p.socket, part, total - written)
        string.free(part)
        if err != "" || count <= 0 {
            close_peer(n, p)
            break
        }
        written = written + count
    }
    free(frame)
}

// UDP: what this side has queued since the last step, into datagrams and
// out now; the step does it itself at its start and its end. For a game
// that sends from its own code and wants it gone before the next frame.
flush(n: *Net, now: float) {
    if n != null && n.udp != null { netudp.flush(n.udp, now) }
}

// This step's arrivals, into n.events.
pump(n: *Net, now: float) {
    if n.kind == KIND_LOOP {
        pump_loop(n, now)
    } else if n.kind == KIND_UDP {
        pump_udp(n, now)
    } else {
        pump_tcp(n)
    }
}

pump_loop(n: *Net, now: float) {
    h = n.hub
    if n.role == ROLE_HOST {
        waiting = h.joining as int[]
        k = 0
        while k < h.joining_count {
            p = peer_new(list.size(n.peers) + 1)
            p.endpoint = waiting[k]
            list.add_raw(n.peers, p as ptr)
            push_event(n, EVENT_CONNECTED, p.id, null, 0)
            k = k + 1
        }
        h.joining_count = 0
    }
    // What has landed for this endpoint, the earliest landing first.
    while true {
        best = 0 - 1
        best_lands = now
        i = 0
        while i < list.size(h.parcels) {
            parcel = list.get_raw(h.parcels, i) as *Parcel
            if parcel.to == n.endpoint && parcel.lands <= now && (best < 0 || parcel.lands < best_lands) {
                best = i
                best_lands = parcel.lands
            }
            i = i + 1
        }
        if best < 0 { break }
        landed = list.get_raw(h.parcels, best) as *Parcel
        list.remove(h.parcels, best)
        peer = peer_from_endpoint(n, landed.from)
        if peer != null {
            n.got = n.got + (landed.length as long)
            push_event(n, EVENT_MESSAGE, peer.id, landed.data, landed.length)
        }
        free(landed.data)
        free(landed as ptr)
    }
}

peer_from_endpoint(n: *Net, endpoint: int) -> *Peer {
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.endpoint == endpoint { return p }
        i = i + 1
    }
    return null
}

peer_from_conn(n: *Net, conn: int) -> *Peer {
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.conn == conn { return p }
        i = i + 1
    }
    return null
}

// UDP: the endpoint's events as the session's: a connection opened is a
// peer (the host's, on a client), one closed a disconnect, a message a
// message.
pump_udp(n: *Net, now: float) {
    ep = n.udp
    netudp.update(ep, now)
    k = 0
    while k < netudp.event_count(ep) {
        ev = netudp.event_at(ep, k)
        if ev.kind == netudp.UDP_CONNECTED {
            if n.role == ROLE_HOST {
                p = peer_new(list.size(n.peers) + 1)
                p.conn = ev.conn
                list.add_raw(n.peers, p as ptr)
                push_event(n, EVENT_CONNECTED, p.id, null, 0)
            } else {
                push_event(n, EVENT_CONNECTED, 0, null, 0)
            }
        } else if ev.kind == netudp.UDP_DISCONNECTED {
            p = peer_from_conn(n, ev.conn)
            if p != null { close_peer(n, p) }
        } else {
            p = peer_from_conn(n, ev.conn)
            if p != null && p.open {
                n.got = n.got + (ev.length as long)
                push_event(n, EVENT_MESSAGE, p.id, ev.data, ev.length)
            }
        }
        k = k + 1
    }
    netudp.clear_events(ep)
}

pump_tcp(n: *Net) {
    if n.role == ROLE_HOST && n.server != null {
        while tcp.server_poll(n.server, 0) > 0 {
            socket, err = tcp.accept(n.server)
            if err != "" { break }
            tcp.set_nodelay(socket, true)
            p = peer_new(list.size(n.peers) + 1)
            p.socket = socket
            list.add_raw(n.peers, p as ptr)
            push_event(n, EVENT_CONNECTED, p.id, null, 0)
        }
    }
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.open { read_peer(n, p) }
        i = i + 1
    }
}

// Whatever the socket holds now, without waiting, cut into whole messages.
read_peer(n: *Net, p: *Peer) {
    while true {
        ready, perr = tcp.poll(p.socket, 0)
        if perr != "" {
            close_peer(n, p)
            return
        }
        if !ready { break }
        chunk, got, err = tcp.read_n(p.socket, TCP_CHUNK)
        if err == "timeout" { break }
        if err != "" || got <= 0 {
            close_peer(n, p)
            return
        }
        if p.pending_length + got > p.pending_capacity {
            wanted = p.pending_capacity * 2
            if wanted < 4096 { wanted = 4096 }
            while wanted < p.pending_length + got { wanted = wanted * 2 }
            p.pending = realloc(p.pending, wanted as long)
            p.pending_capacity = wanted
        }
        block = bytes.new(got)
        bytes.copy_from_string(block, 0, chunk, got)
        memcpy(p.pending + p.pending_length, bytes.data(block), got as long)
        bytes.free(block)
        p.pending_length = p.pending_length + got
        n.got = n.got + (got as long)
    }
    // Whole messages off the front.
    at = 0
    heard = p.recv_bytes as long[]
    while p.pending_length - at >= 4 {
        length = (mem.get_u32_le(p.pending, at)) as int
        if p.pending_length - at - 4 < length { break }
        push_event(n, EVENT_MESSAGE, p.id, p.pending + at + 4, length)
        heard[TRAFFIC_HEADERS] = heard[TRAFFIC_HEADERS] + 4
        at = at + 4 + length
    }
    if at > 0 {
        memmove(p.pending, p.pending + at, (p.pending_length - at) as long)
        p.pending_length = p.pending_length - at
    }
}

close_peer(n: *Net, p: *Peer) {
    if !p.open { return }
    p.open = false
    if p.socket != null {
        tcp.tcp_close(p.socket)
        p.socket = null
    }
    push_event(n, EVENT_DISCONNECTED, p.id, null, 0)
}

// --- replication ---------------------------------------------------------------------------

// Mark a game object networked: the host sends its transform, a client
// draws it from what arrived. Its id is its order among the networked, so a
// scene both sides build the same way has the same ids on both.
networked(n: *Net, o: *GameObject) -> int {
    no = net_object_new(list.size(n.objects) + 1, o)
    list.add_raw(n.objects, no as ptr)
    bind_fields(n, no)
    if n.role == ROLE_CLIENT { set_remote(no, true) }
    return no.id
}

// Every networked object given back to this side: simulated here again,
// its scripts' fixed_update run and a body the session drove dynamic
// again. For a game that keeps its objects past the session (a client
// that leaves and plays on alone); net_free does not touch the game's
// objects, which may be gone by then.
release(n: *Net) {
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null { set_remote(no, false) }
        i = i + 1
    }
}

// Whether another peer simulates the object: on a client what the host
// owns and every other client's player, on the host a client's player.
// Its scripts' fixed_update, the simulation, is left to that peer
// (behaviour.object_remote: the engine runs only their update and
// late_update here), and a dynamic body on it is made kinematic, driven
// where the session puts it -- it pushes what it meets, and is never
// simulated against the host's word.
set_remote(no: *NetObject, remote: bool) {
    if no.object == null || no.remote == remote { return }
    no.remote = remote
    behaviour.object_set_remote(no.object, remote)
    rb = physics.rigidbody_of(no.object)
    if remote && rb != null && physics.rigidbody_kind(rb) == physics.DYNAMIC {
        physics.rigidbody_set_kind(rb, physics.KINEMATIC)
        no.body_driven = true
    }
    if !remote && no.body_driven {
        if rb != null { physics.rigidbody_set_kind(rb, physics.DYNAMIC) }
        no.body_driven = false
    }
}

net_object_new(id: int, o: *GameObject) -> *NetObject {
    no = calloc(1, sizeof(NetObject)) as *NetObject
    no.id = id
    no.object = o
    no.history = calloc(HISTORY * SAMPLE, 8)
    no.priority = 1.0
    no.bound_radius = 0.5
    return no
}

net_object_free(no: *NetObject) {
    if no.fields != null { list.free(no.fields) }
    free(no.history)
    free(no as ptr)
}

networked_count(n: *Net) -> int { return list.size(n.objects) }

object_by_id(n: *Net, id: int) -> *NetObject {
    if id < 1 || id > list.size(n.objects) { return null }
    return list.get_raw(n.objects, id - 1) as *NetObject
}

net_object_of(n: *Net, o: *GameObject) -> *NetObject {
    if o == null { return null }
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && no.object == o { return no }
        i = i + 1
    }
    return null
}

// A networked object at a given id, as a spawn names it: the list grows to
// it, and an id already taken is left as it is.
networked_at(n: *Net, o: *GameObject, id: int) {
    while list.size(n.objects) < id { list.add_raw(n.objects, null) }
    if list.get_raw(n.objects, id - 1) != null { return }
    no = net_object_new(id, o)
    list.set(n.objects, id - 1, no as ptr)
    bind_fields(n, no)
    if n.role == ROLE_CLIENT { set_remote(no, true) }
}

// Where a networked object is: its model's place, or for an object with no
// model (a player, a trigger) its game object's.
position_of(o: *GameObject) -> Vec3 {
    m = behaviour.object_model(o)
    if m != null { return m.position }
    return behaviour.object_position(o)
}

rotation_of(o: *GameObject) -> Quat {
    m = behaviour.object_model(o)
    if m != null { return m.rotation }
    return behaviour.object_rotation(o)
}

// A networked object put somewhere, the same way round: its model, or its
// game object when it has none.
set_transform(o: *GameObject, where: Vec3, turn: Quat) {
    m = behaviour.object_model(o)
    if m != null {
        core.model_set_position(m, where.x, where.y, where.z)
        core.model_set_rotation(m, turn)
    } else {
        behaviour.object_set_position(o, where)
        behaviour.object_set_rotation(o, turn)
    }
}

// --- fields of a script's state (#486) ---------------------------------------------------------
//
// A field is the host's: its game writes it, and every tick the session
// reads it as a snapshot holds it -- an int as it is, a float as whole
// steps of its precision (or its 64 bits, where the precision is 0), a
// bool as 0 or 1, a Vec3 as three floats, a text as its length and bytes.
// It goes in its object's record, against what the client acknowledged,
// only when it differs, so an unchanged field costs nothing, and a field
// and the transform it goes with arrive in the same snapshot, since the
// budget takes or leaves a record whole. A client writes every field from
// every snapshot it takes, in the tick order it takes them (never
// backwards), and calls the field's hook when that changes the value.
// A field is state, not an event: two changes between the snapshots a
// client takes are one change there, the newer. What must be seen every
// time is an event (send_event).

// The 8-byte words a field of `kind` takes in a snapshot.
kind_words(kind: int) -> int {
    if kind == REPLICATE_VEC3 { return 3 }
    if kind == REPLICATE_TEXT { return TEXT_WORDS }
    return 1
}

// A field of an object's script state, replicated: `kind` is
// REPLICATE_INT, _FLOAT, _BOOL, _VEC3 or _TEXT, `field` where the game
// keeps the value (`&state.health`), or null for a text, which the session
// keeps (set_text, text). A float and a Vec3 go in whole steps of
// `precision`, or as their 64 bits exactly where it is 0. Both sides
// register the same fields on the same objects in the same order, as they
// mark objects networked; the object may be networked after it (a kind's
// maker registers its object's fields before the session numbers it). On
// the host an object's fields are fixed once a tick has taken its state.
// False, with last_error, for a field that cannot be.
replicate(n: *Net, o: *GameObject, name: string, field: ptr, kind: int, precision: float = 0.0) -> bool {
    if n == null || o == null { return false }
    if kind < REPLICATE_INT || kind > REPLICATE_TEXT {
        error_made("no field kind ${kind}")
        return false
    }
    if kind == REPLICATE_TEXT && field != null {
        error_borrowed("a text field is the session's: pass null, and set it with set_text")
        return false
    }
    if kind != REPLICATE_TEXT && field == null {
        error_made("field ${name} has nowhere to be kept")
        return false
    }
    if precision < 0.0 {
        error_made("field ${name}: a precision is a step, never below 0")
        return false
    }
    order = 0
    i = 0
    while i < list.size(n.replicated) {
        f = list.get_raw(n.replicated, i) as *NetField
        if f.object == o {
            if string.equals(f.name, name) == 1 {
                error_made("the object already replicates a field named ${name}")
                return false
            }
            order = order + 1
        }
        i = i + 1
    }
    if order >= FIELDS_MOST {
        error_made("an object replicates ${FIELDS_MOST} fields at most")
        return false
    }
    no = net_object_of(n, o)
    if no != null && no.captured {
        error_made("field ${name}: the object's fields were fixed at the first tick that took its state")
        return false
    }
    f = calloc(1, sizeof(NetField)) as *NetField
    f.object = o
    f.order = order
    f.name = core.set_owned(f.name, name)
    f.kind = kind
    f.precision = 0.0
    if kind == REPLICATE_FLOAT || kind == REPLICATE_VEC3 { f.precision = precision }
    f.field = field
    if kind == REPLICATE_TEXT {
        f.value = core.set_owned(f.value, "")
        f.packed = calloc(TEXT_WORDS, 8)
    }
    list.add_raw(n.replicated, f as ptr)
    if no != null { bind_field(n, no, f) }
    return true
}

// The fields registered for an object before it was networked, bound to
// it now it has its id, and on a client given what the newest snapshot
// already holds of it (a snapshot is not held up behind the reliable word
// that makes an object, so it may have come first).
bind_fields(n: *Net, no: *NetObject) {
    bound = false
    i = 0
    while i < list.size(n.replicated) {
        f = list.get_raw(n.replicated, i) as *NetField
        if f.id == 0 && f.object == no.object {
            bind_field(n, no, f)
            bound = true
        }
        i = i + 1
    }
    if bound && n.role == ROLE_CLIENT {
        shot = ring_find(n.received, n.newest_tick)
        if shot != null { apply_object_fields(n, no, shot, n.last_step) }
    }
}

bind_field(n: *Net, no: *NetObject, f: *NetField) {
    f.id = no.id
    if no.fields == null { no.fields = list.new() }
    list.add_raw(no.fields, f as ptr)
    // The host's layout is its registrations; a client's is what the wire
    // says (the host's), learned from the first whole record.
    if n.role == ROLE_HOST {
        lay = layout_for(n, no.id)
        at = lay.count
        (lay.kinds as int[])[at] = f.kind
        (lay.precisions as float[])[at] = f.precision
        (lay.offsets as int[])[at] = lay.words
        lay.words = lay.words + kind_words(f.kind)
        lay.count = at + 1
    }
}

// Object `id`'s layout, or null.
layout_at(n: *Net, id: int) -> *NetLayout {
    if id < 1 || id > list.size(n.layouts) { return null }
    return list.get_raw(n.layouts, id - 1) as *NetLayout
}

// Object `id`'s layout, made (with no fields, and no place yet) where it
// has none.
layout_for(n: *Net, id: int) -> *NetLayout {
    while list.size(n.layouts) < id { list.add_raw(n.layouts, null) }
    lay = list.get_raw(n.layouts, id - 1) as *NetLayout
    if lay != null { return lay }
    lay = calloc(1, sizeof(NetLayout)) as *NetLayout
    lay.at = 0 - 1
    lay.kinds = calloc(FIELDS_MOST, 4)
    lay.offsets = calloc(FIELDS_MOST, 4)
    lay.precisions = calloc(FIELDS_MOST, 8)
    list.set(n.layouts, id - 1, lay as ptr)
    return lay
}

layout_free(lay: *NetLayout) {
    free(lay.kinds)
    free(lay.offsets)
    free(lay.precisions)
    free(lay as ptr)
}

// A layout given its words in every snapshot's block: those of one let
// go with the same number of words, or new ones at the block's end.
place_layout(n: *Net, lay: *NetLayout) {
    k = 0
    while k < list.size(n.spare_words) {
        spare = list.get_raw(n.spare_words, k) as *NetLayout
        if spare.words == lay.words {
            lay.at = spare.at
            list.remove(n.spare_words, k)
            free(spare as ptr)
            return
        }
        k = k + 1
    }
    lay.at = n.field_words
    n.field_words = n.field_words + lay.words
}

// An object gone for good (its id is never given again): its fields let
// go, and its words kept for the next layout of their size. A snapshot
// that still has them marks them known under the old id, which nothing
// asks again; the new object's are unknown in it until told.
drop_fields(n: *Net, id: int) {
    i = 0
    while i < list.size(n.replicated) {
        f = list.get_raw(n.replicated, i) as *NetField
        if f.id == id {
            field_free(f)
            list.remove(n.replicated, i)
        } else {
            i = i + 1
        }
    }
    lay = layout_at(n, id)
    if lay == null { return }
    if lay.at >= 0 && lay.words > 0 {
        spare = calloc(1, sizeof(NetLayout)) as *NetLayout
        spare.at = lay.at
        spare.words = lay.words
        list.add_raw(n.spare_words, spare as ptr)
    }
    layout_free(lay)
    list.set(n.layouts, id - 1, null)
}

field_free(f: *NetField) {
    string.free(f.name)
    if f.value != null { string.free(f.value) }
    if f.packed != null { free(f.packed) }
    free(f as ptr)
}

field_named(n: *Net, o: *GameObject, name: string) -> *NetField {
    i = 0
    while i < list.size(n.replicated) {
        f = list.get_raw(n.replicated, i) as *NetField
        if f.object == o && string.equals(f.name, name) == 1 { return f }
        i = i + 1
    }
    return null
}

// `hook(context, change)` is called on a client whenever a snapshot
// changes this field, after the value is written: once a change, in the
// order of the ticks the snapshots were taken at, and in the order the
// object's fields were registered within one.
on_changed(n: *Net, o: *GameObject, name: string, hook: fn(ptr, *NetChange), context: ptr) -> bool {
    f = field_named(n, o, name)
    if f == null {
        error_made("no field named ${name} on that object")
        return false
    }
    f.hook = hook
    f.context = context
    return true
}

// A text field's value, on the host, up to TEXT_BYTES bytes: sent from the
// next tick, as any field's change is. False for a longer text, a field
// that is not a text, or a client (whose texts are the host's).
set_text(n: *Net, o: *GameObject, name: string, value: string) -> bool {
    f = field_named(n, o, name)
    if f == null || f.kind != REPLICATE_TEXT {
        error_made("no text field named ${name} on that object")
        return false
    }
    if n.role != ROLE_HOST {
        error_borrowed("a field is the host's to write")
        return false
    }
    length = string.length(value)
    if length > TEXT_BYTES {
        error_made("a text field holds ${TEXT_BYTES} bytes at most; ${name} was given ${length}")
        return false
    }
    f.value = core.set_owned(f.value, value)
    pack_text(f.packed, 0, value, length)
    return true
}

// A text field's value: the host's own, or on a client the newest a
// snapshot brought; "" for none. The session's, until it changes.
text(n: *Net, o: *GameObject, name: string) -> string {
    f = field_named(n, o, name)
    if f == null || f.kind != REPLICATE_TEXT { return "" }
    return f.value
}

// The fields registered on an object.
field_count(n: *Net, o: *GameObject) -> int {
    count = 0
    i = 0
    while i < list.size(n.replicated) {
        if (list.get_raw(n.replicated, i) as *NetField).object == o { count = count + 1 }
        i = i + 1
    }
    return count
}

// A text into TEXT_WORDS words of `words` from word `at`: its length in the
// first byte, its bytes after, the rest zero, so two of the same text are
// the same words.
pack_text(words: ptr, at: int, value: string, length: int) {
    base = at * 8
    mem.set(words + base, 0, (TEXT_WORDS * 8) as long)
    mem.set_byte(words, base, length)
    if length > 0 {
        block = bytes.new(length)
        bytes.copy_from_string(block, 0, value, length)
        memcpy(words + base + 1, bytes.data(block), length as long)
        bytes.free(block)
    }
}

// A float as a snapshot holds it: whole steps of the precision, or its 64
// bits where that is 0. Steps are held to 2^53, what a double counts
// exactly.
float_word(v: float, precision: float) -> long {
    if precision <= 0.0 { return mem.bits_of_float(v) }
    s = floor(v / precision + 0.5)
    if s > 9007199254740992.0 { s = 9007199254740992.0 }
    if s < 0.0 - 9007199254740992.0 { s = 0.0 - 9007199254740992.0 }
    return s as long
}

word_float(w: long, precision: float) -> float {
    if precision <= 0.0 { return mem.float_from_bits(w) }
    return (w as float) * precision
}

// Host: an object's fields now, as words into `shot`.
read_fields(n: *Net, no: *NetObject, lay: *NetLayout, shot: *Snapshot) {
    words = shot.fvalues as long[]
    k = 0
    while k < list.size(no.fields) {
        f = list.get_raw(no.fields, k) as *NetField
        at = lay.at + (lay.offsets as int[])[f.order]
        if f.kind == REPLICATE_INT {
            words[at] = (mem.get_int(f.field, 0)) as long
        } else if f.kind == REPLICATE_BOOL {
            words[at] = 0 as long
            if mem.get_int(f.field, 0) != 0 { words[at] = 1 as long }
        } else if f.kind == REPLICATE_FLOAT {
            words[at] = float_word(mem.get_float64(f.field, 0), f.precision)
        } else if f.kind == REPLICATE_VEC3 {
            words[at] = float_word(mem.get_float64(f.field, 0), f.precision)
            words[at + 1] = float_word(mem.get_float64(f.field, 8), f.precision)
            words[at + 2] = float_word(mem.get_float64(f.field, 16), f.precision)
        } else {
            memcpy(shot.fvalues + at * 8, f.packed, (TEXT_WORDS * 8) as long)
        }
        k = k + 1
    }
}

// Whether object `index`'s fields differ between two snapshots' words:
// field `k` of `lay`, or with k below 0 any of them.
field_differs(lay: *NetLayout, a: ptr, b: ptr, k: int) -> bool {
    first = 0
    last = lay.count - 1
    if k >= 0 {
        first = k
        last = k
    }
    wa = a as long[]
    wb = b as long[]
    j = first
    while j <= last {
        at = lay.at + (lay.offsets as int[])[j]
        w = kind_words((lay.kinds as int[])[j])
        m = 0
        while m < w {
            if wa[at + m] != wb[at + m] { return true }
            m = m + 1
        }
        j = j + 1
    }
    return false
}

// A float's value or change onto the wire: steps as a zigzag varint of the
// change (the value itself, whole), or the 64 bits as they are.
put_float_word(b: *NetBuf, w: long, was: long, whole: bool, precision: float) {
    if precision <= 0.0 {
        put_u32(b, (w & (4294967295 as long)) as int)
        put_u32(b, ((w >> 32) & (4294967295 as long)) as int)
        return
    }
    if whole { put_varint(b, zigzag(w)) } else { put_varint(b, zigzag(w - was)) }
}

get_float_word(r: *NetReader, was: long, whole: bool, precision: float) -> long {
    if precision <= 0.0 {
        low = (get_u32(r) as long) & (4294967295 as long)
        high = (get_u32(r) as long) & (4294967295 as long)
        return low | (high << 32)
    }
    change = unzigzag(get_varint(r))
    if whole { return change }
    return was + change
}

// Object `index`'s fields onto the wire, from the words of `cur` against
// those of `base`: whole -- how many, each one's kind (and precision), and
// every value -- or the mask of the ones that changed, and their changes.
write_fields(b: *NetBuf, lay: *NetLayout, cur: ptr, base: ptr, whole: bool) {
    words = cur as long[]
    was = base as long[]
    if whole {
        put_varint(b, lay.count as long)
        k = 0
        while k < lay.count {
            kind = (lay.kinds as int[])[k]
            precision = (lay.precisions as float[])[k]
            if (kind == REPLICATE_FLOAT || kind == REPLICATE_VEC3) && precision > 0.0 {
                put_u8(b, kind | KIND_STEPPED)
                put_f64(b, precision)
            } else {
                put_u8(b, kind)
            }
            k = k + 1
        }
    } else {
        mask = 0 as long
        k = 0
        while k < lay.count {
            if field_differs(lay, cur, base, k) { mask = mask | ((1 as long) << k) }
            k = k + 1
        }
        put_varint(b, mask)
    }
    k = 0
    while k < lay.count {
        if whole || field_differs(lay, cur, base, k) {
            kind = (lay.kinds as int[])[k]
            precision = (lay.precisions as float[])[k]
            at = lay.at + (lay.offsets as int[])[k]
            if kind == REPLICATE_INT {
                if whole { put_varint(b, zigzag(words[at])) } else { put_varint(b, zigzag(words[at] - was[at])) }
            } else if kind == REPLICATE_BOOL {
                put_u8(b, (words[at]) as int)
            } else if kind == REPLICATE_FLOAT {
                put_float_word(b, words[at], was[at], whole, precision)
            } else if kind == REPLICATE_VEC3 {
                m = 0
                while m < 3 {
                    put_float_word(b, words[at + m], was[at + m], whole, precision)
                    m = m + 1
                }
            } else {
                length = mem.get_byte(cur, at * 8)
                put_u8(b, length)
                j = 0
                while j < length {
                    put_u8(b, mem.get_byte(cur, at * 8 + 1 + j))
                    j = j + 1
                }
            }
        }
        k = k + 1
    }
}

// Client: object `index`'s fields off the wire into `shot`, whose words
// hold the base's: a whole block teaches the object's layout where this
// side has none (and must agree where it has one), a changed one needs
// it. False for what cannot be read.
read_fields_wire(n: *Net, r: *NetReader, shot: *Snapshot, index: int, whole: bool) -> bool {
    lay = layout_at(n, index + 1)
    if whole {
        count = (get_varint(r)) as int
        if !r.ok || count < 0 || count > FIELDS_MOST { return false }
        kinds = calloc(FIELDS_MOST, 4)
        precisions = calloc(FIELDS_MOST, 8)
        ks = kinds as int[]
        ps = precisions as float[]
        k = 0
        while k < count && r.ok {
            code = get_u8(r)
            ks[k] = code & 7
            if (code & KIND_STEPPED) != 0 { ps[k] = get_f64(r) }
            if ks[k] < REPLICATE_INT || ks[k] > REPLICATE_TEXT { r.ok = false }
            k = k + 1
        }
        same = r.ok
        if same && lay != null && lay.at >= 0 {
            same = lay.count == count
            k = 0
            while same && k < count {
                if (lay.kinds as int[])[k] != ks[k] || (lay.precisions as float[])[k] != ps[k] { same = false }
                k = k + 1
            }
            if !same { r.ok = false }
        } else if same {
            lay = layout_for(n, index + 1)
            k = 0
            while k < count {
                (lay.kinds as int[])[k] = ks[k]
                (lay.precisions as float[])[k] = ps[k]
                (lay.offsets as int[])[k] = lay.words
                lay.words = lay.words + kind_words(ks[k])
                k = k + 1
            }
            lay.count = count
            place_layout(n, lay)
        }
        free(kinds)
        free(precisions)
        if !r.ok { return false }
        snapshot_fit_words(shot, n.field_words)
    } else if lay == null || lay.at < 0 {
        return false
    }
    mask = 0 as long
    if !whole {
        mask = get_varint(r)
        if !r.ok { return false }
    }
    words = shot.fvalues as long[]
    k = 0
    while k < lay.count && r.ok {
        if whole || ((mask >> k) & (1 as long)) == (1 as long) {
            kind = (lay.kinds as int[])[k]
            precision = (lay.precisions as float[])[k]
            at = lay.at + (lay.offsets as int[])[k]
            if kind == REPLICATE_INT {
                change = unzigzag(get_varint(r))
                if whole { words[at] = change } else { words[at] = words[at] + change }
            } else if kind == REPLICATE_BOOL {
                words[at] = (get_u8(r)) as long
            } else if kind == REPLICATE_FLOAT {
                words[at] = get_float_word(r, words[at], whole, precision)
            } else if kind == REPLICATE_VEC3 {
                m = 0
                while m < 3 {
                    words[at + m] = get_float_word(r, words[at + m], whole, precision)
                    m = m + 1
                }
            } else {
                length = get_u8(r)
                if length > TEXT_BYTES || r.at + length > r.length {
                    r.ok = false
                } else {
                    mem.set(shot.fvalues + at * 8, 0, (TEXT_WORDS * 8) as long)
                    mem.set_byte(shot.fvalues, at * 8, length)
                    if length > 0 { memcpy(shot.fvalues + at * 8 + 1, r.data + r.at, length as long) }
                    r.at = r.at + length
                }
            }
        }
        k = k + 1
    }
    if !r.ok { return false }
    (shot.fknown as int[])[index] = 1
    return true
}

// A snapshot's field block grown to `words`, what it holds kept.
snapshot_fit_words(shot: *Snapshot, words: int) {
    if words <= shot.fcapacity { return }
    wanted = shot.fcapacity * 2
    if wanted < 16 { wanted = 16 }
    while wanted < words { wanted = wanted * 2 }
    shot.fvalues = grown(shot.fvalues, shot.fcapacity, wanted, 8)
    shot.fcapacity = wanted
}

// Client: every field registered here whose object `shot` has fields for,
// written where the game keeps it, and its hook called where that changed
// it -- in the order the fields were registered. Called for every
// snapshot taken, in the order they are taken, so the fields are always
// the newest snapshot's.
apply_fields(n: *Net, shot: *Snapshot, now: float) {
    i = 0
    while i < list.size(n.replicated) {
        f = list.get_raw(n.replicated, i) as *NetField
        if f.id > 0 { apply_field(n, f, shot, now) }
        i = i + 1
    }
}

apply_object_fields(n: *Net, no: *NetObject, shot: *Snapshot, now: float) {
    if no.fields == null { return }
    k = 0
    while k < list.size(no.fields) {
        apply_field(n, list.get_raw(no.fields, k) as *NetField, shot, now)
        k = k + 1
    }
}

apply_field(n: *Net, f: *NetField, shot: *Snapshot, now: float) {
    index = f.id - 1
    if index >= shot.count || (shot.fknown as int[])[index] != 1 { return }
    // Nothing older than what was applied: a snapshot after the host let
    // an object go carries its base's fields, not the newest.
    brought = (shot.fticks as int[])[index]
    if brought < f.applied_tick { return }
    f.applied_tick = brought
    lay = layout_at(n, f.id)
    if lay == null || lay.at < 0 || f.order >= lay.count || (lay.kinds as int[])[f.order] != f.kind { return }
    words = shot.fvalues as long[]
    at = lay.at + (lay.offsets as int[])[f.order]
    precision = (lay.precisions as float[])[f.order]
    changed = false
    if f.kind == REPLICATE_INT {
        v = (words[at]) as int
        changed = mem.get_int(f.field, 0) != v
        mem.set_int(f.field, 0, v)
    } else if f.kind == REPLICATE_BOOL {
        v = 0
        if words[at] != (0 as long) { v = 1 }
        was = 0
        if mem.get_int(f.field, 0) != 0 { was = 1 }
        changed = was != v
        mem.set_int(f.field, 0, v)
    } else if f.kind == REPLICATE_FLOAT {
        changed = set_float_field(f.field, 0, word_float(words[at], precision))
    } else if f.kind == REPLICATE_VEC3 {
        cx = set_float_field(f.field, 0, word_float(words[at], precision))
        cy = set_float_field(f.field, 8, word_float(words[at + 1], precision))
        cz = set_float_field(f.field, 16, word_float(words[at + 2], precision))
        changed = cx || cy || cz
    } else {
        if mem.compare(f.packed, shot.fvalues + at * 8, (TEXT_WORDS * 8) as long) != 0 {
            memcpy(f.packed, shot.fvalues + at * 8, (TEXT_WORDS * 8) as long)
            length = mem.get_byte(f.packed, 0)
            fresh = bytes.string_from_ptr(f.packed + 1, length)
            f.value = core.set_owned(f.value, fresh)
            string.free(fresh)
            changed = true
        }
    }
    if changed && f.hook != null {
        change = NetChange { object: f.object, id: f.id, name: f.name, order: f.order, tick: shot.tick, now: now }
        hook = f.hook
        hook(f.context, &change)
    }
}

// A float written where the game keeps it; whether that changed its bits.
set_float_field(field: ptr, offset: int, value: float) -> bool {
    changed = mem.bits_of_float(mem.get_float64(field, offset)) != mem.bits_of_float(value)
    mem.set_float64(field, offset, value)
    return changed
}

// --- the quantised state ----------------------------------------------------------------------
//
// A position goes in whole steps of the session's precision (a tenth of a
// millimetre by default): its x, y and z as integers, and a record carries
// each one's change against what the client has, as a varint of a few
// bytes. A rotation goes as its three smallest components in 15 bits
// each and which one was dropped in 2 (the dropped one is the largest, so
// the others are within +-1/sqrt 2, and a unit quaternion's length gives
// it back): 48 bits, 6 bytes, a hundredth of a milliradian. The host keeps
// the quantised values themselves, so a delta is an exact difference of
// integers and a client that adds it holds what the host told it, to the
// bit.

quantise(n: *Net, x: float) -> float {
    return floor(x / n.unit + 0.5)
}

// A rotation's 48 bits, as a whole number a double holds exactly.
pack_rotation(q: Quat) -> float {
    x = q.x
    y = q.y
    z = q.z
    w = q.w
    length = sqrt(x * x + y * y + z * z + w * w)
    if length < 0.000000001 {
        x = 0.0
        y = 0.0
        z = 0.0
        w = 1.0
    } else {
        x = x / length
        y = y / length
        z = z / length
        w = w / length
    }
    largest = 0
    big = abs_of(x)
    if abs_of(y) > big { largest = 1 ; big = abs_of(y) }
    if abs_of(z) > big { largest = 2 ; big = abs_of(z) }
    if abs_of(w) > big { largest = 3 }
    // q and -q are the same turn: the dropped component made positive.
    sign = 1.0
    if (largest == 0 && x < 0.0) || (largest == 1 && y < 0.0) || (largest == 2 && z < 0.0) || (largest == 3 && w < 0.0) { sign = 0.0 - 1.0 }
    a = y
    b = z
    c = w
    if largest == 1 { a = x }
    if largest == 2 { a = x ; b = y }
    if largest == 3 { a = x ; b = y ; c = z }
    return (largest as float) * 35184372088832.0 + rotation_step(a * sign) * 1073741824.0 +
           rotation_step(b * sign) * 32768.0 + rotation_step(c * sign)
}

rotation_step(v: float) -> float {
    k = floor((v + HALF_ROOT_TWO) / (2.0 * HALF_ROOT_TWO) * ROTATION_STEPS + 0.5)
    if k < 0.0 { k = 0.0 }
    if k > ROTATION_STEPS { k = ROTATION_STEPS }
    return k
}

rotation_value(k: float) -> float {
    return k / ROTATION_STEPS * (2.0 * HALF_ROOT_TWO) - HALF_ROOT_TWO
}

unpack_rotation(packed: float) -> Quat {
    bits = packed as long
    largest = (bits / (35184372088832 as long)) as int
    a = rotation_value(((bits / (1073741824 as long)) % (32768 as long)) as float)
    b = rotation_value(((bits / (32768 as long)) % (32768 as long)) as float)
    c = rotation_value((bits % (32768 as long)) as float)
    rest = 1.0 - a * a - b * b - c * c
    d = 0.0
    if rest > 0.0 { d = sqrt(rest) }
    if largest == 0 { return core.quat(d, a, b, c) }
    if largest == 1 { return core.quat(a, d, b, c) }
    if largest == 2 { return core.quat(a, b, d, c) }
    return core.quat(a, b, c, d)
}

abs_of(v: float) -> float {
    if v < 0.0 { return 0.0 - v }
    return v
}

// Every networked object's state now, quantised, into `shot`, and its
// fields; and whether there is an object at that id at all (a destroyed
// one's id has none). An object's fields take their place in the block at
// the first tick that takes its state, and are fixed from then on.
current_states(n: *Net, shot: *Snapshot, now: float) {
    count = list.size(n.objects)
    i = 0
    while i < count {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && !no.captured {
            no.captured = true
            lay = layout_at(n, i + 1)
            if lay != null && lay.at < 0 { place_layout(n, lay) }
        }
        i = i + 1
    }
    snapshot_reset(shot, n.tick, now, count, n.field_words)
    states = shot.states as float[]
    known = shot.known as int[]
    fknown = shot.fknown as int[]
    i = 0
    while i < count {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null {
            at = i * STATE
            where = position_of(no.object)
            states[at] = quantise(n, where.x)
            states[at + 1] = quantise(n, where.y)
            states[at + 2] = quantise(n, where.z)
            states[at + 3] = pack_rotation(rotation_of(no.object))
            known[i] = 1
            lay = layout_at(n, i + 1)
            if lay != null && lay.count > 0 && lay.at >= 0 {
                read_fields(n, no, lay, shot)
                fknown[i] = 1
            }
        }
        i = i + 1
    }
}

same_state(a: float[], b: float[], index: int) -> bool {
    at = index * STATE
    return a[at] == b[at] && a[at + 1] == b[at + 1] && a[at + 2] == b[at + 2] && a[at + 3] == b[at + 3]
}

// A shot's state of object `index` as a place and a turn: 7 floats into
// `values` at `into`.
state_values(n: *Net, shot: *Snapshot, index: int, values: float[], into: int) {
    s = shot.states as float[]
    at = index * STATE
    values[into] = s[at] * n.unit
    values[into + 1] = s[at + 1] * n.unit
    values[into + 2] = s[at + 2] * n.unit
    q = unpack_rotation(s[at + 3])
    values[into + 3] = q.x
    values[into + 4] = q.y
    values[into + 5] = q.z
    values[into + 6] = q.w
}

// --- what each client is sent ------------------------------------------------------------------

// The host's snapshot, to every welcomed client: each its own, of what is
// relevant to it, within its budget, as a delta against the newest
// snapshot it has acknowledged.
send_snapshot(n: *Net, now: float) {
    current_states(n, n.current, now)
    scratch_grow(n, n.current.count)
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed && p.open { snapshot_to(n, p, now) }
        i = i + 1
    }
    drop_gone(n)
    // This tick's states are the next tick's previous ones.
    was = n.previous
    n.previous = n.current
    n.current = was
}

// Whether object `index` is relevant to this client: by its own setting,
// else within the relevance radius of the client's player, or of its eye
// where it has sent a view and has no player (everything is when there is
// no radius, or nothing to measure from).
relevant(n: *Net, p: *Peer, index: int) -> bool {
    no = list.get_raw(n.objects, index) as *NetObject
    if no == null { return false }
    if no.relevance == RELEVANT_NEVER { return false }
    if no.relevance == RELEVANT_ALWAYS { return true }
    if n.relevance <= 0.0 || (p.player == null && !p.view_known) { return true }
    d = distance_to_client(n, p, index)
    return d <= n.relevance
}

// Metres from this client to object `index`, now: from its player, or
// from its eye where it has no player; 0 with neither.
distance_to_client(n: *Net, p: *Peer, index: int) -> float {
    s = n.current.states as float[]
    here = index * STATE
    if p.player == null {
        if !p.view_known { return 0.0 }
        ex = s[here] * n.unit - p.eye.x
        ey = s[here + 1] * n.unit - p.eye.y
        ez = s[here + 2] * n.unit - p.eye.z
        return sqrt(ex * ex + ey * ey + ez * ez)
    }
    pl = p.player as *NetPlayer
    at = (pl.net_id - 1) * STATE
    dx = (s[here] - s[at]) * n.unit
    dy = (s[here + 1] - s[at + 1]) * n.unit
    dz = (s[here + 2] - s[at + 2]) * n.unit
    return sqrt(dx * dx + dy * dy + dz * dz)
}

// How fast an object's priority grows for this client while it waits: its
// own priority, and more the nearer it is to the client -- 1 +
// NEAR_WEIGHT / d, so one at a metre gathers eleven times what a far one
// does and is never left waiting behind the far ones for long -- and by
// what the client can see: SIGHT_BOOST times as fast for an object in its
// view that a ray from its eye reaches, SIGHT_CUT times slower for one
// outside the view or behind the static world. Slower, never stopped: an
// object behind the player still arrives, so turning round never shows a
// stale world.
weight(n: *Net, p: *Peer, index: int, looks: int) -> float {
    no = list.get_raw(n.objects, index) as *NetObject
    w = no.priority
    if p.player != null || p.view_known {
        d = distance_to_client(n, p, index)
        if d < 1.0 { d = 1.0 }
        w = w * (1.0 + NEAR_WEIGHT / d)
    }
    if n.sighted {
        if looks == SIGHT_SEEN { w = w * SIGHT_BOOST }
        if looks == SIGHT_OUT || looks == SIGHT_HIDDEN { w = w / SIGHT_CUT }
    }
    return w
}

// --- what each client can see (#487) -------------------------------------------------------------
//
// A client sends its view with its inputs (or its acknowledgements, with
// no player): where its eye is, the way it looks, how wide. The host
// judges every object it would send against it: outside the frustum it is
// out of sight; inside, a ray from the eye to the object's sphere -- its
// centre, and where that is blocked its top -- against the static world
// the host has as physics statics (set_occluders) says whether anything is
// in the way. A ray is cast when an object comes into the frustum, and
// every SIGHT_EVERY ticks while it stays, staggered by its index, so a
// view full of objects costs a sixth of its rays a tick; between, the
// object keeps what the last ray found.

// Client: what it sees -- its eye, the way it looks (a direction, any
// length), the vertical field of view in radians and the width over the
// height -- sent to the host with its inputs, or with its acknowledgements
// where it has no player: each time it moves VIEW_MOVE or turns VIEW_TURN,
// at most once a tick, and every VIEW_REFRESH seconds whatever it does. A
// client with a player sends its eye from the player's place, and the host
// keeps it there as the player goes: an eye that follows its player -- a
// camera over its shoulder, a driver's seat -- is sent again only when it
// turns, however fast the player moves.
set_view(n: *Net, eye: Vec3, direction: Vec3, fov: float, aspect: float) {
    length = sqrt(direction.x * direction.x + direction.y * direction.y + direction.z * direction.z)
    if length < 0.000001 || fov <= 0.0 || aspect <= 0.0 { return }
    n.view_eye = eye
    n.view_dir = core.vec3(direction.x / length, direction.y / length, direction.z / length)
    n.view_fov = fov
    n.view_aspect = aspect
    n.view_set = true
}

// Client: a camera's view, as set_view takes it.
set_camera_view(n: *Net, cam: *Camera) {
    if cam == null { return }
    core.camera_update_vectors(cam)
    set_view(n, cam.position, cam.front, core.deg_to_rad(cam.fov), cam.aspect)
}

// Host: whether client `client` has sent a view to judge by.
has_view(n: *Net, client: int) -> bool {
    p = peer_by_id(n, client)
    return p != null && p.view_known
}

// Host: the first tick judged by the newest view client `client` sent; 0
// before one.
view_tick(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    return p.view_tick
}

// Host: the static world a client's view is occluded by: the physics
// world's static bodies, the ground and the buildings. Without it, only
// the frustum counts.
set_occluders(n: *Net, world: *Physics) { n.occluders = world }

// Host: whether what a client can see weighs on the priority its objects
// gather (true, the default); false weighs by distance alone, what the
// sight is measured against. Sight is judged either way, for what it is
// measured by (sight, view_bytes).
set_visibility(n: *Net, on: bool) { n.sighted = on }

// The sphere an object is seen by: its centre from the object's place,
// on the world's axes, and its radius (0.5 m round its place by default).
set_bounds(n: *Net, o: *GameObject, centre: Vec3, radius: float) {
    no = net_object_of(n, o)
    if no == null || radius <= 0.0 { return }
    no.bound_centre = centre
    no.bound_radius = radius
}

// Host: what client `client` saw of object `id` at the last tick it was
// judged (SIGHT_*).
sight(n: *Net, client: int, id: int) -> int {
    p = peer_by_id(n, client)
    if p == null || id < 1 || id > p.capacity || p.sights == null { return SIGHT_NONE }
    return (p.sights as int[])[id - 1]
}

// Whether the client's view has changed enough since it was last sent to
// send it again, and it is its turn.
view_due(n: *Net, now: float) -> bool {
    if !n.view_set { return false }
    if !n.view_sent { return true }
    since = now - n.view_sent_at
    if since >= VIEW_REFRESH { return true }
    if since < 0.999 / n.tick_rate { return false }
    follows = n.mine != null
    if follows != n.sent_follows { return true }
    moved = core.v3_len(core.v3_sub(eye_to_send(n), n.sent_eye)) > VIEW_MOVE
    along = n.view_dir.x * n.sent_dir.x + n.view_dir.y * n.sent_dir.y + n.view_dir.z * n.sent_dir.z
    turned = along < cos(VIEW_TURN)
    widened = abs_of(n.view_fov - n.sent_fov) > VIEW_TURN || abs_of(n.view_aspect - n.sent_aspect) > 0.02
    return moved || turned || widened
}

// The eye as the client sends it: from its player's place where it has
// one, its place in the world where it has none.
eye_to_send(n: *Net) -> Vec3 {
    if n.mine == null { return n.view_eye }
    at = behaviour.object_position((n.mine as *NetPlayer).controller.object as *GameObject)
    return core.v3_sub(n.view_eye, at)
}

// The view onto the wire, VIEW_BYTES: the eye as floats, the direction as
// a heading and a pitch in 16 bits each, the vertical view in whole
// degrees and the aspect in 32nds.
put_view(n: *Net, b: *NetBuf, now: float) {
    d = n.view_dir
    heading = atan2(d.x, 0.0 - d.z)
    if heading < 0.0 { heading = heading + 2.0 * PI }
    pitch = asin(clamp_unit(d.y))
    eye = eye_to_send(n)
    put_f32(b, eye.x)
    put_f32(b, eye.y)
    put_f32(b, eye.z)
    put_u16(b, (floor(heading / (2.0 * PI) * 65536.0 + 0.5) as int) % 65536)
    put_u16(b, clamp_int((floor((pitch + PI * 0.5) / PI * 65535.0 + 0.5)) as int, 0, 65535))
    put_u8(b, clamp_int((floor(n.view_fov * 180.0 / PI + 0.5)) as int, 1, 179))
    put_u8(b, clamp_int((floor(n.view_aspect * 32.0 + 0.5)) as int, 1, 255))
    n.view_sent = true
    n.view_sent_at = now
    n.sent_eye = eye
    n.sent_follows = n.mine != null
    n.sent_dir = n.view_dir
    n.sent_fov = n.view_fov
    n.sent_aspect = n.view_aspect
}

// Host: a client's view off the wire, and its frustum made ready; an eye
// sent from the client's player (`follows`) put where the player is.
take_view(n: *Net, p: *Peer, r: *NetReader, follows: bool) {
    x = get_f32(r)
    y = get_f32(r)
    z = get_f32(r)
    heading = (get_u16(r) as float) / 65536.0 * 2.0 * PI
    pitch = (get_u16(r) as float) / 65535.0 * PI - PI * 0.5
    degrees = get_u8(r)
    aspect = (get_u8(r) as float) / 32.0
    if !r.ok || degrees < 1 || aspect <= 0.0 { return }
    p.eye = core.vec3(x, y, z)
    p.eye_offset = p.eye
    p.eye_follows = follows && p.player != null
    place_eye(p)
    p.forward = core.vec3(sin(heading) * cos(pitch), sin(pitch), 0.0 - cos(heading) * cos(pitch))
    // Across the view: right is level (the forward crossed with up), and
    // the view's up is square to both. Looking straight up or down, any
    // level right will do.
    rx = 0.0 - p.forward.z
    rz = p.forward.x
    level = sqrt(rx * rx + rz * rz)
    if level < 0.000001 {
        rx = 1.0
        rz = 0.0
        level = 1.0
    }
    p.right = core.vec3(rx / level, 0.0, rz / level)
    f = p.forward
    rt = p.right
    p.upward = core.vec3(rt.y * f.z - rt.z * f.y, rt.z * f.x - rt.x * f.z, rt.x * f.y - rt.y * f.x)
    half_up = (degrees as float) * PI / 180.0 * 0.5
    half_side = atan(tan(half_up) * aspect)
    half_up = half_up + SIGHT_MARGIN
    half_side = half_side + SIGHT_MARGIN
    if half_up > 1.55 { half_up = 1.55 }
    if half_side > 1.55 { half_side = 1.55 }
    p.cos_up = cos(half_up)
    p.sin_up = sin(half_up)
    p.cos_side = cos(half_side)
    p.sin_side = sin(half_side)
    p.view_known = true
    p.view_tick = n.tick + 1
}

// Host: a client's eye that follows its player, where the player is now.
place_eye(p: *Peer) {
    if !p.eye_follows || p.player == null { return }
    at = behaviour.object_position((p.player as *NetPlayer).controller.object as *GameObject)
    p.eye = core.v3_add(at, p.eye_offset)
}

// Host: what client `p` sees of object `index` now: out of sight outside
// its frustum; in it, seen or hidden by the last ray, and a new ray when
// the object has just come into the frustum or its turn has come.
sight_now(n: *Net, p: *Peer, index: int) -> int {
    if !p.view_known { return SIGHT_NONE }
    no = list.get_raw(n.objects, index) as *NetObject
    s = n.current.states as float[]
    at = index * STATE
    cx = s[at] * n.unit + no.bound_centre.x
    cy = s[at + 1] * n.unit + no.bound_centre.y
    cz = s[at + 2] * n.unit + no.bound_centre.z
    radius = no.bound_radius
    vx = cx - p.eye.x
    vy = cy - p.eye.y
    vz = cz - p.eye.z
    ahead = vx * p.forward.x + vy * p.forward.y + vz * p.forward.z
    across = abs_of(vx * p.right.x + vy * p.right.y + vz * p.right.z)
    up = abs_of(vx * p.upward.x + vy * p.upward.y + vz * p.upward.z)
    // The sphere against each side plane of the frustum: a plane through
    // the eye tilted out by the half angle, its distance from the centre
    // the across and the ahead turned by that angle.
    sights = p.sights as int[]
    was = sights[index]
    if across * p.cos_side - ahead * p.sin_side > radius || up * p.cos_up - ahead * p.sin_up > radius {
        sights[index] = SIGHT_OUT
        return SIGHT_OUT
    }
    sighted = p.sighted as int[]
    fresh = was != SIGHT_SEEN && was != SIGHT_HIDDEN
    if !fresh && sighted[index] > 0 && (n.tick + index) % SIGHT_EVERY != 0 { return was }
    sighted[index] = n.tick
    looks = SIGHT_SEEN
    if n.occluders != null {
        if blocked(n, p, cx, cy, cz, radius) && blocked(n, p, cx, cy + radius, cz, 0.0) { looks = SIGHT_HIDDEN }
    }
    sights[index] = looks
    return looks
}

// Whether the static world stands between the client's eye and a point,
// short of the sphere of `radius` round it.
blocked(n: *Net, p: *Peer, x: float, y: float, z: float, radius: float) -> bool {
    dx = x - p.eye.x
    dy = y - p.eye.y
    dz = z - p.eye.z
    d = sqrt(dx * dx + dy * dy + dz * dz)
    reach = d - radius
    if reach <= 0.0 { return false }
    p.rays = p.rays + 1
    return physics.ray_static_hits(n.occluders, p.eye, core.vec3(dx / d, dy / d, dz / d), reach)
}

clamp_unit(v: float) -> float {
    if v > 1.0 { return 1.0 }
    if v < 0.0 - 1.0 { return 0.0 - 1.0 }
    return v
}

clamp_int(v: int, low: int, high: int) -> int {
    if v < low { return low }
    if v > high { return high }
    return v
}

// The candidates, most urgent first: by priority gathered, and by index
// among equals, so the order is the same on every run. A heap sort, in
// place, of `count` indices by `key`.
sort_urgent(order: int[], key: float[], count: int) {
    if count < 2 { return }
    start = count / 2 - 1
    while start >= 0 {
        sift(order, key, start, count)
        start = start - 1
    }
    end = count - 1
    while end > 0 {
        swap = order[0]
        order[0] = order[end]
        order[end] = swap
        sift(order, key, 0, end)
        end = end - 1
    }
}

// The heap's root is the least urgent, so the sort leaves the most urgent
// first.
less_urgent(key: float[], a: int, b: int) -> bool {
    if key[a] != key[b] { return key[a] < key[b] }
    return a > b
}

sift(order: int[], key: float[], root: int, count: int) {
    r = root
    while true {
        child = r * 2 + 1
        if child >= count { return }
        if child + 1 < count && less_urgent(key, order[child + 1], order[child]) { child = child + 1 }
        if !less_urgent(key, order[child], order[r]) { return }
        swap = order[r]
        order[r] = order[child]
        order[child] = swap
        r = child
    }
}

// The room a budget leaves for records, past the header (its records'
// count taken at its largest).
budget_room(n: *Net, budget: int, count: int) -> int {
    return budget - (1 + 4 + 4 + 4 + 1 + varint_size(count as long) + varint_size(count as long) + 1)
}

// Whether the base already holds object `index` as it is now: its
// transform (never asked of the client's own player, which goes apart)
// and its fields.
unchanged(n: *Net, base: *Snapshot, index: int, own: bool) -> bool {
    cur = n.current
    fields = (cur.fknown as int[])[index] == 1
    if base == null || index >= base.count { return own && !fields }
    if !own {
        if (base.known as int[])[index] != 1 { return false }
        if !same_state(cur.states as float[], base.states as float[], index) { return false }
    }
    if !fields { return true }
    if (base.fknown as int[])[index] != 1 { return false }
    return !field_differs(layout_at(n, index + 1), cur.fvalues, base.fvalues, 0 - 1)
}

// Object `index`'s fields against the base: what changed, all of it when
// the base does not have it, and whether it was still as the base has it
// at the tick before this one -- the client then holds it there until
// that moment, so an object that starts to move after standing still is
// not drawn sliding from wherever it stood, over all the time it stood.
//
// Its replicated fields likewise: FIELD_STATE where any differs from the
// base's, with FIELD_STATE_WHOLE where the base has none of them. The
// client's own player (`own`) is reconciled from a block of its own and
// never drawn from a record, so its record carries its fields alone.
record_fields(n: *Net, base: *Snapshot, index: int, own: bool) -> int {
    fields = 0
    if !own {
        s = n.current.states as float[]
        at = index * STATE
        if base == null || index >= base.count || (base.known as int[])[index] != 1 {
            fields = FIELD_WHOLE | FIELD_X | FIELD_Y | FIELD_Z | FIELD_ROTATION
        } else {
            bs = base.states as float[]
            if s[at] != bs[at] { fields = fields | FIELD_X }
            if s[at + 1] != bs[at + 1] { fields = fields | FIELD_Y }
            if s[at + 2] != bs[at + 2] { fields = fields | FIELD_Z }
            if s[at + 3] != bs[at + 3] { fields = fields | FIELD_ROTATION }
            prev = n.previous
            if prev.used && index < prev.count && (prev.known as int[])[index] == 1 && same_state(prev.states as float[], bs, index) {
                fields = fields | FIELD_HELD
            }
        }
    }
    if (n.current.fknown as int[])[index] == 1 {
        lay = layout_at(n, index + 1)
        if base == null || index >= base.count || (base.fknown as int[])[index] != 1 {
            fields = fields | FIELD_STATE | FIELD_STATE_WHOLE
        } else if field_differs(lay, n.current.fvalues, base.fvalues, 0 - 1) {
            fields = fields | FIELD_STATE
        }
    }
    return fields
}

// Object `index`'s record against the base into `b`: its fields, and the
// fields' values or changes.
write_record(n: *Net, b: *NetBuf, base: *Snapshot, index: int, own: bool) {
    s = n.current.states as float[]
    at = index * STATE
    fields = record_fields(n, base, index, own)
    whole = (fields & FIELD_WHOLE) != 0
    put_u8(b, fields)
    k = 0
    while k < 3 {
        if (fields & (1 << k)) != 0 {
            value = (s[at + k]) as long
            if !whole { value = value - ((base.states as float[])[at + k]) as long }
            put_varint(b, zigzag(value))
        }
        k = k + 1
    }
    if (fields & FIELD_ROTATION) != 0 {
        bits = (s[at + 3]) as long
        put_u16(b, (bits % (65536 as long)) as int)
        put_u32(b, (bits / (65536 as long)) as int)
    }
    if (fields & FIELD_STATE) != 0 {
        fresh = (fields & FIELD_STATE_WHOLE) != 0
        was = n.current.fvalues
        if !fresh { was = base.fvalues }
        write_fields(b, layout_at(n, index + 1), n.current.fvalues, was, fresh)
    }
}

// The client's player at full precision, as the wire carries it: what it
// reconciles against, so its prediction is not moved by a quantum.
own_state(n: *Net, pl: *NetPlayer, into: *Snapshot) {
    o = pl.controller.object as *GameObject
    where = behaviour.object_position(o)
    own = into.own as float[]
    own[0] = as_f32(n, where.x)
    own[1] = as_f32(n, where.y)
    own[2] = as_f32(n, where.z)
    own[3] = as_f32(n, pl.controller.velocity.y)
    own[4] = 0.0
    if pl.controller.grounded { own[4] = 1.0 }
    into.own_known = true
}

same_own(a: *Snapshot, b: *Snapshot) -> bool {
    if !a.own_known || !b.own_known { return false }
    x = a.own as float[]
    y = b.own as float[]
    k = 0
    while k < OWN {
        if x[k] != y[k] { return false }
        k = k + 1
    }
    return true
}

snapshot_to(n: *Net, p: *Peer, now: float) {
    cur = n.current
    count = cur.count
    peer_grow(p, count)
    // The base: the newest snapshot the client acknowledged, while it is
    // one the client can still hold -- it keeps the last 32 it took, so a
    // base 32 ticks old may be gone there, and a delta against it would be
    // one it cannot read, and could never acknowledge. Past that, whole.
    base = null as *Snapshot
    if n.deltas { base = ring_find(p.ring, p.acked_tick) }
    if base != null && n.tick - base.tick >= KEPT - 1 { base = null }
    told = ring_take(p.ring, base)
    snapshot_reset(told, n.tick, now, count, n.field_words)
    cur_states = cur.states as float[]
    cur_known = cur.known as int[]
    cur_fknown = cur.fknown as int[]
    accum = p.accum as float[]
    waits = p.waits as int[]
    worst = p.worst as int[]
    marked = p.marked as int[]
    sights = p.sights as int[]
    sight_waits = p.sight_waits as int[]
    worst_sight = p.worst_sight as int[]
    order = n.candidates as int[]
    // The client's own player: reconciled from its own block, never drawn
    // from a record; a record of its own carries its fields alone.
    own_index = 0 - 1
    if p.player != null {
        pl = p.player as *NetPlayer
        own_index = pl.net_id - 1
        own_state(n, pl, told)
    }
    place_eye(p)
    send_own = told.own_known && (base == null || !same_own(told, base))
    // The candidates: relevant, and not what the base already has. Every
    // one gathers priority for waiting, by what the client can see of it;
    // one that is not a candidate has nothing to wait for. They go most
    // urgent first: by the priority gathered, except that one the client
    // can see and has already waited a tick for goes ahead of the rest --
    // a priority alone would let a hidden object that gathered for a
    // second outrank it, and what a client can see is never two ticks
    // old while the budget holds what it sees -- and so does one that has
    // waited SIGHT_STALE ticks, whatever it is: a view full of changes the
    // budget cannot hold every other tick would otherwise keep what is
    // behind the camera from ever going.
    urgency = n.urgency as float[]
    candidates = 0
    i = 0
    while i < count {
        wanted = cur_known[i] == 1 && relevant(n, p, i) && !unchanged(n, base, i, i == own_index)
        if wanted {
            was = sights[i]
            looks = sight_now(n, p, i)
            if looks != was { sight_waits[i] = 0 }
            accum[i] = accum[i] + weight(n, p, i, looks)
            urgency[i] = accum[i]
            if n.sighted && ((looks == SIGHT_SEEN && sight_waits[i] >= 1) || waits[i] >= SIGHT_STALE) { urgency[i] = accum[i] + OVERDUE }
            order[candidates] = i
            candidates = candidates + 1
        } else {
            accum[i] = 0.0
            waits[i] = 0
            sight_waits[i] = 0
        }
        i = i + 1
    }
    sort_urgent(order, urgency, candidates)
    // The most urgent first, while the budget lasts; one that does not fit
    // leaves room for a smaller one after it. The header's size is known
    // but for the records' count, which is taken at its largest; a
    // record's index gap at most the varint of its index.
    budget = p.budget
    if budget <= 0 { budget = n.budget }
    // A held record wants the previous tick's time; the client knows it
    // when the base is that tick, and is told it otherwise (4 bytes, kept
    // out of the budget's room from the start).
    send_previous = base != null && base.tick < n.tick - 1 && n.previous.used
    lacked = wanted_command(p)
    // The destroyed objects' last fields it carries: each its id, its
    // block's length, and the block whole (a client that no longer has the
    // object's layout steps over it).
    rec = n.measured
    gone = 0
    gone_bytes = 0
    k = 0
    while k < list.size(n.gone) {
        g = list.get_raw(n.gone, k) as *NetGone
        if gone_due(g, base) {
            rec.length = 0
            write_fields(rec, g.lay, g.words, g.words, true)
            gone = gone + 1
            gone_bytes = gone_bytes + varint_size(g.id as long) + varint_size(rec.length as long) + rec.length
        }
        k = k + 1
    }
    if gone > 0 { gone_bytes = gone_bytes + varint_size(gone as long) }
    room = 0
    if budget > 0 {
        room = budget_room(n, budget, count)
        if send_own { room = room - 17 }
        if send_previous { room = room - 4 }
        if lacked > 0 { room = room - 5 }
        room = room - gone_bytes
    }
    chosen = 0
    k = 0
    while k < candidates {
        i = order[k]
        take = true
        if budget > 0 {
            rec.length = 0
            write_record(n, rec, base, i, i == own_index)
            size = rec.length + varint_size((i + 1) as long)
            if size <= room {
                room = room - size
            } else if chosen == 0 && size > budget_room(n, budget, count) {
                // A record no snapshot's room could ever hold -- an object
                // whole with its fields, over a budget smaller than that --
                // goes alone when it comes first, or it would wait for
                // ever: the one way a snapshot is over its budget.
                room = 0
            } else {
                take = false
            }
        }
        if take {
            marked[i] = n.tick
            if waits[i] > worst[i] { worst[i] = waits[i] }
            if worst[i] > p.worst_any { p.worst_any = worst[i] }
            waits[i] = 0
            sight_waits[i] = 0
            accum[i] = 0.0
            chosen = chosen + 1
        } else {
            waits[i] = waits[i] + 1
            sight_waits[i] = sight_waits[i] + 1
            if sight_waits[i] > worst_sight[sights[i]] { worst_sight[sights[i]] = sight_waits[i] }
        }
        k = k + 1
    }
    // What the client will hold once it has this snapshot: the chosen as
    // they are now, the rest as the base had them (or unknown); their
    // fields likewise. And whether any chosen one is held.
    held = false
    told_states = told.states as float[]
    told_known = told.known as int[]
    told_fknown = told.fknown as int[]
    if base != null && n.field_words > 0 {
        words = base.fcapacity
        if words > told.fcapacity { words = told.fcapacity }
        memcpy(told.fvalues, base.fvalues, (words * 8) as long)
    }
    i = 0
    while i < count {
        if send_previous && !held && i != own_index && marked[i] == n.tick && cur_known[i] == 1 {
            held = (record_fields(n, base, i, false) & FIELD_HELD) != 0
        }
        at = i * STATE
        if i != own_index && marked[i] == n.tick && cur_known[i] == 1 {
            told_states[at] = cur_states[at]
            told_states[at + 1] = cur_states[at + 1]
            told_states[at + 2] = cur_states[at + 2]
            told_states[at + 3] = cur_states[at + 3]
            told_known[i] = 1
        } else if i != own_index && cur_known[i] == 1 && base != null && i < base.count && (base.known as int[])[i] == 1 {
            bs = base.states as float[]
            told_states[at] = bs[at]
            told_states[at + 1] = bs[at + 1]
            told_states[at + 2] = bs[at + 2]
            told_states[at + 3] = bs[at + 3]
            told_known[i] = 1
        }
        if cur_fknown[i] == 1 {
            if marked[i] == n.tick {
                lay = layout_at(n, i + 1)
                memcpy(told.fvalues + lay.at * 8, cur.fvalues + lay.at * 8, (lay.words * 8) as long)
                told_fknown[i] = 1
            } else if base != null && i < base.count && (base.fknown as int[])[i] == 1 {
                told_fknown[i] = 1
            }
        }
        i = i + 1
    }
    // The snapshot.
    b = n.out
    b.length = 0
    put_u8(b, MSG_SNAPSHOT)
    put_u32(b, n.tick)
    put_f32(b, now)
    put_u32(b, p.last_input)
    if base != null { put_u8(b, n.tick - base.tick) } else { put_u8(b, 0) }
    put_varint(b, count as long)
    put_varint(b, chosen as long)
    flags = 0
    if send_own { flags = flags | SNAP_OWN }
    if send_previous && held { flags = flags | SNAP_PREVIOUS }
    if lacked > 0 { flags = flags | SNAP_WANTED }
    if gone > 0 { flags = flags | SNAP_GONE }
    put_u8(b, flags)
    if send_own {
        own = told.own as float[]
        put_f32(b, own[0])
        put_f32(b, own[1])
        put_f32(b, own[2])
        put_f32(b, own[3])
        put_u8(b, (own[4]) as int)
    }
    if (flags & SNAP_PREVIOUS) != 0 { put_f32(b, n.previous.time) }
    if lacked > 0 { put_varint(b, (lacked - p.last_input) as long) }
    previous = 0 - 1
    i = 0
    while i < count {
        if marked[i] == n.tick && cur_known[i] == 1 {
            before = b.length
            put_varint(b, (i - previous - 1) as long)
            previous = i
            write_record(n, b, base, i, i == own_index)
            // What the budget went on, by what the client could see.
            spent = (b.length - before) as long
            if sights[i] == SIGHT_SEEN { p.view_bytes = p.view_bytes + spent }
            if sights[i] == SIGHT_OUT || sights[i] == SIGHT_HIDDEN { p.hidden_bytes = p.hidden_bytes + spent }
        }
        i = i + 1
    }
    if gone > 0 {
        put_varint(b, gone as long)
        k = 0
        while k < list.size(n.gone) {
            g = list.get_raw(n.gone, k) as *NetGone
            if gone_due(g, base) {
                rec.length = 0
                write_fields(rec, g.lay, g.words, g.words, true)
                put_varint(b, g.id as long)
                put_varint(b, rec.length as long)
                buf_reserve(b, rec.length)
                memcpy(b.data + b.length, rec.data, rec.length as long)
                b.length = b.length + rec.length
            }
            k = k + 1
        }
    }
    n.objects_sent = n.objects_sent + (chosen as long)
    p.snapshots = p.snapshots + 1
    if base == null { p.wholes = p.wholes + 1 }
    p.snapshot_bytes = p.snapshot_bytes + (b.length as long)
    if b.length > p.largest { p.largest = b.length }
    deliver(n, p, false, b.data, b.length, now)
}

// A snapshot arrived: rebuilt from its base and its records, kept,
// acknowledged, and its records sampled for drawing; the client's own
// player reconciled.
take_snapshot(n: *Net, r: *NetReader, now: float) {
    tick = get_u32(r)
    host_time = get_f32(r)
    ack = get_u32(r)
    gap = get_u8(r)
    count = (get_varint(r)) as int
    records = (get_varint(r)) as int
    flags = get_u8(r)
    if !r.ok || count < 0 || records < 0 || records > count { return }
    // Never backwards: one older than a snapshot already held is late,
    // and what it says is already superseded.
    if n.newest_tick > 0 && tick <= n.newest_tick {
        n.stale = n.stale + 1
        return
    }
    // A delta against a snapshot this side no longer has (or never had)
    // cannot be read; the host moves on to one it has acknowledged.
    base = null as *Snapshot
    if gap > 0 {
        base = ring_find(n.received, tick - gap)
        if base == null { return }
    }
    shot = ring_take(n.received, base)
    snapshot_reset(shot, tick, host_time, count, n.field_words)
    states = shot.states as float[]
    known = shot.known as int[]
    fknown = shot.fknown as int[]
    fticks = shot.fticks as int[]
    if base != null {
        bs = base.states as float[]
        bk = base.known as int[]
        bf = base.fknown as int[]
        bt = base.fticks as int[]
        i = 0
        while i < count && i < base.count {
            if bk[i] == 1 {
                at = i * STATE
                states[at] = bs[at]
                states[at + 1] = bs[at + 1]
                states[at + 2] = bs[at + 2]
                states[at + 3] = bs[at + 3]
                known[i] = 1
            }
            fknown[i] = bf[i]
            fticks[i] = bt[i]
            i = i + 1
        }
        words = base.fcapacity
        if words > shot.fcapacity { words = shot.fcapacity }
        if words > 0 { memcpy(shot.fvalues, base.fvalues, (words * 8) as long) }
    }
    own = shot.own as float[]
    if (flags & SNAP_OWN) != 0 {
        own[0] = get_f32(r)
        own[1] = get_f32(r)
        own[2] = get_f32(r)
        own[3] = get_f32(r)
        own[4] = get_u8(r) as float
        shot.own_known = true
    } else if base != null && base.own_known {
        bo = base.own as float[]
        k = 0
        while k < OWN {
            own[k] = bo[k]
            k = k + 1
        }
        shot.own_known = true
    }
    // When a held object was last still: the previous tick's time, told,
    // or the base's when the base is the previous tick.
    held_at = 0.0 - 1.0
    if (flags & SNAP_PREVIOUS) != 0 {
        held_at = get_f32(r)
    } else if base != null {
        held_at = base.time
    }
    // The oldest command the host lacks, when it holds a later one.
    wanted = 0
    if (flags & SNAP_WANTED) != 0 { wanted = ack + ((get_varint(r)) as int) }
    scratch_grow(n, count)
    carried = n.records as int[]
    carried_fields = n.fields as int[]
    index = 0 - 1
    j = 0
    while j < records && r.ok {
        index = index + ((get_varint(r)) as int) + 1
        fields = get_u8(r)
        if !r.ok || index >= count { r.ok = false ; break }
        whole = (fields & FIELD_WHOLE) != 0
        moved = (fields & (FIELD_X | FIELD_Y | FIELD_Z | FIELD_ROTATION | FIELD_WHOLE)) != 0
        if moved && !whole && known[index] != 1 { r.ok = false ; break }
        at = index * STATE
        k = 0
        while k < 3 {
            if (fields & (1 << k)) != 0 {
                change = (unzigzag(get_varint(r))) as float
                if whole { states[at + k] = change } else { states[at + k] = states[at + k] + change }
            }
            k = k + 1
        }
        if (fields & FIELD_ROTATION) != 0 {
            low = get_u16(r)
            high = get_u32(r)
            states[at + 3] = (high as float) * 65536.0 + (low as float)
        }
        if (fields & FIELD_STATE) != 0 && r.ok {
            if !read_fields_wire(n, r, shot, index, (fields & FIELD_STATE_WHOLE) != 0) { r.ok = false ; break }
            fticks[index] = tick
        }
        // A record of fields alone (the client's own player's) says
        // nothing of where the object is.
        if moved { known[index] = 1 }
        carried[j] = index
        carried_fields[j] = fields
        j = j + 1
    }
    // The last fields of objects the host destroyed: as a record's, where
    // this side still has the object's layout; stepped over where not.
    if (flags & SNAP_GONE) != 0 && r.ok {
        gone = (get_varint(r)) as int
        g = 0
        while g < gone && r.ok {
            index = ((get_varint(r)) as int) - 1
            length = (get_varint(r)) as int
            if !r.ok || index < 0 || index >= count || length < 0 || r.at + length > r.length { r.ok = false ; break }
            lay = layout_at(n, index + 1)
            if lay != null && lay.at >= 0 {
                block = NetReader { data: r.data, length: r.at + length, at: r.at, ok: true }
                if !read_fields_wire(n, &block, shot, index, true) { r.ok = false ; break }
                fticks[index] = tick
            }
            r.at = r.at + length
            g = g + 1
        }
    }
    if !r.ok {
        shot.used = false
        return
    }
    n.newest_tick = tick
    n.newest_time = host_time
    if wanted > 0 && wanted != n.wanted { n.asked = n.asked + 1 }
    n.wanted = wanted
    if !n.ack_due { n.ack_since = now }
    n.ack_due = true
    n.snapshots = n.snapshots + 1
    // The host's clock against ours, from the least-delayed snapshot seen: a
    // snapshot can arrive later than its time, never earlier.
    offset = host_time - now
    if !n.offset_known || offset > n.offset {
        n.offset = offset
        n.offset_known = true
    }
    // The records, drawn: each at its moment, and one that was still where
    // the client had it at the tick before held there until then.
    values = calloc(14, 8)
    v = values as float[]
    mine = n.mine as *NetPlayer
    j = 0
    while j < records {
        index = carried[j]
        id = index + 1
        no = object_by_id(n, id)
        moved = (carried_fields[j] & (FIELD_X | FIELD_Y | FIELD_Z | FIELD_ROTATION | FIELD_WHOLE)) != 0
        if moved && no != null && !no.leaving && (mine == null || id != mine.net_id) {
            if (carried_fields[j] & FIELD_HELD) != 0 && base != null && held_at >= 0.0 {
                state_values(n, base, index, v, 7)
                add_sample(no, held_at, v, 7)
            }
            state_values(n, shot, index, v, 0)
            add_sample(no, host_time, v, 0)
        }
        j = j + 1
    }
    free(values)
    if mine != null && shot.own_known {
        reconcile(n, core.vec3(own[0], own[1], own[2]), own[3], own[4] > 0.5, ack)
    }
    // Every field as this snapshot has it, and the hooks of those it
    // changed: in the order the snapshots are taken, which is never
    // backwards, so in tick order.
    apply_fields(n, shot, now)
    i = 0
    while i < list.size(n.takes) {
        t = list.get_raw(n.takes, i) as *NetJoinHook
        told = t.hook
        told(t.context, tick, now)
        i = i + 1
    }
}

// An object made on this side after the snapshots began -- a player told
// of, an object created -- given what the newest snapshot has of it, so
// one that stands still is drawn: its state went in a record before the
// object was here, and a still one is not sent again.
seed_from_snapshot(n: *Net, no: *NetObject) {
    shot = ring_find(n.received, n.newest_tick)
    if shot == null { return }
    index = no.id - 1
    if index >= shot.count || (shot.known as int[])[index] != 1 { return }
    values = calloc(7, 8)
    state_values(n, shot, index, values as float[], 0)
    add_sample(no, shot.time, values as float[], 0)
    free(values)
}

// The client's acknowledgement of its newest snapshot on its own, when no
// input has carried it.
send_ack(n: *Net, now: float) {
    b = n.out
    b.length = 0
    put_u8(b, MSG_ACK)
    put_u16(b, n.newest_tick & 65535)
    put_view_flag(n, b, now)
    deliver(n, peer_by_id(n, 0), false, b.data, b.length, now)
    n.ack_due = false
}

// An input's or an acknowledgement's flags, and the view after them when
// it is due.
put_view_flag(n: *Net, b: *NetBuf, now: float) {
    if view_due(n, now) {
        // Flag 2: the eye is from the client's player's place.
        if n.mine != null { put_u8(b, 3) } else { put_u8(b, 1) }
        put_view(n, b, now)
    } else {
        put_u8(b, 0)
    }
}

// A snapshot the client holds, its tick's low 16 bits: the next is a
// delta against it. The tick is the newest at or before the host's own
// with those bits (a client acknowledges only what it was sent).
take_ack(n: *Net, p: *Peer, wire: int) {
    tick = n.tick - ((n.tick - wire) & 65535)
    if tick > p.acked_tick && ring_find(p.ring, tick) != null { p.acked_tick = tick }
}

// A sample of an object at the host's time `host_time`, the seven floats of
// `values` at `at`, into its history: kept when newer than the newest held.
add_sample(no: *NetObject, host_time: float, values: float[], at: int) {
    h = no.history as float[]
    if no.count > 0 && host_time <= h[no.newest * SAMPLE] { return }
    slot = (no.newest + 1) % HISTORY
    if no.count == 0 { slot = 0 }
    hs = slot * SAMPLE
    h[hs] = host_time
    k = 0
    while k < 7 {
        h[hs + 1 + k] = values[at + k]
        k = k + 1
    }
    no.newest = slot
    if no.count < HISTORY { no.count = no.count + 1 }
}

view_time(n: *Net, now: float) -> float {
    if n.role == ROLE_HOST { return now }
    if !n.offset_known { return 0.0 - 1.0 }
    return now + n.offset - n.interpolation_delay
}

// Each networked object drawn where the host had it `interpolation_delay`
// ago in the host's time: between the two samples around that moment; or,
// where the snapshots have stopped coming (a run of them lost, longer than
// the delay), one that was moving carried on along its last motion for up
// to `extrapolation`, and one that was not held where it stands.
interpolate(n: *Net, now: float) {
    if !n.offset_known { return }
    at = view_time(n, now)
    dt = 0.0
    if n.last_draw >= 0.0 { dt = now - n.last_draw }
    n.last_draw = now
    // What an error keeps of itself over this frame: e^(-dt / smoothing).
    keep = 0.0
    if n.smoothing > 0.0 { keep = exp(0.0 - dt / n.smoothing) }
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && no.count > 0 { place_interpolated(no, at, keep, n.newest_time, n.extrapolation) }
        i = i + 1
    }
}

// Client: how long a remote object's drawing error takes to fall to a
// third (0.1 s by default; 0 corrects it at once). The error is what the
// samples moved an object by where the view had held it: a burst of
// losses runs the view past the newest sample, the object stands at it,
// and the snapshots after it put it on along its path -- drawn from where
// it stood, never jumped there.
set_smoothing(n: *Net, seconds: float) {
    if seconds >= 0.0 { n.smoothing = seconds }
}

// Client: how long past the newest snapshot it holds an object that was
// moving in it is carried on along its last motion (0.1 s by default; 0
// holds it where it was). A run of snapshots lost, longer than the view is
// behind, runs the view past them all: held, an object at 10 m/s stood 667
// mm behind where the host had it after four lost at 100 ms behind, and
// was corrected over the smoothing's time; carried on along the chord of
// its last interval it is off only by its path's curve, 34 mm on a circle
// of 10 m at a radian a second (tests/test_net.ae). One the newest snapshot
// left out stood still (or waited for the budget) and stands: only a gap in
// the snapshots themselves is guessed across.
set_extrapolation(n: *Net, seconds: float) {
    if seconds >= 0.0 { n.extrapolation = seconds }
}

// An object at its interpolated place and turn: its model's, or its game
// object's when it has none (a remote player, a ragdoll's bone). Where the
// view has run past its newest sample: carried on along its last two
// samples' motion, up to `reach` past it, where that sample is the newest
// snapshot's (`newest_time`) -- the snapshots have stopped coming, and it
// was moving in the last of them -- or held at it where the newest
// snapshot left it out (it stood still, or waited for the budget). Each
// time what it is drawn from changes while the view is past its samples
// -- the samples come again, a new one arrives with the view still past
// it, the carrying stops -- the place the old ones put it at now and the
// place the new ones do differ by an error, which the object is drawn off
// them by and which falls away over the smoothing's time: corrected, never
// snapped, and never stopped for a frame. An error past TELEPORT is not
// one: the object was moved, and is.
place_interpolated(no: *NetObject, at: float, keep: float, newest_time: float, reach: float) {
    h = no.history as float[]
    after = 0 - 1
    before = 0 - 1
    k = 0
    while k < no.count {
        slot = (no.newest - k + HISTORY) % HISTORY
        if h[slot * SAMPLE] > at {
            after = slot
        } else {
            before = slot
            break
        }
        k = k + 1
    }
    if before < 0 { before = after }
    if after < 0 { after = before }
    anchor = h[no.newest * SAMPLE]
    held = at > anchor
    carried = false
    if held && reach > 0.0 && !no.leaving && no.count >= 2 && anchor == newest_time {
        last = (no.newest - 1 + HISTORY) % HISTORY
        if can_carry(h, last, no.newest) {
            before = last
            after = no.newest
            carried = true
        }
    }
    t = sample_share(h, before, after, carried, at, reach)
    target = sample_place(h, before, after, t)
    if no.drawn_known && no.held && (!held || carried != no.carried || anchor != no.from_c_time) {
        // What it is drawn from has changed while the view was past its
        // samples: where the old ones put it now, less where the new ones
        // do, is the error it goes on from -- its path unbroken.
        was = no.drawn
        if h[no.from_a * SAMPLE] == no.from_a_time && h[no.from_c * SAMPLE] == no.from_c_time {
            was = core.v3_add(sample_place(h, no.from_a, no.from_c, sample_share(h, no.from_a, no.from_c, no.carried, at, reach)),
                              core.v3_mul(no.error, keep))
        }
        no.error = core.v3_sub(was, target)
        if core.v3_len(no.error) > TELEPORT { no.error = core.vec3(0.0, 0.0, 0.0) }
    } else {
        no.error = core.v3_mul(no.error, keep)
    }
    no.held = held
    no.carried = carried
    no.from_a = before
    no.from_c = after
    no.from_a_time = h[before * SAMPLE]
    no.from_c_time = h[after * SAMPLE]
    drawn = core.v3_add(target, no.error)
    no.drawn = drawn
    no.drawn_known = true
    set_transform(no.object, drawn, nlerp(h, before * SAMPLE + 4, after * SAMPLE + 4, t))
}

// Whether an object's motion from sample slot `a` to slot `c` (its newest)
// can be carried on: the two close enough in time for their motion to be
// its motion now, and apart by less than a teleport.
can_carry(h: float[], a: int, c: int) -> bool {
    span = h[c * SAMPLE] - h[a * SAMPLE]
    dx = h[c * SAMPLE + 1] - h[a * SAMPLE + 1]
    dy = h[c * SAMPLE + 2] - h[a * SAMPLE + 2]
    dz = h[c * SAMPLE + 3] - h[a * SAMPLE + 3]
    return span > 0.0 && span <= CARRIED_SPAN && dx * dx + dy * dy + dz * dz <= TELEPORT * TELEPORT
}

// How far from sample slot `a` toward slot `c` an object is at `at`: between
// them, 0 to 1; carried on past `c`, one more for each span of theirs it has
// gone past it, up to `reach` past it.
sample_share(h: float[], a: int, c: int, carried: bool, at: float, reach: float) -> float {
    ta = h[a * SAMPLE]
    tc = h[c * SAMPLE]
    if carried {
        lead = at - tc
        if lead > reach { lead = reach }
        if lead < 0.0 { lead = 0.0 }
        return 1.0 + lead / (tc - ta)
    }
    if tc <= ta { return 0.0 }
    t = (at - ta) / (tc - ta)
    if t < 0.0 { return 0.0 }
    if t > 1.0 { return 1.0 }
    return t
}

sample_place(h: float[], a: int, c: int, t: float) -> Vec3 {
    x = a * SAMPLE
    y = c * SAMPLE
    return core.vec3(h[x + 1] + (h[y + 1] - h[x + 1]) * t,
                     h[x + 2] + (h[y + 2] - h[x + 2]) * t,
                     h[x + 3] + (h[y + 3] - h[x + 3]) * t)
}

// Between two rotations (four floats of `h` at `a` and at `c`) the short way
// round, normalized: over a tick's arc this is slerp to a fraction of a
// degree.
nlerp(h: float[], a: int, c: int, t: float) -> Quat {
    sign = 1.0
    if h[a] * h[c] + h[a + 1] * h[c + 1] + h[a + 2] * h[c + 2] + h[a + 3] * h[c + 3] < 0.0 { sign = 0.0 - 1.0 }
    x = h[a] + (h[c] * sign - h[a]) * t
    y = h[a + 1] + (h[c + 1] * sign - h[a + 1]) * t
    z = h[a + 2] + (h[c + 2] * sign - h[a + 2]) * t
    w = h[a + 3] + (h[c + 3] * sign - h[a + 3]) * t
    length = sqrt(x * x + y * y + z * z + w * w)
    if length < 0.000001 { return core.quat(0.0, 0.0, 0.0, 1.0) }
    return core.quat(x / length, y / length, z / length, w / length)
}

// --- the step ------------------------------------------------------------------------------

// One step of the session at `now` (seconds): what arrived is handled, the
// host sends a snapshot when a network tick is due, a client moves what it
// draws. The engine calls it every frame (attach); a test calls it itself.
step(n: *Net, now: float) {
    if n == null { return }
    delta = 0.0
    if n.last_step >= 0.0 { delta = now - n.last_step }
    n.last_step = now
    // A client whose newest snapshot no input has acknowledged says so on
    // its own: at once without a player, and with one only once a fixed
    // step and a half has gone by without an input to carry it -- a frame
    // drawn three times between two fixed steps is not three reasons for a
    // datagram of its own.
    if n.role == ROLE_CLIENT && n.ack_due && (n.mine == null || now - n.ack_since >= PLAYER_STEP * 1.5) { send_ack(n, now) }
    // What was sent since the last step goes first, then what arrived.
    flush(n, now)
    // Events queued outside a step (a client's connection) are handled in
    // this one, with what arrives.
    pump(n, now)
    i = 0
    while i < list.size(n.events) {
        ev = list.get_raw(n.events, i) as *NetEvent
        handle(n, ev, now)
        i = i + 1
    }
    clear_events(n)
    if n.role == ROLE_HOST {
        step_players(n, delta)
        // A tick is due a whole interval after the last, to within a
        // thousandth of one: steps of 1/60 add up to a hair under 1/30
        // often enough that a strict comparison skipped every few ticks,
        // and a skipped snapshot doubles the gap a client interpolates.
        n.since_tick = n.since_tick + delta
        interval = 1.0 / n.tick_rate
        if n.since_tick >= interval * 0.999 || n.tick == 0 {
            n.since_tick = n.since_tick - interval
            if n.since_tick > interval || n.since_tick < 0.0 { n.since_tick = 0.0 }
            n.tick = n.tick + 1
            send_snapshot(n, now)
        }
    } else {
        interpolate(n, now)
        let_go(n, now)
        // Without a player there is no input to carry the acknowledgement,
        // or the view.
        if n.mine == null && (n.ack_due || (n.my_id > 0 && view_due(n, now))) { send_ack(n, now) }
    }
    link_step(n, now)
    flush(n, now)
}

// --- the link, measured (#488) ----------------------------------------------------------------
//
// Every transport measured the same way, from the session itself, both
// ways: ten pings a second to every peer it has welcomed (a client, to
// its host once welcomed), each answered at once. A pong gives a round
// trip, as the game has it -- a frame on either side included -- smoothed
// as RFC 6298 smooths one (and TCP does), in integer microseconds; a ping
// unanswered after PING_LOST is lost, and the loss is the share of the
// last LOSS_PINGS judged. Every byte to a peer and from it is counted by
// kind, and each kind's rate taken over windows of a second.

link_step(n: *Net, now: float) {
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        linked = p.open && p.welcomed
        if n.role == ROLE_CLIENT { linked = p.open && n.my_id > 0 && !n.closed }
        if linked {
            judge_pings(p, now)
            if p.ping_at < 0.0 || now - p.ping_at >= PING_EVERY * 0.999 { send_ping(n, p, now) }
            roll_window(n, p, now)
        }
        i = i + 1
    }
}

send_ping(n: *Net, p: *Peer, now: float) {
    id = p.next_ping & 65535
    slot = id % PINGS
    (p.ping_times as float[])[slot] = now
    (p.ping_states as int[])[slot] = 1
    p.next_ping = p.next_ping + 1
    p.ping_at = now
    p.pings_sent = p.pings_sent + 1
    b = n.out
    b.length = 0
    put_u8(b, MSG_PING)
    put_u16(b, id)
    deliver(n, p, false, b.data, b.length, now)
}

// A ping answered at once; a pong is a round trip, if its ping is still
// in flight (one answered after PING_LOST was judged lost, and stays so).
take_ping(n: *Net, p: *Peer, kind: int, r: *NetReader, now: float) {
    id = get_u16(r)
    if p == null || !r.ok { return }
    if kind == MSG_PING {
        b = n.out
        b.length = 0
        put_u8(b, MSG_PONG)
        put_u16(b, id)
        deliver(n, p, false, b.data, b.length, now)
        return
    }
    slot = id % PINGS
    states = p.ping_states as int[]
    // The slot is this ping's while no newer one has taken it: 64 pings,
    // over six seconds, and a ping is judged in one.
    if states[slot] != 1 || ((p.next_ping - 1 - id) & 65535) >= PINGS { return }
    states[slot] = 2
    p.pings_answered = p.pings_answered + 1
    judged(p, 0)
    sample = ((now - (p.ping_times as float[])[slot]) * 1000000.0 + 0.5) as int
    if sample < 0 { sample = 0 }
    if !p.rtt_known {
        p.srtt_us = sample
        p.rttvar_us = sample / 2
        p.rtt_known = true
    } else {
        gap = p.srtt_us - sample
        if gap < 0 { gap = 0 - gap }
        p.rttvar_us = (p.rttvar_us * 3 + gap) / 4
        p.srtt_us = (p.srtt_us * 7 + sample) / 8
    }
}

// The pings in flight past PING_LOST, lost.
judge_pings(p: *Peer, now: float) {
    states = p.ping_states as int[]
    times = p.ping_times as float[]
    k = 0
    while k < PINGS {
        if states[k] == 1 && now - times[k] > PING_LOST {
            states[k] = 3
            p.pings_lost = p.pings_lost + 1
            judged(p, 1)
        }
        k = k + 1
    }
}

// A ping's outcome into the ring the loss is judged over: 1 lost, 0 answered.
judged(p: *Peer, lost: int) {
    (p.outcomes as int[])[p.outcome_next] = lost
    p.outcome_next = (p.outcome_next + 1) % LOSS_PINGS
    if p.outcome_count < LOSS_PINGS { p.outcome_count = p.outcome_count + 1 }
}

// What the transport adds for a peer, read into its counts: UDP's headers
// (the packets' and the chunks' own) and its resends each way. TCP's
// frames are counted as they go and come; the loopback adds nothing.
sync_transport(n: *Net, p: *Peer) {
    if n.udp == null { return }
    sent = p.sent_bytes as long[]
    got = p.recv_bytes as long[]
    headers = netudp.conn_headers(n.udp, p.conn, true)
    if headers >= (0 as long) {
        sent[TRAFFIC_HEADERS] = headers
        got[TRAFFIC_HEADERS] = netudp.conn_headers(n.udp, p.conn, false)
        sent[TRAFFIC_RESENT] = netudp.conn_resent(n.udp, p.conn, true)
        got[TRAFFIC_RESENT] = netudp.conn_resent(n.udp, p.conn, false)
    }
}

// Every rate taken over the window just ended, when a second has passed:
// whole bytes a second, from the counts' change over the window's
// microseconds.
roll_window(n: *Net, p: *Peer, now: float) {
    if p.window_start >= 0.0 && now - p.window_start < WINDOW * 0.999 { return }
    sync_transport(n, p)
    sent = p.sent_bytes as long[]
    got = p.recv_bytes as long[]
    was_sent = p.window_sent as long[]
    was_got = p.window_recv as long[]
    if p.window_start >= 0.0 {
        us = ((now - p.window_start) * 1000000.0 + 0.5) as long
        rate_sent = p.rate_sent as long[]
        rate_got = p.rate_recv as long[]
        all_sent = 0 as long
        all_got = 0 as long
        k = 1
        while k < LINK_KINDS {
            rate_sent[k] = (sent[k] - was_sent[k]) * (1000000 as long) / us
            rate_got[k] = (got[k] - was_got[k]) * (1000000 as long) / us
            if counted_kind(k) {
                all_sent = all_sent + (sent[k] - was_sent[k])
                all_got = all_got + (got[k] - was_got[k])
            }
            k = k + 1
        }
        rate_sent[TRAFFIC_ALL] = all_sent * (1000000 as long) / us
        rate_got[TRAFFIC_ALL] = all_got * (1000000 as long) / us
        p.window_us = us
    }
    k = 0
    while k < LINK_KINDS {
        was_sent[k] = sent[k]
        was_got[k] = got[k]
        k = k + 1
    }
    p.window_start = now
}

// The kinds a peer's traffic is counted in, which add up to all of it:
// the messages by what they are, the transport's headers, its resends.
counted_kind(k: int) -> bool {
    return k == TRAFFIC_SNAPSHOTS || k == TRAFFIC_EVENTS || k == TRAFFIC_INPUTS || k == TRAFFIC_ACKS ||
           k == TRAFFIC_HEADERS || k == TRAFFIC_RESENT || k == TRAFFIC_LINK
}

handle(n: *Net, ev: *NetEvent, now: float) {
    if n.role == ROLE_CLIENT && ev.kind == EVENT_CONNECTED {
        b = n.out
        b.length = 0
        put_u8(b, MSG_HELLO)
        put_u32(b, PROTOCOL)
        deliver(n, peer_by_id(n, 0), true, b.data, b.length, now)
        return
    }
    if ev.kind == EVENT_DISCONNECTED {
        if n.role == ROLE_CLIENT {
            n.closed = true
        } else {
            p = peer_by_id(n, ev.peer)
            if p != null && p.welcomed { left(n, p.id, now) }
        }
        return
    }
    if ev.kind != EVENT_MESSAGE { return }
    r = NetReader { data: ev.data, length: ev.length, at: 0, ok: true }
    kind = get_u8(&r)
    if !r.ok { return }
    from = peer_by_id(n, ev.peer)
    if from != null {
        heard = from.recv_bytes as long[]
        k = received_kind(kind)
        heard[k] = heard[k] + (ev.length as long)
    }
    if kind == MSG_PING || kind == MSG_PONG {
        take_ping(n, from, kind, &r, now)
        return
    }
    if n.role == ROLE_HOST && kind == MSG_HELLO {
        if get_u32(&r) != PROTOCOL { return }
        p = peer_by_id(n, ev.peer)
        if p == null || p.welcomed { return }
        p.welcomed = true
        b = n.out
        b.length = 0
        put_u8(b, MSG_WELCOME)
        put_u32(b, p.id)
        put_u32(b, (n.tick_rate) as int)
        put_f64(b, n.unit)
        deliver(n, p, true, b.data, b.length, now)
        host_player(n, p, now)
        tell_objects(n, p, now)
        joined(n, p.id, now)
        return
    }
    if kind == MSG_EVENT {
        // On the host, from a client it has welcomed; on a client, from the
        // host (the only peer it has).
        if n.role == ROLE_HOST {
            p = peer_by_id(n, ev.peer)
            if p == null || !p.welcomed { return }
        }
        take_event(n, ev.peer, &r, now)
        return
    }
    if kind == MSG_EVENT_BYTES {
        if n.role == ROLE_HOST {
            p = peer_by_id(n, ev.peer)
            if p == null || !p.welcomed { return }
        }
        take_event_bytes(n, ev.peer, &r, now)
        return
    }
    if n.role == ROLE_CLIENT && kind == MSG_CREATE {
        client_create(n, &r)
        return
    }
    if n.role == ROLE_CLIENT && kind == MSG_DESTROY {
        client_destroy(n, &r)
        return
    }
    if n.role == ROLE_HOST && kind == MSG_INPUT {
        p = peer_by_id(n, ev.peer)
        if p == null { return }
        tick = get_u16(&r)
        flags = get_u8(&r)
        if !r.ok { return }
        if (flags & 1) != 0 { take_view(n, p, &r, (flags & 2) != 0) }
        if !r.ok { return }
        take_ack(n, p, tick)
        if p.player != null { apply_inputs(n, p, &r) }
        return
    }
    if n.role == ROLE_HOST && kind == MSG_ACK {
        p = peer_by_id(n, ev.peer)
        tick = get_u16(&r)
        flags = get_u8(&r)
        if p == null || !r.ok { return }
        if (flags & 1) != 0 { take_view(n, p, &r, (flags & 2) != 0) }
        if r.ok { take_ack(n, p, tick) }
        return
    }
    if n.role == ROLE_CLIENT && kind == MSG_SPAWN {
        id = get_u32(&r)
        owner = get_u32(&r)
        if !r.ok { return }
        client_spawn(n, id, owner)
        return
    }
    if n.role == ROLE_CLIENT && kind == MSG_WELCOME {
        id = get_u32(&r)
        rate = get_u32(&r)
        unit = get_f64(&r)
        if !r.ok { return }
        n.my_id = id
        if rate > 0 { n.tick_rate = rate as float }
        if unit > 0.0 { n.unit = unit }
        return
    }
    if n.role == ROLE_CLIENT && kind == MSG_SNAPSHOT {
        take_snapshot(n, &r, now)
    }
}

// Whether a client has been welcomed, and its host is still there; a host
// always is connected.
connected(n: *Net) -> bool {
    if n.role == ROLE_HOST { return true }
    return n.my_id > 0 && !n.closed
}

// Whether a client's link to its host has gone: the host said so, or
// fell silent past the timeout (UDP), or the stream closed (TCP).
disconnected(n: *Net) -> bool { return n.closed }

client_id(n: *Net) -> int { return n.my_id }

// Whether this side is the host.
hosting(n: *Net) -> bool { return n.role == ROLE_HOST }

// The clients a host has welcomed and still hears.
peer_count(n: *Net) -> int {
    count = 0
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed && p.open { count = count + 1 }
        i = i + 1
    }
    return count
}

set_tick_rate(n: *Net, per_second: float) {
    if per_second > 0.0 { n.tick_rate = per_second }
}

// How far behind the host's time a client draws: at least a snapshot
// interval and the link's jitter, or it runs out of snapshots to draw from.
set_interpolation_delay(n: *Net, seconds: float) {
    if seconds >= 0.0 { n.interpolation_delay = seconds }
}

// --- players ---------------------------------------------------------------------------------

// How a player is made, on either side: `maker(context, client)` returns a
// character controller on a game object of its own, where the game wants a
// player to begin. The host calls it for every client it welcomes, a client
// for every player it is told of -- its own included.
set_player_maker(n: *Net, maker: fn(ptr, int) -> *CharacterController, context: ptr) {
    n.player_maker = maker
    n.maker_context = context
}

player_by_id(n: *Net, id: int) -> *NetPlayer {
    i = 0
    while i < list.size(n.players) {
        pl = list.get_raw(n.players, i) as *NetPlayer
        if pl.net_id == id { return pl }
        i = i + 1
    }
    return null
}

// The player a client owns, or null.
player_of(n: *Net, client: int) -> *NetPlayer {
    i = 0
    while i < list.size(n.players) {
        pl = list.get_raw(n.players, i) as *NetPlayer
        if pl.client == client { return pl }
        i = i + 1
    }
    return null
}

player_count(n: *Net) -> int { return list.size(n.players) }

// A client's own player, once the host has spawned it; null before.
my_player(n: *Net) -> *NetPlayer { return n.mine as *NetPlayer }

// The most a reconciliation has had to move this client's player, metres:
// 0 where the client's world and the host's agree, as they should.
prediction_error(n: *Net) -> float { return n.worst_correction }

input_sent(n: *Net) -> int { return n.inputs_sent }

// A client's commands the host has asked for again: the times a snapshot
// said the host lacked one -- every message that carried it lost -- while
// it held a later one. Each was sent again, and the host applied it in its
// turn, so none is ever lost for good.
commands_asked(n: *Net) -> int { return n.asked }

make_player(n: *Net, client: int, id: int) -> *NetPlayer {
    maker = n.player_maker
    if maker == null { return null }
    controller = maker(n.maker_context, client)
    if controller == null { return null }
    // The session moves it -- by commands, by prediction, or by snapshots
    // -- so the world does not also stand it where it is.
    controller.driven = true
    pl = calloc(1, sizeof(NetPlayer)) as *NetPlayer
    pl.client = client
    pl.net_id = id
    pl.controller = controller
    list.add_raw(n.players, pl as ptr)
    networked_at(n, controller.object as *GameObject, id)
    // A player is simulated where its commands are: on the host its own
    // (client 0), on a client its own; every other copy is remote.
    remote = client != n.my_id
    if n.role == ROLE_HOST { remote = client != 0 }
    set_remote(object_by_id(n, id), remote)
    return pl
}

// A welcomed client's player on the host, and every player told to every
// client: the new one to all, the ones before it to the newcomer.
host_player(n: *Net, p: *Peer, now: float) {
    if n.player_maker == null { return }
    pl = make_player(n, p.id, list.size(n.objects) + 1)
    if pl == null { return }
    p.player = pl as ptr
    i = 0
    while i < list.size(n.peers) {
        other = list.get_raw(n.peers, i) as *Peer
        if other.welcomed {
            if other == p {
                k = 0
                while k < list.size(n.players) {
                    tell_spawn(n, other, list.get_raw(n.players, k) as *NetPlayer, now)
                    k = k + 1
                }
            } else {
                tell_spawn(n, other, pl, now)
            }
        }
        i = i + 1
    }
}

tell_spawn(n: *Net, p: *Peer, pl: *NetPlayer, now: float) {
    b = n.out
    b.length = 0
    put_u8(b, MSG_SPAWN)
    put_u32(b, pl.net_id)
    put_u32(b, pl.client)
    deliver(n, p, true, b.data, b.length, now)
}

client_spawn(n: *Net, id: int, owner: int) {
    if player_by_id(n, id) != null { return }
    pl = make_player(n, owner, id)
    if pl == null { return }
    if owner == n.my_id {
        n.mine = pl as ptr
    } else {
        seed_from_snapshot(n, object_by_id(n, id))
    }
}

// The host applies a client's commands it has not applied yet, oldest
// first, a fixed step each: the same moves the client made ahead of it.
apply_inputs(n: *Net, p: *Peer, r: *NetReader) {
    if p.queued == null { p.queued = calloc(COMMANDS * COMMAND, 8) }
    q = p.queued as float[]
    first = get_u32(r)
    count = get_u8(r)
    mask_at = r.at
    r.at = r.at + (count + 7) / 8
    if count == 0 || r.at > r.length { return }
    sx = 0 as long
    sz = 0 as long
    dx = 0 as long
    dz = 0 as long
    jump = 0.0
    i = 0
    while i < count {
        seq = first + i
        if (mem.get_byte(r.data, mask_at + i / 8) & (1 << (i % 8))) != 0 {
            // Each walk the one before it changed as much again, and the
            // difference; the first as it is.
            x = sx + dx + unzigzag(get_varint(r))
            packed = get_varint(r)
            z = sz + dz + unzigzag(packed / (2 as long))
            jump = 0.0
            if (packed & (1 as long)) != (0 as long) { jump = ((get_varint(r)) as float) / JUMP_STEPS }
            if i > 0 {
                dx = x - sx
                dz = z - sz
            }
            sx = x
            sz = z
        } else if i == 0 {
            return
        } else {
            dx = 0 as long
            dz = 0 as long
        }
        if !r.ok { return }
        wx = (sx as float) / WALK_STEPS
        wz = (sz as float) / WALK_STEPS
        // Not yet applied, and within the ring: kept at its place by
        // sequence, whatever came before it.
        if seq > p.last_input && seq <= p.last_input + COMMANDS {
            slot = (seq % COMMANDS) * COMMAND
            q[slot] = (seq) as float
            q[slot + 1] = wx
            q[slot + 2] = wz
            q[slot + 3] = jump
            if seq > p.last_queued { p.last_queued = seq }
        }
        i = i + 1
    }
}

// A client's next command, applied to its player, and only that one: every
// command is applied, in order. A command goes in several messages
// (carried_for), so the next is here while a later one is unless all of
// them were lost; then the player waits, each snapshot says which command
// the host lacks (wanted_command), and the client sends it again with the
// ones after it.
apply_queued(n: *Net, p: *Peer) {
    if p.queued == null || p.last_queued <= p.last_input { return }
    next = p.last_input + 1
    q = p.queued as float[]
    slot = (next % COMMANDS) * COMMAND
    if (q[slot]) as int != next { return }
    pl = p.player as *NetPlayer
    physics.character_move(pl.controller, core.vec3(q[slot + 1], 0.0, q[slot + 2]), q[slot + 3], PLAYER_STEP)
    settle(n, pl.controller)
    p.last_input = next
}

// The host's player steps due by `now`: a command a client each, and a
// second where a client's queue has grown past QUEUE_DEPTH (it fell behind
// while the link held its commands back).
step_players(n: *Net, delta: float) {
    if !n.player_started {
        n.player_started = true
        return
    }
    n.player_clock = n.player_clock + delta
    while n.player_clock >= PLAYER_STEP * 0.999 {
        n.player_clock = n.player_clock - PLAYER_STEP
        i = 0
        while i < list.size(n.peers) {
            p = list.get_raw(n.peers, i) as *Peer
            if p.player != null && p.last_queued > p.last_input {
                apply_queued(n, p)
                if p.last_queued - p.last_input > QUEUE_DEPTH { apply_queued(n, p) }
            }
            i = i + 1
        }
    }
}

// The host plays too (a listen server): a player of its own, client 0,
// made now and told to every client as any player is. Its commands move it
// directly -- the host's world is the authority, so there is nothing to
// predict. Null without a player maker.
host_play(n: *Net, now: float) -> *NetPlayer {
    if n.role != ROLE_HOST { return null }
    if n.mine != null { return n.mine as *NetPlayer }
    pl = make_player(n, 0, list.size(n.objects) + 1)
    if pl == null { return null }
    n.mine = pl as ptr
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed { tell_spawn(n, p, pl, now) }
        i = i + 1
    }
    return pl
}

// A client's command for this fixed step: its own player moves by it now,
// ahead of the host, and it goes to the host with the few before it (so a
// lost message costs nothing), and the newest snapshot the client holds
// (its acknowledgement, riding along). Before the host has spawned the
// player, nothing. On the host, its own player (host_play) moves, and that
// is all.
player_input(n: *Net, walk: Vec3, jump: float, now: float) {
    mine = n.mine as *NetPlayer
    if mine == null { return }
    if n.role == ROLE_HOST {
        physics.character_move(mine.controller, core.vec3(walk.x, 0.0, walk.z), jump, PLAYER_STEP)
        return
    }
    if n.command_count >= COMMANDS { return }
    seq = n.next_seq
    n.next_seq = n.next_seq + 1
    cmds = n.commands as float[]
    slot = ((n.command_first + n.command_count) % COMMANDS) * COMMAND
    // The command as the wire carries it -- a millimetre a second of walk,
    // a 64th of a metre a second of jump -- and predicted as that: the host
    // applies the same numbers, so the two worlds take the same step.
    cmds[slot] = (seq) as float
    cmds[slot + 1] = (walk_steps(walk.x) as float) / WALK_STEPS
    cmds[slot + 2] = (walk_steps(walk.z) as float) / WALK_STEPS
    cmds[slot + 3] = (jump_steps(jump) as float) / JUMP_STEPS
    cmds[slot + 4] = 0.0
    n.command_count = n.command_count + 1
    physics.character_move(mine.controller, core.vec3(cmds[slot + 1], 0.0, cmds[slot + 2]), cmds[slot + 3], PLAYER_STEP)
    settle(n, mine.controller)
    // Each command goes in as many messages from the one it is made in as
    // the link's loss asks (carried_for), so it is lost only when all of
    // them are; one the host still lacks while it holds a later one (a
    // snapshot says which) goes again, and every one after it, until the
    // host has it -- so no command is ever missing for good, and the host
    // applies every one, in order. A command is sent where it differs from
    // the one before it, as its change from the change before: a walk
    // turning or speeding up changes a little more each step, a byte an
    // axis; a key held is the same command step after step, a bit each.
    carried = carried_for(n)
    start = 0
    while start < n.command_count - 1 && cmds[((n.command_first + start) % COMMANDS) * COMMAND + 4] >= (carried as float) {
        start = start + 1
    }
    if n.wanted > 0 {
        lacked = n.wanted - (cmds[n.command_first * COMMAND]) as int
        if lacked >= 0 && lacked < start { start = lacked }
    }
    count = n.command_count - start
    if count > INPUTS_MOST { count = INPUTS_MOST }
    b = n.out
    b.length = 0
    put_u8(b, MSG_INPUT)
    put_u16(b, n.newest_tick & 65535)
    put_view_flag(n, b, now)
    put_u32(b, (cmds[((n.command_first + start) % COMMANDS) * COMMAND]) as int)
    put_u8(b, count)
    mask = 0
    k = 0
    while k < count {
        if command_differs(n, start + k, k == 0) { mask = mask | (1 << (k % 8)) }
        if k % 8 == 7 || k == count - 1 {
            put_u8(b, mask)
            mask = 0
        }
        k = k + 1
    }
    sx = 0 as long
    sz = 0 as long
    dx = 0 as long
    dz = 0 as long
    k = 0
    while k < count {
        at = ((n.command_first + start + k) % COMMANDS) * COMMAND
        if command_differs(n, start + k, k == 0) {
            x = walk_steps(cmds[at + 1])
            z = walk_steps(cmds[at + 2])
            leap = jump_steps(cmds[at + 3])
            put_varint(b, zigzag(x - sx - dx))
            // The z's lowest bit says whether a jump follows.
            jumps = 0 as long
            if leap > (0 as long) { jumps = 1 as long }
            put_varint(b, zigzag(z - sz - dz) * (2 as long) + jumps)
            if leap > (0 as long) { put_varint(b, leap) }
            if k > 0 {
                dx = x - sx
                dz = z - sz
            }
            sx = x
            sz = z
        } else {
            dx = 0 as long
            dz = 0 as long
        }
        cmds[at + 4] = cmds[at + 4] + 1.0
        k = k + 1
    }
    deliver(n, peer_by_id(n, 0), false, b.data, b.length, now)
    n.ack_due = false
    n.inputs_sent = n.inputs_sent + 1
}

// A client's player after a move, as the snapshot carries it: its place
// and its fall in 32-bit floats -- on the host, and in the client's
// prediction and its replays alike. The client's replay starts from exactly
// the host's state and takes exactly its steps, so the two agree to the bit
// wherever the player walks: where a hair of rounding would put it on the
// other side of a seam between two floors, the correction was the floors'
// difference, not a quantum.
settle(n: *Net, c: *CharacterController) {
    o = c.object as *GameObject
    at = behaviour.object_position(o)
    behaviour.object_set_position(o, core.vec3(as_f32(n, at.x), as_f32(n, at.y), as_f32(n, at.z)))
    c.velocity = core.vec3(c.velocity.x, as_f32(n, c.velocity.y), c.velocity.z)
}

// A walk in whole millimetres a second, a jump in 64ths of a metre a
// second (none below 0): what a command is on the wire.
walk_steps(v: float) -> long { return floor(v * WALK_STEPS + 0.5) as long }

jump_steps(v: float) -> long {
    if v <= 0.0 { return 0 as long }
    return floor(v * JUMP_STEPS + 0.5) as long
}

// The input messages each command goes in: enough that every one of them
// is lost for one command in a million (CARRIED_LOST) at the link's loss --
// a ping's round trip, so at least either way's -- as the pings judged so
// far put it by the rule of succession, (lost + 1) / (judged + 1): every
// unacknowledged command before any is judged, six after a second of none
// lost, four once fifty are; never fewer than CARRIED. On a link losing
// half or more, every unacknowledged command.
carried_for(n: *Net) -> int {
    p = peer_by_id(n, 0)
    if p == null { return INPUTS_MOST }
    lost = 0
    ring = p.outcomes as int[]
    k = 0
    while k < p.outcome_count {
        lost = lost + ring[k]
        k = k + 1
    }
    loss = ((lost + 1) as float) / ((p.outcome_count + 1) as float)
    if loss >= 0.5 { return INPUTS_MOST }
    wanted = log(CARRIED_LOST) / log(loss)
    carried = wanted as int
    if (carried as float) < wanted { carried = carried + 1 }
    if carried < CARRIED { carried = CARRIED }
    if carried > INPUTS_MOST { carried = INPUTS_MOST }
    return carried
}

// Whether the client's unacknowledged command `k` is sent: the first a
// message carries always, another where it is not the one before it again.
command_differs(n: *Net, k: int, first: bool) -> bool {
    if first { return true }
    cmds = n.commands as float[]
    at = ((n.command_first + k) % COMMANDS) * COMMAND
    was = ((n.command_first + k - 1) % COMMANDS) * COMMAND
    return cmds[at + 1] != cmds[was + 1] || cmds[at + 2] != cmds[was + 2] || cmds[at + 3] != cmds[was + 3]
}

// Host: the oldest command of a client's it lacks while it holds a later
// one -- one whose every message was lost -- or 0.
wanted_command(p: *Peer) -> int {
    if p.queued == null { return 0 }
    q = p.queued as float[]
    seq = p.last_input + 1
    while seq < p.last_queued {
        if (q[(seq % COMMANDS) * COMMAND]) as int != seq { return seq }
        seq = seq + 1
    }
    return 0
}

// The host says where this client's player was after command `ack`: the
// player is put there, the acknowledged commands dropped, and the rest
// replayed on top -- so the client stays ahead of the host and agrees with
// it. How far that moved the player from where the client had it is the
// prediction's error.
reconcile(n: *Net, at: Vec3, vy: float, grounded: bool, ack: int) {
    mine = n.mine as *NetPlayer
    if ack < n.acked { return }
    n.acked = ack
    c = mine.controller
    o = c.object as *GameObject
    had = behaviour.object_position(o)
    cmds = n.commands as float[]
    while n.command_count > 0 && (cmds[n.command_first * COMMAND]) as int <= ack {
        n.command_first = (n.command_first + 1) % COMMANDS
        n.command_count = n.command_count - 1
    }
    behaviour.object_set_position(o, at)
    c.velocity = core.vec3(c.velocity.x, vy, c.velocity.z)
    c.grounded = grounded
    k = 0
    while k < n.command_count {
        slot = ((n.command_first + k) % COMMANDS) * COMMAND
        physics.character_move(c, core.vec3(cmds[slot + 1], 0.0, cmds[slot + 2]), cmds[slot + 3], PLAYER_STEP)
        settle(n, c)
        k = k + 1
    }
    moved = core.v3_len(core.v3_sub(behaviour.object_position(o), had))
    n.last_correction = moved
    if moved > n.worst_correction { n.worst_correction = moved }
}

// --- events ----------------------------------------------------------------------------------
//
// A game's own messages: a horn honked, a hit, a door opened. An event is
// reliable, so it arrives once and in order with everything else reliable
// the same side sent the same peer: an event the host sends after creating
// an object arrives after the object is there. It carries up to four
// numbers (an id, an amount, a place), 32-bit floats on the wire, and only
// as many as the last one that is not 0.

// An event this side handles: `handler(context, call)` is called with
// every one that arrives, in the step it arrives. On the wire an event is
// its order among the registered, so both sides register the same events
// in the same order, as they mark the same objects networked. Returns the
// event's id.
on_event(n: *Net, name: string, handler: fn(ptr, *NetCall), context: ptr) -> int {
    h = heap.new(NetHandler)
    h.name = core.set_owned(h.name, name)
    h.handler = handler
    h.context = context
    list.add_raw(n.handlers, h as ptr)
    return list.size(n.handlers)
}

event_named(n: *Net, name: string) -> int {
    i = 0
    while i < list.size(n.handlers) {
        h = list.get_raw(n.handlers, i) as *NetHandler
        if string.equals(h.name, name) == 1 { return i + 1 }
        i = i + 1
    }
    return 0
}

// Send an event. A client's go to the host (`to` is HOST); the host's go
// to one client, by its id, or to EVERYONE it has welcomed -- not to the
// host itself, whose game calls its own code. False when there is no such
// event, or no one to send it to yet (a client before its welcome).
send_event(n: *Net, name: string, to: int, now: float, a: float = 0.0, b: float = 0.0, c: float = 0.0, d: float = 0.0) -> bool {
    event = event_named(n, name)
    if event == 0 {
        error_made("no event named ${name}")
        return false
    }
    count = 4
    if d == 0.0 {
        count = 3
        if c == 0.0 {
            count = 2
            if b == 0.0 {
                count = 1
                if a == 0.0 { count = 0 }
            }
        }
    }
    out = n.out
    out.length = 0
    put_u8(out, MSG_EVENT)
    put_u16(out, event)
    put_u8(out, count)
    if count > 0 { put_f32(out, a) }
    if count > 1 { put_f32(out, b) }
    if count > 2 { put_f32(out, c) }
    if count > 3 { put_f32(out, d) }
    if n.role == ROLE_CLIENT {
        if n.my_id == 0 || n.closed { return false }
        deliver(n, peer_by_id(n, 0), true, out.data, out.length, now)
        return true
    }
    sent = false
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed && p.open && (to == EVERYONE || to == p.id) {
            deliver(n, p, true, out.data, out.length, now)
            sent = true
        }
        i = i + 1
    }
    return sent
}

// An event with a block of bytes instead of four numbers: a state too big
// for numbers, sent once (a horde's, to a client that joins late). The
// same event ids, the same rules for who sends to whom; the handler reads
// `call.data` and `call.length`, which are the session's until it
// returns. 7 bytes and the block.
send_event_bytes(n: *Net, name: string, to: int, now: float, data: ptr, length: int) -> bool {
    event = event_named(n, name)
    if event == 0 {
        error_made("no event named ${name}")
        return false
    }
    if length < 0 || (length > 0 && data == null) { return false }
    out = n.out
    out.length = 0
    put_u8(out, MSG_EVENT_BYTES)
    put_u16(out, event)
    put_u32(out, length)
    if length > 0 {
        buf_reserve(out, length)
        memcpy(out.data + out.length, data, length as long)
        out.length = out.length + length
    }
    if n.role == ROLE_CLIENT {
        if n.my_id == 0 || n.closed { return false }
        deliver(n, peer_by_id(n, 0), true, out.data, out.length, now)
        return true
    }
    sent = false
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed && p.open && (to == EVERYONE || to == p.id) {
            deliver(n, p, true, out.data, out.length, now)
            sent = true
        }
        i = i + 1
    }
    return sent
}

take_event_bytes(n: *Net, sender: int, r: *NetReader, now: float) {
    event = get_u16(r)
    length = get_u32(r)
    if !r.ok || length < 0 || r.at + length > r.length || event < 1 || event > list.size(n.handlers) { return }
    h = list.get_raw(n.handlers, event - 1) as *NetHandler
    call = NetCall { event: event, sender: sender, a: 0.0, b: 0.0, c: 0.0, d: 0.0, data: r.data + r.at, length: length, now: now }
    handler = h.handler
    handler(h.context, &call)
}

// On the host, `hook(context, client, now)` is called with every client
// it welcomes, after the welcome, its player and the objects alive are on
// their way, so what the game sends it from the hook arrives after them:
// what a client that joins late needs of the game's own state.
on_join(n: *Net, hook: fn(ptr, int, float), context: ptr) {
    j = heap.new(NetJoinHook)
    j.hook = hook
    j.context = context
    list.add_raw(n.joins, j as ptr)
}

// On the host, `hook(context, client, now)` is called with every welcomed
// client whose link goes: it said so, or it fell silent past the timeout
// (UDP), or its stream closed (TCP). Its player stays, the game's to take
// away.
on_leave(n: *Net, hook: fn(ptr, int, float), context: ptr) {
    j = heap.new(NetJoinHook)
    j.hook = hook
    j.context = context
    list.add_raw(n.leaves, j as ptr)
}

// On a client, `hook(context, tick, now)` is called with every snapshot
// it takes, once its fields are written and their hooks called: the ticks
// this side has held, in order. What a state it never held cannot have
// shown (a change the loss or the budget folded into the next), and what
// a debugger or a test lines the fields' changes up against.
on_snapshot(n: *Net, hook: fn(ptr, int, float), context: ptr) {
    j = heap.new(NetJoinHook)
    j.hook = hook
    j.context = context
    list.add_raw(n.takes, j as ptr)
}

joined(n: *Net, client: int, now: float) {
    i = 0
    while i < list.size(n.joins) {
        j = list.get_raw(n.joins, i) as *NetJoinHook
        hook = j.hook
        hook(j.context, client, now)
        i = i + 1
    }
}

left(n: *Net, client: int, now: float) {
    i = 0
    while i < list.size(n.leaves) {
        j = list.get_raw(n.leaves, i) as *NetJoinHook
        hook = j.hook
        hook(j.context, client, now)
        i = i + 1
    }
}

// An event that arrived, to its handler.
take_event(n: *Net, sender: int, r: *NetReader, now: float) {
    event = get_u16(r)
    count = get_u8(r)
    if count > EVENT_VALUES { return }
    a = 0.0
    b = 0.0
    c = 0.0
    d = 0.0
    if count > 0 { a = get_f32(r) }
    if count > 1 { b = get_f32(r) }
    if count > 2 { c = get_f32(r) }
    if count > 3 { d = get_f32(r) }
    if !r.ok || event < 1 || event > list.size(n.handlers) { return }
    h = list.get_raw(n.handlers, event - 1) as *NetHandler
    call = NetCall { event: event, sender: sender, a: a, b: b, c: c, d: d, data: null, length: 0, now: now }
    handler = h.handler
    handler(h.context, &call)
}

// --- objects created mid-game ------------------------------------------------------------------
//
// The scene's networked objects are known by the order both sides mark
// them. An object the host creates while the game runs (a rocket, a car
// driven in) is known by the id the host gives it, the next after every id
// so far, and by its kind: the host tells every client the id, the kind
// and where it is, and each client makes its own with the kind's maker.
// An id is never given again, so a snapshot or a delta that still names a
// destroyed object finds nothing there.

// A kind of object the host creates: `maker(context, id)` returns a new
// game object for net id `id` (the session places it), and
// `unmaker(context, o)` lets one go (engine.destroy, as a game does; null
// to keep it). Both sides register the same kinds in the same order: on the
// wire a kind is that order. Returns the kind's id.
object_kind(n: *Net, name: string, maker: fn(ptr, int) -> *GameObject, unmaker: fn(ptr, *GameObject), context: ptr) -> int {
    k = heap.new(NetKind)
    k.name = core.set_owned(k.name, name)
    k.maker = maker
    k.unmaker = unmaker
    k.context = context
    list.add_raw(n.kinds, k as ptr)
    return list.size(n.kinds)
}

kind_named(n: *Net, name: string) -> int {
    i = 0
    while i < list.size(n.kinds) {
        k = list.get_raw(n.kinds, i) as *NetKind
        if string.equals(k.name, name) == 1 { return i + 1 }
        i = i + 1
    }
    return 0
}

// A new object of a kind, on the host, at `position` turned by `rotation`:
// made by the kind's maker, networked, and told to every client now, each
// making its own and placing it the same. From the next tick the snapshots
// carry it like any. Null on a client, or with no such kind.
create_object(n: *Net, name: string, position: Vec3, rotation: Quat, now: float) -> *GameObject {
    if n.role != ROLE_HOST { return null }
    kind = kind_named(n, name)
    if kind == 0 {
        error_made("no object kind named ${name}")
        return null
    }
    k = list.get_raw(n.kinds, kind - 1) as *NetKind
    id = list.size(n.objects) + 1
    maker = k.maker
    o = maker(k.context, id)
    if o == null { return null }
    set_transform(o, position, rotation)
    networked_at(n, o, id)
    no = object_by_id(n, id)
    no.kind = kind
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed { tell_object(n, p, no, now) }
        i = i + 1
    }
    return o
}

// An object the host created, gone: every client told when and where it
// was last, then the kind's unmaker lets it go here. A client draws it to
// that place and lets its own go when its view reaches that moment, so the
// object lives the same stretch of the host's time on every side.
destroy_object(n: *Net, o: *GameObject, now: float) {
    if n.role != ROLE_HOST || o == null { return }
    no = null as *NetObject
    i = 0
    while i < list.size(n.objects) {
        candidate = list.get_raw(n.objects, i) as *NetObject
        if candidate != null && candidate.object == o && candidate.kind > 0 { no = candidate }
        i = i + 1
    }
    if no == null { return }
    where = position_of(o)
    turn = rotation_of(o)
    out = n.out
    out.length = 0
    put_u8(out, MSG_DESTROY)
    put_u32(out, no.id)
    put_f32(out, now)
    put_f32(out, where.x)
    put_f32(out, where.y)
    put_f32(out, where.z)
    put_f32(out, turn.x)
    put_f32(out, turn.y)
    put_f32(out, turn.z)
    put_f32(out, turn.w)
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if p.welcomed { deliver(n, p, true, out.data, out.length, now) }
        i = i + 1
    }
    keep_gone(n, no, now)
    forget(n, no)
}

// Host: a destroyed object's fields as they are now, for the snapshots to
// carry: a change only a lost snapshot carried, or one made since the last
// tick, would otherwise never reach a client.
keep_gone(n: *Net, no: *NetObject, now: float) {
    lay = layout_at(n, no.id)
    if lay == null || lay.at < 0 || lay.count == 0 || no.fields == null { return }
    g = calloc(1, sizeof(NetGone)) as *NetGone
    g.id = no.id
    g.tick = n.tick + 1
    g.lay = calloc(1, sizeof(NetLayout)) as *NetLayout
    g.lay.count = lay.count
    g.lay.at = 0
    g.lay.words = lay.words
    g.lay.kinds = calloc(FIELDS_MOST, 4)
    g.lay.offsets = calloc(FIELDS_MOST, 4)
    g.lay.precisions = calloc(FIELDS_MOST, 8)
    memcpy(g.lay.kinds, lay.kinds, (FIELDS_MOST * 4) as long)
    memcpy(g.lay.offsets, lay.offsets, (FIELDS_MOST * 4) as long)
    memcpy(g.lay.precisions, lay.precisions, (FIELDS_MOST * 8) as long)
    fields_now = snapshot_new()
    snapshot_reset(fields_now, g.tick, now, 0, n.field_words)
    read_fields(n, no, lay, fields_now)
    g.words = calloc(lay.words, 8)
    memcpy(g.words, fields_now.fvalues + lay.at * 8, (lay.words * 8) as long)
    snapshot_free(fields_now)
    list.add_raw(n.gone, g as ptr)
}

gone_free(g: *NetGone) {
    layout_free(g.lay)
    free(g.words)
    free(g as ptr)
}

// Whether a snapshot against `base` carries this one: when the client may
// not hold a snapshot of its tick.
gone_due(g: *NetGone, base: *Snapshot) -> bool {
    return base == null || base.tick < g.tick
}

// Host: the destroyed objects every client has acknowledged a snapshot of
// their tick for, let go -- the first snapshot at or after it a client
// took carried them.
drop_gone(n: *Net) {
    k = 0
    while k < list.size(n.gone) {
        g = list.get_raw(n.gone, k) as *NetGone
        had = true
        i = 0
        while i < list.size(n.peers) {
            p = list.get_raw(n.peers, i) as *Peer
            if p.welcomed && p.open && p.acked_tick < g.tick { had = false }
            i = i + 1
        }
        if had {
            gone_free(g)
            list.remove(n.gone, k)
        } else {
            k = k + 1
        }
    }
}

// The game object at a net id, or null (none, or destroyed).
object_of(n: *Net, id: int) -> *GameObject {
    no = object_by_id(n, id)
    if no == null { return null }
    return no.object
}

// A networked object's net id, or 0: what an event names it by.
id_of(n: *Net, o: *GameObject) -> int {
    no = net_object_of(n, o)
    if no == null { return 0 }
    return no.id
}

// A created object told to one client: its id, its kind, and where it is
// now, at the host's time.
tell_object(n: *Net, p: *Peer, no: *NetObject, now: float) {
    where = position_of(no.object)
    turn = rotation_of(no.object)
    out = n.out
    out.length = 0
    put_u8(out, MSG_CREATE)
    put_u32(out, no.id)
    put_u16(out, no.kind)
    put_f32(out, now)
    put_f32(out, where.x)
    put_f32(out, where.y)
    put_f32(out, where.z)
    put_f32(out, turn.x)
    put_f32(out, turn.y)
    put_f32(out, turn.z)
    put_f32(out, turn.w)
    deliver(n, p, true, out.data, out.length, now)
}

// Every created object still here, to a client just welcomed: one that
// joins late has what the others have, and nothing destroyed before it
// came.
tell_objects(n: *Net, p: *Peer, now: float) {
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && no.kind > 0 { tell_object(n, p, no, now) }
        i = i + 1
    }
}

// A client told of a created object makes its own with the kind's maker,
// places it where the host has it, and keeps that as its first sample, so
// it is drawn from there to wherever the snapshots take it.
client_create(n: *Net, r: *NetReader) {
    id = get_u32(r)
    kind = get_u16(r)
    host_time = get_f32(r)
    values = calloc(7, 8)
    v = values as float[]
    k = 0
    while k < 7 {
        v[k] = get_f32(r)
        k = k + 1
    }
    if r.ok && kind >= 1 && kind <= list.size(n.kinds) && object_by_id(n, id) == null {
        nk = list.get_raw(n.kinds, kind - 1) as *NetKind
        maker = nk.maker
        o = maker(nk.context, id)
        if o != null {
            set_transform(o, core.vec3(v[0], v[1], v[2]), core.quat(v[3], v[4], v[5], v[6]))
            networked_at(n, o, id)
            no = object_by_id(n, id)
            no.kind = kind
            add_sample(no, host_time, v, 0)
            seed_from_snapshot(n, no)
        }
    }
    free(values)
}

// The host destroyed an object: its last place is its last sample. A
// snapshot cannot say an object is gone (one it leaves out is as it was),
// so any sample from after that moment is the old state carried on and is
// dropped. The object goes when this side's view reaches the moment.
client_destroy(n: *Net, r: *NetReader) {
    id = get_u32(r)
    host_time = get_f32(r)
    values = calloc(7, 8)
    v = values as float[]
    k = 0
    while k < 7 {
        v[k] = get_f32(r)
        k = k + 1
    }
    no = object_by_id(n, id)
    if r.ok && no != null && no.kind > 0 && !no.leaving {
        h = no.history as float[]
        while no.count > 0 && h[no.newest * SAMPLE] >= host_time {
            no.newest = (no.newest - 1 + HISTORY) % HISTORY
            no.count = no.count - 1
        }
        add_sample(no, host_time, v, 0)
        no.leaving = true
        no.leaves = host_time
    }
    free(values)
}

// The leaving objects whose moment this side's view has reached, let go.
let_go(n: *Net, now: float) {
    at = view_time(n, now)
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && no.leaving && (at >= no.leaves || !n.offset_known) { forget(n, no) }
        i = i + 1
    }
}

// A created object let go: its kind's unmaker called (which can still
// ask its id), its fields with it, and its id left empty for good.
forget(n: *Net, no: *NetObject) {
    k = list.get_raw(n.kinds, no.kind - 1) as *NetKind
    unmaker = k.unmaker
    if unmaker != null { unmaker(k.context, no.object) }
    drop_fields(n, no.id)
    list.set(n.objects, no.id - 1, null)
    net_object_free(no)
}

// --- what it costs --------------------------------------------------------------------------------

bytes_sent(n: *Net) -> long {
    if n.udp != null { return netudp.bytes_sent(n.udp) }
    return n.sent
}

bytes_received(n: *Net) -> long {
    if n.udp != null { return netudp.bytes_received(n.udp) }
    return n.got
}

snapshots_received(n: *Net) -> int { return n.snapshots }

// Client: snapshots that arrived after a newer one and were dropped.
stale_snapshots(n: *Net) -> int { return n.stale }

// This side's traffic of one kind (TRAFFIC_*), bytes sent: the messages
// by what they are, on every transport, and what UDP adds around them.
traffic(n: *Net, kind: int) -> long {
    if kind >= TRAFFIC_SNAPSHOTS && kind <= TRAFFIC_ACKS { return (n.traffic as long[])[kind] }
    if n.udp == null {
        if kind == TRAFFIC_HEADERS { return (n.traffic as long[])[kind] }
        return 0 as long
    }
    if kind == TRAFFIC_HEADERS { return netudp.header_bytes(n.udp) }
    if kind == TRAFFIC_ACK_PACKETS { return netudp.ack_bytes(n.udp) }
    if kind == TRAFFIC_RESENT { return netudp.resent_bytes(n.udp) }
    if kind == TRAFFIC_HANDSHAKE { return netudp.handshake_bytes(n.udp) }
    return 0 as long
}

// UDP: datagrams sent, the largest of them, and the round trip to the
// host (a client) or to client `client` (the host), seconds.
datagrams_sent(n: *Net) -> long {
    if n.udp == null { return 0 as long }
    return netudp.datagrams_sent(n.udp)
}

largest_datagram(n: *Net) -> int {
    if n.udp == null { return 0 }
    return netudp.largest(n.udp)
}

round_trip(n: *Net, client: int) -> float {
    us = round_trip_us(n, client)
    if us < 0 { return 0.0 }
    return (us as float) / 1000000.0
}

// The peer a link's figures are about: a host's client `client`, or a
// client's host whatever `client` says.
link_peer(n: *Net, client: int) -> *Peer {
    if n == null { return null }
    if n.role == ROLE_CLIENT { return peer_by_id(n, 0) }
    return peer_by_id(n, client)
}

// The link's smoothed round trip to a peer, microseconds, from its pings
// (every transport alike); -1 before one is answered.
round_trip_us(n: *Net, client: int) -> int {
    p = link_peer(n, client)
    if p == null || !p.rtt_known { return 0 - 1 }
    return p.srtt_us
}

// Its jitter: the round trip's smoothed variance (RFC 6298's), seconds
// and microseconds.
jitter(n: *Net, client: int) -> float {
    us = jitter_us(n, client)
    if us < 0 { return 0.0 }
    return (us as float) / 1000000.0
}

jitter_us(n: *Net, client: int) -> int {
    p = link_peer(n, client)
    if p == null || !p.rtt_known { return 0 - 1 }
    return p.rttvar_us
}

// The share of the last LOSS_PINGS pings judged that were lost (0..1),
// and the same in parts per million.
loss(n: *Net, client: int) -> float {
    ppm = loss_ppm(n, client)
    if ppm < 0 { return 0.0 }
    return (ppm as float) / 1000000.0
}

loss_ppm(n: *Net, client: int) -> int {
    p = link_peer(n, client)
    if p == null || p.outcome_count == 0 { return 0 - 1 }
    lost = 0
    ring = p.outcomes as int[]
    k = 0
    while k < p.outcome_count {
        lost = lost + ring[k]
        k = k + 1
    }
    return ((lost as long) * (1000000 as long) / (p.outcome_count as long)) as int
}

// The pings to a peer: 1 sent, 2 answered, 3 lost.
pings(n: *Net, client: int, what: int) -> int {
    p = link_peer(n, client)
    if p == null { return 0 }
    if what == 1 { return p.pings_sent }
    if what == 2 { return p.pings_answered }
    if what == 3 { return p.pings_lost }
    return 0
}

// A peer's traffic of one kind (TRAFFIC_*, or TRAFFIC_ALL for every kind
// it is counted in), SENT to it or RECEIVED from it, whole bytes a second
// over the last window of a second; 0 before a window has ended.
rate(n: *Net, client: int, direction: int, kind: int) -> long {
    p = link_peer(n, client)
    if p == null || kind < 0 || kind >= LINK_KINDS { return 0 as long }
    if direction == SENT { return (p.rate_sent as long[])[kind] }
    return (p.rate_recv as long[])[kind]
}

// The same, every byte since the link began.
link_bytes(n: *Net, client: int, direction: int, kind: int) -> long {
    p = link_peer(n, client)
    if p == null || kind < 0 || kind >= LINK_KINDS { return 0 as long }
    counts = p.recv_bytes as long[]
    if direction == SENT { counts = p.sent_bytes as long[] }
    if kind != TRAFFIC_ALL { return counts[kind] }
    all = 0 as long
    k = 1
    while k < LINK_KINDS {
        if counted_kind(k) { all = all + counts[k] }
        k = k + 1
    }
    return all
}

// The last window's length, microseconds: what the rates are over.
window_us(n: *Net, client: int) -> long {
    p = link_peer(n, client)
    if p == null { return 0 as long }
    return p.window_us
}

// Host: the bytes a snapshot to client `client` may take: its own budget,
// or the session's; 0 for no limit.
budget_of(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    if p.budget > 0 { return p.budget }
    return n.budget
}

// Host: the most ticks any object waited for client `client`, changed and
// relevant but past its budget.
worst_wait_any(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    return p.worst_any
}

// Host: the most ticks in a row an object waited for client `client`
// while it had one sight (SIGHT_SEEN, _OUT, _HIDDEN; _NONE before a view).
worst_wait_sight(n: *Net, client: int, sight: int) -> int {
    p = peer_by_id(n, client)
    if p == null || sight < 0 || sight > 3 { return 0 }
    return (p.worst_sight as int[])[sight]
}

// Host: the record bytes client `client` was sent of objects it could see
// when they went, and of ones it could not; and the rays cast for it.
view_bytes(n: *Net, client: int) -> long {
    p = peer_by_id(n, client)
    if p == null { return 0 as long }
    return p.view_bytes
}

hidden_bytes(n: *Net, client: int) -> long {
    p = peer_by_id(n, client)
    if p == null { return 0 as long }
    return p.hidden_bytes
}

rays_cast(n: *Net, client: int) -> long {
    p = peer_by_id(n, client)
    if p == null { return 0 as long }
    return p.rays
}

// Host: the tick object `id` was last sent to client `client`; 0 never.
last_sent(n: *Net, client: int, id: int) -> int {
    p = peer_by_id(n, client)
    if p == null || id < 1 || id > p.capacity || p.marked == null { return 0 }
    return (p.marked as int[])[id - 1]
}

// Client: what the newest reconciliation moved its player, metres.
last_correction(n: *Net) -> float { return n.last_correction }

// Client: a correction in whole micrometres, the channel's unit: the last
// (worst false) or the worst.
correction_um(n: *Net, worst: bool) -> long {
    metres = n.last_correction
    if worst { metres = n.worst_correction }
    return floor(metres * 1000000.0 + 0.5) as long
}

// The link's simulated conditions: a UDP session's on what it sends, a
// loopback session's on its hub (every session on it). False for TCP,
// which has none.
set_link(n: *Net, latency: float, jitter_s: float, loss_share: float) -> bool {
    if n == null || latency < 0.0 || jitter_s < 0.0 || loss_share < 0.0 || loss_share > 1.0 { return false }
    if n.udp != null {
        netudp.set_conditions(n.udp, latency, jitter_s, loss_share)
        return true
    }
    if n.hub != null {
        hub_set_conditions(n.hub, latency, jitter_s, loss_share)
        return true
    }
    error_borrowed("TCP has no simulated link")
    return false
}

link_latency(n: *Net) -> float {
    if n.udp != null { return netudp.conditions_latency(n.udp) }
    if n.hub != null { return n.hub.latency }
    return 0.0
}

link_jitter(n: *Net) -> float {
    if n.udp != null { return netudp.conditions_jitter(n.udp) }
    if n.hub != null { return n.hub.jitter }
    return 0.0
}

link_loss(n: *Net) -> float {
    if n.udp != null { return netudp.conditions_loss(n.udp) }
    if n.hub != null { return n.hub.loss }
    return 0.0
}

transport_name(n: *Net) -> string {
    if n.kind == KIND_UDP { return "udp" }
    if n.kind == KIND_TCP { return "tcp" }
    return "loopback"
}

// Every session made and not yet freed, in the order they were made.
session_count() -> int {
    if g_sessions == null { return 0 }
    return list.size(g_sessions)
}

session_at(index: int) -> *Net {
    if g_sessions == null || index < 0 || index >= list.size(g_sessions) { return null }
    return list.get_raw(g_sessions, index) as *Net
}

session_index(n: *Net) -> int {
    k = 0
    while k < session_count() {
        if session_at(k) == n { return k }
        k = k + 1
    }
    return 0 - 1
}

// --- on the agent channel (#488) -------------------------------------------------------------------
//
// net.stats answers with every session in the program and every figure
// above, each a whole number in the unit its name says (microseconds,
// parts per million, bytes, bytes a second, ticks, micrometres): the
// numbers ae3d.net measures, to the unit. net.set_link sets the link's
// simulated conditions as the editor's play sliders do.

answer_op(context: ptr, op: string, request: ptr) -> ptr {
    only = 0 - 1
    node = json.object_get_raw(request, "session")
    if node != null {
        only = json.get_int(node)
        if session_at(only) == null { return json_text("no session ${only}: there are ${session_count()}") }
    }
    if op == "net.stats" {
        out = json.obj()
        sessions = json.arr()
        k = 0
        while k < session_count() {
            if only < 0 || only == k { json.array_add_raw(sessions, session_json(session_at(k), k)) }
            k = k + 1
        }
        json.object_set_raw(out, "sessions", sessions)
        return out
    }
    if op == "net.set_link" {
        latency = number_arg(request, "latency")
        jitter_s = number_arg(request, "jitter")
        loss_share = number_arg(request, "loss")
        if latency < 0.0 || jitter_s < 0.0 || loss_share < 0.0 || loss_share > 1.0 {
            return json.str("net.set_link wants latency and jitter in seconds, and loss between 0 and 1")
        }
        out = json.obj()
        sessions = json.arr()
        changed = 0
        k = 0
        while k < session_count() {
            n = session_at(k)
            if (only < 0 || only == k) && n.kind != KIND_TCP {
                set_link(n, latency, jitter_s, loss_share)
                entry = json.obj()
                json.object_set_raw(entry, "session", json.from_int(k as long))
                json.object_set_raw(entry, "link", link_json(n))
                json.array_add_raw(sessions, entry)
                changed = changed + 1
            }
            k = k + 1
        }
        if changed == 0 {
            json.free(out)
            json.free(sessions)
            return json.str("no session with a simulated link (TCP has none)")
        }
        json.object_set_raw(out, "sessions", sessions)
        return out
    }
    return json_text("unknown op ${op}; net.stats and net.set_link are ae3d.net's")
}

// A number argument, or -1 when it is not there.
number_arg(request: ptr, name: string) -> float {
    node = json.object_get_raw(request, name)
    if node == null { return 0.0 - 1.0 }
    return json.get_number(node)
}

json_whole(x: long) -> ptr { return json.from_int(x) }

// A text made for an answer (an interpolation) as a JSON string, which
// copies it: the text freed.
json_text(text: string) -> ptr {
    node = json.str(text)
    string.free(text)
    return node
}

micros(seconds: float) -> long { return floor(seconds * 1000000.0 + 0.5) as long }

link_json(n: *Net) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "latency_us", json_whole(micros(link_latency(n))))
    json.object_set_raw(out, "jitter_us", json_whole(micros(link_jitter(n))))
    json.object_set_raw(out, "loss_ppm", json_whole(micros(link_loss(n))))
    return out
}

session_json(n: *Net, index: int) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "session", json_whole(index as long))
    role = "client"
    if n.role == ROLE_HOST { role = "host" }
    json.object_set_raw(out, "role", json.str(role))
    json.object_set_raw(out, "transport", json.str(transport_name(n)))
    json.object_set_raw(out, "client_id", json_whole(n.my_id as long))
    json.object_set_raw(out, "connected", json.boolean(connected(n)))
    tick = n.newest_tick
    if n.role == ROLE_HOST { tick = n.tick }
    json.object_set_raw(out, "tick", json_whole(tick as long))
    json.object_set_raw(out, "objects", json_whole(networked_count(n) as long))
    json.object_set_raw(out, "players", json_whole(player_count(n) as long))
    json.object_set_raw(out, "fields", json_whole(list.size(n.replicated) as long))
    if n.kind != KIND_TCP { json.object_set_raw(out, "link", link_json(n)) }
    if n.role == ROLE_CLIENT {
        json.object_set_raw(out, "snapshots_received", json_whole(n.snapshots as long))
        json.object_set_raw(out, "stale_snapshots", json_whole(n.stale as long))
        json.object_set_raw(out, "commands_asked", json_whole(n.asked as long))
        prediction = json.obj()
        json.object_set_raw(prediction, "last_um", json_whole(correction_um(n, false)))
        json.object_set_raw(prediction, "worst_um", json_whole(correction_um(n, true)))
        json.object_set_raw(out, "prediction", prediction)
    }
    peers = json.arr()
    i = 0
    while i < list.size(n.peers) {
        p = list.get_raw(n.peers, i) as *Peer
        if n.role == ROLE_CLIENT || p.welcomed { json.array_add_raw(peers, peer_json(n, p)) }
        i = i + 1
    }
    json.object_set_raw(out, "peers", peers)
    return out
}

// A peer's traffic by kind, a rate or a total.
kinds_json(n: *Net, client: int, direction: int, rates: bool) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "snapshots", json_whole(traffic_figure(n, client, direction, TRAFFIC_SNAPSHOTS, rates)))
    json.object_set_raw(out, "events", json_whole(traffic_figure(n, client, direction, TRAFFIC_EVENTS, rates)))
    json.object_set_raw(out, "inputs", json_whole(traffic_figure(n, client, direction, TRAFFIC_INPUTS, rates)))
    json.object_set_raw(out, "acks", json_whole(traffic_figure(n, client, direction, TRAFFIC_ACKS, rates)))
    json.object_set_raw(out, "link", json_whole(traffic_figure(n, client, direction, TRAFFIC_LINK, rates)))
    json.object_set_raw(out, "headers", json_whole(traffic_figure(n, client, direction, TRAFFIC_HEADERS, rates)))
    json.object_set_raw(out, "resent", json_whole(traffic_figure(n, client, direction, TRAFFIC_RESENT, rates)))
    json.object_set_raw(out, "all", json_whole(traffic_figure(n, client, direction, TRAFFIC_ALL, rates)))
    return out
}

traffic_figure(n: *Net, client: int, direction: int, kind: int, rates: bool) -> long {
    if rates { return rate(n, client, direction, kind) }
    return link_bytes(n, client, direction, kind)
}

peer_json(n: *Net, p: *Peer) -> ptr {
    sync_transport(n, p)
    client = p.id
    out = json.obj()
    json.object_set_raw(out, "peer", json_whole(p.id as long))
    json.object_set_raw(out, "open", json.boolean(p.open))
    json.object_set_raw(out, "round_trip_us", json_whole(round_trip_us(n, client) as long))
    json.object_set_raw(out, "jitter_us", json_whole(jitter_us(n, client) as long))
    json.object_set_raw(out, "loss_ppm", json_whole(loss_ppm(n, client) as long))
    pinged = json.obj()
    json.object_set_raw(pinged, "sent", json_whole(pings(n, client, 1) as long))
    json.object_set_raw(pinged, "answered", json_whole(pings(n, client, 2) as long))
    json.object_set_raw(pinged, "lost", json_whole(pings(n, client, 3) as long))
    json.object_set_raw(out, "pings", pinged)
    json.object_set_raw(out, "window_us", json_whole(window_us(n, client)))
    json.object_set_raw(out, "sent", kinds_json(n, client, SENT, true))
    json.object_set_raw(out, "received", kinds_json(n, client, RECEIVED, true))
    json.object_set_raw(out, "sent_bytes", kinds_json(n, client, SENT, false))
    json.object_set_raw(out, "received_bytes", kinds_json(n, client, RECEIVED, false))
    if n.role == ROLE_HOST {
        json.object_set_raw(out, "budget", json_whole(budget_of(n, client) as long))
        json.object_set_raw(out, "largest_snapshot", json_whole(p.largest as long))
        json.object_set_raw(out, "snapshots", json_whole(p.snapshots as long))
        json.object_set_raw(out, "whole_snapshots", json_whole(p.wholes as long))
        json.object_set_raw(out, "delta_snapshots", json_whole((p.snapshots - p.wholes) as long))
        json.object_set_raw(out, "worst_wait", json_whole(p.worst_any as long))
        json.object_set_raw(out, "view", json.boolean(p.view_known))
        waited = json.obj()
        json.object_set_raw(waited, "seen", json_whole(worst_wait_sight(n, client, SIGHT_SEEN) as long))
        json.object_set_raw(waited, "out", json_whole(worst_wait_sight(n, client, SIGHT_OUT) as long))
        json.object_set_raw(waited, "hidden", json_whole(worst_wait_sight(n, client, SIGHT_HIDDEN) as long))
        json.object_set_raw(out, "worst_wait_by_sight", waited)
        json.object_set_raw(out, "view_bytes", json_whole(p.view_bytes))
        json.object_set_raw(out, "hidden_bytes", json_whole(p.hidden_bytes))
        json.object_set_raw(out, "rays", json_whole(p.rays))
    }
    return out
}

// When a link last heard from the other side, in the time `step` is given,
// seconds: a client's from its host, a host's from client `client`; -1
// where there is no such link, or it is not UDP (TCP has no timeout of
// its own). What the UDP timeout counts from.
last_heard(n: *Net, client: int) -> float {
    if n.udp == null { return 0.0 - 1.0 }
    p = peer_by_id(n, client)
    if n.role == ROLE_CLIENT { p = peer_by_id(n, 0) }
    if p == null { return 0.0 - 1.0 }
    return netudp.heard(n.udp, p.conn)
}

// Host: the most ticks object `id` ever waited, changed and relevant but
// past client `client`'s budget, before it was sent.
worst_wait(n: *Net, client: int, id: int) -> int {
    p = peer_by_id(n, client)
    if p == null || id < 1 || id > p.capacity { return 0 }
    return (p.worst as int[])[id - 1]
}

// Host: the largest snapshot client `client` was sent, bytes; all it was
// sent; how many.
largest_snapshot(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    return p.largest
}

snapshot_bytes(n: *Net, client: int) -> long {
    p = peer_by_id(n, client)
    if p == null { return 0 as long }
    return p.snapshot_bytes
}

snapshots_sent(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    return p.snapshots
}

// Host: the snapshots client `client` was sent whole, against no base: its
// first, and any after it held nothing the host still kept (the last 32).
whole_snapshots(n: *Net, client: int) -> int {
    p = peer_by_id(n, client)
    if p == null { return 0 }
    return p.wholes
}

// The host's tick; a client's newest snapshot's.
host_tick(n: *Net) -> int { return n.tick }
snapshot_tick(n: *Net) -> int { return n.newest_tick }

// Whether object `id`'s state is known: on a client, whether its newest
// snapshot has it (it has been told it); on the host, whether it was
// networked at the last tick.
known(n: *Net, id: int) -> bool {
    shot = newest_states(n)
    if shot == null || id < 1 || id > shot.count { return false }
    return (shot.known as int[])[id - 1] == 1
}

// Whether object `id`'s replicated fields are known: on a client, whether
// its newest snapshot has them (a player told of before any snapshot
// carried it holds what its maker gave it); on the host, whether the last
// tick took them.
fields_known(n: *Net, id: int) -> bool {
    shot = newest_states(n)
    if shot == null || id < 1 || id > shot.count { return false }
    return (shot.fknown as int[])[id - 1] == 1
}

// On a client, the tick of the snapshot that brought object `id`'s fields
// as its newest snapshot holds them: the host's at that tick, since a
// record left out is one whose fields had not changed. 0 when none are
// known, and on the host.
fields_tick(n: *Net, id: int) -> int {
    if n.role == ROLE_HOST || !fields_known(n, id) { return 0 }
    shot = newest_states(n)
    return (shot.fticks as int[])[id - 1]
}

// Object `id`'s state as the wire carries it, quantised, into `out` (7
// floats: x y z, qx qy qz qw): on a client, its newest snapshot's; on the
// host, its state at the last tick. False when it is not known.
state_at(n: *Net, id: int, out: ptr) -> bool {
    if !known(n, id) { return false }
    state_values(n, newest_states(n), id - 1, out as float[], 0)
    return true
}

newest_states(n: *Net) -> *Snapshot {
    if n.role == ROLE_HOST {
        if n.previous.used { return n.previous }
        return null
    }
    return ring_find(n.received, n.newest_tick)
}

// --- in the engine ---------------------------------------------------------------------------

net_update(state: ptr, e: *Engine, delta: float) {
    step(state as *Net, platform.time())
}

// The session stepped by the engine every frame, on the engine's clock.
attach(e: *Engine, n: *Net) {
    b = engine.behaviour_new("net", n as ptr)
    b.update = net_update
    engine.engine_add_behaviour(e, b)
}

net_free(n: *Net) {
    if n == null { return }
    clear_events(n)
    list.free(n.events)
    // A UDP session says it is going, to every connection, before its
    // socket closes.
    if n.udp != null {
        netudp.close(n.udp, n.last_step)
        netudp.endpoint_free(n.udp)
    }
    i = 0
    while i < list.size(n.peers) {
        peer_free(list.get_raw(n.peers, i) as *Peer)
        i = i + 1
    }
    list.free(n.peers)
    // The objects the session created it lets go, by their kinds' unmakers;
    // the scene's and the players' are the game's.
    i = 0
    while i < list.size(n.objects) {
        no = list.get_raw(n.objects, i) as *NetObject
        if no != null && no.kind > 0 {
            forget(n, no)
        } else if no != null {
            net_object_free(no)
        }
        i = i + 1
    }
    list.free(n.objects)
    i = 0
    while i < list.size(n.replicated) {
        field_free(list.get_raw(n.replicated, i) as *NetField)
        i = i + 1
    }
    list.free(n.replicated)
    i = 0
    while i < list.size(n.layouts) {
        lay = list.get_raw(n.layouts, i) as *NetLayout
        if lay != null { layout_free(lay) }
        i = i + 1
    }
    list.free(n.layouts)
    i = 0
    while i < list.size(n.spare_words) {
        free(list.get_raw(n.spare_words, i))
        i = i + 1
    }
    list.free(n.spare_words)
    i = 0
    while i < list.size(n.gone) {
        gone_free(list.get_raw(n.gone, i) as *NetGone)
        i = i + 1
    }
    list.free(n.gone)
    i = 0
    while i < list.size(g_sessions) {
        if list.get_raw(g_sessions, i) == n as ptr {
            list.remove(g_sessions, i)
            break
        }
        i = i + 1
    }
    i = 0
    while i < list.size(n.handlers) {
        heap.free(list.get_raw(n.handlers, i) as *NetHandler)
        i = i + 1
    }
    list.free(n.handlers)
    i = 0
    while i < list.size(n.kinds) {
        heap.free(list.get_raw(n.kinds, i) as *NetKind)
        i = i + 1
    }
    list.free(n.kinds)
    i = 0
    while i < list.size(n.joins) {
        heap.free(list.get_raw(n.joins, i) as *NetJoinHook)
        i = i + 1
    }
    list.free(n.joins)
    i = 0
    while i < list.size(n.leaves) {
        heap.free(list.get_raw(n.leaves, i) as *NetJoinHook)
        i = i + 1
    }
    list.free(n.leaves)
    i = 0
    while i < list.size(n.takes) {
        heap.free(list.get_raw(n.takes, i) as *NetJoinHook)
        i = i + 1
    }
    list.free(n.takes)
    i = 0
    while i < list.size(n.players) {
        free(list.get_raw(n.players, i))
        i = i + 1
    }
    list.free(n.players)
    free(n.commands)
    ring_free(n.received)
    snapshot_free(n.current)
    snapshot_free(n.previous)
    if n.candidates != null { free(n.candidates) }
    if n.records != null { free(n.records) }
    if n.fields != null { free(n.fields) }
    if n.urgency != null { free(n.urgency) }
    free(n.traffic)
    free(n.scratch)
    if n.server != null { tcp.tcp_server_close(n.server) }
    if n.kind == KIND_LOOP && n.role == ROLE_HOST && n.hub != null { n.hub.host_open = false }
    buf_free(n.out)
    buf_free(n.measured)
    free(n as ptr)
    g_alive = g_alive - 1
}
