// An environment map from a file (#869): Radiance .hdr (RGBE) or OpenEXR,
// told apart by what the bytes are rather than by the name, decoded to a
// float image (ae3d.hdrimage).
//
//   img = envimage.load("studio.hdr")        // null on failure: envimage.error()
//   img = envimage.from_memory(bytes, size)
//   envimage.dispose(img)                    // hdrimage.dispose
//
// Both formats are read as the equirectangular (latitude-longitude) map they
// hold: the width twice the height, the top row the zenith, the left and
// right edges the same meridian. A map that is not twice as wide as it is
// tall (a cube cross, a mirror ball, a crop) is not an equirectangular map and
// would light a scene wrongly, so it is refused, by either format's decoder,
// with an error that names its size (Nic 875-8).
import std.string
import ae3d.blob
import ae3d.core
import ae3d.hdrimage
import ae3d.radiance
import ae3d.openexr
import std.mem

exports (load, from_memory, decode_any, dispose, error, half_rows, float_rows, lod_for_width)

error() -> string { return hdrimage.error() }
dispose(img: ptr) { hdrimage.dispose(img) }

from_memory(data: @keep ptr, length: int) -> ptr {
    return two_to_one(decode_any(data, length))
}

// The same without the shape check: whatever picture the bytes are, of any
// proportions. For the decoders' own tests, which read pictures of 8 by 20;
// an environment map comes in by `from_memory` or `load`.
decode_any(data: @keep ptr, length: int) -> ptr {
    if data == null || length <= 0 {
        hdrimage.set_error("empty environment map")
        return null
    }
    if openexr.is_openexr(data, length) { return openexr.decode(data, length) }
    if radiance.is_radiance(data, length) { return radiance.decode(data, length) }
    hdrimage.set_error("not a Radiance .hdr or an OpenEXR picture")
    return null
}

// `img` when it is as wide as two of its height, else refused (freed, null)
// with the size in the error.
two_to_one(img: @into ptr) -> ptr {
    if img == null { return null }
    w = hdrimage.width(img)
    h = hdrimage.height(img)
    if w == 2 * h { return img }
    hdrimage.dispose(img)
    hdrimage.set_error("the environment map is ${w} x ${h}: an equirectangular map is twice as wide as it is tall (2:1)")
    return null
}

load(path: string) -> ptr {
    if path == "" {
        hdrimage.set_error("empty path")
        return null
    }
    data = blob.read(path)
    size = blob.last_size()
    if data == null {
        hdrimage.set_error(string.concat("cannot read ", path))
        return null
    }
    if size > (2147483647 as long) {
        blob.free_bytes(data)
        hdrimage.set_error("the file is too large")
        return null
    }
    img = from_memory(data, size as int)
    blob.free_bytes(data)
    return img
}

extern calloc(count: long, size: long) -> ptr
extern log2(x: float) -> float

// The image as the renderers upload an equirectangular texture: RGBA, the
// bottom row first (as every other image the engine uploads, so a map sits in
// the world the way a painted sky does), as binary16 (`half_rows`, 8 bytes a
// texel) or binary32 (`float_rows`, 16). Light below zero is cut to zero and
// above the half's largest (65504) held there. The caller frees the result.
half_rows(img: ptr) -> ptr {
    w = hdrimage.width(img)
    h = hdrimage.height(img)
    out = calloc((w as long) * (h as long) * (4 as long), 2 as long)
    if out == null { return null }
    src = hdrimage.pixels(img) as f32[]
    dst = out as uint16[]
    row = 0
    while row < h {
        from = (h - 1 - row) * w * 4
        to = row * w * 4
        i = 0
        while i < w * 4 {
            v = src[from + i] as float
            if v != v { v = 0.0 }
            if v < 0.0 { v = 0.0 }
            dst[to + i] = core.half_bits(v) as uint16
            i = i + 1
        }
        row = row + 1
    }
    return out
}

float_rows(img: ptr) -> ptr {
    w = hdrimage.width(img)
    h = hdrimage.height(img)
    out = calloc((w as long) * (h as long) * (4 as long), 4 as long)
    if out == null { return null }
    src = hdrimage.pixels(img) as f32[]
    dst = out as f32[]
    row = 0
    while row < h {
        from = (h - 1 - row) * w * 4
        to = row * w * 4
        i = 0
        while i < w * 4 {
            v = src[from + i] as float
            if v != v { v = 0.0 }
            if v < 0.0 { v = 0.0 }
            if v > 65504.0 { v = 65504.0 }
            dst[to + i] = v as f32
            i = i + 1
        }
        row = row + 1
    }
    return out
}

// The mip level of an equirectangular map `width` texels across to read for
// one texel of the 256-texel octahedral capture: the capture's texel covers
// about 4 pi / 254^2 of the sphere, a side of about 1 / 450 of the map's width
// at the equator, so a map wider than that is read from the level where its
// texels are that size (0 for a map no wider).
lod_for_width(width: int) -> float {
    if width <= 450 { return 0.0 }
    return log2((width as float) / 450.0)
}
