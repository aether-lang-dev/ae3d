// The engine's own component kinds: what every game object can carry
// before a game adds any of its own (ae3d.component says what a kind is).
//
//   Transform       where the object is: its model's position, rotation and
//                   scale. Every object has one, as in Unity.
//   Mesh Renderer   whether its model is drawn and casts a shadow.
//   Material        the surface it is drawn with: colour, metal, roughness,
//                   the textures.
//   Light           a light the object carries: its kind, colour, reach and
//                   cone. It stands where the object stands.
//   Camera          a camera the object carries: its lens and how it flies.
//   Water           a water surface: its waves, its colour and how it shows
//                   the sky, the shore and what is under it.
//   Terrain         a terrain: its biome, its seed and whether it is drawn as
//                   blocks or as one smooth surface.
//   Physics Body    the body the object is in the simulation: static,
//                   kinematic, dynamic or a character, its collider and its
//                   surface. No body is no component.
//   Natural Motion  a figure's animation played by its muscles when the
//                   scene is simulated (ae3d.motion): its mode, whether it
//                   protects itself falling, its strength and when it gets
//                   up. No natural motion is no component.
//
// Each is a view over the engine's own structs, never a copy of them: the
// Transform's state is the model, the Material's the model's material, the
// Light's the renderer's light. So a program that moves a model with
// core.model_set_position and the inspector that shows it agree without a
// sync, and what either writes is what is drawn.

import std.string
import std.heap
import ae3d.core
import ae3d.behaviour
import ae3d.component
import ae3d.water
import ae3d.voxel
import ae3d.terrain
import ae3d.scene

exports (
    register, transform_kind, renderer_kind, material_kind, light_kind, camera_kind, water_kind, terrain_kind, physics_kind, natural_kind,
    attach_transform, attach_renderer, attach_material, attach_light, attach_camera, attach_water, attach_terrain, attach_physics, attach_natural,
    attach_builtins, transform_of, light_of, camera_of, water_of, terrain_of, physics_of, natural_of, BODY_KINDS, COLLIDER_KINDS, body_name, collider_name, body_index, collider_index
)

var g_transform: ptr = null
var g_renderer: ptr = null
var g_material: ptr = null
var g_light: ptr = null
var g_camera: ptr = null
var g_water: ptr = null
var g_terrain: ptr = null
var g_physics: ptr = null
var g_natural: ptr = null
var g_wave_height = 0 - 1              // the Water's wave height field, which rebuilds the wave table

transform_kind() -> *ComponentKind {
    register()
    return g_transform as *ComponentKind
}
renderer_kind() -> *ComponentKind {
    register()
    return g_renderer as *ComponentKind
}
material_kind() -> *ComponentKind {
    register()
    return g_material as *ComponentKind
}
light_kind() -> *ComponentKind {
    register()
    return g_light as *ComponentKind
}
camera_kind() -> *ComponentKind {
    register()
    return g_camera as *ComponentKind
}
water_kind() -> *ComponentKind {
    register()
    return g_water as *ComponentKind
}
terrain_kind() -> *ComponentKind {
    register()
    return g_terrain as *ComponentKind
}
physics_kind() -> *ComponentKind {
    register()
    return g_physics as *ComponentKind
}
natural_kind() -> *ComponentKind {
    register()
    return g_natural as *ComponentKind
}

// --- Transform ------------------------------------------------------------

// A model for the kind's defaults: at the origin, unrotated, at unit scale.
transform_default() -> ptr {
    m = core.model_new()
    return m as ptr
}

transform_default_free(p: ptr) { core.model_free(p as *Model) }

// A write to the position, the rotation or the scale is a move: the model's
// matrix and everything parented to it follow.
transform_validate(p: ptr, field: int) { core.model_update_matrix(p as *Model) }

// --- Mesh Renderer ----------------------------------------------------------

renderer_validate(p: ptr, field: int) { core.model_mark_dirty(p as *Model) }

// --- Material -------------------------------------------------------------

material_default() -> ptr { return core.material_new("default") as ptr }
material_default_free(p: ptr) { core.material_free(p as *Material) }

material_texture(p: ptr) -> string { return core.text((p as *Material).texture_path) }
set_material_texture(p: ptr, path: string) { core.material_set_texture_path(p as *Material, path) }
material_normal(p: ptr) -> string { return core.text((p as *Material).normal_path) }
set_material_normal(p: ptr, path: string) { core.material_set_normal_path(p as *Material, path) }

// --- Light ----------------------------------------------------------------

light_default() -> ptr {
    return core.light_point(core.vec3(0.0, 0.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0, 30.0) as ptr
}
light_default_free(p: ptr) { core.light_free(p as *Light) }

light_range(p: ptr) -> float { return core.light_range(p as *Light) }
set_light_range(p: ptr, metres: float) { core.light_set_range(p as *Light, metres) }
// The two angles of a cone move together where they have to: the angle a
// person just set is the one kept, and the other gives way -- an outer
// angle narrowed past the inner takes the inner with it, an inner widened
// past the outer pushes the outer out. Either set alone is always what
// was asked for.
light_inner(p: ptr) -> float { return core.light_inner_degrees(p as *Light) }
set_light_inner(p: ptr, degrees: float) {
    l = p as *Light
    outer = core.light_outer_degrees(l)
    if outer < degrees + 0.01 { outer = degrees + 0.01 }
    core.light_set_cone(l, degrees, outer)
}
light_outer(p: ptr) -> float { return core.light_outer_degrees(p as *Light) }
set_light_outer(p: ptr, degrees: float) {
    l = p as *Light
    inner = core.light_inner_degrees(l)
    if inner > degrees - 0.01 { inner = degrees - 0.01 }
    if inner < 0.0 { inner = 0.0 }
    core.light_set_cone(l, inner, degrees)
}

// A light on an object stands where the object stands, each frame after
// the scripts have moved it; a directional light has no place, only a
// direction, and is left where it is.
light_follow(p: ptr, go: *GameObject, delta: float) {
    l = p as *Light
    if l.mode == core.MODE_DIRECTIONAL || go.model == null { return }
    l.position = behaviour.object_world_position(go)
}

// --- Camera ---------------------------------------------------------------

camera_default() -> ptr {
    return core.camera_new(1280, 720) as ptr
}
camera_default_free(p: ptr) { core.camera_free(p as *Camera) }

// A new lens is a new projection.
camera_validate(p: ptr, field: int) {
    cam = p as *Camera
    core.camera_update_projection(cam)
}

// --- Water ----------------------------------------------------------------

// A surface's settings with none of its geometry, for the kind's defaults.
water_default() -> ptr { return water.simulation_new(1000.0, 6.0) as ptr }
water_default_free(p: ptr) { water.simulation_free(p as *Simulation) }

// A write reaches the surface's uniforms at once; the wave height is the
// wave table the surface is displaced by, built again.
water_validate(p: ptr, field: int) {
    w = p as *Simulation
    if field == g_wave_height {
        water.simulation_set_amplitude(w, w.base_amplitude)
    } else if w.model != null {
        water.simulation_apply(w)
    }
}

water_sky(p: ptr) -> string { return water.simulation_sky_path(p as *Simulation) }
set_water_sky(p: ptr, path: string) { water.simulation_set_sky_texture(p as *Simulation, path) }

// --- Terrain --------------------------------------------------------------

// A world of one voxel with no model, for the kind's defaults: the plains, a
// seed of 0, blocks.
terrain_default() -> ptr { return voxel.world_new(1, 1, 1, 1.0) as ptr }
terrain_default_free(p: ptr) { voxel.world_free(p as *VoxelWorld) }

// Each is the world's or its model's, and each write fills the world again
// and draws it on the model it has (terrain.rebuild): what the terrain is
// is how it was made, and a scene records exactly that.
terrain_biome(p: ptr) -> int { return voxel.world_origin_kind(p as *VoxelWorld) }
terrain_seed(p: ptr) -> int { return (voxel.world_origin_seed(p as *VoxelWorld)) as int }
terrain_style(p: ptr) -> int { return terrain.style_of(voxel.world_model(p as *VoxelWorld)) }

set_terrain_biome(p: ptr, biome: int) {
    w = p as *VoxelWorld
    m = voxel.world_model(w)
    terrain.rebuild(w, m, voxel.world_origin_seed(w), biome, terrain.style_of(m))
}
set_terrain_seed(p: ptr, seed: int) {
    w = p as *VoxelWorld
    m = voxel.world_model(w)
    terrain.rebuild(w, m, seed as long, voxel.world_origin_kind(w), terrain.style_of(m))
}
set_terrain_style(p: ptr, style: int) {
    w = p as *VoxelWorld
    m = voxel.world_model(w)
    terrain.rebuild(w, m, voxel.world_origin_seed(w), voxel.world_origin_kind(w), style)
}

// --- Physics Body -------------------------------------------------------

// The body and the collider as the scene file writes them, by name, in the
// order the inspector offers them.
const BODY_KINDS = 4
const COLLIDER_KINDS = 5

body_name(kind: int) -> string {
    if kind == 0 { return "static" }
    if kind == 1 { return "kinematic" }
    if kind == 3 { return "character" }
    return "dynamic"
}

collider_name(kind: int) -> string {
    if kind == 1 { return "sphere" }
    if kind == 2 { return "capsule" }
    if kind == 3 { return "hull" }
    if kind == 4 { return "mesh" }
    return "box"
}

body_index(spec: *PhysicsSpec) -> int {
    k = 0
    while k < BODY_KINDS {
        if string.equals(spec.body, body_name(k)) == 1 { return k }
        k = k + 1
    }
    return 2
}

collider_index(spec: *PhysicsSpec) -> int {
    k = 0
    while k < COLLIDER_KINDS {
        if string.equals(spec.collider, collider_name(k)) == 1 { return k }
        k = k + 1
    }
    return 0
}

// A prop's body: dynamic, a box of its bounds, a wooden surface, water's
// density.
physics_default() -> ptr { return scene.physics_spec_new("dynamic", "box", 0.6, 0.0, 1.0) as ptr }
physics_default_free(p: ptr) { heap.free(p as *PhysicsSpec) }

physics_body(p: ptr) -> int { return body_index(p as *PhysicsSpec) }
// A character is a capsule, whatever the body before it was.
set_physics_body(p: ptr, kind: int) {
    s = p as *PhysicsSpec
    s.body = core.set_owned(s.body, body_name(kind))
    if kind == 3 { s.collider = core.set_owned(s.collider, "capsule") }
}
physics_collider(p: ptr) -> int { return collider_index(p as *PhysicsSpec) }
set_physics_collider(p: ptr, kind: int) {
    s = p as *PhysicsSpec
    s.collider = core.set_owned(s.collider, collider_name(kind))
}

// A body has weight: a density typed as 0 or below is the least there is.
physics_validate(p: ptr, field: int) {
    s = p as *PhysicsSpec
    if s.density < 0.001 { s.density = 0.001 }
}

// --- Natural Motion -------------------------------------------------------

// The modes by the scene file's names, in the order the inspector offers
// them (ae3d.motion reads the same names).
const NATURAL_MODES = 3

natural_mode_name(which: int) -> string {
    if which == 1 { return "powered" }
    if which == 2 { return "limp" }
    return "animated"
}

// A figure standing on its own muscles, protecting itself, up three seconds
// after it falls.
natural_default() -> ptr { return scene.motion_spec_new("powered", 1.0, true, 3.0) as ptr }
natural_default_free(p: ptr) { heap.free(p as *MotionSpec) }

natural_mode(p: ptr) -> int {
    spec = p as *MotionSpec
    k = 0
    while k < NATURAL_MODES {
        if string.equals(spec.mode, natural_mode_name(k)) == 1 { return k }
        k = k + 1
    }
    return 0
}
set_natural_mode(p: ptr, which: int) {
    spec = p as *MotionSpec
    spec.mode = core.set_owned(spec.mode, natural_mode_name(which))
}

// Every kind here, once. Safe to call from every start: a kind of the same
// name is answered rather than made again.
register() {
    if g_transform != null { return }

    t = component.kind("Transform", "Transform", transform_default, transform_default_free)
    component.vec3_field(t, "position", offsetof(Model, position))
    component.rotation_field(t, "rotation", offsetof(Model, rotation))
    component.vec3_field(t, "scale", offsetof(Model, scale))
    component.set_step(t, "position", 0.1)
    component.set_step(t, "scale", 0.01)
    component.set_validate(t, transform_validate)
    component.set_unique(t, true)
    g_transform = t as ptr

    r = component.kind("Mesh Renderer", "Rendering", transform_default, transform_default_free)
    component.bool_field(r, "visible", offsetof(Model, visible))
    component.bool_field(r, "casts shadow", offsetof(Model, casts_shadow))
    component.set_validate(r, renderer_validate)
    component.set_unique(r, true)
    g_renderer = r as ptr

    m = component.kind("Material", "Rendering", material_default, material_default_free)
    component.color_field(m, "color", offsetof(Material, diffuse))
    component.float_field(m, "metallic", offsetof(Material, metallic), 0.0, 1.0)
    component.float_field(m, "roughness", offsetof(Material, roughness), 0.0, 1.0)
    component.float_field(m, "reflectivity", offsetof(Material, reflectivity), 0.0, 1.0)
    component.float_field(m, "exposure", offsetof(Material, exposure), 0.0, 8.0)
    component.float_field(m, "opacity", offsetof(Material, alpha), 0.0, 1.0)
    component.asset_field(m, "texture", "texture", material_texture, set_material_texture)
    component.asset_field(m, "normal map", "texture", material_normal, set_material_normal)
    component.set_tooltip(m, "opacity", "Below 0.99 the surface is drawn with the translucent ones, after every opaque one.")
    component.set_unique(m, true)
    g_material = m as ptr

    l = component.kind("Light", "Rendering", light_default, light_default_free)
    kind_field = component.enum_field(l, "type", offsetof(Light, mode))
    // In the order of core's MODE_POINT, MODE_DIRECTIONAL and MODE_SPOT.
    component.enum_choice_add(kind_field, "point")
    component.enum_choice_add(kind_field, "directional")
    component.enum_choice_add(kind_field, "spot")
    component.color_field(l, "color", offsetof(Light, color))
    component.float_field(l, "intensity", offsetof(Light, intensity), 0.0, 100.0)
    component.float_field(l, "temperature", offsetof(Light, temperature), 0.0, 12000.0)
    component.float_property(l, "range", light_range, set_light_range, 0.0, 1000.0)
    component.vec3_field(l, "direction", offsetof(Light, direction))
    component.float_property(l, "inner angle", light_inner, set_light_inner, 0.0, 89.0)
    component.float_property(l, "outer angle", light_outer, set_light_outer, 0.0, 90.0)
    component.set_tooltip(l, "temperature", "Kelvin; 0 leaves the colour as it is.")
    component.set_tooltip(l, "range", "How far a point or spot light reaches; 0 never fades.")
    component.phases(l, null, null, null, light_follow)
    component.set_unique(l, true)
    g_light = l as ptr

    c = component.kind("Camera", "Rendering", camera_default, camera_default_free)
    component.float_field(c, "field of view", offsetof(Camera, fov), 10.0, 120.0)
    component.float_field(c, "near", offsetof(Camera, near), 0.01, 100.0)
    component.float_field(c, "far", offsetof(Camera, far), 1.0, 100000.0)
    component.float_field(c, "speed", offsetof(Camera, speed), 0.0, 1000.0)
    component.float_field(c, "sensitivity", offsetof(Camera, sensitivity), 0.0, 5.0)
    component.bool_field(c, "invert mouse", offsetof(Camera, invert_mouse))
    component.set_validate(c, camera_validate)
    component.set_unique(c, true)
    g_camera = c as ptr

    w = component.kind("Water", "Rendering", water_default, water_default_free)
    component.float_field(w, "wave height", offsetof(Simulation, base_amplitude), 0.0, 24.0)
    component.float_field(w, "wave speed", offsetof(Simulation, wave_speed_multiplier), 0.0, 4.0)
    component.float_field(w, "wave scale", offsetof(Simulation, wave_scale), 1.0, 600.0)
    component.float_field(w, "randomness", offsetof(Simulation, wave_randomness), 0.0, 1.0)
    // Three floats one after another, as a colour's three are.
    component.color_field(w, "color", offsetof(Simulation, color_r))
    component.float_field(w, "opacity", offsetof(Simulation, opacity), 0.0, 1.0)
    component.bool_field(w, "foam", offsetof(Simulation, foam_enabled))
    component.float_field(w, "foam intensity", offsetof(Simulation, foam_intensity), 0.0, 4.0)
    component.float_field(w, "shore fade", offsetof(Simulation, depth_fade), 0.0, 40.0)
    component.float_field(w, "shore foam", offsetof(Simulation, shore_foam), 0.0, 15.0)
    component.float_field(w, "reflection", offsetof(Simulation, reflection_intensity), 0.0, 2.0)
    component.color_field(w, "sky color", offsetof(Simulation, sky_r))
    component.asset_field(w, "sky", "sky", water_sky, set_water_sky)
    component.bool_field(w, "caustics", offsetof(Simulation, caustics_enabled))
    component.float_field(w, "caustics intensity", offsetof(Simulation, caustics_intensity), 0.0, 2.0)
    component.float_field(w, "caustics scale", offsetof(Simulation, caustics_scale), 0.0, 0.02)
    component.float_field(w, "shadow", offsetof(Simulation, shadow_strength), 0.0, 1.0)
    component.float_field(w, "distortion", offsetof(Simulation, distortion_strength), 0.0, 1.0)
    component.float_field(w, "normal strength", offsetof(Simulation, normal_strength), 0.0, 4.0)
    component.set_tooltip(w, "wave scale", "How much shorter the waves are than the ocean's own: 1 is swells kilometres long, a few hundred is a shore's.")
    component.set_tooltip(w, "shore fade", "Metres of water that hide the bottom; 0 is one opacity everywhere.")
    component.set_tooltip(w, "shore foam", "Metres from the waterline the shore's foam runs out over.")
    component.set_tooltip(w, "sky", "The skybox the surface reflects; none reflects the computed sky.")
    component.set_validate(w, water_validate)
    component.set_unique(w, true)
    g_wave_height = component.field_index(w, "wave height")
    g_water = w as ptr

    g = component.kind("Terrain", "Rendering", terrain_default, terrain_default_free)
    biome_field = component.enum_property(g, "biome", terrain_biome, set_terrain_biome)
    b = 0
    while b < terrain.BIOME_COUNT {
        component.enum_choice_add(biome_field, terrain.biome_name(b))
        b = b + 1
    }
    component.int_property(g, "seed", terrain_seed, set_terrain_seed, 0, 0)
    style_field = component.enum_property(g, "style", terrain_style, set_terrain_style)
    component.enum_choice_add(style_field, terrain.style_name(terrain.BLOCKS))
    component.enum_choice_add(style_field, terrain.style_name(terrain.SMOOTH))
    component.set_tooltip(g, "seed", "The same seed and biome give the same terrain, anywhere.")
    component.set_tooltip(g, "style", "Blocks draw a cube per visible voxel; smooth draws one surface over them.")
    component.set_unique(g, true)
    g_terrain = g as ptr

    p = component.kind("Physics Body", "Physics", physics_default, physics_default_free)
    body_field = component.enum_property(p, "body", physics_body, set_physics_body)
    k = 0
    while k < BODY_KINDS {
        component.enum_choice_add(body_field, body_name(k))
        k = k + 1
    }
    collider_field = component.enum_property(p, "collider", physics_collider, set_physics_collider)
    k = 0
    while k < COLLIDER_KINDS {
        component.enum_choice_add(collider_field, collider_name(k))
        k = k + 1
    }
    component.float_field(p, "friction", offsetof(PhysicsSpec, friction), 0.0, 2.0)
    component.float_field(p, "bounce", offsetof(PhysicsSpec, restitution), 0.0, 1.0)
    component.float_field(p, "density", offsetof(PhysicsSpec, density), 0.0, 0.0)
    component.set_tooltip(p, "body", "Static never moves; kinematic moves where it is put; dynamic is moved by the simulation; a character walks.")
    component.set_tooltip(p, "collider", "A box, sphere or capsule of the object's bounds, its convex hull, or its mesh itself (static only).")
    component.set_tooltip(p, "density", "Kilograms a cubic metre over a thousand: water is 1.")
    component.set_validate(p, physics_validate)
    component.set_unique(p, true)
    // The scene file writes a body as its attachment's physics.
    component.set_recorded(p, true)
    g_physics = p as ptr

    n = component.kind("Natural Motion", "Animation", natural_default, natural_default_free)
    modes = component.enum_property(n, "mode", natural_mode, set_natural_mode)
    k = 0
    while k < NATURAL_MODES {
        component.enum_choice_add(modes, natural_mode_name(k))
        k = k + 1
    }
    component.bool_field(n, "protective", offsetof(MotionSpec, protective))
    component.float_field(n, "strength", offsetof(MotionSpec, strength), 0.0, 1.0)
    component.float_field(n, "get up after", offsetof(MotionSpec, get_up), 0.0, 10.0)
    component.set_tooltip(n, "mode", "Animated plays the clip as it is; powered plays it with muscles that balance and react; limp is a ragdoll.")
    component.set_tooltip(n, "protective", "Arms out to break a fall.")
    component.set_tooltip(n, "get up after", "Seconds lying before it gets up; 0 never.")
    component.set_unique(n, true)
    // The scene file writes it with the figure.
    component.set_recorded(n, true)
    g_natural = n as ptr
}

// The object's transform: its model, which it makes when it has none (a
// group is placed as much as a mesh is).
attach_transform(o: *GameObject) -> *Component {
    existing = component.find(o, transform_kind())
    if existing != null { return existing }
    return component.attach_state(o, transform_kind(), behaviour.object_transform(o) as ptr, false)
}

attach_renderer(o: *GameObject) -> *Component {
    existing = component.find(o, renderer_kind())
    if existing != null || o.model == null { return existing }
    return component.attach_state(o, renderer_kind(), o.model, false)
}

// The model's material, which it gets if it has none: one the model owns
// (core.model_ensure_material), freed with it like every other it holds.
attach_material(o: *GameObject) -> *Component {
    existing = component.find(o, material_kind())
    if existing != null || o.model == null { return existing }
    m = o.model as *Model
    core.model_ensure_material(m)
    return component.attach_state(o, material_kind(), m.material as ptr, false)
}

// A light the object carries. `owned` hands it to the component, freed with
// the object; a light the renderer or a program keeps is borrowed.
attach_light(o: *GameObject, l: *Light, owned: bool) -> *Component {
    existing = component.find(o, light_kind())
    if existing != null { return existing }
    return component.attach_state(o, light_kind(), l as ptr, owned)
}

attach_camera(o: *GameObject, cam: *Camera, owned: bool) -> *Component {
    existing = component.find(o, camera_kind())
    if existing != null { return existing }
    return component.attach_state(o, camera_kind(), cam as ptr, owned)
}

// What every object starts with: its transform, and for one with a model
// the renderer and the material that draw it.
attach_builtins(o: *GameObject) {
    // Asked before the transform, which gives a model-less object an empty
    // model to be placed by: that one is a group, never drawn, and so is a
    // model with nothing in it.
    drawn = o.model != null && core.mesh_vertex_count((o.model as *Model).mesh) > 0
    attach_transform(o)
    if drawn {
        attach_renderer(o)
        attach_material(o)
    }
}

// A water surface the object is: borrowed, the simulation being the
// object's water component's.
attach_water(o: *GameObject, sim: *Simulation) -> *Component {
    existing = component.find(o, water_kind())
    if existing != null { return existing }
    return component.attach_state(o, water_kind(), sim as ptr, false)
}

// A terrain the object is: borrowed, the world being the object's voxel
// component's.
attach_terrain(o: *GameObject, w: *VoxelWorld) -> *Component {
    existing = component.find(o, terrain_kind())
    if existing != null { return existing }
    return component.attach_state(o, terrain_kind(), w as ptr, false)
}

// The body the object is in the simulation, owned by it from here: freed
// when the component or the object goes.
attach_physics(o: *GameObject, spec: *PhysicsSpec) -> *Component {
    existing = component.find(o, physics_kind())
    if existing != null { component.remove(o, existing) }
    return component.attach_state(o, physics_kind(), spec as ptr, true)
}

transform_of(o: *GameObject) -> *Component { return component.find(o, transform_kind()) }
light_of(o: *GameObject) -> *Light {
    c = component.find(o, light_kind())
    if c == null { return null }
    return c.state as *Light
}
camera_of(o: *GameObject) -> *Camera {
    c = component.find(o, camera_kind())
    if c == null { return null }
    return c.state as *Camera
}
// Natural motion onto `o`, owning `spec` from here, replacing any it had.
attach_natural(o: *GameObject, spec: *MotionSpec) -> *Component {
    existing = component.find(o, natural_kind())
    if existing != null { component.remove(o, existing) }
    return component.attach_state(o, natural_kind(), spec as ptr, true)
}

// The object's natural motion as recorded, or null for none.
natural_of(o: *GameObject) -> *MotionSpec {
    if o == null { return null }
    c = component.find(o, natural_kind())
    if c == null { return null }
    return c.state as *MotionSpec
}

physics_of(o: *GameObject) -> *PhysicsSpec {
    c = component.find(o, physics_kind())
    if c == null { return null }
    return c.state as *PhysicsSpec
}
terrain_of(o: *GameObject) -> *VoxelWorld {
    c = component.find(o, terrain_kind())
    if c == null { return null }
    return c.state as *VoxelWorld
}
water_of(o: *GameObject) -> *Simulation {
    c = component.find(o, water_kind())
    if c == null { return null }
    return c.state as *Simulation
}
