// Animation graphs as data (#903): a figure's takes, states, blend spaces,
// motion matching databases, transitions, layers and aim offsets declared in
// a file and built on its animator, the way Unity's Animator Controller and
// UE5's Animation Blueprint state machines are assets rather than code.
// What a file builds is what the animator's own calls build, call for call;
// the game drives it by the same parameters (animator.set_float, set_bool,
// trigger) and finds its parts by their names here.
//
//     # A runner: a stand, its gaits blended by speed, a jump on a trigger.
//     take idle Idle_Loop                  # the figure's own animation
//     take walk Walk_Loop
//     take sprint Sprint_Loop
//     take jump Jump_Start root            # root: its root motion taken out
//     take sit Sitting_Idle_Loop from people/ual1.glb    # another file's, retargeted
//     capture fw people/fw.bvh root straighten cut_loop
//                                          # a BVH capture (gzip'd or not)
//                                          # retargeted onto the figure
//     mirror fw_m fw                       # a take mirrored left for right
//
//     state idle idle loop                 # a state playing a take
//     state jump jump once
//     blend move speed                     # a blend along parameter speed
//       walk measured                      # at the take's measured speed
//       sprint 5.5                         # or at a value
//     end
//     blend2 strafe vx vz                  # over the ground's two ways
//       fw measured                        # at its velocity over its length
//     end
//     matcher walker                       # motion matching over takes
//       fw
//       fw_m
//     end
//     transition idle move 0.2             # from (or any), to, seconds
//       when speed above 0.1               # above, below, is, is_not,
//     end                                  # triggered; or `when ended`
//     transition any jump 0.1
//       when jump triggered
//       crossfade                          # also: synced, or <state>,
//     end                                  # match <seconds>
//     layer hit hit_head from spine_01 once    # also: additive, loop
//     aim pistol from spine_01             # an aim offset over a chain
//       aim_mid 0 0                        # a take at its yaw, pitch
//     end
//     play idle
//
//     g = animgraph.load(a, "assets/runner.graph")
//     animator.set_float(a, "speed", 3.0)
//     animator.layer_weight(a, animgraph.layer_of(g, "hit"), 1.0, 0.1)
//
// Each kind of part names its own: takes, states (blends and matchers are
// states), layers and aims, a take and its state often sharing a name.
// Joints are named as UE5's mannequin names them
// (spine_01, hand_r), whatever the figure's own rig calls them, or by the
// rig's own name. Paths are the program's, as every file the engine reads.
//
// A file's takes are made once for a figure file and its skeleton and
// shared by every figure loaded on them after (#992), each compressed
// within clips.COMPRESS_ERROR of the skin as its statement finishes it:
// the states, blends and transitions are each figure's own, the takes are
// not. A figure's animator holds its use of them (animator.hold), so they
// stay while it plays them, whenever its graph is freed.

import std.fs
import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.retarget
import ae3d.bvh
import ae3d.gltf
import ae3d.figure
import ae3d.blob
import ae3d.checksum

exports (
    Graph, load, graph_free, state_of, take_of, layer_of, aim_of, error
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// What a name is.
const NAME_TAKE = 0
const NAME_STATE = 1
const NAME_LAYER = 2
const NAME_AIM = 3

struct Entry {
    name: string
    kind: int
    index: int                     // a state's, a layer's or an aim's index
    take: ptr                      // a take's *Take
}

struct Graph {
    animator: ptr                  // *Animator
    names: ptr                     // list of *Entry
    sources: ptr                   // list of *Source: other figures' files read for takes, while loading
    made: ptr                      // *Made: the takes its file makes for its figure's skeleton
    reuse: bool                    // made by a load before: its takes are taken in order, not made
    next: int                      // the next of them a statement takes (reuse), or the first not yet compressed
}

// A graph file's takes made for one figure's skeleton (#992): its own
// animations, the other files' retargeted onto it, its captures and their
// mirrors, each compressed (clips.compress) as its statement finishes them.
// Made by the first load of the file onto a figure of that file and that
// skeleton, and shared by every load after (animator.share_take), as the
// gaits' takes are: 100 runners on one graph read, retargeted and kept
// every take 100 times. Keyed by the graph file and its text's CRC-32, the
// figure's file, and the skeleton (its joints and its rest pose's CRC-32).
struct Made {
    path: string                   // the graph file
    crc: long                      // its text's CRC-32
    figure: string                 // the figure's file
    joints: int                    // its skeleton's joints
    skeleton: long                 // and its rest pose's CRC-32
    takes: ptr                     // list of *Take, in the order its statements make them; its own
    users: int                     // animators playing them (animator.hold)
}

var g_made: ptr = null             // list of *Made

var g_error: string = ""
var g_text: string = ""
var g_at = 0
var g_length = 0
var g_number: ptr = null

// What the last load that failed said: its line and why.
error() -> string { return g_error }

// The graph in the file at `path` built on `a`. Null when the file cannot be
// read or says something that cannot be built (error() says where and why);
// what it built before then stays on the animator.
load(a: *Animator, path: string) -> *Graph {
    g_error = ""
    content, err = fs.read(path)
    if err != "" {
        g_error = "cannot read ${path}"
        return null
    }
    if g_number == null { g_number = calloc(1, 8) }
    g_text = content
    g_at = 0
    g_length = string.length(content)
    g = heap.new(Graph)
    g.animator = a as ptr
    g.names = list.new()
    g.sources = list.new()
    made_for(g, a, path)
    good = true
    while good {
        word = next_token()
        if string.length(word) == 0 {
            string.free(word)
            break
        }
        if string.starts_with(word, "#") == 1 {
            skip_line()
        } else {
            // A number that was not one fails the statement it was in.
            good = statement(g, word) && g_error == ""
            if good && !at_line_end() { good = fail("more on the line than `${word}` takes") }
            if good { skip_line() }
            // The takes it made, compressed now: what reads them after (a
            // mirror, a layer's first frame, a matcher's features, a blend's
            // speeds) reads them as every figure of the file will play them.
            if !g.reuse { compress_made(g) }
        }
        string.free(word)
    }
    string.free(content)
    sources_free(g)
    g_text = ""
    made_done(g, good)
    if !good {
        graph_free(g)
        return null
    }
    return g
}

// --- the takes, shared (#992) --------------------------------------------------------------------

// The takes a load of the graph file at `path` onto `a` plays: those a load
// before made for the same file, figure file and skeleton, taken in order
// (reuse), or a new set this load makes.
made_for(g: *Graph, a: *Animator, path: string) {
    text = blob.read(path)
    crc = 0 as long
    if text != null {
        crc = checksum.crc32(0 as long, text, blob.last_size() as int)
        blob.free_bytes(text)
    }
    r = animator.rig(a)
    joints = pose.count(r)
    skeleton = checksum.crc32(0 as long, pose.rest(r), pose.size(r) * 8)
    file = figure.path(figure.figure_of(animator.figure_object(a)))
    if g_made != null {
        i = 0
        while i < list.size(g_made) {
            m = list.get_raw(g_made, i) as *Made
            if m.crc == crc && m.joints == joints && m.skeleton == skeleton && string.equals(m.path, path) == 1 && string.equals(m.figure, file) == 1 {
                m.users = m.users + 1
                animator.hold(a, made_drop, m as ptr)
                g.made = m as ptr
                g.reuse = true
                return
            }
            i = i + 1
        }
    }
    m = heap.new(Made)
    m.path = string.copy(path)
    m.crc = crc
    m.figure = string.copy(file)
    m.joints = joints
    m.skeleton = skeleton
    m.takes = list.new()
    g.made = m as ptr
    g.reuse = false
}

// A load that made its takes, done: built whole, they are kept for the
// loads after and this animator holds a use of them; failed, they are the
// animator's (as everything else it built), freed with it.
made_done(g: *Graph, good: bool) {
    if g.reuse { return }
    m = g.made as *Made
    a = g.animator as *Animator
    if good {
        m.users = 1
        animator.hold(a, made_drop, m as ptr)
        if g_made == null { g_made = list.new() }
        list.add_raw(g_made, m as ptr)
        return
    }
    i = 0
    while i < list.size(m.takes) {
        _given = animator.add_take(a, list.get_raw(m.takes, i) as *Take, false)
        i = i + 1
    }
    list.free(m.takes)
    m.takes = list.new()
    made_free(m)
}

// A use of a graph's takes let go of (animator.hold); with the last, they go.
made_drop(state: ptr) {
    m = state as *Made
    m.users = m.users - 1
    if m.users > 0 { return }
    k = 0
    while k < list.size(g_made) {
        if list.get_raw(g_made, k) == state {
            list.remove(g_made, k)
            break
        }
        k = k + 1
    }
    made_free(m)
}

made_free(m: *Made) {
    i = 0
    while i < list.size(m.takes) {
        clips.take_free(list.get_raw(m.takes, i) as *Take)
        i = i + 1
    }
    list.free(m.takes)
    string.free(m.path)
    string.free(m.figure)
    heap.free(m)
}

// The takes made since the last statement compressed (clips.compress).
compress_made(g: *Graph) {
    m = g.made as *Made
    r = animator.rig(g.animator as *Animator)
    while g.next < list.size(m.takes) {
        _err = clips.compress(list.get_raw(m.takes, g.next) as *Take, r)
        g.next = g.next + 1
    }
}

// Take `t`, just made for the figure, kept with the graph's takes (its root
// motion taken out when `root`) and played by the animator: shared.
keep(g: *Graph, t: *Take, root: bool) -> *Take {
    if t == null { return null }
    a = g.animator as *Animator
    r = animator.rig(a)
    if root && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
    list.add_raw((g.made as *Made).takes, t as ptr)
    return animator.share_take(a, t, false)
}

// The next take a load before made here (reuse).
given(g: *Graph) -> *Take {
    m = g.made as *Made
    if g.next >= list.size(m.takes) {
        fail("the graph's takes were made by a load that built fewer")
        return null
    }
    t = list.get_raw(m.takes, g.next) as *Take
    g.next = g.next + 1
    return animator.share_take(g.animator as *Animator, t, false)
}

// The take named `animation` among the graph's takes made so far, as
// animator.take finds one the figure already has; null for none.
made_named(g: *Graph, animation: string) -> *Take {
    m = g.made as *Made
    upto = list.size(m.takes)
    if g.reuse { upto = g.next }
    i = 0
    while i < upto {
        t = list.get_raw(m.takes, i) as *Take
        if string.equals(clips.name(t), animation) == 1 { return animator.share_take(g.animator as *Animator, t, false) }
        i = i + 1
    }
    return null as *Take
}

graph_free(g: *Graph) {
    if g == null { return }
    i = 0
    while i < list.size(g.names) {
        en = list.get_raw(g.names, i) as *Entry
        string.free(en.name)
        heap.free(en)
        i = i + 1
    }
    list.free(g.names)
    sources_free(g)
    list.free(g.sources)
    heap.free(g)
}

// The state (a take's, a blend's, a matcher's) named `name`, -1 for none.
state_of(g: *Graph, name: string) -> int { return index_of(g, name, NAME_STATE) }
// The layer named `name`, -1 for none.
layer_of(g: *Graph, name: string) -> int { return index_of(g, name, NAME_LAYER) }
// The aim offset named `name`, -1 for none.
aim_of(g: *Graph, name: string) -> int { return index_of(g, name, NAME_AIM) }
// The take named `name`, null for none.
take_of(g: *Graph, name: string) -> *Take {
    en = entry(g, name, NAME_TAKE)
    if en == null { return null }
    return en.take as *Take
}

index_of(g: *Graph, name: string, kind: int) -> int {
    if g == null { return 0 - 1 }
    en = entry(g, name, kind)
    if en == null { return 0 - 1 }
    return en.index
}

entry(g: *Graph, name: string, kind: int) -> *Entry {
    i = 0
    while i < list.size(g.names) {
        en = list.get_raw(g.names, i) as *Entry
        if en.kind == kind && string.equals(en.name, name) == 1 { return en }
        i = i + 1
    }
    return null as *Entry
}

// Name `name` given to a part; false (and why) when it is taken.
named(g: *Graph, name: string, kind: int, index: int, t: @keep ptr) -> bool {
    if entry(g, name, kind) != null { return fail("`${name}` is named twice") }
    en = heap.new(Entry)
    en.name = string.copy(name)
    en.kind = kind
    en.index = index
    en.take = t
    list.add_raw(g.names, en as ptr)
    return true
}

// --- statements ----------------------------------------------------------------------------------

// One statement, its first word read.
statement(g: *Graph, word: string) -> bool {
    if string.equals(word, "take") == 1 { return take_line(g) }
    if string.equals(word, "capture") == 1 { return capture_line(g) }
    if string.equals(word, "mirror") == 1 { return mirror_line(g) }
    if string.equals(word, "state") == 1 { return state_line(g) }
    if string.equals(word, "blend") == 1 { return blend_block(g, false) }
    if string.equals(word, "blend2") == 1 { return blend_block(g, true) }
    if string.equals(word, "matcher") == 1 { return matcher_block(g) }
    if string.equals(word, "transition") == 1 { return transition_block(g) }
    if string.equals(word, "layer") == 1 { return layer_line(g) }
    if string.equals(word, "aim") == 1 { return aim_block(g) }
    if string.equals(word, "play") == 1 {
        s = state_named(g)
        if s < 0 { return false }
        animator.play(g.animator as *Animator, s, 0.0)
        return true
    }
    return fail("no statement `${word}`")
}

// take <name> <animation> [from <file>] [root]: the figure's own animation,
// or another figure's file's retargeted onto it (a library of takes on
// another skeleton: UAL's on the UE5 mannequin), its root motion taken out
// with `root`.
take_line(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    animation = next_token()
    root = false
    from = string.copy("")
    good = string.length(animation) > 0
    if !good { good = fail("a take names its animation") }
    while good && !at_line_end() {
        option = next_token()
        if string.equals(option, "root") == 1 {
            root = true
        } else if string.equals(option, "from") == 1 {
            string.free(from)
            from = next_token()
        } else {
            good = fail("a take takes from and root, not `${option}`")
        }
        string.free(option)
    }
    if good {
        t = null as *Take
        if string.length(from) == 0 {
            // The figure's own, once a graph however often it is named.
            t = made_named(g, animation)
            if t == null && g.reuse { t = given(g) }
            if t == null && !g.reuse {
                f = figure.figure_of(animator.figure_object(a))
                t = keep(g, clips.from_scene(animator.rig(a), figure.scene(f), animation, 0.0), root)
            }
            if t == null { good = fail("the figure's file has no animation `${animation}`") }
        } else if g.reuse {
            t = given(g)
            good = t != null
        } else {
            s = source_of(g, from)
            if s == null {
                good = fail("cannot read the figure's file ${from}")
            } else {
                made = clips.from_scene(s.rig as *pose.Rig, s.scene as *GltfScene, animation, 0.0)
                if made == null {
                    good = fail("${from} has no animation `${animation}`")
                } else {
                    t = keep(g, retarget.retarget(s.rig as *pose.Rig, made, animator.rig(a)), root)
                    clips.take_free(made)
                }
            }
        }
        if good { good = named(g, name, NAME_TAKE, 0, t as ptr) }
    }
    string.free(name)
    string.free(animation)
    string.free(from)
    return good
}

// Another figure's file a take is retargeted from: read once a load, its
// skeleton's rig made once.
struct Source {
    path: string
    scene: ptr                     // *GltfScene
    rig: ptr                       // *pose.Rig
}

source_of(g: *Graph, path: string) -> *Source {
    i = 0
    while i < list.size(g.sources) {
        s = list.get_raw(g.sources, i) as *Source
        if string.equals(s.path, path) == 1 { return s }
        i = i + 1
    }
    scene = gltf.load(path)
    if scene == null { return null as *Source }
    if gltf.skeleton_count(scene) == 0 {
        gltf.scene_destroy(scene)
        return null as *Source
    }
    s = heap.new(Source)
    s.path = string.copy(path)
    s.scene = scene as ptr
    s.rig = pose.of_skeleton(gltf.skeleton(scene, 0)) as ptr
    list.add_raw(g.sources, s as ptr)
    return s
}

sources_free(g: *Graph) {
    i = 0
    while i < list.size(g.sources) {
        s = list.get_raw(g.sources, i) as *Source
        pose.rig_free(s.rig as *pose.Rig)
        gltf.scene_destroy(s.scene as *GltfScene)
        string.free(s.path)
        heap.free(s)
        i = i + 1
    }
    list.free(g.sources)
    g.sources = list.new()
}

// capture <name> <path> [root] [straighten] [cut_loop] [from <s>] [to <s>]
// [asf <skeleton.asf> [fps <n>]] [event <name> <s>]...: a capture retargeted
// onto the figure, its root motion taken out (root), its path turned onto
// the nearest of the ground's four ways (straighten), cut to a loop
// (cut_loop); cropped to `from` and `to` seconds of it, read from CMU's
// ASF skeleton and AMC take (`asf`, its frame rate `fps`, 120 by default)
// rather than a BVH, its events at their seconds into the capture (#948).
// The take is named `name` (clips.name), as an item's swing names it.
capture_line(g: *Graph) -> bool {
    a = g.animator as *Animator
    r = animator.rig(a)
    name = next_token()
    path = next_token()
    root = false
    straight = false
    looped = false
    from_s = 0.0 - 1.0
    to_s = 0.0 - 1.0
    asf = ""
    fps = 120.0
    times = list.new()
    good = true
    while good && !at_line_end() {
        option = next_token()
        if string.equals(option, "root") == 1 {
            root = true
        } else if string.equals(option, "straighten") == 1 {
            straight = true
        } else if string.equals(option, "cut_loop") == 1 {
            looped = true
        } else if string.equals(option, "from") == 1 {
            from_s = next_number()
        } else if string.equals(option, "to") == 1 {
            to_s = next_number()
        } else if string.equals(option, "asf") == 1 {
            asf = next_token()
        } else if string.equals(option, "fps") == 1 {
            fps = next_number()
        } else if string.equals(option, "event") == 1 {
            word = next_token()
            at = heap.new(EventAt)
            at.name = string.copy(word)
            string.free(word)
            at.seconds = next_number()
            list.add_raw(times, at as ptr)
        } else {
            good = fail("a capture takes root, straighten, cut_loop, from, to, asf, fps or event, not `${option}`")
        }
        string.free(option)
    }
    if good && g.reuse {
        // Read, cut and straightened by the load that made it.
        t = given(g)
        good = t != null
        if good { good = named(g, name, NAME_TAKE, 0, t as ptr) }
    } else if good {
        c = null as *Capture
        if string.length(asf) > 0 {
            c = bvh.load_asf(asf, path, fps, 0.0)
        } else {
            c = bvh.load(path, 0.0)
        }
        if c == null {
            good = fail("cannot read the capture ${path}: ${bvh.error()}")
        } else {
            step = bvh.frame_time(c)
            first = 0
            last = 0 - 1
            if from_s >= 0.0 && step > 0.0 { first = (from_s / step + 0.5) as int }
            if to_s >= 0.0 && step > 0.0 { last = (to_s / step + 0.5) as int }
            made = bvh.take(c, name, first, last)
            t = retarget.retarget(bvh.rig(c), made, r)
            if root && !clips.has_root_motion(t) { clips.extract_root(t, r, clips.up_of(r)) }
            clips.take_free(made)
            bvh.capture_free(c)
            // Its events, at their seconds into the take as cropped.
            k = 0
            while k < list.size(times) {
                ev = list.get_raw(times, k) as *EventAt
                clips.add_event(t, ev.seconds - (first as float) * step, ev.name)
                k = k + 1
            }
            if straight { clips.straighten(t, r, true) }
            if looped {
                // Its loop alone is kept: the capture it was cut from is
                // played by nothing.
                cut = clips.loop_cut(t, r)
                clips.take_free(t)
                t = cut
                if straight { clips.straighten(t, r, true) }
            }
            t = keep(g, t, false)
            good = named(g, name, NAME_TAKE, 0, t as ptr)
        }
    }
    k = 0
    while k < list.size(times) {
        string.free((list.get_raw(times, k) as *EventAt).name)
        heap.free(list.get_raw(times, k) as *EventAt)
        k = k + 1
    }
    list.free(times)
    if string.length(asf) > 0 { string.free(asf) }
    string.free(name)
    string.free(path)
    return good
}

// An event's seconds, kept while a capture line is read.
struct EventAt {
    name: string
    seconds: float
}

// mirror <name> <take>: a take mirrored, left for right.
mirror_line(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    t = take_named(g)
    good = t != null
    if good {
        m = null as *Take
        if g.reuse {
            m = given(g)
        } else {
            m = keep(g, clips.mirror(t, animator.rig(a)), false)
        }
        good = m != null && named(g, name, NAME_TAKE, 0, m as ptr)
    }
    string.free(name)
    return good
}

// state <name> <take> loop|once [by <param> [left]] [rate <r>]: a state playing a take,
// looping or once; by a parameter, played by the distance it names gone
// (or, `left`, left to go: animator.clock_by); at `rate` times its own.
state_line(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    t = take_named(g)
    good = t != null
    loop = false
    if good {
        how = next_token()
        if string.equals(how, "loop") == 1 {
            loop = true
        } else if string.equals(how, "once") != 1 {
            good = fail("a state plays loop or once, not `${how}`")
        }
        string.free(how)
    }
    if good {
        s = animator.add_state(a, name, t, loop)
        good = named(g, name, NAME_STATE, s, null)
        while good && !at_line_end() {
            by = next_token()
            if string.equals(by, "by") == 1 {
                param = next_token()
                left = flag("left")
                animator.clock_by(a, s, param, left)
                string.free(param)
            } else if string.equals(by, "rate") == 1 {
                // Played at `rate` times its take's own (#948).
                animator.set_rate(a, s, next_number())
            } else {
                good = fail("after a state's loop or once comes `by` or `rate`, not `${by}`")
            }
            string.free(by)
        }
    }
    string.free(name)
    return good
}

// blend <name> <param> ... end, each line <take> measured|<value>; blend2
// <name> <param_x> <param_z> ... end, each line <take> measured|<x> <z>.
blend_block(g: *Graph, two: bool) -> bool {
    a = g.animator as *Animator
    name = next_token()
    across = next_token()
    ahead = ""
    if two { ahead = next_token() }
    s = 0 - 1
    if two {
        s = animator.add_blend2(a, name)
        animator.bind2(a, s, across, ahead)
    } else {
        s = animator.add_blend(a, name)
        animator.bind(a, s, across)
    }
    good = named(g, name, NAME_STATE, s, null)
    string.free(name)
    string.free(across)
    if two { string.free(ahead) }
    while good {
        good = block_line()
        if !good { break }
        word = next_token()
        if string.equals(word, "end") == 1 {
            string.free(word)
            break
        }
        t = take_of(g, word)
        if t == null { good = fail("no take `${word}`") }
        string.free(word)
        if good {
            at = next_token()
            measured = string.equals(at, "measured") == 1
            if !measured { g_at = g_at - string.length(at) }
            string.free(at)
            if two {
                x = 0.0
                z = 0.0
                if measured {
                    went = clips.travel(t, clips.duration(t))
                    x = went.x / clips.duration(t)
                    z = went.y / clips.duration(t)
                } else {
                    x = next_number()
                    z = next_number()
                }
                animator.blend_add2(a, s, t, x, z)
            } else {
                v = clips.speed(t)
                if !measured { v = next_number() }
                animator.blend_add(a, s, t, v)
            }
            if !at_line_end() { good = fail("more on a blend's line than a take and where it is") }
            skip_line()
        }
    }
    return good
}

// matcher <name> ... end, each line a take: motion matching over them,
// built at its end.
matcher_block(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    s = animator.add_matcher(a, name)
    good = named(g, name, NAME_STATE, s, null)
    string.free(name)
    count = 0
    while good {
        good = block_line()
        if !good { break }
        word = next_token()
        if string.equals(word, "end") == 1 {
            string.free(word)
            break
        }
        t = take_of(g, word)
        if t == null {
            good = fail("no take `${word}`")
        } else {
            animator.matcher_add(a, s, t)
            count = count + 1
        }
        string.free(word)
        if good && !at_line_end() { good = fail("more on a matcher's line than a take") }
        skip_line()
    }
    if good && count == 0 { good = fail("a matcher with no takes") }
    if good { animator.matcher_build(a, s) }
    return good
}

// transition <from|any> <to> <seconds> ... end, each line a condition (when
// <param> above|below <value>, when <param> is|is_not|triggered, when
// ended) or an option (crossfade, synced, or <state>, match <seconds>).
transition_block(g: *Graph) -> bool {
    a = g.animator as *Animator
    from = animator.ANY
    first = next_token()
    good = true
    if string.equals(first, "any") != 1 {
        g_at = g_at - string.length(first)
        from = state_named(g)
        good = from >= 0
    }
    string.free(first)
    if !good { return false }
    to = state_named(g)
    if to < 0 { return false }
    seconds = next_number()
    tr = animator.add_transition(a, from, to, seconds)
    while good {
        good = block_line()
        if !good { break }
        word = next_token()
        if string.equals(word, "end") == 1 {
            string.free(word)
            break
        }
        if string.equals(word, "when") == 1 {
            good = condition(a, tr)
        } else if string.equals(word, "crossfade") == 1 {
            animator.transition_crossfade(a, tr, true)
        } else if string.equals(word, "synced") == 1 {
            animator.transition_synced(a, tr, true)
        } else if string.equals(word, "or") == 1 {
            other = state_named(g)
            good = other >= 0
            if good { animator.transition_or(a, tr, other) }
        } else if string.equals(word, "match") == 1 {
            animator.transition_match(a, tr, next_number())
        } else {
            good = fail("a transition takes when, crossfade, synced, or and match, not `${word}`")
        }
        string.free(word)
        if good && !at_line_end() { good = fail("more on a transition's line than it takes") }
        skip_line()
    }
    return good
}

condition(a: *Animator, tr: int) -> bool {
    param = next_token()
    if string.equals(param, "ended") == 1 {
        string.free(param)
        animator.transition_when(a, tr, "", animator.ENDED, 0.0)
        return true
    }
    test = next_token()
    good = true
    if string.equals(test, "above") == 1 {
        animator.transition_when(a, tr, param, animator.ABOVE, next_number())
    } else if string.equals(test, "below") == 1 {
        animator.transition_when(a, tr, param, animator.BELOW, next_number())
    } else if string.equals(test, "is") == 1 {
        animator.transition_when(a, tr, param, animator.IS, 0.0)
    } else if string.equals(test, "is_not") == 1 {
        animator.transition_when(a, tr, param, animator.IS_NOT, 0.0)
    } else if string.equals(test, "triggered") == 1 {
        animator.transition_when(a, tr, param, animator.TRIGGERED, 0.0)
    } else {
        good = fail("a condition is above, below, is, is_not or triggered, not `${test}`")
    }
    string.free(param)
    string.free(test)
    return good
}

// layer <name> <take> [from <joint>] [additive] [loop|once]: a layer over
// the joints under one (the whole figure when none is named), blended over
// the state or added to it, at weight 0 until the game raises it.
layer_line(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    t = take_named(g)
    good = t != null
    from = 0 - 1
    additive = false
    loop = false
    while good && !at_line_end() {
        option = next_token()
        if string.equals(option, "from") == 1 {
            from = joint_named(g)
            good = from >= 0
        } else if string.equals(option, "additive") == 1 {
            additive = true
        } else if string.equals(option, "loop") == 1 {
            loop = true
        } else if string.equals(option, "once") != 1 {
            good = fail("a layer takes from, additive, loop or once, not `${option}`")
        }
        string.free(option)
    }
    if good { good = named(g, name, NAME_LAYER, animator.add_layer(a, t, from, additive, loop), null) }
    string.free(name)
    return good
}

// aim <name> [from <joint>] ... end, each line <take> <yaw> <pitch>: an aim
// offset over the joints under one, each take's first frame the aim at its
// yaw and pitch (radians).
aim_block(g: *Graph) -> bool {
    a = g.animator as *Animator
    name = next_token()
    from = 0 - 1
    good = true
    if !at_line_end() {
        word = next_token()
        if string.equals(word, "from") == 1 {
            from = joint_named(g)
            good = from >= 0
        } else {
            good = fail("an aim takes from, not `${word}`")
        }
        string.free(word)
    }
    m = 0 - 1
    if good {
        m = animator.add_aim(a, from)
        good = named(g, name, NAME_AIM, m, null)
    }
    string.free(name)
    while good {
        good = block_line()
        if !good { break }
        word = next_token()
        if string.equals(word, "end") == 1 {
            string.free(word)
            break
        }
        t = take_of(g, word)
        if t == null { good = fail("no take `${word}`") }
        string.free(word)
        if good {
            yaw = next_number()
            pitch = next_number()
            animator.aim_add(a, m, t, yaw, pitch)
            if !at_line_end() { good = fail("more on an aim's line than a take, its yaw and its pitch") }
            skip_line()
        }
    }
    return good
}

// --- names ---------------------------------------------------------------------------------------

take_named(g: *Graph) -> *Take {
    word = next_token()
    t = take_of(g, word)
    if t == null { fail("no take `${word}`") }
    string.free(word)
    return t
}

state_named(g: *Graph) -> int {
    word = next_token()
    s = state_of(g, word)
    if s < 0 { fail("no state `${word}`") }
    string.free(word)
    return s
}

// A joint by UE5's mannequin's name for it, or the rig's own.
joint_named(g: *Graph) -> int {
    r = animator.rig(g.animator as *Animator)
    word = next_token()
    j = 0 - 1
    k = 0
    while k < pose.FINGERS && j < 0 {
        known = pose.slot_name(pose.SCHEME_UE5, k)
        if string.equals(known, word) == 1 { j = pose.human(r, k) }
        string.free(known)
        k = k + 1
    }
    if j < 0 { j = pose.find(r, word) }
    if j < 0 { fail("the figure has no joint `${word}`") }
    string.free(word)
    return j
}

// --- reading -------------------------------------------------------------------------------------

// False, the error set to `why` at the line being read.
fail(why: string) -> bool {
    line = 1
    i = 0
    while i < g_at && i < g_length {
        if string.char_at(g_text, i) == 10 { line = line + 1 }
        i = i + 1
    }
    if g_error == "" { g_error = "line ${line}: ${why}" }
    return false
}

// The block's next line begun, past blank and comment lines; false at the
// file's end, which a block may not reach.
block_line() -> bool {
    while g_at < g_length {
        if !at_line_end() { return true }
        skip_line()
    }
    return fail("a block with no `end`")
}

// Whether the line's next word is `word`: read when it is.
flag(word: string) -> bool {
    if at_line_end() { return false }
    start = g_at
    next = next_token()
    found = string.equals(next, word) == 1
    string.free(next)
    if !found { g_at = start }
    return found
}

is_blank(ch: int) -> bool { return ch == 32 || ch == 9 || ch == 10 || ch == 13 }

next_token() -> string {
    while g_at < g_length && is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
    start = g_at
    while g_at < g_length && !is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
    if g_at == start { return string.copy("") }
    return string.substring(g_text, start, g_at)
}

next_number() -> float {
    word = next_token()
    value = 0.0
    if string.length(word) > 0 && string.to_double_raw(word, g_number) != 0 {
        value = (g_number as float[])[0]
    } else {
        fail("`${word}` is not a number")
    }
    string.free(word)
    return value
}

// Whether only spaces, tabs or a comment are left before the line's end.
at_line_end() -> bool {
    while g_at < g_length {
        ch = string.char_at(g_text, g_at)
        if ch == 35 {
            while g_at < g_length && string.char_at(g_text, g_at) != 10 { g_at = g_at + 1 }
            return true
        }
        if ch != 32 && ch != 9 && ch != 13 { return ch == 10 }
        g_at = g_at + 1
    }
    return true
}

skip_line() {
    while g_at < g_length && string.char_at(g_text, g_at) != 10 { g_at = g_at + 1 }
    if g_at < g_length { g_at = g_at + 1 }
}
