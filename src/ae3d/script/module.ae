// Scripts: source files that are component kinds.
//
// A script is an ordinary Aether source file, and it is a component. Its
// state is a struct of its own, one for every object it is attached to;
// its fields are what the inspector shows and the scene saves; its phases
// are Unity's, by Unity's names:
//
//     struct Bob { rate: float  height: float  clock: float }
//
//     create() -> ptr { ... }                          // a state, with its defaults
//     destroy(p: ptr) { heap.free(p as *Bob) }
//     fields(k: *ComponentKind) {                      // what is shown and saved
//         component.float_field(k, "rate", offsetof(Bob, rate), 0.0, 10.0)
//         ...
//     }
//     awake(p: ptr, go: *GameObject)                   // as it is attached
//     start(p: ptr, go: *GameObject)                   // before its first update
//     update(p: ptr, go: *GameObject, delta: float)    // every frame
//     fixed_update(p: ptr, go: *GameObject, step: float)
//     late_update(p: ptr, go: *GameObject, delta: float)
//     on_enable(p: ptr, go: *GameObject)               // as it comes to run: added, enabled, made active
//     on_disable(p: ptr, go: *GameObject)              // as it stops: disabled, made inactive, taken off
//     on_destroy(p: ptr, go: *GameObject)              // as it is taken off
//     on_collision_enter(p: ptr, go: *GameObject, hit: *Collision)   // and _stay, _exit: what its colliders touch
//     on_trigger_enter(p: ptr, go: *GameObject, other: *GameObject)  // and _stay, _exit: what overlaps its triggers
//     on_net_spawn(p: ptr, go: *GameObject)            // on the network, on every peer, once
//
// create, destroy and fields are what make a file a script; every phase
// is optional. It is compiled into a shared library (scripts/build_script.sh)
// and opened at run time: script_kind registers the library as a component
// kind named for the script, so an object is given one as it is given any
// component (component.add), from the editor's Add Component or a program.
// A game that compiles its scripts in registers the same functions with
// ae3d.component directly; one file serves both.
//
// A library rebuilt while the editor runs is swapped under the objects
// carrying it (script_reload): each attachment's fields are read out, its
// state freed by the old library and made again by the new, and the fields
// written back by name -- a field the new code renamed takes its default,
// the rest carry over. One that runs is told on_disable by the old code
// before its state goes and on_enable by the new once it is back.
//
// A script is compiled from the same sources as the host, so the two agree
// about what a Model is only while they are built from the same tree.
// script_open holds them to it: a library says what layout it was built
// against (component.script_layout, exported under a C name of its own) and
// one that says another, or nothing, is refused by name, never misread.

import std.list
import std.heap
import std.string
import std.json
import std.os
import std.fs
import std.dl
import ae3d.core
import ae3d.behaviour
import ae3d.component

exports (
    Script,
    script_open, script_close, script_kind, script_reload,
    script_path, library_path, last_error,
    loaded_count, loaded_name, loaded_kind, loaded_script, loaded_error, reload_named, build_and_reload
)

// A loaded script: its library and what it exports, resolved once.
struct Script {
    handle: ptr
    create: ptr
    destroy: ptr
    fields: ptr
    awake: ptr
    start: ptr
    update: ptr
    fixed_update: ptr
    late_update: ptr
    on_destroy: ptr
    on_enable: ptr
    on_disable: ptr
    on_collision_enter: ptr
    on_collision_stay: ptr
    on_collision_exit: ptr
    on_trigger_enter: ptr
    on_trigger_stay: ptr
    on_trigger_exit: ptr
    on_net_spawn: ptr
    // Its struct's derived schema, or null: the fields, and the states when
    // the script has no create and destroy of its own.
    table: ptr
    path: string
}

var g_error = ""

last_error() -> string { return g_error }

// The message kept for last_error, owned: the one before it freed, since a
// module's variable does not free what it held when it is given another.
set_error(text: string) { g_error = string.copy(text) }

// What a loadable library is called on this platform: knowing which
// belongs here rather than in every caller that wants to open one.
library_suffix() -> string {
    platform = os.platform()
    if platform == "windows" { return ".dll" }
    if platform == "darwin" { return ".dylib" }
    return ".so"
}

// Where the library for a named script lives.
library_path(directory: string, name: string) -> string {
    tail = string.concat(name, library_suffix())
    path = string.concat(directory, tail)
    string.free(tail)
    return path
}

// Open a compiled script. Answers null and says why rather than half a
// script: a library without create, destroy and fields is not a script,
// and a component made of it would have no state to run on.
script_open(path: string) -> *Script {
    set_error("")
    if path == "" {
        set_error("no script path")
        return null
    }
    handle = dl.open_raw(path)
    if handle == null {
        reason = dl.last_error_raw()
        if reason == "" { reason = "the library would not load" }
        set_error("${path}: ${reason}")
        return null
    }
    create = dl.symbol_raw(handle, "create")
    destroy = dl.symbol_raw(handle, "destroy")
    fields = dl.symbol_raw(handle, "fields")
    // The struct the file is named for, when it derives its schema: bob.ae's
    // Bob, health_bar.ae's HealthBar, whose `Bob_schema` every library built
    // from the file exports.
    stem = path
    cut = string.index_of(stem, "/")
    while cut >= 0 {
        stem = string.substring(stem, cut + 1, string.length(stem))
        cut = string.index_of(stem, "/")
    }
    cut = string.index_of(stem, "\\")
    while cut >= 0 {
        stem = string.substring(stem, cut + 1, string.length(stem))
        cut = string.index_of(stem, "\\")
    }
    dot = string.index_of(stem, ".")
    if dot >= 0 { stem = string.substring(stem, 0, dot) }
    struct_name = ""
    parts = string.split(stem, "_")
    k = 0
    while k < string.array_size(parts) {
        part = string.array_get(parts, k)
        if string.length(part) > 0 {
            struct_name = string.concat(struct_name, string.to_upper(string.substring(part, 0, 1)))
            struct_name = string.concat(struct_name, string.substring(part, 1, string.length(part)))
        }
        k = k + 1
    }
    string.array_free(parts)
    table = null as ptr
    derived = dl.symbol_raw(handle, "${struct_name}_schema")
    if derived != null {
        read_schema = derived as fn() -> ptr
        table = read_schema()
    }
    if table == null && (create == null || destroy == null || fields == null) {
        dl.close_raw(handle)
        set_error("${path}: a script exports create, destroy and fields, or its struct ${struct_name} derives its schema (@derive(schema))")
        return null
    }
    if (create == null) != (destroy == null) {
        dl.close_raw(handle)
        set_error("${path}: create and destroy come together: what one makes the other frees")
        return null
    }
    if create == null && component.schema_holds_text(table) {
        dl.close_raw(handle)
        set_error("${path}: ${struct_name} holds a string, which only its own code can free: give the script create and destroy")
        return null
    }
    // Built against this engine's layout, or refused: a script built from
    // another tree reads every object it is handed through that tree's idea
    // of it (component.script_layout).
    layout = dl.symbol_raw(handle, "script_layout_hash")
    if layout == null {
        dl.close_raw(handle)
        set_error("${path}: built before scripts said what engine they were built against; rebuild it (scripts/build_script.sh)")
        return null
    }
    asked = layout as fn() -> long
    theirs = asked()
    ours = component.script_layout()
    if theirs != ours {
        dl.close_raw(handle)
        set_error("${path}: built against another engine (its layout ${theirs}, this engine's ${ours}); rebuild it with this tree (scripts/build_script.sh)")
        return null
    }
    s = heap.new(Script)
    s.handle = handle
    s.create = create
    s.destroy = destroy
    s.fields = fields
    s.table = table
    s.awake = dl.symbol_raw(handle, "awake")
    s.start = dl.symbol_raw(handle, "start")
    s.update = dl.symbol_raw(handle, "update")
    s.fixed_update = dl.symbol_raw(handle, "fixed_update")
    s.late_update = dl.symbol_raw(handle, "late_update")
    s.on_destroy = dl.symbol_raw(handle, "on_destroy")
    s.on_enable = dl.symbol_raw(handle, "on_enable")
    s.on_disable = dl.symbol_raw(handle, "on_disable")
    s.on_collision_enter = dl.symbol_raw(handle, "on_collision_enter")
    s.on_collision_stay = dl.symbol_raw(handle, "on_collision_stay")
    s.on_collision_exit = dl.symbol_raw(handle, "on_collision_exit")
    s.on_trigger_enter = dl.symbol_raw(handle, "on_trigger_enter")
    s.on_trigger_stay = dl.symbol_raw(handle, "on_trigger_stay")
    s.on_trigger_exit = dl.symbol_raw(handle, "on_trigger_exit")
    s.on_net_spawn = dl.symbol_raw(handle, "on_net_spawn")
    s.path = string.copy(path)
    return s
}

// CRITICAL: the path is not freed here. A struct owns its string fields and
// heap.free releases them, so freeing it as well is a double free.
script_close(s: *Script) {
    if s == null { return }
    if s.handle != null { dl.close_raw(s.handle) }
    heap.free(s)
}

script_path(s: *Script) -> string {
    if s == null { return "" }
    return s.path
}

// The kind's functions, its fields and its defaults, from `s`.
define(k: *ComponentKind, s: *Script) {
    if s.create == null {
        // Made and freed from the schema: the struct is the whole declaration.
        component.kind_redefine(k, null, component.schema_state_free, s.table)
    } else {
        component.kind_redefine(k, s.create as fn() -> ptr, s.destroy as fn(ptr), s.table)
    }
    // The schema's fields, then whatever the script declares itself beside
    // them (a text field, a property worked out from the state).
    if s.table != null { component.schema_fields(k, s.table) }
    if s.fields != null {
        declare_fields = s.fields as fn(ptr)
        declare_fields(k as ptr)
    }
    k.awake = s.awake as fn(ptr, *GameObject)
    k.start = s.start as fn(ptr, *GameObject)
    k.update = s.update as fn(ptr, *GameObject, float)
    k.fixed_update = s.fixed_update as fn(ptr, *GameObject, float)
    k.late_update = s.late_update as fn(ptr, *GameObject, float)
    k.on_destroy = s.on_destroy as fn(ptr, *GameObject)
    k.on_enable = s.on_enable as fn(ptr, *GameObject)
    k.on_disable = s.on_disable as fn(ptr, *GameObject)
    component.set_collisions(k, s.on_collision_enter as fn(ptr, *GameObject, *Collision), s.on_collision_stay as fn(ptr, *GameObject, *Collision),
                             s.on_collision_exit as fn(ptr, *GameObject, *Collision))
    component.set_triggers(k, s.on_trigger_enter as fn(ptr, *GameObject, *GameObject), s.on_trigger_stay as fn(ptr, *GameObject, *GameObject),
                           s.on_trigger_exit as fn(ptr, *GameObject, *GameObject))
    component.set_net_spawn(k, s.on_net_spawn as fn(ptr, *GameObject))
}

// The script as a component kind named `name`, listed under Scripts:
// registered the first time, and its functions and fields taken from `s`
// again every time after (a script rebuilt is the same kind, done anew).
// One per object: a script is a behaviour of the object, and two of the
// same on one object would be the same behaviour twice.
script_kind(s: *Script, name: string) -> *ComponentKind {
    if s == null { return null }
    k = component.kind_named(name)
    if k == null {
        k = component.kind(name, "Scripts", s.create as fn() -> ptr, s.destroy as fn(ptr))
    }
    define(k, s)
    component.set_unique(k, true)
    remember(name, k, s)
    return k
}

// --- the scripts a program has opened (#510) ----------------------------------------------------
//
// Every script made a kind here (script_kind), by name: what the agent
// channel lists, reloads and reports the errors of (script.list,
// script.reload, script.errors). A program that keeps its own list (the
// editor) keeps it as before; this one is the library's.

struct Loaded {
    name: string
    kind: ptr                      // *ComponentKind
    script: ptr                    // *Script: the library the kind runs now
    error: string                  // why its last build or reload failed, "" when it did not
}

var g_loaded: ptr = null           // list of *Loaded

remember(name: string, k: *ComponentKind, s: *Script) {
    if g_loaded == null { g_loaded = list.new() }
    at = loaded_index(name)
    if at >= 0 {
        x = list.get_raw(g_loaded, at) as *Loaded
        x.kind = k as ptr
        x.script = s as ptr
        return
    }
    x = heap.new(Loaded)
    x.name = string.copy(name)
    x.kind = k as ptr
    x.script = s as ptr
    x.error = ""
    list.add_raw(g_loaded, x as ptr)
}

loaded_index(name: string) -> int {
    if g_loaded == null { return 0 - 1 }
    i = 0
    while i < list.size(g_loaded) {
        if string.equals((list.get_raw(g_loaded, i) as *Loaded).name, name) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

loaded_count() -> int {
    if g_loaded == null { return 0 }
    return list.size(g_loaded)
}

loaded_at(i: int) -> *Loaded { return list.get_raw(g_loaded, i) as *Loaded }
loaded_name(i: int) -> string { return loaded_at(i).name }
loaded_kind(i: int) -> *ComponentKind { return loaded_at(i).kind as *ComponentKind }
loaded_script(i: int) -> *Script { return loaded_at(i).script as *Script }
loaded_error(i: int) -> string { return loaded_at(i).error }

set_loaded_error(at: int, why: string) {
    x = loaded_at(at)
    if x.error != "" { string.free(x.error) }
    x.error = string.copy(why)
}

// The script `name` opened again from its library as it is on disk now and
// swapped under every object carrying it in `s` (script_reload: fields kept
// by name, states the new code's), the old library closed. "" when it
// reloaded; else why not, which script.errors gives back too.
reload_named(name: string, s: *Scene) -> string {
    at = loaded_index(name)
    if at < 0 { return "no script ${name} has been opened (script.list names them)" }
    x = loaded_at(at)
    previous = x.script as *Script
    replaced = script_open(script_path(previous))
    if replaced == null {
        why = last_error()
        set_loaded_error(at, why)
        return why
    }
    script_reload(x.kind as *ComponentKind, previous, replaced, s, null)
    x.script = replaced as ptr
    script_close(previous)
    set_loaded_error(at, "")
    return ""
}

// A path's file name without its directory or its extensions.
stem_of(path: string) -> string {
    start = string.length(path)
    while start > 0 && string.char_at(path, start - 1) != 47 && string.char_at(path, start - 1) != 92 { start = start - 1 }
    end = start
    while end < string.length(path) && string.char_at(path, end) != 46 { end = end + 1 }
    return string.substring(path, start, end)
}

// `source` built into the library `name` runs from (`build_tool`, a build
// script taking the source and the library's directory: the engine's
// scripts/build_script.sh), then reloaded. "" when built and reloaded; else
// the compiler's output or why it would not reload.
build_and_reload(name: string, source: string, build_tool: string, s: *Scene) -> string {
    at = loaded_index(name)
    if at < 0 { return "no script ${name} has been opened (script.list names them)" }
    library = script_path(loaded_script(at))
    // The build names its library for the source file: another stem would
    // build a library this script does not run from, and reload the old.
    if string.equals(stem_of(source), stem_of(library)) != 1 {
        why = "${source} builds ${stem_of(source)}, and ${name} runs from ${library}: give the source it was built from"
        set_loaded_error(at, why)
        return why
    }
    directory = "."
    cut = string.length(library) - 1
    while cut >= 0 && string.char_at(library, cut) != 47 { cut = cut - 1 }
    if cut > 0 { directory = string.substring(library, 0, cut) }
    argv = list.new()
    list.add(argv, source)
    list.add(argv, directory)
    // stdout and stderr both: the compiler says what is wrong on stderr,
    // and a capture of stdout alone took a failed build for one with
    // nothing to say.
    log = "${directory}/${stem_of(source)}.build.log"
    token, err = os.os_spawn_to_raw(build_tool, argv, null, log)
    list.free(argv)
    if err != "" {
        why = "${build_tool} would not run: ${err}"
        set_loaded_error(at, why)
        return why
    }
    status, werr = os.wait(token)
    said, _read = fs.read(log)
    if werr != "" || status != 0 {
        why = said
        if why == "" { why = "${build_tool} ${source} failed (status ${status}${werr}) and said nothing" }
        set_loaded_error(at, why)
        return why
    }
    return reload_named(name, s)
}

// The kind moved from `old` to `replaced`, with every attachment kept --
// on the scene's objects, on its root, and on `others` (a list of objects
// out of the scene and still held, as an editor keeps what it deleted for
// undo; null for none): its fields read out, its state freed by the library
// that made it, made again by the new one, the fields written back by
// name, and its start run again on the next frame. `old` stays open until
// the caller closes it after this returns.
script_reload(k: *ComponentKind, old: *Script, replaced: *Script, s: *Scene, others: ptr) {
    if k == null || replaced == null { return }
    held = list.new()
    collect(k, behaviour.scene_root(s), held)
    count = 0
    if s != null { count = behaviour.scene_count(s) }
    i = 0
    while i < count {
        collect(k, behaviour.scene_object(s, i), held)
        i = i + 1
    }
    if others != null {
        i = 0
        while i < list.size(others) {
            collect(k, list.get_raw(others, i) as *GameObject, held)
            i = i + 1
        }
    }
    // Every state read out and freed while the old library's code is still
    // there to free it; one that runs told on_disable by that code first, as
    // whatever its on_enable registered the state with still holds it.
    n = list.size(held)
    i = 0
    while i < n {
        h = list.get_raw(held, i) as *HeldState
        c = h.component as *Component
        if c.live && c.on_disable != null { c.on_disable(c.state, behaviour.component_owner(c)) }
        component.release_state(c)
        i = i + 1
    }
    define(k, replaced)
    i = 0
    while i < n {
        h = list.get_raw(held, i) as *HeldState
        c = h.component as *Component
        component.replace_state(c, component.make_state(k))
        component.from_json(c, h.fields)
        c.started = false
        // And the new state told it runs, by the new code.
        if c.live && c.on_enable != null { c.on_enable(c.state, behaviour.component_owner(c)) }
        json.free(h.fields)
        heap.free(h)
        i = i + 1
    }
    list.free(held)
}

// A component of the kind being reloaded, and its fields as they were.
struct HeldState {
    component: ptr
    fields: ptr
}

collect(k: *ComponentKind, o: *GameObject, held: ptr) {
    if o == null { return }
    count = behaviour.object_component_count(o)
    i = 0
    while i < count {
        c = behaviour.object_component(o, i)
        if c != null && c.schema == k as ptr {
            h = heap.new(HeldState)
            h.component = c as ptr
            h.fields = component.to_json(c, false)
            list.add_raw(held, h)
        }
        i = i + 1
    }
}
