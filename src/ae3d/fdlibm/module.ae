// ae3d.fdlibm -- the same transcendental functions to the bit on every
// platform (#911).
//
// A peer that evaluates a character's graph from the same inputs as
// another draws the same pose only if every number on the way rounds the
// same. +, -, *, / and sqrt are IEEE's on every platform (every build says
// -ffp-contract=off, so none is fused), but libm's sin, cos, atan2, acos and
// exp are each platform's own: glibc, Apple's and MinGW's differ in the last
// bit here and there, and the mannequin's trail (test_net_anim) parted on
// all three CI runners at its first tick. These are Sun's fdlibm (as
// FreeBSD's msun keeps it), written in plain arithmetic: within an ulp of
// the true value, and the same bits everywhere. ae3d.core's sin_of, cos_of,
// atan2_of, acos_of and exp_of are these.
//
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
// Developed at SunPro, a Sun Microsystems, Inc. business. Permission to
// use, copy, modify, and distribute this software is freely granted,
// provided that this notice is preserved.

import std.mem

exports (
    sin, cos, atan, atan2, acos, exp
)

extern sqrt(x: float) -> float

// The high and low 32 bits of a double, and a double from them.
high(x: float) -> int { return ((mem.bits_of_float(x) >> 32) & (4294967295 as long)) as int }
low(x: float) -> long { return mem.bits_of_float(x) & (4294967295 as long) }
from_words(hi: int, lo: long) -> float { return mem.float_from_bits((((hi as long) & (4294967295 as long)) << 32) | (lo & (4294967295 as long))) }
magnitude(x: float) -> int { return high(x) & 2147483647 }
negative(x: float) -> bool { return mem.bits_of_float(x) < (0 as long) }

// --- sin and cos ---------------------------------------------------------------------------------

const S1 = -1.66666666666666324348e-01
const S2 = 8.33333333332248946124e-03
const S3 = -1.98412698298579493134e-04
const S4 = 2.75573137070700676789e-06
const S5 = -2.50507602534068634195e-08
const S6 = 1.58969099521155010221e-10
const C1 = 4.16666666666666019037e-02
const C2 = -1.38888888888741095749e-03
const C3 = 2.48015872894767294178e-05
const C4 = -2.75573143513906633035e-07
const C5 = 2.08757232129817482790e-09
const C6 = -1.13596475577881948265e-11
const INVPIO2 = 6.36619772367581382433e-01
const PIO2_1 = 1.57079632673412561417e+00
const PIO2_1T = 6.07710050650619224932e-11
const PIO2_2 = 6.07710050630396597660e-11
const PIO2_2T = 2.02226624879595063154e-21
const PIO2_3 = 2.02226624871116645580e-21
const PIO2_3T = 8.47842766036889956997e-32

// sin(x + y) for |x| <= pi/4, y the tail of x (0 where there is none).
kernel_sin(x: float, y: float, tail: bool) -> float {
    z = x * x
    v = z * x
    r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)))
    if !tail { return x + v * (S1 + z * r) }
    return x - ((z * (0.5 * y - v * r) - y) - v * S1)
}

// cos(x + y) for |x| <= pi/4.
kernel_cos(x: float, y: float) -> float {
    ix = magnitude(x)
    if ix < 1044381696 { return 1.0 }                       // |x| < 2^-27
    z = x * x
    r = z * (C1 + z * (C2 + z * (C3 + z * (C4 + z * (C5 + z * C6)))))
    if ix < 1070805811 { return 1.0 - (0.5 * z - (z * r - x * y)) }   // |x| < 0.3
    qx = 0.28125
    if ix <= 1072234496 { qx = from_words(ix - 2097152, 0 as long) }  // |x| <= 0.78125: x / 4, its low word dropped
    hz = 0.5 * z - qx
    a = 1.0 - qx
    return a - (hz - (z * r - x * y))
}

// x less n pi/2, nearest: n, and the remainder as a head and a tail.
// Cody and Waite's reduction in three parts (fdlibm's medium case): exact
// enough for any angle a figure turns through; past 2^20 pi/2 it loses
// bits, still the same ones everywhere.
rem_pio2(x: float) -> (int, float, float) {
    t = x * INVPIO2
    n = 0 as long
    if t >= 0.0 { n = (t + 0.5) as long } else { n = (t - 0.5) as long }
    fn = n as float
    r = x - fn * PIO2_1
    w = fn * PIO2_1T
    y0 = r - w
    j = magnitude(x) >> 20
    i = j - ((high(y0) >> 20) & 2047)
    if i > 16 {
        t2 = r
        w = fn * PIO2_2
        r = t2 - w
        w = fn * PIO2_2T - ((t2 - r) - w)
        y0 = r - w
        i = j - ((high(y0) >> 20) & 2047)
        if i > 49 {
            t3 = r
            w = fn * PIO2_3
            r = t3 - w
            w = fn * PIO2_3T - ((t3 - r) - w)
            y0 = r - w
        }
    }
    y1 = (r - y0) - w
    return (n % (4 as long)) as int, y0, y1
}

sin(x: float) -> float {
    if magnitude(x) <= 1072243195 { return kernel_sin(x, 0.0, false) }   // |x| <= pi/4
    if magnitude(x) >= 2146435072 { return x - x }                      // inf or NaN
    n, y0, y1 = rem_pio2(x)
    q = (n + 4) % 4
    if q == 0 { return kernel_sin(y0, y1, true) }
    if q == 1 { return kernel_cos(y0, y1) }
    if q == 2 { return 0.0 - kernel_sin(y0, y1, true) }
    return 0.0 - kernel_cos(y0, y1)
}

cos(x: float) -> float {
    if magnitude(x) <= 1072243195 { return kernel_cos(x, 0.0) }
    if magnitude(x) >= 2146435072 { return x - x }
    n, y0, y1 = rem_pio2(x)
    q = (n + 4) % 4
    if q == 0 { return kernel_cos(y0, y1) }
    if q == 1 { return 0.0 - kernel_sin(y0, y1, true) }
    if q == 2 { return 0.0 - kernel_cos(y0, y1) }
    return kernel_sin(y0, y1, true)
}

// --- atan and atan2 ------------------------------------------------------------------------------

const AT0 = 3.33333333333329318027e-01
const AT1 = -1.99999999998764832476e-01
const AT2 = 1.42857142725034663711e-01
const AT3 = -1.11111104054623557880e-01
const AT4 = 9.09088713343650656196e-02
const AT5 = -7.69187620504482999495e-02
const AT6 = 6.66107313738753120669e-02
const AT7 = -5.83357013379057348645e-02
const AT8 = 4.97687799461593236017e-02
const AT9 = -3.65315727442169155270e-02
const AT10 = 1.62858201153657823623e-02

atan_hi(id: int) -> float {
    if id == 0 { return 4.63647609000806093515e-01 }
    if id == 1 { return 7.85398163397448278999e-01 }
    if id == 2 { return 9.82793723247329054082e-01 }
    return 1.57079632679489655800e+00
}

atan_lo(id: int) -> float {
    if id == 0 { return 2.26987774529616870924e-17 }
    if id == 1 { return 3.06161699786838301793e-17 }
    if id == 2 { return 1.39033110312309984516e-17 }
    return 6.12323399573676603587e-17
}

atan(x0: float) -> float {
    x = x0
    ix = magnitude(x)
    below = negative(x)
    if ix >= 1141899264 {                                   // |x| >= 2^66
        if x != x { return x + x }
        if below { return 0.0 - (atan_hi(3) + atan_lo(3)) }
        return atan_hi(3) + atan_lo(3)
    }
    id = 0 - 1
    if ix < 1071382528 {                                    // |x| < 0.4375
        if ix < 1044381696 { return x }                     // |x| < 2^-27
    } else {
        x = 0.0 + x
        if below { x = 0.0 - x }
        if ix < 1072889856 {                                // |x| < 1.1875
            if ix < 1072037888 {                            // 7/16 <= |x| < 11/16
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            } else {
                id = 1
                x = (x - 1.0) / (x + 1.0)
            }
        } else {
            if ix < 1073971200 {                            // |x| < 2.4375
                id = 2
                x = (x - 1.5) / (1.0 + 1.5 * x)
            } else {
                id = 3
                x = (0.0 - 1.0) / x
            }
        }
    }
    z = x * x
    w = z * z
    s1 = z * (AT0 + w * (AT2 + w * (AT4 + w * (AT6 + w * (AT8 + w * AT10)))))
    s2 = w * (AT1 + w * (AT3 + w * (AT5 + w * (AT7 + w * AT9))))
    if id < 0 { return x - x * (s1 + s2) }
    r = atan_hi(id) - ((x * (s1 + s2) - atan_lo(id)) - x)
    if below { return 0.0 - r }
    return r
}

const PI = 3.1415926535897931160e+00
const PI_O_2 = 1.5707963267948965580e+00
const PI_LO = 1.2246467991473531772e-16

atan2(y: float, x: float) -> float {
    if x != x || y != y { return x + y }
    if x == 1.0 { return atan(y) }
    m = 0
    if negative(y) { m = m + 1 }
    if negative(x) { m = m + 2 }
    if y == 0.0 {
        if m < 2 { return y }
        if m == 2 { return PI }
        return 0.0 - PI
    }
    if x == 0.0 {
        if negative(y) { return 0.0 - PI_O_2 }
        return PI_O_2
    }
    ix = magnitude(x)
    iy = magnitude(y)
    if ix == 2146435072 {                                   // x infinite
        if iy == 2146435072 {
            if m == 0 { return PI_O_2 * 0.5 }
            if m == 1 { return 0.0 - PI_O_2 * 0.5 }
            if m == 2 { return 3.0 * PI_O_2 * 0.5 }
            return 0.0 - 3.0 * PI_O_2 * 0.5
        }
        if m == 0 { return 0.0 }
        if m == 1 { return 0.0 - 0.0 }
        if m == 2 { return PI }
        return 0.0 - PI
    }
    if iy == 2146435072 {
        if negative(y) { return 0.0 - PI_O_2 }
        return PI_O_2
    }
    k = (iy - ix) >> 20
    z = 0.0
    if k > 60 {
        z = PI_O_2 + 0.5 * PI_LO
        m = m & 1
    } else if negative(x) && k < 0 - 60 {
        z = 0.0
    } else {
        q = y / x
        if q < 0.0 { q = 0.0 - q }
        z = atan(q)
    }
    if m == 0 { return z }
    if m == 1 { return 0.0 - z }
    if m == 2 { return PI - (z - PI_LO) }
    return (z - PI_LO) - PI
}

// --- acos ----------------------------------------------------------------------------------------

const PIO2_HI = 1.57079632679489655800e+00
const PIO2_LO = 6.12323399573676603587e-17
const PS0 = 1.66666666666666657415e-01
const PS1 = -3.25565818622400915405e-01
const PS2 = 2.01212532134862925881e-01
const PS3 = -4.00555345006794114027e-02
const PS4 = 7.91534994289814532176e-04
const PS5 = 3.47933107596021167570e-05
const QS1 = -2.40339491173441421878e+00
const QS2 = 2.02094576023350569471e+00
const QS3 = -6.88283971605453293030e-01
const QS4 = 7.70381505559019352791e-02

acos_ratio(z: float) -> float {
    p = z * (PS0 + z * (PS1 + z * (PS2 + z * (PS3 + z * (PS4 + z * PS5)))))
    q = 1.0 + z * (QS1 + z * (QS2 + z * (QS3 + z * QS4)))
    return p / q
}

acos(x: float) -> float {
    ix = magnitude(x)
    if ix >= 1072693248 {                                   // |x| >= 1
        if x == 1.0 { return 0.0 }
        if x == 0.0 - 1.0 { return PI + 2.0 * PIO2_LO }
        return (x - x) / (x - x)
    }
    if ix < 1071644672 {                                    // |x| < 0.5
        if ix <= 1012924416 { return PIO2_HI + PIO2_LO }    // |x| < 2^-57
        r = acos_ratio(x * x)
        return PIO2_HI - (x - (PIO2_LO - x * r))
    }
    if negative(x) {
        z = (1.0 + x) * 0.5
        s = sqrt(z)
        w = acos_ratio(z) * s - PIO2_LO
        return PI - 2.0 * (s + w)
    }
    z = (1.0 - x) * 0.5
    s = sqrt(z)
    df = from_words(high(s), 0 as long)
    c = (z - df * df) / (s + df)
    w = acos_ratio(z) * s + c
    return 2.0 * (df + w)
}

// --- exp -----------------------------------------------------------------------------------------

const O_THRESHOLD = 7.09782712893383973096e+02
const U_THRESHOLD = -7.45133219101941108420e+02
const LN2_HI = 6.93147180369123816490e-01
const LN2_LO = 1.90821492927058770002e-10
const INVLN2 = 1.44269504088896338700e+00
const P1 = 1.66666666666666019037e-01
const P2 = -2.77777777770155933842e-03
const P3 = 6.61375632143793436117e-05
const P4 = -1.65339022054652515390e-06
const P5 = 4.13813679705723846039e-08
const TWOM1000 = 9.33263618503218878990e-302

exp(x0: float) -> float {
    x = x0
    if x != x { return x + x }
    if x > O_THRESHOLD { return mem.float_from_bits(9218868437227405312 as long) }   // inf
    if x < U_THRESHOLD { return 0.0 }
    hx = magnitude(x)
    below = negative(x)
    hi = 0.0
    lo = 0.0
    k = 0
    if hx > 1071001154 {                                    // |x| > 0.5 ln2
        if hx < 1072734898 {                                // |x| < 1.5 ln2
            if below {
                hi = x + LN2_HI
                lo = 0.0 - LN2_LO
                k = 0 - 1
            } else {
                hi = x - LN2_HI
                lo = LN2_LO
                k = 1
            }
        } else {
            half = 0.5
            if below { half = 0.0 - 0.5 }
            k = (INVLN2 * x + half) as int
            t = k as float
            hi = x - t * LN2_HI
            lo = t * LN2_LO
        }
        x = hi - lo
    } else if hx < 1043333120 {                             // |x| < 2^-28
        return 1.0 + x
    }
    t = x * x
    c = x - t * (P1 + t * (P2 + t * (P3 + t * (P4 + t * P5))))
    if k == 0 { return 1.0 - ((x * c) / (c - 2.0) - x) }
    y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)
    if k >= 0 - 1021 { return mem.float_from_bits(mem.bits_of_float(y) + ((k as long) << 52)) }
    return mem.float_from_bits(mem.bits_of_float(y) + (((k + 1000) as long) << 52)) * TWOM1000
}
