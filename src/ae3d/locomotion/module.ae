// ae3d.locomotion -- a figure that walks and runs under a player's hand
// (#576): a character controller for where it goes, a figure for how it
// looks going there, and the motion between them.
//
//   c = physics.character_controller(player, 0.3, 1.8)
//   l = locomotion.attach(e, player, c, "Idle", "Walk", "Run")
//   locomotion.set_input(l, direction, running)        // every frame, from the input
//   locomotion.set_crowd(l, walkers)                   // a list of *Locomotion it steps aside for
//   locomotion.set_load(l, kg, across, ahead)          // what it carries, metres right and ahead of its middle
//   locomotion.locomotion_free(l)                      // then physics.character_free(c): the
//                                                      // controller stays the caller's
//
// The body has momentum: the velocity asked for is reached at no more than
// ACCELERATION and given up at no more than DECELERATION, metres a second
// each second, so a start leans into its first steps and a stop settles
// rather than the figure being set to speed and back.
//
// The clip follows the speed, and the speed the clip. Each clip's own
// speed is what its feet cover over a cycle (read from the clip, as the
// crowd's banks are: the root's travel, or the foot on the ground's for a
// clip made in place), so playing a clip at the body's speed over its own
// leaves the feet where they were set down. Below IDLE_BELOW the figure
// idles; above the middle of the walk's and the run's speeds it runs.
// Changing clip is inertialized (ae3d.figure.play_blended), never a cut.
//
// The facing turns toward the way the body goes at no more than TURN_RATE,
// so a turn takes the figure round over a few steps instead of spinning it
// on the spot. The hips lean: into a turn by how fast it turns at its speed
// (at most LEAN_TURN), and forward into speeding up and back into slowing
// down (at most LEAN_PITCH).
//
// Carrying something (`set_load`, #509), the figure leans away from it so the
// two keep their weight over the feet: the hips roll from a load at the side
// and pitch back from one ahead, by atan(load x its offset / (body x the
// hips' height)) -- 20 kg in a hand a quarter metre out leans a person
// 3.8 degrees -- and its top speeds fall by LOAD_SLOW of the load's share of
// the body's mass, to half at most. The body is BODY_MASS kilograms unless
// set (`set_body_mass`).
//
// In a crowd (`set_crowd`), the velocity asked for is bent so the figure
// steps aside for the others in it before the accelerations take it
// (ae3d.avoid): it goes round them at its speed, keeping right of one
// coming straight at it.
//
// A step the controller climbs at once, the body climbs over STEP_SPEED:
// the hips are carried by the difference while the capsule is already up,
// so a kerb is not a jump in the drawn figure. Feet on the world
// (ae3d.feet) finish the job where the figure has them.
import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.gltf
import ae3d.anim
import ae3d.crowd
import ae3d.posing
import ae3d.figure
import ae3d.skin
import ae3d.ik
import ae3d.physics
import ae3d.matching
import ae3d.avoid

exports (
    Locomotion,
    attach, locomotion_free, set_input, set_speeds, speed, heading, velocity, clip_now, clip_speed,
    lean_roll, lean_pitch, hips_lift, use_matching, set_crowd, set_load, set_body_mass, top_speed, hips_height,
    set_paused, paused, place,
    set_foot_lock, foot_lock, lock_offset, LOCK_BLEED, LOCK_MOST, TURN_CRAWL, TURN_STEP_PACE,
    BODY_MASS, LOAD_SLOW,
    ACCELERATION, DECELERATION, TURN_RATE, IDLE_BELOW, LEAN_TURN, LEAN_PITCH, STEP_SPEED, BLEND_SECONDS
)

const ACCELERATION = 4.0              // metres a second, each second
const DECELERATION = 6.0
const TURN_RATE = 4.0                 // radians a second
const IDLE_BELOW = 0.15               // metres a second
const LEAN_TURN = 0.21                // radians (12 degrees)
const LEAN_PITCH = 0.1                // radians (6 degrees)
const BODY_MASS = 75.0                // kilograms
// A foot on the ground stays where it was set down (#611), the drawn body
// carried round it: turned about its middle, the figure's planted foot was
// swept across the ground, 40 to 65% of the body's way through a turn
// against under 2% straight. Each frame the hips are moved by what the
// lowest foot near the ground slipped since it was set down, never more than
// LOCK_MOST metres, and the capsule takes that offset up over LOCK_BLEED
// seconds: the drawn body stays where its foot put it and the capsule comes
// to it. Bled back out of the drawn body instead, the hips carried the
// planted foot with them: on the box man a turn round slipped it 29% of the
// body's way, 0.8% now (108% unheld); a stop 235% unheld, none.
const LOCK_BLEED = 0.3
const LOCK_MOST = 0.5
const FOOT_DOWN = 0.12                // metres over the ground a foot still counts as on it
// A foot newly held only while the body goes as its clip does not, and
// held then until it lifts -- turning faster than
// LOCK_TURN radians a second, or its speed changing faster than LOCK_ACCEL
// metres a second each second: walking on straight at its pace the clip
// already sets its feet down where they stay, and held on four feet whose
// lowest changes paw to paw, the fox's drifted 3% of its way, not 0.2%.
const LOCK_TURN = 0.3
// Asked to go behind it, a figure walking at full speed turned its 180
// degrees walking backwards -- moonwalking, its feet stepping the wrong way.
// Going a way it does not face, it may go only as fast as the cosine of the
// turn to it lets, and TURN_CRAWL of its speed past a quarter turn.
const TURN_CRAWL = 0.1
// The walk's pace as it turns on the spot, stepping round.
const TURN_STEP_PACE = 0.8
const LOCK_ACCEL = 0.5
const LOAD_SLOW = 0.5                 // of the load's share of the body's mass, off the top speeds
const STEP_SPEED = 1.2                // metres a second the drawn body climbs a step at
const BLEND_SECONDS = 0.25
const SAMPLES_PER_SECOND = 120       // a clip's speed read at twice a frame's rate

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

struct Locomotion {
    engine: ptr
    object: ptr                       // *GameObject
    figure: ptr                       // *Figure
    controller: ptr                   // *CharacterController
    hips: ptr                         // *Model
    idle: string
    walk: string
    run: string
    walk_speed: float                 // metres a second the clip's feet cover at its own pace
    run_speed: float
    walk_max: float                   // the body's top speeds
    run_max: float
    input: Vec3                       // the way asked for, its length up to 1
    running: bool
    velocity: Vec3
    heading: float                    // radians about up; 0 faces +z
    playing: int                      // 0 idle, 1 walk, 2 run
    roll: float
    pitch: float
    last_speed: float
    facing: float                     // the way the clips walk, radians about up from +z, in the figure's own frame
    drawn_y: float                    // where the drawn body stands
    drawn_known: bool
    lift: float                       // how far the hips are carried this frame
    matcher: ptr                      // *Matcher posing the figure (#591), or null for a clip by speed
    // The hips' own pose, before this frame's lift and lean, and what was
    // written over it: a hips bone no clip poses keeps what was written, and
    // is given its own back before the next frame's are applied.
    hips_pos: Vec3
    hips_rot: Quat
    wrote_pos: Vec3
    wrote_rot: Quat
    wrote: bool
    behaviour: ptr
    crowd: ptr                        // a list of *Locomotion it steps aside for, or null
    feet: ptr                         // a list of *Model: the bones a walk sets down (#611)
    locking: bool
    paused: bool                      // handed to something else (a ragdoll): not stepped, posed nor moved
    aside: float                      // how far its crowd turns its way from the one asked, radians
    lock_foot: ptr                    // *Model: the foot set down, or null
    lock_at: Vec3                     // where it was set down
    lock: Vec3                        // the drawn body's offset that keeps it there
    lock_heading: float               // the heading and the speed last frame, for whether to hold
    lock_speed: float
    load_mass: float                  // kilograms carried
    load_across: float                // metres to its right of its middle
    load_ahead: float                 // metres ahead of it
    body_mass: float                  // kilograms
    hips_height: float                // the hips over the ground standing, metres: what a load leans it about
    others: ptr                       // float[others_room * 6]: the crowd's places and velocities, this step
    others_room: int
}

// Locomotion for the figure on `o`, moved by `controller`, with its idle,
// walk and run clips by name. The clips' speeds are read now: what each
// clip's feet cover over a cycle, at the figure's scale.
attach(e: *Engine, o: *GameObject, controller: *CharacterController, idle: string, walk: string, run: string) -> *Locomotion {
    fig = figure.figure_of(o)
    if fig == null || controller == null { return null }
    l = heap.new(Locomotion)
    l.engine = e as ptr
    l.object = o as ptr
    l.figure = fig as ptr
    l.controller = controller as ptr
    l.idle = string.copy(idle)
    l.walk = string.copy(walk)
    l.run = string.copy(run)
    // Read off the figure's bones in the world, so at the object's scale.
    l.walk_speed = clip_travel_speed(fig, walk)
    l.run_speed = clip_travel_speed(fig, run)
    l.facing = clip_facing(fig, o, walk)
    if l.walk_speed <= 0.0 { l.walk_speed = 1.4 }
    if l.run_speed <= l.walk_speed { l.run_speed = l.walk_speed * 2.5 }
    l.walk_max = l.walk_speed
    l.run_max = l.run_speed
    l.body_mass = BODY_MASS
    l.locking = true
    l.feet = find_feet(fig, walk)
    l.hips = find_hips(fig, walk) as ptr
    l.playing = 0
    figure.play(fig, idle, 1.0, true)
    b = engine.behaviour_new("locomotion", l as ptr)
    b.fixed_update = on_step
    b.update = on_frame
    b.pose = on_pose
    engine.engine_add_behaviour(e, b)
    l.behaviour = b as ptr
    return l
}

// A clip's speed at its own pace: what its feet cover over a cycle, over the
// cycle's length.
clip_travel_speed(fig: *Figure, name: string) -> float {
    file = fig.file as *GltfScene
    duration = gltf.animation_duration(file, name)
    if duration <= 0.0 { return 0.0 }
    // Finely: which foot is the lowest changes between samples, and a coarse
    // bake puts the change a sample early or late and the speed off by it.
    frames = (duration * SAMPLES_PER_SECOND) as int + 1
    bank = gltf.bake_bank(file, name, frames)
    if bank == null { return 0.0 }
    speed = posing.posebank_travel(bank, frames) / duration
    crowd.posebank_free(bank)
    // The bake posed the figure; the clip that plays will pose it again.
    return speed
}

// The way a clip walks, in the figure's own frame: radians about up from
// +z. Its root's way over the ground where it carries travel; for a clip
// made in place, against the way its foot on the ground goes back under it.
clip_facing(fig: *Figure, o: *GameObject, name: string) -> float {
    sk = figure.skeleton(fig)
    if sk == null { return 0.0 }
    bones = skin.skeleton_count(sk)
    file = fig.file as *GltfScene
    duration = gltf.animation_duration(file, name)
    if duration <= 0.0 || bones <= 0 { return 0.0 }
    reg = anim.registry_new()
    gltf.play(file, name, reg, true)
    samples = 48
    at = calloc((samples + 1) * bones * 3, 8)
    p = at as float[]
    k = 0
    while k <= samples {
        t = (k as float) / (samples as float) * duration
        i = 0
        while i < anim.registry_count(reg) {
            b = anim.registry_binding(reg, i)
            anim.player_set_time(anim.binding_player(b), t)
            anim.apply(anim.binding_player(b), anim.binding_model(b))
            i = i + 1
        }
        j = 0
        while j < bones {
            bone = skin.skeleton_bone(sk, j)
            core.model_sync_transform(bone)
            p[(k * bones + j) * 3] = bone.world_position.x
            p[(k * bones + j) * 3 + 1] = bone.world_position.y
            p[(k * bones + j) * 3 + 2] = bone.world_position.z
            j = j + 1
        }
        k = k + 1
    }
    anim.registry_free(reg)
    // The root's way, if it goes anywhere.
    way = core.vec3(p[samples * bones * 3] - p[0], 0.0, p[samples * bones * 3 + 2] - p[2])
    if core.v3_len(way) < 0.0001 {
        // Against the feet: the bones that rise and fall, the lowest of them
        // each frame, its way back under the body summed.
        top = 0.0 - 1000000000.0
        bottom = 1000000000.0
        j = 0
        while j < bones {
            if p[j * 3 + 1] > top { top = p[j * 3 + 1] }
            if p[j * 3 + 1] < bottom { bottom = p[j * 3 + 1] }
            j = j + 1
        }
        lift = (top - bottom) * 0.05
        back = core.vec3(0.0, 0.0, 0.0)
        k = 0
        while k < samples {
            lowest = 0 - 1
            j = 0
            while j < bones {
                low = 1000000000.0
                high = 0.0 - 1000000000.0
                kk = 0
                while kk <= samples {
                    y = p[(kk * bones + j) * 3 + 1]
                    if y < low { low = y }
                    if y > high { high = y }
                    kk = kk + 1
                }
                if high - low > lift && (lowest < 0 || p[(k * bones + j) * 3 + 1] < p[(k * bones + lowest) * 3 + 1]) { lowest = j }
                j = j + 1
            }
            if lowest >= 0 {
                from = (k * bones + lowest) * 3
                to = ((k + 1) * bones + lowest) * 3
                back = core.v3_add(back, core.vec3(p[to] - p[from], 0.0, p[to + 2] - p[from + 2]))
            }
            k = k + 1
        }
        way = core.v3_mul(back, 0.0 - 1.0)
    }
    free(at)
    if core.v3_len(way) < 0.000001 { return 0.0 }
    // Into the figure's own frame: the object's turn taken off.
    local = core.quat_apply(core.quat_conjugate(behaviour.object_world_rotation(o)), way)
    return core.atan2_of(local.x, local.z)
}

// The bone the legs hang from: by the names packs use, else the bone
// nearest the root that the walk poses -- a skin's first joint is often a
// still root above it.
// The bones a walk sets down: over a cycle of it, those that rise and fall
// by more than a twentieth of the figure's height and come within FOOT_DOWN
// of the lowest any bone goes -- the ankles and the toes.
find_feet(fig: *Figure, walk: string) -> ptr {
    out = list.new()
    sk = figure.skeleton(fig)
    if sk == null { return out }
    bones = skin.skeleton_count(sk)
    file = fig.file as *GltfScene
    duration = gltf.animation_duration(file, walk)
    if duration <= 0.0 || bones <= 0 { return out }
    reg = anim.registry_new()
    gltf.play(file, walk, reg, true)
    low = calloc(bones, 8)
    high = calloc(bones, 8)
    lo = low as float[]
    hi = high as float[]
    j = 0
    while j < bones {
        lo[j] = 1000000.0
        hi[j] = 0.0 - 1000000.0
        j = j + 1
    }
    samples = 24
    k = 0
    while k < samples {
        t = (k as float) / (samples as float) * duration
        i = 0
        while i < anim.registry_count(reg) {
            b = anim.registry_binding(reg, i)
            anim.player_set_time(anim.binding_player(b), t)
            anim.apply(anim.binding_player(b), anim.binding_model(b))
            i = i + 1
        }
        j = 0
        while j < bones {
            bone = skin.skeleton_bone(sk, j)
            core.model_sync_transform(bone)
            y = bone.world_position.y
            if y < lo[j] { lo[j] = y }
            if y > hi[j] { hi[j] = y }
            j = j + 1
        }
        k = k + 1
    }
    anim.registry_free(reg)
    bottom = 1000000.0
    top = 0.0 - 1000000.0
    j = 0
    while j < bones {
        if lo[j] < bottom { bottom = lo[j] }
        if hi[j] > top { top = hi[j] }
        j = j + 1
    }
    j = 0
    while j < bones {
        if hi[j] - lo[j] > (top - bottom) * 0.05 && lo[j] < bottom + FOOT_DOWN { list.add_raw(out, skin.skeleton_bone(sk, j) as ptr) }
        j = j + 1
    }
    free(low)
    free(high)
    return out
}

// Whether a foot on the ground stays where it was set down (#611): on by
// default.
set_foot_lock(l: *Locomotion, on: bool) {
    if l == null { return }
    l.locking = on
    if !on {
        l.lock = core.vec3(0.0, 0.0, 0.0)
        l.lock_foot = null
    }
}

foot_lock(l: *Locomotion) -> bool { return l.locking }

// The drawn body's offset from its capsule that keeps the foot down.
lock_offset(l: *Locomotion) -> Vec3 { return l.lock }

// Stood still and asked nothing: every foot is on the ground where it was
// set, and the lowest held (#611) -- not held as the clip blended to its
// idle after a stop, the planted foot slid 3.5 cm.
standing(l: *Locomotion) -> bool {
    asked = core.sqrt_of(l.input.x * l.input.x + l.input.z * l.input.z)
    return speed(l) <= IDLE_BELOW && asked <= 0.05
}

// A frame of the lock (LOCK_BLEED): the offset bled, then the lowest foot
// near the ground held where it was set down.
hold_foot(l: *Locomotion, hips: *Model, delta: float) {
    if !l.locking || l.feet == null || list.size(l.feet) == 0 || delta <= 0.0 { return }
    turning = core.abs_of(l.heading - l.lock_heading) / delta
    if turning > 3.14159265358979 / delta { turning = 0.0 }
    sp = speed(l)
    changing = core.abs_of(sp - l.lock_speed) / delta
    l.lock_heading = l.heading
    l.lock_speed = sp
    // Not turning nor changing pace, no foot is newly held; one held keeps
    // being held until it lifts.
    calm = turning < LOCK_TURN && changing < LOCK_ACCEL && !standing(l)
    o = l.object as *GameObject
    ground = behaviour.object_world_position(o).y
    lowest = null as *Model
    k = 0
    while k < list.size(l.feet) {
        f = list.get_raw(l.feet, k) as *Model
        core.model_sync_transform(f)
        if lowest == null || f.world_position.y < lowest.world_position.y { lowest = f }
        k = k + 1
    }
    if lowest == null { return }
    at = lowest.world_position
    if at.y > ground + FOOT_DOWN {
        l.lock_foot = null
        return
    }
    if l.lock_foot != lowest as ptr {
        l.lock_foot = null
        if calm { return }
        l.lock_foot = lowest as ptr
        l.lock_at = at
        return
    }
    slip = core.vec3(l.lock_at.x - at.x, 0.0, l.lock_at.z - at.z)
    want = core.v3_add(l.lock, slip)
    n = core.v3_len(want)
    if n > LOCK_MOST { want = core.v3_mul(want, LOCK_MOST / n) }
    move_world(hips, core.v3_sub(want, l.lock))
    l.lock = want
}

// A bone moved by `by` in the world.
move_world(m: *Model, by: Vec3) {
    core.model_sync_transform(m)
    world = core.v3_add(m.world_position, by)
    parent = core.model_parent(m)
    if parent == null {
        core.model_set_position(m, world.x, world.y, world.z)
        return
    }
    core.model_sync_transform(parent)
    local = core.mat4_transform_point(core.mat4_inverse(parent.model_matrix), world)
    core.model_set_position(m, local.x, local.y, local.z)
}

find_hips(fig: *Figure, walk: string) -> *Model {
    sk = figure.skeleton(fig)
    if sk == null { return null }
    i = skin.skeleton_find(sk, "Hips")
    if i < 0 { i = skin.skeleton_find(sk, "mixamorig:Hips") }
    if i < 0 { i = skin.skeleton_find(sk, "hips") }
    if i >= 0 { return skin.skeleton_bone(sk, i) }
    reg = anim.registry_new()
    gltf.play(fig.file as *GltfScene, walk, reg, true)
    best = null as *Model
    best_depth = 1000000
    k = 0
    while k < anim.registry_count(reg) {
        m = anim.binding_model(anim.registry_binding(reg, k))
        if m != null && skin_has(sk, m) {
            depth = 0
            up = m.parent as *Model
            while up != null {
                depth = depth + 1
                up = up.parent as *Model
            }
            if depth < best_depth {
                best_depth = depth
                best = m
            }
        }
        k = k + 1
    }
    anim.registry_free(reg)
    if best != null { return best }
    return skin.skeleton_bone(sk, 0)
}

skin_has(sk: *Skeleton, m: *Model) -> bool {
    i = 0
    while i < skin.skeleton_count(sk) {
        if skin.skeleton_bone(sk, i) == m { return true }
        i = i + 1
    }
    return false
}

// From now on the figure is posed by motion matching over `db` (#586),
// built from the figure's clips against its object's model, rather than
// idle, walk or run chosen by speed (#591). The controller still moves it.
use_matching(l: *Locomotion, db: *Database) {
    if l.matcher != null { matching.matcher_free(l.matcher as *Matcher) }
    l.matcher = matching.matcher_new(db) as ptr
}

locomotion_free(l: *Locomotion) {
    if l == null { return }
    if l.feet != null { list.free(l.feet) }
    if l.matcher != null { matching.matcher_free(l.matcher as *Matcher) }
    if l.others != null { free(l.others) }
    e = l.engine as *Engine
    // Out of the engine's list, the step is ours to free: the engine frees
    // only the behaviours it still holds.
    if e != null && l.behaviour != null {
        engine.engine_remove_behaviour(e, l.behaviour as *Behaviour)
        heap.free(l.behaviour as *Behaviour)
        l.behaviour = null
    }
    heap.free(l)
}

// The way to go, in the world (its length 0 to 1, a stick's deflection),
// and whether to run.
set_input(l: *Locomotion, direction: Vec3, running: bool) {
    if l == null { return }
    d = core.vec3(direction.x, 0.0, direction.z)
    n = core.v3_len(d)
    if n > 1.0 { d = core.v3_mul(d, 1.0 / n) }
    l.input = d
    l.running = running
}

// The body's top walking and running speeds (the clips' own unless set).
set_speeds(l: *Locomotion, walk: float, run: float) {
    l.walk_max = walk
    l.run_max = run
}

// What it carries: `kg`, `across` metres to its right of its middle and
// `ahead` metres in front of it. 0 kg for nothing.
set_load(l: *Locomotion, kg: float, across: float, ahead: float) {
    if l == null { return }
    l.load_mass = kg
    if l.load_mass < 0.0 { l.load_mass = 0.0 }
    l.load_across = across
    l.load_ahead = ahead
}

// The hips' height over the ground standing, read on the first frame.
hips_height(l: *Locomotion) -> float { return l.hips_height }

set_body_mass(l: *Locomotion, kg: float) {
    if l == null || kg <= 0.0 { return }
    l.body_mass = kg
}

// The top speed it may go now: the walk's or the run's, slowed by what it
// carries.
top_speed(l: *Locomotion) -> float {
    top = l.walk_max
    if l.running { top = l.run_max }
    if l.load_mass > 0.0 {
        slow = 1.0 - LOAD_SLOW * l.load_mass / l.body_mass
        if slow < 0.5 { slow = 0.5 }
        top = top * slow
    }
    return top
}

// The lean a load asks, (roll, pitch) radians: away from it.
load_roll(l: *Locomotion) -> float {
    if l.load_mass <= 0.0 || l.hips_height <= 0.0 { return 0.0 }
    return core.atan2_of(l.load_mass * l.load_across, l.body_mass * l.hips_height)
}

load_pitch(l: *Locomotion) -> float {
    if l.load_mass <= 0.0 || l.hips_height <= 0.0 { return 0.0 }
    return 0.0 - core.atan2_of(l.load_mass * l.load_ahead, l.body_mass * l.hips_height)
}

speed(l: *Locomotion) -> float { return core.v3_len(core.vec3(l.velocity.x, 0.0, l.velocity.z)) }
heading(l: *Locomotion) -> float { return l.heading }
velocity(l: *Locomotion) -> Vec3 { return l.velocity }
clip_now(l: *Locomotion) -> int { return l.playing }
lean_roll(l: *Locomotion) -> float { return l.roll }
lean_pitch(l: *Locomotion) -> float { return l.pitch }
hips_lift(l: *Locomotion) -> float { return l.lift }

// A clip's own speed: 1 the walk, 2 the run.
clip_speed(l: *Locomotion, which: int) -> float {
    if which == 1 { return l.walk_speed }
    if which == 2 { return l.run_speed }
    return 0.0
}

clamp(x: float, low: float, high: float) -> float {
    if x < low { return low }
    if x > high { return high }
    return x
}

toward(now: float, wanted: float, most: float) -> float {
    if now < wanted {
        moved = now + most
        if moved > wanted { return wanted }
        return moved
    }
    moved = now - most
    if moved < wanted { return wanted }
    return moved
}

// The figures it steps aside for (ae3d.avoid): a std.list of *Locomotion,
// itself among them or not, which the caller keeps; null for none.
// Handed over (#509): paused, its figure is another's to pose -- an active
// ragdoll knocked down -- and its capsule another's to move: no input
// taken, no step, no clip chosen, no hips written. Taken up again, it goes
// on from standing, its foot hold let go; `place` it first where the body
// it was handed to stands.
set_paused(l: *Locomotion, on: bool) {
    if l == null { return }
    l.paused = on
    l.velocity = core.vec3(0.0, 0.0, 0.0)
    l.lock = core.vec3(0.0, 0.0, 0.0)
    l.lock_foot = null
    l.wrote = false
    // Taken up again by matching, it searches afresh: the frame it was
    // playing when paused is not what the figure's clip is at now -- a
    // ragdoll and its get-up had it -- and followed on from there, it
    // blended from a pose not on the screen, a planted foot turned under it
    // and its toe swept 30 cm (#509).
    if !on && l.matcher != null { (l.matcher as *Matcher).frame = 0 - 1 }
}

paused(l: *Locomotion) -> bool { return l.paused }

// Its capsule stood at `at` and its figure facing `yaw` about up (the
// object's own turn, as behaviour.object_set_rotation sets it): where a
// body handed back stands.
place(l: *Locomotion, at: Vec3, yaw: float) {
    if l == null { return }
    o = l.object as *GameObject
    behaviour.object_set_position(o, at)
    l.heading = yaw + l.facing
    l.lock_heading = l.heading
    behaviour.object_set_rotation(o, core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)))
}

set_crowd(l: *Locomotion, walkers: ptr) {
    if l == null { return }
    l.crowd = walkers
}

// The velocity asked for, bent aside for the crowd.
crowd_aside(l: *Locomotion, wanted: Vec3, step: float) -> Vec3 {
    n = list.size(l.crowd)
    if n <= 1 { return wanted }
    if l.others_room < n {
        if l.others != null { free(l.others) }
        l.others = calloc(n * 6, 8)
        l.others_room = n
    }
    o = l.others as float[]
    count = 0
    i = 0
    while i < n {
        other = list.get_raw(l.crowd, i) as *Locomotion
        if other != l && other != null {
            at = behaviour.object_world_position(other.object as *GameObject)
            o[count * 6] = at.x
            o[count * 6 + 1] = at.y
            o[count * 6 + 2] = at.z
            o[count * 6 + 3] = other.velocity.x
            o[count * 6 + 4] = 0.0
            o[count * 6 + 5] = other.velocity.z
            count = count + 1
        }
        i = i + 1
    }
    here = behaviour.object_world_position(l.object as *GameObject)
    return avoid.aside(here, l.velocity, wanted, l.others, count, avoid.RADIUS, step)
}

// A fixed step: the velocity toward what is asked, bent aside for the
// crowd, within the body's acceleration, and the controller moved by it.
on_step(state: ptr, e: *Engine, step: float) {
    l = state as *Locomotion
    if l.paused { return }
    // The way it faces, at what is asked of it: it walks the arc its turn
    // makes, not crabbing straight at where it is going while still turned
    // from it -- its clip's feet step back along the way it faces, and the
    // body going another way swept the foot on the ground over it (#611).
    asked = core.sqrt_of(l.input.x * l.input.x + l.input.z * l.input.z)
    ahead = core.vec3(core.sin_of(l.heading), 0.0, core.cos_of(l.heading))
    wanted = core.v3_mul(ahead, asked * top_speed(l) * facing_share(l))
    if l.crowd != null {
        bent = crowd_aside(l, wanted, step)
        // The figure turns as its way is bent: stepping aside it faces the
        // way it goes, not crabbing past with its clip stepping straight
        // on -- in a crowd of 200 on the plaza, 310 of 334 stances that
        // slid over a centimetre were walkers going aside, not turning.
        l.aside = 0.0
        if core.v3_len(bent) > 0.05 && core.v3_len(wanted) > 0.05 {
            l.aside = wrap_turn(core.atan2_of(bent.x, bent.z) - core.atan2_of(wanted.x, wanted.z))
        }
        wanted = bent
    }
    dx = wanted.x - l.velocity.x
    dz = wanted.z - l.velocity.z
    change = core.sqrt_of(dx * dx + dz * dz)
    // Speeding up or slowing down: which limit holds.
    now_speed = core.sqrt_of(l.velocity.x * l.velocity.x + l.velocity.z * l.velocity.z)
    wanted_speed = core.sqrt_of(wanted.x * wanted.x + wanted.z * wanted.z)
    limit = ACCELERATION
    if wanted_speed < now_speed { limit = DECELERATION }
    most = limit * step
    if change > most && change > 0.0 {
        dx = dx * most / change
        dz = dz * most / change
    }
    l.velocity = core.vec3(l.velocity.x + dx, 0.0, l.velocity.z + dz)
    // The foot hold's offset taken up by the capsule, not bled out of the
    // drawn body: the body stays where its planted foot put it and the
    // capsule comes to it -- bled back to the capsule, the hips carried the
    // planted foot with them and it slid (#611, #509: a turn on the spot
    // pivots on a foot).
    moved = l.velocity
    if l.locking {
        taken = core.v3_mul(l.lock, step / LOCK_BLEED)
        if step >= LOCK_BLEED { taken = l.lock }
        l.lock = core.v3_sub(l.lock, taken)
        moved = core.v3_add(moved, core.v3_mul(taken, 1.0 / step))
    }
    physics.character_move(l.controller as *CharacterController, moved, 0.0, step)
}

// How much of its speed it may go the way it is asked, as it faces: all of
// it ahead, by the cosine of the turn to it short of a quarter turn, and
// TURN_CRAWL past that -- it turns round before it walks off (#611).
facing_share(l: *Locomotion) -> float {
    n = core.sqrt_of(l.input.x * l.input.x + l.input.z * l.input.z)
    if n < 0.0001 { return 1.0 }
    c = (l.input.x * core.sin_of(l.heading) + l.input.z * core.cos_of(l.heading)) / n
    if c < TURN_CRAWL { return TURN_CRAWL }
    return c
}

wrap_turn(a: float) -> float {
    t = a
    while t > 3.14159265 { t = t - 6.2831853 }
    while t < 0.0 - 3.14159265 { t = t + 6.2831853 }
    return t
}

// A frame: the facing turned, the clip chosen and paced, the lean worked out.
on_frame(state: ptr, e: *Engine, delta: float) {
    l = state as *Locomotion
    if l.paused { return }
    fig = l.figure as *Figure
    o = l.object as *GameObject
    sp = speed(l)
    before = l.heading
    asked = core.sqrt_of(l.input.x * l.input.x + l.input.z * l.input.z)
    spinning = false
    if sp > IDLE_BELOW || asked > 0.05 {
        // Toward where it is asked to go, when it is; else the way it goes.
        wanted = core.atan2_of(l.velocity.x, l.velocity.z)
        if asked > 0.05 { wanted = core.atan2_of(l.input.x, l.input.z) + l.aside }
        d = wanted - l.heading
        while d > 3.14159265 { d = d - 6.2831853 }
        while d < 0.0 - 3.14159265 { d = d + 6.2831853 }
        most = TURN_RATE * delta
        if d > most { d = most }
        if d < 0.0 - most { d = 0.0 - most }
        l.heading = l.heading + d
        spinning = core.abs_of(d) > most * 0.5
    }
    // The figure turned so the way its clips walk is the heading.
    behaviour.object_set_rotation(o, core.quat_rotate(l.heading - l.facing, core.vec3(0.0, 1.0, 0.0)))
    // The clip for the speed, and its pace so its feet cover what the body does.
    which = 0
    if sp > IDLE_BELOW || spinning {
        which = 1
        if sp > (l.walk_speed + l.run_speed) * 0.5 { which = 2 }
    }
    if l.matcher != null {
        // Posed by motion matching (#591): told where the controller has
        // the body, how it moves and what is asked, the database's moment
        // that fits is played, at the body's pace.
        top = top_speed(l)
        matching.follow(l.matcher as *Matcher, behaviour.object_world_position(o), l.velocity, core.v3_mul(l.input, top),
                        l.heading, delta)
        which = l.playing
    }
    if which != l.playing {
        name = l.idle
        if which == 1 { name = l.walk }
        if which == 2 { name = l.run }
        figure.play_blended(fig, name, 1.0, true, BLEND_SECONDS)
        l.playing = which
    }
    if l.matcher == null {
        // Turning on the spot it steps round: on the idle's one planted foot
        // the body swung about it, the lock 2.5 cm further off each frame
        // till it gave and the foot slid (#611).
        if which == 1 && spinning && sp < l.walk_speed * TURN_STEP_PACE { figure.set_speed(fig, TURN_STEP_PACE) }
        if which == 1 && !(spinning && sp < l.walk_speed * TURN_STEP_PACE) { figure.set_speed(fig, sp / l.walk_speed) }
        if which == 2 { figure.set_speed(fig, sp / l.run_speed) }
        if which == 0 { figure.set_speed(fig, 1.0) }
    }
    // The hips' height over the ground, read once: what a load leans it about.
    if l.hips_height <= 0.0 && l.hips != null {
        core.model_sync_transform(l.hips as *Model)
        l.hips_height = (l.hips as *Model).world_position.y - behaviour.object_world_position(o).y
    }
    // The lean: into the turn by how fast it turns at its speed, with the
    // change of speed, and away from what it carries.
    if delta > 0.0 {
        turning = (l.heading - before) / delta
        roll_wanted = clamp(turning * sp * 0.08, 0.0 - LEAN_TURN, LEAN_TURN) + load_roll(l)
        pitch_wanted = clamp((sp - l.last_speed) / delta * 0.04, 0.0 - LEAN_PITCH, LEAN_PITCH) + load_pitch(l)
        l.roll = toward(l.roll, roll_wanted, 1.5 * delta)
        l.pitch = toward(l.pitch, pitch_wanted, 1.5 * delta)
    }
    l.last_speed = sp
    // The drawn body eased up a step the capsule took at once.
    y = behaviour.object_world_position(o).y
    if !l.drawn_known {
        l.drawn_y = y
        l.drawn_known = true
    }
    l.drawn_y = toward(l.drawn_y, y, STEP_SPEED * delta)
    if l.drawn_y < y - 0.5 || l.drawn_y > y + 0.5 { l.drawn_y = y }
    l.lift = l.drawn_y - y
}

// The pose phase: the hips carried down to where the drawn body is and
// leaned.
on_pose(state: ptr, e: *Engine) {
    l = state as *Locomotion
    hips = l.hips as *Model
    if hips == null { return }
    if l.paused {
        // Not its pose to give back when it is taken up again: whatever
        // posed it meanwhile wrote the hips.
        l.wrote = false
        return
    }
    // The hips' own pose: what the clip wrote this frame, or, where nothing
    // did, what they had before last frame's lift and lean -- the place and
    // the turn each on its own: a walk that keys the hips' height but not
    // their turn had last frame's lean kept and leant on again, frame on
    // frame, until the figure stood on its head (#611).
    if l.wrote && same_v(hips.position, l.wrote_pos) {
        core.model_set_position(hips, l.hips_pos.x, l.hips_pos.y, l.hips_pos.z)
    }
    if l.wrote && same_q(hips.rotation, l.wrote_rot) {
        core.model_set_rotation(hips, l.hips_rot)
    }
    l.hips_pos = hips.position
    l.hips_rot = hips.rotation
    if l.locking {
        if l.lock.x != 0.0 || l.lock.z != 0.0 { move_world(hips, l.lock) }
    }
    if l.lift != 0.0 {
        core.model_sync_transform(hips)
        world = core.v3_add(hips.world_position, core.vec3(0.0, l.lift, 0.0))
        parent = core.model_parent(hips)
        if parent == null {
            core.model_set_position(hips, world.x, world.y, world.z)
        } else {
            core.model_sync_transform(parent)
            local = core.mat4_transform_point(core.mat4_inverse(parent.model_matrix), world)
            core.model_set_position(hips, local.x, local.y, local.z)
        }
    }
    if l.roll != 0.0 || l.pitch != 0.0 {
        forward = core.vec3(core.sin_of(l.heading), 0.0, core.cos_of(l.heading))
        side = core.vec3(forward.z, 0.0, 0.0 - forward.x)
        lean = core.quat_mul(core.quat_rotate(0.0 - l.roll, forward), core.quat_rotate(l.pitch, side))
        ik.turn_world(hips, core.quat_normalize(lean))
    }
    hold_foot(l, hips, engine.engine_delta_time(e))
    l.wrote_pos = hips.position
    l.wrote_rot = hips.rotation
    l.wrote = true
}

same_v(a: Vec3, b: Vec3) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z }
same_q(a: Quat, b: Quat) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w }
