// Clips for a rig (#853, layer 1).
//
// A take is one animation of a file resampled for a rig: every joint's local
// transform at a fixed rate, laid out as poses one after another, so a sample
// is two frames and a blend with no key search. glTF stores an animation as
// keys per node, each node on its own clock; resampled at the file's own key
// rate a take is exact at its frames and, between them, within the nlerp of a
// thirtieth of a second of motion.
//
// What the engine needs to know about a clip is read from it once, as it is
// made, the way a shipped engine finds it at import:
//   - root motion: where the root (the UE5 skeleton's `root`, the pelvis
//     where there is none) travels and turns over the ground, taken out of
//     the poses and kept beside them, so the game moves the figure by it or
//     plays the clip in place;
//   - foot contacts: each foot down while its sole is within CONTACT_UP of
//     the lowest it comes, so foot placement locks it and a blend can keep
//     two gaits' feet in step;
//   - its speed over the ground: its root's, or for a clip made in place,
//     its stance feet's, which carry the ground backwards under it at that
//     speed; a locomotion blend plays the clips at the pace the figure moves.

import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.anim
import ae3d.gltf
import ae3d.pose

exports (
    Take, CONTACT_UP,
    from_scene, from_frames, take_free, name, frames, rate, duration, looping, set_looping, mirror, seal_loop, straighten,
    loop_cut, crop, travel_length, distance_at, speed_at, time_at_distance, time_at_distance_left, moving_at, still_at, calmest, braking, braking_speed,
    add_event, event_count, event_time, event_name, event_found, FOOT_LEFT, FOOT_RIGHT,
    frame, sample, sample_frame, extract_root, root_under_pelvis, root_joint, travel, root_delta, has_root_motion,
    contact, planted, find_contacts, contacts_like, speed, even_root, foot_down, phase_of, time_at_phase, time_of, ground_point, up_of, heading,
    ground_carry,
    compress, compressed, compress_error, take_bytes, track_kinds, keys_kept, COMPRESS_ERROR
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr

// Metres over its lowest a foot's sole may be and count as down.
const CONTACT_UP = 0.03
// Flat frames (both feet, the whole take) under which a take is taken to run
// on its balls.
const FLAT_LEAST = 6
// A take whose root travels less than this over its length is in place.
const MOVES = 0.05
// And a pelvis that ends this far from where it began carries the take.
const TRAVELS = 0.25
// A planted foot moves with the ground: its ball within SLIP_SPEED metres a
// second of the ground's speed, or SLIP_SHARE of it for a fast take.
const SLIP_SPEED = 0.25
const SLIP_SHARE = 0.15
// A loop whose ends are farther apart than this at any joint (radians) was
// not made to loop, and is left as it is.
const LOOP_GAP = 0.175
// The shortest loop loop_cut cuts, seconds.
const LOOP_LEAST = 0.6
// Seconds a root's stand or move holds for moving_at to read it as one.
const MOVE_HELD = 0.1
// Seconds about a time speed_at reads a root's pace over.
const SPEED_SPAN = 0.1
// The events found at import: a foot coming down.
const FOOT_LEFT = "foot_l"
const FOOT_RIGHT = "foot_r"

// A named moment of a take (a footfall, a blow landing, a cup at the lips),
// fired by the animator as its clock passes it.
struct Event {
    at: float                      // seconds into the take
    name: string
    found: bool                    // found at import (a footfall), not added by a program
}

struct Take {
    name: string
    count: int                     // the rig's joints
    frames: int
    rate: float                    // frames a second
    duration: float                // seconds, (frames - 1) / rate
    looping: bool
    data: ptr                      // float[frames * stride]
    stride: int                    // a frame's floats: the rig's pose size, its curves (#910) after its joints
    root: int                      // the joint its root motion was taken from, -1 none
    motion: ptr                    // float[frames * 4]: the root's x, z and yaw from frame 0, and its y
    contacts: ptr                  // float[frames * 2]: left and right foot down (1) or not (0)
    flat: ptr                      // float[frames * 2]: left and right foot planted, flat or on its ball (see planted)
    speed: float                   // metres a second over the ground
    left_down: float               // seconds the left foot first comes down, -1 when it never does
    right_down: float
    heading: Vec3                  // the way it carries the figure over the ground (unit, x and z), at rest
    events: ptr                    // list of *Event, in order of time
    pivot: Vec3                    // where its root was held (frame 0's place), in the rig's space
    up: Vec3                       // the rig's up its root motion was taken about
    travels: bool                  // its root travels in its frames (see find_contacts)
    under_pelvis: bool             // its root motion taken from its pelvis (root_under_pelvis)
    packed: ptr                    // *Packed: its frames compressed (compress), `data` null; or null
}

// --- making -------------------------------------------------------------------------------------

// Animation `animation` of `scene` resampled for `rig` at `per_second`
// frames a second (0: the file's own key rate, at least 24). Joints the
// animation does not drive hold their rest pose. Null when the scene has no
// animation by that name.
from_scene(rig: *Rig, scene: *GltfScene, animation: string, per_second: float) -> *Take {
    n = pose.count(rig)
    driven = calloc(n, 8) as ptr[]
    prefix = string.concat(animation, ":")
    any = false
    longest = 0.0
    finest = 1000.0
    i = 0
    while i < gltf.clip_count(scene) {
        c = gltf.clip(scene, i)
        if string.starts_with(anim.clip_name(c), prefix) == 1 {
            node = gltf.clip_node(scene, i)
            j = 0
            while j < n {
                if pose.joint(rig, j) == node { driven[j] = c as ptr }
                j = j + 1
            }
            any = true
            if anim.clip_duration(c) > longest { longest = anim.clip_duration(c) }
            gap = key_gap(c)
            if gap > 0.0 && gap < finest { finest = gap }
        }
        i = i + 1
    }
    string.free(prefix)
    if !any {
        free(driven as ptr)
        return null
    }
    r = per_second
    if r <= 0.0 {
        r = 30.0
        if finest < 1000.0 { r = 1.0 / finest }
        if r < 24.0 { r = 24.0 }
        if r > 120.0 { r = 120.0 }
    }
    count = (longest * r + 0.5) as int + 1
    t = blank_take(rig, animation, count, r)
    t.duration = longest
    // The rig's curves (#910): each from the weights channel of the clip
    // driving its model, where the animation has one; at rest otherwise.
    curves = pose.curve_count(rig)
    weighed = calloc(curves + 1, 8) as ptr[]
    prefix2 = string.concat(animation, ":")
    i = 0
    while i < gltf.clip_count(scene) {
        c = gltf.clip(scene, i)
        if string.starts_with(anim.clip_name(c), prefix2) == 1 {
            node = gltf.clip_node(scene, i)
            k = 0
            while k < curves {
                if pose.curve_model(rig, k) == node && weights_channel(c) != null { weighed[k] = c as ptr }
                k = k + 1
            }
        }
        i = i + 1
    }
    string.free(prefix2)
    f = 0
    while f < count {
        at = (f as float) / r
        if at > longest { at = longest }
        p = frame(t, f)
        pose.rest_pose(rig, p)
        j = 0
        while j < n {
            if driven[j] != null { sample_joint(driven[j] as *Clip, at, p, j) }
            j = j + 1
        }
        k = 0
        while k < curves {
            if weighed[k] != null { sample_curve(weighed[k] as *Clip, rig, at, p, k) }
            k = k + 1
        }
        f = f + 1
    }
    free(weighed as ptr)
    free(driven as ptr)
    if t.looping { _sealed = seal_loop(t, rig) }
    find_contacts(t, rig)
    return t
}

// A take of `count` frames at `per_second`, every frame the rest pose: one a
// program fills itself (a retarget, a capture).
from_frames(rig: *Rig, title: string, count: int, per_second: float) -> *Take {
    t = blank_take(rig, title, count, per_second)
    f = 0
    while f < count {
        pose.rest_pose(rig, frame(t, f))
        f = f + 1
    }
    return t
}

blank_take(rig: *Rig, title: string, count: int, per_second: float) -> *Take {
    t = heap.new(Take)
    t.name = string.copy(title)
    t.count = pose.count(rig)
    t.frames = count
    t.rate = per_second
    t.duration = ((count - 1) as float) / per_second
    t.looping = string.contains(title, "Loop") == 1
    t.stride = pose.size(rig)
    t.data = calloc(count * t.stride + 1, 8)
    t.root = 0 - 1
    t.motion = calloc(count * 4, 8)
    t.contacts = calloc(count * 2, 8)
    t.flat = calloc(count * 2, 8)
    t.events = list.new()
    t.left_down = 0.0 - 1.0
    t.right_down = 0.0 - 1.0
    return t
}

take_free(t: *Take) {
    if t == null { return }
    if t.data != null { free(t.data) }
    packed_free(t.packed as *Packed)
    free(t.motion)
    free(t.contacts)
    free(t.flat)
    i = 0
    while i < list.size(t.events) {
        ev = list.get_raw(t.events, i) as *Event
        string.free(ev.name)
        heap.free(ev)
        i = i + 1
    }
    list.free(t.events)
    string.free(t.name)
    heap.free(t)
}

// The smallest gap between two keys of any of the clip's channels.
key_gap(c: *Clip) -> float {
    best = 0.0
    k = 0
    while k < anim.clip_channel_count(c) {
        ch = anim.clip_channel(c, k)
        keys = anim.channel_key_count(ch)
        if keys > 1 {
            gap = anim.channel_duration(ch) / ((keys - 1) as float)
            if best <= 0.0 || gap < best { best = gap }
        }
        k = k + 1
    }
    return best
}

// Joint `j` of pose `p` from clip `c` at `at` seconds, channel by channel.
sample_joint(c: *Clip, at: float, p: ptr, j: int) {
    k = 0
    while k < anim.clip_channel_count(c) {
        ch = anim.clip_channel(c, k)
        target = anim.channel_target(ch)
        if target == anim.TRANSLATION { pose.set_translation(p, j, anim.sample_vec3(ch, at)) }
        if target == anim.ROTATION { pose.set_rotation(p, j, core.quat_normalize(anim.sample_quat(ch, at))) }
        if target == anim.SCALE { pose.set_scale(p, j, anim.sample_vec3(ch, at)) }
        k = k + 1
    }
}

// The clip's morph weights channel (#910), null for none.
weights_channel(c: *Clip) -> *AnimChannel {
    k = 0
    while k < anim.clip_channel_count(c) {
        ch = anim.clip_channel(c, k)
        if anim.channel_target(ch) == anim.WEIGHTS { return ch }
        k = k + 1
    }
    return null
}

// Curve `k` of pose `p` from clip `c`'s weights channel at `at` seconds:
// the weight of the morph target the curve drives.
sample_curve(c: *Clip, rig: *Rig, at: float, p: ptr, k: int) {
    ch = weights_channel(c)
    target = pose.curve_target(rig, k)
    if ch == null || target < 0 || target >= anim.channel_width(ch) { return }
    values = calloc(anim.channel_width(ch), 8)
    anim.sample_weights(ch, at, values)
    pose.set_curve(rig, p, k, (values as float[])[target])
    free(values)
}

// --- reading ------------------------------------------------------------------------------------

name(t: *Take) -> string { return t.name }
frames(t: *Take) -> int { return t.frames }
rate(t: *Take) -> float { return t.rate }
duration(t: *Take) -> float { return t.duration }
looping(t: *Take) -> bool { return t.looping }
set_looping(t: *Take, on: bool) { t.looping = on }
speed(t: *Take) -> float { return t.speed }
root_joint(t: *Take) -> int { return t.root }
has_root_motion(t: *Take) -> bool { return t.root >= 0 }

// Frame `f`'s pose, in place in the take, to read or to write. A
// compressed take has its frames back as they were decoded, and is no
// longer compressed: what only reads a take's poses reads them through
// sample and sample_frame.
frame(t: *Take, f: int) -> ptr {
    if t.packed != null { unpack(t) }
    k = f
    if k < 0 { k = 0 }
    if k >= t.frames { k = t.frames - 1 }
    return t.data + k * t.stride * 8
}

// The time `at` seconds into the take: wrapped into its length when it
// loops, held at its ends when not.
time_of(t: *Take, at: float, loop: bool) -> float {
    if t.duration <= 0.0 { return 0.0 }
    if loop {
        x = at - t.duration * floor_of(at / t.duration)
        if x >= t.duration { x = 0.0 }
        return x
    }
    if at < 0.0 { return 0.0 }
    if at > t.duration { return t.duration }
    return at
}

floor_of(x: float) -> float {
    i = x as int
    f = i as float
    if f > x { f = f - 1.0 }
    return f
}

// The take's pose `at` seconds in, into `out`: the two frames around it
// blended. Looping, the last frame runs into the first (a loop's last frame
// is its first again).
sample(t: *Take, rig: *Rig, at: float, loop: bool, out: ptr) {
    x = time_of(t, at, loop) * t.rate
    f0 = x as int
    if f0 >= t.frames - 1 {
        sample_frame(t, rig, t.frames - 1, out)
        return
    }
    u = x - (f0 as float)
    if t.packed != null {
        packed_blend(t, f0, u, out)
        return
    }
    pose.blend(rig, frame(t, f0), frame(t, f0 + 1), u, out)
}

// Frame `f`'s pose into `out`.
sample_frame(t: *Take, rig: *Rig, f: int, out: ptr) {
    if t.packed != null {
        packed_frame(t, f, out)
        return
    }
    pose.copy(rig, frame(t, f), out)
}

// The take's phase at `at` seconds, 0 to 1, by its feet: 0 as its left foot
// first comes down, 0.5 as its right does, back to 1 at the left's next. A
// locomotion blend plays its takes at one phase, so every take's left foot
// comes down together and every right foot does too, whatever their steps'
// lengths (sync markers, as a shipped engine's blend spaces keep them).
// Synced by the left foot alone, a jog and a sprint blended put their right
// feet down a few frames apart, and the blended foot slid between them. A
// take with no footfalls runs its phase evenly from its start.
phase_of(t: *Take, at: float) -> float {
    if t.duration <= 0.0 { return 0.0 }
    left, right = markers(t)
    x = at - t.duration * floor_of(at / t.duration)
    if x < left { x = x + t.duration }
    if x < right { return 0.5 * (x - left) / (right - left) }
    return 0.5 + 0.5 * (x - right) / (left + t.duration - right)
}

// The time in the take at `phase` (phase_of the other way).
time_at_phase(t: *Take, phase: float) -> float {
    if t.duration <= 0.0 { return 0.0 }
    left, right = markers(t)
    p = phase - floor_of(phase)
    x = 0.0
    if p < 0.5 {
        x = left + (p / 0.5) * (right - left)
    } else {
        x = right + ((p - 0.5) / 0.5) * (left + t.duration - right)
    }
    return time_of(t, x, true)
}

// Its left and right footfalls as times, the right after the left within a
// cycle; for a take without them, its start and its middle.
markers(t: *Take) -> (float, float) {
    left = t.left_down
    right = t.right_down
    if left < 0.0 || right < 0.0 || left == right {
        left = 0.0
        if t.left_down >= 0.0 { left = t.left_down }
        return left, left + t.duration * 0.5
    }
    if right < left { right = right + t.duration }
    return left, right
}

// Root motion taken out: the root joint's travel over the ground and its
// turn about up, kept per frame as offsets from frame 0, and the joint held
// over its rest place in every frame (frame 0's height, its own tilt kept),
// turned to face the rig's forward as it does at rest (Unreal's root lock
// to the reference pose): the figure is drawn on its object, and its travel
// is along its own facing. A capture's first frame stands and faces wherever
// the actor was in the volume: held there, its figure was drawn 8 m from its
// object, and 100STYLE's backward walk took it off 45 degrees from its back.
// The turn is the root's twist about up, whatever its own axes are (the
// UE5 root's forward axis points up, and read off that its turn was 0).
// The root is the rig's `root` where it moves, otherwise its pelvis, which
// carries its travel only. Nothing is taken from a take whose root travels
// less than MOVES: it is already in place. `up` is the rig's up in its own
// space (the armature's).
extract_root(t: *Take, rig: *Rig, up: Vec3) {
    joint = pick_root(t, rig)
    if joint < 0 { return }
    turns = joint == pose.human(rig, pose.ROOT)
    first_t = pose.translation(frame(t, 0), joint)
    // Where it is held: over the rest pose's place, at frame 0's height.
    rest_t = pose.translation(pose.rest(rig), joint)
    held = core.v3_add(core.v3_sub(rest_t, core.v3_mul(up, core.v3_dot(rest_t, up))), core.v3_mul(up, core.v3_dot(first_t, up)))
    first_q = pose.rotation(frame(t, 0), joint)
    // Frame 0's heading against the rest pose's: what the root lock takes off.
    facing0 = 0.0
    if turns { facing0 = wrap_angle(twist_about(core.quat_mul(first_q, core.quat_conjugate(pose.rotation(pose.rest(rig), joint))), up)) }
    unface = core.quat_rotate(0.0 - facing0, up)
    m = t.motion as float[]
    f = 0
    while f < t.frames {
        p = frame(t, f)
        tr = pose.translation(p, joint)
        q = pose.rotation(p, joint)
        d = core.v3_sub(tr, first_t)
        rise = core.v3_dot(d, up)
        flat = core.quat_apply(unface, core.v3_sub(d, core.v3_mul(up, rise)))
        turn = 0.0
        if turns { turn = wrap_angle(twist_about(core.quat_mul(q, core.quat_conjugate(first_q)), up)) }
        m[f * 4] = flat.x
        m[f * 4 + 1] = flat.z
        m[f * 4 + 2] = turn
        m[f * 4 + 3] = rise
        // Held at frame 0's place over the ground, facing as at rest.
        pose.set_translation(p, joint, core.v3_add(held, core.v3_mul(up, rise)))
        pose.set_rotation(p, joint, core.quat_normalize(core.quat_mul(core.quat_rotate(0.0 - turn - facing0, up), q)))
        f = f + 1
    }
    t.root = joint
    t.pivot = core.vec3(held.x, held.y, held.z)
    t.up = up
    from_root(t, rig)
}

// A looping take's travel made even: its root goes from its first frame's
// place to its last's at one speed, and what it swayed about that line
// (slowing over each planted foot, hurrying between, side to side) moves
// into the pose. A root that follows the pelvis frame by frame carries that
// sway, and a figure moved at an even speed (a mover) played it as its
// planted foot sliding: a 0.8 m/s walk's 40 to 70 mm a stance (#970). The
// world the take draws is the same, frame by frame; only what is travel and
// what is pose changes. For a loop only: a start's or a stop's root speeds
// up or slows down for real, and evened its body was drawn up to 0.3 m off
// its capsule.
even_root(t: *Take) {
    if t == null || t.root < 0 || t.frames < 3 { return }
    m = t.motion as float[]
    last = (t.frames - 1) * 4
    f = 0
    while f < t.frames {
        u = (f as float) / ((t.frames - 1) as float)
        ex = m[0] + (m[last] - m[0]) * u
        ez = m[1] + (m[last + 1] - m[1]) * u
        // Into the pose's frame: it is turned back by its root's turn.
        off = core.quat_apply(core.quat_rotate(0.0 - m[f * 4 + 2], t.up), core.vec3(m[f * 4] - ex, 0.0, m[f * 4 + 1] - ez))
        p = frame(t, f)
        pose.set_translation(p, t.root, core.v3_add(pose.translation(p, t.root), off))
        m[f * 4] = ex
        m[f * 4 + 1] = ez
        f = f + 1
    }
}

// The take's root motion taken from where its pelvis is over the ground
// (#859), as Unity's root motion is taken from the centre of mass: in every
// frame the pelvis drawn over the object, and the root carrying what the
// pelvis travels, its turn kept. For a take whose body moves over a still
// root (a get-up from the ground, UE5's root left where the figure lay):
// rooted at the root, the figure's capsule stood 0.24 m from the pelvis
// LayToIdle starts with, and the pelvis came over it only once up. The
// world the take draws is the same, frame by frame, but for one shift: its
// first frame's pelvis over the object, where it was that far off. Taken
// once (later calls do nothing); a take with no root motion is given one,
// on its rig's root or else its pelvis.
root_under_pelvis(t: *Take, rig: *Rig) {
    pelvis = pose.human(rig, pose.PELVIS)
    if t == null || pelvis < 0 || t.under_pelvis { return }
    joint = t.root
    up = t.up
    if joint < 0 {
        joint = pose.human(rig, pose.ROOT)
        if joint < 0 { joint = pelvis }
        up = up_of(rig)
    }
    w = pose.new(rig)
    m = t.motion as float[]
    first = core.vec3(0.0, 0.0, 0.0)
    f = 0
    while f < t.frames {
        p = frame(t, f)
        pose.world(rig, p, w)
        at = pose.translation(w, pelvis)
        off = core.v3_sub(at, core.v3_mul(up, core.v3_dot(at, up)))
        if f == 0 { first = off }
        // Into the travel's frame (turned by the root's turn then), from the
        // first frame's.
        carried = core.quat_apply(core.quat_rotate(m[f * 4 + 2], up), off)
        m[f * 4] = m[f * 4] + carried.x - first.x
        m[f * 4 + 1] = m[f * 4 + 1] + carried.z - first.z
        pose.set_translation(p, joint, core.v3_sub(pose.translation(p, joint), in_parent(rig, w, joint, off)))
        f = f + 1
    }
    pose.release(w)
    t.root = joint
    t.up = up
    t.under_pelvis = true
    from_root(t, rig)
}

// Offset `v` of the rig's space in the space of joint `j`'s parent, as pose
// `w` (worlds) has it: what moves the joint by `v`.
in_parent(rig: *Rig, w: ptr, j: int, v: Vec3) -> Vec3 {
    up = pose.parent(rig, j)
    if up < 0 { return v }
    back = core.quat_apply(core.quat_conjugate(pose.rotation(w, up)), v)
    s = pose.scale(w, up)
    return core.vec3(back.x / s.x, back.y / s.y, back.z / s.z)
}

// The turn of `q` about `up` (its twist, as a swing-twist decomposition
// finds it), radians.
twist_about(q: Quat, up: Vec3) -> float {
    along = q.x * up.x + q.y * up.y + q.z * up.z
    return 2.0 * core.atan2_of(along, q.w)
}

// The take's speed and heading from its root's travel over its length.
from_root(t: *Take, rig: *Rig) {
    m = t.motion as float[]
    find_speed_from_root(t)
    last = (t.frames - 1) * 4
    across = core.sqrt_of(m[last] * m[last] + m[last + 1] * m[last + 1])
    if across > 0.000001 { t.heading = ground_dir(rig, core.vec3(m[last] / across, 0.0, m[last + 1] / across)) }
}

// The root joint. On a rig with a root bone (UE5's `root`) it is that bone,
// when it moves MOVES anywhere in the take: the root carries the motion
// there, and a pelvis moving under a still root is the motion itself (a
// figure getting up where it lies, sitting down onto where it stood). On a
// rig with none (Mixamo's) it is the pelvis, when it ends TRAVELS from where
// it began (an in-place walk's pelvis sways a few centimetres and comes
// back). -1 when there is nothing to take.
pick_root(t: *Take, rig: *Rig) -> int {
    candidates = [pose.human(rig, pose.ROOT), pose.human(rig, pose.PELVIS)]
    k = 0
    while k < 2 {
        j = candidates[k]
        if j >= 0 {
            a = pose.translation(frame(t, 0), j)
            b = pose.translation(frame(t, t.frames - 1), j)
            far = 0.0
            f = 0
            while f < t.frames {
                d = core.v3_len(core.v3_sub(pose.translation(frame(t, f), j), a))
                if d > far { far = d }
                f = f + 1
            }
            if k == 0 { if far >= MOVES { return j } else { return 0 - 1 } }
            if k == 1 && core.v3_len(core.v3_sub(b, a)) >= TRAVELS { return j }
        }
        k = k + 1
    }
    return 0 - 1
}
wrap_angle(a: float) -> float {
    x = a
    while x > 3.141592653589793 { x = x - 6.283185307179586 }
    while x < 0.0 - 3.141592653589793 { x = x + 6.283185307179586 }
    return x
}

find_speed_from_root(t: *Take) {
    if t.duration <= 0.0 { return }
    m = t.motion as float[]
    last = (t.frames - 1) * 4
    t.speed = core.sqrt_of(m[last] * m[last] + m[last + 1] * m[last + 1]) / t.duration
}

// The root's offset `at` seconds in from frame 0: x and z over the ground
// in the rig's space, and its turn about up.
travel(t: *Take, at: float) -> Vec3 {
    if t.root < 0 { return core.vec3(0.0, 0.0, 0.0) }
    m = t.motion as float[]
    x = time_of(t, at, false) * t.rate
    f0 = x as int
    if f0 >= t.frames - 1 {
        k = (t.frames - 1) * 4
        return core.vec3(m[k], m[k + 1], m[k + 2])
    }
    u = x - (f0 as float)
    a = f0 * 4
    b = a + 4
    return core.vec3(m[a] + (m[b] - m[a]) * u, m[a + 1] + (m[b + 1] - m[a + 1]) * u, m[a + 2] + (m[b + 2] - m[a + 2]) * u)
}

// The root's motion from `from` to `to` seconds (wrapping when it loops),
// as the figure takes it: x and z over the ground in the root's own frame at
// `from` (x across, z ahead, in the rig's axes turned back by its heading
// then), and the turn about up.
root_delta(t: *Take, from: float, to: float, loop: bool) -> Vec3 {
    if t.root < 0 { return core.vec3(0.0, 0.0, 0.0) }
    if !loop || to >= from { return segment(t, time_of(t, from, loop), time_of(t, to, loop)) }
    // Wrapped: to the end, then from the start.
    a = time_of(t, from, true)
    b = time_of(t, to, true)
    first = segment(t, a, t.duration)
    second = segment(t, 0.0, b)
    c = core.cos_of(first.z)
    s = core.sin_of(first.z)
    return core.vec3(first.x + c * second.x + s * second.y, first.y - s * second.x + c * second.y, first.z + second.z)
}

// The root's motion over [a, b] in the frame of its heading at a. The vector
// carries x, z and yaw in x, y and z.
segment(t: *Take, a: float, b: float) -> Vec3 {
    pa = travel(t, a)
    pb = travel(t, b)
    dx = pb.x - pa.x
    dz = pb.y - pa.y
    c = core.cos_of(pa.z)
    s = core.sin_of(pa.z)
    return core.vec3(c * dx - s * dz, s * dx + c * dz, wrap_angle(pb.z - pa.z))
}

// --- contacts -----------------------------------------------------------------------------------

// Whether foot `side` (0 left, 1 right) is down `at` seconds in.
contact(t: *Take, side: int, at: float, loop: bool) -> bool {
    f = (time_of(t, at, loop) * t.rate + 0.5) as int
    if f >= t.frames { f = t.frames - 1 }
    return (t.contacts as float[])[f * 2 + side] > 0.5
}


// The first time foot `side` comes down, -1 when it never does.
foot_down(t: *Take, side: int) -> float {
    if side == 0 { return t.left_down }
    return t.right_down
}

// A point of the rig given in its space put in the ground's (the space the
// figure stands in: up is y), through the armature the rig hangs from.
ground_point(rig: *Rig, p: Vec3) -> Vec3 {
    base = pose.base_model(rig)
    if base == null { return p }
    core.model_sync_transform(base)
    s = base.world_scale
    scaled = core.vec3(p.x * s.x, p.y * s.y, p.z * s.z)
    return core.v3_add(base.world_position, core.quat_apply(base.world_rotation, scaled))
}

// The way take `t` carries the figure over the ground when the figure stands
// at rest (unit; zero for a take that goes nowhere).
heading(t: *Take) -> Vec3 { return t.heading }

// A direction of the rig's space in the ground's, level.
ground_dir(rig: *Rig, v: Vec3) -> Vec3 {
    base = pose.base_model(rig)
    w = v
    if base != null {
        core.model_sync_transform(base)
        w = core.quat_apply(base.world_rotation, v)
    }
    flat = core.vec3(w.x, 0.0, w.z)
    if core.v3_len(flat) < 0.000001 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(flat)
}

// Up in the rig's own space: the ground's up turned back through the
// armature (a Blender armature stands Z-up under a turned node).
up_of(rig: *Rig) -> Vec3 {
    base = pose.base_model(rig)
    if base == null { return core.vec3(0.0, 1.0, 0.0) }
    core.model_sync_transform(base)
    return core.v3_normalize(core.quat_apply(core.quat_conjugate(base.world_rotation), core.vec3(0.0, 1.0, 0.0)))
}

// Each foot's contacts, the take's speed over the ground when it has no root
// motion, its heading, and the first touchdowns, found from its frames. A
// foot is down while its sole (the lower of its ankle and its ball) is
// within CONTACT_UP of the lowest that sole comes in the take, and flat while
// its ankle and its ball both are.
find_contacts(t: *Take, rig: *Rig) { contacts_like(t, rig, null) }

// As find_contacts, with the contacts and planted frames of `like` (a take of
// the same motion and length: what it was retargeted from) in place of those
// its own feet show; its speed, heading and footfalls found from them.
contacts_like(t: *Take, rig: *Rig, like: *Take) {
    worlds = pose.new(rig)
    c = t.contacts as float[]
    flatness = t.flat as float[]
    // Per frame and foot: the ankle's height, the ball's, and the ball's x, z.
    marks = calloc(t.frames * 8, 8) as float[]
    feet = [pose.human(rig, pose.FOOT_L), pose.human(rig, pose.FOOT_R)]
    balls = [pose.human(rig, pose.BALL_L), pose.human(rig, pose.BALL_R)]
    lowest_ankle = [1000000.0, 1000000.0]
    lowest_ball = [1000000.0, 1000000.0]
    balls_down = calloc(t.frames * 2, 8) as float[]
    flat_count = 0
    f = 0
    while f < t.frames {
        pose.world(rig, frame(t, f), worlds)
        side = 0
        while side < 2 {
            at = (f * 2 + side) * 4
            if feet[side] >= 0 {
                a = ground_point(rig, pose.translation(worlds, feet[side]))
                b = a
                if balls[side] >= 0 { b = ground_point(rig, pose.translation(worlds, balls[side])) }
                marks[at] = a.y
                marks[at + 1] = b.y
                marks[at + 2] = b.x
                marks[at + 3] = b.z
                if a.y < lowest_ankle[side] { lowest_ankle[side] = a.y }
                if b.y < lowest_ball[side] { lowest_ball[side] = b.y }
            }
            side = side + 1
        }
        f = f + 1
    }
    f = 0
    while f < t.frames {
        side = 0
        while side < 2 {
            at = (f * 2 + side) * 4
            sole = marks[at]
            if marks[at + 1] < sole { sole = marks[at + 1] }
            lowest = lowest_ankle[side]
            if lowest_ball[side] < lowest { lowest = lowest_ball[side] }
            c[f * 2 + side] = 0.0
            flatness[f * 2 + side] = 0.0
            balls_down[f * 2 + side] = 0.0
            if feet[side] >= 0 && sole <= lowest + CONTACT_UP { c[f * 2 + side] = 1.0 }
            if feet[side] >= 0 && marks[at + 1] <= lowest_ball[side] + CONTACT_UP { balls_down[f * 2 + side] = 1.0 }
            if feet[side] >= 0 && marks[at] <= lowest_ankle[side] + CONTACT_UP && marks[at + 1] <= lowest_ball[side] + CONTACT_UP {
                flatness[f * 2 + side] = 1.0
                flat_count = flat_count + 1
            }
            side = side + 1
        }
        f = f + 1
    }
    // Planted: flat where the take puts its feet down flat (a walk), its balls
    // down where it never does (a run on its forefoot: the sprint is flat one
    // frame a stance).
    if flat_count < FLAT_LEAST {
        f = 0
        while f < t.frames * 2 {
            flatness[f] = balls_down[f]
            f = f + 1
        }
    }
    free(balls_down as ptr)
    // Whether its pelvis travels in its frames (a capture read whole, its
    // root motion not taken out): such a take goes over a still ground, and
    // only there must a planted foot also be still (keep_still).
    went = core.vec3(0.0, 0.0, 0.0)
    pelvis = pose.human(rig, pose.PELVIS)
    if pelvis >= 0 {
        pose.world(rig, frame(t, 0), worlds)
        a = ground_point(rig, pose.translation(worlds, pelvis))
        pose.world(rig, frame(t, t.frames - 1), worlds)
        b = ground_point(rig, pose.translation(worlds, pelvis))
        went = core.vec3(b.x - a.x, 0.0, b.z - a.z)
    }
    t.travels = t.root < 0 && core.v3_len(went) >= TRAVELS
    if t.travels { keep_still(t, flatness, marks) }
    if like != null && like.frames == t.frames {
        k = 0
        while k < t.frames * 2 {
            c[k] = (like.contacts as float[])[k]
            flatness[k] = (like.flat as float[])[k]
            k = k + 1
        }
    }
    // The speed over the ground, from the feet while planted: every planted
    // stretch's travel of the ball over its time. A planted foot is what
    // stays put on the ground; the rest of a stance is the foot rolling onto its
    // heel and off its toe, about points the joints are not on. Taken over the
    // whole stance, the walk rolling forward off its toe came out at 0.94 m/s,
    // and its flat foot slid back 7 cm a stance under a figure moved at that.
    sum_x = 0.0
    sum_z = 0.0
    flat_frames = 0
    side = 0
    while side < 2 {
        started = 0 - 1
        f = 0
        while f <= t.frames {
            down = f < t.frames && flatness[f * 2 + side] > 0.5
            if down && started < 0 { started = f }
            if !down && started >= 0 {
                last = f - 1
                if last > started {
                    a0 = (started * 2 + side) * 4
                    a1 = (last * 2 + side) * 4
                    sum_x = sum_x + marks[a1 + 2] - marks[a0 + 2]
                    sum_z = sum_z + marks[a1 + 3] - marks[a0 + 3]
                    flat_frames = flat_frames + last - started
                }
                started = 0 - 1
            }
            f = f + 1
        }
        side = side + 1
    }
    // First touchdowns: a foot down after a frame it was up (or down from
    // the start when it never lifts).
    t.left_down = touchdown(t, 0)
    t.right_down = touchdown(t, 1)
    find_footfalls(t)
    across = core.sqrt_of(sum_x * sum_x + sum_z * sum_z)
    if t.root < 0 && flat_frames > 0 { t.speed = across / ((flat_frames as float) / t.rate) }
    // The way it goes: against its feet's travel (they carry the ground back).
    // Not the way its toes point: feet stand turned out, and a figure moved
    // heel to toe walks off its gait's line, its toes sliding.
    if t.root < 0 && across > 0.000001 { t.heading = core.vec3(0.0 - sum_x / across, 0.0, 0.0 - sum_z / across) }
    // Over a still ground (see above): its speed and heading are its pelvis's,
    // and its planted feet's travel is only their slip (a capture's forward
    // walk came out at 0.027 m/s).
    if t.travels && t.duration > 0.0 && core.v3_len(went) > 0.000001 {
        t.speed = core.v3_len(went) / t.duration
        t.heading = core.v3_normalize(went)
    }
    free(marks as ptr)
    pose.release(worlds)
}

// Whether foot `side` is planted `at` seconds in: flat on the ground, or on
// its ball for a take that runs on it.
planted(t: *Take, side: int, at: float, loop: bool) -> bool {
    f = (time_of(t, at, loop) * t.rate + 0.5) as int
    if f >= t.frames { f = t.frames - 1 }
    return (t.flat as float[])[f * 2 + side] > 0.5
}

touchdown(t: *Take, side: int) -> float {
    c = t.contacts as float[]
    f = 1
    while f < t.frames {
        if c[f * 2 + side] > 0.5 && c[(f - 1) * 2 + side] < 0.5 { return (f as float) / t.rate }
        f = f + 1
    }
    if c[side] > 0.5 { return 0.0 }
    return 0.0 - 1.0
}

// --- events -------------------------------------------------------------------------------------

// Every footfall as an event (FOOT_LEFT, FOOT_RIGHT): a foot down after a
// frame it was up. A loop's footfall on its first frame is on its last (the
// same moment). Found again whenever the contacts are.
find_footfalls(t: *Take) {
    drop_found(t)
    c = t.contacts as float[]
    side = 0
    while side < 2 {
        title = FOOT_LEFT
        if side == 1 { title = FOOT_RIGHT }
        f = 1
        while f < t.frames {
            if c[f * 2 + side] > 0.5 && c[(f - 1) * 2 + side] < 0.5 { insert_event(t, (f as float) / t.rate, title, true) }
            f = f + 1
        }
        side = side + 1
    }
}

// An event named `title` `at` seconds into `t`, fired whenever the
// animator's clock for the take passes it.
add_event(t: *Take, at: float, title: string) { insert_event(t, at, title, false) }

insert_event(t: *Take, at: float, title: string, found: bool) {
    ev = heap.new(Event)
    ev.at = at
    ev.name = string.copy(title)
    ev.found = found
    list.add_raw(t.events, ev as ptr)
    k = list.size(t.events) - 1
    while k > 0 {
        before = list.get_raw(t.events, k - 1) as *Event
        if before.at <= at { break }
        list.set(t.events, k, before as ptr)
        k = k - 1
    }
    list.set(t.events, k, ev as ptr)
}

drop_found(t: *Take) {
    kept = list.new()
    i = 0
    while i < list.size(t.events) {
        ev = list.get_raw(t.events, i) as *Event
        if ev.found {
            string.free(ev.name)
            heap.free(ev)
        } else {
            list.add_raw(kept, ev as ptr)
        }
        i = i + 1
    }
    list.free(t.events)
    t.events = kept
}

event_count(t: *Take) -> int { return list.size(t.events) }
event_time(t: *Take, i: int) -> float { return (list.get_raw(t.events, i) as *Event).at }
event_name(t: *Take, i: int) -> string { return (list.get_raw(t.events, i) as *Event).name }
event_found(t: *Take, i: int) -> bool { return (list.get_raw(t.events, i) as *Event).found }

// --- mirroring ----------------------------------------------------------------------------------

// Take `t` mirrored across the figure (pose.mirror on every frame), made for
// this call and owned by the caller: its root's travel reflected and its
// turns the other way, its contacts the take's left for right, its speed and heading found again, its
// events kept (its footfalls found again, so a left foot's is a right's).
// Named as `t` with "_Mirror" after it.
mirror(t: *Take, rig: *Rig) -> *Take {
    title = string.concat(t.name, "_Mirror")
    m = blank_take(rig, title, t.frames, t.rate)
    string.free(title)
    m.duration = t.duration
    m.looping = t.looping
    // A compressed take read as it plays, and left compressed: a graph's
    // takes are shared by every figure of its file (#992).
    scratch = pose.new(rig)
    f = 0
    while f < t.frames {
        src = scratch
        if t.packed != null {
            packed_frame(t, f, scratch)
        } else {
            src = frame(t, f)
        }
        pose.mirror(rig, src, frame(m, f))
        f = f + 1
    }
    pose.release(scratch)
    if t.root >= 0 {
        m.root = pose.mirror_of(rig, t.root)
        n = pose.mirror_normal(rig)
        level = core.sqrt_of(n.x * n.x + n.z * n.z)
        nx = 1.0
        nz = 0.0
        if level > 0.000001 {
            nx = n.x / level
            nz = n.z / level
        }
        a = t.motion as float[]
        b = m.motion as float[]
        f = 0
        while f < t.frames {
            d = a[f * 4] * nx + a[f * 4 + 1] * nz
            b[f * 4] = a[f * 4] - 2.0 * d * nx
            b[f * 4 + 1] = a[f * 4 + 1] - 2.0 * d * nz
            b[f * 4 + 2] = 0.0 - a[f * 4 + 2]
            b[f * 4 + 3] = a[f * 4 + 3]
            f = f + 1
        }
        m.pivot = t.pivot
        m.up = t.up
        m.under_pelvis = t.under_pelvis
        from_root(m, rig)
    }
    // Its contacts the take's, left for right: found again from the mirrored
    // feet's heights, a capture's dragged foot came back down.
    like = blank_take(rig, t.name, t.frames, t.rate)
    f = 0
    while f < t.frames {
        (like.contacts as float[])[f * 2] = (t.contacts as float[])[f * 2 + 1]
        (like.contacts as float[])[f * 2 + 1] = (t.contacts as float[])[f * 2]
        (like.flat as float[])[f * 2] = (t.flat as float[])[f * 2 + 1]
        (like.flat as float[])[f * 2 + 1] = (t.flat as float[])[f * 2]
        f = f + 1
    }
    contacts_like(m, rig, like)
    take_free(like)
    i = 0
    while i < list.size(t.events) {
        ev = list.get_raw(t.events, i) as *Event
        if !ev.found { insert_event(m, ev.at, ev.name, false) }
        i = i + 1
    }
    return m
}

// --- the ground under a take ----------------------------------------------------------------------

// Where a point fixed to the ground, at `p` in frame `from` of the take (the
// rig's space), is in frame `to`. A take whose root motion was taken out
// carries the ground back by that motion (the root's travel and turn about
// its held place); a take made in place, by the ground its planted feet push
// back at its speed along its heading; a take whose root moves in its frames
// (a capture read whole) leaves it where it is, its feet's planted travel
// being nothing.
ground_carry(t: *Take, rig: *Rig, p: Vec3, from: int, to: int) -> Vec3 {
    if from == to { return p }
    if t.root >= 0 {
        m = t.motion as float[]
        a = clamp_frame(t, from) * 4
        b = clamp_frame(t, to) * 4
        // Into the ground's frame at `from`, then back out at `to`.
        level = core.v3_sub(p, core.v3_mul(t.up, core.v3_dot(p, t.up)))
        pivot = core.v3_sub(t.pivot, core.v3_mul(t.up, core.v3_dot(t.pivot, t.up)))
        rise = core.v3_mul(t.up, core.v3_dot(p, t.up))
        world = core.v3_add(core.v3_add(core.quat_apply(core.quat_rotate(m[a + 2], t.up), core.v3_sub(level, pivot)), pivot), core.vec3(m[a], 0.0, m[a + 1]))
        back = core.v3_sub(core.v3_sub(world, core.vec3(m[b], 0.0, m[b + 1])), pivot)
        return core.v3_add(core.v3_add(core.quat_apply(core.quat_rotate(0.0 - m[b + 2], t.up), back), pivot), rise)
    }
    // Its root travelling in its frames (a capture read whole): the ground is still.
    if t.travels { return p }
    // Made in place: the ground goes back at the take's speed.
    seconds = ((to - from) as float) / t.rate
    shift = core.v3_mul(t.heading, 0.0 - t.speed * seconds)
    base = pose.base_model(rig)
    if base == null { return core.v3_add(p, shift) }
    core.model_sync_transform(base)
    s = base.world_scale
    v = core.quat_apply(core.quat_conjugate(base.world_rotation), shift)
    return core.v3_add(p, core.vec3(v.x / s.x, v.y / s.y, v.z / s.z))
}

clamp_frame(t: *Take, f: int) -> int {
    if f < 0 { return 0 }
    if f >= t.frames { return t.frames - 1 }
    return f
}

// Planted means still on the ground, not only low: a foot dragged or pivoted
// along the floor (a shuffle as a figure turns) is low and flat, and went 13
// cm through what was counted its stance. Over a still ground (a capture
// read whole), a planted frame's ball must stay still, within SLIP_SPEED of
// the planted frames' own mean velocity (taken twice, the second time
// without the frames far off the first). Not under a clip made in place,
// whose feet are planted because it was made so: at a sprint's touchdown
// and push-off the ball strays more than SLIP_SHARE from the ground's speed
// while it is down, and filtered so, the runner's lock let go mid-stance at
// 8.5 m/s and its toe went 327 mm.
keep_still(t: *Take, flatness: float[], marks: float[]) {
    if t.frames < 3 { return }
    gx = 0.0
    gz = 0.0
    pass = 0
    while pass < 2 {
        sx = 0.0
        sz = 0.0
        n = 0
        f = 0
        while f < t.frames {
            side = 0
            while side < 2 {
                if flatness[f * 2 + side] > 0.5 {
                    vx, vz = ball_velocity(t, marks, f, side)
                    if pass == 0 || slip_ok(vx - gx, vz - gz, gx, gz) {
                        sx = sx + vx
                        sz = sz + vz
                        n = n + 1
                    }
                }
                side = side + 1
            }
            f = f + 1
        }
        if n > 0 {
            gx = sx / (n as float)
            gz = sz / (n as float)
        }
        pass = pass + 1
    }
    // A foot dragged is neither planted nor down: feet locking holds a foot
    // that is down, and 100STYLE's side step drags its trailing foot along
    // the floor for most of a stride, held and then let go a third of a
    // metre behind it.
    c = t.contacts as float[]
    f = 0
    while f < t.frames {
        side = 0
        while side < 2 {
            if flatness[f * 2 + side] > 0.5 || c[f * 2 + side] > 0.5 {
                vx, vz = ball_velocity(t, marks, f, side)
                if !slip_ok(vx - gx, vz - gz, gx, gz) {
                    flatness[f * 2 + side] = 0.0
                    c[f * 2 + side] = 0.0
                }
            }
            side = side + 1
        }
        f = f + 1
    }
}

slip_ok(dx: float, dz: float, gx: float, gz: float) -> bool {
    allowed = SLIP_SHARE * core.sqrt_of(gx * gx + gz * gz)
    if allowed < SLIP_SPEED { allowed = SLIP_SPEED }
    return dx * dx + dz * dz <= allowed * allowed
}

// The ball's velocity over the ground at frame `f` (x and z), from the
// frames either side (one side at the ends).
ball_velocity(t: *Take, marks: float[], f: int, side: int) -> (float, float) {
    a = f - 1
    b = f + 1
    if a < 0 { a = 0 }
    if b >= t.frames { b = t.frames - 1 }
    if b == a { return 0.0, 0.0 }
    pa = (a * 2 + side) * 4
    pb = (b * 2 + side) * 4
    seconds = ((b - a) as float) / t.rate
    return (marks[pb + 2] - marks[pa + 2]) / seconds, (marks[pb + 3] - marks[pa + 3]) / seconds
}

// --- loops --------------------------------------------------------------------------------------

// A loop made seamless, as Unity's Loop Pose makes one: the gap between its
// last frame and its first, at each joint, spread over the take (none of it
// at the first frame, all of it at the last), so the last frame is the first
// again and nothing snaps as it wraps. UAL's jog and sprint end 0.78 degrees
// off where they begin. Not the root while it carries the take (its travel
// and turn are the root motion: it moves MOVES or more and its motion was
// not taken out), nor the pelvis's place over the ground while it travels
// TRAVELS or more, only its height; and not a take whose ends are more than
// LOOP_GAP apart at any joint, which was not made to loop. A capture looped
// after its root motion was taken out has its pelvis sealed too, or its hips
// would jump at the seam. Whether it was sealed.
seal_loop(t: *Take, rig: *Rig) -> bool { return seal_within(t, rig, LOOP_GAP) }

// As seal_loop, sealed unless a joint's ends are more than `most` radians
// apart.
seal_within(t: *Take, rig: *Rig, most: float) -> bool {
    if t.frames < 3 { return false }
    first = frame(t, 0)
    last = frame(t, t.frames - 1)
    root = pose.human(rig, pose.ROOT)
    pelvis = pose.human(rig, pose.PELVIS)
    up = up_of(rig)
    if root >= 0 && t.root < 0 && core.v3_len(core.v3_sub(pose.translation(last, root), pose.translation(first, root))) < MOVES { root = 0 - 1 }
    carries = false
    if pelvis >= 0 && t.root != pelvis {
        went = core.v3_sub(pose.translation(last, pelvis), pose.translation(first, pelvis))
        went = core.v3_sub(went, core.v3_mul(up, core.v3_dot(went, up)))
        carries = core.v3_len(went) >= TRAVELS
    }
    j = 0
    while j < t.count {
        if j != root {
            q = core.quat_mul(pose.rotation(first, j), core.quat_conjugate(pose.rotation(last, j)))
            w = core.abs_of(q.w)
            if w > 1.0 { w = 1.0 }
            if 2.0 * core.acos_of(w) > most { return false }
        }
        j = j + 1
    }
    n = t.frames - 1
    j = 0
    while j < t.count {
        if j != root {
            turn = core.quat_normalize(core.quat_mul(pose.rotation(first, j), core.quat_conjugate(pose.rotation(last, j))))
            move = core.v3_sub(pose.translation(first, j), pose.translation(last, j))
            if j == pelvis && carries { move = core.v3_mul(up, core.v3_dot(move, up)) }
            f = 1
            while f <= n {
                u = (f as float) / (n as float)
                p = frame(t, f)
                pose.set_rotation(p, j, core.quat_normalize(core.quat_mul(core.quat_slerp(core.quat_ident(), turn, u), pose.rotation(p, j))))
                pose.set_translation(p, j, core.v3_add(pose.translation(p, j), core.v3_mul(move, u)))
                f = f + 1
            }
        }
        j = j + 1
    }
    return true
}

// --- straightening ------------------------------------------------------------------------------

// A take's root motion made to go straight, as a capture's locomotion is
// cleaned for a blend space: its root turns nowhere, and each step of its
// path is the step as the root took it, in its own frame then (the turn
// taken out of the path as the root lock took it out of the poses), so a
// planted foot stays where it is over the ground but for the turn's own
// sweep (the turn's rate times the foot's distance from the root). With
// `cardinal`, the take is turned, poses and path together, so its travel
// lies on the nearest of the figure's forward, back, left and right, as a
// blend space's samples stand. 100STYLE's forward and backward walks turn
// their actor a few degrees each: played out and back, a figure went round
// in a circle, and on their diagonals 0.6 m to the side every 20 s.
// Straightened by zeroing the turn and dropping the path's side, a capture's
// stop that turned 29 degrees slid its planted ball 362 mm over its own
// ground. Nothing for a take with no root motion.
straighten(t: *Take, rig: *Rig, cardinal: bool) {
    if t.root < 0 || t.frames < 2 { return }
    m = t.motion as float[]
    // The path in the root's own frame, step by step.
    nx = 0.0
    nz = 0.0
    px = m[0]
    pz = m[1]
    m[0] = 0.0
    m[1] = 0.0
    f = 1
    while f < t.frames {
        dx = m[f * 4] - px
        dz = m[f * 4 + 1] - pz
        px = m[f * 4]
        pz = m[f * 4 + 1]
        turn = (m[(f - 1) * 4 + 2] + m[f * 4 + 2]) * 0.5
        c = core.cos_of(turn)
        s = core.sin_of(turn)
        nx = nx + c * dx - s * dz
        nz = nz + s * dx + c * dz
        m[f * 4] = nx
        m[f * 4 + 1] = nz
        f = f + 1
    }
    f = 0
    while f < t.frames {
        m[f * 4 + 2] = 0.0
        f = f + 1
    }
    far = core.sqrt_of(nx * nx + nz * nz)
    if cardinal && far > 0.000001 {
        // The turn from the travel's way to the nearest axis.
        lx = 0.0
        lz = 0.0
        if core.abs_of(nx) > core.abs_of(nz) {
            lx = 1.0
            if nx < 0.0 { lx = 0.0 - 1.0 }
        } else {
            lz = 1.0
            if nz < 0.0 { lz = 0.0 - 1.0 }
        }
        // (quat_rotate turns +z toward +x.)
        delta = core.atan2_of(nz * lx - nx * lz, nx * lx + nz * lz)
        turn_all(t, rig, delta)
    }
    from_root(t, rig)
}

// Take `t` (its root motion taken out) turned by `angle` about its up, about
// where its root is held: every frame's root joint, and the path.
turn_all(t: *Take, rig: *Rig, angle: float) {
    q = core.quat_rotate(angle, t.up)
    m = t.motion as float[]
    f = 0
    while f < t.frames {
        moved = core.quat_apply(q, core.vec3(m[f * 4], 0.0, m[f * 4 + 1]))
        m[f * 4] = moved.x
        m[f * 4 + 1] = moved.z
        p = frame(t, f)
        at = pose.translation(p, t.root)
        pose.set_translation(p, t.root, core.v3_add(t.pivot, core.quat_apply(q, core.v3_sub(at, t.pivot))))
        pose.set_rotation(p, t.root, core.quat_normalize(core.quat_mul(q, pose.rotation(p, t.root))))
        f = f + 1
    }
}

// --- loops cut from captures ----------------------------------------------------------------------

// The take's best loop, made for this call and owned by the caller: the two
// frames at least LOOP_LEAST seconds apart whose poses match best (the feet,
// balls, hands, head and pelvis where they stand about the root, and how fast
// they move there, a tenth of a second's motion weighed as a place), the take
// cut from the first to the second and sealed. A capture cut between two
// footfalls ends 16 to 41 degrees off its start at a foot (a footfall's frame
// is where the sole crosses 3 cm, a few frames either way from stride to
// stride), too far to seal, and wrapping it jumped the foot. Root motion
// carried over from the first frame; contacts kept, its speed and footfalls
// found again. Null when the take is shorter than LOOP_LEAST and a frame.
loop_cut(t: *Take, rig: *Rig) -> *Take {
    least = (LOOP_LEAST * t.rate + 0.5) as int
    if t.frames < least + 2 { return null }
    slots = [pose.FOOT_L, pose.BALL_L, pose.FOOT_R, pose.BALL_R, pose.HAND_L, pose.HAND_R, pose.HEAD, pose.PELVIS]
    keys = calloc(8, 4) as int[]
    nk = 0
    k = 0
    while k < 8 {
        j = pose.human(rig, slots[k])
        if j >= 0 {
            keys[nk] = j
            nk = nk + 1
        }
        k = k + 1
    }
    // Every frame's key joints' places in the rig's space.
    places = calloc(t.frames * nk * 3, 8) as float[]
    worlds = pose.new(rig)
    f = 0
    while f < t.frames {
        pose.world(rig, frame(t, f), worlds)
        k = 0
        while k < nk {
            p = pose.translation(worlds, keys[k])
            at = (f * nk + k) * 3
            places[at] = p.x
            places[at + 1] = p.y
            places[at + 2] = p.z
            k = k + 1
        }
        f = f + 1
    }
    pose.release(worlds)
    lead = 0.1 * t.rate
    best = 1000000000.0
    best_a = 0
    best_b = t.frames - 1
    a = 0
    while a < t.frames - 1 - least {
        b = a + least
        while b < t.frames - 1 {
            score = 0.0
            k = 0
            while k < nk * 3 {
                pa = places[a * nk * 3 + k]
                pb = places[b * nk * 3 + k]
                va = (places[(a + 1) * nk * 3 + k] - pa) * lead
                vb = (places[(b + 1) * nk * 3 + k] - pb) * lead
                score = score + (pa - pb) * (pa - pb) + (va - vb) * (va - vb)
                k = k + 1
            }
            if score < best {
                best = score
                best_a = a
                best_b = b
            }
            b = b + 1
        }
        a = a + 1
    }
    free(places as ptr)
    free(keys as ptr)
    // A loop cut on purpose is sealed whatever its gap: refused for one
    // joint more than LOOP_GAP apart at its ends, five of 100STYLE's six
    // gaits wrapped unsealed, and a forward run's hands jumped 5 cm at its
    // seam, a held axe's second arm 77 rad/s with them (#962). Spread over
    // a foot's swing alone instead of the loop, a leg's gap moved the swing
    // a matcher searches by, and a matched walk slid a planted toe 124 mm.
    return crop_sealed(t, rig, best_a, best_b, true, 3.1415926535897931)
}

// Frames `a` to `b` of `t` (inclusive) as a take of their own, made for this
// call: its root motion from frame `a`'s, its contacts kept, its speed and
// footfalls found again, sealed as a loop when `loop`.
crop(t: *Take, rig: *Rig, a: int, b: int, loop: bool) -> *Take { return crop_sealed(t, rig, a, b, loop, LOOP_GAP) }

// As crop, a loop sealed unless a joint's ends are more than `most` radians
// apart (seal_within).
crop_sealed(t: *Take, rig: *Rig, a: int, b: int, loop: bool, most: float) -> *Take {
    n = b - a + 1
    out = blank_take(rig, t.name, n, t.rate)
    out.looping = loop
    floats = t.stride
    if t.packed != null { unpack(t) }
    src = t.data as float[]
    dst = out.data as float[]
    k = 0
    while k < n * floats {
        dst[k] = src[a * floats + k]
        k = k + 1
    }
    like = blank_take(rig, t.name, n, t.rate)
    f = 0
    while f < n * 2 {
        (like.contacts as float[])[f] = (t.contacts as float[])[a * 2 + f]
        (like.flat as float[])[f] = (t.flat as float[])[a * 2 + f]
        f = f + 1
    }
    if t.root >= 0 {
        out.root = t.root
        out.pivot = t.pivot
        out.up = t.up
        m = t.motion as float[]
        o = out.motion as float[]
        // From frame a's place and heading.
        c = core.cos_of(m[a * 4 + 2])
        s = core.sin_of(m[a * 4 + 2])
        f = 0
        while f < n {
            dx = m[(a + f) * 4] - m[a * 4]
            dz = m[(a + f) * 4 + 1] - m[a * 4 + 1]
            o[f * 4] = c * dx - s * dz
            o[f * 4 + 1] = s * dx + c * dz
            o[f * 4 + 2] = wrap_angle(m[(a + f) * 4 + 2] - m[a * 4 + 2])
            o[f * 4 + 3] = m[(a + f) * 4 + 3]
            f = f + 1
        }
        from_root(out, rig)
    }
    if loop { _sealed = seal_within(out, rig, most) }
    contacts_like(out, rig, like)
    take_free(like)
    i = 0
    while i < list.size(t.events) {
        ev = list.get_raw(t.events, i) as *Event
        at = ev.at - (a as float) / t.rate
        if !ev.found && at >= 0.0 && at <= out.duration { insert_event(out, at, ev.name, false) }
        i = i + 1
    }
    return out
}

// --- distance matching --------------------------------------------------------------------------

// The length of the path take `t`'s root travels over the ground, metres;
// 0 for a take with no root motion.
travel_length(t: *Take) -> float {
    if t.root < 0 { return 0.0 }
    m = t.motion as float[]
    total = 0.0
    f = 1
    while f < t.frames {
        dx = m[f * 4] - m[(f - 1) * 4]
        dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
        total = total + core.sqrt_of(dx * dx + dz * dz)
        f = f + 1
    }
    return total
}

// The speed take `t`'s root goes over the ground about `at` seconds, metres
// a second: its way over the SPEED_SPAN about it (held within the take), so
// a capture's frame-to-frame sway does not read as its pace. 0 for a take
// with no root motion.
speed_at(t: *Take, at: float) -> float {
    if t.root < 0 { return 0.0 }
    lo = core.clampf(at - SPEED_SPAN * 0.5, 0.0, t.duration)
    hi = core.clampf(at + SPEED_SPAN * 0.5, 0.0, t.duration)
    if hi - lo < 0.000001 { return 0.0 }
    return (distance_at(t, hi) - distance_at(t, lo)) / (hi - lo)
}

// The metres take `t`'s root has gone along its path at `at` seconds:
// time_at_distance's inverse.
distance_at(t: *Take, at: float) -> float {
    if t.root < 0 || at <= 0.0 { return 0.0 }
    m = t.motion as float[]
    total = 0.0
    f = 1
    while f < t.frames {
        dx = m[f * 4] - m[(f - 1) * 4]
        dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
        step = core.sqrt_of(dx * dx + dz * dz)
        ends = (f as float) / t.rate
        if ends >= at { return total + step * (1.0 - (ends - at) * t.rate) }
        total = total + step
        f = f + 1
    }
    return total
}

// The time at which take `t`'s root has gone `d` metres along its path (its
// end past the whole of it, its start at 0 or less): distance matching, as
// Paragon played its starts and stops (GDC 2016), so a start's feet plant
// where the clip planted them whatever the speed it is driven at.
time_at_distance(t: *Take, d: float) -> float {
    if t.root < 0 || d <= 0.0 { return 0.0 }
    m = t.motion as float[]
    total = 0.0
    f = 1
    while f < t.frames {
        dx = m[f * 4] - m[(f - 1) * 4]
        dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
        step = core.sqrt_of(dx * dx + dz * dz)
        if total + step >= d {
            u = 0.0
            if step > 0.0000001 { u = (d - total) / step }
            return ((f - 1) as float + u) / t.rate
        }
        total = total + step
        f = f + 1
    }
    return t.duration
}

// The time at which `d` metres of its root's path are left before its end:
// how a stop is played toward the point the figure comes to rest on.
time_at_distance_left(t: *Take, d: float) -> float { return time_at_distance(t, travel_length(t) - d) }

// The first time take `t`'s root moves faster than `speed` over the ground
// after standing (where a start leaves its stand); -1 when it never does.
// A take that begins on the move (the tail of a step before it, as a
// capture of starts and stops in a row does) is read from where it first
// stands: 100STYLE's StartStop start walks in at 0.68 m/s, stands from 0.75
// to 1.5 s and walks off at 1.55 s, and read from its first frame the
// "start" cut about it was the slowing tail, 0.30 m in 1.6 s, that a start
// clocked by the distance come raced through at up to 28 times its pace.
// A take that never stands is read from its first frame, as before. A
// stand and a move each hold for MOVE_HELD: the same take's stand sways to
// 0.11 m/s for two frames at 0.92 s, and read frame by frame that sway was
// its move.
moving_at(t: *Take, speed: float) -> float {
    if t.root < 0 { return 0.0 - 1.0 }
    n = (MOVE_HELD * t.rate) as int
    if n < 1 { n = 1 }
    f = 1
    while f < t.frames && !speed_held(t, f, speed, false, n) { f = f + 1 }
    if f >= t.frames { f = 1 }
    while f < t.frames {
        if speed_held(t, f, speed, true, n) { return (f as float) / t.rate }
        f = f + 1
    }
    return 0.0 - 1.0
}

// Whether take `t`'s root goes faster than `speed` (or, not `above`, no
// faster) at each of the `n` frames from `f` that it has.
speed_held(t: *Take, f: int, speed: float, above: bool, n: int) -> bool {
    k = f
    while k < f + n && k < t.frames {
        if (root_speed(t, k) > speed) != above { return false }
        k = k + 1
    }
    return true
}

// The first time after its fastest that take `t`'s root falls to `speed` or
// slower (where a stop comes to its stand); -1 when it never does. The
// last time it moves would be a start after the stop, in a take that goes
// on.
still_at(t: *Take, speed: float) -> float {
    if t.root < 0 { return 0.0 - 1.0 }
    fastest = 1
    f = 1
    while f < t.frames {
        if root_speed(t, f) > root_speed(t, fastest) { fastest = f }
        f = f + 1
    }
    f = fastest
    while f < t.frames {
        if root_speed(t, f) <= speed { return (f as float) / t.rate }
        f = f + 1
    }
    return 0.0 - 1.0
}

// The start of the `seconds` long stretch of take `t` (on `rig`) in which
// the figure moves least: the sum, frame to frame, of every joint's turn,
// and its root's travel. Where a stand is cut from a capture that walks in,
// stands, gestures and stands again: cut where its root first stood still,
// 100STYLE's neutral stand began as its actor lifted its arms out to 78
// degrees, and a figure standing on it held them out like a gorilla.
calmest(t: *Take, rig: *Rig, seconds: float) -> float {
    span = (seconds * t.rate) as int
    if span < 2 || span >= t.frames { return 0.0 }
    moves = calloc(t.frames, 8) as float[]
    n = pose.count(rig)
    f = 1
    while f < t.frames {
        a = frame(t, f - 1)
        b = frame(t, f)
        sum = 0.0
        j = 0
        while j < n {
            qa = pose.rotation(a, j)
            qb = pose.rotation(b, j)
            d = core.abs_of(qa.x * qb.x + qa.y * qb.y + qa.z * qb.z + qa.w * qb.w)
            if d > 1.0 { d = 1.0 }
            sum = sum + 2.0 * core.acos_of(d)
            j = j + 1
        }
        if t.root >= 0 { sum = sum + root_speed(t, f) / t.rate }
        moves[f] = sum
        f = f + 1
    }
    best = 1
    best_sum = 1000000000.0
    run = 0.0
    f = 1
    while f < t.frames {
        run = run + moves[f]
        if f - span >= 1 { run = run - moves[f - span] }
        if f >= span && run < best_sum {
            best_sum = run
            best = f - span + 1
        }
        f = f + 1
    }
    free(moves as ptr)
    return (best as float) / t.rate
}

// The root's speed over the ground at frame `f` (from the frame before).
root_speed(t: *Take, f: int) -> float {
    m = t.motion as float[]
    dx = m[f * 4] - m[(f - 1) * 4]
    dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
    return core.sqrt_of(dx * dx + dz * dz) * t.rate
}

// The deceleration take `t` (one that comes to a stand) brakes at, metres a
// second a second: the speed its root last moves at nine tenths of the
// speed it begins at, squared, over twice the way from there to its end. A
// mover braking at it comes to rest as the take does, so a stop played by
// the distance left (time_at_distance_left) enters where the take's feet
// are in the stride the figure's are. 0 when it has no root motion.
braking(t: *Take) -> float {
    v, left = braking_from(t)
    if left <= 0.01 { return 0.0 }
    return v * v / (2.0 * left)
}

// The speed take `t` brakes from (braking): nine tenths of the speed it
// begins at, metres a second; 0 when it has no root motion. A stop serves
// the speeds about it: from a run the mover slows to it first.
braking_speed(t: *Take) -> float {
    v, left = braking_from(t)
    if left <= 0.01 { return 0.0 }
    return v
}

// The speed take `t` brakes from and the way it goes from there to its end.
braking_from(t: *Take) -> (float, float) {
    if t.root < 0 || t.frames < 8 { return 0.0, 0.0 }
    m = t.motion as float[]
    // Its speed at the start, over its first tenth of a second.
    n = (0.1 * t.rate) as int
    if n < 1 { n = 1 }
    v0 = core.sqrt_of(m[n * 4] * m[n * 4] + m[n * 4 + 1] * m[n * 4 + 1]) * t.rate / (n as float)
    if v0 <= 0.01 { return 0.0, 0.0 }
    from = 0
    f = 1
    while f < t.frames {
        dx = m[f * 4] - m[(f - 1) * 4]
        dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
        if core.sqrt_of(dx * dx + dz * dz) * t.rate >= 0.9 * v0 { from = f }
        f = f + 1
    }
    left = 0.0
    f = from + 1
    while f < t.frames {
        dx = m[f * 4] - m[(f - 1) * 4]
        dz = m[f * 4 + 1] - m[(f - 1) * 4 + 1]
        left = left + core.sqrt_of(dx * dx + dz * dz)
        f = f + 1
    }
    return 0.9 * v0, left
}

// --- compression (#990) -------------------------------------------------------------------------

// A take's frames compressed, as ACL compresses UE5's AnimSequences: each
// joint's translation, rotation and scale is a track of its own, kept as
// coarsely as the skin allows. A track that holds still keeps one value and
// nothing a frame; one that moves keeps 16 bits a number over its own range
// (a rotation its x, y and z, its w made from them, the quaternion's sign
// made w's), or 32-bit floats, or, where nothing coarser will do, the
// take's own 64-bit numbers. Each track is given the coarsest that keeps
// its share of the error: how far it moves a point of the skin, at virtual
// vertices a bone's length from each joint (ACL's measure), the bound
// shared out along the longest chain. Then the whole take is decoded, frame
// by frame, and every joint's points measured against the take's own in
// the rig's space; a chain past the bound is made finer until none is.
// Then the frames the skin does not need are dropped (#992, ACL's keyframe
// stripping): a frame between two kept keys is their blend, kept out only
// where that blend holds every frame between, and every point halfway
// between two, within the bound; sampling looks its keys up by the frame
// (each frame's key at or before it), so it costs what it did.
// A take compressed is the same take: sample and sample_frame decode it as
// they read it, and a program that writes its frames (frame) has them back
// as they were decoded.
const PACK_CONST = 0
const PACK_Q16 = 1
const PACK_F32 = 2
const PACK_F64 = 3
// The most a compressed take moves a point of the skin, metres (0.1 mm).
const COMPRESS_ERROR = 0.0001
// The least distance of a virtual vertex from its joint, metres.
const PACK_SHELL = 0.01
// A 16-bit number's steps.
const PACK_STEPS = 65535.0

struct Packed {
    kinds: ptr                     // int[count * 3]: each joint's translation, rotation and scale track's PACK_ kind
    at: ptr                        // int[count * 3]: where its numbers are in a frame's record, bytes
    values: ptr                    // float[count * 3 * 8]: a constant's numbers (4), or a Q16 track's least (4) and step (4)
    record: int                    // bytes a frame
    bytes: ptr                     // the records, frames * record
    curves: ptr                    // float[frames * curves]: the curves as they were, or null for none
    error: float                   // the most it moves a point of the skin, metres, over every frame
    still: ptr                     // float[count * FLOATS]: a pose with every still track's numbers, laid down whole first
    still_blend: ptr               // and as a blend between two frames gives them: each still turn over its length, as an nlerp of it with itself
    moving: ptr                    // int[]: the tracks that move, decoded over it
    moving_count: int
    // Key reduction (#992): the frames whose records are kept, in order, the
    // first and the last always; a frame between two is their blend. Null
    // with every frame kept (`bytes` a record a frame).
    keys: ptr                      // int[key_count]: each key's frame
    key_of: ptr                    // int[frames]: each frame's key at or before it
    key_count: int
}

// How close to the bound a frame dropped between two keys may put the skin:
// the measure is at the frames and halfway between them, and a sample
// anywhere between keeps under the bound with this to spare.
const KEY_SHARE = 0.9
// The most frames one pair of keys spans, so the search stays linear.
const KEY_SPAN = 64

// How many numbers a joint's track `part` has (0 its translation, 1 its
// rotation, 2 its scale), and where they start in the joint's pose.
track_width(part: int) -> int {
    if part == 1 { return 4 }
    return 3
}

track_offset(part: int) -> int {
    if part == 0 { return 0 }
    if part == 1 { return 3 }
    return 7
}

// Bytes a frame of a track of kind `kind`.
track_bytes(kind: int, part: int) -> int {
    if kind == PACK_Q16 { return 6 }
    if kind == PACK_F32 { return 4 * track_width(part) }
    if kind == PACK_F64 { return 8 * track_width(part) }
    return 0
}

// Take `t` compressed in place, its frames on rig `rig`, within
// COMPRESS_ERROR of the skin. The most it moves a point of the skin,
// metres; -1 for a take it leaves as it is (empty, already compressed, or
// for a rig of another size).
compress(t: *Take, rig: *Rig) -> float {
    if t == null || t.packed != null || t.data == null || t.frames < 1 || t.count != pose.count(rig) { return 0.0 - 1.0 }
    n = t.count
    shell = calloc(n + 1, 8) as float[]
    reach = calloc(n + 1, 8) as float[]
    depth = pack_reach(rig, shell, reach)
    // A track's share of the error: every joint of the longest chain moves
    // the skin by its turn and by its place.
    budget = COMPRESS_ERROR / ((depth * 2) as float)
    kinds = calloc(n * 3 + 1, 4) as int[]
    values = calloc(n * 3 * 8 + 1, 8) as float[]
    hold = calloc(4, 4)
    k = 0
    while k < n * 3 {
        kinds[k] = pack_choose(t, k, reach[k / 3], budget, values, hold)
        k = k + 1
    }
    free(hold)
    pk = heap.new(Packed)
    pk.kinds = kinds as ptr
    pk.values = values as ptr
    pk.at = calloc(n * 3 + 1, 4)
    pack_layout(pk, n)
    pack_fill(t, pk)
    err, worst = pack_measure(t, rig, pk, shell)
    rounds = 0
    while err > COMPRESS_ERROR && rounds < n * 3 {
        pack_finer(rig, pk, worst)
        free(pk.bytes)
        pack_layout(pk, n)
        pack_fill(t, pk)
        err, worst = pack_measure(t, rig, pk, shell)
        rounds = rounds + 1
    }
    // Then the frames the skin does not need, dropped: each the blend of
    // the keys either side of it (ACL's keyframe stripping), within the
    // bound, measured again over every frame.
    if err <= COMPRESS_ERROR && pack_reduce(t, rig, pk, shell) {
        err, _w = pack_measure(t, rig, pk, shell)
    }
    pk.error = err
    free(shell as ptr)
    free(reach as ptr)
    t.packed = pk as ptr
    free(t.data)
    t.data = null
    return err
}

// Each joint's virtual vertices' distance from it into `shell`: a bone's
// length, its longest child's (an end joint's own), at least PACK_SHELL.
// How far its part of the skeleton reaches from it at rest, its
// descendants' places and their vertices, into `reach`. The number of
// joints on the longest chain.
pack_reach(rig: *Rig, shell: float[], reach: float[]) -> int {
    n = pose.count(rig)
    rest = pose.new(rig)
    worlds = pose.new(rig)
    pose.world(rig, rest, worlds)
    j = 0
    while j < n {
        shell[j] = PACK_SHELL
        j = j + 1
    }
    ends = calloc(n + 1, 4) as int[]
    j = 0
    while j < n {
        ends[j] = 1
        j = j + 1
    }
    j = 0
    while j < n {
        length = core.v3_len(pose.translation(rest, j))
        up = pose.parent(rig, j)
        if up >= 0 {
            ends[up] = 0
            if length > shell[up] { shell[up] = length }
        }
        j = j + 1
    }
    j = 0
    while j < n {
        length = core.v3_len(pose.translation(rest, j))
        if ends[j] == 1 && pose.parent(rig, j) >= 0 && length > shell[j] { shell[j] = length }
        j = j + 1
    }
    free(ends as ptr)
    deepest = 1
    k = 0
    while k < n {
        p = pose.translation(worlds, k)
        chain = 0
        j = k
        while j >= 0 {
            d = core.v3_len(core.v3_sub(p, pose.translation(worlds, j))) + shell[k]
            if d > reach[j] { reach[j] = d }
            chain = chain + 1
            j = pose.parent(rig, j)
        }
        if chain > deepest { deepest = chain }
        k = k + 1
    }
    pose.release(rest)
    pose.release(worlds)
    return deepest
}

// The coarsest kind track `k` keeps within `budget` metres of the skin, a
// part of the skeleton `reach` metres long under it; its constant, or its
// range and step, into `values`. `hold` is room for four 32-bit floats.
pack_choose(t: *Take, k: int, reach: float, budget: float, values: float[], hold: ptr) -> int {
    j = k / 3
    part = k % 3
    width = track_width(part)
    base = j * pose.FLOATS + track_offset(part)
    at = k * 8
    d = t.data as float[]
    // Still: frame 0's numbers.
    c = 0
    while c < width {
        values[at + c] = d[base + c]
        c = c + 1
    }
    if pack_error(t, k, PACK_CONST, reach, values, at, hold) <= budget { return PACK_CONST }
    // 16 bits a number over the track's own range.
    c = 0
    while c < 3 {
        least = 0.0
        most = 0.0
        f = 0
        while f < t.frames {
            x = pack_number(d, f * t.stride + base, c, part)
            if f == 0 || x < least { least = x }
            if f == 0 || x > most { most = x }
            f = f + 1
        }
        values[at + c] = least
        values[at + 4 + c] = (most - least) / PACK_STEPS
        c = c + 1
    }
    if pack_error(t, k, PACK_Q16, reach, values, at, hold) <= budget { return PACK_Q16 }
    if pack_error(t, k, PACK_F32, reach, values, at, hold) <= budget { return PACK_F32 }
    return PACK_F64
}

// Number `c` of a track's numbers at `at` in a pose: a rotation's signed so
// its w is never negative.
pack_number(d: float[], at: int, c: int, part: int) -> float {
    x = d[at + c]
    if part == 1 && d[at + 3] < 0.0 { return 0.0 - x }
    return x
}

// A number as a count of `step`s over `least`.
pack_q16(x: float, least: float, step: float) -> int {
    if step <= 0.0 { return 0 }
    q = ((x - least) / step + 0.5) as int
    if q < 0 { q = 0 }
    if q > 65535 { q = 65535 }
    return q
}

// The most track `k` kept as `kind` moves a point of the skin over the
// take, metres: a place by how far it is off, a turn by the chord it
// sweeps at `reach`, a scale by how far it moves what is `reach` away.
pack_error(t: *Take, k: int, kind: int, reach: float, v: float[], at: int, hold: ptr) -> float {
    part = k % 3
    base = (k / 3) * pose.FLOATS + track_offset(part)
    d = t.data as float[]
    worst = 0.0
    f = 0
    while f < t.frames {
        src = f * t.stride + base
        x, y, z, w = pack_value(d, src, part, kind, v, at, hold)
        e = 0.0
        if part == 1 {
            ax = d[src]
            ay = d[src + 1]
            az = d[src + 2]
            aw = d[src + 3]
            la = core.sqrt_of(ax * ax + ay * ay + az * az + aw * aw)
            lb = core.sqrt_of(x * x + y * y + z * z + w * w)
            if la > 0.0 && lb > 0.0 {
                dot = (ax * x + ay * y + az * z + aw * w) / (la * lb)
                s = 1.0 - dot * dot
                if s < 0.0 { s = 0.0 }
                e = 2.0 * reach * core.sqrt_of(s)
            }
        } else {
            dx = x - d[src]
            dy = y - d[src + 1]
            dz = z - d[src + 2]
            e = core.sqrt_of(dx * dx + dy * dy + dz * dz)
            if part == 2 { e = e * reach }
        }
        if e > worst { worst = e }
        f = f + 1
    }
    return worst
}

// A track's numbers at `src` as kind `kind` would give them back.
pack_value(d: float[], src: int, part: int, kind: int, v: float[], at: int, hold: ptr) -> (float, float, float, float) {
    if kind == PACK_CONST { return v[at], v[at + 1], v[at + 2], v[at + 3] }
    if kind == PACK_Q16 {
        x = v[at] + (pack_q16(pack_number(d, src, 0, part), v[at], v[at + 4]) as float) * v[at + 4]
        y = v[at + 1] + (pack_q16(pack_number(d, src, 1, part), v[at + 1], v[at + 5]) as float) * v[at + 5]
        z = v[at + 2] + (pack_q16(pack_number(d, src, 2, part), v[at + 2], v[at + 6]) as float) * v[at + 6]
        if part == 1 { return x, y, z, pack_w(x, y, z) }
        return x, y, z, 0.0
    }
    if kind == PACK_F32 {
        h = hold as f32[]
        h[3] = 0.0
        c = 0
        while c < track_width(part) {
            h[c] = d[src + c]
            c = c + 1
        }
        return h[0] as float, h[1] as float, h[2] as float, h[3] as float
    }
    w = 0.0
    if part == 1 { w = d[src + 3] }
    return d[src], d[src + 1], d[src + 2], w
}

// A unit quaternion's w from its x, y and z, w not negative.
pack_w(x: float, y: float, z: float) -> float {
    s = 1.0 - x * x - y * y - z * z
    if s <= 0.0 { return 0.0 }
    return core.sqrt_of(s)
}

// Each track's place in a frame's record, the widest kinds first so every
// number sits on its own size; and the record's bytes, on 8.
pack_layout(pk: *Packed, n: int) {
    kinds = pk.kinds as int[]
    at = pk.at as int[]
    offset = 0
    kind = PACK_F64
    while kind >= PACK_Q16 {
        k = 0
        while k < n * 3 {
            if kinds[k] == kind {
                at[k] = offset
                offset = offset + track_bytes(kind, k % 3)
            }
            k = k + 1
        }
        kind = kind - 1
    }
    pk.record = ((offset + 7) / 8) * 8
}

// The records written from the take's frames, and its curves kept as they
// are.
pack_fill(t: *Take, pk: *Packed) {
    n = t.count
    pk.bytes = calloc(t.frames * pk.record + 8, 1)
    kinds = pk.kinds as int[]
    at = pk.at as int[]
    v = pk.values as float[]
    d = t.data as float[]
    f = 0
    while f < t.frames {
        rec = pk.bytes + f * pk.record
        k = 0
        while k < n * 3 {
            part = k % 3
            src = f * t.stride + (k / 3) * pose.FLOATS + track_offset(part)
            kind = kinds[k]
            if kind == PACK_Q16 {
                q = (rec + at[k]) as uint16[]
                c = 0
                while c < 3 {
                    q[c] = pack_q16(pack_number(d, src, c, part), v[k * 8 + c], v[k * 8 + 4 + c])
                    c = c + 1
                }
            } else if kind == PACK_F32 {
                s = (rec + at[k]) as f32[]
                c = 0
                while c < track_width(part) {
                    s[c] = d[src + c]
                    c = c + 1
                }
            } else if kind == PACK_F64 {
                s64 = (rec + at[k]) as float[]
                c = 0
                while c < track_width(part) {
                    s64[c] = d[src + c]
                    c = c + 1
                }
            }
            k = k + 1
        }
        f = f + 1
    }
    // The still tracks laid in a pose once, and the moving ones listed.
    // Between two frames a still turn is nlerped with itself, as pose.blend
    // blends one: over its length (a turn read from a file is a unit one
    // only to its float's rounding).
    if pk.still == null { pk.still = calloc(n * pose.FLOATS + 1, 8) }
    if pk.still_blend == null { pk.still_blend = calloc(n * pose.FLOATS + 1, 8) }
    if pk.moving == null { pk.moving = calloc(n * 3 + 1, 4) }
    still = pk.still as float[]
    blended = pk.still_blend as float[]
    moving = pk.moving as int[]
    pk.moving_count = 0
    k = 0
    while k < n * 3 {
        if kinds[k] == PACK_CONST {
            base = (k / 3) * pose.FLOATS + track_offset(k % 3)
            c = 0
            while c < track_width(k % 3) {
                still[base + c] = v[k * 8 + c]
                blended[base + c] = v[k * 8 + c]
                c = c + 1
            }
            if k % 3 == 1 {
                x = v[k * 8]
                y = v[k * 8 + 1]
                z = v[k * 8 + 2]
                w = v[k * 8 + 3]
                length = core.sqrt_of(x * x + y * y + z * z + w * w)
                if length < 0.000000001 { length = 1.0 }
                blended[base] = x / length
                blended[base + 1] = y / length
                blended[base + 2] = z / length
                blended[base + 3] = w / length
            }
        } else {
            moving[pk.moving_count] = k
            pk.moving_count = pk.moving_count + 1
        }
        k = k + 1
    }
    curves = t.stride - n * pose.FLOATS
    if curves > 0 && pk.curves == null {
        pk.curves = calloc(t.frames * curves + 1, 8)
        cv = pk.curves as float[]
        f = 0
        while f < t.frames {
            c = 0
            while c < curves {
                cv[f * curves + c] = d[f * t.stride + n * pose.FLOATS + c]
                c = c + 1
            }
            f = f + 1
        }
    }
}

// Track `k`'s numbers in record `rec`.
track_read(pk: *Packed, rec: ptr, k: int) -> (float, float, float, float) {
    kind = (pk.kinds as int[])[k]
    v = pk.values as float[]
    at = k * 8
    if kind == PACK_CONST { return v[at], v[at + 1], v[at + 2], v[at + 3] }
    place = rec + (pk.at as int[])[k]
    if kind == PACK_Q16 {
        q = place as uint16[]
        x = v[at] + (q[0] as float) * v[at + 4]
        y = v[at + 1] + (q[1] as float) * v[at + 5]
        z = v[at + 2] + (q[2] as float) * v[at + 6]
        if k % 3 == 1 { return x, y, z, pack_w(x, y, z) }
        return x, y, z, 0.0
    }
    if kind == PACK_F32 {
        s = place as f32[]
        if k % 3 == 1 { return s[0] as float, s[1] as float, s[2] as float, s[3] as float }
        return s[0] as float, s[1] as float, s[2] as float, 0.0
    }
    s64 = place as float[]
    if k % 3 == 1 { return s64[0], s64[1], s64[2], s64[3] }
    return s64[0], s64[1], s64[2], 0.0
}

// Frame `f` of a compressed take decoded into pose `out`: its record, or,
// a frame dropped (pack_reduce), the blend of the keys either side of it.
packed_frame(t: *Take, f: int, out: ptr) {
    pk = t.packed as *Packed
    k0 = f
    if k0 < 0 { k0 = 0 }
    if k0 >= t.frames { k0 = t.frames - 1 }
    if pk.keys == null {
        record_decode(t, pk, pk.bytes + k0 * pk.record, out)
    } else {
        keys = pk.keys as int[]
        ka = (pk.key_of as int[])[k0]
        if keys[ka] == k0 {
            record_decode(t, pk, pk.bytes + ka * pk.record, out)
        } else {
            ra = pk.bytes + ka * pk.record
            records_blend(t, pk, ra, ra + pk.record, ((k0 - keys[ka]) as float) / ((keys[ka + 1] - keys[ka]) as float), out)
        }
    }
    packed_curves(t, k0, k0, 0.0, out)
}

// Record `rec`'s pose (the take's tracks; not its curves) into `out`.
record_decode(t: *Take, pk: *Packed, rec: ptr, out: ptr) {
    o = out as float[]
    memcpy(out, pk.still, ((t.count * pose.FLOATS) as long) * (8 as long))
    moving = pk.moving as int[]
    m = 0
    while m < pk.moving_count {
        k = moving[m]
        x, y, z, w = track_read(pk, rec, k)
        at = (k / 3) * pose.FLOATS + track_offset(k % 3)
        o[at] = x
        o[at + 1] = y
        o[at + 2] = z
        if k % 3 == 1 { o[at + 3] = w }
        m = m + 1
    }
}

// The curves `u` of the way from frame `f0` to frame `f1`, lerped as
// pose.blend lerps them.
packed_curves(t: *Take, f0: int, f1: int, u: float, out: ptr) {
    pk = t.packed as *Packed
    if pk.curves == null { return }
    curves = t.stride - t.count * pose.FLOATS
    cv = pk.curves as float[]
    o = out as float[]
    base = t.count * pose.FLOATS
    c = 0
    while c < curves {
        a = cv[f0 * curves + c]
        b = cv[f1 * curves + c]
        if u <= 0.0 {
            o[base + c] = a
        } else if u >= 1.0 {
            o[base + c] = b
        } else {
            o[base + c] = a + (b - a) * u
        }
        c = c + 1
    }
}

// A compressed take `u` of the way from frame `f0` to the next, into
// `out`: each track decoded at the two and blended as pose.blend blends two
// poses, places and scales lerped and turns nlerped the short way; a still
// track written once.
packed_blend(t: *Take, f0: int, u: float, out: ptr) {
    if u <= 0.0 {
        packed_frame(t, f0, out)
        return
    }
    if u >= 1.0 {
        packed_frame(t, f0 + 1, out)
        return
    }
    pk = t.packed as *Packed
    ra = pk.bytes + f0 * pk.record
    w = u
    if pk.keys != null {
        // Between the keys either side (pack_reduce): the last frame is
        // one, so a frame before it has one after it.
        keys = pk.keys as int[]
        ka = (pk.key_of as int[])[f0]
        ra = pk.bytes + ka * pk.record
        w = (((f0 - keys[ka]) as float) + u) / ((keys[ka + 1] - keys[ka]) as float)
    }
    records_blend(t, pk, ra, ra + pk.record, w, out)
    packed_curves(t, f0, f0 + 1, u, out)
}

// Records `ra` and `rb` blended `u` of the way (0 < u < 1) into `out`, the
// take's tracks (not its curves): each track decoded at the two and blended
// as pose.blend blends two poses, places and scales lerped and turns
// nlerped the short way; a still track written once.
records_blend(t: *Take, pk: *Packed, ra: ptr, rb: ptr, u: float, out: ptr) {
    kinds = pk.kinds as int[]
    offsets = pk.at as int[]
    v = pk.values as float[]
    o = out as float[]
    memcpy(out, pk.still_blend, ((t.count * pose.FLOATS) as long) * (8 as long))
    moving = pk.moving as int[]
    m = 0
    while m < pk.moving_count {
        k = moving[m]
        part = k % 3
        at = (k / 3) * pose.FLOATS + track_offset(part)
        if kinds[k] == PACK_Q16 && part == 1 {
            // A 16-bit turn, the commonest moving track, read in place.
            qa = (ra + offsets[k]) as uint16[]
            qb = (rb + offsets[k]) as uint16[]
            vk = k * 8
            ax = v[vk] + (qa[0] as float) * v[vk + 4]
            ay = v[vk + 1] + (qa[1] as float) * v[vk + 5]
            az = v[vk + 2] + (qa[2] as float) * v[vk + 6]
            bx = v[vk] + (qb[0] as float) * v[vk + 4]
            by = v[vk + 1] + (qb[1] as float) * v[vk + 5]
            bz = v[vk + 2] + (qb[2] as float) * v[vk + 6]
            pack_nlerp(ax, ay, az, pack_w(ax, ay, az), bx, by, bz, pack_w(bx, by, bz), u, o, at)
        } else {
            ax, ay, az, aw = track_read(pk, ra, k)
            bx, by, bz, bw = track_read(pk, rb, k)
            if part == 1 {
                pack_nlerp(ax, ay, az, aw, bx, by, bz, bw, u, o, at)
            } else {
                o[at] = ax + (bx - ax) * u
                o[at + 1] = ay + (by - ay) * u
                o[at + 2] = az + (bz - az) * u
            }
        }
        m = m + 1
    }
}

// Two turns nlerped `u` of the way the short way, into `o` at `at`, as
// pose.blend blends a joint's.
pack_nlerp(ax: float, ay: float, az: float, aw: float, bx: float, by: float, bz: float, bw: float, u: float, o: float[], at: int) {
    d = ax * bx + ay * by + az * bz + aw * bw
    sign = 1.0
    if d < 0.0 { sign = 0.0 - 1.0 }
    x = ax + (sign * bx - ax) * u
    y = ay + (sign * by - ay) * u
    z = az + (sign * bz - az) * u
    w = aw + (sign * bw - aw) * u
    length = core.sqrt_of(x * x + y * y + z * z + w * w)
    if length < 0.000000001 { length = 1.0 }
    o[at] = x / length
    o[at + 1] = y / length
    o[at + 2] = z / length
    o[at + 3] = w / length
}

// The most the records `pk` move a point of the skin from where the take's
// own frames put it, metres, over every frame in the rig's space (each
// joint and its three virtual vertices `shell` away along its axes), and
// the joint they move most.
pack_measure(t: *Take, rig: *Rig, pk: *Packed, shell: float[]) -> (float, int) {
    held = t.packed
    t.packed = pk as ptr
    raw = pose.new(rig)
    got = pose.new(rig)
    wa = pose.new(rig)
    wb = pose.new(rig)
    worst = 0.0
    worst_j = 0
    f = 0
    while f < t.frames {
        pose.copy(rig, t.data + f * t.stride * 8, raw)
        packed_frame(t, f, got)
        pose.world(rig, raw, wa)
        pose.world(rig, got, wb)
        j = 0
        while j < t.count {
            e = pack_point_error(wa, wb, j, shell[j])
            if e > worst {
                worst = e
                worst_j = j
            }
            j = j + 1
        }
        f = f + 1
    }
    pose.release(raw)
    pose.release(got)
    pose.release(wa)
    pose.release(wb)
    t.packed = held
    return worst, worst_j
}

// How far joint `j` and its virtual vertices `d` along its axes are apart
// in two rig-space poses: the most of the four.
pack_point_error(wa: ptr, wb: ptr, j: int, d: float) -> float {
    pa = pose.translation(wa, j)
    pb = pose.translation(wb, j)
    qa = pose.rotation(wa, j)
    qb = pose.rotation(wb, j)
    sa = pose.scale(wa, j)
    sb = pose.scale(wb, j)
    worst = core.v3_len(core.v3_sub(pa, pb))
    axis = 0
    while axis < 3 {
        e = core.vec3(d, 0.0, 0.0)
        if axis == 1 { e = core.vec3(0.0, d, 0.0) }
        if axis == 2 { e = core.vec3(0.0, 0.0, d) }
        va = core.v3_add(pa, core.quat_apply(qa, core.vec3(e.x * sa.x, e.y * sa.y, e.z * sa.z)))
        vb = core.v3_add(pb, core.quat_apply(qb, core.vec3(e.x * sb.x, e.y * sb.y, e.z * sb.z)))
        x = core.v3_len(core.v3_sub(va, vb))
        if x > worst { worst = x }
        axis = axis + 1
    }
    return worst
}

// Every track of joint `j` and of the joints above it one kind finer (a
// still one to 32-bit floats).
pack_finer(rig: *Rig, pk: *Packed, j: int) {
    kinds = pk.kinds as int[]
    at = j
    while at >= 0 {
        p = 0
        while p < 3 {
            k = at * 3 + p
            if kinds[k] == PACK_CONST {
                kinds[k] = PACK_F32
            } else if kinds[k] < PACK_F64 {
                kinds[k] = kinds[k] + 1
            }
            p = p + 1
        }
        at = pose.parent(rig, at)
    }
}

// The keys `pk` (every frame a record) keeps: from each key, the next is the
// farthest frame (at most KEY_SPAN on) whose blend with it puts every frame
// between, and every point halfway between two frames, within KEY_SHARE of
// the bound at the skin of the take's own, in the rig's space (each joint
// and its virtual vertices `shell` along its axes). The records not kept
// go. Whether any frame was dropped.
pack_reduce(t: *Take, rig: *Rig, pk: *Packed, shell: float[]) -> bool {
    frames = t.frames
    if frames < 3 { return false }
    size = pose.size(rig)
    bound = COMPRESS_ERROR * KEY_SHARE
    // The take's own poses in the rig's space, at its frames and halfway.
    at_frames = calloc(frames * size + 1, 8)
    halves = calloc(frames * size + 1, 8)
    raw = pose.new(rig)
    mid = pose.new(rig)
    f = 0
    while f < frames {
        pose.copy(rig, t.data + f * t.stride * 8, raw)
        pose.world(rig, raw, at_frames + f * size * 8)
        if f + 1 < frames {
            pose.blend(rig, t.data + f * t.stride * 8, t.data + (f + 1) * t.stride * 8, 0.5, mid)
            pose.world(rig, mid, halves + f * size * 8)
        }
        f = f + 1
    }
    got = pose.new(rig)
    wb = pose.new(rig)
    keys = calloc(frames + 1, 4) as int[]
    count = 1
    keys[0] = 0
    a = 0
    while a < frames - 1 {
        b = a + 1
        // The farthest b whose span holds; a span of one always does.
        while b + 1 < frames && b + 1 - a <= KEY_SPAN && span_holds(t, rig, pk, a, b + 1, at_frames, halves, got, wb, shell, bound) { b = b + 1 }
        keys[count] = b
        count = count + 1
        a = b
    }
    pose.release(raw)
    pose.release(mid)
    pose.release(got)
    pose.release(wb)
    free(at_frames)
    free(halves)
    if count >= frames {
        free(keys as ptr)
        return false
    }
    // The kept records, in order, and each frame's key.
    bytes = calloc(count * pk.record + 8, 1)
    key_of = calloc(frames + 1, 4) as int[]
    k = 0
    while k < count {
        memcpy(bytes + k * pk.record, pk.bytes + keys[k] * pk.record, pk.record as long)
        f = keys[k]
        last = frames
        if k + 1 < count { last = keys[k + 1] }
        while f < last {
            key_of[f] = k
            f = f + 1
        }
        k = k + 1
    }
    free(pk.bytes)
    pk.bytes = bytes
    pk.keys = keys as ptr
    pk.key_of = key_of as ptr
    pk.key_count = count
    return true
}

// Whether keys at frames `a` and `b` (records as every frame has one now)
// blended put every frame between them, and every point halfway between
// two frames, within `bound` of the take's own (`at_frames` and `halves`,
// rig space). `got` and `wb` scratch.
span_holds(t: *Take, rig: *Rig, pk: *Packed, a: int, b: int, at_frames: ptr, halves: ptr, got: ptr, wb: ptr, shell: float[], bound: float) -> bool {
    size = pose.size(rig)
    ra = pk.bytes + a * pk.record
    rb = pk.bytes + b * pk.record
    span = (b - a) as float
    i = a
    while i < b {
        // Frame i (a's own is exact) and halfway on to the next.
        h = 0
        while h < 2 {
            if i > a || h == 1 {
                x = (i as float) + 0.5 * (h as float)
                records_blend(t, pk, ra, rb, (x - (a as float)) / span, got)
                pose.world(rig, got, wb)
                want = at_frames + i * size * 8
                if h == 1 { want = halves + i * size * 8 }
                j = 0
                while j < t.count {
                    if pack_point_error(want, wb, j, shell[j]) > bound { return false }
                    j = j + 1
                }
            }
            h = h + 1
        }
        i = i + 1
    }
    return true
}

// The frames written back from their records: a program that writes a
// take's frames has them as they were decoded, the take no longer
// compressed.
unpack(t: *Take) {
    if t.packed == null { return }
    pk = t.packed as *Packed
    data = calloc(t.frames * t.stride + 1, 8)
    f = 0
    while f < t.frames {
        packed_frame(t, f, data + f * t.stride * 8)
        f = f + 1
    }
    t.data = data
    t.packed = null
    packed_free(pk)
}

packed_free(pk: *Packed) {
    if pk == null { return }
    free(pk.kinds)
    free(pk.at)
    free(pk.values)
    free(pk.bytes)
    if pk.curves != null { free(pk.curves) }
    if pk.still != null { free(pk.still) }
    if pk.still_blend != null { free(pk.still_blend) }
    if pk.moving != null { free(pk.moving) }
    if pk.keys != null { free(pk.keys) }
    if pk.key_of != null { free(pk.key_of) }
    heap.free(pk)
}

// How many of compressed take `t`'s frames are kept as keys (the rest
// blended from them, #992), and the bytes a key's record holds; its frames
// and 0 for a take that is not compressed.
keys_kept(t: *Take) -> (int, int) {
    if t == null || t.packed == null { return t.frames, 0 }
    pk = t.packed as *Packed
    if pk.keys == null { return t.frames, pk.record }
    return pk.key_count, pk.record
}

// Whether take `t` is compressed, and the most its compression moves a
// point of the skin, metres (0 for one that is not).
compressed(t: *Take) -> bool { return t != null && t.packed != null }

compress_error(t: *Take) -> float {
    if t == null || t.packed == null { return 0.0 }
    return (t.packed as *Packed).error
}

// The bytes take `t` holds: its frames, compressed or not, its root's
// motion and its feet's contacts (eight numbers a frame), and its events.
take_bytes(t: *Take) -> long {
    if t == null { return 0 as long }
    total = (t.frames as long) * (64 as long)
    if t.packed != null {
        pk = t.packed as *Packed
        // Its records; each track's kind, place, numbers and listing; its two still poses.
        records = t.frames
        if pk.keys != null {
            // A record a key, and each key's frame and each frame's key.
            records = pk.key_count
            total = total + ((pk.key_count + t.frames) as long) * (4 as long)
        }
        total = total + (records as long) * (pk.record as long) + ((t.count * 3) as long) * (76 as long) + ((t.count * pose.FLOATS) as long) * (16 as long)
        if pk.curves != null { total = total + ((t.frames * (t.stride - t.count * pose.FLOATS)) as long) * (8 as long) }
    } else if t.data != null {
        total = total + ((t.frames * t.stride) as long) * (8 as long)
    }
    return total + (list.size(t.events) as long) * (32 as long)
}

// How many of take `t`'s tracks are of each kind: still, 16-bit, 32-bit
// and 64-bit.
track_kinds(t: *Take) -> (int, int, int, int) {
    if t == null || t.packed == null { return 0, 0, 0, 0 }
    kinds = (t.packed as *Packed).kinds as int[]
    still = 0
    q16 = 0
    f32s = 0
    f64s = 0
    k = 0
    while k < t.count * 3 {
        if kinds[k] == PACK_CONST { still = still + 1 }
        if kinds[k] == PACK_Q16 { q16 = q16 + 1 }
        if kinds[k] == PACK_F32 { f32s = f32s + 1 }
        if kinds[k] == PACK_F64 { f64s = f64s + 1 }
        k = k + 1
    }
    return still, q16, f32s, f64s
}
