// Faces (#910): an ARKit-like face set mapped onto a model's morph targets,
// as ae3d.pose maps a body onto the humanoid layout, and procedural blinks.
//
//   map = face.map_of(head)                 // its targets by what they do
//   blinker = face.blinker_new(seed)
//   face.blink_step(blinker, dt)            // each frame
//   face.blink_apply(blinker, map)          // eyeBlinkLeft and Right weighed
//
// The face set is Apple ARKit's 52 blend shapes (ARFaceAnchor.BlendShape
// Location), the layout face capture (Live Link Face, MetaHuman's ARKit
// curves) and most rigged heads (Character Creator, Ready Player Me, VRoid's
// perfect sync) are made for. A head's targets are found by name however its
// tool writes them: case, separators and a mesh prefix aside ("Face.eye_Blink_L"
// is eyeBlinkLeft), and _L, _R, .L, Left and Right taken as the side.
//
// A blink is timed as a person's: some 15 to 20 a minute at rest (Bentivoglio
// et al. 1997, 17 a minute), the intervals between them irregular (drawn
// here from 1.2 to 6 s around a mean of 3.5 s); the lid closing in about 100
// ms, faster as it goes, held shut for a few tens of milliseconds, and opening
// slower, about 150 to 200 ms, easing out (Kwon et al. 2013: closing 100 ms,
// opening roughly twice as long). Both eyes together, as a spontaneous blink
// is. Deterministic from its seed: a replay blinks as the run did.
import std.heap
import std.string
import std.mem
import std.bytes
import ae3d.core
import ae3d.morph

exports (
    FaceMap, Blinker, SHAPES, shape_name, shape_of,
    EYE_BLINK_LEFT, EYE_BLINK_RIGHT, JAW_OPEN, MOUTH_SMILE_LEFT, MOUTH_SMILE_RIGHT,
    map_of, map_free, target, mapped, set_shape, shape_weight,
    blinker_new, blinker_free, blink_step, blink_apply, blink_weight, blinks, blink_set_rate, blink_now, blink_on_shift,
    CLOSING, HELD, OPENING,
    Saccades, saccades_new, saccades_free, saccades_step, saccades_reset, saccade_yaw, saccade_pitch,
    saccade_duration, saccades_made, microsaccades_made,
    SACCADE_BASE, SACCADE_PER_DEGREE, FIXATION_SHORTEST, FIXATION_LONGEST, MICRO_MOST, SHIFT_BLINK_DEGREES, SHIFT_BLINK_SHARE
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const SHAPES = 52

// The slots used by name in code; the rest by shape_of.
const EYE_BLINK_LEFT = 0
const EYE_BLINK_RIGHT = 7
const JAW_OPEN = 17
const MOUTH_SMILE_LEFT = 23
const MOUTH_SMILE_RIGHT = 24

// A blink's phases, seconds.
const CLOSING = 0.1
const HELD = 0.04
const OPENING = 0.18

// ARKit's 52, in its documentation's order: the eyes (left, then right),
// the jaw, the mouth, the brows, the cheeks, the nose, the tongue.
shape_name(slot: int) -> string {
    if slot == 0 { return "eyeBlinkLeft" }
    if slot == 1 { return "eyeLookDownLeft" }
    if slot == 2 { return "eyeLookInLeft" }
    if slot == 3 { return "eyeLookOutLeft" }
    if slot == 4 { return "eyeLookUpLeft" }
    if slot == 5 { return "eyeSquintLeft" }
    if slot == 6 { return "eyeWideLeft" }
    if slot == 7 { return "eyeBlinkRight" }
    if slot == 8 { return "eyeLookDownRight" }
    if slot == 9 { return "eyeLookInRight" }
    if slot == 10 { return "eyeLookOutRight" }
    if slot == 11 { return "eyeLookUpRight" }
    if slot == 12 { return "eyeSquintRight" }
    if slot == 13 { return "eyeWideRight" }
    if slot == 14 { return "jawForward" }
    if slot == 15 { return "jawLeft" }
    if slot == 16 { return "jawRight" }
    if slot == 17 { return "jawOpen" }
    if slot == 18 { return "mouthClose" }
    if slot == 19 { return "mouthFunnel" }
    if slot == 20 { return "mouthPucker" }
    if slot == 21 { return "mouthLeft" }
    if slot == 22 { return "mouthRight" }
    if slot == 23 { return "mouthSmileLeft" }
    if slot == 24 { return "mouthSmileRight" }
    if slot == 25 { return "mouthFrownLeft" }
    if slot == 26 { return "mouthFrownRight" }
    if slot == 27 { return "mouthDimpleLeft" }
    if slot == 28 { return "mouthDimpleRight" }
    if slot == 29 { return "mouthStretchLeft" }
    if slot == 30 { return "mouthStretchRight" }
    if slot == 31 { return "mouthRollLower" }
    if slot == 32 { return "mouthRollUpper" }
    if slot == 33 { return "mouthShrugLower" }
    if slot == 34 { return "mouthShrugUpper" }
    if slot == 35 { return "mouthPressLeft" }
    if slot == 36 { return "mouthPressRight" }
    if slot == 37 { return "mouthLowerDownLeft" }
    if slot == 38 { return "mouthLowerDownRight" }
    if slot == 39 { return "mouthUpperUpLeft" }
    if slot == 40 { return "mouthUpperUpRight" }
    if slot == 41 { return "browDownLeft" }
    if slot == 42 { return "browDownRight" }
    if slot == 43 { return "browInnerUp" }
    if slot == 44 { return "browOuterUpLeft" }
    if slot == 45 { return "browOuterUpRight" }
    if slot == 46 { return "cheekPuff" }
    if slot == 47 { return "cheekSquintLeft" }
    if slot == 48 { return "cheekSquintRight" }
    if slot == 49 { return "noseSneerLeft" }
    if slot == 50 { return "noseSneerRight" }
    if slot == 51 { return "tongueOut" }
    return ""
}

// A name as the map compares it: after the last '.' or ':' (a mesh's or a
// namespace's prefix), lower case, letters and digits only, and a side
// written as a trailing l or r (or left / right) made "left" / "right".
key_of(given: string) -> string {
    n = string.length(given)
    // Blender's side, ".L" or ".R", is a side and not a prefix.
    if n > 2 && string.char_at(given, n - 2) == 46 {
        last = string.char_at(given, n - 1)
        if last == 76 || last == 108 || last == 82 || last == 114 {
            stem = string.substring(given, 0, n - 2)
            body = key_of(stem)
            word = "left"
            if last == 82 || last == 114 { word = "right" }
            sided = string.concat(body, word)
            string.free(stem)
            string.free(body)
            return sided
        }
    }
    from = 0
    i = 0
    while i < n {
        c = string.char_at(given, i)
        if c == 46 || c == 58 { from = i + 1 }
        i = i + 1
    }
    letters = calloc(n + 8, 1)
    count = 0
    // Where the last separator was, to read a trailing "_l" as a side.
    last_cut = 0 - 1
    i = from
    while i < n {
        c = string.char_at(given, i)
        if c >= 65 && c <= 90 { c = c + 32 }
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            mem.set_uint8(letters, count, c)
            count = count + 1
        } else {
            last_cut = count
        }
        i = i + 1
    }
    text = string.copy(bytes.string_from_ptr(letters, count))
    free(letters)
    // A side after a separator: "eye_blink_l" is eyeblinkleft.
    if last_cut >= 0 && last_cut == count - 1 && count > 1 {
        side = string.char_at(text, count - 1)
        if side == 108 || side == 114 {
            stem = string.substring(text, 0, count - 1)
            word = "left"
            if side == 114 { word = "right" }
            sided = string.concat(stem, word)
            string.free(stem)
            string.free(text)
            return sided
        }
    }
    return text
}

// The slot a target of that name fills, -1 for none of the 52. A head made
// in VRoid Studio names its own set (Fcl_EYE_Close_L, after a mesh's
// prefix, "Face.M_F00_000_00_Fcl_EYE_Close_L"): its eyes' closing, the
// shapes of it that are ARKit's, are taken as the blinks.
shape_of(given: string) -> int {
    k = key_of(given)
    found = 0 - 1
    slot = 0
    while slot < SHAPES && found < 0 {
        candidate = key_of(shape_name(slot))
        if candidate == k { found = slot }
        string.free(candidate)
        slot = slot + 1
    }
    if found < 0 && string.ends_with(k, "fcleyecloseleft") == 1 { found = EYE_BLINK_LEFT }
    if found < 0 && string.ends_with(k, "fcleyecloseright") == 1 { found = EYE_BLINK_RIGHT }
    string.free(k)
    return found
}

// A head's face: for each of the 52 shapes, the morph target of its model
// that is that shape (-1 for none), and the model whose weights draw it
// (the driver, for a glTF primitive), borrowed.
struct FaceMap {
    model: ptr
    targets: ptr                   // int[SHAPES]
    found: int
}

// The face set of model `m`'s morph targets by their names; a map with none
// found where it has no targets or none of the 52.
map_of(m: *Model) -> *FaceMap {
    f = heap.new(FaceMap)
    f.targets = calloc(SHAPES, 4)
    t = f.targets as int[]
    i = 0
    while i < SHAPES {
        t[i] = 0 - 1
        i = i + 1
    }
    f.model = m as ptr
    if m != null && m.morph_driver != null { f.model = m.morph_driver }
    if m == null || m.morph == null { return f }
    set = m.morph as *MorphSet
    k = 0
    while k < morph.count(set) {
        slot = shape_of(morph.name(set, k))
        if slot >= 0 && t[slot] < 0 {
            t[slot] = k
            f.found = f.found + 1
        }
        k = k + 1
    }
    return f
}

map_free(f: *FaceMap) {
    if f == null { return }
    free(f.targets)
    heap.free(f)
}

// The morph target that is shape `slot`, -1 for none; and how many of the 52
// the head has.
target(f: *FaceMap, slot: int) -> int {
    if f == null || slot < 0 || slot >= SHAPES { return 0 - 1 }
    return (f.targets as int[])[slot]
}

mapped(f: *FaceMap) -> int {
    if f == null { return 0 }
    return f.found
}

// Shape `slot` weighed at `weight`, where the head has it.
set_shape(f: *FaceMap, slot: int, weight: float) {
    t = target(f, slot)
    if t >= 0 { core.model_set_morph_weight(f.model as *Model, t, weight) }
}

shape_weight(f: *FaceMap, slot: int) -> float {
    t = target(f, slot)
    if t < 0 { return 0.0 }
    return core.model_morph_weight(f.model as *Model, t)
}

// --- blinks ---------------------------------------------------------------------------------------

struct Blinker {
    seed: int
    clock: float                   // seconds since the last blink began
    next: float                    // the interval until the next one begins
    mean: float                    // the mean interval, seconds
    weight: float                  // the lids now, 0 open to 1 shut
    count: int                     // blinks begun
}

// A deterministic draw in [0, 1) from the blinker's seed (a 31-bit LCG,
// Park and Miller's).
draw(b: *Blinker) -> float {
    b.seed = ((b.seed as long) * (48271 as long) % (2147483647 as long)) as int
    return (b.seed as float) / 2147483647.0
}

// The next interval: irregular about the mean, as people's are -- the
// average of two draws, spread from 0.35 to 1.7 times the mean.
interval(b: *Blinker) -> float {
    u = (draw(b) + draw(b)) * 0.5
    return b.mean * (0.35 + 1.35 * u)
}

blinker_new(seed: int) -> *Blinker {
    b = heap.new(Blinker)
    b.seed = seed % 2147483646 + 1
    if b.seed <= 0 { b.seed = 1 }
    b.mean = 3.5
    b.next = interval(b) * draw(b)
    b.clock = 0.0
    return b
}

blinker_free(b: *Blinker) { if b != null { heap.free(b) } }

// Blinks a minute at rest, about which the intervals are drawn (17 by
// default; fewer while reading or concentrating, more when tired or talking).
blink_set_rate(b: *Blinker, per_minute: float) {
    if per_minute <= 0.0 { return }
    b.mean = 60.0 / per_minute / 1.025
}

// The lids at `t` seconds into a blink: closing on a quadratic ease-in for
// CLOSING (the lid speeds up as it falls), shut for HELD, opening for
// OPENING on a smoothstep (the slower, gentler half), open after.
lids_at(t: float) -> float {
    if t < 0.0 { return 0.0 }
    if t < CLOSING {
        u = t / CLOSING
        return u * u
    }
    if t < CLOSING + HELD { return 1.0 }
    if t < CLOSING + HELD + OPENING {
        u = (t - CLOSING - HELD) / OPENING
        return 1.0 - u * u * (3.0 - 2.0 * u)
    }
    return 0.0
}

// The blinker `dt` seconds on: a blink begun when its interval since the
// last one began is up, the clock then counting into it. The intervals are
// never shorter than a blink and a fifth of a second, so one never starts
// while another is under way.
blink_step(b: *Blinker, dt: float) {
    b.clock = b.clock + dt
    if b.clock >= b.next {
        b.clock = b.clock - b.next
        b.next = interval(b)
        span = CLOSING + HELD + OPENING
        if b.next < span + 0.2 { b.next = span + 0.2 }
        b.count = b.count + 1
    }
    if b.count > 0 { b.weight = lids_at(b.clock) } else { b.weight = 0.0 }
}

// A blink begun now, unless one is under way: the blink that goes with a
// large gaze shift (people blink on about a third of shifts over 30
// degrees, Evinger et al. 1994), or one a game asks for. The next
// spontaneous one is drawn from here.
blink_now(b: *Blinker) -> bool {
    span = CLOSING + HELD + OPENING
    if b.count > 0 && b.clock < span { return false }
    b.clock = 0.0
    b.next = interval(b)
    if b.next < span + 0.2 { b.next = span + 0.2 }
    b.count = b.count + 1
    b.weight = lids_at(0.0)
    return true
}

// A gaze shift of `degrees`: a blink with it on a third of those over 30
// (drawn from the blinker's seed, so a replay blinks on the same shifts).
// Whether one began.
blink_on_shift(b: *Blinker, degrees: float) -> bool {
    if degrees <= SHIFT_BLINK_DEGREES { return false }
    if draw(b) >= SHIFT_BLINK_SHARE { return false }
    return blink_now(b)
}

blink_weight(b: *Blinker) -> float { return b.weight }

// --- saccades -------------------------------------------------------------------------------------
//
// The eyes never hold still on what they look at: they fixate for 200 to 400
// ms, then jump. Most jumps are small saccades to another feature of what is
// looked at (here within SCAN_DEGREES of it); between them the eye drifts
// and makes microsaccades, jumps under a degree. A saccade's duration
// follows its amplitude, the main sequence (Bahill et al. 1975, Carpenter
// 1988): about 21 to 30 ms plus 2 to 3 ms a degree, here 24 ms plus 2.5 ms
// a degree, on a minimum-jerk profile (the velocity a bell, as measured).
// The offsets are angles off the line to the point looked at, which the
// look (ikrig) turns the eyes by. Deterministic from a seed.

const SACCADE_BASE = 0.024         // seconds
const SACCADE_PER_DEGREE = 0.0025  // seconds a degree
const FIXATION_SHORTEST = 0.2
const FIXATION_LONGEST = 0.4
const SCAN_DEGREES = 5.0           // how far from the point looked at a saccade goes
const MICRO_SHARE = 0.4            // of the jumps, how many are microsaccades
const MICRO_LEAST = 0.15           // degrees
const MICRO_MOST = 0.8
const SACCADE_LEAST = 1.5          // degrees: a saccade proper is at least this
const SHIFT_BLINK_DEGREES = 30.0
const SHIFT_BLINK_SHARE = 0.3333

struct Saccades {
    seed: int
    clock: float                   // seconds into the fixation or the saccade
    moving: bool                   // in a saccade now
    hold: float                    // this fixation's length
    span: float                    // this saccade's
    from_yaw: float                // degrees, the saccade's start
    from_pitch: float
    to_yaw: float                  // and its end
    to_pitch: float
    yaw: float                     // the offset now, degrees
    pitch: float
    count: int                     // saccades made (microsaccades among them)
    micro: int                     // of them, microsaccades
}

saccades_new(seed: int) -> *Saccades {
    s = heap.new(Saccades)
    s.seed = seed % 2147483646 + 1
    if s.seed <= 0 { s.seed = 1 }
    s.hold = FIXATION_SHORTEST + (FIXATION_LONGEST - FIXATION_SHORTEST) * saccade_draw(s)
    return s
}

saccades_free(s: *Saccades) { if s != null { heap.free(s) } }

saccade_draw(s: *Saccades) -> float {
    s.seed = ((s.seed as long) * (48271 as long) % (2147483647 as long)) as int
    return (s.seed as float) / 2147483647.0
}

// How long a saccade of `degrees` takes: the main sequence.
saccade_duration(degrees: float) -> float { return SACCADE_BASE + SACCADE_PER_DEGREE * degrees }

// The next jump from where the eye is: a microsaccade (under a degree, any
// way) or a saccade to another point within SCAN_DEGREES of what is looked
// at, at least SACCADE_LEAST from here.
saccade_begin(s: *Saccades) {
    s.from_yaw = s.yaw
    s.from_pitch = s.pitch
    angle = saccade_draw(s) * 6.2831853
    if saccade_draw(s) < MICRO_SHARE {
        size = MICRO_LEAST + (MICRO_MOST - MICRO_LEAST) * saccade_draw(s)
        s.to_yaw = s.yaw + size * core.cos_of(angle)
        s.to_pitch = s.pitch + size * core.sin_of(angle)
        s.micro = s.micro + 1
    } else {
        tries = 0
        done = false
        while !done {
            r = SCAN_DEGREES * core.sqrt_of(saccade_draw(s))
            a = saccade_draw(s) * 6.2831853
            ty = r * core.cos_of(a)
            tp = r * core.sin_of(a) * 0.6
            dy = ty - s.yaw
            dp = tp - s.pitch
            tries = tries + 1
            if core.sqrt_of(dy * dy + dp * dp) >= SACCADE_LEAST || tries > 16 {
                s.to_yaw = ty
                s.to_pitch = tp
                done = true
            }
        }
    }
    dy = s.to_yaw - s.from_yaw
    dp = s.to_pitch - s.from_pitch
    s.span = saccade_duration(core.sqrt_of(dy * dy + dp * dp))
    s.moving = true
    s.clock = 0.0
    s.count = s.count + 1
}

// The eyes `dt` seconds on: a fixation held, then a saccade, then the next.
saccades_step(s: *Saccades, dt: float) {
    s.clock = s.clock + dt
    guard = 0
    while guard < 8 {
        guard = guard + 1
        if s.moving {
            if s.clock < s.span {
                u = s.clock / s.span
                k = u * u * u * (10.0 - 15.0 * u + 6.0 * u * u)
                s.yaw = s.from_yaw + (s.to_yaw - s.from_yaw) * k
                s.pitch = s.from_pitch + (s.to_pitch - s.from_pitch) * k
                return
            }
            s.clock = s.clock - s.span
            s.yaw = s.to_yaw
            s.pitch = s.to_pitch
            s.moving = false
            s.hold = FIXATION_SHORTEST + (FIXATION_LONGEST - FIXATION_SHORTEST) * saccade_draw(s)
        } else {
            if s.clock < s.hold { return }
            s.clock = s.clock - s.hold
            saccade_begin(s)
        }
    }
}

// A gaze shift to something new: the eyes land on it itself, the scan
// begun again from there.
saccades_reset(s: *Saccades) {
    s.yaw = 0.0
    s.pitch = 0.0
    s.moving = false
    s.clock = 0.0
    s.hold = FIXATION_SHORTEST + (FIXATION_LONGEST - FIXATION_SHORTEST) * saccade_draw(s)
}

// The offset now, radians: about the upright, then over level.
saccade_yaw(s: *Saccades) -> float { return s.yaw * 0.017453293 }
saccade_pitch(s: *Saccades) -> float { return s.pitch * 0.017453293 }
saccades_made(s: *Saccades) -> int { return s.count }
microsaccades_made(s: *Saccades) -> int { return s.micro }
blinks(b: *Blinker) -> int { return b.count }

// Both eyes' blink shapes at the blinker's lids.
blink_apply(b: *Blinker, f: *FaceMap) {
    set_shape(f, EYE_BLINK_LEFT, b.weight)
    set_shape(f, EYE_BLINK_RIGHT, b.weight)
}
