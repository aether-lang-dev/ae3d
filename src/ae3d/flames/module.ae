// ae3d.flames -- flames simulated, not drawn (#738): a small 2D fluid run at
// load, a puff of hot gas burned at the foot of the grid and let go, and the
// tongue it becomes baked into a flipbook a particle plays over its life --
// born compact and white-hot, licking up as its eddies pull it apart, cooled
// to red rags, gone.
//
// The fluid is Stam's stable fluids (Stam 1999, "Stable Fluids"): velocity
// advected through itself semi-Lagrangian, made divergence-free by a Jacobi
// pressure solve, heat and smoke carried along. Hot gas rises (buoyancy as
// its heat), smoke weighs it down a little, and vorticity confinement
// (Fedkiw, Stam and Jensen 2001) puts back the small eddies the advection
// smooths out, which is what makes a flame lick rather than drift.
//
// A frame's red is the heat (0 to 1), for core.model_set_fire's black body;
// its alpha where there is flame at all. The smoke flipbook is the same run's
// smoke density, white, its alpha the density. Seeded: the same seed bakes
// the same flames on every machine.
//
//   flames.bake("fire://flames", "fire://smoke", 7)   // 4 by 4 frames each
//   particles.set_texture(em, "fire://flames", flames.COLUMNS, flames.ROWS)
import ae3d.png
import ae3d.picture

exports (
    bake, COLUMNS, ROWS, FRAME_WIDTH, FRAME_HEIGHT
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float
extern exp(x: float) -> float
extern floor(x: float) -> float

const COLUMNS = 4
const ROWS = 4
const FRAME_WIDTH = 64
const FRAME_HEIGHT = 128
const W = 64
const H = 128
const BURN = 40                      // steps the flame is fed
const FIRST = 4                      // the step the first frame is taken at
const EVERY = 4                      // steps between frames
const JACOBI = 30
const BUOYANCY = 0.32
const WEIGHT = 0.02
const VORTICITY = 0.6
const COOLING = 0.94
const SPENT = 0.91                   // the cooling once the feed has stopped: it burns out
const THINNING = 0.985

struct Fluid {
    u: ptr
    v: ptr
    heat: ptr
    smoke: ptr
    scratch: ptr
    scratch2: ptr
    pressure: ptr
    divergence: ptr
    curl: ptr
    seed: long
}

field() -> ptr { return calloc(W * H, 8) }

at(x: int, y: int) -> int { return y * W + x }

// The generator: a 64-bit linear congruential one's top bits, 0 to 1.
random(f: *Fluid) -> float {
    f.seed = f.seed * (6364136223846793005 as long) + (1442695040888963407 as long)
    bits = (f.seed >> (33 as long)) & (2147483647 as long)
    return (bits as float) / 2147483648.0
}

// `q` read at (x, y) in cells, bilinearly, its edges held.
sample(q: ptr, x: float, y: float) -> float {
    f = q as float[]
    cx = x
    cy = y
    if cx < 0.0 { cx = 0.0 }
    if cy < 0.0 { cy = 0.0 }
    if cx > (W - 1) as float { cx = (W - 1) as float }
    if cy > (H - 1) as float { cy = (H - 1) as float }
    x0 = floor(cx) as int
    y0 = floor(cy) as int
    x1 = x0 + 1
    y1 = y0 + 1
    if x1 > W - 1 { x1 = W - 1 }
    if y1 > H - 1 { y1 = H - 1 }
    tx = cx - x0 as float
    ty = cy - y0 as float
    a = f[at(x0, y0)] + (f[at(x1, y0)] - f[at(x0, y0)]) * tx
    b = f[at(x0, y1)] + (f[at(x1, y1)] - f[at(x0, y1)]) * tx
    return a + (b - a) * ty
}

// `q` carried one step along the velocity into `out`: each cell takes what
// was where the flow came from.
advect(fl: *Fluid, q: ptr, out: ptr) {
    u = fl.u as float[]
    v = fl.v as float[]
    o = out as float[]
    y = 0
    while y < H {
        x = 0
        while x < W {
            i = at(x, y)
            o[i] = sample(q, (x as float) - u[i], (y as float) - v[i])
            x = x + 1
        }
        y = y + 1
    }
}

swap_into(dst: ptr, src: ptr) {
    d = dst as float[]
    s = src as float[]
    i = 0
    while i < W * H {
        d[i] = s[i]
        i = i + 1
    }
}

// The velocity made divergence-free: the pressure that takes its
// divergence out, by Jacobi iterations, and its gradient taken off.
project(fl: *Fluid) {
    u = fl.u as float[]
    v = fl.v as float[]
    p = fl.pressure as float[]
    d = fl.divergence as float[]
    np = fl.scratch as float[]
    y = 1
    while y < H - 1 {
        x = 1
        while x < W - 1 {
            i = at(x, y)
            d[i] = 0.5 * (u[i + 1] - u[i - 1] + v[i + W] - v[i - W])
            p[i] = 0.0
            x = x + 1
        }
        y = y + 1
    }
    k = 0
    while k < JACOBI {
        y = 1
        while y < H - 1 {
            x = 1
            while x < W - 1 {
                i = at(x, y)
                np[i] = (p[i - 1] + p[i + 1] + p[i - W] + p[i + W] - d[i]) * 0.25
                x = x + 1
            }
            y = y + 1
        }
        swap_into(fl.pressure, fl.scratch)
        k = k + 1
    }
    y = 1
    while y < H - 1 {
        x = 1
        while x < W - 1 {
            i = at(x, y)
            u[i] = u[i] - 0.5 * (p[i + 1] - p[i - 1])
            v[i] = v[i] - 0.5 * (p[i + W] - p[i - W])
            x = x + 1
        }
        y = y + 1
    }
}

// The eddies the advection smooths out, put back: a push across the
// gradient of the curl's size, toward the eddy's middle.
confine(fl: *Fluid) {
    u = fl.u as float[]
    v = fl.v as float[]
    w = fl.curl as float[]
    y = 1
    while y < H - 1 {
        x = 1
        while x < W - 1 {
            i = at(x, y)
            w[i] = 0.5 * ((v[i + 1] - v[i - 1]) - (u[i + W] - u[i - W]))
            x = x + 1
        }
        y = y + 1
    }
    y = 2
    while y < H - 2 {
        x = 2
        while x < W - 2 {
            i = at(x, y)
            gx = 0.5 * (abs_of(w[i + 1]) - abs_of(w[i - 1]))
            gy = 0.5 * (abs_of(w[i + W]) - abs_of(w[i - W]))
            len = sqrt(gx * gx + gy * gy) + 0.00001
            gx = gx / len
            gy = gy / len
            u[i] = u[i] + VORTICITY * gy * w[i]
            v[i] = v[i] - VORTICITY * gx * w[i]
            x = x + 1
        }
        y = y + 1
    }
}

abs_of(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// The puff fed: hot gas and smoke over an ellipse at the grid's foot, its
// edge ragged and its upward push flickering, so no two steps feed alike.
feed(fl: *Fluid) {
    u = fl.u as float[]
    v = fl.v as float[]
    heat = fl.heat as float[]
    smoke = fl.smoke as float[]
    cx = (W as float) * 0.5 + (random(fl) - 0.5) * 3.0
    y = 4
    while y < 20 {
        x = 8
        while x < W - 8 {
            dx = ((x as float) - cx) / 15.0
            dy = ((y as float) - 11.0) / 7.0
            r = dx * dx + dy * dy
            if r < 1.0 {
                i = at(x, y)
                fall = 1.0 - r
                hot = fall * (0.75 + 0.5 * random(fl))
                if hot > heat[i] { heat[i] = hot }
                smoke[i] = smoke[i] + 0.04 * fall
                v[i] = v[i] + 0.25 * fall * random(fl)
                u[i] = u[i] + (random(fl) - 0.5) * 0.6 * fall
            }
            x = x + 1
        }
        y = y + 1
    }
}

// One step of the fluid.
step(fl: *Fluid, feeding: bool) {
    if feeding { feed(fl) }
    v = fl.v as float[]
    heat = fl.heat as float[]
    smoke = fl.smoke as float[]
    i = 0
    while i < W * H {
        v[i] = v[i] + BUOYANCY * heat[i] - WEIGHT * smoke[i]
        i = i + 1
    }
    confine(fl)
    advect(fl, fl.u, fl.scratch)
    advect(fl, fl.v, fl.scratch2)
    swap_into(fl.u, fl.scratch)
    swap_into(fl.v, fl.scratch2)
    project(fl)
    advect(fl, fl.heat, fl.scratch)
    swap_into(fl.heat, fl.scratch)
    advect(fl, fl.smoke, fl.scratch)
    swap_into(fl.smoke, fl.scratch)
    cooling = SPENT
    if feeding { cooling = COOLING }
    i = 0
    while i < W * H {
        heat[i] = heat[i] * cooling
        smoke[i] = smoke[i] * THINNING
        i = i + 1
    }
}

// How far from the frame's edge a cell is, as a fade to zero at the rim:
// no flame reaches the quad's edge, so none is cut off there.
rim(x: int, y: int) -> float {
    ex = x
    if W - 1 - x < ex { ex = W - 1 - x }
    ey = y
    if H - 1 - y < ey { ey = H - 1 - y }
    e = ex
    if ey < e { e = ey }
    t = (e as float) / 6.0
    if t > 1.0 { return 1.0 }
    return t * t * (3.0 - 2.0 * t)
}

// The fluid's state now into frame `frame` of the two flipbooks, the first
// at the top left, each upright (images are kept bottom row first).
capture(fl: *Fluid, fire: ptr, smoke_book: ptr, frame: int) {
    heat = fl.heat as float[]
    smoke = fl.smoke as float[]
    column = frame % COLUMNS
    row = frame / COLUMNS
    width = W * COLUMNS
    y = 0
    while y < H {
        x = 0
        while x < W {
            i = at(x, y)
            edge = rim(x, y)
            h = heat[i] * edge
            if h > 1.0 { h = 1.0 }
            cover = h * 6.0
            if cover > 1.0 { cover = 1.0 }
            s = smoke[i] * edge * 2.5
            if s > 1.0 { s = 1.0 }
            px = column * W + x
            py = (ROWS - 1 - row) * H + y
            png.rgba_set(fire, py * width + px, h, h, h, cover)
            png.rgba_set(smoke_book, py * width + px, 1.0, 1.0, 1.0, s)
            x = x + 1
        }
        y = y + 1
    }
}

// The flames and their smoke baked into two flipbooks of COLUMNS by ROWS
// frames of FRAME_WIDTH by FRAME_HEIGHT, registered under `fire_name` and
// `smoke_name` (either "" to skip). 1 when both registered.
bake(fire_name: string, smoke_name: string, seed: int) -> int {
    fl = Fluid { u: field(), v: field(), heat: field(), smoke: field(), scratch: field(), scratch2: field(),
                 pressure: field(), divergence: field(), curl: field(), seed: (seed as long) * (2654435761 as long) + (1 as long) }
    width = W * COLUMNS
    height = H * ROWS
    fire = calloc(width * height, 4)
    smoke_book = calloc(width * height, 4)
    frames = COLUMNS * ROWS
    last = FIRST + (frames - 1) * EVERY
    s = 0
    frame = 0
    while s <= last {
        step(&fl, s < BURN)
        if s >= FIRST && (s - FIRST) % EVERY == 0 && frame < frames {
            capture(&fl, fire, smoke_book, frame)
            frame = frame + 1
        }
        s = s + 1
    }
    ok = 1
    if fire_name != "" && picture.register_rgba(fire_name, fire, width, height) != 1 { ok = 0 }
    if smoke_name != "" && picture.register_rgba(smoke_name, smoke_book, width, height) != 1 { ok = 0 }
    free(fire)
    free(smoke_book)
    free(fl.u)
    free(fl.v)
    free(fl.heat)
    free(fl.smoke)
    free(fl.scratch)
    free(fl.scratch2)
    free(fl.pressure)
    free(fl.divergence)
    free(fl.curl)
    return ok
}
