// ae3d.vkcanvas -- a program's canvas on Vulkan: a colour image and a depth
// image of the program's size, the render pass that draws into them (both
// cleared, the colour left readable by a shader) and its framebuffer. The
// program's meshes are drawn into it with its own quoted shader pairs
// (vkframe's canvas draws), and it is shown in a rectangle of the frame as
// a view's picture is, through the view blit, so what its shaders wrote is
// shown as they wrote it.
//
// Not part of ae3d.vktargets: a view (#866) swaps every variable of that
// module in and out, and a canvas is the program's, the same in every view.
//
// The colour is the display's format, written through a view of that format
// and sampled through its sRGB view (a mutable-format image), as a view's
// picture is: the view blit decodes and encodes, and the values come out
// as they went in.

import contrib.vulkan.vk
import ae3d.vkhost
import ae3d.vkdevice
import ae3d.vktexture
import ae3d.vktargets

exports (VkCanvas, pass, canvas_new, canvas_free, framebuffer, texture, width, height, destroy_pass)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

struct VkCanvas {
    width: int
    height: int
    image: ptr        // the colour: VkImage, its memory, the view it is drawn through
    memory: ptr
    draw_view: ptr
    texture: int      // vktexture's handle: its sRGB view and sampler, sampled by the blit
    depth: ptr        // vkhost.VKImage's three, the depth's
    depth_memory: ptr
    depth_view: ptr
    framebuffer: ptr
}

// The canvases' render pass, one for all, made when the first is.
var g_pass: ptr = null
var g_cell: ptr = null

fn cell() -> ptr {
    if g_cell == null { g_cell = calloc(8, 8) }
    return g_cell
}

pass() -> ptr { return g_pass }
framebuffer(c: *VkCanvas) -> ptr { return c.framebuffer }
texture(c: *VkCanvas) -> int { return c.texture }
width(c: *VkCanvas) -> int { return c.width }
height(c: *VkCanvas) -> int { return c.height }

// The colour (cleared, kept, left for a shader to read) and the depth
// (cleared, thrown away): one sample each. The colour was read by the last
// frame's blit, and is read by this frame's after.
fn made_pass() -> ptr {
    a = calloc(2, sizeof(VkAttachmentDescription))
    c = a as *VkAttachmentDescription
    c.format = vktargets.color_format()
    c.samples = vk.SAMPLE_COUNT_1_BIT
    c.loadOp = vk.ATTACHMENT_LOAD_OP_CLEAR
    c.storeOp = vk.ATTACHMENT_STORE_OP_STORE
    c.stencilLoadOp = vk.ATTACHMENT_LOAD_OP_DONT_CARE
    c.stencilStoreOp = vk.ATTACHMENT_STORE_OP_DONT_CARE
    c.initialLayout = vk.IMAGE_LAYOUT_UNDEFINED
    c.finalLayout = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    z = (a + sizeof(VkAttachmentDescription)) as *VkAttachmentDescription
    z.format = vktargets.depth_format()
    z.samples = vk.SAMPLE_COUNT_1_BIT
    z.loadOp = vk.ATTACHMENT_LOAD_OP_CLEAR
    z.storeOp = vk.ATTACHMENT_STORE_OP_DONT_CARE
    z.stencilLoadOp = vk.ATTACHMENT_LOAD_OP_DONT_CARE
    z.stencilStoreOp = vk.ATTACHMENT_STORE_OP_DONT_CARE
    z.initialLayout = vk.IMAGE_LAYOUT_UNDEFINED
    z.finalLayout = vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL
    refs = calloc(2, sizeof(VkAttachmentReference))
    r0 = refs as *VkAttachmentReference
    r0.attachment = 0
    r0.layout = vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
    r1 = (refs + sizeof(VkAttachmentReference)) as *VkAttachmentReference
    r1.attachment = 1
    r1.layout = vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL
    subpass = calloc(1, sizeof(VkSubpassDescription)) as *VkSubpassDescription
    subpass.pipelineBindPoint = vk.PIPELINE_BIND_POINT_GRAPHICS
    subpass.colorAttachmentCount = 1
    subpass.pColorAttachments = refs
    subpass.pDepthStencilAttachment = refs + sizeof(VkAttachmentReference)
    deps = calloc(2, sizeof(VkSubpassDependency))
    d0 = deps as *VkSubpassDependency
    d0.srcSubpass = vk.SUBPASS_EXTERNAL
    d0.dstSubpass = 0
    d0.srcStageMask = vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT | vk.PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT
    d0.dstStageMask = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | vk.PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT
    d0.srcAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
    d0.dstAccessMask = vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
                       vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT
    d1 = (deps + sizeof(VkSubpassDependency)) as *VkSubpassDependency
    d1.srcSubpass = 0
    d1.dstSubpass = vk.SUBPASS_EXTERNAL
    d1.srcStageMask = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
    d1.dstStageMask = vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT
    d1.srcAccessMask = vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT
    d1.dstAccessMask = vk.ACCESS_SHADER_READ_BIT
    info = calloc(1, sizeof(VkRenderPassCreateInfo)) as *VkRenderPassCreateInfo
    info.sType = vk.STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
    info.attachmentCount = 2
    info.pAttachments = a
    info.subpassCount = 1
    info.pSubpasses = subpass as ptr
    info.dependencyCount = 2
    info.pDependencies = deps
    r = vk.vkCreateRenderPass(vkhost.device(), info as ptr, null, cell())
    out = (cell() as ptr[])[0]
    free(info as ptr)
    free(deps)
    free(subpass as ptr)
    free(refs)
    free(a)
    if r != vk.SUCCESS { return null }
    return out
}

// The display's sRGB twin of `format`, the colour's sampled view's.
fn srgb_of(format: int) -> int {
    if format == vk.FORMAT_R8G8B8A8_UNORM { return vk.FORMAT_R8G8B8A8_SRGB }
    if format == vk.FORMAT_B8G8R8A8_UNORM { return vk.FORMAT_B8G8R8A8_SRGB }
    return format
}

fn view_of_format(image: @keep ptr, format: int) -> ptr {
    vi = calloc(1, sizeof(VkImageViewCreateInfo)) as *VkImageViewCreateInfo
    vi.sType = vk.STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
    vi.image = image
    vi.viewType = vk.IMAGE_VIEW_TYPE_2D
    vi.format = format
    vi.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    vi.subresourceRange.levelCount = 1
    vi.subresourceRange.layerCount = 1
    r = vk.vkCreateImageView(vkhost.device(), vi as ptr, null, cell())
    free(vi as ptr)
    if r != vk.SUCCESS { return null }
    return (cell() as ptr[])[0]
}

// A canvas `w` by `h`; null, said, when it would not make.
canvas_new(w: int, h: int) -> *VkCanvas {
    if w < 1 || h < 1 || vkhost.device() == null { return null }
    if g_pass == null { g_pass = made_pass() }
    if g_pass == null {
        vkdevice.fail("canvas vkCreateRenderPass failed")
        return null
    }
    d = vkhost.device()
    c = calloc(1, sizeof(VkCanvas)) as *VkCanvas
    c.width = w
    c.height = h
    info = calloc(1, sizeof(VkImageCreateInfo)) as *VkImageCreateInfo
    info.sType = vk.STRUCTURE_TYPE_IMAGE_CREATE_INFO
    info.flags = vk.IMAGE_CREATE_MUTABLE_FORMAT_BIT
    info.imageType = vk.IMAGE_TYPE_2D
    info.format = vktargets.color_format()
    info.extent.width = w
    info.extent.height = h
    info.extent.depth = 1
    info.mipLevels = 1
    info.arrayLayers = 1
    info.samples = vk.SAMPLE_COUNT_1_BIT
    info.tiling = vk.IMAGE_TILING_OPTIMAL
    info.usage = vk.IMAGE_USAGE_COLOR_ATTACHMENT_BIT | vk.IMAGE_USAGE_SAMPLED_BIT | vk.IMAGE_USAGE_TRANSFER_SRC_BIT
    info.sharingMode = vk.SHARING_MODE_EXCLUSIVE
    info.initialLayout = vk.IMAGE_LAYOUT_UNDEFINED
    r = vk.vkCreateImage(d, info as ptr, null, cell())
    free(info as ptr)
    if r != vk.SUCCESS {
        free(c as ptr)
        vkdevice.fail("canvas vkCreateImage failed")
        return null
    }
    c.image = (cell() as ptr[])[0]
    needs = calloc(1, sizeof(VkMemoryRequirements)) as *VkMemoryRequirements
    vk.vkGetImageMemoryRequirements(d, c.image, needs as ptr)
    c.memory = vkhost.allocate(needs, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
    free(needs as ptr)
    if c.memory == null {
        canvas_free(c)
        vkdevice.fail("canvas vkAllocateMemory failed")
        return null
    }
    vk.vkBindImageMemory(d, c.image, c.memory, 0)
    c.draw_view = view_of_format(c.image, vktargets.color_format())
    sampled = view_of_format(c.image, srgb_of(vktargets.color_format()))
    sampler = vkhost.sampler(vk.FILTER_NEAREST, vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, vk.SAMPLER_MIPMAP_MODE_NEAREST, 0.0, 0.0)
    if c.draw_view == null || sampled == null || sampler == null {
        if sampled != null { vk.vkDestroyImageView(d, sampled, null) }
        if sampler != null { vk.vkDestroySampler(d, sampler, null) }
        canvas_free(c)
        vkdevice.fail("canvas vkCreateImageView failed")
        return null
    }
    // The texture owns the sampled view and its sampler, not the image.
    c.texture = vktexture.adopt_target(vkhost.VKImage { image: null, memory: null, view: sampled }, sampler, w, h)
    if c.texture == 0 {
        vk.vkDestroySampler(d, sampler, null)
        vk.vkDestroyImageView(d, sampled, null)
        canvas_free(c)
        return null
    }
    z = vkhost.image(w, h, 1, vktargets.depth_format(), vk.SAMPLE_COUNT_1_BIT, vk.IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
                     vk.IMAGE_ASPECT_DEPTH_BIT)
    if z.image == null {
        canvas_free(c)
        vkdevice.fail("canvas depth image failed")
        return null
    }
    c.depth = z.image
    c.depth_memory = z.memory
    c.depth_view = z.view
    views = calloc(2, 8)
    (views as ptr[])[0] = c.draw_view
    (views as ptr[])[1] = c.depth_view
    fb = calloc(1, sizeof(VkFramebufferCreateInfo)) as *VkFramebufferCreateInfo
    fb.sType = vk.STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
    fb.renderPass = g_pass
    fb.attachmentCount = 2
    fb.pAttachments = views
    fb.width = w
    fb.height = h
    fb.layers = 1
    r = vk.vkCreateFramebuffer(d, fb as ptr, null, cell())
    free(fb as ptr)
    free(views)
    if r != vk.SUCCESS {
        canvas_free(c)
        vkdevice.fail("canvas vkCreateFramebuffer failed")
        return null
    }
    c.framebuffer = (cell() as ptr[])[0]
    return c
}

// The canvas and what it holds, the device idle first.
canvas_free(c: *VkCanvas) {
    if c == null { return }
    d = vkhost.device()
    if d != null {
        vk.vkDeviceWaitIdle(d)
        if c.framebuffer != null { vk.vkDestroyFramebuffer(d, c.framebuffer, null) }
        if c.texture != 0 { vktexture.destroy(c.texture) }
        if c.draw_view != null { vk.vkDestroyImageView(d, c.draw_view, null) }
        if c.image != null { vk.vkDestroyImage(d, c.image, null) }
        if c.memory != null { vk.vkFreeMemory(d, c.memory, null) }
        if c.depth != null {
            vkhost.image_free(vkhost.VKImage { image: c.depth, memory: c.depth_memory, view: c.depth_view })
        }
    }
    free(c as ptr)
}

// The canvases' pass, at the device's end.
destroy_pass() {
    if g_pass != null && vkhost.device() != null { vk.vkDestroyRenderPass(vkhost.device(), g_pass, null) }
    g_pass = null
}
