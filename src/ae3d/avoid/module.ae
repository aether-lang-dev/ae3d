// ae3d.avoid -- stepping aside for another figure (#509): the velocity a
// figure wants, changed as little as it takes to pass the figures around it
// instead of walking into them, the way people on a pavement do.
//
//   v = avoid.aside(position, current, wanted, others, count, avoid.RADIUS, delta)
//
// `others` is a float[count * 6]: each figure's position (x, y, z) and then
// its velocity. Reciprocal velocity obstacles (ORCA: van den Berg, Guy, Lin
// and Manocha, "Reciprocal n-body collision avoidance", 2011, solved as
// their RVO2 library solves them). For each other figure, the velocities
// that would bring the two nearer than two radii and DODGE_MARGIN within
// HORIZON seconds, both keeping on, and the least change to its own velocity
// (`current`) that leaves them: it takes half of that change, the other
// figure the other half; all of it from one standing still, which steps
// aside for nobody. Each other figure so gives a half-plane of velocities.
// Nobody on a meeting course, the velocity is `wanted` exactly; else
// `wanted` turned aside and slowed by the least that is in all of them
// (turned_aside), to its right first, as a person crossing another's way
// turns or checks their pace; nothing turned within ASIDE_MOST at any of
// its paces, the one in all of them nearest `wanted`, no faster than it.
// Already nearer than that, it draws away over SOONEST seconds. Where no
// velocity is in all of them (a knot of figures), the one that breaks the
// worst of them least.
//
// Only turning, keeping its speed, as it did before, it dropped what of the
// change lay along its way: two crossing at right angles passed 0.74 m
// apart against the 0.85 planned, one walking round another standing still
// 0.72, eight crossing a circle 0.65; and in the plaza, walkers crossing
// and meeting head on in a crowd met capsule to capsule, their knees
// through each other's.
//
// And it turns from the way it is going (`current`) by no more than
// TURN_RATE radians a second over `delta`: a dodge comes on and goes off as
// a walker turns, not in a frame. On the ground: heights are ignored.
import ae3d.core

exports (
    RADIUS, HORIZON, DODGE_MARGIN, SQUEEZE_MARGIN, TURN_RATE, aside
)

extern sqrt(x: float) -> float
extern atan2(y: float, x: float) -> float
extern cos(x: float) -> float
extern sin(x: float) -> float
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const RADIUS = 0.3                   // metres: a person's shoulders, halved
const HORIZON = 2.5                  // seconds looked ahead
const DODGE_MARGIN = 0.25            // metres kept clear beyond touching
const SOONEST = 0.25                 // seconds: already nearer than the clearance, drawn apart over this
const STILL = 0.05                   // m/s: an other figure slower than this steps aside for nobody
const TURN_RATE = 3.0                // radians a second
const ASIDE_STEP = 0.02              // radians: the turns aside tried, a degree or so apart
const SQUEEZE_PACE = 0.6             // of its speed: slowed past this to keep DODGE_MARGIN clear, it keeps SQUEEZE_MARGIN
const SQUEEZE_MARGIN = 0.05          // metres kept clear beyond touching, in a knot
const PACES = 5                      // its speed and the shares of it below tried, a fifth apart
const SLOW_COST = 1.0                // radians of turn a walker gives for its whole speed: a fifth slower is worth 11 degrees
const ASIDE_MOST = 1.75              // radians: turned further than this (100 degrees), it slows instead; up against one standing, only past a right angle clears
const EPSILON = 0.00001

// The velocity to go at: `wanted` changed as little as it takes to pass
// each figure it would meet.
aside(position: Vec3, current: Vec3, wanted: Vec3, others: ptr, count: int, radius: float, delta: float) -> Vec3 {
    speed = sqrt(wanted.x * wanted.x + wanted.z * wanted.z)
    if speed < 0.0001 { return wanted }
    if count <= 0 { return wanted }
    lines_block = calloc(count * 4, 8)
    proj_block = calloc(count * 4, 8)
    v = kept_clear(position, current, wanted, speed, others, count, 2.0 * radius + DODGE_MARGIN, lines_block as float[], proj_block as float[])
    // In a knot, closer: kept DODGE_MARGIN clear of everyone, eight crossing
    // a circle wound round its middle at 3 cm/s, each held to the pace of
    // the one ahead of it. Slowed past SQUEEZE_PACE so, it passes as near as
    // SQUEEZE_MARGIN, as people in a crowd give up the room they keep.
    if v.x * v.x + v.z * v.z < SQUEEZE_PACE * SQUEEZE_PACE * speed * speed {
        near = kept_clear(position, current, wanted, speed, others, count, 2.0 * radius + SQUEEZE_MARGIN, lines_block as float[], proj_block as float[])
        if near.x * near.x + near.z * near.z > v.x * v.x + v.z * v.z { v = near }
    }
    free(proj_block)
    free(lines_block)
    // Turned back to `wanted` as it was turned from it: let go at once, a
    // walker clear of the one it crossed swung back 70 degrees in a frame.
    return turned(current, core.vec3(v.x, wanted.y, v.z), delta)
}

// `wanted` changed as little as it takes to keep `clear` of every other
// figure; `lines` and `proj` are room for count lines.
kept_clear(position: Vec3, current: Vec3, wanted: Vec3, speed: float, others: ptr, count: int, clear: float, lines: float[], proj: float[]) -> Vec3 {
    n = 0
    o = others as float[]
    i = 0
    while i < count {
        at = i * 6
        if constrain(lines, n, position, current, core.vec3(o[at], 0.0, o[at + 2]), core.vec3(o[at + 3], 0.0, o[at + 5]), clear) {
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 || allowed(lines, n, wanted) { return wanted }
    // Turned and slowed the least it takes; else ORCA's own answer, the
    // velocity nearest the wanted one.
    f = turned_aside(lines, n, wanted, speed)
    if f.ok { return f.v }
    p = solve(lines, n, speed, wanted)
    if p.fail < n { return least_broken(lines, n, p.fail, speed, p.v, proj) }
    return p.v
}

// The half-plane of velocities that pass the figure at `other` going
// `other_v`, written as line `n` of `lines` (a point on its edge, x and z,
// and its direction; the velocities v allowed are those with
// det(direction, point - v) <= 0): false when there is none to give (the
// two on the same spot, going alike).
constrain(lines: float[], n: int, position: Vec3, current: Vec3, other: Vec3, other_v: Vec3, clear: float) -> bool {
    rpx = other.x - position.x
    rpz = other.z - position.z
    rvx = current.x - other_v.x
    rvz = current.z - other_v.z
    dist_sq = rpx * rpx + rpz * rpz
    clear_sq = clear * clear
    share = 0.5
    if other_v.x * other_v.x + other_v.z * other_v.z < STILL * STILL { share = 1.0 }
    dx = 0.0
    dz = 0.0
    ux = 0.0
    uz = 0.0
    if dist_sq > clear_sq {
        // Apart: the obstacle is the cone of relative velocities toward the
        // other's disc, cut off at HORIZON.
        wx = rvx - rpx / HORIZON
        wz = rvz - rpz / HORIZON
        w_sq = wx * wx + wz * wz
        dot1 = wx * rpx + wz * rpz
        if dot1 < 0.0 && dot1 * dot1 > clear_sq * w_sq {
            // Out over the cut-off disc: away from its centre.
            w_len = sqrt(w_sq)
            nx = wx / w_len
            nz = wz / w_len
            dx = nz
            dz = 0.0 - nx
            ux = (clear / HORIZON - w_len) * nx
            uz = (clear / HORIZON - w_len) * nz
        } else {
            // Out over a side of the cone: onto the nearer side.
            leg = sqrt(dist_sq - clear_sq)
            if rpx * wz - rpz * wx > 0.0 {
                dx = (rpx * leg - rpz * clear) / dist_sq
                dz = (rpx * clear + rpz * leg) / dist_sq
            } else {
                dx = 0.0 - (rpx * leg + rpz * clear) / dist_sq
                dz = 0.0 - (0.0 - rpx * clear + rpz * leg) / dist_sq
            }
            dot2 = rvx * dx + rvz * dz
            ux = dot2 * dx - rvx
            uz = dot2 * dz - rvz
        }
    } else {
        // Already nearer than `clear`: apart again over SOONEST.
        wx = rvx - rpx / SOONEST
        wz = rvz - rpz / SOONEST
        w_len = sqrt(wx * wx + wz * wz)
        if w_len < EPSILON { return false }
        nx = wx / w_len
        nz = wz / w_len
        dx = nz
        dz = 0.0 - nx
        ux = (clear / SOONEST - w_len) * nx
        uz = (clear / SOONEST - w_len) * nz
    }
    at = n * 4
    lines[at] = current.x + share * ux
    lines[at + 1] = current.z + share * uz
    lines[at + 2] = dx
    lines[at + 3] = dz
    return true
}

det(ax: float, az: float, bx: float, bz: float) -> float { return ax * bz - az * bx }

// Whether `v` is on the allowed side of every line.
allowed(lines: float[], count: int, v: Vec3) -> bool {
    i = 0
    while i < count {
        at = i * 4
        if det(lines[at + 2], lines[at + 3], lines[at] - v.x, lines[at + 1] - v.z) > 0.0 { return false }
        i = i + 1
    }
    return true
}

// `wanted` turned and slowed by the least that is on the allowed side of
// every line: at its speed and at PACES shares of it below, each turned
// ASIDE_STEP at a time to ASIDE_MOST either way, to its right first, so two
// meeting straight on each keep right and pass; of those, the one whose
// turn and SLOW_COST for each share of speed it gives up are least. ORCA's
// own answer is the velocity nearest the wanted one, and straight on that
// is slower, not aside: two meeting head on slowed to a stop, face to face,
// and eight crossing a circle stood still at its middle. People turn
// first, check their pace when turning would take them far round, and
// stop only when nothing else clears.
turned_aside(lines: float[], count: int, wanted: Vec3, speed: float) -> AsideFound {
    base = atan2(wanted.z, wanted.x)
    best = AsideFound { ok: false, v: wanted }
    least = 1000000.0
    k = 0
    while k < PACES {
        share = 1.0 - (k as float) / (PACES as float)
        slowed = SLOW_COST * (1.0 - share)
        if slowed >= least { return best }
        pace = speed * share
        // Slowed, straight on first; at its speed straight on is `wanted`,
        // which is not allowed.
        a = 0.0
        if k == 0 { a = ASIDE_STEP }
        found = false
        while a <= ASIDE_MOST && !found && slowed + a < least {
            side = 0
            while side < 2 && !found {
                // +a turns toward its right: its right is (-z, x) of its way.
                t = base + a
                if side == 1 { t = base - a }
                v = core.vec3(cos(t) * pace, 0.0, sin(t) * pace)
                if allowed(lines, count, v) {
                    found = true
                    least = slowed + a
                    best = AsideFound { ok: true, v: v }
                }
                side = side + 1
                if a == 0.0 { side = 2 }
            }
            a = a + ASIDE_STEP
        }
        k = k + 1
    }
    return best
}

// A velocity found, and whether one was.
struct AsideFound {
    ok: bool
    v: Vec3
}

// The velocity on line `k` within `limit` and on the allowed side of the
// lines before it, nearest `opt` (or, `toward`, furthest along `opt`).
on_line(lines: float[], k: int, limit: float, opt: Vec3, toward: bool) -> AsideFound {
    at = k * 4
    px = lines[at]
    pz = lines[at + 1]
    dx = lines[at + 2]
    dz = lines[at + 3]
    dot = px * dx + pz * dz
    disc = dot * dot + limit * limit - (px * px + pz * pz)
    if disc < 0.0 { return AsideFound { ok: false, v: opt } }
    root = sqrt(disc)
    t_left = 0.0 - dot - root
    t_right = 0.0 - dot + root
    i = 0
    while i < k {
        bt = i * 4
        denom = det(dx, dz, lines[bt + 2], lines[bt + 3])
        numer = det(lines[bt + 2], lines[bt + 3], px - lines[bt], pz - lines[bt + 1])
        if denom <= EPSILON && denom >= 0.0 - EPSILON {
            // Parallel: the whole line is on one side of the other.
            if numer < 0.0 { return AsideFound { ok: false, v: opt } }
        } else {
            t = numer / denom
            if denom >= 0.0 {
                if t < t_right { t_right = t }
            } else {
                if t > t_left { t_left = t }
            }
            if t_left > t_right { return AsideFound { ok: false, v: opt } }
        }
        i = i + 1
    }
    t = 0.0
    if toward {
        t = t_left
        if opt.x * dx + opt.z * dz > 0.0 { t = t_right }
    } else {
        t = dx * (opt.x - px) + dz * (opt.z - pz)
        if t < t_left { t = t_left }
        if t > t_right { t = t_right }
    }
    return AsideFound { ok: true, v: core.vec3(px + t * dx, 0.0, pz + t * dz) }
}

// The velocity within `limit` on the allowed side of every line nearest
// `opt` (or, `toward`, furthest along it), and the first line it could not
// be kept to, `count` when there was none.
struct AsideProgram {
    fail: int
    v: Vec3
}

solve_toward(lines: float[], count: int, limit: float, opt: Vec3, toward: bool) -> AsideProgram {
    v = opt
    if toward {
        v = core.vec3(opt.x * limit, 0.0, opt.z * limit)
    } else if opt.x * opt.x + opt.z * opt.z > limit * limit {
        l = sqrt(opt.x * opt.x + opt.z * opt.z)
        v = core.vec3(opt.x / l * limit, 0.0, opt.z / l * limit)
    }
    i = 0
    while i < count {
        at = i * 4
        if det(lines[at + 2], lines[at + 3], lines[at] - v.x, lines[at + 1] - v.z) > 0.0 {
            f = on_line(lines, i, limit, opt, toward)
            if !f.ok { return AsideProgram { fail: i, v: v } }
            v = f.v
        }
        i = i + 1
    }
    return AsideProgram { fail: count, v: v }
}

solve(lines: float[], count: int, limit: float, opt: Vec3) -> AsideProgram {
    return solve_toward(lines, count, limit, opt, false)
}

// No velocity on the allowed side of every line: from line `from` on, the
// one that is least far over the worst of them, starting at `v`. `proj` is
// room for count lines.
least_broken(lines: float[], count: int, from: int, limit: float, v: Vec3, proj: float[]) -> Vec3 {
    best = v
    distance = 0.0
    i = from
    while i < count {
        at = i * 4
        if det(lines[at + 2], lines[at + 3], lines[at] - best.x, lines[at + 1] - best.z) > distance {
            m = 0
            j = 0
            while j < i {
                bt = j * 4
                d = det(lines[at + 2], lines[at + 3], lines[bt + 2], lines[bt + 3])
                px = 0.0
                pz = 0.0
                keep = true
                if d <= EPSILON && d >= 0.0 - EPSILON {
                    // Parallel and the same way: nothing new.
                    if lines[at + 2] * lines[bt + 2] + lines[at + 3] * lines[bt + 3] > 0.0 { keep = false }
                    px = 0.5 * (lines[at] + lines[bt])
                    pz = 0.5 * (lines[at + 1] + lines[bt + 1])
                } else {
                    s = det(lines[bt + 2], lines[bt + 3], lines[at] - lines[bt], lines[at + 1] - lines[bt + 1]) / d
                    px = lines[at] + s * lines[at + 2]
                    pz = lines[at + 1] + s * lines[at + 3]
                }
                if keep {
                    ex = lines[bt + 2] - lines[at + 2]
                    ez = lines[bt + 3] - lines[at + 3]
                    el = sqrt(ex * ex + ez * ez)
                    if el > EPSILON {
                        ct = m * 4
                        proj[ct] = px
                        proj[ct + 1] = pz
                        proj[ct + 2] = ex / el
                        proj[ct + 3] = ez / el
                        m = m + 1
                    }
                }
                j = j + 1
            }
            p = solve_toward(proj, m, limit, core.vec3(0.0 - lines[at + 3], 0.0, lines[at + 2]), true)
            if p.fail >= m { best = p.v }
            distance = det(lines[at + 2], lines[at + 3], lines[at] - best.x, lines[at + 1] - best.z)
        }
        i = i + 1
    }
    return best
}

// `toward`, turned to from `current` by no more than TURN_RATE over
// `delta`, at its own speed. From a standstill, at once.
turned(current: Vec3, toward: Vec3, delta: float) -> Vec3 {
    now = sqrt(current.x * current.x + current.z * current.z)
    speed = sqrt(toward.x * toward.x + toward.z * toward.z)
    if now < 0.0001 || delta <= 0.0 || speed < 0.0001 { return toward }
    from = atan2(current.z, current.x)
    to = atan2(toward.z, toward.x)
    d = to - from
    while d > 3.141592653589793 { d = d - 6.283185307179586 }
    while d < 0.0 - 3.141592653589793 { d = d + 6.283185307179586 }
    most = TURN_RATE * delta
    if d <= most && d >= 0.0 - most { return toward }
    if d > most { d = most }
    if d < 0.0 - most { d = 0.0 - most }
    a = from + d
    return core.vec3(cos(a) * speed, toward.y, sin(a) * speed)
}
