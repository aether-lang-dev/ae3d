// ae3d.avoid -- stepping aside for another figure (#509): the velocity a
// figure wants, bent so it passes the figures around it instead of walking
// into them, the way people on a pavement do.
//
//   v = avoid.aside(position, current, wanted, others, count, avoid.RADIUS, delta)
//
// `others` is a float[count * 6]: each figure's position (x, y, z) and then
// its velocity. The figure looks HORIZON seconds ahead: for each other one
// it finds when the two would be nearest, keeping on as they go, and how
// near. Nearer than two radii and DODGE_MARGIN, it bends its way aside --
// away from where the other will be then, or, coming straight at each
// other, to its right, so two figures meeting head on each keep right and
// pass -- by as much as it needs to clear in the time left, the sooner the
// meeting the more; already nearer than that, alongside one it overtakes,
// it keeps away until clear. The speed is the wanted one: it walks round,
// it does not stop. And it turns from the way it is going (`current`) by
// no more than TURN_RATE radians a second over `delta`: a dodge comes on
// and goes off as a walker turns, not in a frame. Nobody on a meeting
// course and going the way it wants, it is the wanted velocity exactly.
// On the ground: heights are ignored.
import ae3d.core

exports (
    RADIUS, HORIZON, DODGE_MARGIN, TURN_RATE, aside, nearest_time, nearest_gap
)

extern sqrt(x: float) -> float
extern atan2(y: float, x: float) -> float
extern cos(x: float) -> float
extern sin(x: float) -> float

const RADIUS = 0.3                   // metres: a person's shoulders, halved
const HORIZON = 2.5                  // seconds looked ahead
const DODGE_MARGIN = 0.25            // metres kept clear beyond touching
const SOONEST = 0.25                 // seconds: a meeting nearer than this is dodged as if this far off
const HEAD_ON = 0.05                 // metres: nearer than this at the nearest, straight at each other
const TURN_RATE = 3.0                // radians a second

// When, from now, two figures keeping on as they go are nearest: `apart`
// the other's place less this one's, `closing` this one's velocity less the
// other's, both level. 0 when they are already drawing apart.
nearest_time(apart: Vec3, closing: Vec3) -> float {
    speed_sq = closing.x * closing.x + closing.z * closing.z
    if speed_sq < 0.000001 { return 0.0 }
    t = (apart.x * closing.x + apart.z * closing.z) / speed_sq
    if t < 0.0 { return 0.0 }
    return t
}

// How far apart, level, they are at time `t`: this one's offset from the
// other then.
nearest_gap(apart: Vec3, closing: Vec3, t: float) -> Vec3 {
    return core.vec3(closing.x * t - apart.x, 0.0, closing.z * t - apart.z)
}

// The velocity to go at: `wanted` bent aside for each figure it would meet.
aside(position: Vec3, current: Vec3, wanted: Vec3, others: ptr, count: int, radius: float, delta: float) -> Vec3 {
    speed = sqrt(wanted.x * wanted.x + wanted.z * wanted.z)
    if speed < 0.0001 { return wanted }
    return turned(current, bent_for(position, wanted, speed, others, count, radius), speed, delta)
}

// `toward` at `speed`, turned to from `current` by no more than TURN_RATE
// over `delta`. From a standstill, at once.
turned(current: Vec3, toward: Vec3, speed: float, delta: float) -> Vec3 {
    now = sqrt(current.x * current.x + current.z * current.z)
    if now < 0.0001 || delta <= 0.0 { return toward }
    from = atan2(current.z, current.x)
    to = atan2(toward.z, toward.x)
    d = to - from
    while d > 3.141592653589793 { d = d - 6.283185307179586 }
    while d < 0.0 - 3.141592653589793 { d = d + 6.283185307179586 }
    most = TURN_RATE * delta
    if d <= most && d >= 0.0 - most { return toward }
    if d > most { d = most }
    if d < 0.0 - most { d = 0.0 - most }
    a = from + d
    return core.vec3(cos(a) * speed, toward.y, sin(a) * speed)
}

// `wanted` bent aside, before the turn is limited.
bent_for(position: Vec3, wanted: Vec3, speed: float, others: ptr, count: int, radius: float) -> Vec3 {
    if count <= 0 { return wanted }
    o = others as float[]
    way = core.vec3(wanted.x / speed, 0.0, wanted.z / speed)
    right = core.vec3(0.0 - way.z, 0.0, way.x)
    push = core.vec3(0.0, 0.0, 0.0)
    clear = 2.0 * radius + DODGE_MARGIN
    i = 0
    while i < count {
        at = i * 6
        apart = core.vec3(o[at] - position.x, 0.0, o[at + 2] - position.z)
        closing = core.vec3(wanted.x - o[at + 3], 0.0, wanted.z - o[at + 5])
        t = nearest_time(apart, closing)
        if t < HORIZON {
            gap = nearest_gap(apart, closing, t)
            near = sqrt(gap.x * gap.x + gap.z * gap.z)
            if near < clear {
                away = right
                if near > HEAD_ON { away = core.vec3(gap.x / near, 0.0, gap.z / near) }
                // To clear by `clear - near` in the time there is, the
                // sooner the harder; and the more the nearer it comes to
                // straight at it.
                soon = t
                if soon < SOONEST { soon = SOONEST }
                by = (clear - near) / soon
                push = core.vec3(push.x + away.x * by, 0.0, push.z + away.z * by)
            }
        }
        i = i + 1
    }
    if push.x == 0.0 && push.z == 0.0 { return wanted }
    // Only aside: what of the push is along the way is dropped, so it does
    // not slow or hurry, and the speed is kept -- the speed it has left
    // going on along the way, so that it goes aside at the speed the
    // dodge asks. Added to the way and scaled back to the speed, the
    // aside was cut with it: 1 m/s asked at 1.4 m/s went 0.81 m/s aside,
    // and two crossing passed 0.73 m apart against the 0.85 planned.
    along = push.x * way.x + push.z * way.z
    side = core.vec3(push.x - way.x * along, 0.0, push.z - way.z * along)
    aside_speed = sqrt(side.x * side.x + side.z * side.z)
    if aside_speed < 0.0001 { return wanted }
    if aside_speed >= speed { return core.vec3(side.x * speed / aside_speed, wanted.y, side.z * speed / aside_speed) }
    on = sqrt(speed * speed - aside_speed * aside_speed)
    return core.vec3(way.x * on + side.x, wanted.y, way.z * on + side.z)
}
