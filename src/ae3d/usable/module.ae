// Usable objects (#908): what a figure can do at a thing in the world --
// sit on this log, work at this bench, open this door -- declared by the
// thing, found by where and what, and held by one figure at a time (UE's
// Smart Objects, Ubisoft's and Rockstar's scenario points).
//
// A kind of object is a data file: its slots, each where a figure is when it
// uses it, the way it faces then, where it stands to start, the tags it
// answers to, its takes (enter, loop, exit) and the part of the figure that
// lands on the slot at the enter take's contact (the pelvis on a seat, a hand
// on a grip: motion warping puts it there). An object in the world is a
// GameObject wearing a kind; its slots go where it stands and turn as it
// faces.
//
//     # a log two can sit on
//     slot left
//       tags sit rest
//       at -0.4 0.40 0.0         # the seat, in the object's frame
//       facing 0 0 1             # the way the sitter faces
//       approach 0 0 0.55        # where it stands to start: across and ahead
//                                # of `at`, its height off the object's foot
//       enter Sitting_Enter
//       loop Sitting_Idle_Loop
//       exit Sitting_Exit
//       lands pelvis
//     end
//
// A figure asks for the nearest free slot with a tag within a reach of it
// (usable.find), claims it (claim: false if another has it), uses it and
// releases it. Two figures never hold one slot. The search is over a grid of
// the slots' approach points, so a world of thousands of objects is asked in
// microseconds.
//
//     u = usable.usables_new(2.0)
//     log = usable.kind_read("assets/usable/log.usable")
//     usable.add(u, log_object, log)
//     s = usable.find(u, figure_at, 8.0, "sit", me)
//     if s >= 0 && usable.claim(u, s, me) { ... usable.release(u, s, me) }

import std.fs
import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.behaviour

exports (
    Usables, Kind, usables_new, usables_free, kind_read, kind_free, kind_slots, kind_error,
    add, remove, moved, slots, find, find_every, claim, release, claimant, slot_at, slot_facing, slot_approach,
    slot_object, slot_name, slot_tagged, slot_enter, slot_loop, slot_exit, slot_lands,
    LANDS_PELVIS, LANDS_HAND_L, LANDS_HAND_R, LANDS_FEET
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// What lands on a slot's point at its enter take's contact.
const LANDS_PELVIS = 0
const LANDS_HAND_L = 1
const LANDS_HAND_R = 2
const LANDS_FEET = 3

// The most slots a kind may declare.
const MOST_SLOTS = 32

// A slot as a kind declares it, in its object's frame.
struct SlotKind {
    name: string
    tags: string                   // " sit rest " (spaces round each, for a whole-word look-up)
    at: Vec3
    facing: Vec3
    approach: Vec3                 // across and ahead of `at` (x, z); its height off the object's foot (y)
    enter: string
    loop: string
    exit: string
    lands: int
}

// A kind of usable object: its slots.
struct Kind {
    slots: ptr                     // list of *SlotKind
}

// A slot of an object in the world.
struct Slot {
    object: ptr                    // *GameObject
    kind: ptr                      // *SlotKind
    claimant: ptr                  // who holds it, or null
    cell: int                      // its grid cell's key
    gone: bool                     // its object removed
}

// The usable objects of a world.
struct Usables {
    cell: float                    // metres a grid cell
    slots: ptr                     // list of *Slot
    sorted: ptr                    // int[]: the slots by cell key
    keys: ptr                      // int[]: each sorted slot's key
    count: int                     // slots sorted
    dirty: bool
}

var g_text: string = ""
var g_at = 0
var g_length = 0
var g_number: ptr = null
var g_error: string = ""

// What the last kind_read that failed said.
kind_error() -> string { return g_error }

usables_new(cell: float) -> *Usables {
    u = heap.new(Usables)
    u.cell = cell
    if u.cell <= 0.0 { u.cell = 2.0 }
    u.slots = list.new()
    u.dirty = true
    return u
}

usables_free(u: *Usables) {
    if u == null { return }
    i = 0
    while i < list.size(u.slots) {
        heap.free(list.get_raw(u.slots, i) as *Slot)
        i = i + 1
    }
    list.free(u.slots)
    if u.sorted != null { free(u.sorted) }
    if u.keys != null { free(u.keys) }
    heap.free(u)
}

// --- kinds ------------------------------------------------------------------------------------------

// The kind declared in the file at `path` (see the top), or null (kind_error
// says why). The caller owns it (kind_free) and may give it to any number of
// objects.
kind_read(path: string) -> *Kind {
    g_error = ""
    content, err = fs.read(path)
    if err != "" {
        g_error = "cannot read the file"
        return null
    }
    if g_number == null { g_number = calloc(1, 8) }
    g_text = content
    g_at = 0
    g_length = string.length(content)
    k = heap.new(Kind)
    k.slots = list.new()
    s = null as *SlotKind
    good = true
    while good {
        word = next_token()
        if string.length(word) == 0 {
            string.free(word)
            break
        }
        if string.starts_with(word, "#") == 1 {
            skip_line()
        } else if string.equals(word, "slot") == 1 {
            if list.size(k.slots) >= MOST_SLOTS {
                g_error = "more slots than a kind may have"
                good = false
            } else {
                s = heap.new(SlotKind)
                s.name = rest_of_line()
                s.tags = string.copy(" ")
                s.facing = core.vec3(0.0, 0.0, 1.0)
                s.enter = string.copy("")
                s.loop = string.copy("")
                s.exit = string.copy("")
                s.lands = LANDS_PELVIS
                list.add_raw(k.slots, s as ptr)
            }
        } else if s != null {
            if string.equals(word, "tags") == 1 {
                while !at_line_end() {
                    tag = next_token()
                    padded = string.concat(s.tags, string.concat(tag, " "))
                    string.free(s.tags)
                    s.tags = padded
                    string.free(tag)
                }
            }
            if string.equals(word, "at") == 1 { s.at = next_vec3() }
            if string.equals(word, "facing") == 1 {
                f = next_vec3()
                if core.v3_len(f) > 0.000001 { s.facing = core.v3_normalize(f) }
            }
            if string.equals(word, "approach") == 1 { s.approach = next_vec3() }
            if string.equals(word, "enter") == 1 {
                string.free(s.enter)
                s.enter = rest_of_line()
            }
            if string.equals(word, "loop") == 1 {
                string.free(s.loop)
                s.loop = rest_of_line()
            }
            if string.equals(word, "exit") == 1 {
                string.free(s.exit)
                s.exit = rest_of_line()
            }
            if string.equals(word, "lands") == 1 {
                part = next_token()
                s.lands = LANDS_PELVIS
                if string.equals(part, "hand_l") == 1 { s.lands = LANDS_HAND_L }
                if string.equals(part, "hand_r") == 1 { s.lands = LANDS_HAND_R }
                if string.equals(part, "feet") == 1 { s.lands = LANDS_FEET }
                string.free(part)
            }
            if string.equals(word, "end") == 1 { s = null as *SlotKind }
        }
        string.free(word)
    }
    string.free(content)
    g_text = ""
    if good && list.size(k.slots) == 0 {
        g_error = "no slots"
        good = false
    }
    if !good {
        kind_free(k)
        return null
    }
    return k
}

kind_free(k: *Kind) {
    if k == null { return }
    i = 0
    while i < list.size(k.slots) {
        s = list.get_raw(k.slots, i) as *SlotKind
        string.free(s.name)
        string.free(s.tags)
        string.free(s.enter)
        string.free(s.loop)
        string.free(s.exit)
        heap.free(s)
        i = i + 1
    }
    list.free(k.slots)
    heap.free(k)
}

kind_slots(k: *Kind) -> int { return list.size(k.slots) }

// --- objects in the world ----------------------------------------------------------------------------

// Object `o` wearing kind `k`: its slots, free. The index of its first.
add(u: *Usables, o: *GameObject, k: *Kind) -> int {
    first = list.size(u.slots)
    i = 0
    while i < list.size(k.slots) {
        s = heap.new(Slot)
        s.object = o as ptr
        s.kind = list.get_raw(k.slots, i)
        list.add_raw(u.slots, s as ptr)
        i = i + 1
    }
    u.dirty = true
    return first
}

// Object `o`'s slots gone: never found again, and whoever held one let go.
remove(u: *Usables, o: *GameObject) {
    i = 0
    while i < list.size(u.slots) {
        s = list.get_raw(u.slots, i) as *Slot
        if s.object == o as ptr {
            s.gone = true
            s.claimant = null
        }
        i = i + 1
    }
    u.dirty = true
}

// An object has moved: its slots found where it is now.
moved(u: *Usables) { u.dirty = true }

slots(u: *Usables) -> int { return list.size(u.slots) }

slot_of(u: *Usables, i: int) -> *Slot {
    if i < 0 || i >= list.size(u.slots) { return null }
    return list.get_raw(u.slots, i) as *Slot
}

// Slot `i`'s point (where its part lands), the way a user faces, and where
// it stands to start: the world's.
slot_at(u: *Usables, i: int) -> Vec3 {
    s = slot_of(u, i)
    if s == null { return core.vec3(0.0, 0.0, 0.0) }
    return world_point(s.object as *GameObject, (s.kind as *SlotKind).at)
}

slot_facing(u: *Usables, i: int) -> Vec3 {
    s = slot_of(u, i)
    if s == null { return core.vec3(0.0, 0.0, 1.0) }
    return core.v3_normalize(core.quat_apply(behaviour.object_rotation(s.object as *GameObject), (s.kind as *SlotKind).facing))
}

slot_approach(u: *Usables, i: int) -> Vec3 {
    s = slot_of(u, i)
    if s == null { return core.vec3(0.0, 0.0, 0.0) }
    k = s.kind as *SlotKind
    return world_point(s.object as *GameObject, core.vec3(k.at.x + k.approach.x, k.approach.y, k.at.z + k.approach.z))
}

slot_object(u: *Usables, i: int) -> *GameObject {
    s = slot_of(u, i)
    if s == null { return null }
    return s.object as *GameObject
}

slot_name(u: *Usables, i: int) -> string { return (slot_of(u, i).kind as *SlotKind).name }
slot_enter(u: *Usables, i: int) -> string { return (slot_of(u, i).kind as *SlotKind).enter }
slot_loop(u: *Usables, i: int) -> string { return (slot_of(u, i).kind as *SlotKind).loop }
slot_exit(u: *Usables, i: int) -> string { return (slot_of(u, i).kind as *SlotKind).exit }
slot_lands(u: *Usables, i: int) -> int { return (slot_of(u, i).kind as *SlotKind).lands }

// Whether slot `i` answers to `tag` ("" answers any).
slot_tagged(u: *Usables, i: int, tag: string) -> bool {
    s = slot_of(u, i)
    if s == null { return false }
    if string.length(tag) == 0 { return true }
    padded = string.concat(" ", string.concat(tag, " "))
    found = string.index_of((s.kind as *SlotKind).tags, padded) >= 0
    string.free(padded)
    return found
}

// A point in object `o`'s frame, in metres, where it is in the world: the
// object's place and turn, not its scale (a cube scaled to a log's size
// keeps its seats where the file puts them).
world_point(o: *GameObject, local: Vec3) -> Vec3 {
    return core.v3_add(behaviour.object_position(o), core.quat_apply(behaviour.object_rotation(o), local))
}

// --- claims -----------------------------------------------------------------------------------------

// Slot `i` held by `who` (any pointer the game knows it by): true if it was
// free or `who` held it already, false if another holds it or it is gone.
claim(u: *Usables, i: int, who: ptr) -> bool {
    s = slot_of(u, i)
    if s == null || s.gone || who == null { return false }
    if s.claimant != null && s.claimant != who { return false }
    s.claimant = who
    return true
}

// Slot `i` let go by `who`; nothing if another holds it.
release(u: *Usables, i: int, who: ptr) {
    s = slot_of(u, i)
    if s == null || s.claimant != who { return }
    s.claimant = null
}

claimant(u: *Usables, i: int) -> ptr {
    s = slot_of(u, i)
    if s == null { return null }
    return s.claimant
}

// --- the search -------------------------------------------------------------------------------------

// The free slot answering to `tag` whose approach point is nearest `at`,
// within `reach` metres level, or -1. A slot `who` holds counts as free to
// it. Searched over the grid cells `reach` covers.
find(u: *Usables, at: Vec3, reach: float, tag: string, who: ptr) -> int {
    if u.dirty { regrid(u) }
    sorted = u.sorted as int[]
    keys = u.keys as int[]
    cx0 = cell_of(at.x - reach, u.cell)
    cx1 = cell_of(at.x + reach, u.cell)
    cz0 = cell_of(at.z - reach, u.cell)
    cz1 = cell_of(at.z + reach, u.cell)
    best = 0 - 1
    best_d = reach * reach
    cz = cz0
    while cz <= cz1 {
        cx = cx0
        while cx <= cx1 {
            key = cell_key(cx, cz)
            n = first_with(keys, u.count, key)
            while n < u.count && keys[n] == key {
                i = sorted[n]
                s = list.get_raw(u.slots, i) as *Slot
                if !s.gone && (s.claimant == null || s.claimant == who) {
                    p = slot_approach(u, i)
                    dx = p.x - at.x
                    dz = p.z - at.z
                    d = dx * dx + dz * dz
                    if d <= best_d && (d < best_d || best < 0 || i < best) && slot_tagged(u, i, tag) {
                        best_d = d
                        best = i
                    }
                }
                n = n + 1
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
    return best
}

// The same over every slot: what find must give, for a test to hold it to.
find_every(u: *Usables, at: Vec3, reach: float, tag: string, who: ptr) -> int {
    best = 0 - 1
    best_d = reach * reach
    i = 0
    while i < list.size(u.slots) {
        s = list.get_raw(u.slots, i) as *Slot
        if !s.gone && (s.claimant == null || s.claimant == who) {
            p = slot_approach(u, i)
            dx = p.x - at.x
            dz = p.z - at.z
            d = dx * dx + dz * dz
            if d <= best_d && (d < best_d || best < 0 || i < best) && slot_tagged(u, i, tag) {
                best_d = d
                best = i
            }
        }
        i = i + 1
    }
    return best
}

cell_of(x: float, size: float) -> int {
    c = x / size
    i = c as int
    if (i as float) > c { i = i - 1 }
    return i
}

// A cell's key: its two coordinates in one int (each within +-32767 cells).
cell_key(cx: int, cz: int) -> int { return (cx + 32768) * 65536 + (cz + 32768) }

// The first sorted slot with `key`, or where it would be.
first_with(keys: int[], n: int, key: int) -> int {
    lo = 0
    hi = n
    while lo < hi {
        mid = (lo + hi) / 2
        if keys[mid] < key { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

// Every slot's cell found again and the slots sorted by it.
regrid(u: *Usables) {
    n = list.size(u.slots)
    if u.sorted != null { free(u.sorted) }
    if u.keys != null { free(u.keys) }
    u.sorted = calloc(n + 1, 4)
    u.keys = calloc(n + 1, 4)
    sorted = u.sorted as int[]
    keys = u.keys as int[]
    i = 0
    while i < n {
        p = slot_approach(u, i)
        key = cell_key(cell_of(p.x, u.cell), cell_of(p.z, u.cell))
        (list.get_raw(u.slots, i) as *Slot).cell = key
        // Insertion into the sorted run: slots are added a few at a time.
        k = i
        while k > 0 && keys[k - 1] > key {
            keys[k] = keys[k - 1]
            sorted[k] = sorted[k - 1]
            k = k - 1
        }
        keys[k] = key
        sorted[k] = i
        i = i + 1
    }
    u.count = n
    u.dirty = false
}

// --- reading -----------------------------------------------------------------------------------------

is_blank(ch: int) -> bool { return ch == 32 || ch == 9 || ch == 10 || ch == 13 }

next_token() -> string {
    while g_at < g_length && is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
    start = g_at
    while g_at < g_length && !is_blank(string.char_at(g_text, g_at)) { g_at = g_at + 1 }
    if g_at == start { return string.copy("") }
    return string.substring(g_text, start, g_at)
}

next_number() -> float {
    word = next_token()
    value = 0.0
    if string.length(word) > 0 && string.to_double_raw(word, g_number) != 0 { value = (g_number as float[])[0] }
    string.free(word)
    return value
}

next_vec3() -> Vec3 {
    x = next_number()
    y = next_number()
    z = next_number()
    return core.vec3(x, y, z)
}

// Whether only spaces, tabs or a comment are left before the line's end.
at_line_end() -> bool {
    while g_at < g_length {
        ch = string.char_at(g_text, g_at)
        if ch == 35 {
            while g_at < g_length && string.char_at(g_text, g_at) != 10 { g_at = g_at + 1 }
            return true
        }
        if ch != 32 && ch != 9 && ch != 13 { return ch == 10 }
        g_at = g_at + 1
    }
    return true
}

skip_line() {
    while g_at < g_length && string.char_at(g_text, g_at) != 10 { g_at = g_at + 1 }
    if g_at < g_length { g_at = g_at + 1 }
}

// The line's next word, or "" (a name, a take's).
rest_of_line() -> string {
    if at_line_end() { return string.copy("") }
    return next_token()
}
