// Particles (#546): an emitter that spawns at a rate or in bursts, each
// particle thrown into a cone with a speed and a lifetime, pulled by
// gravity and slowed by drag, landing on the static world -- the physics'
// static colliders, where the engine has physics, and a ground height --
// and saying where it landed, so a game turns a drop of blood into a stain
// or a spark into a scorch. Blood spraying from a hit and dripping from a
// wound, dust, sparks, debris.
//
// Drawn as the weather's particles are: one model an emitter, a quad turned
// to the eye at every point instance (core.model_set_billboard, full), a
// soft disc for a texture, a colour and a scale a point -- the scale
// running from the size at birth to the size at death, which is the fade.
// The particles are the emitter's arrays, uploaded whole each frame
// (core.model_set_instance_positions, _scales); a dead one is the last one
// moved into its place.
//
// Stepped on the engine's fixed step, with a generator of its own seeded by
// the game: the same emitter does the same thing on every run, as a replay
// or a networked game needs. A landing is found by a ray along the step's
// move against the static world (physics.ray_static_hit), one a particle a
// step: a thousand particles at 60 Hz are sixty thousand rays a second.

import std.heap
import ae3d.core
import ae3d.engine
import ae3d.png
import ae3d.picture
import ae3d.physics
import ae3d.flames

exports (
    Emitter, emitter, emitter_free, emitter_step, burst,
    set_position, set_direction, set_rate, set_speed, set_lifetime, set_gravity, set_drag,
    set_size, set_color, set_ground, set_seed, on_land,
    set_blend, set_texture, add_color_key, clear_color_keys, set_spin, set_glow, set_fire, set_heat, set_smoke,
    set_stretch, set_area, set_soft, set_light, emitter_light, set_haze, KEYS,
    FLAMES, SMOKE,
    alive, landed, spawned, particle_position, particle_velocity, emitter_model
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float
extern sin(x: float) -> float
extern cos(x: float) -> float
extern atan2(y: float, x: float) -> float
extern log(x: float) -> float
extern pow(x: float, y: float) -> float

const DISC = 32                      // the soft disc's texels a side
const PI = 3.14159265358979323846

struct Emitter {
    engine: ptr                      // *Engine
    model: ptr                       // *Model, every particle a point instance of it
    behaviour: ptr                   // *Behaviour, the fixed step
    capacity: int
    count: int                       // alive now
    xyz: ptr                         // float[capacity * 3]
    velocity: ptr                    // float[capacity * 3]
    age: ptr                         // float[capacity]
    life: ptr                        // float[capacity]
    scales: ptr                      // float[capacity], uploaded
    position: Vec3                   // where particles are born
    direction: Vec3                  // the cone's axis, unit
    cone: float                      // the cone's half angle, radians
    rate: float                      // particles a second; 0 for bursts alone
    owed: float                      // the fraction of a particle the rate owes
    speed_low: float
    speed_high: float
    life_low: float
    life_high: float
    gravity: Vec3
    drag: float                      // the share of its speed a particle loses a second
    size_start: float
    size_end: float
    red: float
    green: float
    blue: float
    has_ground: bool
    ground: float                    // the height of a plane a particle lands on
    seed: long
    land: fn(ptr, Vec3, Vec3)        // where it landed and the surface's normal; null for none
    land_context: ptr
    landed_count: int
    spawned_count: int
    // Colour and alpha over a particle's life (#728): `key_count` keys of
    // five floats -- the life's share, red, green, blue, alpha -- in order
    // of the share; with none, the emitter's colour and alpha 1.
    keys: ptr                        // float[KEYS * 5]
    key_count: int
    // A particle's turn about the way it faces, and how fast it turns,
    // radians a second between spin_low and spin_high.
    angle: ptr                       // float[capacity]
    turning: ptr                     // float[capacity]
    spin_low: float
    spin_high: float
    // Drawn along their flight as it shows on the screen, as long as the
    // way they travel in `stretch` seconds (0: square, turned by the spin).
    stretch: float
    // Born anywhere on a level disc of `area` metres' radius about the
    // position, evenly over it (0: at the position): a fire across its logs.
    area: float
    // A light the fire casts (#738): a point at the emitter, its colour the
    // black body's, flickering about `light_power`; null for none.
    light: ptr                       // *Light
    light_power: float
    light_lift: float
    clock: float
    // Heat haze over the fire (#738): an engine haze slot, -1 for none.
    haze_slot: int
    haze_radius: float
    haze_height: float
    haze_strength: float
}

// The most colour keys an emitter holds.
const KEYS = 8
// The flipbooks ae3d.flames bakes for set_fire and set_smoke, once a run.
const FLAMES = "ae3d://particles/flames"
const SMOKE = "ae3d://particles/smoke"
var g_flames_baked = false

// An emitter of at most `capacity` particles at once, its model in the
// engine and its step in the engine's loop: born at the origin, thrown up
// into a cone of 15 degrees at 2 to 3 m/s, living two seconds, under
// Earth's gravity, a tenth of a metre across, white. Set what differs.
emitter(e: *Engine, capacity: int) -> *Emitter {
    em = heap.new(Emitter)
    em.engine = e as ptr
    em.capacity = capacity
    em.xyz = calloc(capacity * 3, 8)
    em.velocity = calloc(capacity * 3, 8)
    em.age = calloc(capacity, 8)
    em.life = calloc(capacity, 8)
    em.scales = calloc(capacity, 8)
    em.angle = calloc(capacity, 8)
    em.turning = calloc(capacity, 8)
    em.keys = calloc(KEYS * 5, 8)
    em.position = core.vec3(0.0, 0.0, 0.0)
    em.direction = core.vec3(0.0, 1.0, 0.0)
    em.cone = 15.0 * PI / 180.0
    em.speed_low = 2.0
    em.speed_high = 3.0
    em.life_low = 2.0
    em.life_high = 2.0
    em.gravity = core.vec3(0.0, 0.0 - 9.81, 0.0)
    em.size_start = 0.1
    em.size_end = 0.1
    em.red = 1.0
    em.green = 1.0
    em.blue = 1.0
    em.seed = 1 as long
    em.haze_slot = 0 - 1
    m = quad()
    core.model_set_texture(m, soft_disc())
    // Cut to the disc: the quad's corners are the texture's clear rim.
    core.model_set_cutout(m, 0.5)
    core.model_set_casts_shadow(m, false)
    core.model_enable_instancing(m, capacity)
    core.model_enable_point_instancing(m)
    core.model_set_billboard(m, 2)
    // Added with every instance counted, since a renderer sets up an
    // instanced model's buffers from the count it has when it is added;
    // then drawn to none until there are particles.
    engine.engine_add_model(e, m)
    core.model_set_instance_draw_count(m, 0)
    em.model = m as ptr
    b = engine.behaviour_new("particles", em as ptr)
    b.fixed_update = on_fixed
    engine.engine_add_behaviour(e, b)
    em.behaviour = b as ptr
    return em
}

emitter_free(em: *Emitter) {
    if em == null { return }
    e = em.engine as *Engine
    if em.behaviour != null {
        engine.engine_remove_behaviour(e, em.behaviour as *Behaviour)
        heap.free(em.behaviour as *Behaviour)
    }
    if em.model != null {
        engine.engine_remove_model(e, em.model as *Model)
        core.model_free(em.model as *Model)
    }
    if em.light != null {
        engine.engine_remove_light(e, em.light as *Light)
        core.light_free(em.light as *Light)
    }
    if em.haze_slot >= 0 { engine.engine_free_haze(e, em.haze_slot) }
    free(em.xyz)
    free(em.velocity)
    free(em.age)
    free(em.life)
    free(em.scales)
    free(em.angle)
    free(em.turning)
    free(em.keys)
    heap.free(em)
}

on_fixed(state: ptr, e: *Engine, step: float) {
    emitter_step(state as *Emitter, step)
}

// --- what a game sets ---------------------------------------------------------------------------------------

set_position(em: *Emitter, at: Vec3) { em.position = at }

// The cone particles are thrown into: its axis and its half angle in radians.
set_direction(em: *Emitter, direction: Vec3, cone: float) {
    if core.v3_len(direction) > 0.000001 { em.direction = core.v3_normalize(direction) }
    em.cone = cone
}

set_rate(em: *Emitter, per_second: float) { em.rate = per_second }

set_speed(em: *Emitter, low: float, high: float) {
    em.speed_low = low
    em.speed_high = high
}

set_lifetime(em: *Emitter, low: float, high: float) {
    em.life_low = low
    em.life_high = high
}

set_gravity(em: *Emitter, g: Vec3) { em.gravity = g }

// The share of its speed a particle loses each second: 0 none, 1 all of
// it in a second (taken a step at a time).
set_drag(em: *Emitter, per_second: float) { em.drag = per_second }

// Across, in metres, at birth and at death; between, as it ages.
set_size(em: *Emitter, start: float, end: float) {
    em.size_start = start
    em.size_end = end
}

set_color(em: *Emitter, r: float, g: float, b: float) {
    em.red = r
    em.green = g
    em.blue = b
}

// A plane at height `y` particles land on, as well as the static world.
set_ground(em: *Emitter, y: float) {
    em.has_ground = true
    em.ground = y
}

set_seed(em: *Emitter, seed: long) {
    em.seed = seed
    if em.seed == (0 as long) { em.seed = 1 as long }
}

// Called for every particle that lands, with where and the surface's
// normal; the particle is gone after.
on_land(em: *Emitter, listener: fn(ptr, Vec3, Vec3), context: ptr) {
    em.land = listener
    em.land_context = context
}

// --- what a game reads ----------------------------------------------------------------------------------------

alive(em: *Emitter) -> int { return em.count }
landed(em: *Emitter) -> int { return em.landed_count }
spawned(em: *Emitter) -> int { return em.spawned_count }
emitter_model(em: *Emitter) -> *Model { return em.model as *Model }

particle_position(em: *Emitter, index: int) -> Vec3 {
    if index < 0 || index >= em.count { return core.vec3(0.0, 0.0, 0.0) }
    x = em.xyz as float[]
    return core.vec3(x[index * 3], x[index * 3 + 1], x[index * 3 + 2])
}

particle_velocity(em: *Emitter, index: int) -> Vec3 {
    if index < 0 || index >= em.count { return core.vec3(0.0, 0.0, 0.0) }
    v = em.velocity as float[]
    return core.vec3(v[index * 3], v[index * 3 + 1], v[index * 3 + 2])
}

// --- the step -----------------------------------------------------------------------------------------------

// `n` particles at once, as many as there is room for: a spray at a hit.
burst(em: *Emitter, n: int) {
    k = 0
    while k < n && em.count < em.capacity {
        emit_one(em)
        k = k + 1
    }
    upload(em)
}

// One step: the rate's particles born, every particle aged, moved and
// landed, the dead taken out, and the rest uploaded.
emitter_step(em: *Emitter, step: float) {
    if step <= 0.0 { return }
    em.clock = em.clock + step
    if em.light != null { flicker(em) }
    if em.haze_slot >= 0 {
        engine.engine_set_haze(em.engine as *Engine, em.haze_slot, em.position, em.haze_radius, em.haze_height,
                               em.haze_strength, em.clock * 1.6)
    }
    em.owed = em.owed + em.rate * step
    while em.owed >= 1.0 {
        em.owed = em.owed - 1.0
        if em.count < em.capacity { emit_one(em) }
    }
    p = physics.of(em.engine as *Engine)
    x = em.xyz as float[]
    v = em.velocity as float[]
    age = em.age as float[]
    life = em.life as float[]
    keep = 1.0 - em.drag * step
    if keep < 0.0 { keep = 0.0 }
    i = 0
    angle = em.angle as float[]
    turning = em.turning as float[]
    while i < em.count {
        age[i] = age[i] + step
        angle[i] = angle[i] + turning[i] * step
        if age[i] >= life[i] {
            kill(em, i)
        } else {
            // Moved by the mean of the step's velocities, the one it had and
            // the one gravity and drag leave it: under gravity alone that is
            // where it truly is (a step's velocity alone fell short of the
            // top of a throw by v dt / 2).
            at = i * 3
            vx = (v[at] + em.gravity.x * step) * keep
            vy = (v[at + 1] + em.gravity.y * step) * keep
            vz = (v[at + 2] + em.gravity.z * step) * keep
            from = core.vec3(x[at], x[at + 1], x[at + 2])
            to = core.vec3(from.x + (v[at] + vx) * 0.5 * step, from.y + (v[at + 1] + vy) * 0.5 * step, from.z + (v[at + 2] + vz) * 0.5 * step)
            v[at] = vx
            v[at + 1] = vy
            v[at + 2] = vz
            if lands(em, p, from, to) {
                kill(em, i)
            } else {
                x[at] = to.x
                x[at + 1] = to.y
                x[at + 2] = to.z
                i = i + 1
            }
        }
    }
    upload(em)
}

// Whether the move from `from` to `to` meets the static world or the
// ground; said to the game where it does.
lands(em: *Emitter, p: *Physics, from: Vec3, to: Vec3) -> bool {
    move = core.v3_sub(to, from)
    reach = core.v3_len(move)
    best = 2.0
    point = to
    normal = core.vec3(0.0, 1.0, 0.0)
    if p != null && reach > 0.000001 {
        hit = physics.ray_static_hit(p, from, core.v3_mul(move, 1.0 / reach), reach)
        if hit.hit {
            best = hit.fraction
            point = hit.point
            normal = hit.normal
        }
    }
    if em.has_ground && to.y <= em.ground && from.y > em.ground {
        share = (from.y - em.ground) / (from.y - to.y)
        if share < best {
            best = share
            point = core.vec3(from.x + move.x * share, em.ground, from.z + move.z * share)
            normal = core.vec3(0.0, 1.0, 0.0)
        }
    }
    if best > 1.0 { return false }
    em.landed_count = em.landed_count + 1
    if em.land != null {
        said = em.land
        said(em.land_context, point, normal)
    }
    return true
}

// A particle born at the emitter, thrown into the cone.
emit_one(em: *Emitter) {
    i = em.count
    em.count = em.count + 1
    em.spawned_count = em.spawned_count + 1
    // A direction in the cone, uniform over its cap: a cosine between the
    // cone's and 1, an angle round the axis.
    cosine = 1.0 - random(em) * (1.0 - cos(em.cone))
    sine = sqrt(1.0 - cosine * cosine)
    turn = random(em) * 2.0 * PI
    axis = em.direction
    helper = core.vec3(1.0, 0.0, 0.0)
    if axis.x * axis.x > 0.81 { helper = core.vec3(0.0, 1.0, 0.0) }
    u = core.v3_normalize(core.v3_cross(axis, helper))
    w = core.v3_cross(axis, u)
    dir = core.v3_add(core.v3_mul(axis, cosine), core.v3_add(core.v3_mul(u, sine * cos(turn)), core.v3_mul(w, sine * sin(turn))))
    speed = em.speed_low + (em.speed_high - em.speed_low) * random(em)
    x = em.xyz as float[]
    v = em.velocity as float[]
    x[i * 3] = em.position.x
    x[i * 3 + 1] = em.position.y
    x[i * 3 + 2] = em.position.z
    // Drawn only where the emitter has an area, so one without keeps the
    // particles its seed always gave.
    if em.area > 0.0 {
        r = em.area * sqrt(random(em))
        a = random(em) * 2.0 * PI
        x[i * 3] = x[i * 3] + r * cos(a)
        x[i * 3 + 2] = x[i * 3 + 2] + r * sin(a)
    }
    v[i * 3] = dir.x * speed
    v[i * 3 + 1] = dir.y * speed
    v[i * 3 + 2] = dir.z * speed
    (em.age as float[])[i] = 0.0
    (em.life as float[])[i] = em.life_low + (em.life_high - em.life_low) * random(em)
    (em.angle as float[])[i] = 0.0
    (em.turning as float[])[i] = 0.0
    // Drawn only where the emitter spins, so an emitter that does not has the
    // same particles from its seed as it always had.
    if em.spin_low != 0.0 || em.spin_high != 0.0 {
        (em.angle as float[])[i] = random(em) * 2.0 * PI
        (em.turning as float[])[i] = em.spin_low + (em.spin_high - em.spin_low) * random(em)
    }
}

// The last particle moved into the place of the one that died.
kill(em: *Emitter, i: int) {
    last = em.count - 1
    if i != last {
        x = em.xyz as float[]
        v = em.velocity as float[]
        k = 0
        while k < 3 {
            x[i * 3 + k] = x[last * 3 + k]
            v[i * 3 + k] = v[last * 3 + k]
            k = k + 1
        }
        (em.age as float[])[i] = (em.age as float[])[last]
        (em.life as float[])[i] = (em.life as float[])[last]
        (em.angle as float[])[i] = (em.angle as float[])[last]
        (em.turning as float[])[i] = (em.turning as float[])[last]
    }
    em.count = last
}

// The particles to the model: where each is, its size for its age, its colour.
upload(em: *Emitter) {
    m = em.model as *Model
    scales = em.scales as float[]
    age = em.age as float[]
    life = em.life as float[]
    // An engine with no camera yet (headless, or not yet run) draws
    // nothing, so there is no view to stretch along.
    cam = engine.engine_camera(em.engine as *Engine)
    stretching = em.stretch > 0.0 && cam != null
    eye = core.vec3(0.0, 0.0, 0.0)
    if stretching { eye = cam.position }
    xyz = em.xyz as float[]
    vel = em.velocity as float[]
    i = 0
    while i < em.count {
        t = 0.0
        if life[i] > 0.0 { t = age[i] / life[i] }
        scales[i] = em.size_start + (em.size_end - em.size_start) * t
        turn = (em.angle as float[])[i]
        along = 0.0
        if stretching {
            // The velocity seen face on, in the quad's own frame as the
            // full billboard builds it: its angle the turn, its length the
            // stretch, over the particle's width.
            at = core.vec3(xyz[i * 3], xyz[i * 3 + 1], xyz[i * 3 + 2])
            forward = core.v3_normalize(core.v3_sub(eye, at))
            right = core.v3_normalize(core.v3_cross(core.vec3(0.0, 1.0, 0.0), forward))
            up = core.v3_cross(forward, right)
            flight = core.vec3(vel[i * 3], vel[i * 3 + 1], vel[i * 3 + 2])
            vx = core.v3_dot(flight, right)
            vy = core.v3_dot(flight, up)
            turn = atan2(vy, vx)
            width = scales[i]
            if width < 0.0001 { width = 0.0001 }
            along = 1.0 + sqrt(vx * vx + vy * vy) * em.stretch / width
        }
        if em.key_count > 0 {
            keyed(em, t)
            core.model_set_instance_color(m, i, g_key_r, g_key_g, g_key_b)
            core.model_set_instance_extras(m, i, g_key_a, t, turn)
        } else {
            core.model_set_instance_color(m, i, em.red, em.green, em.blue)
            core.model_set_instance_extras(m, i, 1.0, t, turn)
        }
        core.model_set_instance_stretch(m, i, along)
        i = i + 1
    }
    core.model_set_instance_positions(m, em.xyz, em.count)
    core.model_set_instance_scales(m, em.scales, em.count)
    core.model_set_instance_draw_count(m, em.count)
}

// The colour keys at life share `t`, between the two keys either side of
// it (the first and the last held beyond them), into g_key_*.
var g_key_r = 1.0
var g_key_g = 1.0
var g_key_b = 1.0
var g_key_a = 1.0

keyed(em: *Emitter, t: float) {
    k = em.keys as float[]
    n = em.key_count
    hi = 0
    while hi < n && k[hi * 5] < t { hi = hi + 1 }
    lo = hi - 1
    if hi >= n { hi = n - 1 }
    if lo < 0 { lo = 0 }
    span = k[hi * 5] - k[lo * 5]
    f = 0.0
    if span > 0.0 { f = (t - k[lo * 5]) / span }
    g_key_r = k[lo * 5 + 1] + (k[hi * 5 + 1] - k[lo * 5 + 1]) * f
    g_key_g = k[lo * 5 + 2] + (k[hi * 5 + 2] - k[lo * 5 + 2]) * f
    g_key_b = k[lo * 5 + 3] + (k[hi * 5 + 3] - k[lo * 5 + 3]) * f
    g_key_a = k[lo * 5 + 4] + (k[hi * 5 + 4] - k[lo * 5 + 4]) * f
}

// The emitter's own generator: a 64-bit linear congruential one (Knuth's
// MMIX constants, wrapping), its top 31 bits taken -- masked, since `>>`
// on a long carries the sign. A uniform number in [0, 1).
random(em: *Emitter) -> float {
    em.seed = em.seed * (6364136223846793005 as long) + (1442695040888963407 as long)
    bits = (em.seed >> 33) & (2147483647 as long)
    return (bits as float) / 2147483648.0
}

// --- the look -----------------------------------------------------------------------------------------------

// How the particles go over what is behind them (#728): core.BLEND_OPAQUE,
// the default, cut to their texture's shape; BLEND_ALPHA mixed by their
// alpha (smoke); BLEND_ADD added to it (flames, embers, sparks: where they
// cross they only brighten).
// Blended, a particle is its texture's soft falloff, not cut at the half
// the opaque disc is cut at: a flame's or a puff's rim was clipped hard.
set_blend(em: *Emitter, mode: int) {
    m = em.model as *Model
    core.model_set_blend(m, mode)
    if mode == core.BLEND_OPAQUE {
        core.model_set_cutout(m, 0.5)
    } else {
        core.model_set_cutout(m, 0.0)
    }
}

// The particles glowing at `brightness` times their colour, lit by
// nothing (1 or more; 0 lit as any surface is): embers, sparks, flames.
set_glow(em: *Emitter, brightness: float) {
    m = em.model as *Model
    if brightness <= 0.0 {
        core.model_set_exposure(m, 1.0)
        return
    }
    b = brightness
    if b < 1.001 { b = 1.001 }
    core.model_set_exposure(m, b * 10.0)
}

bake_once() {
    if g_flames_baked { return }
    g_flames_baked = flames.bake(FLAMES, SMOKE, 7) == 1
}

// Fire (#738): each particle a flame simulated by ae3d.flames, played over
// its life, glowing as a black body up to `kelvin` at its hottest (1800 to
// 2400 a wood fire's) and added over what is behind it. Its quads are
// twice as tall as wide, as the flames are. Colour keys' red cools it over
// a life; their alpha fades it.
set_fire(em: *Emitter, kelvin: float) {
    bake_once()
    m = em.model as *Model
    set_texture(em, FLAMES, flames.COLUMNS, flames.ROWS)
    set_blend(em, core.BLEND_ADD)
    core.model_set_fire(m, kelvin)
    core.model_set_scale(m, 1.0, 2.0, 1.0)
    core.model_set_soft(m, 0.25)
    // A flame's foot is at the bottom of its frame: it stands on the point.
    core.model_set_billboard_lift(m, 0.42)
}

// Sparks and embers hot (#738): each glowing as a black body up to `kelvin`
// at its hottest (2000 a fresh spark's), cooled over its life by its colour
// keys' red, as bright as the fourth power of its heat -- so a spark rises
// yellow-white and dies a dull red, fading as it goes, where a colour key
// alone faded its colour and kept its brightness. Added over what is
// behind it; set_glow scales it.
set_heat(em: *Emitter, kelvin: float) {
    m = em.model as *Model
    set_blend(em, core.BLEND_ADD)
    core.model_set_fire(m, kelvin)
}

// Sparks drawn along their flight: each as long as the way it travels in
// `seconds` as it shows on the screen, turned to it (0 for square). The
// spin is set aside while it is on.
set_stretch(em: *Emitter, seconds: float) { em.stretch = seconds }

// Blended particles faded out within `metres` of what is drawn behind them
// (#738): they melt into the ground and the logs instead of cutting a line
// across them. 0 for hard; set_fire and set_smoke make them soft.
set_soft(em: *Emitter, metres: float) { core.model_set_soft(em.model as *Model, metres) }

// Particles born anywhere on a level disc `radius` metres about the
// position, evenly over it (0 for at the position).
set_area(em: *Emitter, radius: float) { em.area = radius }

// The light the fire casts (#738): a point `lift` metres over the emitter,
// the colour of a black body at `kelvin`, reaching `range` metres, its
// intensity flickering about `power` on the emitter's own clock (the same
// every run). Added to the engine; gone with the emitter.
set_light(em: *Emitter, kelvin: float, power: float, range: float, lift: float) {
    e = em.engine as *Engine
    if em.light != null {
        engine.engine_remove_light(e, em.light as *Light)
        core.light_free(em.light as *Light)
    }
    glow = black_body(kelvin)
    l = core.light_point(core.v3_add(em.position, core.vec3(0.0, lift, 0.0)), glow, power, range)
    l.temperature = 6500.0
    em.light = l as ptr
    em.light_power = power
    em.light_lift = lift
    engine.engine_add_light(e, l)
}

emitter_light(em: *Emitter) -> *Light { return em.light as *Light }

// Heat haze over the fire (#738): a column of hot air `radius` across and
// `height` tall over the emitter, rippling what is seen through it by
// `strength` (0.5 a campfire's), its shimmer rising on the emitter's clock.
// One of the engine's HAZE_SLOTS; false when they are all taken. 0 strength
// gives the slot back.
set_haze(em: *Emitter, radius: float, height: float, strength: float) -> bool {
    e = em.engine as *Engine
    if strength <= 0.0 {
        if em.haze_slot >= 0 { engine.engine_free_haze(e, em.haze_slot) }
        em.haze_slot = 0 - 1
        return true
    }
    if em.haze_slot < 0 { em.haze_slot = engine.engine_haze_slot(e) }
    if em.haze_slot < 0 { return false }
    em.haze_radius = radius
    em.haze_height = height
    em.haze_strength = strength
    engine.engine_set_haze(e, em.haze_slot, em.position, radius, height, strength, em.clock * 1.6)
    return true
}

// The fire's light breathing: three unrelated waves, never in step, so it
// neither pulses nor repeats a beat a person could follow.
flicker(em: *Emitter) {
    l = em.light as *Light
    t = em.clock
    f = 0.80 + 0.10 * sin(t * 11.3) + 0.06 * sin(t * 23.9 + 1.7) + 0.04 * sin(t * 47.1 + 4.2)
    l.intensity = em.light_power * f
    l.position = core.v3_add(em.position, core.vec3(0.03 * sin(t * 7.1), em.light_lift, 0.03 * sin(t * 5.3 + 2.0)))
}

// The colour a black body glows at `kelvin`, its brightest channel one, as
// the shader's black_body (Helland's fit), linear.
black_body(kelvin: float) -> Vec3 {
    t = kelvin / 100.0
    if t < 5.0 { t = 5.0 }
    g = 0.0
    if t > 6.6 { g = clampf((99.4708025861 * log(t) - 161.1195681661) / 255.0) }
    b = 0.0
    if t > 19.0 { b = clampf((138.5177312231 * log(t - 10.0) - 305.0447927307) / 255.0) }
    return core.vec3(1.0, pow(g, 2.2), pow(b, 2.2))
}

clampf(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

// Smoke: each particle the smoke of the same flames, blended by its alpha
// and lit as a surface is.
set_smoke(em: *Emitter) {
    bake_once()
    m = em.model as *Model
    set_texture(em, SMOKE, flames.COLUMNS, flames.ROWS)
    set_blend(em, core.BLEND_ALPHA)
    core.model_set_soft(m, 0.5)
    core.model_set_scale(m, 1.0, 2.0, 1.0)
}

// The particles' texture, from `path` (a file, or a picture registered by
// name), as a flipbook of `columns` by `rows` frames, the first at the top
// left, played over each particle's life; 1 by 1 for one picture.
set_texture(em: *Emitter, path: string, columns: int, rows: int) {
    m = em.model as *Model
    core.model_set_texture(m, path)
    if columns > 1 || rows > 1 {
        core.model_set_flipbook(m, columns, rows)
    } else {
        core.model_set_flipbook(m, 0, 0)
    }
}

// A colour and an alpha at share `t` of a particle's life (0 born, 1 gone),
// kept in order of `t`: a flame born white-yellow and dying red and dark,
// smoke fading out. False past KEYS keys.
add_color_key(em: *Emitter, t: float, r: float, g: float, b: float, a: float) -> bool {
    if em.key_count >= KEYS { return false }
    k = em.keys as float[]
    at = em.key_count
    while at > 0 && k[(at - 1) * 5] > t {
        c = 0
        while c < 5 {
            k[at * 5 + c] = k[(at - 1) * 5 + c]
            c = c + 1
        }
        at = at - 1
    }
    k[at * 5] = t
    k[at * 5 + 1] = r
    k[at * 5 + 2] = g
    k[at * 5 + 3] = b
    k[at * 5 + 4] = a
    em.key_count = em.key_count + 1
    return true
}

clear_color_keys(em: *Emitter) { em.key_count = 0 }

// Each particle turned at random as it is born and turning at between `low`
// and `high` radians a second, either way as their signs say: a flame
// licks, smoke rolls. 0 and 0, the default, for none.
set_spin(em: *Emitter, low: float, high: float) {
    em.spin_low = low
    em.spin_high = high
}

// A disc white at its middle, clear at its rim.
soft_disc() -> string {
    name = "ae3d://particles/soft_disc"
    pixels = calloc(DISC * DISC, 4)
    y = 0
    while y < DISC {
        x = 0
        while x < DISC {
            dx = ((x as float) + 0.5) / (DISC as float) - 0.5
            dy = ((y as float) + 0.5) / (DISC as float) - 0.5
            r = sqrt(dx * dx + dy * dy) * 2.0
            a = 1.0 - r * r
            if a < 0.0 { a = 0.0 }
            png.rgba_set(pixels, y * DISC + x, 1.0, 1.0, 1.0, a)
            x = x + 1
        }
        y = y + 1
    }
    ok = picture.register_rgba(name, pixels, DISC, DISC) == 1
    free(pixels)
    if !ok { return "" }
    return name
}

// A unit quad in the XY plane facing +Z, one metre across, centred.
quad() -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.0 - 0.5, 0.0), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.0 - 0.5, 0.0), 1.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.5, 0.0), 1.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.5, 0.0), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}
