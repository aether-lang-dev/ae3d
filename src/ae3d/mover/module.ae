// A figure's mover (#856): the controller that moves a figure the way a game
// asks and feeds its animator's graph, which picks the clips.
//
// A game asks for a velocity over the ground (a stick's, metres a second)
// and, optionally, a way to face (strafing: facing a target while moving
// any way; otherwise the figure faces the way it goes). The mover is
// Holden's simulation: its velocity follows the one asked on a critically
// damped spring (half-life HALF_LIFE), its facing follows on another
// (FACING_HALF_LIFE), and the figure's object goes where the springs take
// it. Each step it writes the graph's parameters, which the animator's
// blend spaces and transitions read:
//   - "vx", "vz": the velocity in the figure's own frame (x across to its
//     left, z ahead), a 2D blend space's;
//   - "speed": the velocity's size, a 1D blend space's;
//   - "moving": on while it moves or is asked to (above MOVING);
//   - "turning": the facing's rate, radians a second, to its left;
//   - "go": on while a velocity is asked for;
//   - "travelled": the metres gone since it last stood still, what a start
//     is played by;
//   - "rest": the distance left to where the springs bring it to rest,
//     what a stop is played by (distance matching).
// Its gait is chosen by the graph from the real velocity, not by the
// mover: the clip choice that used to be hard-coded in ae3d.locomotion is
// the graph's.
//
// The springs' way ahead (future) is what motion matching asks for.

import std.heap
import ae3d.core
import ae3d.behaviour
import ae3d.physics
import ae3d.animator

extern exp(x: float) -> float

exports (
    Mover, HALF_LIFE, FACING_HALF_LIFE, MOVING,
    mover_new, mover_free, ask, face, step, velocity, facing_of, future, rest_distance, rest_point, set_half_lives, set_braking, set_braking_below, set_start_pace, set_matcher, set_follow, sim_at, settle, settle_moving, path, path_on
)

// Seconds the springs halve their gap to the velocity and facing asked in.
const HALF_LIFE = 0.27
const FACING_HALF_LIFE = 0.27
// Metres a second over which a figure counts as moving.
const MOVING = 0.1
// Radians off its facing a way asked of a standing figure may be for it to
// set off at once: further, it turns toward it where it stands first (its
// feet step it round), then starts, as one turns before walking off to the
// side. Started at once, a forward start played while the figure turned
// 90 degrees to walk off along a log it had sat on, and its feet crossed
// 110 mm.
const START_ARC = 0.5236
// The share of its speed a walker keeps through a curve past a right angle (#969).
const CURVE_SLOW = 0.6
// Radians a moving figure's way may be off the way it faces while it curves:
// people going round a bend face where they go.
const CURVE_ARC = 0.1745
// Following its clips (set_follow): the figure eased toward the simulation
// over this half-life, at most this many metres a second over its own
// motion, and the simulation kept within CLAMP metres of it.
const ADJUST_HALF_LIFE = 0.3
// (Each metre the figure is eased is a metre its planted feet's locks drift:
// at 0.5 m/s, a matched turn's stance drifted past the lock's slip.)
const ADJUST_MOST = 0.2
const CLAMP = 0.15

struct Mover {
    animator: ptr                  // *Animator
    object: ptr                    // *GameObject
    velocity: Vec3                 // over the ground, the world's
    acceleration: Vec3
    asked: Vec3                    // the velocity asked for
    facing: float                  // yaw about up, radians (0 facing +z)
    facing_rate: float
    face_asked: float
    strafing: bool                 // facing held to face_asked; else it faces the way it goes
    turning_first: bool            // standing, turning toward a way asked past START_ARC before it starts
    half_life: float
    facing_half_life: float
    travelled: float               // metres gone since it last stood still
    braking: float                 // m/s a second it slows at with nothing asked, 0 for the spring
    brake_below: float             // and the speed it brakes from (set_braking_below); faster, the spring slows it to that first, 0 any
    start_pace: float              // times a start's own pace it goes at most while one plays (set_start_pace), 0 any
    matcher: int                   // the animator's matcher state it asks the way ahead of, -1 none
    follow: bool                   // the figure moved by its clips' root motion, the springs a simulation (set_follow)
    sim: Vec3                      // the simulation's place, following
    wall: Vec3                     // level, unit: the way into a wall its capsule is against (slid), zero for none
}

// A mover for the figure on `o`, played by `a`. Its object starts where it
// stands, facing as it faces.
mover_new(a: *Animator, o: *GameObject) -> *Mover {
    m = heap.new(Mover)
    m.animator = a as ptr
    m.object = o as ptr
    m.half_life = HALF_LIFE
    m.facing_half_life = FACING_HALF_LIFE
    q = behaviour.object_rotation(o)
    ahead = core.quat_apply(q, core.vec3(0.0, 0.0, 1.0))
    m.facing = core.atan2_of(ahead.x, ahead.z)
    m.face_asked = m.facing
    m.matcher = 0 - 1
    return m
}

mover_free(m: *Mover) { if m != null { heap.free(m) } }

set_half_lives(m: *Mover, velocity: float, facing: float) {
    m.half_life = velocity
    m.facing_half_life = facing
}

// The velocity a game asks for, over the ground (its y is not read).
ask(m: *Mover, v: Vec3) { m.asked = core.vec3(v.x, 0.0, v.z) }

// Hold the figure facing `yaw` (strafing) whatever way it goes; `hold`
// false lets it face the way it goes again.
face(m: *Mover, yaw: float, hold: bool) {
    m.face_asked = yaw
    m.strafing = hold
}

velocity(m: *Mover) -> Vec3 { return m.velocity }
facing_of(m: *Mover) -> float { return m.facing }

// --- the springs ----------------------------------------------------------------------------------

damping(half_life: float) -> float { return (4.0 * 0.69314718056) / (half_life + 0.00001) }

// A critically damped spring on a velocity `v` (accelerating at `a`) toward
// `goal`, after `t`: the velocity, the acceleration, and how far it moved.
spring(v: float, a: float, goal: float, half_life: float, t: float) -> (float, float, float) {
    y = damping(half_life) * 0.5
    j0 = v - goal
    j1 = a + j0 * y
    e = exp(0.0 - y * t)
    moved = e * ((0.0 - j1) / (y * y) + (0.0 - j0 - j1 * t) / y) + j1 / (y * y) + j0 / y + goal * t
    return e * (j0 + j1 * t) + goal, e * (a - j1 * y * t), moved
}

wrap(x: float) -> float {
    a = x
    while a > 3.141592653589793 { a = a - 6.283185307179586 }
    while a < 0.0 - 3.141592653589793 { a = a + 6.283185307179586 }
    return a
}

// The facing wanted now: held, or the way the velocity asked goes (kept
// where it is when nothing is asked).
// Moving (facing free, not matching), it faces where it goes, turned toward
// the way asked by CURVE_ARC at most: turned toward the goal as fast as its
// spring went, a body in a sharp turn faced 45 degrees off the way it was
// still going, its gaits half a side step, and its feet crossed (#969).
facing_goal(m: *Mover) -> float { return facing_toward(m, m.asked, m.velocity, m.facing) }

// The same for `asked` asked of a figure going at `velocity`, facing `facing`.
facing_toward(m: *Mover, asked: Vec3, velocity: Vec3, facing: float) -> float {
    if m.strafing { return m.face_asked }
    if core.v3_len(asked) > MOVING {
        way = core.atan2_of(asked.x, asked.z)
        if m.matcher < 0 && core.v3_len(velocity) >= MOVING {
            going = core.atan2_of(velocity.x, velocity.z)
            off = core.clampf(wrap(way - going), 0.0 - CURVE_ARC, CURVE_ARC)
            return going + off
        }
        return way
    }
    return facing
}

// The velocity its springs go toward when `asked` is asked of a figure going
// at `velocity`, facing `facing`, and whether it turns where it stands first
// (`was_turning`: it was): the start's and the curve's rules below.
toward(m: *Mover, asked: Vec3, velocity: Vec3, facing: float, was_turning: bool) -> (Vec3, bool) {
    goal = asked
    turning = false
    // Standing and asked to go off its facing by more than START_ARC: it
    // turns toward the way where it stands first, the velocity held at rest.
    // Once turning, it turns on until it faces within CURVE_ARC of the way,
    // and sets off straight: let off at START_ARC, its first steps were
    // curved 20 degrees across at once, and a foot stepped past the hips'
    // middle walking off a log.
    if !m.strafing && m.matcher < 0 && core.v3_len(velocity) < MOVING && core.v3_len(asked) > MOVING {
        off = wrap(core.atan2_of(asked.x, asked.z) - facing)
        if core.abs_of(off) > START_ARC || (was_turning && core.abs_of(off) > CURVE_ARC) {
            turning = true
            goal = core.vec3(0.0, 0.0, 0.0)
        }
    }
    // Moving and asked off its facing by more than CURVE_ARC: it walks a
    // curve (#969), the way it goes held within CURVE_ARC of the way it
    // faces as the facing turns after it, and slower for a turn past a right
    // angle. Asked off at once, the gaits read a sharp turn as a side or a
    // back step, and a walker turned to a new goal crossed its feet 169 mm;
    // held 30 degrees off, a quarter of its gait was a side step under a
    // turning body, and a runner slowing into the curve crossed 214 mm.
    if !m.strafing && m.matcher < 0 && core.v3_len(velocity) >= MOVING && core.v3_len(goal) > MOVING {
        off = wrap(core.atan2_of(goal.x, goal.z) - facing)
        if core.abs_of(off) > CURVE_ARC {
            way = facing + CURVE_ARC
            if off < 0.0 { way = facing - CURVE_ARC }
            speed = core.v3_len(goal)
            if core.abs_of(off) > 1.5708 { speed = speed * CURVE_SLOW }
            goal = core.vec3(core.sin_of(way) * speed, 0.0, core.cos_of(way) * speed)
        }
    }
    return goal, turning
}

// Where the figure would go over the next `count` steps of `dt` were `v`
// asked from now on: its offsets from where it is over the ground, x and z
// pairs into `out` (2 * count floats), the springs, the start's and the
// curve's rules run ahead and the figure left as it is. What a steering
// weighs a way by (ae3d.character's avoidance, #956): the curve turns a
// walker's way about 20 degrees a second, and a way 30 degrees off taken as
// if at once had two walkers meet while it was still being turned to.
path(m: *Mover, v: Vec3, dt: float, count: int, out: float[]) {
    asked = core.vec3(v.x, 0.0, v.z)
    vel = m.velocity
    acc = m.acceleration
    f = m.facing
    fr = m.facing_rate
    turning = m.turning_first
    x = 0.0
    z = 0.0
    k = 0
    while k < count {
        goal, now_turning = toward(m, asked, vel, f, turning)
        turning = now_turning
        speed = core.v3_len(vel)
        if m.braking > 0.0 && core.v3_len(asked) <= MOVING && speed > 0.0 && (m.brake_below <= 0.0 || speed <= m.brake_below) {
            slower = speed - m.braking * dt
            if slower < 0.0 { slower = 0.0 }
            went = (speed + slower) * 0.5 * dt
            x = x + vel.x / speed * went
            z = z + vel.z / speed * went
            vel = core.v3_mul(vel, slower / speed)
            acc = core.vec3(0.0, 0.0, 0.0)
        } else {
            vx, ax, mx = spring(vel.x, acc.x, goal.x, m.half_life, dt)
            vz, az, mz = spring(vel.z, acc.z, goal.z, m.half_life, dt)
            x = x + mx
            z = z + mz
            vel = core.vec3(vx, 0.0, vz)
            acc = core.vec3(ax, 0.0, az)
        }
        aim = f + wrap(facing_toward(m, asked, vel, f) - f)
        nf, nfr, _turned = spring_angle(f, fr, aim, m.facing_half_life, dt)
        f = wrap(nf)
        fr = nfr
        out[k * 2] = x
        out[k * 2 + 1] = z
        k = k + 1
    }
}

// The same with the velocity asked last kept asked: where the figure goes
// doing as it does, a walker in its curve to a new goal curving on. Read as
// going straight on at its velocity, two walkers each curving round toward
// the other were not seen to meet until 2.3 m apart, and their capsules
// touched.
path_on(m: *Mover, dt: float, count: int, out: float[]) { path(m, m.asked, dt, count, out) }

// One step of `dt`: the springs on, the object moved and turned by them,
// and the graph's parameters written.
step(m: *Mover, dt: float) {
    if dt <= 0.0 { return }
    o = m.object as *GameObject
    dx = 0.0
    dz = 0.0
    // The start's and the curve's rules (toward).
    asked, turning = toward(m, m.asked, m.velocity, m.facing, m.turning_first)
    m.turning_first = turning
    asked = along_wall(m, asked)
    if braking_now(m) {
        // Braking at a constant deceleration along its way, to a stand.
        speed = core.v3_len(m.velocity)
        slower = speed - m.braking * dt
        if slower < 0.0 { slower = 0.0 }
        went = (speed + slower) * 0.5 * dt
        if speed > 0.000001 {
            dx = m.velocity.x / speed * went
            dz = m.velocity.z / speed * went
            m.velocity = core.v3_mul(m.velocity, slower / speed)
        }
        m.acceleration = core.vec3(0.0, 0.0, 0.0)
    } else {
        vx, ax, mx = spring(m.velocity.x, m.acceleration.x, asked.x, m.half_life, dt)
        vz, az, mz = spring(m.velocity.z, m.acceleration.z, asked.z, m.half_life, dt)
        dx = mx
        dz = mz
        was = m.velocity
        m.velocity = core.vec3(vx, 0.0, vz)
        m.acceleration = core.vec3(ax, 0.0, az)
        off_wall(m, dt)
        most = start_most(m)
        speed = core.v3_len(m.velocity)
        if most >= 0.0 && speed > most {
            // Kept to the start's pace: on at it, its spring going on from there.
            m.velocity = core.v3_mul(m.velocity, most / speed)
            m.acceleration = core.v3_mul(core.v3_sub(m.velocity, was), 1.0 / dt)
            dx = (was.x + m.velocity.x) * 0.5 * dt
            dz = (was.z + m.velocity.z) * 0.5 * dt
        }
    }
    // The facing: a spring on the angle, toward the nearer way round.
    goal = m.facing + wrap(facing_goal(m) - m.facing)
    f, fr, _turned = spring_angle(m.facing, m.facing_rate, goal, m.facing_half_life, dt)
    m.facing = wrap(f)
    m.facing_rate = fr
    // The way come since it last stood still, a start's distance.
    if core.v3_len(m.velocity) < MOVING && core.v3_len(m.asked) < MOVING {
        m.travelled = 0.0
    } else {
        m.travelled = m.travelled + core.sqrt_of(dx * dx + dz * dz)
    }
    if m.follow {
        m.sim = core.vec3(m.sim.x + dx, m.sim.y, m.sim.z + dz)
        adjust(m, dt)
    } else {
        // A figure with a character controller (physics.character_controller)
        // is moved by its capsule, as Unity's CharacterController.Move: a
        // wall stops it, a stair or a kerb lifts it, gravity keeps it on the
        // ground. One with none is set where the springs put it.
        at = behaviour.object_position(o)
        capsule = physics.character_of(o)
        if capsule != null && dt > 0.0 {
            physics.character_move(capsule, core.vec3(dx / dt, 0.0, dz / dt), 0.0, dt)
            slid(m, core.vec3(dx, 0.0, dz), core.v3_sub(behaviour.object_position(o), at))
        } else {
            behaviour.object_set_position(o, core.vec3(at.x + dx, at.y, at.z + dz))
        }
        behaviour.object_set_rotation(o, core.quat_rotate(m.facing, core.vec3(0.0, 1.0, 0.0)))
    }
    feed(m)
}

// A wall (#977). The capsule's move against the springs' (`planned`, over
// the ground), as it `went`: held back by more than SLID_OFF of the move
// (and SLID_LEAST), by a wall or a solid neighbour, the way into what held
// it is kept (m.wall), and while the capsule is still against it
// (along_wall) what is asked goes along it, not into it, and the springs'
// velocity into it eases off over WALL_HALF_LIFE (off_wall): the velocity
// the graph plays is the one the capsule really has, as Unity's
// CharacterController and UE's CharacterMovement give it. Kept at what was
// asked, a walker run along a wall's face slid sideways at 2 m/s while its
// graph played a run straight into the wall, its locked feet dragged across
// under it: crossed 263 mm, a toe thrown 7.4 m/s past its clip. Cut at
// once, the velocity into the wall dropped 1.6 m/s in a step, and a forearm
// turned 55 rad/s.
const SLID_OFF = 0.1
const SLID_LEAST = 0.0005
const WALL_HALF_LIFE = 0.08
// Metres into the wall a capsule is tried at to find it still there.
const WALL_PROBE = 0.02
slid(m: *Mover, planned: Vec3, went: Vec3) {
    blocked = core.vec3(planned.x - went.x, 0.0, planned.z - went.z)
    gone = core.v3_len(blocked)
    if gone < SLID_LEAST || gone < SLID_OFF * core.v3_len(planned) { return }
    m.wall = core.v3_mul(blocked, 1.0 / gone)
    pushing = core.v3_dot(m.acceleration, m.wall)
    if pushing > 0.0 { m.acceleration = core.v3_sub(m.acceleration, core.v3_mul(m.wall, pushing)) }
}

// `asked` with nothing into the wall the capsule is against; the wall let
// go of once a move WALL_PROBE into it is no longer held back.
along_wall(m: *Mover, asked: Vec3) -> Vec3 {
    if core.v3_len(m.wall) < 0.5 { return asked }
    capsule = physics.character_of(m.object as *GameObject)
    if capsule == null || m.follow {
        m.wall = core.vec3(0.0, 0.0, 0.0)
        return asked
    }
    free = physics.character_reach(capsule, core.v3_mul(m.wall, WALL_PROBE))
    if core.v3_len(free) > WALL_PROBE * 0.5 {
        m.wall = core.vec3(0.0, 0.0, 0.0)
        return asked
    }
    into = core.v3_dot(asked, m.wall)
    if into <= 0.0 { return asked }
    return core.v3_sub(asked, core.v3_mul(m.wall, into))
}

// The springs' velocity into the wall eased off, `dt` seconds of it.
off_wall(m: *Mover, dt: float) {
    if core.v3_len(m.wall) < 0.5 { return }
    into = core.v3_dot(m.velocity, m.wall)
    if into <= 0.0 { return }
    kept = exp(0.0 - 0.69314718056 * dt / WALL_HALF_LIFE)
    m.velocity = core.v3_sub(m.velocity, core.v3_mul(m.wall, into * (1.0 - kept)))
}

// The figure moved by its clips' own root motion (the animator's), the
// springs a simulation of where it should be (Holden's, for motion
// matching: a clip played at its own speed and way keeps its feet; moved
// by the springs, a matched clip's feet skated a third of a metre and the
// lock let them go). Each step the figure is eased toward the simulation
// (half-life ADJUST_HALF_LIFE, at most ADJUST_MOST metres a second over its
// own motion, the planted feet's lock taking it up) and turned toward its
// facing; the simulation is kept within CLAMP of the figure.
set_follow(m: *Mover, on: bool) {
    o = m.object as *GameObject
    m.follow = on
    m.sim = behaviour.object_position(o)
    animator.set_root_motion(m.animator as *Animator, on)
}

adjust(m: *Mover, dt: float) {
    o = m.object as *GameObject
    at = behaviour.object_position(o)
    dx = m.sim.x - at.x
    dz = m.sim.z - at.z
    share = 1.0 - exp(0.0 - 0.69314718056 * dt / ADJUST_HALF_LIFE)
    mx = dx * share
    mz = dz * share
    far = core.sqrt_of(mx * mx + mz * mz)
    if far > ADJUST_MOST * dt {
        mx = mx * ADJUST_MOST * dt / far
        mz = mz * ADJUST_MOST * dt / far
    }
    at = core.vec3(at.x + mx, at.y, at.z + mz)
    behaviour.object_set_position(o, at)
    // Its facing: turned toward the simulation's, the same share.
    q = behaviour.object_rotation(o)
    ahead = core.quat_apply(q, core.vec3(0.0, 0.0, 1.0))
    yaw = core.atan2_of(ahead.x, ahead.z)
    turn = wrap(m.facing - yaw) * share
    behaviour.object_set_rotation(o, core.quat_normalize(core.quat_mul(core.quat_rotate(turn, core.vec3(0.0, 1.0, 0.0)), q)))
    // The simulation kept near the figure.
    ox = m.sim.x - at.x
    oz = m.sim.z - at.z
    gap = core.sqrt_of(ox * ox + oz * oz)
    if gap > CLAMP {
        m.sim = core.vec3(at.x + ox * CLAMP / gap, m.sim.y, at.z + oz * CLAMP / gap)
    }
}

// The springs at rest where the figure's object stands, facing as it
// faces, asking nothing: after something else has moved it (a seat's
// warped enter and exit, ae3d.character's use). Stepped on from where they
// were, the springs turned the figure back to the way it faced before.
settle(m: *Mover) {
    o = m.object as *GameObject
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    m.facing = core.atan2_of(ahead.x, ahead.z)
    m.facing_rate = 0.0
    m.face_asked = m.facing
    m.strafing = false
    m.velocity = core.vec3(0.0, 0.0, 0.0)
    m.acceleration = core.vec3(0.0, 0.0, 0.0)
    m.asked = core.vec3(0.0, 0.0, 0.0)
    m.travelled = 0.0
    m.sim = behaviour.object_position(o)
    m.wall = core.vec3(0.0, 0.0, 0.0)
}

// The springs at rest going at `velocity` (the world's, over the ground)
// where the figure's object stands, facing the way it goes, and asked to go
// on so: a figure handed over walking (a crowd's, ae3d.animlod) goes on at
// the pace it had, where settled at a stand it would have stopped and
// started again. The graph's parameters written at once, for the frame it
// is handed over in.
settle_moving(m: *Mover, velocity: Vec3) {
    settle(m)
    v = core.vec3(velocity.x, 0.0, velocity.z)
    m.velocity = v
    m.asked = v
    if core.v3_len(v) > MOVING {
        m.facing = core.atan2_of(v.x, v.z)
        m.face_asked = m.facing
        // Under way: well past any start's distance.
        m.travelled = 1000.0
    }
    feed(m)
}

// Where the simulation is: the figure's object, unless the figure follows
// its clips (set_follow).
sim_at(m: *Mover) -> Vec3 {
    if m.follow { return m.sim }
    return behaviour.object_position(m.object as *GameObject)
}

// The angle spring: the angle itself goes to `goal` critically damped.
spring_angle(x: float, v: float, goal: float, half_life: float, dt: float) -> (float, float, float) {
    y = damping(half_life) * 0.5
    j0 = x - goal
    j1 = v + j0 * y
    e = exp(0.0 - y * dt)
    return e * (j0 + j1 * dt) + goal, e * (v - j1 * y * dt), 0.0
}

// The graph's parameters, from the springs.
feed(m: *Mover) {
    a = m.animator as *Animator
    c = core.cos_of(m.facing)
    s = core.sin_of(m.facing)
    // Ahead is (sin f, cos f); the figure's left is (cos f, -sin f).
    ahead = m.velocity.x * s + m.velocity.z * c
    across = m.velocity.x * c - m.velocity.z * s
    speed = core.v3_len(m.velocity)
    animator.set_float(a, "vx", across)
    animator.set_float(a, "vz", ahead)
    animator.set_float(a, "speed", speed)
    asking = core.v3_len(m.asked) > MOVING && !m.turning_first
    animator.set_bool(a, "moving", speed > MOVING || asking)
    animator.set_float(a, "turning", m.facing_rate)
    animator.set_float(a, "rest", rest_distance(m))
    animator.set_float(a, "travelled", m.travelled)
    animator.set_bool(a, "go", asking)
    if m.matcher >= 0 { ask_matcher(m) }
}

// Where the springs take the figure `t` seconds on, from where it is: its
// offset over the ground (the world's x and z) and its facing then. What
// motion matching asks a clip's way ahead to match.
future(m: *Mover, t: float) -> (Vec3, float) {
    _vx, _ax, dx = spring(m.velocity.x, m.acceleration.x, m.asked.x, m.half_life, t)
    _vz, _az, dz = spring(m.velocity.z, m.acceleration.z, m.asked.z, m.half_life, t)
    goal = m.facing + wrap(facing_goal(m) - m.facing)
    f, _fr, _x = spring_angle(m.facing, m.facing_rate, goal, m.facing_half_life, t)
    return core.vec3(dx, 0.0, dz), wrap(f)
}

// Where the figure comes to rest if nothing more is asked: braking, v²/2a
// along its way; on the spring, the spring's end. What a stop is played
// toward.
rest_point(m: *Mover) -> Vec3 {
    at = sim_at(m)
    speed = core.v3_len(m.velocity)
    if m.braking > 0.0 && (m.brake_below <= 0.0 || speed <= m.brake_below) {
        if speed < 0.000001 { return at }
        far = speed * speed / (2.0 * m.braking)
        return core.vec3(at.x + m.velocity.x / speed * far, at.y, at.z + m.velocity.z / speed * far)
    }
    // The spring's total travel to rest from v, a toward 0: j0/y + j1/y^2.
    y = damping(m.half_life) * 0.5
    jx = m.velocity.x
    jz = m.velocity.z
    kx = m.acceleration.x + jx * y
    kz = m.acceleration.z + jz * y
    rest = core.vec3(at.x + jx / y + kx / (y * y), at.y, at.z + jz / y + kz / (y * y))
    // Faster than it brakes from: the spring down to that speed, then the
    // braking, which goes further than the spring's last stretch (2 v / y,
    // from rest acceleration) by what is between them.
    if m.braking > 0.0 && speed > 0.000001 {
        v = m.brake_below
        more = v * v / (2.0 * m.braking) - 2.0 * v / y
        if more > 0.0 { rest = core.vec3(rest.x + m.velocity.x / speed * more, rest.y, rest.z + m.velocity.z / speed * more) }
    }
    return rest
}

// The distance to rest_point over the ground.
rest_distance(m: *Mover) -> float {
    at = sim_at(m)
    p = rest_point(m)
    return core.sqrt_of((p.x - at.x) * (p.x - at.x) + (p.z - at.z) * (p.z - at.z))
}

// With nothing asked, slow at `deceleration` metres a second a second to a
// stand, the way Unreal's movement brakes (0: the velocity's spring brings
// it to rest). Set from a stop take's own (clips.braking), the figure comes
// to rest over the distance the take does, and the stop played by the
// distance left enters where its feet are in the stride the figure's are:
// on the spring, a walk at 0.8 m/s came to rest in 0.3 m where the capture's
// actor took a metre, and the stop entered on its last half step.
set_braking(m: *Mover, deceleration: float) { m.braking = deceleration }

// And brake so only from `speed` down (0: from any speed); faster, the
// velocity's spring slows it to that first, as a run slows to a walk before
// it stops. A walk's stop's braking (0.41 m/s^2) taken from a run at 3 m/s
// left a figure still going 1.35 m/s 4 s after it was let go.
set_braking_below(m: *Mover, speed: float) { m.brake_below = speed }

// While its animator plays a start by the distance come (animator.clock_by,
// clock_pace), the figure goes no faster than `most` times that take's own
// pace where it is (0: as the springs go): a start set off at its own pace,
// as a stop brakes at its own (set_braking), so its distance clock keeps to
// real time. On the springs alone the figure outran the people's StartStop
// start from its move-off, its clock running up to twice its pace and a
// ball turning 18 rad/s against the takes' own fastest 14.9 (#937).
set_start_pace(m: *Mover, most: float) { m.start_pace = most }

// The fastest the figure may go now (set_start_pace), -1 any.
start_most(m: *Mover) -> float {
    if m.start_pace <= 0.0 || m.animator == null { return 0.0 - 1.0 }
    pace = animator.clock_pace(m.animator as *Animator)
    if pace < 0.0 { return 0.0 - 1.0 }
    return pace * m.start_pace
}

braking_now(m: *Mover) -> bool {
    speed = core.v3_len(m.velocity)
    if m.brake_below > 0.0 && speed > m.brake_below { return false }
    return m.braking > 0.0 && core.v3_len(m.asked) <= MOVING && speed > 0.0
}

// The animator's matcher `state` asked, every step, for the way ahead the
// springs predict (its place and facing a third, two thirds and a whole
// second on, in the figure's frame now).
set_matcher(m: *Mover, state: int) { m.matcher = state }

ask_matcher(m: *Mover) {
    a = m.animator as *Animator
    // From the figure as it stands (following its clips, it is not where
    // the simulation is): the simulation's way ahead in the figure's frame.
    o = m.object as *GameObject
    at = behaviour.object_position(o)
    sim = sim_at(m)
    ahead_now = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    yaw = core.atan2_of(ahead_now.x, ahead_now.z)
    c = core.cos_of(yaw)
    s = core.sin_of(yaw)
    ahead = [0.33, 0.67, 1.0]
    k = 0
    while k < 3 {
        offset, facing = future(m, ahead[k])
        px = sim.x + offset.x - at.x
        pz = sim.z + offset.z - at.z
        // Ahead is (sin f, cos f); the figure's left is (cos f, -sin f).
        x = px * c - pz * s
        z = px * s + pz * c
        animator.match_trajectory(a, m.matcher, k, x, z, wrap(facing - yaw))
        k = k + 1
    }
}
