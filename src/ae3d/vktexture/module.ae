// ae3d.vktexture -- the Vulkan backend's textures (#402), on
// contrib.vulkan.vk: made, and the table a draw binds them from by handle.
//
// Three kinds, as the renderer asks for them:
//
//   - a scene texture (a model's image): RGBA bytes, with a mip chain --
//     each level a filtered halving of the one above, as glGenerateMipmap
//     builds, since minification without mips is what separates a sharp
//     distant surface from an aliased one -- where the format can be
//     filtered, and sampled with the frame's LOD bias;
//   - an RGBA texture of two dimensions or three (the clouds' weather and
//     their tileable noise): linear, repeating, no mips;
//   - a float texture, four floats a texel (a pose bank): fetched by exact
//     texel, so nearest and clamped;
//   - a table, two half floats a texel (the sky light's split-sum table):
//     read between its entries, so linear, and clamped at its edges.
//
// This module makes the image, its memory and its view, stages the texels
// through a host buffer (ae3d.vkhost's) and records the upload, the mip
// chain and the layout changes into a one-off command buffer (ae3d.vkhost's)
// submitted and waited on, then puts it in the table (adopt), which gives it
// its sampler and a handle. The targets the frame draws into and a later
// pass samples go in the same table (adopt_target), so a set binds them as
// it binds any texture.

import std.list
import contrib.vulkan.vk
import ae3d.vkdevice
import ae3d.vkhost
import ae3d.core

exports (
    SCENE, RGBA, FLOATS, TABLE,
    texture_create, texture_create_rgba, texture_create_float, texture_create_table, mip_chain,
    valid, view, sampler_of, image_of, memory_of, width_of, height_of, mean_of, adopt, adopt_target, destroy, rebias, clear,
    update_in_frame, update_region_in_frame, collect_slot
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern memset(p: ptr, value: int, n: long) -> ptr

// The kinds, as adopt takes them: which sampler it gets.
const SCENE = 0
const RGBA = 1
const FLOATS = 2
const TABLE = 3

// What an image was made into: its handles, or nulls when it could not be.
struct Made {
    image: ptr                       // VkImage
    memory: ptr                      // VkDeviceMemory
    view: ptr                        // VkImageView
}

// A device-local image, sampled and written to by copies (and read from by
// blits, for a mip chain), of `depth` layers of depth -- three dimensions
// past one -- and `levels` mip levels, with a view of all of it. Nulls
// when the device would not make it; nothing is left behind then.
make_image(width: int, height: int, depth: int, levels: int, format: int, readable: bool) -> Made {
    d = vkhost.device()
    out = Made { image: null, memory: null, view: null }
    ci = calloc(1, sizeof(VkImageCreateInfo)) as *VkImageCreateInfo
    ci.sType = vk.STRUCTURE_TYPE_IMAGE_CREATE_INFO
    ci.imageType = vk.IMAGE_TYPE_2D
    if depth > 1 { ci.imageType = vk.IMAGE_TYPE_3D }
    ci.format = format
    ci.extent.width = width
    ci.extent.height = height
    ci.extent.depth = depth
    ci.mipLevels = levels
    ci.arrayLayers = 1
    ci.samples = vk.SAMPLE_COUNT_1_BIT
    ci.tiling = vk.IMAGE_TILING_OPTIMAL
    ci.usage = vk.IMAGE_USAGE_TRANSFER_DST_BIT | vk.IMAGE_USAGE_SAMPLED_BIT
    if readable { ci.usage = ci.usage | vk.IMAGE_USAGE_TRANSFER_SRC_BIT }
    ci.sharingMode = vk.SHARING_MODE_EXCLUSIVE
    ci.initialLayout = vk.IMAGE_LAYOUT_UNDEFINED
    handle = calloc(1, 8)
    r = vk.vkCreateImage(d, ci as ptr, null, handle)
    free(ci as ptr)
    if r != vk.SUCCESS {
        free(handle)
        return out
    }
    out.image = (handle as ptr[])[0]
    needs = calloc(1, sizeof(VkMemoryRequirements)) as *VkMemoryRequirements
    vk.vkGetImageMemoryRequirements(d, out.image, needs as ptr)
    out.memory = vkhost.allocate(needs, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
    free(needs as ptr)
    if out.memory == null {
        vk.vkDestroyImage(d, out.image, null)
        free(handle)
        return Made { image: null, memory: null, view: null }
    }
    vk.vkBindImageMemory(d, out.image, out.memory, 0)
    vi = calloc(1, sizeof(VkImageViewCreateInfo)) as *VkImageViewCreateInfo
    vi.sType = vk.STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
    vi.image = out.image
    vi.viewType = vk.IMAGE_VIEW_TYPE_2D
    if depth > 1 { vi.viewType = vk.IMAGE_VIEW_TYPE_3D }
    vi.format = format
    vi.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    vi.subresourceRange.levelCount = levels
    vi.subresourceRange.layerCount = 1
    (handle as ptr[])[0] = null
    r = vk.vkCreateImageView(d, vi as ptr, null, handle)
    free(vi as ptr)
    if r != vk.SUCCESS {
        vk.vkDestroyImage(d, out.image, null)
        vk.vkFreeMemory(d, out.memory, null)
        free(handle)
        return Made { image: null, memory: null, view: null }
    }
    out.view = (handle as ptr[])[0]
    free(handle)
    return out
}

// A layout change of `count` levels of `image` from `base`.
turn(commands: ptr, image: ptr, from: int, to: int, src_access: int, dst_access: int, src_stage: int, dst_stage: int,
     base: int, count: int) {
    b = calloc(1, sizeof(VkImageMemoryBarrier)) as *VkImageMemoryBarrier
    b.sType = vk.STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
    b.oldLayout = from
    b.newLayout = to
    b.srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.image = image
    b.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    b.subresourceRange.baseMipLevel = base
    b.subresourceRange.levelCount = count
    b.subresourceRange.layerCount = 1
    b.srcAccessMask = src_access
    b.dstAccessMask = dst_access
    vk.vkCmdPipelineBarrier(commands, src_stage, dst_stage, 0, 0, null, 0, null, 1, b as ptr)
    free(b as ptr)
}

// The staged texels into level 0 of the image.
copy_in(commands: ptr, staging: *HostBuffer, image: ptr, width: int, height: int, depth: int) {
    region = calloc(1, sizeof(VkBufferImageCopy)) as *VkBufferImageCopy
    region.imageSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.imageSubresource.layerCount = 1
    region.imageExtent.width = width
    region.imageExtent.height = height
    region.imageExtent.depth = depth
    vk.vkCmdCopyBufferToImage(commands, staging.buffer, image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, region as ptr)
    free(region as ptr)
}

// VkImageBlit's layout: a subresource, two offsets, a subresource, two
// offsets; the far corner of each pair is its second offset.
offset_of_src_far() -> int { return sizeof(VkImageSubresourceLayers) + sizeof(VkOffset3D) }
offset_of_dst_far() -> int { return 2 * sizeof(VkImageSubresourceLayers) + 3 * sizeof(VkOffset3D) }

// Each level a filtered halving of the one above, and every level left
// readable by the shaders: level 0 arrives written by the copy, every
// level in transfer-destination layout.
// Each level below the first a filtered halving of the one above, by blits
// recorded into `commands`: every level in transfer-destination layout
// first, all of them shader-readable after.
mip_chain(commands: ptr, image: ptr, width: int, height: int, levels: int) {
    w = width
    h = height
    level = 1
    while level < levels {
        nw = w
        if w > 1 { nw = w / 2 }
        nh = h
        if h > 1 { nh = h / 2 }
        turn(commands, image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
             vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_TRANSFER_READ_BIT,
             vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, level - 1, 1)
        blit = calloc(1, sizeof(VkImageBlit)) as *VkImageBlit
        blit.srcSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
        blit.srcSubresource.mipLevel = level - 1
        blit.srcSubresource.layerCount = 1
        blit.dstSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
        blit.dstSubresource.mipLevel = level
        blit.dstSubresource.layerCount = 1
        far_src = (blit as ptr + offset_of_src_far()) as *VkOffset3D
        far_src.x = w
        far_src.y = h
        far_src.z = 1
        far_dst = (blit as ptr + offset_of_dst_far()) as *VkOffset3D
        far_dst.x = nw
        far_dst.y = nh
        far_dst.z = 1
        vk.vkCmdBlitImage(commands, image, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, image,
                          vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, blit as ptr, vk.FILTER_LINEAR)
        free(blit as ptr)
        turn(commands, image, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
             vk.ACCESS_TRANSFER_READ_BIT, vk.ACCESS_SHADER_READ_BIT,
             vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, level - 1, 1)
        w = nw
        h = nh
        level = level + 1
    }
    turn(commands, image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
         vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_SHADER_READ_BIT,
         vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, levels - 1, 1)
}

// Whether RGBA bytes can be filtered in the device's optimal tiling: what a
// blitted mip chain needs.
filterable(format: int) -> bool {
    props = calloc(1, sizeof(VkFormatProperties)) as *VkFormatProperties
    vk.vkGetPhysicalDeviceFormatProperties(vkdevice.physical(), format, props as ptr)
    ok = ((props.optimalTilingFeatures) as int & vk.FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT) != 0
    free(props as ptr)
    return ok
}

// A texture from `bytes` bytes of texels at `texels`, of a format and a
// kind, made, uploaded and adopted: its handle, or 0.
upload(width: int, height: int, depth: int, texels: ptr, bytes: int, format: int, levels: int, kind: int) -> int {
    if width <= 0 || height <= 0 || depth <= 0 || texels == null { return 0 }
    vkhost.device()
    staging = vkhost.upload_buffer(bytes)
    if staging == null { return 0 }
    memcpy(staging.mapped, texels, bytes as long)
    made = make_image(width, height, depth, levels, format, levels > 1)
    if made.image == null {
        vkhost.host_buffer_free(staging)
        return 0
    }
    commands = vkhost.once_begin()
    // Every level to transfer-destination, not only the one the copy
    // writes: the chain's blits write the rest, and a level still undefined
    // when it was blitted into was hundreds of the validation layer's
    // errors (#405).
    turn(commands, made.image, vk.IMAGE_LAYOUT_UNDEFINED, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
         0, vk.ACCESS_TRANSFER_WRITE_BIT, vk.PIPELINE_STAGE_TOP_OF_PIPE_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, levels)
    copy_in(commands, staging, made.image, width, height, depth)
    if kind == SCENE {
        mip_chain(commands, made.image, width, height, levels)
    } else {
        turn(commands, made.image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
             vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_SHADER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT,
             vk.PIPELINE_STAGE_VERTEX_SHADER_BIT | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 1)
    }
    vkhost.once_end(commands)
    vkhost.host_buffer_free(staging)
    return adopt(made.image, made.memory, made.view, width, height, levels, kind)
}

// A scene texture from RGBA bytes, with its mip chain where the format can
// be filtered: sRGB when the bytes are a colour (`srgb`), so a sample -- and
// every mip level, filtered as light -- is the colour's light; the bytes as
// they are when they are data.
texture_create(width: int, height: int, rgba: ptr, srgb: bool) -> int {
    format = vk.FORMAT_R8G8B8A8_UNORM
    if srgb { format = vk.FORMAT_R8G8B8A8_SRGB }
    levels = 1
    if filterable(format) {
        extent = width
        if height > extent { extent = height }
        while extent > 1 {
            extent = extent / 2
            levels = levels + 1
        }
    }
    handle = upload(width, height, 1, rgba, width * height * 4, format, levels, SCENE)
    if handle != 0 && srgb { slot_at(handle).mean = texel_mean(width, height, rgba) }
    return handle
}

// The mean light of sRGB bytes, each texel weighed by its cover (alpha), so
// a cut-out leaf's transparent texels do not tint it: from a grid of at
// most 64 by 64 of them, what the probes' rays take a surface's colour as
// (ae3d.vkddgi).
texel_mean(width: int, height: int, rgba: ptr) -> Vec3 {
    bytes = rgba as uint8[]
    step_x = (width + 63) / 64
    step_y = (height + 63) / 64
    r = 0.0
    g = 0.0
    b = 0.0
    cover = 0.0
    y = step_y / 2
    while y < height {
        x = step_x / 2
        while x < width {
            at = (y * width + x) * 4
            a = (bytes[at + 3] as float) / 255.0
            r = r + core.srgb_decode_of((bytes[at] as float) / 255.0) * a
            g = g + core.srgb_decode_of((bytes[at + 1] as float) / 255.0) * a
            b = b + core.srgb_decode_of((bytes[at + 2] as float) / 255.0) * a
            cover = cover + a
            x = x + step_x
        }
        y = y + step_y
    }
    if cover <= 0.0 { return core.vec3(1.0, 1.0, 1.0) }
    return core.vec3(r / cover, g / cover, b / cover)
}

// RGBA bytes of two dimensions or, with `depth` past one, three: linear,
// repeating, no mips.
texture_create_rgba(width: int, height: int, depth: int, rgba: ptr) -> int {
    return upload(width, height, depth, rgba, width * height * depth * 4, vk.FORMAT_R8G8B8A8_UNORM, 1, RGBA)
}

// Four floats a texel, fetched by exact texel.
texture_create_float(width: int, height: int, rgba: ptr) -> int {
    return upload(width, height, 1, rgba, width * height * 16, vk.FORMAT_R32G32B32A32_SFLOAT, 1, FLOATS)
}

// Two half floats a texel (their bits, `halves` int16 pairs), read between
// entries and clamped: a table.
texture_create_table(width: int, height: int, halves: ptr) -> int {
    return upload(width, height, 1, halves, width * height * 4, vk.FORMAT_R16G16_SFLOAT, 1, TABLE)
}

// --- textures written again, in the frame (#544) ---

// A texture's level-0 texels replaced in place, recorded into `commands`
// -- a frame's command buffer, ahead of its passes, outside any render
// pass -- so the frames still in flight finish reading the old texels and
// the next pass reads the new: the barriers order the copy after every
// earlier read on the queue, and the passes after it. No wait on the
// device, which a texture remade on every hit would cost. The staging
// buffer goes when this frame slot comes round again (`collect_slot`,
// called once the slot's fence has passed). An RGBA texture of one level:
// a damage mask.
const UPDATE_SLOTS = 4

var g_updates: ptr = null          // ptr[UPDATE_SLOTS]: a list of *HostBuffer a slot

// The list of a slot's staging buffers, made the first time.
staged(slot: int) -> ptr {
    if g_updates == null { g_updates = calloc(UPDATE_SLOTS, 8) }
    l = (g_updates as ptr[])[slot]
    if l == null {
        l = list.new()
        (g_updates as ptr[])[slot] = l
    }
    return l
}

update_in_frame(handle: int, rgba: ptr, commands: ptr, slot: int) -> bool {
    if !valid(handle) || rgba == null || commands == null || slot < 0 || slot >= UPDATE_SLOTS { return false }
    t = slot_at(handle)
    bytes = t.width * t.height * 4
    staging = vkhost.upload_buffer(bytes)
    if staging == null { return false }
    memcpy(staging.mapped, rgba, bytes as long)
    turn(commands, t.image, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
         vk.ACCESS_SHADER_READ_BIT, vk.ACCESS_TRANSFER_WRITE_BIT,
         vk.PIPELINE_STAGE_VERTEX_SHADER_BIT | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1)
    copy_in(commands, staging, t.image, t.width, t.height, 1)
    turn(commands, t.image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
         vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_SHADER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT,
         vk.PIPELINE_STAGE_VERTEX_SHADER_BIT | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 1)
    list.add_raw(staged(slot), staging as ptr)
    return true
}

// A `width` x `height` region of a texture's level 0, at `x`, `y`,
// written from tightly packed RGBA in the frame, as update_in_frame writes
// the whole: a damage mask's cell of its atlas page (#560).
update_region_in_frame(handle: int, rgba: ptr, x: int, y: int, width: int, height: int, commands: ptr, slot: int) -> bool {
    if !valid(handle) || rgba == null || commands == null || slot < 0 || slot >= UPDATE_SLOTS { return false }
    if width <= 0 || height <= 0 { return false }
    t = slot_at(handle)
    if x < 0 || y < 0 || x + width > t.width || y + height > t.height { return false }
    bytes = width * height * 4
    staging = vkhost.upload_buffer(bytes)
    if staging == null { return false }
    memcpy(staging.mapped, rgba, bytes as long)
    turn(commands, t.image, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
         vk.ACCESS_SHADER_READ_BIT, vk.ACCESS_TRANSFER_WRITE_BIT,
         vk.PIPELINE_STAGE_VERTEX_SHADER_BIT | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1)
    region = calloc(1, sizeof(VkBufferImageCopy)) as *VkBufferImageCopy
    region.imageSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.imageSubresource.layerCount = 1
    region.imageOffset.x = x
    region.imageOffset.y = y
    region.imageExtent.width = width
    region.imageExtent.height = height
    region.imageExtent.depth = 1
    vk.vkCmdCopyBufferToImage(commands, staging.buffer, t.image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, region as ptr)
    free(region as ptr)
    turn(commands, t.image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
         vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_SHADER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT,
         vk.PIPELINE_STAGE_VERTEX_SHADER_BIT | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 1)
    list.add_raw(staged(slot), staging as ptr)
    return true
}

// The staging buffers a frame slot's updates copied from, freed: its
// fence has passed, so the copies are done.
collect_slot(slot: int) {
    if g_updates == null || slot < 0 || slot >= UPDATE_SLOTS { return }
    l = (g_updates as ptr[])[slot]
    if l == null { return }
    i = 0
    while i < list.size(l) {
        vkhost.host_buffer_free(list.get_raw(l, i) as *HostBuffer)
        i = i + 1
    }
    list.clear(l)
}

// --- the table ---------------------------------------------------------------------------------------------------

// The textures a draw binds by handle, slot + 1: 256 at first, twice as
// many each time a scene makes one more than the table holds (#725). At 256
// a texture asked for past them was never made, and its model drew with the
// default one. A scene texture keeps its mip levels, which its sampler reads
// with the frame's LOD bias.
const MAX_TEXTURES = 256

struct VKTexture {
    image: ptr
    memory: ptr
    view: ptr
    sampler: ptr
    width: int
    height: int
    in_use: bool
    mip_levels: int                  // a scene texture with a mip chain: its sampler takes the LOD bias
    mean: Vec3                       // a colour texture's mean light, by its texels' cover (white for data)
}

var g_table: ptr = null            // VKTexture[g_room]
var g_room = MAX_TEXTURES
var g_bias = 0.0                   // the scene textures' mip bias for the render scale

slot_at(handle: int) -> *VKTexture { return (g_table + (handle - 1) * sizeof(VKTexture)) as *VKTexture }

table() {
    if g_table == null {
        g_room = MAX_TEXTURES
        g_table = calloc(g_room, sizeof(VKTexture))
    }
}

// Whether `handle` names a texture there is.
valid(handle: int) -> bool {
    return g_table != null && handle >= 1 && handle <= g_room && slot_at(handle).in_use
}

// A texture's view, sampler, image, memory and size, for what binds or
// reads it. Null and 0 for a handle that names none.
view(handle: int) -> ptr {
    if !valid(handle) { return null }
    return slot_at(handle).view
}
sampler_of(handle: int) -> ptr {
    if !valid(handle) { return null }
    return slot_at(handle).sampler
}
image_of(handle: int) -> ptr {
    if !valid(handle) { return null }
    return slot_at(handle).image
}
memory_of(handle: int) -> ptr {
    if !valid(handle) { return null }
    return slot_at(handle).memory
}
width_of(handle: int) -> int {
    if !valid(handle) { return 0 }
    return slot_at(handle).width
}
// What texture_create measured of a colour texture: its mean light; white
// for data, a target, or no texture.
mean_of(handle: int) -> Vec3 {
    if !valid(handle) { return core.vec3(1.0, 1.0, 1.0) }
    return slot_at(handle).mean
}

height_of(handle: int) -> int {
    if !valid(handle) { return 0 }
    return slot_at(handle).height
}

// The first free slot's handle; the table grown when it is full, its
// handles kept (#725).
free_handle() -> int {
    table()
    h = 1
    while h <= g_room {
        if !slot_at(h).in_use { return h }
        h = h + 1
    }
    room = g_room * 2
    grown = calloc(room, sizeof(VKTexture))
    if grown == null { return 0 }
    memcpy(grown, g_table, (g_room * sizeof(VKTexture)) as long)
    free(g_table)
    g_table = grown
    first = g_room + 1
    g_room = room
    return first
}

// A scene texture's sampler, with the mip chain and the LOD bias of the
// moment: the scene drawn smaller than the frame for an upscaler picks a
// coarser mip than the frame's pixels deserve, and the detail lost there
// is detail the upscaler never gets to reconstruct; the bias, log2 of the
// scale, keeps the mip the frame's own. Remade for every texture when the
// scale changes (rebias).
scene_sampler(t: *VKTexture) -> bool {
    if t.sampler != null {
        vk.vkDestroySampler(vkhost.device(), t.sampler, null)
        t.sampler = null
    }
    t.sampler = vkhost.sampler(vk.FILTER_LINEAR, vk.SAMPLER_ADDRESS_MODE_REPEAT, vk.SAMPLER_MIPMAP_MODE_LINEAR,
                               t.mip_levels as float, g_bias)
    if t.sampler == null {
        vkdevice.fail("vkCreateSampler failed")
        return false
    }
    return true
}

// An image this module made -- uploaded and left readable by the shaders
// -- into the table, with the sampler its kind is drawn with: a scene
// texture's linear, repeating, over its mip chain at the frame's LOD bias;
// an RGBA one's linear and repeating with no mips; a float one's nearest
// and clamped, fetched by exact texel. The handle, or 0 when the table is
// full or the sampler would not make, the image then destroyed.
adopt(image: ptr, memory: ptr, view: ptr, width: int, height: int, mip_levels: int, kind: int) -> int {
    handle = free_handle()
    made = vkhost.VKImage { image: image, memory: memory, view: view }
    if handle == 0 {
        vkdevice.fail("texture table full")
        vkhost.image_free(made)
        return 0
    }
    t = slot_at(handle)
    memset(t as ptr, 0, sizeof(VKTexture) as long)
    t.image = image
    t.memory = memory
    t.view = view
    t.width = width
    t.height = height
    t.mean = core.vec3(1.0, 1.0, 1.0)
    if kind == SCENE {
        t.mip_levels = mip_levels
        if !scene_sampler(t) {
            vkhost.image_free(made)
            memset(t as ptr, 0, sizeof(VKTexture) as long)
            return 0
        }
    } else {
        filter = vk.FILTER_LINEAR
        address = vk.SAMPLER_ADDRESS_MODE_REPEAT
        if kind == FLOATS {
            filter = vk.FILTER_NEAREST
            address = vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
        }
        if kind == TABLE { address = vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE }
        t.sampler = vkhost.sampler(filter, address, vk.SAMPLER_MIPMAP_MODE_NEAREST, 0.0, 0.0)
        if t.sampler == null {
            vkdevice.fail("vkCreateSampler failed")
            vkhost.image_free(made)
            memset(t as ptr, 0, sizeof(VKTexture) as long)
            return 0
        }
    }
    t.in_use = true
    return handle
}

// A target made elsewhere -- an image the frame draws into and a later
// pass samples -- into the table with its own sampler, so the descriptor
// cache binds it as it binds any texture. The handle, or 0 when the table
// is full; the caller keeps the image then.
adopt_target(made: vkhost.VKImage, sampler: ptr, width: int, height: int) -> int {
    handle = free_handle()
    if handle == 0 {
        vkdevice.fail("texture table full")
        return 0
    }
    t = slot_at(handle)
    memset(t as ptr, 0, sizeof(VKTexture) as long)
    t.image = made.image
    t.memory = made.memory
    t.view = made.view
    t.sampler = sampler
    t.width = width
    t.height = height
    t.mean = core.vec3(1.0, 1.0, 1.0)
    t.in_use = true
    return handle
}

// The texture under `handle` destroyed, the device idle first. What bound
// it (ae3d.vkdesc's descriptor sets) has to be told before this.
destroy(handle: int) {
    if !valid(handle) || vkhost.device() == null { return }
    d = vkhost.device()
    vk.vkDeviceWaitIdle(d)
    t = slot_at(handle)
    if t.sampler != null { vk.vkDestroySampler(d, t.sampler, null) }
    if t.view != null { vk.vkDestroyImageView(d, t.view, null) }
    if t.image != null { vk.vkDestroyImage(d, t.image, null) }
    if t.memory != null { vk.vkFreeMemory(d, t.memory, null) }
    memset(t as ptr, 0, sizeof(VKTexture) as long)
}

// Every scene texture's sampler remade at `bias`; true when it changed,
// and the descriptor sets that named the old samplers have to go.
rebias(bias: float) -> bool {
    if bias == g_bias { return false }
    g_bias = bias
    if vkhost.device() == null || g_table == null { return true }
    vk.vkDeviceWaitIdle(vkhost.device())
    h = 1
    while h <= g_room {
        t = slot_at(h)
        if t.in_use && t.mip_levels > 0 { scene_sampler(t) }
        h = h + 1
    }
    return true
}

// Every texture destroyed, with the device: at shutdown; the next device
// starts with no bias.
clear() {
    g_bias = 0.0
    k = 0
    while k < UPDATE_SLOTS {
        collect_slot(k)
        k = k + 1
    }
    if g_table == null { return }
    d = vkhost.device()
    h = 1
    while h <= g_room {
        t = slot_at(h)
        if t.in_use && d != null {
            if t.sampler != null { vk.vkDestroySampler(d, t.sampler, null) }
            if t.view != null { vk.vkDestroyImageView(d, t.view, null) }
            if t.image != null { vk.vkDestroyImage(d, t.image, null) }
            if t.memory != null { vk.vkFreeMemory(d, t.memory, null) }
        }
        memset(t as ptr, 0, sizeof(VKTexture) as long)
        h = h + 1
    }
}
