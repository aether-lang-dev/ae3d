// Undo and redo for editor edits.
//
// A step records what a value was and what it became, so travelling in either
// direction is reading one of the two fields back out. Property edits coalesce:
// a slider drag delivers a callback per pixel, and stepping back through those
// one at a time would make undo useless, so consecutive edits to the same
// property extend the step the first one opened.

import std.list
import std.heap
import std.string

exports (
    EditStep, History,
    STEP_PROPERTY, STEP_ADD, STEP_REMOVE, STEP_PARENT, STEP_NAME,
    STEP_COMPONENT, STEP_COMPONENT_ADD, STEP_COMPONENT_REMOVE,
    history_new, history_free, history_record, history_record_parent, history_record_name, history_undo, history_redo,
    history_record_component, history_record_component_added, history_record_component_removed,
    history_depth, history_redo_depth, history_top, history_clear,
    history_begin_replay, history_end_replay, history_close,
    history_group_begin, history_group_end, history_undo_group, history_redo_group
)
const STEP_PROPERTY = 0
const STEP_ADD = 1
const STEP_REMOVE = 2
// A model moved under another (or out from under one): the parents before
// and after are the step's `from` and `to`.
const STEP_PARENT = 3
// A model renamed: the names before and after are the step's `from` and
// `to`, strings the step owns.
const STEP_NAME = 4
// A component's fields changed: the object is the subject, the kind is
// named, and `json_before` and `json_after` are its fields before and after
// as the scene file writes them (ae3d.component's to_json) -- whatever kind
// it is, one step shape undoes it.
const STEP_COMPONENT = 5
// A component added to the object, or taken off it: its kind and its fields
// (`json_after` for an add, `json_before` for a removal) are what bring it
// back, so no step holds a component that is not on its object.
const STEP_COMPONENT_ADD = 6
const STEP_COMPONENT_REMOVE = 7
const HISTORY_LIMIT = 64

struct EditStep {
    kind: int
    subject: ptr
    slot: int
    before: float
    after: float
    from: ptr                      // STEP_PARENT: the parent before, or null
    to: ptr                        // STEP_PARENT: the parent after, or null
    name_from: string              // STEP_NAME: the names before and after, the step's own
    name_to: string
    kind_name: string              // STEP_COMPONENT*: the component's kind
    json_before: string            // its fields before and after, the step's own
    json_after: string
    // Steps recorded between history_group_begin and history_group_end
    // share a group and undo together: grouping five objects is one edit
    // to the person who did it, however many parents it changed.
    group: int
}

struct History {
    undo: ptr
    redo: ptr
    replaying: bool
    open: bool
    grouping: int                  // the group steps are being recorded into, or 0
    groups: int                    // how many groups have been begun
}

history_new() -> *History {
    h = heap.new(History)
    h.undo = list.new()
    h.redo = list.new()
    h.replaying = false
    h.open = false
    h.grouping = 0
    h.groups = 0
    return h
}

history_free(h: *History) {
    if h == null { return }
    drain(h.undo)
    drain(h.redo)
    list.free(h.undo)
    list.free(h.redo)
    heap.free(h)
}

drain(stack: ptr) {
    if stack == null { return }
    while list.size(stack) > 0 {
        step = list.get_raw(stack, 0) as *EditStep
        list.remove(stack, 0)
        free_step(step)
    }
}

// heap.free releases a step's names with it.
free_step(step: *EditStep) {
    heap.free(step)
}

// The edit that was being made has finished, so the next one starts a step of
// its own however much it looks like the last. Without this a drag, a pause and
// another drag of the same slider are one step, and undo steps back past both.
history_close(h: *History) {
    if h != null { h.open = false }
}

// Applying a step must not record it again as a fresh edit.
history_begin_replay(h: *History) {
    if h != null { h.replaying = true }
}

history_end_replay(h: *History) {
    if h != null { h.replaying = false }
}

history_clear(h: *History) {
    if h == null { return }
    h.open = false
    drain(h.undo)
    drain(h.redo)
}

history_depth(h: *History) -> int {
    if h == null { return 0 }
    return list.size(h.undo)
}

history_redo_depth(h: *History) -> int {
    if h == null { return 0 }
    return list.size(h.redo)
}

history_top(h: *History) -> *EditStep {
    if h == null || list.size(h.undo) == 0 { return null }
    return list.get_raw(h.undo, list.size(h.undo) - 1) as *EditStep
}

history_record(h: *History, kind: int, subject: ptr, slot: int,
               before: float, after: float) {
    if h == null || h.replaying { return }

    count = list.size(h.undo)
    if kind == STEP_PROPERTY && h.open && count > 0 {
        top = list.get_raw(h.undo, count - 1) as *EditStep
        if top.kind == STEP_PROPERTY && top.subject == subject && top.slot == slot {
            top.after = after
            return
        }
    }

    step = heap.new(EditStep)
    step.kind = kind
    step.subject = subject
    step.slot = slot
    step.before = before
    step.after = after
    step.from = null
    step.to = null
    step.group = h.grouping
    list.add_raw(h.undo, step)
    h.open = kind == STEP_PROPERTY

    while list.size(h.undo) > HISTORY_LIMIT {
        stale = list.get_raw(h.undo, 0) as *EditStep
        list.remove(h.undo, 0)
        free_step(stale)
    }
    drain(h.redo)
}

// A model renamed. Consecutive renames of one model while the step is
// open are one step, as a name is typed a letter at a time.
history_record_name(h: *History, subject: ptr, before: string, after: string) {
    if h == null || h.replaying { return }
    count = list.size(h.undo)
    if h.open && count > 0 {
        top = list.get_raw(h.undo, count - 1) as *EditStep
        if top.kind == STEP_NAME && top.subject == subject {
            if top.name_to != null { string.free(top.name_to) }
            top.name_to = string.copy(after)
            return
        }
    }
    step = heap.new(EditStep)
    step.kind = STEP_NAME
    step.subject = subject
    step.slot = 0
    step.before = 0.0
    step.after = 0.0
    step.from = null
    step.to = null
    step.name_from = string.copy(before)
    step.name_to = string.copy(after)
    step.group = h.grouping
    list.add_raw(h.undo, step)
    h.open = true
    while list.size(h.undo) > HISTORY_LIMIT {
        stale = list.get_raw(h.undo, 0) as *EditStep
        list.remove(h.undo, 0)
        free_step(stale)
    }
    drain(h.redo)
}

// Keeps the undo stack to its length and forgets what was undone: a new
// edit is a new future.
push_step(h: *History, step: *EditStep) {
    step.group = h.grouping
    list.add_raw(h.undo, step)
    while list.size(h.undo) > HISTORY_LIMIT {
        stale = list.get_raw(h.undo, 0) as *EditStep
        list.remove(h.undo, 0)
        free_step(stale)
    }
    drain(h.redo)
}

component_step(kind: int, subject: ptr, kind_name: string, before: string, after: string) -> *EditStep {
    step = heap.new(EditStep)
    step.kind = kind
    step.subject = subject
    step.kind_name = string.copy(kind_name)
    step.json_before = string.copy(before)
    step.json_after = string.copy(after)
    return step
}

// A component's fields edited. Consecutive edits of the same component
// while the step is open -- a drag delivers one a pixel, a vector three a
// commit -- extend it, so undo goes back to before the whole adjustment.
history_record_component(h: *History, subject: ptr, kind_name: string, before: string, after: string) {
    if h == null || h.replaying { return }
    count = list.size(h.undo)
    if h.open && count > 0 {
        top = list.get_raw(h.undo, count - 1) as *EditStep
        if top.kind == STEP_COMPONENT && top.subject == subject && string.equals(top.kind_name, kind_name) == 1 {
            top.json_after = core_owned(top.json_after, after)
            return
        }
    }
    push_step(h, component_step(STEP_COMPONENT, subject, kind_name, before, after))
    h.open = true
}

core_owned(previous: string, value: string) -> string {
    if previous != null { string.free(previous) }
    return string.copy(value)
}

history_record_component_added(h: *History, subject: ptr, kind_name: string, fields: string) {
    if h == null || h.replaying { return }
    push_step(h, component_step(STEP_COMPONENT_ADD, subject, kind_name, "", fields))
    h.open = false
}

history_record_component_removed(h: *History, subject: ptr, kind_name: string, fields: string) {
    if h == null || h.replaying { return }
    push_step(h, component_step(STEP_COMPONENT_REMOVE, subject, kind_name, fields, ""))
    h.open = false
}

// A model's parent changed: from one (or none) to another (or none).
history_record_parent(h: *History, subject: ptr, from: ptr, to: ptr) {
    if h == null || h.replaying { return }
    step = heap.new(EditStep)
    step.kind = STEP_PARENT
    step.subject = subject
    step.slot = 0
    step.before = 0.0
    step.after = 0.0
    step.from = from
    step.to = to
    step.group = h.grouping
    list.add_raw(h.undo, step)
    h.open = false
    while list.size(h.undo) > HISTORY_LIMIT {
        stale = list.get_raw(h.undo, 0) as *EditStep
        list.remove(h.undo, 0)
        free_step(stale)
    }
    drain(h.redo)
}

// The steps recorded until history_group_end undo and redo together.
history_group_begin(h: *History) {
    if h == null { return }
    h.groups = h.groups + 1
    h.grouping = h.groups
}

history_group_end(h: *History) {
    if h != null { h.grouping = 0 ; h.open = false }
}

// Whether the next step to undo (or redo) belongs to the same group as
// the one just handed over: the caller keeps going while it does.
history_undo_group(h: *History, group: int) -> bool {
    if h == null || group == 0 || list.size(h.undo) == 0 { return false }
    return (list.get_raw(h.undo, list.size(h.undo) - 1) as *EditStep).group == group
}

history_redo_group(h: *History, group: int) -> bool {
    if h == null || group == 0 || list.size(h.redo) == 0 { return false }
    return (list.get_raw(h.redo, list.size(h.redo) - 1) as *EditStep).group == group
}

// The caller applies the step; this only moves it between the two stacks and
// hands it over, so the history has no opinion about what a step means.
history_undo(h: *History) -> *EditStep {
    return transfer(h, h.undo, h.redo)
}

history_redo(h: *History) -> *EditStep {
    return transfer(h, h.redo, h.undo)
}

transfer(h: *History, from: ptr, onto: ptr) -> *EditStep {
    if h == null || list.size(from) == 0 { return null }
    h.open = false
    index = list.size(from) - 1
    step = list.get_raw(from, index) as *EditStep
    list.remove(from, index)
    list.add_raw(onto, step)
    return step
}
