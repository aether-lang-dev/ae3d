// ae3d.skylight -- the light the sky casts (#655), the part made on the CPU.
//
// The sky is captured each frame into an octahedral map (shaders, "The
// octahedral sky map"), and from it, on the device, the irradiance onto
// every normal and the reflections prefiltered by roughness. What scales
// the reflections by a surface's F0 is the split-sum table made here once
// (Karis): for a view angle and a roughness, the scale and the bias F0
// takes. It depends on nothing in the scene, so it is made at start and
// uploaded.

import ae3d.core

exports (
    SIZE, LEVELS, IRRADIANCE_SIZE, LUT_SIZE, brdf_lut, irradiance_at
)

extern calloc(count: int, size: int) -> ptr
extern sqrt(x: float) -> float
extern cos(x: float) -> float
extern pow(x: float, y: float) -> float
extern fabs(x: float) -> float
extern floor(x: float) -> float

// The sizes the shaders are written for (SKY_SIZE, SKY_LEVELS,
// SKY_IRRADIANCE_SIZE): the capture's level 0 and the prefiltered map's,
// texels a side with the gutter; the prefiltered map's levels, roughness 0
// to 1; the irradiance map's size.
const SIZE = 256
const LEVELS = 6
const IRRADIANCE_SIZE = 16
const LUT_SIZE = 64
const LUT_SAMPLES = 256
const PI = 3.14159265358979323846

// The i-th point of the Hammersley set, its second coordinate.
radical_inverse(index: int) -> float {
    bits = index
    result = 0.0
    f = 0.5
    while bits > 0 {
        if (bits & 1) == 1 { result = result + f }
        bits = bits >> 1
        f = f * 0.5
    }
    return result
}

// The split-sum table: for each view angle (its cosine, across) and
// roughness (down), the scale and the bias of F0 the prefiltered sky is
// multiplied by, as float[LUT_SIZE * LUT_SIZE * 2]. GGX importance-sampled,
// with the Smith-Schlick visibility k = a / 2 image lighting takes.
brdf_lut() -> ptr {
    out = calloc(LUT_SIZE * LUT_SIZE * 2, 8)
    o = out as float[]
    j = 0
    while j < LUT_SIZE {
        roughness = ((j as float) + 0.5) / (LUT_SIZE as float)
        a = roughness * roughness
        k = a / 2.0
        i = 0
        while i < LUT_SIZE {
            nv = ((i as float) + 0.5) / (LUT_SIZE as float)
            vx = sqrt(1.0 - nv * nv)
            vz = nv
            scale_sum = 0.0
            bias_sum = 0.0
            s = 0
            while s < LUT_SAMPLES {
                e1 = ((s as float) + 0.5) / (LUT_SAMPLES as float)
                phi = 2.0 * PI * radical_inverse(s)
                cos_theta = sqrt((1.0 - e1) / (1.0 + (a * a - 1.0) * e1))
                sin_theta = sqrt(1.0 - cos_theta * cos_theta)
                // V lies in the xz plane, so H's y never enters.
                hx = sin_theta * cos(phi)
                hz = cos_theta
                vh = vx * hx + vz * hz
                lz = 2.0 * vh * hz - vz
                if lz > 0.0 {
                    if vh < 0.0 { vh = 0.0 }
                    g_v = nv / (nv * (1.0 - k) + k)
                    g_l = lz / (lz * (1.0 - k) + k)
                    visibility = g_v * g_l * vh / (hz * nv)
                    fresnel = pow(1.0 - vh, 5.0)
                    scale_sum = scale_sum + (1.0 - fresnel) * visibility
                    bias_sum = bias_sum + fresnel * visibility
                }
                s = s + 1
            }
            at = (j * LUT_SIZE + i) * 2
            o[at] = scale_sum / (LUT_SAMPLES as float)
            o[at + 1] = bias_sum / (LUT_SAMPLES as float)
            i = i + 1
        }
        j = j + 1
    }
    return out
}

// The irradiance map read back (`texels`, IRRADIANCE_SIZE squared RGBA
// floats) at normal `n`, between its texels as the shader reads it: the
// irradiance onto a surface facing n.
irradiance_at(texels: ptr, n: Vec3) -> Vec3 {
    t = texels as f32[]
    l1 = fabs(n.x) + fabs(n.y) + fabs(n.z)
    px = n.x / l1
    py = n.z / l1
    if n.y < 0.0 {
        sx = 1.0
        if px < 0.0 { sx = 0.0 - 1.0 }
        sy = 1.0
        if py < 0.0 { sy = 0.0 - 1.0 }
        fx = (1.0 - fabs(py)) * sx
        fy = (1.0 - fabs(px)) * sy
        px = fx
        py = fy
    }
    size = IRRADIANCE_SIZE as float
    // Texel space: the texel centres at integers, the gutter included.
    u = ((px * 0.5 + 0.5) * (size - 2.0) + 1.0) - 0.5
    v = ((py * 0.5 + 0.5) * (size - 2.0) + 1.0) - 0.5
    x0 = floor(u)
    y0 = floor(v)
    fu = u - x0
    fv = v - y0
    r = 0.0
    g = 0.0
    b = 0.0
    j = 0
    while j < 2 {
        i = 0
        while i < 2 {
            x = (x0 as int) + i
            y = (y0 as int) + j
            if x < 0 { x = 0 }
            if y < 0 { y = 0 }
            if x >= IRRADIANCE_SIZE { x = IRRADIANCE_SIZE - 1 }
            if y >= IRRADIANCE_SIZE { y = IRRADIANCE_SIZE - 1 }
            w = (1.0 - fu) * (1.0 - fv)
            if i == 1 && j == 0 { w = fu * (1.0 - fv) }
            if i == 0 && j == 1 { w = (1.0 - fu) * fv }
            if i == 1 && j == 1 { w = fu * fv }
            at = (y * IRRADIANCE_SIZE + x) * 4
            r = r + (t[at] as float) * w
            g = g + (t[at + 1] as float) * w
            b = b + (t[at + 2] as float) * w
            i = i + 1
        }
        j = j + 1
    }
    return core.vec3(r, g, b)
}
