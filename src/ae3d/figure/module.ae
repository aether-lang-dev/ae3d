// ae3d.figure -- an animated figure as one game object (#439).
//
// A figure is a glTF read from a file -- its meshes, the skeleton they are
// skinned to, its animations -- standing where a game object stands and
// playing a clip. The object's model is an empty group; the file's roots
// hang under it, so moving, turning or scaling the object carries the
// whole figure, and the file's meshes are drawn as any model is. A clip
// plays by name, at a speed, looping or not, advanced by the engine's
// update like any script; `set_time` scrubs it.
//
// A scene file records a figure as the group's "figure" record (the file,
// the clip, the speed, whether it loops, how far in: ae3d.scene's
// FigureSpec), and its own meshes as internal, so they are not written: a
// scene read back makes the figure again from its file (`attach` on the
// group the scene made). The editor and every program that saves its
// scene write the same record.
//
// A figure's models belong to its file, freed with it: `figures_free`
// after the engine that drew them is gone, as with any glTF.
//
// Underneath, a figure needs no engine: `figure_new` reads one under a
// group, `advance` plays it on, `figure_free` lets it go, and whatever
// draws it (the editor's viewport, a tool) adds its meshes itself.
//
// Changing clip (#574). `play` cuts: the new clip's first pose replaces the
// last one in a frame. `play_blended` inertializes (Bollo, GDC 2018): every
// node keeps the offset from where it was drawn to where the new clip puts
// it, and the speed that offset was changing at, and the offset decays to
// nothing over the blend time along a quintic that starts at that speed
// and ends at rest. Nothing is averaged between two poses -- the new clip
// plays from its first frame, under an offset that fades -- so a foot is
// never dragged sideways by a mix of two strides, and the motion carries
// on at the speed it had instead of stopping dead.
//
// Layers on top of the clip: `layer_play` plays another clip over the
// bones under one bone (an upper body that aims and reloads over legs that
// walk), at a weight; or as an additive, its change from its own first
// frame added to whatever the clip and the layers under it posed
// (breathing, a flinch).

import std.list
import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.engine
import ae3d.gltf
import ae3d.anim
import ae3d.scene
import ae3d.skin
import ae3d.component

exports (
    Figure,
    figure, attach, figure_of, play, stop, set_time, figures_free,
    figure_new, figure_free, advance, set_speed, set_looping, clip_index, keep_pose, put_pose, pose_free,
    play_blended, play_blended_at, blending, layer_play, layer_play_under, layer_set_weight, layer_stop, layer_count,
    path, clip, speed, looping, time, clip_count, clip_name, duration, skeleton, primitive_count, primitive, add_clip,
    put_back, turn_put_back,
    figure_kind, attach_figure, figure_component
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

struct Figure {
    engine: ptr                      // *Engine
    object: ptr                      // *GameObject
    path: string
    file: ptr                        // *GltfScene
    players: ptr                     // *Registry: the clip's players, one a node
    clip: string                     // "" when none plays
    speed: float
    looping: bool
    time: float                      // seconds into the clip
    duration: float
    // The pose each node was drawn in this frame and the frame before
    // (POSE_FLOATS a node, gltf's model order): what a transition carries on.
    drawn: ptr
    drawn_before: ptr
    // Each node's pose as the clip left it this frame, before a transition's
    // offsets and the layers went on (#650): where a node starts the next
    // frame from, if nothing else has moved it. The figure's own: a turn or
    // a place the clip does not key keeps the figure's, never another
    // writer's move on it (#673).
    base: ptr
    // Each node as it stood when the clip had gone on this frame, another
    // writer's move on it kept: the figure's offsets and layers went on over
    // it, and come off it again the next frame (#673).
    posed: ptr
    based: bool
    // Which of each node's channels the figure put back this frame, TURN
    // and PLACE (#673): its clip keys them, or the node, still as the
    // figure drew it, went back to the clip's pose. What was written on a
    // channel before is gone; on one not put back, another writer's move
    // is still there, and the figure's own offsets were taken off from
    // under it.
    put: ptr                         // int a node
    keyed: ptr                       // int a node: the channels the clip keys
    nodes: int
    pending: float                   // the frame's seconds, for the decay
    frame_seconds: float             // the last frame's, for the speeds
    // A transition: each node's offsets as quintics (INERTIA_FLOATS a node),
    // how far into it, and how long it takes.
    inertia: ptr
    blend_t: float
    blend_time: float
    layers: ptr                      // list of *FigureLayer
}

const POSE_FLOATS = 7                // position, rotation
const TURN = 1                       // a node's rotation, in Figure.put and Figure.keyed
const PLACE = 2                      // its position
// A node's transition: the rotation's axis (3), then four quintics -- the
// rotation's angle and the position's x, y, z -- of QUINTIC floats each.
const QUINTIC = 7                    // a, b, c, d (t^5..t^2), v0, x0, and when it rests
const INERTIA_FLOATS = 3 + 4 * QUINTIC

// A clip over part of the figure, or added to it.
struct FigureLayer {
    players: ptr                     // *Registry
    root: ptr                        // *Model the masked bones hang from; null for every bone
    weight: float
    additive: bool
    time: float
    speed: float
    looping: bool
    duration: float
    reference: ptr                   // POSE_FLOATS a node: the layer's first frame, for an additive
}

// Every figure an engine has, for the scene file's records.
struct Figures {
    engine: ptr
    list: ptr                        // list of *Figure
}

var g_figures: ptr = null            // list of *Figures, one an engine

figures_for(e: *Engine) -> *Figures {
    if g_figures == null { g_figures = list.new() }
    i = 0
    while i < list.size(g_figures) {
        fs = list.get_raw(g_figures, i) as *Figures
        if fs.engine == e as ptr { return fs }
        i = i + 1
    }
    fs = calloc(1, sizeof(Figures)) as *Figures
    fs.engine = e as ptr
    fs.list = list.new()
    list.add_raw(g_figures, fs as ptr)
    engine.engine_set_attachment_provider(e, figure_attachments, fs as ptr)
    return fs
}

// A figure from `path`, as a new game object named `name`, at the origin.
// Null when the file cannot be read (gltf.last_error says why).
figure(e: *Engine, name: string, path: string) -> *GameObject {
    group = core.model_new()
    o = engine.object(e, name, group)
    if attach(e, o, path) == null { return null }
    return o
}

// A figure from `path` on an object that has a group for a model -- one the
// game made, or one a scene file read back: its meshes drawn by the engine,
// its clip played on by the engine's update, its record in the scene file
// the engine saves. Null when the file cannot be read or the object has no
// model.
attach(e: *Engine, o: *GameObject, path: string) -> *Figure {
    group = behaviour.object_model(o)
    if group == null { return null }
    f = figure_new(path, group)
    if f == null { return null }
    f.engine = e as ptr
    f.object = o as ptr
    i = 0
    while i < primitive_count(f) {
        engine.engine_add_model(e, primitive(f, i))
        i = i + 1
    }
    engine.script(o, "Figure", f as ptr, null, figure_update)
    list.add_raw(figures_for(e).list, f as ptr)
    return f
}

// A figure from `path` under `group`, nothing playing, drawn by no one yet.
// Null when the file cannot be read.
figure_new(path: string, group: *Model) -> *Figure {
    file = gltf.load(path)
    if file == null { return null }
    f = calloc(1, sizeof(Figure)) as *Figure
    f.path = string.copy(path)
    f.file = file as ptr
    f.clip = string.copy("")
    f.speed = 1.0
    f.looping = true
    f.players = anim.registry_new() as ptr
    f.nodes = gltf.model_count(file)
    f.drawn = calloc(f.nodes * POSE_FLOATS + 1, 8)
    f.drawn_before = calloc(f.nodes * POSE_FLOATS + 1, 8)
    f.base = calloc(f.nodes * POSE_FLOATS + 1, 8)
    f.posed = calloc(f.nodes * POSE_FLOATS + 1, 8)
    f.put = calloc(f.nodes + 1, 4)
    f.keyed = calloc(f.nodes + 1, 4)
    f.inertia = calloc(f.nodes * INERTIA_FLOATS + 1, 8)
    f.layers = list.new()
    f.frame_seconds = 1.0 / 60.0
    i = 0
    while i < gltf.root_count(file) {
        core.model_set_parent(gltf.root(file, i), group)
        i = i + 1
    }
    // Drawn, until a clip plays, as the file rests, and still: a transition
    // out of the rest pose carries on from it. Left at zero, the first
    // blend carried each bone from the origin, and stretched it 49 m.
    remember(f)
    remember(f)
    // And posed so, under no offsets: the first clip goes on over the rest
    // pose as every later one does over the last, and a node moved before
    // it was moved by another writer, whose move stays its own (#673).
    i = 0
    while i < f.nodes {
        read_node(gltf.model(file, i), f.base as float[], i * POSE_FLOATS)
        read_node(gltf.model(file, i), f.posed as float[], i * POSE_FLOATS)
        i = i + 1
    }
    f.based = true
    return f
}

// A figure and its file's models, gone. Whatever drew them lets them go
// first.
figure_free(f: *Figure) {
    if f == null { return }
    anim.registry_free(f.players as *Registry)
    if f.drawn != null { free(f.drawn) }
    if f.drawn_before != null { free(f.drawn_before) }
    if f.base != null { free(f.base) }
    if f.posed != null { free(f.posed) }
    if f.put != null { free(f.put) }
    if f.keyed != null { free(f.keyed) }
    if f.inertia != null { free(f.inertia) }
    if f.layers != null {
        i = 0
        while i < list.size(f.layers) {
            layer_free(list.get_raw(f.layers, i) as *FigureLayer)
            i = i + 1
        }
        list.free(f.layers)
    }
    gltf.scene_destroy(f.file as *GltfScene)
    string.free(f.path)
    string.free(f.clip)
    free(f as ptr)
}

// The clip on by `delta` seconds, at the figure's speed.
advance(f: *Figure, delta: float) {
    if f == null || string.equals(f.clip, "") == 1 { return }
    f.pending = delta
    if delta > 0.0 { f.frame_seconds = delta }
    set_time(f, f.time + delta * f.speed)
}

// The figure on an object, or null.
figure_of(o: *GameObject) -> *Figure {
    if o == null { return null }
    i = 0
    while i < behaviour.object_component_count(o) {
        c = behaviour.object_component(o, i)
        if c != null && string.equals(c.name, "Figure") == 1 { return behaviour.component_state(c) as *Figure }
        i = i + 1
    }
    return null
}

// Play `clip` from its start at `speed` (1 its own pace), looping or not.
// False, and nothing playing, when the file has no animation by that name.
play(f: *Figure, name: string, rate: float, loops: bool) -> bool {
    if f == null { return false }
    stop(f)
    made = gltf.play(f.file as *GltfScene, name, f.players as *Registry, loops)
    if made == 0 { return false }
    mark_keyed(f)
    string.free(f.clip)
    f.clip = string.copy(name)
    f.speed = rate
    f.looping = loops
    f.time = 0.0
    f.duration = gltf.animation_duration(f.file as *GltfScene, name)
    // A cut ends any transition.
    f.blend_time = 0.0
    f.blend_t = 0.0
    return true
}

// The pace the clip plays at, from now on (0 holds it where it is).
set_speed(f: *Figure, rate: float) {
    if f != null { f.speed = rate }
}

// Whether the clip starts again at its end, from now on.
set_looping(f: *Figure, loops: bool) {
    if f == null { return }
    f.looping = loops
    r = f.players as *Registry
    i = 0
    while i < anim.registry_count(r) {
        anim.player_set_looping(anim.binding_player(anim.registry_binding(r, i)), loops)
        i = i + 1
    }
}

// The playing clip's place in the file's list, or -1 when none plays.
clip_index(f: *Figure) -> int {
    if f == null || string.equals(f.clip, "") == 1 { return 0 - 1 }
    i = 0
    while i < clip_count(f) {
        if string.equals(clip_name(f, i), f.clip) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// Nothing plays: the pose stays where the clip left it.
stop(f: *Figure) {
    if f == null { return }
    anim.registry_free(f.players as *Registry)
    f.players = anim.registry_new() as ptr
    string.free(f.clip)
    f.clip = string.copy("")
    f.time = 0.0
    f.duration = 0.0
    mark_keyed(f)
}

// The clip at `seconds` in (wrapped when it loops, held at its end when not),
// posed now.
set_time(f: *Figure, seconds: float) {
    if f == null || string.equals(f.clip, "") == 1 { return }
    f.time = wrapped(f, seconds)
    r = f.players as *Registry
    i = 0
    while i < anim.registry_count(r) {
        anim.player_set_time(anim.binding_player(anim.registry_binding(r, i)), f.time)
        i = i + 1
    }
    clip_onto_base(f, r)
    delta = f.pending
    f.pending = 0.0
    if f.blend_time > 0.0 { decay(f, delta) }
    apply_layers(f, delta)
    remember(f)
}

wrapped(f: *Figure, seconds: float) -> float {
    if f.duration <= 0.0 { return 0.0 }
    t = seconds
    if f.looping {
        while t >= f.duration { t = t - f.duration }
        while t < 0.0 { t = t + f.duration }
    } else {
        if t > f.duration { t = f.duration }
        if t < 0.0 { t = 0.0 }
    }
    return t
}

// A frame's update: the clip on by the frame's time, at the figure's speed.
figure_update(state: ptr, o: *GameObject, delta: float) {
    advance(state as *Figure, delta)
}

path(f: *Figure) -> string { return f.path }
clip(f: *Figure) -> string { return f.clip }
speed(f: *Figure) -> float { return f.speed }
looping(f: *Figure) -> bool { return f.looping }
time(f: *Figure) -> float { return f.time }
duration(f: *Figure) -> float { return f.duration }
// A clip made at run time added to the figure's animation `animation`, as
// the clip driving the node named `node` (a bone, by its file's name):
// played, blended, layered and listed (clip_count, clip_name, clip_index)
// as the clips its file brought (#645). Motion captured, retargeted onto
// the rig or generated goes in one clip a node, each named
// "<animation>:<node>" as gltf names the file's. False when the figure has
// no such node or the clip is not so named; added, the clip is the
// figure's, freed with it.
add_clip(f: *Figure, animation: string, clip: *Clip, node: string) -> bool {
    if f == null { return false }
    m = find_node(f, node)
    if m == null { return false }
    return gltf.add_clip(f.file as *GltfScene, animation, clip, m)
}

// Whether the clips in `r` key `node`'s turn, and its place.
keys_of(r: *Registry, node: *Model) -> (bool, bool) {
    turn = false
    place = false
    k = 0
    while k < anim.registry_count(r) {
        b = anim.registry_binding(r, k)
        if anim.binding_model(b) == node {
            c = anim.player_clip(anim.binding_player(b))
            i = 0
            while i < anim.clip_channel_count(c) {
                t = anim.channel_target(anim.clip_channel(c, i))
                if t == anim.ROTATION { turn = true }
                if t == anim.TRANSLATION { place = true }
                i = i + 1
            }
        }
        k = k + 1
    }
    return turn, place
}

// Whether the figure put `node`'s place back this frame (#673): its clip
// keys it, or the node, as the figure drew it, went back to the clip's
// pose. A module that moves the node each frame finds none of its last
// move on it then; where not, its last move is still there, for it to
// take off itself.
put_back(f: *Figure, node: *Model) -> bool {
    if f == null || node == null { return false }
    file = f.file as *GltfScene
    put = f.put as int[]
    i = 0
    while i < f.nodes {
        if gltf.model(file, i) == node { return has_place(put[i]) }
        i = i + 1
    }
    return false
}

// The same for `node`'s turn.
turn_put_back(f: *Figure, node: *Model) -> bool {
    if f == null || node == null { return false }
    file = f.file as *GltfScene
    put = f.put as int[]
    i = 0
    while i < f.nodes {
        if gltf.model(file, i) == node { return has_turn(put[i]) }
        i = i + 1
    }
    return false
}

// Which channels of each node the playing clip keys, into Figure.keyed.
mark_keyed(f: *Figure) {
    file = f.file as *GltfScene
    keyed = f.keyed as int[]
    i = 0
    while i < f.nodes {
        turn, place = keys_of(f.players as *Registry, gltf.model(file, i))
        keyed[i] = 0
        if turn { keyed[i] = keyed[i] + TURN }
        if place { keyed[i] = keyed[i] + PLACE }
        i = i + 1
    }
}

has_turn(channels: int) -> bool { return channels % 2 == 1 }
has_place(channels: int) -> bool { return channels >= PLACE }

clip_count(f: *Figure) -> int { return gltf.animation_count(f.file as *GltfScene) }
clip_name(f: *Figure, index: int) -> string { return gltf.animation_name(f.file as *GltfScene, index) }
primitive_count(f: *Figure) -> int { return gltf.primitive_count(f.file as *GltfScene) }
primitive(f: *Figure, index: int) -> *Model { return gltf.primitive(f.file as *GltfScene, index) }

// Every node of the figure's file as it stands now -- position, rotation,
// scale -- to put back with `put_pose`: what the editor keeps before a
// ragdoll takes the rig and restores when the simulation stops. Freed with
// `pose_free`.
keep_pose(f: *Figure) -> ptr {
    file = f.file as *GltfScene
    count = gltf.model_count(file)
    kept = calloc(count * 10 + 1, 8)
    k = kept as float[]
    k[0] = count as float
    i = 0
    while i < count {
        m = gltf.model(file, i)
        at = 1 + i * 10
        k[at] = m.position.x
        k[at + 1] = m.position.y
        k[at + 2] = m.position.z
        k[at + 3] = m.rotation.x
        k[at + 4] = m.rotation.y
        k[at + 5] = m.rotation.z
        k[at + 6] = m.rotation.w
        k[at + 7] = m.scale.x
        k[at + 8] = m.scale.y
        k[at + 9] = m.scale.z
        i = i + 1
    }
    return kept
}

put_pose(f: *Figure, kept: ptr) {
    if f == null || kept == null { return }
    file = f.file as *GltfScene
    k = kept as float[]
    count = k[0] as int
    i = 0
    while i < count && i < gltf.model_count(file) {
        m = gltf.model(file, i)
        at = 1 + i * 10
        core.model_set_position(m, k[at], k[at + 1], k[at + 2])
        core.model_set_rotation(m, core.quat(k[at + 3], k[at + 4], k[at + 5], k[at + 6]))
        core.model_set_scale(m, k[at + 7], k[at + 8], k[at + 9])
        i = i + 1
    }
}

pose_free(kept: ptr) {
    if kept != null { free(kept) }
}

// The skeleton its meshes are skinned to (the file's first), or null for a
// figure with none.
skeleton(f: *Figure) -> *Skeleton {
    file = f.file as *GltfScene
    if gltf.skeleton_count(file) == 0 { return null }
    return gltf.skeleton(file, 0)
}

// The scene file's records: each figure's group with its figure record,
// and its meshes as internal.
figure_attachments(state: ptr) -> ptr {
    fs = state as *Figures
    out = list.new()
    i = 0
    while i < list.size(fs.list) {
        f = list.get_raw(fs.list, i) as *Figure
        group = behaviour.object_model(f.object as *GameObject)
        if group != null {
            a = scene.attachment_new(group, "", "", null, null)
            scene.attachment_set_figure(a, scene.figure_spec_new(f.path, f.clip, f.speed, f.looping, f.time))
            list.add_raw(out, a as ptr)
        }
        k = 0
        while k < primitive_count(f) {
            inner = scene.attachment_new(primitive(f, k), "", "", null, null)
            scene.attachment_set_internal(inner, true)
            list.add_raw(out, inner as ptr)
            k = k + 1
        }
        i = i + 1
    }
    return out
}

// Every figure the engine had, and its file's models, freed: after the
// engine is, since the engine drew them.
figures_free(e: *Engine) {
    if g_figures == null { return }
    i = 0
    while i < list.size(g_figures) {
        fs = list.get_raw(g_figures, i) as *Figures
        if fs.engine == e as ptr {
            k = 0
            while k < list.size(fs.list) {
                figure_free(list.get_raw(fs.list, k) as *Figure)
                k = k + 1
            }
            list.free(fs.list)
            free(fs as ptr)
            list.remove(g_figures, i)
        } else {
            i = i + 1
        }
    }
    if list.size(g_figures) == 0 {
        list.free(g_figures)
        g_figures = null
    }
}

// --- the Figure component --------------------------------------------------

// A figure is its object's Figure component: the clip it plays, whether it
// loops, its pace and how far into the clip it stands, each read off the
// figure and written to it. The clip is chosen by name from the figure's
// own file ("clip" assets, which the editor lists from the file). A figure
// comes from a file, so the kind has no constructor: it is never added
// from Add Component, only attached where a figure is made.
var g_figure_kind: ptr = null

figure_kind() -> *ComponentKind {
    if g_figure_kind != null { return g_figure_kind as *ComponentKind }
    k = component.kind("Figure", "Animation", null, null)
    component.asset_field(k, "clip", "clip", clip_text, set_clip_text)
    component.bool_property(k, "loop", loop_flag, set_loop_flag)
    component.float_property(k, "speed", speed_value, set_speed_value, 0.0, 3.0)
    component.float_property(k, "time", time_value, set_time_value, 0.0, 1.0)
    component.set_tooltip(k, "clip", "An animation in the figure's file; none stops it.")
    component.set_tooltip(k, "time", "How far into the clip, from its start (0) to its end (1).")
    component.set_unique(k, true)
    g_figure_kind = k as ptr
    return k
}

// The figure's Figure component on `o`, borrowing the figure.
attach_figure(o: *GameObject, f: *Figure) -> *Component {
    existing = component.find(o, figure_kind())
    if existing != null { return existing }
    return component.attach_state(o, figure_kind(), f as ptr, false)
}

figure_component(o: *GameObject) -> *Component { return component.find(o, figure_kind()) }

clip_text(p: ptr) -> string {
    if p == null { return "" }
    f = p as *Figure
    at = clip_index(f)
    if at < 0 { return "" }
    return clip_name(f, at)
}

// A name the file has plays from its start at the pace and loop it had;
// none, or one the file lacks, stops it.
set_clip_text(p: ptr, name: string) {
    if p == null { return }
    f = p as *Figure
    if name == "" || !play(f, name, f.speed, f.looping) { stop(f) }
}

loop_flag(p: ptr) -> bool {
    if p == null { return false }
    return (p as *Figure).looping
}
set_loop_flag(p: ptr, on: bool) { if p != null { set_looping(p as *Figure, on) } }

speed_value(p: ptr) -> float {
    if p == null { return 1.0 }
    return (p as *Figure).speed
}
set_speed_value(p: ptr, rate: float) { if p != null { set_speed(p as *Figure, rate) } }

time_value(p: ptr) -> float {
    if p == null { return 0.0 }
    f = p as *Figure
    if f.duration <= 0.0 { return 0.0 }
    return f.time / f.duration
}
set_time_value(p: ptr, share: float) {
    if p == null { return }
    f = p as *Figure
    set_time(f, share * f.duration)
}

// --- transitions (#574) --------------------------------------------------------------------------------

// A node's local pose into `out` at `at`.
read_node(m: *Model, out: float[], at: int) {
    out[at] = m.position.x
    out[at + 1] = m.position.y
    out[at + 2] = m.position.z
    out[at + 3] = m.rotation.x
    out[at + 4] = m.rotation.y
    out[at + 5] = m.rotation.z
    out[at + 6] = m.rotation.w
}

node_quat(b: float[], at: int) -> Quat { return core.quat(b[at + 3], b[at + 4], b[at + 5], b[at + 6]) }
node_pos(b: float[], at: int) -> Vec3 { return core.vec3(b[at], b[at + 1], b[at + 2]) }

// This frame's pose kept, and the last frame's behind it.
remember(f: *Figure) {
    file = f.file as *GltfScene
    now = f.drawn as float[]
    before = f.drawn_before as float[]
    i = 0
    while i < f.nodes {
        k = 0
        while k < POSE_FLOATS {
            before[i * POSE_FLOATS + k] = now[i * POSE_FLOATS + k]
            k = k + 1
        }
        read_node(gltf.model(file, i), now, i * POSE_FLOATS)
        i = i + 1
    }
}

// The clip posed onto each node's own pose (#650): a node still as the
// figure drew it last -- nothing has moved it since -- put back first where
// the clip left it, under the offsets and layers drawn over it, and what the
// clip leaves now kept for the next frame. The offsets a transition and the
// layers add are on the clip's pose, and a node the clip keys is rewritten
// by it every frame; one it does not key kept the sum, and the next frame's
// offset went on top of it -- a clip keying only turns, blended in, pulled
// the limbs metres off within a second and kept them there. A node something
// else moved (the rig's root, carried by a ragdoll getting up; the hips,
// lifted by ae3d.locomotion and lowered by ae3d.feet) keeps that move: only
// what the figure added over the clip last frame comes off it (#673), as
// every writer takes its own last move off. Left on, a transition's offset
// went onto such a node again each frame of the transition, and a standing
// walker's hips rose 28 cm with its legs folded under it.
clip_onto_base(f: *Figure, r: *Registry) {
    file = f.file as *GltfScene
    drawn = f.drawn as float[]
    base = f.base as float[]
    posed = f.posed as float[]
    put = f.put as int[]
    keyed = f.keyed as int[]
    i = 0
    while i < f.nodes {
        put[i] = keyed[i]
        if f.based {
            m = gltf.model(file, i)
            at = i * POSE_FLOATS
            if as_drawn(m, drawn, at) {
                core.model_set_position(m, base[at], base[at + 1], base[at + 2])
                core.model_set_rotation(m, node_quat(base, at))
                put[i] = TURN + PLACE
            } else {
                take_own_off(m, drawn, posed, at)
            }
        }
        i = i + 1
    }
    anim.registry_apply(r)
    i = 0
    while i < f.nodes {
        at = i * POSE_FLOATS
        read_node(gltf.model(file, i), posed, at)
        if has_place(put[i]) {
            base[at] = posed[at]
            base[at + 1] = posed[at + 1]
            base[at + 2] = posed[at + 2]
        }
        if has_turn(put[i]) {
            k = 3
            while k < POSE_FLOATS {
                base[at + k] = posed[at + k]
                k = k + 1
            }
        }
        i = i + 1
    }
    f.based = true
}


// What the figure added over the clip's pose last frame, a transition's
// offsets and the layers -- the node as drawn against the node as the clip
// left it -- taken off `m`.
take_own_off(m: *Model, drawn: float[], posed: float[], at: int) {
    if drawn[at] != posed[at] || drawn[at + 1] != posed[at + 1] || drawn[at + 2] != posed[at + 2] {
        core.model_set_position(m, m.position.x - (drawn[at] - posed[at]), m.position.y - (drawn[at + 1] - posed[at + 1]),
                                m.position.z - (drawn[at + 2] - posed[at + 2]))
    }
    was = node_quat(drawn, at)
    under = node_quat(posed, at)
    if was.x != under.x || was.y != under.y || was.z != under.z || was.w != under.w {
        own = core.quat_mul(was, core.quat_conjugate(under))
        core.model_set_rotation(m, core.quat_normalize(core.quat_mul(core.quat_conjugate(own), m.rotation)))
    }
}

// Whether `m` is exactly as `drawn` holds it, at `at`.
as_drawn(m: *Model, drawn: float[], at: int) -> bool {
    return m.position.x == drawn[at] && m.position.y == drawn[at + 1] && m.position.z == drawn[at + 2] &&
           m.rotation.x == drawn[at + 3] && m.rotation.y == drawn[at + 4] && m.rotation.z == drawn[at + 5] && m.rotation.w == drawn[at + 6]
}

// Bollo's quintic for an offset of x0 changing at v0, to rest at t1: its
// t^5..t^2 coefficients, v0 and x0 into `q` at `at`. An offset growing away
// from rest is taken as still (it would overshoot); one falling fast reaches
// rest no later than its own speed allows.
quintic(q: float[], at: int, x0_in: float, v0_in: float, t1_in: float) {
    x0 = x0_in
    v0 = v0_in
    flip = x0 < 0.0
    if flip {
        x0 = 0.0 - x0
        v0 = 0.0 - v0
    }
    if v0 > 0.0 { v0 = 0.0 }
    t1 = t1_in
    if v0 < 0.0 {
        limit = 0.0 - 5.0 * x0 / v0
        if limit < t1 { t1 = limit }
    }
    if t1 <= 0.000001 || x0 <= 0.0 {
        k = 0
        while k < QUINTIC {
            q[at + k] = 0.0
            k = k + 1
        }
        return
    }
    a0 = (0.0 - 8.0 * v0 * t1 - 20.0 * x0) / (t1 * t1)
    t2 = t1 * t1
    t3 = t2 * t1
    t4 = t3 * t1
    t5 = t4 * t1
    sign = 1.0
    if flip { sign = 0.0 - 1.0 }
    q[at] = sign * (0.0 - (a0 * t2 + 6.0 * v0 * t1 + 12.0 * x0) / (2.0 * t5))
    q[at + 1] = sign * ((3.0 * a0 * t2 + 16.0 * v0 * t1 + 30.0 * x0) / (2.0 * t4))
    q[at + 2] = sign * (0.0 - (3.0 * a0 * t2 + 12.0 * v0 * t1 + 20.0 * x0) / (2.0 * t3))
    q[at + 3] = sign * (a0 * 0.5)
    q[at + 4] = sign * v0
    q[at + 5] = sign * x0
    q[at + 6] = t1
}

// A quintic's offset at t: nothing once it has come to rest -- at the end of
// the transition, or sooner where its own speed brought it there (past its
// rest the polynomial runs away).
quintic_at(q: float[], at: int, t: float, t_end: float) -> float {
    if t >= t_end || t >= q[at + 6] { return 0.0 }
    return (((q[at] * t + q[at + 1]) * t + q[at + 2]) * t + q[at + 3]) * t * t + q[at + 4] * t + q[at + 5]
}

// `name` from its first frame, carried on from where the figure was drawn:
// each node's offset to the new clip, and the speed it was changing at,
// decayed over `seconds` (#574). False, and the clip playing on, when the
// file has no animation by that name.
play_blended(f: *Figure, name: string, rate: float, loops: bool, seconds: float) -> bool {
    return play_blended_at(f, name, 0.0, rate, loops, seconds)
}

// As play_blended, the new clip entered `at` seconds in rather than at its
// first frame: what motion matching asks, a moment of a clip that fits
// (#586).
play_blended_at(f: *Figure, name: string, at: float, rate: float, loops: bool, seconds: float) -> bool {
    if f == null { return false }
    if seconds <= 0.0 {
        if !play(f, name, rate, loops) { return false }
        set_time(f, at)
        return true
    }
    if gltf.animation_duration(f.file as *GltfScene, name) <= 0.0 && !has_clip(f, name) { return false }
    old_now = copy_pose(f, f.drawn)
    old_before = copy_pose(f, f.drawn_before)
    old_posed = copy_pose(f, f.posed)
    old_base = copy_pose(f, f.base)
    if !play(f, name, rate, loops) {
        free(old_now)
        free(old_before)
        free(old_posed)
        free(old_base)
        return false
    }
    f.time = wrapped(f, at)
    players = f.players as *Registry
    k = 0
    while k < anim.registry_count(players) {
        anim.player_set_time(anim.binding_player(anim.registry_binding(players, k)), f.time)
        k = k + 1
    }
    clip_onto_base(f, players)
    file = f.file as *GltfScene
    dt = f.frame_seconds
    if dt <= 0.0 { dt = 1.0 / 60.0 }
    was = old_now as float[]
    was_before = old_before as float[]
    posed = old_posed as float[]
    own = old_base as float[]
    keyed = f.keyed as int[]
    inertia = f.inertia as float[]
    i = 0
    while i < f.nodes {
        m = gltf.model(file, i)
        at = i * POSE_FLOATS
        off = i * INERTIA_FLOATS
        // The offset is the figure's own (#673): from its drawing, less
        // what other writers had put on the node under it (the node as
        // posed against the figure's base, a turn on the node's side), to
        // the new clip's turn or place where it keys them, and where it
        // does not, to the figure's own pose. Taken in, another writer's
        // move rode the transition: the feet's pelvis drop, on a walker
        // going from its Idle to its Walk, was carried down with the blend
        // while the feet dropped the pelvis again, and its foot was set
        // 13 cm under the ground.
        new_q = m.rotation
        new_p = m.position
        if !has_turn(keyed[i]) { new_q = node_quat(own, at) }
        if !has_place(keyed[i]) { new_p = node_pos(own, at) }
        others_q = core.quat_mul(core.quat_conjugate(node_quat(own, at)), node_quat(posed, at))
        others_p = core.v3_sub(node_pos(posed, at), node_pos(own, at))
        was_q = core.quat_mul(node_quat(was, at), core.quat_conjugate(others_q))
        before_q = core.quat_mul(node_quat(was_before, at), core.quat_conjugate(others_q))
        // The rotation's offset as an angle about an axis, and how fast it
        // was turning about that axis.
        q = core.quat_normalize(core.quat_mul(was_q, core.quat_conjugate(new_q)))
        if q.w < 0.0 { q = core.quat(0.0 - q.x, 0.0 - q.y, 0.0 - q.z, 0.0 - q.w) }
        half_sin = core.sqrt_of(q.x * q.x + q.y * q.y + q.z * q.z)
        angle = 2.0 * core.atan2_of(half_sin, q.w)
        axis = core.vec3(0.0, 1.0, 0.0)
        if half_sin > 0.0000001 { axis = core.vec3(q.x / half_sin, q.y / half_sin, q.z / half_sin) }
        qb = core.quat_normalize(core.quat_mul(before_q, core.quat_conjugate(new_q)))
        if qb.w < 0.0 { qb = core.quat(0.0 - qb.x, 0.0 - qb.y, 0.0 - qb.z, 0.0 - qb.w) }
        angle_before = 2.0 * core.atan2_of(qb.x * axis.x + qb.y * axis.y + qb.z * axis.z, qb.w)
        inertia[off] = axis.x
        inertia[off + 1] = axis.y
        inertia[off + 2] = axis.z
        quintic(inertia, off + 3, angle, (angle - angle_before) / dt, seconds)
        // The position's, axis by axis.
        p_was = core.v3_sub(node_pos(was, at), others_p)
        p_before = core.v3_sub(node_pos(was_before, at), others_p)
        quintic(inertia, off + 3 + QUINTIC, p_was.x - new_p.x, (p_was.x - p_before.x) / dt, seconds)
        quintic(inertia, off + 3 + 2 * QUINTIC, p_was.y - new_p.y, (p_was.y - p_before.y) / dt, seconds)
        quintic(inertia, off + 3 + 3 * QUINTIC, p_was.z - new_p.z, (p_was.z - p_before.z) / dt, seconds)
        i = i + 1
    }
    free(old_now)
    free(old_before)
    free(old_posed)
    free(old_base)
    f.blend_t = 0.0
    f.blend_time = seconds
    decay(f, 0.0)
    apply_layers(f, 0.0)
    remember(f)
    return true
}

has_clip(f: *Figure, name: string) -> bool {
    i = 0
    while i < clip_count(f) {
        if clip_name(f, i) == name { return true }
        i = i + 1
    }
    return false
}

copy_pose(f: *Figure, source: ptr) -> ptr {
    out = calloc(f.nodes * POSE_FLOATS + 1, 8)
    a = out as float[]
    b = source as float[]
    k = 0
    while k < f.nodes * POSE_FLOATS {
        a[k] = b[k]
        k = k + 1
    }
    return out
}

// Whether a transition is still decaying.
blending(f: *Figure) -> bool { return f != null && f.blend_time > 0.0 }

// The clip's pose, under the offsets as they are `delta` further on.
decay(f: *Figure, delta: float) {
    f.blend_t = f.blend_t + delta
    t = f.blend_t
    file = f.file as *GltfScene
    inertia = f.inertia as float[]
    i = 0
    while i < f.nodes {
        off = i * INERTIA_FLOATS
        m = gltf.model(file, i)
        angle = quintic_at(inertia, off + 3, t, f.blend_time)
        if angle != 0.0 {
            turn = core.quat_rotate(angle, core.vec3(inertia[off], inertia[off + 1], inertia[off + 2]))
            core.model_set_rotation(m, core.quat_normalize(core.quat_mul(turn, m.rotation)))
        }
        dx = quintic_at(inertia, off + 3 + QUINTIC, t, f.blend_time)
        dy = quintic_at(inertia, off + 3 + 2 * QUINTIC, t, f.blend_time)
        dz = quintic_at(inertia, off + 3 + 3 * QUINTIC, t, f.blend_time)
        if dx != 0.0 || dy != 0.0 || dz != 0.0 {
            core.model_set_position(m, m.position.x + dx, m.position.y + dy, m.position.z + dz)
        }
        i = i + 1
    }
    if t >= f.blend_time {
        f.blend_time = 0.0
        f.blend_t = 0.0
    }
}

// --- layers (#574) -------------------------------------------------------------------------------------

// `name` over the bones under `bone_name` (and that bone) at `weight`, or,
// `additive`, its change from its own first frame added to the pose
// beneath: the layer's number, or -1 when the file has no such clip or no
// such bone. A bone named "" is every bone.
layer_play(f: *Figure, name: string, bone_name: string, weight: float, additive: bool, loops: bool) -> int {
    if f == null { return 0 - 1 }
    root = null as *Model
    if bone_name != "" {
        root = find_node(f, bone_name)
        if root == null { return 0 - 1 }
    }
    return layer_play_under(f, name, root, weight, additive, loops)
}

find_node(f: *Figure, name: string) -> *Model {
    file = f.file as *GltfScene
    i = 0
    while i < f.nodes {
        m = gltf.model(file, i)
        if core.text(m.name) == name { return m }
        i = i + 1
    }
    return null
}

// As layer_play, its mask the bones under `root` (null for every bone).
layer_play_under(f: *Figure, name: string, root: *Model, weight: float, additive: bool, loops: bool) -> int {
    if f == null { return 0 - 1 }
    r = anim.registry_new()
    made = gltf.play(f.file as *GltfScene, name, r, loops)
    if made == 0 {
        anim.registry_free(r)
        return 0 - 1
    }
    layer = calloc(1, sizeof(FigureLayer)) as *FigureLayer
    layer.players = r as ptr
    layer.root = root as ptr
    layer.weight = weight
    layer.additive = additive
    layer.speed = 1.0
    layer.looping = loops
    layer.duration = gltf.animation_duration(f.file as *GltfScene, name)
    // Its first frame, read and given back: what an additive layer is the
    // change from.
    layer.reference = calloc(f.nodes * POSE_FLOATS + 1, 8)
    file = f.file as *GltfScene
    base = calloc(f.nodes * POSE_FLOATS + 1, 8)
    i = 0
    while i < f.nodes {
        read_node(gltf.model(file, i), base as float[], i * POSE_FLOATS)
        i = i + 1
    }
    layer_pose(layer, 0.0)
    i = 0
    while i < f.nodes {
        read_node(gltf.model(file, i), layer.reference as float[], i * POSE_FLOATS)
        put_node(gltf.model(file, i), base as float[], i * POSE_FLOATS)
        i = i + 1
    }
    free(base)
    list.add_raw(f.layers, layer as ptr)
    return list.size(f.layers) - 1
}

put_node(m: *Model, b: float[], at: int) {
    core.model_set_position(m, b[at], b[at + 1], b[at + 2])
    core.model_set_rotation(m, node_quat(b, at))
}

layer_set_weight(f: *Figure, index: int, weight: float) {
    layer = layer_at(f, index)
    if layer != null { layer.weight = weight }
}

// A layer off; the ones above it move down.
layer_stop(f: *Figure, index: int) {
    layer = layer_at(f, index)
    if layer == null { return }
    layer_free(layer)
    list.remove(f.layers, index)
}

layer_count(f: *Figure) -> int {
    if f == null || f.layers == null { return 0 }
    return list.size(f.layers)
}

layer_at(f: *Figure, index: int) -> *FigureLayer {
    if f == null || f.layers == null || index < 0 || index >= list.size(f.layers) { return null }
    return list.get_raw(f.layers, index) as *FigureLayer
}

layer_free(layer: *FigureLayer) {
    anim.registry_free(layer.players as *Registry)
    free(layer.reference)
    free(layer as ptr)
}

// A layer's clip at `seconds`, onto the nodes it animates.
layer_pose(layer: *FigureLayer, seconds: float) {
    r = layer.players as *Registry
    i = 0
    while i < anim.registry_count(r) {
        anim.player_set_time(anim.binding_player(anim.registry_binding(r, i)), seconds)
        i = i + 1
    }
    anim.registry_apply(r)
}

// Whether `m` is `root` or hangs under it.
under(m: *Model, root: *Model) -> bool {
    if root == null { return true }
    at = m
    while at != null {
        if at == root { return true }
        at = at.parent as *Model
    }
    return false
}

// Every layer on, `delta` further, over what the clip and the layers below
// posed.
apply_layers(f: *Figure, delta: float) {
    if f.layers == null || list.size(f.layers) == 0 { return }
    file = f.file as *GltfScene
    base = calloc(f.nodes * POSE_FLOATS + 1, 8)
    b = base as float[]
    k = 0
    while k < list.size(f.layers) {
        layer = list.get_raw(f.layers, k) as *FigureLayer
        layer.time = layer.time + delta * layer.speed
        if layer.duration > 0.0 {
            if layer.looping {
                while layer.time >= layer.duration { layer.time = layer.time - layer.duration }
            } else if layer.time > layer.duration {
                layer.time = layer.duration
            }
        }
        i = 0
        while i < f.nodes {
            read_node(gltf.model(file, i), b, i * POSE_FLOATS)
            i = i + 1
        }
        layer_pose(layer, layer.time)
        ref = layer.reference as float[]
        w = layer.weight
        i = 0
        while i < f.nodes {
            m = gltf.model(file, i)
            at = i * POSE_FLOATS
            base_q = node_quat(b, at)
            base_p = node_pos(b, at)
            if !under(m, layer.root as *Model) || w <= 0.0 {
                put_node(m, b, at)
            } else if layer.additive {
                // The layer's change since its first frame, at the weight, on
                // top of the pose beneath.
                change = core.quat_normalize(core.quat_mul(m.rotation, core.quat_conjugate(node_quat(ref, at))))
                turn = core.quat_slerp(core.quat_ident(), change, w)
                moved = core.v3_mul(core.v3_sub(m.position, node_pos(ref, at)), w)
                core.model_set_rotation(m, core.quat_normalize(core.quat_mul(turn, base_q)))
                core.model_set_position(m, base_p.x + moved.x, base_p.y + moved.y, base_p.z + moved.z)
            } else if w < 1.0 {
                core.model_set_rotation(m, core.quat_slerp(base_q, m.rotation, w))
                core.model_set_position(m, base_p.x + (m.position.x - base_p.x) * w, base_p.y + (m.position.y - base_p.y) * w,
                                        base_p.z + (m.position.z - base_p.z) * w)
            }
            i = i + 1
        }
        k = k + 1
    }
    free(base)
}
