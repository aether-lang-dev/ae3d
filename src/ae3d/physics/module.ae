// Physics: aephysics's world in the engine's loop, in the shape Unity
// gives it. A Physics is a behaviour on the engine: at every fixed step
// it steps the world and writes each simulated body's transform onto
// the game object that carries it. A Rigidbody is the component that
// puts an object in that world (dynamic, kinematic or static, as
// Unity's Rigidbody and its absence mean); colliders add the shapes --
// a box, a sphere, a capsule, a triangle mesh -- with a material; a
// Ragdoll is aephysics's twelve-bone human, each bone a game object of
// its own so the renderer draws it and a script can reach it.
//
//     p = physics.attach(e)
//     ground = engine.object(e, "Ground", loader.cube(1.0))
//     physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.6, 0.0))
//     crate = engine.object(e, "Crate", loader.cube(1.0))
//     physics.rigidbody(crate, physics.DYNAMIC)
//     physics.box_collider(crate, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
//
// The physics engine is aephysics (deps/aephysics), a rigid body engine
// written in Aether on Box3D's design; its own tests and benchmarks
// hold it to the reference, and this module is only the seam: the
// objects' transforms in, the bodies' transforms out, once per fixed
// step. Its math types (Vec3, Quat) are the engine's own, defined the
// same way, so a transform crosses without conversion.
import std.list
import std.heap
import std.string
import aephysics.math
import aephysics.hull
import aephysics.manifold
import aephysics.mesh
import aephysics.material
import aephysics.shape
import aephysics.dynamics
import aephysics.physics_world
import aephysics.human
import aephysics.joint_solver
import aephysics.mover
import ae3d.core
import ae3d.geometry
import ae3d.jobs
import ae3d.behaviour
import ae3d.engine
import ae3d.loader
import ae3d.skin
import ae3d.scene
import ae3d.viewpoint
import std.strarr

exports (
    Physics, Rigidbody, Ragdoll, Vehicle,
    DYNAMIC, KINEMATIC, STATIC, KIND_RIGIDBODY, WHEEL_COUNT,
    attach, of, physics_free, physics_world_id, physics_step_count, physics_set_gravity, physics_body_count, physics_shape_count,
    material, rigidbody, rigidbody_remove, collider_remove, rigidbody_count, rigidbody_of, rigidbody_body, rigidbody_set_kind, rigidbody_kind, rigidbody_set_velocity, rigidbody_velocity, rigidbody_place,
    rigidbody_apply_impulse, rigidbody_apply_force, rigidbody_is_awake, rigidbody_set_damping, rigidbody_enable_hit_events,
    box_collider, sphere_collider, capsule_collider, mesh_collider, hull_collider,
    hull_of_mesh, mesh_of_mesh, convex_collider_of_model, mesh_collider_of_model,
    vehicle, vehicle_free, vehicle_drive, vehicle_speed, vehicle_chassis, vehicle_wheel,
    ragdoll, ragdoll_free, ragdoll_bone, ragdoll_human, ragdoll_set_velocity, ragdoll_still, ragdoll_kick,
    ragdoll_stand, ragdoll_release, ragdoll_is_standing, ragdoll_turn, ragdoll_of_shape, hit_event_count, hit_event,
    ragdoll_dress, ragdoll_dress_named, ragdoll_is_dressed, humanoid_bone, ragdoll_bone_axis, ragdoll_bone_speed,
    ragdoll_hold_shape, ragdoll_let_go_shape, ragdoll_is_holding_shape,
    HUMANOID_ENGINE, HUMANOID_MIXAMO, HUMANOID_MIXAMO_BARE, HUMANOID_UNREAL, humanoid_scheme, humanoid_scheme_bone, ragdoll_dress_humanoid,
    ragdoll_follow, ragdoll_is_following, ragdoll_power, ragdoll_is_powered, ragdoll_set_bone_drive,
    ragdoll_bone_drive_torque, ragdoll_set_balance_assist, ragdoll_aim, ragdoll_clear_aim, ragdoll_clear_aims, ragdoll_is_aimed, ragdoll_balance_assist,
    ragdoll_apply_impulse, ragdoll_bone_rotation, ragdoll_bone_target, RagdollHit, ragdoll_at, ray_hits, ray_hit_object, ray_distance, ray_static_distance, ray_static_hits, ray_static_hit, StaticRayHit, ragdoll_physics, capsule_clear,
    ragdoll_center_of_mass, ragdoll_set_soles, ragdoll_mass, ragdoll_set_mass, ragdoll_height, ragdoll_segment_share, person_mass, ragdoll_joint_error, ragdoll_tilt,
    POSE_STRIDE, ragdoll_body_pose, ragdoll_animation_pose, ragdoll_move_animation, ragdoll_show_pose,
    ragdoll_restore_animation, ragdoll_pose_lowest, ragdoll_pose_end, ragdoll_rig_bone_rotation, ragdoll_rest_forward,
    ragdoll_set_bone_limp, ragdoll_bone_is_limp, ragdoll_free_flanks, ragdoll_flanks_free, ragdoll_cross_legs, ragdoll_draw_toward_clip, ragdoll_clip_local, ragdoll_rig_bone, ragdoll_draw_bone_from_body,
    ragdoll_park, ragdoll_unpark, ragdoll_is_parked, ragdoll_to_rig,
    CharacterController, character_controller, character_ignore, character_of, character_feet, character_move, character_grounded, character_velocity,
    character_ground_normal, character_free, character_set_slope_limit, character_set_step_height, character_overlap, character_overlap_world,
    spec_of, apply_spec, attachments
)

// A powered joint's motor closes the gap to its pose in this many seconds,
// at no more than POWER_SPIN radians a second.
const TOE_UP = 0.02                    // m over the ground a drawn toe is kept
const TOE_LOOK = 1.0                   // m above the ankle the ground is looked for from
const POWER_TAU = 0.05
// A fitted foot's capsule ends, from the shin, on a shin FOOT_SHIN long
// (the reference's), in proportion on another (level_feet).
const FOOT_AHEAD = 0.12
const FOOT_BEHIND = 0.05
const FOOT_SHIN = 0.45
const POWER_SPIN = 20.0
// A held shape (ragdoll_hold_shape) gives within this of itself: inside it
// a joint's motor brakes rather than chases, so a figure lying in the
// shape it landed in comes to rest and sleeps. Chasing every last
// fraction of a degree, 22 forward and 24 sideways fallers of 30 lay still
// within 3 s of landing; braking within it, 29 and 29 (tests/test_falls.ae).
const HOLD_SLACK = 0.02
const POWER_ASSIST_HERTZ = 60.0
const POWER_BLEND = 0.25
const LIMP_FRICTION = 0.1
// A knee bends KNEE_FLEX radians (130 degrees) from straight, as a
// person's does, and straightens no further than straight (#578).
const KNEE_FLEX = 2.3
// A world holding a powered figure steps in POWERED_SUB_STEPS sub-steps,
// not 4 (#579). At 4 a joint's constraint, at its 60 Hz, sits on the
// solver's limit of a quarter of the sub-step rate, and against the
// motors' drive every body of a figure standing untouched turned at
// 0.56 rad/s on average, 1.6 at most: the whole figure trembled. At 8 it
// is 0.0035 and 0.04. Softening the joints instead (20 Hz at 4) quietened
// it as well but left the limbs too soft to writhe or to catch a fall.
// It costs 34 us a figure a step against 23 (tests/test_motion_cost.ae),
// and a world with no powered figure keeps its 4.
const POWERED_SUB_STEPS = 8

extern sqrt(x: float) -> float
extern acos(x: float) -> float
extern atan2(y: float, x: float) -> float
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const DYNAMIC = 0
const KINEMATIC = 1
const STATIC = 2

// The component kind of a Rigidbody, after the behaviour module's own.
const KIND_RIGIDBODY = 9

// The world and what it drives.
struct Physics {
    engine: ptr                    // *Engine
    behaviour: ptr                 // *Behaviour, the step in the loop
    world_id: WorldId
    rigidbodies: ptr               // list of *Rigidbody
    ragdolls: ptr                  // list of *Ragdoll
    characters: ptr                // list of *CharacterController in this world
    sub_steps: int
    step_count: int
}

// A body on a game object.
struct Rigidbody {
    physics: ptr                   // *Physics
    object: ptr                    // *GameObject
    body_id: BodyId
    kind: int
    collider: int                  // the first collider's kind (COLLIDER_BOX ...), or 0 for none yet
    friction: float
    restitution: float
    density: float
    colliders: ptr                 // list of *Collider: its shapes, and what each was made from
}

// A shape on a body and the hull or mesh it was made from, which the world
// holds by reference: released with the shape when nothing else holds it.
struct Collider {
    shape: ShapeId
    hull: ptr                      // *HullData, or null
    mesh: ptr                      // *MeshData, or null
}

// A ragdoll: aephysics's human, and a game object per bone. Standing,
// its pelvis is sprung upright to the ground (human_align_spring) until
// released, when it falls as the figure it is.
struct Ragdoll {
    physics: ptr
    human: Human
    bones: ptr                     // list of *GameObject, in human's bone order
    standing: bool
    rig: ptr                       // *Rig, the skinned figure the ragdoll drives, or null
    following: bool                // the other way round: the rig drives the ragdoll, through its anchors
    powered: bool                  // following through its joints' motors within a torque budget, the root free
    friction: float                // newton metres: the joints' motors' friction when not powered
    aims: ptr                      // float[BONE_COUNT * 5]: per bone, aimed (0/1) and a world rotation; null when none ever was
    held: ptr                      // float[BONE_COUNT * 4]: each joint's relative rotation, held (ragdoll_hold_shape); null when none ever was
    holding: bool
    // Powered, the rig is drawn as the bodies are; the animation's pose,
    // which the muscles track, is kept beside it: each mapped bone's local
    // rotation and the root's local position and rotation as the animation
    // last set them (anim), the world rotations the joints are driven to
    // (targets), and what the bodies last wrote into the rig (written), so
    // what the animation wrote since can be told from it.
    anim: ptr                      // float[(BONE_COUNT + 1) * 7]: quat, then position (the root's)
    written: ptr                   // float[(BONE_COUNT + 1) * 7]
    written_valid: bool
    targets: ptr                   // float[BONE_COUNT * 4]
    targets_valid: bool
    // Powered from a rig that drove it, the drawing is the bodies' from the
    // first frame, under the offset the rig's pose had from them, which
    // fades over POWER_BLEND (#581): the bodies follow a rig of other
    // proportions only so closely (ten degrees, a limb), and drawn one way
    // and then the other the figure would jump. Blending from the rig's
    // pose to the bodies' instead, the drawing lagged a blow: 6 cm behind
    // the hips 0.08 s after it. The offset, and the seconds left.
    shown_from: ptr                // float[(BONE_COUNT + 1) * 7], the rig's locals' offsets from the bodies'
    shown_left: float
    // The arms passing the hips, the lower spine and the thighs while the
    // figure keeps to its clip (ragdoll_free_flanks): the filter joints.
    flanks: ptr                    // JointId[FLANK_PAIRS], or null
    flanks_free: bool
    flanks_held: int               // filter joints still kept, freeing them: their pairs overlap
    legs: ptr                      // JointId[LEG_PAIRS], or null: the legs passing as a foot crosses
    legs_crossing: bool
    legs_held: int
    // Out of the world: every body and anchor disabled, and the step
    // passes it by (ragdoll_park).
    parked: bool
    // Bones let go while the rest follows the rig or its muscles (#573):
    // int[BONE_COUNT], 1 for a limp bone, or null for none.
    limp: ptr
    // What it was made with, so dressing can build it again as the rig's
    // figure: its joints' springs, its filter group, and, standing, the
    // ground its pelvis is sprung to and that spring's.
    hertz: float
    damping_ratio: float
    group: int
    stand_ground: BodyId
    stand_hertz: float
    stand_damping_ratio: float
}

// A skinned figure worn by a ragdoll: a rig bone per ragdoll bone, each
// with the rotation that takes the body's frame to the bone's, and the
// rig's root carried by the pelvis.
struct RigBone {
    model: ptr                     // *Model, the rig bone
    offset: Quat                   // body rotation * offset = the bone's world rotation
    offset_p: Vec3                 // the bone's head from the body's origin, in the body's frame
}

struct Rig {
    skeleton: ptr                  // *Skeleton
    root: ptr                      // *Model, the rig's root
    bones: ptr                     // RigBone[human.BONE_COUNT]
    // RigBone[2], left then right: an ankle its calf does not parent -- a
    // foot an IK rig hangs from its root -- carried by the calf's body, so
    // the foot goes where the shin does. Model null where the calf parents
    // its ankle and the hierarchy carries it.
    feet: ptr
    root_offset_p: Vec3            // the root from the pelvis, in the pelvis's frame
    ankles: ptr                    // *Model[2]: the drawn ankles, left and right, or null
    toes: ptr                      // *Model[2]: their toes, or null
    ankle_own: ptr                 // Quat[2]: an ankle's own turn before toe_on_ground turned it
    ankle_turned: ptr              // int[2]: 1 while it is turned
    root_offset_q: Quat
}

// A car: a chassis and four wheels on wheel joints (Box3D's: the
// suspension along the chassis's up, the spin about the axle, the front
// pair steered), driven by a throttle, a steering angle and a brake.
const WHEEL_COUNT = 4
const WHEEL_FRONT_LEFT = 0
const WHEEL_FRONT_RIGHT = 1
const WHEEL_REAR_LEFT = 2
const WHEEL_REAR_RIGHT = 3

struct Vehicle {
    physics: ptr
    chassis: ptr                   // *Rigidbody
    wheels: ptr                    // *Rigidbody[WHEEL_COUNT]
    joints: ptr                    // JointId[WHEEL_COUNT]
    max_torque: float
    max_speed: float               // the spin motor's speed at full throttle, radians a second
    max_steer: float               // radians
}

var g_attached: ptr = null         // list of *Physics, to find an engine's

// The world in the engine's loop: gravity down, four sub-steps a fixed
// step, stepped on the engine's own job pool (AE3D_JOBS: this thread
// and the job workers), the same at any count to the bit.
attach(e: *Engine) -> *Physics {
    p = heap.new(Physics)
    p.engine = e as ptr
    wdef = dynamics.default_world_def()
    wdef.scheduler = jobs.scheduler()
    wdef.worker_count = jobs.threads()
    p.world_id = dynamics.create_world(&wdef)
    p.rigidbodies = list.new()
    p.ragdolls = list.new()
    p.characters = list.new()
    p.sub_steps = 4
    engine.engine_set_attachment_provider(e, physics_attachments, p as ptr)
    // Freed with the engine unless freed first.
    engine.engine_on_free(e, physics_released, p as ptr)
    p.step_count = 0
    // The camera the engine flies keeps out of this world's static bodies
    // from now on (ae3d.viewpoint): what the scene says stands still.
    viewpoint.use_world(engine.engine_viewpoint(e), p.world_id)
    b = engine.behaviour_new("physics", p as ptr)
    b.fixed_update = on_fixed_update
    b.pose = on_pose
    engine.engine_add_behaviour(e, b)
    p.behaviour = b as ptr
    if g_attached == null { g_attached = list.new() }
    list.add_raw(g_attached, p as ptr)
    return p
}

// The physics attached to an engine, or null.
of(e: *Engine) -> *Physics {
    if g_attached == null { return null }
    count = list.size(g_attached)
    i = 0
    while i < count {
        p = list.get_raw(g_attached, i) as *Physics
        if p.engine == e as ptr { return p }
        i = i + 1
    }
    return null
}

physics_world_id(p: *Physics) -> WorldId { return p.world_id }
physics_step_count(p: *Physics) -> int { return p.step_count }
physics_body_count(p: *Physics) -> int { return physics_world.get_counters(p.world_id).body_count }
physics_shape_count(p: *Physics) -> int { return physics_world.get_counters(p.world_id).shape_count }
physics_set_gravity(p: *Physics, gravity: Vec3) { physics_world.set_gravity(p.world_id, gravity) }

// The step, and every simulated body's transform onto its object. A
// kinematic body goes the other way: the object's transform is where
// the game put it, and the body is driven there over the step -- as a
// velocity, so the solver sees it move and what rides on it comes along.
on_fixed_update(state: ptr, e: *Engine, step: float) {
    p = state as *Physics
    count = list.size(p.rigidbodies)
    i = 0
    while i < count {
        rb = list.get_raw(p.rigidbodies, i) as *Rigidbody
        if rb.kind == KINEMATIC { push_transform(rb, step) }
        i = i + 1
    }
    // A ragdoll that follows its rig takes the rig's pose as its anchors'
    // targets for this step, before the world moves.
    ragdoll_count = list.size(p.ragdolls)
    sub_steps = p.sub_steps
    k = 0
    while k < ragdoll_count {
        r = list.get_raw(p.ragdolls, k) as *Ragdoll
        if r.parked {
            // out of the world: nothing to drive
        } else if r.powered && r.following {
            if r.rig != null { refresh_targets(r) }
            drive_joints(r, step)
            if sub_steps < POWERED_SUB_STEPS { sub_steps = POWERED_SUB_STEPS }
        } else if r.following {
            drive_anchors(r, step)
        }
        k = k + 1
    }
    // A character nothing moves stands where it is, under gravity and on
    // the ground: one from a scene record, say, before a script walks it.
    k = 0
    while k < list.size(p.characters) {
        ch = list.get_raw(p.characters, k) as *CharacterController
        if !ch.driven { character_step(ch, core.vec3(0.0, 0.0, 0.0), 0.0, step) }
        k = k + 1
    }
    physics_world.step(p.world_id, step, sub_steps)
    p.step_count = p.step_count + 1
    i = 0
    while i < count {
        rb = list.get_raw(p.rigidbodies, i) as *Rigidbody
        if rb.kind == DYNAMIC { pull_transform(rb) }
        i = i + 1
    }
    i = 0
    while i < count {
        rb = list.get_raw(p.rigidbodies, i) as *Rigidbody
        if rb.kind == KINEMATIC { pull_transform(rb) }
        i = i + 1
    }
    count = list.size(p.ragdolls)
    i = 0
    while i < count {
        r = list.get_raw(p.ragdolls, i) as *Ragdoll
        if !r.parked {
            pull_ragdoll(r)
            if r.rig != null && r.following == false { show_bodies(r, step) }
            if r.rig != null && r.powered && r.following { show_bodies(r, step) }
        }
        i = i + 1
    }
}

// The frame's pose phase, after the clips: every ragdoll that draws its
// figure from its bodies takes the frame's clip pose for its animation and
// draws the figure again. The bodies drew it at the fixed step, but a clip
// played in the update after -- even one held on a frame under a struck
// walker -- posed the rig again, and what it posed and the bodies do not
// (the feet a calf carries, the hips' place) was drawn as the clip had it:
// a struck walker's drawn feet 5 to 50 cm in the ground, its bodies on it.
on_pose(state: ptr, e: *Engine) {
    p = state as *Physics
    count = list.size(p.ragdolls)
    i = 0
    while i < count {
        r = list.get_raw(p.ragdolls, i) as *Ragdoll
        if !r.parked && r.rig != null && (r.following == false || (r.powered && r.following)) {
            capture_animation(r)
            draw_bodies(r)
        }
        i = i + 1
    }
}

// A body lives in the world; its object may live in a group (a parent
// at some place), so the transforms cross in world space either way.
pull_transform(rb: *Rigidbody) {
    o = rb.object as *GameObject
    t = dynamics.body_get_transform(rb.body_id)
    behaviour.object_set_world_position(o, t.p)
    behaviour.object_set_world_rotation(o, t.q)
}

push_transform(rb: *Rigidbody, step: float) {
    o = rb.object as *GameObject
    target = Transform { p: behaviour.object_world_position(o), q: behaviour.object_world_rotation(o) }
    dynamics.body_set_target_transform(rb.body_id, target, step, true)
}

// The world, its bodies and the shapes' data. The objects stay the
// scene's, where they are, without their Rigidbody components: freed
// while its objects are still the scene's (before the scene), so that
// the components can be taken off them -- and so that the same objects
// can be given bodies again, as the editor's simulation does.
physics_released(state: ptr) {
    physics_free(state as *Physics)
}

physics_free(p: *Physics) {
    if p == null { return }
    e = p.engine as *Engine
    engine.engine_remove_on_free(e, p as ptr)
    // Out of the engine's list, the step is the physics's to free: the
    // engine frees only the behaviours it still holds.
    if p.behaviour != null {
        engine.engine_remove_behaviour(e, p.behaviour as *Behaviour)
        heap.free(p.behaviour as *Behaviour)
        p.behaviour = null
    }
    engine.engine_remove_attachment_provider(e, p as ptr)
    // The world is going: the camera goes back to the scene's own models.
    viewpoint.use_models(engine.engine_viewpoint(e))
    // Every body off its object, the last first: the component's destroy
    // hook releases the body, its shapes' hulls and meshes and its record.
    while list.size(p.rigidbodies) > 0 {
        rb = list.get_raw(p.rigidbodies, list.size(p.rigidbodies) - 1) as *Rigidbody
        o = rb.object as *GameObject
        c = behaviour.object_find_component(o, KIND_RIGIDBODY)
        if c != null && behaviour.component_state(c) == rb as ptr {
            behaviour.object_remove_component(o, c)
        } else {
            release_rigidbody(rb)
        }
    }
    count = list.size(p.ragdolls)
    i = 0
    while i < count {
        ragdoll_let_go(list.get_raw(p.ragdolls, i) as *Ragdoll)
        i = i + 1
    }
    count = list.size(p.characters)
    i = 0
    while i < count {
        ch = list.get_raw(p.characters, i) as *CharacterController
        if ch.owned {
            character_release(ch)
        } else {
            ch.physics = null
        }
        i = i + 1
    }
    list.free(p.characters)
    dynamics.destroy_world(p.world_id)
    list.free(p.rigidbodies)
    list.free(p.ragdolls)
    if g_attached != null {
        n = list.size(g_attached)
        i = 0
        while i < n {
            if list.get_raw(g_attached, i) == p as ptr { list.remove(g_attached, i); break }
            i = i + 1
        }
    }
    heap.free(p)
}

// --- rigid bodies --------------------------------------------------------------------------------------------

// A surface: Coulomb friction, restitution (the bounce), no rolling resistance.
material(friction: float, restitution: float) -> SurfaceMaterial {
    m = material.default_surface_material()
    m.friction = friction
    m.restitution = restitution
    return m
}

// The object in the world: a body at its position and rotation, of the
// kind asked (a dynamic one falls and collides, a kinematic one is moved
// by the game and pushes, a static one never moves). Unity's AddComponent
// of a Rigidbody; the colliders below give it shapes and therefore mass.
rigidbody(o: *GameObject, kind: int) -> *Rigidbody {
    e = engine.of(o)
    p = of(e)
    if p == null { return null }
    existing = rigidbody_of(o)
    if existing != null { return existing }
    rb = heap.new(Rigidbody)
    rb.physics = p as ptr
    rb.object = o as ptr
    rb.kind = kind
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    if kind == KINEMATIC { bdef.kind = dynamics.BODY_KINEMATIC }
    if kind == STATIC { bdef.kind = dynamics.BODY_STATIC }
    bdef.position = behaviour.object_world_position(o)
    bdef.rotation = behaviour.object_world_rotation(o)
    // The body says whose it is, so a query that meets it can name the object.
    bdef.user_data = rb as ptr
    rb.body_id = dynamics.create_body(p.world_id, &bdef)
    rb.colliders = list.new()
    c = behaviour.component_new("Rigidbody", KIND_RIGIDBODY, rb as ptr)
    // Destroying the object, or taking the component off, takes the body
    // out of the world with it, as Unity's Destroy does (#549). Left in, it
    // collided where the object had been and the step wrote its transform
    // into the freed object.
    c.destroy = rigidbody_gone
    behaviour.object_add_component(o, c)
    list.add_raw(p.rigidbodies, rb as ptr)
    return rb
}

// The component's destroy hook.
rigidbody_gone(state: ptr, o: *GameObject) {
    release_rigidbody(state as *Rigidbody)
}

// A body gone from its world: the body (its shapes, contacts and joints
// with it), the hulls and meshes its shapes were made from where no
// other body's shape holds them, and its record.
release_rigidbody(rb: *Rigidbody) {
    p = rb.physics as *Physics
    if dynamics.body_is_valid(rb.body_id) { dynamics.destroy_body(rb.body_id) }
    n = list.size(p.rigidbodies)
    i = 0
    while i < n {
        if list.get_raw(p.rigidbodies, i) == rb as ptr {
            list.remove(p.rigidbodies, i)
            break
        }
        i = i + 1
    }
    while list.size(rb.colliders) > 0 {
        col = list.get_raw(rb.colliders, 0) as *Collider
        list.remove(rb.colliders, 0)
        release_source(p, col)
        heap.free(col)
    }
    list.free(rb.colliders)
    heap.free(rb)
}

// A collider's hull or mesh destroyed, unless another collider in the
// world was made from the same one.
release_source(p: *Physics, col: *Collider) {
    if col.hull != null && !held(p, col.hull, true) { hull.destroy_hull(col.hull as *HullData) }
    if col.mesh != null && !held(p, col.mesh, false) { mesh.destroy_mesh(col.mesh as *MeshData) }
}

held(p: *Physics, source: ptr, is_hull: bool) -> bool {
    i = 0
    while i < list.size(p.rigidbodies) {
        rb = list.get_raw(p.rigidbodies, i) as *Rigidbody
        k = 0
        while k < list.size(rb.colliders) {
            col = list.get_raw(rb.colliders, k) as *Collider
            if is_hull && col.hull == source { return true }
            if !is_hull && col.mesh == source { return true }
            k = k + 1
        }
        i = i + 1
    }
    return false
}

// The object's body taken out of the world, the object kept: a wall's
// part that falls as debris and then lies as rubble.
rigidbody_remove(o: *GameObject) {
    if o == null { return }
    c = behaviour.object_find_component(o, KIND_RIGIDBODY)
    if c != null { behaviour.object_remove_component(o, c) }
}

// One collider off the object's body, its hull or mesh released where no
// other collider holds it; the body's mass follows. False when the body
// has no such shape.
collider_remove(o: *GameObject, shape: ShapeId) -> bool {
    rb = rigidbody_of(o)
    if rb == null { return false }
    i = 0
    while i < list.size(rb.colliders) {
        col = list.get_raw(rb.colliders, i) as *Collider
        if col.shape.index1 == shape.index1 && col.shape.world0 == shape.world0 && col.shape.generation == shape.generation {
            dynamics.destroy_shape(col.shape, true)
            list.remove(rb.colliders, i)
            release_source(rb.physics as *Physics, col)
            heap.free(col)
            return true
        }
        i = i + 1
    }
    return false
}

// How many bodies the physics holds for game objects.
rigidbody_count(p: *Physics) -> int {
    if p == null { return 0 }
    return list.size(p.rigidbodies)
}

// A shape put on a body, kept with what it was made from.
keep_collider(rb: *Rigidbody, shape: ShapeId, h: ptr, md: ptr) -> ShapeId {
    col = heap.new(Collider)
    col.shape = shape
    col.hull = h
    col.mesh = md
    list.add_raw(rb.colliders, col as ptr)
    return shape
}

rigidbody_of(o: *GameObject) -> *Rigidbody {
    c = behaviour.object_find_component(o, KIND_RIGIDBODY)
    if c == null { return null }
    return c.state as *Rigidbody
}

// A body's kind now: DYNAMIC, KINEMATIC or STATIC. A networked object's
// body on a client is kinematic while another peer simulates it (ae3d.net
// drives it where the host has it, and it pushes what it meets the way a
// kinematic body does), and given its kind back when the session lets it
// go.
rigidbody_set_kind(rb: *Rigidbody, kind: int) {
    if rb == null || rb.kind == kind { return }
    t = dynamics.BODY_DYNAMIC
    if kind == KINEMATIC { t = dynamics.BODY_KINEMATIC }
    if kind == STATIC { t = dynamics.BODY_STATIC }
    dynamics.body_set_type(rb.body_id, t)
    rb.kind = kind
}

rigidbody_kind(rb: *Rigidbody) -> int { return rb.kind }

rigidbody_body(rb: *Rigidbody) -> BodyId { return rb.body_id }
rigidbody_set_velocity(rb: *Rigidbody, v: Vec3) { dynamics.body_set_linear_velocity(rb.body_id, v) }

// The body put at `position` and `rotation` at once, for what queries the
// world next: a network session's rewind (#499) puts a body where a client
// drew it and back. Not a move -- nothing it passes is pushed -- and a
// kinematic body is driven back to its object at the next step.
rigidbody_place(rb: *Rigidbody, position: Vec3, rotation: Quat) {
    dynamics.body_set_transform(rb.body_id, position, rotation)
}
rigidbody_velocity(rb: *Rigidbody) -> Vec3 { return dynamics.body_get_linear_velocity(rb.body_id) }
rigidbody_apply_impulse(rb: *Rigidbody, impulse: Vec3) { dynamics.body_apply_linear_impulse_to_center(rb.body_id, impulse, true) }
rigidbody_apply_force(rb: *Rigidbody, force: Vec3) { dynamics.body_apply_force_to_center(rb.body_id, force, true) }
rigidbody_is_awake(rb: *Rigidbody) -> bool { return dynamics.body_is_awake(rb.body_id) }
rigidbody_set_damping(rb: *Rigidbody, linear: float, angular: float) {
    dynamics.body_set_linear_damping(rb.body_id, linear)
    dynamics.body_set_angular_damping(rb.body_id, angular)
}

// Hit events on every shape of the body: what it strikes faster than
// the world's threshold is reported by hit_event after the step.
rigidbody_enable_hit_events(rb: *Rigidbody, flag: bool) {
    p = rb.physics as *Physics
    ids_block = calloc(64, sizeof(ShapeId))
    ids = ids_block as ShapeId[]
    count = dynamics.body_get_shapes(rb.body_id, ids, 64)
    i = 0
    while i < count {
        dynamics.shape_enable_hit_events(ids[i], flag)
        i = i + 1
    }
    free(ids_block)
    physics_world.set_hit_event_threshold(p.world_id, 1.0)
}

hit_event_count(p: *Physics) -> int { return physics_world.contact_hit_event_count(p.world_id) }
hit_event(p: *Physics, index: int) -> ContactHitEvent { return physics_world.contact_hit_event(p.world_id, index) }

// The body a collider goes on: the object's, or a static one made for
// it, as a Unity collider without a Rigidbody is static.
body_for_collider(o: *GameObject) -> *Rigidbody {
    rb = rigidbody_of(o)
    if rb != null { return rb }
    return rigidbody(o, STATIC)
}

// A shape's definition: its material, and its density (the body's mass
// comes from its shapes' volumes and densities; water is 1).
shape_def(m: SurfaceMaterial, density: float) -> ShapeDef {
    sdef = dynamics.default_shape_def()
    sdef.base_material = m
    sdef.density = density
    return sdef
}

// The collider kinds the scene file names.
const COLLIDER_BOX = 1
const COLLIDER_SPHERE = 2
const COLLIDER_CAPSULE = 3
const COLLIDER_HULL = 4
const COLLIDER_MESH = 5

collider_name(kind: int) -> string {
    if kind == COLLIDER_BOX { return "box" }
    if kind == COLLIDER_SPHERE { return "sphere" }
    if kind == COLLIDER_CAPSULE { return "capsule" }
    if kind == COLLIDER_HULL { return "hull" }
    if kind == COLLIDER_MESH { return "mesh" }
    return ""
}

// The first collider's kind and material, kept on the body for the scene file.
note_collider(rb: *Rigidbody, kind: int, m: SurfaceMaterial, density: float) {
    if rb.collider != 0 { return }
    rb.collider = kind
    rb.friction = m.friction
    rb.restitution = m.restitution
    rb.density = density
}

// A box of these half extents about the object's origin.
box_collider(o: *GameObject, half_extents: Vec3, m: SurfaceMaterial, density: float = 1.0) -> ShapeId {
    rb = body_for_collider(o)
    if rb == null { return dynamics.null_shape_id() }
    box = hull.make_box_hull(half_extents.x, half_extents.y, half_extents.z)
    sdef = shape_def(m, density)
    note_collider(rb, COLLIDER_BOX, m, density)
    return keep_collider(rb, dynamics.create_hull_shape(rb.body_id, &sdef, box), box as ptr, null)
}

sphere_collider(o: *GameObject, radius: float, m: SurfaceMaterial, density: float = 1.0) -> ShapeId {
    rb = body_for_collider(o)
    if rb == null { return dynamics.null_shape_id() }
    sdef = shape_def(m, density)
    note_collider(rb, COLLIDER_SPHERE, m, density)
    return keep_collider(rb, dynamics.create_sphere_shape(rb.body_id, &sdef, manifold.sphere(math.vec3_zero(), radius)), null, null)
}

// A capsule between two centres in the object's frame.
capsule_collider(o: *GameObject, center1: Vec3, center2: Vec3, radius: float, m: SurfaceMaterial, density: float = 1.0) -> ShapeId {
    rb = body_for_collider(o)
    if rb == null { return dynamics.null_shape_id() }
    sdef = shape_def(m, density)
    note_collider(rb, COLLIDER_CAPSULE, m, density)
    return keep_collider(rb, dynamics.create_capsule_shape(rb.body_id, &sdef, manifold.capsule(center1, center2, radius)), null, null)
}

// A convex hull in the object's frame; the hull is the world's from
// here on, freed when the last collider made from it goes.
hull_collider(o: *GameObject, h: *HullData, m: SurfaceMaterial, density: float = 1.0) -> ShapeId {
    rb = body_for_collider(o)
    if rb == null || h == null { return dynamics.null_shape_id() }
    sdef = shape_def(m, density)
    note_collider(rb, COLLIDER_HULL, m, density)
    return keep_collider(rb, dynamics.create_hull_shape(rb.body_id, &sdef, h), h as ptr, null)
}

// A triangle mesh (static: a mesh shape on a body that moves is the
// reference's ground, not a dynamic shape), at a scale. The mesh is the
// world's from here on, freed when the last collider made from it goes.
mesh_collider(o: *GameObject, md: *MeshData, m: SurfaceMaterial, scale: Vec3 = math.vec3_one()) -> ShapeId {
    rb = body_for_collider(o)
    if rb == null || md == null { return dynamics.null_shape_id() }
    sdef = dynamics.default_shape_def()
    sdef.base_material = m
    note_collider(rb, COLLIDER_MESH, m, 0.0)
    return keep_collider(rb, dynamics.create_mesh_shape(rb.body_id, &sdef, md, scale), null, md as ptr)
}

// --- the scene file --------------------------------------------------------------------------------------------

// What the scene file records of an object's physics, or null when it
// has no body: the body's kind and its first collider's kind and
// material. The record is the scene's (`scene.PhysicsSpec`) and belongs
// to the caller.
spec_of(o: *GameObject) -> *PhysicsSpec {
    rb = rigidbody_of(o)
    if rb == null && character_of(o) != null { return scene.physics_spec_new("character", "capsule", 0.0, 0.0, 1.0) }
    if rb == null || rb.collider == 0 { return null }
    body = "dynamic"
    if rb.kind == KINEMATIC { body = "kinematic" }
    if rb.kind == STATIC { body = "static" }
    return scene.physics_spec_new(body, collider_name(rb.collider), rb.friction, rb.restitution, rb.density)
}

// A body and its collider on an object from the scene file's record: the
// collider from the object's own mesh -- a box of its bounds, a sphere or
// a capsule of them, the hull of its vertices, or its triangles. Answers
// the rigidbody, or null when the object has no mesh to make it from.
apply_spec(o: *GameObject, spec: *PhysicsSpec) -> *Rigidbody {
    if o == null || spec == null { return null }
    model = behaviour.object_model(o)
    if model == null || model.mesh == null { return null }
    if spec.body == "character" {
        character_of_spec(o, model)
        return null
    }
    kind = DYNAMIC
    if spec.body == "kinematic" { kind = KINEMATIC }
    if spec.body == "static" { kind = STATIC }
    rb = rigidbody(o, kind)
    if rb == null { return null }
    m = material(spec.friction, spec.restitution)
    size = core.mesh_size(model.mesh, model.scale)
    half = math.vec3(size.x * 0.5, size.y * 0.5, size.z * 0.5)
    if spec.collider == "sphere" {
        radius = half.x
        if half.y > radius { radius = half.y }
        if half.z > radius { radius = half.z }
        sphere_collider(o, radius, m, spec.density)
    } else if spec.collider == "capsule" {
        radius = half.x
        if half.z > radius { radius = half.z }
        reach = half.y - radius
        if reach < 0.0 { reach = 0.0 }
        capsule_collider(o, math.vec3(0.0, 0.0 - reach, 0.0), math.vec3(0.0, reach, 0.0), radius, m, spec.density)
    } else if spec.collider == "hull" {
        convex_collider_of_model(o, m, spec.density)
    } else if spec.collider == "mesh" {
        mesh_collider_of_model(o, m)
    } else {
        box_collider(o, half, m, spec.density)
    }
    return rb
}

// A character from a scene record: a capsule as wide as the mesh's widest
// half and as tall as it, its feet the mesh's lowest point -- where a
// figure modelled standing on its origin, or centred on it, stands.
// Answers null on an object with a character already.
character_of_spec(o: *GameObject, model: *Model) -> *CharacterController {
    if character_of(o) != null { return null }
    size = core.mesh_size(model.mesh, model.scale)
    radius = size.x * 0.5
    if size.z * 0.5 > radius { radius = size.z * 0.5 }
    if radius > size.y * 0.5 { radius = size.y * 0.5 }
    low = 0.0
    count = geometry.mesh_vertex_count(model.mesh)
    i = 0
    while i < count {
        y = geometry.mesh_pos_y(model.mesh, i)
        if i == 0 || y < low { low = y }
        i = i + 1
    }
    c = character_controller(o, radius, size.y)
    if c == null { return null }
    c.lift = 0.0 - low * model.scale.y
    c.owned = true
    return c
}

// Every object with a body, as the scene's attachments (a model and its
// physics record each): what a scene file records of this world. The
// list is the caller's, freed with scene.attachments_free.
attachments(p: *Physics) -> ptr {
    out = list.new()
    count = list.size(p.rigidbodies)
    i = 0
    while i < count {
        rb = list.get_raw(p.rigidbodies, i) as *Rigidbody
        o = rb.object as *GameObject
        model = behaviour.object_model(o)
        spec = spec_of(o)
        if model != null && spec != null {
            a = scene.attachment_new(model, "", "", null, null)
            scene.attachment_set_physics(a, spec)
            list.add_raw(out, a as ptr)
        } else if spec != null {
            heap.free(spec)
        }
        i = i + 1
    }
    // Characters, as a character record on their models.
    k = 0
    while k < list.size(p.characters) {
        ch = list.get_raw(p.characters, k) as *CharacterController
        o = ch.object as *GameObject
        model = behaviour.object_model(o)
        if model != null {
            a = scene.attachment_new(model, "", "", null, null)
            scene.attachment_set_physics(a, scene.physics_spec_new("character", "capsule", 0.0, 0.0, 1.0))
            list.add_raw(out, a as ptr)
        }
        k = k + 1
    }
    // A ragdoll's bone capsules are this module's, made again with the
    // ragdoll: the scene file leaves them out.
    ragdolls = list.size(p.ragdolls)
    k = 0
    while k < ragdolls {
        r = list.get_raw(p.ragdolls, k) as *Ragdoll
        b = 0
        while b < list.size(r.bones) {
            bone_model = behaviour.object_model(list.get_raw(r.bones, b) as *GameObject)
            if bone_model != null {
                a = scene.attachment_new(bone_model, "", "", null, null)
                scene.attachment_set_internal(a, true)
                list.add_raw(out, a as ptr)
            }
            b = b + 1
        }
        k = k + 1
    }
    return out
}

// The provider the engine asks when a scene is written.
physics_attachments(state: ptr) -> ptr {
    return attachments(state as *Physics)
}

// The convex hull of a drawn mesh's vertices, scaled: what a crate, a
// bin or a bench collides as. Null for a mesh with no volume.
hull_of_mesh(drawn: ptr, scale: Vec3) -> *HullData {
    count = core.mesh_vertex_count(drawn)
    if count < 4 { return null }
    block = calloc(count, sizeof(Vec3))
    points = block as Vec3[]
    i = 0
    while i < count {
        v = core.mesh_position(drawn, i)
        points[i] = math.vec3(v.x * scale.x, v.y * scale.y, v.z * scale.z)
        i = i + 1
    }
    // The hull with the most vertices the engine's hull holds. A drawn
    // mesh is not made for collision: a bevelled crate has 56 corners and
    // more edges than a hull may carry (128), so the builder refuses it
    // whole. Quickhull takes the points farthest from the hull first, so
    // a smaller vertex budget is the tightest hull of that many corners
    // -- the crate's box with its bevels a centimetre inside it -- and
    // the budget is halved until one builds.
    budget = hull.MAX_HULL_VERTICES
    h = null as *HullData
    while h == null && budget >= 8 {
        h = hull.create_hull(points, count, budget)
        budget = budget / 2
    }
    free(block)
    return h
}

// A drawn mesh as a collision mesh: its triangles, unscaled (the mesh
// collider takes the scale).
mesh_of_mesh(drawn: ptr) -> *MeshData {
    vertex_count = core.mesh_vertex_count(drawn)
    index_count = core.mesh_index_count(drawn)
    if vertex_count < 3 || index_count < 3 { return null }
    vertices_block = calloc(vertex_count, sizeof(Vec3))
    vertices = vertices_block as Vec3[]
    i = 0
    while i < vertex_count {
        vertices[i] = core.mesh_position(drawn, i)
        i = i + 1
    }
    indices_block = calloc(index_count, 4)
    indices = indices_block as int[]
    i = 0
    while i < index_count {
        indices[i] = core.mesh_index_at(drawn, i)
        i = i + 1
    }
    def = mesh.mesh_def()
    def.vertices = vertices_block
    def.indices = indices_block
    def.vertex_count = vertex_count
    def.triangle_count = index_count / 3
    def.weld_vertices = true
    def.weld_tolerance = 0.0001
    md = mesh.create_mesh(&def, null, 0)
    free(indices_block)
    free(vertices_block)
    return md
}

// The object's own model as its collider: convex (a prop, dynamic or
// not) from the hull of its vertices at the model's scale.
convex_collider_of_model(o: *GameObject, m: SurfaceMaterial, density: float = 1.0) -> ShapeId {
    model = behaviour.object_model(o)
    if model == null || model.mesh == null { return dynamics.null_shape_id() }
    return hull_collider(o, hull_of_mesh(model.mesh, model.scale), m, density)
}

// The object's own model as its collider: its triangles, for the static
// world (a building, a kerb, a lamp post).
mesh_collider_of_model(o: *GameObject, m: SurfaceMaterial) -> ShapeId {
    model = behaviour.object_model(o)
    if model == null || model.mesh == null { return dynamics.null_shape_id() }
    return mesh_collider(o, mesh_of_mesh(model.mesh), m, model.scale)
}

// --- vehicles ------------------------------------------------------------------------------------------------

// A car from its objects: the chassis (a rigidbody with its colliders
// already on it) and four wheel objects, each a dynamic body with its
// collider about its origin (a sphere, as the reference's driving
// sample has them: a faceted cylinder sits on a facet and will not
// roll), placed where its axle goes in the chassis's frame (front
// left, front right, rear left, rear right); the axle is the wheel's
// own x. The joints spring the wheels along the chassis's up
// (suspension), spin them about the axle with a motor, and steer the
// front pair. Both joint frames are the same basis -- x up, z along
// the axle -- so the wheel rests where the joint has no rotation to
// undo. The rear wheels are driven; the fronts roll free unless braked.
vehicle(chassis_o: *GameObject, wheel_objects: ptr, mounts: ptr, suspension_hertz: float, suspension_damping: float,
        travel: float, max_torque: float, max_speed: float, max_steer: float) -> *Vehicle {
    chassis = rigidbody_of(chassis_o)
    if chassis == null { return null }
    p = chassis.physics as *Physics
    v = heap.new(Vehicle)
    v.physics = p as ptr
    v.chassis = chassis as ptr
    v.wheels = calloc(WHEEL_COUNT, 8)
    v.joints = calloc(WHEEL_COUNT, sizeof(JointId))
    v.max_torque = max_torque
    v.max_speed = max_speed
    v.max_steer = max_steer
    wheels = v.wheels as ptr[]
    joints = v.joints as JointId[]
    objects = wheel_objects as ptr[]
    mount_points = mounts as Vec3[]
    chassis_q = dynamics.body_get_rotation(chassis.body_id)
    chassis_p = dynamics.body_get_position(chassis.body_id)
    // The joint's frame in both bodies: x up (the suspension), z along the axle, y = z cross x.
    frame_q = math.make_quat_from_matrix(Matrix3 { cx: math.vec3(0.0, 1.0, 0.0), cy: math.vec3(0.0, 0.0, 1.0), cz: math.vec3(1.0, 0.0, 0.0) })
    i = 0
    while i < WHEEL_COUNT {
        o = objects[i] as *GameObject
        rb = rigidbody_of(o)
        if rb == null { rb = rigidbody(o, DYNAMIC) }
        wheels[i] = rb as ptr
        world_mount = math.add(chassis_p, math.rotate_vector(chassis_q, mount_points[i]))
        dynamics.body_set_transform(rb.body_id, world_mount, chassis_q)
        jdef = dynamics.default_wheel_joint_def()
        jdef.base.body_id_a = chassis.body_id
        jdef.base.body_id_b = rb.body_id
        jdef.base.local_frame_a.p = mount_points[i]
        jdef.base.local_frame_a.q = frame_q
        jdef.base.local_frame_b.p = math.vec3_zero()
        jdef.base.local_frame_b.q = frame_q
        jdef.enable_suspension_spring = true
        jdef.suspension_hertz = suspension_hertz
        jdef.suspension_damping_ratio = suspension_damping
        jdef.enable_suspension_limit = true
        jdef.lower_suspension_limit = 0.0 - travel
        jdef.upper_suspension_limit = travel
        jdef.enable_spin_motor = true
        jdef.max_spin_torque = 0.0
        jdef.spin_speed = 0.0
        jdef.enable_steering = i < 2
        jdef.steering_hertz = 8.0
        jdef.steering_damping_ratio = 1.0
        jdef.target_steering_angle = 0.0
        jdef.max_steering_torque = 20.0 * max_torque
        jdef.enable_steering_limit = i < 2
        jdef.lower_steering_limit = 0.0 - max_steer
        jdef.upper_steering_limit = max_steer
        joints[i] = dynamics.create_wheel_joint(p.world_id, &jdef)
        pull_transform(rb)
        i = i + 1
    }
    return v
}

vehicle_chassis(v: *Vehicle) -> *Rigidbody { return v.chassis as *Rigidbody }
vehicle_wheel(v: *Vehicle, index: int) -> *Rigidbody { wheels = v.wheels as ptr[]; return wheels[index] as *Rigidbody }

// The controls this step: throttle -1..1 (reverse to forward), steer
// -1..1 (right to left), brake 0..1. The rear wheels drive; braking
// is the motors holding every wheel still at full torque; a wheel
// neither driven nor braked rolls free (a motor holding a wheel still
// is a brake, which is what kept a first car crawling).
vehicle_drive(v: *Vehicle, throttle: float, steer: float, brake: float) {
    joints = v.joints as JointId[]
    t = math.clamp_float(throttle, 0.0 - 1.0, 1.0)
    s = math.clamp_float(steer, 0.0 - 1.0, 1.0)
    b = math.clamp_float(brake, 0.0, 1.0)
    i = 0
    while i < WHEEL_COUNT {
        driven = i >= 2
        if b > 0.0 {
            joint_solver.wheel_joint_set_spin_motor_speed(joints[i], 0.0)
            joint_solver.wheel_joint_set_max_spin_torque(joints[i], b * v.max_torque)
        } else if driven && t != 0.0 {
            // A negative spin about the axle (the chassis's x) rolls the wheel toward -z, forward.
            joint_solver.wheel_joint_set_spin_motor_speed(joints[i], 0.0 - t * v.max_speed)
            joint_solver.wheel_joint_set_max_spin_torque(joints[i], v.max_torque)
        } else {
            joint_solver.wheel_joint_set_spin_motor_speed(joints[i], 0.0)
            joint_solver.wheel_joint_set_max_spin_torque(joints[i], 0.0)
        }
        if i < 2 { joint_solver.wheel_joint_set_target_steering_angle(joints[i], s * v.max_steer) }
        i = i + 1
    }
    dynamics.body_set_awake((v.chassis as *Rigidbody).body_id, true)
}

// The chassis's speed along its heading, metres a second (negative in reverse).
vehicle_speed(v: *Vehicle) -> float {
    chassis = v.chassis as *Rigidbody
    forward = math.rotate_vector(dynamics.body_get_rotation(chassis.body_id), math.vec3(0.0, 0.0, 0.0 - 1.0))
    return math.dot(dynamics.body_get_linear_velocity(chassis.body_id), forward)
}

vehicle_free(v: *Vehicle) {
    free(v.wheels)
    free(v.joints)
    heap.free(v)
}

// --- ragdolls ------------------------------------------------------------------------------------------------

// The twelve-bone human standing at a position, its joints sprung toward
// its pose at `hertz` with friction torque, and a game object per bone
// drawn as its capsule (the calves as shin and foot): the objects are the
// engine's, named "<name>/<bone>", and follow their bones every step.
ragdoll(e: *Engine, name: string, position: Vec3, friction_torque: float, hertz: float, damping_ratio: float) -> *Ragdoll {
    p = of(e)
    if p == null { return null }
    r = heap.new(Ragdoll)
    r.physics = p as ptr
    r.human = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    r.standing = false
    r.rig = null
    r.following = false
    r.hertz = hertz
    r.damping_ratio = damping_ratio
    r.group = list.size(p.ragdolls) + 1
    human.create_human(&r.human, p.world_id, position, friction_torque, hertz, damping_ratio, r.group, r as ptr)
    widen_knees(r)
    ragdoll_set_soles(r, false)
    r.flanks_free = false
    r.legs_crossing = false
    r.friction = friction_torque
    r.bones = list.new()
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        o = engine.object(e, "${name}/${bone_name(i)}", bone_model(bone.body_id, i))
        list.add_raw(r.bones, o as ptr)
        i = i + 1
    }
    list.add_raw(p.ragdolls, r as ptr)
    pull_ragdoll(r)
    return r
}

bone_name(index: int) -> string {
    if index == human.BONE_PELVIS { return "pelvis" }
    if index == human.BONE_SPINE_01 { return "spine_01" }
    if index == human.BONE_SPINE_03 { return "spine_03" }
    if index == human.BONE_NECK { return "neck" }
    if index == human.BONE_THIGH_L { return "thigh_l" }
    if index == human.BONE_CALF_L { return "calf_l" }
    if index == human.BONE_THIGH_R { return "thigh_r" }
    if index == human.BONE_CALF_R { return "calf_r" }
    if index == human.BONE_UPPER_ARM_L { return "upper_arm_l" }
    if index == human.BONE_LOWER_ARM_L { return "lower_arm_l" }
    if index == human.BONE_UPPER_ARM_R { return "upper_arm_r" }
    return "lower_arm_r"
}

// A bone's model: its capsule shapes, each a capsule mesh placed in the
// body's frame, merged into one model.
bone_model(body_id: BodyId, index: int) -> *Model {
    m = core.model_new()
    push_bone_capsules(m.mesh, body_id)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    // Clothed rather than bare: a dull warm grey, the torso and limbs a shade apart.
    tone = 0.58 - 0.05 * ((index % 4) as float)
    core.model_matte(m, tone, tone * 0.92, tone * 0.85)
    return m
}

push_bone_capsules(mesh: ptr, body_id: BodyId) {
    ids_block = calloc(4, sizeof(ShapeId))
    ids = ids_block as ShapeId[]
    count = dynamics.body_get_shapes(body_id, ids, 4)
    i = 0
    while i < count {
        if dynamics.shape_get_type(ids[i]) == shape.SHAPE_CAPSULE {
            c = dynamics.shape_get_capsule(ids[i])
            loader.push_capsule(mesh, c.center1, c.center2, c.radius, 12, 6)
        }
        i = i + 1
    }
    free(ids_block)
}

pull_ragdoll(r: *Ragdoll) {
    i = 0
    while i < human.BONE_COUNT {
        o = list.get_raw(r.bones, i) as *GameObject
        t = dynamics.body_get_transform(human.bone_at(&r.human, i).body_id)
        behaviour.object_set_position(o, t.p)
        behaviour.object_set_rotation(o, t.q)
        i = i + 1
    }
}

ragdoll_bone(r: *Ragdoll, index: int) -> *GameObject { return list.get_raw(r.bones, index) as *GameObject }

// The figure standing: its pelvis sprung upright to the ground's body by
// a parallel joint at `hertz`, and every bone held at its pose by a
// kinematic anchor through a parallel joint (the pose drive of an
// active ragdoll, rotation only), so it stands until released.
ragdoll_stand(r: *Ragdoll, ground: *Rigidbody, hertz: float, damping_ratio: float) {
    if r.standing { return }
    p = r.physics as *Physics
    human.human_align_spring(&r.human, p.world_id, ground.body_id, hertz, damping_ratio)
    human.human_create_parallel_anchors(&r.human, p.world_id)
    r.stand_ground = ground.body_id
    r.stand_hertz = hertz
    r.stand_damping_ratio = damping_ratio
    r.standing = true
}

// The springs and anchors let go: the figure is a ragdoll from here,
// and a rig it wore follows its bodies.
ragdoll_release(r: *Ragdoll) {
    if r.standing == false && r.following == false { return }
    // Let go while the rig drove it, the rig is the animation's pose:
    // kept, as a powered figure keeps it, for whatever brings it back.
    if r.rig != null && r.following && !r.powered {
        r.written_valid = false
        capture_animation(r)
    }
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    if dynamics.joint_is_valid(pelvis.joint_id) {
        dynamics.destroy_joint(pelvis.joint_id, true)
        pelvis.joint_id = dynamics.null_joint_id()
    }
    human.human_destroy_anchors(&r.human)
    unpower(r)
    r.standing = false
    r.following = false
}

// The rig drives the ragdoll: from here every fixed step the bodies'
// anchors are driven to where the rig's bones are, and the figure walks
// as the rig is animated, colliding as the ragdoll it is. A standing
// figure's springs are exchanged for the anchors that carry it; the rig
// is no longer posed from the bodies. `ragdoll_release` ends it, and
// the bodies drive the rig again from wherever they were -- the way a
// character animated until the moment it is struck becomes the ragdoll
// that falls. False when the ragdoll wears no rig.
ragdoll_follow(r: *Ragdoll) -> bool {
    if r.rig == null { return false }
    if r.following && !r.powered { return true }
    p = r.physics as *Physics
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    if dynamics.joint_is_valid(pelvis.joint_id) {
        dynamics.destroy_joint(pelvis.joint_id, true)
        pelvis.joint_id = dynamics.null_joint_id()
    }
    human.human_destroy_anchors(&r.human)
    unpower(r)
    human.human_create_motor_anchors(&r.human, p.world_id)
    r.standing = true
    r.following = true
    i = 0
    while i < human.BONE_COUNT {
        apply_limp(r, i)
        i = i + 1
    }
    return true
}

// The arms pass the hips, the lower spine and the thighs (#600) while
// the figure keeps to its clip -- animated, getting up, or POWERED and on
// its feet -- as the thighs pass each other and the head the shoulders. At
// rest a person's arm hangs against the flank and the hand against the
// thigh, and a clip holds them there; a capsule fitted around a bone is
// thicker than the flesh, and held off by them, a POWERED figure's upper
// arms stood 16 degrees from their clip, 42 to 45 after it had fallen and
// got up, pushed out and turned about themselves -- every other joint
// within a twentieth of a degree. Passing them, within 0.004. Falling,
// lying or limp, the arms meet them again: passing them always, an arm
// reaching down in a fall sideways went through the hip, and the head met
// the ground at 2.5 m/s, not 1.3 (tests/test_falls.ae). Filter joints, so
// the arms meet everything else -- the chest, the shins, other figures --
// as before; they go with the bodies when the human is destroyed. Each
// pair meets again only once its capsules are apart: met at once, an arm
// the clip had held into a thigh was thrown out of it as the figure began
// to fall, and the falls went worse than with no passing at all. Called
// every step while freeing them, until every pair is apart.
const FLANK_PAIRS = 16

ragdoll_free_flanks(r: *Ragdoll, free_them: bool) {
    if free_them == r.flanks_free && (free_them || r.flanks_held == 0) { return }
    if r.flanks == null { r.flanks = calloc(FLANK_PAIRS, sizeof(JointId)) }
    ids = r.flanks as JointId[]
    world = (r.physics as *Physics).world_id
    held = 0
    k = 0
    while k < FLANK_PAIRS {
        arm = human.BONE_UPPER_ARM_L
        if k % 4 == 1 { arm = human.BONE_UPPER_ARM_R }
        if k % 4 == 2 { arm = human.BONE_LOWER_ARM_L }
        if k % 4 == 3 { arm = human.BONE_LOWER_ARM_R }
        other = human.BONE_PELVIS
        if k >= 4 { other = human.BONE_SPINE_01 }
        if k >= 8 { other = human.BONE_THIGH_L }
        if k >= 12 { other = human.BONE_THIGH_R }
        if free_them {
            if !dynamics.joint_is_valid(ids[k]) {
                fdef = dynamics.default_filter_joint_def()
                fdef.base.body_id_a = human.bone_at(&r.human, arm).body_id
                fdef.base.body_id_b = human.bone_at(&r.human, other).body_id
                ids[k] = dynamics.create_filter_joint(world, &fdef)
            }
        } else if dynamics.joint_is_valid(ids[k]) {
            if capsules_apart(human.bone_at(&r.human, arm), human.bone_at(&r.human, other)) {
                dynamics.destroy_joint(ids[k], true)
                ids[k] = dynamics.null_joint_id()
            } else {
                held = held + 1
            }
        }
        k = k + 1
    }
    r.flanks_free = free_them
    r.flanks_held = held
}

// Whether two bones' capsules are apart, by a centimetre.
capsules_apart(a: *HumanBone, b: *HumanBone) -> bool {
    ca = dynamics.shape_get_capsule(a.shape_id)
    cb = dynamics.shape_get_capsule(b.shape_id)
    ta = dynamics.body_get_transform(a.body_id)
    tb = dynamics.body_get_transform(b.body_id)
    near = math.segment_distance(core.v3_add(ta.p, core.quat_apply(ta.q, ca.center1)), core.v3_add(ta.p, core.quat_apply(ta.q, ca.center2)),
                                   core.v3_add(tb.p, core.quat_apply(tb.q, cb.center1)), core.v3_add(tb.p, core.quat_apply(tb.q, cb.center2)))
    return core.v3_len(core.v3_sub(near.point1, near.point2)) > ca.radius + cb.radius + 0.01
}

ragdoll_flanks_free(r: *Ragdoll) -> bool { return r.flanks_free }

// The physics a ragdoll is in: what its world is asked about.
ragdoll_physics(r: *Ragdoll) -> *Physics { return r.physics as *Physics }

// The legs pass each other below the thighs too (#481), for a figure
// ae3d.motion moves: the shins, and each thigh the other's shin. A side
// shove loads the near foot, which cannot then step; the far one crosses
// in front of it, and held off by the shin it passes, it was lifted and
// did not move. Passed only while a foot crossed, the falls sideways went
// worse (the protected head 2.4 m/s); passed always, they go better (0.58
// from 1.27) and forwards too (1.71 from 1.96). Turned off, each pair
// meets again once apart, as the arms do (ragdoll_free_flanks).
const LEG_PAIRS = 3

ragdoll_cross_legs(r: *Ragdoll, crossing: bool) {
    if crossing == r.legs_crossing && (crossing || r.legs_held == 0) { return }
    if r.legs == null { r.legs = calloc(LEG_PAIRS, sizeof(JointId)) }
    ids = r.legs as JointId[]
    world = (r.physics as *Physics).world_id
    held = 0
    k = 0
    while k < LEG_PAIRS {
        a = human.BONE_CALF_L
        b = human.BONE_CALF_R
        if k == 1 { a = human.BONE_THIGH_L }
        if k == 2 {
            a = human.BONE_THIGH_R
            b = human.BONE_CALF_L
        }
        if crossing {
            if !dynamics.joint_is_valid(ids[k]) {
                fdef = dynamics.default_filter_joint_def()
                fdef.base.body_id_a = human.bone_at(&r.human, a).body_id
                fdef.base.body_id_b = human.bone_at(&r.human, b).body_id
                ids[k] = dynamics.create_filter_joint(world, &fdef)
            }
        } else if dynamics.joint_is_valid(ids[k]) {
            if capsules_apart(human.bone_at(&r.human, a), human.bone_at(&r.human, b)) {
                dynamics.destroy_joint(ids[k], true)
                ids[k] = dynamics.null_joint_id()
            } else {
                held = held + 1
            }
        }
        k = k + 1
    }
    r.legs_crossing = crossing
    r.legs_held = held
}

// The feet roll as a flat sole does, not as a log (FOOT_ROLL): the foot is
// a capsule lying heel to toe, and rolling resistance is the reference's
// 0.1 of its radius, a 7 mm lever, so a foot pushed sideways rolled under
// the figure. Shoved 1.2 m/s from the side, the box man's feet slid 1.34 m
// along the ground over a nine-step stagger; at FOOT_ROLL, a lever of the
// capsule's whole radius (a sole's half-width), 0.52 m over three steps
// (build/scratch/side_probe.ae). Only while it steps or stands upright,
// ae3d.motion says (ragdoll_set_soles): flat always, they held struck figures propped
// leaning or half down, and none of the plaza's walkers got up again.
const FOOT_ROLL = 1.0
const FOOT_ROLL_DOWN = 0.1

ragdoll_set_soles(r: *Ragdoll, flat: bool) {
    roll = FOOT_ROLL_DOWN
    if flat { roll = FOOT_ROLL }
    k = human.BONE_CALF_L
    while k <= human.BONE_CALF_R {
        foot = human.bone_at(&r.human, k).foot_shape_id
        if dynamics.shape_is_valid(foot) {
            mat = dynamics.shape_get_surface_material(foot)
            mat.rolling_resistance = roll
            dynamics.shape_set_surface_material(foot, mat)
        }
        k = k + 2
    }
}

// The knees given a person's range (#578). The reference ragdoll's knee
// rests straight on one of its limits and bends 60 degrees to the other,
// and a figure falling or stepping bent it no further: it fell stiff and
// stepped like a toy. Now it bends KNEE_FLEX from straight, the way the
// reference's own limits put its bend, and does not straighten past
// straight; the bone's limits, which ae3d.motion keeps its aims within,
// say so too.
widen_knees(r: *Ragdoll) {
    side = 0
    while side < 2 {
        calf = human.BONE_CALF_L
        if side == 1 { calf = human.BONE_CALF_R }
        bone = human.bone_at(&r.human, calf)
        if dynamics.joint_is_valid(bone.joint_id) && bone.joint_kind == dynamics.JOINT_REVOLUTE {
            qa = core.quat_mul(human.bone_at(&r.human, bone.parent_index).reference_frame.q, bone.local_frame_a.q)
            qb = core.quat_mul(bone.reference_frame.q, bone.local_frame_b.q)
            rel = core.quat_mul(core.quat_conjugate(qa), qb)
            rest = 2.0 * atan2(rel.z, rel.w)
            lower = rest
            upper = rest + KNEE_FLEX
            if bone.twist_limit.y - rest < rest - bone.twist_limit.x {
                lower = rest - KNEE_FLEX
                upper = rest
            }
            joint_solver.revolute_joint_set_limits(bone.joint_id, lower, upper)
            bone.twist_limit = Vec2 { x: lower, y: upper }
        }
        side = side + 1
    }
}

// A bone let go of, or taken back (#573). Limp, while the figure follows
// its rig its anchor holds it to nothing and its joint's spring is off, so
// it hangs from its parent, swings and collides as a ragdoll's does; while
// it is powered its muscle is whoever sets the bones' drives (ae3d.motion
// gives it none). The rig's bone is the body's to draw:
// ragdoll_draw_bone_from_body. Not the pelvis, which carries the rest.
ragdoll_set_bone_limp(r: *Ragdoll, index: int, limp: bool) {
    if index <= human.BONE_PELVIS || index >= human.BONE_COUNT { return }
    if r.limp == null { r.limp = calloc(human.BONE_COUNT, 4) }
    flags = r.limp as int[]
    flags[index] = 0
    if limp { flags[index] = 1 }
    apply_limp(r, index)
}

ragdoll_bone_is_limp(r: *Ragdoll, index: int) -> bool {
    if r.limp == null || index < 0 || index >= human.BONE_COUNT { return false }
    return (r.limp as int[])[index] == 1
}

// A bone's limpness on its anchor and joint, while the figure follows.
apply_limp(r: *Ragdoll, index: int) {
    if !r.following || r.powered || index == human.BONE_PELVIS { return }
    bone = human.bone_at(&r.human, index)
    limp = ragdoll_bone_is_limp(r, index)
    // The anchor's joint goes, and comes back, rather than its springs set
    // to nothing: at nothing, its last spring impulse was still applied
    // every sub-step as a warm start, and pushed a limp arm onto its limit
    // and held it there (aephysics#76).
    if limp && dynamics.joint_is_valid(bone.anchor_joint_id) {
        dynamics.destroy_joint(bone.anchor_joint_id, true)
        bone.anchor_joint_id = dynamics.null_joint_id()
    } else if !limp && !dynamics.joint_is_valid(bone.anchor_joint_id) && dynamics.body_is_valid(bone.anchor_id) {
        // As aephysics.human makes the anchors that carry a figure: the
        // anchor where the body is, so the joint's rest is no offset (made
        // with the anchor where the clip is, it held the arm where it hung),
        // and from there the anchor is driven to the clip.
        xf = dynamics.body_get_transform(bone.body_id)
        dynamics.body_set_transform(bone.anchor_id, xf.p, xf.q)
        p = r.physics as *Physics
        mdef = dynamics.default_motor_joint_def()
        mdef.angular_hertz = 5.0
        mdef.angular_damping_ratio = 1.0
        mdef.linear_hertz = 5.0
        mdef.linear_damping_ratio = 1.0
        mdef.max_spring_force = math.MAX_FLOAT
        mdef.max_spring_torque = math.MAX_FLOAT
        mdef.base.body_id_a = bone.anchor_id
        mdef.base.body_id_b = bone.body_id
        bone.anchor_joint_id = dynamics.create_motor_joint(p.world_id, &mdef)
        dynamics.body_set_awake(bone.anchor_id, true)
    }
    // While the anchors carry the figure its joints' springs pull toward the
    // clip's pose with them (drive_anchors, #584); a limp bone hangs free.
    set_joint_spring(bone, !limp)
    // A figure standing on a still clip sleeps; a joint made or let go
    // does not wake it, and an arm taken back stayed where it hung.
    dynamics.body_set_awake(bone.body_id, true)
    // A limp bone keeps LIMP_FRICTION of its joint's friction: at all of it
    // (6.4 N m at a shoulder, the figure's 8 by the joint's 0.8) an arm let
    // go of stayed held out where it was, against a weight of about 3.
    friction = bone.joint_friction * r.friction
    if limp { friction = friction * LIMP_FRICTION }
    ragdoll_set_bone_drive(r, index, friction)
}

// The rig's model for a bone, or null with no rig.
ragdoll_rig_bone(r: *Ragdoll, index: int) -> *Model {
    if r.rig == null || index < 0 || index >= human.BONE_COUNT { return null }
    return rig_model(r, index)
}

// One rig bone drawn as its body is: its rotation in the world from the
// body's, as pose_rig draws every bone of a figure that does not follow.
ragdoll_draw_bone_from_body(r: *Ragdoll, index: int) {
    if r.rig == null || index < 0 || index >= human.BONE_COUNT { return }
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    t = dynamics.body_get_transform(human.bone_at(&r.human, index).body_id)
    set_world_rotation(bones[index].model as *Model, core.quat_mul(t.q, bones[index].offset))
}

ragdoll_is_following(r: *Ragdoll) -> bool { return r.following }

// The rig drives the ragdoll the way muscles drive a body. Every joint's
// motor -- internal, between a bone and its parent, as a muscle is -- is
// driven each fixed step toward the pose the rig gives the two bones: at
// the relative angular velocity that would close the gap in POWER_TAU
// seconds, with no more torque than `max_torque` newton metres (a bone's
// share of it, set per bone by ragdoll_set_bone_drive). A motor is a hard
// constraint within its budget, so a figure carries its own weight on its
// knees and gives only when what pushes it is more than they have; a
// spring is soft and would have it sag at any stiffness. The pelvis alone
// is held to the rig's rotation from outside, by an anchor whose torque is
// capped at `assist`: the balance a standing figure keeps, which a blow
// past it overcomes. Nothing holds the figure's position. False when the
// ragdoll wears no rig.
ragdoll_power(r: *Ragdoll, max_torque: float, assist: float) -> bool {
    if r.rig == null { return false }
    was_following = r.following && !r.powered
    p = r.physics as *Physics
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    if dynamics.joint_is_valid(pelvis.joint_id) {
        dynamics.destroy_joint(pelvis.joint_id, true)
        pelvis.joint_id = dynamics.null_joint_id()
    }
    human.human_destroy_anchors(&r.human)
    human.human_create_parallel_anchors(&r.human, p.world_id)
    // Only the pelvis keeps its anchor; every other bone is its joint's.
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        if i != human.BONE_PELVIS {
            if dynamics.joint_is_valid(bone.anchor_joint_id) { dynamics.destroy_joint(bone.anchor_joint_id, true) }
            if dynamics.body_is_valid(bone.anchor_id) { dynamics.destroy_body(bone.anchor_id) }
            bone.anchor_joint_id = dynamics.null_joint_id()
            bone.anchor_id = dynamics.null_body_id()
            set_joint_spring(bone, false)
            ragdoll_set_bone_drive(r, i, max_torque)
        }
        i = i + 1
    }
    // The assist is stiff: its torque cap is what limits it, as a muscle's
    // is, not the softness a spring has against the pelvis's own mass --
    // at the anchors' 8 Hz the whole figure toppled with 300 N m to spare.
    joint_solver.parallel_joint_set_spring_hertz(pelvis.anchor_joint_id, POWER_ASSIST_HERTZ)
    joint_solver.parallel_joint_set_spring_damping_ratio(pelvis.anchor_joint_id, 1.0)
    ragdoll_set_balance_assist(r, assist)
    r.standing = true
    r.following = true
    r.powered = true
    // The animation's pose is the rig's when the rig drove the bodies
    // until now; drawn from the bodies (limp, or getting up), the rig is
    // theirs, and the animation's pose is the one kept.
    if was_following {
        r.written_valid = false
        if r.shown_from == null { r.shown_from = calloc((human.BONE_COUNT + 1) * 7, 8) }
        read_rig_locals(r, r.shown_from as float[])
        // The offset now, before anything has moved the bodies: the rig
        // posed from them and read, then given back the animation's pose.
        bodies = calloc((human.BONE_COUNT + 1) * 7, 8)
        pose_rig(r)
        read_rig_locals(r, bodies as float[])
        set_rig_locals(r, r.shown_from as float[])
        shown_offsets(r.shown_from as float[], bodies as float[])
        free(bodies)
        r.shown_left = POWER_BLEND
    }
    r.targets_valid = false
    refresh_targets(r)
    drive_joints(r, 1.0 / 60.0)
    return true
}

ragdoll_is_powered(r: *Ragdoll) -> bool { return r.powered && r.following }

// A joint's spring on or off, whichever kind it is.
set_joint_spring(bone: *HumanBone, on: bool) {
    if !dynamics.joint_is_valid(bone.joint_id) { return }
    if bone.joint_kind == dynamics.JOINT_REVOLUTE {
        joint_solver.revolute_joint_enable_spring(bone.joint_id, on)
    } else if bone.joint_kind == dynamics.JOINT_SPHERICAL {
        joint_solver.spherical_joint_enable_spring(bone.joint_id, on)
    }
}

// A bone's muscle: the most torque its joint's motor may use, in newton
// metres. The pelvis has no joint; its muscle is the balance assist.
ragdoll_set_bone_drive(r: *Ragdoll, index: int, max_torque: float) {
    bone = human.bone_at(&r.human, index)
    if !dynamics.joint_is_valid(bone.joint_id) || index == human.BONE_PELVIS { return }
    if bone.joint_kind == dynamics.JOINT_REVOLUTE {
        joint_solver.revolute_joint_set_max_motor_torque(bone.joint_id, max_torque)
    } else if bone.joint_kind == dynamics.JOINT_SPHERICAL {
        joint_solver.spherical_joint_set_max_motor_torque(bone.joint_id, max_torque)
    }
}

// A bone's muscle as it stands, in newton metres. 0 for the pelvis.
ragdoll_bone_drive_torque(r: *Ragdoll, index: int) -> float {
    bone = human.bone_at(&r.human, index)
    if !dynamics.joint_is_valid(bone.joint_id) || index == human.BONE_PELVIS { return 0.0 }
    if bone.joint_kind == dynamics.JOINT_REVOLUTE { return joint_solver.revolute_joint_get_max_motor_torque(bone.joint_id) }
    if bone.joint_kind == dynamics.JOINT_SPHERICAL { return joint_solver.spherical_joint_get_max_motor_torque(bone.joint_id) }
    return 0.0
}

// The torque, in newton metres, the pelvis may use to keep the figure's
// balance; 0 lets it go.
ragdoll_set_balance_assist(r: *Ragdoll, torque: float) {
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    if !dynamics.joint_is_valid(pelvis.anchor_joint_id) { return }
    joint_solver.parallel_joint_set_max_torque(pelvis.anchor_joint_id, torque)
}

ragdoll_balance_assist(r: *Ragdoll) -> float {
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    if !dynamics.joint_is_valid(pelvis.anchor_joint_id) { return 0.0 }
    return joint_solver.parallel_joint_get_max_torque(pelvis.anchor_joint_id)
}

// A bone aimed: its joint's motor drives its body to `rotation` in the
// world, from wherever its parent is now, instead of to the pose the rig
// gives it. What a controller reaching for something asks (arms out to a
// fall, a head turned to a threat); the bones below it keep the rig's
// pose relative to it. Within the joint's limits and its muscle, as any
// target is.
ragdoll_aim(r: *Ragdoll, index: int, rotation: Quat) {
    if index < 0 || index >= human.BONE_COUNT { return }
    if r.aims == null { r.aims = calloc(human.BONE_COUNT * 5, 8) }
    aims = r.aims as float[]
    q = core.quat_normalize(rotation)
    aims[index * 5] = 1.0
    aims[index * 5 + 1] = q.x
    aims[index * 5 + 2] = q.y
    aims[index * 5 + 3] = q.z
    aims[index * 5 + 4] = q.w
}

// The shape it has now held: every joint driven to the relative rotation
// it has, whatever the rig or an aim asks, until ragdoll_let_go_shape. A
// figure that has landed holds the shape it landed in; an aim instead
// holds a bone's rotation in the world, and every bone aimed where it lay
// wrenched the legs back toward it as the body rolled.
ragdoll_hold_shape(r: *Ragdoll) {
    if r.held == null { r.held = calloc(human.BONE_COUNT * 4, 8) }
    held = r.held as float[]
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        if bone.parent_index >= 0 {
            q = joint_relative(r, i)
            held[i * 4] = q.x
            held[i * 4 + 1] = q.y
            held[i * 4 + 2] = q.z
            held[i * 4 + 3] = q.w
        }
        i = i + 1
    }
    r.holding = true
}

ragdoll_let_go_shape(r: *Ragdoll) { r.holding = false }

ragdoll_is_holding_shape(r: *Ragdoll) -> bool { return r.holding }

// A joint's relative rotation now: its frame on the bone in its frame on the parent.
joint_relative(r: *Ragdoll, index: int) -> Quat {
    bone = human.bone_at(&r.human, index)
    ha = core.quat_mul(dynamics.body_get_rotation(human.bone_at(&r.human, bone.parent_index).body_id), bone.local_frame_a.q)
    hb = core.quat_mul(dynamics.body_get_rotation(bone.body_id), bone.local_frame_b.q)
    return core.quat_normalize(core.quat_mul(core.quat_conjugate(ha), hb))
}

// Back to the rig's pose: one bone, or all.
ragdoll_clear_aim(r: *Ragdoll, index: int) {
    if r.aims == null || index < 0 || index >= human.BONE_COUNT { return }
    aims = r.aims as float[]
    aims[index * 5] = 0.0
}

ragdoll_clear_aims(r: *Ragdoll) {
    if r.aims == null { return }
    i = 0
    while i < human.BONE_COUNT {
        ragdoll_clear_aim(r, i)
        i = i + 1
    }
}

ragdoll_is_aimed(r: *Ragdoll, index: int) -> bool {
    if r.aims == null || index < 0 || index >= human.BONE_COUNT { return false }
    aims = r.aims as float[]
    return aims[index * 5] > 0.5
}

ragdoll_aim_rotation(r: *Ragdoll, index: int) -> Quat {
    aims = r.aims as float[]
    return core.quat(aims[index * 5 + 1], aims[index * 5 + 2], aims[index * 5 + 3], aims[index * 5 + 4])
}

// Every joint's motor toward the rig's pose, and the pelvis's anchor. The
// relative rotation of the joint's frames the two bones' targets make is
// compared with the one they have: the rotation between (in the parent
// frame's space) over POWER_TAU is the relative angular velocity asked of
// a spherical joint's motor, turned into the world; the angle between is
// the hinge's speed. Capped at POWER_SPIN radians a second.
drive_joints(r: *Ragdoll, step: float) {
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        if i == human.BONE_PELVIS {
            q = ragdoll_bone_target(r, i)
            xf = dynamics.body_get_transform(bone.body_id)
            human.human_set_anchor_target(&r.human, i, Transform { p: xf.p, q: q }, step)
        } else if dynamics.joint_is_valid(bone.joint_id) && bone.parent_index >= 0 {
            parent_body = human.bone_at(&r.human, bone.parent_index).body_id
            wa = core.quat_mul(ragdoll_bone_target(r, bone.parent_index), bone.local_frame_a.q)
            wb = core.quat_mul(ragdoll_bone_target(r, i), bone.local_frame_b.q)
            if ragdoll_is_aimed(r, i) {
                // Aimed in the world: from the parent as it is, not as the
                // rig would have it.
                wa = core.quat_mul(dynamics.body_get_rotation(parent_body), bone.local_frame_a.q)
                wb = core.quat_mul(ragdoll_aim_rotation(r, i), bone.local_frame_b.q)
            }
            want = core.quat_normalize(core.quat_mul(core.quat_conjugate(wa), wb))
            if r.holding {
                held = r.held as float[]
                want = core.quat(held[i * 4], held[i * 4 + 1], held[i * 4 + 2], held[i * 4 + 3])
            }
            ha = core.quat_mul(dynamics.body_get_rotation(parent_body), bone.local_frame_a.q)
            hb = core.quat_mul(dynamics.body_get_rotation(bone.body_id), bone.local_frame_b.q)
            have = core.quat_normalize(core.quat_mul(core.quat_conjugate(ha), hb))
            if bone.joint_kind == dynamics.JOINT_SPHERICAL {
                gap = core.quat_normalize(core.quat_mul(want, core.quat_conjugate(have)))
                if gap.w < 0.0 { gap = core.quat(0.0 - gap.x, 0.0 - gap.y, 0.0 - gap.z, 0.0 - gap.w) }
                s = sqrt(gap.x * gap.x + gap.y * gap.y + gap.z * gap.z)
                spin = core.vec3(0.0, 0.0, 0.0)
                if s > 0.000001 {
                    angle = 2.0 * atan2(s, gap.w)
                    if r.holding && angle < HOLD_SLACK { angle = 0.0 }
                    speed = angle / POWER_TAU
                    if speed > POWER_SPIN { speed = POWER_SPIN }
                    spin = core.vec3(gap.x / s * speed, gap.y / s * speed, gap.z / s * speed)
                }
                joint_solver.spherical_joint_set_motor_velocity(bone.joint_id, core.quat_apply(ha, spin))
            } else if bone.joint_kind == dynamics.JOINT_REVOLUTE {
                target = 2.0 * atan2(want.z, want.w)
                current = 2.0 * atan2(have.z, have.w)
                off = target - current
                if r.holding && off < HOLD_SLACK && off > 0.0 - HOLD_SLACK { off = 0.0 }
                speed = off / POWER_TAU
                if speed > POWER_SPIN { speed = POWER_SPIN }
                if speed < 0.0 - POWER_SPIN { speed = 0.0 - POWER_SPIN }
                joint_solver.revolute_joint_set_motor_speed(bone.joint_id, speed)
            }
        }
        i = i + 1
    }
}

// How far bone `index` is from the pose the rig gives it, relative to its
// parent -- the joint's error, in radians: what the muscles answer for. The
// pelvis's is its rotation's in the world.
ragdoll_joint_error(r: *Ragdoll, index: int) -> float {
    bone = human.bone_at(&r.human, index)
    if index == human.BONE_PELVIS || bone.parent_index < 0 {
        return quat_angle(ragdoll_bone_rotation(r, index), ragdoll_bone_target(r, index))
    }
    wa = core.quat_mul(ragdoll_bone_target(r, bone.parent_index), bone.local_frame_a.q)
    wb = core.quat_mul(ragdoll_bone_target(r, index), bone.local_frame_b.q)
    want = core.quat_mul(core.quat_conjugate(wa), wb)
    ha = core.quat_mul(ragdoll_bone_rotation(r, bone.parent_index), bone.local_frame_a.q)
    hb = core.quat_mul(ragdoll_bone_rotation(r, index), bone.local_frame_b.q)
    have = core.quat_mul(core.quat_conjugate(ha), hb)
    return quat_angle(want, have)
}

// How far the figure leans: the angle between the figure's up as its
// pelvis carries it and the up the rig gives it, in radians. A turn about
// the vertical is no lean. The figure's up, not the pelvis body's +y: on a
// fitted ragdoll that is the hips' line to the spine, 20 degrees off
// vertical on an MPFB figure, and a turn swung it round a cone that read
// as a lean of a third of the turn -- standing bodies were taken for
// falling and let go (#550).
ragdoll_tilt(r: *Ragdoll) -> float {
    rest = core.quat_conjugate(human.bone_at(&r.human, human.BONE_PELVIS).reference_frame.q)
    up = core.vec3(0.0, 1.0, 0.0)
    have = core.quat_apply(core.quat_mul(ragdoll_bone_rotation(r, human.BONE_PELVIS), rest), up)
    want = core.quat_apply(core.quat_mul(ragdoll_bone_target(r, human.BONE_PELVIS), rest), up)
    d = core.v3_dot(core.v3_normalize(have), core.v3_normalize(want))
    if d > 1.0 { d = 1.0 }
    if d < 0.0 - 1.0 { d = 0.0 - 1.0 }
    return acos(d)
}

quat_angle(a: Quat, b: Quat) -> float {
    d = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    if d < 0.0 { d = 0.0 - d }
    if d > 1.0 { d = 1.0 }
    return 2.0 * acos(d)
}

// The joints' motors back to friction: no speed asked, the friction's
// torque, the springs on as the figure was made.
unpower(r: *Ragdoll) {
    if !r.powered { return }
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        if i != human.BONE_PELVIS && dynamics.joint_is_valid(bone.joint_id) {
            if bone.joint_kind == dynamics.JOINT_SPHERICAL {
                joint_solver.spherical_joint_set_motor_velocity(bone.joint_id, core.vec3(0.0, 0.0, 0.0))
            } else if bone.joint_kind == dynamics.JOINT_REVOLUTE {
                joint_solver.revolute_joint_set_motor_speed(bone.joint_id, 0.0)
            }
            ragdoll_set_bone_drive(r, i, bone.joint_friction * r.friction)
            set_joint_spring(bone, true)
        }
        i = i + 1
    }
    r.powered = false
}

// A blow: `impulse` (newton seconds) on a bone at `point`, in the world.
ragdoll_apply_impulse(r: *Ragdoll, index: int, impulse: Vec3, point: Vec3) {
    bone = human.bone_at(&r.human, index)
    dynamics.body_apply_linear_impulse(bone.body_id, impulse, point, true)
}

// A bone body's rotation in the world, now.
ragdoll_bone_rotation(r: *Ragdoll, index: int) -> Quat {
    return dynamics.body_get_rotation(human.bone_at(&r.human, index).body_id)
}

// The rotation the rig gives a bone's body now: what its anchor is driven
// to. The body's own when the ragdoll wears no rig.
ragdoll_bone_target(r: *Ragdoll, index: int) -> Quat {
    if r.rig == null { return ragdoll_bone_rotation(r, index) }
    if r.powered && r.targets_valid {
        t = r.targets as float[]
        return core.quat(t[index * 4], t[index * 4 + 1], t[index * 4 + 2], t[index * 4 + 3])
    }
    return rig_bone_target(r, index)
}

// The rotation the rig's own pose gives a bone's body now.
rig_bone_target(r: *Ragdoll, index: int) -> Quat {
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    bone = bones[index].model as *Model
    core.model_sync_transform(bone)
    return core.quat_normalize(core.quat_mul(bone.world_rotation, core.quat_conjugate(bones[index].offset)))
}

// --- a powered ragdoll's two poses ----------------------------------------------------------------

// The rig's model for mapped bone `k`, or its root for k == BONE_COUNT.
rig_model(r: *Ragdoll, k: int) -> *Model {
    rig = r.rig as *Rig
    if k == human.BONE_COUNT { return rig.root as *Model }
    return (rig.bones as RigBone[])[k].model as *Model
}

// A powered figure's bone drawn `w` of the way from where its body is to
// where its clip puts it, as rotations under its parent: what ae3d.motion
// draws a calm figure's arms by (#600), which the flanks hold off their
// clip. Kept as written, so the next step does not take it for the clip's.
ragdoll_draw_toward_clip(r: *Ragdoll, index: int, w: float) {
    if r.rig == null || r.anim == null || r.written == null || !r.written_valid { return }
    if index < 0 || index >= human.BONE_COUNT || w <= 0.0 { return }
    m = rig_model(r, index)
    at = index * 7
    anim = r.anim as float[]
    clip = core.quat(anim[at], anim[at + 1], anim[at + 2], anim[at + 3])
    q = core.quat_normalize(core.quat_slerp(m.rotation, clip, w))
    core.model_set_rotation(m, q)
    written = r.written as float[]
    written[at] = q.x
    written[at + 1] = q.y
    written[at + 2] = q.z
    written[at + 3] = q.w
}

// The rotation under its parent the clip gives a bone, as last captured.
ragdoll_clip_local(r: *Ragdoll, index: int) -> Quat {
    if r.rig == null || r.anim == null || index < 0 || index >= human.BONE_COUNT { return core.quat_ident() }
    anim = r.anim as float[]
    at = index * 7
    return core.quat(anim[at], anim[at + 1], anim[at + 2], anim[at + 3])
}

// What the animation has set on the rig since the bodies last wrote it,
// bone by bone, into the animation's pose: a bone the animation did not
// touch keeps the pose it had, so a clip that moves the chest alone leaves
// the legs where the animation last put them rather than where they fell.
capture_animation(r: *Ragdoll) {
    if r.anim == null { r.anim = calloc((human.BONE_COUNT + 1) * 7, 8) }
    if r.written == null { r.written = calloc((human.BONE_COUNT + 1) * 7, 8) }
    anim = r.anim as float[]
    written = r.written as float[]
    k = 0
    while k <= human.BONE_COUNT {
        m = rig_model(r, k)
        at = k * 7
        q = m.rotation
        p = m.position
        if !r.written_valid || q.x != written[at] || q.y != written[at + 1] || q.z != written[at + 2] ||
           q.w != written[at + 3] || p.x != written[at + 4] || p.y != written[at + 5] || p.z != written[at + 6] {
            anim[at] = q.x
            anim[at + 1] = q.y
            anim[at + 2] = q.z
            anim[at + 3] = q.w
            anim[at + 4] = p.x
            anim[at + 5] = p.y
            anim[at + 6] = p.z
        }
        k = k + 1
    }
}

// The joints' targets from the animation's pose: the rig set to it, read,
// and left for the bodies to write over after the step.
refresh_targets(r: *Ragdoll) {
    capture_animation(r)
    anim = r.anim as float[]
    k = 0
    while k <= human.BONE_COUNT {
        m = rig_model(r, k)
        at = k * 7
        core.model_set_rotation(m, core.quat(anim[at], anim[at + 1], anim[at + 2], anim[at + 3]))
        if k == human.BONE_COUNT { core.model_set_position(m, anim[at + 4], anim[at + 5], anim[at + 6]) }
        k = k + 1
    }
    if r.targets == null { r.targets = calloc(human.BONE_COUNT * 4, 8) }
    t = r.targets as float[]
    i = 0
    while i < human.BONE_COUNT {
        q = rig_bone_target(r, i)
        t[i * 4] = q.x
        t[i * 4 + 1] = q.y
        t[i * 4 + 2] = q.z
        t[i * 4 + 3] = q.w
        i = i + 1
    }
    r.targets_valid = true
}

// Each of the rig's locals in `rig` made its offset from the same in
// `bodies`: a rotation that turns the bodies' to the rig's, and the root's
// place less the bodies'.
shown_offsets(rig: float[], bodies: float[]) {
    k = 0
    while k <= human.BONE_COUNT {
        at = k * 7
        off = core.quat_normalize(core.quat_mul(core.quat(rig[at], rig[at + 1], rig[at + 2], rig[at + 3]),
                                                core.quat_conjugate(core.quat(bodies[at], bodies[at + 1], bodies[at + 2], bodies[at + 3]))))
        rig[at] = off.x
        rig[at + 1] = off.y
        rig[at + 2] = off.z
        rig[at + 3] = off.w
        rig[at + 4] = rig[at + 4] - bodies[at + 4]
        rig[at + 5] = rig[at + 5] - bodies[at + 5]
        rig[at + 6] = rig[at + 6] - bodies[at + 6]
        k = k + 1
    }
}

// The rig as the bodies are, for drawing -- under the offset the rig's own
// pose had from them, fading over the first POWER_BLEND of a figure
// powered from it -- and what that wrote remembered.
show_bodies(r: *Ragdoll, step: float) {
    draw_bodies(r)
    if r.shown_left > 0.0 && r.powered {
        r.shown_left = r.shown_left - step
        if r.shown_left <= 0.0 { r.shown_left = 0.0 }
    }
}

// The rig drawn from the bodies, what is left of a blend's offset on it,
// and what was drawn kept as written: what capture_animation tells the
// animation's own poses from.
draw_bodies(r: *Ragdoll) {
    pose_rig(r)
    if r.shown_left > 0.0 && r.powered {
        from = r.shown_from as float[]
        // What is left of the offset: all of it on the frame of the change,
        // easing to none, with no step at either end.
        u = 1.0 - r.shown_left / POWER_BLEND
        if u > 1.0 { u = 1.0 }
        left = 1.0 - u * u * (3.0 - 2.0 * u)
        k = 0
        while k <= human.BONE_COUNT {
            m = rig_model(r, k)
            at = k * 7
            off = core.quat_slerp(core.quat_ident(), core.quat(from[at], from[at + 1], from[at + 2], from[at + 3]), left)
            core.model_set_rotation(m, core.quat_normalize(core.quat_mul(off, m.rotation)))
            if k == human.BONE_COUNT {
                core.model_set_position(m, m.position.x + from[at + 4] * left,
                                        m.position.y + from[at + 5] * left,
                                        m.position.z + from[at + 6] * left)
            }
            k = k + 1
        }
    }
    if r.written == null { r.written = calloc((human.BONE_COUNT + 1) * 7, 8) }
    written = r.written as float[]
    k = 0
    while k <= human.BONE_COUNT {
        m = rig_model(r, k)
        at = k * 7
        written[at] = m.rotation.x
        written[at + 1] = m.rotation.y
        written[at + 2] = m.rotation.z
        written[at + 3] = m.rotation.w
        written[at + 4] = m.position.x
        written[at + 5] = m.position.y
        written[at + 6] = m.position.z
        k = k + 1
    }
    r.written_valid = true
}

// --- a pose as data ----------------------------------------------------------------------------------
//
// A pose is every bone body's transform in the world, POSE_STRIDE floats a
// bone in the human's bone order: its rotation (x, y, z, w), then its
// position. What ae3d.motion keys a get-up with: the bodies' pose as it
// lies, the animation's standing where it will stand, and the rig drawn
// from any pose between.

const POSE_STRIDE = 7

pose_set(pose: float[], i: int, t: Transform) {
    at = i * POSE_STRIDE
    pose[at] = t.q.x
    pose[at + 1] = t.q.y
    pose[at + 2] = t.q.z
    pose[at + 3] = t.q.w
    pose[at + 4] = t.p.x
    pose[at + 5] = t.p.y
    pose[at + 6] = t.p.z
}

pose_get(pose: float[], i: int) -> Transform {
    at = i * POSE_STRIDE
    return Transform { p: core.vec3(pose[at + 4], pose[at + 5], pose[at + 6]),
                       q: core.quat(pose[at], pose[at + 1], pose[at + 2], pose[at + 3]) }
}

// The bodies as they are, into `out` (BONE_COUNT * POSE_STRIDE floats).
ragdoll_body_pose(r: *Ragdoll, out: ptr) {
    pose = out as float[]
    i = 0
    while i < human.BONE_COUNT {
        pose_set(pose, i, dynamics.body_get_transform(human.bone_at(&r.human, i).body_id))
        i = i + 1
    }
}

// Where the animation's pose puts the bodies, into `out`: the rig set to
// the pose the animation last gave it (what the kept pose has, with
// whatever the animation has written since), each body read off its bone
// as the anchors would be driven to it, and the rig put back as it was.
// False when the ragdoll wears no rig.
ragdoll_animation_pose(r: *Ragdoll, out: ptr) -> bool {
    if r.rig == null { return false }
    capture_animation(r)
    saved = calloc((human.BONE_COUNT + 1) * 7, 8)
    keep = saved as float[]
    read_rig_locals(r, keep)
    set_rig_locals(r, r.anim as float[])
    pose = out as float[]
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    i = 0
    while i < human.BONE_COUNT {
        bone = bones[i].model as *Model
        core.model_sync_transform(bone)
        q = core.quat_normalize(core.quat_mul(bone.world_rotation, core.quat_conjugate(bones[i].offset)))
        p = core.v3_sub(bone.world_position, core.quat_apply(q, bones[i].offset_p))
        pose_set(pose, i, Transform { p: p, q: q })
        i = i + 1
    }
    set_rig_locals(r, keep)
    free(saved)
    return true
}

// The rig's bones' and root's locals, into `out`.
read_rig_locals(r: *Ragdoll, out: float[]) {
    k = 0
    while k <= human.BONE_COUNT {
        m = rig_model(r, k)
        at = k * 7
        out[at] = m.rotation.x
        out[at + 1] = m.rotation.y
        out[at + 2] = m.rotation.z
        out[at + 3] = m.rotation.w
        out[at + 4] = m.position.x
        out[at + 5] = m.position.y
        out[at + 6] = m.position.z
        k = k + 1
    }
}

// The rig's bones and root to a kept pose: each mapped bone's local
// rotation, the root's local rotation and position.
set_rig_locals(r: *Ragdoll, locals: float[]) {
    untoe(r)
    k = 0
    while k <= human.BONE_COUNT {
        m = rig_model(r, k)
        at = k * 7
        core.model_set_rotation(m, core.quat(locals[at], locals[at + 1], locals[at + 2], locals[at + 3]))
        // The root's place, and the pelvis's, which the bodies set too
        // (pose_rig_from): left where the ragdoll had put it, a clip that
        // keys no hips translation drew the walker handed back with its
        // hips under the ground, and its bodies, woken, followed them
        // through it.
        if k == human.BONE_COUNT || k == human.BONE_PELVIS { core.model_set_position(m, locals[at + 4], locals[at + 5], locals[at + 6]) }
        k = k + 1
    }
}

// The animation's pose moved as one piece: its root turned by `turn`
// about `pivot` and carried by `shift`, in the world. Where a figure that
// fell gets up to: the animation's pose where it now is, facing the way it
// rises.
ragdoll_move_animation(r: *Ragdoll, pivot: Vec3, turn: Quat, shift: Vec3) {
    if r.rig == null { return }
    capture_animation(r)
    anim = r.anim as float[]
    at = human.BONE_COUNT * 7
    rig = r.rig as *Rig
    root = rig.root as *Model
    local_q = core.quat(anim[at], anim[at + 1], anim[at + 2], anim[at + 3])
    local_p = core.vec3(anim[at + 4], anim[at + 5], anim[at + 6])
    parent = core.model_parent(root)
    world_q = local_q
    world_p = local_p
    if parent != null {
        core.model_sync_transform(parent)
        world_q = core.quat_mul(parent.world_rotation, local_q)
        scaled = core.vec3(local_p.x * parent.world_scale.x, local_p.y * parent.world_scale.y, local_p.z * parent.world_scale.z)
        world_p = core.v3_add(parent.world_position, core.quat_apply(parent.world_rotation, scaled))
    }
    world_q = core.quat_normalize(core.quat_mul(turn, world_q))
    world_p = core.v3_add(core.v3_add(pivot, core.quat_apply(turn, core.v3_sub(world_p, pivot))), shift)
    local_q = world_q
    local_p = world_p
    if parent != null {
        local_q = core.quat_normalize(core.quat_mul(core.quat_conjugate(parent.world_rotation), world_q))
        back = core.quat_apply(core.quat_conjugate(parent.world_rotation), core.v3_sub(world_p, parent.world_position))
        local_p = core.vec3(back.x / parent.world_scale.x, back.y / parent.world_scale.y, back.z / parent.world_scale.z)
    }
    anim[at] = local_q.x
    anim[at + 1] = local_q.y
    anim[at + 2] = local_q.z
    anim[at + 3] = local_q.w
    anim[at + 4] = local_p.x
    anim[at + 5] = local_p.y
    anim[at + 6] = local_p.z
}

// The rig drawn from a pose: the root where the pose's pelvis carries it,
// every mapped bone at its body's rotation in the pose. A rig that drives
// the bodies (following) takes them there.
ragdoll_show_pose(r: *Ragdoll, pose: ptr) {
    if r.rig == null { return }
    pose_rig_from(r, pose)
}

// The rig back to the animation's pose: what the figure hands back to its
// animation with.
ragdoll_restore_animation(r: *Ragdoll) {
    if r.rig == null || r.anim == null { return }
    set_rig_locals(r, r.anim as float[])
}

// The lowest point of a pose (of the bodies as they are, for null):
// every bone's capsules where the pose puts its body, the lowest of
// their ends less their radius.
ragdoll_pose_lowest(r: *Ragdoll, pose: ptr) -> float {
    lowest = 1000000.0
    ids_block = calloc(4, sizeof(ShapeId))
    ids = ids_block as ShapeId[]
    i = 0
    while i < human.BONE_COUNT {
        t = pose_or_body(r, pose, i)
        count = dynamics.body_get_shapes(human.bone_at(&r.human, i).body_id, ids, 4)
        k = 0
        while k < count {
            c = dynamics.shape_get_capsule(ids[k])
            low = t.p.y + core.quat_apply(t.q, c.center1).y
            other = t.p.y + core.quat_apply(t.q, c.center2).y
            if other < low { low = other }
            low = low - c.radius
            if low < lowest { lowest = low }
            k = k + 1
        }
        i = i + 1
    }
    free(ids_block)
    return lowest
}

// A bone's far end where a pose puts it: the end of its capsule away from
// its joint (a calf's is the ankle, a forearm's the wrist).
ragdoll_pose_end(r: *Ragdoll, pose: ptr, index: int) -> Vec3 {
    t = pose_get(pose as float[], index)
    return core.v3_add(t.p, core.quat_apply(t.q, bone_far_end(human.bone_at(&r.human, index))))
}

// A mapped rig bone's rotation in the world, as drawn now.
ragdoll_rig_bone_rotation(r: *Ragdoll, index: int) -> Quat {
    if r.rig == null { return ragdoll_bone_rotation(r, index) }
    m = rig_model(r, index)
    core.model_sync_transform(m)
    return m.world_rotation
}

// The figure's centre of mass in the world, and its mass.
ragdoll_center_of_mass(r: *Ragdoll) -> Vec3 {
    sum = core.vec3(0.0, 0.0, 0.0)
    total = 0.0
    i = 0
    while i < human.BONE_COUNT {
        id = human.bone_at(&r.human, i).body_id
        mass = dynamics.body_get_mass(id)
        c = dynamics.body_get_world_center(id)
        sum = core.v3_add(sum, core.v3_mul(c, mass))
        total = total + mass
        i = i + 1
    }
    if total <= 0.0 { return sum }
    return core.v3_mul(sum, 1.0 / total)
}

// A bone's share of the whole body's mass (#626): de Leva's (1996)
// adjustment of Zatsiorsky's segment table, male. The pelvis carries the
// lower trunk, SPINE_01 the middle, SPINE_03 the upper; the neck the head
// and neck; each calf its shank and foot, each lower arm its forearm and
// hand. They sum to 1.
ragdoll_segment_share(index: int) -> float {
    if index == human.BONE_PELVIS { return 0.1117 }
    if index == human.BONE_SPINE_01 { return 0.1633 }
    if index == human.BONE_SPINE_03 { return 0.1596 }
    if index == human.BONE_NECK { return 0.0694 }
    if index == human.BONE_THIGH_L || index == human.BONE_THIGH_R { return 0.1416 }
    if index == human.BONE_CALF_L || index == human.BONE_CALF_R { return 0.0433 + 0.0137 }
    if index == human.BONE_UPPER_ARM_L || index == human.BONE_UPPER_ARM_R { return 0.0271 }
    if index == human.BONE_LOWER_ARM_L || index == human.BONE_LOWER_ARM_R { return 0.0162 + 0.0061 }
    return 0.0
}

// What a person `height` metres tall weighs, kilograms: a body-mass index
// of 23 (the middle of the healthy range), the default for a figure whose
// own weight is not known.
person_mass(height: float) -> float { return 23.0 * height * height }

// The ragdoll weighing `kg` in all (#626), each bone its share of it
// (ragdoll_segment_share): every shape on a bone's body -- its capsule, and
// a calf's foot -- has its density scaled by the bone's new mass over its
// old, so the shapes keep their shape and the inertia follows the mass.
// Built from capsules fitted round the bones, solid, the reference human
// weighs 129 to 138 kg and a fitted 1.75 m figure 109: 1.5 to 1.8 times a
// person.
// Not mid-step.
ragdoll_set_mass(r: *Ragdoll, kg: float) {
    if r == null || kg <= 0.0 { return }
    ids_block = calloc(8, sizeof(ShapeId))
    ids = ids_block as ShapeId[]
    i = 0
    while i < human.BONE_COUNT {
        body = human.bone_at(&r.human, i).body_id
        now = dynamics.body_get_mass(body)
        want = kg * ragdoll_segment_share(i)
        if now > 0.0 && want > 0.0 {
            scale = want / now
            n = dynamics.body_get_shapes(body, ids, 8)
            k = 0
            while k < n {
                dynamics.shape_set_density(ids[k], dynamics.shape_get_density(ids[k]) * scale, false)
                k = k + 1
            }
            dynamics.body_apply_mass_from_shapes(body)
        }
        i = i + 1
    }
    free(ids_block)
}

// From the lowest point of its bodies to the top of its head (the neck's
// capsule carries it), as it stands now, metres.
ragdoll_height(r: *Ragdoll) -> float {
    neck = human.bone_at(&r.human, human.BONE_NECK)
    t = dynamics.body_get_transform(neck.body_id)
    c = dynamics.shape_get_capsule(neck.shape_id)
    a = t.p.y + core.quat_apply(t.q, c.center1).y
    b = t.p.y + core.quat_apply(t.q, c.center2).y
    top = a
    if b > a { top = b }
    return top + c.radius - ragdoll_pose_lowest(r, null)
}

ragdoll_mass(r: *Ragdoll) -> float {
    total = 0.0
    i = 0
    while i < human.BONE_COUNT {
        total = total + dynamics.body_get_mass(human.bone_at(&r.human, i).body_id)
        i = i + 1
    }
    return total
}

// Each mapped bone's body where the rig has it: the rig bone's world
// rotation less the offset the dressing found, and its origin back from
// the bone's head by the same offset. The anchors are driven there over
// the step.
drive_anchors(r: *Ragdoll, step: float) {
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    i = 0
    while i < human.BONE_COUNT {
        bone = bones[i].model as *Model
        core.model_sync_transform(bone)
        q = core.quat_normalize(core.quat_mul(bone.world_rotation, core.quat_conjugate(bones[i].offset)))
        p = core.v3_sub(bone.world_position, core.quat_apply(q, bones[i].offset_p))
        human.human_set_anchor_target(&r.human, i, Transform { p: p, q: q }, step)
        i = i + 1
    }
    // Each joint's spring toward the clip's pose, as the anchors pull (#584).
    // Toward the reference pose, its 8 Hz against the anchors' 5 left the
    // bodies trailing their clip: an arm held up ahead by 0.14 rad, one taken
    // back from limp by 0.25. Off, an arm sagged from its keys through a
    // get-up, and powered at its end, it was snapped up 8 degrees a step.
    i = 1
    while i < human.BONE_COUNT {
        hb = human.bone_at(&r.human, i)
        if dynamics.joint_is_valid(hb.joint_id) && hb.parent_index >= 0 && !ragdoll_bone_is_limp(r, i) {
            wa = core.quat_mul(rig_bone_target(r, hb.parent_index), hb.local_frame_a.q)
            wb = core.quat_mul(rig_bone_target(r, i), hb.local_frame_b.q)
            want = core.quat_normalize(core.quat_mul(core.quat_conjugate(wa), wb))
            if hb.joint_kind == dynamics.JOINT_SPHERICAL {
                joint_solver.spherical_joint_set_target_rotation(hb.joint_id, want)
            } else if hb.joint_kind == dynamics.JOINT_REVOLUTE {
                joint_solver.revolute_joint_set_target_angle(hb.joint_id, 2.0 * atan2(want.z, want.w))
            }
        }
        i = i + 1
    }
}

ragdoll_is_standing(r: *Ragdoll) -> bool { return r.standing }

// The whole figure turned about its pelvis by `yaw` about y, as one
// piece: every bone body moved and rotated together, so its joints are
// as they were. For a figure before it stands; a standing one is held
// by its anchors.
ragdoll_turn(r: *Ragdoll, yaw: float) {
    pelvis = human.bone_at(&r.human, human.BONE_PELVIS)
    pivot = dynamics.body_get_position(pelvis.body_id)
    turn = core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0))
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        t = dynamics.body_get_transform(bone.body_id)
        p = core.v3_add(pivot, core.quat_apply(turn, core.v3_sub(t.p, pivot)))
        dynamics.body_set_transform(bone.body_id, p, core.quat_normalize(core.quat_mul(turn, t.q)))
        i = i + 1
    }
    pull_ragdoll(r)
}

// The ragdoll out of the world: every bone's body and every anchor
// disabled, so it has no contacts, costs the solver nothing and is
// passed by the step, where it is, until `ragdoll_unpark`. What a pool
// of figures kept for later does with the ones not in use (ae3d.handover):
// a dozen ragdolls stood waiting would be a dozen stepped for nothing.
ragdoll_park(r: *Ragdoll) {
    if r == null || r.parked { return }
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.body_disable(bone.anchor_id) }
        dynamics.body_disable(bone.body_id)
        i = i + 1
    }
    r.parked = true
}

// Back in the world, where it was parked: every body enabled, the
// joints between them linked again once both ends are.
ragdoll_unpark(r: *Ragdoll) {
    if r == null || !r.parked { return }
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(&r.human, i)
        dynamics.body_enable(bone.body_id)
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.body_enable(bone.anchor_id) }
        i = i + 1
    }
    r.parked = false
}

ragdoll_is_parked(r: *Ragdoll) -> bool { return r.parked }

// Every body, and its anchor, put where the rig it wears puts it now,
// still: a figure moved by hand -- taken from a pool and stood where a
// crowd's figure was drawn -- rather than dragged there by its anchors
// over a step, which from metres away is a blow that throws it. The
// transforms are the ones the anchors are driven to (drive_anchors).
ragdoll_to_rig(r: *Ragdoll) {
    if r == null || r.rig == null { return }
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    still = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < human.BONE_COUNT {
        bone = bones[i].model as *Model
        core.model_sync_transform(bone)
        q = core.quat_normalize(core.quat_mul(bone.world_rotation, core.quat_conjugate(bones[i].offset)))
        at = core.v3_sub(bone.world_position, core.quat_apply(q, bones[i].offset_p))
        body = human.bone_at(&r.human, i)
        dynamics.body_set_transform(body.body_id, at, q)
        dynamics.body_set_linear_velocity(body.body_id, still)
        dynamics.body_set_angular_velocity(body.body_id, still)
        if dynamics.body_is_valid(body.anchor_id) {
            dynamics.body_set_transform(body.anchor_id, at, q)
            dynamics.body_set_linear_velocity(body.anchor_id, still)
            dynamics.body_set_angular_velocity(body.anchor_id, still)
        }
        i = i + 1
    }
    pull_ragdoll(r)
}

// The ragdoll a shape belongs to, or null: every bone's body carries it.
ragdoll_of_shape(p: *Physics, id: ShapeId) -> *Ragdoll {
    data = dynamics.body_get_user_data(dynamics.shape_get_body(id))
    if data == null { return null }
    n = list.size(p.ragdolls)
    i = 0
    while i < n {
        if list.get_raw(p.ragdolls, i) == data { return data as *Ragdoll }
        i = i + 1
    }
    return null
}
ragdoll_human(r: *Ragdoll) -> *Human { return &r.human }

// Whether the ray from `origin` along `direction` (a unit vector) meets any
// shape within `reach` metres.
ray_hits(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> bool {
    if p == null { return false }
    hit = physics_world.cast_ray_closest(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter())
    return hit.hit
}

// The game object whose body the ray from `origin` along `direction` (a
// unit vector) meets first within `reach` metres; null when it meets
// nothing, or a shape no Rigidbody of this world owns (a ragdoll's bone, a
// character).
ray_hit_object(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> *GameObject {
    if p == null { return null }
    hit = physics_world.cast_ray_closest(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter())
    if !hit.hit { return null }
    data = dynamics.body_get_user_data(dynamics.shape_get_body(hit.shape_id))
    if data == null { return null }
    n = list.size(p.rigidbodies)
    i = 0
    while i < n {
        if list.get_raw(p.rigidbodies, i) == data { return (data as *Rigidbody).object as *GameObject }
        i = i + 1
    }
    return null
}

// How far along the ray from `origin` along `direction` (a unit vector)
// the first shape it meets is, within `reach` metres; -1 for none. Where a
// player dropped over a scene stands.
ray_distance(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> float {
    if p == null { return 0.0 - 1.0 }
    hit = physics_world.cast_ray_closest(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter())
    if !hit.hit { return 0.0 - 1.0 }
    return hit.fraction * reach
}

// The same for the static world alone -- the ground, the buildings -- past
// anything that moves: where a player dropped over a scene can stand, and
// not on a figure's head.
struct StaticRayHit {
    fraction: float
    hit: bool
    point: Vec3
    normal: Vec3
}

static_ray_visitor(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, material: long, triangle: int, child: int, context: ptr) -> float {
    if dynamics.body_get_type(dynamics.shape_get_body(shape_id)) != dynamics.BODY_STATIC { return 0.0 - 1.0 }
    found = context as *StaticRayHit
    found.hit = true
    found.fraction = fraction
    found.point = point
    found.normal = normal
    return fraction
}

// Where the ray from `origin` along `direction` (a unit vector) first
// meets the static world within `reach` metres: the point, the surface's
// normal there and the fraction of the reach. Not hit when it meets none.
ray_static_hit(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> StaticRayHit {
    found = StaticRayHit { fraction: 1.0, hit: false, point: origin, normal: core.vec3(0.0, 1.0, 0.0) }
    if p == null || reach <= 0.0 { return found }
    physics_world.cast_ray(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter(), static_ray_visitor, (&found) as ptr)
    return found
}

ray_static_distance(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> float {
    if p == null { return 0.0 - 1.0 }
    found = StaticRayHit { fraction: 1.0, hit: false, point: origin, normal: core.vec3(0.0, 1.0, 0.0) }
    physics_world.cast_ray(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter(), static_ray_visitor, (&found) as ptr)
    if !found.hit { return 0.0 - 1.0 }
    return found.fraction * reach
}

// The first static shape the ray meets ends the cast: whether anything of
// the static world lies along it is all that is asked, not where.
any_static_visitor(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, material: long, triangle: int, child: int, context: ptr) -> float {
    if dynamics.body_get_type(dynamics.shape_get_body(shape_id)) != dynamics.BODY_STATIC { return 0.0 - 1.0 }
    found = context as *StaticRayHit
    found.hit = true
    found.fraction = fraction
    return 0.0
}

// Whether the ray from `origin` along `direction` (a unit vector) meets
// the static world -- the ground, the buildings -- within `reach` metres:
// whether a wall stands between an eye and what it looks at (ae3d.net's
// sight, #487).
ray_static_hits(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> bool {
    if p == null || reach <= 0.0 { return false }
    found = StaticRayHit { fraction: 1.0, hit: false, point: origin, normal: core.vec3(0.0, 1.0, 0.0) }
    physics_world.cast_ray(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter(), any_static_visitor, (&found) as ptr)
    return found.hit
}

// Whether a character's capsule -- `radius` wide, `height` tall, standing
// with its feet at `feet`, its round bottom a step's height up as a
// controller's is -- touches nothing, static or moving: a place a player
// can be put.
struct ClearProbe {
    deepest: float
}

clear_visitor(shape_id: ShapeId, results: PlaneResult[], count: int, context: ptr) -> bool {
    probe = context as *ClearProbe
    i = 0
    while i < count {
        if results[i].plane.offset > probe.deepest { probe.deepest = results[i].plane.offset }
        i = i + 1
    }
    return true
}

capsule_clear(p: *Physics, feet: Vec3, radius: float, height: float) -> bool {
    if p == null { return true }
    bottom = 0.35 + radius
    top = height - radius
    if top < bottom { top = bottom }
    probe = ClearProbe { deepest: 0.0 }
    physics_world.collide_mover(p.world_id, feet, Capsule { center1: core.vec3(0.0, bottom, 0.0), center2: core.vec3(0.0, top, 0.0), radius: radius },
                                shape.default_query_filter(), clear_visitor, (&probe) as ptr)
    return probe.deepest <= 0.001
}

// What a ray met first, when it was a ragdoll: which, which bone (the
// human's order), and where.
struct RagdollHit {
    ragdoll: ptr                   // *Ragdoll, or null when the ray met none first
    bone: int
    point: Vec3
}

// The ragdoll bone the ray from `origin` along `direction` (a unit vector)
// meets first within `reach` metres -- what a click on a figure strikes.
// A ragdoll of null when what it meets first is not a ragdoll, or nothing.
ragdoll_at(p: *Physics, origin: Vec3, direction: Vec3, reach: float) -> RagdollHit {
    out = RagdollHit { ragdoll: null, bone: 0 - 1, point: origin }
    if p == null { return out }
    hit = physics_world.cast_ray_closest(p.world_id, origin, core.v3_mul(direction, reach), shape.default_query_filter())
    if !hit.hit { return out }
    r = ragdoll_of_shape(p, hit.shape_id)
    if r == null { return out }
    body = dynamics.shape_get_body(hit.shape_id)
    i = 0
    while i < human.BONE_COUNT {
        id = human.bone_at(&r.human, i).body_id
        if id.index1 == body.index1 && id.world0 == body.world0 && id.generation == body.generation {
            out.ragdoll = r as ptr
            out.bone = i
            out.point = hit.point
        }
        i = i + 1
    }
    return out
}
ragdoll_set_velocity(r: *Ragdoll, v: Vec3) { human.human_set_velocity(&r.human, v) }

// Every body at rest: no speed, no spin.
ragdoll_still(r: *Ragdoll) {
    still = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < human.BONE_COUNT {
        body = human.bone_at(&r.human, i)
        if dynamics.body_is_valid(body.body_id) {
            dynamics.body_set_linear_velocity(body.body_id, still)
            dynamics.body_set_angular_velocity(body.body_id, still)
        }
        i = i + 1
    }
}

// How fast a bone's body moves, metres a second.
ragdoll_bone_speed(r: *Ragdoll, index: int) -> float {
    return core.v3_len(dynamics.body_get_linear_velocity(human.bone_at(&r.human, index).body_id))
}
ragdoll_kick(r: *Ragdoll, angular_impulse: Vec3) { human.human_apply_angular_impulse(&r.human, angular_impulse) }

// The ragdoll out of the world; its bone objects stay the scene's to remove.
ragdoll_free(r: *Ragdoll) {
    p = r.physics as *Physics
    n = list.size(p.ragdolls)
    i = 0
    while i < n {
        if list.get_raw(p.ragdolls, i) == r as ptr { list.remove(p.ragdolls, i); break }
        i = i + 1
    }
    ragdoll_let_go(r)
}

// A ragdoll's own: its bodies and joints, and everything a controller or a
// figure hung on it -- aims, poses, the rig it wears. Whether freed alone or
// with the world: freed with the world, only the humanoid and the bone list
// went, and a dressed ragdoll lost its rig's bone table with every engine.
ragdoll_let_go(r: *Ragdoll) {
    human.destroy_human(&r.human)
    list.free(r.bones)
    if r.aims != null { free(r.aims) }
    if r.held != null { free(r.held) }
    if r.anim != null { free(r.anim) }
    if r.written != null { free(r.written) }
    if r.targets != null { free(r.targets) }
    if r.shown_from != null { free(r.shown_from) }
    if r.limp != null { free(r.limp) }
    if r.flanks != null { free(r.flanks) }
    if r.legs != null { free(r.legs) }
    if r.rig != null {
        rig = r.rig as *Rig
        free(rig.bones)
        free(rig.feet)
        if rig.ankles != null { free(rig.ankles) }
        if rig.toes != null { free(rig.toes) }
        if rig.ankle_own != null { free(rig.ankle_own) }
        if rig.ankle_turned != null { free(rig.ankle_turned) }
        heap.free(rig)
    }
    heap.free(r)
}

// --- a figure on the ragdoll -------------------------------------------------------------------------------------

// The rig bone that stands for each of the ragdoll's twelve, in the
// ragdoll's bone order, as the engine's own Blender pipeline names them.
humanoid_bone(index: int) -> string {
    if index == human.BONE_PELVIS { return "Hips" }
    if index == human.BONE_SPINE_01 { return "Spine" }
    if index == human.BONE_SPINE_03 { return "Chest" }
    if index == human.BONE_NECK { return "Neck" }
    if index == human.BONE_THIGH_L { return "ThighL" }
    if index == human.BONE_CALF_L { return "KneeL" }
    if index == human.BONE_THIGH_R { return "ThighR" }
    if index == human.BONE_CALF_R { return "KneeR" }
    if index == human.BONE_UPPER_ARM_L { return "ShoulderL" }
    if index == human.BONE_LOWER_ARM_L { return "ElbowL" }
    if index == human.BONE_UPPER_ARM_R { return "ShoulderR" }
    return "ElbowR"
}

// The ways a humanoid rig's twelve bones are named: the engine's Blender
// pipeline's, Mixamo's -- with its "mixamorig:" prefix, and without it
// as most packs that follow it write them -- and the Unreal mannequin's
// (#646), which Quaternius' CC0 figures, the UE4 and UE5 mannequins and the
// rigs retargeted to them follow. Mixamo's three spine bones are Spine,
// Spine1 and Spine2, Unreal's spine_01 to spine_03 (to _05 on UE5's); the
// ragdoll's chest is spine_03 either way. The neck is the neck: the
// ragdoll's neck capsule is the head, and turns with it.
const HUMANOID_ENGINE = 0
const HUMANOID_MIXAMO = 1
const HUMANOID_MIXAMO_BARE = 2
const HUMANOID_UNREAL = 3
const HUMANOID_SCHEMES = 4

// Bone `index` of the ragdoll, in the naming `scheme`.
humanoid_scheme_bone(scheme: int, index: int) -> string {
    if scheme == HUMANOID_ENGINE { return humanoid_bone(index) }
    if scheme == HUMANOID_MIXAMO { return mixamo_rig_bone(index) }
    if scheme == HUMANOID_UNREAL { return unreal_bone(index) }
    return mixamo_bone(index)
}

// The Unreal mannequin's names.
unreal_bone(index: int) -> string {
    if index == human.BONE_PELVIS { return "pelvis" }
    if index == human.BONE_SPINE_01 { return "spine_01" }
    if index == human.BONE_SPINE_03 { return "spine_03" }
    if index == human.BONE_NECK { return "neck_01" }
    if index == human.BONE_THIGH_L { return "thigh_l" }
    if index == human.BONE_CALF_L { return "calf_l" }
    if index == human.BONE_THIGH_R { return "thigh_r" }
    if index == human.BONE_CALF_R { return "calf_r" }
    if index == human.BONE_UPPER_ARM_L { return "upperarm_l" }
    if index == human.BONE_LOWER_ARM_L { return "lowerarm_l" }
    if index == human.BONE_UPPER_ARM_R { return "upperarm_r" }
    return "lowerarm_r"
}

// Mixamo's names as its own exports write them.
mixamo_rig_bone(index: int) -> string {
    if index == human.BONE_PELVIS { return "mixamorig:Hips" }
    if index == human.BONE_SPINE_01 { return "mixamorig:Spine" }
    if index == human.BONE_SPINE_03 { return "mixamorig:Spine2" }
    if index == human.BONE_NECK { return "mixamorig:Neck" }
    if index == human.BONE_THIGH_L { return "mixamorig:LeftUpLeg" }
    if index == human.BONE_CALF_L { return "mixamorig:LeftLeg" }
    if index == human.BONE_THIGH_R { return "mixamorig:RightUpLeg" }
    if index == human.BONE_CALF_R { return "mixamorig:RightLeg" }
    if index == human.BONE_UPPER_ARM_L { return "mixamorig:LeftArm" }
    if index == human.BONE_LOWER_ARM_L { return "mixamorig:LeftForeArm" }
    if index == human.BONE_UPPER_ARM_R { return "mixamorig:RightArm" }
    return "mixamorig:RightForeArm"
}

mixamo_bone(index: int) -> string {
    if index == human.BONE_PELVIS { return "Hips" }
    if index == human.BONE_SPINE_01 { return "Spine" }
    if index == human.BONE_SPINE_03 { return "Spine2" }
    if index == human.BONE_NECK { return "Neck" }
    if index == human.BONE_THIGH_L { return "LeftUpLeg" }
    if index == human.BONE_CALF_L { return "LeftLeg" }
    if index == human.BONE_THIGH_R { return "RightUpLeg" }
    if index == human.BONE_CALF_R { return "RightLeg" }
    if index == human.BONE_UPPER_ARM_L { return "LeftArm" }
    if index == human.BONE_LOWER_ARM_L { return "LeftForeArm" }
    if index == human.BONE_UPPER_ARM_R { return "RightArm" }
    return "RightForeArm"
}

// The first naming whose twelve bones the skeleton has every one of, or -1
// for a rig that is not a humanoid the engine knows.
humanoid_scheme(skeleton: *Skeleton) -> int {
    if skeleton == null { return 0 - 1 }
    scheme = 0
    while scheme < HUMANOID_SCHEMES {
        all = true
        i = 0
        while i < human.BONE_COUNT && all {
            if skin.skeleton_find(skeleton, humanoid_scheme_bone(scheme, i)) < 0 { all = false }
            i = i + 1
        }
        if all { return scheme }
        scheme = scheme + 1
    }
    return 0 - 1
}

// A figure put on the ragdoll where the figure stands and the way it faces:
// the ragdoll turned first to face as the rig's feet do, so dressing it
// leaves the figure turned as the scene had it, then dressed by whichever
// naming the rig's bones follow. False when the rig is no humanoid the
// engine knows.
ragdoll_dress_humanoid(r: *Ragdoll, skeleton: *Skeleton) -> bool {
    scheme = humanoid_scheme(skeleton)
    if r == null || scheme < 0 { return false }
    stood = rig_pose_save(skeleton)
    skin.skeleton_strike_bind(skeleton)
    legs = calloc(human.BONE_COUNT, 4) as int[]
    k = human.BONE_THIGH_L
    while k <= human.BONE_CALF_R {
        legs[k] = skin.skeleton_find(skeleton, humanoid_scheme_bone(scheme, k))
        k = k + 1
    }
    rig_facing = core.v3_add(rig_foot_direction(skeleton, legs, human.BONE_CALF_L), rig_foot_direction(skeleton, legs, human.BONE_CALF_R))
    free(legs)
    rig_pose_restore(skeleton, stood, null)
    free(stood)
    body_facing = core.v3_add(body_foot_direction(r, human.BONE_CALF_L), body_foot_direction(r, human.BONE_CALF_R))
    if core.v3_len(rig_facing) > 0.0001 && core.v3_len(body_facing) > 0.0001 {
        want = atan2(0.0 - rig_facing.z, rig_facing.x)
        have = atan2(0.0 - body_facing.z, body_facing.x)
        ragdoll_turn(r, want - have)
    }
    names = strarr.new()
    i = 0
    while i < human.BONE_COUNT {
        strarr.push(names, humanoid_scheme_bone(scheme, i))
        i = i + 1
    }
    ok = ragdoll_dress_named(r, skeleton, strarr.array(names))
    strarr.free(names)
    return ok
}

// The skinned figure worn by the ragdoll, its rig named as the pipeline
// names one: every fixed step from here the rig's bones take the bodies'
// rotations and the root rides the pelvis, so the mesh weighted to the
// rig stands, falls and lies as the ragdoll does. The ragdoll's own
// capsule models are hidden; its objects stay for scripts.
ragdoll_dress(r: *Ragdoll, skeleton: *Skeleton) -> bool {
    names = strarr.new()
    i = 0
    while i < human.BONE_COUNT {
        strarr.push(names, humanoid_bone(i))
        i = i + 1
    }
    ok = ragdoll_dress_named(r, skeleton, strarr.array(names))
    strarr.free(names)
    return ok
}

ragdoll_is_dressed(r: *Ragdoll) -> bool { return r.rig != null }

// With the rig's own names for the twelve bones (a glTF rig names them
// its way). Answers false, dressing nothing, when a name is not in the
// skeleton, the skeleton has no root, or the ragdoll already wears a rig.
//
// The ragdoll is built again as the rig's figure. The rig is put in its
// bind pose -- the pose its mesh was modelled in, not whatever pose the
// file's nodes were saved in (#539) -- faced the ragdoll's way, from
// where each one's feet point, and stood on its pelvis; then every body's joint is put at its rig bone's, every
// bone turned to run along the rig's line and stretched to its length
// (aephysics.human's human_fit_shape), and the figure set down with its
// feet where they were. So the rig's bind pose is the ragdoll's rest
// pose, and the rotation from a body to its bone carries no bend: a
// spine that curves is held curved (#529). A standing ragdoll stands
// again; its bodies are new, its game objects the same.
//
// An ankle is the calf's first child, or, on an IK rig whose feet hang
// from its root, the bone that heads on the leg's line below the knee
// (rig_ankle); such a foot is carried by its calf from then on.
ragdoll_dress_named(r: *Ragdoll, skeleton: *Skeleton, names: string[]) -> bool {
    if r == null || r.rig != null || skeleton == null || skin.skeleton_count(skeleton) == 0 { return false }
    indices = calloc(human.BONE_COUNT, 4) as int[]
    i = 0
    while i < human.BONE_COUNT {
        indices[i] = skin.skeleton_find(skeleton, names[i])
        if indices[i] < 0 {
            free(indices)
            return false
        }
        i = i + 1
    }
    root = rig_root(skeleton)
    if root == null { free(indices); return false }
    stood = rig_pose_save(skeleton)
    skin.skeleton_strike_bind(skeleton)
    rig = heap.new(Rig)
    rig.skeleton = skeleton as ptr
    rig.root = root as ptr
    rig.bones = calloc(human.BONE_COUNT, sizeof(RigBone))
    bones = rig.bones as RigBone[]

    // The figure faced as the ragdoll is, from the feet.
    pelvis_t = dynamics.body_get_transform(human.bone_at(&r.human, human.BONE_PELVIS).body_id)
    // Both feet, summed: a rest pose's feet splay, and the two splays cancel.
    rig_facing = core.v3_add(rig_foot_direction(skeleton, indices, human.BONE_CALF_L), rig_foot_direction(skeleton, indices, human.BONE_CALF_R))
    body_facing = core.v3_add(body_foot_direction(r, human.BONE_CALF_L), body_foot_direction(r, human.BONE_CALF_R))
    if core.v3_len(rig_facing) > 0.0001 && core.v3_len(body_facing) > 0.0001 {
        turn = core.quat_from_to(rig_facing, body_facing)
        core.model_set_rotation(root, core.quat_mul(turn, root.rotation))
    }
    // And stood where it is: the rig's pelvis on the ragdoll's.
    core.model_sync_transform(root)
    hips = skin.skeleton_bone(skeleton, indices[human.BONE_PELVIS])
    core.model_sync_transform(hips)
    shift = core.v3_sub(pelvis_t.p, hips.world_position)
    core.model_set_position(root, root.position.x + shift.x, root.position.y + shift.y, root.position.z + shift.z)
    core.model_sync_transform(root)

    fit_to_rig(r, skeleton, indices)

    // Each bone's rotation and head from its body's: the body lies along
    // the bone's line, so the rotation is the twist between their frames.
    i = 0
    while i < human.BONE_COUNT {
        bone = skin.skeleton_bone(skeleton, indices[i])
        core.model_sync_transform(bone)
        body_t = dynamics.body_get_transform(human.bone_at(&r.human, i).body_id)
        bones[i].model = bone as ptr
        bones[i].offset = core.quat_normalize(core.quat_mul(core.quat_conjugate(body_t.q), bone.world_rotation))
        bones[i].offset_p = core.quat_apply(core.quat_conjugate(body_t.q), core.v3_sub(bone.world_position, body_t.p))
        i = i + 1
    }
    // A foot its calf does not parent, carried by the calf's body.
    rig.feet = calloc(2, sizeof(RigBone))
    rig.ankles = calloc(2, 8)
    rig.toes = calloc(2, 8)
    rig.ankle_own = calloc(2, sizeof(Quat))
    rig.ankle_turned = calloc(2, 4)
    feet = rig.feet as RigBone[]
    side = 0
    while side < 2 {
        calf = human.BONE_CALF_L
        if side == 1 { calf = human.BONE_CALF_R }
        ankle = rig_ankle(skeleton, indices, calf)
        if ankle != null {
            (rig.ankles as ptr[])[side] = ankle as ptr
            (rig.toes as ptr[])[side] = rig_child(skeleton, ankle) as ptr
        }
        if ankle != null && !descends_from(ankle, skin.skeleton_bone(skeleton, indices[calf])) {
            core.model_sync_transform(ankle)
            calf_t = dynamics.body_get_transform(human.bone_at(&r.human, calf).body_id)
            feet[side].model = ankle as ptr
            feet[side].offset = core.quat_normalize(core.quat_mul(core.quat_conjugate(calf_t.q), ankle.world_rotation))
            feet[side].offset_p = core.quat_apply(core.quat_conjugate(calf_t.q), core.v3_sub(ankle.world_position, calf_t.p))
        }
        side = side + 1
    }
    // The root from the pelvis.
    core.model_sync_transform(root)
    pelvis_t = dynamics.body_get_transform(human.bone_at(&r.human, human.BONE_PELVIS).body_id)
    inverse_pelvis = core.quat_conjugate(pelvis_t.q)
    rig.root_offset_p = core.quat_apply(inverse_pelvis, core.v3_sub(root.world_position, pelvis_t.p))
    rig.root_offset_q = core.quat_normalize(core.quat_mul(inverse_pelvis, root.world_rotation))
    free(indices)
    // Measured in the bind pose, the figure is left as it stood: the rig
    // back in the pose it was in (where its root now carries it) and the
    // bodies put on that pose, so a figure dressed while a clip plays
    // starts in the clip's stance rather than the T-pose (#542).
    rig_pose_restore(skeleton, stood, root)
    free(stood)

    // The capsules go unseen; the figure is the ragdoll now.
    i = 0
    while i < human.BONE_COUNT {
        o = list.get_raw(r.bones, i) as *GameObject
        capsule = behaviour.object_model(o)
        if capsule != null { capsule.visible = false }
        i = i + 1
    }
    r.rig = rig as ptr
    ragdoll_to_rig(r)
    // The root rides the pelvis as the two stand in that pose: an
    // unmapped bone between them (a Body a clip turns) is part of it.
    core.model_sync_transform(root)
    pelvis_t = dynamics.body_get_transform(human.bone_at(&r.human, human.BONE_PELVIS).body_id)
    inverse_pelvis = core.quat_conjugate(pelvis_t.q)
    rig.root_offset_p = core.quat_apply(inverse_pelvis, core.v3_sub(root.world_position, pelvis_t.p))
    rig.root_offset_q = core.quat_normalize(core.quat_mul(inverse_pelvis, root.world_rotation))
    pose_rig(r)
    return true
}

// Every bone's local transform (position, rotation, scale: ten floats a
// bone), to put back with rig_pose_restore; the caller frees it.
rig_pose_save(skeleton: *Skeleton) -> ptr {
    count = skin.skeleton_count(skeleton)
    block = calloc(count * 10, 8)
    v = block as float[]
    i = 0
    while i < count {
        m = skin.skeleton_bone(skeleton, i)
        at = i * 10
        v[at] = m.position.x
        v[at + 1] = m.position.y
        v[at + 2] = m.position.z
        v[at + 3] = m.rotation.x
        v[at + 4] = m.rotation.y
        v[at + 5] = m.rotation.z
        v[at + 6] = m.rotation.w
        v[at + 7] = m.scale.x
        v[at + 8] = m.scale.y
        v[at + 9] = m.scale.z
        i = i + 1
    }
    return block
}

// The bones back to a saved pose, all but `keep` (the root a dressing
// has placed, when it is one of the skeleton's bones).
rig_pose_restore(skeleton: *Skeleton, block: ptr, keep: *Model) {
    v = block as float[]
    count = skin.skeleton_count(skeleton)
    i = 0
    while i < count {
        m = skin.skeleton_bone(skeleton, i)
        if m != keep {
            at = i * 10
            core.model_set_position(m, v[at], v[at + 1], v[at + 2])
            core.model_set_rotation(m, core.quat(v[at + 3], v[at + 4], v[at + 5], v[at + 6]))
            core.model_set_scale(m, v[at + 7], v[at + 8], v[at + 9])
        }
        i = i + 1
    }
    i = 0
    while i < count {
        core.model_sync_transform(skin.skeleton_bone(skeleton, i))
        i = i + 1
    }
}

// The ragdoll built again as the figure the rig is, where it stands:
// the reference's shape fitted to the rig's joints, lines and toes in
// the figure's own space (the reference's, placed as the pelvis is now),
// the old bodies destroyed and the fitted ones made, then set down so
// its lowest point is where the old one's was. Where the skeleton
// carries its skinned mesh, the feet are fitted to the flesh: a toe the
// rig has no bone for is the foot's farthest point forward, and each
// shin ends where its foot's underside meets the mesh's sole (#539) --
// an IK rig's ankle bone can sit at the sole, and a foot hung below it
// would stand the figure off the ground. The bone objects keep
// their names and take the new capsules; a standing figure is sprung
// upright and anchored again.
// Each fitted calf's foot laid flat under its shin (#626): the reference's
// foot runs from its toe at the ankle's height to a heel 8.5 cm up the
// shin, about 50 degrees off it, so a figure standing on upright shins
// stood on its toes -- its heels 9 cm off the ground, its support a line
// under them, the balance assist holding up what its feet could not. Laid
// perpendicular to the shin at the toe end's height along it, toward where
// the rig's toe points, FOOT_AHEAD in front of the shin and FOOT_BEHIND
// behind it: a person carries the body over the ankle a few centimetres
// ahead of the heel. Measured on test_balance's rig at 75 kg with the
// assist at m g 0.3: shoves from behind held 0.6 m/s on the feet and 1.4
// stepping (tiptoe, 0.4 and 0.4, and back over the heels it fell).
level_feet(shape: ptr) {
    level_foot(human.spec_at(shape, human.BONE_CALF_L))
    level_foot(human.spec_at(shape, human.BONE_CALF_R))
}

level_foot(spec: *BoneSpec) {
    if !spec.has_foot { return }
    axis = core.v3_sub(spec.capsule.center1, spec.capsule.center2)
    shin = core.v3_len(axis)
    if shin < 0.000001 { return }
    axis = core.v3_normalize(axis)
    // In proportion to the shin: the reference's is 0.45 m.
    scale = shin / FOOT_SHIN
    base = spec.capsule.center2
    // The toe end: the one farther off the shin.
    a = core.v3_sub(spec.foot.center1, base)
    b = core.v3_sub(spec.foot.center2, base)
    off_a = core.v3_sub(a, core.v3_mul(axis, core.v3_dot(a, axis)))
    off_b = core.v3_sub(b, core.v3_mul(axis, core.v3_dot(b, axis)))
    toe = a
    toe_off = off_a
    if core.v3_len(off_b) > core.v3_len(off_a) {
        toe = b
        toe_off = off_b
    }
    if core.v3_len(toe_off) < 0.000001 { return }
    ahead = core.v3_normalize(toe_off)
    along = core.v3_mul(axis, core.v3_dot(toe, axis))
    front = core.v3_add(base, core.v3_add(along, core.v3_mul(ahead, FOOT_AHEAD * scale)))
    back = core.v3_add(base, core.v3_sub(along, core.v3_mul(ahead, FOOT_BEHIND * scale)))
    spec.foot = Capsule { center1: front, center2: back, radius: spec.foot.radius }
}

fit_to_rig(r: *Ragdoll, skeleton: *Skeleton, indices: int[]) {
    p = r.physics as *Physics
    shape = human.human_reference_shape()
    rest = human.spec_at(shape, human.BONE_PELVIS).reference
    pelvis_t = dynamics.body_get_transform(human.bone_at(&r.human, human.BONE_PELVIS).body_id)
    place_q = core.quat_normalize(core.quat_mul(pelvis_t.q, core.quat_conjugate(rest.q)))
    placement = Transform { p: core.v3_sub(pelvis_t.p, core.quat_apply(place_q, rest.p)), q: place_q }
    block = calloc(2 * human.BONE_COUNT + 2, sizeof(Vec3))
    v = block as Vec3[]
    i = 0
    while i < human.BONE_COUNT {
        head = skin.skeleton_bone(skeleton, indices[i])
        core.model_sync_transform(head)
        v[i] = figure_point(placement, head.world_position)
        v[human.BONE_COUNT + i] = figure_point(placement, rig_tail(skeleton, indices, i, shape, placement))
        i = i + 1
    }
    toes = null as ptr
    left = rig_toe_point(skeleton, indices, human.BONE_CALF_L)
    right = rig_toe_point(skeleton, indices, human.BONE_CALF_R)
    if left.found && right.found {
        v[2 * human.BONE_COUNT] = figure_point(placement, left.at)
        v[2 * human.BONE_COUNT + 1] = figure_point(placement, right.at)
        toes = block + 2 * human.BONE_COUNT * sizeof(Vec3)
    }
    fit_soles(skeleton, indices, block, toes, placement)
    free(shape)
    shape = fitted_shape(block, toes)
    level_feet(shape)
    free(block)

    lowest = ragdoll_pose_lowest(r, null)
    standing = r.standing
    r.standing = false
    human.destroy_human(&r.human)
    human.create_human_shaped(&r.human, p.world_id, placement, shape, r.friction, r.hertz, r.damping_ratio, r.group, r as ptr)
    widen_knees(r)
    ragdoll_set_soles(r, false)
    r.flanks_free = false
    r.legs_crossing = false
    free(shape)
    // Set down where the reference's feet were.
    drop = lowest - ragdoll_pose_lowest(r, null)
    i = 0
    while i < human.BONE_COUNT {
        id = human.bone_at(&r.human, i).body_id
        t = dynamics.body_get_transform(id)
        dynamics.body_set_transform(id, core.vec3(t.p.x, t.p.y + drop, t.p.z), t.q)
        i = i + 1
    }
    root = rig_root(skeleton)
    core.model_set_position(root, root.position.x, root.position.y + drop, root.position.z)
    core.model_sync_transform(root)
    // A person's weight for its height (#626): built of capsules fitted round
    // the bones, solid, a figure weighed 1.5 to 1.8 times a person.
    ragdoll_set_mass(r, person_mass(ragdoll_height(r)))

    // The bone objects draw the new capsules.
    e = p.engine as *Engine
    i = 0
    while i < human.BONE_COUNT {
        m = behaviour.object_model(list.get_raw(r.bones, i) as *GameObject)
        if m != null {
            mesh = geometry.mesh_create()
            push_bone_capsules(mesh, human.bone_at(&r.human, i).body_id)
            if e != null { engine.engine_remove_model(e, m) }
            core.model_set_mesh(m, mesh)
            if e != null { engine.engine_add_model(e, m) }
        }
        i = i + 1
    }
    pull_ragdoll(r)
    if standing {
        human.human_align_spring(&r.human, p.world_id, r.stand_ground, r.stand_hertz, r.stand_damping_ratio)
        human.human_create_parallel_anchors(&r.human, p.world_id)
        r.standing = true
    }
}

// The reference's shape fitted to heads, tails (Vec3[BONE_COUNT] each,
// one after the other in `block`) and toes; the caller frees it.
fitted_shape(block: ptr, toes: ptr) -> ptr {
    shape = human.human_reference_shape()
    human.human_fit_shape(shape, block, block + human.BONE_COUNT * sizeof(Vec3), toes)
    return shape
}

// How far a shin's end moves, in metres, to measure how its foot moves.
const SOLE_PROBE = 0.05

// Both calves' tails in `block` moved along their shins, by one length,
// until the lower fitted foot's underside is level with the lower sole of
// the flesh the ankles carry. One length for both: the rig's legs keep
// their proportions, and the reference's own feet are not level (its
// right toe sits 8 mm below its left), which fitting each foot to its
// sole would turn into legs of two lengths. The underside moves with the
// tails in a straight line -- a foot rides its shin, stretched with it --
// so two fits measure that line and the third is exact. Unmoved where
// neither ankle carries flesh.
fit_soles(skeleton: *Skeleton, indices: int[], block: ptr, toes: ptr, placement: Transform) {
    v = block as Vec3[]
    sole = 0.0
    any = false
    calf = human.BONE_CALF_L
    while calf <= human.BONE_CALF_R {
        ankle = rig_ankle(skeleton, indices, calf)
        if ankle != null {
            flesh = skin.skeleton_bone_extreme(skeleton, rig_index(skeleton, ankle), core.vec3(0.0, 0.0 - 1.0, 0.0))
            if flesh.found && (!any || flesh.at.y < sole) {
                sole = flesh.at.y
                any = true
            }
        }
        calf = calf + 2
    }
    if !any { return }
    left = human.BONE_COUNT + human.BONE_CALF_L
    right = human.BONE_COUNT + human.BONE_CALF_R
    left_tail = v[left]
    right_tail = v[right]
    left_shin = core.v3_normalize(core.v3_sub(v[left], v[human.BONE_CALF_L]))
    right_shin = core.v3_normalize(core.v3_sub(v[right], v[human.BONE_CALF_R]))
    shape = fitted_shape(block, toes)
    low = feet_underside(shape, placement)
    free(shape)
    v[left] = core.v3_add(left_tail, core.v3_mul(left_shin, SOLE_PROBE))
    v[right] = core.v3_add(right_tail, core.v3_mul(right_shin, SOLE_PROBE))
    shape = fitted_shape(block, toes)
    slope = (feet_underside(shape, placement) - low) / SOLE_PROBE
    free(shape)
    move = 0.0
    if slope < 0.0 - 0.1 {
        move = (sole - low) / slope
        reach = 0.5 * core.v3_len(core.v3_sub(left_tail, v[human.BONE_CALF_L]))
        if move > reach { move = reach }
        if move < 0.0 - reach { move = 0.0 - reach }
    }
    v[left] = core.v3_add(left_tail, core.v3_mul(left_shin, move))
    v[right] = core.v3_add(right_tail, core.v3_mul(right_shin, move))
}

// The lower of a shape's two feet's undersides, in the world.
feet_underside(shape: ptr, placement: Transform) -> float {
    left = foot_underside(shape, placement, human.BONE_CALF_L)
    right = foot_underside(shape, placement, human.BONE_CALF_R)
    if right < left { return right }
    return left
}

// The lowest point of a calf's foot in a shape placed by `placement`,
// in the world: the lower end of its capsule, less its radius.
foot_underside(shape: ptr, placement: Transform, calf: int) -> float {
    spec = human.spec_at(shape, calf)
    c = spec.capsule
    if spec.has_foot { c = spec.foot }
    q = core.quat_mul(placement.q, spec.reference.q)
    p = core.v3_add(placement.p, core.quat_apply(placement.q, spec.reference.p))
    a = core.v3_add(p, core.quat_apply(q, c.center1))
    b = core.v3_add(p, core.quat_apply(q, c.center2))
    low = a.y
    if b.y < low { low = b.y }
    return low - c.radius
}

// A model's index among the skeleton's bones, or -1.
rig_index(skeleton: *Skeleton, m: *Model) -> int {
    count = skin.skeleton_count(skeleton)
    i = 0
    while i < count {
        if skin.skeleton_bone(skeleton, i) == m { return i }
        i = i + 1
    }
    return 0 - 1
}

// A calf's toe in the world: its toe bone's head; or, where the rig has
// none, the farthest point forward of the flesh the ankle carries (along
// rig_foot_direction). Not found when neither is there.
rig_toe_point(skeleton: *Skeleton, indices: int[], calf: int) -> Extreme {
    toe = rig_toe(skeleton, indices, calf)
    if toe != null { return Extreme { at: toe.world_position, found: true } }
    absent = Extreme { at: core.vec3(0.0, 0.0, 0.0), found: false }
    ankle = rig_ankle(skeleton, indices, calf)
    forward = rig_foot_direction(skeleton, indices, calf)
    if ankle == null || core.v3_len(forward) < 0.000001 { return absent }
    return skin.skeleton_bone_extreme(skeleton, rig_index(skeleton, ankle), core.v3_normalize(forward))
}

// A point in the world in the figure's own space.
figure_point(placement: Transform, at: Vec3) -> Vec3 {
    return core.quat_apply(core.quat_conjugate(placement.q), core.v3_sub(at, placement.p))
}

// Where a mapped bone's line ends on the rig, in the world: its next
// mapped bone's head along the chain the ragdoll is measured by (the
// chest's runs to the neck's, not to whichever child the exporter listed
// first: a clavicle, on a rig whose children sort by name); for a calf,
// its ankle's head (rig_ankle); for the neck or a forearm, its own first
// child's head (the head, the wrist); for a bone with none, the
// reference's line from the bone's head.
rig_tail(skeleton: *Skeleton, indices: int[], index: int, shape: ptr, placement: Transform) -> Vec3 {
    head = skin.skeleton_bone(skeleton, indices[index])
    next = human.human_chain_child(index)
    if next >= 0 {
        tail = skin.skeleton_bone(skeleton, indices[next])
        core.model_sync_transform(tail)
        return tail.world_position
    }
    child = rig_child(skeleton, head)
    if index == human.BONE_CALF_L || index == human.BONE_CALF_R { child = rig_ankle(skeleton, indices, index) }
    if child != null {
        core.model_sync_transform(child)
        return child.world_position
    }
    line = core.v3_sub(human.human_shape_tail(shape, index), human.human_shape_head(shape, index))
    return core.v3_add(head.world_position, core.quat_apply(placement.q, line))
}

// A bone's first child in the skeleton, or null.
rig_child(skeleton: *Skeleton, bone: *Model) -> *Model {
    count = skin.skeleton_count(skeleton)
    i = 0
    while i < count {
        other = skin.skeleton_bone(skeleton, i)
        if other != null && core.model_parent(other) == bone { return other }
        i = i + 1
    }
    return null
}

// A calf's ankle (`calf` a ragdoll bone, `indices` the rig's bone for
// each): the calf's first child; or, where the calf has none -- an IK rig
// hangs its feet from its root, as Blender's Rigify-style and Quaternius's
// rigs do -- the bone whose head lies on the leg's line, the thigh's head
// through the knee's carried on below the knee, nearest that line and
// within a fifth of the way down it of it (a pole target, out in front of
// the knee, is not). Null when there is none: the reference's line stands.
rig_ankle(skeleton: *Skeleton, indices: int[], calf: int) -> *Model {
    knee = skin.skeleton_bone(skeleton, indices[calf])
    child = rig_child(skeleton, knee)
    if child != null { return child }
    hip = skin.skeleton_bone(skeleton, indices[calf - 1])
    core.model_sync_transform(hip)
    core.model_sync_transform(knee)
    down = core.v3_sub(knee.world_position, hip.world_position)
    if core.v3_len(down) < 0.000001 { return null }
    down = core.v3_normalize(down)
    best = null as *Model
    best_off = 0.0
    count = skin.skeleton_count(skeleton)
    i = 0
    while i < count {
        other = skin.skeleton_bone(skeleton, i)
        if other != null && other != knee && !descends_from(knee, other) {
            core.model_sync_transform(other)
            to = core.v3_sub(other.world_position, knee.world_position)
            along = core.v3_dot(to, down)
            off = core.v3_len(core.v3_sub(to, core.v3_mul(down, along)))
            if along > 0.0 && off < 0.2 * along && (best == null || off < best_off) {
                best = other
                best_off = off
            }
        }
        i = i + 1
    }
    return best
}

// Whether `m` hangs below `ancestor` (or is it).
descends_from(m: *Model, ancestor: *Model) -> bool {
    at = m
    while at != null {
        if at == ancestor { return true }
        at = core.model_parent(at)
    }
    return false
}

// A calf's toe: its ankle's child, synced; null when the rig has none.
rig_toe(skeleton: *Skeleton, indices: int[], calf: int) -> *Model {
    ankle = rig_ankle(skeleton, indices, calf)
    if ankle == null { return null }
    toe = rig_child(skeleton, ankle)
    if toe != null { core.model_sync_transform(toe) }
    return toe
}

// The rig's root: the bone with no parent among the skeleton's bones, or
// the parent chain's top from the first bone.
rig_root(skeleton: *Skeleton) -> *Model {
    first = skin.skeleton_bone(skeleton, 0)
    if first == null { return null }
    top = first
    while core.model_parent(top) != null { top = core.model_parent(top) }
    return top
}

// Where the rig's foot points, along the ground: from the ankle to its
// child (the toe); or, for an ankle with none, along the ankle bone
// itself -- a glTF bone runs along its own +y, Blender's and Mixamo's
// alike -- where that lies nearer level than upright. Zero when neither
// says.
rig_foot_direction(skeleton: *Skeleton, indices: int[], calf: int) -> Vec3 {
    ankle = rig_ankle(skeleton, indices, calf)
    if ankle == null { return core.vec3(0.0, 0.0, 0.0) }
    core.model_sync_transform(ankle)
    toe = rig_toe(skeleton, indices, calf)
    d = core.vec3(0.0, 0.0, 0.0)
    if toe != null {
        d = core.v3_sub(toe.world_position, ankle.world_position)
    } else {
        d = core.quat_apply(ankle.world_rotation, core.vec3(0.0, 1.0, 0.0))
        if d.y * d.y > d.x * d.x + d.z * d.z { return core.vec3(0.0, 0.0, 0.0) }
    }
    return core.vec3(d.x, 0.0, d.z)
}

// Where the ragdoll's foot points, along the ground: the calf's foot
// capsule, its end farther off the shin's line the toe.
body_foot_direction(r: *Ragdoll, calf_index: int) -> Vec3 {
    return foot_direction_at(r, calf_index, dynamics.body_get_rotation(human.bone_at(&r.human, calf_index).body_id))
}

// The way the figure faces standing in the reference's pose, level: the
// way its knees do not bend. Each knee's hinge is bent a little toward
// the limit it has room to bend to, and where the ankle goes is behind;
// the two knees' behinds, averaged and turned round, are its front. (Not
// its toes: they splay, 23 degrees on the reference's figure, and a bow
// about an axis that far off would bend the knees sideways.)
ragdoll_rest_forward(r: *Ragdoll) -> Vec3 {
    back = core.v3_add(knee_back(r, human.BONE_CALF_L), knee_back(r, human.BONE_CALF_R))
    flat = core.vec3(0.0 - back.x, 0.0, 0.0 - back.z)
    if core.v3_len(flat) < 0.000001 { return core.vec3(0.0, 0.0, 1.0) }
    return core.v3_normalize(flat)
}

// Where a knee's bend takes its ankle, in the reference's pose, level.
knee_back(r: *Ragdoll, calf_index: int) -> Vec3 {
    calf = human.bone_at(&r.human, calf_index)
    thigh = human.bone_at(&r.human, calf.parent_index)
    qa = core.quat_mul(thigh.reference_frame.q, calf.local_frame_a.q)
    qb = core.quat_mul(calf.reference_frame.q, calf.local_frame_b.q)
    rel = core.quat_mul(core.quat_conjugate(qa), qb)
    angle = 2.0 * atan2(rel.z, rel.w)
    // Toward whichever limit is further: the way it bends.
    toward = 0.5
    if calf.twist_limit.y - angle < angle - calf.twist_limit.x { toward = 0.0 - 0.5 }
    axis = core.quat_apply(qa, core.vec3(0.0, 0.0, 1.0))
    knee = core.v3_add(thigh.reference_frame.p, core.quat_apply(thigh.reference_frame.q, calf.local_frame_a.p))
    far = bone_far_end(calf)
    shin = core.v3_sub(core.v3_add(calf.reference_frame.p, core.quat_apply(calf.reference_frame.q, far)), knee)
    moved = core.quat_apply(core.quat_rotate(toward, axis), shin)
    d = core.v3_sub(moved, shin)
    return core.vec3(d.x, 0.0, d.z)
}

// Where a calf's foot points, along the ground, were the calf at `rotation`.
foot_direction_at(r: *Ragdoll, calf_index: int, rotation: Quat) -> Vec3 {
    body = human.bone_at(&r.human, calf_index)
    if !dynamics.shape_is_valid(body.foot_shape_id) { return core.vec3(0.0, 0.0, 0.0) }
    leg = dynamics.shape_get_capsule(body.shape_id)
    foot = dynamics.shape_get_capsule(body.foot_shape_id)
    axis = core.v3_normalize(core.v3_sub(leg.center2, leg.center1))
    off1 = core.v3_len(core.v3_sub(core.v3_sub(foot.center1, leg.center1), core.v3_mul(axis, core.v3_dot(core.v3_sub(foot.center1, leg.center1), axis))))
    off2 = core.v3_len(core.v3_sub(core.v3_sub(foot.center2, leg.center1), core.v3_mul(axis, core.v3_dot(core.v3_sub(foot.center2, leg.center1), axis))))
    local = core.v3_sub(foot.center1, foot.center2)
    if off2 > off1 { local = core.v3_sub(foot.center2, foot.center1) }
    d = core.quat_apply(rotation, local)
    return core.vec3(d.x, 0.0, d.z)
}

// The way a bone runs from its joint, in its body's frame: a unit vector
// toward its far end. The reference's left limbs run along their bodies'
// +x and its right ones along -x, so nothing can take one axis for all.
ragdoll_bone_axis(r: *Ragdoll, index: int) -> Vec3 {
    return core.v3_normalize(bone_far_end(human.bone_at(&r.human, index)))
}

// A bone's far end in its body's frame: the end of its own capsule (a
// calf's shin, not its foot) farther from its joint.
bone_far_end(bone: *HumanBone) -> Vec3 {
    c = dynamics.shape_get_capsule(bone.shape_id)
    if core.v3_len(c.center2) > core.v3_len(c.center1) { return c.center2 }
    return c.center1
}

// The rig after the step: the root where the pelvis carries it, every
// mapped bone at its body's rotation, parents before children so a
// child's local rotation is taken against its parent's new one, and an
// IK foot where its calf carries it; the unmapped bones (a wrist, a toe,
// the crown) keep their own and follow.
pose_rig(r: *Ragdoll) {
    pose_rig_from(r, null)
}

// The rig from a pose (BONE_COUNT * POSE_STRIDE floats), or from the
// bodies as they are when `pose` is null.
pose_rig_from(r: *Ragdoll, pose: ptr) {
    rig = r.rig as *Rig
    bones = rig.bones as RigBone[]
    skeleton = rig.skeleton as *Skeleton
    root = rig.root as *Model
    pelvis_t = pose_or_body(r, pose, human.BONE_PELVIS)
    root_p = core.v3_add(pelvis_t.p, core.quat_apply(pelvis_t.q, rig.root_offset_p))
    root_q = core.quat_mul(pelvis_t.q, rig.root_offset_q)
    set_world_rotation(root, root_q)
    parent = core.model_parent(root)
    if parent == null {
        core.model_set_position(root, root_p.x, root_p.y, root_p.z)
    } else {
        core.model_sync_transform(parent)
        local = core.quat_apply(core.quat_conjugate(parent.world_rotation), core.v3_sub(root_p, parent.world_position))
        core.model_set_position(root, local.x / parent.world_scale.x, local.y / parent.world_scale.y, local.z / parent.world_scale.z)
    }
    count = skin.skeleton_count(skeleton)
    i = 0
    while i < count {
        bone = skin.skeleton_bone(skeleton, i)
        k = 0
        while k < human.BONE_COUNT {
            if bones[k].model == bone as ptr {
                t = pose_or_body(r, pose, k)
                set_world_rotation(bone, core.quat_mul(t.q, bones[k].offset))
                // The pelvis's bone set where its body is, not only turned:
                // the root is put so the hips land on the pelvis as the
                // bind pose has them, but a clip held under the ragdoll
                // moves the hips about the root -- the plaza's walk held
                // ready to land -- and every drawn bone went with them,
                // 0.3 to 0.6 m off the bodies and the knees and toes into
                // the ground as a struck walker got up.
                if k == human.BONE_PELVIS { set_world_position(bone, core.v3_add(t.p, core.quat_apply(t.q, bones[k].offset_p))) }
                break
            }
            k = k + 1
        }
        i = i + 1
    }
    feet = rig.feet as RigBone[]
    side = 0
    while side < 2 {
        foot = feet[side].model as *Model
        if foot != null {
            calf = human.BONE_CALF_L
            if side == 1 { calf = human.BONE_CALF_R }
            t = pose_or_body(r, pose, calf)
            set_world_rotation(foot, core.quat_mul(t.q, feet[side].offset))
            set_world_position(foot, core.v3_add(t.p, core.quat_apply(t.q, feet[side].offset_p)))
        }
        toe_on_ground(r, side)
        side = side + 1
    }
}

// The drawn foot turned up about its ankle so its toe is not under the
// ground: what the ankle the bodies lack would do (a calf's body carries
// its foot rigidly). The drawn foot, held as the clip left it, toes
// pointed, went 5 to 16 cm into the ground under a struck figure lying,
// kneeling or getting up, its bodies on the ground.
toe_on_ground(r: *Ragdoll, side: int) {
    rig = r.rig as *Rig
    if rig.ankles == null || rig.toes == null { return }
    ankle = (rig.ankles as ptr[])[side] as *Model
    toe = (rig.toes as ptr[])[side] as *Model
    if ankle == null || toe == null { return }
    core.model_sync_transform(ankle)
    core.model_sync_transform(toe)
    a = ankle.world_position
    t = toe.world_position
    hit = ray_static_hit(r.physics as *Physics, core.vec3(t.x, a.y + TOE_LOOK, t.z), core.vec3(0.0, 0.0 - 1.0, 0.0), TOE_LOOK * 2.0)
    if !hit.hit { return }
    floor = hit.point.y + TOE_UP
    if t.y >= floor { return }
    v = core.v3_sub(t, a)
    reach = core.v3_len(v)
    if reach < 0.0001 { return }
    want_y = core.clampf(floor - a.y, 0.0 - reach, reach)
    level = sqrt(core.clampf(reach * reach - want_y * want_y, 0.0, 1000.0))
    flat = core.vec3(v.x, 0.0, v.z)
    if core.v3_len(flat) < 0.0001 { return }
    flat = core.v3_normalize(flat)
    want = core.vec3(flat.x * level, want_y, flat.z * level)
    turn = core.quat_from_to(core.v3_normalize(v), core.v3_normalize(want))
    if (rig.ankle_turned as int[])[side] == 0 {
        (rig.ankle_own as Quat[])[side] = ankle.rotation
        (rig.ankle_turned as int[])[side] = 1
    }
    set_world_rotation(ankle, core.quat_normalize(core.quat_mul(turn, ankle.world_rotation)))
}

// The ankles' own turns back, where toe_on_ground turned them: handed back
// to its animation, a figure's ankle kept the turn the drawing had given it
// -- an ankle no clip keys stays as the bodies left it -- and a zombie
// given back to the horde had a foot 305 mm off its pose.
untoe(r: *Ragdoll) {
    rig = r.rig as *Rig
    if rig.ankles == null || rig.ankle_turned == null { return }
    side = 0
    while side < 2 {
        if (rig.ankle_turned as int[])[side] == 1 {
            core.model_set_rotation((rig.ankles as ptr[])[side] as *Model, (rig.ankle_own as Quat[])[side])
            (rig.ankle_turned as int[])[side] = 0
        }
        side = side + 1
    }
}

pose_or_body(r: *Ragdoll, pose: ptr, index: int) -> Transform {
    if pose == null { return dynamics.body_get_transform(human.bone_at(&r.human, index).body_id) }
    return pose_get(pose as float[], index)
}

// A model's local position for a world one, against its parent's current world transform.
set_world_position(m: *Model, world: Vec3) {
    parent = core.model_parent(m)
    if parent == null {
        core.model_set_position(m, world.x, world.y, world.z)
        return
    }
    core.model_sync_transform(parent)
    local = core.quat_apply(core.quat_conjugate(parent.world_rotation), core.v3_sub(world, parent.world_position))
    core.model_set_position(m, local.x / parent.world_scale.x, local.y / parent.world_scale.y, local.z / parent.world_scale.z)
}

// A model's local rotation for a world one, against its parent's current world rotation.
set_world_rotation(m: *Model, world: Quat) {
    parent = core.model_parent(m)
    if parent == null {
        core.model_set_rotation(m, core.quat_normalize(world))
        return
    }
    core.model_sync_transform(parent)
    core.model_set_rotation(m, core.quat_normalize(core.quat_mul(core.quat_conjugate(parent.world_rotation), world)))
}

// --- a character controller -----------------------------------------------------------------------------------
//
// A player's body, as a game wants one (#420): a capsule that walks the
// world rather than a rigid body that tumbles through it. Box3D's character
// mover, the way its sample drives it: each move gathers the planes the
// capsule touches (collide_mover), solves the wanted translation out of
// them (solve_planes), casts the capsule along the result (cast_mover) and
// takes what it can -- up to five times, until the move is spent -- and the
// velocity is clipped against the planes that pushed.
//
// The capsule rides a step height above the feet, so a kerb or a stair
// lower than that passes under it; a ray from there down finds the ground,
// and where the ground is walkable -- flatter than the slope limit -- the
// feet are put on it. Steeper ground is a wall the capsule slides off.

const CHARACTER_PLANES = 32
const CHARACTER_ITERATIONS = 5

struct CharacterController {
    physics: ptr                   // *Physics
    object: ptr                    // *GameObject; its position is the feet
    radius: float
    height: float                  // feet to the top of the head
    step_height: float             // the capsule's gap above the feet: what it walks up
    slope_cos: float               // the cosine of the steepest walkable ground
    velocity: Vec3
    grounded: bool
    ground_normal: Vec3
    planes: ptr                    // CollisionPlane[CHARACTER_PLANES]
    plane_count: int
    push_force: float              // newtons: what it pushes a dynamic body it walks into with
    pushing: bool                  // this move's first contact pass, when pushes are applied
    origin: Vec3                   // the feet the planes are relative to, this pass
    step_seconds: float
    pushed: ptr                    // BodyId[CHARACTER_PLANES]: pushed already this move
    pushed_count: int
    lift: float                    // the object's origin above its feet: 0 for a figure whose origin is its feet
    driven: bool                   // something has moved it (character_move); until then the world stands it
    world_only: bool               // an overlap query of the static world alone
    owned: bool                    // made from a scene record: the world's to free
    ignore: ptr                    // *Ragdoll: its own figure's, not met (character_ignore)
}

// A character controller on `o`, whose position is the feet: a capsule of
// `radius` reaching `height` above them. Walks up steps to 0.35 m and slopes
// to 45 degrees until told otherwise.
character_controller(o: *GameObject, radius: float, height: float) -> *CharacterController {
    e = engine.of(o)
    p = of(e)
    c = heap.new(CharacterController)
    c.physics = p as ptr
    c.object = o as ptr
    c.radius = radius
    c.height = height
    c.step_height = 0.35
    c.slope_cos = 0.7071
    c.velocity = core.vec3(0.0, 0.0, 0.0)
    c.ground_normal = core.vec3(0.0, 1.0, 0.0)
    c.planes = calloc(CHARACTER_PLANES, sizeof(CollisionPlane))
    c.pushed = calloc(CHARACTER_PLANES, sizeof(BodyId))
    c.push_force = 400.0
    if p != null { list.add_raw(p.characters, c as ptr) }
    return c
}

character_free(c: *CharacterController) {
    if c == null { return }
    p = c.physics as *Physics
    if p != null {
        i = 0
        while i < list.size(p.characters) {
            if list.get_raw(p.characters, i) == c as ptr { list.remove(p.characters, i); break }
            i = i + 1
        }
    }
    character_release(c)
}

character_release(c: *CharacterController) {
    free(c.planes)
    free(c.pushed)
    heap.free(c)
}

// The character on an object, or null.
character_of(o: *GameObject) -> *CharacterController {
    e = engine.of(o)
    if e == null { return null }
    p = of(e)
    if p == null { return null }
    i = 0
    while i < list.size(p.characters) {
        c = list.get_raw(p.characters, i) as *CharacterController
        if c.object == o as ptr { return c }
        i = i + 1
    }
    return null
}

// Where its feet are: the object's origin less the lift.
character_feet(c: *CharacterController) -> Vec3 {
    at = behaviour.object_position(c.object as *GameObject)
    return core.vec3(at.x, at.y - c.lift, at.z)
}

character_set_slope_limit(c: *CharacterController, degrees: float) {
    c.slope_cos = core.cos_of(core.deg_to_rad(degrees))
}

character_set_step_height(c: *CharacterController, metres: float) {
    if metres >= 0.0 { c.step_height = metres }
}

character_grounded(c: *CharacterController) -> bool { return c.grounded }
character_velocity(c: *CharacterController) -> Vec3 { return c.velocity }
character_ground_normal(c: *CharacterController) -> Vec3 { return c.ground_normal }

// The capsule, relative to the feet: from a step height up to the head.
character_capsule(c: *CharacterController) -> Capsule {
    bottom = c.step_height + c.radius
    top = c.height - c.radius
    if top < bottom { top = bottom }
    return Capsule { center1: core.vec3(0.0, bottom, 0.0), center2: core.vec3(0.0, top, 0.0), radius: c.radius }
}

// The planes a shape offers the capsule, onto the controller's list. A plane
// that pushes the capsule up is laid flat through the point of contact, a
// wall that pushes only sideways:
//   - on the ground, every one. The capsule floats a step height over the
//     feet and the ground ray alone decides what is stepped onto, so what
//     touches its round bottom is higher than a step. A walkable ramp never
//     reaches the bottom sphere (it would take a slope past 65 degrees
//     within the radius). Taken as it came, the plane of a kerb's edge
//     against that sphere tilts up -- n.y 0.83 for a 0.4 m kerb, walkable --
//     and the capsule was lifted over anything up to the step height plus
//     r(1 - cos 45) (#527).
//   - in the air, the steep ones: a walkable plane under a falling capsule
//     lands it, but a steep one taken as it came turned a walk into it into
//     a climb -- the walk clipped against a 50 degree slope points up it,
//     faster than gravity slid it down, and the capsule walked a metre up
//     ground it is set to refuse (#527).
character_plane_visitor(shape_id: ShapeId, results: PlaneResult[], count: int, context: ptr) -> bool {
    c = context as *CharacterController
    if c.world_only && dynamics.body_get_type(dynamics.shape_get_body(shape_id)) != dynamics.BODY_STATIC { return true }
    if own_body(c, shape_id) { return true }
    planes = c.planes as CollisionPlane[]
    i = 0
    while i < count && c.plane_count < CHARACTER_PLANES {
        plane = results[i].plane
        n = plane.normal
        if n.y > 0.0 && (c.grounded || n.y < c.slope_cos) {
            // A mover's plane is a constraint on the capsule's move, not a
            // surface: dot(normal, move) - offset is the capsule's
            // separation, so the offset is its overlap, negated. Laid flat,
            // the plane keeps the separation it measures, over the
            // horizontal share of the normal that now resolves it.
            flat = sqrt(n.x * n.x + n.z * n.z)
            if flat > 0.0001 {
                wall = core.vec3(n.x / flat, 0.0, n.z / flat)
                plane = math.plane(wall, plane.offset / flat)
            }
        }
        planes[c.plane_count] = mover.collision_plane(plane, math.MAX_FLOAT, true)
        c.plane_count = c.plane_count + 1
        i = i + 1
    }
    // A dynamic body it walks into is pushed, with a person's force, along
    // the character's own motion into it -- once a move -- and moves if that
    // is more than what holds it; a crate slides and the character follows
    // at its pace, a car does not and is a wall.
    if c.pushing && count > 0 && c.push_force > 0.0 {
        body = dynamics.shape_get_body(shape_id)
        if dynamics.body_get_type(body) == dynamics.BODY_DYNAMIC && !already_pushed(c, body) {
            n = results[0].plane.normal
            flat = sqrt(n.x * n.x + n.z * n.z)
            into = core.v3_dot(c.velocity, core.vec3(0.0 - n.x, 0.0, 0.0 - n.z))
            if flat > 0.0001 && into > 0.0 {
                // No more than it takes to bring the body up to the
                // character's pace: a person leans on a crate at a walk,
                // not throws it.
                dir = core.vec3(0.0 - n.x / flat, 0.0, 0.0 - n.z / flat)
                lag = into - core.v3_dot(dynamics.body_get_linear_velocity(body), dir)
                push = c.push_force * c.step_seconds
                needed = dynamics.body_get_mass(body) * lag
                if needed < push { push = needed }
                if push < 0.0 { push = 0.0 }
                impulse = core.v3_mul(dir, push)
                dynamics.body_apply_linear_impulse(body, impulse, core.v3_add(c.origin, results[0].point), true)
                marks = c.pushed as BodyId[]
                if c.pushed_count < CHARACTER_PLANES {
                    marks[c.pushed_count] = body
                    c.pushed_count = c.pushed_count + 1
                }
            }
        }
    }
    return true
}

already_pushed(c: *CharacterController, body: BodyId) -> bool {
    marks = c.pushed as BodyId[]
    i = 0
    while i < c.pushed_count {
        if marks[i].index1 == body.index1 && marks[i].world0 == body.world0 && marks[i].generation == body.generation { return true }
        i = i + 1
    }
    return false
}

character_cast_filter(shape_id: ShapeId, context: ptr) -> bool {
    if context == null { return true }
    c = context as *CharacterController
    return !own_body(c, shape_id)
}

// Whether a shape is a body of the ragdoll the character's own figure has
// (character_ignore).
own_body(c: *CharacterController, shape_id: ShapeId) -> bool {
    if c.ignore == null { return false }
    return dynamics.body_get_user_data(dynamics.shape_get_body(shape_id)) == c.ignore
}

// The ragdoll its own figure has, which the character walks through rather
// than out of: met, a walker's capsule stood inside its own bodies once
// they were in the world, was pushed out of them down through the ground,
// and walked on below it.
character_ignore(c: *CharacterController, r: *Ragdoll) {
    if c != null { c.ignore = r as ptr }
}

// The deepest the capsule is into anything now, in metres: 0 when it
// touches nothing or only rests against it.
character_overlap(c: *CharacterController) -> float {
    p = c.physics as *Physics
    grounded = c.grounded
    c.grounded = false              // the planes as they are, none laid flat
    c.pushing = false
    c.plane_count = 0
    physics_world.collide_mover(p.world_id, character_feet(c), character_capsule(c),
                                shape.default_query_filter(), character_plane_visitor, c as ptr)
    c.grounded = grounded
    planes = c.planes as CollisionPlane[]
    deepest = 0.0
    i = 0
    while i < c.plane_count {
        if planes[i].plane.offset > deepest { deepest = planes[i].plane.offset }
        i = i + 1
    }
    return deepest
}

// How deep the capsule is into the static world alone -- the buildings,
// kerbs and steps it walks among, not a crate it leans on or a figure that
// walks into it -- in metres.
character_overlap_world(c: *CharacterController) -> float {
    c.world_only = true
    deepest = character_overlap(c)
    c.world_only = false
    return deepest
}

// One move of `delta` seconds: `walk` is the horizontal velocity asked for
// (metres a second; its y is ignored), `jump` a vertical speed to leave the
// ground at (0 for none, and only from the ground). Gravity pulls a
// character off the ground; the world pushes back.
character_move(c: *CharacterController, walk: Vec3, jump: float, delta: float) {
    c.driven = true
    character_step(c, walk, jump, delta)
}

character_step(c: *CharacterController, walk: Vec3, jump: float, delta: float) {
    p = c.physics as *Physics
    o = c.object as *GameObject
    gravity = physics_world.get_gravity(p.world_id)
    vy = c.velocity.y
    if c.grounded {
        vy = 0.0
        if jump > 0.0 { vy = jump }
    } else {
        vy = vy + gravity.y * delta
    }
    c.velocity = core.vec3(walk.x, vy, walk.z)
    feet = character_feet(c)
    capsule = character_capsule(c)
    filter = shape.default_query_filter()
    // Box3D's order: the capsule cast along what is left of the move and
    // moved as far as the world lets it, the planes it then touches
    // gathered and solved for no move at all -- only out of any overlap --
    // and what is left of the move, and the velocity, clipped against them,
    // so a wall is slid along rather than crept into. Solving the whole move
    // against the planes before casting let the solver's slop take the
    // capsule a few millimetres into a wall each step, and through it in a
    // second.
    remaining = core.v3_mul(c.velocity, delta)
    c.step_seconds = delta
    c.pushed_count = 0
    iteration = 0
    while iteration < CHARACTER_ITERATIONS {
        fraction = physics_world.cast_mover(p.world_id, feet, capsule, remaining, filter, true, character_cast_filter, c as ptr)
        feet = core.v3_add(feet, core.v3_mul(remaining, fraction))
        c.plane_count = 0
        c.pushing = true
        c.origin = feet
        physics_world.collide_mover(p.world_id, feet, capsule, filter, character_plane_visitor, c as ptr)
        c.pushing = false
        solved = mover.solve_planes(core.vec3(0.0, 0.0, 0.0), c.planes as CollisionPlane[], c.plane_count)
        feet = core.v3_add(feet, solved.delta)
        remaining = mover.clip_vector(core.v3_mul(remaining, 1.0 - fraction), c.planes as CollisionPlane[], c.plane_count)
        c.velocity = mover.clip_vector(c.velocity, c.planes as CollisionPlane[], c.plane_count)
        if core.v3_len(remaining) < 0.0001 { break }
        iteration = iteration + 1
    }

    // The ground: a ray from the capsule's bottom down past the feet, as far
    // as the step height below them when it stood last step (so it follows
    // the ground down a ramp or a stair), and only to the feet when it is in
    // the air. Walkable ground puts the feet on it.
    reach = c.step_height + 0.01
    if c.grounded { reach = c.step_height * 2.0 }
    origin = core.v3_add(feet, core.vec3(0.0, c.step_height, 0.0))
    hit = physics_world.cast_ray_closest(p.world_id, origin, core.vec3(0.0, 0.0 - reach, 0.0), filter)
    c.grounded = false
    if hit.hit && hit.normal.y >= c.slope_cos && c.velocity.y <= 0.0 {
        // Down onto it only as far as the capsule fits: a ray finds the
        // floor of a gap narrower than the capsule (an alley between two
        // buildings, a slot between crates), and putting the feet on it put
        // the capsule 72 mm into a wall. Where it cannot get down, it stays
        // up, off the ground, and falls as far as its next move lets it.
        // Up onto it only where its head fits too: a step under an awning
        // put the capsule 250 mm into the awning. Where it cannot get up,
        // the step is a wall.
        drop = hit.point.y - feet.y
        fits = true
        if drop < 0.0 {
            fraction = physics_world.cast_mover(p.world_id, feet, capsule, core.vec3(0.0, drop, 0.0), filter, true,
                                                character_cast_filter, c as ptr)
            if fraction < 0.999 {
                fits = false
                feet = core.vec3(feet.x, feet.y + drop * fraction, feet.z)
            }
        } else if drop > 0.001 {
            fraction = physics_world.cast_mover(p.world_id, feet, capsule, core.vec3(0.0, drop, 0.0), filter, true,
                                                character_cast_filter, c as ptr)
            if fraction < 0.999 { fits = false }
        }
        if fits {
            feet = core.vec3(feet.x, hit.point.y, feet.z)
            c.grounded = true
            c.ground_normal = hit.normal
            c.velocity = core.vec3(c.velocity.x, 0.0, c.velocity.z)
        }
    }
    // The ray is one line under the capsule's middle; the capsule is round
    // and wide. Where two floors overlap a centimetre apart (an alley's
    // floor over the ground beneath it), the ray found the lower and the
    // capsule sat 10 mm into the upper, standing or landing: out of
    // whatever it ends in, by the planes it touches, as a move is.
    c.plane_count = 0
    physics_world.collide_mover(p.world_id, feet, capsule, filter, character_plane_visitor, c as ptr)
    out = mover.solve_planes(core.vec3(0.0, 0.0, 0.0), c.planes as CollisionPlane[], c.plane_count)
    feet = core.v3_add(feet, out.delta)
    behaviour.object_set_position(o, core.vec3(feet.x, feet.y + c.lift, feet.z))
}
