// A game's walkers' fields on the agent channel (#510): nav.fields and
// nav.path. ae3d.nav knows nothing of the channel -- a headless crowd
// simulation should not carry the renderers the channel imports -- so a game
// that wants its fields seen hands them here by name.
//
//     navagent.expose(field, "horde")
//
// nav.path asks a field for the walk between two places (nav.flow_path): an
// agent checking that the gate is reachable from the yard, or why a walker
// stands still, reads the corners and the cost without touching the target
// the walkers steer by.

import std.list
import std.heap
import std.string
import std.json
import ae3d.core
import ae3d.nav
import ae3d.agent

exports (expose, forget, exposed_count)

struct Exposed {
    name: string
    field: ptr                     // *FlowField, the game's
}

var g_fields: ptr = null           // list of *Exposed
var g_answering = false

// The field on the channel by `name` (a second under one name takes its
// place). The field stays the game's; forget it before freeing it.
expose(field: @keep ptr, name: string) {
    if g_fields == null { g_fields = list.new() }
    i = 0
    while i < list.size(g_fields) {
        x = list.get_raw(g_fields, i) as *Exposed
        if string.equals(x.name, name) == 1 {
            x.field = field
            return
        }
        i = i + 1
    }
    x = heap.new(Exposed)
    x.name = string.copy(name)
    x.field = field
    list.add_raw(g_fields, x as ptr)
    if !g_answering {
        agent.provide("nav.", answer_op, null)
        g_answering = true
    }
}

// The field off the channel, before the game frees it.
forget(field: ptr) {
    if g_fields == null { return }
    i = 0
    while i < list.size(g_fields) {
        x = list.get_raw(g_fields, i) as *Exposed
        if x.field == field {
            string.free(x.name)
            heap.free(x)
            list.remove(g_fields, i)
            return
        }
        i = i + 1
    }
}

exposed_count() -> int {
    if g_fields == null { return 0 }
    return list.size(g_fields)
}

field_named(name: string) -> *Exposed {
    if g_fields == null || list.size(g_fields) == 0 { return null }
    if name == "" { return list.get_raw(g_fields, 0) as *Exposed }
    i = 0
    while i < list.size(g_fields) {
        x = list.get_raw(g_fields, i) as *Exposed
        if string.equals(x.name, name) == 1 { return x }
        i = i + 1
    }
    return null
}

point_arg(request: ptr, name: string) -> (Vec3, bool) {
    node = json.object_get_raw(request, name)
    if node == null || json.array_size(node) < 2 { return core.vec3(0.0, 0.0, 0.0), false }
    // [x, z], or [x, y, z] with y passed over.
    if json.array_size(node) >= 3 {
        return core.vec3(json.get_number(json.array_get_raw(node, 0)), 0.0, json.get_number(json.array_get_raw(node, 2))), true
    }
    return core.vec3(json.get_number(json.array_get_raw(node, 0)), 0.0, json.get_number(json.array_get_raw(node, 1))), true
}

answer_op(context: ptr, op: string, request: ptr) -> ptr {
    if op == "nav.fields" {
        out = json.obj()
        items = json.arr()
        i = 0
        while i < exposed_count() {
            x = list.get_raw(g_fields, i) as *Exposed
            f = x.field as *FlowField
            entry = json.obj()
            json.object_set_raw(entry, "name", json.str(x.name))
            json.object_set_raw(entry, "width", json.from_int(nav.flow_width(f)))
            json.object_set_raw(entry, "height", json.from_int(nav.flow_height(f)))
            json.array_add_raw(items, entry)
            i = i + 1
        }
        json.object_set_raw(out, "fields", items)
        return out
    }
    if op != "nav.path" { return json.str("unknown op ${op}; nav.fields and nav.path are ae3d.navagent's") }
    name = ""
    node = json.object_get_raw(request, "field")
    if node != null { name = json.get_string_raw(node) }
    x = field_named(name)
    if x == null { return json.str("no field ${name} on the channel (navagent.expose puts one there; nav.fields names them)") }
    from, has_from = point_arg(request, "from")
    to, has_to = point_arg(request, "to")
    if !has_from || !has_to { return json.str("nav.path needs from and to, [x, z] or [x, y, z] each") }
    p = nav.flow_path(x.field as *FlowField, from, to)
    out = json.obj()
    json.object_set_raw(out, "field", json.str(x.name))
    json.object_set_raw(out, "reached", json.boolean(p.cost >= 0))
    // Tenths of a cell, the flood's measure; -1 for no walk.
    json.object_set_raw(out, "cost", json.from_int(p.cost))
    points = json.arr()
    i = 0
    while i < p.count {
        pt = json.arr()
        json.array_add_raw(pt, json.num(nav.path_point_x(p, i)))
        json.array_add_raw(pt, json.num(nav.path_point_z(p, i)))
        json.array_add_raw(points, pt)
        i = i + 1
    }
    json.object_set_raw(out, "points", points)
    nav.path_free(p)
    return out
}
