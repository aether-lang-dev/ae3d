// ae3d.vksky -- the sky's light on the Vulkan backend (#655).
//
// Each frame, before the scene pass, the sky is drawn into an octahedral
// map (ae3d.shaders.skydome's sky_capture: the sky in every direction, the
// sun's and the moon's discs left to the key light), halved down its mips
// by blits, and from it two things the scene shader reads:
//
//   - the irradiance onto every normal, a small octahedral map, the
//     capture's mip of that size cosine-convolved (ae3d.shaders.skyprobe);
//   - the reflections, the capture prefiltered by GGX into roughness levels
//     (ae3d.shaders.skyprobe), one pass a level.
//
// With the split-sum table (ae3d.skylight, made once) they are bindings 10,
// 11 and 12 of every set (ae3d.vkdesc). All in the frame, so the first
// frame drawn is lit by its own sky.

import contrib.vulkan.vk
import std.mem
import ae3d.core
import ae3d.skylight
import ae3d.vkdevice
import ae3d.vkhost
import ae3d.vktexture
import ae3d.vktargets
import ae3d.vkframe
import ae3d.vkdesc
import ae3d.vkscene
import ae3d.vkquote
import ae3d.vkquote (QuotedPass)
import ae3d.vkspirv
import ae3d.gpu
import ae3d.shaders.skyprobe
import ae3d.shaders.envmap
import ae3d.envimage
import ae3d.hdrimage
import ae3d.shaderlib (Texture, vec3)

exports (
    start, stop, capture, irradiance_at, reflections_view, reflections_sampler, set_ground, set_environment, environment
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcmp(a: ptr, b: ptr, n: long) -> int
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr

// ae3d.skylight's SIZE, LEVELS and IRRADIANCE_SIZE, which the shaders are
// written for; the capture's levels run from SIZE down to one texel.
const SIZE = 256
const LEVELS = 6
const IRRADIANCE = 16
const CAPTURE_LEVELS = 9
// The words a capture is drawn from (inputs_now).
const INPUT_WORDS = 32

var g_capture = 0                    // the capture, in the texture table: all its levels
// What the last capture was drawn from (inputs_now), and whether there was
// one: the sky is captured again only when something it is drawn from moved.
var g_inputs: ptr = null
var g_inputs_now: ptr = null
var g_captured = false
var g_capture_image: ptr = null
var g_capture_view: ptr = null       // its level 0, drawn into
var g_capture_framebuffer: ptr = null
var g_lit_image: ptr = null
var g_lit_memory: ptr = null
var g_lit_view: ptr = null           // all its levels, sampled
var g_lit_sampler: ptr = null
var g_lit_views: ptr = null          // VkImageView[LEVELS]
var g_lit_framebuffers: ptr = null   // VkFramebuffer[LEVELS]
var g_irradiance_image: ptr = null
var g_irradiance_memory: ptr = null
var g_irradiance_view: ptr = null
var g_irradiance_sampler: ptr = null
var g_irradiance_framebuffer: ptr = null
var g_table = 0                      // the split-sum table, in the texture table
// The irradiance and the reflections' levels made from the capture, written
// with quote (ae3d.shaders.skyprobe): one draw a capture, and one a level.
var g_irradiance_pass: ptr = null
// The ground the irradiance sees under the horizon (#740): its albedo, then
// the sun's light onto level ground, six f32s as the renderer gives them
// (set_ground). They were the scene block's groundAlbedo and groundSun,
// which only the hand-written irradiance read.
var g_ground: ptr = null
var g_filter_pass: ptr = null
// The user's environment map in place of the sky (#869): its texture in the
// table (0 for none: the sky), the light scale and the mip it is read from,
// and whether the capture has been made from it yet.
var g_env_pass: ptr = null
var g_env_texture = 0
var g_env_half_v = 0.0
var g_env_lod = 0.0
var g_env_intensity = 1.0
var g_env_drawn = false

// A view of one level of `image`.
level_view(image: @keep ptr, level: int) -> ptr {
    info = calloc(1, sizeof(VkImageViewCreateInfo)) as *VkImageViewCreateInfo
    info.sType = vk.STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
    info.image = image
    info.viewType = vk.IMAGE_VIEW_TYPE_2D
    info.format = vktargets.scene_format()
    info.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    info.subresourceRange.baseMipLevel = level
    info.subresourceRange.levelCount = 1
    info.subresourceRange.layerCount = 1
    cell = calloc(1, 8)
    r = vk.vkCreateImageView(vkhost.device(), info as ptr, null, cell)
    view = (cell as ptr[])[0]
    free(cell)
    free(info as ptr)
    if r != vk.SUCCESS { return null }
    return view
}

// A framebuffer of the HDR screen pass over `view`, `size` a side.
framebuffer(view: @keep ptr, size: int) -> ptr {
    views = calloc(1, 8)
    (views as ptr[])[0] = view
    info = calloc(1, sizeof(VkFramebufferCreateInfo)) as *VkFramebufferCreateInfo
    info.sType = vk.STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
    info.renderPass = vktargets.hdr_pass()
    info.attachmentCount = 1
    info.pAttachments = views
    info.width = size
    info.height = size
    info.layers = 1
    cell = calloc(1, 8)
    r = vk.vkCreateFramebuffer(vkhost.device(), info as ptr, null, cell)
    made = (cell as ptr[])[0]
    free(cell)
    free(info as ptr)
    free(views)
    if r != vk.SUCCESS { return null }
    return made
}

// A layout change of levels `base` on (`count` of them) of `image`.
turn(commands: ptr, image: @keep ptr, base: int, count: int, from: int, to: int, src_access: int, dst_access: int,
     src_stage: int, dst_stage: int) {
    b = calloc(1, sizeof(VkImageMemoryBarrier)) as *VkImageMemoryBarrier
    b.sType = vk.STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
    b.oldLayout = from
    b.newLayout = to
    b.srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.image = image
    b.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    b.subresourceRange.baseMipLevel = base
    b.subresourceRange.levelCount = count
    b.subresourceRange.layerCount = 1
    b.srcAccessMask = src_access
    b.dstAccessMask = dst_access
    vk.vkCmdPipelineBarrier(commands, src_stage, dst_stage, 0, 0, null, 0, null, 1, b as ptr)
    free(b as ptr)
}

// Every level of `image` cleared to black and left shader-readable, so a
// set naming it before its first capture reads a defined image.
blacked(commands: ptr, image: @keep ptr, levels: int) {
    turn(commands, image, 0, levels, vk.IMAGE_LAYOUT_UNDEFINED, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
         0, vk.ACCESS_TRANSFER_WRITE_BIT, vk.PIPELINE_STAGE_TOP_OF_PIPE_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    colour = calloc(4, 4)              // a VkClearColorValue: black
    range = calloc(1, sizeof(VkImageSubresourceRange)) as *VkImageSubresourceRange
    range.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    range.levelCount = levels
    range.layerCount = 1
    vk.vkCmdClearColorImage(commands, image, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, colour, 1, range as ptr)
    free(colour)
    free(range as ptr)
    turn(commands, image, 0, levels, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
         vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_SHADER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT,
         vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT)
}

// The split-sum table as half floats, in the texture table.
table() -> int {
    values = skylight.brdf_lut() as float[]
    count = skylight.LUT_SIZE * skylight.LUT_SIZE * 2
    halves = calloc(count, 2)
    i = 0
    while i < count {
        mem.set_uint16(halves, i * 2, core.half_bits(values[i]))
        i = i + 1
    }
    handle = vktexture.texture_create_table(skylight.LUT_SIZE, skylight.LUT_SIZE, halves)
    free(halves)
    free(values as ptr)
    return handle
}

// The images, their views and framebuffers, the table, and the sets told
// of them. False, with the reason in the backend's last error, when one
// would not make.
start() -> bool {
    format = vktargets.scene_format()
    usage = vk.IMAGE_USAGE_COLOR_ATTACHMENT_BIT | vk.IMAGE_USAGE_SAMPLED_BIT | vk.IMAGE_USAGE_TRANSFER_DST_BIT
    capture = vkhost.image(SIZE, SIZE, CAPTURE_LEVELS, format, vk.SAMPLE_COUNT_1_BIT,
                           usage | vk.IMAGE_USAGE_TRANSFER_SRC_BIT, vk.IMAGE_ASPECT_COLOR_BIT)
    if capture.image == null { return false }
    // The filter reads the capture between its mips (filtered importance
    // sampling), clamped: the gutter is what holds the far side of an edge.
    sampler = vkhost.sampler(vk.FILTER_LINEAR, vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, vk.SAMPLER_MIPMAP_MODE_LINEAR,
                             CAPTURE_LEVELS as float, 0.0)
    if sampler == null {
        vkhost.image_free(capture)
        vkdevice.fail("sky capture vkCreateSampler failed")
        return false
    }
    g_capture = vktexture.adopt_target(capture, sampler, SIZE, SIZE)
    if g_capture == 0 { return false }
    g_capture_image = capture.image
    g_capture_view = level_view(capture.image, 0)
    if g_capture_view == null { return failed("sky capture vkCreateImageView failed") }
    g_capture_framebuffer = framebuffer(g_capture_view, SIZE)
    if g_capture_framebuffer == null { return failed("sky capture vkCreateFramebuffer failed") }

    lit = vkhost.image(SIZE, SIZE, LEVELS, format, vk.SAMPLE_COUNT_1_BIT, usage, vk.IMAGE_ASPECT_COLOR_BIT)
    if lit.image == null { return false }
    g_lit_image = lit.image
    g_lit_memory = lit.memory
    g_lit_view = lit.view
    // Read between its levels: the roughness falls between them.
    g_lit_sampler = vkhost.sampler(vk.FILTER_LINEAR, vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
                                   vk.SAMPLER_MIPMAP_MODE_LINEAR, LEVELS as float, 0.0)
    if g_lit_sampler == null { return failed("sky light vkCreateSampler failed") }
    g_lit_views = calloc(LEVELS, 8)
    g_lit_framebuffers = calloc(LEVELS, 8)
    k = 0
    while k < LEVELS {
        view = level_view(g_lit_image, k)
        if view == null { return failed("sky light vkCreateImageView failed") }
        (g_lit_views as ptr[])[k] = view
        fb = framebuffer(view, SIZE >> k)
        if fb == null { return failed("sky light vkCreateFramebuffer failed") }
        (g_lit_framebuffers as ptr[])[k] = fb
        k = k + 1
    }

    // Copyable, for the agent to read back (irradiance_at).
    irradiance = vkhost.image(IRRADIANCE, IRRADIANCE, 1, format, vk.SAMPLE_COUNT_1_BIT,
                              usage | vk.IMAGE_USAGE_TRANSFER_SRC_BIT, vk.IMAGE_ASPECT_COLOR_BIT)
    if irradiance.image == null { return false }
    g_irradiance_image = irradiance.image
    g_irradiance_memory = irradiance.memory
    g_irradiance_view = irradiance.view
    g_irradiance_sampler = vkhost.sampler(vk.FILTER_LINEAR, vk.SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
                                          vk.SAMPLER_MIPMAP_MODE_NEAREST, 0.0, 0.0)
    if g_irradiance_sampler == null { return failed("sky irradiance vkCreateSampler failed") }
    g_irradiance_framebuffer = framebuffer(g_irradiance_view, IRRADIANCE)
    if g_irradiance_framebuffer == null { return failed("sky irradiance vkCreateFramebuffer failed") }

    g_table = table()
    if g_table == 0 { return failed("the split-sum table would not upload") }

    g_irradiance_pass = vkquote.pass_new(skyprobe.sky_irradiance(Texture { image: null }, vec3(0.0, 0.0, 0.0),
                                                            vec3(0.0, 0.0, 0.0)),
                                         vkspirv.SKY_IRRADIANCE_QUOTED_VERT, vkspirv.SKY_IRRADIANCE_QUOTED_FRAG,
                                         vkspirv.SKY_IRRADIANCE_QUOTED_HASH, vktargets.hdr_pass(), 1) as ptr
    if g_irradiance_pass == null { return failed("sky irradiance pass failed") }
    g_filter_pass = vkquote.pass_new(skyprobe.sky_filter(Texture { image: null }, SIZE * 1.0, 0.0),
                                     vkspirv.SKY_FILTER_QUOTED_VERT, vkspirv.SKY_FILTER_QUOTED_FRAG,
                                     vkspirv.SKY_FILTER_QUOTED_HASH, vktargets.hdr_pass(), LEVELS) as ptr
    if g_filter_pass == null { return failed("sky filter pass failed") }
    g_env_pass = vkquote.pass_new(envmap.env_capture(Texture { image: null }, 0.0, 0.0, 0.0),
                                  vkspirv.ENV_CAPTURE_QUOTED_VERT, vkspirv.ENV_CAPTURE_QUOTED_FRAG,
                                  vkspirv.ENV_CAPTURE_QUOTED_HASH, vktargets.hdr_pass(), 1) as ptr
    if g_env_pass == null { return failed("environment capture pass failed") }

    commands = vkhost.once_begin()
    blacked(commands, g_capture_image, CAPTURE_LEVELS)
    blacked(commands, g_lit_image, LEVELS)
    blacked(commands, g_irradiance_image, 1)
    vkhost.once_end(commands)

    vkdesc.set_sky_light(g_lit_view, g_lit_sampler, vktexture.view(g_table), vktexture.sampler_of(g_table),
                         g_irradiance_view, g_irradiance_sampler)
    return true
}

failed(why: string) -> bool {
    vkdevice.fail(why)
    return false
}

// Everything start made, gone; the device idle first.
stop() {
    d = vkhost.device()
    if d == null { return }
    vk.vkDeviceWaitIdle(d)
    if g_capture_framebuffer != null { vk.vkDestroyFramebuffer(d, g_capture_framebuffer, null) }
    if g_capture_view != null { vk.vkDestroyImageView(d, g_capture_view, null) }
    if g_capture != 0 { vkdesc.texture_destroy(g_capture) }
    if g_lit_framebuffers != null {
        k = 0
        while k < LEVELS {
            fb = (g_lit_framebuffers as ptr[])[k]
            if fb != null { vk.vkDestroyFramebuffer(d, fb, null) }
            view = (g_lit_views as ptr[])[k]
            if view != null { vk.vkDestroyImageView(d, view, null) }
            k = k + 1
        }
        free(g_lit_framebuffers)
        free(g_lit_views)
    }
    if g_lit_sampler != null { vk.vkDestroySampler(d, g_lit_sampler, null) }
    vkhost.image_free(vkhost.VKImage { image: g_lit_image, memory: g_lit_memory, view: g_lit_view })
    if g_irradiance_framebuffer != null { vk.vkDestroyFramebuffer(d, g_irradiance_framebuffer, null) }
    if g_irradiance_sampler != null { vk.vkDestroySampler(d, g_irradiance_sampler, null) }
    vkhost.image_free(vkhost.VKImage { image: g_irradiance_image, memory: g_irradiance_memory, view: g_irradiance_view })
    if g_table != 0 { vkdesc.texture_destroy(g_table) }
    vkquote.pass_free(g_irradiance_pass as *QuotedPass)
    g_irradiance_pass = null
    vkquote.pass_free(g_filter_pass as *QuotedPass)
    g_filter_pass = null
    vkquote.pass_free(g_env_pass as *QuotedPass)
    g_env_pass = null
    if g_env_texture != 0 { vkdesc.texture_destroy(g_env_texture) }
    g_env_texture = 0
    g_env_drawn = false
    vkdesc.set_sky_light(null, null, null, null, null, null)
    g_capture = 0
    g_captured = false
    g_capture_image = null
    g_capture_view = null
    g_capture_framebuffer = null
    g_lit_image = null
    g_lit_memory = null
    g_lit_view = null
    g_lit_sampler = null
    g_lit_views = null
    g_lit_framebuffers = null
    g_irradiance_image = null
    g_irradiance_memory = null
    g_irradiance_view = null
    g_irradiance_sampler = null
    g_irradiance_framebuffer = null
    g_table = 0
}

// The ground under the horizon for this frame's capture: its albedo (0 for
// none: the capture's own lower half kept) and the sun's light onto level
// ground. Set before capture(), as the sky's own values are.
set_ground(albedo: Vec3, sun: Vec3) {
    if g_ground == null { g_ground = calloc(6, 4) }
    w = g_ground as f32[]
    w[0] = albedo.x as f32
    w[1] = albedo.y as f32
    w[2] = albedo.z as f32
    w[3] = sun.x as f32
    w[4] = sun.y as f32
    w[5] = sun.z as f32
}

// This frame's sky captured and turned into its light, recorded before the
// scene pass: `sky` the sky's image (the default texture for a procedural
// or flat sky), `weather` and `shape` the clouds' textures, the sky's own
// values already set (vkframe.set_sky_*, and the scene block's).
// The words the capture is drawn from, into g_inputs_now: the sky's image
// and the clouds', and the sky's values -- what the capture shader
// reads -- with the clouds' drift, dither and the eye only where there are
// clouds to draw.
inputs_now(sky: int, weather: int, shape: int) {
    if g_inputs == null {
        g_inputs = calloc(INPUT_WORDS, 4)
        g_inputs_now = calloc(INPUT_WORDS, 4)
    }
    words = g_inputs_now as int[]
    block = vkdesc.block(vkdesc.PROGRAM_SCENE)
    words[0] = sky
    words[1] = weather
    words[2] = shape
    at = 3
    // Each value in the sky's own words (vkframe.sky_words) or the block:
    // the sky's kind, overcast, turbidity and the clouds' cover, then its
    // flat colour, its sun, the clouds' sun, its colour and the overcast's.
    own = vkframe.sky_words()
    sources = [own, own, own, block]
    offsets = [vkframe.SKY_KIND, vkframe.SKY_OVERCAST, vkframe.SKY_TURBIDITY, vkscene.OFF_CLOUDCOVER]
    k = 0
    while k < 4 {
        words[at] = ((sources[k] + offsets[k]) as int[])[0]
        at = at + 1
        k = k + 1
    }
    vector_sources = [own, own, block, own, own]
    vectors = [vkframe.SKY_FLAT, vkframe.SKY_SUN, vkscene.OFF_CLOUDSUN, vkframe.SKY_CLOUD_SUN_COLOUR, vkframe.SKY_OVERCAST_COLOUR]
    k = 0
    while k < 5 {
        c = 0
        while c < 3 {
            words[at] = ((vector_sources[k] + vectors[k] + c * 4) as int[])[0]
            at = at + 1
            c = c + 1
        }
        k = k + 1
    }
    // The ground, as set_ground holds it, in the same words it held in the
    // block.
    k = 0
    while k < 6 {
        words[at] = 0
        if g_ground != null { words[at] = (g_ground as int[])[k] }
        at = at + 1
        k = k + 1
    }
    // The clouds' drift and the eye by steps: the sky's light follows the
    // clouds every half second of drift and the eye every 16 m, where
    // drawn every frame the capture's march was 3 ms of it (#317).
    clouded = ((block + vkscene.OFF_CLOUDCOVER) as f32[])[0] > (0.0 as f32)
    cloudy = [vkscene.OFF_CLOUDTIME, vkscene.OFF_VIEWPOS, vkscene.OFF_VIEWPOS + 4, vkscene.OFF_VIEWPOS + 8]
    steps = [0.5, 16.0, 16.0, 16.0]
    k = 0
    while k < 4 {
        words[at] = 0
        if clouded { words[at] = core.floor_of((((block + cloudy[k]) as f32[])[0] as float) / steps[k]) as int }
        at = at + 1
        k = k + 1
    }
}

// The clouds' detail is made with their shape, so the shape's handle in
// the inputs says when either changed.
capture(sky: int, weather: int, shape: int, detail: int) {
    if g_capture == 0 { return }
    environment_mode = g_env_texture != 0 && g_env_pass != null
    if environment_mode {
        // The map is the same every frame: the capture is made once, and
        // again when the map, its scale or the mode changes (set_environment
        // clears g_env_drawn).
        if g_env_drawn { return }
        g_env_drawn = true
        g_captured = false
    } else {
        if g_env_drawn {
            // Back to the sky: it is captured afresh.
            g_env_drawn = false
            g_captured = false
        }
        inputs_now(sky, weather, shape)
        if g_captured && memcmp(g_inputs, g_inputs_now, (INPUT_WORDS * 4) as long) == 0 { return }
        memcpy(g_inputs, g_inputs_now, (INPUT_WORDS * 4) as long)
        g_captured = true
    }
    commands = vkframe.frame_commands()
    pass = vktargets.hdr_pass()
    // The levels under the first are remade from it: what they held goes.
    turn(commands, g_capture_image, 1, CAPTURE_LEVELS - 1, vk.IMAGE_LAYOUT_UNDEFINED,
         vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, vk.ACCESS_TRANSFER_WRITE_BIT,
         vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    if environment_mode {
        e = vkquote.shader(g_env_pass as *QuotedPass)
        _l = gpu.set_float(e, "lod", g_env_lod)
        _h = gpu.set_float(e, "half_v", g_env_half_v)
        _i = gpu.set_float(e, "intensity", g_env_intensity)
        vkframe.quoted_screen_pass(pass, g_capture_framebuffer, SIZE, SIZE, g_env_pass, 0, g_env_texture)
    } else {
        vkframe.sky_capture_pass(pass, g_capture_framebuffer, SIZE, sky, weather, shape, detail)
    }
    turn(commands, g_capture_image, 0, 1, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
         vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
         vk.ACCESS_TRANSFER_READ_BIT | vk.ACCESS_TRANSFER_WRITE_BIT,
         vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    vktexture.mip_chain(commands, g_capture_image, SIZE, SIZE, CAPTURE_LEVELS)

    // The ground as the renderer set it (set_ground).
    irradiance_shader = vkquote.shader(g_irradiance_pass as *QuotedPass)
    if g_ground == null { set_ground(core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0)) }
    ground = g_ground as f32[]
    // A map has its own ground: no albedo is laid under the horizon.
    ground_scale = 1.0
    if environment_mode { ground_scale = 0.0 }
    _a = gpu.set_vec3(irradiance_shader, "ground_albedo", ground[0] as float * ground_scale, ground[1] as float * ground_scale, ground[2] as float * ground_scale)
    _s = gpu.set_vec3(irradiance_shader, "ground_sun", ground[3] as float * ground_scale, ground[4] as float * ground_scale, ground[5] as float * ground_scale)
    vkframe.quoted_screen_pass(pass, g_irradiance_framebuffer, IRRADIANCE, IRRADIANCE, g_irradiance_pass, 0, g_capture)
    filter_shader = vkquote.shader(g_filter_pass as *QuotedPass)
    k = 0
    while k < LEVELS {
        size = SIZE >> k
        _z = gpu.set_float(filter_shader, "level_size", size as float)
        _r = gpu.set_float(filter_shader, "roughness", (k as float) / ((LEVELS - 1) as float))
        vkframe.quoted_screen_pass(pass, (g_lit_framebuffers as ptr[])[k], size, size, g_filter_pass, k, g_capture)
        k = k + 1
    }
}

// The prefiltered map, every level, and its sampler: what a probe's ray
// that meets nothing reads the sky's light from (ae3d.vkddgi).
reflections_view() -> ptr { return g_lit_view }
reflections_sampler() -> ptr { return g_lit_sampler }

// The sky's irradiance onto a surface facing `n`, read back from the
// device: what the agent explains a surface's light by. Waits for the
// device, so it is for a question asked now and then, not for a frame.
irradiance_at(n: Vec3) -> Vec3 {
    if g_irradiance_image == null { return core.vec3(0.0, 0.0, 0.0) }
    vk.vkDeviceWaitIdle(vkhost.device())
    count = IRRADIANCE * IRRADIANCE
    buffer = vkhost.host_buffer(count * 8)
    if buffer == null { return core.vec3(0.0, 0.0, 0.0) }
    commands = vkhost.once_begin()
    read = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    turn(commands, g_irradiance_image, 0, 1, read, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, 0, vk.ACCESS_TRANSFER_READ_BIT,
         vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    region = calloc(1, sizeof(VkBufferImageCopy)) as *VkBufferImageCopy
    region.imageSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.imageSubresource.layerCount = 1
    region.imageExtent.width = IRRADIANCE
    region.imageExtent.height = IRRADIANCE
    region.imageExtent.depth = 1
    vk.vkCmdCopyImageToBuffer(commands, g_irradiance_image, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer.buffer, 1, region as ptr)
    free(region as ptr)
    turn(commands, g_irradiance_image, 0, 1, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, read, 0, vk.ACCESS_SHADER_READ_BIT,
         vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT)
    vkhost.once_end(commands)
    texels = calloc(count * 4, 4)
    out = texels as f32[]
    i = 0
    while i < count * 4 {
        out[i] = core.half_value(mem.get_uint8(buffer.mapped, i * 2) | (mem.get_uint8(buffer.mapped, i * 2 + 1) << 8)) as f32
        i = i + 1
    }
    vkhost.host_buffer_free(buffer)
    e = skylight.irradiance_at(texels, n)
    free(texels)
    return e
}

// The sky's light from a map (#869): `img` (an ae3d.hdrimage, equirectangular)
// uploaded as a half-float texture with its mip chain and the capture made from
// it in place of the sky, scaled by `intensity`; null `img` goes back to the
// sky. The image is the caller's. False, the sky kept, when the texture would
// not make.
set_environment(img: ptr, intensity: float) -> bool {
    if g_capture == 0 { return false }
    if img == null {
        if g_env_texture != 0 { vkdesc.texture_destroy(g_env_texture) }
        g_env_texture = 0
        g_env_drawn = false
        return true
    }
    halves = envimage.half_rows(img)
    if halves == null { return false }
    handle = vktexture.texture_create_environment(hdrimage.width(img), hdrimage.height(img), halves)
    free(halves)
    if handle == 0 { return false }
    if g_env_texture != 0 { vkdesc.texture_destroy(g_env_texture) }
    g_env_texture = handle
    g_env_half_v = 0.5 / (hdrimage.height(img) as float)
    g_env_lod = envimage.lod_for_width(hdrimage.width(img))
    g_env_intensity = intensity
    g_env_drawn = false
    return true
}

// Whether a map stands in for the sky.
environment() -> bool { return g_env_texture != 0 }
