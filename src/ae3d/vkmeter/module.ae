// ae3d.vkmeter -- the frame's light, measured on the Vulkan backend (#402),
// on Aether's own Vulkan bindings (contrib.vulkan.vk).
//
// After the composite, the light it read -- the scene, or what the
// reflection, the temporal pass or DLSS made of it, before the frame's
// exposure and tone curve -- is blitted into an image of its own at half
// size, halved level by level (each blit a box filter) to no wider than 320
// texels, and the last level copied into a buffer the host can read -- one
// per frame in flight. When a frame slot's fence has passed, the texels of
// its buffer, taken through the exposure that frame was drawn at and the
// tone curve, are the measurement: the frame's mean linear luminance as it
// showed, and the share of it near white. Auto exposure reads it
// (ae3d.exposure). Light averages where shown values do not, so the halving
// is of the light and the curve comes after.
//
// The frame (ae3d.vkframe) owns the device's frame, its command buffer and
// its image; this module owns the meter's image, its memory, and its
// buffers, and frees them when the swapchain they were sized to goes. It
// reaches the frame through the frame's hooks (vkframe.add_hooks): record
// after the last pass, collect after the fence, release with the swapchain.
// Its buffers are ae3d.vkhost's.

import contrib.vulkan.vk
import ae3d.vkdevice
import std.mem
import ae3d.vkhost
import ae3d.vkframe
import ae3d.vktexture
import ae3d.vktargets
import ae3d.core

exports (
    set_on, is_on, measured
)

// This module's own hooks, by their C names, for their addresses.
extern ae3d_vkmeter_record(context: ptr)
extern ae3d_vkmeter_collect(context: ptr)
extern ae3d_vkmeter_release(context: ptr)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern ldexp(x: float, e: int) -> float

const SMALLEST = 320                 // texels: the widest the last level may be
const MAX_FRAMES = 4                 // at least ae3d.vkframe's FRAMES
const NEAR_WHITE = 0.8               // linear luminance counted as near white
const TEXEL = 8                      // bytes: four half floats

struct Meter {
    on: bool
    hooked: bool
    device: ptr                      // the device the meter's objects are made on
    image: ptr                       // VkImage, the halving chain
    memory: ptr                      // VkDeviceMemory
    levels: int
    source_width: int                // the light measured
    source_height: int
    width: int                       // level 0: half the light's
    height: int
    small_width: int                 // the last level
    small_height: int
    buffers: ptr                     // *HostBuffer[MAX_FRAMES]
    written: ptr                     // int[MAX_FRAMES]
    exposures: ptr                   // float[MAX_FRAMES]: what each slot's frame was drawn at
    have: bool
    mean: float
    white: float
}

var g_meter: ptr = null

meter() -> *Meter {
    if g_meter == null {
        m = calloc(1, sizeof(Meter)) as *Meter
        m.buffers = calloc(MAX_FRAMES, 8)
        m.written = calloc(MAX_FRAMES, 8)
        m.exposures = calloc(MAX_FRAMES, 8)
        g_meter = m as ptr
    }
    return g_meter as *Meter
}

// The latest measurement into `out` (two floats: the mean linear luminance
// and the near-white share); false before there is one.
measured(out: ptr) -> bool {
    m = meter()
    if !m.have || out == null { return false }
    o = out as float[]
    o[0] = m.mean
    o[1] = m.white
    return true
}

// --- device objects --------------------------------------------------------------------------------

// The halving chain: `levels` levels from w x h, device-local, blitted to
// and from.
make_image(m: *Meter, w: int, h: int, levels: int) -> bool {
    device = vkdevice.device()
    ci = calloc(1, sizeof(VkImageCreateInfo)) as *VkImageCreateInfo
    ci.sType = vk.STRUCTURE_TYPE_IMAGE_CREATE_INFO
    ci.imageType = vk.IMAGE_TYPE_2D
    ci.format = vktargets.scene_format()
    ci.extent.width = w
    ci.extent.height = h
    ci.extent.depth = 1
    ci.mipLevels = levels
    ci.arrayLayers = 1
    ci.samples = vk.SAMPLE_COUNT_1_BIT
    ci.tiling = vk.IMAGE_TILING_OPTIMAL
    ci.usage = vk.IMAGE_USAGE_TRANSFER_SRC_BIT | vk.IMAGE_USAGE_TRANSFER_DST_BIT
    ci.sharingMode = vk.SHARING_MODE_EXCLUSIVE
    ci.initialLayout = vk.IMAGE_LAYOUT_UNDEFINED
    out = calloc(1, 8)
    r = vk.vkCreateImage(device, ci as ptr, null, out)
    m.image = (out as ptr[])[0]
    free(out)
    free(ci as ptr)
    if r != vk.SUCCESS {
        m.image = null
        return false
    }
    needs = calloc(1, sizeof(VkMemoryRequirements)) as *VkMemoryRequirements
    vk.vkGetImageMemoryRequirements(device, m.image, needs as ptr)
    m.memory = vkhost.allocate(needs, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
    free(needs as ptr)
    if m.memory == null { return false }
    return vk.vkBindImageMemory(device, m.image, m.memory, 0) == vk.SUCCESS
}

// Everything the meter made, gone; it is made again at the next frame's
// size.
release(m: *Meter) {
    device = m.device
    if device == null { return }
    if m.image != null { vk.vkDestroyImage(device, m.image, null) }
    if m.memory != null { vk.vkFreeMemory(device, m.memory, null) }
    m.image = null
    m.memory = null
    f = 0
    while f < MAX_FRAMES {
        vkhost.host_buffer_free((m.buffers as ptr[])[f] as *HostBuffer)
        (m.buffers as ptr[])[f] = null
        (m.written as int[])[f] = 0
        f = f + 1
    }
    m.source_width = 0
    m.source_height = 0
    m.width = 0
    m.height = 0
    m.device = null
}

// The chain and the buffers for light of `source_w` by `source_h`.
make_meter(m: *Meter, source_w: int, source_h: int) -> bool {
    release(m)
    m.device = vkhost.device()
    m.source_width = source_w
    m.source_height = source_h
    w = half(source_w)
    h = half(source_h)
    levels = 1
    // A level is half the one above it, rounded down, never under one.
    sw = w
    sh = h
    while sw > SMALLEST {
        sw = half(sw)
        sh = half(sh)
        levels = levels + 1
    }
    m.width = w
    m.height = h
    m.levels = levels
    m.small_width = sw
    m.small_height = sh
    if !make_image(m, w, h, levels) {
        release(m)
        return false
    }
    frames = vkframe.FRAMES
    f = 0
    while f < frames && f < MAX_FRAMES {
        b = vkhost.host_buffer(sw * sh * TEXEL)
        if b == null {
            release(m)
            return false
        }
        (m.buffers as ptr[])[f] = b as ptr
        f = f + 1
    }
    return true
}

half(n: int) -> int {
    if n / 2 > 0 { return n / 2 }
    return 1
}

// --- the frame -------------------------------------------------------------------------------------

// A layout change of one level (or all, `level` -1) of `image`, ahead of a
// transfer.
barrier(commands: ptr, image: ptr, level: int, from: int, to: int, src_access: int, dst_access: int, src_stage: int) {
    b = calloc(1, sizeof(VkImageMemoryBarrier)) as *VkImageMemoryBarrier
    b.sType = vk.STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
    b.oldLayout = from
    b.newLayout = to
    b.srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    b.image = image
    b.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    if level < 0 {
        b.subresourceRange.baseMipLevel = 0
        b.subresourceRange.levelCount = vk.REMAINING_MIP_LEVELS
    } else {
        b.subresourceRange.baseMipLevel = level
        b.subresourceRange.levelCount = 1
    }
    b.subresourceRange.layerCount = 1
    b.srcAccessMask = src_access
    b.dstAccessMask = dst_access
    vk.vkCmdPipelineBarrier(commands, src_stage, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 0, null, 0, null, 1, b as ptr)
    free(b as ptr)
}

// A buffer-and-image-free barrier: `src` then `dst`, for the host's reads
// and the copies'.
memory_barrier(commands: ptr, src_stage: int, dst_stage: int, src_access: int, dst_access: int) {
    b = calloc(1, sizeof(VkMemoryBarrier)) as *VkMemoryBarrier
    b.sType = vk.STRUCTURE_TYPE_MEMORY_BARRIER
    b.srcAccessMask = src_access
    b.dstAccessMask = dst_access
    vk.vkCmdPipelineBarrier(commands, src_stage, dst_stage, 0, 1, b as ptr, 0, null, 0, null)
    free(b as ptr)
}

// One blit, `from` level `from_level` (fw x fh) into the chain's level
// `to_level` (tw x th), filtered.
blit(commands: ptr, m: *Meter, from: ptr, from_level: int, fw: int, fh: int, to_level: int, tw: int, th: int) {
    region = calloc(1, sizeof(VkImageBlit)) as *VkImageBlit
    region.srcSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.srcSubresource.mipLevel = from_level
    region.srcSubresource.layerCount = 1
    region.dstSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.dstSubresource.mipLevel = to_level
    region.dstSubresource.layerCount = 1
    // The far corners, the second of each pair of offsets (the first is 0).
    far_src = (region as ptr + offset_of_src_far()) as *VkOffset3D
    far_src.x = fw
    far_src.y = fh
    far_src.z = 1
    far_dst = (region as ptr + offset_of_dst_far()) as *VkOffset3D
    far_dst.x = tw
    far_dst.y = th
    far_dst.z = 1
    vk.vkCmdBlitImage(commands, from, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, m.image,
                      vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, region as ptr, vk.FILTER_LINEAR)
    free(region as ptr)
}

// VkImageBlit's layout: a subresource (16 bytes), two offsets (12 each), a
// subresource, two offsets.
offset_of_src_far() -> int { return sizeof(VkImageSubresourceLayers) + sizeof(VkOffset3D) }
offset_of_dst_far() -> int { return 2 * sizeof(VkImageSubresourceLayers) + 3 * sizeof(VkOffset3D) }

// Recorded after the frame's last pass: the light the composite read into
// the chain, halved level by level, the last level into this frame's
// buffer. The light is a post texture, readable by a shader between
// passes: moved to transfer-source for the blit and back.
@c_callback("ae3d_vkmeter_record")
record_hook(context: ptr) {
    m = meter()
    source_texture = vkframe.composited()
    if !m.on || source_texture == 0 { return }
    source = vktexture.image_of(source_texture)
    source_w = vktexture.width_of(source_texture)
    source_h = vktexture.height_of(source_texture)
    if m.image == null || m.source_width != source_w || m.source_height != source_h || m.device != vkdevice.device() {
        if !make_meter(m, source_w, source_h) { return }
    }
    commands = vkframe.frame_commands()
    slot = vkframe.frame_slot()
    read = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    barrier(commands, source, 0, read, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
            0, vk.ACCESS_TRANSFER_READ_BIT, vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT)
    // After the last frame's blits read the levels this one writes, not
    // merely after nothing (#410).
    barrier(commands, m.image, 0 - 1, vk.IMAGE_LAYOUT_UNDEFINED, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
            0, vk.ACCESS_TRANSFER_WRITE_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    blit(commands, m, source, 0, source_w, source_h, 0, m.width, m.height)
    w = m.width
    h = m.height
    level = 1
    while level < m.levels {
        nw = half(w)
        nh = half(h)
        barrier(commands, m.image, level - 1, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_TRANSFER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
        blit(commands, m, m.image, level - 1, w, h, level, nw, nh)
        w = nw
        h = nh
        level = level + 1
    }
    barrier(commands, m.image, m.levels - 1, vk.IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
            vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_TRANSFER_READ_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT)
    // This slot's buffer was written by the copy two frames ago and read by
    // the host since: the copy waits for both, and what it writes is made
    // visible to the host, which reads it after the fence (#410).
    memory_barrier(commands, vk.PIPELINE_STAGE_TRANSFER_BIT | vk.PIPELINE_STAGE_HOST_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT,
                   vk.ACCESS_TRANSFER_WRITE_BIT | vk.ACCESS_HOST_READ_BIT, vk.ACCESS_TRANSFER_WRITE_BIT)
    region = calloc(1, sizeof(VkBufferImageCopy)) as *VkBufferImageCopy
    region.imageSubresource.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    region.imageSubresource.mipLevel = m.levels - 1
    region.imageSubresource.layerCount = 1
    region.imageExtent.width = m.small_width
    region.imageExtent.height = m.small_height
    region.imageExtent.depth = 1
    vk.vkCmdCopyImageToBuffer(commands, m.image, vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, ((m.buffers as ptr[])[slot] as *HostBuffer).buffer, 1, region as ptr)
    free(region as ptr)
    memory_barrier(commands, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_HOST_BIT,
                   vk.ACCESS_TRANSFER_WRITE_BIT, vk.ACCESS_HOST_READ_BIT)
    // Back to readable, before the next frame's passes read it or draw over
    // it.
    back = calloc(1, sizeof(VkImageMemoryBarrier)) as *VkImageMemoryBarrier
    back.sType = vk.STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
    back.oldLayout = vk.IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
    back.newLayout = read
    back.srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    back.dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED
    back.image = source
    back.subresourceRange.aspectMask = vk.IMAGE_ASPECT_COLOR_BIT
    back.subresourceRange.levelCount = 1
    back.subresourceRange.layerCount = 1
    back.srcAccessMask = 0
    back.dstAccessMask = vk.ACCESS_SHADER_READ_BIT | vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT
    vk.vkCmdPipelineBarrier(commands, vk.PIPELINE_STAGE_TRANSFER_BIT,
                            vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT | vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
                            0, 0, null, 0, null, 1, back as ptr)
    free(back as ptr)
    (m.written as int[])[slot] = 1
    (m.exposures as float[])[slot] = vkframe.frame_exposure()
}

// A half float's value. Infinity is the largest a half holds; a texel that
// is not a number is taken as black, which is what the composite's clamp
// makes of it.
half_float(texels: ptr, at: int) -> float {
    bits = mem.get_uint8(texels, at) | (mem.get_uint8(texels, at + 1) << 8)
    exponent = (bits >> 10) & 31
    fraction = bits & 1023
    value = 0.0
    if exponent == 0 {
        value = ldexp(fraction as float, 0 - 24)
    } else if exponent == 31 {
        if fraction != 0 { return 0.0 }
        value = 65504.0
    } else {
        value = ldexp((fraction + 1024) as float, exponent - 25)
    }
    if (bits & 32768) != 0 { return 0.0 - value }
    return value
}

// This frame slot's measurement, its fence having passed: each texel of the
// last level as it showed -- its light times the exposure it was drawn at,
// through the tone curve -- and the mean linear luminance of those and the
// share of them near white.
@c_callback("ae3d_vkmeter_collect")
collect_hook(context: ptr) {
    m = meter()
    slot = vkframe.frame_slot()
    if slot < 0 || slot >= MAX_FRAMES { return }
    written = m.written as int[]
    b = (m.buffers as ptr[])[slot] as *HostBuffer
    if written[slot] == 0 || b == null { return }
    texels = b.mapped
    written[slot] = 0
    count = m.small_width * m.small_height
    if count <= 0 { return }
    e = (m.exposures as float[])[slot]
    sum = 0.0
    white = 0
    i = 0
    while i < count {
        at = i * TEXEL
        luma = 0.2126 * core.aces_of(e * half_float(texels, at)) + 0.7152 * core.aces_of(e * half_float(texels, at + 2)) +
               0.0722 * core.aces_of(e * half_float(texels, at + 4))
        sum = sum + luma
        if luma > NEAR_WHITE { white = white + 1 }
        i = i + 1
    }
    m.mean = sum / (count as float)
    m.white = (white as float) / (count as float)
    m.have = true
}

@c_callback("ae3d_vkmeter_release")
release_hook(context: ptr) {
    release(meter())
}

// Measure every frame from now on, or stop. The hooks go in the first time.
set_on(on: bool) {
    m = meter()
    m.on = on
    if on && !m.hooked {
        m.hooked = true
        vkframe.add_hooks(vkframe.STAGE_MEASURE, (&ae3d_vkmeter_record) as ptr, (&ae3d_vkmeter_collect) as ptr,
                          (&ae3d_vkmeter_release) as ptr, null)
    }
}

is_on() -> bool { return meter().on }
