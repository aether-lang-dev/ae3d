// ae3d.quotegen -- a program's own quoted screen passes as SPIR-V, written at
// the program's build into an Aether module the program then imports, as
// tools/generate_shaders writes ae3d.vkspirv from ae3d's own shaders. The
// Vulkan backend compiles no GLSL at run time; this is how a shader that is
// not ae3d's reaches it (engine_set_screen_pass).
//
// A program keeps a small generator beside it:
//
//     import ae3d.quotegen
//     import film
//     main() {
//         g = quotegen.begin("film_spirv.ae", "a film's shader")
//         quotegen.add(g, "film", film.film(vec2(1.0, 1.0), 0.0, 0.0))
//         os.exit(quotegen.finish(g))
//     }
//
// and imports what it writes: `film_spirv.film()` is a *gpu.QuotedSpirv,
// the words of the pass's full-screen vertex shader and its pixel shader,
// and the hash of the tree they were made from. A capture's value does not
// enter the tree's hash, so the tree is made with any values; one whose
// shape has changed since (the shader edited, the generator not run again)
// ends the program when the pass is made, naming the shader, as one of
// ae3d's own does (vkquote.fresh).
//
// For each shader, ae3d.gpu writes the Vulkan dialect's GLSL of the screen
// vertex shader and of the pixel shader, glslangValidator (on PATH) compiles
// both to SPIR-V 1.0, and their words go into the module. Unlike ae3d's own,
// no one glslang is required: the words are checked by the hash of the tree
// they came from, not held byte for byte to a reference; the module says
// which glslang made them.

import std.os
import std.list
import std.string
import std.strbuilder
import std.file
import std.fs
import std.mem
import ae3d.blob
import ae3d.gpu
import ae3d.gpu (GpuShader)

exports (QuoteGen, begin, add, add_pair, finish)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

struct QuoteGen {
    path: string        // the module written
    work: string        // where the GLSL and SPIR-V are made
    glslang: string     // glslangValidator's first line of --version
    body: ptr           // *strbuilder: the module's functions
    names: ptr          // *strbuilder: the shaders' names, for the exports
    count: int          // how many
    failed: int         // the shaders that would not compile
}

// A module to be written at `path` (an Aether source file), its first
// comment line saying what it is: `about`. Null, said, when glslangValidator
// cannot be run.
begin(path: string, about: string) -> *QuoteGen {
    argv = list.new()
    list.add(argv, "--version")
    out, status, err = os.run_capture("glslangValidator", argv, null)
    if err != "" || status != 0 {
        println("quotegen: glslangValidator could not be run (status ${status}${err}): it is needed on PATH")
        return null
    }
    g = calloc(1, sizeof(QuoteGen)) as *QuoteGen
    g.path = path
    // Beside the program's other build output, as ae3d's is (build/shaders).
    g.work = "build/quotegen"
    fs.mkdir_p(g.work)
    first = out
    nl = string.index_of(out, "\n")
    if nl > 0 { first = string.substring(out, 0, nl) }
    g.glslang = first
    g.body = strbuilder.new(65536)
    g.names = strbuilder.new(256)
    strbuilder.append(g.body, "// ${about}: the SPIR-V of its quoted screen passes and pairs, GENERATED by ae3d.quotegen\n")
    strbuilder.append(g.body, "// with ${first}. Do not edit: run the generator again after the shaders change.\n\n")
    // ae3d.gpu whole as well as the one name: a module reached only by
    // selective imports had its own imports left out before Aether 0.946.0,
    // and ae3d.gpu's std.string with them
    strbuilder.append(g.body, "import ae3d.gpu\nimport ae3d.gpu (QuotedSpirv)\n\nEXPORTS_HERE\n\n")
    strbuilder.append(g.body, "extern malloc(size: long) -> ptr\nextern memcpy(dst: ptr, src: ptr, n: long) -> ptr\n")
    return g
}

// `text` into `path`, in binary, so its lines end as written; false, said,
// when it cannot be.
write_text(path: string, text: string) -> bool {
    // The module's folder made if it is not there yet.
    k = string.length(path)
    while k > 0 && string.char_at(path, k - 1) != 47 { k = k - 1 }
    if k > 1 { _d = fs.mkdir_p(string.substring(path, 0, k - 1)) }
    handle, err = file.open(path, "wb")
    if err != "" {
        println("quotegen: ${path} could not be written")
        return false
    }
    file.file_write_raw(handle, text, string.length(text))
    file.close(handle)
    return true
}

// The SPIR-V of `stage`'s GLSL `text` (vert or frag), its byte count in
// size_out[0]; null, said, when glslang would not compile it.
compiled(g: *QuoteGen, name: string, stage: string, text: string, size_out: int[]) -> ptr {
    src = "${g.work}/${name}.${stage}"
    spv = "${g.work}/${name}.${stage}.spv"
    if !write_text(src, text) { return null }
    argv = list.new()
    list.add(argv, "-V")
    list.add(argv, src)
    list.add(argv, "-o")
    list.add(argv, spv)
    out, errors, status, err = os.run_full("glslangValidator", argv, null, "")
    if err != "" || status != 0 {
        print(out)
        print(errors)
        println("quotegen: ${name}'s ${stage} shader would not compile (its GLSL: ${src})")
        return null
    }
    data = blob.read(spv)
    if data == null {
        println("quotegen: ${spv} was not written")
        return null
    }
    size_out[0] = blob.last_size() as int
    return data
}

// The words of `data` as an Aether int array literal's, eight a line, each
// signed as an int holds it (the least spelled as an expression).
words(b: ptr, data: ptr, size: int) {
    i = 0
    while i < size {
        w = (mem.get_uint8(data, i) as long) + (mem.get_uint8(data, i + 1) as long) * 256 +
            (mem.get_uint8(data, i + 2) as long) * 65536 + (mem.get_uint8(data, i + 3) as long) * 16777216
        if w >= 2147483648 { w = w - 4294967296 }
        if i % 32 == 0 { strbuilder.append(b, "        ") } else { strbuilder.append(b, ", ") }
        if w == 0 - 2147483648 {
            strbuilder.append(b, "-2147483647 - 1")
        } else {
            strbuilder.append_long(b, w)
        }
        i = i + 4
        if i % 32 == 0 || i >= size {
            if i < size { strbuilder.append(b, ",") }
            strbuilder.append(b, "\n")
        }
    }
}

// The pass of the quoted pixel shader `s` (which it frees) into the module,
// as `<name>()`. A name is an Aether function's: letters, digits and _.
add(g: *QuoteGen, name: string, s: *GpuShader) {
    if g == null || s == null { return }
    vert = gpu.emit_screen_vertex(s, gpu.VULKAN)
    if vert == "" { println("quotegen: ${name}: ${gpu.last_error()}") }
    frag = gpu.emit_glsl(s, gpu.VULKAN)
    if frag == "" { println("quotegen: ${name}: ${gpu.last_error()}") }
    if vert == "" || frag == "" {
        g.failed = g.failed + 1
    } else {
        written(g, name, "${gpu.shader_name(s)}: its screen vertex shader", vert, frag, gpu.shader_hash(s))
    }
    gpu.shader_free(s)
}

// A program's pair, for its canvas (ae3d.engine's engine_canvas_draw): the
// quoted vertex shader `vs` and pixel shader `ps` (both of which it frees),
// linked by their varyings, into the module as `<name>()`, its hash of both
// trees (gpu.pair_hash).
add_pair(g: *QuoteGen, name: string, vs: *GpuShader, ps: *GpuShader) {
    if g == null || vs == null || ps == null { return }
    if !gpu.link(vs, ps) {
        println("quotegen: ${name}: ${gpu.last_error()}")
        g.failed = g.failed + 1
    } else {
        // Each stage's error said before the next is written over it.
        vert = gpu.emit_vertex_glsl(vs, gpu.VULKAN, "", "")
        if vert == "" { println("quotegen: ${name}: ${gpu.last_error()}") }
        frag = gpu.emit_glsl(ps, gpu.VULKAN)
        if frag == "" { println("quotegen: ${name}: ${gpu.last_error()}") }
        if vert == "" || frag == "" {
            g.failed = g.failed + 1
        } else {
            written(g, name, "${gpu.shader_name(vs)}: its vertex shader", vert, frag, gpu.pair_hash(vs, ps))
        }
    }
    gpu.shader_free(vs)
    gpu.shader_free(ps)
}

// The two stages' GLSL compiled, and the module's function for them written.
fn written(g: *QuoteGen, name: string, about: string, vert_text: string, frag_text: string, hash: long) {
    vsize = calloc(1, 4) as int[]
    fsize = calloc(1, 4) as int[]
    vert = compiled(g, name, "vert", vert_text, vsize)
    frag = compiled(g, name, "frag", frag_text, fsize)
    if vert == null || frag == null {
        g.failed = g.failed + 1
    } else {
        b = g.body
        strbuilder.append(b, "\nvar g_${name}: ptr = null\n\n")
        strbuilder.append(b, "// ${about}, ${vsize[0]} bytes, and its pixel shader, ${fsize[0]}.\n")
        strbuilder.append(b, "${name}() -> *QuotedSpirv {\n    if g_${name} != null { return g_${name} as *QuotedSpirv }\n")
        strbuilder.append(b, "    v = [\n")
        words(b, vert, vsize[0])
        strbuilder.append(b, "    ]\n    f = [\n")
        words(b, frag, fsize[0])
        strbuilder.append(b, "    ]\n    q = malloc(sizeof(QuotedSpirv) as long) as *QuotedSpirv\n")
        strbuilder.append(b, "    q.vert = malloc(${vsize[0]} as long)\n    _v = memcpy(q.vert, v, ${vsize[0]} as long)\n")
        strbuilder.append(b, "    q.vert_bytes = ${vsize[0]}\n")
        strbuilder.append(b, "    q.frag = malloc(${fsize[0]} as long)\n    _f = memcpy(q.frag, f, ${fsize[0]} as long)\n")
        strbuilder.append(b, "    q.frag_bytes = ${fsize[0]}\n")
        strbuilder.append(b, "    q.hash = ${hash}\n")
        strbuilder.append(b, "    g_${name} = q as ptr\n    return q\n}\n")
        if g.count > 0 { strbuilder.append(g.names, ", ") }
        strbuilder.append(g.names, name)
        g.count = g.count + 1
    }
    if vert != null { blob.free_bytes(vert) }
    if frag != null { blob.free_bytes(frag) }
    free(vsize as ptr)
    free(fsize as ptr)
}

// The module written, and 0; 1, said, when a shader would not compile or the
// file could not be written, and nothing is written.
finish(g: *QuoteGen) -> int {
    if g == null { return 1 }
    if g.failed > 0 {
        println("quotegen: ${g.failed} shader(s) would not compile; ${g.path} is left as it was")
        return 1
    }
    text = string.replace_all(strbuilder.finish(g.body), "EXPORTS_HERE", "exports (${strbuilder.finish(g.names)})")
    if !write_text(g.path, text) { return 1 }
    println("quotegen: ${g.path}: ${g.count} pass(es)")
    return 0
}
