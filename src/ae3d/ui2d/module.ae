// ae3d.ui2d -- a game's UI as things that stay: layers of rectangles, bars,
// text, images and widgets, placed by anchors and scaled for the display;
// focus, clicks and typing through ae3d.input; and a stack of menus the
// game and the editor's play mode share (#449, slices 3 and 4).
//
//   ui = engine.engine_ui(e)
//   hud = ui2d.layer(ui)                                        // drawn over the frame, after post
//   bar = ui2d.rect(hud, ui2d.BOTTOM_LEFT, 24.0, -24.0, 300.0, 18.0, colour)
//   ui2d.set_fill(bar, health / 100.0)                          // a bar is a rect with a fill
//   label = ui2d.text(hud, ui2d.CENTER, 0.0, 60.0, "E to get in", 28.0)
//   ui2d.image(hud, ui2d.TOP_RIGHT, -20.0, 20.0, 256.0, 256.0, minimap)
//
//   pause = ui2d.menu(ui)
//   resume = ui2d.button(pause, ui2d.CENTER, 0.0, -30.0, 240.0, 44.0, "Resume")
//   ...
//   if input.pressed(in, "pause") { ui2d.push(ui, pause) }       // a script's update
//   if ui2d.clicked(resume) { ui2d.pop(ui) }
//
// Where ae3d.hud is immediate -- a script says every frame what is on the
// screen -- this keeps what it is given: a bar is made once and its fill
// set as the health changes; a menu is built once and pushed when it is
// wanted. What is kept is what can be pointed at, focused and typed into,
// which a thing that exists for one frame cannot be.
//
// Placing. A node is placed in its parent -- a layer is the whole screen, a
// panel its own rectangle -- by an anchor (one of nine: the corners, the
// middles of the edges, the centre) and an offset from it, x right and y
// down as the overlay's pixels are. The node's own point that sits on the
// anchor is the same one: TOP_RIGHT puts the node's top-right corner at the
// parent's, so (-20, 20) is twenty in from the right and down from the top
// whatever the window's size; BOTTOM_LEFT with (24, -24) is twenty-four in
// from the left and up from the bottom. A node can instead stretch across
// its parent, inset by four margins. Offsets and sizes are in the UI's
// units, which are pixels times the scale -- the monitor's content scale
// unless the game sets one -- so a button is as big to the eye at 150% as
// at 100%. Every edge is rounded to a whole pixel once scaled: a rectangle
// is crisp at any scale and exactly where it was asked for at scale 1.
//
// Drawing. The layers are drawn in the order they were made, then the
// menus open, from the bottom of the stack up, each over a dimming of what
// is under it: all of it after anything a script drew through ae3d.hud
// that frame, as the overlay's source (hud.set_source), laid out at the
// size the frame is drawn at. A panel clips what is in it; a panel can
// scroll. Where each node was drawn -- its rectangle and the clip it was
// drawn under -- is kept, and is what a click is tested against: what is
// clicked is what was seen.
//
// Input. Once a frame, right after ae3d.input's poll and before any script
// runs (screen_input):
// - A mouse press lands on the topmost widget under the pointer, inside its
//   clip, and on nothing behind it: while a menu is open only the top menu
//   is tried; else the layers from the last made. A press on a widget, or
//   on a solid node (a panel with a background), is swallowed from the
//   game's input until the button is released. A button is clicked by a
//   press and a release on it; a toggle flips; a slider follows the pointer
//   while held; a text field takes its caret where it was pressed.
// - Keys, characters and the gamepad go to the top menu, or with no menu
//   open to a text field that has the focus (a chat box): one focused
//   widget a layer. Tab and Shift+Tab step through a layer's widgets in the
//   order they were made, wrapping round; the arrows and the d-pad (or the
//   left stick) move to the nearest widget that way, wrapping to the far
//   side; Enter, Space and the pad's A activate; Escape and the pad's B pop
//   the top menu. Left and right move a slider, and a text field's caret.
//   A text field takes the characters typed (ae3d.input's character events,
//   so the layout and shift are the keyboard's), Backspace and Delete, Home
//   and End.
// - While a menu is open, or a field on a layer has the focus, the game's
//   input is blocked (input.set_blocked, set by the engine before the poll
//   from blocking()): its actions read nothing and whatever was held stays
//   swallowed until it is let go, so the click that pressed "Resume" fires
//   no shot when the menu is gone.
//
// A node's events are this frame's: clicked, changed and submitted are
// true in the frame they happened, for every script that asks.

import std.list
import std.heap
import std.string
import std.mem
import std.bytes
import ae3d.core
import ae3d.platform
import ae3d.input
import ae3d.hud
import ae3d.glyphs

exports (
    UiScreen, UiNode, UiTheme,
    TOP_LEFT, TOP, TOP_RIGHT, LEFT, CENTER, RIGHT, BOTTOM_LEFT, BOTTOM, BOTTOM_RIGHT,
    ALIGN_LEFT, ALIGN_CENTER, ALIGN_RIGHT,
    KIND_LAYER, KIND_PANEL, KIND_RECT, KIND_TEXT, KIND_IMAGE, KIND_BUTTON, KIND_TOGGLE, KIND_SLIDER, KIND_FIELD,
    screen_new, screen_free, attach, theme, set_scale, set_auto_scale, scale, clock,
    layer, menu, push, pop, pop_all, top, depth, is_open, blocking,
    panel, rect, text, image, button, toggle, slider, field, destroy,
    load_image, add_image, update_image,
    set_position, set_size, set_anchor, stretch, set_visible, set_enabled, set_solid,
    set_colour, set_back, set_fill, set_fill_from, set_text, set_text_size, set_align, set_wrap, set_outline,
    set_image, set_scroll, set_scrollable, set_closable, set_dim,
    set_on, set_value, set_range, set_step, set_field_text, set_max_length,
    focus, blur, focused, has_focus, hovered, clicked, changed, submitted,
    is_on, value, field_text, caret, scroll_y, content_height,
    is_drawn, drawn_rect, drawn_clip, focus_order, takes_point,
    screen_input, draw
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern floor(x: float) -> float

// Where a node sits in its parent, and which of its own points sits there.
const TOP_LEFT = 0
const TOP = 1
const TOP_RIGHT = 2
const LEFT = 3
const CENTER = 4
const RIGHT = 5
const BOTTOM_LEFT = 6
const BOTTOM = 7
const BOTTOM_RIGHT = 8

// Where a text's lines sit in its box (hud.ALIGN_*).
const ALIGN_LEFT = 0
const ALIGN_CENTER = 1
const ALIGN_RIGHT = 2

const KIND_LAYER = 0
const KIND_PANEL = 1
const KIND_RECT = 2
const KIND_TEXT = 3
const KIND_IMAGE = 4
const KIND_BUTTON = 5
const KIND_TOGGLE = 6
const KIND_SLIDER = 7
const KIND_FIELD = 8

// The widgets' proportions, in UI units.
const LABEL_SIZE = 18.0
const RING = 2.0                 // the focus ring, inside the widget's edge
const BORDER = 1.0
const TRACK = 6.0                // a slider's track
const KNOB = 14.0                // a slider's knob, as wide as this
const TOGGLE_GAP = 10.0          // a toggle's box to its label
const FIELD_PAD = 8.0            // a field's text in from its edge
const CARET = 2.0
const WHEEL_STEP = 40.0          // what a turn of the wheel scrolls a panel
// A caret blinks on for BLINK seconds and off for as long; typing or
// moving it shows it at once.
const BLINK = 0.53
// A direction held on the pad steps once, again after REPEAT_DELAY, then
// every REPEAT_RATE: a menu of twenty is crossed in two seconds, and one
// press is one step.
const REPEAT_DELAY = 0.40
const REPEAT_RATE = 0.08
const STICK_PRESS = 0.5
// A text field holds this many bytes of UTF-8 unless told otherwise.
const FIELD_BYTES = 256

const NO_DIRECTION = 0 - 1
const DIR_UP = 0
const DIR_DOWN = 1
const DIR_LEFT = 2
const DIR_RIGHT = 3

// The colours the widgets are drawn in, display sRGB with alpha, and the
// size of their labels. A game sets its own through theme().
struct UiTheme {
    text: Vec4
    hint: Vec4                   // a text field's hint, and a disabled widget's label
    face: Vec4                   // a button or a knob
    hover: Vec4
    down: Vec4                   // pressed
    disabled: Vec4
    well: Vec4                   // a slider's track, a toggle's box, a field
    accent: Vec4                 // a slider's fill, a toggle's check
    border: Vec4
    ring: Vec4                   // the focus
    label_size: float
}

struct UiNode {
    kind: int
    screen: ptr                  // *UiScreen
    parent: ptr                  // *UiNode; null for a layer
    layer: ptr                   // *UiNode, the layer it is in (itself, for a layer)
    children: ptr                // list of *UiNode, for a layer or a panel
    order: int                   // when it was made: Tab's order within a layer
    // Where: an anchor and an offset, a size, in UI units; or stretched
    // across the parent, inset by four margins.
    anchor: int
    x: float
    y: float
    w: float
    h: float
    stretched: bool
    margin_left: float
    margin_top: float
    margin_right: float
    margin_bottom: float
    visible: bool
    enabled: bool
    solid: bool                  // takes a click that lands on it though it is no widget
    // What: a colour (a rectangle's fill, a text's colour, an image's tint,
    // a panel's background), a bar's well and its share filled from a side,
    // a text and its size, alignment and outline, an image.
    colour: Vec4
    back: Vec4
    fill: float
    fill_from: int               // LEFT, RIGHT, TOP or BOTTOM
    label: string                // a text, a widget's label, a field's hint
    size: float                  // text size, UI units; 0 is the theme's
    align: int
    outline: Vec4
    outline_px: float
    picture: int                 // an image of the overlay's; -1 none
    // A panel's contents: whether it clips them, scrolls them, and how far
    // down they reach (UI units, from the last draw).
    clips: bool
    scrollable: bool
    scroll_x: float
    scroll_y: float
    content_h: float
    // A widget's state.
    on: bool
    amount: float                // a slider's value
    low: float
    high: float
    step: float
    buffer: ptr                  // a field's text, UTF-8 bytes
    length: int                  // its length in bytes
    limit: int                   // the most bytes it holds
    edit: string                 // the text as a string, kept with the bytes
    cursor: int                  // the caret, a byte offset
    view_x: float                // how far the text is scrolled left in the field, pixels
    clicked_at: int              // the input frame it happened in; 0 never
    changed_at: int
    submitted_at: int
    // A layer's: whether it is a menu, whether Escape closes it, what it
    // dims under it, and its focused widget.
    is_menu: bool
    closable: bool
    dim: Vec4
    focus: ptr                   // *UiNode
    // Where it was drawn, in pixels, and the clip it was drawn under; which
    // draw that was.
    x0: float
    y0: float
    x1: float
    y1: float
    cx0: float
    cy0: float
    cx1: float
    cy1: float
    drawn_at: int
}

struct UiScreen {
    layers: ptr                  // list of *UiNode: every layer and menu, in the order made
    stack: ptr                   // list of *UiNode: the menus open, the top last
    hud: ptr                     // *Hud it draws into
    ui_theme: ptr                // *UiTheme
    ui_scale: float
    scale_set: bool              // the game set the scale; the monitor's is not taken
    width: int                   // the size it was last drawn at
    height: int
    frame: int                   // input frames
    draws: int
    made: int                    // nodes made, for their order
    hover: ptr                   // *UiNode under the pointer
    active: ptr                  // *UiNode a press went down on, until it is let go
    pointer_x: float
    pointer_y: float
    ui_clock: float
    blink_from: float
    nav_dir: int                 // the direction held on the pad
    nav_wait: float
}

// --- the screen ------------------------------------------------------------------------------------

default_theme() -> *UiTheme {
    t = heap.new(UiTheme)
    t.text = core.vec4(0.95, 0.95, 0.96, 1.0)
    t.hint = core.vec4(0.58, 0.60, 0.64, 1.0)
    t.face = core.vec4(0.20, 0.22, 0.26, 0.94)
    t.hover = core.vec4(0.29, 0.32, 0.38, 0.96)
    t.down = core.vec4(0.13, 0.14, 0.17, 1.0)
    t.disabled = core.vec4(0.16, 0.16, 0.18, 0.6)
    t.well = core.vec4(0.07, 0.08, 0.10, 0.88)
    t.accent = core.vec4(0.30, 0.62, 0.95, 1.0)
    t.border = core.vec4(0.42, 0.45, 0.52, 1.0)
    t.ring = core.vec4(1.0, 0.78, 0.22, 1.0)
    t.label_size = LABEL_SIZE
    return t
}

screen_new() -> *UiScreen {
    s = heap.new(UiScreen)
    s.layers = list.new()
    s.stack = list.new()
    s.ui_theme = default_theme() as ptr
    s.ui_scale = 1.0
    s.nav_dir = NO_DIRECTION
    return s
}

screen_free(s: *UiScreen) {
    if s == null { return }
    if s.hud != null { hud.set_source(s.hud as *Hud, null, null) }
    k = 0
    while k < list.size(s.layers) {
        node_free(list.get_raw(s.layers, k) as *UiNode)
        k = k + 1
    }
    list.free(s.layers)
    list.free(s.stack)
    heap.free(s.ui_theme as *UiTheme)
    heap.free(s)
}

// The overlay the screen draws into, as its source: once a frame, when the
// frame is drawn, after what scripts drew.
attach(s: *UiScreen, o: *Hud) {
    if s == null { return }
    if s.hud != null && s.hud != o as ptr { hud.set_source(s.hud as *Hud, null, null) }
    s.hud = o as ptr
    if o != null { hud.set_source(o, draw_source, s as ptr) }
}

draw_source(state: ptr, o: *Hud, width: int, height: int) {
    draw(state as *UiScreen, o, width, height)
}

theme(s: *UiScreen) -> *UiTheme { return s.ui_theme as *UiTheme }

// The UI's units to pixels: 2 draws everything twice as big. Set by the
// game, it stays; else it is the monitor's (set_auto_scale, which the
// engine calls every frame from the window's content scale).
set_scale(s: *UiScreen, factor: float) {
    if factor <= 0.0 { return }
    s.ui_scale = factor
    s.scale_set = true
}

set_auto_scale(s: *UiScreen, factor: float) {
    if s.scale_set || factor <= 0.0 { return }
    s.ui_scale = factor
}

scale(s: *UiScreen) -> float { return s.ui_scale }

// Seconds of input frames: what a caret blinks by.
clock(s: *UiScreen) -> float { return s.ui_clock }

// --- nodes ---------------------------------------------------------------------------------------------

node_new(s: *UiScreen, kind: int) -> *UiNode {
    n = heap.new(UiNode)
    n.kind = kind
    n.screen = s as ptr
    n.visible = true
    n.enabled = true
    n.fill = 1.0
    n.fill_from = LEFT
    n.picture = 0 - 1
    n.colour = core.vec4(1.0, 1.0, 1.0, 1.0)
    n.order = s.made
    s.made = s.made + 1
    n.label = core.set_owned(n.label, "")
    return n
}

// A node made in `parent` (a layer or a panel), placed by an anchor.
child_new(parent: *UiNode, kind: int, anchor: int, x: float, y: float, w: float, h: float) -> *UiNode {
    if parent == null { return null }
    s = parent.screen as *UiScreen
    n = node_new(s, kind)
    n.parent = parent as ptr
    n.layer = parent.layer
    n.anchor = anchor
    n.x = x
    n.y = y
    n.w = w
    n.h = h
    if parent.children == null { parent.children = list.new() }
    list.add_raw(parent.children, n as ptr)
    return n
}

node_free(n: *UiNode) {
    if n == null { return }
    if n.children != null {
        k = 0
        while k < list.size(n.children) {
            node_free(list.get_raw(n.children, k) as *UiNode)
            k = k + 1
        }
        list.free(n.children)
    }
    if n.buffer != null { free(n.buffer) }
    heap.free(n)
}

// Whether `inner` is `outer` or inside it.
within(inner: *UiNode, outer: *UiNode) -> bool {
    n = inner
    while n != null {
        if n == outer { return true }
        n = n.parent as *UiNode
    }
    return false
}

// A node and everything in it, gone: out of its parent (or, a layer, out
// of the screen and the stack), and out of the focus, the hover and the
// press that pointed into it.
destroy(n: *UiNode) {
    if n == null { return }
    s = n.screen as *UiScreen
    if s.hover != null && within(s.hover as *UiNode, n) { s.hover = null }
    if s.active != null && within(s.active as *UiNode, n) { s.active = null }
    owner = n.layer as *UiNode
    if owner != null && owner != n && owner.focus != null && within(owner.focus as *UiNode, n) { owner.focus = null }
    if n.kind == KIND_LAYER {
        remove_from(s.stack, n as ptr)
        remove_from(s.layers, n as ptr)
    } else if n.parent != null {
        remove_from((n.parent as *UiNode).children, n as ptr)
    }
    node_free(n)
}

remove_from(items: ptr, item: ptr) {
    if items == null { return }
    k = 0
    while k < list.size(items) {
        if list.get_raw(items, k) == item {
            list.remove(items, k)
            return
        }
        k = k + 1
    }
}

layer_new(s: *UiScreen, is_menu: bool) -> *UiNode {
    n = node_new(s, KIND_LAYER)
    n.layer = n as ptr
    n.stretched = true
    n.children = list.new()
    n.is_menu = is_menu
    n.closable = true
    n.colour = core.vec4(0.0, 0.0, 0.0, 0.0)
    if is_menu { n.dim = core.vec4(0.0, 0.0, 0.0, 0.5) }
    list.add_raw(s.layers, n as ptr)
    return n
}

// A layer over the frame, drawn every frame while it is visible: a HUD.
layer(s: *UiScreen) -> *UiNode { return layer_new(s, false) }

// A menu: a layer drawn only while it is open (push), over a dimming of
// what is under it, taking the input while it is on top.
menu(s: *UiScreen) -> *UiNode { return layer_new(s, true) }

// A panel: a rectangle that holds nodes placed in it, clips them to itself
// and can scroll them; a background of `colour` when its alpha is above
// zero, and then it takes a click that lands on it.
panel(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, colour: Vec4) -> *UiNode {
    n = child_new(parent, KIND_PANEL, anchor, x, y, w, h)
    if n == null { return null }
    n.children = list.new()
    n.clips = true
    n.colour = colour
    n.solid = colour.w > 0.0
    return n
}

// A filled rectangle; a bar is one with a fill (set_fill) over a well of
// another colour (set_back).
rect(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, colour: Vec4) -> *UiNode {
    n = child_new(parent, KIND_RECT, anchor, x, y, w, h)
    if n == null { return null }
    n.colour = colour
    return n
}

// Text, `size` UI units to the em, white: as wide as it is unless given a
// width to wrap in (set_wrap), as tall as its lines.
text(parent: *UiNode, anchor: int, x: float, y: float, words: string, size: float) -> *UiNode {
    n = child_new(parent, KIND_TEXT, anchor, x, y, 0.0, 0.0)
    if n == null { return null }
    n.label = core.set_owned(n.label, words)
    n.size = size
    return n
}

// One of the overlay's images (load_image, add_image) in a rectangle.
image(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, picture: int) -> *UiNode {
    n = child_new(parent, KIND_IMAGE, anchor, x, y, w, h)
    if n == null { return null }
    n.picture = picture
    return n
}

// A button: clicked() is true in the frame it was pressed and let go over,
// or activated from the keyboard or the pad while focused.
button(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, label: string) -> *UiNode {
    n = child_new(parent, KIND_BUTTON, anchor, x, y, w, h)
    if n == null { return null }
    n.label = core.set_owned(n.label, label)
    return n
}

// A toggle: a box, checked or not, and its label; changed() the frame it
// flips.
toggle(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, label: string, on: bool) -> *UiNode {
    n = child_new(parent, KIND_TOGGLE, anchor, x, y, w, h)
    if n == null { return null }
    n.label = core.set_owned(n.label, label)
    n.on = on
    return n
}

// A slider from `low` to `high` at `start`, stepped by a twentieth of its
// range from the keyboard and the pad (set_step).
slider(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float,
       low: float, high: float, start: float) -> *UiNode {
    n = child_new(parent, KIND_SLIDER, anchor, x, y, w, h)
    if n == null { return null }
    n.low = low
    n.high = high
    n.step = (high - low) / 20.0
    n.amount = clamp_value(n, start)
    return n
}

// A text field, empty, with a hint shown while it is empty and not focused.
field(parent: *UiNode, anchor: int, x: float, y: float, w: float, h: float, hint: string) -> *UiNode {
    n = child_new(parent, KIND_FIELD, anchor, x, y, w, h)
    if n == null { return null }
    n.label = core.set_owned(n.label, hint)
    n.limit = FIELD_BYTES
    n.buffer = calloc(n.limit + 4, 1)
    n.edit = core.set_owned(n.edit, "")
    return n
}

is_widget(n: *UiNode) -> bool {
    return n.kind == KIND_BUTTON || n.kind == KIND_TOGGLE || n.kind == KIND_SLIDER || n.kind == KIND_FIELD
}

// --- images ----------------------------------------------------------------------------------------------

// An image file into the overlay the screen draws into (attach first): its
// number, for image(), or -1.
load_image(s: *UiScreen, path: string) -> int {
    if s == null || s.hud == null { return 0 - 1 }
    return hud.image_load(s.hud as *Hud, path)
}

// Pixels a program made, RGBA, top row first, into the overlay.
add_image(s: *UiScreen, width: int, height: int, rgba: ptr) -> int {
    if s == null || s.hud == null { return 0 - 1 }
    return hud.image_add(s.hud as *Hud, width, height, rgba)
}

// An image's pixels replaced (the same size): a minimap redrawn.
update_image(s: *UiScreen, picture: int, rgba: ptr) {
    if s == null || s.hud == null { return }
    hud.image_update(s.hud as *Hud, picture, rgba)
}

// --- setting what a node is --------------------------------------------------------------------------

set_position(n: *UiNode, x: float, y: float) {
    if n == null { return }
    n.x = x
    n.y = y
}

set_size(n: *UiNode, w: float, h: float) {
    if n == null { return }
    n.w = w
    n.h = h
}

set_anchor(n: *UiNode, anchor: int) {
    if n == null || anchor < TOP_LEFT || anchor > BOTTOM_RIGHT { return }
    n.anchor = anchor
    n.stretched = false
}

// Across the parent, inset by these margins (UI units): a bar along the
// bottom of the screen, a panel's contents filling it.
stretch(n: *UiNode, left: float, top: float, right: float, bottom: float) {
    if n == null { return }
    n.stretched = true
    n.margin_left = left
    n.margin_top = top
    n.margin_right = right
    n.margin_bottom = bottom
}

set_visible(n: *UiNode, on: bool) {
    if n == null { return }
    n.visible = on
}

// A disabled widget is drawn dimmed and takes no focus and no input; a
// click on it is still taken from the game.
set_enabled(n: *UiNode, on: bool) {
    if n == null { return }
    n.enabled = on
    if !on {
        owner = n.layer as *UiNode
        if owner != null && owner.focus == n as ptr { owner.focus = null }
    }
}

// Whether a click that lands on the node is the UI's, though the node is
// no widget: a panel's background is, a HUD's bar and its text are not.
set_solid(n: *UiNode, on: bool) {
    if n == null { return }
    n.solid = on
}

set_colour(n: *UiNode, colour: Vec4) {
    if n == null { return }
    n.colour = colour
}

// A bar's well: drawn under the fill, the whole rectangle.
set_back(n: *UiNode, colour: Vec4) {
    if n == null { return }
    n.back = colour
}

// The share of a rectangle filled, 0 to 1, from its left unless set_fill_from.
set_fill(n: *UiNode, share: float) {
    if n == null { return }
    if share < 0.0 { share = 0.0 }
    if share > 1.0 { share = 1.0 }
    n.fill = share
}

// The side a bar fills from: LEFT, RIGHT, TOP or BOTTOM.
set_fill_from(n: *UiNode, side: int) {
    if n == null { return }
    if side == LEFT || side == RIGHT || side == TOP || side == BOTTOM { n.fill_from = side }
}

// A text's words, a widget's label, a field's hint.
set_text(n: *UiNode, words: string) {
    if n == null { return }
    n.label = core.set_owned(n.label, words)
}

set_text_size(n: *UiNode, size: float) {
    if n == null { return }
    n.size = size
}

set_align(n: *UiNode, align: int) {
    if n == null { return }
    n.align = align
}

// Text wrapped to `width` UI units, its lines aligned in it (set_align);
// 0 is as wide as the text.
set_wrap(n: *UiNode, width: float) {
    if n == null { return }
    n.w = width
}

set_outline(n: *UiNode, colour: Vec4, px: float) {
    if n == null { return }
    n.outline = colour
    n.outline_px = px
}

set_image(n: *UiNode, picture: int) {
    if n == null { return }
    n.picture = picture
}

// How far a panel's contents are scrolled, UI units, down and right.
set_scroll(n: *UiNode, x: float, y: float) {
    if n == null { return }
    n.scroll_x = x
    n.scroll_y = y
}

// A panel the wheel scrolls, within its contents' height.
set_scrollable(n: *UiNode, on: bool) {
    if n == null { return }
    n.scrollable = on
}

// Whether Escape and the pad's B close a menu (a title menu is not).
set_closable(n: *UiNode, on: bool) {
    if n == null { return }
    n.closable = on
}

// What a menu dims under it; nothing at alpha 0.
set_dim(n: *UiNode, colour: Vec4) {
    if n == null { return }
    n.dim = colour
}

set_on(n: *UiNode, on: bool) {
    if n == null { return }
    n.on = on
}

clamp_value(n: *UiNode, v: float) -> float {
    lo = n.low
    hi = n.high
    if lo > hi {
        lo = n.high
        hi = n.low
    }
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

set_value(n: *UiNode, v: float) {
    if n == null { return }
    n.amount = clamp_value(n, v)
}

set_range(n: *UiNode, low: float, high: float) {
    if n == null { return }
    n.low = low
    n.high = high
    n.amount = clamp_value(n, n.amount)
}

set_step(n: *UiNode, step: float) {
    if n == null { return }
    n.step = step
}

// The most bytes of UTF-8 a field holds.
set_max_length(n: *UiNode, bytes_most: int) {
    if n == null || n.kind != KIND_FIELD || bytes_most <= 0 { return }
    grown = calloc(bytes_most + 4, 1)
    keep = n.length
    if keep > bytes_most { keep = bytes_most }
    if keep > 0 { mem.copy(grown, n.buffer, keep as long) }
    free(n.buffer)
    n.buffer = grown
    n.limit = bytes_most
    n.length = keep
    if n.cursor > keep { n.cursor = keep }
    refresh_edit(n)
}

// A field's text replaced, the caret at its end.
set_field_text(n: *UiNode, words: string) {
    if n == null || n.kind != KIND_FIELD { return }
    count = string.length(words)
    if count > n.limit { count = n.limit }
    k = 0
    while k < count {
        mem.set_byte(n.buffer, k, string.char_at_n(words, string.length(words), k) & 255)
        k = k + 1
    }
    n.length = count
    n.cursor = count
    refresh_edit(n)
}

refresh_edit(n: *UiNode) {
    fresh = bytes.string_from_ptr(n.buffer, n.length)
    n.edit = core.set_owned(n.edit, fresh)
}

// --- asking about a node -----------------------------------------------------------------------------

frame_of(n: *UiNode) -> int { return (n.screen as *UiScreen).frame }

clicked(n: *UiNode) -> bool {
    if n == null { return false }
    return n.clicked_at > 0 && n.clicked_at == frame_of(n)
}

changed(n: *UiNode) -> bool {
    if n == null { return false }
    return n.changed_at > 0 && n.changed_at == frame_of(n)
}

submitted(n: *UiNode) -> bool {
    if n == null { return false }
    return n.submitted_at > 0 && n.submitted_at == frame_of(n)
}

is_on(n: *UiNode) -> bool {
    if n == null { return false }
    return n.on
}

value(n: *UiNode) -> float {
    if n == null { return 0.0 }
    return n.amount
}

// A field's text, as it is now: good until the field next changes.
field_text(n: *UiNode) -> string {
    if n == null || n.kind != KIND_FIELD { return "" }
    return n.edit
}

// The caret, a byte offset into the field's text.
caret(n: *UiNode) -> int {
    if n == null { return 0 }
    return n.cursor
}

scroll_y(n: *UiNode) -> float {
    if n == null { return 0.0 }
    return n.scroll_y
}

// How far down a panel's contents reach, UI units, as last drawn.
content_height(n: *UiNode) -> float {
    if n == null { return 0.0 }
    return n.content_h
}

// Whether the node was drawn in the screen's last draw.
is_drawn(n: *UiNode) -> bool {
    if n == null { return false }
    return n.drawn_at > 0 && n.drawn_at == (n.screen as *UiScreen).draws
}

// Where it was last drawn, in pixels: left, top, right, bottom.
drawn_rect(n: *UiNode) -> (float, float, float, float) {
    if n == null { return 0.0, 0.0, 0.0, 0.0 }
    return n.x0, n.y0, n.x1, n.y1
}

// The clip it was drawn under, in pixels.
drawn_clip(n: *UiNode) -> (float, float, float, float) {
    if n == null { return 0.0, 0.0, 0.0, 0.0 }
    return n.cx0, n.cy0, n.cx1, n.cy1
}

// --- the stack of menus ----------------------------------------------------------------------------------

// A menu opened over everything, taking the input; a menu already open is
// brought to the top. Its focus is where it was left, or its first widget.
push(s: *UiScreen, m: *UiNode) {
    if s == null || m == null || !m.is_menu { return }
    remove_from(s.stack, m as ptr)
    list.add_raw(s.stack, m as ptr)
    s.active = null
    s.nav_dir = NO_DIRECTION
    f = m.focus as *UiNode
    if f == null || !focusable(f) {
        m.focus = null
        order = focus_order(m)
        if list.size(order) > 0 { focus(list.get_raw(order, 0) as *UiNode) }
        list.free(order)
    }
}

// The top menu closed: the one under it takes the input, or the game.
pop(s: *UiScreen) -> *UiNode {
    if s == null || list.size(s.stack) == 0 { return null }
    m = list.get_raw(s.stack, list.size(s.stack) - 1) as *UiNode
    list.remove(s.stack, list.size(s.stack) - 1)
    s.active = null
    s.nav_dir = NO_DIRECTION
    return m
}

pop_all(s: *UiScreen) {
    if s == null { return }
    list.clear(s.stack)
    s.active = null
    s.nav_dir = NO_DIRECTION
}

top(s: *UiScreen) -> *UiNode {
    if s == null || list.size(s.stack) == 0 { return null }
    return list.get_raw(s.stack, list.size(s.stack) - 1) as *UiNode
}

// How many menus are open.
depth(s: *UiScreen) -> int {
    if s == null { return 0 }
    return list.size(s.stack)
}

is_open(s: *UiScreen, m: *UiNode) -> bool {
    if s == null { return false }
    k = 0
    while k < list.size(s.stack) {
        if list.get_raw(s.stack, k) == m as ptr { return true }
        k = k + 1
    }
    return false
}

// Whether the game's input is to be blocked: a menu is open, or a field on
// a layer has the focus and is being typed into.
blocking(s: *UiScreen) -> bool {
    if s == null { return false }
    if list.size(s.stack) > 0 { return true }
    return typing_layer(s) != null
}

// The layer (not a menu) whose focused widget is a field, if one is.
typing_layer(s: *UiScreen) -> *UiNode {
    k = 0
    while k < list.size(s.layers) {
        l = list.get_raw(s.layers, k) as *UiNode
        if !l.is_menu && l.visible && l.focus != null {
            f = l.focus as *UiNode
            if f.kind == KIND_FIELD && focusable(f) { return l }
        }
        k = k + 1
    }
    return null
}

// --- focus -----------------------------------------------------------------------------------------------

// Whether a node can take the focus: a widget, enabled, and shown with
// everything it is in.
focusable(n: *UiNode) -> bool {
    if n == null || !is_widget(n) || !n.enabled { return false }
    p = n
    while p != null {
        if !p.visible { return false }
        p = p.parent as *UiNode
    }
    return true
}

// The focus in the node's layer, on the node.
focus(n: *UiNode) {
    if n == null || !focusable(n) { return }
    owner = n.layer as *UiNode
    if owner.focus != n as ptr {
        owner.focus = n as ptr
        s = n.screen as *UiScreen
        s.blink_from = s.ui_clock
    }
}

// The focus off the node, if it has it.
blur(n: *UiNode) {
    if n == null { return }
    owner = n.layer as *UiNode
    if owner != null && owner.focus == n as ptr { owner.focus = null }
}

// A layer's focused widget, or null.
focused(l: *UiNode) -> *UiNode {
    if l == null { return null }
    owner = l.layer as *UiNode
    f = owner.focus as *UiNode
    if f != null && !focusable(f) { return null }
    return f
}

has_focus(n: *UiNode) -> bool {
    if n == null { return false }
    return focused(n) == n
}

// The widget under the pointer at the last input frame, or null.
hovered(s: *UiScreen) -> *UiNode {
    if s == null { return null }
    return s.hover as *UiNode
}

// A layer's widgets that can take the focus, in the order Tab visits them:
// as they were made, depth first. The list is the caller's to free.
focus_order(l: *UiNode) -> ptr {
    order = list.new()
    if l != null { collect_focusable(l, order) }
    return order
}

collect_focusable(n: *UiNode, order: ptr) {
    if !n.visible { return }
    if focusable(n) { list.add_raw(order, n as ptr) }
    if n.children == null { return }
    k = 0
    while k < list.size(n.children) {
        collect_focusable(list.get_raw(n.children, k) as *UiNode, order)
        k = k + 1
    }
}

// Tab: the next widget in the layer's order, or the one before, round.
step_focus(l: *UiNode, direction: int) {
    order = focus_order(l)
    count = list.size(order)
    if count > 0 {
        at = 0 - 1
        k = 0
        while k < count {
            if list.get_raw(order, k) == l.focus { at = k }
            k = k + 1
        }
        if at < 0 {
            at = 0
            if direction < 0 { at = count - 1 }
        } else {
            at = (at + direction + count) % count
        }
        focus(list.get_raw(order, at) as *UiNode)
    }
    list.free(order)
}

// An arrow: the nearest widget that way from the focused one's centre, by
// how far along and, twice as heavily, how far off the line; none that
// way, the one furthest the other way (a column wraps from its bottom to
// its top). Widgets not drawn last frame are not where anyone can see them
// and are passed over.
move_focus(l: *UiNode, dx: float, dy: float) {
    order = focus_order(l)
    count = list.size(order)
    current = focused(l)
    if current == null || !is_drawn(current) {
        if count > 0 { focus(list.get_raw(order, 0) as *UiNode) }
        list.free(order)
        return
    }
    fx = (current.x0 + current.x1) * 0.5
    fy = (current.y0 + current.y1) * 0.5
    best = null as ptr
    best_score = 0.0
    behind = null as ptr
    behind_score = 0.0
    k = 0
    while k < count {
        c = list.get_raw(order, k) as *UiNode
        if c != current && is_drawn(c) {
            vx = (c.x0 + c.x1) * 0.5 - fx
            vy = (c.y0 + c.y1) * 0.5 - fy
            along = vx * dx + vy * dy
            off = vx * dy - vy * dx
            if off < 0.0 { off = 0.0 - off }
            score = along + 2.0 * off
            if along > 0.5 {
                if best == null || score < best_score {
                    best = c as ptr
                    best_score = score
                }
            } else if along < 0.0 - 0.5 {
                // The far side: the most negative along, the least off.
                if behind == null || score < behind_score {
                    behind = c as ptr
                    behind_score = score
                }
            }
        }
        k = k + 1
    }
    if best != null {
        focus(best as *UiNode)
    } else if behind != null {
        focus(behind as *UiNode)
    }
    list.free(order)
}

// --- input -------------------------------------------------------------------------------------------------

// Once a frame, after ae3d.input's poll and before the game's scripts: the
// pointer, the clicks, the keys, the characters and the pad, to the menus
// and widgets they belong to (see the top of this file).
screen_input(s: *UiScreen, keys: *Input, delta: float) {
    if s == null || keys == null { return }
    s.frame = s.frame + 1
    s.ui_clock = s.ui_clock + delta
    s.pointer_x = input.pointer_x(keys)
    s.pointer_y = input.pointer_y(keys)
    under = hit(s, s.pointer_x, s.pointer_y)
    s.hover = null
    if under != null && is_widget(under) { s.hover = under as ptr }

    events = input.mouse_event_count(keys)
    k = 0
    while k < events {
        button, down = input.mouse_event(keys, k)
        if button == platform.MOUSE_LEFT {
            if down { press(s, keys) } else { release(s) }
        } else if down && hit(s, s.pointer_x, s.pointer_y) != null {
            // The other buttons do nothing on the UI, and are not the game's
            // where they landed on it either.
            input.swallow_mouse(keys, button)
        }
        k = k + 1
    }
    if s.active != null {
        held = s.active as *UiNode
        if held.kind == KIND_SLIDER && input.device_mouse(keys, platform.MOUSE_LEFT) { slide_to(held, s.pointer_x) }
    }
    wheel = input.pointer_scroll(keys)
    if wheel != 0.0 { scroll_under(s, wheel) }

    target = top(s)
    if target == null { target = typing_layer(s) }
    if target == null { return }
    count = input.key_event_count(keys)
    k = 0
    while k < count {
        key, mods, repeat = input.key_event(keys, k)
        on_key(s, target, key, mods, repeat)
        // A key can pop the menu it went to: what follows goes to the next.
        target = top(s)
        if target == null { target = typing_layer(s) }
        if target == null { return }
        k = k + 1
    }
    f = focused(target)
    if f != null && f.kind == KIND_FIELD {
        count = input.char_count(keys)
        k = 0
        while k < count {
            type_char(f, input.char_at(keys, k))
            k = k + 1
        }
    }
    if target.is_menu { on_pad(s, target, keys, delta) }
}

// Whether a press at a point (the overlay's pixels) would be the UI's: a
// menu is open, or it lands on a widget or a solid node as last drawn.
// What the editor's viewport asks before it orbits or picks in play mode.
takes_point(s: *UiScreen, px: float, py: float) -> bool {
    if s == null { return false }
    if list.size(s.stack) > 0 { return true }
    return hit(s, px, py) != null
}

// The topmost node under a point that takes clicks -- a widget, or a solid
// node -- inside the clip it was drawn under: only in the top menu while
// one is open, else in the layers from the last made.
hit(s: *UiScreen, px: float, py: float) -> *UiNode {
    menu_on = top(s)
    if menu_on != null { return hit_node(s, menu_on, px, py) }
    k = list.size(s.layers) - 1
    while k >= 0 {
        l = list.get_raw(s.layers, k) as *UiNode
        if !l.is_menu && l.visible {
            found = hit_node(s, l, px, py)
            if found != null { return found }
        }
        k = k - 1
    }
    return null
}

hit_node(s: *UiScreen, n: *UiNode, px: float, py: float) -> *UiNode {
    if !n.visible || n.drawn_at != s.draws || s.draws == 0 { return null }
    if n.children != null {
        k = list.size(n.children) - 1
        while k >= 0 {
            found = hit_node(s, list.get_raw(n.children, k) as *UiNode, px, py)
            if found != null { return found }
            k = k - 1
        }
    }
    if !is_widget(n) && !n.solid { return null }
    left = n.x0
    if n.cx0 > left { left = n.cx0 }
    right = n.x1
    if n.cx1 < right { right = n.cx1 }
    upper = n.y0
    if n.cy0 > upper { upper = n.cy0 }
    lower = n.y1
    if n.cy1 < lower { lower = n.cy1 }
    if px >= left && px < right && py >= upper && py < lower { return n }
    return null
}

press(s: *UiScreen, keys: *Input) {
    under = hit(s, s.pointer_x, s.pointer_y)
    if under != null { input.swallow_mouse(keys, platform.MOUSE_LEFT) }
    if under != null && is_widget(under) && under.enabled {
        s.active = under as ptr
        focus(under)
        if under.kind == KIND_SLIDER { slide_to(under, s.pointer_x) }
        if under.kind == KIND_FIELD {
            under.cursor = caret_at(s, under, s.pointer_x)
            s.blink_from = s.ui_clock
        }
        return
    }
    // A press anywhere else takes the focus off a field on a layer: the
    // chat box lets go of the keyboard when the game is clicked.
    typing = typing_layer(s)
    if typing != null { typing.focus = null }
}

release(s: *UiScreen) {
    held = s.active as *UiNode
    s.active = null
    if held == null || !held.enabled { return }
    if hit(s, s.pointer_x, s.pointer_y) != held { return }
    activate(held)
}

// What Enter, Space, the pad's A and a click do.
activate(n: *UiNode) {
    if n == null || !n.enabled { return }
    frame = frame_of(n)
    if n.kind == KIND_BUTTON { n.clicked_at = frame }
    if n.kind == KIND_TOGGLE {
        n.on = !n.on
        n.changed_at = frame
    }
}

// A slider's value from where the pointer is along it.
slide_to(n: *UiNode, px: float) {
    s = n.screen as *UiScreen
    knob = floor(KNOB * s.ui_scale + 0.5)
    run = (n.x1 - n.x0) - knob
    share = 0.0
    if run > 0.0 { share = (px - n.x0 - knob * 0.5) / run }
    if share < 0.0 { share = 0.0 }
    if share > 1.0 { share = 1.0 }
    set_amount(n, n.low + (n.high - n.low) * share)
}

set_amount(n: *UiNode, v: float) {
    v = clamp_value(n, v)
    if v != n.amount {
        n.amount = v
        n.changed_at = frame_of(n)
    }
}

// The wheel over a panel that scrolls: the innermost one under the pointer.
scroll_under(s: *UiScreen, wheel: float) {
    scroller = null as ptr
    menu_on = top(s)
    if menu_on != null {
        scroller = scrollable_under(s, menu_on, s.pointer_x, s.pointer_y)
    } else {
        k = list.size(s.layers) - 1
        while k >= 0 && scroller == null {
            l = list.get_raw(s.layers, k) as *UiNode
            if !l.is_menu && l.visible { scroller = scrollable_under(s, l, s.pointer_x, s.pointer_y) }
            k = k - 1
        }
    }
    if scroller == null { return }
    p = scroller as *UiNode
    room = p.content_h - (p.y1 - p.y0) / s.ui_scale
    if room < 0.0 { room = 0.0 }
    // A turn away from the user (positive) shows what is above.
    y = p.scroll_y - wheel * WHEEL_STEP
    if y < 0.0 { y = 0.0 }
    if y > room { y = room }
    p.scroll_y = y
}

scrollable_under(s: *UiScreen, n: *UiNode, px: float, py: float) -> ptr {
    if !n.visible || n.drawn_at != s.draws { return null }
    if n.children != null {
        k = list.size(n.children) - 1
        while k >= 0 {
            found = scrollable_under(s, list.get_raw(n.children, k) as *UiNode, px, py)
            if found != null { return found }
            k = k - 1
        }
    }
    if n.kind == KIND_PANEL && n.scrollable && px >= n.x0 && px < n.x1 && py >= n.y0 && py < n.y1 { return n as ptr }
    return null
}

on_key(s: *UiScreen, target: *UiNode, key: int, mods: int, repeat: bool) {
    f = focused(target)
    backwards = (mods & platform.MOD_SHIFT) != 0
    if f != null && f.kind == KIND_FIELD {
        if edit_key(s, target, f, key, repeat) { return }
    }
    if key == platform.KEY_TAB {
        direction = 1
        if backwards { direction = 0 - 1 }
        step_focus(target, direction)
    } else if key == platform.KEY_UP {
        move_focus(target, 0.0, 0.0 - 1.0)
    } else if key == platform.KEY_DOWN {
        move_focus(target, 0.0, 1.0)
    } else if key == platform.KEY_LEFT || key == platform.KEY_RIGHT {
        sign = 1.0
        if key == platform.KEY_LEFT { sign = 0.0 - 1.0 }
        if f != null && f.kind == KIND_SLIDER {
            set_amount(f, f.amount + sign * f.step)
        } else {
            move_focus(target, sign, 0.0)
        }
    } else if !repeat && (key == platform.KEY_ENTER || key == platform.KEY_KP_ENTER || key == platform.KEY_SPACE) {
        activate(f)
    } else if !repeat && key == platform.KEY_ESCAPE {
        close_top(s, target)
    }
}

// Escape or the pad's B: the top menu closed, if it may be; a field on a
// layer let go of.
close_top(s: *UiScreen, target: *UiNode) {
    if target.is_menu {
        if target.closable && top(s) == target { pop(s) }
        return
    }
    target.focus = null
}

// A key a focused field takes: true when it did.
edit_key(s: *UiScreen, target: *UiNode, f: *UiNode, key: int, repeat: bool) -> bool {
    if key == platform.KEY_BACKSPACE {
        if f.cursor > 0 {
            start = previous_boundary(f, f.cursor)
            cut(f, start, f.cursor)
            f.cursor = start
            f.changed_at = frame_of(f)
        }
    } else if key == platform.KEY_DELETE {
        if f.cursor < f.length {
            cut(f, f.cursor, next_boundary(f, f.cursor))
            f.changed_at = frame_of(f)
        }
    } else if key == platform.KEY_LEFT {
        f.cursor = previous_boundary(f, f.cursor)
    } else if key == platform.KEY_RIGHT {
        f.cursor = next_boundary(f, f.cursor)
    } else if key == platform.KEY_HOME {
        f.cursor = 0
    } else if key == platform.KEY_END {
        f.cursor = f.length
    } else if key == platform.KEY_ENTER || key == platform.KEY_KP_ENTER {
        if !repeat {
            f.submitted_at = frame_of(f)
            // A field on a layer (a chat box) lets go once it is sent.
            if !target.is_menu { target.focus = null }
        }
    } else if key == platform.KEY_SPACE {
        // Typed, as its character: not an activation.
    } else {
        return false
    }
    s.blink_from = s.ui_clock
    return true
}

// The byte offset of the codepoint before (or after) `at`: UTF-8's
// continuation bytes are 10xxxxxx.
previous_boundary(f: *UiNode, at: int) -> int {
    k = at - 1
    while k > 0 && (mem.get_uint8(f.buffer, k) & 192) == 128 { k = k - 1 }
    if k < 0 { return 0 }
    return k
}

next_boundary(f: *UiNode, at: int) -> int {
    if at >= f.length { return f.length }
    k = at + 1
    while k < f.length && (mem.get_uint8(f.buffer, k) & 192) == 128 { k = k + 1 }
    return k
}

// Bytes [from, to) out of a field's text.
cut(f: *UiNode, from: int, to: int) {
    if to <= from { return }
    if to < f.length { mem.move(f.buffer + from, f.buffer + to, (f.length - to) as long) }
    f.length = f.length - (to - from)
    refresh_edit(f)
}

// A character typed into a field at its caret, as UTF-8; controls and what
// would overflow the field are not taken.
type_char(f: *UiNode, codepoint: int) {
    if codepoint < 32 || codepoint == 127 || (codepoint >= 128 && codepoint < 160) { return }
    if codepoint > 1114111 || (codepoint >= 55296 && codepoint <= 57343) { return }
    count = 1
    if codepoint >= 128 { count = 2 }
    if codepoint >= 2048 { count = 3 }
    if codepoint >= 65536 { count = 4 }
    if f.length + count > f.limit { return }
    if f.cursor < f.length { mem.move(f.buffer + f.cursor + count, f.buffer + f.cursor, (f.length - f.cursor) as long) }
    at = f.cursor
    if count == 1 {
        mem.set_byte(f.buffer, at, codepoint)
    } else if count == 2 {
        mem.set_byte(f.buffer, at, 192 | (codepoint >> 6))
        mem.set_byte(f.buffer, at + 1, 128 | (codepoint & 63))
    } else if count == 3 {
        mem.set_byte(f.buffer, at, 224 | (codepoint >> 12))
        mem.set_byte(f.buffer, at + 1, 128 | ((codepoint >> 6) & 63))
        mem.set_byte(f.buffer, at + 2, 128 | (codepoint & 63))
    } else {
        mem.set_byte(f.buffer, at, 240 | (codepoint >> 18))
        mem.set_byte(f.buffer, at + 1, 128 | ((codepoint >> 12) & 63))
        mem.set_byte(f.buffer, at + 2, 128 | ((codepoint >> 6) & 63))
        mem.set_byte(f.buffer, at + 3, 128 | (codepoint & 63))
    }
    f.length = f.length + count
    f.cursor = f.cursor + count
    f.changed_at = frame_of(f)
    refresh_edit(f)
    s = f.screen as *UiScreen
    s.blink_from = s.ui_clock
}

// The gamepad, on a menu: A activates, B closes, the d-pad or the left
// stick moves (a slider's value, left and right), repeating while held.
on_pad(s: *UiScreen, target: *UiNode, keys: *Input, delta: float) {
    f = focused(target)
    if input.device_button_pressed(keys, input.PAD_A) { activate(f) }
    if input.device_button_pressed(keys, input.PAD_B) {
        close_top(s, target)
        return
    }
    held = NO_DIRECTION
    if input.device_button(keys, input.PAD_UP) { held = DIR_UP }
    if input.device_button(keys, input.PAD_DOWN) { held = DIR_DOWN }
    if input.device_button(keys, input.PAD_LEFT) { held = DIR_LEFT }
    if input.device_button(keys, input.PAD_RIGHT) { held = DIR_RIGHT }
    if held == NO_DIRECTION {
        sx = input.device_pad_axis(keys, input.PAD_LEFT_X)
        sy = input.device_pad_axis(keys, input.PAD_LEFT_Y)
        ax = sx
        if ax < 0.0 { ax = 0.0 - ax }
        ay = sy
        if ay < 0.0 { ay = 0.0 - ay }
        if ax >= STICK_PRESS || ay >= STICK_PRESS {
            if ax > ay {
                held = DIR_RIGHT
                if sx < 0.0 { held = DIR_LEFT }
            } else {
                held = DIR_DOWN
                if sy < 0.0 { held = DIR_UP }
            }
        }
    }
    if held != s.nav_dir {
        s.nav_dir = held
        if held != NO_DIRECTION {
            pad_step(target, held)
            s.nav_wait = REPEAT_DELAY
        }
        return
    }
    if held == NO_DIRECTION { return }
    s.nav_wait = s.nav_wait - delta
    while s.nav_wait <= 0.0 {
        pad_step(target, held)
        s.nav_wait = s.nav_wait + REPEAT_RATE
    }
}

pad_step(target: *UiNode, direction: int) {
    f = focused(target)
    if (direction == DIR_LEFT || direction == DIR_RIGHT) && f != null && f.kind == KIND_SLIDER {
        sign = 1.0
        if direction == DIR_LEFT { sign = 0.0 - 1.0 }
        set_amount(f, f.amount + sign * f.step)
        return
    }
    if direction == DIR_UP { move_focus(target, 0.0, 0.0 - 1.0) }
    if direction == DIR_DOWN { move_focus(target, 0.0, 1.0) }
    if direction == DIR_LEFT { move_focus(target, 0.0 - 1.0, 0.0) }
    if direction == DIR_RIGHT { move_focus(target, 1.0, 0.0) }
}

// --- drawing -----------------------------------------------------------------------------------------------

round_px(v: float) -> float { return floor(v + 0.5) }

text_px(s: *UiScreen, n: *UiNode) -> float {
    size = n.size
    if size <= 0.0 { size = (s.ui_theme as *UiTheme).label_size }
    return size * s.ui_scale
}

// The screen drawn into the overlay, `width` by `height` pixels: the
// layers, then the menus open, each over its dimming.
draw(s: *UiScreen, o: *Hud, width: int, height: int) {
    if s == null || o == null { return }
    s.width = width
    s.height = height
    s.draws = s.draws + 1
    fw = width as float
    fh = height as float
    k = 0
    while k < list.size(s.layers) {
        l = list.get_raw(s.layers, k) as *UiNode
        if !l.is_menu { draw_node(s, o, l, 0.0, 0.0, fw, fh, 0.0, 0.0, 0.0, 0.0, fw, fh) }
        k = k + 1
    }
    k = 0
    while k < list.size(s.stack) {
        m = list.get_raw(s.stack, k) as *UiNode
        if m.dim.w > 0.0 { hud.rect(o, 0.0, 0.0, fw, fh, m.dim) }
        draw_node(s, o, m, 0.0, 0.0, fw, fh, 0.0, 0.0, 0.0, 0.0, fw, fh)
        k = k + 1
    }
}

// A node's size in pixels: its own, scaled; a text's, measured.
node_size(s: *UiScreen, o: *Hud, n: *UiNode) -> (float, float) {
    if n.kind == KIND_TEXT {
        box = n.w * s.ui_scale
        tw, th = hud.measure_box(o, n.label, text_px(s, n), box)
        if box > 0.0 { tw = box }
        if n.h > 0.0 { th = n.h * s.ui_scale }
        return tw, th
    }
    return n.w * s.ui_scale, n.h * s.ui_scale
}

// Where a node goes in its parent's rectangle, its contents scrolled by
// (sx, sy) pixels: whole pixels.
place(s: *UiScreen, o: *Hud, n: *UiNode, px0: float, py0: float, px1: float, py1: float,
      sx: float, sy: float) -> (float, float, float, float) {
    unit = s.ui_scale
    left = 0.0
    upper = 0.0
    right = 0.0
    lower = 0.0
    if n.stretched {
        left = px0 + n.margin_left * unit
        upper = py0 + n.margin_top * unit
        right = px1 - n.margin_right * unit
        lower = py1 - n.margin_bottom * unit
    } else {
        w, h = node_size(s, o, n)
        fx = ((n.anchor % 3) as float) * 0.5
        fy = ((n.anchor / 3) as float) * 0.5
        ax = px0 + (px1 - px0) * fx
        ay = py0 + (py1 - py0) * fy
        left = ax + n.x * unit - fx * w
        upper = ay + n.y * unit - fy * h
        right = left + w
        lower = upper + h
    }
    return round_px(left - sx), round_px(upper - sy), round_px(right - sx), round_px(lower - sy)
}

draw_node(s: *UiScreen, o: *Hud, n: *UiNode, px0: float, py0: float, px1: float, py1: float,
          sx: float, sy: float, cx0: float, cy0: float, cx1: float, cy1: float) {
    if !n.visible { return }
    x0, y0, x1, y1 = place(s, o, n, px0, py0, px1, py1, sx, sy)
    n.x0 = x0
    n.y0 = y0
    n.x1 = x1
    n.y1 = y1
    n.cx0 = cx0
    n.cy0 = cy0
    n.cx1 = cx1
    n.cy1 = cy1
    n.drawn_at = s.draws
    paint(s, o, n)
    if n.children == null { return }
    // What it holds, clipped to it when it clips, scrolled by its scroll.
    ix0 = cx0
    iy0 = cy0
    ix1 = cx1
    iy1 = cy1
    if n.clips {
        if x0 > ix0 { ix0 = x0 }
        if y0 > iy0 { iy0 = y0 }
        if x1 < ix1 { ix1 = x1 }
        if y1 < iy1 { iy1 = y1 }
        hud.push_clip(o, x0, y0, x1 - x0, y1 - y0)
    }
    scroll_px = n.scroll_x * s.ui_scale
    scroll_py = n.scroll_y * s.ui_scale
    reach = 0.0
    k = 0
    while k < list.size(n.children) {
        c = list.get_raw(n.children, k) as *UiNode
        draw_node(s, o, c, x0, y0, x1, y1, scroll_px, scroll_py, ix0, iy0, ix1, iy1)
        if c.visible && c.y1 + scroll_py - y0 > reach { reach = c.y1 + scroll_py - y0 }
        k = k + 1
    }
    n.content_h = reach / s.ui_scale
    if n.clips { hud.pop_clip(o) }
}

// What a node looks like.
paint(s: *UiScreen, o: *Hud, n: *UiNode) {
    t = s.ui_theme as *UiTheme
    w = n.x1 - n.x0
    h = n.y1 - n.y0
    if w <= 0.0 || h <= 0.0 { return }
    if n.kind == KIND_LAYER || n.kind == KIND_PANEL {
        if n.colour.w > 0.0 { hud.rect(o, n.x0, n.y0, w, h, n.colour) }
    } else if n.kind == KIND_RECT {
        paint_bar(o, n, w, h)
    } else if n.kind == KIND_TEXT {
        box = 0.0
        if n.w > 0.0 { box = w }
        if n.outline_px > 0.0 {
            hud.text_box_outlined(o, n.x0, n.y0, box, text_px(s, n), n.label, n.colour, n.align, n.outline, n.outline_px * s.ui_scale)
        } else {
            hud.text_box(o, n.x0, n.y0, box, text_px(s, n), n.label, n.colour, n.align)
        }
    } else if n.kind == KIND_IMAGE {
        hud.image(o, n.x0, n.y0, w, h, n.picture, n.colour)
    } else if n.kind == KIND_BUTTON {
        hud.rect(o, n.x0, n.y0, w, h, face_of(s, t, n))
        centred_label(s, o, n, n.x0, n.y0, w, h, label_colour(t, n))
        ring_of(s, o, t, n)
    } else if n.kind == KIND_TOGGLE {
        paint_toggle(s, o, t, n, w, h)
    } else if n.kind == KIND_SLIDER {
        paint_slider(s, o, t, n, w, h)
    } else if n.kind == KIND_FIELD {
        paint_field(s, o, t, n, w, h)
    }
}

// A rectangle: its well, then its share filled from its side, to the pixel.
paint_bar(o: *Hud, n: *UiNode, w: float, h: float) {
    if n.back.w > 0.0 { hud.rect(o, n.x0, n.y0, w, h, n.back) }
    if n.fill <= 0.0 { return }
    if n.fill_from == TOP || n.fill_from == BOTTOM {
        fh = round_px(h * n.fill)
        top_y = n.y0
        if n.fill_from == BOTTOM { top_y = n.y1 - fh }
        hud.rect(o, n.x0, top_y, w, fh, n.colour)
        return
    }
    fw = round_px(w * n.fill)
    left_x = n.x0
    if n.fill_from == RIGHT { left_x = n.x1 - fw }
    hud.rect(o, left_x, n.y0, fw, h, n.colour)
}

face_of(s: *UiScreen, t: *UiTheme, n: *UiNode) -> Vec4 {
    if !n.enabled { return t.disabled }
    if s.active == n as ptr { return t.down }
    if s.hover == n as ptr { return t.hover }
    return t.face
}

label_colour(t: *UiTheme, n: *UiNode) -> Vec4 {
    if !n.enabled { return t.hint }
    return t.text
}

// The focus ring, inside the widget's edge, where the focus is.
ring_of(s: *UiScreen, o: *Hud, t: *UiTheme, n: *UiNode) {
    if !has_focus(n) { return }
    hud.rect_outline(o, n.x0, n.y0, n.x1 - n.x0, n.y1 - n.y0, round_px(RING * s.ui_scale), t.ring)
}

// A widget's label centred in a box, cut to it.
centred_label(s: *UiScreen, o: *Hud, n: *UiNode, x: float, y: float, w: float, h: float, colour: Vec4) {
    size = text_px(s, n)
    tw, th = hud.measure(o, n.label, size)
    hud.push_clip(o, x, y, w, h)
    hud.text(o, round_px(x + (w - tw) * 0.5), round_px(y + (h - th) * 0.5), size, n.label, colour)
    hud.pop_clip(o)
}

paint_toggle(s: *UiScreen, o: *Hud, t: *UiTheme, n: *UiNode, w: float, h: float) {
    side = h
    well = t.well
    if s.hover == n as ptr { well = t.hover }
    hud.rect(o, n.x0, n.y0, side, side, well)
    hud.rect_outline(o, n.x0, n.y0, side, side, round_px(BORDER * s.ui_scale), t.border)
    if n.on {
        inset = round_px(side * 0.22)
        check = t.accent
        if !n.enabled { check = t.hint }
        hud.rect(o, n.x0 + inset, n.y0 + inset, side - 2.0 * inset, side - 2.0 * inset, check)
    }
    gap = round_px(TOGGLE_GAP * s.ui_scale)
    size = text_px(s, n)
    _tw, th = hud.measure(o, n.label, size)
    hud.push_clip(o, n.x0, n.y0, w, h)
    hud.text(o, n.x0 + side + gap, round_px(n.y0 + (h - th) * 0.5), size, n.label, label_colour(t, n))
    hud.pop_clip(o)
    ring_of(s, o, t, n)
}

// The share of a slider's range its value is at.
slider_share(n: *UiNode) -> float {
    if n.high == n.low { return 0.0 }
    return (n.amount - n.low) / (n.high - n.low)
}

paint_slider(s: *UiScreen, o: *Hud, t: *UiTheme, n: *UiNode, w: float, h: float) {
    track = round_px(TRACK * s.ui_scale)
    if track < 2.0 { track = 2.0 }
    ty = round_px(n.y0 + (h - track) * 0.5)
    knob = round_px(KNOB * s.ui_scale)
    kx = round_px(n.x0 + (w - knob) * slider_share(n))
    hud.rect(o, n.x0, ty, w, track, t.well)
    fill = t.accent
    if !n.enabled { fill = t.hint }
    hud.rect(o, n.x0, ty, kx + knob * 0.5 - n.x0, track, fill)
    hud.rect(o, kx, n.y0, knob, h, face_of(s, t, n))
    hud.rect_outline(o, kx, n.y0, knob, h, round_px(BORDER * s.ui_scale), t.border)
    ring_of(s, o, t, n)
}

// A text field: its well, its border (or the focus ring), its text scrolled
// so the caret is in view and cut to the field, the caret blinking where
// the next character goes; its hint while it is empty and not focused.
paint_field(s: *UiScreen, o: *Hud, t: *UiTheme, n: *UiNode, w: float, h: float) {
    hud.rect(o, n.x0, n.y0, w, h, t.well)
    focused_now = has_focus(n)
    if focused_now {
        hud.rect_outline(o, n.x0, n.y0, w, h, round_px(RING * s.ui_scale), t.ring)
    } else {
        hud.rect_outline(o, n.x0, n.y0, w, h, round_px(BORDER * s.ui_scale), t.border)
    }
    pad = round_px(FIELD_PAD * s.ui_scale)
    inner_w = w - 2.0 * pad
    if inner_w <= 0.0 { return }
    size = text_px(s, n)
    tw, th = hud.measure(o, n.edit, size)
    ty = round_px(n.y0 + (h - th) * 0.5)
    ix = n.x0 + pad
    if n.length == 0 && !focused_now {
        n.view_x = 0.0
        hud.push_clip(o, ix, n.y0, inner_w, h)
        hud.text(o, ix, ty, size, n.label, t.hint)
        hud.pop_clip(o)
        return
    }
    at = caret_offset(o, n, size)
    caret_w = round_px(CARET * s.ui_scale)
    if caret_w < 1.0 { caret_w = 1.0 }
    if at - n.view_x > inner_w - caret_w { n.view_x = at - inner_w + caret_w }
    if at - n.view_x < 0.0 { n.view_x = at }
    if tw + caret_w <= inner_w { n.view_x = 0.0 }
    n.view_x = round_px(n.view_x)
    hud.push_clip(o, ix, n.y0, inner_w, h)
    colour = t.text
    if !n.enabled { colour = t.hint }
    hud.text(o, ix - n.view_x, ty, size, n.edit, colour)
    if focused_now && caret_shown(s) {
        hud.rect(o, round_px(ix - n.view_x + at), ty, caret_w, th, t.text)
    }
    hud.pop_clip(o)
}

caret_shown(s: *UiScreen) -> bool {
    phase = s.ui_clock - s.blink_from
    if phase < 0.0 { return true }
    cycles = floor(phase / BLINK)
    return (cycles as int) % 2 == 0
}

// How far into the field's text its caret is, in pixels.
caret_offset(o: *Hud, n: *UiNode, size: float) -> float {
    if n.cursor <= 0 { return 0.0 }
    head = bytes.string_from_ptr(n.buffer, n.cursor)
    w, _h = hud.measure(o, head, size)
    return w
}

// The caret nearest a point along a field, from where its text was drawn.
caret_at(s: *UiScreen, n: *UiNode, px: float) -> int {
    o = s.hud as *Hud
    if o == null || n.length == 0 { return 0 }
    size = text_px(s, n)
    pad = round_px(FIELD_PAD * s.ui_scale)
    along = px - (n.x0 + pad) + n.view_x
    best = 0
    best_gap = along
    if best_gap < 0.0 { best_gap = 0.0 - best_gap }
    at = 0
    while at < n.length {
        at = next_boundary(n, at)
        head = bytes.string_from_ptr(n.buffer, at)
        w, _h = hud.measure(o, head, size)
        gap = along - w
        if gap < 0.0 { gap = 0.0 - gap }
        if gap < best_gap {
            best = at
            best_gap = gap
        }
    }
    return best
}
