// The materials a batch's draws are made with (ae3d.batch): parameter sets
// a host names, each a quoted vertex and pixel shader pair of ae3d's own,
// so no shader text from the host reaches a driver.
//
// The first is three.js's MeshNormalMaterial: the surface's normal in the
// eye's space, packed into a colour as three.js packs it,
// normalize(n) * 0.5 + 0.5, written as it is (three.js's normal material
// has no colour-space step), with its opacity as alpha.

import std.quote
import ae3d.gpu (GpuShader, vertex, fragment)
import ae3d.shaderlib (vec2, vec3, vec4, mat4, mul, xyz, normalize)

exports (BatchVertex, NormalVaryings, normal_vertex, normal_pixel)

// What a batch's mesh gives a vertex, as ae3d's vertex has it.
struct BatchVertex {
    position: vec3
    uv: vec2
    normal: vec3
}

struct NormalVaryings {
    position: vec4
    eye_normal: vec3
}

// `mvp` the projection times the eye's view times the object's world
// matrix, made the renderer's (engine_canvas_lens on Vulkan); `turn` takes
// an object's normal into the eye's space (the view times world matrix's
// cofactors: its inverse transpose up to a scale the pixel shader
// normalises away).
normal_vertex(mvp: mat4, turn: mat4) -> *GpuShader {
    return vertex("batch_normal_vertex") quote | v: BatchVertex | {
        return NormalVaryings {
            position: mul(mvp, vec4(v.position, 1.0)),
            eye_normal: xyz(mul(turn, vec4(v.normal, 0.0)))
        }
    }
}

normal_pixel(opacity: float) -> *GpuShader {
    return fragment("batch_normal_pixel") quote | f: NormalVaryings | {
        n = normalize(f.eye_normal)
        return vec4(n * 0.5 + vec3(0.5, 0.5, 0.5), opacity)
    }
}
