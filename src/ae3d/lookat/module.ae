// ae3d.lookat -- a figure's head turns to look at a point (#587, part of
// #509): the neck carrying some of the turn and the head the rest, within
// a person's limits, eased in and out, every frame in the engine's pose
// phase after the clips.
//
//   l = lookat.attach(e, figure_root, neck, head, forward)  // forward: the way the figure faces, in its root's frame
//   lookat.set_target(l, point)                             // in the world
//   lookat.clear(l)                                         // back to the clip
//
// The turn is from where the clip has the head facing to the point: about
// the figure's up (yaw) and then across (pitch), each held within YAW_LIMIT
// and PITCH_LIMIT, as far as a neck turns. It is eased by a critically
// damped spring with a half-life of HALF_LIFE, toward the held turn, or
// toward none when cleared, so a head never snaps round. NECK_SHARE of it
// is the neck's and the rest the head's. `set_weight` fades it in and out.
// The bones it turns are put back to their own pose before each frame's
// turn, so a still pose is not turned further frame on frame.
import std.heap
import ae3d.core
import ae3d.engine
import ae3d.ik
import ae3d.figure

exports (
    LookAt, YAW_LIMIT, PITCH_LIMIT, HALF_LIFE, NECK_SHARE,
    attach, lookat_free, set_target, clear, release, set_weight, solve, yaw, pitch, aiming, set_figure
)

extern exp(x: float) -> float
extern asin(x: float) -> float

const YAW_LIMIT = 1.4                // radians (80 degrees) either side
const PITCH_LIMIT = 1.0              // radians (57 degrees) up and down
const HALF_LIFE = 0.12
const NECK_SHARE = 0.4

struct LookAt {
    engine: ptr                      // *Engine, or null when solved by hand
    behaviour: ptr                   // *Behaviour
    root: ptr                        // *Model: the figure's root
    neck: ptr                        // *Model
    head: ptr                        // *Model
    forward: Vec3                    // the way the figure faces, in its root's frame
    head_forward: Vec3               // the same in the head's own frame, as the clip had it at attach
    target: Vec3
    aiming: bool
    weight: float
    yaw: float                       // the turn drawn now, radians
    pitch: float
    yaw_rate: float
    pitch_rate: float
    // The bones' own pose, and what was written over it.
    neck_rot: Quat
    head_rot: Quat
    neck_wrote: Quat
    head_wrote: Quat
    wrote: bool
    figure: ptr                      // *Figure posing the neck and head, or null (set_figure)
    eye: Vec3                        // the head's place last frame, turned: where it looks from
}

attach(e: *Engine, root: *Model, neck: *Model, head: *Model, forward: Vec3) -> *LookAt {
    if root == null || neck == null || head == null { return null }
    l = heap.new(LookAt)
    l.engine = e as ptr
    l.root = root as ptr
    l.neck = neck as ptr
    l.head = head as ptr
    l.forward = core.v3_normalize(forward)
    l.weight = 1.0
    core.model_sync_transform(root)
    core.model_sync_transform(head)
    world_forward = core.quat_apply(root.world_rotation, l.forward)
    l.head_forward = core.quat_apply(core.quat_conjugate(head.world_rotation), world_forward)
    if e != null {
        b = engine.behaviour_new("lookat", l as ptr)
        b.pose = on_pose
        engine.engine_add_behaviour(e, b)
        l.behaviour = b as ptr
    }
    return l
}

lookat_free(l: *LookAt) {
    if l == null { return }
    e = l.engine as *Engine
    if e != null && l.behaviour != null {
        engine.engine_remove_behaviour(e, l.behaviour as *Behaviour)
        heap.free(l.behaviour as *Behaviour)
        l.behaviour = null
    }
    heap.free(l)
}

set_target(l: *LookAt, point: Vec3) {
    l.target = point
    l.aiming = true
}

clear(l: *LookAt) { l.aiming = false }

// Off at once, not eased: the neck and the head given back their own pose.
// For a figure handed to its ragdoll: eased out, the look went on turning
// the head the bodies had drawn, and the ragdoll took that for the
// animation's pose.
release(l: *LookAt) {
    if l == null { return }
    neck = l.neck as *Model
    head = l.head as *Model
    if l.wrote && same(neck.rotation, l.neck_wrote) && same(head.rotation, l.head_wrote) {
        core.model_set_rotation(neck, l.neck_rot)
        core.model_set_rotation(head, l.head_rot)
    } else if l.wrote && l.figure != null {
        take_turn_off(l.figure as *Figure, neck, l.neck_wrote, l.neck_rot)
        take_turn_off(l.figure as *Figure, head, l.head_wrote, l.head_rot)
    }
    l.aiming = false
    l.wrote = false
    l.yaw = 0.0
    l.pitch = 0.0
    l.yaw_rate = 0.0
    l.pitch_rate = 0.0
}

set_weight(l: *LookAt, w: float) {
    x = w
    if x < 0.0 { x = 0.0 }
    if x > 1.0 { x = 1.0 }
    l.weight = x
}

yaw(l: *LookAt) -> float { return l.yaw }
pitch(l: *LookAt) -> float { return l.pitch }
aiming(l: *LookAt) -> bool { return l.aiming }

on_pose(state: ptr, e: *Engine) {
    solve(state as *LookAt, engine.engine_delta_time(e))
}

clampf(x: float, low: float, high: float) -> float {
    if x < low { return low }
    if x > high { return high }
    return x
}

wrap(a: float) -> float {
    x = a
    while x > 3.14159265 { x = x - 6.2831853 }
    while x < 0.0 - 3.14159265 { x = x + 6.2831853 }
    return x
}

// The figure that poses the neck and the head: told, the look takes its
// own turn off them each frame even where the figure has moved them since
// (#673), unless the figure put them back itself. Taken off only where they
// still held exactly what it wrote, the figure's own offsets coming off
// from under it, on a clip that keys neither, left the look's turn on and
// the next went on top: a walker watching the car turned its head on and
// on, and once struck and up again, its ragdoll's head went after it.
set_figure(l: *LookAt, fig: *Figure) {
    if l != null { l.figure = fig as ptr }
}

// `m`'s turn, `before` it was turned to `wrote`, taken off it unless the
// figure put the turn back itself; on the node's side, the figure's being
// on the other.
take_turn_off(fig: *Figure, m: *Model, wrote: Quat, before: Quat) {
    if figure.turn_put_back(fig, m) { return }
    core.model_set_rotation(m, core.quat_normalize(core.quat_mul(core.quat_mul(m.rotation, core.quat_conjugate(wrote)), before)))
}

same(a: Quat, b: Quat) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w }

// A critically damped spring's value and rate after `t`, toward `goal`.
spring_value(x: float, v: float, goal: float, t: float) -> float {
    y = (4.0 * 0.69314718) / (HALF_LIFE + 0.00001) * 0.5
    j0 = x - goal
    j1 = v + j0 * y
    return exp(0.0 - y * t) * (j0 + j1 * t) + goal
}

spring_rate(x: float, v: float, goal: float, t: float) -> float {
    y = (4.0 * 0.69314718) / (HALF_LIFE + 0.00001) * 0.5
    j0 = x - goal
    j1 = v + j0 * y
    return exp(0.0 - y * t) * (v - j1 * y * t)
}

// A frame: the bones back to their clip's pose, the turn asked for and
// eased toward, and the turn shared between the neck and the head.
solve(l: *LookAt, delta: float) {
    neck = l.neck as *Model
    head = l.head as *Model
    root = l.root as *Model
    if l.wrote && same(neck.rotation, l.neck_wrote) && same(head.rotation, l.head_wrote) {
        core.model_set_rotation(neck, l.neck_rot)
        core.model_set_rotation(head, l.head_rot)
    } else if l.wrote && l.figure != null {
        take_turn_off(l.figure as *Figure, neck, l.neck_wrote, l.neck_rot)
        take_turn_off(l.figure as *Figure, head, l.head_wrote, l.head_rot)
    }
    l.neck_rot = neck.rotation
    l.head_rot = head.rotation
    core.model_sync_transform(root)
    core.model_sync_transform(head)
    up = core.quat_apply(root.world_rotation, core.vec3(0.0, 1.0, 0.0))
    // Where the clip has the head facing, and the way to the point, both in
    // the root's frame: as yaw about its up and pitch from level.
    goal_yaw = 0.0
    goal_pitch = 0.0
    if l.aiming {
        back = core.quat_conjugate(root.world_rotation)
        facing = core.quat_apply(back, core.quat_apply(head.world_rotation, l.head_forward))
        // From where the turned head was last frame: turning the neck moves
        // the head, and with it the way to the point.
        eye = head.world_position
        if l.wrote { eye = l.eye }
        toward = core.quat_apply(back, core.v3_sub(l.target, eye))
        if core.v3_len(toward) > 0.0001 && core.v3_len(facing) > 0.0001 {
            facing = core.v3_normalize(facing)
            toward = core.v3_normalize(toward)
            goal_yaw = clampf(wrap(core.atan2_of(toward.x, toward.z) - core.atan2_of(facing.x, facing.z)), 0.0 - YAW_LIMIT, YAW_LIMIT)
            goal_pitch = clampf(asin(clampf(toward.y, 0.0 - 1.0, 1.0)) - asin(clampf(facing.y, 0.0 - 1.0, 1.0)), 0.0 - PITCH_LIMIT, PITCH_LIMIT)
        }
    }
    goal_yaw = goal_yaw * l.weight
    goal_pitch = goal_pitch * l.weight
    if delta > 0.0 {
        ny = spring_value(l.yaw, l.yaw_rate, goal_yaw, delta)
        l.yaw_rate = spring_rate(l.yaw, l.yaw_rate, goal_yaw, delta)
        l.yaw = ny
        np = spring_value(l.pitch, l.pitch_rate, goal_pitch, delta)
        l.pitch_rate = spring_rate(l.pitch, l.pitch_rate, goal_pitch, delta)
        l.pitch = np
    }
    if core.abs_of(l.yaw) < 0.00001 && core.abs_of(l.pitch) < 0.00001 && !l.aiming {
        l.wrote = false
        return
    }
    // The turn: yaw about the figure's up, then pitch about the way across
    // the head as the yaw leaves it (looking up is a turn back about it).
    facing_world = core.quat_apply(head.world_rotation, l.head_forward)
    turned_facing = core.quat_apply(core.quat_rotate(l.yaw, up), facing_world)
    across = core.v3_cross(up, turned_facing)
    if core.v3_len(across) < 0.0001 { across = core.quat_apply(root.world_rotation, core.vec3(1.0, 0.0, 0.0)) }
    across = core.v3_normalize(across)
    // The whole turn, then the neck's share of it, and the head what is left
    // after the neck has turned it: two yaw-and-pitch turns one after the
    // other are not the whole one, and left the head 3 degrees off.
    whole = core.quat_normalize(core.quat_mul(core.quat_rotate(0.0 - l.pitch, across), core.quat_rotate(l.yaw, up)))
    neck_turn = core.quat_normalize(core.quat_slerp(core.quat_ident(), whole, NECK_SHARE))
    ik.turn_world(neck, neck_turn)
    ik.turn_world(head, core.quat_normalize(core.quat_mul(whole, core.quat_conjugate(neck_turn))))
    l.neck_wrote = neck.rotation
    l.head_wrote = head.rotation
    l.wrote = true
    core.model_sync_transform(head)
    l.eye = head.world_position
}
