// A float image: what an environment map is decoded to (#869), before it is
// a texture. Linear light as the file states it, RGBA, 32 bits a channel,
// the top row first (a file's order; picture's rows run bottom first because
// the renderers upload that way, and an equirectangular map is addressed by
// direction, which the shader maps to rows itself).
//
//   img = hdrimage.new_image(width, height)       // zeroed, alpha 1; null when it cannot be
//   p = hdrimage.pixels(img)                 // float[width * height * 4]
//   hdrimage.dispose(img)
//
// The decoders (ae3d.radiance, ae3d.openexr) answer in these and leave their
// reasons in hdrimage.error(); ae3d.envimage picks one by what a file is.
import std.string
import std.heap

exports (new_image, width, height, pixels, dispose, error, set_error, MAX_DIMENSION)

extern calloc(count: long, size: long) -> ptr
extern free(p: ptr)

// A side no map reaches, and the product a decoder will allocate for: 16384 by
// 8192 texels of four floats is 2 GB, past which a file is a mistake (or a
// bomb) and is refused before anything is allocated.
const MAX_DIMENSION = 32768
const MAX_TEXELS = 134217728

struct HdrImage {
    pixels: ptr
    width: int
    height: int
}

var g_error = ""
var g_error_owned = false

error() -> string { return g_error }

set_error(reason: string) {
    if g_error_owned { string.free(g_error) }
    g_error = string.copy(reason)
    g_error_owned = true
}

new_image(width: int, height: int) -> ptr {
    if width <= 0 || height <= 0 || width > MAX_DIMENSION || height > MAX_DIMENSION {
        set_error("the image has no usable size")
        return null
    }
    texels = (width as long) * (height as long)
    if texels > (MAX_TEXELS as long) {
        set_error("the image is too large")
        return null
    }
    img = heap.new(HdrImage)
    img.width = width
    img.height = height
    img.pixels = calloc(texels * (4 as long), 4 as long)
    if img.pixels == null {
        heap.free(img)
        set_error("out of memory")
        return null
    }
    p = img.pixels as f32[]
    i = 0
    n = (texels as int) * 4
    while i < n {
        p[i + 3] = 1.0 as f32
        i = i + 4
    }
    return img as ptr
}

width(img: ptr) -> int { return (img as *HdrImage).width }
height(img: ptr) -> int { return (img as *HdrImage).height }
pixels(img: ptr) -> ptr { return (img as *HdrImage).pixels }

dispose(img: ptr) {
    if img == null { return }
    h = img as *HdrImage
    if h.pixels != null { free(h.pixels) }
    heap.free(h)
}
