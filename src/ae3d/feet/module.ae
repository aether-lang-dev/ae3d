// ae3d.feet -- feet on the world (#577): a walking figure's feet on the
// ground under them, wherever that is, after its clip has posed it.
//
//   f = feet.attach(e, figure_root, hips, l_hip, l_knee, l_ankle, r_hip, r_knee, r_ankle)
//   feet.ground_physics(f, physics.of(e))       // or feet.ground_height(f, fn, state)
//
// A clip is made on a flat floor: the figure's root stands on it, and a
// foot's height above the root is how high the clip lifts it. On the world
// the floor is wherever the ground is under each foot. Every frame, in the
// pose phase (after the clips, before the draw):
//
//   - each foot's target is its animated place, raised or lowered to the
//     ground under it by what lies between that ground and the root's floor,
//     so a swing over a kerb clears the kerb by what it cleared the floor;
//   - the pelvis is lowered so the lower foot can reach its ground, and a
//     held foot the body has gone on past is within its leg's reach
//     (reach_drop) -- never raised -- eased toward that at no more than
//     PELVIS_SPEED, so a kerb appearing under a foot does not snap the body
//     down;
//   - each leg is solved onto its target with the two-bone solver
//     (ae3d.ik), its knee turned toward the way the figure faces;
//   - a foot on the ground is turned to lie on it: its up toward the
//     ground's normal, by no more than FOOT_TILT, so a slope does not leave
//     it standing on its heel or toes;
//   - a foot the clip has set down is locked: it stays where it was set and
//     as it was turned, whatever the body does over it, until the clip
//     lifts it or the body is LOCK_REACH from it, and is let go over
//     UNLOCK_SECONDS, place and turn, before it can be locked again,
//     carried to its animated place over the ground, lifted along an arc
//     by RELEASE_LIFT of the way, not dragged along it.
//     Contact comes from the clip -- a foot low and slow is set down, and
//     held while it stays low -- so no hand-made labels are needed;
//   - every foot keeps the turn the clip gave it in the world: its shin
//     solved, it is not carried round with it.
//
// It eases out to nothing while the figure is in the air or ragdolled
// (`set_weight`), and back.
import std.heap
import std.list
import ae3d.core
import ae3d.engine
import ae3d.ik
import ae3d.physics
import ae3d.figure
import ae3d.skin

exports (
    Feet, Leg,
    attach, feet_free, ground_physics, ground_height, set_weight, release, solve,
    pelvis_offset, leg, leg_count, leg_locked, leg_target, leg_ground, leg_ankle,
    PELVIS_SPEED, FOOT_TILT, UNLOCK_SECONDS, RELEASE_LIFT, STEP_LIFT, LOCK_REACH, LIFT_RELEASE, set_figure
)

// How fast the pelvis moves to its height, metres a second.
const PELVIS_SPEED = 0.6
// The most the pelvis is lowered to bring a held foot within its leg's reach
// (reach_drop), metres: further, the clip's stride is not a crouch, and the
// foot gives.
const REACH_DROP = 0.05
const BENT = 0.01                       // m off the hip-ankle line a knee is bent, for its pole
// m off the hip-ankle line a knee is flexed, past the few degrees a clip
// overstraightens one: only a bend past it says which way the knee bends.
const FLEXED = 0.05
const TOE_FRONT = 0.02                  // m: a leg's front taken from its foot, before any flex is learnt
const FRONT_MEMORY = 0.99               // of the knee's learnt front kept a frame
// The most a foot is turned to lie on the ground, radians (30 degrees).
const FOOT_TILT = 0.5236
// How long a foot takes to leave the place it was locked to.
const UNLOCK_SECONDS = 0.15
// And it is carried there over the ground, not along it: lifted along an arc
// by this share of the way it has to go, up to STEP_LIFT, as its own step is.
// A walker's foot is let go 9 cm on average from where the walk has it (5.6
// cm along the way the body went, 5.5 across, turning; ahead of it, #759),
// and caught up over UNLOCK_SECONDS at the clip's height, its toe still on
// the ground, it slid there: in the plaza with no car, 70% of the toes'
// skating. Lifted a fifth of the way, the toes slid 0.76 cm a walker-second
// against 2.72, 56 cm a run within 1 cm of the ground against 116.
const RELEASE_LIFT = 0.2
// A foot is down while it is within this share of its standing height above
// the floor (above that the clip is lifting it)...
const CONTACT_LIFT = 1.35
// ...and moving slower than this over the ground, metres a second...
const CONTACT_SPEED = 0.6
// ...or, at whatever speed, within this share of its standing height: on
// the ground. A clip that sets a foot down still moving is set down where it
// touches; a swing never comes that low.
const CONTACT_TOUCH = 1.05
// The farthest its animated place may be from where a foot held on the ground
// was set before it is let go, metres.
const LOCK_REACH = 0.35
// How far over where it was set a held foot's clip lifts it before it is let
// go, metres.
const LIFT_RELEASE = 0.02
// How far over where it was set the clip may lift a foot, heel first, that
// stays held because no other foot is: a walk has a foot on the ground at
// every moment, the trailing toe until the leading heel strikes (#676).
const HEEL_RISE = 0.08
// A foot held on the ground that its clip, keeping it on the ground, has
// moved more than STEP_OFF from where it is held steps there by itself: lifted
// along an arc up to STEP_LIFT and set down over STEP_SECONDS, once it has
// stood STEP_REST and while another foot holds the body, one foot at a time,
// and only where the clip has set it, still (its ankle slower than
// STEP_STILL as the clip moves it, in its root's frame), and the body not
// going over the ground (its root slower than STEP_STILL; turning where it
// stands is not going): a clip moving it is about to step it itself, and a
// body carried over a held foot is walked on by its clip. Measured in the
// world alone, a body turned on the spot over its idle moved every ankle,
// and no foot stepped until the turn was over, the legs twisted round under
// it (#827). Held there, a
// body stopping over it drew the leg out straight and dragged the toe up off
// the ground and along it. Stepped while the clip still moved it, at the
// start of a turn on the spot, it was in the air as the walk lifted the
// other foot.
const STEP_OFF = 0.08
const STEP_STILL = 0.15
const STEP_LIFT = 0.06
const STEP_SECONDS = 0.25
const STEP_REST = 0.1
const STEP_PLACE = 0.8                  // of a step, by when the foot is over its place
// How far above a foot the ground is looked for, and how far below.
const LOOK_UP = 1.0
const LOOK_DOWN = 2.0
// The highest above the floor the body stands on that ground under a foot
// is ground for it: the step the body itself walks up (physics.STEP_HEIGHT,
// its capsule's gap). A ledge or a wall's top higher than that is not stood
// on; the foot keeps to the floor beside it. A walker standing by the
// plaza's steps put its foot on a top 0.6 m over its floor, its ankle above
// its hips and its knee folded back 53 degrees for 9 s; at 0.45 m, a walker
// on the first step beside the 0.6 m deck still put a foot on the deck,
// 0.45 m up, and flung its thigh 80 to 118 degrees for a frame or two.
step_up() -> float { return physics.STEP_HEIGHT }

struct Leg {
    hip: ptr                         // *Model
    knee: ptr
    ankle: ptr
    standing: float                  // the ankle's height above the floor in the bind pose
    locked: bool
    lock_at: Vec3                    // where it was set down
    lock_turn: Quat                  // and turned, in the world
    release: float                   // seconds of letting go left
    released_from: Vec3              // where it was let go from
    release_way: float               // how far, level, it had to go as it was let go
    held_for: float                  // seconds held
    stepping: bool                   // stepping by itself to where the clip has it
    step_t: float                    // seconds into the step
    step_from: Vec3                  // where it stepped from
    step_turn: Quat                  // and turned
    step_lift: float                 // the arc's height
    step_share: float                // how far along, eased
    step_over: bool                  // over its place: coming straight down on step_to
    step_to: Vec3
    last: Vec3                       // the animated ankle last frame
    last_in: Vec3                    // and in its root's frame
    known: bool
    target: Vec3                     // this frame's
    ground: Vec3                     // the ground under it, and its normal
    normal: Vec3
    // Its bones' own turns before this frame's solve, and what it wrote.
    hip_rot: Quat
    knee_rot: Quat
    ankle_rot: Quat
    // The way its knee bends, learnt from the clip in the hips' frame (#572):
    // the sum of the clip's bends there past FLEXED, each by how far, fading
    // over FRONT_MEMORY; so it points the way the knee flexes, and turns
    // with the body (learn_front).
    front: Vec3
    hip_wrote: Quat
    knee_wrote: Quat
    ankle_wrote: Quat
    wrote: bool
}

struct Feet {
    engine: ptr
    root: ptr                        // *Model the figure stands on: its floor is this one's height
    hips: ptr                        // *Model lowered for the lower foot
    figure: ptr                      // *Figure posing it, or null: whether it put the hips and legs back (set_figure)
    legs: ptr                        // list of *Leg
    pelvis: float                    // the pelvis's offset now, metres (negative, down)
    root_was: Vec3                   // the root last frame, and whether known: how fast the body goes over the ground
    root_known: bool
    weight: float                    // 1 on, 0 off
    wanted_weight: float
    // The ground: a physics world's static bodies, or a function of a place.
    physics: ptr
    height_fn: fn(ptr, float, float) -> float
    height_state: ptr
    behaviour: ptr
    // The hips' own place before this frame's lowering, and what was written
    // over it: a hips bone no clip poses is given its own back first.
    hips_pos: Vec3
    wrote_pos: Vec3
    wrote: bool
}

// Feet for a figure: `root` the model it stands on (the figure's group, or
// its rig's root), `hips` the bone the legs hang from, and each leg's hip,
// knee and ankle, from the figure's skeleton as it stands now (its bind
// pose: each ankle's standing height is read from it). Solved every frame
// in the engine's pose phase; the ground is flat at the root's height until
// it is given.
attach(e: *Engine, root: *Model, hips: *Model, l_hip: *Model, l_knee: *Model, l_ankle: *Model,
       r_hip: *Model, r_knee: *Model, r_ankle: *Model) -> *Feet {
    f = heap.new(Feet)
    f.engine = e as ptr
    f.root = root as ptr
    f.hips = hips as ptr
    f.legs = list.new()
    f.weight = 1.0
    f.wanted_weight = 1.0
    add_leg(f, l_hip, l_knee, l_ankle)
    add_leg(f, r_hip, r_knee, r_ankle)
    if e != null {
        b = engine.behaviour_new("feet", f as ptr)
        b.pose = on_pose
        b.update = on_update
        engine.engine_add_behaviour(e, b)
        f.behaviour = b as ptr
    }
    return f
}

add_leg(f: *Feet, hip: *Model, knee: *Model, ankle: *Model) {
    l = heap.new(Leg)
    l.hip = hip as ptr
    l.knee = knee as ptr
    l.ankle = ankle as ptr
    core.model_sync_transform(ankle)
    core.model_sync_transform(f.root as *Model)
    l.standing = ankle.world_position.y - (f.root as *Model).world_position.y
    if l.standing < 0.01 { l.standing = 0.01 }
    list.add_raw(f.legs, l as ptr)
}

feet_free(f: *Feet) {
    if f == null { return }
    e = f.engine as *Engine
    // Out of the engine's list, the step is ours to free: the engine frees
    // only the behaviours it still holds.
    if e != null && f.behaviour != null {
        engine.engine_remove_behaviour(e, f.behaviour as *Behaviour)
        heap.free(f.behaviour as *Behaviour)
        f.behaviour = null
    }
    i = 0
    while i < list.size(f.legs) {
        heap.free(list.get_raw(f.legs, i) as *Leg)
        i = i + 1
    }
    list.free(f.legs)
    heap.free(f)
}

// The figure that poses these legs: told, the feet take their own drop
// off the hips, and their solved turns off the legs, each frame even where
// another has moved them since (#673), unless the figure put them back
// itself.
set_figure(f: *Feet, fig: *Figure) {
    if f == null { return }
    f.figure = fig as ptr
    if fig != null { toes_ahead(f, figure.skeleton(fig)) }
}

// Each leg's front, before its clip has flexed the knee: the way its foot
// points, from the ankle to the bone the ankle carries (its toes), across
// the line from the hip to the ankle, a knee bending over its toes. Put
// small (TOE_FRONT), so the first knee flexed past FLEXED outweighs it.
// Taken toward the root's +z, as it was, a plaza walker (its object facing
// -z) set off on both knees bent backwards, its legs straight in the clip.
toes_ahead(f: *Feet, sk: *Skeleton) {
    if sk == null { return }
    hips = f.hips as *Model
    core.model_sync_transform(hips)
    to_hips = core.quat_conjugate(hips.world_rotation)
    i = 0
    while i < list.size(f.legs) {
        l = list.get_raw(f.legs, i) as *Leg
        ankle = l.ankle as *Model
        b = 0
        while b < skin.skeleton_count(sk) {
            toe = skin.skeleton_bone(sk, b)
            if core.model_parent(toe) == ankle {
                core.model_sync_transform(toe)
                core.model_sync_transform(l.hip as *Model)
                line = core.v3_normalize(core.v3_sub(ankle.world_position, (l.hip as *Model).world_position))
                way = core.v3_sub(toe.world_position, ankle.world_position)
                way = core.v3_sub(way, core.v3_mul(line, core.v3_dot(way, line)))
                if core.v3_len(way) > 0.001 && core.v3_len(l.front) < BENT {
                    l.front = core.quat_apply(to_hips, core.v3_mul(core.v3_normalize(way), TOE_FRONT))
                }
                b = skin.skeleton_count(sk)
            }
            b = b + 1
        }
        i = i + 1
    }
}

// The ground: the static bodies of a physics world, by a ray down.
ground_physics(f: *Feet, p: *Physics) {
    f.physics = p as ptr
    f.height_fn = null
}

// The ground: a function of a place's x and z giving its height (the normal
// is worked out from it), with its own state.
ground_height(f: *Feet, height: fn(ptr, float, float) -> float, state: @keep ptr) {
    f.height_fn = height
    f.height_state = state
    f.physics = null
}

// On (1), off (0), or between: it eases to what is asked over a quarter
// of a second. Off while the figure is in the air or a ragdoll has it.
set_weight(f: *Feet, w: float) {
    f.wanted_weight = w
}

// Off at once, not eased: its last turn of the legs and its lowering of
// the hips put back, the held feet let go. For a figure handed to its
// ragdoll: eased out over a quarter second, the solve went on turning the
// legs the bodies had drawn, and the ragdoll took that for the animation's
// pose to stand in.
release(f: *Feet) {
    if f == null { return }
    put_back(f)
    f.weight = 0.0
    f.wanted_weight = 0.0
    f.pelvis = 0.0
    n = list.size(f.legs)
    i = 0
    while i < n {
        l = list.get_raw(f.legs, i) as *Leg
        l.locked = false
        l.release = 0.0
        l.stepping = false
        l.known = false
        i = i + 1
    }
}

leg_count(f: *Feet) -> int { return list.size(f.legs) }
leg(f: *Feet, i: int) -> *Leg { return list.get_raw(f.legs, i) as *Leg }
leg_locked(f: *Feet, i: int) -> bool { return leg(f, i).locked }
leg_target(f: *Feet, i: int) -> Vec3 { return leg(f, i).target }
leg_ground(f: *Feet, i: int) -> Vec3 { return leg(f, i).ground }
leg_ankle(f: *Feet, i: int) -> *Model { return leg(f, i).ankle as *Model }
pelvis_offset(f: *Feet) -> float { return f.pelvis }

// The ground under a place: its height and its normal.
ground_at(f: *Feet, x: float, z: float, from_y: float) -> (float, Vec3) {
    if f.height_fn != null {
        h = f.height_fn
        y = h(f.height_state, x, z)
        if y > from_y + step_up() { return (f.root as *Model).world_position.y, core.vec3(0.0, 1.0, 0.0) }
        e = 0.05
        dx = h(f.height_state, x + e, z) - h(f.height_state, x - e, z)
        dz = h(f.height_state, x, z + e) - h(f.height_state, x, z - e)
        return y, core.v3_normalize(core.vec3(0.0 - dx, 2.0 * e, 0.0 - dz))
    }
    if f.physics != null {
        hit = physics.ray_static_hit(f.physics as *Physics, core.vec3(x, from_y + LOOK_UP, z), core.vec3(0.0, 0.0 - 1.0, 0.0), LOOK_UP + LOOK_DOWN)
        if hit.hit && hit.point.y <= from_y + step_up() { return hit.point.y, hit.normal }
    }
    return (f.root as *Model).world_position.y, core.vec3(0.0, 1.0, 0.0)
}

on_update(state: ptr, e: *Engine, delta: float) {
    f = state as *Feet
    f.weight = ease(f.weight, f.wanted_weight, delta * 4.0)
}

// How far the pelvis must come down for a leg to reach `target` from its hip
// as the clip has it (0, or negative): the target lower under the hip than
// the leg, its full length, reaches at that level distance. A foot held
// where it was set while the body went on over it is drawn out past the
// leg's reach, braking from a run most: held on the ground at the height
// the clip had its ankle, the leg came up 4 to 8.6 mm short of it, the
// solve left it straight and pointing, and the toe slid 7 mm on the ground
// (#828). No further down than REACH_DROP, and nothing where the target is
// level-wise past the leg: that foot is let go (LOCK_REACH).
reach_drop(l: *Leg, target: Vec3) -> float {
    hip = l.hip as *Model
    knee = l.knee as *Model
    ankle = l.ankle as *Model
    core.model_sync_transform(ankle)
    at = hip.world_position
    reach = core.v3_distance(at, knee.world_position) + core.v3_distance(knee.world_position, ankle.world_position)
    dx = target.x - at.x
    dz = target.z - at.z
    level = dx * dx + dz * dz
    if level >= reach * reach { return 0.0 }
    under = core.sqrt_of(reach * reach - level)
    over = at.y - target.y
    if over <= under { return 0.0 }
    need = under - over
    if need < 0.0 - REACH_DROP { need = 0.0 - REACH_DROP }
    return need
}

ease(now: float, wanted: float, step: float) -> float {
    if now < wanted {
        moved = now + step
        if moved > wanted { return wanted }
        return moved
    }
    moved = now - step
    if moved < wanted { return wanted }
    return moved
}

on_pose(state: ptr, e: *Engine) {
    f = state as *Feet
    solve(f, engine.engine_delta_time(e))
}

// Learns the way leg `l`'s knee flexes from the clip, in the hips' frame:
// its knee off the line from its hip to its ankle, as the clip has it now,
// summed with the bends before, fading over FRONT_MEMORY. Only a bend past
// FLEXED: kept the way it was last seen bent in the world, a near-straight
// leg's pole went stale as the walker turned under it, and a clip
// overstraightening the knee a few degrees set it bending backwards: walkers
// in the plaza's crowd stood on knees bent back 5 to 55 degrees, 132 times
// in 30 s with 20 of them. Toward the root's +z, as it was before, a figure
// whose clips walk another way (the box man walks along its own x) had its
// knees bent backwards whenever it walked that way: of 20 walkers' legs over
// 20 s, 442 s bent back, 28 with the feet let go.
learn_front(l: *Leg, hips_turn: Quat) {
    hip = l.hip as *Model
    knee = l.knee as *Model
    ankle = l.ankle as *Model
    core.model_sync_transform(hip)
    core.model_sync_transform(knee)
    core.model_sync_transform(ankle)
    line = core.v3_sub(ankle.world_position, hip.world_position)
    span = core.v3_dot(line, line)
    if span <= 0.0001 { return }
    u = core.v3_dot(core.v3_sub(knee.world_position, hip.world_position), line) / span
    bend = core.v3_sub(knee.world_position, core.v3_add(hip.world_position, core.v3_mul(line, u)))
    if core.v3_len(bend) > FLEXED {
        l.front = core.v3_add(core.v3_mul(l.front, FRONT_MEMORY), core.quat_apply(core.quat_conjugate(hips_turn), bend))
    }
}

// The frame's feet, `delta` seconds on from the last: called by the
// engine's pose phase, or by whatever poses the figure without one.
solve(f: *Feet, delta: float) {
    // Last frame's turn of the legs taken off first, where nothing has
    // posed them since -- a clip held, or stopped, under a ragdoll that
    // has the figure: turned again on top of it, frame on frame as the
    // weight eased out, the legs were left twisted, and a struck walker
    // got up into that pose and fell again (#572).
    put_back(f)
    if f.weight <= 0.0 {
        f.pelvis = ease(f.pelvis, 0.0, PELVIS_SPEED * delta)
        return
    }
    root = f.root as *Model
    core.model_sync_transform(root)
    floor = root.world_position.y
    // The body going over the ground (a locomotion carrying it, its hold's
    // offset bleeding out), not turning where it stands.
    going = 0.0
    if f.root_known && delta > 0.0 {
        gx = root.world_position.x - f.root_was.x
        gz = root.world_position.z - f.root_was.z
        going = core.sqrt_of(gx * gx + gz * gz) / delta
    }
    f.root_was = root.world_position
    f.root_known = true
    n = list.size(f.legs)
    // Where each foot goes, and how far the pelvis has to come down for the
    // lowest of them.
    drop = 0.0
    held = 0
    stepping = false
    i = 0
    while i < n {
        if (list.get_raw(f.legs, i) as *Leg).locked { held = held + 1 }
        if (list.get_raw(f.legs, i) as *Leg).stepping { stepping = true }
        i = i + 1
    }
    i = 0
    while i < n {
        l = list.get_raw(f.legs, i) as *Leg
        ankle = l.ankle as *Model
        core.model_sync_transform(ankle)
        a = ankle.world_position
        above = a.y - floor
        gy, normal = ground_at(f, a.x, a.z, floor)
        l.ground = core.vec3(a.x, gy, a.z)
        l.normal = normal
        target = core.vec3(a.x, gy + above, a.z)
        // Down and slow: the clip has set this foot down.
        speed = 0.0
        // And as the clip moves it, in its root's frame: the body turned
        // over a still clip (a turn on the spot over the idle) moves the
        // ankle in the world, not in the clip.
        in_root = core.quat_apply(core.quat_conjugate(root.world_rotation), core.v3_sub(a, root.world_position))
        in_clip = 0.0
        if l.known && delta > 0.0 {
            dx = a.x - l.last.x
            dz = a.z - l.last.z
            speed = core.sqrt_of(dx * dx + dz * dz) / delta
            ix = in_root.x - l.last_in.x
            iz = in_root.z - l.last_in.z
            in_clip = core.sqrt_of(ix * ix + iz * iz) / delta
        }
        l.last = a
        l.last_in = in_root
        l.known = true
        low = above < l.standing * CONTACT_LIFT
        // Held only once slow, a foot the box man's walk set down at 1.2 m/s
        // slid 2 cm on the ground before it was held, at every step.
        down = low && (speed < CONTACT_SPEED || above < l.standing * CONTACT_TOUCH)
        // Held, it stays held while it is low: what moves the animated
        // ankle over the ground then is the body over the foot (a
        // locomotion's offset bleeding out, #611), not the clip lifting it --
        // let go for that, the planted foot slid with it. Only the body
        // drawn LOCK_REACH from it lets it go on the ground.
        // And it is let go as the clip lifts it LIFT_RELEASE over where it
        // was set: held on to the bind pose's measure of a lifted foot, 1.35
        // times the ankle's height standing in it, the walk's foot was 6 cm
        // up into its swing -- the box man's planted ankle is 0.07 m high,
        // its bind pose's 0.1 -- and the leg dragged it 13 cm to the hold
        // as it went.
        // But the only foot held is not let go by its heel rising, up to
        // HEEL_RISE, before another is set down: its toe is still on the
        // ground in the clip. Let go at the heel, turning round on the spot,
        // a foot held while the body turned over it went to where the clip
        // had it with the other still in the air, its toe skimming the
        // ground (#676).
        if l.locked {
            away = core.vec3(target.x - l.lock_at.x, 0.0, target.z - l.lock_at.z)
            held_y, _held_normal = ground_at(f, l.lock_at.x, l.lock_at.z, floor)
            rise = held_y + above - l.lock_at.y
            reach = core.v3_len(away) < LOCK_REACH
            down = low && reach && rise < LIFT_RELEASE
            if !down && held == 1 && reach && rise < HEEL_RISE { down = true }
        }
        // Let go, it is carried over to its animated place before it can be
        // held again: set down at once where the clip had it, it jumped
        // there, 30 cm in a frame.
        if down && !l.locked && !l.stepping && l.release <= 0.0 {
            l.locked = true
            l.lock_at = target
            l.lock_turn = ankle.world_rotation
            l.release = 0.0
            l.held_for = 0.0
            held = held + 1
        } else if !down && l.locked {
            l.locked = false
            l.release = UNLOCK_SECONDS
            l.released_from = l.lock_at
            l.release_way = core.v3_len(core.vec3(target.x - l.lock_at.x, 0.0, target.z - l.lock_at.z))
            held = held - 1
        }
        // A step of its own, to where the clip has it on the ground.
        if l.locked {
            l.held_for = l.held_for + delta
            off = core.v3_len(core.vec3(target.x - l.lock_at.x, 0.0, target.z - l.lock_at.z))
            if off > STEP_OFF && in_clip < STEP_STILL && going < STEP_STILL && !stepping && held >= 2 && l.held_for >= STEP_REST {
                l.locked = false
                held = held - 1
                stepping = true
                l.stepping = true
                l.step_t = 0.0
                l.step_from = l.lock_at
                l.step_turn = l.lock_turn
                l.step_over = false
                l.step_lift = off * 0.5
                if l.step_lift > STEP_LIFT { l.step_lift = STEP_LIFT }
            }
        } else if l.stepping && !low {
            // The clip lifts it into its own step: carried on from here as
            // a foot let go.
            l.stepping = false
            l.release = UNLOCK_SECONDS
            l.released_from = core.v3_add(l.step_from, core.v3_mul(core.vec3(target.x - l.step_from.x, 0.0, target.z - l.step_from.z), l.step_share))
            if l.step_over { l.released_from = l.step_to }
            l.lock_turn = core.quat_slerp(l.step_turn, ankle.world_rotation, l.step_share)
            l.release_way = core.v3_len(core.vec3(target.x - l.released_from.x, 0.0, target.z - l.released_from.z))
        }
        lift = 0.0
        landed = false
        if l.stepping {
            l.step_t = l.step_t + delta
            u = l.step_t / STEP_SECONDS
            if u > 1.0 { u = 1.0 }
            // Over the ground by STEP_PLACE of the step, then set down: a
            // foot comes to its place before it lands. Carried the whole
            // step, a turning figure's foot was within 1.5 cm of the ground
            // still going 13 mm a frame as it came down.
            over = u / STEP_PLACE
            if over > 1.0 { over = 1.0 }
            l.step_share = over * over * (3.0 - 2.0 * over)
            lift = l.step_lift * core.sin_of(3.14159265 * u)
            target = core.vec3(l.step_from.x + (target.x - l.step_from.x) * l.step_share, target.y,
                               l.step_from.z + (target.z - l.step_from.z) * l.step_share)
            // Over its place, it comes straight down there: the place the
            // clip has it goes on with the body turning over it, and
            // followed down, a figure turning on the spot set its foot down
            // going 7.5 mm a frame, and slid it that far on the ground
            // (#827).
            if over >= 1.0 {
                if !l.step_over {
                    l.step_over = true
                    l.step_to = target
                }
                target = core.vec3(l.step_to.x, target.y, l.step_to.z)
            }
            // Down on its last frame: its frames' seconds summed fall short of
            // STEP_SECONDS by their round-off, and it stood a frame on the
            // ground unheld.
            landed = l.step_t >= STEP_SECONDS - 0.000001
        }
        if l.locked {
            target = core.vec3(l.lock_at.x, target.y, l.lock_at.z)
        } else if l.release > 0.0 {
            l.release = l.release - delta
            if l.release < 0.0 { l.release = 0.0 }
            t = l.release / UNLOCK_SECONDS
            target = core.vec3(target.x + (l.released_from.x - target.x) * t, target.y, target.z + (l.released_from.z - target.z) * t)
            up = l.release_way * RELEASE_LIFT
            if up > STEP_LIFT { up = STEP_LIFT }
            lift = up * core.sin_of(3.14159265 * (1.0 - t))
        }
        // Held, or carried back from where it was held, it stands on the
        // ground under where it is, not under the clip's ankle. Its height
        // taken from the clip's ankle, a walker going along the plaza's kerb
        // with a foot held on it had that foot posed on the road's height,
        // 15 cm down inside the kerb, once its ankle in the clip had passed
        // the kerb's edge; the car struck it, its ragdoll was put on that
        // pose, and the foot stayed caught in the kerb for the rest of the
        // minute, 45 s sunk in the ground.
        if l.locked || l.release > 0.0 || l.stepping {
            gy, normal = ground_at(f, target.x, target.z, floor)
            l.ground = core.vec3(target.x, gy, target.z)
            l.normal = normal
            target = core.vec3(target.x, gy + above + lift, target.z)
        }
        if landed {
            l.stepping = false
            l.locked = true
            l.lock_at = target
            l.lock_turn = ankle.world_rotation
            l.held_for = 0.0
            held = held + 1
        }
        l.target = target
        need = target.y - a.y
        if need < drop { drop = need }
        need = reach_drop(l, target)
        if need < drop { drop = need }
        i = i + 1
    }
    // The pelvis eased to its height, never raised above the clip's.
    f.pelvis = ease(f.pelvis, drop, PELVIS_SPEED * delta)
    if delta <= 0.0 { f.pelvis = drop }
    hips = f.hips as *Model
    f.hips_pos = hips.position
    lowered = f.pelvis * f.weight
    if lowered != 0.0 {
        core.model_sync_transform(hips)
        parent = core.model_parent(hips)
        world = core.v3_add(hips.world_position, core.vec3(0.0, lowered, 0.0))
        if parent == null {
            core.model_set_position(hips, world.x, world.y, world.z)
        } else {
            core.model_sync_transform(parent)
            local = core.mat4_transform_point(core.mat4_inverse(parent.model_matrix), world)
            core.model_set_position(hips, local.x, local.y, local.z)
        }
    }
    f.wrote_pos = hips.position
    f.wrote = true
    // Each leg onto its target, its knee bent the way the clip bends it.
    forward = core.quat_apply(root.world_rotation, core.vec3(0.0, 0.0, 1.0))
    hips_turn = (f.hips as *Model).world_rotation
    // Every leg's front learnt from the clip before any leg is solved, and
    // the figure's, the sum of them, for a leg that has not flexed yet.
    figure_front = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < n {
        l = list.get_raw(f.legs, i) as *Leg
        learn_front(l, hips_turn)
        figure_front = core.v3_add(figure_front, l.front)
        i = i + 1
    }
    i = 0
    while i < n {
        l = list.get_raw(f.legs, i) as *Leg
        ankle = l.ankle as *Model
        knee = l.knee as *Model
        core.model_sync_transform(ankle)
        a = ankle.world_position
        goal = core.v3_add(a, core.v3_mul(core.v3_sub(l.target, a), f.weight))
        clip_turn = ankle.world_rotation
        // A foot on the ground keeps the turn it was set down with: the body
        // turning over it does not screw it round on the ground.
        if l.locked { clip_turn = l.lock_turn }
        if l.stepping { clip_turn = core.quat_slerp(l.step_turn, clip_turn, l.step_share) }
        if !l.locked && l.release > 0.0 { clip_turn = core.quat_slerp(clip_turn, l.lock_turn, l.release / UNLOCK_SECONDS) }
        core.model_sync_transform(knee)
        // The knee's pole is the way the clip flexes it (learn_front); a leg
        // not yet seen flexed takes the way the figure's others flex,
        // toward the root's +z only when none has been. Its own bend there,
        // as it was, came from a clip overstraightening the knee as a walk
        // began: the pole behind it, a walker's knee bent backwards with
        // its thigh facing ahead, or with its thigh turned half round to
        // face the pole, its toe pointed backwards (#781); 13 of 24 walkers
        // in the plaza's first second.
        way = core.quat_apply(hips_turn, l.front)
        if core.v3_len(way) < BENT {
            way = core.quat_apply(hips_turn, figure_front)
            if core.v3_len(way) < BENT { way = forward }
        }
        pole = core.v3_add(knee.world_position, core.v3_mul(core.v3_normalize(way), 0.5))
        l.hip_rot = (l.hip as *Model).rotation
        l.knee_rot = knee.rotation
        l.ankle_rot = ankle.rotation
        ik.solve_two_bone(l.hip as *Model, knee, ankle, goal, pole)
        // The foot as the clip turned it in the world, not as the shin it
        // hangs from now carries it: turned with the solved shin, a planted
        // foot pitched about its locked ankle and swept its toe over the
        // ground, 55% of the body's way walking straight (#611).
        core.model_sync_transform(ankle)
        back = core.quat_mul(clip_turn, core.quat_conjugate(ankle.world_rotation))
        ik.turn_world(ankle, core.quat_slerp(core.quat_ident(), back, f.weight))
        // A foot on the ground lies on it.
        if l.locked {
            up = core.vec3(0.0, 1.0, 0.0)
            tilt = core.acos_of(core.v3_dot(up, l.normal))
            if tilt > 0.0001 {
                axis = core.v3_normalize(core.v3_cross(up, l.normal))
                if tilt > FOOT_TILT { tilt = FOOT_TILT }
                ik.turn_world(ankle, core.quat_rotate(tilt * f.weight, axis))
            }
        }
        l.hip_wrote = (l.hip as *Model).rotation
        l.knee_wrote = knee.rotation
        l.ankle_wrote = ankle.rotation
        l.wrote = true
        i = i + 1
    }
}

// The legs' and the hips' own pose back where they still hold what this
// wrote last frame: nothing posed them since.
put_back(f: *Feet) {
    n = list.size(f.legs)
    i = 0
    while i < n {
        l = list.get_raw(f.legs, i) as *Leg
        hip = l.hip as *Model
        knee = l.knee as *Model
        ankle = l.ankle as *Model
        if l.wrote && same_q(hip.rotation, l.hip_wrote) && same_q(knee.rotation, l.knee_wrote) && same_q(ankle.rotation, l.ankle_wrote) {
            core.model_set_rotation(hip, l.hip_rot)
            core.model_set_rotation(knee, l.knee_rot)
            core.model_set_rotation(ankle, l.ankle_rot)
        } else if l.wrote && f.figure != null {
            // Turned since -- the figure's own offsets coming off them, on
            // a clip that does not key the legs' turns -- and not put back
            // by the figure: only this one's turn taken off each (#673).
            // Left on, the legs were solved from last frame's solution, and
            // the box man's planted toe slid 6.9% of its way turning round.
            fig = f.figure as *Figure
            take_turn_off(fig, hip, l.hip_wrote, l.hip_rot)
            take_turn_off(fig, knee, l.knee_wrote, l.knee_rot)
            take_turn_off(fig, ankle, l.ankle_wrote, l.ankle_rot)
        }
        l.wrote = false
        i = i + 1
    }
    hips = f.hips as *Model
    if f.wrote && hips.position.x == f.wrote_pos.x && hips.position.y == f.wrote_pos.y && hips.position.z == f.wrote_pos.z {
        core.model_set_position(hips, f.hips_pos.x, f.hips_pos.y, f.hips_pos.z)
    } else if f.wrote && f.figure != null && !figure.put_back(f.figure as *Figure, hips) {
        // Moved since by another (locomotion's lean, lift and foot hold),
        // and the hips' place not put back by the figure this frame: this
        // one's own drop taken off, the other's move kept (#673). Left on, the
        // drop was added to itself frame on frame while the figure stood in
        // its Idle, and a standing walker's feet went under the ground.
        core.model_set_position(hips, hips.position.x - (f.wrote_pos.x - f.hips_pos.x),
                                hips.position.y - (f.wrote_pos.y - f.hips_pos.y),
                                hips.position.z - (f.wrote_pos.z - f.hips_pos.z))
    }
    f.wrote = false
}

// `m`'s turn, `before` it was solved to `wrote`, taken off it unless the
// figure put the turn back itself. Taken off on the node's side: the
// figure puts its own turns on, and takes them off, on the other, so what
// it did since stays whole.
take_turn_off(fig: *Figure, m: *Model, wrote: Quat, before: Quat) {
    if figure.turn_put_back(fig, m) { return }
    core.model_set_rotation(m, core.quat_normalize(core.quat_mul(core.quat_mul(m.rotation, core.quat_conjugate(wrote)), before)))
}

same_q(a: Quat, b: Quat) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w }
