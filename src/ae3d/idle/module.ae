// ae3d.idle -- a standing figure's breath and its weight shifting (#592,
// part of #509), added over whatever its clip poses, every frame in the
// engine's pose phase after the clips.
//
//   d = idle.attach(e, figure_root, hips, chest, forward)   // forward: the way the figure faces, in its root's frame
//   idle.set_speed(d, speed)                                 // every frame: moving, it fades out
//
// The breath pitches the chest back BREATH_PITCH at the top of each
// breath, every BREATH_SECONDS or so: the pace drifts BREATH_DRIFT either
// way over a slower cycle, so the breath never repeats as a loop does. The
// weight shifts from one foot to the other, the hips swaying WEIGHT_SHIFT
// metres across, over WEIGHT_SECONDS -- a period that never falls in step
// with the breath's. Moving, both fade out by the speed, gone at
// STILL_BELOW. The bones it moves are put back to their own pose before
// each frame's, so a still pose is not moved further frame on frame.
import std.heap
import ae3d.core
import ae3d.engine
import ae3d.ik

exports (
    Idle, BREATH_SECONDS, BREATH_PITCH, WEIGHT_SECONDS, WEIGHT_SHIFT, STILL_BELOW,
    attach, idle_free, set_weight, set_speed, solve, breath, sway
)

extern cos(x: float) -> float
extern sin(x: float) -> float

const BREATH_SECONDS = 4.2
const BREATH_PITCH = 0.035           // radians (2 degrees)
const BREATH_DRIFT = 0.15            // of the pace, either way
const DRIFT_SECONDS = 23.0
const WEIGHT_SECONDS = 7.3
const WEIGHT_SHIFT = 0.025           // metres
const STILL_BELOW = 0.4              // metres a second: moving faster, no idle
const TAU = 6.283185307179586

struct Idle {
    engine: ptr                      // *Engine, or null when solved by hand
    behaviour: ptr
    root: ptr                        // *Model
    hips: ptr                        // *Model
    chest: ptr                       // *Model
    forward: Vec3                    // the way the figure faces, in its root's frame
    weight: float
    speed: float
    time: float
    breath_phase: float              // 0 to 1 over a breath
    breath: float                    // the chest's pitch now, radians
    sway: float                      // the hips' shift now, metres
    // The bones' own pose, and what was written over it.
    hips_pos: Vec3
    chest_rot: Quat
    hips_wrote: Vec3
    chest_wrote: Quat
    wrote: bool
}

attach(e: *Engine, root: *Model, hips: *Model, chest: *Model, forward: Vec3) -> *Idle {
    if root == null || hips == null || chest == null { return null }
    d = heap.new(Idle)
    d.engine = e as ptr
    d.root = root as ptr
    d.hips = hips as ptr
    d.chest = chest as ptr
    d.forward = core.v3_normalize(forward)
    d.weight = 1.0
    if e != null {
        b = engine.behaviour_new("idle", d as ptr)
        b.pose = on_pose
        engine.engine_add_behaviour(e, b)
        d.behaviour = b as ptr
    }
    return d
}

idle_free(d: *Idle) {
    if d == null { return }
    e = d.engine as *Engine
    if e != null && d.behaviour != null {
        engine.engine_remove_behaviour(e, d.behaviour as *Behaviour)
        heap.free(d.behaviour as *Behaviour)
        d.behaviour = null
    }
    heap.free(d)
}

set_weight(d: *Idle, w: float) {
    x = w
    if x < 0.0 { x = 0.0 }
    if x > 1.0 { x = 1.0 }
    d.weight = x
}

set_speed(d: *Idle, speed: float) { d.speed = speed }

// The chest's pitch and the hips' shift drawn now.
breath(d: *Idle) -> float { return d.breath }
sway(d: *Idle) -> float { return d.sway }

on_pose(state: ptr, e: *Engine) {
    solve(state as *Idle, engine.engine_delta_time(e))
}

same_v(a: Vec3, b: Vec3) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z }
same_q(a: Quat, b: Quat) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w }

// A frame: the bones back to their clip's pose, the breath and the sway
// moved on, and laid over the clip as far as the weight and the speed let.
solve(d: *Idle, delta: float) {
    hips = d.hips as *Model
    chest = d.chest as *Model
    root = d.root as *Model
    if d.wrote && same_v(hips.position, d.hips_wrote) && same_q(chest.rotation, d.chest_wrote) {
        core.model_set_position(hips, d.hips_pos.x, d.hips_pos.y, d.hips_pos.z)
        core.model_set_rotation(chest, d.chest_rot)
    }
    d.hips_pos = hips.position
    d.chest_rot = chest.rotation
    d.time = d.time + delta
    // The breath's pace drifts, so no two breaths are alike.
    pace = 1.0 + BREATH_DRIFT * sin(TAU * d.time / DRIFT_SECONDS)
    d.breath_phase = d.breath_phase + delta * pace / BREATH_SECONDS
    while d.breath_phase >= 1.0 { d.breath_phase = d.breath_phase - 1.0 }
    still = 1.0 - d.speed / STILL_BELOW
    if still < 0.0 { still = 0.0 }
    if still > 1.0 { still = 1.0 }
    w = d.weight * still
    d.breath = BREATH_PITCH * (0.5 - 0.5 * cos(TAU * d.breath_phase)) * w
    d.sway = WEIGHT_SHIFT * sin(TAU * d.time / WEIGHT_SECONDS) * w
    if w <= 0.0 {
        d.wrote = false
        return
    }
    core.model_sync_transform(root)
    up = core.quat_apply(root.world_rotation, core.vec3(0.0, 1.0, 0.0))
    ahead = core.quat_apply(root.world_rotation, d.forward)
    across = core.v3_normalize(core.v3_cross(up, ahead))
    // The hips across, in their parent's frame.
    core.model_sync_transform(hips)
    world = core.v3_add(hips.world_position, core.v3_mul(across, d.sway))
    parent = core.model_parent(hips)
    if parent == null {
        core.model_set_position(hips, world.x, world.y, world.z)
    } else {
        core.model_sync_transform(parent)
        local = core.mat4_transform_point(core.mat4_inverse(parent.model_matrix), world)
        core.model_set_position(hips, local.x, local.y, local.z)
    }
    // The chest back with the breath (looking up is a turn back about the
    // way across).
    ik.turn_world(chest, core.quat_rotate(0.0 - d.breath, across))
    d.hips_wrote = hips.position
    d.chest_wrote = chest.rotation
    d.wrote = true
}
