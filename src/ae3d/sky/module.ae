// The sun by the hour, and the sky it makes.
//
// A painted sky is one time of day for good, and a scene's light has to be
// set to agree with it by hand. This is the other way round: the hour says
// where the sun is, and the sun says what colour it is, how strong, and what
// the sky looks like -- the skybox shader draws it from the same sun, the
// scene is lit by that sky (#655), and the water reflects it. Both renderers
// read the same numbers, so a scene at half past five looks the same on each.
//
// The model is a day at a temperate latitude: the sun rises in the east at
// six, stands high in the south at noon and sets in the west at six, and the
// night has a moon's worth of light so nothing is black. By day the sun and
// the sky are a clear day's (core.sun_light; Preetham's sky, as the shader
// draws it); the dusk's and the night's colours are what a clear sky does as
// the sun goes down, not a measurement of one.
import ae3d.core

extern exp(x: float) -> float
extern cos(x: float) -> float
extern acos(x: float) -> float
extern tan(x: float) -> float

exports (
    sun_direction, sun_color, sun_intensity, dayness, day_share, daylight,
    zenith_color, horizon_color, hour_name
)

const PI = 3.14159265

// Where the sun is, as the direction TOWARD it, for an hour of the day
// (0 to 24, fractional). East is +x, up is +y, south is -z; the arc leans
// south the way a northern sky's does, so noon is not straight overhead.
sun_direction(hours: float) -> Vec3 {
    t = (wrap(hours) - 6.0) / 12.0 * PI
    x = core.cos_of(t)
    y = core.sin_of(t) * 0.92
    z = 0.0 - 0.40
    return core.v3_normalize(core.vec3(x, y, z))
}

// How much of a day it is: one in full daylight, zero at night, with the
// twilight between as the sun crosses the horizon.
dayness(hours: float) -> float {
    elevation = sun_direction(hours).y
    return smooth(0.0 - 0.14, 0.06, elevation)
}

// The sun's colour: white high up, gold and then red as it nears the
// horizon, and the moon's blue-grey once it is under.
sun_color(hours: float) -> Vec3 {
    elevation = sun_direction(hours).y
    low = smooth(0.35, 0.0 - 0.05, elevation)   // 1 at the horizon, 0 high up
    day = core.vec3(1.0, 0.96, 0.90)
    setting = core.vec3(1.0, 0.58, 0.28)
    lit = core.v3_lerp(day, setting, low * low)
    // The moon's, once the sun is well under, and not before: the setting
    // sun is orange to the last.
    moon = core.vec3(0.55, 0.65, 0.95)
    under = smooth(0.0, 0.0 - 0.12, elevation)
    return core.v3_lerp(lit, moon, under)
}

// The moon's light, a game's and not a measurement's: a moonlit night
// lit enough to be seen.
const MOON = 0.05

// How strong the sun is, in the units a light takes: a clear day's sun at
// its height (core.sun_light), and the moon's once it is under.
sun_intensity(hours: float) -> float {
    elevation = sun_direction(hours).y
    return core.sun_light(elevation, core.SKY_TURBIDITY) + MOON * (1.0 - dayness(hours))
}

// The share of the sky that is the daylight model's, as the shader blends
// it: all of it once the sun is a quarter up, none at the horizon.
day_share(hours: float) -> float {
    return smooth(0.0, 0.25, sun_direction(hours).y)
}

// The sky straight up and at the horizon as they show, for whatever mirrors
// the sky without drawing it -- the water when it has no image to reflect,
// the fog that fades into the horizon.
zenith_color(hours: float) -> Vec3 {
    day = shown(daylight(core.vec3(0.0, 1.0, 0.0), sun_direction(hours), core.SKY_TURBIDITY))
    dusk_day = core.vec3(0.16, 0.20, 0.45)
    night = core.vec3(0.02, 0.03, 0.08)
    dusk = core.v3_lerp(night, dusk_day, dayness(hours))
    return core.v3_lerp(dusk, day, day_share(hours))
}

horizon_color(hours: float) -> Vec3 {
    sun = sun_direction(hours)
    elevation = sun.y
    low = smooth(0.35, 0.0 - 0.05, elevation)
    // Across from the sun's azimuth: the horizon neither toward it nor away.
    across = core.v3_normalize(core.vec3(0.0 - sun.z, 0.0, sun.x))
    day = shown(daylight(across, sun, core.SKY_TURBIDITY))
    dusk_light = core.vec3(1.0, 0.52, 0.22)
    night = core.vec3(0.06, 0.07, 0.13)
    lit = core.v3_lerp(core.vec3(0.72, 0.82, 0.93), dusk_light, low * 0.6)
    dusk = core.v3_lerp(night, lit, dayness(hours))
    return core.v3_lerp(dusk, day, day_share(hours))
}

shown(c: Vec3) -> Vec3 {
    return core.vec3(core.displayed_of(c.x), core.displayed_of(c.y), core.displayed_of(c.z))
}

// The Perez distribution.
perez(cos_theta: float, gamma: float, a: float, b: float, c: float, d: float, e: float) -> float {
    ct = cos_theta
    if ct < 0.01 { ct = 0.01 }
    return (1.0 + a * exp(b / ct)) * (1.0 + c * exp(d * gamma) + e * cos(gamma) * cos(gamma))
}

// The daylight sky's light in direction `dir` with the sun toward `sun`, in
// the engine's units: Preetham, Shirley and Smits, as the sky shader draws
// it (shaders.FRAGMENT_SKYBOX's daylight, which this must match).
daylight(dir: Vec3, sun: Vec3, t: float) -> Vec3 {
    if sun.y <= 0.0 { return core.vec3(0.0, 0.0, 0.0) }
    theta_s = acos(core.clampf(sun.y, 0.0, 1.0))
    d = dir
    below = 1.0
    if d.y < 0.0 {
        below = core.lerpf(1.0, 0.6, core.clampf((0.0 - d.y) * 4.0, 0.0, 1.0))
        d = core.v3_normalize(core.vec3(d.x, 0.0, d.z))
    }
    gamma = acos(core.clampf(core.v3_dot(d, sun), 0.0 - 1.0, 1.0))
    chi = (4.0 / 9.0 - t / 120.0) * (PI - 2.0 * theta_s)
    yz = ((4.0453 * t - 4.9710) * tan(chi) - 0.2155 * t + 2.4192) * 1000.0
    t1 = theta_s
    t2 = theta_s * theta_s
    t3 = t2 * theta_s
    xz = t * t * (0.00166 * t3 - 0.00375 * t2 + 0.00209 * t1) +
         t * (0.0 - 0.02903 * t3 + 0.06377 * t2 - 0.03202 * t1 + 0.00394) +
         (0.11693 * t3 - 0.21196 * t2 + 0.06052 * t1 + 0.25886)
    yz_c = t * t * (0.00275 * t3 - 0.00610 * t2 + 0.00317 * t1) +
           t * (0.0 - 0.04214 * t3 + 0.08970 * t2 - 0.04153 * t1 + 0.00516) +
           (0.15346 * t3 - 0.26756 * t2 + 0.06670 * t1 + 0.26688)
    ya = 0.1787 * t - 1.4630
    yb = 0.0 - 0.3554 * t + 0.4275
    yc = 0.0 - 0.0227 * t + 5.3251
    yd = 0.1206 * t - 2.5771
    ye = 0.0 - 0.0670 * t + 0.3703
    xa = 0.0 - 0.0193 * t - 0.2592
    xb = 0.0 - 0.0665 * t + 0.0008
    xc = 0.0 - 0.0004 * t + 0.2125
    xd = 0.0 - 0.0641 * t - 0.8989
    xe = 0.0 - 0.0033 * t + 0.0452
    ca = 0.0 - 0.0167 * t - 0.2608
    cb = 0.0 - 0.0950 * t + 0.0092
    cc = 0.0 - 0.0079 * t + 0.2102
    cd = 0.0 - 0.0441 * t - 1.6537
    ce = 0.0 - 0.0109 * t + 0.0529
    lum = yz * perez(d.y, gamma, ya, yb, yc, yd, ye) / perez(1.0, theta_s, ya, yb, yc, yd, ye)
    x = xz * perez(d.y, gamma, xa, xb, xc, xd, xe) / perez(1.0, theta_s, xa, xb, xc, xd, xe)
    y = yz_c * perez(d.y, gamma, ca, cb, cc, cd, ce) / perez(1.0, theta_s, ca, cb, cc, cd, ce)
    cx = x / y * lum
    cz = (1.0 - x - y) / y * lum
    r = 3.2406 * cx - 1.5372 * lum - 0.4986 * cz
    g = 0.0 - 0.9689 * cx + 1.8758 * lum + 0.0415 * cz
    b = 0.0557 * cx - 0.2040 * lum + 1.0570 * cz
    if r < 0.0 { r = 0.0 }
    if g < 0.0 { g = 0.0 }
    if b < 0.0 { b = 0.0 }
    scale = core.SKY_PHOTOMETRIC * below
    return core.vec3(r * scale, g * scale, b * scale)
}

// "17:30", for a console or a title.
hour_name(hours: float) -> string {
    h = wrap(hours)
    whole = h as int
    minutes = ((h - (whole as float)) * 60.0 + 0.5) as int
    if minutes >= 60 { minutes = 59 }
    text = "${whole}:"
    if minutes < 10 { text = "${text}0" }
    return "${text}${minutes}"
}

wrap(hours: float) -> float {
    h = hours
    while h < 0.0 { h = h + 24.0 }
    while h >= 24.0 { h = h - 24.0 }
    return h
}

// A smooth step from `edge0` to `edge1`, in either order.
smooth(edge0: float, edge1: float, x: float) -> float {
    t = (x - edge0) / (edge1 - edge0)
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    return t * t * (3.0 - 2.0 * t)
}
