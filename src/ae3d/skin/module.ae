// Skinned meshes: one mesh, many bones, and the vertices that hang off them.
//
// A rigid figure is a model per part, each with its own transform. It holds
// together as long as the parts are boxes and comes apart the moment they are
// not: two limbs meeting at a shoulder are two surfaces sliding through each
// other, and no amount of modelling closes that seam. A skinned figure is one
// surface, and the joints are inside it.
//
// The bones here are ordinary models. Nothing about them is special -- they
// have a position, a rotation, a scale and a parent, and they compose through
// the same hierarchy every other model does. That is the whole point: a clip
// exported from Blender drives a bone exactly as it drives a part, and ae3d.ik
// solves a limb of bones exactly as it solves a limb of parts. A skeleton adds
// one thing to a chain of models, which is where each of them was when the mesh
// was bound to it.
//
// The palette a draw is posed by is that difference, per bone: where the bone
// is now, times the inverse of where it was bound. A mesh in its bind pose
// therefore comes out of a skinned draw exactly where it went in, which is the
// property that makes a wrong weight visible rather than plausible.

import std.list
import std.heap
import ae3d.core

exports (
    Skeleton, Bone, skeleton_new, skeleton_free, skeleton_add, skeleton_bind,
    skeleton_count, skeleton_bone, skeleton_find, skeleton_palette,
    skeleton_fit, skeleton_reach, skeleton_set_inverse_bind, skeleton_settle,
    skeleton_update, skeleton_update_shifted, skeleton_bind_position, skeleton_strike_bind,
    skeleton_add_mesh, skeleton_set_space, skeleton_mesh_count, skeleton_mesh, skeleton_bone_extreme, Extreme, MAX_BONES
)

// The vertex shader declares an array this long. Ninety-six matrices are six
// kilobytes of the sixteen GL 3.3 guarantees a vertex stage, so a figure that
// fits here fits on a software rasteriser too; a Mixamo rig with its fingers
// is sixty-five bones, which forty-eight did not hold.
const MAX_BONES = 96

struct Bone {
    // Borrowed. A skeleton names bones, it does not own them, because these are
    // the same models the clips and the solver drive.
    model: ptr
    // Where this bone was when the mesh was bound to it, inverted.
    inverse_bind: Mat4
    // What the model's world transform was when this bone's palette entry was
    // last written. A bone that has not moved is not recomputed.
    stamp: int
}

struct Skeleton {
    bones: ptr
    palette: ptr
    // How far the bones spread from their own middle when the mesh was bound
    // to them. Subtracted from the mesh's bind radius, what is left is the
    // thickness of the surface, which is the part a pose does not change.
    bind_spread: float
    // The meshes skinned to these bones (list of mesh handles), borrowed:
    // what a fit to the figure's flesh, not only its joints, reads.
    meshes: ptr
    // The model whose space the inverse binds are taken in -- a glTF
    // skin's, the node that carries the skinned mesh -- borrowed; null
    // for the world, as skeleton_bind takes them.
    space: ptr
}

skeleton_new() -> *Skeleton {
    s = heap.new(Skeleton)
    s.bones = list.new()
    s.palette = null
    s.meshes = list.new()
    s.space = null
    return s
}

skeleton_free(s: *Skeleton) {
    if s == null { return }
    if s.bones != null {
        i = 0
        count = list.size(s.bones)
        while i < count {
            b = list.get_raw(s.bones, i) as *Bone
            if b != null { heap.free(b) }
            i = i + 1
        }
        list.free(s.bones)
    }
    if s.palette != null { core.palette_destroy(s.palette) }
    if s.meshes != null { list.free(s.meshes) }
    heap.free(s)
}

// Add a bone, and answer the index the mesh weights against. Refuses past the
// limit rather than writing off the end of the palette.
skeleton_add(s: *Skeleton, bone: *Model) -> int {
    if s == null || bone == null { return 0 - 1 }
    if list.size(s.bones) >= MAX_BONES { return 0 - 1 }
    index = list.size(s.bones)
    b = heap.new(Bone)
    b.model = bone as ptr
    b.inverse_bind = core.mat4_ident()
    b.stamp = 0 - 1
    list.add_raw(s.bones, b as ptr)
    return index
}

// The pose the bones are in now is the pose the mesh was modelled in. Called
// once, after the bones are placed and before anything animates them.
skeleton_bind(s: *Skeleton) {
    if s == null { return }
    count = list.size(s.bones)
    i = 0
    while i < count {
        b = list.get_raw(s.bones, i) as *Bone
        if b != null && b.model != null {
            bone = b.model as *Model
            core.model_sync_transform(bone)
            b.inverse_bind = core.mat4_inverse(bone.model_matrix)
            b.stamp = 0 - 1
        }
        i = i + 1
    }
    skeleton_update(s)
    centre = core.vec3(0.0, 0.0, 0.0)
    s.bind_spread = skeleton_reach(s, &centre)
}

// The inverse bind matrix a file gives for a bone, where the mesh was not
// bound in the pose the bones happen to be in now: glTF carries them
// explicitly. Set for every bone, then skeleton_settle instead of
// skeleton_bind.
skeleton_set_inverse_bind(s: *Skeleton, index: int, inverse: Mat4) {
    if s == null || index < 0 || index >= list.size(s.bones) { return }
    b = list.get_raw(s.bones, index) as *Bone
    b.inverse_bind = inverse
    b.stamp = 0 - 1
}

// What skeleton_bind does after it has the inverse binds: the first
// palette, and the bind spread the fit reads.
skeleton_settle(s: *Skeleton) {
    if s == null { return }
    skeleton_update(s)
    centre = core.vec3(0.0, 0.0, 0.0)
    s.bind_spread = skeleton_reach(s, &centre)
}

skeleton_count(s: *Skeleton) -> int {
    if s == null { return 0 }
    return list.size(s.bones)
}

skeleton_bone(s: *Skeleton, index: int) -> *Model {
    if s == null || index < 0 || index >= list.size(s.bones) { return null }
    b = list.get_raw(s.bones, index) as *Bone
    if b == null { return null }
    return b.model as *Model
}

skeleton_find(s: *Skeleton, name: string) -> int {
    if s == null { return 0 - 1 }
    count = list.size(s.bones)
    i = 0
    while i < count {
        bone = skeleton_bone(s, i)
        if bone != null {
            if core.text(bone.name) == name { return i }
        }
        i = i + 1
    }
    return 0 - 1
}

// Rebuild the matrices a draw reads, for the bones that moved. A skeleton
// standing still writes nothing: the stamp a model bumps when its world
// transform is rebuilt is what says whether it did.
skeleton_update(s: *Skeleton) {
    if s == null { return }
    count = list.size(s.bones)
    if count == 0 { return }
    if s.palette == null { s.palette = core.palette_create(count) }
    i = 0
    while i < count {
        b = list.get_raw(s.bones, i) as *Bone
        if b != null && b.model != null {
            bone = b.model as *Model
            core.model_sync_transform(bone)
            if b.stamp != bone.world_stamp {
                posed = core.mat4_mul(bone.model_matrix, b.inverse_bind)
                core.palette_set(s.palette, i, &posed)
                b.stamp = bone.world_stamp
            }
        }
        i = i + 1
    }
}

// The palette with the figure's travel taken out: every entry rebuilt with
// `offset` subtracted from where the bone stands, so the pose is struck in
// place. A clip that walks the figure up the street carries that walk in its
// root bone, and a crowd baked from such a clip would carry it too -- every
// instance drifting off its own simulated position through the clip and
// snapping back at the loop, which reads as teleporting. The crowd moves the
// instance; the pose must not. Every entry, stamps or not, because the shift
// changes bones that did not move; and the stamps are cleared after, so a
// plain update returns the palette to the true pose.
skeleton_update_shifted(s: *Skeleton, offset: Vec3) {
    if s == null { return }
    count = list.size(s.bones)
    if count == 0 { return }
    if s.palette == null { s.palette = core.palette_create(count) }
    i = 0
    while i < count {
        b = list.get_raw(s.bones, i) as *Bone
        if b != null && b.model != null {
            bone = b.model as *Model
            core.model_sync_transform(bone)
            posed = core.mat4_mul(bone.model_matrix, b.inverse_bind)
            posed.m12 = posed.m12 - offset.x
            posed.m13 = posed.m13 - offset.y
            posed.m14 = posed.m14 - offset.z
            core.palette_set(s.palette, i, &posed)
            b.stamp = 0 - 1
        }
        i = i + 1
    }
}

// Every bone put back where the mesh was bound to it: its world transform
// its inverse bind matrix inverted, in the skeleton's space (a figure a
// game object turned stays turned), its local one that over its parent's
// -- the parent's bind transform when the parent is a bone of this
// skeleton, its transform as it stands when it is not (the armature). A
// file's nodes need not stand in the bind pose: a glTF exported from
// Blender carries the pose the scene was saved in, a stride, a turned
// body. What a rig is measured by -- a ragdoll fitted to it (#539) -- is
// the pose its mesh was modelled in, and this is that pose. The joint
// list's order does not matter: no bone's transform is read back from a
// bone this has already moved.
skeleton_strike_bind(s: *Skeleton) {
    if s == null { return }
    count = list.size(s.bones)
    i = 0
    while i < count {
        b = list.get_raw(s.bones, i) as *Bone
        if b != null && b.model != null {
            bone = b.model as *Model
            world = bind_matrix_of(s, bone)
            parent = core.model_parent(bone)
            local = world
            if parent != null {
                local = core.mat4_mul(core.mat4_inverse(bind_matrix_of(s, parent)), world)
            }
            c0 = core.vec3(local.m0, local.m1, local.m2)
            c1 = core.vec3(local.m4, local.m5, local.m6)
            c2 = core.vec3(local.m8, local.m9, local.m10)
            sx = core.v3_len(c0)
            sy = core.v3_len(c1)
            sz = core.v3_len(c2)
            core.model_set_position(bone, local.m12, local.m13, local.m14)
            core.model_set_scale(bone, sx, sy, sz)
            core.model_set_rotation(bone, core.quat_from_axes(core.v3_mul(c0, 1.0 / sx), core.v3_mul(c1, 1.0 / sy), core.v3_mul(c2, 1.0 / sz)))
        }
        i = i + 1
    }
    i = 0
    while i < count {
        bone = skeleton_bone(s, i)
        if bone != null { core.model_sync_transform(bone) }
        i = i + 1
    }
}

// A model's world transform in the bind pose: its inverse bind inverted,
// in the skeleton's space, if it is one of the skeleton's bones; its
// transform as it stands if not.
bind_matrix_of(s: *Skeleton, m: *Model) -> Mat4 {
    count = list.size(s.bones)
    i = 0
    while i < count {
        b = list.get_raw(s.bones, i) as *Bone
        if b != null && b.model == m as ptr {
            bind = core.mat4_inverse(b.inverse_bind)
            if s.space == null { return bind }
            space = s.space as *Model
            core.model_sync_transform(space)
            return core.mat4_mul(space.model_matrix, bind)
        }
        i = i + 1
    }
    core.model_sync_transform(m)
    return m.model_matrix
}

// The model whose space the inverse binds are in: a glTF skin's are in
// the space of the node that carries the skinned mesh.
skeleton_set_space(s: *Skeleton, space: *Model) {
    if s != null { s.space = space as ptr }
}

// A mesh skinned to this skeleton, its joint indices counting in the
// skeleton's bone order. Borrowed: the mesh stays its model's. Each once.
skeleton_add_mesh(s: *Skeleton, mesh: ptr) {
    if s == null || mesh == null { return }
    n = list.size(s.meshes)
    i = 0
    while i < n {
        if list.get_raw(s.meshes, i) == mesh { return }
        i = i + 1
    }
    list.add_raw(s.meshes, mesh)
}

skeleton_mesh_count(s: *Skeleton) -> int {
    if s == null { return 0 }
    return list.size(s.meshes)
}

skeleton_mesh(s: *Skeleton, index: int) -> ptr {
    if s == null || index < 0 || index >= list.size(s.meshes) { return null }
    return list.get_raw(s.meshes, index)
}

// The farthest point along `direction` of the flesh bone `index` carries
// -- the vertices of the skeleton's meshes weighted more than half to it
// -- posed where the bone stands now. A foot's sole is its lowest point,
// its toe its farthest forward. Not found when the bone carries none.
struct Extreme {
    at: Vec3
    found: bool
}

skeleton_bone_extreme(s: *Skeleton, index: int, direction: Vec3) -> Extreme {
    best = Extreme { at: core.vec3(0.0, 0.0, 0.0), found: false }
    if s == null || index < 0 || index >= list.size(s.bones) { return best }
    b = list.get_raw(s.bones, index) as *Bone
    bone = b.model as *Model
    core.model_sync_transform(bone)
    posed = core.mat4_mul(bone.model_matrix, b.inverse_bind)
    best_along = 0.0
    m = 0
    while m < list.size(s.meshes) {
        mesh = list.get_raw(s.meshes, m)
        count = core.mesh_vertex_count(mesh)
        v = 0
        while v < count {
            slot = 0
            while slot < 4 {
                if core.mesh_skin_joint(mesh, v, slot) == index && core.mesh_skin_weight(mesh, v, slot) > 0.5 {
                    p = core.mat4_transform_point(posed, core.mesh_position(mesh, v))
                    along = core.v3_dot(p, direction)
                    if !best.found || along > best_along {
                        best.at = p
                        best.found = true
                        best_along = along
                    }
                    break
                }
                slot = slot + 1
            }
            v = v + 1
        }
        m = m + 1
    }
    return best
}

// Where a bone stood when the mesh was bound to it.
skeleton_bind_position(s: *Skeleton, index: int) -> Vec3 {
    if s == null || index < 0 || index >= list.size(s.bones) { return core.vec3(0.0, 0.0, 0.0) }
    b = list.get_raw(s.bones, index) as *Bone
    if b == null { return core.vec3(0.0, 0.0, 0.0) }
    bind = core.mat4_inverse(b.inverse_bind)
    return core.vec3(bind.m12, bind.m13, bind.m14)
}

skeleton_palette(s: *Skeleton) -> ptr {
    if s == null { return null }
    return s.palette
}

// The middle of the bones and how far they reach from it, as they are now.
skeleton_reach(s: *Skeleton, centre: *Vec3) -> float {
    count = list.size(s.bones)
    middle = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < count {
        bone = skeleton_bone(s, i)
        if bone != null {
            core.model_sync_transform(bone)
            middle = core.v3_add(middle, core.model_world_position(bone))
        }
        i = i + 1
    }
    middle = core.v3_mul(middle, 1.0 / (count * 1.0))
    reach = 0.0
    i = 0
    while i < count {
        bone = skeleton_bone(s, i)
        if bone != null {
            away = core.v3_distance(middle, core.model_world_position(bone))
            if away > reach { reach = away }
        }
        i = i + 1
    }
    centre.x = middle.x
    centre.y = middle.y
    centre.z = middle.z
    return reach
}

// Where a skinned model actually is.
//
// A skinned mesh is written in its bind pose and stays there: its vertices do
// not move, its bones do, and the shader puts the two together. So the model's
// own bounds describe a figure standing at the origin however far up the
// street it has walked -- which culls it when it is on screen, keeps it when it
// is not, and answers the wrong rectangle to anything that asks where it
// landed. This is the bounds it should have had, and it is the skeleton that
// knows them.
skeleton_fit(s: *Skeleton, m: *Model) {
    if s == null || m == null || list.size(s.bones) == 0 { return }
    skeleton_update(s)
    centre = core.vec3(0.0, 0.0, 0.0)
    reach = skeleton_reach(s, &centre)
    thickness = m.skin_reach - s.bind_spread
    if thickness < 0.0 { thickness = 0.0 }
    m.bounding_center = centre
    m.bounding_radius = reach + thickness
}
