// Visemes from a voice track (#910): the mouth shapes a recorded line is
// spoken with, found in its sound, as Rhubarb Lip Sync and Oculus's offline
// lip sync do it, played onto a face's curves by the animator
// (animator.speak).
//
//   track = visemes.analyse(samples, frames, 48000)   // mono f32 PCM
//   animator.speak(a, track, 0.0)                    // with the sound's play
//
// The sound is read a frame every 10 ms through a 30 ms window: its
// loudness, and, where it is voiced, its first two formants -- the
// resonances of the mouth that make one vowel another -- from a linear
// prediction of the frame (autocorrelation, Levinson-Durbin, the
// envelope's first two peaks). A vowel is the nearest of five to its two
// formants in log frequency: the open A, I, U (rounded), E and O, the set
// VRoid's and MetaHuman's ARKit faces are posed with (Peterson and Barney
// 1952 for the formants). Each frame's five weights are the vowels' near-
// ness, times how open the loudness says the mouth is; silence closes it.
// The weights are smoothed forward and back (zero phase), so a shape comes
// as its sound does and not after: the track is the whole line, read
// before it plays, and a mouth that moved only after the sound it made
// would show it (sound leading a face by more than about 45 ms is seen,
// ITU-R BT.1359).
//
// The shapes a face is posed by (drive): VRoid's own vowels (Fcl_MTH_A to
// O), or ARKit's mouth shapes as viseme sets map them (Oculus's to ARKit:
// jawOpen with funnel and pucker for O and U, smile and stretch for I and E).
import std.heap
import std.string
import ae3d.core
import ae3d.face

exports (
    Track, VISEMES, AA, IH, OU, EE, OH, RATE,
    analyse, track_free, frames, duration, weight, sample, loudness, viseme_of, drive, speaker_shift
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern log(x: float) -> float
extern exp(x: float) -> float

const VISEMES = 5
const AA = 0
const IH = 1
const OU = 2
const EE = 3
const OH = 4
// Frames a second.
const RATE = 100.0
const WINDOW = 0.03                // seconds a frame's window
// Below this far under the track's loudest frame a frame is silence (dB),
// and its mouth opens over the next OPEN_DB.
const SILENCE_DB = 30.0
const OPEN_DB = 20.0
// The smoothing's time constant, seconds: forward and back.
const SMOOTH = 0.02

struct Track {
    count: int
    weights: ptr                   // float[count * VISEMES]
    level: ptr                     // float[count]: how open, 0 to 1
    shift: float                   // the voice's log formant shift from the table's (speaker_shift)
}

// The most a voice's formants are taken to stand off the table's, in log
// frequency (0.3: 35% higher or 26% lower).
const SHIFT_MOST = 0.3

// How far this line's voice was found to stand from the table's: its
// formants e^shift times the table's.
speaker_shift(t: *Track) -> float {
    if t == null { return 0.0 }
    return t.shift
}

// The formants each vowel is told by (Hz): F1, F2.
f1_of(v: int) -> float {
    if v == AA { return 750.0 }
    if v == IH { return 300.0 }
    if v == OU { return 350.0 }
    if v == EE { return 480.0 }
    return 500.0
}

f2_of(v: int) -> float {
    if v == AA { return 1200.0 }
    if v == IH { return 2300.0 }
    if v == OU { return 900.0 }
    if v == EE { return 1900.0 }
    return 850.0
}

frames(t: *Track) -> int {
    if t == null { return 0 }
    return t.count
}

duration(t: *Track) -> float { return (frames(t) as float) / RATE }

track_free(t: *Track) {
    if t == null { return }
    free(t.weights)
    free(t.level)
    heap.free(t)
}

// Viseme `v`'s weight at frame `f`.
weight(t: *Track, f: int, v: int) -> float {
    if t == null || f < 0 || f >= t.count || v < 0 || v >= VISEMES { return 0.0 }
    return (t.weights as float[])[f * VISEMES + v]
}

loudness(t: *Track, f: int) -> float {
    if t == null || f < 0 || f >= t.count { return 0.0 }
    return (t.level as float[])[f]
}

// The five weights `at` seconds in, between the two frames around it, into
// `out` (float[VISEMES]); zero before and after the track.
sample(t: *Track, at: float, out: ptr) {
    o = out as float[]
    x = at * RATE
    f0 = x as int
    if x < 0.0 { f0 = 0 - 1 }
    u = x - (f0 as float)
    v = 0
    while v < VISEMES {
        o[v] = weight(t, f0, v) * (1.0 - u) + weight(t, f0 + 1, v) * u
        v = v + 1
    }
}

// The viseme a frame is most, -1 for a frame closer to silent than any.
viseme_of(t: *Track, f: int) -> int {
    best = 0 - 1
    most = 0.1
    v = 0
    while v < VISEMES {
        w = weight(t, f, v)
        if w > most {
            most = w
            best = v
        }
        v = v + 1
    }
    return best
}

// --- the analysis ---------------------------------------------------------------------------------

analyse(samples: ptr, count: int, sample_rate: int) -> *Track {
    t = heap.new(Track)
    if samples == null || count <= 0 || sample_rate <= 0 {
        t.count = 0
        t.weights = calloc(1, 8)
        t.level = calloc(1, 8)
        return t
    }
    // Down to about 11 kHz, where the formants a vowel is told by are
    // (under 4 kHz): averaged in steps, which is the low-pass it needs.
    step = sample_rate / 11025
    if step < 1 { step = 1 }
    rate = (sample_rate as float) / (step as float)
    n = count / step
    x = calloc(n + 1, 8) as float[]
    s = samples as f32[]
    i = 0
    while i < n {
        sum = 0.0
        k = 0
        while k < step {
            sum = sum + (s[i * step + k] as float)
            k = k + 1
        }
        x[i] = sum / (step as float)
        i = i + 1
    }
    t.count = ((n as float) / rate * RATE) as int + 1
    t.weights = calloc(t.count * VISEMES + 1, 8)
    t.level = calloc(t.count + 1, 8)
    raw = calloc(t.count * VISEMES + 1, 8) as float[]
    db = calloc(t.count + 1, 8) as float[]
    order = 2 + (rate / 1000.0) as int
    width = (WINDOW * rate) as int
    frame_x = calloc(width + 1, 8) as float[]
    r = calloc(order + 2, 8) as float[]
    a = calloc(order + 2, 8) as float[]
    loudest = 0.0 - 1000.0
    lf1 = calloc(t.count + 1, 8) as float[]
    lf2 = calloc(t.count + 1, 8) as float[]
    f = 0
    while f < t.count {
        centre = ((f as float) / RATE * rate) as int
        first = centre - width / 2
        energy = 0.0
        k = 0
        while k < width {
            j = first + k
            sv = 0.0
            if j >= 1 && j < n { sv = x[j] - 0.97 * x[j - 1] }
            if j == 0 { sv = x[0] }
            h = 0.54 - 0.46 * core.cos_of(6.2831853 * (k as float) / ((width - 1) as float))
            frame_x[k] = sv * h
            raw_v = 0.0
            if j >= 0 && j < n { raw_v = x[j] }
            energy = energy + raw_v * raw_v
            k = k + 1
        }
        rms = core.sqrt_of(energy / (width as float))
        db[f] = 20.0 * log(rms + 0.0000001) / log(10.0)
        if db[f] > loudest { loudest = db[f] }
        f1, f2 = formants(frame_x, width, order, rate, r, a)
        if f1 > 0.0 && f2 > 0.0 {
            lf1[f] = log(f1)
            lf2[f] = log(f2)
        }
        f = f + 1
    }
    // The speaker (Nearey 1978): a voice's formants all scale with its
    // vocal tract, so the line's mean log formant against the table's is
    // how far this voice's vowels stand from the table's, and every frame
    // is moved back by it before it is told. Held to SHIFT_MOST either
    // way, the span from a large man's tract to a child's.
    shift = 0.0
    voiced = 0
    f = 0
    while f < t.count {
        if lf1[f] != 0.0 && db[f] > loudest - SILENCE_DB + OPEN_DB * 0.5 {
            shift = shift + (lf1[f] + lf2[f]) * 0.5
            voiced = voiced + 1
        }
        f = f + 1
    }
    if voiced > 0 {
        table = 0.0
        v = 0
        while v < VISEMES {
            table = table + (log(f1_of(v)) + log(f2_of(v))) * 0.5
            v = v + 1
        }
        shift = core.clampf(shift / (voiced as float) - table / (VISEMES as float), 0.0 - SHIFT_MOST, SHIFT_MOST)
    }
    t.shift = shift
    f = 0
    while f < t.count {
        if lf1[f] != 0.0 {
            total = 0.0
            v = 0
            while v < VISEMES {
                d1 = (lf1[f] - shift - log(f1_of(v))) / 0.25
                d2 = (lf2[f] - shift - log(f2_of(v))) / 0.2
                w = exp(0.0 - (d1 * d1 + d2 * d2) * 0.5)
                raw[f * VISEMES + v] = w
                total = total + w
                v = v + 1
            }
            if total > 0.0 {
                v = 0
                while v < VISEMES {
                    raw[f * VISEMES + v] = raw[f * VISEMES + v] / total
                    v = v + 1
                }
            }
        }
        f = f + 1
    }
    free(lf1 as ptr)
    free(lf2 as ptr)
    // How open: the loudness over the silence's floor, then the weights
    // smoothed forward and back.
    level = t.level as float[]
    f = 0
    while f < t.count {
        level[f] = core.clampf((db[f] - (loudest - SILENCE_DB)) / OPEN_DB, 0.0, 1.0)
        v = 0
        while v < VISEMES {
            raw[f * VISEMES + v] = raw[f * VISEMES + v] * level[f]
            v = v + 1
        }
        f = f + 1
    }
    keep = exp(0.0 - 1.0 / (RATE * SMOOTH))
    out = t.weights as float[]
    v = 0
    while v < VISEMES {
        held = 0.0
        f = 0
        while f < t.count {
            held = held * keep + raw[f * VISEMES + v] * (1.0 - keep)
            out[f * VISEMES + v] = held
            f = f + 1
        }
        held = 0.0
        f = t.count - 1
        while f >= 0 {
            held = held * keep + out[f * VISEMES + v] * (1.0 - keep)
            out[f * VISEMES + v] = held
            f = f - 1
        }
        v = v + 1
    }
    free(x as ptr)
    free(raw as ptr)
    free(db as ptr)
    free(frame_x as ptr)
    free(r as ptr)
    free(a as ptr)
    return t
}

// A frame's first two formants (Hz), from its linear prediction of `order`
// (`r` and `a` scratch, order + 2 each): the first two peaks of the
// prediction's envelope over 200 Hz, the second at least 250 Hz over the
// first. 0s for a frame with none (silence, noise).
formants(x: float[], n: int, order: int, rate: float, r: float[], a: float[]) -> (float, float) {
    lag = 0
    while lag <= order {
        sum = 0.0
        k = lag
        while k < n {
            sum = sum + x[k] * x[k - lag]
            k = k + 1
        }
        r[lag] = sum
        lag = lag + 1
    }
    if r[0] <= 0.0000000001 { return 0.0, 0.0 }
    // Levinson-Durbin: a[0] = 1, a[1..order].
    k = 0
    while k <= order {
        a[k] = 0.0
        k = k + 1
    }
    a[0] = 1.0
    err = r[0]
    i = 1
    while i <= order {
        acc = r[i]
        j = 1
        while j < i {
            acc = acc + a[j] * r[i - j]
            j = j + 1
        }
        refl = 0.0 - acc / err
        // a[j] += refl * a[i - j], both halves at once.
        j = 1
        while j <= i / 2 {
            lo = a[j]
            hi = a[i - j]
            a[j] = lo + refl * hi
            if j != i - j { a[i - j] = hi + refl * lo }
            j = j + 1
        }
        a[i] = refl
        err = err * (1.0 - refl * refl)
        if err <= 0.0 { return 0.0, 0.0 }
        i = i + 1
    }
    // The envelope 1 / |A(e^jw)|^2 from 100 to 3500 Hz, every 10 Hz.
    f1 = 0.0
    f2 = 0.0
    before2 = 0.0
    before1 = 0.0
    freq = 100.0
    while freq <= 3500.0 && f2 == 0.0 {
        w = 6.2831853 * freq / rate
        re = 0.0
        im = 0.0
        k = 0
        while k <= order {
            re = re + a[k] * core.cos_of(w * (k as float))
            im = im - a[k] * core.sin_of(w * (k as float))
            k = k + 1
        }
        p = 1.0 / (re * re + im * im + 0.000000000001)
        // A peak at the frequency before this one.
        if before1 > before2 && before1 > p && freq - 10.0 > 200.0 {
            peak = freq - 10.0
            if f1 == 0.0 {
                f1 = peak
            } else if peak > f1 + 250.0 {
                f2 = peak
            }
        }
        before2 = before1
        before1 = p
        freq = freq + 10.0
    }
    return f1, f2
}

// --- onto a face ----------------------------------------------------------------------------------

// How much each of the five visemes drives the face's target named `name`,
// into `out` (float[VISEMES]): VRoid's own vowels whole, ARKit's mouth
// shapes as the common viseme-to-ARKit tables blend them; all zero for a
// target speech does not pose. Whether any is not zero.
drive(name: string, out: ptr) -> bool {
    o = out as float[]
    v = 0
    while v < VISEMES {
        o[v] = 0.0
        v = v + 1
    }
    vowel = vroid_vowel(name)
    if vowel >= 0 {
        o[vowel] = 1.0
        return true
    }
    slot = face.shape_of(name)
    if slot == face.JAW_OPEN {
        o[AA] = 0.7
        o[IH] = 0.2
        o[OU] = 0.15
        o[EE] = 0.35
        o[OH] = 0.45
        return true
    }
    if slot == 19 {
        // mouthFunnel
        o[OH] = 0.5
        o[OU] = 0.3
        return true
    }
    if slot == 20 {
        // mouthPucker
        o[OU] = 0.8
        o[OH] = 0.3
        return true
    }
    if slot == face.MOUTH_SMILE_LEFT || slot == face.MOUTH_SMILE_RIGHT {
        o[IH] = 0.5
        o[EE] = 0.3
        return true
    }
    if slot == 29 || slot == 30 {
        // mouthStretchLeft and Right
        o[EE] = 0.4
        o[IH] = 0.3
        return true
    }
    return false
}

// VRoid's vowel targets (…Fcl_MTH_A to O), -1 for any other name.
vroid_vowel(name: string) -> int {
    tails = ["Fcl_MTH_A", "Fcl_MTH_I", "Fcl_MTH_U", "Fcl_MTH_E", "Fcl_MTH_O"]
    which = [AA, IH, OU, EE, OH]
    k = 0
    while k < 5 {
        if string_ends(name, tails[k]) { return which[k] }
        k = k + 1
    }
    return 0 - 1
}

string_ends(s: string, tail: string) -> bool { return string.ends_with(s, tail) == 1 }
