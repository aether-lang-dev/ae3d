// ae3d.motion -- natural motion: an active ragdoll (#414).
//
// The motion GTA IV and V get from NaturalMotion's Euphoria: a figure whose
// animation is played by its muscles rather than pasted onto its bones. A
// component on a ragdoll that wears a skinned figure (ae3d.physics's
// ragdoll_dress), in one of three modes:
//
//   ANIMATED  the animation plays and the bodies follow it, position and
//             all, colliding as they go: what is struck is pushed aside,
//             the figure is not;
//   POWERED   the animation is played by muscles: every joint's motor
//             drives it toward the pose the animation gives it, within a
//             torque budget, and nothing holds the figure up but its own
//             feet and a balance the pelvis keeps within a budget of its
//             own. Pushed within them it gives and comes back; past them,
//             it falls, and keeps its shape as it goes;
//   LIMP      a ragdoll, and the animation follows the bodies.
//
// `strength` scales the muscles: the torque every joint's motor may use to
// hold the pose, and the torque the pelvis may use to keep the figure's
// balance (0 is limp, 1 the figure's full strength).
// A `hit` is a blow at a point on a bone: the impulse, and the bone struck
// goes weak -- most of its budget gone, its neighbours' by half -- and
// recovers over `recovery` seconds, so a shoulder shot drops the arm and
// the arm comes back up.
//
// Falling, a POWERED figure protects itself (`set_protective`, on by
// default): when it leans past FALL_TILT it stops fighting for its
// balance, its arms reach down, straight, toward where it is falling and
// its head tucks away from it -- so its hands meet the ground before its
// head does, and its head meets it slower, as a person's does. Landed
// (leaning past LYING_TILT), it lets go and lies.
//
// Down, it gets up (`get_up`, or by itself `set_get_up` seconds after it
// settles): GETTING_UP, a way up matched to how it lies -- face up it sits
// up, draws its feet in and stands over them; face down it pushes up onto
// its hands and knees, brings its feet under it and stands -- ending on
// the animation's own pose, moved to where it stands and turned the way it
// rose, so the animation takes over with nothing to jump. The way up is
// the rig's, keyed through the figure's bodies' frames and drawn exactly;
// the bodies follow it as an ANIMATED figure's do, so it collides as it
// rises. (The reference ragdoll's hips and knees bend too little to sit or
// crouch, so a get-up played by its muscles could not be one.)
// A POWERED figure set ANIMATED blends into the animation over a quarter
// second from where its bodies are, instead of jumping there.
//
// Pushed, a POWERED figure steps to catch itself (`set_stepping`, on by
// default). Its capture point -- where its centre of mass would come to
// rest over a foot, the centre of mass carried on by its velocity times
// sqrt(height / g) -- is watched every step; when it leaves the ground
// between the feet by more than STEP_MARGIN, the foot further from it
// swings to put itself under it: the thigh reaches toward the spot with
// the knee bent, then the leg straightens onto it, over STEP_SECONDS.
// A shove one step does not catch, it staggers from: quicker catch steps
// in a run, each to where the capture point is then, until it stands or,
// leaning past STAGGER_TILT, falls into the protective fall.
//
// Down and hurt, it writhes (`set_writhing`, off by default): for the
// seconds it is given after it lands, its legs draw up together and let
// down and its arms fold over its front toward where it was last struck,
// less and less until it lies still, in whatever pose it landed in (face
// down its arms stay tucked). A limb a blow left weak does not take part: a figure shot in
// the arm clutches with the other. Only a POWERED figure writhes; a LIMP
// one is past it. It settles once it stops, so `set_get_up` counts from
// then.
//
// On a figure (ae3d.figure, #439): `on_figure` gives a figure an active
// ragdoll where it stands and the way it faces, dressed from its skeleton
// by whichever humanoid naming its bones follow (the engine's, or
// Mixamo's). Its clip is the animation the muscles play. The scene file
// carries it as the "motion" record of the figure's group (mode,
// strength, protective, get-up), and `from_record` puts it back.

import std.list
import std.string
import std.heap
import aephysics.human
import aephysics.dynamics
import ae3d.core
import ae3d.behaviour
import ae3d.engine
import ae3d.physics
import ae3d.figure
import ae3d.scene
import ae3d.skin

exports (
    Motion, ANIMATED, POWERED, LIMP, GETTING_UP,
    active_ragdoll, motion_free, set_mode, mode, set_strength, strength, set_recovery,
    hit, bone_weakness, motion_step, attach, tracking_error, tilt, muscle, full_assist,
    set_protective, protective, falling, lying, set_stepping, stepping, steps_taken, staggering,
    set_writhing, writhing, wound,
    PART_HEAD, PART_SPINE, PART_ARM_L, PART_ARM_R, PART_LEG_L, PART_LEG_R, PARTS,
    set_part_mode, part_mode, set_part_strength, part_strength, part_drawing_blend,
    get_up, set_get_up, getting_up, down, face_up, blending, rise_seconds,
    on_skeleton, on_figure, from_record, motions_free, mode_name, mode_of_name, get_up_after,
    release, motions_release
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float
extern sin(x: float) -> float
extern cos(x: float) -> float

const ANIMATED = 1
const POWERED = 2
const LIMP = 3
const GETTING_UP = 4                   // not set, but got to: get_up()

// The torque the pelvis may use to keep the figure's balance at strength 1,
// in newton metres; the joints' own are in `muscle`. Measured on the
// engine's figure (tests/test_motion.ae): at this it stands on its capsule
// feet, comes back from a 60 N s shove to the chest and falls from 400; at
// 600 it could not hold itself upright, at 2500 not even 400 felled it.
const FULL_ASSIST = 1200.0
const WEAK_STRUCK = 0.95              // the budget a struck bone loses, at the most
const WEAK_NEAR = 0.5                 // and the bones joined to it
// A blow takes as much of that as the speed it gives the bone struck, over
// BLOW_FULL_SPEED (#595): a bullet in an arm (8 N s on the 4.9 kg arm,
// 1.6 m/s) all of it, a 5 N s tap on the 18.5 kg pelvis (0.27 m/s) a sixth.
// Every blow took all of it, and a tap on the pelvis left the figure 60 N m
// of its 1200 balance to stand on.
const BLOW_FULL_SPEED = 1.6
// The pelvis's weakness takes PELVIS_ASSIST_SHARE of the balance assist
// with it: a figure struck on the hip staggers, it does not lose its
// sense of balance.
const PELVIS_ASSIST_SHARE = 0.5
// The protective fall's settings, chosen over thirty falls each way
// (tests/test_falls.ae, #479). Leaning 0.35 rad (20 degrees) from its pose,
// a figure is falling (a 60 N s shove leans it less). Its arms reach 0.7
// down to 1 toward the fall. Its trunk bends away from the fall when the
// fall is toward its back -- going over backwards from the start, and in
// a fall forwards or sideways once its pelvis has turned past level --
// CURL at each spine joint, and its head TUCK past where the chest carries
// it: going over backwards that rounds the back and tucks the chin, so the
// head comes down last; face down, it arches the back and lifts the chest
// and head off the ground. And the balance keeps its full torque (times
// FALL_ASSIST) against the fall until the figure is down: let go at the
// first lean, the figure toppled from the hips like a plank.
//
// Swept: a tuck of 0.5 to 1.2, a curl of 0 to 0.5, the assist from none
// to all of it, the reach 0.4 to 1.0 down, the fall's lean 0.25 to 0.45.
// Without the assist no setting held the head off the ground backwards or
// sideways in more than 18 and 22 falls of 30; with it, 29 and 30. (Until
// aephysics#58 the pelvis anchor, capped at nothing, kept applying its last
// impulse through the whole fall: an assist nobody had asked for, which
// every setting before had been chosen on top of.)
const FALL_TILT = 0.35
const REACH_DOWN = 0.7
const TUCK = 0.8
const CURL = 0.5
const FALL_ASSIST = 1.0
const FALL_KNEE = 0.45
// Leaning past LYING_TILT with its pelvis down -- within GROUNDED metres
// of its lowest point -- for SETTLE_STEPS steps, it has landed: the reach
// stops and every joint holds the shape it landed in, the head still
// tucked, on LANDED_MUSCLE of its budget. Its trunk then still -- the
// pelvis and the chest no faster than SETTLED for SETTLE_STEPS steps -- it
// lies. Measured over thirty falls each way (tests/test_falls.ae): still
// reaching once down, the arms pushed it off the ground to fall a second
// time; the shape held at full strength rocked, and its head met the
// ground again in most falls backwards and every one sideways; under a
// fifth of its budget the shape sagged and crept, and at half or more the
// joints chattered against the ground. Two fifths settles the most: at a
// third, a forearm propped up as it landed tipped over for a second and a
// sideways faller lay still only 3.25 s after landing; at two fifths
// every fall backwards and sideways lies still within 1.3 s, and the
// protected head meets the ground backwards at 0.06 m/s against 0.34. (The
// lean alone, steady for a moment, had read a pause in a tumble as a
// landing.)
const LYING_TILT = 1.2
const GROUNDED = 0.25
const SETTLED = 0.3
const SETTLE_STEPS = 10
// A fall that ends on its hands and knees, or sitting, leans less than
// LYING_TILT or keeps its pelvis up: its trunk still for CAUGHT_STEPS, it
// has landed all the same, and holds the shape it was caught in at its
// full strength, its balance kept, as a person on all fours does. Waiting
// to lie flat, 20 of 30 forward fallers knelt to the end still reaching;
// caught and let go to LANDED_MUSCLE, they slumped onto their faces; held
// at full strength with the balance let go, they slumped all the same and
// 9 were still settling 3 s after landing. A third of a second still is
// caught: half a second left one more of them settling. Caught at under
// SETTLED, a kneeling figure can still go over; it then falls again (in
// protect).
const CAUGHT_STEPS = 20
const LANDED_MUSCLE = 0.4
// Stepping: the capture point may leave the ground between the feet by
// STEP_MARGIN metres before a foot moves -- as far as the balance the
// pelvis keeps brings back without a step; a step takes STEP_SECONDS, the
// first STEP_LIFT of them with the knee bent STEP_KNEE radians so the foot
// clears the ground; a step reaches at most STEP_REACH metres from under
// the hip and lands STEP_BEYOND past the capture point, so the figure stops
// over its new support rather than at its edge; another waits STEP_REST.
const STEP_MARGIN = 0.24
const STEP_SECONDS = 0.3
const STEP_LIFT = 0.12
const STEP_KNEE = 0.5
const STEP_REACH = 0.5
const STEP_BEYOND = 0.05
const STEP_REST = 0.1
// A push that carries the capture point further than STEP_FAR strides
// from under the hip is a fall, not a stumble: no step would reach it,
// and a leg swinging as the figure goes over only takes the fall from the
// arms. The protective fall has it. Measured from behind at the chest
// (tests/test_stagger.ae): at a stride and a half the first step waited
// for the capture point to come back in reach, 0.28 s after a 330 N s
// shove, and the figure fell two steps later; at two it steps at once and
// staggers out of shoves up to 360 N s. At three, shoves past what it can
// catch kept it staggering on for seconds instead of falling.
const STEP_FAR = 2.0
// Staggering: once a step has been taken and the capture point is still
// off the feet, the steps come in a run -- each STAGGER_SECONDS long with
// STAGGER_REST between, quicker than the first -- while the capture point
// is within STAGGER_FAR strides, and the protective fall waits until the
// figure leans past STAGGER_TILT (34 degrees) rather than FALL_TILT: a
// figure still catching itself is not yet falling. Waiting to 46 degrees,
// as first tried, the arms came too late in shoves from behind the steps
// could not catch (tests/test_falls.ae). At 29 degrees, with feet that grip
// (aephysics#59), the IK rig's catch of 230 and 240 N s from behind leaned
// just past it: the fall cut the catching step short and it went down,
// where 220 and 250 stood (tests/test_ragdoll_ik_rig.ae); at 34 it stands
// all of 200 to 280, and the falls protect the head as before.
const STAGGER_FAR = 3.0
const STAGGER_MARGIN = 0.08
const STAGGER_SECONDS = 0.22
const STAGGER_REST = 0.03
const STAGGER_TILT = 0.6
// A figure standing still sways; only one moving over the ground at
// STEP_SPEED or faster is falling off its feet. A foot is FOOT_LENGTH long,
// heel under the ankle, toe forward.
const STEP_SPEED = 0.25
const FOOT_LENGTH = 0.2
const GRAVITY = 9.81
// A target is kept LIMIT_MARGIN radians inside its joint's limits: one
// past them only saturates the motor, whose torque, against the limit,
// turns the body instead of the limb.
const LIMIT_MARGIN = 0.05
// Writhing: its limbs move with WRITHE_MUSCLE of their budget (the rest
// keep WRITHE_REST). The legs draw up together and let down
// once every WRITHE_PERIOD seconds, the hips bending forward to WRITHE_HIP
// and the knees back to WRITHE_KNEE radians at the top, less as the
// writhing fades: the knees bent less than the hips lift the feet off the
// ground, where a foot dragged along it pushed the figure away across the
// ground. The arms fold toward the wound: the shoulders forward by
// CLUTCH_SHOULDER and in by CLUTCH_IN, the elbows by CLUTCH_ELBOW, rocking
// by CLUTCH_ROCK over CLUTCH_PERIOD seconds. Every bend is from the limb's
// own rest place under its parent, within the reference ragdoll's joint
// limits (hips 30 degrees, shoulders 45, elbows and knees 35 about their
// rest).
// With the figure at rest (#579), the arms at less than all of their
// muscle could not lift themselves over the chest lying on its back.
const WRITHE_MUSCLE = 1.0
// Writhing, the shape it landed in is let go (held, it holds every joint
// whatever an aim asks), and the limbs not writhing keep WRITHE_REST of
// their budget: a limb not aimed drives toward the rig's standing pose, and
// strong, it pushed the body over. Done, it holds the shape it ends in.
const WRITHE_REST = 0.15
const WRITHE_PERIOD = 1.7
const WRITHE_HIP = 0.6
const WRITHE_KNEE = 0.2
// It writhes in whatever pose it lands in (#480). Face down it once turned
// over onto its back first, pushing with the arm on the higher side, but
// with the figure at rest (#579) the push and the drawn-up leg only braced
// it against the ground, still for the whole of its writhing: the roll
// had come from the trembling. Face down its legs draw up under it and its
// arms stay tucked.
const CLUTCH_SHOULDER = 0.7
const CLUTCH_IN = 0.3
const CLUTCH_ELBOW = 0.6
const CLUTCH_ROCK = 0.12
const CLUTCH_PERIOD = 1.1
const TAU = 6.283185307179586
// Body parts, for a mode and a strength of their own (#573). A part taken
// back from limp is drawn from where it hung to its clip over PART_BLEND,
// eased, as the bodies are drawn to their clip.
const PART_HEAD = 0
const PART_SPINE = 1
const PART_ARM_L = 2
const PART_ARM_R = 3
const PART_LEG_L = 4
const PART_LEG_R = 5
const PARTS = 6
const PART_BLEND = 0.3
const DRAWN_FLOATS = 13

// Getting up: three stages from the pose it lies in, each RISE_STAGE
// seconds, eased in and out; a blend back into the animation, BLEND. On
// the ground is leaning past DOWN_TILT, or the pelvis within DOWN_HEIGHT
// of the figure's lowest point (crumpled where it stood); settled there
// is the pelvis moving less than REST_MOVE a step for SETTLE_STEPS.
const RISE_STAGE = 0.7
const RISE_KEYS = 4
const BLEND = 0.25
const DOWN_TILT = 1.0
const DOWN_HEIGHT = 0.45
const REST_MOVE = 0.002

// The ways up, as the lean of each bone from standing, in degrees, about
// the axis across the figure: for a bone that hangs (a thigh, a shin, an
// arm), positive swings its lower end back; for one that stands (the
// pelvis, the spine, the head), positive leans it forward. In the human's
// bone order: pelvis, spine, chest, head, left thigh, shin, right thigh,
// shin, left arm, forearm, right arm, forearm.
//
// Sitting, face up: the trunk up, the knees drawn up, the hands behind.
// On hands and knees, face down: the trunk along the ground, the thighs
// down, the shins back, the arms straight down. Crouching, either way:
// the trunk leant over the thighs, the arms out in front.
const SIT = 1
const KNEEL = 2
const CROUCH = 3

fill_leans(out: float[], way: int) {
    if way == SIT {
        twelve(out, 0.0 - 15.0, 5.0, 10.0, 10.0, 0.0 - 110.0, 0.0 - 30.0, 0.0 - 110.0, 0.0 - 30.0, 35.0, 35.0, 35.0, 35.0)
    } else if way == KNEEL {
        twelve(out, 75.0, 80.0, 80.0, 55.0, 0.0, 90.0, 0.0, 90.0, 0.0, 0.0, 0.0, 0.0)
    } else {
        twelve(out, 50.0, 45.0, 40.0, 20.0, 0.0 - 95.0, 30.0, 0.0 - 95.0, 30.0, 0.0 - 40.0, 0.0 - 60.0, 0.0 - 40.0, 0.0 - 60.0)
    }
}

twelve(out: float[], a: float, b: float, c: float, d: float, e: float, f: float, g: float, h: float, i: float, j: float, k: float, l: float) {
    out[0] = a
    out[1] = b
    out[2] = c
    out[3] = d
    out[4] = e
    out[5] = f
    out[6] = g
    out[7] = h
    out[8] = i
    out[9] = j
    out[10] = k
    out[11] = l
}

struct Motion {
    ragdoll: *Ragdoll
    mode: int
    strength: float
    recovery: float                    // seconds a struck bone takes to come back
    weakness: ptr                      // float[BONE_COUNT]: the share of each bone's budget a hit took
    protective: bool                   // reaches for the ground when it falls
    falling: bool
    landed: bool                       // fell, and holds the shape it landed in
    lying: bool                        // landed, and still: on the ground
    still_steps: int                   // steps it has been down on the ground
    caught_steps: int                  // steps its trunk has been still, falling
    caught: bool                       // landed caught (kneeling, sitting) rather than lying down
    quiet_steps: int                   // steps its trunk has been still, landed
    rest_steps: int                    // steps the pelvis has barely moved
    last_pelvis: Vec3
    settled: bool                      // on the ground and still there
    down_seconds: float                // settled on the ground this long
    get_up_after: float                // seconds settled before it gets up by itself; 0 never
    // A way from the bodies to the animation: its keyed poses (pelvis
    // transform and every bone's rotation, physics.POSE_STRIDE floats a
    // bone), how many, how long each stage takes, how far along it is, the
    // mode it ends in and the pose it is drawn in now.
    keys: ptr                          // float[RISE_KEYS * BONE_COUNT * POSE_STRIDE]
    key_count: int
    stage_seconds: float
    along: float                       // seconds into the way
    ends_in: int                          // the mode at its end
    blending: bool                     // a blend back, not a get-up
    now: ptr                           // float[BONE_COUNT * POSE_STRIDE]
    rise_seconds: float                // how long the last get-up took
    object: ptr                        // *GameObject whose figure it wears, or null
    engine: ptr                        // *Engine that steps it (attach), or null
    stepper: ptr                       // *Behaviour it is stepped by, or null
    stepping: bool                     // steps to catch itself when pushed
    step_leg: int                      // the thigh stepping (human's order), or -1
    staggering: bool                   // stepping to catch itself, step after step
    run: int                           // the steps of this stagger so far
    step_time: float                   // seconds into the step, or since the last
    step_target: Vec3                  // where the swing foot lands
    steps: int                         // steps taken
    last_com: Vec3
    com_known: bool
    writhe_for: float                  // seconds it writhes after it lands; 0 never
    writhe_left: float                 // seconds of writhing still to come
    writhe_time: float                 // seconds into the writhing
    wound: int                         // the bone last struck, or -1
    slumping: bool                     // hurt, caught on its hands and knees, and letting go to lie
    // Body parts (#573): which are let go, each bone's lasting share of
    // its muscle, and, for a figure that follows its clip, what the clip
    // last posed each bone at, what this wrote over it, and the offset a
    // part taken back is drawn under as it fades.
    part_limp: ptr                     // int[PARTS]
    part_strength: ptr                 // float[BONE_COUNT]
    drawn: ptr                         // float[BONE_COUNT * 13]: clip, written, offset (quats), left
    drew: ptr                          // int[BONE_COUNT]: 1 when this wrote the bone last
}

// Every active ragdoll an engine has put on a figure, for the scene file's
// records.
struct Motions {
    engine: ptr
    list: ptr                          // list of *Motion
}

var g_motions: ptr = null              // list of *Motions, one an engine

full_assist() -> float { return FULL_ASSIST }

// A bone's full muscle, the torque its joint may use at strength 1, in
// newton metres: an adult's peak joint torques, round -- the legs and the
// lower back carry the body, the neck and the arms carry themselves.
muscle(index: int) -> float {
    if index == human.BONE_SPINE_01 || index == human.BONE_SPINE_03 { return 250.0 }
    if index == human.BONE_NECK { return 40.0 }
    if index == human.BONE_THIGH_L || index == human.BONE_THIGH_R { return 300.0 }
    if index == human.BONE_CALF_L || index == human.BONE_CALF_R { return 250.0 }
    if index == human.BONE_UPPER_ARM_L || index == human.BONE_UPPER_ARM_R { return 80.0 }
    if index == human.BONE_LOWER_ARM_L || index == human.BONE_LOWER_ARM_R { return 60.0 }
    return 0.0
}

// An active ragdoll on a dressed ragdoll, ANIMATED to begin with. Null when
// the ragdoll wears no figure: there is no animation to play.
active_ragdoll(r: *Ragdoll) -> *Motion {
    if r == null || !physics.ragdoll_is_dressed(r) { return null }
    m = calloc(1, sizeof(Motion)) as *Motion
    m.ragdoll = r
    m.strength = 1.0
    m.recovery = 0.8
    m.protective = true
    m.stepping = true
    m.step_leg = 0 - 1
    m.wound = 0 - 1
    m.step_time = STEP_REST
    m.weakness = calloc(human.BONE_COUNT, 8)
    m.keys = calloc(RISE_KEYS * human.BONE_COUNT * physics.POSE_STRIDE, 8)
    m.now = calloc(human.BONE_COUNT * physics.POSE_STRIDE, 8)
    m.part_limp = calloc(PARTS, 4)
    m.part_strength = calloc(human.BONE_COUNT, 8)
    m.drawn = calloc(human.BONE_COUNT * DRAWN_FLOATS, 8)
    m.drew = calloc(human.BONE_COUNT, 4)
    shares = m.part_strength as float[]
    i = 0
    while i < human.BONE_COUNT {
        shares[i] = 1.0
        i = i + 1
    }
    set_mode(m, ANIMATED)
    return m
}

motion_free(m: *Motion) {
    if m == null { return }
    free(m.weakness)
    free(m.keys)
    free(m.now)
    free(m.part_limp)
    free(m.part_strength)
    free(m.drawn)
    free(m.drew)
    free(m as ptr)
}

set_mode(m: *Motion, to: int) {
    was = m.mode
    m.falling = false
    m.landed = false
    m.lying = false
    physics.ragdoll_let_go_shape(m.ragdoll)
    m.still_steps = 0
    m.down_seconds = 0.0
    m.rest_steps = 0
    m.settled = false
    m.key_count = 0
    m.blending = false
    m.step_leg = 0 - 1
    m.staggering = false
    m.run = 0
    m.step_time = STEP_REST
    m.com_known = false
    m.writhe_left = 0.0
    m.slumping = false
    physics.ragdoll_clear_aims(m.ragdoll)
    if to == ANIMATED {
        if was == POWERED {
            // From where the bodies are to the animation, over BLEND.
            key_bodies(m, 0)
            physics.ragdoll_animation_pose(m.ragdoll, key_at(m, 1))
            physics.ragdoll_follow(m.ragdoll)
            start_way(m, 2, BLEND, ANIMATED)
            m.blending = true
            m.mode = ANIMATED
            return
        }
        physics.ragdoll_follow(m.ragdoll)
    } else if to == POWERED {
        physics.ragdoll_power(m.ragdoll, 0.0, FULL_ASSIST * m.strength)
    } else if to == LIMP {
        physics.ragdoll_release(m.ragdoll)
    } else {
        return
    }
    m.mode = to
    // The muscles from the strength and the hits, once the mode is the
    // one they apply to.
    apply_budget(m)
}

mode(m: *Motion) -> int { return m.mode }

// --- getting up --------------------------------------------------------------------------------------

// --- on a figure -----------------------------------------------------------------------------------

// An active ragdoll on the skeleton of the figure `o` stands for: a ragdoll
// where the object stands, turned the way the rig faces, dressed by the
// rig's humanoid naming, stepped by the engine; ANIMATED to begin with.
// Null when the rig is no humanoid the engine knows.
on_skeleton(e: *Engine, o: *GameObject, sk: *Skeleton) -> *Motion {
    if o == null || sk == null || physics.humanoid_scheme(sk) < 0 { return null }
    if physics.of(e) == null { physics.attach(e) }
    group = behaviour.object_model(o)
    at = behaviour.object_position(o)
    if group != null {
        core.model_sync_transform(group)
        at = group.world_position
    }
    r = physics.ragdoll(e, core.text(o.name), at, 8.0, 8.0, 1.0)
    if !physics.ragdoll_dress_humanoid(r, sk) { return null }
    m = active_ragdoll(r)
    if m == null { return null }
    m.object = o as ptr
    attach(e, m)
    list.add_raw(motions_for(e).list, m as ptr)
    return m
}

// An active ragdoll on the figure an object is (ae3d.figure). Null when the
// object is no figure, or its figure no humanoid.
on_figure(e: *Engine, o: *GameObject) -> *Motion {
    f = figure.figure_of(o)
    if f == null { return null }
    return on_skeleton(e, o, figure.skeleton(f))
}

// The scene file's motion record put back on the figure a scene read in:
// the ragdoll, its mode, strength, protection and get-up.
from_record(e: *Engine, o: *GameObject, spec: *MotionSpec) -> *Motion {
    if spec == null { return null }
    m = on_figure(e, o)
    if m == null { return null }
    set_strength(m, spec.strength)
    set_protective(m, spec.protective)
    set_get_up(m, spec.get_up)
    set_mode(m, mode_of_name(spec.mode))
    return m
}

mode_name(which: int) -> string {
    if which == POWERED { return "powered" }
    if which == LIMP { return "limp" }
    return "animated"
}

// A mode by the scene file's name for it; ANIMATED for any other.
mode_of_name(name: string) -> int {
    if string.equals(name, "powered") == 1 { return POWERED }
    if string.equals(name, "limp") == 1 { return LIMP }
    return ANIMATED
}

get_up_after(m: *Motion) -> float { return m.get_up_after }

motions_for(e: *Engine) -> *Motions {
    if g_motions == null { g_motions = list.new() }
    i = 0
    while i < list.size(g_motions) {
        ms = list.get_raw(g_motions, i) as *Motions
        if ms.engine == e as ptr { return ms }
        i = i + 1
    }
    ms = calloc(1, sizeof(Motions)) as *Motions
    ms.engine = e as ptr
    ms.list = list.new()
    list.add_raw(g_motions, ms as ptr)
    engine.engine_set_attachment_provider(e, motion_attachments, ms as ptr)
    return ms
}

// The scene file's records: each figure's active ragdoll on its group. A
// figure getting up is written as the mode it gets up to.
motion_attachments(state: ptr) -> ptr {
    ms = state as *Motions
    out = list.new()
    i = 0
    while i < list.size(ms.list) {
        m = list.get_raw(ms.list, i) as *Motion
        group = null as *Model
        if m.object != null { group = behaviour.object_model(m.object as *GameObject) }
        if group != null {
            which = m.mode
            if which == GETTING_UP { which = m.ends_in }
            a = scene.attachment_new(group, "", "", null, null)
            scene.attachment_set_motion(a, scene.motion_spec_new(mode_name(which), m.strength, m.protective, m.get_up_after))
            list.add_raw(out, a as ptr)
        }
        i = i + 1
    }
    return out
}

// Every active ragdoll put on a figure of the engine's, freed: after the
// engine is.
motions_free(e: *Engine) {
    if g_motions == null { return }
    i = 0
    while i < list.size(g_motions) {
        ms = list.get_raw(g_motions, i) as *Motions
        if ms.engine == e as ptr {
            k = 0
            while k < list.size(ms.list) {
                motion_free(list.get_raw(ms.list, k) as *Motion)
                k = k + 1
            }
            list.free(ms.list)
            free(ms as ptr)
            list.remove(g_motions, i)
        } else {
            i = i + 1
        }
    }
    if list.size(g_motions) == 0 {
        list.free(g_motions)
        g_motions = null
    }
}

// Seconds settled on the ground before it gets up by itself; 0, the
// default, leaves it down until get_up.
set_get_up(m: *Motion, seconds: float) {
    if seconds < 0.0 { seconds = 0.0 }
    m.get_up_after = seconds
}

getting_up(m: *Motion) -> bool { return m.mode == GETTING_UP }

// Whether it is on the ground and settled there, POWERED or LIMP.
down(m: *Motion) -> bool { return m.settled }

// Whether it is on the ground: leaning past DOWN_TILT, or its pelvis
// within DOWN_HEIGHT of its lowest point.
on_ground(m: *Motion) -> bool {
    if tilt(m) > DOWN_TILT { return true }
    physics.ragdoll_body_pose(m.ragdoll, m.now)
    low = physics.ragdoll_pose_lowest(m.ragdoll, m.now)
    return pose_position(m.now, human.BONE_PELVIS).y - low < DOWN_HEIGHT
}

// Whether it is blending back into its animation.
blending(m: *Motion) -> bool { return m.blending && m.key_count > 0 }

// How long the last get-up took, seconds.
rise_seconds(m: *Motion) -> float { return m.rise_seconds }

key_at(m: *Motion, k: int) -> ptr {
    return m.keys + k * human.BONE_COUNT * physics.POSE_STRIDE * 8
}

key_bodies(m: *Motion, k: int) {
    physics.ragdoll_body_pose(m.ragdoll, key_at(m, k))
}

start_way(m: *Motion, count: int, stage: float, ends_in: int) {
    m.key_count = count
    m.stage_seconds = stage
    m.along = 0.0
    m.ends_in = ends_in
    pose_between(m, 0, 0.0)
    physics.ragdoll_show_pose(m.ragdoll, m.now)
}

// Get up from the ground, to the mode it was in (POWERED stays POWERED,
// anything else ends ANIMATED). False when it is not on the ground, or
// wears no figure to key the way up on.
get_up(m: *Motion) -> bool {
    if m.mode == GETTING_UP { return true }
    if !physics.ragdoll_is_dressed(m.ragdoll) || !on_ground(m) { return false }
    ends_in = ANIMATED
    if m.mode == POWERED { ends_in = POWERED }
    r = m.ragdoll
    h = physics.ragdoll_human(r)
    key_bodies(m, 0)
    lying = key_at(m, 0)
    ground = physics.ragdoll_pose_lowest(r, lying)
    pelvis = pose_position(lying, human.BONE_PELVIS)
    // Which way it lies: its chest's front, turned from standing, to the
    // sky or the ground (the chest's, not the pelvis's: propped on its
    // arms, a figure's pelvis can point anywhere). Face up it rises toward
    // its feet; face down, toward its head.
    rest_pelvis = human.bone_at(h, human.BONE_PELVIS).reference_frame.q
    forward_rest = rest_forward(m)
    front = lying_front(m, lying)
    face_up = front.y > 0.0
    ankles = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, lying, human.BONE_CALF_L), physics.ragdoll_pose_end(r, lying, human.BONE_CALF_R)), 0.5)
    head = pose_position(lying, human.BONE_NECK)
    way = level(core.v3_sub(head, pelvis))
    if face_up { way = level(core.v3_sub(ankles, pelvis)) }
    if core.v3_len(way) < 0.5 { way = level(front) }
    if core.v3_len(way) < 0.5 { way = forward_rest }
    // The first key where it lies; where its feet will stand is where its
    // feet are sitting, or where its knees are kneeling.
    first = KNEEL
    if face_up { first = SIT }
    key_bent(m, 1, first, way, pelvis, ground)
    stand = core.v3_mul(core.v3_add(pose_position(key_at(m, 1), human.BONE_CALF_L), pose_position(key_at(m, 1), human.BONE_CALF_R)), 0.5)
    if face_up {
        stand = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, key_at(m, 1), human.BONE_CALF_L), physics.ragdoll_pose_end(r, key_at(m, 1), human.BONE_CALF_R)), 0.5)
    }
    key_bent(m, 2, CROUCH, way, pelvis, ground)
    plant(m, 2, stand)
    // The last, the animation's pose: turned to face the way it rose,
    // its feet where it stands, on the ground.
    last = key_at(m, 3)
    physics.ragdoll_animation_pose(r, last)
    anim_pelvis = pose_position(last, human.BONE_PELVIS)
    anim_front = level(core.quat_apply(core.quat_mul(pose_rotation(last, human.BONE_PELVIS), core.quat_conjugate(rest_pelvis)), forward_rest))
    turn = core.quat_ident()
    if core.v3_len(anim_front) > 0.5 { turn = core.quat_from_to(anim_front, way) }
    physics.ragdoll_move_animation(r, anim_pelvis, turn, core.vec3(0.0, 0.0, 0.0))
    physics.ragdoll_animation_pose(r, last)
    feet = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, last, human.BONE_CALF_L), physics.ragdoll_pose_end(r, last, human.BONE_CALF_R)), 0.5)
    shift = core.vec3(stand.x - feet.x, ground - physics.ragdoll_pose_lowest(r, last), stand.z - feet.z)
    physics.ragdoll_move_animation(r, core.vec3(0.0, 0.0, 0.0), core.quat_ident(), shift)
    physics.ragdoll_animation_pose(r, last)
    // Its bodies follow the way up, as an animated figure's follow its rig.
    m.falling = false
    m.slumping = false
    m.landed = false
    m.lying = false
    physics.ragdoll_let_go_shape(m.ragdoll)
    physics.ragdoll_clear_aims(r)
    physics.ragdoll_follow(r)
    m.mode = GETTING_UP
    m.blending = false
    start_way(m, RISE_KEYS, RISE_STAGE, ends_in)
    return true
}

// The front of a pose's chest: the way the figure faces standing, turned
// as its chest is turned from standing.
lying_front(m: *Motion, pose: ptr) -> Vec3 {
    h = physics.ragdoll_human(m.ragdoll)
    rest = human.bone_at(h, human.BONE_SPINE_03).reference_frame.q
    return core.quat_apply(core.quat_mul(pose_rotation(pose, human.BONE_SPINE_03), core.quat_conjugate(rest)), rest_forward(m))
}

// Whether it lies face up: its chest's front to the sky. For a figure on
// the ground.
face_up(m: *Motion) -> bool {
    physics.ragdoll_body_pose(m.ragdoll, m.now)
    return lying_front(m, m.now).y > 0.0
}

// A keyed pose from a way's leans (the constants above), facing `way`,
// its pelvis over `pelvis`, its lowest point on `ground`.
key_bent(m: *Motion, k: int, leans: int, way: Vec3, pelvis: Vec3, ground: float) {
    r = m.ragdoll
    h = physics.ragdoll_human(r)
    pose = key_at(m, k)
    forward_rest = rest_forward(m)
    face = core.quat_from_to(forward_rest, way)
    across = core.v3_normalize(core.v3_cross(core.vec3(0.0, 1.0, 0.0), forward_rest))
    angles_block = calloc(human.BONE_COUNT, 8)
    angles = angles_block as float[]
    fill_leans(angles, leans)
    i = 0
    while i < human.BONE_COUNT {
        bend = core.quat_rotate(angles[i] * 0.0174533, across)
        q = core.quat_normalize(core.quat_mul(face, core.quat_mul(bend, human.bone_at(h, i).reference_frame.q)))
        set_rotation(pose, i, q)
        i = i + 1
    }
    free(angles_block)
    set_position(pose, human.BONE_PELVIS, core.vec3(pelvis.x, 0.0, pelvis.z))
    chain(m, pose)
    lift(m, pose, ground - physics.ragdoll_pose_lowest(r, pose))
}

// A keyed pose moved level so its ankles are over `stand`.
plant(m: *Motion, k: int, stand: Vec3) {
    r = m.ragdoll
    pose = key_at(m, k)
    feet = core.v3_mul(core.v3_add(physics.ragdoll_pose_end(r, pose, human.BONE_CALF_L), physics.ragdoll_pose_end(r, pose, human.BONE_CALF_R)), 0.5)
    shift = core.vec3(stand.x - feet.x, 0.0, stand.z - feet.z)
    i = 0
    while i < human.BONE_COUNT {
        set_position(pose, i, core.v3_add(pose_position(pose, i), shift))
        i = i + 1
    }
}

lift(m: *Motion, pose: ptr, by: float) {
    i = 0
    while i < human.BONE_COUNT {
        at = pose_position(pose, i)
        set_position(pose, i, core.vec3(at.x, at.y + by, at.z))
        i = i + 1
    }
}

// Every bone placed from its parent through their joint, from the pelvis
// out: the joint's point on the parent is its point on the child.
chain(m: *Motion, pose: ptr) {
    h = physics.ragdoll_human(m.ragdoll)
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(h, i)
        if bone.parent_index >= 0 {
            parent = bone.parent_index
            joint = core.v3_add(pose_position(pose, parent), core.quat_apply(pose_rotation(pose, parent), bone.local_frame_a.p))
            set_position(pose, i, core.v3_sub(joint, core.quat_apply(pose_rotation(pose, i), bone.local_frame_b.p)))
        }
        i = i + 1
    }
}

// The way the figure faces standing in the reference's pose: where its
// feet point.
rest_forward(m: *Motion) -> Vec3 {
    toes = level(physics.ragdoll_rest_forward(m.ragdoll))
    if core.v3_len(toes) < 0.5 { return core.vec3(0.0, 0.0, 1.0) }
    return toes
}

level(v: Vec3) -> Vec3 {
    flat = core.vec3(v.x, 0.0, v.z)
    if core.v3_len(flat) < 0.000001 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(flat)
}

pose_position(pose: ptr, i: int) -> Vec3 {
    p = pose as float[]
    at = i * physics.POSE_STRIDE
    return core.vec3(p[at + 4], p[at + 5], p[at + 6])
}

pose_rotation(pose: ptr, i: int) -> Quat {
    p = pose as float[]
    at = i * physics.POSE_STRIDE
    return core.quat(p[at], p[at + 1], p[at + 2], p[at + 3])
}

set_position(block: ptr, i: int, v: Vec3) {
    pose = block as float[]
    at = i * physics.POSE_STRIDE
    pose[at + 4] = v.x
    pose[at + 5] = v.y
    pose[at + 6] = v.z
}

set_rotation(block: ptr, i: int, q: Quat) {
    pose = block as float[]
    at = i * physics.POSE_STRIDE
    pose[at] = q.x
    pose[at + 1] = q.y
    pose[at + 2] = q.z
    pose[at + 3] = q.w
}

// The pose `u` (0..1) of the way from key `k` to key `k + 1`, eased, into
// `now`: every bone's rotation turned that far, the pelvis carried that
// far. (The rig is drawn from the pelvis and the rotations alone.)
pose_between(m: *Motion, k: int, u: float) {
    e = u * u * (3.0 - 2.0 * u)
    a = key_at(m, k)
    b = key_at(m, k)
    if k + 1 < m.key_count { b = key_at(m, k + 1) }
    now = m.now
    i = 0
    while i < human.BONE_COUNT {
        set_rotation(now, i, core.quat_slerp(pose_rotation(a, i), pose_rotation(b, i), e))
        set_position(now, i, core.v3_lerp(pose_position(a, i), pose_position(b, i), e))
        i = i + 1
    }
}

// A fixed step along the way: the rig drawn at the pose it has reached,
// and at its end the animation's own and the mode it ends in.
step_way(m: *Motion, step: float) {
    m.along = m.along + step
    stages = m.key_count - 1
    total = m.stage_seconds * (stages as float)
    if m.along >= total {
        physics.ragdoll_restore_animation(m.ragdoll)
        if !m.blending { m.rise_seconds = m.along }
        ends_in = m.ends_in
        m.key_count = 0
        m.blending = false
        if ends_in == POWERED {
            set_mode(m, POWERED)
        } else {
            m.mode = ANIMATED
        }
        return
    }
    k = floor_int(m.along / m.stage_seconds)
    u = (m.along - (k as float) * m.stage_seconds) / m.stage_seconds
    pose_between(m, k, u)
    physics.ragdoll_show_pose(m.ragdoll, m.now)
}

floor_int(x: float) -> int {
    n = x as int
    if (n as float) > x { n = n - 1 }
    return n
}

// The share of the figure's full muscle it has, 0..1.
set_strength(m: *Motion, s: float) {
    m.strength = core.clampf(s, 0.0, 1.0)
    apply_budget(m)
}

strength(m: *Motion) -> float { return m.strength }

set_recovery(m: *Motion, seconds: float) {
    if seconds > 0.0 { m.recovery = seconds }
}

// A blow: `impulse` (newton seconds) at `point` on bone `index` (the
// ragdoll's bone order, physics.humanoid_bone names them). The bone is
// pushed, and its muscle goes weak with its neighbours', to come back over
// the recovery time.
hit(m: *Motion, index: int, point: Vec3, impulse: Vec3) {
    if index < 0 || index >= human.BONE_COUNT { return }
    m.wound = index
    physics.ragdoll_apply_impulse(m.ragdoll, index, impulse, point)
    weak = m.weakness as float[]
    h = physics.ragdoll_human(m.ragdoll)
    mass = dynamics.body_get_mass(human.bone_at(h, index).body_id)
    share = 1.0
    if mass > 0.0 {
        share = core.v3_len(impulse) / mass / BLOW_FULL_SPEED
        if share > 1.0 { share = 1.0 }
    }
    weaken(weak, index, WEAK_STRUCK * share)
    parent = human.bone_at(h, index).parent_index
    if parent >= 0 && parent < human.BONE_COUNT { weaken(weak, parent, WEAK_NEAR * share) }
    i = 0
    while i < human.BONE_COUNT {
        if human.bone_at(h, i).parent_index == index { weaken(weak, i, WEAK_NEAR * share) }
        i = i + 1
    }
    apply_budget(m)
}

weaken(weak: float[], index: int, by: float) {
    if weak[index] < by { weak[index] = by }
}

// How much of a bone's budget a hit has taken, 0..1.
bone_weakness(m: *Motion, index: int) -> float {
    if index < 0 || index >= human.BONE_COUNT { return 0.0 }
    weak = m.weakness as float[]
    return weak[index]
}

// Every joint's torque from the strength and what hits have left of it,
// and the balance the pelvis keeps. A weak limb sags under its own weight,
// as a stunned one does, until its muscle comes back.
apply_budget(m: *Motion) {
    if m.mode != POWERED { return }
    weak = m.weakness as float[]
    i = 0
    while i < human.BONE_COUNT {
        set_drive(m, i, muscle(i) * m.strength * (1.0 - weak[i]))
        i = i + 1
    }
    assist = FULL_ASSIST * m.strength * (1.0 - weak[human.BONE_PELVIS] * PELVIS_ASSIST_SHARE)
    // Falling, the balance works against the fall until the figure is down;
    // lying, it lets go. Caught on its hands and knees, it keeps it: let go
    // there, a figure kneeling still collapsed onto its face and took three
    // seconds more to come to rest.
    if m.falling { assist = assist * FALL_ASSIST }
    if m.falling && m.slumping {
        assist = 0.0
        i = 0
        while i < human.BONE_COUNT {
            set_drive(m, i, muscle(i) * m.strength * WRITHE_REST * (1.0 - weak[i]))
            i = i + 1
        }
    }
    if m.landed && !m.caught { assist = 0.0 }
    if m.landed {
        i = 0
        while i < human.BONE_COUNT {
            share = LANDED_MUSCLE
            if m.caught { share = 1.0 }
            set_drive(m, i, muscle(i) * m.strength * share * (1.0 - weak[i]))
            i = i + 1
        }
        if m.writhe_left > 0.0 { writhe_budget(m) }
    }
    physics.ragdoll_set_balance_assist(m.ragdoll, assist)
}

set_protective(m: *Motion, on: bool) {
    m.protective = on
    if !on && m.falling {
        m.falling = false
        m.slumping = false
        m.landed = false
        m.lying = false
        physics.ragdoll_clear_aims(m.ragdoll)
        physics.ragdoll_let_go_shape(m.ragdoll)
        apply_budget(m)
    }
}

protective(m: *Motion) -> bool { return m.protective }

// Whether a push is caught by a step.
set_stepping(m: *Motion, on: bool) {
    m.stepping = on
    if !on && m.step_leg >= 0 { end_step(m) }
    if !on {
        m.staggering = false
        m.run = 0
    }
}

stepping(m: *Motion) -> bool { return m.step_leg >= 0 }

// Whether it is staggering: a run of catch steps under way, one after
// another while the push carries it on.
staggering(m: *Motion) -> bool { return m.staggering }

// How many steps it has taken to catch itself.
steps_taken(m: *Motion) -> int { return m.steps }

// Where a foot is: its calf's far end, the ankle, in the world.
ankle(m: *Motion, calf: int) -> Vec3 {
    physics.ragdoll_body_pose(m.ragdoll, m.now)
    return physics.ragdoll_pose_end(m.ragdoll, m.now, calf)
}

// How far, along the ground, `p` is outside the four corners of the feet
// (each heel and toe): 0 inside the ground they span, else the distance to
// its nearest edge. The corners are joined all ways, and a point is inside
// when it is on the inner side of every edge of their hull.
off_feet(p: Vec3, heel_l: Vec3, toe_l: Vec3, heel_r: Vec3, toe_r: Vec3) -> float {
    if inside_hull(p, heel_l, toe_l, heel_r, toe_r) { return 0.0 }
    d = off_segment(p, heel_l, toe_l)
    d = min_of(d, off_segment(p, heel_r, toe_r))
    d = min_of(d, off_segment(p, heel_l, heel_r))
    d = min_of(d, off_segment(p, toe_l, toe_r))
    d = min_of(d, off_segment(p, heel_l, toe_r))
    d = min_of(d, off_segment(p, toe_l, heel_r))
    return d
}

min_of(a: float, b: float) -> float {
    if b < a { return b }
    return a
}

// Whether `p` is inside the hull of four points on the ground: some edge
// among the six pairs is a hull edge exactly when the other two points are
// on one side of it; `p` is inside when it is on their side of every hull
// edge.
inside_hull(p: Vec3, a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> bool {
    return edge_ok(p, a, b, c, d) && edge_ok(p, a, c, b, d) && edge_ok(p, a, d, b, c) &&
           edge_ok(p, b, c, a, d) && edge_ok(p, b, d, a, c) && edge_ok(p, c, d, a, b)
}

// For the edge u-v with the other two points o1, o2: when it is a hull
// edge, whether p is on their side of it; true when it is not a hull edge.
edge_ok(p: Vec3, u: Vec3, v: Vec3, o1: Vec3, o2: Vec3) -> bool {
    s1 = side(u, v, o1)
    s2 = side(u, v, o2)
    if s1 * s2 < 0.0 { return true }
    reference = s1
    if core.abs_of(s2) > core.abs_of(s1) { reference = s2 }
    if core.abs_of(reference) < 0.000001 { return true }
    return side(u, v, p) * reference >= 0.0
}

side(u: Vec3, v: Vec3, p: Vec3) -> float {
    return (v.x - u.x) * (p.z - u.z) - (v.z - u.z) * (p.x - u.x)
}

// The distance, along the ground, from `p` to the segment between `a` and
// `b`.
off_segment(p: Vec3, a: Vec3, b: Vec3) -> float {
    ax = b.x - a.x
    az = b.z - a.z
    length2 = ax * ax + az * az
    t = 0.0
    if length2 > 0.000001 { t = ((p.x - a.x) * ax + (p.z - a.z) * az) / length2 }
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    dx = p.x - (a.x + ax * t)
    dz = p.z - (a.z + az * t)
    return sqrt(dx * dx + dz * dz)
}

// The way a standing figure faces, level: its pelvis's turn from the
// reference's pose taken to the toes' way. Not the chest's: a shove from
// behind folds the spine forward, the chest's front points at the ground
// and a little back, and leveled it read the figure as facing the way it
// came from, so a stagger's next step was taken for a step backwards.
standing_front(m: *Motion) -> Vec3 {
    h = physics.ragdoll_human(m.ragdoll)
    rest = human.bone_at(h, human.BONE_PELVIS).reference_frame.q
    turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_PELVIS), core.quat_conjugate(rest))
    return level(core.quat_apply(turned, rest_forward(m)))
}

// A fixed step of balance by stepping: the capture point watched, a step
// started when it leaves the feet, a step in progress carried on.
balance(m: *Motion, step: float) {
    r = m.ragdoll
    com = physics.ragdoll_center_of_mass(r)
    if !m.com_known {
        m.last_com = com
        m.com_known = true
        return
    }
    vx = (com.x - m.last_com.x) / step
    vz = (com.z - m.last_com.z) / step
    m.last_com = com
    m.step_time = m.step_time + step
    if m.step_leg >= 0 {
        swing(m)
        if m.step_time >= step_seconds(m) { end_step(m) }
        return
    }
    if m.step_time < step_rest(m) { return }
    if sqrt(vx * vx + vz * vz) < STEP_SPEED {
        m.staggering = false
        m.run = 0
        return
    }
    left = ankle(m, human.BONE_CALF_L)
    right = ankle(m, human.BONE_CALF_R)
    ground = left.y
    if right.y < ground { ground = right.y }
    height = com.y - ground
    if height <= 0.1 { return }
    reach = sqrt(height / GRAVITY)
    capture = core.vec3(com.x + vx * reach, ground, com.z + vz * reach)
    // The feet as the ground they cover: heel at the ankle, toe forward
    // the way the figure faces.
    ahead = core.v3_mul(standing_front(m), FOOT_LENGTH)
    toe_l = core.v3_add(left, ahead)
    toe_r = core.v3_add(right, ahead)
    off = off_feet(capture, left, toe_l, right, toe_r)
    // Over the feet again, the stagger is over: the rocking that follows on
    // the feet that caught it is the balance's to hold, not a stagger's
    // STAGGER_MARGIN to step for. On the IK rig, shoves from behind of 210
    // and 220 N s took three and four steps that way, two this.
    if off <= 0.0 && m.staggering {
        m.staggering = false
        m.run = 0
    }
    margin = STEP_MARGIN
    if m.staggering { margin = STAGGER_MARGIN }
    if off <= margin { return }
    // Not backwards: the reference's hips hardly extend (their cone sits
    // forward of the leg), so a step back is too short to catch anything
    // and only takes a foot from under a figure its balance would have
    // held. A push onto the heels is the pelvis's to hold, as before.
    // Backwards is behind the rear foot: after a long step forward the
    // feet's middle is ahead of a figure still falling forward, and taken
    // from there, a stagger's second step waited a quarter second, until
    // it was falling too far to catch.
    front = standing_front(m)
    rear = left
    if core.v3_dot(right, front) < core.v3_dot(left, front) { rear = right }
    // And mostly behind: a side shove that turns the figure a little puts
    // the capture point a little behind the rear foot as well, and taken
    // for a step back, no step followed the first one out (#481).
    behind = core.vec3(capture.x - rear.x, 0.0, capture.z - rear.z)
    back = 0.0 - core.v3_dot(behind, front)
    aside = core.v3_len(core.v3_sub(behind, core.v3_mul(front, 0.0 - back)))
    if back > 0.3 * core.v3_len(behind) && back > aside { return }
    going = core.vec3(capture.x - (left.x + right.x + ahead.x) * 0.5, 0.0, capture.z - (left.z + right.z + ahead.z) * 0.5)
    // Which foot moves. Going mostly sideways, the foot on that side steps
    // out, as a person catches a push from the side; swinging the other
    // across it only tangled the legs. Going mostly forward, the foot
    // further behind swings through: it is the one the other can stand on.
    across = core.vec3(left.x - right.x, 0.0, left.z - right.z)
    if core.v3_len(across) > 0.0001 { across = core.v3_normalize(across) }
    lateral = core.v3_dot(going, across)
    onward = core.v3_dot(going, standing_front(m))
    thigh = human.BONE_THIGH_L
    stance = right
    if core.abs_of(lateral) > core.abs_of(onward) {
        if lateral < 0.0 {
            thigh = human.BONE_THIGH_R
            stance = left
        }
    } else if core.v3_len(core.vec3(right.x - capture.x, 0.0, right.z - capture.z)) >
              core.v3_len(core.vec3(left.x - capture.x, 0.0, left.z - capture.z)) {
        thigh = human.BONE_THIGH_R
        stance = left
    }
    // Past STEP_FAR strides from under the hip, a fall; staggering, past
    // STAGGER_FAR.
    hip_now = behaviour.object_position(physics.ragdoll_bone(r, thigh))
    furthest = STEP_REACH * STEP_FAR
    if m.staggering { furthest = STEP_REACH * STAGGER_FAR }
    // Out of reach, the stagger is over: the protective fall takes it from
    // FALL_TILT, rather than waiting on a step that will not come.
    if core.v3_len(core.vec3(capture.x - hip_now.x, 0.0, capture.z - hip_now.z)) > furthest {
        m.staggering = false
        m.run = 0
        return
    }
    // A little past the capture point, from the stance foot's side, and
    // within a stride of under the hip.
    away = core.vec3(capture.x - stance.x, 0.0, capture.z - stance.z)
    if core.v3_len(away) > 0.0001 { away = core.v3_normalize(away) }
    target = core.vec3(capture.x + away.x * STEP_BEYOND, ground, capture.z + away.z * STEP_BEYOND)
    hip = behaviour.object_position(physics.ragdoll_bone(r, thigh))
    stride = core.vec3(target.x - hip.x, 0.0, target.z - hip.z)
    if core.v3_len(stride) > STEP_REACH {
        stride = core.v3_mul(core.v3_normalize(stride), STEP_REACH)
        target = core.vec3(hip.x + stride.x, ground, hip.z + stride.z)
    }
    m.step_leg = thigh
    m.step_target = target
    m.step_time = 0.0
    if !m.staggering { m.run = 0 }
    m.run = m.run + 1
    m.staggering = true
    m.steps = m.steps + 1
    swing(m)
}

// The swinging leg aimed: the thigh toward the landing from the hip, the
// shin hanging while the foot lifts, then along the thigh as it lands.
swing(m: *Motion) {
    r = m.ragdoll
    calf = m.step_leg + 1
    hip = behaviour.object_position(physics.ragdoll_bone(r, m.step_leg))
    toward = core.v3_sub(core.vec3(m.step_target.x, m.step_target.y + 0.08, m.step_target.z), hip)
    if core.v3_len(toward) < 0.0001 { return }
    point_limb(m, m.step_leg, core.v3_normalize(toward))
    if m.step_time < step_seconds(m) * STEP_LIFT / STEP_SECONDS {
        hinge_bend(m, calf, STEP_KNEE)
    } else {
        hinge_bend(m, calf, 0.0)
    }
}

// A step's length and the rest after it: a stagger's steps after its
// first come quicker.
step_seconds(m: *Motion) -> float {
    if m.run >= 2 { return STAGGER_SECONDS }
    return STEP_SECONDS
}

step_rest(m: *Motion) -> float {
    if m.run >= 1 && m.staggering { return STAGGER_REST }
    return STEP_REST
}

end_step(m: *Motion) {
    if m.step_leg >= 0 {
        physics.ragdoll_clear_aim(m.ragdoll, m.step_leg)
        physics.ragdoll_clear_aim(m.ragdoll, m.step_leg + 1)
    }
    m.step_leg = 0 - 1
    m.step_time = 0.0
}

// How long it writhes once it lands, hurt, seconds; 0 (the default) it
// lies still. Writhing now goes on for that long from now.
set_writhing(m: *Motion, seconds: float) {
    if seconds < 0.0 { seconds = 0.0 }
    was = m.writhe_left > 0.0
    m.writhe_for = seconds
    if m.lying && !m.caught && seconds > 0.0 {
        start_writhing(m, seconds)
    } else if was {
        stop_writhing(m)
    }
    apply_budget(m)
}

start_writhing(m: *Motion, seconds: float) {
    m.writhe_left = seconds
    m.writhe_time = 0.0
    physics.ragdoll_let_go_shape(m.ragdoll)
}

// Done writhing: the aims let go and the shape it ends in held, as a
// landing's is.
stop_writhing(m: *Motion) {
    m.writhe_left = 0.0
    physics.ragdoll_clear_aims(m.ragdoll)
    if m.lying { hold_pose(m) }
}

writhing(m: *Motion) -> bool { return m.lying && m.writhe_left > 0.0 }

// The bone it was last struck on, or -1.
wound(m: *Motion) -> int { return m.wound }

// A fixed step of writhing: the legs' cycle and the arms folded over the
// wound, each a bend from where the limb rests under its parent.
writhe(m: *Motion, step: float) {
    m.writhe_time = m.writhe_time + step
    m.writhe_left = m.writhe_left - step
    if m.writhe_left <= 0.0 {
        stop_writhing(m)
        apply_budget(m)
        return
    }
    // Full for the first half, then less and less.
    fade = m.writhe_left / (m.writhe_for * 0.5)
    if fade > 1.0 { fade = 1.0 }
    cycle = m.writhe_time / WRITHE_PERIOD
    kick(m, human.BONE_THIGH_L, cycle, fade)
    kick(m, human.BONE_THIGH_R, cycle, fade)
    clutch(m, fade)
    writhe_budget(m)
}

// Whether an arm (its upper bone) may move: not the wound, nor weak.
arm_able(m: *Motion, arm: int) -> bool {
    return m.wound != arm && m.wound != arm + 1 && bone_weakness(m, arm) <= 0.5 && bone_weakness(m, arm + 1) <= 0.5
}

// Writhing, the limbs that move have the muscle for it, and the rest keep
// what lying leaves them, since a limb not aimed drives toward the
// standing pose and, strong, would push the body over.
writhe_budget(m: *Motion) {
    weak = m.weakness as float[]
    i = human.BONE_THIGH_L
    while i < human.BONE_COUNT {
        share = WRITHE_REST
        if physics.ragdoll_is_aimed(m.ragdoll, i) { share = WRITHE_MUSCLE }
        set_drive(m, i, muscle(i) * m.strength * share * (1.0 - weak[i]))
        i = i + 1
    }
}

// A leg at `cycle` through drawing up and letting down. A leg a blow left
// weak hangs.
kick(m: *Motion, thigh: int, cycle: float, fade: float) {
    calf = thigh + 1
    if bone_weakness(m, thigh) > 0.5 || bone_weakness(m, calf) > 0.5 {
        physics.ragdoll_clear_aim(m.ragdoll, thigh)
        physics.ragdoll_clear_aim(m.ragdoll, calf)
        return
    }
    drawn = (0.5 - 0.5 * cos(TAU * cycle)) * fade
    bend(m, thigh, human.BONE_PELVIS, WRITHE_HIP * drawn, 0.0)
    bend(m, calf, thigh, 0.0 - WRITHE_KNEE * drawn, 0.0)
}

// The arms folded toward the wound -- the bone last struck, or the belly
// -- and rocking there. An arm a blow left weak, or the struck arm itself,
// stays where it lies.
clutch(m: *Motion, fade: float) {
    rock = CLUTCH_ROCK * sin(TAU * m.writhe_time / CLUTCH_PERIOD) * fade
    fold(m, human.BONE_UPPER_ARM_L, human.BONE_LOWER_ARM_L, 1.0, rock)
    fold(m, human.BONE_UPPER_ARM_R, human.BONE_LOWER_ARM_R, 0.0 - 1.0, rock)
}

// One arm folded: the shoulder forward and in toward the middle (`side`
// is +1 for the left, -1 for the right), the elbow bent.
fold(m: *Motion, arm: int, forearm: int, side: float, rock: float) {
    r = m.ragdoll
    if !arm_able(m, arm) {
        physics.ragdoll_clear_aim(r, arm)
        physics.ragdoll_clear_aim(r, forearm)
        return
    }
    bend(m, arm, human.BONE_SPINE_03, CLUTCH_SHOULDER + rock, CLUTCH_IN * side)
    bend(m, forearm, arm, CLUTCH_ELBOW, 0.0)
}

// Bone `index` aimed at its rest place under `parent`, as the parent is
// now, turned by `forward` radians about the figure's side-to-side axis
// (forward for a hip, a shoulder or an elbow; negative, back, for a knee)
// and by `across` about its front-to-back axis (positive toward the
// figure's right, bringing a left arm in).
bend(m: *Motion, index: int, parent: int, forward: float, across: float) {
    r = m.ragdoll
    h = physics.ragdoll_human(r)
    parent_rest = human.bone_at(h, parent).reference_frame.q
    rest = human.bone_at(h, index).reference_frame.q
    ahead = rest_forward(m)
    lateral = core.v3_normalize(core.v3_cross(ahead, core.vec3(0.0, 1.0, 0.0)))
    back_to_rest = core.quat_conjugate(parent_rest)
    turn = core.quat_mul(core.quat_rotate(forward, core.quat_apply(back_to_rest, lateral)),
                         core.quat_rotate(across, core.quat_apply(back_to_rest, ahead)))
    under = core.quat_mul(back_to_rest, rest)
    physics.ragdoll_aim(r, index, within_cone(m, index, core.quat_mul(physics.ragdoll_bone_rotation(r, parent), core.quat_mul(turn, under))))
}

// Whether it is falling and protecting itself.
falling(m: *Motion) -> bool { return m.falling }

// Whether it fell and lies on the ground.
lying(m: *Motion) -> bool { return m.lying }

// The way the figure is falling, level: where its pelvis's up leans to.
// The figure's up, not the pelvis body's +y: aephysics's pelvis rests a
// half turn about x, its +y down, and read as up it pointed the arms'
// reach and the head's tuck the other way from the fall.
fall_way(m: *Motion) -> Vec3 {
    h = physics.ragdoll_human(m.ragdoll)
    rest = human.bone_at(h, human.BONE_PELVIS).reference_frame.q
    up = core.quat_apply(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_PELVIS),
                         core.quat_apply(core.quat_conjugate(rest), core.vec3(0.0, 1.0, 0.0)))
    way = core.vec3(up.x, 0.0, up.z)
    if core.v3_len(way) < 0.05 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(way)
}

// An arm reaching down toward the fall, a little out to its own side, so
// the hands land apart, and straight: a straight arm takes the landing
// through its joints, where a bent one folds on its elbow's muscle. Each
// of its two bodies turned from where its length points now to there
// (the left arm's capsules lie along their bodies' +x, the right's -x:
// one axis for both had the left arm reach up and away).
reach(m: *Motion, arm: int, forearm: int, way: Vec3) {
    r = m.ragdoll
    shoulder = behaviour.object_position(physics.ragdoll_bone(r, arm))
    chest = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_SPINE_03))
    side = core.v3_sub(shoulder, chest)
    side = core.vec3(side.x, 0.0, side.z)
    if core.v3_len(side) > 0.001 { side = core.v3_normalize(side) }
    want = core.v3_normalize(core.vec3(way.x + side.x * 0.3, 0.0 - REACH_DOWN, way.z + side.z * 0.3))
    aim_along(r, arm, want)
    aim_along(r, forearm, want)
}

aim_along(r: *Ragdoll, index: int, want: Vec3) {
    now = physics.ragdoll_bone_rotation(r, index)
    points = core.quat_apply(now, physics.ragdoll_bone_axis(r, index))
    physics.ragdoll_aim(r, index, core.quat_mul(core.quat_from_to(points, want), now))
}

// How fast its trunk moves: the faster of the pelvis and the chest.
trunk_speed(m: *Motion) -> float {
    trunk = physics.ragdoll_bone_speed(m.ragdoll, human.BONE_PELVIS)
    upper = physics.ragdoll_bone_speed(m.ragdoll, human.BONE_SPINE_03)
    if upper > trunk { return upper }
    return trunk
}

// The shape it landed in held, the head as tucked: the aims give way to it.
hold_pose(m: *Motion) {
    physics.ragdoll_clear_aims(m.ragdoll)
    physics.ragdoll_hold_shape(m.ragdoll)
}

// Bone `index` at its rest place under its parent, as the parent is now:
// turned from the parent as the reference's pose has it.
rest_under(m: *Motion, index: int) -> Quat {
    r = m.ragdoll
    h = physics.ragdoll_human(r)
    bone = human.bone_at(h, index)
    under = core.quat_mul(core.quat_conjugate(human.bone_at(h, bone.parent_index).reference_frame.q), bone.reference_frame.q)
    return core.quat_mul(physics.ragdoll_bone_rotation(r, bone.parent_index), under)
}

// A bone on a ball joint (a hip, a shoulder, the neck) pointed along
// `want`: its rest place under its parent turned the least way there, and
// kept within its cone.
point_limb(m: *Motion, index: int, want: Vec3) {
    r = m.ragdoll
    rest = rest_under(m, index)
    from = core.quat_apply(rest, physics.ragdoll_bone_axis(r, index))
    physics.ragdoll_aim(r, index, within_cone(m, index, core.quat_mul(core.quat_from_to(from, want), rest)))
}

// Bone `index` at `rotation` in the world, turned back as little as it
// takes to lie within its joint's cone of its parent as the parent is now,
// LIMIT_MARGIN inside it. A target past a limit only saturates the motor,
// and its torque, against the limit, turns the body instead of the limb.
within_cone(m: *Motion, index: int, rotation: Quat) -> Quat {
    r = m.ragdoll
    bone = human.bone_at(physics.ragdoll_human(r), index)
    if bone.swing_limit <= 0.0 || bone.parent_index < 0 { return rotation }
    z = core.vec3(0.0, 0.0, 1.0)
    cone = core.quat_apply(core.quat_mul(physics.ragdoll_bone_rotation(r, bone.parent_index), bone.local_frame_a.q), z)
    twist = core.quat_apply(core.quat_mul(rotation, bone.local_frame_b.q), z)
    most = bone.swing_limit - LIMIT_MARGIN
    off = core.acos_of(core.v3_dot(cone, twist))
    if off <= most { return rotation }
    axis = core.v3_cross(cone, twist)
    if core.v3_len(axis) < 0.000001 { return rotation }
    return core.quat_normalize(core.quat_mul(core.quat_rotate(most - off, core.v3_normalize(axis)), rotation))
}

// A bone on a hinge (a knee, an elbow) turned about it from its rest place
// under its parent as far toward pointing along `want` as its limits let
// it, LIMIT_MARGIN inside them.
point_hinge(m: *Motion, index: int, want: Vec3) {
    r = m.ragdoll
    rest = rest_under(m, index)
    axis = hinge_axis(m, index)
    from = core.quat_apply(rest, physics.ragdoll_bone_axis(r, index))
    f = core.v3_sub(from, core.v3_mul(axis, core.v3_dot(from, axis)))
    w = core.v3_sub(want, core.v3_mul(axis, core.v3_dot(want, axis)))
    if core.v3_len(f) < 0.000001 || core.v3_len(w) < 0.000001 { return }
    turn = core.atan2_of(core.v3_dot(core.v3_cross(f, w), axis), core.v3_dot(f, w))
    hinge_turn(m, index, turn)
}

// A bone on a hinge bent `bend` radians from its rest place under its
// parent, toward the limit it has the more room to turn to -- the way a
// knee or an elbow bends -- within its limits.
hinge_bend(m: *Motion, index: int, bend: float) {
    bone = human.bone_at(physics.ragdoll_human(m.ragdoll), index)
    rest = rest_hinge(m, index)
    way = 1.0
    if bone.twist_limit.y - rest < rest - bone.twist_limit.x { way = 0.0 - 1.0 }
    hinge_turn(m, index, way * bend)
}

// A hinged bone turned `turn` radians about its hinge from its rest place
// under its parent, the angle kept LIMIT_MARGIN inside the limits.
hinge_turn(m: *Motion, index: int, turn: float) {
    bone = human.bone_at(physics.ragdoll_human(m.ragdoll), index)
    rest = rest_hinge(m, index)
    angle = rest + turn
    low = bone.twist_limit.x + LIMIT_MARGIN
    high = bone.twist_limit.y - LIMIT_MARGIN
    if angle < low { angle = low }
    if angle > high { angle = high }
    physics.ragdoll_aim(m.ragdoll, index, core.quat_mul(core.quat_rotate(angle - rest, hinge_axis(m, index)), rest_under(m, index)))
}

// A hinge's angle in the reference's pose.
rest_hinge(m: *Motion, index: int) -> float {
    h = physics.ragdoll_human(m.ragdoll)
    bone = human.bone_at(h, index)
    qa = core.quat_mul(human.bone_at(h, bone.parent_index).reference_frame.q, bone.local_frame_a.q)
    qb = core.quat_mul(bone.reference_frame.q, bone.local_frame_b.q)
    rel = core.quat_mul(core.quat_conjugate(qa), qb)
    return 2.0 * core.atan2_of(rel.z, rel.w)
}

// A hinge's axis in the world, on its parent as the parent is now.
hinge_axis(m: *Motion, index: int) -> Vec3 {
    r = m.ragdoll
    bone = human.bone_at(physics.ragdoll_human(r), index)
    return core.quat_apply(core.quat_mul(physics.ragdoll_bone_rotation(r, bone.parent_index), bone.local_frame_a.q), core.vec3(0.0, 0.0, 1.0))
}

// A fixed step of the protective fall: into it past FALL_TILT, the arms'
// reach and the head's tuck renewed as the figure turns, and out of it
// again should the figure find its feet.
protect(m: *Motion) {
    if m.mode != POWERED || !m.protective { return }
    lean = physics.ragdoll_tilt(m.ragdoll)
    if !m.falling {
        if lean < FALL_TILT || (m.staggering && lean < STAGGER_TILT) { return }
        m.falling = true
        apply_budget(m)
    } else if lean < FALL_TILT * 0.5 {
        m.falling = false
        m.slumping = false
        m.landed = false
        m.lying = false
        physics.ragdoll_let_go_shape(m.ragdoll)
        physics.ragdoll_clear_aims(m.ragdoll)
        apply_budget(m)
        return
    }
    if m.lying {
        // Caught, and going over after all -- kneeling, it tips onto its
        // face -- it falls again: the shape let go, the arms reaching,
        // to land and lie as any fall does. Held, it tipped over a second
        // in the kneeling shape and rocked on its arms after.
        if m.caught && trunk_speed(m) > SETTLED {
            m.caught = false
            m.landed = false
            m.lying = false
            m.still_steps = 0
            m.caught_steps = 0
            physics.ragdoll_let_go_shape(m.ragdoll)
            apply_budget(m)
        }
        return
    }
    if m.landed {
        if trunk_speed(m) < SETTLED { m.quiet_steps = m.quiet_steps + 1 } else { m.quiet_steps = 0 }
        if m.quiet_steps >= SETTLE_STEPS {
            m.lying = true
            hold_pose(m)
            if m.writhe_for > 0.0 && !m.caught { start_writhing(m, m.writhe_for) }
            apply_budget(m)
        }
        return
    }
    pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS)).y
    down = pelvis - physics.ragdoll_pose_lowest(m.ragdoll, null) < GROUNDED
    if lean > LYING_TILT && down { m.still_steps = m.still_steps + 1 } else { m.still_steps = 0 }
    // Or caught -- on its hands and knees, sitting -- and still there.
    if trunk_speed(m) < SETTLED { m.caught_steps = m.caught_steps + 1 } else { m.caught_steps = 0 }
    if m.still_steps >= SETTLE_STEPS || m.caught_steps >= CAUGHT_STEPS {
        m.caught = m.still_steps < SETTLE_STEPS && !m.slumping
        // Hurt, it does not stay on its hands and knees or sit up: it lets
        // go and goes down, to writhe where it comes to lie.
        if m.caught && m.writhe_for > 0.0 {
            m.slumping = true
            m.caught = false
            m.caught_steps = 0
            physics.ragdoll_clear_aims(m.ragdoll)
            apply_budget(m)
            return
        }
        m.slumping = false
        m.landed = true
        m.quiet_steps = 0
        m.caught_steps = 0
        hold_pose(m)
        apply_budget(m)
        return
    }
    if m.slumping { return }
    way = fall_way(m)
    if core.v3_len(way) < 0.5 { return }
    reach(m, human.BONE_UPPER_ARM_L, human.BONE_LOWER_ARM_L, way)
    reach(m, human.BONE_UPPER_ARM_R, human.BONE_LOWER_ARM_R, way)
    // The knees give, as a person's do going down (#578).
    hinge_bend(m, human.BONE_CALF_L, FALL_KNEE)
    hinge_bend(m, human.BONE_CALF_R, FALL_KNEE)
    across = core.v3_cross(core.vec3(0.0, 1.0, 0.0), way)
    if core.v3_len(across) > 0.001 {
        across = core.v3_normalize(across)
        // The trunk bent away from the fall when the fall is toward its back
        // (above): the spine a CURL at each joint, the head a TUCK past it.
        h = physics.ragdoll_human(m.ragdoll)
        turned = core.quat_mul(physics.ragdoll_bone_rotation(m.ragdoll, human.BONE_PELVIS),
                               core.quat_conjugate(human.bone_at(h, human.BONE_PELVIS).reference_frame.q))
        ahead = core.quat_apply(turned, rest_forward(m))
        back = 0.0 - core.v3_dot(core.v3_normalize(core.vec3(ahead.x, 0.0, ahead.z)), way)
        if back > 0.5 {
            physics.ragdoll_aim(m.ragdoll, human.BONE_SPINE_01,
                core.quat_mul(core.quat_rotate(0.0 - CURL, across), carried(m, human.BONE_SPINE_01, human.BONE_PELVIS)))
            physics.ragdoll_aim(m.ragdoll, human.BONE_SPINE_03,
                core.quat_mul(core.quat_rotate(0.0 - 2.0 * CURL, across), carried(m, human.BONE_SPINE_03, human.BONE_PELVIS)))
        }
        // The head away from the fall, from where the chest carries it at
        // rest (the neck's frame is not the chest's: aimed as the chest,
        // the head was tucked by their difference too, 18 degrees more).
        physics.ragdoll_aim(m.ragdoll, human.BONE_NECK,
                            core.quat_mul(core.quat_rotate(0.0 - TUCK, across), carried(m, human.BONE_NECK, human.BONE_SPINE_03)))
    }
}

// Where `bone` would be in the world held at its rest pose to `by` as `by` is now.
carried(m: *Motion, bone: int, by: int) -> Quat {
    h = physics.ragdoll_human(m.ragdoll)
    by_now = physics.ragdoll_bone_rotation(m.ragdoll, by)
    by_rest = human.bone_at(h, by).reference_frame.q
    rest = human.bone_at(h, bone).reference_frame.q
    return core.quat_normalize(core.quat_mul(by_now, core.quat_mul(core.quat_conjugate(by_rest), rest)))
}

// A fixed step's recovery: every weakened bone a step's share closer to
// its full budget.
motion_step(m: *Motion, step: float) {
    if m.key_count > 0 {
        step_way(m, step)
        return
    }
    protect(m)
    if m.lying && m.writhe_left > 0.0 { writhe(m, step) }
    if m.mode == POWERED && m.stepping && !m.falling && !m.lying { balance(m, step) }
    if m.falling && m.step_leg >= 0 { end_step(m) }
    if m.mode != ANIMATED { settle(m) }
    if down(m) { m.down_seconds = m.down_seconds + step } else { m.down_seconds = 0.0 }
    if m.get_up_after > 0.0 && m.down_seconds >= m.get_up_after && m.mode != ANIMATED {
        get_up(m)
        return
    }
    weak = m.weakness as float[]
    changed = false
    i = 0
    while i < human.BONE_COUNT {
        if weak[i] > 0.0 {
            weak[i] = weak[i] - step / m.recovery
            if weak[i] < 0.0 { weak[i] = 0.0 }
            changed = true
        }
        i = i + 1
    }
    if changed { apply_budget(m) }
}

// Whether it has come to rest on the ground: its pelvis barely moving,
// step on step, for SETTLE_STEPS; and no longer, once it is off it.
settle(m: *Motion) {
    pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
    // Writhing, it has not settled: a get-up counts from when it stops.
    if m.writhe_left > 0.0 {
        m.last_pelvis = pelvis
        m.rest_steps = 0
        m.settled = false
        return
    }
    if core.v3_len(core.v3_sub(pelvis, m.last_pelvis)) < REST_MOVE { m.rest_steps = m.rest_steps + 1 } else { m.rest_steps = 0 }
    m.last_pelvis = pelvis
    if m.settled {
        if !on_ground(m) { m.settled = false }
    } else if m.rest_steps >= SETTLE_STEPS && on_ground(m) {
        m.settled = true
    }
}

// How far bone `index` is from the pose the animation gives it, relative to
// its parent, in radians: what its muscle answers for. (A figure that has
// been turned about the vertical is still on its pose; `tilt` is the lean.)
tracking_error(m: *Motion, index: int) -> float {
    return physics.ragdoll_joint_error(m.ragdoll, index)
}

// How far the figure leans from the upright its animation gives it, in
// radians.
tilt(m: *Motion) -> float {
    return physics.ragdoll_tilt(m.ragdoll)
}

// --- body parts (#573) ---------------------------------------------------------------------------------

// The bones of a part, first and count, in the human's order.
part_first(part: int) -> int {
    if part == PART_HEAD { return human.BONE_NECK }
    if part == PART_SPINE { return human.BONE_SPINE_01 }
    if part == PART_ARM_L { return human.BONE_UPPER_ARM_L }
    if part == PART_ARM_R { return human.BONE_UPPER_ARM_R }
    if part == PART_LEG_L { return human.BONE_THIGH_L }
    return human.BONE_THIGH_R
}

part_count(part: int) -> int {
    if part == PART_HEAD { return 1 }
    return 2
}

// A part let go (LIMP) or given back to the body's own mode (ANIMATED or
// POWERED, whichever the body is in): a crippled arm that hangs and swings
// from the shoulder while the figure walks its clip on, colliding as the
// ragdoll's arm does; or, powered, the arm with no muscle while the rest
// fights. False for another mode, or a part that is not one.
set_part_mode(m: *Motion, part: int, to: int) -> bool {
    if part < 0 || part >= PARTS { return false }
    limp = (m.part_limp as int[])[part]
    if to == LIMP {
        if limp == 1 { return true }
        (m.part_limp as int[])[part] = 1
    } else if to == ANIMATED || to == POWERED {
        if limp == 0 { return true }
        (m.part_limp as int[])[part] = 0
        // Drawn from where it hung back to its clip, not at once.
        i = part_first(part)
        while i < part_first(part) + part_count(part) {
            start_part_blend(m, i)
            i = i + 1
        }
    } else {
        return false
    }
    i = part_first(part)
    while i < part_first(part) + part_count(part) {
        physics.ragdoll_set_bone_limp(m.ragdoll, i, to == LIMP)
        if to == LIMP { physics.ragdoll_clear_aim(m.ragdoll, i) }
        i = i + 1
    }
    apply_budget(m)
    return true
}

// LIMP for a part let go, else the body's own mode.
part_mode(m: *Motion, part: int) -> int {
    if part < 0 || part >= PARTS { return m.mode }
    if (m.part_limp as int[])[part] == 1 { return LIMP }
    return m.mode
}

// A part's lasting share of its muscle, 0 to 1: an injury that holds
// through every blow and recovery until the game lifts it (#573).
set_part_strength(m: *Motion, part: int, share: float) {
    if part < 0 || part >= PARTS { return }
    if share < 0.0 { share = 0.0 }
    if share > 1.0 { share = 1.0 }
    i = part_first(part)
    while i < part_first(part) + part_count(part) {
        (m.part_strength as float[])[i] = share
        i = i + 1
    }
    apply_budget(m)
}

part_strength(m: *Motion, part: int) -> float {
    if part < 0 || part >= PARTS { return 1.0 }
    return (m.part_strength as float[])[part_first(part)]
}

// How much of a bone's offset from its clip is still drawn, 1 to 0: a part
// taken back from limp, easing back to its clip.
part_drawing_blend(m: *Motion, bone: int) -> float {
    if bone < 0 || bone >= human.BONE_COUNT { return 0.0 }
    return (m.drawn as float[])[bone * DRAWN_FLOATS + 12] / PART_BLEND
}

// A bone's drive as its part has it: scaled by the part's lasting share,
// and none for a limp part's. Every drive this module sets goes through
// here, so a blow, a recovery or the writhing never restores an injury.
set_drive(m: *Motion, bone: int, torque: float) {
    share = (m.part_strength as float[])[bone]
    if physics.ragdoll_bone_is_limp(m.ragdoll, bone) { share = 0.0 }
    physics.ragdoll_set_bone_drive(m.ragdoll, bone, torque * share)
}

// The offset a bone taken back is drawn under: from what this last wrote it
// at (where its body hung) to its clip, fading over PART_BLEND.
start_part_blend(m: *Motion, bone: int) {
    d = m.drawn as float[]
    at = bone * DRAWN_FLOATS
    if (m.drew as int[])[bone] == 0 { return }
    clip = core.quat(d[at], d[at + 1], d[at + 2], d[at + 3])
    wrote = core.quat(d[at + 4], d[at + 5], d[at + 6], d[at + 7])
    off = core.quat_normalize(core.quat_mul(wrote, core.quat_conjugate(clip)))
    d[at + 8] = off.x
    d[at + 9] = off.y
    d[at + 10] = off.z
    d[at + 11] = off.w
    d[at + 12] = PART_BLEND
}

// The pose phase, after the clip: a limp part of a figure that follows its
// clip drawn as its bodies hang, and a part taken back drawn under its
// fading offset. A bone nothing posed since this wrote it is given back
// what its clip last set, so a still pose is not taken for the clip's.
motion_pose(state: ptr, e: *Engine) {
    m = state as *Motion
    if m.mode != ANIMATED || m.key_count > 0 { return }
    d = m.drawn as float[]
    drew = m.drew as int[]
    delta = engine.engine_delta_time(e)
    i = 1
    while i < human.BONE_COUNT {
        at = i * DRAWN_FLOATS
        limp = physics.ragdoll_bone_is_limp(m.ragdoll, i)
        if limp || d[at + 12] > 0.0 {
            bone = physics.ragdoll_rig_bone(m.ragdoll, i)
            if bone != null {
                now = bone.rotation
                if drew[i] == 1 && now.x == d[at + 4] && now.y == d[at + 5] && now.z == d[at + 6] && now.w == d[at + 7] {
                    core.model_set_rotation(bone, core.quat(d[at], d[at + 1], d[at + 2], d[at + 3]))
                }
                clip = bone.rotation
                d[at] = clip.x
                d[at + 1] = clip.y
                d[at + 2] = clip.z
                d[at + 3] = clip.w
                if limp {
                    physics.ragdoll_draw_bone_from_body(m.ragdoll, i)
                    d[at + 12] = 0.0
                } else {
                    d[at + 12] = d[at + 12] - delta
                    if d[at + 12] < 0.0 { d[at + 12] = 0.0 }
                    u = 1.0 - d[at + 12] / PART_BLEND
                    left = 1.0 - u * u * (3.0 - 2.0 * u)
                    off = core.quat_slerp(core.quat_ident(), core.quat(d[at + 8], d[at + 9], d[at + 10], d[at + 11]), left)
                    core.model_set_rotation(bone, core.quat_normalize(core.quat_mul(off, clip)))
                }
                wrote = bone.rotation
                d[at + 4] = wrote.x
                d[at + 5] = wrote.y
                d[at + 6] = wrote.z
                d[at + 7] = wrote.w
                drew[i] = 1
            }
        } else {
            drew[i] = 0
        }
        i = i + 1
    }
}

motion_fixed(state: ptr, e: *Engine, step: float) {
    motion_step(state as *Motion, step)
}

// Stepped by the engine every fixed step.
attach(e: *Engine, m: *Motion) {
    b = engine.behaviour_new("motion", m as ptr)
    b.fixed_update = motion_fixed
    b.pose = motion_pose
    engine.engine_add_behaviour(e, b)
    m.engine = e as ptr
    m.stepper = b as ptr
}

// An active ragdoll let go of while its engine runs on: no longer stepped,
// out of the scene file's records, freed. (The ragdoll is physics's.) What
// the editor does when a simulation stops; a program that ends frees its
// motions after the engine, which frees their steps.
release(m: *Motion) {
    if m == null { return }
    if m.engine != null && m.stepper != null {
        engine.engine_remove_behaviour(m.engine as *Engine, m.stepper as *Behaviour)
        heap.free(m.stepper as *Behaviour)
        forget(m.engine as *Engine, m)
    }
    motion_free(m)
}

// Every active ragdoll put on a figure of the engine's, released.
motions_release(e: *Engine) {
    ms = motions_for(e)
    while list.size(ms.list) > 0 {
        release(list.get_raw(ms.list, 0) as *Motion)
    }
}

forget(e: *Engine, m: *Motion) {
    ms = motions_for(e)
    i = 0
    while i < list.size(ms.list) {
        if list.get_raw(ms.list, i) == m as ptr {
            list.remove(ms.list, i)
            return
        }
        i = i + 1
    }
}
