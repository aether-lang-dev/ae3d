// Skeletons and poses (#853, layer 0).
//
// A pose is the figure's joints' local transforms laid out flat, ten numbers a
// joint (translation, rotation, scale), indexed by the rig's joint order. Every
// stage of the animation pipeline reads poses and writes poses: clips sample
// into them, the graph blends them, IK corrects them in model space. Only at
// the end of the frame is one pose written to the figure's joints, by one
// writer. That is the rule a game engine's animation runs on (Unreal's pose
// buffers, Unity's Playables, ozz-animation): before it, every system here
// wrote the scene graph's bones directly and found the others by comparing
// floats.
//
// A rig is a skin's joints read once: their names, their parents, the order
// that puts parents first, and their rest pose. It also maps them onto one
// humanoid layout, the UE5 mannequin's (pelvis, spine_01, thigh_l...), from
// whichever naming the file uses (UE5, Blender's Rigify, Mixamo), so a clip
// made on one humanoid can be retargeted onto another and IK can find a leg
// without being told its bones' names.

import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.skin

exports (
    Rig, FLOATS,
    ROOT, PELVIS, SPINE_01, SPINE_02, SPINE_03, NECK, HEAD,
    CLAVICLE_L, UPPERARM_L, LOWERARM_L, HAND_L, CLAVICLE_R, UPPERARM_R, LOWERARM_R, HAND_R,
    THIGH_L, CALF_L, FOOT_L, BALL_L, THIGH_R, CALF_R, FOOT_R, BALL_R, FINGERS, SLOTS,
    SCHEME_NONE, SCHEME_UE5, SCHEME_RIGIFY, SCHEME_MIXAMO, SCHEME_BVH,
    of_skeleton, of_joints, rig_free, count, name, parent, find, joint, human, scheme, slot_name,
    order, rest, base_model,
    new, release, copy, rest_pose, read, apply,
    translation, rotation, scale, set_translation, set_rotation, set_scale,
    blend, blend_weighted, difference, add, add_weighted,
    world, local_rotation_of, mask, mask_free, subtree_contains, rest_world,
    mirror, mirror_of, mirror_normal
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

// Floats a joint takes in a pose: tx ty tz, qx qy qz qw, sx sy sz.
const FLOATS = 10

// The humanoid layout's slots, the UE5 mannequin's bones.
const ROOT = 0
const PELVIS = 1
const SPINE_01 = 2
const SPINE_02 = 3
const SPINE_03 = 4
const NECK = 5
const HEAD = 6
const CLAVICLE_L = 7
const UPPERARM_L = 8
const LOWERARM_L = 9
const HAND_L = 10
const CLAVICLE_R = 11
const UPPERARM_R = 12
const LOWERARM_R = 13
const HAND_R = 14
const THIGH_L = 15
const CALF_L = 16
const FOOT_L = 17
const BALL_L = 18
const THIGH_R = 19
const CALF_R = 20
const FOOT_R = 21
const BALL_R = 22
// The fingers after the body: side (left, right), finger (thumb, index,
// middle, ring, pinky), phalanx 1 to 3, at FINGERS + side * 15 + finger * 3
// + phalanx - 1.
const FINGERS = 23
const SLOTS = 53

const SCHEME_NONE = 0 - 1
const SCHEME_UE5 = 0
const SCHEME_RIGIFY = 1
const SCHEME_MIXAMO = 2
// Xsens MVN's naming, what its BVH files and the libraries captured with it
// (100STYLE) use: Hips, Chest to Chest4, LeftCollar, LeftShoulder...
const SCHEME_BVH = 3
const SCHEMES = 4

struct Name {
    text: string
}

struct Rig {
    count: int
    joints: ptr                    // *Model[count]: the skin's joints, borrowed
    names: ptr                     // list of the joints' names, owned copies
    parents: ptr                   // int[count]: each joint's parent, -1 for a top joint
    order: ptr                     // int[count]: the joints, every parent before its children
    rest: ptr                      // float[count * FLOATS]: the rest pose, as the file left the joints
    human: ptr                     // int[SLOTS]: the joint in each humanoid slot, -1 when none
    scheme: int                    // the naming the humanoid map was read from
    base: ptr                      // *Model the top joints hang from (the armature), or null
    mirrors: ptr                   // int[count]: each joint's other side's (itself on the middle line)
    rest_worlds: ptr               // float[count * FLOATS]: the rest pose in the rig's space
    across: Vec3                   // the figure's middle plane in the rig's space: its normal (left of the figure)
    middle: Vec3                   // and a point on it
}

// --- the rig ------------------------------------------------------------------------------------

// The rig of a skin: its joints in the skin's order, read as they stand now,
// which for a figure no clip has posed is the file's rest pose. Null for an
// empty skin.
of_skeleton(sk: *Skeleton) -> *Rig {
    n = skin.skeleton_count(sk)
    if n <= 0 { return null }
    r = heap.new(Rig)
    r.count = n
    r.joints = calloc(n, 8)
    r.names = list.new()
    r.parents = calloc(n, 4)
    r.order = calloc(n, 4)
    r.rest = calloc(n * FLOATS, 8)
    r.human = calloc(SLOTS, 4)
    joints = r.joints as ptr[]
    parents = r.parents as int[]
    i = 0
    while i < n {
        m = skin.skeleton_bone(sk, i)
        joints[i] = m as ptr
        nm = heap.new(Name)
        nm.text = string.copy(m.name)
        list.add_raw(r.names, nm as ptr)
        i = i + 1
    }
    i = 0
    while i < n {
        m = joints[i] as *Model
        parents[i] = 0 - 1
        up = core.model_parent(m)
        k = 0
        while k < n {
            if joints[k] == up as ptr { parents[i] = k }
            k = k + 1
        }
        if parents[i] < 0 && up != null { r.base = up as ptr }
        i = i + 1
    }
    sort_parents_first(r)
    read(r, r.rest)
    finish(r)
    return r
}

// A rig no skin wears: `n` joints named `names` (ptr[n] of string.keep references, copied),
// each under `parents[j]` (-1 for a top joint), at rest as `rest` (a pose's
// layout, copied). A motion capture's skeleton (a BVH file's), which takes
// are made on and retargeted from. Its space is the ground's: up is y.
of_joints(n: int, names: ptr, parents: int[], rest: ptr) -> *Rig {
    if n <= 0 { return null }
    r = heap.new(Rig)
    r.count = n
    r.joints = calloc(n, 8)
    r.names = list.new()
    r.parents = calloc(n, 4)
    r.order = calloc(n, 4)
    r.rest = calloc(n * FLOATS, 8)
    r.human = calloc(SLOTS, 4)
    own = r.parents as int[]
    i = 0
    while i < n {
        nm = heap.new(Name)
        given, _why = string.from_ptr((names as ptr[])[i])
        nm.text = string.copy(given)
        list.add_raw(r.names, nm as ptr)
        own[i] = parents[i]
        i = i + 1
    }
    copy(r, rest, r.rest)
    sort_parents_first(r)
    finish(r)
    return r
}

// What a rig works out once its joints and rest pose are known: its humanoid
// map, its rest pose in its own space, and its mirror.
finish(r: *Rig) {
    map_humanoid(r)
    r.rest_worlds = calloc(r.count * FLOATS, 8)
    world(r, r.rest, r.rest_worlds)
    r.mirrors = calloc(r.count, 4)
    map_mirrors(r)
}

rig_free(r: *Rig) {
    if r == null { return }
    i = 0
    while i < list.size(r.names) {
        nm = list.get_raw(r.names, i) as *Name
        string.free(nm.text)
        heap.free(nm)
        i = i + 1
    }
    list.free(r.names)
    free(r.joints)
    free(r.parents)
    free(r.order)
    free(r.rest)
    free(r.human)
    free(r.mirrors)
    free(r.rest_worlds)
    heap.free(r)
}

// The joints in an order that puts every parent before its children: a
// joint's depth first, then its index. A skin need not list them so.
sort_parents_first(r: *Rig) {
    n = r.count
    parents = r.parents as int[]
    order = r.order as int[]
    depth = calloc(n, 4) as int[]
    deepest = 0
    i = 0
    while i < n {
        d = 0
        p = parents[i]
        while p >= 0 && d <= n {
            d = d + 1
            p = parents[p]
        }
        depth[i] = d
        if d > deepest { deepest = d }
        i = i + 1
    }
    at = 0
    d = 0
    while d <= deepest {
        i = 0
        while i < n {
            if depth[i] == d {
                order[at] = i
                at = at + 1
            }
            i = i + 1
        }
        d = d + 1
    }
    free(depth as ptr)
}

count(r: *Rig) -> int { return r.count }
name(r: *Rig, j: int) -> string { return (list.get_raw(r.names, j) as *Name).text }
parent(r: *Rig, j: int) -> int { return (r.parents as int[])[j] }
joint(r: *Rig, j: int) -> *Model { return (r.joints as ptr[])[j] as *Model }
order(r: *Rig, at: int) -> int { return (r.order as int[])[at] }
rest(r: *Rig) -> ptr { return r.rest }
base_model(r: *Rig) -> *Model { return r.base as *Model }
scheme(r: *Rig) -> int { return r.scheme }

// The joint named `wanted`, or -1.
find(r: *Rig, wanted: string) -> int {
    i = 0
    while i < r.count {
        if string.equals((list.get_raw(r.names, i) as *Name).text, wanted) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// The joint in humanoid slot `slot`, or -1 when the rig has none there.
human(r: *Rig, slot: int) -> int {
    if slot < 0 || slot >= SLOTS { return 0 - 1 }
    return (r.human as int[])[slot]
}

// --- the humanoid map -----------------------------------------------------------------------------

// The name a slot's bone has in `scheme`, made for this call (the caller
// frees it); "" where the scheme has no such bone.
slot_name(sch: int, slot: int) -> string {
    if slot >= FINGERS { return finger_name(sch, slot) }
    if sch == SCHEME_UE5 {
        ue = ["root", "pelvis", "spine_01", "spine_02", "spine_03", "neck_01", "head",
              "clavicle_l", "upperarm_l", "lowerarm_l", "hand_l", "clavicle_r", "upperarm_r", "lowerarm_r", "hand_r",
              "thigh_l", "calf_l", "foot_l", "ball_l", "thigh_r", "calf_r", "foot_r", "ball_r"]
        return string.copy(ue[slot])
    }
    if sch == SCHEME_RIGIFY {
        rigify = ["root", "DEF-hips", "DEF-spine.001", "DEF-spine.002", "DEF-spine.003", "DEF-neck", "DEF-head",
                  "DEF-shoulder.L", "DEF-upper_arm.L", "DEF-forearm.L", "DEF-hand.L",
                  "DEF-shoulder.R", "DEF-upper_arm.R", "DEF-forearm.R", "DEF-hand.R",
                  "DEF-thigh.L", "DEF-shin.L", "DEF-foot.L", "DEF-toe.L", "DEF-thigh.R", "DEF-shin.R", "DEF-foot.R", "DEF-toe.R"]
        return string.copy(rigify[slot])
    }
    if sch == SCHEME_MIXAMO {
        mixamo = ["", "Hips", "Spine", "Spine1", "Spine2", "Neck", "Head",
                  "LeftShoulder", "LeftArm", "LeftForeArm", "LeftHand", "RightShoulder", "RightArm", "RightForeArm", "RightHand",
                  "LeftUpLeg", "LeftLeg", "LeftFoot", "LeftToeBase", "RightUpLeg", "RightLeg", "RightFoot", "RightToeBase"]
        return string.copy(mixamo[slot])
    }
    if sch == SCHEME_BVH {
        // Four chest bones over three spine slots: the one the collars hang
        // from is spine_03, and Chest3's turn rides into it in the rig's space.
        bvh = ["", "Hips", "Chest", "Chest2", "Chest4", "Neck", "Head",
               "LeftCollar", "LeftShoulder", "LeftElbow", "LeftWrist", "RightCollar", "RightShoulder", "RightElbow", "RightWrist",
               "LeftHip", "LeftKnee", "LeftAnkle", "LeftToe", "RightHip", "RightKnee", "RightAnkle", "RightToe"]
        return string.copy(bvh[slot])
    }
    return string.copy("")
}

finger_name(sch: int, slot: int) -> string {
    k = slot - FINGERS
    side = k / 15
    finger = (k - side * 15) / 3
    phalanx = k - side * 15 - finger * 3 + 1
    ue = ["thumb", "index", "middle", "ring", "pinky"]
    title = ["Thumb", "Index", "Middle", "Ring", "Pinky"]
    number = string.from_int(phalanx)
    out = ""
    if sch == SCHEME_UE5 {
        lr = "_l"
        if side == 1 { lr = "_r" }
        out = string.concat(ue[finger], string.concat("_0", string.concat(number, lr)))
    } else if sch == SCHEME_RIGIFY {
        lr = ".L"
        if side == 1 { lr = ".R" }
        stem = "DEF-f_"
        if finger == 0 { stem = "DEF-" }
        out = string.concat(stem, string.concat(ue[finger], string.concat(".0", string.concat(number, lr))))
    } else if sch == SCHEME_MIXAMO {
        hand = "LeftHand"
        if side == 1 { hand = "RightHand" }
        out = string.concat(hand, string.concat(title[finger], number))
    } else {
        out = string.copy("")
    }
    string.free(number)
    return out
}

// A joint's name with any "prefix:" before it taken off (Mixamo's
// "mixamorig:"), and compared with no regard to case: UAL2's mannequin
// names its head "Head" where UE5's says "head".
same_name(joint_name: string, wanted: string) -> bool {
    if string.length(wanted) == 0 { return false }
    bare = joint_name
    colon = string.index_of(joint_name, ":")
    owned = false
    if colon >= 0 {
        bare = string.substring(joint_name, colon + 1, string.length(joint_name))
        owned = true
    }
    a = string.to_lower(bare)
    b = string.to_lower(wanted)
    same = string.equals(a, b) == 1
    string.free(a)
    string.free(b)
    if owned { string.free(bare) }
    return same
}

// The humanoid slots filled from whichever scheme names the most of the
// body's 23 bones.
map_humanoid(r: *Rig) {
    human = r.human as int[]
    best = SCHEME_NONE
    best_found = 0
    sch = 0
    while sch < SCHEMES {
        found = 0
        slot = 0
        while slot < FINGERS {
            wanted = slot_name(sch, slot)
            if find_like(r, wanted) >= 0 { found = found + 1 }
            string.free(wanted)
            slot = slot + 1
        }
        if found > best_found {
            best_found = found
            best = sch
        }
        sch = sch + 1
    }
    r.scheme = best
    slot = 0
    while slot < SLOTS {
        human[slot] = 0 - 1
        if best >= 0 {
            wanted = slot_name(best, slot)
            human[slot] = find_like(r, wanted)
            string.free(wanted)
        }
        slot = slot + 1
    }
}

find_like(r: *Rig, wanted: string) -> int {
    i = 0
    while i < r.count {
        if same_name((list.get_raw(r.names, i) as *Name).text, wanted) { return i }
        i = i + 1
    }
    return 0 - 1
}

// --- the mirror -----------------------------------------------------------------------------------

// Each joint's other side, by its name with left and right swapped
// (thigh_l and thigh_r, DEF-hand.L and DEF-hand.R, LeftArm and RightArm),
// itself where no joint has that name; and the figure's middle plane,
// halfway between its thighs at rest, across the line joining them (the
// rig's x where it has no thighs).
map_mirrors(r: *Rig) {
    m = r.mirrors as int[]
    i = 0
    while i < r.count {
        m[i] = i
        other = swapped_side(name(r, i))
        if string.length(other) > 0 {
            k = find(r, other)
            if k >= 0 { m[i] = k }
        }
        string.free(other)
        i = i + 1
    }
    r.across = core.vec3(1.0, 0.0, 0.0)
    r.middle = core.vec3(0.0, 0.0, 0.0)
    left = human(r, THIGH_L)
    right = human(r, THIGH_R)
    if left >= 0 && right >= 0 {
        a = translation(r.rest_worlds, left)
        b = translation(r.rest_worlds, right)
        d = core.v3_sub(a, b)
        if core.v3_len(d) > 0.000001 {
            r.across = core.v3_normalize(d)
            r.middle = core.v3_mul(core.v3_add(a, b), 0.5)
        }
    }
}

// `n` with its side swapped, made for this call; "" when it names no side.
swapped_side(n: string) -> string {
    ends = ["_l", "_r", "_L", "_R", ".L", ".R", ".l", ".r"]
    other_ends = ["_r", "_l", "_R", "_L", ".R", ".L", ".r", ".l"]
    size = string.length(n)
    k = 0
    while k < 8 {
        if size > 2 && string.ends_with(n, ends[k]) == 1 {
            stem = string.substring(n, 0, size - 2)
            out = string.concat(stem, other_ends[k])
            string.free(stem)
            return out
        }
        k = k + 1
    }
    sides = ["Left", "Right", "left", "right"]
    others = ["Right", "Left", "right", "left"]
    k = 0
    while k < 4 {
        at = string.index_of(n, sides[k])
        if at >= 0 {
            before = string.substring(n, 0, at)
            after = string.substring(n, at + string.length(sides[k]), size)
            middle = string.concat(before, others[k])
            out = string.concat(middle, after)
            string.free(before)
            string.free(after)
            string.free(middle)
            return out
        }
        k = k + 1
    }
    return string.copy("")
}

// The joint on `j`'s other side (`j` on the middle line).
mirror_of(r: *Rig, j: int) -> int { return (r.mirrors as int[])[j] }

// The figure's middle plane's normal in the rig's space, toward its left.
mirror_normal(r: *Rig) -> Vec3 { return r.across }

// `p` mirrored across the figure's middle into `out` (which may be `p`), as
// Unreal's mirror tables do it: each joint's turn from its rest pose in the
// rig's space, reflected, is given to the joint on its other side, and every
// joint's place is reflected. Turns are mirrored from the rest pose, not as
// they stand, because a left and a right bone's own axes are not each
// other's reflection (the reflection of a right-handed frame is
// left-handed). A walk that leads with its left foot comes out leading with
// its right, and a turn to the left a turn to the right. Mirrored twice, a
// pose is itself again.
mirror(r: *Rig, p: ptr, out: ptr) {
    n = r.count
    worlds = calloc(n * FLOATS, 8)
    world(r, p, worlds)
    flipped = calloc(n * FLOATS, 8)
    mirrors = r.mirrors as int[]
    j = 0
    while j < n {
        c = mirrors[j]
        turn = core.quat_mul(rotation(worlds, j), core.quat_conjugate(rotation(r.rest_worlds, j)))
        set_rotation(flipped, c, core.quat_normalize(core.quat_mul(reflect_turn(r, turn), rotation(r.rest_worlds, c))))
        set_translation(flipped, c, reflect_point(r, translation(worlds, j)))
        set_scale(flipped, c, scale(worlds, j))
        j = j + 1
    }
    // Back into each joint's parent's frame.
    parents = r.parents as int[]
    local = calloc(n * FLOATS, 8)
    c = 0
    while c < n {
        up = parents[c]
        set_scale(local, c, scale(p, mirrors[c]))
        if up < 0 {
            set_translation(local, c, translation(flipped, c))
            set_rotation(local, c, rotation(flipped, c))
        } else {
            back = core.quat_conjugate(rotation(flipped, up))
            ps = scale(flipped, up)
            d = core.quat_apply(back, core.v3_sub(translation(flipped, c), translation(flipped, up)))
            set_translation(local, c, core.vec3(ratio(d.x, ps.x), ratio(d.y, ps.y), ratio(d.z, ps.z)))
            set_rotation(local, c, core.quat_normalize(core.quat_mul(back, rotation(flipped, c))))
        }
        c = c + 1
    }
    copy(r, local, out)
    free(worlds)
    free(flipped)
    free(local)
}

// A turn reflected in the middle plane: its axis reflected and its angle
// reversed (a reflection of a turn about a line across the plane is the
// same turn; about a line in it, the opposite one).
reflect_turn(r: *Rig, q: Quat) -> Quat {
    n = r.across
    d = q.x * n.x + q.y * n.y + q.z * n.z
    return core.quat(0.0 - (q.x - 2.0 * d * n.x), 0.0 - (q.y - 2.0 * d * n.y), 0.0 - (q.z - 2.0 * d * n.z), q.w)
}

reflect_point(r: *Rig, x: Vec3) -> Vec3 {
    n = r.across
    d = core.v3_dot(core.v3_sub(x, r.middle), n)
    return core.v3_sub(x, core.v3_mul(n, 2.0 * d))
}

// --- poses ----------------------------------------------------------------------------------------

new(r: *Rig) -> ptr {
    p = calloc(r.count * FLOATS, 8)
    copy(r, r.rest, p)
    return p
}

release(p: ptr) { if p != null { free(p) } }

copy(r: *Rig, from: ptr, to: ptr) {
    a = from as float[]
    b = to as float[]
    i = 0
    while i < r.count * FLOATS {
        b[i] = a[i]
        i = i + 1
    }
}

rest_pose(r: *Rig, out: ptr) { copy(r, r.rest, out) }

// The joints' local transforms as they stand, into `out` (the rest pose
// for a rig no skin wears).
read(r: *Rig, out: ptr) {
    joints = r.joints as ptr[]
    i = 0
    while i < r.count {
        m = joints[i] as *Model
        if m != null {
            set_translation(out, i, m.position)
            set_rotation(out, i, m.rotation)
            set_scale(out, i, m.scale)
        } else if out != r.rest {
            copy_joint(r.rest, out, i)
        }
        i = i + 1
    }
}

copy_joint(from: ptr, to: ptr, j: int) {
    a = from as float[]
    b = to as float[]
    k = 0
    while k < FLOATS {
        b[j * FLOATS + k] = a[j * FLOATS + k]
        k = k + 1
    }
}

// `p` written to the joints: the frame's one write. Nothing for a rig no
// skin wears.
apply(r: *Rig, p: ptr) {
    joints = r.joints as ptr[]
    i = 0
    while i < r.count {
        m = joints[i] as *Model
        if m != null {
            t = translation(p, i)
            s = scale(p, i)
            core.model_set_position(m, t.x, t.y, t.z)
            core.model_set_rotation(m, rotation(p, i))
            core.model_set_scale(m, s.x, s.y, s.z)
        }
        i = i + 1
    }
}

translation(p: ptr, j: int) -> Vec3 {
    f = p as float[]
    at = j * FLOATS
    return core.vec3(f[at], f[at + 1], f[at + 2])
}

rotation(p: ptr, j: int) -> Quat {
    f = p as float[]
    at = j * FLOATS + 3
    return core.quat(f[at], f[at + 1], f[at + 2], f[at + 3])
}

scale(p: ptr, j: int) -> Vec3 {
    f = p as float[]
    at = j * FLOATS + 7
    return core.vec3(f[at], f[at + 1], f[at + 2])
}

set_translation(p: ptr, j: int, v: Vec3) {
    f = p as float[]
    at = j * FLOATS
    f[at] = v.x
    f[at + 1] = v.y
    f[at + 2] = v.z
}

set_rotation(p: ptr, j: int, q: Quat) {
    f = p as float[]
    at = j * FLOATS + 3
    f[at] = q.x
    f[at + 1] = q.y
    f[at + 2] = q.z
    f[at + 3] = q.w
}

set_scale(p: ptr, j: int, v: Vec3) {
    f = p as float[]
    at = j * FLOATS + 7
    f[at] = v.x
    f[at + 1] = v.y
    f[at + 2] = v.z
}

// --- blending -------------------------------------------------------------------------------------

// `out` = `a` turned `w` of the way to `b`, joint by joint: translations and
// scales lerped, rotations nlerped on the nearer hemisphere (what engines blend
// with: within the few tens of degrees two poses of one motion differ by it is
// the slerp to a fraction of a degree, and it commutes with weights). `out` may
// be `a` or `b`.
blend(r: *Rig, a: ptr, b: ptr, w: float, out: ptr) {
    j = 0
    while j < r.count {
        blend_joint(a, b, j, w, out)
        j = j + 1
    }
}

// As blend, each joint by `w` times its weight in `weights` (float[count], a
// mask): an upper body played over the legs.
blend_weighted(r: *Rig, a: ptr, b: ptr, weights: ptr, w: float, out: ptr) {
    mw = weights as float[]
    j = 0
    while j < r.count {
        blend_joint(a, b, j, w * mw[j], out)
        j = j + 1
    }
}

blend_joint(a: ptr, b: ptr, j: int, w: float, out: ptr) {
    fa = a as float[]
    fb = b as float[]
    fo = out as float[]
    at = j * FLOATS
    if w <= 0.0 {
        if a != out {
            k = 0
            while k < FLOATS {
                fo[at + k] = fa[at + k]
                k = k + 1
            }
        }
        return
    }
    if w >= 1.0 {
        if b != out {
            k = 0
            while k < FLOATS {
                fo[at + k] = fb[at + k]
                k = k + 1
            }
        }
        return
    }
    k = 0
    while k < 3 {
        fo[at + k] = fa[at + k] + (fb[at + k] - fa[at + k]) * w
        fo[at + 7 + k] = fa[at + 7 + k] + (fb[at + 7 + k] - fa[at + 7 + k]) * w
        k = k + 1
    }
    d = fa[at + 3] * fb[at + 3] + fa[at + 4] * fb[at + 4] + fa[at + 5] * fb[at + 5] + fa[at + 6] * fb[at + 6]
    sign = 1.0
    if d < 0.0 { sign = 0.0 - 1.0 }
    x = fa[at + 3] + (sign * fb[at + 3] - fa[at + 3]) * w
    y = fa[at + 4] + (sign * fb[at + 4] - fa[at + 4]) * w
    z = fa[at + 5] + (sign * fb[at + 5] - fa[at + 5]) * w
    qw = fa[at + 6] + (sign * fb[at + 6] - fa[at + 6]) * w
    length = core.sqrt_of(x * x + y * y + z * z + qw * qw)
    if length < 0.000000001 { length = 1.0 }
    fo[at + 3] = x / length
    fo[at + 4] = y / length
    fo[at + 5] = z / length
    fo[at + 6] = qw / length
}

// The additive difference of `p` over `base`, into `out`: per joint, the
// translation's difference, the rotation's turn from the base
// (conj(base) * p, in the joint's own frame) and the scale's ratio. A hit
// flinch or a breath made as a clip, played over whatever the figure does.
difference(r: *Rig, p: ptr, base: ptr, out: ptr) {
    j = 0
    while j < r.count {
        set_translation(out, j, core.v3_sub(translation(p, j), translation(base, j)))
        set_rotation(out, j, core.quat_normalize(core.quat_mul(core.quat_conjugate(rotation(base, j)), rotation(p, j))))
        bs = scale(base, j)
        ps = scale(p, j)
        set_scale(out, j, core.vec3(ratio(ps.x, bs.x), ratio(ps.y, bs.y), ratio(ps.z, bs.z)))
        j = j + 1
    }
}

ratio(a: float, b: float) -> float {
    if core.abs_of(b) < 0.000000001 { return 1.0 }
    return a / b
}

// `delta` (a difference) laid `w` deep over `base`, into `out`.
add(r: *Rig, base: ptr, delta: ptr, w: float, out: ptr) {
    j = 0
    while j < r.count {
        add_joint(base, delta, j, w, out)
        j = j + 1
    }
}

add_weighted(r: *Rig, base: ptr, delta: ptr, weights: ptr, w: float, out: ptr) {
    mw = weights as float[]
    j = 0
    while j < r.count {
        add_joint(base, delta, j, w * mw[j], out)
        j = j + 1
    }
}

add_joint(base: ptr, delta: ptr, j: int, w: float, out: ptr) {
    t = core.v3_add(translation(base, j), core.v3_mul(translation(delta, j), w))
    q = core.quat_normalize(core.quat_mul(rotation(base, j), core.quat_slerp(core.quat_ident(), rotation(delta, j), w)))
    bs = scale(base, j)
    ds = scale(delta, j)
    s = core.vec3(bs.x * (1.0 + (ds.x - 1.0) * w), bs.y * (1.0 + (ds.y - 1.0) * w), bs.z * (1.0 + (ds.z - 1.0) * w))
    set_translation(out, j, t)
    set_rotation(out, j, q)
    set_scale(out, j, s)
}

// --- model space ----------------------------------------------------------------------------------

// Every joint's transform in the rig's space (the armature's, where the top
// joints hang), into `out` (a pose's layout): parents first, a child's
// translation turned and scaled by its parent's.
world(r: *Rig, p: ptr, out: ptr) {
    parents = r.parents as int[]
    order = r.order as int[]
    at = 0
    while at < r.count {
        j = order[at]
        up = parents[j]
        if up < 0 {
            set_translation(out, j, translation(p, j))
            set_rotation(out, j, rotation(p, j))
            set_scale(out, j, scale(p, j))
        } else {
            ps = scale(out, up)
            t = translation(p, j)
            local = core.vec3(t.x * ps.x, t.y * ps.y, t.z * ps.z)
            set_translation(out, j, core.v3_add(translation(out, up), core.quat_apply(rotation(out, up), local)))
            set_rotation(out, j, core.quat_normalize(core.quat_mul(rotation(out, up), rotation(p, j))))
            s = scale(p, j)
            set_scale(out, j, core.vec3(s.x * ps.x, s.y * ps.y, s.z * ps.z))
        }
        at = at + 1
    }
}

// The local rotation that gives joint `j` the rig-space rotation `wanted`
// under the rig-space pose `worlds`: what IK writes back.
local_rotation_of(r: *Rig, worlds: ptr, j: int, wanted: Quat) -> Quat {
    up = (r.parents as int[])[j]
    if up < 0 { return core.quat_normalize(wanted) }
    return core.quat_normalize(core.quat_mul(core.quat_conjugate(rotation(worlds, up)), wanted))
}

// The rest pose in the rig's space, into `out`.
rest_world(r: *Rig, out: ptr) { world(r, r.rest, out) }

// --- masks ----------------------------------------------------------------------------------------

// A mask (float[count]): `weight` on joint `from` and every joint under it,
// 0 elsewhere. An upper body is the mask of spine_01.
mask(r: *Rig, from: int, weight: float) -> ptr {
    m = calloc(r.count, 8)
    w = m as float[]
    j = 0
    while j < r.count {
        if from >= 0 && subtree_contains(r, from, j) { w[j] = weight }
        j = j + 1
    }
    return m
}

mask_free(m: ptr) { if m != null { free(m) } }

// Whether `j` is `top` or under it.
subtree_contains(r: *Rig, top: int, j: int) -> bool {
    parents = r.parents as int[]
    at = j
    steps = 0
    while at >= 0 && steps <= r.count {
        if at == top { return true }
        at = parents[at]
        steps = steps + 1
    }
    return false
}
