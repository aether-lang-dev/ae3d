#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Records { uint record[]; };
layout(std430, set = 0, binding = 1) readonly buffer Instances { float instance[]; };
layout(std430, set = 0, binding = 2) buffer Commands { uint command[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Visible { uvec4 visible[]; };
layout(std430, set = 0, binding = 4) buffer Counters { uint counter[]; };
// The view: its six planes (inside where dot(normal, p) + w >= -radius),
// the eye and the pixels a unit spans a unit away, then the error a cut
// may make on the screen, in pixels, and the nearest distance measured.
layout(std430, set = 0, binding = 5) readonly buffer View { vec4 view[]; };

layout(push_constant) uniform Params {
    mat4 model;
    uint firstCluster;
    uint clusterCount;
    uint firstInstance;
    uint instanced;
    uint firstCommand;
    uint materials;
    uint commandCount;
    uint budget;
    uint visibleCapacity;
} params;

const uint WORDS = 20u;

vec4 sphereAt(uint at) {
    return vec4(uintBitsToFloat(record[at]), uintBitsToFloat(record[at + 1u]),
                uintBitsToFloat(record[at + 2u]), uintBitsToFloat(record[at + 3u]));
}

// An error in the model's units, at a sphere, as pixels on the screen: by
// the sphere's nearest point to the eye, so a cluster is never judged
// further than any of it is.
float onScreen(mat4 m, float scale, vec4 sphere, float error) {
    vec3 centre = (m * vec4(sphere.xyz, 1.0)).xyz;
    float d = max(distance(centre, view[6].xyz) - sphere.w * scale, view[7].y);
    return error * scale / d * view[6].w;
}

void main() {
    uint k = gl_GlobalInvocationID.x;
    uint i = params.firstInstance + gl_GlobalInvocationID.y;
    mat4 m = params.model;
    if (params.instanced != 0u) {
        uint at = i * 20u;
        m = m * mat4(instance[at], instance[at + 1u], instance[at + 2u], instance[at + 3u],
                     instance[at + 4u], instance[at + 5u], instance[at + 6u], instance[at + 7u],
                     instance[at + 8u], instance[at + 9u], instance[at + 10u], instance[at + 11u],
                     instance[at + 12u], instance[at + 13u], instance[at + 14u], instance[at + 15u]);
    }
    // The instance's commands, one a material: the draw it is reads its
    // own instance, and starts empty (the frame filled them with zero).
    if (k == 0u) {
        for (uint g = 0u; g < params.materials; g++) {
            uint c = (params.firstCommand + gl_GlobalInvocationID.y * params.materials + g) * 5u;
            command[c + 1u] = 1u;
            command[c + 3u] = 0u;
            command[c + 4u] = i;
        }
    }
    if (k >= params.clusterCount) return;
    uint cluster = params.firstCluster + k;
    uint at = cluster * WORDS;
    float scale = sqrt(max(dot(m[0].xyz, m[0].xyz), max(dot(m[1].xyz, m[1].xyz), dot(m[2].xyz, m[2].xyz))));
    float tau = view[7].x;
    if (onScreen(m, scale, sphereAt(at + 8u), uintBitsToFloat(record[at + 12u])) > tau) return;
    if (onScreen(m, scale, sphereAt(at + 13u), uintBitsToFloat(record[at + 17u])) <= tau) return;
    vec4 own = sphereAt(at + 4u);
    vec3 centre = (m * vec4(own.xyz, 1.0)).xyz;
    float radius = own.w * scale;
    for (uint p = 0u; p < 6u; p++) {
        if (dot(view[p].xyz, centre) + view[p].w < -radius) return;
    }
    uint slot = atomicAdd(counter[0], 1u);
    if (slot >= params.visibleCapacity) return;
    uint draw = params.firstCommand + gl_GlobalInvocationID.y * params.materials + record[at + 19u];
    uint offset = atomicAdd(command[draw * 5u], record[at + 3u] * 3u);
    visible[slot] = uvec4(cluster, draw, offset, 0u);
}
