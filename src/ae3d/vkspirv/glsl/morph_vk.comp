#version 450

layout(local_size_x = 64) in;

struct Active {
    uint target;
    float weight;
};

layout(std430, set = 0, binding = 0) readonly buffer BindVertices { float bindVertex[]; };
layout(std430, set = 0, binding = 1) readonly buffer Deltas { vec4 delta[]; };
layout(std430, set = 0, binding = 2) readonly buffer Actives { Active weighed[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Morphed { float morphed[]; };

layout(push_constant) uniform MorphParams {
    uint vertexCount;
    uint activeCount;
} params;

void main() {
    uint v = gl_GlobalInvocationID.x;
    if (v >= params.vertexCount) return;
    uint at = v * 9u;
    vec3 p = vec3(bindVertex[at], bindVertex[at + 1u], bindVertex[at + 2u]);
    vec3 n = vec3(bindVertex[at + 5u], bindVertex[at + 6u], bindVertex[at + 7u]);
    for (uint k = 0u; k < params.activeCount; k++) {
        // (`active` itself is a word GLSL keeps for itself.)
        uint d = (weighed[k].target * params.vertexCount + v) * 2u;
        float w = weighed[k].weight;
        p += w * delta[d].xyz;
        n += w * delta[d + 1u].xyz;
    }
    float len = length(n);
    if (len > 0.0) n = n / len;
    morphed[at] = p.x;
    morphed[at + 1u] = p.y;
    morphed[at + 2u] = p.z;
    morphed[at + 3u] = bindVertex[at + 3u];
    morphed[at + 4u] = bindVertex[at + 4u];
    morphed[at + 5u] = n.x;
    morphed[at + 6u] = n.y;
    morphed[at + 7u] = n.z;
    morphed[at + 8u] = bindVertex[at + 8u];
}
