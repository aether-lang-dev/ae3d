// ae3d.vkspirv -- the Vulkan backend's shaders as SPIR-V (#402), GENERATED by
// tools/generate_shaders.ae from the GLSL in ae3d.shaders: do not edit. code(shader) is
// a fresh copy of a shader's words, four-byte aligned as a shader module
// takes them, for the caller to free; bytes(shader) is its size.

exports (
    SCENE_VERT,
    SCENE_FRAG,
    SCENE_RQ_FRAG,
    CROWD_SORT_COMP,
    SKIN_COMP,
    DEPTH_VERT,
    DEPTH_FRAG,
    SKY_VERT,
    SKY_FRAG,
    SCREEN_VERT,
    COMPOSITE_FRAG,
    FXAA_FRAG,
    COLOR_RESOLVE_FRAG,
    SSR_FRAG,
    SSAO_FRAG,
    DEPTH_RESOLVE_FRAG,
    DEPTH_COPY_FRAG,
    TAA_FRAG,
    WATER_VERT,
    WATER_FRAG,
    CROWD_VERT,
    CROWD_DEPTH_VERT,
    OVERLAY_VERT,
    OVERLAY_FRAG,
    code, bytes
)

extern malloc(n: long) -> ptr
extern memcpy(dst: ptr, src: int[], n: long) -> ptr

const SCENE_VERT = 0
const SCENE_FRAG = 1
const SCENE_RQ_FRAG = 2
const CROWD_SORT_COMP = 3
const SKIN_COMP = 4
const DEPTH_VERT = 5
const DEPTH_FRAG = 6
const SKY_VERT = 7
const SKY_FRAG = 8
const SCREEN_VERT = 9
const COMPOSITE_FRAG = 10
const FXAA_FRAG = 11
