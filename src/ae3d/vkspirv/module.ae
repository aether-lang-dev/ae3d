const CROWD_DEPTH_VERT = 20
const OVERLAY_VERT = 21
const OVERLAY_FRAG = 22

// The words of `shader`, copied; null for a shader there is none of.
code(shader: int) -> ptr {
    if shader == SCENE_VERT { return scene_vert() }
    if shader == SCENE_FRAG { return scene_frag() }
    if shader == SCENE_RQ_FRAG { return scene_rq_frag() }
    if shader == CROWD_SORT_COMP { return crowd_sort_comp() }
    if shader == DEPTH_VERT { return depth_vert() }
    if shader == DEPTH_FRAG { return depth_frag() }
    if shader == SKY_VERT { return sky_vert() }
    if shader == SKY_FRAG { return sky_frag() }
    if shader == SCREEN_VERT { return screen_vert() }
    if shader == PASSTHROUGH_FRAG { return passthrough_frag() }
    if shader == FXAA_FRAG { return fxaa_frag() }
    if shader == BLOOM_FRAG { return bloom_frag() }
    if shader == SSR_FRAG { return ssr_frag() }
    if shader == SSAO_FRAG { return ssao_frag() }
    if shader == DEPTH_RESOLVE_FRAG { return depth_resolve_frag() }
    if shader == DEPTH_COPY_FRAG { return depth_copy_frag() }
    if shader == TAA_FRAG { return taa_frag() }
    if shader == WATER_VERT { return water_vert() }
    if shader == WATER_FRAG { return water_frag() }
    if shader == CROWD_VERT { return crowd_vert() }
    if shader == CROWD_DEPTH_VERT { return crowd_depth_vert() }
    if shader == OVERLAY_VERT { return overlay_vert() }
    if shader == OVERLAY_FRAG { return overlay_frag() }
    return null
}

// The size of `shader` in bytes; 0 for a shader there is none of.
bytes(shader: int) -> int {
    if shader == SCENE_VERT { return 18852 }
    if shader == SCENE_FRAG { return 82168 }
    if shader == SCENE_RQ_FRAG { return 93020 }
    if shader == CROWD_SORT_COMP { return 14004 }
    if shader == DEPTH_VERT { return 16060 }
    if shader == DEPTH_FRAG { return 9028 }
    if shader == SKY_VERT { return 10308 }
    if shader == SKY_FRAG { return 33000 }
    if shader == SCREEN_VERT { return 9796 }
    if shader == PASSTHROUGH_FRAG { return 9372 }
    if shader == FXAA_FRAG { return 15316 }
    if shader == BLOOM_FRAG { return 11656 }
    if shader == SSR_FRAG { return 22284 }
    if shader == SSAO_FRAG { return 19236 }
    if shader == DEPTH_RESOLVE_FRAG { return 10176 }
    if shader == DEPTH_COPY_FRAG { return 9600 }
    if shader == TAA_FRAG { return 12988 }
    if shader == WATER_VERT { return 20588 }
    if shader == WATER_FRAG { return 53612 }
    if shader == CROWD_VERT { return 21712 }
    if shader == CROWD_DEPTH_VERT { return 15320 }
    if shader == OVERLAY_VERT { return 1664 }
    if shader == OVERLAY_FRAG { return 2112 }
    return 0
}

