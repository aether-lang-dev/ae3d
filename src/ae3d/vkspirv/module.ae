// ae3d.vkspirv -- the Vulkan backend's shaders as SPIR-V (#402), GENERATED by
// tools/generate_shaders.ae from the GLSL in ae3d.shaders: do not edit. code(shader) is
// a fresh copy of a shader's words, four-byte aligned as a shader module
// takes them, for the caller to free; bytes(shader) is its size.

exports (
    SCENE_VERT,
    SCENE_FRAG,
    SCENE_RQ_FRAG,
    CROWD_SORT_COMP,
    DEPTH_VERT,
    DEPTH_FRAG,
    SKY_VERT,
    SKY_FRAG,
    SCREEN_VERT,
    PASSTHROUGH_FRAG,
    FXAA_FRAG,
    BLOOM_FRAG,
    SSR_FRAG,
    SSAO_FRAG,
    DEPTH_RESOLVE_FRAG,
    DEPTH_COPY_FRAG,
    TAA_FRAG,
    WATER_VERT,
    WATER_FRAG,
    CROWD_VERT,
    CROWD_DEPTH_VERT,
    OVERLAY_VERT,
    OVERLAY_FRAG,
    code, bytes
)

extern malloc(n: long) -> ptr
extern memcpy(dst: ptr, src: int[], n: long) -> ptr

const SCENE_VERT = 0
const SCENE_FRAG = 1
const SCENE_RQ_FRAG = 2
const CROWD_SORT_COMP = 3
const DEPTH_VERT = 4
const DEPTH_FRAG = 5
const SKY_VERT = 6
const SKY_FRAG = 7
const SCREEN_VERT = 8
const PASSTHROUGH_FRAG = 9
const FXAA_FRAG = 10
const BLOOM_FRAG = 11
const SSR_FRAG = 12
const SSAO_FRAG = 13
const DEPTH_RESOLVE_FRAG = 14
const DEPTH_COPY_FRAG = 15
const TAA_FRAG = 16
const WATER_VERT = 17
const WATER_FRAG = 18
const CROWD_VERT = 19
const CROWD_DEPTH_VERT = 20
const OVERLAY_VERT = 21
const OVERLAY_FRAG = 22

// The words of `shader`, copied; null for a shader there is none of.
code(shader: int) -> ptr {
    if shader == SCENE_VERT { return scene_vert() }
    if shader == SCENE_FRAG { return scene_frag() }
    if shader == SCENE_RQ_FRAG { return scene_rq_frag() }
    if shader == CROWD_SORT_COMP { return crowd_sort_comp() }
    if shader == DEPTH_VERT { return depth_vert() }
    if shader == DEPTH_FRAG { return depth_frag() }
    if shader == SKY_VERT { return sky_vert() }
    if shader == SKY_FRAG { return sky_frag() }
    if shader == SCREEN_VERT { return screen_vert() }
    if shader == PASSTHROUGH_FRAG { return passthrough_frag() }
    if shader == FXAA_FRAG { return fxaa_frag() }
    if shader == BLOOM_FRAG { return bloom_frag() }
    if shader == SSR_FRAG { return ssr_frag() }
    if shader == SSAO_FRAG { return ssao_frag() }
    if shader == DEPTH_RESOLVE_FRAG { return depth_resolve_frag() }
    if shader == DEPTH_COPY_FRAG { return depth_copy_frag() }
    if shader == TAA_FRAG { return taa_frag() }
    if shader == WATER_VERT { return water_vert() }
    if shader == WATER_FRAG { return water_frag() }
    if shader == CROWD_VERT { return crowd_vert() }
    if shader == CROWD_DEPTH_VERT { return crowd_depth_vert() }
    if shader == OVERLAY_VERT { return overlay_vert() }
    if shader == OVERLAY_FRAG { return overlay_frag() }
    return null
}

// The size of `shader` in bytes; 0 for a shader there is none of.
bytes(shader: int) -> int {
    if shader == SCENE_VERT { return 19420 }
    if shader == SCENE_FRAG { return 103268 }
    if shader == SCENE_RQ_FRAG { return 113868 }
    if shader == CROWD_SORT_COMP { return 14004 }
    if shader == DEPTH_VERT { return 16628 }
    if shader == DEPTH_FRAG { return 9596 }
    if shader == SKY_VERT { return 10876 }
    if shader == SKY_FRAG { return 33568 }
    if shader == SCREEN_VERT { return 10364 }
    if shader == PASSTHROUGH_FRAG { return 9940 }
    if shader == FXAA_FRAG { return 15884 }
    if shader == BLOOM_FRAG { return 12224 }
    if shader == SSR_FRAG { return 22852 }
    if shader == SSAO_FRAG { return 19804 }
    if shader == DEPTH_RESOLVE_FRAG { return 10744 }
    if shader == DEPTH_COPY_FRAG { return 10168 }
    if shader == TAA_FRAG { return 13556 }
    if shader == WATER_VERT { return 21156 }
    if shader == WATER_FRAG { return 54180 }
    if shader == CROWD_VERT { return 22280 }
    if shader == CROWD_DEPTH_VERT { return 15888 }
    if shader == OVERLAY_VERT { return 1664 }
    if shader == OVERLAY_FRAG { return 2112 }
    return 0
}

