// tools/generate_shaders.ae from the GLSL in ae3d.shaders: do not edit. code(shader) is
// a fresh copy of a shader's words, four-byte aligned as a shader module
// takes them, for the caller to free; bytes(shader) is its size.

exports (
    SCENE_VERT,
    SCENE_FRAG,
    SCENE_RQ_FRAG,
    CROWD_SORT_COMP,
    SKIN_COMP,
    DEPTH_VERT,
    DEPTH_FRAG,
    SKY_VERT,
    SKY_FRAG,
    SCREEN_VERT,
    PASSTHROUGH_FRAG,
    FXAA_FRAG,
    BLOOM_FRAG,
    SSR_FRAG,
    SSAO_FRAG,
    DEPTH_RESOLVE_FRAG,
    DEPTH_COPY_FRAG,
    TAA_FRAG,
    WATER_VERT,
    WATER_FRAG,
    CROWD_VERT,
    CROWD_DEPTH_VERT,
    OVERLAY_VERT,
    OVERLAY_FRAG,
    code, bytes
)

extern malloc(n: long) -> ptr
extern memcpy(dst: ptr, src: int[], n: long) -> ptr

const SCENE_VERT = 0
const SCENE_FRAG = 1
const SCENE_RQ_FRAG = 2
