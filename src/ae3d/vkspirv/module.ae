    if shader == SKY_VERT { return 11160 }
    if shader == SKY_FRAG { return 36720 }
    if shader == SCREEN_VERT { return 10648 }
    if shader == PASSTHROUGH_FRAG { return 10224 }
    if shader == FXAA_FRAG { return 16168 }
    if shader == BLOOM_FRAG { return 12508 }
    if shader == SSR_FRAG { return 23136 }
    if shader == SSAO_FRAG { return 20108 }
    if shader == DEPTH_RESOLVE_FRAG { return 11028 }
    if shader == DEPTH_COPY_FRAG { return 10452 }
    if shader == TAA_FRAG { return 13840 }
    if shader == WATER_VERT { return 21440 }
    if shader == WATER_FRAG { return 54464 }
    if shader == CROWD_VERT { return 22644 }
    if shader == CROWD_DEPTH_VERT { return 16804 }
    if shader == OVERLAY_VERT { return 1664 }
    if shader == OVERLAY_FRAG { return 2112 }
    return 0
}

