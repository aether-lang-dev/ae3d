// ae3d.vkmsl -- the quoted shaders' MSL (src/ae3d/metal) as the code of a Vulkan
// shader module, GENERATED by tools/generate_shaders.ae: do not edit. MoltenVK takes MSL source in
// place of SPIR-V when the code starts with its magic word (0x19960412); the
// renderer hands it these with AE3D_MSL=1. code(shader) is a fresh copy of
// the words of a shader of ae3d.vkspirv's numbering, for the caller to free
// (null for one with no MSL); bytes(shader) its size, the NUL and the padding
// counted; stage(shader) 0 for a vertex shader, 1 a fragment shader, -1 none.
// The entry function is main0 in every one, the name MoltenVK finds it by.

import ae3d.vkspirv

exports (code, bytes, stage)

extern malloc(n: long) -> ptr
extern memcpy(dst: ptr, src: int[], n: long) -> ptr

