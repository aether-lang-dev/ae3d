// The animation pipeline's showcase (#853, #854, #855): four real people on the
// new layers, for a person to watch. Not a test: ci.sh never builds it.
//
//   ./build.sh tools/anim_showcase.ae && ./build/anim_showcase
//   AE3D_WATCH=1 (follow the runner), 2 (the female), 3 (the hit figure),
//   4 (the captured walker);
//   0 or unset, the whole scene from a slow orbit.
//
//   - the runner (the Rigify mannequin, tests/fixtures/people/ual1_rigify.glb)
//     goes round a circle through a 20 s cycle: standing, walking, jogging,
//     running, sprinting, slowing and stopping, its walk, jog and sprint
//     blended by speed and synced on their footfalls, its feet locked on the
//     ground (ikrig), its head turned to the camera;
//   - the female mannequin (UE5's skeleton) runs the same cycle a quarter of
//     a turn behind on the runner's gaits retargeted onto her, aiming a
//     pistol over her walk (an upper-body layer);
//   - the UE5 mannequin stands with a foot up on a 12 cm block on its own
//     idle (UAL2), the runner's chest and head hits retargeted onto it and
//     added over the idle every few seconds, its head following the runner;
//   - the UE5 mannequin again, on a character controller, walks out along a
//     line and back on 100STYLE's captured forward and backward walks
//     (motion capture read from BVH, retargeted with its feet kept and a
//     root made under its hips), carried by their root motion.
//
// Each cycle prints, per mover, the worst a planted toe slid and how the
// speed was matched.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.retarget
import ae3d.bvh

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern atan2(y: float, x: float) -> float

const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const FEMALE = "tests/fixtures/people/mannequin_f.glb"
const MALE = "tests/fixtures/people/mannequin.glb"
const RADIUS = 5.0
const CYCLE = 20.0
const ACCELERATION = 3.0           // m/s a second the movers speed up and slow down at
const STYLE = "tests/fixtures/people/100style/"
const LINE = 1.4                   // metres the captured walker goes out and back

struct Mover {
    o: ptr                         // *GameObject
    a: ptr                         // *Animator
    feet: ptr                      // *Feet
    move: int
    idle: int
    aim: int                       // layer, -1 none
    centre: Vec3
    angle: float                   // round the circle
    speed: float
    offset: float                  // seconds behind the cycle
    toes: ptr                      // float[6]: where each toe was planted
    planted: ptr                   // float[2]
    worst: float                   // worst toe slide this cycle
}

struct Show {
    runner: Mover
    female: Mover
    hit_o: ptr
    hit_a: ptr
    hits: ptr                      // int[2]: the hit layers
    hit_next: float
    hit_which: int
    clock: float
    cycle: int
    camera_angle: float
    walker_o: ptr                  // *GameObject: the captured walker
    walker_a: ptr                  // *Animator
    forward: int                   // its states
    back: int
    going_back: bool
    home: Vec3                     // where its line starts
    line: Vec3                     // and the way it runs (the walker's facing)
}

// The speed the cycle asks for `t` seconds in.
wanted_speed(t: float) -> float {
    x = t - CYCLE * floor_of(t / CYCLE)
    if x < 2.0 { return 0.0 }
    if x < 6.0 { return 1.2 }
    if x < 9.0 { return 3.5 }
    if x < 12.0 { return 6.0 }
    if x < 14.5 { return 8.5 }
    if x < 16.5 { return 3.0 }
    if x < 19.0 { return 1.2 }
    return 0.0
}

floor_of(x: float) -> float {
    i = x as int
    f = i as float
    if f > x { f = f - 1.0 }
    return f
}

make_mover(e: *Engine, m: *Mover, o: *GameObject, a: *Animator, centre: Vec3, offset: float) {
    m.o = o as ptr
    m.a = a as ptr
    m.centre = centre
    m.offset = offset
    m.aim = 0 - 1
    m.toes = calloc(6, 8)
    m.planted = calloc(2, 8)
    f = ikrig.feet_new(animator.rig(a), o)
    ikrig.feet_ground_physics(f, physics.of(e))
    animator.set_feet(a, f)
    m.feet = f as ptr
    animator.play(a, m.idle, 0.0)
    place(m, 0.0)
}

// The mover on its circle at its angle, facing along it.
place(m: *Mover, dt: float) {
    o = m.o as *GameObject
    at = core.vec3(m.centre.x + RADIUS * sin(m.angle), 0.0, m.centre.z + RADIUS * cos(m.angle))
    behaviour.object_set_position(o, at)
    // Going round anticlockwise seen from above: the tangent.
    tx = cos(m.angle)
    tz = 0.0 - sin(m.angle)
    behaviour.object_set_rotation(o, core.quat_rotate(atan2(tx, tz), core.vec3(0.0, 1.0, 0.0)))
}

step_mover(s: *Show, m: *Mover, dt: float, look: Vec3) {
    a = m.a as *Animator
    goal = wanted_speed(s.clock - m.offset)
    if m.speed < goal {
        m.speed = m.speed + ACCELERATION * dt
        if m.speed > goal { m.speed = goal }
    } else if m.speed > goal {
        m.speed = m.speed - ACCELERATION * dt
        if m.speed < goal { m.speed = goal }
    }
    moving = animator.current(a) == m.move
    if m.speed > 0.25 && !moving { animator.play(a, m.move, 0.35) }
    if m.speed <= 0.1 && moving { animator.play(a, m.idle, 0.4) }
    animator.set_param(a, m.move, m.speed)
    if animator.current(a) == m.move {
        m.angle = m.angle + m.speed * dt / RADIUS
        place(m, dt)
    }
    if m.aim >= 0 {
        w = 0.0
        if m.speed > 0.4 && m.speed < 2.0 { w = 1.0 }
        animator.layer_weight(a, m.aim, w, 0.4)
    }
    animator.look_at(a, look, 0.7)
}

// The worst a planted toe slid since the cycle began, measured on the pose
// drawn, as the motion test measures it.
measure(m: *Mover) {
    a = m.a as *Animator
    r = animator.rig(a)
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    toes = m.toes as float[]
    planted = m.planted as float[]
    side = 0
    while side < 2 {
        down = animator.contact_weight(a, side) > 0.99 && animator.current(a) == m.move
        now = (animator.plant_weight(a, side) > 0.99 || planted[side] > 0.5) && down
        tip = ikrig.toe_tip(m.feet as *Feet, r, w, side)
        if now && planted[side] < 0.5 {
            toes[side * 3] = tip.x
            toes[side * 3 + 2] = tip.z
        }
        if now {
            dx = tip.x - toes[side * 3]
            dz = tip.z - toes[side * 3 + 2]
            d = core.sqrt_of(dx * dx + dz * dz)
            if d > m.worst { m.worst = d }
            ankle = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
            aim = ikrig.feet_target(m.feet as *Feet, side)
            miss = core.v3_len(core.v3_sub(ankle, aim))
            if core.env_int("TRACE", 0) == 1 && d > 0.005 { println("    SLIDE side ${side} ${d * 1000.0} mm: ankle off its target ${miss * 1000.0} mm, speed ${m.speed}, pace state ${animator.current(a)}, transitioning ${animator.transitioning(a)}, locked ${ikrig.feet_locked(m.feet as *Feet, side)}, down ${animator.contact_weight(a, side)} planted ${animator.plant_weight(a, side)}") }
        }
        planted[side] = 0.0
        if now { planted[side] = 1.0 }
        side = side + 1
    }
    pose.release(w)
}

// The Rigify mannequin's gaits (or retargeted onto `a`'s rig from `source`).
add_gaits(a: *Animator, source: *pose.Rig, scene: *GltfScene) -> int {
    s = animator.add_blend(a, "move")
    names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    k = 0
    while k < 3 {
        t = null as *Take
        if source == null {
            t = animator.take(a, names[k], false)
        } else {
            made = clips.from_scene(source, scene, names[k], 0.0)
            t = animator.add_take(a, retarget.retarget(source, made, animator.rig(a)), false)
            clips.take_free(made)
        }
        animator.blend_add(a, s, t, clips.speed(t))
        k = k + 1
    }
    return s
}

start(state: ptr, e: *Engine) {
    s = state as *Show
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(60.0, 1.0, 60.0))
    // A dark, rough ground the figures read against.
    gm = behaviour.object_model(ground)
    core.model_set_diffuse(gm, 0.20, 0.21, 0.23)
    core.model_set_pbr(gm, 0.0, 0.9)
    physics.box_collider(ground, core.vec3(30.0, 0.5, 30.0), physics.material(0.8, 0.0))
    // The source of every retarget: the Rigify mannequin's file, out of sight.
    source_o = figure.figure(e, "Source", RIGIFY)
    behaviour.object_set_position(source_o, core.vec3(0.0, 0.0 - 50.0, 0.0))
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    scene = figure.scene(source_f)
    // The runner.
    ro = figure.figure(e, "Runner", RIGIFY)
    ra = animator.attach(e, ro)
    s.runner.move = add_gaits(ra, null, null)
    s.runner.idle = animator.add_state(ra, "idle", animator.take(ra, "Idle_Loop", false), true)
    make_mover(e, &s.runner, ro, ra, core.vec3(0.0 - 3.5, 0.0, 0.0), 0.0)
    // The female, a quarter of a cycle behind, aiming over her walk.
    fo = figure.figure(e, "Female", FEMALE)
    fa = animator.attach(e, fo)
    s.female.move = add_gaits(fa, source, scene)
    idle_made = clips.from_scene(source, scene, "Idle_Loop", 0.0)
    s.female.idle = animator.add_state(fa, "idle", animator.add_take(fa, retarget.retarget(source, idle_made, animator.rig(fa)), false), true)
    clips.take_free(idle_made)
    aim_made = clips.from_scene(source, scene, "Pistol_Aim_Neutral", 0.0)
    aim = animator.add_take(fa, retarget.retarget(source, aim_made, animator.rig(fa)), false)
    clips.take_free(aim_made)
    s.female.aim = animator.add_layer(fa, aim, pose.human(animator.rig(fa), pose.SPINE_01), false, true)
    make_mover(e, &s.female, fo, fa, core.vec3(3.5, 0.0, 0.0), CYCLE * 0.25)
    // The UE5 mannequin on a block, hit now and then.
    block = engine.object(e, "Block", loader.cube(1.0))
    behaviour.object_set_position(block, core.vec3(0.12, 0.06, 7.0))
    behaviour.object_set_scale(block, core.vec3(0.3, 0.12, 0.5))
    physics.box_collider(block, core.vec3(0.15, 0.06, 0.25), physics.material(0.8, 0.0))
    mo = figure.figure(e, "Standing", MALE)
    behaviour.object_set_position(mo, core.vec3(0.0, 0.0, 7.0))
    behaviour.object_set_rotation(mo, core.quat_rotate(3.1415926, core.vec3(0.0, 1.0, 0.0)))
    ma = animator.attach(e, mo)
    idle = animator.add_state(ma, "idle", animator.take(ma, "Idle_No_Loop", false), true)
    animator.play(ma, idle, 0.0)
    hits = calloc(2, 4) as int[]
    names = ["Hit_Chest", "Hit_Head"]
    k = 0
    while k < 2 {
        made = clips.from_scene(source, scene, names[k], 0.0)
        hits[k] = animator.add_layer(ma, animator.add_take(ma, retarget.retarget(source, made, animator.rig(ma)), false), 0 - 1, true, false)
        clips.take_free(made)
        k = k + 1
    }
    feet = ikrig.feet_new(animator.rig(ma), mo)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(ma, feet)
    s.hit_o = mo as ptr
    s.hit_a = ma as ptr
    s.hits = hits as ptr
    s.hit_next = 2.0
    pose.rig_free(source)
    make_walker(s, e)
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Show
    s.clock = s.clock + step
    cam = engine.engine_camera(e).position
    step_mover(s, &s.runner, step, cam)
    step_mover(s, &s.female, step, cam)
    // The standing figure: hit every few seconds, watching the runner.
    ma = s.hit_a as *Animator
    if s.clock >= s.hit_next {
        hits = s.hits as int[]
        layer = hits[s.hit_which]
        animator.layer_restart(ma, layer)
        animator.layer_weight(ma, layer, 1.0, 0.0)
        animator.layer_weight(ma, hits[1 - s.hit_which], 0.0, 0.2)
        s.hit_which = 1 - s.hit_which
        s.hit_next = s.clock + 2.5
    }
    runner = s.runner.o as *GameObject
    step_walker(s)
    animator.look_at(ma, core.v3_add(behaviour.object_position(runner), core.vec3(0.0, 1.6, 0.0)), 0.8)
}

// After the frame is drawn (the pose phase has run): the toes measured on the
// pose the frame shows, with the figures where the frame shows them.
// Measured in the fixed step, the last frame's pose was read through this
// step's place, a frame's travel off.
late_update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    measure(&s.runner)
    measure(&s.female)
    cycle = (s.clock / CYCLE) as int
    if cycle > s.cycle {
        wat = core.v3_sub(behaviour.object_position(s.walker_o as *GameObject), s.home)
        println("anim_showcase: cycle ${cycle}: the runner's planted toes slid ${s.runner.worst * 1000.0} mm at worst, the female's ${s.female.worst * 1000.0} mm; the captured walker ${core.v3_dot(wat, s.line)} m along its line, ${core.v3_len(core.v3_sub(wat, core.v3_mul(s.line, core.v3_dot(wat, s.line))))} m off it")
        s.runner.worst = 0.0
        s.female.worst = 0.0
        s.cycle = cycle
    }
}

update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0)
    if watch >= 1 && watch <= 4 {
        o = s.runner.o as *GameObject
        if watch == 2 { o = s.female.o as *GameObject }
        if watch == 3 { o = s.hit_o as *GameObject }
        if watch == 4 { o = s.walker_o as *GameObject }
        at = behaviour.object_position(o)
        side = core.quat_apply(behaviour.object_rotation(o), core.vec3(1.0, 0.0, 0.0))
        core.camera_set_position(cam, core.vec3(at.x + side.x * 3.0, 1.4, at.z + side.z * 3.0))
        core.camera_look_at(cam, core.vec3(at.x, 0.9, at.z))
        return
    }
    s.camera_angle = s.camera_angle + delta * 0.08
    core.camera_set_position(cam, core.vec3(15.0 * sin(s.camera_angle), 5.0, 2.0 + 15.0 * cos(s.camera_angle)))
    core.camera_look_at(cam, core.vec3(0.0, 0.8, 2.0))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - animation pipeline showcase (automated)")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    // Late afternoon: a low sun and its long shadows, the procedural sky.
    engine.engine_set_time_of_day(e, 16.8)
    s = heap_show()
    b = engine.behaviour_new("anim_showcase", s as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    b.late_update = late_update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
}

heap_show() -> *Show {
    s = calloc(1, sizeof(Show)) as *Show
    s.hit_which = 0
    return s
}

// The captured walker: the UE5 mannequin on a character controller, walking
// 100STYLE's forward and backward walks (motion capture, retargeted onto it
// with its feet kept and a root made under its hips, straightened), carried by their root
// motion out along a line and back.
make_walker(s: *Show, e: *Engine) {
    wo = figure.figure(e, "Captured", MALE)
    s.home = core.vec3(0.0 - LINE * 0.5, 0.0, 0.0 - 9.0)
    behaviour.object_set_position(wo, s.home)
    behaviour.object_set_rotation(wo, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    _capsule = physics.character_controller(wo, 0.3, 1.7)
    wa = animator.attach(e, wo)
    names = ["neutral_fw.bvh", "neutral_bw.bvh"]
    states = [0, 0]
    k = 0
    while k < 2 {
        c = bvh.load("${STYLE}${names[k]}", 0.0)
        made = bvh.take(c, names[k], 0, 0 - 1)
        t = animator.add_take(wa, retarget.retarget(bvh.rig(c), made, animator.rig(wa)), true)
        clips.straighten(t, animator.rig(wa), true)
        states[k] = animator.add_state(wa, names[k], t, false)
        clips.take_free(made)
        bvh.capture_free(c)
        k = k + 1
    }
    s.forward = states[0]
    s.back = states[1]
    animator.set_root_motion(wa, true)
    feet = ikrig.feet_new(animator.rig(wa), wo)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(wa, feet)
    animator.play(wa, s.forward, 0.0)
    s.line = retarget.facing(animator.rig(wa))
    s.walker_o = wo as ptr
    s.walker_a = wa as ptr
}

// Out along the line, then back: the walk turned to the backward walk when
// it is LINE out, and to the forward walk when it is home, each from its
// start, inertialized over 0.4 s; or when the take playing is about to
// end, since a capture's takes do not loop and a figure holding its last
// frame stands still.
step_walker(s: *Show) {
    wo = s.walker_o as *GameObject
    wa = s.walker_a as *Animator
    at = behaviour.object_position(wo)
    out = core.v3_dot(core.v3_sub(at, s.home), s.line)
    ending = animator.state_time(wa) >= clips.duration(animator.current_take(wa)) - 0.4
    if core.env_int("TRACE", 0) == 2 && (s.clock * 4.0) as int != ((s.clock - 0.0166) * 4.0) as int {
        ahead = core.quat_apply(behaviour.object_rotation(wo), core.vec3(0.0, 0.0, 1.0))
        moved = animator.root_moved(wa)
        println("    WALKER t ${s.clock} back ${s.going_back} out ${out} heading ${atan2(ahead.x, ahead.z) * 57.29578} state ${animator.state_name(wa, animator.current(wa))} at ${animator.state_time(wa)} of ${clips.duration(animator.current_take(wa))} moved ${moved.x} ${moved.y} ${moved.z}")
    }
    if !s.going_back && (out >= LINE || ending) {
        animator.play(wa, s.back, 0.4)
        s.going_back = true
    } else if s.going_back && (out <= 0.0 || ending) {
        animator.play(wa, s.forward, 0.4)
        s.going_back = false
    }
}
