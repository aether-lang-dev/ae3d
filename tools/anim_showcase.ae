// The animation pipeline's showcase (#853 to #857): real people on the
// new layers, for a person to watch. Not a test: ci.sh never builds it.
//
//   ./build.sh tools/anim_showcase.ae && ./build/anim_showcase
//   AE3D_WATCH=1 (follow the runner), 2 (the female), 3 (the hit figure),
//   4 (the captured walker), 5 (the figure on a stick), 6 (the climber),
//   7 (the rifleman), 8 (the swordsman); AE3D_WATCH_FRONT=1 watches it from in
//   front;
//   0 or unset, the whole scene from a slow orbit.
//
//   - the runner (the Rigify mannequin, tests/fixtures/people/ual1_rigify.glb)
//     goes round a circle through a 20 s cycle: standing, walking, jogging,
//     running, sprinting, slowing and stopping, its walk, jog and sprint
//     blended by speed and synced on their footfalls, its feet locked on the
//     ground (ikrig), its head turned to the camera;
//   - the female mannequin (UE5's skeleton) runs the same cycle a quarter of
//     a turn behind on the runner's gaits retargeted onto her, aiming a
//     pistol over her walk (an upper-body layer);
//   - the UE5 mannequin stands with a foot up on a 12 cm block on its own
//     idle (UAL2), the runner's chest and head hits retargeted onto it and
//     added over the idle every few seconds, its head following the runner;
//   - the UE5 mannequin again, on a character controller, walks out along a
//     line and back facing out on motion matching (#906) over 100STYLE's
//     neutral style read whole (its walks, runs, side steps, turns, starts,
//     stops and idles, the side, turning and idle ones mirrored), made a
//     person in one call (ae3d.character), carried by the takes' root
//     motion, standing at each end;
//   - the UE5 mannequin on a stick goes through a 24 s cycle (stand, walk,
//     step aside facing ahead, run, stop, turn round on the spot, walk back
//     aiming a pistol), made a person in one call (ae3d.character) on
//     100STYLE's gaits;
//   - the Rigify mannequin again walks up and down 0.2 m stairs (a tread a
//     step, its stride cut to fit) and over a 20 degree ramp, a bowl in
//     both hands, its soles on the ground heel to toe (#857);
//   - the UE5 mannequin stands holding a rifle bladed in both hands,
//     aiming it at a point sweeping before it, the aim spread up its spine
//     and its hands solved onto the rifle where the aim put it (#857);
//   - the UE5 mannequin made a person (ae3d.character) with a sword at its
//     left hip (ae3d.items, #925): it draws it, the right hand to the grip
//     and the sword from the hip to the hand, swings it twice at the pace
//     its weight gives, its fingers round the grip, and sheathes it.
//
// AE3D_METRICS=1 prints every 10 s, per figure, the worst a player would
// see: legs through each other, a knee bent out, the chest twisted off the
// hips, a forearm over-rolled, and when.
//
// Each cycle prints, per mover, the worst a planted toe slid and how the
// speed was matched.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.mover
import ae3d.metrics
import ae3d.character
import ae3d.items
import ae3d.animgraph

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern atan2(y: float, x: float) -> float

const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const FEMALE = "tests/fixtures/people/mannequin_f.glb"
const MALE = "tests/fixtures/people/mannequin.glb"
const RADIUS = 5.0
const CYCLE = 20.0
const ACCELERATION = 3.0           // m/s a second the movers speed up and slow down at
// How fast a mover is asked back onto its circle, a share of its distance
// off it each second.
const ONTO = 1.5
const STYLE = "tests/fixtures/people/100style/"
const GRAPHS = "tests/fixtures/graphs/"
const LINE = 1.4                   // metres the captured walker goes out and back
// The climber's parcel: metres across, high and deep, and its kilograms.
const PARCEL_MASS = 6.0
parcel_size() -> Vec3 { return core.vec3(0.3, 0.2, 0.25) }
const WALKER_OUT = 1.0             // metres a second it walks out, and back
const WALKER_BACK = 0.6
const WALKER_STAND = 1.0           // seconds it stands at each end

// A figure going round a circle on its gaits.
struct Circler {
    c: ptr                         // *Character (ae3d.character)
    o: ptr                         // *GameObject
    a: ptr                         // *Animator
    feet: ptr                      // *Feet
    move: int
    idle: int
    aim: int                       // layer, -1 none
    centre: Vec3
    angle: float                   // round the circle
    speed: float
    offset: float                  // seconds behind the cycle
    toes: ptr                      // float[6]: where each toe was planted
    planted: ptr                   // float[2]
    worst: float                   // worst toe slide this cycle
}

// A pistol a figure holds in its right hand (arm_pistol), each part in the
// hand's own frame.
struct Pistol {
    o: ptr                         // *GameObject: the figure
    a: ptr                         // *Animator
    hand: int                      // the right hand's joint
    grip_at: Vec3                  // the grip's middle
    grip_down: Vec3                // the way down it
    barrel: Vec3                   // the way the barrel points
    slide_at: Vec3                 // the slide's middle
    trigger_at: Vec3
    slide: ptr                     // *GameObject
    grip: ptr
    trigger: ptr
    work: ptr                      // scratch pose
}

// The show, for the props' behaviour start adds (main owns it).
var g_show: ptr = null

struct Show {
    runner: Circler
    female: Circler
    female_pistol: Pistol          // the pistol the female aims (#907)
    stick_pistol: Pistol           // and the figure on a stick
    hit_c: ptr                     // *Character: the hit figure
    hit_o: ptr
    hit_a: ptr
    hits: ptr                      // int[2]: the hit layers
    hit_next: float
    hit_until: float               // the hit playing ends then: its eyes leave the runner till it does
    hit_lengths: ptr               // float[2]: each hit's length
    hit_which: int
    clock: float
    cycle: int
    camera_angle: float
    walker_o: ptr                  // *GameObject: the captured walker
    walker_a: ptr                  // *Animator
    walker_c: ptr                  // *Character (ae3d.character)
    walker_leg: int                // out, standing, back, standing
    walker_wait: float             // seconds it has stood
    home: Vec3                     // where its line starts
    line: Vec3                     // and the way it runs (the walker's facing)
    stick_o: ptr                   // *GameObject: the figure on a stick
    stick_a: ptr                   // *Animator
    stick_c: ptr                   // *Character (ae3d.character)
    stick_yaw: float               // the way its stick faces it
    stick_home: Vec3
    climb_c: ptr                   // *Character: the climber (#857)
    climb_o: ptr
    climb_a: ptr
    climb_feet: ptr
    climb_hands: ptr
    climb_bowl: ptr
    climb_start: Vec3
    climb_stairs: float            // where its stairs end along the course
    climb_end: float
    climb_stride: float
    climb_full_stride: float
    climb_walk_speed: float
    climb_belly: float
    climb_box: Vec3                // the box's middle in the climber's spine_02 frame
    climb_spine_rest: Quat         // spine_02's rest turn, the rig's space
    climb_work: ptr                // scratch pose
    climb_ramp: float              // where its ramp starts along the course
    rifle_c: ptr                   // *Character: the rifleman (#857)
    rifle_o: ptr
    rifle_a: ptr
    rifle_gun: ptr
    rifle_butt: Vec3
    rifle_axis: Vec3
    rifle_up: Vec3                 // the rifle's up, the chest's frame
    rifle_grip_at: Vec3            // its pistol grip's middle, the chest's frame
    rifle_grip_down: Vec3          // and the way down it
    rifle_trigger_at: Vec3         // its trigger, the chest's frame
    rifle_grip: ptr                // *GameObject
    rifle_trigger: ptr             // *GameObject
    rifle_work: ptr
    seen: ptr                      // ptr[FIGURES] of *Meter (ae3d.metrics, AE3D_METRICS)
    seen_next: float
    sword_c: ptr                   // *Character: the swordsman
    sword_kind: ptr                // *Kind (ae3d.items)
    sword: ptr                     // *Item
    sword_o: ptr                   // *GameObject
    sword_a: ptr                   // *Animator
    sword_beat: int                // the part of its cycle it is in
}

// The speed the cycle asks for `t` seconds in.
wanted_speed(t: float) -> float {
    x = t - CYCLE * floor_of(t / CYCLE)
    if x < 2.0 { return 0.0 }
    if x < 6.0 { return 1.2 }
    if x < 9.0 { return 3.5 }
    if x < 12.0 { return 6.0 }
    if x < 14.5 { return 8.5 }
    if x < 16.5 { return 3.0 }
    if x < 19.0 { return 1.2 }
    return 0.0
}

floor_of(x: float) -> float {
    i = x as int
    f = i as float
    if f > x { f = f - 1.0 }
    return f
}

// A mover's person (ae3d.character.graphed) on its circle: its feet, its
// stand and its gaits the character's, put at its start.
make_mover(e: *Engine, m: *Circler, c: *Character, centre: Vec3, offset: float) {
    m.c = c as ptr
    m.o = character.object_of(c) as ptr
    m.a = character.animator_of(c) as ptr
    m.centre = centre
    m.offset = offset
    m.aim = 0 - 1
    m.toes = calloc(6, 8)
    m.planted = calloc(2, 8)
    m.feet = character.feet_of(c) as ptr
    gr = character.graph_of(c)
    m.idle = animgraph.state_of(gr, "idle")
    m.move = animgraph.state_of(gr, "move")
    place(m, 0.0)
    mover.settle(character.mover_of(c))
}

// The mover put on its circle at its angle, facing along it.
place(m: *Circler, dt: float) {
    o = m.o as *GameObject
    at = core.vec3(m.centre.x + RADIUS * sin(m.angle), 0.0, m.centre.z + RADIUS * cos(m.angle))
    behaviour.object_set_position(o, at)
    // Going round anticlockwise seen from above: the tangent.
    tx = cos(m.angle)
    tz = 0.0 - sin(m.angle)
    behaviour.object_set_rotation(o, core.quat_rotate(atan2(tx, tz), core.vec3(0.0, 1.0, 0.0)))
}

step_mover(s: *Show, m: *Circler, dt: float, look: Vec3) {
    c = m.c as *Character
    goal = wanted_speed(s.clock - m.offset)
    if m.speed < goal {
        m.speed = m.speed + ACCELERATION * dt
        if m.speed > goal { m.speed = goal }
    } else if m.speed > goal {
        m.speed = m.speed - ACCELERATION * dt
        if m.speed < goal { m.speed = goal }
    }
    // Asked round its circle at that speed and back onto it: the way round
    // where it is, and a share of how far it is off the circle. Its graph
    // goes from its stand to its gaits and back by the speed its mover has.
    at = behaviour.object_position(m.o as *GameObject)
    off = core.vec3(at.x - m.centre.x, 0.0, at.z - m.centre.z)
    out = core.v3_len(off)
    if out < 0.000001 {
        off = core.vec3(0.0, 0.0, 1.0)
        out = 1.0
    }
    turn = atan2(off.x, off.z)
    round = core.vec3(cos(turn), 0.0, 0.0 - sin(turn))
    back = core.v3_mul(off, (RADIUS - out) * ONTO / out)
    character.move(c, core.v3_add(core.v3_mul(round, m.speed), back), core.vec3(0.0, 0.0, 0.0))
    a = m.a as *Animator
    if m.aim >= 0 {
        w = 0.0
        if m.speed > 0.4 && m.speed < 2.0 { w = 1.0 }
        animator.layer_weight(a, m.aim, w, 0.4)
    }
    character.look(c, look)
}

// The worst a planted toe slid since the cycle began, measured on the pose
// drawn, as the motion test measures it.
measure(m: *Circler) {
    a = m.a as *Animator
    r = animator.rig(a)
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    toes = m.toes as float[]
    planted = m.planted as float[]
    side = 0
    while side < 2 {
        down = animator.contact_weight(a, side) > 0.99 && animator.current(a) == m.move
        now = (animator.plant_weight(a, side) > 0.99 || planted[side] > 0.5) && down
        tip = ikrig.toe_tip(m.feet as *Feet, r, w, side)
        if now && planted[side] < 0.5 {
            toes[side * 3] = tip.x
            toes[side * 3 + 2] = tip.z
        }
        if now {
            dx = tip.x - toes[side * 3]
            dz = tip.z - toes[side * 3 + 2]
            d = core.sqrt_of(dx * dx + dz * dz)
            if d > m.worst { m.worst = d }
            ankle = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
            aim = ikrig.feet_target(m.feet as *Feet, side)
            miss = core.v3_len(core.v3_sub(ankle, aim))
            if core.env_int("TRACE", 0) == 1 && d > 0.005 { println("    SLIDE side ${side} ${d * 1000.0} mm: ankle off its target ${miss * 1000.0} mm, speed ${m.speed}, pace state ${animator.current(a)}, transitioning ${animator.transitioning(a)}, locked ${ikrig.feet_locked(m.feet as *Feet, side)}, down ${animator.contact_weight(a, side)} planted ${animator.plant_weight(a, side)}") }
        }
        planted[side] = 0.0
        if now { planted[side] = 1.0 }
        side = side + 1
    }
    pose.release(w)
}

start(state: ptr, e: *Engine) {
    s = state as *Show
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(60.0, 1.0, 60.0))
    // A dark, rough ground the figures read against.
    gm = behaviour.object_model(ground)
    core.model_set_diffuse(gm, 0.20, 0.21, 0.23)
    core.model_set_pbr(gm, 0.0, 0.9)
    physics.box_collider(ground, core.vec3(30.0, 0.5, 30.0), physics.material(0.8, 0.0))
    // The runner: a person on its own file's walk, jog and sprint, blended by
    // speed (ae3d.character.graphed, tests/fixtures/graphs/gaits.graph).
    runner = character.graphed(e, "Runner", RIGIFY, "${GRAPHS}gaits.graph")
    make_mover(e, &s.runner, runner, core.vec3(0.0 - 3.5, 0.0, 0.0), 0.0)
    // The female, a quarter of a cycle behind, aiming over her walk: the
    // runner's gaits and its level pistol aim retargeted from its file.
    female = character.graphed(e, "Female", FEMALE, "${GRAPHS}female.graph")
    make_mover(e, &s.female, female, core.vec3(3.5, 0.0, 0.0), CYCLE * 0.25)
    s.female.aim = animgraph.layer_of(character.graph_of(female), "aim")
    arm_pistol(e, &s.female_pistol, character.object_of(female), character.animator_of(female))
    // The UE5 mannequin on a block, hit now and then: a person on its own
    // idle, the runner's chest and head hits retargeted as layers added over
    // it (tests/fixtures/graphs/struck.graph). No capsule: it would stand
    // the figure on top of the block.
    block = engine.object(e, "Block", loader.cube(1.0))
    behaviour.object_set_position(block, core.vec3(0.12, 0.06, 7.0))
    behaviour.object_set_scale(block, core.vec3(0.3, 0.12, 0.5))
    physics.box_collider(block, core.vec3(0.15, 0.06, 0.25), physics.material(0.8, 0.0))
    hit = character.graphed(e, "Standing", MALE, "${GRAPHS}struck.graph")
    character.capsule_off(hit)
    mo = character.object_of(hit)
    behaviour.object_set_position(mo, core.vec3(0.0, 0.0, 7.0))
    behaviour.object_set_rotation(mo, core.quat_rotate(3.1415926, core.vec3(0.0, 1.0, 0.0)))
    ma = character.animator_of(hit)
    mover.settle(character.mover_of(hit))
    gr = character.graph_of(hit)
    hits = calloc(2, 4) as int[]
    lengths = calloc(2, 8) as float[]
    names = ["hit_chest", "hit_head"]
    k = 0
    while k < 2 {
        hits[k] = animgraph.layer_of(gr, names[k])
        lengths[k] = clips.duration(animgraph.take_of(gr, names[k]))
        k = k + 1
    }
    s.hit_c = hit as ptr
    s.hit_o = mo as ptr
    s.hit_a = ma as ptr
    s.hits = hits as ptr
    s.hit_lengths = lengths as ptr
    s.hit_next = 2.0
    make_walker(s, e)
    make_stick(s, e)
    make_climber(s, e)
    make_rifleman(s, e)
    make_swordsman(s, e)
    // The props (the climber's box, the rifle) placed on the pose drawn,
    // after every figure's animator has posed it: a second behaviour, added
    // after the figures, whose pose phase runs after theirs. Placed in the
    // late update, they were a frame behind the hands holding them.
    pb = engine.behaviour_new("anim_showcase_props", g_show)
    pb.pose = place_props
    engine.engine_add_behaviour(e, pb)
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Show
    s.clock = s.clock + step
    cam = engine.engine_camera(e).position
    step_mover(s, &s.runner, step, cam)
    step_mover(s, &s.female, step, cam)
    // The standing figure: hit every few seconds, watching the runner.
    ma = s.hit_a as *Animator
    if s.clock >= s.hit_next {
        hits = s.hits as int[]
        layer = hits[s.hit_which]
        animator.layer_restart(ma, layer)
        animator.layer_weight(ma, layer, 1.0, 0.0)
        animator.layer_weight(ma, hits[1 - s.hit_which], 0.0, 0.2)
        s.hit_which = 1 - s.hit_which
        s.hit_until = s.clock + (s.hit_lengths as float[])[1 - s.hit_which]
        // Now and then, not on a beat: a hit every 2.5 s read as headbanging.
        s.hit_next = s.clock + 3.5 + 1.5 * (0.5 + 0.5 * sin(s.clock * 1.7))
    }
    runner = s.runner.o as *GameObject
    step_walker(s, step)
    step_stick(s, step)
    step_climber(s, step)
    step_rifleman(s)
    step_swordsman(s, step)
    // Its eyes on the runner, but for while a hit plays: struck, a head goes
    // where the blow sends it. Held on the runner through it, the head hit
    // tipped the head back 16 degrees where its take tips it 80.
    hit = s.hit_c as *Character
    if s.clock < s.hit_until {
        character.look_free(hit)
    } else {
        character.look(hit, core.v3_add(behaviour.object_position(runner), core.vec3(0.0, 1.6, 0.0)))
    }
}

// After the frame is drawn (the pose phase has run): the toes measured on the
// pose the frame shows, with the figures where the frame shows them.
// Measured in the fixed step, the last frame's pose was read through this
// step's place, a frame's travel off.
late_update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    measure(&s.runner)
    measure(&s.female)
    metrics(s, e, delta)
    cycle = (s.clock / CYCLE) as int
    if cycle > s.cycle {
        wat = core.v3_sub(behaviour.object_position(s.walker_o as *GameObject), s.home)
        println("anim_showcase: cycle ${cycle}: the runner's planted toes slid ${s.runner.worst * 1000.0} mm at worst, the female's ${s.female.worst * 1000.0} mm; the captured walker ${core.v3_dot(wat, s.line)} m along its line, ${core.v3_len(core.v3_sub(wat, core.v3_mul(s.line, core.v3_dot(wat, s.line))))} m off it")
        s.runner.worst = 0.0
        s.female.worst = 0.0
        s.cycle = cycle
    }
}

update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0)
    if watch >= 1 && watch <= 8 {
        o = s.runner.o as *GameObject
        if watch == 2 { o = s.female.o as *GameObject }
        if watch == 3 { o = s.hit_o as *GameObject }
        if watch == 4 { o = s.walker_o as *GameObject }
        if watch == 5 { o = s.stick_o as *GameObject }
        if watch == 6 { o = s.climb_o as *GameObject }
        if watch == 7 { o = s.rifle_o as *GameObject }
        if watch == 8 { o = s.sword_o as *GameObject }
        at = behaviour.object_position(o)
        side = core.quat_apply(behaviour.object_rotation(o), core.vec3(1.0, 0.0, 0.0))
        // AE3D_WATCH_FRONT=1 looks at it from in front instead of beside it.
        if core.env_int("AE3D_WATCH_FRONT", 0) == 1 { side = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }
        // AE3D_WATCH_DIST metres away (3), AE3D_WATCH_AT high it looks at (0.9).
        far = core.env_float("AE3D_WATCH_DIST", 3.0)
        high = core.env_float("AE3D_WATCH_AT", 0.9)
        core.camera_set_position(cam, core.vec3(at.x + side.x * far, at.y + high + 0.5 * far / 3.0, at.z + side.z * far))
        core.camera_look_at(cam, core.vec3(at.x, at.y + high, at.z))
        return
    }
    s.camera_angle = s.camera_angle + delta * 0.08
    core.camera_set_position(cam, core.vec3(15.0 * sin(s.camera_angle), 5.0, 2.0 + 15.0 * cos(s.camera_angle)))
    core.camera_look_at(cam, core.vec3(0.0, 0.8, 2.0))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - animation pipeline showcase (automated)")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    // Late afternoon: a low sun and its long shadows, the procedural sky.
    engine.engine_set_time_of_day(e, 16.8)
    s = heap_show()
    g_show = s as ptr
    b = engine.behaviour_new("anim_showcase", s as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    b.late_update = late_update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    if s.stick_c != null { character.character_free(s.stick_c as *Character) }
    if s.walker_c != null { character.character_free(s.walker_c as *Character) }
    people = [s.runner.c, s.female.c, s.hit_c, s.climb_c, s.rifle_c]
    k = 0
    while k < 5 {
        if people[k] != null { character.character_free(people[k] as *Character) }
        k = k + 1
    }
    if s.rifle_work != null { pose.release(s.rifle_work) }
    if s.sword != null { items.item_free(s.sword as *Item) }
    if s.sword_kind != null { items.kind_free(s.sword_kind as *Kind) }
    if s.sword_c != null { character.character_free(s.sword_c as *Character) }
    if s.climb_work != null { pose.release(s.climb_work) }
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
}

heap_show() -> *Show {
    s = calloc(1, sizeof(Show)) as *Show
    s.hit_which = 0
    return s
}

// The captured walker: the UE5 mannequin on a character controller (the
// character's capsule), made a person through ae3d.character (#903) on a
// database rather than gaits:
// motion matching (#906) over 100STYLE's neutral style read whole, its eight
// takes (walks and runs ahead, back and to the side, turns, starts, stops,
// idles: 46,000 frames) and the mirrors of the side, turning and idle ones,
// carried by their root motion. Its mover walks it out along a line, stands
// it, walks it back facing the way it came (a backward walk), and stands it
// again; the matcher picks the frames that go from one to the next, as a
// person stops before stepping back. On short cuts of the takes, cut from
// its forward walk to its backward walk, its planted foot slid 36 cm at
// each end.
make_walker(s: *Show, e: *Engine) {
    c = character.humanoid(e, "Captured", MALE, null as *Gaits)
    names = ["FW", "BW", "SW", "FR", "BR", "SR", "TR1", "ID"]
    mirrored = [false, false, true, false, false, true, true, true]
    k = 0
    while k < 8 {
        _read = character.match_add(c, "${STYLE}whole/Neutral_${names[k]}.bvh.gz", mirrored[k])
        k = k + 1
    }
    wo = character.object_of(c)
    s.home = core.vec3(0.0 - LINE * 0.5, 0.0, 0.0 - 9.0)
    s.line = core.vec3(1.0, 0.0, 0.0)
    behaviour.object_set_position(wo, s.home)
    behaviour.object_set_rotation(wo, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    s.walker_c = c as ptr
    s.walker_o = wo as ptr
    s.walker_a = character.animator_of(c) as ptr
    s.walker_leg = 0
    s.walker_wait = 0.0
}

// Out along the line facing along it, a stand at its end, back along it
// still facing out (stepping backward), a stand at home; and again.
step_walker(s: *Show, dt: float) {
    wo = s.walker_o as *GameObject
    out = core.v3_dot(core.v3_sub(behaviour.object_position(wo), s.home), s.line)
    if s.walker_leg == 0 && out >= LINE { s.walker_leg = 1 }
    if s.walker_leg == 2 && out <= 0.0 { s.walker_leg = 3 }
    if s.walker_leg == 1 || s.walker_leg == 3 {
        s.walker_wait = s.walker_wait + dt
        if s.walker_wait >= WALKER_STAND {
            s.walker_wait = 0.0
            s.walker_leg = (s.walker_leg + 1) % 4
        }
    }
    asked = core.vec3(0.0, 0.0, 0.0)
    if s.walker_leg == 0 { asked = core.v3_mul(s.line, WALKER_OUT) }
    if s.walker_leg == 2 { asked = core.v3_mul(s.line, 0.0 - WALKER_BACK) }
    character.move(s.walker_c as *Character, asked, s.line)
}

// --- the figure on a stick (#856) -------------------------------------------------------------

// The UE5 mannequin made a person in one call (ae3d.character, #903): a
// stand, a start, a 2D blend of 100STYLE's walks, runs and side steps, and a
// stop (and its mirror) that enter on their feet, its feet stepping as it
// turns on the spot, its eyes ahead, and an aim offset (the runner's pistol
// aims retargeted) over its spine on a ready pose. Set up by hand it was 96
// lines and 56 calls across seven modules.
make_stick(s: *Show, e: *Engine) {
    g = character.gaits("${STYLE}neutral")
    character.gaits_set(g, character.GAIT_STOP, "${STYLE}neutral_arrive.bvh")
    character.gaits_set(g, character.GAIT_START, "${STYLE}startstop_start.bvh")
    c = character.humanoid(e, "Stick", MALE, g)
    character.gaits_free(g)
    _armed = character.aims(c, e, RIGIFY, "Pistol_Aim_Neutral", "Pistol_Aim_Up", "Pistol_Aim_Down")
    so = character.object_of(c)
    s.stick_home = core.vec3(0.0 - 4.0, 0.0, 11.0)
    behaviour.object_set_position(so, s.stick_home)
    behaviour.object_set_rotation(so, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    arm_pistol(e, &s.stick_pistol, so, character.animator_of(c))
    s.stick_c = c as ptr
    s.stick_o = so as ptr
    s.stick_a = character.animator_of(c) as ptr
    s.stick_yaw = 1.5707963
}

// Asked at the takes' own speeds, metres a second: 100STYLE's forward walk
// and run (fw, fr) go 0.86 and 1.86. Asked between them, every walk was a
// third run; Siltreach's pacer, on this graph, asks the same.
const STICK_WALK = 0.86
const STICK_RUN = 1.86

// The stick's 24 s cycle: stand, walk ahead, step left and right facing
// ahead, run, stop, turn round on the spot, walk back aiming, stop, turn
// round again.
step_stick(s: *Show, dt: float) {
    c = s.stick_c as *Character
    t = s.clock - 24.0 * floor_of(s.clock / 24.0)
    yaw = s.stick_yaw
    ahead = core.vec3(core.sin_of(yaw), 0.0, core.cos_of(yaw))
    left = core.vec3(core.cos_of(yaw), 0.0, 0.0 - core.sin_of(yaw))
    asked = core.vec3(0.0, 0.0, 0.0)
    aiming = false
    if t >= 2.0 && t < 6.0 { asked = core.v3_mul(ahead, STICK_WALK) }
    if t >= 6.0 && t < 8.0 { asked = core.v3_mul(left, 0.5) }
    if t >= 8.0 && t < 10.0 { asked = core.v3_mul(left, 0.0 - 0.5) }
    if t >= 10.0 && t < 12.0 { asked = core.v3_mul(ahead, STICK_RUN) }
    if t >= 14.0 && t < 14.0 + dt { s.stick_yaw = s.stick_yaw + 3.1415926 }
    if t >= 17.0 && t < 20.0 {
        asked = core.v3_mul(ahead, STICK_WALK)
        aiming = true
    }
    if t >= 21.0 && t < 21.0 + dt { s.stick_yaw = s.stick_yaw + 3.1415926 }
    // Strafing and turning on the spot face ahead; walking, the way it goes.
    facing = core.vec3(0.0, 0.0, 0.0)
    if t >= 6.0 && t < 10.0 || t >= 14.0 && t < 17.0 || t >= 21.0 {
        yaw = s.stick_yaw
        facing = core.vec3(core.sin_of(yaw), 0.0, core.cos_of(yaw))
    }
    character.move(c, asked, facing)
    // Aimed at a point 10 m ahead, swept up and down.
    if aiming {
        at = behaviour.object_position(character.object_of(c))
        pitch = 0.4 * core.sin_of(s.clock * 1.3)
        character.aim(c, core.vec3(at.x + ahead.x * 10.0, at.y + 1.6 + 10.0 * core.tan_of(pitch), at.z + ahead.z * 10.0))
    } else {
        character.aim_off(c)
    }
}
// --- a sword by its handle (#925) -------------------------------------------------------------

// A sword's model in the item's frame (tests/fixtures/items/sword.item): a
// grip along +y from 3 to 13 cm, a cross over it, a 76 cm blade above, a
// pommel under. The grip is the item's own model, the rest hung on it.
sword_model(e: *Engine) -> *Model {
    grip = loader.capsule(core.vec3(0.0, 0.03, 0.0), core.vec3(0.0, 0.13, 0.0), 0.013, 10, 3)
    core.model_matte(grip, 0.16, 0.10, 0.06)
    parts = [loader.cube(1.0), loader.cube(1.0), loader.sphere(1.0, 10, 8)]
    places = [core.vec3(0.0, 0.145, 0.0), core.vec3(0.0, 0.535, 0.0), core.vec3(0.0, 0.015, 0.0)]
    sizes = [core.vec3(0.18, 0.02, 0.03), core.vec3(0.045, 0.76, 0.006), core.vec3(0.026, 0.026, 0.026)]
    k = 0
    while k < 3 {
        m = parts[k]
        core.model_set_position(m, places[k].x, places[k].y, places[k].z)
        core.model_set_scale(m, sizes[k].x, sizes[k].y, sizes[k].z)
        core.model_matte(m, 0.62, 0.63, 0.66)
        core.model_set_pbr(m, 0.9, 0.3)
        engine.engine_add_model(e, m)
        core.model_set_parent(m, grip)
        k = k + 1
    }
    return grip
}

// The UE5 mannequin made a person (ae3d.character) with a sword at its left
// hip (ae3d.items): every 12 s it stands, draws it (the right hand to the
// grip, the sword from the hip to the hand), swings it twice (the
// mannequin's own Sword_Regular_A, at the pace its weight gives), and
// sheathes it.
make_swordsman(s: *Show, e: *Engine) {
    g = character.gaits("${STYLE}neutral")
    character.gaits_set(g, character.GAIT_STOP, "${STYLE}neutral_arrive.bvh")
    character.gaits_set(g, character.GAIT_START, "${STYLE}startstop_start.bvh")
    c = character.humanoid(e, "Swordsman", MALE, g)
    character.gaits_free(g)
    o = character.object_of(c)
    behaviour.object_set_position(o, core.vec3(SWORD_X, 0.0, SWORD_Z))
    behaviour.object_set_rotation(o, core.quat_rotate(0.0 - 1.5707963, core.vec3(0.0, 1.0, 0.0)))
    mover.settle(character.mover_of(c))
    kind = items.kind_read("tests/fixtures/items/sword.item")
    blade = engine.object(e, "Sword", sword_model(e))
    it = items.item_new(e, kind, blade)
    _carried = items.carry(it, character.animator_of(c), "hip_l")
    s.sword_c = c as ptr
    s.sword_kind = kind as ptr
    s.sword = it as ptr
    s.sword_o = o as ptr
    s.sword_a = character.animator_of(c) as ptr
    s.sword_beat = 0 - 1
}

const SWORD_X = 7.0
const SWORD_Z = 10.0
const SWORD_CYCLE = 12.0

step_swordsman(s: *Show, dt: float) {
    it = s.sword as *Item
    t = s.clock - SWORD_CYCLE * floor_of(s.clock / SWORD_CYCLE)
    beat = 0 - 1
    if t >= 2.0 { beat = 0 }
    if t >= 3.5 { beat = 1 }
    if t >= 6.0 { beat = 2 }
    if t >= 9.0 { beat = 3 }
    if beat == s.sword_beat { return }
    s.sword_beat = beat
    if beat == 0 { _drew = items.draw(it) }
    if beat == 1 || beat == 2 { _swung = items.swing(it, 0) }
    if beat == 3 { _put = items.sheathe(it) }
}

// --- stairs, a ramp, a bowl and a rifle (#857) ------------------------------------------------

const TREAD = 0.3
const RISE = 0.2
const STEPS = 5
const SLOPE = 0.349066
const COURSE_X = 12.0
const COURSE_Z = 0.0 - 8.0
// Radians the rifleman's rifle lies across his chest, left of its forward.
const BLADE = 0.611
// Of the walk's stride, the steps up and down the 20 degree ramp: a steep
// trail's, where people step short (tests/test_ik_constraints.ae's too).
const SLOPE_STRIDE = 0.7

// A static box `half` big, its middle `along` the course and `high` up,
// pitched `pitch` (its top rising along the course's way, +z).
course_box(e: *Engine, along: float, high: float, half: Vec3, pitch: float) {
    b = engine.object(e, "Course", loader.cube(1.0))
    behaviour.object_set_position(b, core.vec3(COURSE_X, high, COURSE_Z + along))
    behaviour.object_set_rotation(b, core.quat_rotate(0.0 - pitch, core.vec3(1.0, 0.0, 0.0)))
    behaviour.object_set_scale(b, core.v3_mul(half, 2.0))
    bm = behaviour.object_model(b)
    core.model_set_diffuse(bm, 0.42, 0.40, 0.37)
    core.model_set_pbr(bm, 0.0, 0.85)
    physics.box_collider(b, half, physics.material(0.8, 0.0))
}

// The climber: the Rigify mannequin on a character controller walking a
// course of five 0.2 m stairs 0.3 m deep up, a landing and five down, then a
// 20 degree ramp up, a top and one down, a bowl held in both hands; on the
// stairs its stride cut to a tread a step, on the ramp to SLOPE_STRIDE
// (ikrig.feet_set_stride), at as much of its speed. Its feet on the ground
// by ikrig: soles traced heel to toe, laid on the ramp, toes bent at the
// ball as the heel rises, the pelvis down by what the lower leg needs. From
// the course's end it starts again.
make_climber(s: *Show, e: *Engine) {
    up_end = 1.5 + TREAD * (STEPS as float)
    down_end = up_end + 2.0 + TREAD * (STEPS as float)
    k = 1
    while k <= STEPS {
        from = 1.5 + TREAD * ((k - 1) as float)
        to = down_end - TREAD * ((k - 1) as float)
        course_box(e, (from + to) * 0.5, RISE * (k as float) * 0.5, core.vec3(1.0, RISE * (k as float) * 0.5, (to - from) * 0.5), 0.0)
        k = k + 1
    }
    run = 3.0
    high = run * sin(SLOPE)
    flat = run * cos(SLOPE)
    thick = 0.25
    first = down_end + 2.0
    course_box(e, first + flat * 0.5 + thick * sin(SLOPE), high * 0.5 - thick * cos(SLOPE), core.vec3(1.0, thick, run * 0.5), SLOPE)
    course_box(e, first + flat + 1.0, high * 0.5, core.vec3(1.0, high * 0.5, 1.0), 0.0)
    course_box(e, first + flat + 2.0 + flat * 0.5 - thick * sin(SLOPE), high * 0.5 - thick * cos(SLOPE), core.vec3(1.0, thick, run * 0.5), 0.0 - SLOPE)
    s.climb_stairs = down_end
    s.climb_end = first + flat * 2.0 + 2.0 + 1.5
    s.climb_ramp = first
    // A person walking at its own cadence (tests/fixtures/graphs/climb.graph),
    // moved by its capsule up the stairs and the ramp.
    c = character.graphed(e, "Climber", RIGIFY, "${GRAPHS}climb.graph")
    co = character.object_of(c)
    s.climb_start = core.vec3(COURSE_X, 0.0, COURSE_Z)
    behaviour.object_set_position(co, s.climb_start)
    mover.settle(character.mover_of(c))
    ca = character.animator_of(c)
    walk = animgraph.take_of(character.graph_of(c), "walk")
    feet = character.feet_of(c)
    hands = ikrig.hands_new(animator.rig(ca))
    animator.set_hands(ca, hands)
    s.climb_walk_speed = clips.speed(walk)
    s.climb_full_stride = clips.speed(walk) * clips.duration(walk) * 0.5
    s.climb_stride = 1.0
    bowl = engine.object(e, "Bowl", loader.cube(1.0))
    behaviour.object_set_scale(bowl, parcel_size())
    core.model_set_diffuse(behaviour.object_model(bowl), 0.75, 0.55, 0.30)
    s.climb_c = c as ptr
    s.climb_o = co as ptr
    s.climb_a = ca as ptr
    s.climb_feet = feet as ptr
    s.climb_hands = hands as ptr
    s.climb_bowl = bowl as ptr
    w = pose.new(animator.rig(ca))
    pose.rest_world(animator.rig(ca), w)
    s.climb_belly = ikrig.to_ground(animator.rig(ca), pose.translation(w, pose.human(animator.rig(ca), pose.SPINE_01))).y - s.climb_start.y
    // The parcel carried at the belly, 25 cm ahead, held on spine_02 so it goes
    // as the trunk does.
    r = animator.rig(ca)
    spine = pose.human(r, pose.SPINE_02)
    s.climb_spine_rest = pose.rotation(w, spine)
    into = core.quat_conjugate(s.climb_spine_rest)
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    belly = pose.translation(w, pose.human(r, pose.SPINE_01))
    box_at = core.v3_add(belly, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 0.25)))
    s.climb_box = core.quat_apply(into, core.v3_sub(box_at, pose.translation(w, spine)))
    left = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0))))
    ahead = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 1.0))))
    down = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))))
    // Held as its size and weight say (ikrig.hands_hold_box): too wide for
    // one hand, too light to need carrying from under, so in both hands on
    // its sides; its weight leans the trunk back (#908).
    half = core.v3_mul(parcel_size(), 0.5 * unit)
    _held = ikrig.hands_hold_box(hands, r, spine, s.climb_box, core.v3_mul(left, 0.0 - 1.0), core.v3_mul(down, 0.0 - 1.0), ahead, half, PARCEL_MASS, 1.0)
    s.climb_work = pose.new(r)
    pose.release(w)
}

step_climber(s: *Show, dt: float) {
    co = s.climb_o as *GameObject
    at = behaviour.object_position(co)
    along = at.z - COURSE_Z
    if along >= s.climb_end {
        // Taken back to the start of its course: its feet let go of where
        // they stood, it is drawn there at once, and its meter starts afresh.
        // Its feet still held at the far end, it skated 2 m.
        behaviour.object_set_position(co, s.climb_start)
        ikrig.feet_reset(s.climb_feet as *Feet)
        mover.settle(character.mover_of(s.climb_c as *Character))
        core.model_reset_interpolation(behaviour.object_model(co))
        if s.seen != null && (s.seen as ptr[])[5] != null { metrics.meter_moved((s.seen as ptr[])[5] as *Meter) }
        at = s.climb_start
        along = 0.0
    }
    // A tread a step on the stairs and short steps on the ramp, eased in and
    // out over half a second.
    wanted = 1.0
    if along > 1.2 && along < s.climb_stairs + 0.3 { wanted = TREAD / s.climb_full_stride }
    if along > s.climb_ramp - 0.3 && along < s.climb_end - 1.2 { wanted = SLOPE_STRIDE }
    s.climb_stride = s.climb_stride + (wanted - s.climb_stride) * core.clampf(dt * 2.0, 0.0, 1.0)
    ikrig.feet_set_stride(s.climb_feet as *Feet, s.climb_stride)
    character.move(s.climb_c as *Character, core.vec3(0.0, 0.0, s.climb_walk_speed * s.climb_stride), core.vec3(0.0, 0.0, 0.0))
}

// The rifleman: the UE5 mannequin standing on its idle, a rifle held bladed
// (its barrel across the chest, 35 degrees off its forward) on the chest,
// the trunk aimed at a point that sweeps 35 degrees either way at 10 m and
// rises and falls, both hands on the rifle's grip and fore-end (ikrig: the
// aim spread up the spine, then the hands solved onto the rifle where the
// aim put it).
make_rifleman(s: *Show, e: *Engine) {
    c = character.graphed(e, "Rifleman", MALE, "${GRAPHS}stand.graph")
    ro = character.object_of(c)
    behaviour.object_set_position(ro, core.vec3(0.0 - 12.0, 0.0, 4.0))
    mover.settle(character.mover_of(c))
    ra = character.animator_of(c)
    r = animator.rig(ra)
    hands = ikrig.hands_new(r)
    animator.set_hands(ra, hands)
    chest = pose.human(r, pose.SPINE_03)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    into = core.quat_conjugate(pose.rotation(rest, chest))
    ahead = core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 1.0)))
    down = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))))
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    up = core.v3_mul(down, 0.0 - 1.0)
    across = core.v3_normalize(core.v3_add(core.v3_mul(ahead, cos(BLADE)), core.v3_mul(core.v3_normalize(core.v3_cross(up, ahead)), sin(BLADE))))
    butt = core.v3_add(core.quat_apply(into, core.v3_sub(pose.translation(rest, pose.human(r, pose.UPPERARM_R)), pose.translation(rest, chest))), core.v3_mul(ahead, 0.08 * unit))
    pose.release(rest)
    ikrig.aim_set_line(animator.trunk_aim(ra), butt, across)
    // A rifle as one is built, in its own frame (along the barrel, up and
    // right of it, from the butt): a stock and receiver 78 cm long and 7 cm
    // deep, a pistol grip under it 21 cm from the butt raked 20 degrees
    // back, and a trigger ahead of the grip. Held as a person holds one
    // (#907): the right hand round the pistol grip, its palm on the grip's
    // right side and the fingers round its front, the thumb over, the
    // index on the trigger; the left hand under the fore-end, palm up, the
    // fingers across it and round it.
    right = core.v3_normalize(core.v3_cross(across, up))
    rake = 0.349
    grip_down = core.v3_normalize(core.v3_sub(core.v3_mul(down, cos(rake)), core.v3_mul(across, sin(rake))))
    grip_mid = core.v3_add(core.v3_add(butt, core.v3_mul(across, 0.21 * unit)), core.v3_add(core.v3_mul(down, 0.035 * unit), core.v3_mul(grip_down, 0.05 * unit)))
    trigger = core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.265 * unit), core.v3_mul(down, 0.05 * unit)))
    around = core.v3_normalize(core.v3_sub(across, core.v3_mul(grip_down, core.v3_dot(across, grip_down))))
    ikrig.hands_hold(hands, 1, chest, core.v3_add(grip_mid, core.v3_mul(right, 0.027 * unit)), core.v3_mul(right, 0.0 - 1.0), around, 0.85, 1.0)
    ikrig.hands_fingers(hands, 1, 0.6, 0.3, 0.85, 0.85, 0.85)
    ikrig.hands_trigger(hands, 1, chest, trigger, 0.0)
    ikrig.hands_hold(hands, 0, chest, core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.45 * unit), core.v3_mul(down, 0.047 * unit))), up, right, 0.55, 1.0)
    s.rifle_up = up
    s.rifle_grip_at = grip_mid
    s.rifle_grip_down = grip_down
    s.rifle_trigger_at = trigger
    grip = engine.object(e, "Rifle grip", loader.cube(1.0))
    behaviour.object_set_scale(grip, core.vec3(0.03, 0.10, 0.04))
    core.model_set_diffuse(behaviour.object_model(grip), 0.10, 0.10, 0.11)
    s.rifle_grip = grip as ptr
    pull = engine.object(e, "Rifle trigger", loader.cube(1.0))
    behaviour.object_set_scale(pull, core.vec3(0.008, 0.024, 0.006))
    core.model_set_diffuse(behaviour.object_model(pull), 0.55, 0.50, 0.40)
    s.rifle_trigger = pull as ptr
    gun = engine.object(e, "Rifle", loader.cube(1.0))
    behaviour.object_set_scale(gun, core.vec3(0.04, 0.07, 0.78))
    core.model_set_diffuse(behaviour.object_model(gun), 0.12, 0.12, 0.13)
    s.rifle_c = c as ptr
    s.rifle_o = ro as ptr
    s.rifle_a = ra as ptr
    s.rifle_gun = gun as ptr
    s.rifle_butt = butt
    s.rifle_axis = across
    s.rifle_work = pose.new(r)
}

step_rifleman(s: *Show) {
    ra = s.rifle_a as *Animator
    sweep = 0.611 * sin(s.clock * 0.5)
    rise = 0.15 + 0.12 * sin(s.clock * 0.37)
    way = core.vec3(sin(sweep) * cos(rise), sin(rise), cos(sweep) * cos(rise))
    target = core.v3_add(core.vec3(0.0 - 12.0, 1.45, 4.0), core.v3_mul(way, 10.0))
    // The whole body turns to the target, as someone aiming does: the hips
    // and feet (stepping as they turn, ikrig.feet_set_steps) face the way
    // the chest does with the rifle held bladed across it, so the spine
    // carries only what is left. Turned by the spine alone, the chest stood
    // 55 degrees off the hips.
    yaw = sweep - BLADE
    character.move(s.rifle_c as *Character, core.vec3(0.0, 0.0, 0.0), core.vec3(sin(yaw), 0.0, cos(yaw)))
    animator.aim_at(ra, target, 1.0)
    // Its eyes on the target, along the barrel.
    character.look(s.rifle_c as *Character, target)
}

// A pistol in a figure's right hand (#907), held as one is: its grip in
// the palm, the middle, ring and little fingers round its front, the thumb
// round its other side, the index on the trigger. It goes where the hand
// goes, aiming or swinging, so the hand is held where its clip puts it (on
// its own joint) and only its fingers close. A pistol as one is built: a
// slide 19 cm long, 3 cm wide and 3.2 cm deep over a grip 11 cm long, 3 cm
// wide and 4.6 cm front to back, raked 18 degrees back, its trigger 2 cm
// under the slide and 4.8 cm ahead of the grip's middle. Aimed without it,
// a figure held its hands round nothing.
arm_pistol(e: *Engine, p: *Pistol, o: *GameObject, a: *Animator) {
    r = animator.rig(a)
    h = ikrig.hands_new(r)
    if h == null { return }
    animator.set_hands(a, h)
    hand = pose.human(r, pose.HAND_R)
    index = pose.human(r, pose.FINGERS + 15 + 1 * 3)
    middle = pose.human(r, pose.FINGERS + 15 + 2 * 3)
    pinky = pose.human(r, pose.FINGERS + 15 + 4 * 3)
    if hand < 0 || index < 0 || middle < 0 || pinky < 0 { return }
    rest = pose.new(r)
    pose.rest_world(r, rest)
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    hp = pose.translation(rest, hand)
    back = core.quat_conjugate(pose.rotation(rest, hand))
    // The palm, the way it faces and the way the fingers go, in the hand's
    // own frame; across the hand from the index to the little finger.
    palm_g, faces_g = ikrig.hands_palm(h, r, rest, 1)
    palm = core.quat_apply(back, core.v3_sub(ikrig.to_rig(r, palm_g), hp))
    facing = core.v3_normalize(core.quat_apply(back, ikrig.dir_to_rig(r, faces_g)))
    along = core.quat_apply(back, core.v3_sub(pose.translation(rest, middle), hp))
    along = core.v3_normalize(core.v3_sub(along, core.v3_mul(facing, core.v3_dot(along, facing))))
    across = core.quat_apply(back, core.v3_sub(pose.translation(rest, pinky), pose.translation(rest, index)))
    across = core.v3_sub(across, core.v3_mul(facing, core.v3_dot(across, facing)))
    across = core.v3_normalize(core.v3_sub(across, core.v3_mul(along, core.v3_dot(across, along))))
    pose.release(rest)
    // Down the grip from the web of the thumb to the little finger, raked
    // back toward the wrist; the barrel square to it, along the forearm.
    rake = 0.314
    p.grip_down = core.v3_normalize(core.v3_sub(core.v3_mul(across, cos(rake)), core.v3_mul(along, sin(rake))))
    p.barrel = core.v3_normalize(core.v3_add(core.v3_mul(along, cos(rake)), core.v3_mul(across, sin(rake))))
    // The grip's middle out from the palm by half its width and the palm's
    // flesh; the slide on its top; the trigger ahead of its front.
    p.grip_at = core.v3_add(palm, core.v3_mul(facing, 0.025 * unit))
    top = core.v3_sub(p.grip_at, core.v3_mul(p.grip_down, 0.055 * unit))
    p.slide_at = core.v3_add(core.v3_sub(top, core.v3_mul(p.grip_down, 0.016 * unit)), core.v3_mul(p.barrel, 0.06 * unit))
    p.trigger_at = core.v3_add(core.v3_add(top, core.v3_mul(p.grip_down, 0.02 * unit)), core.v3_mul(p.barrel, 0.048 * unit))
    p.hand = hand
    ikrig.hands_hold(h, 1, hand, palm, facing, along, 0.85, 1.0)
    ikrig.hands_fingers(h, 1, 0.6, 0.3, 0.85, 0.85, 0.85)
    ikrig.hands_trigger(h, 1, hand, p.trigger_at, 0.0)
    slide = engine.object(e, "Pistol slide", loader.cube(1.0))
    behaviour.object_set_scale(slide, core.vec3(0.03, 0.032, 0.19))
    core.model_set_diffuse(behaviour.object_model(slide), 0.11, 0.11, 0.12)
    grip = engine.object(e, "Pistol grip", loader.cube(1.0))
    behaviour.object_set_scale(grip, core.vec3(0.03, 0.11, 0.046))
    core.model_set_diffuse(behaviour.object_model(grip), 0.16, 0.14, 0.12)
    pull = engine.object(e, "Pistol trigger", loader.cube(1.0))
    behaviour.object_set_scale(pull, core.vec3(0.006, 0.02, 0.006))
    core.model_set_diffuse(behaviour.object_model(pull), 0.55, 0.50, 0.40)
    p.o = o as ptr
    p.a = a as ptr
    p.slide = slide as ptr
    p.grip = grip as ptr
    p.trigger = pull as ptr
    p.work = pose.new(r)
}

// The pistol where the drawn right hand holds it.
draw_pistol(p: *Pistol) {
    if p.a == null { return }
    a = p.a as *Animator
    r = animator.rig(a)
    w = p.work
    pose.world(r, animator.pose_now(a), w)
    turn = pose.rotation(w, p.hand)
    at = pose.translation(w, p.hand)
    barrel = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, p.barrel)))
    up = core.v3_mul(core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, p.grip_down))), 0.0 - 1.0)
    up = core.v3_normalize(core.v3_sub(up, core.v3_mul(barrel, core.v3_dot(up, barrel))))
    side = core.v3_cross(up, barrel)
    slide = p.slide as *GameObject
    behaviour.object_set_position(slide, ikrig.to_ground(r, core.v3_add(at, core.quat_apply(turn, p.slide_at))))
    behaviour.object_set_rotation(slide, core.quat_from_axes(side, up, barrel))
    // The grip raked back: its long axis up it.
    up_grip = core.v3_mul(core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, p.grip_down))), 0.0 - 1.0)
    ahead_grip = core.v3_cross(side, up_grip)
    grip = p.grip as *GameObject
    behaviour.object_set_position(grip, ikrig.to_ground(r, core.v3_add(at, core.quat_apply(turn, p.grip_at))))
    behaviour.object_set_rotation(grip, core.quat_from_axes(side, up_grip, ahead_grip))
    pull = p.trigger as *GameObject
    behaviour.object_set_position(pull, ikrig.to_ground(r, core.v3_add(at, core.quat_apply(turn, p.trigger_at))))
    behaviour.object_set_rotation(pull, core.quat_from_axes(side, up_grip, ahead_grip))
}

// The props on the pose drawn: the rifle where the aimed chest holds it,
// the box where the climber's spine holds it.
place_props(state: ptr, e: *Engine) {
    s = state as *Show
    if s.rifle_a != null { draw_rifle(s) }
    if s.climb_a != null { draw_box(s) }
    draw_pistol(&s.female_pistol)
    draw_pistol(&s.stick_pistol)
}

// The box at the climber's belly, turned as its spine turned from rest.
draw_box(s: *Show) {
    ca = s.climb_a as *Animator
    r = animator.rig(ca)
    w = s.climb_work
    pose.world(r, animator.pose_now(ca), w)
    spine = pose.human(r, pose.SPINE_02)
    turn = pose.rotation(w, spine)
    at = core.v3_add(pose.translation(w, spine), core.quat_apply(turn, s.climb_box))
    box = s.climb_bowl as *GameObject
    behaviour.object_set_position(box, ikrig.to_ground(r, at))
    rel = core.quat_mul(turn, core.quat_conjugate(s.climb_spine_rest))
    ax = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(rel, ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))))
    ay = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(rel, ikrig.dir_to_rig(r, core.vec3(0.0, 1.0, 0.0)))))
    az = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(rel, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 1.0)))))
    behaviour.object_set_rotation(box, core.quat_from_axes(ax, ay, az))
}

// The rifle where the aimed chest holds it, on the pose drawn: its stock and
// receiver, its pistol grip and its trigger, each in the rifle's frame.
draw_rifle(s: *Show) {
    ra = s.rifle_a as *Animator
    r = animator.rig(ra)
    w = s.rifle_work
    pose.world(r, animator.pose_now(ra), w)
    chest = pose.human(r, pose.SPINE_03)
    turn = pose.rotation(w, chest)
    at = pose.translation(w, chest)
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    butt = core.v3_add(at, core.quat_apply(turn, s.rifle_butt))
    middle = core.v3_add(butt, core.v3_mul(core.quat_apply(turn, s.rifle_axis), 0.39 * unit))
    barrel = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, s.rifle_axis)))
    top = ikrig.dir_to_ground(r, core.quat_apply(turn, s.rifle_up))
    top = core.v3_normalize(core.v3_sub(top, core.v3_mul(barrel, core.v3_dot(top, barrel))))
    side = core.v3_cross(top, barrel)
    gun = s.rifle_gun as *GameObject
    behaviour.object_set_position(gun, ikrig.to_ground(r, middle))
    behaviour.object_set_rotation(gun, core.quat_from_axes(side, top, barrel))
    // The grip raked back: its long axis up it, from its foot.
    up_grip = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, core.v3_mul(s.rifle_grip_down, 0.0 - 1.0))))
    ahead_grip = core.v3_cross(side, up_grip)
    grip = s.rifle_grip as *GameObject
    behaviour.object_set_position(grip, ikrig.to_ground(r, core.v3_add(at, core.quat_apply(turn, s.rifle_grip_at))))
    behaviour.object_set_rotation(grip, core.quat_from_axes(side, up_grip, ahead_grip))
    pull = s.rifle_trigger as *GameObject
    behaviour.object_set_position(pull, ikrig.to_ground(r, core.v3_add(at, core.quat_apply(turn, s.rifle_trigger_at))))
    behaviour.object_set_rotation(pull, core.quat_from_axes(side, top, barrel))
}

// --- what a player would see wrong (AE3D_METRICS=1) -------------------------------------------

// Per figure, on the pose drawn, the worst through the run of what reads as
// wrong at a glance, measured by ae3d.metrics (the definitions the tests and
// a game's scorecard use too) and printed every METRIC_EVERY seconds, with a
// flag past these bounds:
//   the legs closer than LEGS_TOUCH (one leg through the other);
//   a knee bent out, or in, past KNEE_OUT off the way the hips face;
//   the chest turned past TWIST_MOST off the hips;
//   a forearm rolled past ROLL_MOST off its upper arm;
//   a foot past the hips' middle;
//   a toe skating past SKATE_MOST a stance;
//   a sole SINK_MOST into the ground.
// Not a test: a way to find the moment a defect shows, by its clock.
const LEGS_TOUCH = 0.08
const KNEE_OUT = 0.7854
const TWIST_MOST = 0.8727
const ROLL_MOST = 2.0944
const SKATE_MOST = 0.005
const SINK_MOST = 0.005
const METRIC_EVERY = 10.0

degrees(x: float) -> float { return x * 57.29578 }

joint_named(r: *pose.Rig, j: int) -> string {
    if j < 0 { return "none" }
    return pose.name(r, j)
}

seen_print(m: *Meter, name: string, r: *pose.Rig) {
    flag = ""
    if metrics.meter_worst(m, metrics.LEGS_APART) < LEGS_TOUCH { flag = "${flag} LEGS-TOUCH" }
    if metrics.meter_worst(m, metrics.KNEE_OUT) > KNEE_OUT { flag = "${flag} KNEE-OUT" }
    if metrics.meter_worst(m, metrics.KNEE_IN) > KNEE_OUT { flag = "${flag} KNEE-IN" }
    if metrics.meter_worst(m, metrics.CHEST_TWIST) > TWIST_MOST { flag = "${flag} TWISTED" }
    if metrics.meter_worst(m, metrics.FOREARM_ROLL) > ROLL_MOST { flag = "${flag} FOREARM-ROLL" }
    if metrics.meter_worst(m, metrics.FEET_CROSS) > 0.0 { flag = "${flag} FEET-CROSS" }
    if metrics.meter_worst(m, metrics.SKATE) > SKATE_MOST { flag = "${flag} SKATING" }
    if metrics.meter_worst(m, metrics.INTO_GROUND) > SINK_MOST { flag = "${flag} SINKING" }
    println("  ${name}: legs ${metrics.meter_worst(m, metrics.LEGS_APART) * 100.0} cm apart at the closest (${metrics.meter_when(m, metrics.LEGS_APART)} s); a knee ${degrees(metrics.meter_worst(m, metrics.KNEE_OUT))} degrees out (${metrics.meter_when(m, metrics.KNEE_OUT)} s) and ${degrees(metrics.meter_worst(m, metrics.KNEE_IN))} in (${metrics.meter_when(m, metrics.KNEE_IN)} s); chest ${degrees(metrics.meter_worst(m, metrics.CHEST_TWIST))} degrees off the hips (${metrics.meter_when(m, metrics.CHEST_TWIST)} s); a forearm rolled ${degrees(metrics.meter_worst(m, metrics.FOREARM_ROLL))} degrees (${metrics.meter_when(m, metrics.FOREARM_ROLL)} s); a foot ${metrics.meter_worst(m, metrics.FEET_CROSS) * 100.0} cm over the middle (${metrics.meter_when(m, metrics.FEET_CROSS)} s); a toe skated ${metrics.meter_worst(m, metrics.SKATE) * 1000.0} mm (${metrics.meter_when(m, metrics.SKATE)} s); a sole ${metrics.meter_worst(m, metrics.INTO_GROUND) * 1000.0} mm into the ground (${metrics.meter_when(m, metrics.INTO_GROUND)} s); the fastest turn ${metrics.meter_worst(m, metrics.POP)} rad/s (${joint_named(r, metrics.meter_joint(m, metrics.POP))}, ${metrics.meter_when(m, metrics.POP)} s)${flag}")
    metrics.meter_reset(m)
}

// The figures the metrics measure.
const FIGURES = 8

metrics(s: *Show, e: *Engine, step: float) {
    if core.env_int("AE3D_METRICS", 0) == 0 { return }
    animators = [s.runner.a, s.female.a, s.hit_a, s.walker_a, s.stick_a, s.climb_a, s.rifle_a, s.sword_a]
    if s.seen == null {
        seen = calloc(FIGURES, 8) as ptr[]
        k = 0
        while k < FIGURES {
            seen[k] = null
            a = animators[k] as *Animator
            if a != null {
                m = metrics.meter_new(animator.rig(a), animator.figure_object(a))
                metrics.meter_ground_physics(m, physics.of(e))
                seen[k] = m as ptr
            }
            k = k + 1
        }
        s.seen = seen as ptr
        s.seen_next = METRIC_EVERY
    }
    seen = s.seen as ptr[]
    k = 0
    while k < FIGURES {
        if seen[k] != null { metrics.meter_take(seen[k] as *Meter, step) }
        k = k + 1
    }
    if s.clock >= s.seen_next {
        names = ["the runner", "the female", "the hit figure", "the captured walker", "the figure on a stick", "the climber", "the rifleman", "the swordsman"]
        println("anim_showcase: at ${s.clock} s, the worst a player would see in the last ${METRIC_EVERY} s:")
        k = 0
        while k < FIGURES {
            if seen[k] != null { seen_print(seen[k] as *Meter, names[k], animator.rig(animators[k] as *Animator)) }
            k = k + 1
        }
        s.seen_next = s.seen_next + METRIC_EVERY
    }
}
