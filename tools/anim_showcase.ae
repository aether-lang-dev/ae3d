// The animation pipeline's showcase (#853 to #857): real people on the
// new layers, for a person to watch. Not a test: ci.sh never builds it.
//
//   ./build.sh tools/anim_showcase.ae && ./build/anim_showcase
//   AE3D_WATCH=1 (follow the runner), 2 (the female), 3 (the hit figure),
//   4 (the captured walker), 5 (the figure on a stick), 6 (the climber),
//   7 (the rifleman); AE3D_WATCH_FRONT=1 watches it from in front;
//   0 or unset, the whole scene from a slow orbit.
//
//   - the runner (the Rigify mannequin, tests/fixtures/people/ual1_rigify.glb)
//     goes round a circle through a 20 s cycle: standing, walking, jogging,
//     running, sprinting, slowing and stopping, its walk, jog and sprint
//     blended by speed and synced on their footfalls, its feet locked on the
//     ground (ikrig), its head turned to the camera;
//   - the female mannequin (UE5's skeleton) runs the same cycle a quarter of
//     a turn behind on the runner's gaits retargeted onto her, aiming a
//     pistol over her walk (an upper-body layer);
//   - the UE5 mannequin stands with a foot up on a 12 cm block on its own
//     idle (UAL2), the runner's chest and head hits retargeted onto it and
//     added over the idle every few seconds, its head following the runner;
//   - the UE5 mannequin again, on a character controller, walks out along a
//     line and back on 100STYLE's captured forward and backward walks
//     (motion capture read from BVH, retargeted with its feet kept and a
//     root made under its hips), carried by their root motion;
//   - the Rigify mannequin again walks up and down 0.2 m stairs (a tread a
//     step, its stride cut to fit) and over a 20 degree ramp, a bowl in
//     both hands, its soles on the ground heel to toe (#857);
//   - the UE5 mannequin stands holding a rifle bladed in both hands,
//     aiming it at a point sweeping before it, the aim spread up its spine
//     and its hands solved onto the rifle where the aim put it (#857).
//
// AE3D_METRICS=1 prints every 10 s, per figure, the worst a player would
// see: legs through each other, a knee bent out, the chest twisted off the
// hips, a forearm over-rolled, and when.
//
// Each cycle prints, per mover, the worst a planted toe slid and how the
// speed was matched.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.ikrig
import ae3d.retarget
import ae3d.bvh
import ae3d.mover

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sin(x: float) -> float
extern cos(x: float) -> float
extern atan2(y: float, x: float) -> float

const RIGIFY = "tests/fixtures/people/ual1_rigify.glb"
const FEMALE = "tests/fixtures/people/mannequin_f.glb"
const MALE = "tests/fixtures/people/mannequin.glb"
const RADIUS = 5.0
const CYCLE = 20.0
const ACCELERATION = 3.0           // m/s a second the movers speed up and slow down at
const STYLE = "tests/fixtures/people/100style/"
const LINE = 1.4                   // metres the captured walker goes out and back

// A figure going round a circle on its gaits.
struct Circler {
    o: ptr                         // *GameObject
    a: ptr                         // *Animator
    feet: ptr                      // *Feet
    move: int
    idle: int
    aim: int                       // layer, -1 none
    centre: Vec3
    angle: float                   // round the circle
    speed: float
    offset: float                  // seconds behind the cycle
    toes: ptr                      // float[6]: where each toe was planted
    planted: ptr                   // float[2]
    worst: float                   // worst toe slide this cycle
}

struct Show {
    runner: Circler
    female: Circler
    hit_o: ptr
    hit_a: ptr
    hits: ptr                      // int[2]: the hit layers
    hit_next: float
    hit_which: int
    clock: float
    cycle: int
    camera_angle: float
    walker_o: ptr                  // *GameObject: the captured walker
    walker_a: ptr                  // *Animator
    forward: int                   // its states
    back: int
    going_back: bool
    home: Vec3                     // where its line starts
    line: Vec3                     // and the way it runs (the walker's facing)
    stick_o: ptr                   // *GameObject: the figure on a stick
    stick_a: ptr                   // *Animator
    stick_m: ptr                   // *Mover (ae3d.mover)
    stick_aim: int                 // its aim offset
    stick_yaw: float               // the way its stick faces it
    stick_home: Vec3
    climb_o: ptr                   // the climber (#857)
    climb_a: ptr
    climb_feet: ptr
    climb_hands: ptr
    climb_bowl: ptr
    climb_start: Vec3
    climb_stairs: float            // where its stairs end along the course
    climb_end: float
    climb_stride: float
    climb_full_stride: float
    climb_walk_speed: float
    climb_belly: float
    climb_ramp: float              // where its ramp starts along the course
    rifle_o: ptr                   // the rifleman (#857)
    rifle_a: ptr
    rifle_gun: ptr
    rifle_butt: Vec3
    rifle_axis: Vec3
    rifle_work: ptr
    seen: ptr                      // ptr[7] of *Seen (AE3D_METRICS)
    seen_next: float
}

// The speed the cycle asks for `t` seconds in.
wanted_speed(t: float) -> float {
    x = t - CYCLE * floor_of(t / CYCLE)
    if x < 2.0 { return 0.0 }
    if x < 6.0 { return 1.2 }
    if x < 9.0 { return 3.5 }
    if x < 12.0 { return 6.0 }
    if x < 14.5 { return 8.5 }
    if x < 16.5 { return 3.0 }
    if x < 19.0 { return 1.2 }
    return 0.0
}

floor_of(x: float) -> float {
    i = x as int
    f = i as float
    if f > x { f = f - 1.0 }
    return f
}

make_mover(e: *Engine, m: *Circler, o: *GameObject, a: *Animator, centre: Vec3, offset: float) {
    m.o = o as ptr
    m.a = a as ptr
    m.centre = centre
    m.offset = offset
    m.aim = 0 - 1
    m.toes = calloc(6, 8)
    m.planted = calloc(2, 8)
    f = ikrig.feet_new(animator.rig(a), o)
    ikrig.feet_ground_physics(f, physics.of(e))
    animator.set_feet(a, f)
    m.feet = f as ptr
    animator.play(a, m.idle, 0.0)
    place(m, 0.0)
}

// The mover on its circle at its angle, facing along it.
place(m: *Circler, dt: float) {
    o = m.o as *GameObject
    at = core.vec3(m.centre.x + RADIUS * sin(m.angle), 0.0, m.centre.z + RADIUS * cos(m.angle))
    behaviour.object_set_position(o, at)
    // Going round anticlockwise seen from above: the tangent.
    tx = cos(m.angle)
    tz = 0.0 - sin(m.angle)
    behaviour.object_set_rotation(o, core.quat_rotate(atan2(tx, tz), core.vec3(0.0, 1.0, 0.0)))
}

step_mover(s: *Show, m: *Circler, dt: float, look: Vec3) {
    a = m.a as *Animator
    goal = wanted_speed(s.clock - m.offset)
    if m.speed < goal {
        m.speed = m.speed + ACCELERATION * dt
        if m.speed > goal { m.speed = goal }
    } else if m.speed > goal {
        m.speed = m.speed - ACCELERATION * dt
        if m.speed < goal { m.speed = goal }
    }
    moving = animator.current(a) == m.move
    if m.speed > 0.25 && !moving { animator.play(a, m.move, 0.35) }
    if m.speed <= 0.1 && moving { animator.play(a, m.idle, 0.4) }
    animator.set_param(a, m.move, m.speed)
    if animator.current(a) == m.move {
        m.angle = m.angle + m.speed * dt / RADIUS
        place(m, dt)
    }
    if m.aim >= 0 {
        w = 0.0
        if m.speed > 0.4 && m.speed < 2.0 { w = 1.0 }
        animator.layer_weight(a, m.aim, w, 0.4)
    }
    animator.look_at(a, look, 0.7)
}

// The worst a planted toe slid since the cycle began, measured on the pose
// drawn, as the motion test measures it.
measure(m: *Circler) {
    a = m.a as *Animator
    r = animator.rig(a)
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    toes = m.toes as float[]
    planted = m.planted as float[]
    side = 0
    while side < 2 {
        down = animator.contact_weight(a, side) > 0.99 && animator.current(a) == m.move
        now = (animator.plant_weight(a, side) > 0.99 || planted[side] > 0.5) && down
        tip = ikrig.toe_tip(m.feet as *Feet, r, w, side)
        if now && planted[side] < 0.5 {
            toes[side * 3] = tip.x
            toes[side * 3 + 2] = tip.z
        }
        if now {
            dx = tip.x - toes[side * 3]
            dz = tip.z - toes[side * 3 + 2]
            d = core.sqrt_of(dx * dx + dz * dz)
            if d > m.worst { m.worst = d }
            ankle = ikrig.to_ground(r, pose.translation(w, pose.human(r, pose.FOOT_L + side * 4)))
            aim = ikrig.feet_target(m.feet as *Feet, side)
            miss = core.v3_len(core.v3_sub(ankle, aim))
            if core.env_int("TRACE", 0) == 1 && d > 0.005 { println("    SLIDE side ${side} ${d * 1000.0} mm: ankle off its target ${miss * 1000.0} mm, speed ${m.speed}, pace state ${animator.current(a)}, transitioning ${animator.transitioning(a)}, locked ${ikrig.feet_locked(m.feet as *Feet, side)}, down ${animator.contact_weight(a, side)} planted ${animator.plant_weight(a, side)}") }
        }
        planted[side] = 0.0
        if now { planted[side] = 1.0 }
        side = side + 1
    }
    pose.release(w)
}

// The Rigify mannequin's gaits (or retargeted onto `a`'s rig from `source`).
add_gaits(a: *Animator, source: *pose.Rig, scene: *GltfScene) -> int {
    s = animator.add_blend(a, "move")
    names = ["Walk_Loop", "Jog_Fwd_Loop", "Sprint_Loop"]
    k = 0
    while k < 3 {
        t = null as *Take
        if source == null {
            t = animator.take(a, names[k], false)
        } else {
            made = clips.from_scene(source, scene, names[k], 0.0)
            t = animator.add_take(a, retarget.retarget(source, made, animator.rig(a)), false)
            clips.take_free(made)
        }
        animator.blend_add(a, s, t, clips.speed(t))
        k = k + 1
    }
    return s
}

start(state: ptr, e: *Engine) {
    s = state as *Show
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(60.0, 1.0, 60.0))
    // A dark, rough ground the figures read against.
    gm = behaviour.object_model(ground)
    core.model_set_diffuse(gm, 0.20, 0.21, 0.23)
    core.model_set_pbr(gm, 0.0, 0.9)
    physics.box_collider(ground, core.vec3(30.0, 0.5, 30.0), physics.material(0.8, 0.0))
    // The source of every retarget: the Rigify mannequin's file, out of sight.
    source_o = figure.figure(e, "Source", RIGIFY)
    behaviour.object_set_position(source_o, core.vec3(0.0, 0.0 - 50.0, 0.0))
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    scene = figure.scene(source_f)
    // The runner.
    ro = figure.figure(e, "Runner", RIGIFY)
    ra = animator.attach(e, ro)
    s.runner.move = add_gaits(ra, null, null)
    s.runner.idle = animator.add_state(ra, "idle", animator.take(ra, "Idle_Loop", false), true)
    make_mover(e, &s.runner, ro, ra, core.vec3(0.0 - 3.5, 0.0, 0.0), 0.0)
    // The female, a quarter of a cycle behind, aiming over her walk.
    fo = figure.figure(e, "Female", FEMALE)
    fa = animator.attach(e, fo)
    s.female.move = add_gaits(fa, source, scene)
    idle_made = clips.from_scene(source, scene, "Idle_Loop", 0.0)
    s.female.idle = animator.add_state(fa, "idle", animator.add_take(fa, retarget.retarget(source, idle_made, animator.rig(fa)), false), true)
    clips.take_free(idle_made)
    aim_made = clips.from_scene(source, scene, "Pistol_Aim_Neutral", 0.0)
    aim = animator.add_take(fa, retarget.retarget(source, aim_made, animator.rig(fa)), false)
    clips.take_free(aim_made)
    s.female.aim = animator.add_layer(fa, aim, pose.human(animator.rig(fa), pose.SPINE_01), false, true)
    make_mover(e, &s.female, fo, fa, core.vec3(3.5, 0.0, 0.0), CYCLE * 0.25)
    // The UE5 mannequin on a block, hit now and then.
    block = engine.object(e, "Block", loader.cube(1.0))
    behaviour.object_set_position(block, core.vec3(0.12, 0.06, 7.0))
    behaviour.object_set_scale(block, core.vec3(0.3, 0.12, 0.5))
    physics.box_collider(block, core.vec3(0.15, 0.06, 0.25), physics.material(0.8, 0.0))
    mo = figure.figure(e, "Standing", MALE)
    behaviour.object_set_position(mo, core.vec3(0.0, 0.0, 7.0))
    behaviour.object_set_rotation(mo, core.quat_rotate(3.1415926, core.vec3(0.0, 1.0, 0.0)))
    ma = animator.attach(e, mo)
    idle = animator.add_state(ma, "idle", animator.take(ma, "Idle_No_Loop", false), true)
    animator.play(ma, idle, 0.0)
    hits = calloc(2, 4) as int[]
    names = ["Hit_Chest", "Hit_Head"]
    k = 0
    while k < 2 {
        made = clips.from_scene(source, scene, names[k], 0.0)
        hits[k] = animator.add_layer(ma, animator.add_take(ma, retarget.retarget(source, made, animator.rig(ma)), false), 0 - 1, true, false)
        clips.take_free(made)
        k = k + 1
    }
    feet = ikrig.feet_new(animator.rig(ma), mo)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(ma, feet)
    s.hit_o = mo as ptr
    s.hit_a = ma as ptr
    s.hits = hits as ptr
    s.hit_next = 2.0
    pose.rig_free(source)
    make_walker(s, e)
    make_stick(s, e)
    make_climber(s, e)
    make_rifleman(s, e)
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Show
    s.clock = s.clock + step
    cam = engine.engine_camera(e).position
    step_mover(s, &s.runner, step, cam)
    step_mover(s, &s.female, step, cam)
    // The standing figure: hit every few seconds, watching the runner.
    ma = s.hit_a as *Animator
    if s.clock >= s.hit_next {
        hits = s.hits as int[]
        layer = hits[s.hit_which]
        animator.layer_restart(ma, layer)
        animator.layer_weight(ma, layer, 1.0, 0.0)
        animator.layer_weight(ma, hits[1 - s.hit_which], 0.0, 0.2)
        s.hit_which = 1 - s.hit_which
        s.hit_next = s.clock + 2.5
    }
    runner = s.runner.o as *GameObject
    step_walker(s)
    step_stick(s, step)
    step_climber(s, step)
    step_rifleman(s)
    animator.look_at(ma, core.v3_add(behaviour.object_position(runner), core.vec3(0.0, 1.6, 0.0)), 0.8)
}

// After the frame is drawn (the pose phase has run): the toes measured on the
// pose the frame shows, with the figures where the frame shows them.
// Measured in the fixed step, the last frame's pose was read through this
// step's place, a frame's travel off.
late_update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    measure(&s.runner)
    measure(&s.female)
    draw_rifle(s)
    metrics(s)
    cycle = (s.clock / CYCLE) as int
    if cycle > s.cycle {
        wat = core.v3_sub(behaviour.object_position(s.walker_o as *GameObject), s.home)
        println("anim_showcase: cycle ${cycle}: the runner's planted toes slid ${s.runner.worst * 1000.0} mm at worst, the female's ${s.female.worst * 1000.0} mm; the captured walker ${core.v3_dot(wat, s.line)} m along its line, ${core.v3_len(core.v3_sub(wat, core.v3_mul(s.line, core.v3_dot(wat, s.line))))} m off it")
        s.runner.worst = 0.0
        s.female.worst = 0.0
        s.cycle = cycle
    }
}

update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0)
    if watch >= 1 && watch <= 7 {
        o = s.runner.o as *GameObject
        if watch == 2 { o = s.female.o as *GameObject }
        if watch == 3 { o = s.hit_o as *GameObject }
        if watch == 4 { o = s.walker_o as *GameObject }
        if watch == 5 { o = s.stick_o as *GameObject }
        if watch == 6 { o = s.climb_o as *GameObject }
        if watch == 7 { o = s.rifle_o as *GameObject }
        at = behaviour.object_position(o)
        side = core.quat_apply(behaviour.object_rotation(o), core.vec3(1.0, 0.0, 0.0))
        // AE3D_WATCH_FRONT=1 looks at it from in front instead of beside it.
        if core.env_int("AE3D_WATCH_FRONT", 0) == 1 { side = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0)) }
        core.camera_set_position(cam, core.vec3(at.x + side.x * 3.0, at.y + 1.4, at.z + side.z * 3.0))
        core.camera_look_at(cam, core.vec3(at.x, at.y + 0.9, at.z))
        return
    }
    s.camera_angle = s.camera_angle + delta * 0.08
    core.camera_set_position(cam, core.vec3(15.0 * sin(s.camera_angle), 5.0, 2.0 + 15.0 * cos(s.camera_angle)))
    core.camera_look_at(cam, core.vec3(0.0, 0.8, 2.0))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - animation pipeline showcase (automated)")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    // Late afternoon: a low sun and its long shadows, the procedural sky.
    engine.engine_set_time_of_day(e, 16.8)
    s = heap_show()
    b = engine.behaviour_new("anim_showcase", s as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    b.late_update = late_update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    if s.walker_o != null { physics.character_free(physics.character_of(s.walker_o as *GameObject)) }
    if s.stick_m != null { mover.mover_free(s.stick_m as *Mover) }
    if s.climb_o != null { physics.character_free(physics.character_of(s.climb_o as *GameObject)) }
    if s.rifle_work != null { pose.release(s.rifle_work) }
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
}

heap_show() -> *Show {
    s = calloc(1, sizeof(Show)) as *Show
    s.hit_which = 0
    return s
}

// The captured walker: the UE5 mannequin on a character controller, walking
// 100STYLE's forward and backward walks (motion capture, retargeted onto it
// with its feet kept and a root made under its hips, straightened), carried by their root
// motion out along a line and back.
make_walker(s: *Show, e: *Engine) {
    wo = figure.figure(e, "Captured", MALE)
    s.home = core.vec3(0.0 - LINE * 0.5, 0.0, 0.0 - 9.0)
    behaviour.object_set_position(wo, s.home)
    behaviour.object_set_rotation(wo, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    _capsule = physics.character_controller(wo, 0.3, 1.7)
    wa = animator.attach(e, wo)
    names = ["neutral_fw.bvh", "neutral_bw.bvh"]
    states = [0, 0]
    k = 0
    while k < 2 {
        c = bvh.load("${STYLE}${names[k]}", 0.0)
        made = bvh.take(c, names[k], 0, 0 - 1)
        t = animator.add_take(wa, retarget.retarget(bvh.rig(c), made, animator.rig(wa)), true)
        clips.straighten(t, animator.rig(wa), true)
        states[k] = animator.add_state(wa, names[k], t, false)
        clips.take_free(made)
        bvh.capture_free(c)
        k = k + 1
    }
    s.forward = states[0]
    s.back = states[1]
    animator.set_root_motion(wa, true)
    feet = ikrig.feet_new(animator.rig(wa), wo)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(wa, feet)
    animator.play(wa, s.forward, 0.0)
    s.line = retarget.facing(animator.rig(wa))
    s.walker_o = wo as ptr
    s.walker_a = wa as ptr
}

// Out along the line, then back: the walk turned to the backward walk when
// it is LINE out, and to the forward walk when it is home, each from its
// start, inertialized over 0.4 s; or when the take playing is about to
// end, since a capture's takes do not loop and a figure holding its last
// frame stands still.
step_walker(s: *Show) {
    wo = s.walker_o as *GameObject
    wa = s.walker_a as *Animator
    at = behaviour.object_position(wo)
    out = core.v3_dot(core.v3_sub(at, s.home), s.line)
    ending = animator.state_time(wa) >= clips.duration(animator.current_take(wa)) - 0.4
    if core.env_int("TRACE", 0) == 2 && (s.clock * 4.0) as int != ((s.clock - 0.0166) * 4.0) as int {
        ahead = core.quat_apply(behaviour.object_rotation(wo), core.vec3(0.0, 0.0, 1.0))
        moved = animator.root_moved(wa)
        println("    WALKER t ${s.clock} back ${s.going_back} out ${out} heading ${atan2(ahead.x, ahead.z) * 57.29578} state ${animator.state_name(wa, animator.current(wa))} at ${animator.state_time(wa)} of ${clips.duration(animator.current_take(wa))} moved ${moved.x} ${moved.y} ${moved.z}")
    }
    if !s.going_back && (out >= LINE || ending) {
        animator.play(wa, s.back, 0.4)
        s.going_back = true
    } else if s.going_back && (out <= 0.0 || ending) {
        animator.play(wa, s.forward, 0.4)
        s.going_back = false
    }
}

// --- the figure on a stick (#856) -------------------------------------------------------------

// A capture's take on `a`'s rig: retargeted with its feet kept, its root
// motion taken out. Owned by the animator.
captured_take(a: *Animator, file: string) -> *Take {
    r = animator.rig(a)
    c = bvh.load("${STYLE}${file}", 0.0)
    made = bvh.take(c, file, 0, 0 - 1)
    t = animator.add_take(a, retarget.retarget(bvh.rig(c), made, r), true)
    clips.take_free(made)
    bvh.capture_free(c)
    return t
}

// Take `t` cut from `from` to `to` seconds about its root's first move (or,
// not `around_move`, its first stand after its fastest).
cut_about(a: *Animator, t: *Take, from: float, to: float, around_move: bool) -> *Take {
    r = animator.rig(a)
    mark = clips.moving_at(t, 0.1)
    if !around_move { mark = clips.still_at(t, 0.1) }
    a0 = ((mark + from) * clips.rate(t)) as int
    b0 = ((mark + to) * clips.rate(t)) as int
    if a0 < 0 { a0 = 0 }
    if b0 > clips.frames(t) - 1 { b0 = clips.frames(t) - 1 }
    return animator.add_take(a, clips.crop(t, r, a0, b0, false), false)
}

// The UE5 mannequin on a mover (ae3d.mover) and a graph of a stand, a start,
// a 2D blend of 100STYLE's walks, runs and side steps, and a stop (and its
// mirror), its feet stepping as it turns on the spot and an aim offset
// (the runner's pistol aims retargeted) over its spine.
make_stick(s: *Show, e: *Engine) {
    so = figure.figure(e, "Stick", MALE)
    s.stick_home = core.vec3(0.0 - 4.0, 0.0, 11.0)
    behaviour.object_set_position(so, s.stick_home)
    behaviour.object_set_rotation(so, core.quat_rotate(1.5707963, core.vec3(0.0, 1.0, 0.0)))
    sa = animator.attach(e, so)
    r = animator.rig(sa)
    // The stand: the stop take's standing, looped.
    stood = captured_take(sa, "neutral_stop.bvh")
    at = (clips.still_at(stood, 0.1) + 1.0) * clips.rate(stood)
    standing = clips.crop(stood, r, at as int, clips.frames(stood) - 1, false)
    idle = animator.add_state(sa, "idle", animator.add_take(sa, clips.loop_cut(standing, r), false), true)
    clips.take_free(standing)
    // The gaits, each a loop on its axis, set in the space at its velocity.
    move = animator.add_blend2(sa, "move")
    names = ["neutral_fw.bvh", "neutral_bw.bvh", "neutral_sw.bvh", "neutral_fr.bvh", "neutral_br.bvh", "neutral_sr.bvh"]
    sides = [false, false, true, false, false, true]
    k = 0
    while k < 6 {
        t = captured_take(sa, names[k])
        clips.straighten(t, r, true)
        t = animator.add_take(sa, clips.loop_cut(t, r), false)
        clips.straighten(t, r, true)
        went = clips.travel(t, clips.duration(t))
        animator.blend_add2(sa, move, t, went.x / clips.duration(t), went.y / clips.duration(t))
        if sides[k] {
            other = animator.add_take(sa, clips.mirror(t, r), false)
            far = clips.travel(other, clips.duration(other))
            animator.blend_add2(sa, move, other, far.x / clips.duration(other), far.y / clips.duration(other))
        }
        k = k + 1
    }
    animator.bind2(sa, move, "vx", "vz")
    // The start by the way come, the stop (either foot's) by the way left.
    starting = captured_take(sa, "neutral_start.bvh")
    clips.straighten(starting, r, true)
    start = animator.add_state(sa, "start", cut_about(sa, starting, 0.0 - 0.3, 1.6, true), false)
    animator.clock_by(sa, start, "travelled", false)
    stopping = captured_take(sa, "lookup_stop.bvh")
    clips.straighten(stopping, r, true)
    stop_t = cut_about(sa, stopping, 0.0 - 1.6, 0.3, false)
    stop = animator.add_state(sa, "stop", stop_t, false)
    animator.clock_by(sa, stop, "rest", true)
    stop_m = animator.add_state(sa, "stop", animator.add_take(sa, clips.mirror(stop_t, r), false), false)
    animator.clock_by(sa, stop_m, "rest", true)
    go = animator.add_transition(sa, idle, start, 0.2)
    animator.transition_when(sa, go, "go", animator.IS, 0.0)
    on = animator.add_transition(sa, start, move, 0.3)
    animator.transition_when(sa, on, "", animator.ENDED, 0.0)
    animator.transition_synced(sa, on, true)
    halt = animator.add_transition(sa, move, stop, 0.25)
    animator.transition_when(sa, halt, "go", animator.IS_NOT, 0.0)
    animator.transition_when(sa, halt, "rest", animator.BELOW, clips.travel_length(stop_t))
    animator.transition_or(sa, halt, stop_m)
    k = 0
    while k < 2 {
        from_stop = stop
        if k == 1 { from_stop = stop_m }
        rested = animator.add_transition(sa, from_stop, idle, 0.3)
        animator.transition_when(sa, rested, "", animator.ENDED, 0.0)
        k = k + 1
    }
    // A stop asked for while it starts, and a start while it stops.
    early = animator.add_transition(sa, start, idle, 0.3)
    animator.transition_when(sa, early, "go", animator.IS_NOT, 0.0)
    animator.transition_when(sa, early, "speed", animator.BELOW, 0.1)
    // The pistol's aims, retargeted from the runner's file, over its spine.
    source_o = figure.figure(e, "Aims", RIGIFY)
    behaviour.object_set_position(source_o, core.vec3(0.0, 0.0 - 60.0, 0.0))
    source_f = figure.figure_of(source_o)
    source = pose.of_skeleton(figure.skeleton(source_f))
    s.stick_aim = animator.add_aim(sa, pose.human(r, pose.SPINE_01))
    aims = ["Pistol_Aim_Neutral", "Pistol_Aim_Up", "Pistol_Aim_Down"]
    pitches = [0.0, 0.7, 0.0 - 0.7]
    k = 0
    while k < 3 {
        made = clips.from_scene(source, figure.scene(source_f), aims[k], 0.0)
        animator.aim_add(sa, s.stick_aim, animator.add_take(sa, retarget.retarget(source, made, r), false), 0.0, pitches[k])
        clips.take_free(made)
        k = k + 1
    }
    pose.rig_free(source)
    animator.set_aim(sa, s.stick_aim, 0.0, 0.0, 0.0)
    feet = ikrig.feet_new(r, so)
    ikrig.feet_ground_physics(feet, physics.of(e))
    ikrig.feet_set_steps(feet, true)
    animator.set_feet(sa, feet)
    m = mover.mover_new(sa, so)
    mover.set_braking(m, clips.braking(stop_t))
    mover.set_half_lives(m, mover.HALF_LIFE, 0.6)
    animator.play(sa, idle, 0.0)
    s.stick_o = so as ptr
    s.stick_a = sa as ptr
    s.stick_m = m as ptr
    s.stick_yaw = 1.5707963
}

// The stick's 24 s cycle: stand, walk ahead, step left and right facing
// ahead, run, stop, turn round on the spot, walk back aiming, stop, turn
// round again.
step_stick(s: *Show, dt: float) {
    m = s.stick_m as *Mover
    sa = s.stick_a as *Animator
    t = s.clock - 24.0 * floor_of(s.clock / 24.0)
    yaw = s.stick_yaw
    ahead = core.vec3(core.sin_of(yaw), 0.0, core.cos_of(yaw))
    left = core.vec3(core.cos_of(yaw), 0.0, 0.0 - core.sin_of(yaw))
    asked = core.vec3(0.0, 0.0, 0.0)
    aim = 0.0
    if t >= 2.0 && t < 6.0 { asked = core.v3_mul(ahead, 0.8) }
    if t >= 6.0 && t < 8.0 { asked = core.v3_mul(left, 0.5) }
    if t >= 8.0 && t < 10.0 { asked = core.v3_mul(left, 0.0 - 0.5) }
    if t >= 10.0 && t < 12.0 { asked = core.v3_mul(ahead, 1.6) }
    if t >= 14.0 && t < 14.0 + dt { s.stick_yaw = s.stick_yaw + 3.1415926 }
    if t >= 17.0 && t < 20.0 {
        asked = core.v3_mul(ahead, 0.8)
        aim = 1.0
    }
    if t >= 21.0 && t < 21.0 + dt { s.stick_yaw = s.stick_yaw + 3.1415926 }
    // Strafing faces ahead; walking, the way it goes.
    mover.face(m, s.stick_yaw, t >= 6.0 && t < 10.0 || t >= 14.0 && t < 17.0 || t >= 21.0)
    mover.ask(m, asked)
    mover.step(m, dt)
    animator.set_aim(sa, s.stick_aim, 0.0, 0.4 * core.sin_of(s.clock * 1.3), aim)
    // Eyes ahead: the capture's actor walks looking at the floor 22 degrees down.
    so = s.stick_o as *GameObject
    at = behaviour.object_position(so)
    face_dir = core.quat_apply(behaviour.object_rotation(so), core.vec3(0.0, 0.0, 1.0))
    animator.look_at(sa, core.vec3(at.x + face_dir.x * 6.0, 1.6, at.z + face_dir.z * 6.0), 0.8)
}

// --- stairs, a ramp, a bowl and a rifle (#857) ------------------------------------------------

const TREAD = 0.3
const RISE = 0.2
const STEPS = 5
const SLOPE = 0.349066
const COURSE_X = 12.0
const COURSE_Z = 0.0 - 8.0
// Radians the rifleman's rifle lies across his chest, left of its forward.
const BLADE = 0.611
// Of the walk's stride, the steps up and down the 20 degree ramp: a steep
// trail's, where people step short (tests/test_ik_constraints.ae's too).
const SLOPE_STRIDE = 0.7

// A static box `half` big, its middle `along` the course and `high` up,
// pitched `pitch` (its top rising along the course's way, +z).
course_box(e: *Engine, along: float, high: float, half: Vec3, pitch: float) {
    b = engine.object(e, "Course", loader.cube(1.0))
    behaviour.object_set_position(b, core.vec3(COURSE_X, high, COURSE_Z + along))
    behaviour.object_set_rotation(b, core.quat_rotate(0.0 - pitch, core.vec3(1.0, 0.0, 0.0)))
    behaviour.object_set_scale(b, core.v3_mul(half, 2.0))
    bm = behaviour.object_model(b)
    core.model_set_diffuse(bm, 0.42, 0.40, 0.37)
    core.model_set_pbr(bm, 0.0, 0.85)
    physics.box_collider(b, half, physics.material(0.8, 0.0))
}

// The climber: the Rigify mannequin on a character controller walking a
// course of five 0.2 m stairs 0.3 m deep up, a landing and five down, then a
// 20 degree ramp up, a top and one down, a bowl held in both hands; on the
// stairs its stride cut to a tread a step, on the ramp to SLOPE_STRIDE
// (ikrig.feet_set_stride), at as much of its speed. Its feet on the ground
// by ikrig: soles traced heel to toe, laid on the ramp, toes bent at the
// ball as the heel rises, the pelvis down by what the lower leg needs. From
// the course's end it starts again.
make_climber(s: *Show, e: *Engine) {
    up_end = 1.5 + TREAD * (STEPS as float)
    down_end = up_end + 2.0 + TREAD * (STEPS as float)
    k = 1
    while k <= STEPS {
        from = 1.5 + TREAD * ((k - 1) as float)
        to = down_end - TREAD * ((k - 1) as float)
        course_box(e, (from + to) * 0.5, RISE * (k as float) * 0.5, core.vec3(1.0, RISE * (k as float) * 0.5, (to - from) * 0.5), 0.0)
        k = k + 1
    }
    run = 3.0
    high = run * sin(SLOPE)
    flat = run * cos(SLOPE)
    thick = 0.25
    first = down_end + 2.0
    course_box(e, first + flat * 0.5 + thick * sin(SLOPE), high * 0.5 - thick * cos(SLOPE), core.vec3(1.0, thick, run * 0.5), SLOPE)
    course_box(e, first + flat + 1.0, high * 0.5, core.vec3(1.0, high * 0.5, 1.0), 0.0)
    course_box(e, first + flat + 2.0 + flat * 0.5 - thick * sin(SLOPE), high * 0.5 - thick * cos(SLOPE), core.vec3(1.0, thick, run * 0.5), 0.0 - SLOPE)
    s.climb_stairs = down_end
    s.climb_end = first + flat * 2.0 + 2.0 + 1.5
    s.climb_ramp = first
    co = figure.figure(e, "Climber", RIGIFY)
    s.climb_start = core.vec3(COURSE_X, 0.0, COURSE_Z)
    behaviour.object_set_position(co, s.climb_start)
    _capsule = physics.character_controller(co, 0.3, 1.7)
    ca = animator.attach(e, co)
    walk = animator.take(ca, "Walk_Loop", false)
    animator.play(ca, animator.add_state(ca, "walk", walk, true), 0.0)
    feet = ikrig.feet_new(animator.rig(ca), co)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(ca, feet)
    hands = ikrig.hands_new(animator.rig(ca))
    animator.set_hands(ca, hands)
    s.climb_walk_speed = clips.speed(walk)
    s.climb_full_stride = clips.speed(walk) * clips.duration(walk) * 0.5
    s.climb_stride = 1.0
    bowl = engine.object(e, "Bowl", loader.cube(1.0))
    behaviour.object_set_scale(bowl, core.vec3(0.2, 0.06, 0.2))
    core.model_set_diffuse(behaviour.object_model(bowl), 0.75, 0.55, 0.30)
    s.climb_o = co as ptr
    s.climb_a = ca as ptr
    s.climb_feet = feet as ptr
    s.climb_hands = hands as ptr
    s.climb_bowl = bowl as ptr
    w = pose.new(animator.rig(ca))
    pose.rest_world(animator.rig(ca), w)
    s.climb_belly = ikrig.to_ground(animator.rig(ca), pose.translation(w, pose.human(animator.rig(ca), pose.SPINE_01))).y - s.climb_start.y
    pose.release(w)
}

step_climber(s: *Show, dt: float) {
    co = s.climb_o as *GameObject
    at = behaviour.object_position(co)
    along = at.z - COURSE_Z
    if along >= s.climb_end {
        behaviour.object_set_position(co, s.climb_start)
        at = s.climb_start
        along = 0.0
    }
    // A tread a step on the stairs and short steps on the ramp, eased in and
    // out over half a second.
    wanted = 1.0
    if along > 1.2 && along < s.climb_stairs + 0.3 { wanted = TREAD / s.climb_full_stride }
    if along > s.climb_ramp - 0.3 && along < s.climb_end - 1.2 { wanted = SLOPE_STRIDE }
    s.climb_stride = s.climb_stride + (wanted - s.climb_stride) * core.clampf(dt * 2.0, 0.0, 1.0)
    ikrig.feet_set_stride(s.climb_feet as *Feet, s.climb_stride)
    physics.character_move(physics.character_of(co), core.vec3(0.0, 0.0, s.climb_walk_speed * s.climb_stride), 0.0, dt)
    // The bowl 32 cm ahead at the belly, a hand on each side of its rim.
    middle = core.v3_add(at, core.vec3(0.0, s.climb_belly, 0.32))
    behaviour.object_set_position(s.climb_bowl as *GameObject, middle)
    h = s.climb_hands as *Hands
    ikrig.hands_set(h, 0, core.v3_add(middle, core.vec3(0.13, 0.0, 0.0)), 1.0)
    ikrig.hands_set(h, 1, core.v3_add(middle, core.vec3(0.0 - 0.13, 0.0, 0.0)), 1.0)
}

// The rifleman: the UE5 mannequin standing on its idle, a rifle held bladed
// (its barrel across the chest, 35 degrees off its forward) on the chest,
// the trunk aimed at a point that sweeps 35 degrees either way at 10 m and
// rises and falls, both hands on the rifle's grip and fore-end (ikrig: the
// aim spread up the spine, then the hands solved onto the rifle where the
// aim put it).
make_rifleman(s: *Show, e: *Engine) {
    ro = figure.figure(e, "Rifleman", MALE)
    behaviour.object_set_position(ro, core.vec3(0.0 - 12.0, 0.0, 4.0))
    ra = animator.attach(e, ro)
    animator.play(ra, animator.add_state(ra, "idle", animator.take(ra, "Idle_No_Loop", false), true), 0.0)
    r = animator.rig(ra)
    feet = ikrig.feet_new(r, ro)
    ikrig.feet_ground_physics(feet, physics.of(e))
    animator.set_feet(ra, feet)
    hands = ikrig.hands_new(r)
    animator.set_hands(ra, hands)
    chest = pose.human(r, pose.SPINE_03)
    rest = pose.new(r)
    pose.rest_world(r, rest)
    into = core.quat_conjugate(pose.rotation(rest, chest))
    ahead = core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0, 1.0)))
    down = core.v3_normalize(core.quat_apply(into, ikrig.dir_to_rig(r, core.vec3(0.0, 0.0 - 1.0, 0.0))))
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    up = core.v3_mul(down, 0.0 - 1.0)
    across = core.v3_normalize(core.v3_add(core.v3_mul(ahead, cos(BLADE)), core.v3_mul(core.v3_normalize(core.v3_cross(up, ahead)), sin(BLADE))))
    butt = core.v3_add(core.quat_apply(into, core.v3_sub(pose.translation(rest, pose.human(r, pose.UPPERARM_R)), pose.translation(rest, chest))), core.v3_mul(ahead, 0.08 * unit))
    pose.release(rest)
    ikrig.aim_set_line(animator.trunk_aim(ra), butt, across)
    ikrig.feet_set_steps(feet, true)
    ikrig.hands_set_on(hands, 1, chest, core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.18 * unit), core.v3_mul(down, 0.07 * unit))), 1.0)
    ikrig.hands_set_on(hands, 0, chest, core.v3_add(butt, core.v3_add(core.v3_mul(across, 0.40 * unit), core.v3_mul(down, 0.04 * unit))), 1.0)
    gun = engine.object(e, "Rifle", loader.cube(1.0))
    behaviour.object_set_scale(gun, core.vec3(0.04, 0.07, 0.78))
    core.model_set_diffuse(behaviour.object_model(gun), 0.12, 0.12, 0.13)
    s.rifle_o = ro as ptr
    s.rifle_a = ra as ptr
    s.rifle_gun = gun as ptr
    s.rifle_butt = butt
    s.rifle_axis = across
    s.rifle_work = pose.new(r)
}

step_rifleman(s: *Show) {
    ra = s.rifle_a as *Animator
    sweep = 0.611 * sin(s.clock * 0.5)
    rise = 0.15 + 0.12 * sin(s.clock * 0.37)
    way = core.vec3(sin(sweep) * cos(rise), sin(rise), cos(sweep) * cos(rise))
    target = core.v3_add(core.vec3(0.0 - 12.0, 1.45, 4.0), core.v3_mul(way, 10.0))
    // The whole body turns to the target, as someone aiming does: the hips
    // and feet (stepping as they turn, ikrig.feet_set_steps) face the way
    // the chest does with the rifle held bladed across it, so the spine
    // carries only what is left. Turned by the spine alone, the chest stood
    // 55 degrees off the hips.
    yaw = sweep - BLADE
    behaviour.object_set_rotation(s.rifle_o as *GameObject, core.quat_rotate(yaw, core.vec3(0.0, 1.0, 0.0)))
    animator.aim_at(ra, target, 1.0)
    // Its eyes on the target, along the barrel.
    animator.look_at(ra, target, 1.0)
}

// The rifle drawn where the aimed chest holds it, after the pose phase.
draw_rifle(s: *Show) {
    ra = s.rifle_a as *Animator
    r = animator.rig(ra)
    w = s.rifle_work
    pose.world(r, animator.pose_now(ra), w)
    chest = pose.human(r, pose.SPINE_03)
    turn = pose.rotation(w, chest)
    butt = core.v3_add(pose.translation(w, chest), core.quat_apply(turn, s.rifle_butt))
    unit = core.v3_len(ikrig.dir_to_rig(r, core.vec3(1.0, 0.0, 0.0)))
    middle = core.v3_add(butt, core.v3_mul(core.quat_apply(turn, s.rifle_axis), 0.39 * unit))
    barrel = core.v3_normalize(ikrig.dir_to_ground(r, core.quat_apply(turn, s.rifle_axis)))
    gun = s.rifle_gun as *GameObject
    behaviour.object_set_position(gun, ikrig.to_ground(r, middle))
    behaviour.object_set_rotation(gun, core.quat_from_to(core.vec3(0.0, 0.0, 1.0), barrel))
}

// --- what a player would see wrong (AE3D_METRICS=1) -------------------------------------------

// Per figure, on the pose drawn, the worst through the run of what reads as
// wrong at a glance, printed every METRIC_EVERY seconds: the legs' segments
// closer than LEGS_TOUCH (one leg through the other), a knee bent out past
// KNEE_OUT off the way the hips face (a knee bent 6 cm off its leg's line or
// more: a straight leg's has no way), the chest turned past TWIST_MOST off
// the hips, a forearm rolled past ROLL_MOST off its upper arm. Not a test:
// a way to find the moment a defect shows, by its clock.
const LEGS_TOUCH = 0.08
const KNEE_OUT = 0.7854
const TWIST_MOST = 0.8727
const ROLL_MOST = 2.0944
const METRIC_EVERY = 10.0

struct Seen {
    gap: float                     // the closest the legs came, metres
    gap_at: float                  // and when
    knee: float                    // the most a knee bent out, radians
    knee_at: float
    twist: float                   // the most the chest turned off the hips
    twist_at: float
    roll: float                    // the most a forearm rolled off its upper arm
    roll_at: float
    knee_in: float                 // the most a knee bent in, toward the other leg
    knee_in_at: float
    cross: float                   // the most a foot crossed the hips' middle, metres
    cross_at: float
}

seen_new() -> *Seen {
    m = calloc(1, sizeof(Seen)) as *Seen
    m.gap = 1000.0
    m.knee_in = 0.0
    m.cross = 0.0 - 1000.0
    return m
}

seen_take(m: *Seen, a: *Animator, clock: float) {
    r = animator.rig(a)
    w = pose.new(r)
    pose.world(r, animator.pose_now(a), w)
    hip_l = joint_g(r, w, pose.THIGH_L)
    knee_l = joint_g(r, w, pose.CALF_L)
    ankle_l = joint_g(r, w, pose.FOOT_L)
    hip_r = joint_g(r, w, pose.THIGH_R)
    knee_r = joint_g(r, w, pose.CALF_R)
    ankle_r = joint_g(r, w, pose.FOOT_R)
    // The legs: shin against shin, thigh against thigh, and across.
    gap = segment_gap(knee_l, ankle_l, knee_r, ankle_r)
    g2 = segment_gap(core.v3_lerp(hip_l, knee_l, 0.4), knee_l, core.v3_lerp(hip_r, knee_r, 0.4), knee_r)
    if g2 < gap { gap = g2 }
    g3 = segment_gap(knee_l, ankle_l, core.v3_lerp(hip_r, knee_r, 0.4), knee_r)
    if g3 < gap { gap = g3 }
    g4 = segment_gap(knee_r, ankle_r, core.v3_lerp(hip_l, knee_l, 0.4), knee_l)
    if g4 < gap { gap = g4 }
    if gap < m.gap {
        m.gap = gap
        m.gap_at = clock
    }
    // The way the hips face, level: square to the line from right hip to left.
    across = core.v3_sub(hip_l, hip_r)
    across = core.v3_normalize(core.vec3(across.x, 0.0, across.z))
    facing = core.v3_cross(across, core.vec3(0.0, 1.0, 0.0))
    // A knee bent out: its offset off the hip-to-ankle line, level, turned
    // away from the way the hips face toward its own side.
    sides = [1.0, 0.0 - 1.0]
    k = 0
    while k < 2 {
        hip = hip_l
        knee = knee_l
        ankle = ankle_l
        if k == 1 {
            hip = hip_r
            knee = knee_r
            ankle = ankle_r
        }
        line = core.v3_normalize(core.v3_sub(ankle, hip))
        off = core.v3_sub(core.v3_sub(knee, hip), core.v3_mul(line, core.v3_dot(core.v3_sub(knee, hip), line)))
        flat = core.vec3(off.x, 0.0, off.z)
        if core.v3_len(flat) > 0.06 {
            flat = core.v3_normalize(flat)
            out = core.atan2_of(core.v3_dot(flat, core.v3_mul(across, sides[k])), core.v3_dot(flat, facing))
            if out > m.knee {
                m.knee = out
                m.knee_at = clock
            }
            if 0.0 - out > m.knee_in {
                m.knee_in = 0.0 - out
                m.knee_in_at = clock
            }
        }
        k = k + 1
    }
    // A foot past the hips' middle toward the other side (a crossover).
    middle = core.v3_lerp(hip_l, hip_r, 0.5)
    crossed = core.v3_dot(core.v3_sub(ankle_r, middle), across)
    crossed_l = 0.0 - core.v3_dot(core.v3_sub(ankle_l, middle), across)
    if crossed_l > crossed { crossed = crossed_l }
    if crossed > m.cross {
        m.cross = crossed
        m.cross_at = clock
    }
    // The chest against the hips: the line across the shoulders, level,
    // against the line across the hips.
    shoulders = core.v3_sub(joint_g(r, w, pose.UPPERARM_L), joint_g(r, w, pose.UPPERARM_R))
    shoulders = core.vec3(shoulders.x, 0.0, shoulders.z)
    if core.v3_len(shoulders) > 0.000001 {
        twist = core.acos_of(core.clampf(core.v3_dot(core.v3_normalize(shoulders), across), 0.0 - 1.0, 1.0))
        if twist > m.twist {
            m.twist = twist
            m.twist_at = clock
        }
    }
    // A forearm's roll off its upper arm, about the forearm.
    limbs = [ikrig.arm_limb(r, 0), ikrig.arm_limb(r, 1)]
    k = 0
    while k < 2 {
        l = limbs[k]
        if l != null {
            local = core.quat_mul(core.quat_conjugate(pose.rotation(w, l.upper)), pose.rotation(w, l.middle))
            roll = core.abs_of(2.0 * core.atan2_of(local.x * l.lower.x + local.y * l.lower.y + local.z * l.lower.z, local.w))
            if roll > 3.141592653589793 { roll = 6.283185307179586 - roll }
            if roll > m.roll {
                m.roll = roll
                m.roll_at = clock
            }
            ikrig.limb_free(l)
        }
        k = k + 1
    }
    pose.release(w)
}

seen_print(m: *Seen, name: string) {
    flag = ""
    if m.gap < LEGS_TOUCH { flag = "${flag} LEGS-TOUCH" }
    if m.knee > KNEE_OUT { flag = "${flag} KNEE-OUT" }
    if m.twist > TWIST_MOST { flag = "${flag} TWISTED" }
    if m.roll > ROLL_MOST { flag = "${flag} FOREARM-ROLL" }
    if m.knee_in > KNEE_OUT { flag = "${flag} KNEE-IN" }
    if m.cross > 0.0 { flag = "${flag} FEET-CROSS" }
    println("  ${name}: legs ${m.gap * 100.0} cm apart at the closest (${m.gap_at} s); a knee ${m.knee * 57.29578} degrees out (${m.knee_at} s); chest ${m.twist * 57.29578} degrees off the hips (${m.twist_at} s); a forearm rolled ${m.roll * 57.29578} degrees (${m.roll_at} s); a knee ${m.knee_in * 57.29578} degrees in (${m.knee_in_at} s); a foot ${m.cross * 100.0} cm over the middle (${m.cross_at} s)${flag}")
    m.gap = 1000.0
    m.knee = 0.0
    m.twist = 0.0
    m.roll = 0.0
    m.knee_in = 0.0
    m.cross = 0.0 - 1000.0
}

joint_g(r: *pose.Rig, w: ptr, slot: int) -> Vec3 {
    return ikrig.to_ground(r, pose.translation(w, pose.human(r, slot)))
}

segment_gap(a0: Vec3, a1: Vec3, b0: Vec3, b1: Vec3) -> float {
    best = 1000000.0
    k = 0
    while k <= 12 {
        u = (k as float) / 12.0
        d = to_segment(core.v3_lerp(a0, a1, u), b0, b1)
        if d < best { best = d }
        e2 = to_segment(core.v3_lerp(b0, b1, u), a0, a1)
        if e2 < best { best = e2 }
        k = k + 1
    }
    return best
}

to_segment(p: Vec3, a: Vec3, b: Vec3) -> float {
    ab = core.v3_sub(b, a)
    t = 0.0
    if core.v3_dot(ab, ab) > 0.0 { t = core.clampf(core.v3_dot(core.v3_sub(p, a), ab) / core.v3_dot(ab, ab), 0.0, 1.0) }
    return core.v3_len(core.v3_sub(p, core.v3_add(a, core.v3_mul(ab, t))))
}

metrics(s: *Show) {
    if core.env_int("AE3D_METRICS", 0) == 0 { return }
    if s.seen == null {
        seen = calloc(7, 8) as ptr[]
        k = 0
        while k < 7 {
            seen[k] = seen_new() as ptr
            k = k + 1
        }
        s.seen = seen as ptr
        s.seen_next = METRIC_EVERY
    }
    seen = s.seen as ptr[]
    animators = [s.runner.a, s.female.a, s.hit_a, s.walker_a, s.stick_a, s.climb_a, s.rifle_a]
    k = 0
    while k < 7 {
        if animators[k] != null { seen_take(seen[k] as *Seen, animators[k] as *Animator, s.clock) }
        k = k + 1
    }
    if s.clock >= s.seen_next {
        names = ["the runner", "the female", "the hit figure", "the captured walker", "the figure on a stick", "the climber", "the rifleman"]
        println("anim_showcase: at ${s.clock} s, the worst a player would see in the last ${METRIC_EVERY} s:")
        k = 0
        while k < 7 {
            seen_print(seen[k] as *Seen, names[k])
            k = k + 1
        }
        s.seen_next = s.seen_next + METRIC_EVERY
    }
}
