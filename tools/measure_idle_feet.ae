// How far a standing figure's feet stray in its own stance while it stands
// still: the measure behind motion's HOME_HELD (#1002, #1019).
//
//     ./build.sh tools/measure_idle_feet.ae && ./build/measure_idle_feet
//
// The neutral idle take (100STYLE Neutral_ID) read frame by frame: each
// ankle's place in the stance frame (from the pelvis, across and ahead the
// way the hips face, along the ground). Over each still stretch of a second
// or more (both feet planted by clips.find_contacts, the hips slower than
// 0.12 m/s), the widest any foot strays from where it stood at any other
// moment, the most it is off its mean place, and how far the feet's places
// relative to each other vary. A stretch in which a foot moved 2 cm or
// more in the world hides a step and is left out of the last line.
import ae3d.core
import ae3d.bvh
import ae3d.pose
import ae3d.clips

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const IDLE = "tests/fixtures/people/100style/whole/Neutral_ID.bvh.gz"

flat(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

main() {
    c = bvh.load(IDLE, 0.0)
    if c == null {
        println("cannot load ${IDLE}")
        return
    }
    r = bvh.rig(c)
    t = bvh.take(c, "idle", 0, 0 - 1)
    clips.find_contacts(t, r)
    n = clips.frames(t)
    rate = clips.rate(t)
    w = pose.new(r)
    // per frame: stance l (x, z), stance r (x, z), still (0/1), world ankles l, r (x, z)
    data = calloc(n * 9, 8)
    d = data as float[]
    last_p = core.vec3(0.0, 0.0, 0.0)
    fr = 0
    while fr < n {
        pose.world(r, clips.frame(t, fr), w)
        p = clips.ground_point(r, pose.translation(w, pose.human(r, pose.PELVIS)))
        tl = clips.ground_point(r, pose.translation(w, pose.human(r, pose.THIGH_L)))
        tr = clips.ground_point(r, pose.translation(w, pose.human(r, pose.THIGH_R)))
        al = clips.ground_point(r, pose.translation(w, pose.human(r, pose.FOOT_L)))
        ar = clips.ground_point(r, pose.translation(w, pose.human(r, pose.FOOT_R)))
        across = core.v3_normalize(flat(core.v3_sub(tl, tr)))
        ahead = core.v3_cross(across, core.vec3(0.0, 1.0, 0.0))
        dl = flat(core.v3_sub(al, p))
        dr = flat(core.v3_sub(ar, p))
        at = fr * 9
        d[at] = core.v3_dot(dl, across)
        d[at + 1] = core.v3_dot(dl, ahead)
        d[at + 2] = core.v3_dot(dr, across)
        d[at + 3] = core.v3_dot(dr, ahead)
        speed = 0.0
        if fr > 0 { speed = core.v3_len(flat(core.v3_sub(p, last_p))) * rate }
        last_p = p
        time = (fr as float) / rate
        still = speed < 0.12 && clips.planted(t, 0, time, false) && clips.planted(t, 1, time, false)
        d[at + 4] = 0.0
        if still { d[at + 4] = 1.0 }
        d[at + 5] = al.x
        d[at + 6] = al.z
        d[at + 7] = ar.x
        d[at + 8] = ar.z
        fr = fr + 1
    }
    println("idle take: ${n} frames at ${rate}/s")
    worst = 0.0
    total = 0.0
    fr = 0
    while fr < n {
        if d[fr * 9 + 4] < 0.5 {
            fr = fr + 1
            continue
        }
        start = fr
        while fr < n && d[fr * 9 + 4] > 0.5 { fr = fr + 1 }
        end = fr
        if ((end - start) as float) / rate < 1.0 { continue }
        total = total + ((end - start) as float) / rate
        // the widest a foot's stance place strays between two moments, and
        // the most its world place moves (a step hidden in the stretch)
        most_l = 0.0
        most_r = 0.0
        moved = 0.0
        most_rel = 0.0
        // each foot's mean place in the stance frame, and the most it is off it
        ml_x = 0.0
        ml_z = 0.0
        mr_x = 0.0
        mr_z = 0.0
        a = start
        while a < end {
            ml_x = ml_x + d[a * 9]
            ml_z = ml_z + d[a * 9 + 1]
            mr_x = mr_x + d[a * 9 + 2]
            mr_z = mr_z + d[a * 9 + 3]
            a = a + 1
        }
        cnt = (end - start) as float
        ml_x = ml_x / cnt
        ml_z = ml_z / cnt
        mr_x = mr_x / cnt
        mr_z = mr_z / cnt
        off_mean = 0.0
        a = start
        while a < end {
            ex = d[a * 9] - ml_x
            ez = d[a * 9 + 1] - ml_z
            if core.sqrt_of(ex * ex + ez * ez) > off_mean { off_mean = core.sqrt_of(ex * ex + ez * ez) }
            ex = d[a * 9 + 2] - mr_x
            ez = d[a * 9 + 3] - mr_z
            if core.sqrt_of(ex * ex + ez * ez) > off_mean { off_mean = core.sqrt_of(ex * ex + ez * ez) }
            a = a + 1
        }
        a = start
        while a < end {
            b = a + 1
            while b < end {
                ex = d[a * 9] - d[b * 9]
                ez = d[a * 9 + 1] - d[b * 9 + 1]
                el = core.sqrt_of(ex * ex + ez * ez)
                if el > most_l { most_l = el }
                ex = d[a * 9 + 2] - d[b * 9 + 2]
                ez = d[a * 9 + 3] - d[b * 9 + 3]
                er = core.sqrt_of(ex * ex + ez * ez)
                if er > most_r { most_r = er }
                // the feet from each other, in the hips' frame
                ex = (d[a * 9 + 2] - d[a * 9]) - (d[b * 9 + 2] - d[b * 9])
                ez = (d[a * 9 + 3] - d[a * 9 + 1]) - (d[b * 9 + 3] - d[b * 9 + 1])
                eb = core.sqrt_of(ex * ex + ez * ez)
                if eb > most_rel { most_rel = eb }
                b = b + 1
            }
            ex = d[a * 9 + 5] - d[start * 9 + 5]
            ez = d[a * 9 + 6] - d[start * 9 + 6]
            ml = core.sqrt_of(ex * ex + ez * ez)
            if ml > moved { moved = ml }
            ex = d[a * 9 + 7] - d[start * 9 + 7]
            ez = d[a * 9 + 8] - d[start * 9 + 8]
            mr = core.sqrt_of(ex * ex + ez * ez)
            if mr > moved { moved = mr }
            a = a + 1
        }
        println("  still ${(start as float) / rate} to ${(end as float) / rate} s: left strays ${most_l * 100.0} cm, right ${most_r * 100.0} cm; off its mean place ${off_mean * 100.0} cm; the feet from each other ${most_rel * 100.0} cm; stance width ${(mr_x - ml_x) * 100.0} cm, right ahead by ${(mr_z - ml_z) * 100.0} cm; a foot moved ${moved * 100.0} cm in the world")
        if moved < 0.02 {
            if most_l > worst { worst = most_l }
            if most_r > worst { worst = most_r }
        }
    }
    println("  over ${total} s still: the widest a planted foot strays in the stance frame ${worst * 100.0} cm")
    free(data)
    pose.release(w)
    clips.take_free(t)
    bvh.capture_free(c)
}
