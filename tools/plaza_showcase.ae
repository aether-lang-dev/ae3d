// The plaza showcase (#509, #860): a crowd wandering a plaza with a ramp,
// steps and a kerb, a car crossing through it, the people it strikes falling
// and getting up again, for a person or the agent loop to watch, and
// measured as it runs. On the engine's motion pipeline: each person the UE5
// mannequin made a character in one call (ae3d.character) on 100STYLE's
// neutral gaits, its capsule solid so the crowd steers round each other
// (#956), its feet locked and stepping (ae3d.ikrig), its bodies following
// its animation (ae3d.physanim); scored by ae3d.metrics as it ends, as
// tools/people_plaza.ae is.
//
//   ./build.sh tools/plaza_showcase.ae && ./build/plaza_showcase
//   AE3D_FIGURES=n (24)   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png (unattended)
//   AE3D_WATCH=k (close on person k, from its right)
//   AE3D_STANCES=1 (every stance's slide, as it ends; 3, those over 1 cm)
//   AE3D_TICK=60 (a frame a step)
//   AE3D_SEED=n (0): another draw of where the people start and go, for a
//   scorecard over several: who the car strikes, and how they land, turns
//   on where everyone is, and one draw's struck people say little
//   AE3D_KNOCKED=1 (each report, every struck person not walking yet: its state)
//   AE3D_EACH=1 (each report, each person's worst on its meter, and when)
//   AE3D_TRACE=k (person k step by step while it walks: its meter's reading,
//   each foot's target, lock and the ground under its soles, its mover's
//   velocity and facing, its graph's state, and how far the clip's own
//   foot crosses)
//   AE3D_FLAG=1 (every walking person's step past a crossing, pop or throw
//   bound: where, its velocity against its capsule's, its nearest neighbour)
//   AE3D_NOCAR=1 (no car)
//   AE3D_LAUNCH=1 (whatever goes up faster than the car comes: the car,
//   the people near it and the fastest; AE3D_LAUNCH_AT=n, steps n to n+30
//   body by body, #982)
//   F1, or AE3D_DEBUG=1 from the start: each foot's target (ae3d.ikrig)
//   drawn over it, green while it is locked and red while it swings, and
//   where its body will be a second on (its mover's velocity), a blue marker
//
// Each person walks to a place on the plaza, and on getting there picks
// another, a quarter of them at a run. Every CAR_EVERY seconds a car crosses
// on a lane through the crowd, a vehicle on four sprung wheels: a person it
// is about to reach is handed to its ragdoll, as test_knockdowns knocks one
// down: the character paused, its animator paused, its physanim bodies let
// go (physanim.release) to ae3d.motion LIMP, and the car meets those bodies
// and throws them. Once it lies at rest (motion.down) it gets up in one call
// (character.get_up: the get-up chosen by how the body lies, its capsule
// put under it, inertialized back), stands for STAND_AFTER and walks on. A
// person within LOOK_CAR of the car as it crosses watches it
// (character.look). Measured, every few seconds and at the end: the
// stances its feet took (a foot locked by ikrig, from set down to lifted)
// and how far the toe slid over the ground in each, which #509 holds under
// 1 cm; the scorecard of what a player sees wrong; ae3d.metrics' toe skate,
// feet crossing, fastest joint and FOOT_THROW, walking, and the fastest
// joint getting up against its get-up's own; and the frame's time.

import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.ikrig
import ae3d.physanim
import ae3d.motion
import ae3d.metrics
import ae3d.input
import ae3d.platform
import aephysics.human
import aephysics.dynamics
import aephysics.math

extern sqrt(x: float) -> float

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern clock_ns() -> long
extern exit(code: int)

const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const GET_UP = "LayToIdle"            // UAL2's, the mannequin's one get-up (and its mirror)
const HALF = 9.0                     // the plaza is 18 m square
const GROUND_PAST = 30.0             // m the ground runs on past it
const ARRIVED = 0.8                  // metres from its goal a person picks another
const GOAL_TRIES = 20                // places looked at for one on the floor
const NEARER = 0.3                   // metres nearer its goal that count as getting there
const HELD_UP = 4.0                  // seconds no nearer before it goes somewhere else
const CLEAR = 0.45                   // metres round a person put down kept clear of the blocks
const WALK = 1.2                     // m/s, people_plaza's walk and run
const RUN = 2.6
const REPORT = 5.0                   // seconds between reports
const SLID = 0.01                    // #509's bound on a stance's slide, metres
// A foot is on the ground while its pad (ikrig's sole under the ball of the
// foot) is within metrics.CONTACT of the ground under it, as ae3d.metrics
// reads a stance, and its toe's tip going over the ground then is the foot
// skating, locked by ikrig or not. Read off the toe joint, as the box man's
// toe base was, the mannequin's stood 9.7 to 82 mm over its rest height in
// a locked stance, and turning on the spot about the toe's tip slid it 6
// to 8 cm. One moving faster than SKATE_SPEED is counted in seconds too.
const SKATE_SPEED = 0.2
const METER_FROM = 60                // steps before the meters start: a second in, each person settled where it was put
// The car: a box 4 by 1.8 m, crossing the plaza along x at CAR_SPEED, one
// way then the other, every CAR_EVERY seconds. A person it reaches is handed
// to its ragdoll just before (CAR_HAND_OVER): its hips and legs kinematic on
// the animation, the car would have met them as an immovable post.
const CAR_SPEED = 7.0
const CAR_EVERY = 6.0
const THROUGH = 0.3                  // m from a walker a thrown body's pelvis passes through it
const SECOND_BLOW = 1.5              // m/s a thrown body meets a walker at, to strike it
const MOVING = 0.5                   // m/s a struck body's pelvis moves at, still moving
const BACK_KNEE = 0.087              // sine of the angle a knee bent backwards is bent past straight (5 degrees)
const HIP_AHEAD = 125.0              // degrees a person's thigh swings from hanging straight: ahead,
const HIP_BACK = 25.0                // back,
const HIP_OUT = 45.0                 // out to the side
const HIP_ACROSS = 30.0              // and across the other
const SPLAY = 1.5                    // a thigh half again past them is splayed where no one's goes
const OVERLAP_GIVE = 0.02            // m two figures' parts may be inside each other touching, a contact's give
const SUNK = 0.03                    // m below the ground a foot or body is sunk
const UNDER = 0.2                    // m a block standing on the ground reaches into it
const CAR_SINK = 0.02                // m of a part's capsule inside the car, past a contact's give
const TRODDEN = 0.35                 // m from a struck body a walker walks through it
const HEAD_SPIN = 2.0                // rad/s a risen person's head turns at most against its chest
const HEAD_AFTER = 1.0               // and not in the second after the car strikes it
const CAR_STANDS = 2.0               // seconds it stands, stopped, before it is gone
const CAR_HARMLESS = 1.0             // m/s under which it hands no one to a ragdoll
const CAR_HAND_OVER = 0.6            // metres from the car's box a person's ragdoll takes it over
const CAR_INSIDE = 0.3               // and no nearer: its arms would be inside it
const CAR_HALF_X = 2.0
const CAR_HALF_Z = 0.9
// Its body CAR_CLEAR off the ground, as a car's is: down to the ground, a
// body lying in its way was pressed between it and the ground and squeezed
// out through it.
const CAR_CLEAR = 0.3
const CAR_HALF_Y = 0.55
// A car on four sprung wheels (physics.vehicle), 1.2 t: its body rides on
// its suspension and gives to what it runs onto (#736).
const CAR_DENSITY = 150.0            // kg a cubic metre of its box: 1.2 t
const WHEEL_R = 0.32
const AXLE_HALF = 0.8                // m from the middle to a wheel, across
const AXLE_AHEAD = 1.4               // and along
const CAR_TORQUE = 900.0             // N m a driven wheel's motor
const CAR_TOP = 9.0                  // m/s at full throttle
const CAR_STEER = 0.5                // radians, the front wheels' most
const CAR_STOPPED = 0.05             // m/s under which it stands
// The suspension's spring, hertz: at 7 Hz a wheel carrying a quarter of
// 1.2 t sags about 4 cm of its 12 cm of travel.
const CAR_SPRING = 7.0
// Its lanes, LANES of them LANE_APART from LANE_FIRST: across the open half
// of the plaza, clear of the deck, the steps and the ramp, which stand
// higher than CAR_CLEAR (lanes_clear).
const LANES = 5
const LANE_FIRST = 1.0
const LANE_APART = 1.75
const BLOCKS_MOST = 16
const DOWN_FIRST = 0.5               // seconds struck before a body at rest is got up: the blow's first step is no rest
const BLEND = 0.4                    // s the get-up is inertialized in over (test_knockdowns')
const STAND_AFTER = 0.4              // seconds it stands, up again, before walking on
const LOOK_CAR = 10.0                // metres within which a person watches the car go by
const LAUNCH_UP = 7.0                // m/s up past which AE3D_LAUNCH=1 prints what is going up (#982): the car's speed
const WALKING = 0
const KNOCKED = 1                    // its ragdoll's, LIMP: falling and lying
const RISING = 2                     // playing its get-up
const RISEN = 3                      // standing, up again, before walking on

struct Walker {
    person: ptr                      // *Character
    object: ptr                      // *GameObject
    body: ptr                        // *Motion while it is knocked down, else null
    meter: ptr                       // *Meter: walking, from METER_FROM on
    rise: ptr                        // *Meter: getting up and standing again
    rise_own: float                  // the fastest its get-up's own take turns a joint
    drawn: ptr                       // its pose as drawn this step, and in the rig's space
    worlds: ptr
    head_last: Quat
    head_known: bool
    goal: Vec3
    pace: float
    seed: int
    held: ptr                        // int[2]: the foot locked last step
    from: ptr                        // float[6]: where each toe was when its foot was locked
    most: ptr                        // float[2]: the farthest each toe has slid in this stance
    ankle_z: ptr                     // float[2]
    ankle_most: ptr                  // float[2]: the same for the ankle
    thick: ptr                       // float[4]: the hips', chest's and each knee's half thickness, its bodies' capsule radii
    hinges: ptr                      // float[6]: each knee's hinge, in its thigh's frame
    reach: ptr                       // float[18]: each thigh's line down, out and ahead, in the hips' frame as it stood
    framed: bool                     // hinges and reach taken, at its first scored step
    marks: ptr                       // *GameObject[3]: the feet's targets and the way ahead, shown by F1
    state: int
    knocks: int                      // times struck
    struck_at: float
    standing: float                  // seconds to stand before walking on, up again
    turned: ptr                      // float[2]: the heading when each foot was locked
    low: ptr                         // float[2]: each toe's lowest over the ground in its stance
    toe_last: ptr                    // float[6]: each toe last step, its y its height over the ground
    toe_seen: bool
    nearest: float                   // metres from its goal at the nearest yet
    no_nearer: float                 // seconds since it last came NEARER
    was: Vec3                        // where it stood last metered step (AE3D_FLAG)
    was_known: bool
    walked_at: float                 // seconds when it last set off walking, up again
    up_state: int                    // the get-up it was told (character.get_up)
    up_begun: bool                   // and its waiting over, the get-up playing
}

struct Plaza {
    walkers: ptr                     // *Walker[count]
    count: int
    gaits: ptr                       // *Gaits
    steps: int
    seconds: float
    next_report: float
    stances: int
    over: int                        // stances that slid more than SLID
    slid_sum: float
    worst: float
    frame_ns: long
    frames: int
    worst_frame_ns: long
    last_ns: long
    ankle_sum: float
    car: ptr                         // *GameObject
    spin_seconds: float
    trodden_seconds: float
    skate: float                     // metres the toes went over the ground, walking
    skate_fast: float                // toe-seconds on the ground faster than SKATE_SPEED
    walking: float                   // walker-seconds walking
    overlap_down: float              // of it, one of the two struck
    back_knee: float
    back_knee_down: float            // of it, the person struck
    splayed: float                   // a thigh past a person's reach by SPLAY
    splayed_down: float              // of which not walking: struck, lying, getting up
    overlap: float
    sunk: float
    sunk_down: float                 // of it, the person struck
    in_car: float
    seconds_struck: int              // people struck by a thrown body, not the car
    through_seconds: float           // a struck body still moving within THROUGH of a walker walking
    trodden_lying: float             // of them, the body lying still
    rise_pop: float                  // rad/s a joint turned past its get-up's own fastest, getting up, at worst
    rise_pop_k: int
    car_body: ptr                    // *Rigidbody: the vehicle's chassis
    vehicle: ptr                     // *Vehicle
    wheels: ptr                      // *GameObject[WHEEL_COUNT]
    car_x: float
    car_way: float                   // +1 or -1 while crossing, 0 waiting
    car_z: float
    car_wait: float
    car_speed: float                 // m/s, braking from CAR_SPEED once it strikes
    blocks: ptr                      // float[BLOCKS_MOST * 3]: each block's least and most z, and its top
    block_count: int
    braking: bool
    stopped_for: float
    lane: int
    struck: int
    returned: int
    down_sum: float
    looking: int                     // people watching the car this step
    debug: bool                      // the markers shown
    build_ms: float                  // putting the people's bodies on (character.physical), at the start
    engine: ptr                      // *Engine: where a goal is looked for on the floor
    // Thrown off the ground (#982): the car's chassis, its most over its
    // ride height and fastest up; any person's body, fastest up and highest.
    car_rise: float
    car_up: float
    body_up: float
    body_high: float
    launch_told: float               // when the last AE3D_LAUNCH line was printed
    rise_waits: int                  // steps a get-up waited, something standing over the body
}

// Whether a person stood at x, z stands on the plaza's floor: the ground
// under it and a body's width round it no higher.
on_floor(e: *Engine, x: float, z: float) -> bool {
    k = 0
    while k < 5 {
        dx = 0.0
        dz = 0.0
        if k == 1 { dx = CLEAR }
        if k == 2 { dx = 0.0 - CLEAR }
        if k == 3 { dz = CLEAR }
        if k == 4 { dz = 0.0 - CLEAR }
        hit = physics.ray_static_hit(physics.of(e), core.vec3(x + dx, 2.0, z + dz), core.vec3(0.0, 0.0 - 1.0, 0.0), 4.0)
        if hit.hit && hit.point.y > 0.01 { return false }
        k = k + 1
    }
    return true
}

// A number from a seed, the next seed with it: the same plaza every run.
next_seed(seed: int) -> int { return (seed * 1103515245 + 12345) % 2147483647 }
unit_of(seed: int) -> float {
    s = seed
    if s < 0 { s = 0 - s }
    return ((s % 10000) as float) / 10000.0
}

// A place to go: on the plaza's floor, as where it starts is. Anywhere on
// the plaza, a goal up on the deck had a walker run straight at the deck's
// side and run on the spot there.
pick_goal(p: *Plaza, w: *Walker) {
    tries = 0
    while tries < GOAL_TRIES {
        w.seed = next_seed(w.seed)
        x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        w.seed = next_seed(w.seed)
        z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        w.goal = core.vec3(x, 0.0, z)
        if p.engine == null || on_floor(p.engine as *Engine, x, z) { tries = GOAL_TRIES }
        tries = tries + 1
    }
    w.seed = next_seed(w.seed)
    w.pace = WALK
    if unit_of(w.seed) < 0.25 { w.pace = RUN }
    w.nearest = 1000000.0
    w.no_nearer = 0.0
}

block(p: *Plaza, e: *Engine, name: string, at: Vec3, half: Vec3, turn: Quat) {
    o = engine.object(e, name, loader.cube(1.0))
    // Matte, as asphalt and concrete are: the ground a dark asphalt, the
    // deck, ramp, steps and kerb a grey concrete.
    bm = behaviour.object_model(o)
    if bm != null {
        if string.equals(name, "Ground") == 1 { core.model_set_diffuse(bm, 0.16, 0.16, 0.17) } else { core.model_set_diffuse(bm, 0.42, 0.41, 0.39) }
        core.model_set_specular(bm, 0.25, 0.25, 0.25)
        core.model_set_pbr(bm, 0.0, 0.92)
        core.model_set_reflectivity(bm, 0.0)
    }
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, turn)
    behaviour.object_set_scale(o, core.v3_mul(half, 2.0))
    physics.box_collider(o, half, physics.material(0.8, 0.0))
    // Where it stands across the car's way, and how high: over its corners.
    if p.blocks == null { p.blocks = calloc(BLOCKS_MOST * 3, 8) }
    if p.block_count >= BLOCKS_MOST { return }
    least = 1000000.0
    most = 0.0 - 1000000.0
    top = 0.0 - 1000000.0
    c = 0
    while c < 8 {
        sx = 1.0
        if (c & 1) != 0 { sx = 0.0 - 1.0 }
        sy = 1.0
        if (c & 2) != 0 { sy = 0.0 - 1.0 }
        sz = 1.0
        if (c & 4) != 0 { sz = 0.0 - 1.0 }
        corner = core.v3_add(at, core.quat_apply(turn, core.vec3(half.x * sx, half.y * sy, half.z * sz)))
        if corner.z < least { least = corner.z }
        if corner.z > most { most = corner.z }
        if corner.y > top { top = corner.y }
        c = c + 1
    }
    held = p.blocks as float[]
    held[p.block_count * 3] = least
    held[p.block_count * 3 + 1] = most
    held[p.block_count * 3 + 2] = top
    p.block_count = p.block_count + 1
}

// The car's lane `k`, its middle's z.
lane_z(k: int) -> float { return LANE_FIRST + LANE_APART * ((k % LANES) as float) }

// Whether every lane of the car passes over every block: none of them
// higher than CAR_CLEAR where the car's box crosses it.
lanes_clear(p: *Plaza) -> bool {
    held = p.blocks as float[]
    clear = true
    k = 0
    while k < LANES {
        z = lane_z(k)
        b = 0
        while b < p.block_count {
            if held[b * 3 + 1] > z - CAR_HALF_Z && held[b * 3] < z + CAR_HALF_Z && held[b * 3 + 2] > CAR_CLEAR {
                println("plaza: the car's lane at z ${z} crosses a block ${held[b * 3 + 2]} m high (z ${held[b * 3]} to ${held[b * 3 + 1]}), over the car's ${CAR_CLEAR} m clearance")
                clear = false
            }
            b = b + 1
        }
        k = k + 1
    }
    return clear
}

// The ground, a ramp up to a 0.6 m deck in the far corner, three 0.15 m
// steps down from its side, and a kerb across the near half. Each block
// reaches UNDER into the ground: standing on it, a block's bottom face lay
// on the ground's top, and a limb driven into its foot was pushed out
// through that face, down into the ground.
build_plaza(p: *Plaza, e: *Engine) {
    level = core.quat_rotate(0.0, core.vec3(0.0, 1.0, 0.0))
    // Wide past the plaza: whatever is thrown off it lands, not falls on.
    block(p, e, "Ground", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(HALF + GROUND_PAST, 0.5, HALF + GROUND_PAST), level)
    block(p, e, "Deck", core.vec3(6.0, (0.6 - UNDER) * 0.5, 0.0 - 6.0), core.vec3(2.0, (0.6 + UNDER) * 0.5, 2.0), level)
    // The ramp rises toward the deck, 10 degrees, from under the floor at
    // z -0.6 to 0.5 m at the deck's edge, and the steps rise 0.15 m each to
    // the deck's side, the highest against it. Turned the other way (#977),
    // the ramp's high end stood 0.5 m over the floor facing the plaza and
    // the steps' 0.45 m riser faced it, the 0.15 m one down against the
    // deck's 0.6: walls the crowd walked into.
    block(p, e, "Ramp", core.vec3(6.0, 0.15, 0.0 - 2.4), core.vec3(1.5, 0.05, 1.8), core.quat_rotate(0.17, core.vec3(1.0, 0.0, 0.0)))
    k = 0
    while k < 3 {
        h = 0.15 * ((k + 1) as float)
        block(p, e, "Step", core.vec3(4.0 - 0.175 - 0.35 * ((2 - k) as float), (h - UNDER) * 0.5, 0.0 - 6.0), core.vec3(0.175, (h + UNDER) * 0.5, 1.5), level)
        k = k + 1
    }
    block(p, e, "Kerb", core.vec3(0.0 - 3.0, (0.15 - UNDER) * 0.5, 3.0), core.vec3(4.0, (0.15 + UNDER) * 0.5, 0.2), level)
}

// The car: a body in the world on four sprung wheels, so what it meets it
// pushes. Its length along its own z, its nose toward -z, as a vehicle's is.
build_car(p: *Plaza, e: *Engine) {
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(CAR_HALF_Z * 2.0, CAR_HALF_Y * 2.0, CAR_HALF_X * 2.0))
    behaviour.object_set_position(car, car_parked())
    body = physics.rigidbody(car, physics.DYNAMIC)
    physics.box_collider(car, core.vec3(CAR_HALF_Z, CAR_HALF_Y, CAR_HALF_X), physics.material(0.6, 0.0), CAR_DENSITY)
    physics.rigidbody_set_damping(body, 0.05, 0.4)
    physics.rigidbody_enable_hit_events(body, true)
    wheels_block = calloc(physics.WHEEL_COUNT, 8)
    wheels = wheels_block as ptr[]
    mounts_block = calloc(physics.WHEEL_COUNT, sizeof(Vec3))
    mounts = mounts_block as Vec3[]
    k = 0
    while k < physics.WHEEL_COUNT {
        mounts[k] = car_mount(k)
        wheel = engine.object(e, "Wheel", loader.sphere(WHEEL_R, 16, 8))
        behaviour.object_set_position(wheel, core.v3_add(car_parked(), mounts[k]))
        physics.rigidbody(wheel, physics.DYNAMIC)
        physics.sphere_collider(wheel, WHEEL_R, physics.material(1.1, 0.0), 250.0)
        wheels[k] = wheel as ptr
        k = k + 1
    }
    p.vehicle = physics.vehicle(car, wheels_block, mounts_block, CAR_SPRING, 0.8, 0.12, CAR_TORQUE, CAR_TOP / WHEEL_R, CAR_STEER) as ptr
    free(mounts_block)
    p.wheels = wheels_block
    p.car_body = body as ptr
    p.car = car as ptr
    // Its contacts reach out over its travel (aephysics#173): at 6.5 m/s a
    // struck figure's limbs were found 5 to 8 cm inside it on the first step.
    physics.physics_set_travel_speculation(physics.of(e), true)
    park(p)
}

start(state: ptr, e: *Engine) {
    p = state as *Plaza
    p.engine = e as ptr
    physics.attach(e)
    build_plaza(p, e)
    if !lanes_clear(p) { exit(1) }
    build_car(p, e)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    p.gaits = g as ptr
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        if !person(p, e, ws[i] as *Walker, i) {
            println("plaza_showcase: ${character.error()}")
            p.count = i
            return
        }
        i = i + 1
    }
    p.next_report = REPORT
    input.bind_key(engine.engine_input(e), "debug", platform.KEY_F1)
}

// Person `i`: the mannequin a character on the plaza's floor, clear of the
// deck, the steps, the ramp and the kerb, its bodies on it, its get-up, its
// meters and its markers. False when the mannequin will not load.
person(p: *Plaza, e: *Engine, w: *Walker, i: int) -> bool {
    c = character.humanoid(e, "Walker", MANNEQUIN, p.gaits as *Gaits)
    if c == null { return false }
    o = character.object_of(c)
    w.seed = 7919 * (i + 1) + 104729 * core.env_int("AE3D_SEED", 0)
    x = 0.0
    z = 0.0
    tries = 0
    while tries == 0 || (!on_floor(e, x, z) && tries < 64) {
        w.seed = next_seed(w.seed)
        x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        w.seed = next_seed(w.seed)
        z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        tries = tries + 1
    }
    behaviour.object_set_position(o, core.vec3(x, 0.0, z))
    mover.settle(character.mover_of(c))
    physics.character_set_solid(physics.character_of(o), true)
    // Its bodies on it now, following its animation, so the car and a body
    // thrown meet them (#940).
    built = clock_ns()
    _bodied = character.physical(c)
    p.build_ms = p.build_ms + ((clock_ns() - built) as float) / 1000000.0
    if character.get_up_add(c, GET_UP) < 0 { println("plaza_showcase: the mannequin has no ${GET_UP}") }
    w.person = c as ptr
    w.object = o as ptr
    a = character.animator_of(c)
    r = animator.rig(a)
    m = metrics.meter_new(r, o)
    metrics.meter_ground_physics(m, physics.of(e))
    metrics.meter_animator(m, a)
    w.meter = m as ptr
    w.rise = metrics.meter_new(r, o) as ptr
    metrics.meter_ground_physics(w.rise as *Meter, physics.of(e))
    w.drawn = pose.new(r)
    w.worlds = pose.new(r)
    w.thick = part_thickness(physanim.ragdoll_of(character.physanim_of(c)))
    marks(p, e, w)
    pick_goal(p, w)
    return true
}

marks(p: *Plaza, e: *Engine, w: *Walker) {
    w.marks = calloc(3, 8)
    marks = w.marks as ptr[]
    k = 0
    while k < 3 {
        mark = engine.object(e, "Mark", loader.cube(1.0))
        behaviour.object_set_scale(mark, core.vec3(0.09, 0.03, 0.09))
        core.model_set_diffuse(mark.model as *Model, 0.2, 0.4, 1.0)
        (mark.model as *Model).visible = p.debug
        marks[k] = mark as ptr
        k = k + 1
    }
}

// The markers on a person, when shown: each foot's target where ikrig puts
// it, green locked and red swinging, on the ground under it, and its body a
// second on.
mark_walker(p: *Plaza, w: *Walker) {
    marks = w.marks as ptr[]
    show = p.debug && w.state == WALKING
    k = 0
    while k < 3 {
        ((marks[k] as *GameObject).model as *Model).visible = show
        k = k + 1
    }
    if !show { return }
    c = w.person as *Character
    f = animator.feet(character.animator_of(c))
    ph = physics.of(p.engine as *Engine)
    k = 0
    while k < 2 {
        mark = marks[k] as *GameObject
        target = ikrig.feet_target(f, k)
        ground = physics.ground_below(ph, target, 0.6, 1.6, ikrig.STAND_UP).point.y
        behaviour.object_set_position(mark, core.vec3(target.x, ground + 0.015, target.z))
        behaviour.object_set_scale(mark, core.vec3(0.16, 0.02, 0.16))
        if ikrig.feet_locked(f, k) {
            core.model_set_diffuse(mark.model as *Model, 0.2, 0.9, 0.3)
        } else {
            core.model_set_diffuse(mark.model as *Model, 0.95, 0.25, 0.2)
        }
        k = k + 1
    }
    at = behaviour.object_world_position(w.object as *GameObject)
    v = mover.velocity(character.mover_of(c))
    behaviour.object_set_position(marks[2] as *GameObject, core.vec3(at.x + v.x, at.y + 0.02, at.z + v.z))
}

// The person's pose as drawn this step, read into its poses (the rig's
// space): what the scorecard and the stances read.
read_drawn(w: *Walker) {
    r = animator.rig(character.animator_of(w.person as *Character))
    pose.read(r, w.drawn)
    pose.world(r, w.drawn, w.worlds)
}

// Joint `slot` where it is drawn, the ground's space.
joint_at(w: *Walker, slot: int) -> Vec3 {
    r = animator.rig(character.animator_of(w.person as *Character))
    j = pose.human(r, slot)
    if j < 0 { return behaviour.object_position(w.object as *GameObject) }
    return clips.ground_point(r, pose.translation(w.worlds, j))
}

// Joint `slot`'s turn as drawn, the ground's space: the rig's turned by the
// armature it hangs from.
turn_at(w: *Walker, slot: int) -> Quat {
    r = animator.rig(character.animator_of(w.person as *Character))
    j = pose.human(r, slot)
    q = core.quat(0.0, 0.0, 0.0, 1.0)
    if j >= 0 { q = pose.rotation(w.worlds, j) }
    base = pose.base_model(r)
    if base == null { return q }
    core.model_sync_transform(base)
    return core.quat_normalize(core.quat_mul(base.world_rotation, q))
}

// The way it faces, radians about up.
heading_of(w: *Walker) -> float {
    ahead = core.quat_apply(behaviour.object_rotation(w.object as *GameObject), core.vec3(0.0, 0.0, 1.0))
    return core.atan2_of(ahead.x, ahead.z)
}

// A step of a walker's feet: each stance's slide, from the toe's tip where
// the foot came down to where it is now, over the ground. A stance is the
// foot locked by ikrig with its pad on the ground: ikrig locks a foot on its
// heel as it strikes and rolls it onto its toe, and from the lock alone the
// toe's roll down onto the ground read as a slide, 2.9 cm a stance and 801
// of 902 stances over 1 cm.
watch_feet(p: *Plaza, w: *Walker) {
    c = w.person as *Character
    f = animator.feet(character.animator_of(c))
    held = w.held as int[]
    from = w.from as float[]
    most = w.most as float[]
    ankle_z = w.ankle_z as float[]
    ankle_most = w.ankle_most as float[]
    turned = w.turned as float[]
    low = w.low as float[]
    speed = core.v3_len(mover.velocity(character.mover_of(c)))
    k = 0
    while k < 2 {
        at, pad_up = sole(p, w, k)
        an = joint_at(w, pose.FOOT_L + (pose.FOOT_R - pose.FOOT_L) * k)
        down = ikrig.feet_locked(f, k) && pad_up < metrics.CONTACT
        if down && held[k] == 0 {
            turned[k] = heading_of(w)
            low[k] = pad_up
            from[k * 3] = at.x
            from[k * 3 + 2] = at.z
            most[k] = 0.0
            from[k * 3 + 1] = an.x
            ankle_z[k] = an.z
            ankle_most[k] = 0.0
        }
        if down && pad_up < low[k] { low[k] = pad_up }
        if down {
            d = core.v3_len(core.vec3(at.x - from[k * 3], 0.0, at.z - from[k * 3 + 2]))
            if d > most[k] { most[k] = d }
            da = core.v3_len(core.vec3(an.x - from[k * 3 + 1], 0.0, an.z - ankle_z[k]))
            if da > ankle_most[k] { ankle_most[k] = da }
        }
        if !down && held[k] == 1 { stance_ended(p, w, k, speed) }
        held[k] = 0
        if down { held[k] = 1 }
        k = k + 1
    }
}

// Foot `k`'s stance over: counted, and printed when asked.
stance_ended(p: *Plaza, w: *Walker, k: int, speed: float) {
    most = w.most as float[]
    ankle_most = w.ankle_most as float[]
    turned = (heading_of(w) - (w.turned as float[])[k]) * 57.3
    if core.env_int("AE3D_STANCES", 0) == 3 && most[k] > SLID {
        println("over: struck before ${w.struck_at > 0.0}, toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm, t ${p.seconds} turned ${turned} speed ${speed}")
    }
    if core.env_int("AE3D_STANCES", 0) == 1 {
        println("stance ${k}: toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm, its pad down to ${(w.low as float[])[k] * 1000.0} mm; turned ${turned} deg; speed ${speed}")
    }
    p.stances = p.stances + 1
    p.slid_sum = p.slid_sum + most[k]
    if most[k] > p.worst { p.worst = most[k] }
    if most[k] > SLID { p.over = p.over + 1 }
    p.ankle_sum = p.ankle_sum + ankle_most[k]
}

update(state: ptr, e: *Engine, delta: float) {
    p = state as *Plaza
    started = clock_ns()
    p.seconds = p.seconds + delta
    if input.pressed(engine.engine_input(e), "debug") { p.debug = !p.debug }
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        mark_walker(p, ws[i] as *Walker)
        i = i + 1
    }
    // The frame's time: from the last frame's update to this one's.
    if p.last_ns > 0 && p.seconds > 1.0 {
        took = started - p.last_ns
        p.frame_ns = p.frame_ns + took
        if took > p.worst_frame_ns { p.worst_frame_ns = took }
        p.frames = p.frames + 1
    }
    p.last_ns = started
    if p.seconds >= p.next_report {
        report(p)
        p.next_report = p.next_report + REPORT
    }
    camera(p, e)
}

// Each walker's errand: on to its goal, another picked once there or kept
// from it, standing a while once up again, and watching the car go by.
errands(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    p.looking = 0
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == WALKING { errand(p, w, step) }
        i = i + 1
    }
}

errand(p: *Plaza, w: *Walker, step: float) {
    c = w.person as *Character
    at = behaviour.object_world_position(w.object as *GameObject)
    to = core.vec3(w.goal.x - at.x, 0.0, w.goal.z - at.z)
    if core.v3_len(to) < ARRIVED { pick_goal(p, w) }
    // Kept from its goal (by the steps, the ramp's side, a knot of others)
    // it goes somewhere else, as a person would, rather than walking into
    // what is in the way.
    if core.v3_len(to) < w.nearest - NEARER {
        w.nearest = core.v3_len(to)
        w.no_nearer = 0.0
    } else {
        w.no_nearer = w.no_nearer + step
        if w.no_nearer > HELD_UP { pick_goal(p, w) }
    }
    to = core.vec3(w.goal.x - at.x, 0.0, w.goal.z - at.z)
    character.move(c, core.v3_mul(core.v3_normalize(to), w.pace), core.vec3(0.0, 0.0, 0.0))
    watch_car(p, w, at)
}

// The car's crossings and strikes, the walkers' errands and the struck
// ones' way back, and the measures: on the fixed step, as the tests measure.
fixed(state: ptr, e: *Engine, step: float) {
    p = state as *Plaza
    p.steps = p.steps + 1
    drive(p, e, step)
    errands(p, step)
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state != WALKING { recover(p, w, step) }
        read_drawn(w)
        i = i + 1
    }
    through(p, step)
    heads(p, step)
    trodden(p, step)
    score(p, step)
    meter(p, step)
    launches(p)
}

// The car this step, where it is, how fast and how it turns, and each
// person within 3 m of it: its state, and each body where it is, how fast,
// whether kinematic or limp.
launch_bodies(p: *Plaza) {
    chassis = physics.rigidbody_body(p.car_body as *Rigidbody)
    at = dynamics.body_get_position(chassis)
    v = dynamics.body_get_linear_velocity(chassis)
    wv = dynamics.body_get_angular_velocity(chassis)
    println("step ${p.steps}: car at ${at.x} ${at.y} ${at.z} v ${v.x} ${v.y} ${v.z} spin ${wv.x} ${wv.y} ${wv.z} braking ${p.braking}")
    k = 0
    while k < physics.WHEEL_COUNT {
        wheel = physics.rigidbody_body(physics.vehicle_wheel(p.vehicle as *Vehicle, k))
        wp = dynamics.body_get_position(wheel)
        wl = dynamics.body_get_linear_velocity(wheel)
        local = core.quat_apply(core.quat_conjugate(dynamics.body_get_rotation(chassis)), core.v3_sub(wp, at))
        println("  wheel ${k} at ${wp.x} ${wp.y} ${wp.z} (in the car ${local.x} ${local.y} ${local.z}) v ${wl.x} ${wl.y} ${wl.z}")
        k = k + 1
    }
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        r = ragdoll_of(w)
        pel = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
        if core.v3_len(core.vec3(pel.x - at.x, 0.0, pel.z - at.z)) < 3.0 {
            oa = behaviour.object_position(w.object as *GameObject)
            line = "  person ${i} state ${w.state} object ${oa.x} ${oa.y} ${oa.z} acting ${character.acting(w.person as *Character)}"
            h = physics.ragdoll_human(r)
            b = 0
            while b < physics.ragdoll_bone_count(r) {
                id = human.bone_at(h, b).body_id
                bp = dynamics.body_get_position(id)
                bv = dynamics.body_get_linear_velocity(id)
                line = "${line} | ${b} ${bp.x} ${bp.y} ${bp.z} v ${bv.x} ${bv.y} ${bv.z} k ${physics.ragdoll_bone_is_kinematic(r, b)} l ${physics.ragdoll_bone_is_limp(r, b)}"
                b = b + 1
            }
            println(line)
        }
        i = i + 1
    }
}

// Anything thrown off the ground (#982): the car's chassis risen over its
// ride height and how fast it goes up, and each person's bodies, how fast
// up and how high, kept at the worst. AE3D_LAUNCH=1 prints the scene when
// either goes up faster than LAUNCH_UP: the car, and each person near it,
// its state and its bodies.
launches(p: *Plaza) {
    up_car = 0.0
    if p.car_way != 0.0 || p.stopped_for > 0.0 {
        chassis = physics.rigidbody_body(p.car_body as *Rigidbody)
        at = dynamics.body_get_position(chassis)
        v = dynamics.body_get_linear_velocity(chassis)
        rise = at.y - (CAR_CLEAR + CAR_HALF_Y)
        if rise > p.car_rise { p.car_rise = rise }
        if v.y > p.car_up { p.car_up = v.y }
        up_car = v.y
    }
    ws = p.walkers as ptr[]
    worst = 0.0
    worst_k = 0 - 1
    i = 0
    while i < p.count {
        r = ragdoll_of(ws[i] as *Walker)
        h = physics.ragdoll_human(r)
        b = 0
        while b < physics.ragdoll_bone_count(r) {
            id = human.bone_at(h, b).body_id
            vy = dynamics.body_get_linear_velocity(id).y
            y = dynamics.body_get_position(id).y
            if vy > worst {
                worst = vy
                worst_k = i
            }
            if y > p.body_high { p.body_high = y }
            b = b + 1
        }
        i = i + 1
    }
    if worst > p.body_up { p.body_up = worst }
    // AE3D_LAUNCH_AT=n: steps n to n+30, every step, the car and the people
    // near it body by body.
    from = core.env_int("AE3D_LAUNCH_AT", 0 - 1)
    if from >= 0 && p.steps >= from && p.steps <= from + 30 {
        launch_bodies(p)
        return
    }
    if core.env_int("AE3D_LAUNCH", 0) != 1 || (up_car < LAUNCH_UP && worst < LAUNCH_UP) || p.seconds - p.launch_told < 0.1 { return }
    p.launch_told = p.seconds
    chassis = physics.rigidbody_body(p.car_body as *Rigidbody)
    at = dynamics.body_get_position(chassis)
    v = dynamics.body_get_linear_velocity(chassis)
    println("launch ${p.steps} t ${p.seconds}: car at ${at.x} ${at.y} ${at.z} v ${v.x} ${v.y} ${v.z} braking ${p.braking} stood ${p.stopped_for}; fastest up person ${worst_k} at ${worst} m/s")
    if worst_k >= 0 {
        fw = ws[worst_k] as *Walker
        fr = ragdoll_of(fw)
        fh = physics.ragdoll_human(fr)
        oa = behaviour.object_position(fw.object as *GameObject)
        line = "  fastest: person ${worst_k} state ${fw.state} since struck ${p.seconds - fw.struck_at} s, object ${oa.x} ${oa.y} ${oa.z}"
        b = 0
        while b < physics.ragdoll_bone_count(fr) {
            id = human.bone_at(fh, b).body_id
            bv = dynamics.body_get_linear_velocity(id)
            bp = dynamics.body_get_position(id)
            if bv.y > LAUNCH_UP { line = "${line} | bone ${b} at ${bp.x} ${bp.y} ${bp.z} v ${bv.x} ${bv.y} ${bv.z} kinematic ${physics.ragdoll_bone_is_kinematic(fr, b)} limp ${physics.ragdoll_bone_is_limp(fr, b)}" }
            b = b + 1
        }
        println(line)
    }
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        pel = behaviour.object_position(physics.ragdoll_bone(ragdoll_of(w), human.BONE_PELVIS))
        gap = core.v3_len(core.vec3(pel.x - at.x, 0.0, pel.z - at.z))
        if gap < 3.0 {
            r = ragdoll_of(w)
            h = physics.ragdoll_human(r)
            fast = 0.0
            fast_b = 0
            kin = 0
            b = 0
            while b < physics.ragdoll_bone_count(r) {
                s = physics.ragdoll_bone_speed(r, b)
                if s > fast {
                    fast = s
                    fast_b = b
                }
                if physics.ragdoll_bone_is_kinematic(r, b) { kin = kin + 1 }
                b = b + 1
            }
            println("  person ${i} state ${w.state} since struck ${p.seconds - w.struck_at} s, pelvis ${pel.x} ${pel.y} ${pel.z} (${gap} m from the car), fastest bone ${fast_b} ${fast} m/s, ${kin} kinematic, acting ${character.acting(w.person as *Character)}")
        }
        i = i + 1
    }
}

// The meters, from METER_FROM on: a walker's walking, a risen one's getting
// up and standing again.
meter(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if p.steps == METER_FROM { metrics.meter_reset(w.meter as *Meter) }
        if p.steps > METER_FROM && w.state == WALKING {
            metrics.meter_take(w.meter as *Meter, step)
            if i == core.env_int("AE3D_TRACE", 0 - 1) { trace(p, w) }
            if core.env_int("AE3D_FLAG", 0) == 1 { flag(p, w, i, step) }
            watch_feet(p, w)
            skating(p, w, step)
        } else {
            w.toe_seen = false
            w.was_known = false
        }
        if w.state == RISING || w.state == RISEN { metrics.meter_take(w.rise as *Meter, step) }
        i = i + 1
    }
}

// AE3D_FLAG=1: a line for every walking person's step whose meter read a
// foot crossed past FLAG_CROSS, a joint past FLAG_POP or a toe thrown past
// FLAG_THROWN: where, its mover's velocity against how fast its capsule
// really went (a contact holding it back), the nearest other person, the
// ground under it, and how long since it set off again after a get-up.
const FLAG_CROSS = 0.005
const FLAG_POP = 40.0
const FLAG_THROWN = 1.5
const FLAG_SKATE = 0.005
const FLAG_INTO = 0.005
flag(p: *Plaza, w: *Walker, k: int, step: float) {
    m = w.meter as *Meter
    at = behaviour.object_position(w.object as *GameObject)
    went = core.vec3(0.0, 0.0, 0.0)
    if w.was_known { went = core.v3_mul(core.v3_sub(at, w.was), 1.0 / step) }
    w.was = at
    w.was_known = true
    cross = metrics.meter_last(m, metrics.FEET_CROSS)
    pop = metrics.meter_last(m, metrics.POP)
    thrown = metrics.meter_last(m, metrics.FOOT_THROW)
    skate = metrics.meter_last(m, metrics.SKATE)
    into = metrics.meter_last(m, metrics.INTO_GROUND)
    if cross <= FLAG_CROSS && pop <= FLAG_POP && thrown <= FLAG_THROWN && skate <= FLAG_SKATE && into <= FLAG_INTO { return }
    v = mover.velocity(character.mover_of(w.person as *Character))
    ws = p.walkers as ptr[]
    near = 1000.0
    near_k = 0 - 1
    j = 0
    while j < p.count {
        if j != k {
            o = behaviour.object_position((ws[j] as *Walker).object as *GameObject)
            d = core.v3_len(core.vec3(o.x - at.x, 0.0, o.z - at.z))
            if d < near {
                near = d
                near_k = j
            }
        }
        j = j + 1
    }
    since = 0.0 - 1.0
    if w.knocks > 0 { since = p.seconds - w.walked_at }
    println("flag ${p.steps} person ${k} at ${at.x} ${at.y} ${at.z} cross ${cross * 1000.0} pop ${pop} thrown ${thrown} v ${v.x} ${v.z} went ${went.x} ${went.z} near ${near} (${near_k}) knocks ${w.knocks} since_up ${since} skate ${skate * 1000.0} into ${into * 1000.0}")
}

// AE3D_TRACE=k: person k, a line a step while it walks: where it stands,
// what its meter read this step (the fastest joint and which, the feet
// crossing, a toe thrown), and each foot's ikrig target, lock, and the
// ground under its heel, pad and toe against their heights.
trace(p: *Plaza, w: *Walker) {
    m = w.meter as *Meter
    a = character.animator_of(w.person as *Character)
    r = animator.rig(a)
    f = animator.feet(a)
    at = behaviour.object_position(w.object as *GameObject)
    joint = "none"
    if metrics.meter_joint(m, metrics.POP) >= 0 { joint = pose.name(r, metrics.meter_joint(m, metrics.POP)) }
    mv = character.mover_of(w.person as *Character)
    v = mover.velocity(mv)
    // The clip's own feet (the graph's pose, before ikrig): how far its
    // foot crosses, as the meter reads the one drawn.
    clip_cross = 0.0 - 1.0
    clip_feet = ""
    if animator.pose_graph(a) != null {
        cw = pose.new(r)
        pose.world(r, animator.pose_graph(a), cw)
        hl = ikrig.to_ground(r, pose.translation(cw, pose.human(r, pose.THIGH_L)))
        hr = ikrig.to_ground(r, pose.translation(cw, pose.human(r, pose.THIGH_R)))
        al = ikrig.to_ground(r, pose.translation(cw, pose.human(r, pose.FOOT_L)))
        ar = ikrig.to_ground(r, pose.translation(cw, pose.human(r, pose.FOOT_R)))
        pose.release(cw)
        clip_feet = " clipfeet ${al.x} ${al.z} ${ar.x} ${ar.z} gs ${animator.ground_speed(a)} down ${animator.contact_weight(a, 0)} ${animator.contact_weight(a, 1)}"
        across = core.vec3(hl.x - hr.x, 0.0, hl.z - hr.z)
        if core.v3_len(across) > 0.000001 {
            across = core.v3_normalize(across)
            mid = core.v3_lerp(hl, hr, 0.5)
            clip_cross = core.v3_dot(core.v3_sub(ar, mid), across)
            other = 0.0 - core.v3_dot(core.v3_sub(al, mid), across)
            if other > clip_cross { clip_cross = other }
        }
    }
    line = "trace ${p.steps} at ${at.x} ${at.y} ${at.z} pop ${metrics.meter_last(m, metrics.POP)} (worst's ${joint}) cross ${metrics.meter_last(m, metrics.FEET_CROSS) * 1000.0} thrown ${metrics.meter_last(m, metrics.FOOT_THROW)} v ${v.x} ${v.z} yaw ${mover.facing_of(mv)} state ${animator.current(a)} clipcross ${clip_cross * 1000.0}${clip_feet}"
    ph = physics.of(p.engine as *Engine)
    k = 0
    while k < 2 {
        heel, pad, toe = ikrig.feet_soles(f, r, w.worlds, k)
        target = ikrig.feet_target(f, k)
        gh = physics.ground_below(ph, heel, 0.6, 1.6, ikrig.STAND_UP).point.y
        gp = physics.ground_below(ph, pad, 0.6, 1.6, ikrig.STAND_UP).point.y
        gt = physics.ground_below(ph, toe, 0.6, 1.6, ikrig.STAND_UP).point.y
        line = "${line} | ${k} lock ${ikrig.feet_locked(f, k)} target ${target.x} ${target.y} ${target.z} heel ${heel.x} ${heel.y} ${heel.z} over ${gh} pad ${pad.y} over ${gp} toe ${toe.x} ${toe.y} ${toe.z} over ${gt}"
        k = k + 1
    }
    println(line)
}

// What the scorecard reads a figure's legs against, taken as it stands at
// its first scored step, in whatever step its gait has it: each knee's
// hinge, the line across the hips, in its thigh's frame to turn with it (the
// knee bends and the thigh swings in a stride about that line, so a stride
// leaves it where it is); and, in the hips' frame, the line a person's thigh
// hangs along standing, straight down, out to each side, and ahead the way
// it faces.
stood(w: *Walker) {
    down = core.vec3(0.0, 0.0 - 1.0, 0.0)
    line = core.v3_sub(joint_at(w, pose.THIGH_R), joint_at(w, pose.THIGH_L))
    across = core.v3_normalize(core.v3_sub(line, core.v3_mul(down, core.v3_dot(line, down))))
    // Ahead the way the figure faces, its object's +z, not the way its
    // toes point: a foot turned up read a stride as the thigh thrown back.
    ahead = core.v3_cross(across, down)
    if core.v3_dot(ahead, core.quat_apply(behaviour.object_world_rotation(w.object as *GameObject), core.vec3(0.0, 0.0, 1.0))) < 0.0 {
        ahead = core.v3_mul(ahead, 0.0 - 1.0)
    }
    to_hips = core.quat_conjugate(turn_at(w, pose.PELVIS))
    // The hinge the way a knee flexes about it: a thigh hanging down and
    // its shin swung back read flexed. Along the line across the hips, left
    // to right, the box man's knees (facing -z) flexed about it; the
    // mannequin's, facing +z, read bent backwards at every step.
    hinge = core.v3_normalize(core.v3_cross(ahead, down))
    hinges = w.hinges as float[]
    reach = w.reach as float[]
    k = 0
    while k < 2 {
        thigh = turn_at(w, pose.THIGH_L + (pose.THIGH_R - pose.THIGH_L) * k)
        put3(hinges, k * 3, core.quat_apply(core.quat_conjugate(thigh), hinge))
        out = across
        if k == 0 { out = core.v3_mul(across, 0.0 - 1.0) }
        put3(reach, k * 9, core.quat_apply(to_hips, down))
        put3(reach, k * 9 + 3, core.quat_apply(to_hips, out))
        put3(reach, k * 9 + 6, core.quat_apply(to_hips, ahead))
        k = k + 1
    }
}

// Whether leg `k`'s thigh, along `thigh`, is past a person's reach by
// SPLAY: its swing from hanging straight, against the ellipse through
// HIP_AHEAD, HIP_BACK, HIP_OUT and HIP_ACROSS the way it swung.
splayed(w: *Walker, k: int, thigh: Vec3) -> bool {
    reach = w.reach as float[]
    d = core.v3_normalize(core.quat_apply(core.quat_conjugate(turn_at(w, pose.PELVIS)), thigh))
    out = core.v3_dot(d, get3(reach, k * 9 + 3))
    ahead = core.v3_dot(d, get3(reach, k * 9 + 6))
    side = core.sqrt_of(out * out + ahead * ahead)
    if side < 0.000001 { return false }
    swing = core.atan2_of(side, core.v3_dot(d, get3(reach, k * 9))) * 57.29578
    a = HIP_AHEAD
    if ahead < 0.0 { a = HIP_BACK }
    b = HIP_OUT
    if out < 0.0 { b = HIP_ACROSS }
    x = swing * ahead / side / a
    y = swing * out / side / b
    return x * x + y * y > SPLAY * SPLAY
}

put3(a: float[], at: int, v: Vec3) {
    a[at] = v.x
    a[at + 1] = v.y
    a[at + 2] = v.z
}

get3(a: float[], at: int) -> Vec3 { return core.vec3(a[at], a[at + 1], a[at + 2]) }

// The scorecard: what a player sees wrong, in figure-seconds, every fixed
// step over every person, as drawn. A knee bent backwards (past straight by
// BACK_KNEE, about its own hinge); a thigh splayed past a person's reach
// (SPLAY); two figures inside each other; a foot or a body sunk in the
// ground (SUNK); a part inside the car (CAR_SINK).
score(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if !w.framed {
            stood(w)
            w.framed = true
        }
        score_legs(p, w, 0, step)
        score_legs(p, w, 1, step)
        j = i + 1
        while j < p.count {
            if inside(w, ws[j] as *Walker) {
                p.overlap = p.overlap + step
                if w.state != WALKING || (ws[j] as *Walker).state != WALKING { p.overlap_down = p.overlap_down + step }
            }
            j = j + 1
        }
        if w.state == KNOCKED { score_body(p, w, step) }
        i = i + 1
    }
}

// Leg `k`'s knee bent backwards, its thigh splayed, its foot sunk.
score_legs(p: *Plaza, w: *Walker, k: int, step: float) {
    hip = joint_at(w, pose.THIGH_L + (pose.THIGH_R - pose.THIGH_L) * k)
    knee = joint_at(w, pose.CALF_L + (pose.CALF_R - pose.CALF_L) * k)
    ankle = joint_at(w, pose.FOOT_L + (pose.FOOT_R - pose.FOOT_L) * k)
    toe = joint_at(w, pose.BALL_L + (pose.BALL_R - pose.BALL_L) * k)
    // Bent backwards: the knee's bend about its own hinge, the other way
    // from its flexing, past BACK_KNEE. The hinge is the line across the
    // hips as the figure stood, turned with the thigh: about the line across
    // the hips as they are, a struck figure's thigh flung out to the side
    // took its knee's hinge round with it (aephysics#129).
    hinge = core.quat_apply(turn_at(w, pose.THIGH_L + (pose.THIGH_R - pose.THIGH_L) * k), get3(w.hinges as float[], k * 3))
    thigh = core.v3_sub(knee, hip)
    shin = core.v3_sub(ankle, knee)
    if core.v3_len(thigh) > 0.01 && core.v3_len(shin) > 0.01 {
        flex = core.v3_dot(core.v3_cross(thigh, shin), hinge) / (core.v3_len(thigh) * core.v3_len(shin))
        if flex < 0.0 - BACK_KNEE {
            p.back_knee = p.back_knee + step
            if w.state != WALKING { p.back_knee_down = p.back_knee_down + step }
        }
        if splayed(w, k, thigh) {
            p.splayed = p.splayed + step
            if w.state != WALKING { p.splayed_down = p.splayed_down + step }
        }
    }
    if toe.y < 0.0 - SUNK || ankle.y < 0.0 - SUNK {
        p.sunk = p.sunk + step
        if w.state != WALKING { p.sunk_down = p.sunk_down + step }
    }
}

// A knocked-down person's bodies: sunk in the ground, or inside the car.
score_body(p: *Plaza, w: *Walker, step: float) {
    r = ragdoll_of(w)
    if physics.ragdoll_pose_lowest(r, null) < 0.0 - SUNK {
        p.sunk = p.sunk + step
        p.sunk_down = p.sunk_down + step
    }
    if p.car_way != 0.0 && in_car(p, r) > CAR_SINK { p.in_car = p.in_car + step }
}

ragdoll_of(w: *Walker) -> *Ragdoll { return physanim.ragdoll_of(character.physanim_of(w.person as *Character)) }

// Whether two figures, as drawn, are inside each other: any of one's hips,
// chest and knees nearer any of the other's than the two parts are thick
// (their bodies' capsule radii, summed) by more than OVERLAP_GIVE, as
// CAR_SINK is held past a contact's give: two bodies lying one on the other
// touch within it.
inside(a: *Walker, b: *Walker) -> bool {
    ta = a.thick as float[]
    tb = b.thick as float[]
    i = 0
    while i < 4 {
        pa = drawn_point(a, i)
        k = 0
        while k < 4 {
            if core.v3_len(core.v3_sub(pa, drawn_point(b, k))) < ta[i] + tb[k] - OVERLAP_GIVE { return true }
            k = k + 1
        }
        i = i + 1
    }
    return false
}

drawn_point(w: *Walker, i: int) -> Vec3 {
    if i == 1 { return joint_at(w, pose.SPINE_03) }
    if i == 2 { return joint_at(w, pose.CALF_L) }
    if i == 3 { return joint_at(w, pose.CALF_R) }
    return joint_at(w, pose.PELVIS)
}

// A person's parts' half thickness (float[4]: hips, chest, left knee, right
// knee): its bodies' capsule radii, the pelvis's, the chest's and each
// calf's.
part_thickness(r: *Ragdoll) -> ptr {
    out = calloc(4, 8)
    t = out as float[]
    i = 0
    while i < 4 {
        t[i] = 0.1
        i = i + 1
    }
    if r == null { return out }
    h = physics.ragdoll_human(r)
    t[0] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_PELVIS).shape_id).radius
    t[1] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_SPINE_03).shape_id).radius
    t[2] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_CALF_L).shape_id).radius
    t[3] = dynamics.shape_get_capsule(human.bone_at(h, human.BONE_CALF_R).shape_id).radius
    return out
}

// How deep a ragdoll's deepest part is inside the car, in metres (0 when
// none is): each bone's capsule, at five points along it, against the car's
// box where its body is now, at the same instant as the bones.
in_car(p: *Plaza, r: *Ragdoll) -> float {
    car = dynamics.body_get_transform(physics.rigidbody_body(p.car_body as *Rigidbody))
    h = physics.ragdoll_human(r)
    deepest = 0.0
    b = 0
    while b < physics.ragdoll_bone_count(r) {
        bone = human.bone_at(h, b)
        at = dynamics.body_get_transform(bone.body_id)
        c = dynamics.shape_get_capsule(bone.shape_id)
        k = 0
        while k < 5 {
            f = (k as float) * 0.25
            local = math.add(c.center1, math.mul_sv(f, math.sub(c.center2, c.center1)))
            d = c.radius - box_distance(math.inv_transform_point(car, math.transform_point(at, local)))
            if d > deepest { deepest = d }
            k = k + 1
        }
        b = b + 1
    }
    return deepest
}

// A point's signed distance from the car's box, in the car's frame (its
// length along its z): negative inside.
box_distance(q: Vec3) -> float {
    dx = core.abs_of(q.x) - CAR_HALF_Z
    dy = core.abs_of(q.y) - CAR_HALF_Y
    dz = core.abs_of(q.z) - CAR_HALF_X
    if dx <= 0.0 && dy <= 0.0 && dz <= 0.0 {
        most = dx
        if dy > most { most = dy }
        if dz > most { most = dz }
        return most
    }
    if dx < 0.0 { dx = 0.0 }
    if dy < 0.0 { dy = 0.0 }
    if dz < 0.0 { dz = 0.0 }
    return sqrt(dx * dx + dy * dy + dz * dz)
}

// Whether a struck body is still on the move: falling, or its pelvis going
// faster than MOVING.
thrown(w: *Walker) -> bool {
    m = w.body as *Motion
    if w.state != KNOCKED || m == null { return false }
    return motion.falling(m) || physics.ragdoll_bone_speed(ragdoll_of(w), human.BONE_PELVIS) > MOVING
}

// Seconds a thrown body's pelvis passes within THROUGH of a walker walking.
through(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == WALKING {
            at = behaviour.object_world_position(w.object as *GameObject)
            near = 1000.0
            j = 0
            while j < p.count {
                d = ws[j] as *Walker
                if j != i && thrown(d) {
                    pel = behaviour.object_position(physics.ragdoll_bone(ragdoll_of(d), human.BONE_PELVIS))
                    gap = core.v3_len(core.vec3(pel.x - at.x, 0.0, pel.z - at.z))
                    if gap < near { near = gap }
                }
                j = j + 1
            }
            if near < THROUGH { p.through_seconds = p.through_seconds + step }
        }
        i = i + 1
    }
}

drive(p: *Plaza, e: *Engine, step: float) {
    car = p.car as *GameObject
    if car == null || core.env_int("AE3D_NOCAR", 0) == 1 { return }
    if p.car_way == 0.0 {
        p.car_wait = p.car_wait - step
        if p.car_wait > 0.0 { return }
        // Across the plaza along a lane through the crowd, each crossing the
        // other way and on another lane.
        p.lane = p.lane + 1
        p.car_way = 1.0
        if p.lane % 2 == 0 { p.car_way = 0.0 - 1.0 }
        p.car_x = (0.0 - p.car_way) * (HALF + 4.0)
        p.car_z = lane_z(p.lane)
        // Put there rolling at its speed, not driven there: moved over a
        // step from where it was parked, it would sweep the plaza at
        // hundreds of metres a second.
        place_car(p)
        p.car_speed = CAR_SPEED
        p.braking = false
        p.stopped_for = 0.0
    }
    // Having struck someone it brakes, as a driver does, stands, and is
    // gone: driven on at its speed, it carried the struck before it on its
    // bumper.
    drive_car(p)
    if p.braking && p.car_speed < CAR_STOPPED { p.stopped_for = p.stopped_for + step }
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == WALKING && about_to_meet(p, w) { strike(p, e, w) }
        i = i + 1
    }
    if (core.abs_of(p.car_x) > HALF + 4.0 && p.car_x * p.car_way > 0.0) || p.stopped_for >= CAR_STANDS {
        p.car_way = 0.0
        p.car_wait = CAR_EVERY
        park(p)
    }
    felt(p, e)
}

// Whether the car is about to reach a walker, front or side: handed to its
// ragdoll then, so the car meets bodies a blow moves. Never inside the
// car's box: handed over there, its bodies were thrown out of it.
about_to_meet(p: *Plaza, w: *Walker) -> bool {
    at = behaviour.object_world_position(w.object as *GameObject)
    out_x = core.abs_of(at.x - p.car_x) - CAR_HALF_X
    out_z = core.abs_of(at.z - p.car_z) - CAR_HALF_Z
    if out_x < 0.0 { out_x = 0.0 }
    if out_z < 0.0 { out_z = 0.0 }
    clear = sqrt(out_x * out_x + out_z * out_z)
    return clear > CAR_INSIDE && clear < CAR_HAND_OVER && p.car_speed > CAR_HARMLESS
}

// Seconds a walker walking is within TRODDEN of a struck body (pelvis to
// neck), summed over the pairs: walked through.
trodden(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        down = ws[i] as *Walker
        if down.state != WALKING {
            r = ragdoll_of(down)
            a = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_PELVIS))
            b = behaviour.object_position(physics.ragdoll_bone(r, human.BONE_NECK))
            m = down.body as *Motion
            lying = m != null && (motion.lying(m) || motion.down(m))
            j = 0
            while j < p.count {
                w = ws[j] as *Walker
                if j != i && w.state == WALKING && near_segment(behaviour.object_world_position(w.object as *GameObject), a, b) {
                    p.trodden_seconds = p.trodden_seconds + step
                    if lying { p.trodden_lying = p.trodden_lying + step }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// Whether `at` is within TRODDEN of the segment from `a` to `b`, level.
near_segment(at: Vec3, a: Vec3, b: Vec3) -> bool {
    ab = core.vec3(b.x - a.x, 0.0, b.z - a.z)
    span = ab.x * ab.x + ab.z * ab.z
    u = 0.0
    if span > 0.0001 { u = core.clampf(((at.x - a.x) * ab.x + (at.z - a.z) * ab.z) / span, 0.0, 1.0) }
    near = core.vec3(a.x + ab.x * u - at.x, 0.0, a.z + ab.z * u - at.z)
    return near.x * near.x + near.z * near.z < TRODDEN * TRODDEN
}

// Seconds a risen person, up on its feet before it walks on, has its head
// turning faster than HEAD_SPIN against its chest, as drawn, summed over the
// people. Not while it falls, lies or plays its get-up, nor in the second
// after the car strikes it: there the head is thrown about by the blow, as
// a struck person's is.
heads(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == RISEN {
            rel = core.quat_mul(core.quat_conjugate(turn_at(w, pose.SPINE_03)), turn_at(w, pose.NECK))
            if w.head_known {
                d = core.quat_mul(rel, core.quat_conjugate(w.head_last))
                a = 2.0 * core.acos_of(core.clampf(core.abs_of(d.w), 0.0, 1.0)) / step
                if a > HEAD_SPIN && p.seconds - w.struck_at > HEAD_AFTER { p.spin_seconds = p.spin_seconds + step }
            }
            w.head_last = rel
            w.head_known = true
        } else {
            w.head_known = false
        }
        i = i + 1
    }
}

// What the car struck this step, each body as hard as it met it: the blow
// the struck feels, without a second push, the contact having given it.
felt(p: *Plaza, e: *Engine) {
    ph = physics.of(e)
    car = physics.rigidbody_body(p.car_body as *Rigidbody)
    n = physics.hit_event_count(ph)
    k = 0
    while k < n {
        ev = physics.hit_event(ph, k)
        other = ev.shape_id_b
        if !same_body(dynamics.shape_get_body(ev.shape_id_a), car) {
            other = ev.shape_id_a
            if !same_body(dynamics.shape_get_body(ev.shape_id_b), car) { other = dynamics.null_shape_id() }
        }
        if dynamics.shape_is_valid(other) {
            i = walker_of(p, physics.ragdoll_of_shape(ph, other))
            if i >= 0 {
                w = (p.walkers as ptr[])[i] as *Walker
                // Met before it was handed over (walked into the car's side):
                // handed over now.
                if w.state == WALKING { strike(p, e, w) }
                feel(p, w, dynamics.shape_get_body(other), ev)
                p.braking = true
            }
        } else {
            second(p, e, ev)
        }
        k = k + 1
    }
}

// A body thrown into a walker: struck hard enough (SECOND_BLOW) by a body
// still on the move, the walker is struck too, the blow felt where they
// met, as a second victim, rather than walking on through the body that hit
// it (#648). A walker's legs meeting a body lying still strike no one.
second(p: *Plaza, e: *Engine, ev: ContactHitEvent) {
    if ev.approach_speed < SECOND_BLOW { return }
    ph = physics.of(e)
    ia = walker_of(p, physics.ragdoll_of_shape(ph, ev.shape_id_a))
    ib = walker_of(p, physics.ragdoll_of_shape(ph, ev.shape_id_b))
    if ia < 0 || ib < 0 || ia == ib { return }
    ws = p.walkers as ptr[]
    wa = ws[ia] as *Walker
    wb = ws[ib] as *Walker
    hit = wa
    body = dynamics.shape_get_body(ev.shape_id_a)
    if wa.state != WALKING {
        hit = wb
        body = dynamics.shape_get_body(ev.shape_id_b)
        if !thrown(wa) { return }
    } else if !thrown(wb) {
        return
    }
    if hit.state != WALKING { return }
    strike(p, e, hit)
    if hit.state != KNOCKED { return }
    p.seconds_struck = p.seconds_struck + 1
    feel(p, hit, body, ev)
}

// The walker whose bodies ragdoll `r` is, or -1.
walker_of(p: *Plaza, r: *Ragdoll) -> int {
    if r == null { return 0 - 1 }
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        if ragdoll_of(ws[i] as *Walker) == r { return i }
        i = i + 1
    }
    return 0 - 1
}

// Hit events on, or off, on every shape of a ragdoll's bodies: what a body
// thrown meets is told (second).
hit_events(r: *Ragdoll, on: bool) {
    h = physics.ragdoll_human(r)
    i = 0
    while i < physics.ragdoll_bone_count(r) {
        bone = human.bone_at(h, i)
        dynamics.shape_enable_hit_events(bone.shape_id, on)
        if dynamics.shape_is_valid(bone.foot_shape_id) { dynamics.shape_enable_hit_events(bone.foot_shape_id, on) }
        i = i + 1
    }
}

car_parked() -> Vec3 { return core.vec3(0.0 - HALF - 30.0, CAR_CLEAR + CAR_HALF_Y, 0.0) }

// The car's turn for its way: its nose, -z, along +x or -x.
car_facing(way: float) -> Quat { return core.quat_rotate((0.0 - way) * 1.5707963, core.vec3(0.0, 1.0, 0.0)) }

// The car and its wheels at the start of its crossing (p.car_x, p.car_z),
// in the world and rolling at CAR_SPEED its way.
place_car(p: *Plaza) {
    v = p.vehicle as *Vehicle
    facing = car_facing(p.car_way)
    at = core.vec3(p.car_x, CAR_CLEAR + CAR_HALF_Y, p.car_z)
    going = core.vec3(p.car_way * CAR_SPEED, 0.0, 0.0)
    chassis = physics.vehicle_chassis(v)
    dynamics.body_enable(chassis.body_id)
    physics.rigidbody_place(chassis, at, facing)
    physics.rigidbody_set_velocity(chassis, going)
    dynamics.body_set_angular_velocity(chassis.body_id, core.vec3(0.0, 0.0, 0.0))
    // Rolling: still where it meets the ground.
    spin = core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), going), 1.0 / WHEEL_R)
    k = 0
    while k < physics.WHEEL_COUNT {
        wheel = physics.vehicle_wheel(v, k)
        dynamics.body_enable(wheel.body_id)
        physics.rigidbody_place(wheel, core.v3_add(at, core.quat_apply(facing, car_mount(k))), facing)
        physics.rigidbody_set_velocity(wheel, going)
        dynamics.body_set_angular_velocity(wheel.body_id, spin)
        k = k + 1
    }
}

// Where wheel `k` goes in the car's frame.
car_mount(k: int) -> Vec3 {
    across = AXLE_HALF
    if k % 2 == 0 { across = 0.0 - AXLE_HALF }
    along = AXLE_AHEAD
    if k < 2 { along = 0.0 - AXLE_AHEAD }
    return core.vec3(across, WHEEL_R - CAR_CLEAR - CAR_HALF_Y, along)
}

// The car out of the world, where it waits for its next crossing: left in
// it off the plaza, a body with mass would roll on or fall.
park(p: *Plaza) {
    v = p.vehicle as *Vehicle
    chassis = physics.vehicle_chassis(v)
    physics.rigidbody_place(chassis, car_parked(), car_facing(1.0))
    dynamics.body_disable(chassis.body_id)
    k = 0
    while k < physics.WHEEL_COUNT {
        wheel = physics.vehicle_wheel(v, k)
        physics.rigidbody_place(wheel, core.v3_add(car_parked(), core.quat_apply(car_facing(1.0), car_mount(k))), car_facing(1.0))
        dynamics.body_disable(wheel.body_id)
        k = k + 1
    }
}

// One step of driving: along its lane at CAR_SPEED, its nose on a point
// four metres down the lane, or, having struck someone, its wheels braked
// to a stop. Where it is and how fast, for the rest of the scene.
drive_car(p: *Plaza) {
    v = p.vehicle as *Vehicle
    chassis = physics.vehicle_chassis(v)
    at = dynamics.body_get_position(chassis.body_id)
    p.car_x = at.x
    p.car_z = at.z
    speed = physics.vehicle_speed(v)
    p.car_speed = core.abs_of(speed)
    forward = core.quat_apply(dynamics.body_get_rotation(chassis.body_id), core.vec3(0.0, 0.0, 0.0 - 1.0))
    aim = core.v3_normalize(core.vec3(p.car_way * 4.0, 0.0, lane_z(p.lane) - at.z))
    // The turn from its nose to the aim about up: positive is to its left.
    turn = core.atan2_of(core.v3_dot(core.v3_cross(forward, aim), core.vec3(0.0, 1.0, 0.0)), core.v3_dot(forward, aim))
    steer = core.clampf(1.5 * turn, 0.0 - 1.0, 1.0)
    if core.env_int("AE3D_CAR", 0) == 1 && (p.steps % 30) == 0 {
        println("car ${p.seconds}: lane ${p.lane} at ${at.x} ${at.y} ${at.z} (lane z ${lane_z(p.lane)}), ${speed} m/s, nose off the lane ${turn} rad, braking ${p.braking}, stood ${p.stopped_for} s")
    }
    if p.braking {
        physics.vehicle_drive(v, 0.0, steer, 1.0)
        return
    }
    throttle = 0.0
    if speed < CAR_SPEED - 0.5 { throttle = 0.8 } else if speed < CAR_SPEED { throttle = 0.3 }
    physics.vehicle_drive(v, throttle, steer, 0.0)
}

same_body(a: BodyId, b: BodyId) -> bool { return a.index1 == b.index1 && a.world0 == b.world0 && a.generation == b.generation }

// The blow on the body the car (or a thrown body) met, felt by its motion
// (its muscles' share): the contact has pushed it already.
feel(p: *Plaza, w: *Walker, body: BodyId, ev: ContactHitEvent) {
    m = w.body as *Motion
    if m == null { return }
    r = ragdoll_of(w)
    b = 0
    while b < physics.ragdoll_bone_count(r) {
        if same_body(human.bone_at(physics.ragdoll_human(r), b).body_id, body) {
            blow = core.v3_mul(core.vec3(p.car_way, 0.0, 0.0), ev.approach_speed * dynamics.body_get_mass(body))
            motion.hit(m, b, ev.point, blow, false)
        }
        b = b + 1
    }
}

// Struck: knocked down as test_knockdowns knocks one down, the full
// ragdoll. The character paused (it leaves its object, mover and capsule
// alone), its animator paused (it writes no joint), its physanim bodies let
// go (physanim.release) to ae3d.motion, LIMP, for the car to meet. Its
// capsule not solid while its body lies elsewhere: left where it was struck,
// it is a post nobody can see (physics.character_set_solid).
strike(p: *Plaza, e: *Engine, w: *Walker) {
    c = w.person as *Character
    pa = character.physanim_of(c)
    if pa == null || physanim.released(pa) { return }
    rag = physanim.ragdoll_of(pa)
    character.pause(c)
    animator.pause(character.animator_of(c))
    physanim.release(pa)
    m = motion.active_ragdoll(rag)
    if m == null { return }
    motion.attach(e, m)
    motion.set_mode(m, motion.LIMP)
    w.body = m as ptr
    physics.character_set_solid(physics.character_of(w.object as *GameObject), false)
    hit_events(rag, true)
    // Its stances end here, not measured: knocked down is not a step.
    held = w.held as int[]
    held[0] = 0
    held[1] = 0
    w.state = KNOCKED
    w.knocks = w.knocks + 1
    w.struck_at = p.seconds
    p.struck = p.struck + 1
}

// The way back: at rest on the ground (motion.down), up in one call
// (character.get_up, which lets the motion go); its get-up played to its
// end (character.acting); stood STAND_AFTER; then walking on.
recover(p: *Plaza, w: *Walker, step: float) {
    c = w.person as *Character
    if w.state == KNOCKED {
        m = w.body as *Motion
        if m != null && motion.down(m) && p.seconds - w.struck_at > DOWN_FIRST { get_up(p, w) }
        return
    }
    if w.state == RISING {
        // Lying on while it waits for room (a car over it, another
        // getting up in its way): counted, and its capsule made solid
        // and its get-up measured once it is on its way up.
        if character.get_up_waiting(c) {
            p.rise_waits = p.rise_waits + 1
            return
        }
        if !w.up_begun { up_begun(w) }
        if !character.acting(c) {
            w.state = RISEN
            w.standing = STAND_AFTER
        }
        return
    }
    character.move(c, core.vec3(0.0, 0.0, 0.0), core.vec3(0.0, 0.0, 0.0))
    w.standing = w.standing - step
    if w.standing > 0.0 { return }
    rise_measured(p, w)
    metrics.meter_moved(w.meter as *Meter)
    pick_goal(p, w)
    w.walked_at = p.seconds
    w.state = WALKING
    p.returned = p.returned + 1
    p.down_sum = p.down_sum + (p.seconds - w.struck_at)
}

// Told to get up once (character.get_up): it waits on its own while
// something stands where it would stand up (character.get_up_waiting).
get_up(p: *Plaza, w: *Walker) {
    c = w.person as *Character
    w.up_state = character.get_up(c, w.body as *Motion, BLEND)
    w.up_begun = false
    w.state = RISING
}

// Its get-up begun: the motion let go, its capsule solid, measured.
up_begun(w: *Walker) {
    c = w.person as *Character
    w.up_begun = true
    hit_events(ragdoll_of(w), false)
    w.body = null
    physics.character_set_solid(physics.character_of(w.object as *GameObject), true)
    a = character.animator_of(c)
    w.rise_own = 0.0
    state = animator.current(a)
    if state >= 0 && animator.state_take(a, state) != null { w.rise_own = metrics.take_fastest(animator.state_take(a, state), animator.rig(a)) }
    metrics.meter_reset(w.rise as *Meter)
    metrics.meter_moved(w.rise as *Meter)
}

// A get-up's fastest joint against its take's own, kept at the worst.
rise_measured(p: *Plaza, w: *Walker) {
    over = metrics.meter_worst(w.rise as *Meter, metrics.POP) - w.rise_own
    if over > p.rise_pop {
        p.rise_pop = over
        p.rise_pop_k = p.returned
    }
}

// The car near and crossing, a walker watches it; else its eyes ahead.
watch_car(p: *Plaza, w: *Walker, at: Vec3) {
    c = w.person as *Character
    car = core.vec3(p.car_x, 1.0, p.car_z)
    near = core.v3_len(core.vec3(car.x - at.x, 0.0, car.z - at.z))
    if p.car_way != 0.0 && near < LOOK_CAR {
        character.look(c, car)
        p.looking = p.looking + 1
    } else {
        character.look_ahead(c)
    }
}

// A walking walker's toes over the ground this step, `step` seconds on:
// the way each on the ground went since the last, if it was on it then.
skating(p: *Plaza, w: *Walker, step: float) {
    last = w.toe_last as float[]
    p.walking = p.walking + step
    k = 0
    while k < 2 {
        at, high = sole(p, w, k)
        if w.toe_seen && high < metrics.CONTACT && last[k * 3 + 1] < metrics.CONTACT {
            went = core.v3_len(core.vec3(at.x - last[k * 3], 0.0, at.z - last[k * 3 + 2]))
            p.skate = p.skate + went
            if went / step > SKATE_SPEED { p.skate_fast = p.skate_fast + step }
        }
        last[k * 3] = at.x
        last[k * 3 + 1] = high
        last[k * 3 + 2] = at.z
        k = k + 1
    }
    w.toe_seen = true
}

// Foot `k`'s toe tip as drawn, and how high its pad is over the ground under
// it: ikrig's soles, as ae3d.metrics reads them.
sole(p: *Plaza, w: *Walker, k: int) -> (Vec3, float) {
    a = character.animator_of(w.person as *Character)
    f = animator.feet(a)
    r = animator.rig(a)
    _heel, pad, _toe = ikrig.feet_soles(f, r, w.worlds, k)
    tip = ikrig.toe_tip(f, r, w.worlds, k)
    ground = physics.ground_below(physics.of(p.engine as *Engine), pad, 0.6, 1.6, ikrig.STAND_UP)
    if !ground.hit { return tip, pad.y }
    return tip, pad.y - ground.point.y
}

camera(p: *Plaza, e: *Engine) {
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < p.count {
        w = (p.walkers as ptr[])[watch] as *Walker
        at = behaviour.object_world_position(w.object as *GameObject)
        core.camera_set_position(cam, core.vec3(at.x + 3.0, at.y + 1.3, at.z + 0.8))
        core.camera_look_at(cam, core.vec3(at.x, at.y + 0.7, at.z))
        return
    }
    core.camera_set_position(cam, core.vec3(0.0, 11.0, 16.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0 - 1.0))
}

// The toes' way over the ground, metres a walker-second walking.
skate_rate(p: *Plaza) -> float {
    if p.walking <= 0.0 { return 0.0 }
    return p.skate / p.walking
}

down_mean(p: *Plaza) -> float {
    if p.returned == 0 { return 0.0 }
    return p.down_sum / (p.returned as float)
}

// The people struck and not up yet: down, getting up or standing.
not_up(p: *Plaza) -> int {
    ws = p.walkers as ptr[]
    n = 0
    i = 0
    while i < p.count {
        if (ws[i] as *Walker).state != WALKING { n = n + 1 }
        i = i + 1
    }
    return n
}

knocked_report(p: *Plaza) {
    ws = p.walkers as ptr[]
    j = 0
    while j < p.count {
        w = ws[j] as *Walker
        m = w.body as *Motion
        if w.state != WALKING {
            pel = behaviour.object_position(physics.ragdoll_bone(ragdoll_of(w), human.BONE_PELVIS))
            if m != null {
                println("knocked ${j} since ${p.seconds - w.struck_at} state ${w.state} fall ${motion.falling(m)} lying ${motion.lying(m)} down ${motion.down(m)} pelvis ${pel.y}")
            } else {
                println("knocked ${j} since ${p.seconds - w.struck_at} state ${w.state} acting ${character.acting(w.person as *Character)} pelvis ${pel.y}")
            }
        }
        j = j + 1
    }
}

report(p: *Plaza) {
    if core.env_int("AE3D_KNOCKED", 0) == 1 { knocked_report(p) }
    mean = 0.0
    ankle = 0.0
    if p.stances > 0 {
        mean = p.slid_sum / (p.stances as float)
        ankle = p.ankle_sum / (p.stances as float)
    }
    frame = 0.0
    if p.frames > 0 { frame = (p.frame_ns as float) / (p.frames as float) / 1000000.0 }
    println("plaza ${p.seconds as int} s: ${p.count} walkers; ${p.stances} stances, a toe slid ${mean * 100.0} cm on average, ${p.worst * 100.0} at most, over ${SLID * 100.0} cm in ${p.over}; the ankle ${ankle * 100.0} cm on average; frame ${frame} ms on average, ${(p.worst_frame_ns as float) / 1000000.0} at most; the car struck ${p.struck}, ${p.returned} walking again, ${down_mean(p)} s from struck to walking on average, ${not_up(p)} not up yet; ${p.looking} watching the car; the bodies put on in ${p.build_ms} ms; heads spinning ${p.spin_seconds} s; bodies walked through ${p.trodden_seconds} s (${p.trodden_lying} s lying still); ${p.seconds_struck} struck by a thrown body; thrown bodies through walkers ${p.through_seconds} s")
    println("plaza scorecard ${p.seconds as int} s: knees backwards ${p.back_knee} s (${p.back_knee_down} s struck), legs splayed ${p.splayed} s (${p.splayed_down} s struck), figures inside each other ${p.overlap} s (${p.overlap_down} s with one struck), sunk in the ground ${p.sunk} s (${p.sunk_down} s struck), in the car ${p.in_car} s, heads spinning ${p.spin_seconds} s, bodies walked through ${p.trodden_seconds} s, toes skating ${skate_rate(p) * 100.0} cm a walker-second (${p.skate_fast} s faster than ${SKATE_SPEED} m/s)")
    meters_report(p)
    println("plaza thrown up ${p.seconds as int} s: the car ${p.car_rise} m over its ride height at most, up at ${p.car_up} m/s at most (it comes at ${CAR_SPEED}); a person's body up at ${p.body_up} m/s at most, ${p.body_high} m high; get-ups waited ${(p.rise_waits as float) / 60.0} s for the car over them")
}

// ae3d.metrics' measures, walking, the worst over the people (as
// people_plaza reports them), and the get-ups' fastest joint against their
// own takes'.
meters_report(p: *Plaza) {
    ws = p.walkers as ptr[]
    skate = 0.0
    sunk = 0.0
    cross = 0.0 - 1000.0
    pop = 0.0
    thrown = 0.0
    own = 0.0
    k = 0
    while k < p.count {
        w = ws[k] as *Walker
        m = w.meter as *Meter
        if metrics.meter_worst(m, metrics.SKATE) > skate { skate = metrics.meter_worst(m, metrics.SKATE) }
        if metrics.meter_worst(m, metrics.INTO_GROUND) > sunk { sunk = metrics.meter_worst(m, metrics.INTO_GROUND) }
        if metrics.meter_worst(m, metrics.FEET_CROSS) > cross { cross = metrics.meter_worst(m, metrics.FEET_CROSS) }
        if metrics.meter_worst(m, metrics.POP) > pop { pop = metrics.meter_worst(m, metrics.POP) }
        if metrics.meter_worst(m, metrics.FOOT_THROW) > thrown { thrown = metrics.meter_worst(m, metrics.FOOT_THROW) }
        f = metrics.animator_fastest(character.animator_of(w.person as *Character))
        if f > own { own = f }
        // AE3D_EACH=1: each person's worst, and when on its meter's clock
        // (seconds walking, from METER_FROM), with the times it was struck.
        if core.env_int("AE3D_EACH", 0) == 1 { println("  person ${k} (struck ${w.knocks}): skate ${metrics.meter_worst(m, metrics.SKATE) * 1000.0} mm at ${metrics.meter_when(m, metrics.SKATE)} s, cross ${metrics.meter_worst(m, metrics.FEET_CROSS) * 1000.0} mm at ${metrics.meter_when(m, metrics.FEET_CROSS)} s, pop ${metrics.meter_worst(m, metrics.POP)} (${pose.name(animator.rig(character.animator_of(w.person as *Character)), metrics.meter_joint(m, metrics.POP))}) at ${metrics.meter_when(m, metrics.POP)} s, thrown ${metrics.meter_worst(m, metrics.FOOT_THROW)} at ${metrics.meter_when(m, metrics.FOOT_THROW)} s") }
        k = k + 1
    }
    println("plaza meters ${p.seconds as int} s: walking, a toe skating ${skate * 1000.0} mm at worst, a sole ${sunk * 1000.0} mm into the ground, a foot ${cross * 1000.0} mm past the hips' middle (below 0, never); the fastest joint ${pop} rad/s, the takes' own ${own}; a toe thrown ${thrown} m/s faster than its clip has it; getting up, a joint ${p.rise_pop} rad/s past its get-up's own fastest at worst (get-up ${p.rise_pop_k})")
}

new_walker() -> *Walker {
    w = calloc(1, sizeof(Walker)) as *Walker
    w.hinges = calloc(6, 8)
    w.reach = calloc(18, 8)
    w.held = calloc(2, 4)
    w.from = calloc(6, 8)
    w.most = calloc(2, 8)
    w.ankle_z = calloc(2, 8)
    w.ankle_most = calloc(2, 8)
    w.turned = calloc(2, 8)
    w.low = calloc(2, 8)
    w.toe_last = calloc(6, 8)
    return w
}

walker_free(w: *Walker) {
    if w.body != null { motion.release(w.body as *Motion) }
    if w.person != null { character.character_free(w.person as *Character) }
    if w.meter != null { metrics.meter_free(w.meter as *Meter) }
    if w.rise != null { metrics.meter_free(w.rise as *Meter) }
    if w.drawn != null { pose.release(w.drawn) }
    if w.worlds != null { pose.release(w.worlds) }
    if w.thick != null { free(w.thick) }
    if w.marks != null { free(w.marks) }
    free(w.hinges)
    free(w.reach)
    free(w.held)
    free(w.from)
    free(w.most)
    free(w.ankle_z)
    free(w.ankle_most)
    free(w.turned)
    free(w.low)
    free(w.toe_last)
    free(w as ptr)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - plaza showcase")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    count = core.env_int("AE3D_FIGURES", 24)
    if count < 1 { count = 1 }
    block_ws = calloc(count, 8)
    ws = block_ws as ptr[]
    i = 0
    while i < count {
        ws[i] = new_walker() as ptr
        i = i + 1
    }
    p = calloc(1, sizeof(Plaza)) as *Plaza
    p.walkers = block_ws
    p.count = count
    p.car_wait = 2.0
    p.next_report = REPORT
    p.debug = core.env_int("AE3D_DEBUG", 0) == 1
    b = engine.behaviour_new("plaza", p as ptr)
    b.start = start
    b.update = update
    b.fixed_update = fixed
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(p)
    i = 0
    while i < count {
        walker_free(ws[i] as *Walker)
        i = i + 1
    }
    free(block_ws)
    if p.gaits != null { character.gaits_free(p.gaits as *Gaits) }
    if p.vehicle != null { physics.vehicle_free(p.vehicle as *Vehicle) }
    if p.wheels != null { free(p.wheels) }
    if p.blocks != null { free(p.blocks) }
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    free(p as ptr)
}
