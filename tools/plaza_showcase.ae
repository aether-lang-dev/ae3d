// The plaza showcase (#509, part of): a crowd of box men wandering a plaza
// with a ramp, steps and a kerb -- locomotion, its foot hold, the legs solved
// onto the ground (ae3d.feet) and stepping aside for each other (ae3d.avoid)
// -- for a person or the agent loop to watch, and measured as it runs. Not a
// test and not an example: ci.sh never builds it.
//
//   ./build.sh tools/plaza_showcase.ae && ./build/plaza_showcase
//   AE3D_FIGURES=n (24)   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png (unattended)
//   AE3D_WATCH=k (close on figure k, from its right)
//   AE3D_STANCES=1 (every stance's slide, as it ends; 3, those over 1 cm)   AE3D_FLAT=1 (feet on a
//   flat floor, not the physics ground)   AE3D_TICK=60 (a frame a step)
//
// Each figure walks to a place on the plaza, and on getting there picks
// another, some at a run. Every CAR_EVERY seconds a car crosses on a lane
// through the crowd: a walker it reaches is handed to an active ragdoll
// (ae3d.motion), POWERED and struck at the hips the way the car goes --
// locomotion paused, ae3d.feet eased out -- falls, gets up, and once up and
// strong is handed back where its body stands and faces, stands while its
// feet come back to the ground, and walks on; its ragdoll is parked. Measured, every few seconds and at the end: the
// stances its feet took -- a foot held on the ground by ae3d.feet, from set
// down to lifted -- and how far the toe slid over the ground in each, which
// #509 holds under 1 cm; and the frame's time. The feet are read after the
// frame is drawn (late_update), as drawn: read in update, before the pose
// phase, they were the clip's, not where ae3d.feet put them.
//
// On an RTX 4070 Ti (Vulkan, vsync at 144 Hz), the car crossing:
//
//   walkers   seconds   stances   slide, mean   at most   over 1 cm    struck, walking again   frame (worst)
//   1         15        32        0.37 cm       0.52      0            -                       7.0 ms
//   24        29        1,370     0.23 cm       10.8      61 (4%)      18, 17 (4.6 s down)     7.0 ms
//   200       15        6,302     0.44 cm       35.8      600 (10%)    90, 52 (4.5 s down)     7.2 ms (65)
//
// (One walker stepped a frame a step, AE3D_TICK=60: 0.006 cm.) The stances
// over 1 cm come with the crowd: figures stepping aside for each other and
// turning to new goals. The worst frames are strikes: a walker's active
// ragdoll is built the first time it is struck.
import std.list
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.locomotion
import ae3d.feet
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern clock_ns() -> long

const PATH = "tests/fixtures/gltf/humanoid.glb"
const HALF = 9.0                     // the plaza is 18 m square
const ARRIVED = 0.8                  // metres from its goal a figure picks another
const REPORT = 5.0                   // seconds between reports
const SLID = 0.01                    // #509's bound on a stance's slide, metres
// The car: a box 4 by 1.8 m, crossing the plaza along x at CAR_SPEED, one
// way then the other, every CAR_EVERY seconds; a walker it reaches is struck
// at the hips, CAR_BLOW N s for every metre a second of its speed.
const CAR_SPEED = 7.0
const CAR_EVERY = 6.0
const CAR_BLOW = 45.0
const CAR_HALF_X = 2.0
const CAR_HALF_Z = 0.9
const SETTLE = 0.8                   // seconds up and strong before it walks on
const STAND_AFTER = 0.4              // seconds it stands, handed back, before walking on
const WALKING = 0
const KNOCKED = 1
const RETURNING = 2

struct Walker {
    object: ptr                      // *GameObject
    loco: ptr                        // *Locomotion
    feet: ptr                        // *Feet
    controller: ptr                  // *CharacterController
    toes: ptr                        // *Model[2], left and right
    goal: Vec3
    running: bool
    seed: int
    held: ptr                        // int[2]: the foot held last frame
    from: ptr                        // float[6]: where each toe was when its foot was set down
    most: ptr                        // float[2]: the farthest each toe has slid in this stance
    ankle_z: ptr                     // float[2]
    ankle_most: ptr                  // float[2]: the same for the ankle
    body: ptr                        // *Motion, once it has been struck
    rest: ptr                        // its figure's pose as loaded (figure.keep_pose)
    state: int
    up_seconds: float
    struck_at: float
    standing: float                  // seconds to stand before walking on, handed back
    turned: ptr                      // float[2]: the heading when each foot was set down
}

struct Plaza {
    walkers: ptr                     // *Walker[count]
    count: int
    crowd: ptr                       // list of *Locomotion
    seconds: float
    next_report: float
    stances: int
    over: int                        // stances that slid more than SLID
    slid_sum: float
    worst: float
    frame_ns: long
    frames: int
    worst_frame_ns: long
    last_ns: long
    ankle_sum: float
    car: ptr                         // *GameObject
    car_x: float
    car_way: float                   // +1 or -1 while crossing, 0 waiting
    car_z: float
    car_wait: float
    lane: int
    struck: int
    returned: int
    down_sum: float
    scratch: ptr                     // two poses, physics.POSE_STRIDE floats a bone
}

// A number from a seed, the next seed with it: the same plaza every run.
next_seed(seed: int) -> int { return (seed * 1103515245 + 12345) % 2147483647 }
unit_of(seed: int) -> float {
    s = seed
    if s < 0 { s = 0 - s }
    return ((s % 10000) as float) / 10000.0
}

pick_goal(w: *Walker) {
    w.seed = next_seed(w.seed)
    x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
    w.seed = next_seed(w.seed)
    z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
    w.goal = core.vec3(x, 0.0, z)
    w.seed = next_seed(w.seed)
    w.running = unit_of(w.seed) < 0.25
}

block(e: *Engine, name: string, at: Vec3, half: Vec3, turn: Quat) {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, turn)
    behaviour.object_set_scale(o, core.v3_mul(half, 2.0))
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

bone(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

start(state: ptr, e: *Engine) {
    p = state as *Plaza
    physics.attach(e)
    level = core.quat_rotate(0.0, core.vec3(0.0, 1.0, 0.0))
    block(e, "Ground", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(HALF + 2.0, 0.5, HALF + 2.0), level)
    // A ramp up to a 0.6 m deck in the far corner, three 0.15 m steps down
    // from its side, and a kerb across the near half.
    block(e, "Deck", core.vec3(6.0, 0.3, 0.0 - 6.0), core.vec3(2.0, 0.3, 2.0), level)
    block(e, "Ramp", core.vec3(6.0, 0.15, 0.0 - 2.4), core.vec3(1.5, 0.05, 1.8), core.quat_rotate(0.0 - 0.17, core.vec3(1.0, 0.0, 0.0)))
    k = 0
    while k < 3 {
        h = 0.15 * ((k + 1) as float)
        block(e, "Step", core.vec3(2.9 + 0.35 * ((2 - k) as float), h * 0.5, 0.0 - 6.0), core.vec3(0.175, h * 0.5, 1.5), level)
        k = k + 1
    }
    block(e, "Kerb", core.vec3(0.0 - 3.0, 0.075, 3.0), core.vec3(4.0, 0.075, 0.2), level)
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(CAR_HALF_X * 2.0, 1.4, CAR_HALF_Z * 2.0))
    behaviour.object_set_position(car, core.vec3(0.0 - HALF - 30.0, 0.7, 0.0))
    p.car = car as ptr

    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        o = figure.figure(e, "Walker", PATH)
        if o == null {
            println("plaza_showcase: ${PATH} would not load")
            return
        }
        w.seed = 7919 * (i + 1)
        w.seed = next_seed(w.seed)
        x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        w.seed = next_seed(w.seed)
        z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        behaviour.object_set_position(o, core.vec3(x, 0.0, z))
        c = physics.character_controller(o, 0.3, 1.8)
        l = locomotion.attach(e, o, c, "Idle", "Walk", "Run")
        locomotion.set_crowd(l, p.crowd)
        list.add_raw(p.crowd, l as ptr)
        sk = figure.skeleton(figure.figure_of(o))
        w.rest = figure.keep_pose(figure.figure_of(o))
        f = feet.attach(e, o.model as *Model, bone(sk, "mixamorig:Hips"),
                        bone(sk, "mixamorig:LeftUpLeg"), bone(sk, "mixamorig:LeftLeg"), bone(sk, "mixamorig:LeftFoot"),
                        bone(sk, "mixamorig:RightUpLeg"), bone(sk, "mixamorig:RightLeg"), bone(sk, "mixamorig:RightFoot"))
        if core.env_int("AE3D_FLAT", 0) == 0 { feet.ground_physics(f, physics.of(e)) }
        toes = w.toes as ptr[]
        toes[0] = bone(sk, "mixamorig:LeftToeBase") as ptr
        toes[1] = bone(sk, "mixamorig:RightToeBase") as ptr
        w.object = o as ptr
        w.loco = l as ptr
        w.feet = f as ptr
        w.controller = c as ptr
        pick_goal(w)
        i = i + 1
    }
    p.next_report = REPORT
}

// A frame of a walker's feet: each stance's slide, from the toe's place
// when the foot was set down to where it is now, over the ground.
watch_feet(p: *Plaza, w: *Walker) {
    f = w.feet as *Feet
    toes = w.toes as ptr[]
    held = w.held as int[]
    from = w.from as float[]
    most = w.most as float[]
    ankle_z = w.ankle_z as float[]
    ankle_most = w.ankle_most as float[]
    turned = w.turned as float[]
    k = 0
    while k < 2 {
        toe = toes[k] as *Model
        core.model_sync_transform(toe)
        at = toe.world_position
        down = feet.leg_locked(f, k)
        if down && held[k] == 0 {
            turned[k] = locomotion.heading(w.loco as *Locomotion)
            from[k * 3] = at.x
            from[k * 3 + 2] = at.z
            most[k] = 0.0
        }
        an = feet.leg_ankle(f, k)
        core.model_sync_transform(an)
        if down && held[k] == 0 {
            from[k * 3 + 1] = an.world_position.x
            ankle_z[k] = an.world_position.z
            ankle_most[k] = 0.0
        }
        if down {
            d = core.v3_len(core.vec3(at.x - from[k * 3], 0.0, at.z - from[k * 3 + 2]))
            if d > most[k] { most[k] = d }
            da = core.v3_len(core.vec3(an.world_position.x - from[k * 3 + 1], 0.0, an.world_position.z - ankle_z[k]))
            if da > ankle_most[k] { ankle_most[k] = da }
        }
        if !down && held[k] == 1 {
            if core.env_int("AE3D_STANCES", 0) == 3 && most[k] > SLID {
                println("over: struck before ${w.body != null}, toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm, t ${p.seconds}")
            }
            if core.env_int("AE3D_STANCES", 0) == 1 {
                println("stance ${k}: toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm; turned ${(locomotion.heading(w.loco as *Locomotion) - turned[k]) * 57.3} deg; speed ${locomotion.speed(w.loco as *Locomotion)}")
            }
            p.stances = p.stances + 1
            p.slid_sum = p.slid_sum + most[k]
            if most[k] > p.worst { p.worst = most[k] }
            if most[k] > SLID { p.over = p.over + 1 }
            p.ankle_sum = p.ankle_sum + ankle_most[k]
        }
        held[k] = 0
        if down { held[k] = 1 }
        k = k + 1
    }
}

update(state: ptr, e: *Engine, delta: float) {
    p = state as *Plaza
    started = clock_ns()
    p.seconds = p.seconds + delta
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        o = w.object as *GameObject
        if o != null && w.state == WALKING {
            at = behaviour.object_world_position(o)
            to = core.vec3(w.goal.x - at.x, 0.0, w.goal.z - at.z)
            if core.v3_len(to) < ARRIVED { pick_goal(w) }
            way = core.v3_normalize(to)
            // Up again, it stands while its feet come back to the ground:
            // walked on at once, with ae3d.feet still easing in, a held foot
            // only partly kept its turn and swung round with the body,
            // its toe 30 cm over the ground.
            if w.standing > 0.0 {
                w.standing = w.standing - delta
                way = core.vec3(0.0, 0.0, 0.0)
            }
            locomotion.set_input(w.loco as *Locomotion, way, w.running)
        }
        i = i + 1
    }
    // The frame's time: from the last frame's update to this one's.
    if p.last_ns > 0 && p.seconds > 1.0 {
        took = started - p.last_ns
        p.frame_ns = p.frame_ns + took
        if took > p.worst_frame_ns { p.worst_frame_ns = took }
        p.frames = p.frames + 1
    }
    p.last_ns = started
    if p.seconds >= p.next_report {
        report(p)
        p.next_report = p.next_report + REPORT
    }
    camera(p, e)
}

// The car's crossings and strikes, and the struck walkers' way back: on the
// fixed step, after the physics and the motions.
fixed(state: ptr, e: *Engine, step: float) {
    p = state as *Plaza
    drive(p, e, step)
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state != WALKING { recover(p, w, step) }
        i = i + 1
    }
}

drive(p: *Plaza, e: *Engine, step: float) {
    car = p.car as *GameObject
    if car == null { return }
    if p.car_way == 0.0 {
        p.car_wait = p.car_wait - step
        if p.car_wait > 0.0 { return }
        // Across the plaza along a lane through the crowd, each crossing the
        // other way and on another lane.
        p.lane = p.lane + 1
        p.car_way = 1.0
        if p.lane % 2 == 0 { p.car_way = 0.0 - 1.0 }
        p.car_x = (0.0 - p.car_way) * (HALF + 4.0)
        p.car_z = (((p.lane % 5) as float) - 2.0) * 2.5
    }
    p.car_x = p.car_x + p.car_way * CAR_SPEED * step
    behaviour.object_set_position(car, core.vec3(p.car_x, 0.7, p.car_z))
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == WALKING {
            at = behaviour.object_world_position(w.object as *GameObject)
            if core.abs_of(at.x - p.car_x) < CAR_HALF_X + 0.3 && core.abs_of(at.z - p.car_z) < CAR_HALF_Z + 0.3 { strike(p, e, w) }
        }
        i = i + 1
    }
    if core.abs_of(p.car_x) > HALF + 4.0 && p.car_x * p.car_way > 0.0 {
        p.car_way = 0.0
        p.car_wait = CAR_EVERY
        behaviour.object_set_position(car, core.vec3(0.0 - HALF - 30.0, 0.7, 0.0))
    }
}

// Struck: locomotion and the feet let it go, and the figure is an active
// ragdoll's, POWERED and hit at the hips the way the car goes.
strike(p: *Plaza, e: *Engine, w: *Walker) {
    o = w.object as *GameObject
    m = w.body as *Motion
    if m == null {
        m = motion.on_figure(e, o)
        if m == null { return }
        w.body = m as ptr
    } else {
        physics.ragdoll_unpark(m.ragdoll)
        physics.ragdoll_to_rig(m.ragdoll)
    }
    locomotion.set_paused(w.loco as *Locomotion, true)
    feet.set_weight(w.feet as *Feet, 0.0)
    motion.set_mode(m, motion.POWERED)
    motion.set_get_up(m, 1.0)
    pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
    motion.hit(m, human.BONE_PELVIS, pelvis, core.vec3(p.car_way * CAR_SPEED * CAR_BLOW, CAR_BLOW * 1.5, 0.0))
    // Its stances end here, not measured: knocked down is not a step.
    held = w.held as int[]
    held[0] = 0
    held[1] = 0
    w.state = KNOCKED
    w.up_seconds = 0.0
    w.struck_at = p.seconds
    p.struck = p.struck + 1
}

// Up again and strong for SETTLE seconds, the walker is moved to where its
// body stands and faces, and the ragdoll blends back into the clip; blended,
// the ragdoll is parked and locomotion and the feet take it up again.
recover(p: *Plaza, w: *Walker, step: float) {
    m = w.body as *Motion
    if w.state == KNOCKED {
        up = motion.mode(m) == motion.POWERED && !motion.falling(m) && !motion.lying(m) && !motion.down(m) &&
             !motion.getting_up(m) && motion.tilt(m) < 0.2 && strong(m)
        if up { w.up_seconds = w.up_seconds + step } else { w.up_seconds = 0.0 }
        if w.up_seconds >= SETTLE {
            to_body(p, w)
            motion.set_mode(m, motion.ANIMATED)
            w.state = RETURNING
        }
        return
    }
    if !motion.blending(m) {
        physics.ragdoll_park(m.ragdoll)
        // Its pose as loaded under the clip again: a bone the clip does
        // not key (the box man's toes) keeps what the ragdoll left it, and
        // its toe swept the ground walking on, 34 cm in a stance.
        fig = figure.figure_of(w.object as *GameObject)
        time = figure.time(fig)
        figure.put_pose(fig, w.rest)
        figure.set_time(fig, time)
        locomotion.set_paused(w.loco as *Locomotion, false)
        feet.set_weight(w.feet as *Feet, 1.0)
        pick_goal(w)
        w.standing = STAND_AFTER
        w.state = WALKING
        p.returned = p.returned + 1
        p.down_sum = p.down_sum + (p.seconds - w.struck_at)
    }
}

strong(m: *Motion) -> bool {
    i = 0
    while i < human.BONE_COUNT {
        if motion.bone_weakness(m, i) > 0.05 { return false }
        i = i + 1
    }
    return true
}

// The walker's object turned about the animation's pelvis by the angle
// between the ways the body and the animation face, and carried by how far
// apart their pelvises are over the ground, as ae3d.handover moves a rig
// back: its clip then stands where its body does, and locomotion is placed
// there.
to_body(p: *Plaza, w: *Walker) {
    m = w.body as *Motion
    r = m.ragdoll
    stride = human.BONE_COUNT * physics.POSE_STRIDE
    bodies = p.scratch
    animated = p.scratch + stride * 8
    physics.ragdoll_body_pose(r, bodies)
    physics.ragdoll_animation_pose(r, animated)
    b = bodies as float[]
    a = animated as float[]
    at = human.BONE_PELVIS * physics.POSE_STRIDE
    rest = human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q
    forward = physics.ragdoll_rest_forward(r)
    body_front = flat(core.quat_apply(core.quat_mul(core.quat(b[at], b[at + 1], b[at + 2], b[at + 3]), core.quat_conjugate(rest)), forward))
    anim_front = flat(core.quat_apply(core.quat_mul(core.quat(a[at], a[at + 1], a[at + 2], a[at + 3]), core.quat_conjugate(rest)), forward))
    angle = 0.0
    if core.v3_len(body_front) > 0.5 && core.v3_len(anim_front) > 0.5 {
        angle = core.atan2_of(body_front.x, body_front.z) - core.atan2_of(anim_front.x, anim_front.z)
    }
    o = w.object as *GameObject
    pivot = core.vec3(a[at + 4], 0.0, a[at + 6])
    now = behaviour.object_world_position(o)
    turn = core.quat_rotate(angle, core.vec3(0.0, 1.0, 0.0))
    off = core.quat_apply(turn, core.vec3(now.x - pivot.x, 0.0, now.z - pivot.z))
    to = core.vec3(pivot.x + off.x + b[at + 4] - a[at + 4], now.y, pivot.z + off.z + b[at + 6] - a[at + 6])
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    yaw = core.atan2_of(ahead.x, ahead.z) + angle
    locomotion.place(w.loco as *Locomotion, to, yaw)
}

flat(v: Vec3) -> Vec3 {
    f = core.vec3(v.x, 0.0, v.z)
    if core.v3_len(f) < 0.000001 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(f)
}

// After the frame is drawn: the feet as they were drawn, the legs solved.
late(state: ptr, e: *Engine, delta: float) {
    p = state as *Plaza
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.object != null && w.state == WALKING { watch_feet(p, w) }
        i = i + 1
    }
}

camera(p: *Plaza, e: *Engine) {
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < p.count {
        w = (p.walkers as ptr[])[watch] as *Walker
        at = behaviour.object_world_position(w.object as *GameObject)
        core.camera_set_position(cam, core.vec3(at.x + 3.0, at.y + 1.3, at.z + 0.8))
        core.camera_look_at(cam, core.vec3(at.x, at.y + 0.7, at.z))
        return
    }
    core.camera_set_position(cam, core.vec3(0.0, 11.0, 16.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0 - 1.0))
}

down_mean(p: *Plaza) -> float {
    if p.returned == 0 { return 0.0 }
    return p.down_sum / (p.returned as float)
}

report(p: *Plaza) {
    mean = 0.0
    if p.stances > 0 { mean = p.slid_sum / (p.stances as float) }
    frame = 0.0
    if p.frames > 0 { frame = (p.frame_ns as float) / (p.frames as float) / 1000000.0 }
    println("plaza ${p.seconds as int} s: ${p.count} walkers; ${p.stances} stances, a toe slid ${mean * 100.0} cm on average, ${p.worst * 100.0} at most, over ${SLID * 100.0} cm in ${p.over}; the ankle ${p.ankle_sum / (p.stances as float) * 100.0} cm on average; frame ${frame} ms on average, ${(p.worst_frame_ns as float) / 1000000.0} at most; the car struck ${p.struck}, ${p.returned} walking again, ${down_mean(p)} s from struck to walking on average")
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - plaza showcase")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    count = core.env_int("AE3D_FIGURES", 24)
    block_ws = calloc(count, 8)
    ws = block_ws as ptr[]
    i = 0
    while i < count {
        w = calloc(1, sizeof(Walker)) as *Walker
        w.toes = calloc(2, 8)
        w.held = calloc(2, 4)
        w.from = calloc(6, 8)
        w.most = calloc(2, 8)
        w.ankle_z = calloc(2, 8)
        w.ankle_most = calloc(2, 8)
        w.turned = calloc(2, 8)
        ws[i] = w as ptr
        i = i + 1
    }
    p = Plaza { walkers: block_ws, count: count, crowd: list.new(), seconds: 0.0, next_report: REPORT, stances: 0, over: 0,
                slid_sum: 0.0, worst: 0.0, frame_ns: 0 as long, frames: 0, worst_frame_ns: 0 as long, last_ns: 0 as long, ankle_sum: 0.0, car: null, car_x: 0.0, car_way: 0.0, car_z: 0.0, car_wait: 2.0,
                lane: 0, struck: 0, returned: 0, down_sum: 0.0, scratch: calloc(human.BONE_COUNT * physics.POSE_STRIDE * 2, 8) }
    b = engine.behaviour_new("plaza", (&p) as ptr)
    b.start = start
    b.update = update
    b.late_update = late
    b.fixed_update = fixed
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(&p)
    motion.motions_free(e)
    i = 0
    while i < count {
        w = ws[i] as *Walker
        if w.feet != null { feet.feet_free(w.feet as *Feet) }
        if w.loco != null { locomotion.locomotion_free(w.loco as *Locomotion) }
        if w.controller != null { physics.character_free(w.controller as *CharacterController) }
        free(w.toes)
        figure.pose_free(w.rest)
        free(w.held)
        free(w.from)
        free(w.most)
        free(w.ankle_z)
        free(w.ankle_most)
        free(w.turned)
        free(w as ptr)
        i = i + 1
    }
    free(block_ws)
    list.free(p.crowd)
    free(p.scratch)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
}
