// The plaza showcase (#509, part of): a crowd of box men wandering a plaza
// with a ramp, steps and a kerb -- locomotion, its foot hold, the legs solved
// onto the ground (ae3d.feet) and stepping aside for each other (ae3d.avoid)
// -- for a person or the agent loop to watch, and measured as it runs. Not a
// test and not an example: ci.sh never builds it.
//
//   ./build.sh tools/plaza_showcase.ae && ./build/plaza_showcase
//   AE3D_FIGURES=n (24)   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png (unattended)
//   AE3D_WATCH=k (close on figure k, from its right)
//   AE3D_STANCES=1 (every stance's slide, as it ends; 3, those over 1 cm)   AE3D_FLAT=1 (feet on a
//   flat floor, not the physics ground)   AE3D_TICK=60 (a frame a step)
//   AE3D_MATCHING=1 (posed by motion matching, a database a walker)
//   AE3D_KNOCKED=1 (each report, every struck walker not walking yet: its state)
//   F1, or AE3D_DEBUG=1 from the start: what each walker's motion is made of
//   drawn over it -- each foot's target (ae3d.feet), green while it is held
//   and red while it swings, and where its body will be a second on
//   (locomotion's velocity), a blue marker
//
// Each figure walks to a place on the plaza, and on getting there picks
// another, some at a run. Every CAR_EVERY seconds a car crosses on a lane
// through the crowd, a kinematic body: a walker it is about to reach is
// handed to an active ragdoll (ae3d.motion), POWERED -- locomotion paused,
// ae3d.feet eased out, its look let go -- the car meets its bodies and it
// feels the blow where they met, falls, gets up, and once up and
// strong is handed back where its body stands and faces, stands while its
// feet come back to the ground, and walks on; its ragdoll is parked. Every
// walker's ragdoll is built at the start and parked: built at the first
// strike, the strike's frame took 65 ms with 200 walkers. A walker within
// LOOK_CAR of the car as it crosses turns its head to it (ae3d.lookat). Measured, every few seconds and at the end: the
// stances its feet took -- a foot held on the ground by ae3d.feet, from set
// down to lifted -- and how far the toe slid over the ground in each, which
// #509 holds under 1 cm; and the frame's time. The feet are read after the
// frame is drawn (late_update), as drawn: read in update, before the pose
// phase, they were the clip's, not where ae3d.feet put them.
//
// On an RTX 4070 Ti (Vulkan, vsync at 144 Hz), the car crossing:
//
//   walkers   seconds   stances   slide, mean   at most   over 1 cm    struck, walking again   frame (worst)
//   1         15        32        0.37 cm       0.52      0            -                       7.0 ms
//   24        29        1,370     0.23 cm       10.8      61 (4%)      18, 17 (4.6 s down)     7.0 ms
//   200       15        6,167     0.44 cm       16.7      594 (10%)    82, 44 (5.4 s down)     6.9 ms (23.6)
//
// (One walker stepped a frame a step, AE3D_TICK=60: 0.006 cm.) The stances
// over 1 cm come with the crowd: figures stepping aside for each other and
// turning to new goals. Building the 200 ragdolls takes 2.9 s at the start.
// Posed by motion matching (24 walkers): 0.64 cm a stance, 34.7 at most, the
// toe sliding more than the ankle (0.39) -- its foot turning, still to see to.
import std.list
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.locomotion
import ae3d.feet
import ae3d.motion
import ae3d.lookat
import ae3d.matching
import ae3d.input
import ae3d.platform
import aephysics.human
import aephysics.dynamics

extern sqrt(x: float) -> float

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern clock_ns() -> long

const PATH = "tests/fixtures/gltf/humanoid.glb"
const HALF = 9.0                     // the plaza is 18 m square
const GROUND_PAST = 30.0             // m the ground runs on past it
const ARRIVED = 0.8                  // metres from its goal a figure picks another
const REPORT = 5.0                   // seconds between reports
const SLID = 0.01                    // #509's bound on a stance's slide, metres
// The car: a box 4 by 1.8 m, crossing the plaza along x at CAR_SPEED, one
// way then the other, every CAR_EVERY seconds: a kinematic body, so a walker
// it reaches is struck by the car itself, its ragdoll taking it over just
// before (CAR_HAND_OVER).
const CAR_SPEED = 7.0
const CAR_EVERY = 6.0
const THROUGH = 0.3                  // m from a walker a thrown body's pelvis passes through it
const SECOND_BLOW = 1.5               // m/s a thrown body meets a walker at, to strike it
const WAKE = 2.0                     // m from a struck body still moving a walker is given its bodies
const SLEEP = 3.0                    // and past which
const WAKE_CALM = 1.0                // seconds clear it is parked again
const MOVING = 0.5                   // m/s a struck body's pelvis moves at, still moving
const BACK_KNEE = 0.087              // sine of the angle a knee bent backwards is bent past straight (5 degrees)
const OVERLAP = 0.2                  // m between two figures' hips, chests or knees: inside each other
const SUNK = 0.03                    // m below the ground a foot or body is sunk
const TRODDEN = 0.35                 // m from a struck body a walker walks through it
const HEAD_SPIN = 2.0                // rad/s a risen walker's head turns at most, settled
const CAR_BRAKE = 7.0                // m/s/s, a car braking hard
const CAR_STANDS = 2.0               // seconds it stands, stopped, before it is gone
const CAR_HARMLESS = 1.0             // m/s under which it hands no one to a ragdoll
const CAR_HAND_OVER = 0.6            // metres from the car's box a walker's ragdoll takes it over
const CAR_INSIDE = 0.3               // and no nearer: its arms would be inside it
const CAR_HALF_X = 2.0
const CAR_HALF_Z = 0.9
// Its body CAR_CLEAR off the ground, as a car's is: down to the ground, a
// body lying in its way was pressed between it and the ground and squeezed
// out through the ground, and fell on below the plaza (of 24 walkers in
// 60 s, 12 struck were kilometres down).
const CAR_CLEAR = 0.3
const CAR_HALF_Y = 0.55
const SETTLE = 0.8                   // seconds up and strong before it walks on
const STAND_AFTER = 0.4              // seconds it stands, handed back, before walking on
const LOOK_CAR = 10.0                // metres within which a walker watches the car go by
const WALKING = 0
const KNOCKED = 1
const RETURNING = 2

struct Walker {
    object: ptr                      // *GameObject
    loco: ptr                        // *Locomotion
    feet: ptr                        // *Feet
    controller: ptr                  // *CharacterController
    head_last: Quat
    head_known: bool
    awake: bool                      // walking with its bodies in the world (wake_near)
    calm_for: float
    toes: ptr                        // *Model[2], left and right
    goal: Vec3
    running: bool
    seed: int
    held: ptr                        // int[2]: the foot held last frame
    from: ptr                        // float[6]: where each toe was when its foot was set down
    most: ptr                        // float[2]: the farthest each toe has slid in this stance
    ankle_z: ptr                     // float[2]
    ankle_most: ptr                  // float[2]: the same for the ankle
    body: ptr                        // *Motion: its active ragdoll, built at the start and parked
    look: ptr                        // *LookAt
    core: ptr                        // *Model[2]: hips, chest (the drawn skeleton)
    legs: ptr                        // *Model[6]: left hip, knee, ankle, right hip, knee, ankle (the drawn skeleton)
    marks: ptr                       // *GameObject[3]: the feet's targets and the way ahead, shown by F1
    db: ptr                          // *Database when posed by motion matching
    rest: ptr                        // its figure's pose as loaded (figure.keep_pose)
    state: int
    up_seconds: float
    struck_at: float
    standing: float                  // seconds to stand before walking on, handed back
    turned: ptr                      // float[2]: the heading when each foot was set down
}

struct Plaza {
    walkers: ptr                     // *Walker[count]
    count: int
    crowd: ptr                       // list of *Locomotion
    seconds: float
    next_report: float
    stances: int
    over: int                        // stances that slid more than SLID
    slid_sum: float
    worst: float
    frame_ns: long
    frames: int
    worst_frame_ns: long
    last_ns: long
    ankle_sum: float
    car: ptr                         // *GameObject
    spin_seconds: float
    trodden_seconds: float
    overlap_down: float              // of it, one of the two struck
    back_knee: float
    overlap: float
    sunk: float
    in_car: float
    woken: int
    seconds_struck: int              // walkers struck by a thrown body, not the car
    through_seconds: float           // a struck body still moving within THROUGH of a walker walking
    trodden_lying: float             // of them, the body lying still
    car_body: ptr                    // *Rigidbody: kinematic, so what it meets it pushes
    car_x: float
    car_way: float                   // +1 or -1 while crossing, 0 waiting
    car_z: float
    car_wait: float
    car_speed: float                 // m/s, braking from CAR_SPEED once it strikes
    braking: bool
    stopped_for: float
    lane: int
    struck: int
    returned: int
    down_sum: float
    looking: int                     // walkers watching the car this frame
    debug: bool                      // the markers shown
    build_ms: float                  // building the walkers' ragdolls, at the start
    scratch: ptr                     // two poses, physics.POSE_STRIDE floats a bone
}

// A number from a seed, the next seed with it: the same plaza every run.
next_seed(seed: int) -> int { return (seed * 1103515245 + 12345) % 2147483647 }
unit_of(seed: int) -> float {
    s = seed
    if s < 0 { s = 0 - s }
    return ((s % 10000) as float) / 10000.0
}

pick_goal(w: *Walker) {
    w.seed = next_seed(w.seed)
    x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
    w.seed = next_seed(w.seed)
    z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
    w.goal = core.vec3(x, 0.0, z)
    w.seed = next_seed(w.seed)
    w.running = unit_of(w.seed) < 0.25
}

block(e: *Engine, name: string, at: Vec3, half: Vec3, turn: Quat) {
    o = engine.object(e, name, loader.cube(1.0))
    behaviour.object_set_position(o, at)
    behaviour.object_set_rotation(o, turn)
    behaviour.object_set_scale(o, core.v3_mul(half, 2.0))
    physics.box_collider(o, half, physics.material(0.8, 0.0))
}

bone(sk: *Skeleton, name: string) -> *Model { return skin.skeleton_bone(sk, skin.skeleton_find(sk, name)) }

start(state: ptr, e: *Engine) {
    p = state as *Plaza
    physics.attach(e)
    level = core.quat_rotate(0.0, core.vec3(0.0, 1.0, 0.0))
    // Wide past the plaza: whatever is thrown off it lands, not falls on.
    block(e, "Ground", core.vec3(0.0, 0.0 - 0.5, 0.0), core.vec3(HALF + GROUND_PAST, 0.5, HALF + GROUND_PAST), level)
    // A ramp up to a 0.6 m deck in the far corner, three 0.15 m steps down
    // from its side, and a kerb across the near half.
    block(e, "Deck", core.vec3(6.0, 0.3, 0.0 - 6.0), core.vec3(2.0, 0.3, 2.0), level)
    block(e, "Ramp", core.vec3(6.0, 0.15, 0.0 - 2.4), core.vec3(1.5, 0.05, 1.8), core.quat_rotate(0.0 - 0.17, core.vec3(1.0, 0.0, 0.0)))
    k = 0
    while k < 3 {
        h = 0.15 * ((k + 1) as float)
        block(e, "Step", core.vec3(2.9 + 0.35 * ((2 - k) as float), h * 0.5, 0.0 - 6.0), core.vec3(0.175, h * 0.5, 1.5), level)
        k = k + 1
    }
    block(e, "Kerb", core.vec3(0.0 - 3.0, 0.075, 3.0), core.vec3(4.0, 0.075, 0.2), level)
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(CAR_HALF_X * 2.0, CAR_HALF_Y * 2.0, CAR_HALF_Z * 2.0))
    behaviour.object_set_position(car, car_parked())
    // A body the crossing moves, so what it meets it pushes: drawn only, the
    // car went through the bodies it had struck down and the struck were
    // thrown by a blow at the hips, not by the car.
    body = physics.rigidbody(car, physics.KINEMATIC)
    physics.box_collider(car, core.vec3(CAR_HALF_X, CAR_HALF_Y, CAR_HALF_Z), physics.material(0.6, 0.0))
    physics.rigidbody_enable_hit_events(body, true)
    p.car_body = body as ptr
    p.car = car as ptr

    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        o = figure.figure(e, "Walker", PATH)
        if o == null {
            println("plaza_showcase: ${PATH} would not load")
            return
        }
        w.seed = 7919 * (i + 1)
        w.seed = next_seed(w.seed)
        x = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        w.seed = next_seed(w.seed)
        z = (unit_of(w.seed) * 2.0 - 1.0) * (HALF - 1.0)
        behaviour.object_set_position(o, core.vec3(x, 0.0, z))
        c = physics.character_controller(o, 0.3, 1.8)
        l = locomotion.attach(e, o, c, "Idle", "Walk", "Run")
        locomotion.set_crowd(l, p.crowd)
        list.add_raw(p.crowd, l as ptr)
        sk = figure.skeleton(figure.figure_of(o))
        w.rest = figure.keep_pose(figure.figure_of(o))
        f = feet.attach(e, o.model as *Model, bone(sk, "mixamorig:Hips"),
                        bone(sk, "mixamorig:LeftUpLeg"), bone(sk, "mixamorig:LeftLeg"), bone(sk, "mixamorig:LeftFoot"),
                        bone(sk, "mixamorig:RightUpLeg"), bone(sk, "mixamorig:RightLeg"), bone(sk, "mixamorig:RightFoot"))
        if core.env_int("AE3D_FLAT", 0) == 0 { feet.ground_physics(f, physics.of(e)) }
        marks = w.marks as ptr[]
        k = 0
        while k < 3 {
            mark = engine.object(e, "Mark", loader.cube(1.0))
            behaviour.object_set_scale(mark, core.vec3(0.09, 0.03, 0.09))
            core.model_set_diffuse(mark.model as *Model, 0.2, 0.4, 1.0)
            (mark.model as *Model).visible = p.debug
            marks[k] = mark as ptr
            k = k + 1
        }
        // Watching the car go by: the head and neck turned to it.
        w.look = lookat.attach(e, o.model as *Model, bone(sk, "mixamorig:Neck"), bone(sk, "mixamorig:Head"), core.vec3(0.0, 0.0, 1.0)) as ptr
        // Posed by motion matching, a database of its own: a database
        // poses the figure it was built from.
        if core.env_int("AE3D_MATCHING", 0) == 1 {
            db = matching.database_new(figure.figure_of(o), o.model as *Model)
            matching.add_clip(db, "Idle")
            matching.add_clip(db, "Walk")
            matching.add_clip(db, "Run")
            matching.build(db)
            locomotion.use_matching(l, db)
            w.db = db as ptr
        }
        // Its active ragdoll, built now and parked until the car strikes:
        // built at the strike, a frame of 200 walkers took 65 ms.
        built = clock_ns()
        m = motion.on_figure(e, o)
        if m != null {
            physics.ragdoll_park(m.ragdoll)
            physics.character_ignore(c, m.ragdoll)
        }
        w.body = m as ptr
        p.build_ms = p.build_ms + ((clock_ns() - built) as float) / 1000000.0
        toes = w.toes as ptr[]
        w.legs = calloc(6, 8)
        legs = w.legs as ptr[]
        legs[0] = bone(sk, "mixamorig:LeftUpLeg") as ptr
        legs[1] = bone(sk, "mixamorig:LeftLeg") as ptr
        legs[2] = bone(sk, "mixamorig:LeftFoot") as ptr
        legs[3] = bone(sk, "mixamorig:RightUpLeg") as ptr
        legs[4] = bone(sk, "mixamorig:RightLeg") as ptr
        legs[5] = bone(sk, "mixamorig:RightFoot") as ptr
        w.core = calloc(2, 8)
        core_bones = w.core as ptr[]
        core_bones[0] = bone(sk, "mixamorig:Hips") as ptr
        core_bones[1] = bone(sk, "mixamorig:Spine2") as ptr
        toes[0] = bone(sk, "mixamorig:LeftToeBase") as ptr
        toes[1] = bone(sk, "mixamorig:RightToeBase") as ptr
        w.object = o as ptr
        w.loco = l as ptr
        w.feet = f as ptr
        w.controller = c as ptr
        pick_goal(w)
        i = i + 1
    }
    p.next_report = REPORT
    input.bind_key(engine.engine_input(e), "debug", platform.KEY_F1)
}

// The markers on a walker, when shown: each foot's target where ae3d.feet
// puts it, green held and red swinging, and its body a second on.
mark_walker(p: *Plaza, w: *Walker) {
    marks = w.marks as ptr[]
    show = p.debug && w.state == WALKING
    k = 0
    while k < 3 {
        ((marks[k] as *GameObject).model as *Model).visible = show
        k = k + 1
    }
    if !show { return }
    f = w.feet as *Feet
    k = 0
    while k < 2 {
        mark = marks[k] as *GameObject
        // On the ground under the target: at the ankle's height it was
        // inside the foot.
        target = feet.leg_target(f, k)
        behaviour.object_set_position(mark, core.vec3(target.x, feet.leg_ground(f, k).y + 0.015, target.z))
        behaviour.object_set_scale(mark, core.vec3(0.16, 0.02, 0.16))
        if feet.leg_locked(f, k) {
            core.model_set_diffuse(mark.model as *Model, 0.2, 0.9, 0.3)
        } else {
            core.model_set_diffuse(mark.model as *Model, 0.95, 0.25, 0.2)
        }
        k = k + 1
    }
    at = behaviour.object_world_position(w.object as *GameObject)
    v = locomotion.velocity(w.loco as *Locomotion)
    behaviour.object_set_position(marks[2] as *GameObject, core.vec3(at.x + v.x, at.y + 0.02, at.z + v.z))
}

// A frame of a walker's feet: each stance's slide, from the toe's place
// when the foot was set down to where it is now, over the ground.
watch_feet(p: *Plaza, w: *Walker) {
    f = w.feet as *Feet
    toes = w.toes as ptr[]
    held = w.held as int[]
    from = w.from as float[]
    most = w.most as float[]
    ankle_z = w.ankle_z as float[]
    ankle_most = w.ankle_most as float[]
    turned = w.turned as float[]
    k = 0
    while k < 2 {
        toe = toes[k] as *Model
        core.model_sync_transform(toe)
        at = toe.world_position
        down = feet.leg_locked(f, k)
        if down && held[k] == 0 {
            turned[k] = locomotion.heading(w.loco as *Locomotion)
            from[k * 3] = at.x
            from[k * 3 + 2] = at.z
            most[k] = 0.0
        }
        an = feet.leg_ankle(f, k)
        core.model_sync_transform(an)
        if down && held[k] == 0 {
            from[k * 3 + 1] = an.world_position.x
            ankle_z[k] = an.world_position.z
            ankle_most[k] = 0.0
        }
        if down {
            d = core.v3_len(core.vec3(at.x - from[k * 3], 0.0, at.z - from[k * 3 + 2]))
            if d > most[k] { most[k] = d }
            da = core.v3_len(core.vec3(an.world_position.x - from[k * 3 + 1], 0.0, an.world_position.z - ankle_z[k]))
            if da > ankle_most[k] { ankle_most[k] = da }
        }
        if !down && held[k] == 1 {
            if core.env_int("AE3D_STANCES", 0) == 3 && most[k] > SLID {
                println("over: struck before ${w.struck_at > 0.0}, toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm, t ${p.seconds} turned ${(locomotion.heading(w.loco as *Locomotion) - turned[k]) * 57.3} speed ${locomotion.speed(w.loco as *Locomotion)}")
            }
            if core.env_int("AE3D_STANCES", 0) == 1 {
                println("stance ${k}: toe ${most[k] * 100.0} cm, ankle ${ankle_most[k] * 100.0} cm; turned ${(locomotion.heading(w.loco as *Locomotion) - turned[k]) * 57.3} deg; speed ${locomotion.speed(w.loco as *Locomotion)}")
            }
            p.stances = p.stances + 1
            p.slid_sum = p.slid_sum + most[k]
            if most[k] > p.worst { p.worst = most[k] }
            if most[k] > SLID { p.over = p.over + 1 }
            p.ankle_sum = p.ankle_sum + ankle_most[k]
        }
        held[k] = 0
        if down { held[k] = 1 }
        k = k + 1
    }
}

update(state: ptr, e: *Engine, delta: float) {
    p = state as *Plaza
    started = clock_ns()
    p.seconds = p.seconds + delta
    p.looking = 0
    if input.pressed(engine.engine_input(e), "debug") { p.debug = !p.debug }
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        o = w.object as *GameObject
        if o != null && w.state == WALKING {
            at = behaviour.object_world_position(o)
            to = core.vec3(w.goal.x - at.x, 0.0, w.goal.z - at.z)
            if core.v3_len(to) < ARRIVED { pick_goal(w) }
            way = core.v3_normalize(to)
            // Up again, it stands while its feet come back to the ground:
            // walked on at once, with ae3d.feet still easing in, a held foot
            // only partly kept its turn and swung round with the body,
            // its toe 30 cm over the ground.
            if w.standing > 0.0 {
                w.standing = w.standing - delta
                way = core.vec3(0.0, 0.0, 0.0)
            }
            locomotion.set_input(w.loco as *Locomotion, way, w.running)
            watch_car(p, w, at)
        }
        if o != null {
            mark_walker(p, w)
        }
        i = i + 1
    }
    // The frame's time: from the last frame's update to this one's.
    if p.last_ns > 0 && p.seconds > 1.0 {
        took = started - p.last_ns
        p.frame_ns = p.frame_ns + took
        if took > p.worst_frame_ns { p.worst_frame_ns = took }
        p.frames = p.frames + 1
    }
    p.last_ns = started
    if p.seconds >= p.next_report {
        report(p)
        p.next_report = p.next_report + REPORT
    }
    camera(p, e)
}

// The car's crossings and strikes, and the struck walkers' way back: on the
// fixed step, after the physics and the motions.
fixed(state: ptr, e: *Engine, step: float) {
    p = state as *Plaza
    drive(p, e, step)
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state != WALKING {
            // The crowd steps round where its body lies.
            m = w.body as *Motion
            locomotion.set_stand_in(w.loco as *Locomotion, behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS)),
                                    behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_NECK)))
            recover(p, w, step)
        }
        i = i + 1
    }
    wake_near(p, step)
    score(p)
}

// The scorecard: what a player sees wrong, in figure-seconds, every fixed
// step over every walker, as drawn. A knee bent backwards (past straight by
// BACK_KNEE, about the line across the hips); two figures
// inside each other (nearer than OVERLAP); a foot or a body sunk in the
// ground (SUNK); a body inside the car.
score(p: *Plaza) {
    step = 1.0 / 60.0
    ws = p.walkers as ptr[]
    car_y = CAR_CLEAR + CAR_HALF_Y
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        legs = w.legs as ptr[]
        toes = w.toes as ptr[]
        k = 0
        while k < 2 {
            hip = legs[k * 3] as *Model
            knee = legs[k * 3 + 1] as *Model
            ankle = legs[k * 3 + 2] as *Model
            toe = toes[k] as *Model
            core.model_sync_transform(hip)
            core.model_sync_transform(knee)
            core.model_sync_transform(ankle)
            core.model_sync_transform(toe)
            // Bent backwards: the knee's bend, about the line across the
            // hips, the other way from its flexing, past BACK_KNEE. Judged
            // from the way the toes point, a kneeling shin's foot hanging
            // down read as a knee bent back: struck figures' knees counted
            // backwards hundreds of seconds a minute, none truly were.
            right = core.v3_sub((legs[3] as *Model).world_position, (legs[0] as *Model).world_position)
            thigh = core.v3_sub(knee.world_position, hip.world_position)
            shin = core.v3_sub(ankle.world_position, knee.world_position)
            if core.v3_len(right) > 0.01 && core.v3_len(thigh) > 0.01 && core.v3_len(shin) > 0.01 {
                flex = core.v3_dot(core.v3_cross(thigh, shin), core.v3_normalize(right)) / (core.v3_len(thigh) * core.v3_len(shin))
                if flex < 0.0 - BACK_KNEE { p.back_knee = p.back_knee + step }
            }
            if toe.world_position.y < 0.0 - SUNK || ankle.world_position.y < 0.0 - SUNK { p.sunk = p.sunk + step }
            k = k + 1
        }
        j = i + 1
        while j < p.count {
            if inside(w, ws[j] as *Walker) {
                p.overlap = p.overlap + step
                if w.state != WALKING || (ws[j] as *Walker).state != WALKING { p.overlap_down = p.overlap_down + step }
            }
            j = j + 1
        }
        m = w.body as *Motion
        if m != null && w.state != WALKING {
            r = m.ragdoll
            if physics.ragdoll_pose_lowest(r, null) < 0.0 - SUNK && floor_near(p, r) { p.sunk = p.sunk + step }
            b2 = 0
            in_car = false
            while b2 < human.BONE_COUNT {
                q = behaviour.object_position(physics.ragdoll_bone(r, b2))
                if p.car_way != 0.0 && core.abs_of(q.x - p.car_x) < CAR_HALF_X && core.abs_of(q.z - p.car_z) < CAR_HALF_Z && q.y > CAR_CLEAR && q.y < car_y + CAR_HALF_Y { in_car = true }
                b2 = b2 + 1
            }
            if in_car { p.in_car = p.in_car + step }
        }
        i = i + 1
    }
}

// Whether two figures, as drawn, are inside each other: any of one's hips,
// chest and knees within OVERLAP of any of the other's.
inside(a: *Walker, b: *Walker) -> bool {
    i = 0
    while i < 4 {
        pa = drawn_point(a, i)
        k = 0
        while k < 4 {
            if core.v3_len(core.v3_sub(pa, drawn_point(b, k))) < OVERLAP { return true }
            k = k + 1
        }
        i = i + 1
    }
    return false
}

drawn_point(w: *Walker, i: int) -> Vec3 {
    m = (w.core as ptr[])[0] as *Model
    if i == 1 { m = (w.core as ptr[])[1] as *Model }
    if i == 2 { m = (w.legs as ptr[])[1] as *Model }
    if i == 3 { m = (w.legs as ptr[])[4] as *Model }
    core.model_sync_transform(m)
    return m.world_position
}

// Whether a ragdoll is over the plaza's flat ground (the kerb, the steps and
// the ramp are above it).
floor_near(p: *Plaza, r: *Ragdoll) -> bool { return true }

// Walkers near a body the car has thrown are given their bodies, following
// their clip, so the body thrown meets them -- parked, nothing collides
// with them, and a body flying into a walker passed through it (#648).
// Within WAKE of a struck body still moving it is woken; WAKE_CALM seconds
// with none within SLEEP it is parked again. Only the few near the action
// are woken: every walker's bodies in the world cost 65 ms a frame at 200.
wake_near(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        m = w.body as *Motion
        if w.state == WALKING && m != null {
            at = behaviour.object_world_position(w.object as *GameObject)
            near = 1000.0
            j = 0
            while j < p.count {
                d = ws[j] as *Walker
                dm = d.body as *Motion
                if j != i && d.state != WALKING && dm != null && (motion.falling(dm) || physics.ragdoll_bone_speed(dm.ragdoll, human.BONE_PELVIS) > MOVING) {
                    pel = behaviour.object_position(physics.ragdoll_bone(dm.ragdoll, human.BONE_PELVIS))
                    gap = core.v3_len(core.vec3(pel.x - at.x, 0.0, pel.z - at.z))
                    if gap < near { near = gap }
                }
                j = j + 1
            }
            if near < THROUGH { p.through_seconds = p.through_seconds + step }
            if !w.awake && near < WAKE {
                physics.ragdoll_unpark(m.ragdoll)
                physics.ragdoll_to_rig(m.ragdoll)
                hit_events(m, true)
                w.awake = true
                w.calm_for = 0.0
                p.woken = p.woken + 1
            } else if w.awake {
                if near > SLEEP { w.calm_for = w.calm_for + step } else { w.calm_for = 0.0 }
                if w.calm_for >= WAKE_CALM {
                    hit_events(m, false)
                    physics.ragdoll_park(m.ragdoll)
                    w.awake = false
                }
            }
        }
        i = i + 1
    }
}

drive(p: *Plaza, e: *Engine, step: float) {
    car = p.car as *GameObject
    if car == null || core.env_int("AE3D_NOCAR", 0) == 1 { return }
    if p.car_way == 0.0 {
        p.car_wait = p.car_wait - step
        if p.car_wait > 0.0 { return }
        // Across the plaza along a lane through the crowd, each crossing the
        // other way and on another lane.
        p.lane = p.lane + 1
        p.car_way = 1.0
        if p.lane % 2 == 0 { p.car_way = 0.0 - 1.0 }
        p.car_x = (0.0 - p.car_way) * (HALF + 4.0)
        p.car_z = (((p.lane % 5) as float) - 2.0) * 2.5
        // Put there, not driven there: moved over a step from where it was
        // parked, it would sweep the plaza at hundreds of metres a second.
        physics.rigidbody_place(p.car_body as *Rigidbody, core.vec3(p.car_x, CAR_CLEAR + CAR_HALF_Y, p.car_z), core.quat_ident())
        p.car_speed = CAR_SPEED
        p.braking = false
        p.stopped_for = 0.0
    }
    // Having struck someone it brakes, as a driver does, stands, and is
    // gone: driven on at its speed, it carried the struck before it on its
    // bumper, 9.6 m for one walker, and off the edge of the plaza for
    // others, who fell on below it.
    if p.braking {
        p.car_speed = p.car_speed - CAR_BRAKE * step
        if p.car_speed < 0.0 { p.car_speed = 0.0 }
        if p.car_speed == 0.0 { p.stopped_for = p.stopped_for + step }
    }
    p.car_x = p.car_x + p.car_way * p.car_speed * step
    behaviour.object_set_position(car, core.vec3(p.car_x, CAR_CLEAR + CAR_HALF_Y, p.car_z))
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.state == WALKING {
            // Handed to its ragdoll just before the car reaches it, front or
            // side, so the car meets its bodies: parked, they are not in the
            // world. Never inside the car's box: handed over there, along
            // its side, its bodies were thrown out of it a hundred metres
            // and more, and fell on below the plaza.
            at = behaviour.object_world_position(w.object as *GameObject)
            out_x = core.abs_of(at.x - p.car_x) - CAR_HALF_X
            out_z = core.abs_of(at.z - p.car_z) - CAR_HALF_Z
            if out_x < 0.0 { out_x = 0.0 }
            if out_z < 0.0 { out_z = 0.0 }
            clear = sqrt(out_x * out_x + out_z * out_z)
            if clear > CAR_INSIDE && clear < CAR_HAND_OVER && p.car_speed > CAR_HARMLESS { strike(p, e, w) }
        }
        i = i + 1
    }
    if (core.abs_of(p.car_x) > HALF + 4.0 && p.car_x * p.car_way > 0.0) || p.stopped_for >= CAR_STANDS {
        p.car_way = 0.0
        p.car_wait = CAR_EVERY
        behaviour.object_set_position(car, car_parked())
        physics.rigidbody_place(p.car_body as *Rigidbody, car_parked(), core.quat_ident())
    }
    felt(p, e)
    heads(p, step)
    trodden(p, step)
}

// Seconds a walker walking is within TRODDEN of a struck body (pelvis to
// head), summed over the pairs: walked through, as the crowd stepped round
// where the struck had stood and not where their bodies lay.
trodden(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        down = ws[i] as *Walker
        m = down.body as *Motion
        if down.state != WALKING && m != null {
            a = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
            b = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_NECK))
            ab = core.vec3(b.x - a.x, 0.0, b.z - a.z)
            span = ab.x * ab.x + ab.z * ab.z
            j = 0
            while j < p.count {
                w = ws[j] as *Walker
                if j != i && w.state == WALKING {
                    at = behaviour.object_world_position(w.object as *GameObject)
                    u = 0.0
                    if span > 0.0001 { u = core.clampf(((at.x - a.x) * ab.x + (at.z - a.z) * ab.z) / span, 0.0, 1.0) }
                    near = core.vec3(a.x + ab.x * u - at.x, 0.0, a.z + ab.z * u - at.z)
                    if near.x * near.x + near.z * near.z < TRODDEN * TRODDEN {
                        p.trodden_seconds = p.trodden_seconds + step
                        if motion.lying(m) || motion.down(m) { p.trodden_lying = p.trodden_lying + step }
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// Seconds a struck walker, up on its feet, has its head turning faster than
// HEAD_SPIN against its chest, summed over the walkers. Left watching the
// car, a risen walker's head turned on and on: 19.7 s in 60 s with 20
// walkers, 5.7 now, the rest its stagger's own.
heads(p: *Plaza, step: float) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        m = w.body as *Motion
        if w.state != WALKING && m != null {
            r = m.ragdoll
            rel = core.quat_mul(core.quat_conjugate(physics.ragdoll_bone_rotation(r, human.BONE_SPINE_03)), physics.ragdoll_bone_rotation(r, human.BONE_NECK))
            if w.head_known {
                d = core.quat_mul(rel, core.quat_conjugate(w.head_last))
                a = 2.0 * core.acos_of(core.clampf(core.abs_of(d.w), 0.0, 1.0)) / step
                if a > HEAD_SPIN && !motion.falling(m) && !motion.lying(m) && !motion.getting_up(m) { p.spin_seconds = p.spin_seconds + step }
            }
            w.head_last = rel
            w.head_known = true
        } else {
            w.head_known = false
        }
        i = i + 1
    }
}

// What the car struck this step, each body as hard as it met it: the blow
// the walker feels -- its muscle's share, its arms' answer -- without a
// second push, the contact having given it.
felt(p: *Plaza, e: *Engine) {
    ph = physics.of(e)
    car = physics.rigidbody_body(p.car_body as *Rigidbody)
    n = physics.hit_event_count(ph)
    k = 0
    while k < n {
        ev = physics.hit_event(ph, k)
        other = ev.shape_id_b
        if !same_body(dynamics.shape_get_body(ev.shape_id_a), car) {
            other = ev.shape_id_a
            if !same_body(dynamics.shape_get_body(ev.shape_id_b), car) { other = dynamics.null_shape_id() }
        }
        if dynamics.shape_is_valid(other) {
            r = physics.ragdoll_of_shape(ph, other)
            if r != null {
                feel(p, r, dynamics.shape_get_body(other), ev)
                p.braking = true
            }
        } else {
            second(p, e, ev)
        }
        k = k + 1
    }
}

// A body thrown into a walker woken near the action (wake_near): struck
// hard enough (SECOND_BLOW), the walker is struck too -- handed to its
// ragdoll, the blow felt where they met -- as a second victim, rather than
// walking on through the body that hit it (#648).
second(p: *Plaza, e: *Engine, ev: ContactHitEvent) {
    if ev.approach_speed < SECOND_BLOW { return }
    ph = physics.of(e)
    ra = physics.ragdoll_of_shape(ph, ev.shape_id_a)
    rb = physics.ragdoll_of_shape(ph, ev.shape_id_b)
    if ra == null || rb == null || ra == rb { return }
    ia = walker_of(p, ra)
    ib = walker_of(p, rb)
    if ia < 0 || ib < 0 { return }
    ws = p.walkers as ptr[]
    wa = ws[ia] as *Walker
    wb = ws[ib] as *Walker
    hit = wa
    body = dynamics.shape_get_body(ev.shape_id_a)
    if wa.state != WALKING || !wa.awake {
        hit = wb
        body = dynamics.shape_get_body(ev.shape_id_b)
        if wb.state != WALKING || !wb.awake { return }
    }
    if wa.state == WALKING && wb.state == WALKING { return }
    strike(p, e, hit)
    p.seconds_struck = p.seconds_struck + 1
    feel(p, (hit.body as *Motion).ragdoll, body, ev)
}

walker_of(p: *Plaza, r: *Ragdoll) -> int {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        m = (ws[i] as *Walker).body as *Motion
        if m != null && m.ragdoll == r { return i }
        i = i + 1
    }
    return 0 - 1
}

// Hit events on, or off, on every shape of a walker's bodies.
hit_events(m: *Motion, on: bool) {
    h = physics.ragdoll_human(m.ragdoll)
    i = 0
    while i < human.BONE_COUNT {
        bone = human.bone_at(h, i)
        dynamics.shape_enable_hit_events(bone.shape_id, on)
        if dynamics.shape_is_valid(bone.foot_shape_id) { dynamics.shape_enable_hit_events(bone.foot_shape_id, on) }
        i = i + 1
    }
}

car_parked() -> Vec3 { return core.vec3(0.0 - HALF - 30.0, CAR_CLEAR + CAR_HALF_Y, 0.0) }

same_body(a: BodyId, b: BodyId) -> bool { return a.index1 == b.index1 && a.world0 == b.world0 && a.generation == b.generation }

feel(p: *Plaza, r: *Ragdoll, body: BodyId, ev: ContactHitEvent) {
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        m = w.body as *Motion
        if m != null && m.ragdoll == r {
            b = 0
            while b < human.BONE_COUNT {
                if same_body(human.bone_at(physics.ragdoll_human(r), b).body_id, body) {
                    blow = core.v3_mul(core.vec3(p.car_way, 0.0, 0.0), ev.approach_speed * dynamics.body_get_mass(body))
                    motion.hit(m, b, ev.point, blow, false)
                }
                b = b + 1
            }
            return
        }
        i = i + 1
    }
}

// Struck: locomotion and the feet let it go, and the figure is an active
// ragdoll's, POWERED, for the car to meet.
strike(p: *Plaza, e: *Engine, w: *Walker) {
    m = w.body as *Motion
    if m == null { return }
    physics.ragdoll_unpark(m.ragdoll)
    physics.ragdoll_to_rig(m.ragdoll)
    // Handed over whole: the feet and the look off at once, then the clip
    // stopped on its frame (locomotion.set_paused) -- nothing but the
    // ragdoll poses the figure until it is handed back. Left watching the
    // car, the look's turn went into the joints' targets from a head the
    // ragdoll had turned, and a risen walker's head turned on and on.
    feet.release(w.feet as *Feet)
    lookat.release(w.look as *LookAt)
    locomotion.set_paused(w.loco as *Locomotion, true)
    motion.set_mode(m, motion.POWERED)
    motion.set_get_up(m, 1.0)
    // Its stances end here, not measured: knocked down is not a step.
    held = w.held as int[]
    held[0] = 0
    held[1] = 0
    w.state = KNOCKED
    w.awake = false
    w.up_seconds = 0.0
    w.struck_at = p.seconds
    p.struck = p.struck + 1
}

// Up again and strong for SETTLE seconds, the walker is moved to where its
// body stands and faces, and the ragdoll blends back into the clip; blended,
// the ragdoll is parked and locomotion and the feet take it up again.
recover(p: *Plaza, w: *Walker, step: float) {
    m = w.body as *Motion
    if w.state == KNOCKED {
        up = motion.mode(m) == motion.POWERED && !motion.falling(m) && !motion.lying(m) && !motion.down(m) &&
             !motion.getting_up(m) && motion.tilt(m) < 0.2 && strong(m)
        if up { w.up_seconds = w.up_seconds + step } else { w.up_seconds = 0.0 }
        if w.up_seconds >= SETTLE {
            to_body(p, w)
            motion.set_mode(m, motion.ANIMATED)
            w.state = RETURNING
        }
        return
    }
    if !motion.blending(m) {
        physics.ragdoll_park(m.ragdoll)
        // Its pose as loaded under the clip again: a bone the clip does
        // not key (the box man's toes) keeps what the ragdoll left it, and
        // its toe swept the ground walking on, 34 cm in a stance.
        fig = figure.figure_of(w.object as *GameObject)
        time = figure.time(fig)
        figure.put_pose(fig, w.rest)
        figure.set_time(fig, time)
        locomotion.set_paused(w.loco as *Locomotion, false)
        feet.set_weight(w.feet as *Feet, 1.0)
        pick_goal(w)
        w.standing = STAND_AFTER
        w.state = WALKING
        p.returned = p.returned + 1
        p.down_sum = p.down_sum + (p.seconds - w.struck_at)
    }
}

strong(m: *Motion) -> bool {
    i = 0
    while i < human.BONE_COUNT {
        if motion.bone_weakness(m, i) > 0.05 { return false }
        i = i + 1
    }
    return true
}

// The walker's object turned about the animation's pelvis by the angle
// between the ways the body and the animation face, and carried by how far
// apart their pelvises are over the ground, as ae3d.handover moves a rig
// back: its clip then stands where its body does, and locomotion is placed
// there.
to_body(p: *Plaza, w: *Walker) {
    m = w.body as *Motion
    r = m.ragdoll
    stride = human.BONE_COUNT * physics.POSE_STRIDE
    bodies = p.scratch
    animated = p.scratch + stride * 8
    physics.ragdoll_body_pose(r, bodies)
    physics.ragdoll_animation_pose(r, animated)
    b = bodies as float[]
    a = animated as float[]
    at = human.BONE_PELVIS * physics.POSE_STRIDE
    rest = human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q
    forward = physics.ragdoll_rest_forward(r)
    body_front = flat(core.quat_apply(core.quat_mul(core.quat(b[at], b[at + 1], b[at + 2], b[at + 3]), core.quat_conjugate(rest)), forward))
    anim_front = flat(core.quat_apply(core.quat_mul(core.quat(a[at], a[at + 1], a[at + 2], a[at + 3]), core.quat_conjugate(rest)), forward))
    angle = 0.0
    if core.v3_len(body_front) > 0.5 && core.v3_len(anim_front) > 0.5 {
        angle = core.atan2_of(body_front.x, body_front.z) - core.atan2_of(anim_front.x, anim_front.z)
    }
    o = w.object as *GameObject
    pivot = core.vec3(a[at + 4], 0.0, a[at + 6])
    now = behaviour.object_world_position(o)
    turn = core.quat_rotate(angle, core.vec3(0.0, 1.0, 0.0))
    off = core.quat_apply(turn, core.vec3(now.x - pivot.x, 0.0, now.z - pivot.z))
    to = core.vec3(pivot.x + off.x + b[at + 4] - a[at + 4], now.y, pivot.z + off.z + b[at + 6] - a[at + 6])
    // On the ground under its body, not at the height its object was left
    // at: the ragdoll carries the object's root with its pelvis, and handed
    // back at that height a walker's capsule stood under the plaza and fell
    // on, walking 2.4 m below the ground.
    hit = physics.ray_static_hit(physics.of(engine.of(o)), core.vec3(to.x, b[at + 5] + 1.0, to.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 4.0)
    if hit.hit { to = core.vec3(to.x, hit.point.y, to.z) }
    ahead = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 1.0))
    yaw = core.atan2_of(ahead.x, ahead.z) + angle
    locomotion.place(w.loco as *Locomotion, to, yaw)
}

flat(v: Vec3) -> Vec3 {
    f = core.vec3(v.x, 0.0, v.z)
    if core.v3_len(f) < 0.000001 { return core.vec3(0.0, 0.0, 0.0) }
    return core.v3_normalize(f)
}

// The car near and crossing, a walker turns its head to it; else to the
// clip again.
watch_car(p: *Plaza, w: *Walker, at: Vec3) {
    look = w.look as *LookAt
    if look == null { return }
    car = core.vec3(p.car_x, 1.0, p.car_z)
    near = core.v3_len(core.vec3(car.x - at.x, 0.0, car.z - at.z))
    if p.car_way != 0.0 && near < LOOK_CAR {
        lookat.set_target(look, car)
        p.looking = p.looking + 1
    } else {
        lookat.clear(look)
    }
}

// After the frame is drawn: the feet as they were drawn, the legs solved.
late(state: ptr, e: *Engine, delta: float) {
    p = state as *Plaza
    ws = p.walkers as ptr[]
    i = 0
    while i < p.count {
        w = ws[i] as *Walker
        if w.object != null && w.state == WALKING { watch_feet(p, w) }
        i = i + 1
    }
}

camera(p: *Plaza, e: *Engine) {
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < p.count {
        w = (p.walkers as ptr[])[watch] as *Walker
        at = behaviour.object_world_position(w.object as *GameObject)
        core.camera_set_position(cam, core.vec3(at.x + 3.0, at.y + 1.3, at.z + 0.8))
        core.camera_look_at(cam, core.vec3(at.x, at.y + 0.7, at.z))
        return
    }
    core.camera_set_position(cam, core.vec3(0.0, 11.0, 16.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0 - 1.0))
}

down_mean(p: *Plaza) -> float {
    if p.returned == 0 { return 0.0 }
    return p.down_sum / (p.returned as float)
}

report(p: *Plaza) {
    if core.env_int("AE3D_KNOCKED", 0) == 1 {
        wsd = p.walkers as ptr[]
        j = 0
        while j < p.count {
            wd = wsd[j] as *Walker
            md = wd.body as *Motion
            if wd.state != WALKING && md != null {
                println("knocked ${j} since ${p.seconds - wd.struck_at} state ${wd.state} mode ${motion.mode(md)} fall ${motion.falling(md)} lying ${motion.lying(md)} down ${motion.down(md)} getup ${motion.getting_up(md)} tilt ${motion.tilt(md)} strong ${strong(md)} up ${wd.up_seconds} pelvis ${behaviour.object_position(physics.ragdoll_bone(md.ragdoll, human.BONE_PELVIS)).y} blending ${motion.blending(md)}")
            }
            j = j + 1
        }
    }
    mean = 0.0
    if p.stances > 0 { mean = p.slid_sum / (p.stances as float) }
    frame = 0.0
    if p.frames > 0 { frame = (p.frame_ns as float) / (p.frames as float) / 1000000.0 }
    println("plaza ${p.seconds as int} s: ${p.count} walkers; ${p.stances} stances, a toe slid ${mean * 100.0} cm on average, ${p.worst * 100.0} at most, over ${SLID * 100.0} cm in ${p.over}; the ankle ${p.ankle_sum / (p.stances as float) * 100.0} cm on average; frame ${frame} ms on average, ${(p.worst_frame_ns as float) / 1000000.0} at most; the car struck ${p.struck}, ${p.returned} walking again, ${down_mean(p)} s from struck to walking on average; ${p.looking} watching the car; the ragdolls built in ${p.build_ms} ms; heads spinning ${p.spin_seconds} s; bodies walked through ${p.trodden_seconds} s (${p.trodden_lying} s lying still); ${p.woken} walkers woken near the action, ${p.seconds_struck} struck by a thrown body; thrown bodies through walkers ${p.through_seconds} s")
    println("plaza scorecard ${p.seconds as int} s: knees backwards ${p.back_knee} s, figures inside each other ${p.overlap} s (${p.overlap_down} s with one struck), sunk in the ground ${p.sunk} s, in the car ${p.in_car} s, heads spinning ${p.spin_seconds} s, bodies walked through ${p.trodden_seconds} s")
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - plaza showcase")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    count = core.env_int("AE3D_FIGURES", 24)
    block_ws = calloc(count, 8)
    ws = block_ws as ptr[]
    i = 0
    while i < count {
        w = calloc(1, sizeof(Walker)) as *Walker
        w.toes = calloc(2, 8)
        w.held = calloc(2, 4)
        w.from = calloc(6, 8)
        w.most = calloc(2, 8)
        w.ankle_z = calloc(2, 8)
        w.ankle_most = calloc(2, 8)
        w.turned = calloc(2, 8)
        w.marks = calloc(3, 8)
        ws[i] = w as ptr
        i = i + 1
    }
    p = Plaza { walkers: block_ws, count: count, crowd: list.new(), seconds: 0.0, next_report: REPORT, stances: 0, over: 0,
                slid_sum: 0.0, worst: 0.0, frame_ns: 0 as long, frames: 0, worst_frame_ns: 0 as long, last_ns: 0 as long, ankle_sum: 0.0, car: null, car_x: 0.0, car_way: 0.0, car_z: 0.0, car_wait: 2.0,
                lane: 0, looking: 0, debug: core.env_int("AE3D_DEBUG", 0) == 1, build_ms: 0.0, struck: 0, returned: 0, down_sum: 0.0, scratch: calloc(human.BONE_COUNT * physics.POSE_STRIDE * 2, 8) }
    b = engine.behaviour_new("plaza", (&p) as ptr)
    b.start = start
    b.update = update
    b.late_update = late
    b.fixed_update = fixed
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(&p)
    motion.motions_free(e)
    i = 0
    while i < count {
        w = ws[i] as *Walker
        if w.look != null { lookat.lookat_free(w.look as *LookAt) }
        if w.feet != null { feet.feet_free(w.feet as *Feet) }
        if w.loco != null { locomotion.locomotion_free(w.loco as *Locomotion) }
        if w.db != null { matching.database_free(w.db as *Database) }
        if w.controller != null { physics.character_free(w.controller as *CharacterController) }
        free(w.toes)
        figure.pose_free(w.rest)
        free(w.held)
        free(w.from)
        free(w.most)
        free(w.ankle_z)
        free(w.ankle_most)
        free(w.turned)
        free(w.marks)
        free(w as ptr)
        i = i + 1
    }
    free(block_ws)
    list.free(p.crowd)
    free(p.scratch)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
}
