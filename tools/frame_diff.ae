// Two frames compared channel by channel: how many of their red, green and
// blue channels differ, and by how much at the most (steps of 255).
//
//   ./build.sh tools/frame_diff.ae
//   ./build/frame_diff a.png b.png                       # exact: any difference fails
//   ./build/frame_diff a.png b.png --within 40 --over 4000
//
// Exits 0 when the frames are the same, or with --within/--over when no
// channel differs by more than `within` and no more than `over` differ at
// all; 1 when they differ past that, naming how; 2 when a frame cannot be
// read or the two are not the same size. scripts/frames_against.sh holds a
// change's frames to another commit's with it: exactly, except where a scene
// is not the same twice on the same commit (#793, #794), which it gives the
// tolerance that scene's issue measured.
import ae3d.picture
import std.os
import std.string

channel(pixels: ptr, index: int) -> int {
    bytes = pixels as byte[]
    return (bytes[index] as int) & 255
}

main() {
    if os.args_count() < 3 {
        println("usage: frame_diff a.png b.png [--within N --over M]")
        os.exit(2)
    }
    within = 0
    over = 0
    i = 3
    while i + 1 < os.args_count() {
        if os.args_get(i) == "--within" { within = string.get_int(os.args_get(i + 1)) }
        if os.args_get(i) == "--over" { over = string.get_int(os.args_get(i + 1)) }
        i = i + 2
    }
    a = picture.load(os.args_get(1))
    if a == null {
        println("frame_diff: ${os.args_get(1)}: ${picture.error()}")
        os.exit(2)
    }
    b = picture.load(os.args_get(2))
    if b == null {
        println("frame_diff: ${os.args_get(2)}: ${picture.error()}")
        picture.dispose(a)
        os.exit(2)
    }
    width = picture.width(a)
    height = picture.height(a)
    if picture.width(b) != width || picture.height(b) != height {
        println("frame_diff: ${width}x${height} against ${picture.width(b)}x${picture.height(b)}")
        picture.dispose(a)
        picture.dispose(b)
        os.exit(2)
    }
    pa = picture.pixels(a)
    pb = picture.pixels(b)
    differ = 0
    worst = 0
    p = 0
    while p < width * height {
        c = 0
        while c < 3 {
            gap = channel(pa, p * 4 + c) - channel(pb, p * 4 + c)
            if gap < 0 { gap = 0 - gap }
            if gap > 0 { differ = differ + 1 }
            if gap > worst { worst = gap }
            c = c + 1
        }
        p = p + 1
    }
    picture.dispose(a)
    picture.dispose(b)
    total = width * height * 3
    if differ == 0 {
        println("the same: ${total} channels")
        return
    }
    line = "${differ} of ${total} channels differ, worst ${worst}"
    if worst <= within && differ <= over {
        println("${line}: within ${within} on at most ${over}")
        return
    }
    if within == 0 && over == 0 {
        println("${line}")
    } else {
        println("${line}: past ${within} on at most ${over}")
    }
    os.exit(1)
}
