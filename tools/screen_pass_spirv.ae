// Writes examples/lib/screenpass_spirv, the Vulkan SPIR-V of the screen pass
// examples/screen_pass.ae draws and the shaders examples/screen_draws.ae
// queues, with ae3d.quotegen: what a program does for
// its own quoted passes, as tools/generate_shaders does for ae3d's. Run from
// the repository root after examples/lib/screenpass changes:
//
//     ./build.sh tools/screen_pass_spirv.ae && ./build/screen_pass_spirv

import std.os
import ae3d.quotegen
import ae3d.shaderlib (vec2, vec3)
import examples.lib.screenpass

main() {
    g = quotegen.begin("examples/lib/screenpass_spirv/module.ae", "examples/screen_pass.ae's pass and examples/screen_draws.ae's (examples/lib/screenpass)")
    quotegen.add(g, "rings", screenpass.rings(vec2(1.0, 1.0), 0.0))
    quotegen.add(g, "ball", screenpass.ball(vec3(1.0, 1.0, 1.0), 1.0))
    quotegen.add(g, "fill", screenpass.fill(vec3(1.0, 1.0, 1.0)))
    os.exit(quotegen.finish(g))
}
