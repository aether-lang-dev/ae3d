// The people plaza (#860): the plaza's crowd on the engine's new motion
// pipeline. The UE5 mannequin made a person in one call (ae3d.character) on
// 100STYLE's neutral gaits, each walking or running to goals across a matte
// plaza, its capsule solid so the people steer round each other (#956), its
// feet locked and stepping (ae3d.ikrig). Scored by ae3d.metrics, figure by
// figure, as it ends. The box men's plaza (tools/plaza_showcase.ae) stays
// beside it until this one carries its car and its falls.
//
//   ./build.sh tools/people_plaza.ae && ./build/people_plaza
//   AE3D_FIGURES=n (12)   AE3D_SEED=n   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png
//   AE3D_WATCH=k (follow person k from behind; unset, a slow orbit)
//   AE3D_WATCH_SIDE=1 (and from its side at knee height, to see its feet)
//   AE3D_EACH=1 (each person's worst and when, as it ends)
//   AE3D_METER_FROM=n (metered from step n, 60: a second in; later, to leave
//   the setting off out)
//   AE3D_TRACE=k (person k step by step: its feet, locks, contacts, blend)
//   AE3D_NOLOCK=1, AE3D_NOFEET=1 (feet unlocked, or no foot IK: the takes'
//   own feet, to tell a take's fault from the IK's)
//   AE3D_HASH=1 (each person's place, mover and drawn pose hashed, a line a
//   step: two runs of a seed compared line by line part at their first
//   differing step)
// A run with AE3D_FRAMES steps on a fixed tick, a frame a 60th of a second,
// so a seed reads the same every run (#983); AE3D_TICK=n another, AE3D_TICK=0
// the wall clock. Watched without AE3D_FRAMES it runs on the wall clock.
// (A burst of stills on the wall clock: a burst's frames are slow to write,
// and a quarter second of steps runs between two of them.)

import std.heap
import std.mem
import std.os
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.animator
import ae3d.character
import ae3d.mover
import ae3d.metrics
import ae3d.ikrig
import ae3d.pose

const MANNEQUIN = "tests/fixtures/people/mannequin.glb"
const GAITS = "tests/fixtures/people/100style/neutral"
const STOP = "tests/fixtures/people/100style/neutral_arrive.bvh"
const START = "tests/fixtures/people/100style/startstop_start.bvh"
const HALF = 9.0                       // metres: the plaza's half width
const WALK = 1.2
const RUN = 2.6
const ARRIVED = 0.6                    // metres from its goal it picks another
const MOST = 64

struct Crowd {
    people: ptr                        // ptr[MOST]: *Character
    meters: ptr                        // ptr[MOST]: *Meter
    goals: ptr                         // float[MOST * 2]: x, z
    paces: ptr                         // float[MOST]: the speed it goes to its goal at
    count: int
    steps: int                         // fixed steps run
    seed: int
    angle: float
    gaits: ptr                         // *Gaits
    closest: float                     // metres between the two nearest capsules' skins, at worst (#956)
    closest_step: int
    closest_a: int
    closest_b: int
    touching: int                      // steps two capsules touched
    was: ptr                           // float[MOST * 4]: each's place a step ago (x, z), the way it went then and whether it went (1)
    sharpest: float                    // radians a second the way a person goes turned at most, going 0.5 m/s and more
    sharpest_step: int
    sharpest_k: int
    // Each goal's errand (#973): a runner asked to a goal inside its turning
    // circle orbited it, never arrived, and ran off the floor.
    picked: ptr                        // float[MOST]: the step its goal was picked at
    straight: ptr                      // float[MOST]: seconds its goal is away in a straight line at its pace
    reached: ptr                       // float[MOST]: goals it has reached
    off_floor: ptr                     // float[MOST]: the step it left the floor at, 0 never
    slowest: float                     // a reached goal's time over its straight-line time, at worst
    slowest_k: int
    slowest_step: int
    tick: float                        // the fixed step's seconds
}

var g_crowd: ptr = null

next_seed(s: int) -> int { return (s * 1103515245 + 12345) & 2147483647 }
unit_of(s: int) -> float { return ((s % 100000) as float) / 100000.0 }

// A new goal for person `k`, standing at `at`, and whether it runs there (a
// quarter of the time).
pick_goal(cr: *Crowd, k: int, at: Vec3) {
    goals = cr.goals as float[]
    cr.seed = next_seed(cr.seed)
    goals[k * 2] = (unit_of(cr.seed) * 2.0 - 1.0) * (HALF - 1.0)
    cr.seed = next_seed(cr.seed)
    goals[k * 2 + 1] = (unit_of(cr.seed) * 2.0 - 1.0) * (HALF - 1.0)
    cr.seed = next_seed(cr.seed)
    pace = WALK
    if unit_of(cr.seed) < 0.25 { pace = RUN }
    (cr.paces as float[])[k] = pace
    dx = goals[k * 2] - at.x
    dz = goals[k * 2 + 1] - at.z
    (cr.picked as float[])[k] = cr.steps as float
    (cr.straight as float[])[k] = core.sqrt_of(dx * dx + dz * dz) / pace
}

// Person `k` reached its goal at step `cr.steps`: counted, and its time
// against the straight line's.
goal_reached(cr: *Crowd, k: int, dt: float) {
    (cr.reached as float[])[k] = (cr.reached as float[])[k] + 1.0
    ratio = errand_ratio(cr, k, dt)
    if ratio > cr.slowest {
        cr.slowest = ratio
        cr.slowest_k = k
        cr.slowest_step = cr.steps
    }
}

// The time person `k` has been on its errand over its straight-line time.
errand_ratio(cr: *Crowd, k: int, dt: float) -> float {
    took = ((cr.steps as float) - (cr.picked as float[])[k]) * dt
    straight = (cr.straight as float[])[k]
    if straight < 0.001 { straight = 0.001 }
    return took / straight
}

// Whether anyone has left the floor (past its half width): the step it did
// so first, kept.
floor_pass(cr: *Crowd) {
    people = cr.people as ptr[]
    off = cr.off_floor as float[]
    k = 0
    while k < cr.count {
        at = behaviour.object_position(character.object_of(people[k] as *Character))
        if off[k] < 0.5 && (core.abs_of(at.x) > HALF + 4.0 || core.abs_of(at.z) > HALF + 4.0) { off[k] = cr.steps as float }
        k = k + 1
    }
}

// The plaza's floor: a dark asphalt, rough, nothing reflected.
plaza_floor(e: *Engine) {
    o = engine.object(e, "Floor", loader.cube(1.0))
    behaviour.object_set_position(o, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(o, core.vec3(HALF * 2.0 + 8.0, 1.0, HALF * 2.0 + 8.0))
    physics.box_collider(o, core.vec3(HALF + 4.0, 0.5, HALF + 4.0), physics.material(0.8, 0.0))
    m = behaviour.object_model(o)
    if m != null {
        core.model_set_diffuse(m, 0.16, 0.16, 0.17)
        core.model_set_specular(m, 0.25, 0.25, 0.25)
        core.model_set_pbr(m, 0.0, 0.92)
        core.model_set_reflectivity(m, 0.0)
    }
}

start(state: ptr, e: *Engine) {
    cr = state as *Crowd
    physics.attach(e)
    plaza_floor(e)
    g = character.gaits(GAITS)
    character.gaits_set(g, character.GAIT_STOP, STOP)
    character.gaits_set(g, character.GAIT_START, START)
    cr.gaits = g as ptr
    people = cr.people as ptr[]
    meters = cr.meters as ptr[]
    k = 0
    while k < cr.count {
        c = character.humanoid(e, "Person", MANNEQUIN, g)
        if c == null {
            println("people_plaza: ${character.error()}")
            cr.count = k
            return
        }
        o = character.object_of(c)
        cr.seed = next_seed(cr.seed)
        x = (unit_of(cr.seed) * 2.0 - 1.0) * (HALF - 1.0)
        cr.seed = next_seed(cr.seed)
        z = (unit_of(cr.seed) * 2.0 - 1.0) * (HALF - 1.0)
        behaviour.object_set_position(o, core.vec3(x, 0.0, z))
        mover.settle(character.mover_of(c))
        physics.character_set_solid(physics.character_of(o), true)
        people[k] = c as ptr
        m = metrics.meter_new(animator.rig(character.animator_of(c)), o)
        metrics.meter_ground_physics(m, physics.of(e))
        metrics.meter_animator(m, character.animator_of(c))
        meters[k] = m as ptr
        if k == core.env_int("AE3D_TRACE", 0 - 1) { metrics.meter_trace(m) }
        if core.env_int("AE3D_NOLOCK", 0) == 1 { ikrig.feet_set_lock(animator.feet(character.animator_of(c)), false) }
        if core.env_int("AE3D_NOFEET", 0) == 1 { ikrig.feet_set_weight(animator.feet(character.animator_of(c)), 0.0) }
        pick_goal(cr, k, core.vec3(x, 0.0, z))
        k = k + 1
    }
}

fixed_update(state: ptr, e: *Engine, dt: float) {
    cr = state as *Crowd
    people = cr.people as ptr[]
    goals = cr.goals as float[]
    k = 0
    while k < cr.count {
        c = people[k] as *Character
        at = behaviour.object_position(character.object_of(c))
        to = core.vec3(goals[k * 2] - at.x, 0.0, goals[k * 2 + 1] - at.z)
        if core.v3_len(to) < ARRIVED {
            goal_reached(cr, k, dt)
            pick_goal(cr, k, at)
            to = core.vec3(goals[k * 2] - at.x, 0.0, goals[k * 2 + 1] - at.z)
        }
        character.move(c, core.v3_mul(core.v3_normalize(to), (cr.paces as float[])[k]), core.vec3(0.0, 0.0, 0.0))
        k = k + 1
    }
    // Measured at the fixed step, as the tests are, from a second on: read at
    // each drawn frame, a pose that changes once a step read as a turn of
    // hundreds of radians a second over a short frame, and the first frames
    // are each figure settling where it was put.
    cr.steps = cr.steps + 1
    cr.tick = dt
    // AE3D_TRACE=k: person k's place, speed and what its animator plays, a
    // line a step, to see what a figure whose feet look wrong is doing.
    tr = core.env_int("AE3D_TRACE", 0 - 1)
    if tr >= 0 && tr < cr.count {
        c = people[tr] as *Character
        a = character.animator_of(c)
        at = behaviour.object_position(character.object_of(c))
        v = mover.velocity(character.mover_of(c))
        ws = ""
        wk = 0
        while wk < 8 {
            ws = "${ws} ${animator.blend_weight(a, animator.current(a), wk)}"
            wk = wk + 1
        }
        ff = animator.feet(a)
        println("trace ${cr.steps} lock ${ikrig.feet_locked(ff, 0)} ${ikrig.feet_locked(ff, 1)} down ${animator.contact_weight(a, 0)} plant ${animator.plant_weight(a, 0)} miss ${ikrig.feet_miss(ff, 0)} w${ws} at ${at.x} ${at.z} speed ${core.v3_len(v)} state ${animator.state_name(a, animator.current(a))} t ${animator.state_time(a)} rate ${animator.rate(a, animator.current(a))} ground ${animator.ground_speed(a)}")
    }
    // The closest two capsules come (#956): the gap between their skins, the
    // worst over the run from a second on, and the steps they touched in;
    // and the sharpest a person's way turned, a shove's or a swerve's.
    if cr.steps > 60 { closest_pass(cr) }
    if cr.steps >= 60 { sharpest_pass(cr, dt) }
    floor_pass(cr)
    meters = cr.meters as ptr[]
    k = 0
    while k < cr.count {
        if cr.steps == core.env_int("AE3D_METER_FROM", 60) { metrics.meter_reset(meters[k] as *Meter) }
        if cr.steps > core.env_int("AE3D_METER_FROM", 60) { metrics.meter_take(meters[k] as *Meter, dt) }
        k = k + 1
    }
    // AE3D_HASH=1: each person's state hashed, a line a step, to find the
    // first step two runs of a seed part at (#983).
    if core.env_int("AE3D_HASH", 0) == 1 {
        line = "hash ${cr.steps}"
        k = 0
        while k < cr.count {
            line = "${line} ${person_hash(people[k] as *Character)}"
            k = k + 1
        }
        println(line)
    }
}

// A float's 64 bits folded into `h`.
hash_float(h: long, v: float) -> long {
    w = mem.bits_of_float(v)
    long g = (h * 1000003 + (w & 268435455)) & 1099511627775
    g = (g * 1000003 + ((w >> 28) & 268435455)) & 1099511627775
    return (g * 1000003 + ((w >> 56) & 255)) & 1099511627775
}

hash_vec(h: long, v: Vec3) -> long { return hash_float(hash_float(hash_float(h, v.x), v.y), v.z) }

// Person `c`'s place, turn, mover and every joint of its drawn pose, hashed.
person_hash(c: *Character) -> long {
    o = character.object_of(c)
    long h = hash_vec(17, behaviour.object_position(o))
    q = behaviour.object_rotation(o)
    h = hash_float(hash_float(hash_float(hash_float(h, q.x), q.y), q.z), q.w)
    m = character.mover_of(c)
    h = hash_vec(h, mover.velocity(m))
    h = hash_float(h, mover.facing_of(m))
    a = character.animator_of(c)
    p = animator.pose_shown(a)
    r = animator.rig(a)
    j = 0
    while j < pose.count(r) {
        h = hash_vec(h, pose.translation(p, j))
        jq = pose.rotation(p, j)
        h = hash_float(hash_float(hash_float(hash_float(h, jq.x), jq.y), jq.z), jq.w)
        j = j + 1
    }
    return h
}

// The sharpest turn of the way each person goes, read from where it is step
// to step: a capsule shoved by another's swings its way 45 degrees in three
// steps, a steering that swerves shows here too.
sharpest_pass(cr: *Crowd, dt: float) {
    people = cr.people as ptr[]
    was = cr.was as float[]
    k = 0
    while k < cr.count {
        at = behaviour.object_position(character.object_of(people[k] as *Character))
        dx = at.x - was[k * 4]
        dz = at.z - was[k * 4 + 1]
        way = core.atan2_of(dx, dz)
        going = cr.steps > 60 && core.sqrt_of(dx * dx + dz * dz) > 0.5 * dt
        if going && was[k * 4 + 3] > 0.5 {
            turn = way - was[k * 4 + 2]
            while turn > 3.141592653589793 { turn = turn - 6.283185307179586 }
            while turn < 0.0 - 3.141592653589793 { turn = turn + 6.283185307179586 }
            rate = core.abs_of(turn) / dt
            if rate > cr.sharpest {
                cr.sharpest = rate
                cr.sharpest_step = cr.steps
                cr.sharpest_k = k
            }
        }
        was[k * 4] = at.x
        was[k * 4 + 1] = at.z
        was[k * 4 + 2] = way
        was[k * 4 + 3] = 0.0
        if going { was[k * 4 + 3] = 1.0 }
        k = k + 1
    }
}

closest_pass(cr: *Crowd) {
    people = cr.people as ptr[]
    touched = false
    i = 0
    while i < cr.count {
        oi = character.object_of(people[i] as *Character)
        pi = behaviour.object_position(oi)
        ri = physics.character_radius(physics.character_of(oi))
        j = i + 1
        while j < cr.count {
            oj = character.object_of(people[j] as *Character)
            pj = behaviour.object_position(oj)
            dx = pj.x - pi.x
            dz = pj.z - pi.z
            gap = core.sqrt_of(dx * dx + dz * dz) - ri - physics.character_radius(physics.character_of(oj))
            if gap < 0.002 { touched = true }
            if gap < cr.closest {
                cr.closest = gap
                cr.closest_step = cr.steps
                cr.closest_a = i
                cr.closest_b = j
            }
            j = j + 1
        }
        i = i + 1
    }
    if touched { cr.touching = cr.touching + 1 }
}

update(state: ptr, e: *Engine, delta: float) {
    cr = state as *Crowd
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < cr.count {
        o = character.object_of((cr.people as ptr[])[watch] as *Character)
        at = behaviour.object_position(o)
        back = core.quat_apply(behaviour.object_rotation(o), core.vec3(0.0, 0.0, 0.0 - 1.0))
        if core.env_int("AE3D_WATCH_SIDE", 0) == 1 {
            // From its side at knee height, the feet's own view: a foot
            // sliding or held behind as the body goes shows here.
            back = core.quat_apply(behaviour.object_rotation(o), core.vec3(1.0, 0.0, 0.0))
            core.camera_set_position(cam, core.vec3(at.x + back.x * 2.6, 0.6, at.z + back.z * 2.6))
            core.camera_look_at(cam, core.vec3(at.x, 0.45, at.z))
            return
        }
        core.camera_set_position(cam, core.vec3(at.x + back.x * 3.5, 1.8, at.z + back.z * 3.5))
        core.camera_look_at(cam, core.vec3(at.x, 0.9, at.z))
        return
    }
    cr.angle = cr.angle + delta * 0.06
    core.camera_set_position(cam, core.vec3(17.0 * core.sin_of(cr.angle), 9.0, 17.0 * core.cos_of(cr.angle)))
    core.camera_look_at(cam, core.vec3(0.0, 0.5, 0.0))
}

// The crowd's score, as it ends: each person's worst, the worst of them.
report(cr: *Crowd) {
    meters = cr.meters as ptr[]
    people = cr.people as ptr[]
    skate = 0.0
    sunk = 0.0
    cross = 0.0
    pop = 0.0
    thrown = 0.0
    own = 0.0
    k = 0
    while k < cr.count {
        m = meters[k] as *Meter
        if metrics.meter_worst(m, metrics.SKATE) > skate { skate = metrics.meter_worst(m, metrics.SKATE) }
        if metrics.meter_worst(m, metrics.INTO_GROUND) > sunk { sunk = metrics.meter_worst(m, metrics.INTO_GROUND) }
        if metrics.meter_worst(m, metrics.FEET_CROSS) > cross { cross = metrics.meter_worst(m, metrics.FEET_CROSS) }
        if metrics.meter_worst(m, metrics.POP) > pop { pop = metrics.meter_worst(m, metrics.POP) }
        if metrics.meter_worst(m, metrics.FOOT_THROW) > thrown { thrown = metrics.meter_worst(m, metrics.FOOT_THROW) }
        f = metrics.animator_fastest(character.animator_of(people[k] as *Character))
        if f > own { own = f }
        if core.env_int("AE3D_EACH", 0) == 1 { println("  person ${k}: skate ${metrics.meter_worst(m, metrics.SKATE) * 1000.0} mm at ${metrics.meter_when(m, metrics.SKATE)} s, cross ${metrics.meter_worst(m, metrics.FEET_CROSS) * 1000.0} mm at ${metrics.meter_when(m, metrics.FEET_CROSS)} s, pop ${metrics.meter_worst(m, metrics.POP)} (${pose.name(animator.rig(character.animator_of(people[k] as *Character)), metrics.meter_joint(m, metrics.POP))}) at ${metrics.meter_when(m, metrics.POP)} s, thrown ${metrics.meter_worst(m, metrics.FOOT_THROW)} at ${metrics.meter_when(m, metrics.FOOT_THROW)} s") }
        k = k + 1
    }
    println("people plaza: ${cr.count} people; a toe skating ${skate * 1000.0} mm at worst, a sole ${sunk * 1000.0} mm into the ground, a foot ${cross * 1000.0} mm past the hips' middle (below 0, never); the fastest joint ${pop} rad/s, the takes' own ${own}; a toe thrown ${thrown} m/s faster than its clip has it")
    println("people plaza: two capsules ${cr.closest * 1000.0} mm apart at the closest (persons ${cr.closest_a} and ${cr.closest_b}, step ${cr.closest_step}), touching in ${cr.touching} steps; a way turned ${cr.sharpest} rad/s at the sharpest (person ${cr.sharpest_k}, step ${cr.sharpest_step})")
    errands_report(cr)
    hz = core.env_int("AE3D_TICK", 0)
    if hz > 0 {
        println("people plaza: on a fixed tick of 1/${hz} s a frame: a seed reads the same every run")
    } else {
        println("people plaza: on the wall clock: the numbers move run to run (#983); AE3D_TICK=60 repeats them")
    }
}

// Goals reached, the slowest against its straight line, the goals still
// open past twice theirs, and anyone off the floor (#973).
errands_report(cr: *Crowd) {
    reached = cr.reached as float[]
    off = cr.off_floor as float[]
    each = ""
    total = 0
    late = 0
    latest = 0.0
    latest_k = 0 - 1
    gone = 0
    k = 0
    while k < cr.count {
        n = reached[k] as int
        each = "${each} ${n}"
        total = total + n
        open = errand_ratio(cr, k, cr.tick)
        if open > 2.0 { late = late + 1 }
        if open > latest {
            latest = open
            latest_k = k
        }
        if off[k] > 0.5 {
            gone = gone + 1
            println("people plaza: person ${k} left the floor at step ${off[k] as int}")
        }
        k = k + 1
    }
    println("people plaza: ${total} goals reached (each:${each}); the slowest took ${cr.slowest} times its straight-line time (person ${cr.slowest_k}, step ${cr.slowest_step}); ${late} goals still open past twice theirs (the longest ${latest} times, person ${latest_k}); ${gone} people left the floor")
}

main() {
    // A run that ends on its own (AE3D_FRAMES) is a scored one, stepped on
    // the fixed tick, a frame a step, unless AE3D_TICK says otherwise
    // (AE3D_TICK=0, the wall clock) (#983). On the wall clock the figures
    // are posed once a frame by the frame's own seconds, and the steps a
    // frame runs (none, one, two) follow the machine: seed 2's fastest joint
    // read 19.7 and 22.0 rad/s, its foot throw 1.59 and 1.75 m/s, two runs
    // of one build. Watched (no AE3D_FRAMES), it keeps the wall clock.
    ticked = os.getenv("AE3D_TICK")
    if ticked == null {
        if core.env_int("AE3D_FRAMES", 0) > 0 { os.setenv("AE3D_TICK", "60") }
    } else {
        string.free(ticked)
    }
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - people plaza")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_light(e, core.light_sun(core.vec3(0.4, 0.8, 0.3)))
    engine.engine_set_time_of_day(e, 16.8)
    cr = heap.new(Crowd)
    cr.count = core.env_int("AE3D_FIGURES", 12)
    if cr.count > MOST { cr.count = MOST }
    if cr.count < 1 { cr.count = 1 }
    cr.seed = 7919 + 104729 * core.env_int("AE3D_SEED", 0)
    cr.people = calloc(MOST, 8)
    cr.meters = calloc(MOST, 8)
    cr.goals = calloc(MOST * 2, 8)
    cr.paces = calloc(MOST, 8)
    cr.closest = 1000.0
    cr.was = calloc(MOST * 4, 8)
    cr.picked = calloc(MOST, 8)
    cr.straight = calloc(MOST, 8)
    cr.reached = calloc(MOST, 8)
    cr.off_floor = calloc(MOST, 8)
    cr.tick = 1.0 / 60.0
    g_crowd = cr as ptr
    b = engine.behaviour_new("people_plaza", cr as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(cr)
}
