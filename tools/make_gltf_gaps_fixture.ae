// Write the glTF fixtures for what the reader gained in #868: a .gltf with
// its buffer and its image as base64 data: URIs and sparse accessors, and a
// .glb with two PNG images in buffer views of its binary chunk.
//
// Both are the same square, two units tall and two wide, in the z = 0 plane:
//
//   v3 (-1,2,0)  v2 (1,2,0)
//   v0 (-1,0,0)  v1 (1,0,0)
//
// The .gltf (tests/fixtures/gltf/sparse_data.gltf) states it with sparse
// accessors, so a reader that ignores them draws a different square:
//
//   POSITION  a buffer view whose v1 and v3 are wrong (9,9,9), and sparse
//             unsigned-byte indices [1, 3] with the right values;
//   NORMAL    no buffer view at all (all zeros) and sparse unsigned-short
//             indices [1, 2, 300] giving (0,0,1) -- v0 and v3 stay zero;
//   TEXCOORD_0 a buffer view of (0,0) for v0 and v1 and wrong for v2 and v3,
//             and sparse unsigned-int indices [2, 3, 301] with (1,1), (0,1)
//             and (0.75, 0.25).
//
// There are 305 vertices, 301 of them unused after the square's four, so that
// the indices 300 and 301 need more than a byte, and the buffer ends in six
// bytes whose base64 is "++++////".
//
// tests/fixtures/gltf/sparse_bad.gltf is the same with the normals' third index 4000,
// an element the accessor does not have: the reader must refuse it.
//
// The buffer is a data:application/octet-stream;base64 URI, and the base
// colour is a 2x2 PNG (red, green / blue, white) as a data:image/png URI.
//
// The .glb (tests/fixtures/gltf/embedded.glb) has plain accessors and two
// images in views of its binary chunk: the base colour's (the 2x2 above) and
// the normal map's, 1x1 and flat (128,128,255).
//
//     ./build.sh tools/make_gltf_gaps_fixture.ae && ./build/make_gltf_gaps_fixture tests/fixtures/gltf
import std.os
import std.string
import std.mem
import ae3d.blob
import ae3d.png

extern malloc(size: long) -> ptr
extern free(p: ptr)
extern fopen(path: string, mode: string) -> ptr
extern fwrite(buffer: ptr, size: long, count: long, f: ptr) -> long
extern fclose(f: ptr) -> int
extern remove(path: string) -> int

const CAPACITY = 16384
// The sparse .gltf's vertices: the square's four and 301 unused ones after them,
// so that sparse indices past 255 (an unsigned short, an unsigned int) are read
// whole, not by their low byte.
const SPARSE_VERTICES = 305

// The binary the .gltf's views are cut from, and where the next piece goes.
var g_blob: ptr = null
var g_size = 0

align4() {
    while g_size % 4 != 0 {
        mem.set_uint8(g_blob, g_size, 0)
        g_size = g_size + 1
    }
}

put_u8(v: int) {
    mem.set_uint8(g_blob, g_size, v)
    g_size = g_size + 1
}

put_u16(v: int) {
    put_u8(v & 255)
    put_u8((v >> 8) & 255)
}

put_u32(v: int) {
    put_u16(v & 65535)
    put_u16((v >> 16) & 65535)
}

put_f32(v: float) {
    mem.set_float32(g_blob, g_size, v)
    g_size = g_size + 4
}

put_vec3(x: float, y: float, z: float) {
    put_f32(x)
    put_f32(y)
    put_f32(z)
}

// base64 of `count` bytes at `data`, padded (RFC 4648 section 4).
base64(data: ptr, count: int) -> string {
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out = ""
    i = 0
    while i < count {
        b0 = mem.get_uint8(data, i)
        have1 = i + 1 < count
        have2 = i + 2 < count
        b1 = 0
        b2 = 0
        if have1 { b1 = mem.get_uint8(data, i + 1) }
        if have2 { b2 = mem.get_uint8(data, i + 2) }
        n = (b0 << 16) | (b1 << 8) | b2
        out = string.concat(out, string.substring(alphabet, (n >> 18) & 63, ((n >> 18) & 63) + 1))
        out = string.concat(out, string.substring(alphabet, (n >> 12) & 63, ((n >> 12) & 63) + 1))
        if have1 {
            out = string.concat(out, string.substring(alphabet, (n >> 6) & 63, ((n >> 6) & 63) + 1))
        } else {
            out = string.concat(out, "=")
        }
        if have2 {
            out = string.concat(out, string.substring(alphabet, n & 63, (n & 63) + 1))
        } else {
            out = string.concat(out, "=")
        }
        i = i + 3
    }
    return out
}

write_bytes(path: string, data: ptr, count: int) {
    f = fopen(path, "wb")
    if f == null {
        println("make_gltf_gaps_fixture: cannot write ${path}")
        os.exit(1)
    }
    fwrite(data, 1 as long, count as long, f)
    fclose(f)
}

write_text(path: string, text: string) {
    f = fopen(path, "wb")
    if f == null {
        println("make_gltf_gaps_fixture: cannot write ${path}")
        os.exit(1)
    }
    fwrite(text, 1 as long, string.length(text) as long, f)
    fclose(f)
}

// A PNG of the given RGBA pixels, as the file png.write makes, read back.
var g_png_size = 0
png_bytes(rgba: ptr, width: int, height: int, scratch: string) -> ptr {
    if !png.write(scratch, rgba, width, height) {
        println("make_gltf_gaps_fixture: cannot write ${scratch}")
        os.exit(1)
    }
    data = blob.read(scratch)
    g_png_size = blob.last_size() as int
    remove(scratch)
    return data
}

pixel(rgba: ptr, index: int, r: int, g: int, b: int) {
    mem.set_uint8(rgba, index * 4, r)
    mem.set_uint8(rgba, index * 4 + 1, g)
    mem.set_uint8(rgba, index * 4 + 2, b)
    mem.set_uint8(rgba, index * 4 + 3, 255)
}

// The 2x2 base colour image: red, green on the bottom row of the file's
// pixels' order, blue, white on the next.
colour_png(scratch: string) -> ptr {
    rgba = malloc(16 as long)
    pixel(rgba, 0, 255, 0, 0)
    pixel(rgba, 1, 0, 255, 0)
    pixel(rgba, 2, 0, 0, 255)
    pixel(rgba, 3, 255, 255, 255)
    data = png_bytes(rgba, 2, 2, scratch)
    free(rgba)
    return data
}

normal_png(scratch: string) -> ptr {
    rgba = malloc(4 as long)
    pixel(rgba, 0, 128, 128, 255)
    data = png_bytes(rgba, 1, 1, scratch)
    free(rgba)
    return data
}

// ---------------------------------------------------------------------------

write_sparse_gltf(directory: string, name: string, bad: bool) {
    g_blob = malloc(CAPACITY as long)
    g_size = 0

    // View 0: POSITION's base, v1 and v3 wrong.
    put_vec3(0.0 - 1.0, 0.0, 0.0)
    put_vec3(9.0, 9.0, 9.0)
    put_vec3(1.0, 2.0, 0.0)
    put_vec3(9.0, 9.0, 9.0)
    i = 4
    while i < SPARSE_VERTICES { put_vec3(0.0, 0.0, 0.0); i = i + 1 }
    // View 1: its sparse indices (unsigned bytes), view 2 its values.
    index_bytes_at = g_size
    put_u8(1)
    put_u8(3)
    align4()
    values_at = g_size
    put_vec3(1.0, 0.0, 0.0)
    put_vec3(0.0 - 1.0, 2.0, 0.0)
    // View 3: TEXCOORD_0's base; v2 and v3 wrong.
    uv_at = g_size
    put_f32(0.0)
    put_f32(0.0)
    put_f32(1.0)
    put_f32(0.0)
    put_f32(0.5)
    put_f32(0.5)
    put_f32(0.5)
    put_f32(0.5)
    i = 4
    while i < SPARSE_VERTICES { put_f32(0.25); put_f32(0.75); i = i + 1 }
    // View 4: its sparse indices (unsigned ints), view 5 its values.
    uv_index_at = g_size
    put_u32(2)
    put_u32(3)
    put_u32(301)
    uv_values_at = g_size
    put_f32(1.0)
    put_f32(1.0)
    put_f32(0.0)
    put_f32(1.0)
    put_f32(0.75)
    put_f32(0.25)
    // View 6: NORMAL's sparse indices (unsigned shorts), view 7 its values.
    normal_index_at = g_size
    put_u16(1)
    put_u16(2)
    if bad { put_u16(4000) } else { put_u16(300) }
    align4()
    normal_values_at = g_size
    put_vec3(0.0, 0.0, 1.0)
    put_vec3(0.0, 0.0, 1.0)
    put_vec3(0.0, 0.0, 1.0)
    // View 8: the triangles.
    triangles_at = g_size
    put_u16(0)
    put_u16(1)
    put_u16(2)
    put_u16(0)
    put_u16(2)
    put_u16(3)
    align4()
    // Six bytes nothing reads, whose base64 is "++++////": the two characters
    // the alphabet ends on, which a table with them wrong would reject.
    while g_size % 3 != 0 { put_u8(0) }
    put_u8(251)
    put_u8(239)
    put_u8(190)
    put_u8(255)
    put_u8(255)
    put_u8(255)

    pixels = colour_png("${directory}/.sparse_colour.png")
    image_size = g_png_size
    image_uri = string.concat("data:image/png;base64,", base64(pixels, image_size))
    free(pixels)
    buffer_uri = string.concat("data:application/octet-stream;base64,", base64(g_blob, g_size))

    text = "{\n"
    text = string.concat(text, "  \"asset\": {\"version\": \"2.0\", \"generator\": \"ae3d tools/make_gltf_gaps_fixture.ae\"},\n")
    text = string.concat(text, "  \"scene\": 0, \"scenes\": [{\"nodes\": [0]}],\n")
    text = string.concat(text, "  \"nodes\": [{\"name\": \"Square\", \"mesh\": 0}],\n")
    text = string.concat(text, "  \"meshes\": [{\"primitives\": [{\"attributes\": {\"POSITION\": 0, \"NORMAL\": 1, \"TEXCOORD_0\": 2}, \"indices\": 3, \"material\": 0}]}],\n")
    text = string.concat(text, "  \"materials\": [{\"pbrMetallicRoughness\": {\"baseColorTexture\": {\"index\": 0}, \"metallicFactor\": 0.0, \"roughnessFactor\": 0.5}}],\n")
    text = string.concat(text, "  \"textures\": [{\"source\": 0}],\n")
    text = string.concat(text, "  \"images\": [{\"mimeType\": \"image/png\", \"uri\": \"${image_uri}\"}],\n")
    text = string.concat(text, "  \"buffers\": [{\"byteLength\": ${g_size}, \"uri\": \"${buffer_uri}\"}],\n")
    text = string.concat(text, "  \"bufferViews\": [\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": 0, \"byteLength\": ${SPARSE_VERTICES * 12}},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${index_bytes_at}, \"byteLength\": 2},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${values_at}, \"byteLength\": 24},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${uv_at}, \"byteLength\": ${SPARSE_VERTICES * 8}},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${uv_index_at}, \"byteLength\": 12},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${uv_values_at}, \"byteLength\": 24},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${normal_index_at}, \"byteLength\": 6},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${normal_values_at}, \"byteLength\": 36},\n")
    text = string.concat(text, "    {\"buffer\": 0, \"byteOffset\": ${triangles_at}, \"byteLength\": 12}\n")
    text = string.concat(text, "  ],\n")
    text = string.concat(text, "  \"accessors\": [\n")
    text = string.concat(text, "    {\"bufferView\": 0, \"componentType\": 5126, \"count\": ${SPARSE_VERTICES}, \"type\": \"VEC3\", \"min\": [-1, 0, 0], \"max\": [1, 2, 0],\n")
    text = string.concat(text, "     \"sparse\": {\"count\": 2, \"indices\": {\"bufferView\": 1, \"componentType\": 5121}, \"values\": {\"bufferView\": 2}}},\n")
    text = string.concat(text, "    {\"componentType\": 5126, \"count\": ${SPARSE_VERTICES}, \"type\": \"VEC3\",\n")
    text = string.concat(text, "     \"sparse\": {\"count\": 3, \"indices\": {\"bufferView\": 6, \"componentType\": 5123}, \"values\": {\"bufferView\": 7}}},\n")
    text = string.concat(text, "    {\"bufferView\": 3, \"componentType\": 5126, \"count\": ${SPARSE_VERTICES}, \"type\": \"VEC2\",\n")
    text = string.concat(text, "     \"sparse\": {\"count\": 3, \"indices\": {\"bufferView\": 4, \"componentType\": 5125}, \"values\": {\"bufferView\": 5}}},\n")
    text = string.concat(text, "    {\"bufferView\": 8, \"componentType\": 5123, \"count\": 6, \"type\": \"SCALAR\"}\n")
    text = string.concat(text, "  ]\n}\n")
    write_text("${directory}/${name}", text)
    free(g_blob)
}

write_embedded_glb(directory: string) {
    g_blob = malloc(CAPACITY as long)
    g_size = 0
    put_vec3(0.0 - 1.0, 0.0, 0.0)
    put_vec3(1.0, 0.0, 0.0)
    put_vec3(1.0, 2.0, 0.0)
    put_vec3(0.0 - 1.0, 2.0, 0.0)
    normals_at = g_size
    put_vec3(0.0, 0.0, 1.0)
    put_vec3(0.0, 0.0, 1.0)
    put_vec3(0.0, 0.0, 1.0)
    put_vec3(0.0, 0.0, 1.0)
    uv_at = g_size
    put_f32(0.0)
    put_f32(0.0)
    put_f32(1.0)
    put_f32(0.0)
    put_f32(1.0)
    put_f32(1.0)
    put_f32(0.0)
    put_f32(1.0)
    triangles_at = g_size
    put_u16(0)
    put_u16(1)
    put_u16(2)
    put_u16(0)
    put_u16(2)
    put_u16(3)
    align4()
    colour_at = g_size
    colour = colour_png("${directory}/.embedded_colour.png")
    colour_size = g_png_size
    i = 0
    while i < colour_size { put_u8(mem.get_uint8(colour, i)); i = i + 1 }
    blob.free_bytes(colour)
    align4()
    normal_map_at = g_size
    normal_map = normal_png("${directory}/.embedded_normal.png")
    normal_map_size = g_png_size
    i = 0
    while i < normal_map_size { put_u8(mem.get_uint8(normal_map, i)); i = i + 1 }
    blob.free_bytes(normal_map)
    align4()

    text = "{\"asset\": {\"version\": \"2.0\", \"generator\": \"ae3d tools/make_gltf_gaps_fixture.ae\"},"
    text = string.concat(text, "\"scene\": 0, \"scenes\": [{\"nodes\": [0]}], \"nodes\": [{\"name\": \"Square\", \"mesh\": 0}],")
    text = string.concat(text, "\"meshes\": [{\"primitives\": [{\"attributes\": {\"POSITION\": 0, \"NORMAL\": 1, \"TEXCOORD_0\": 2}, \"indices\": 3, \"material\": 0}]}],")
    text = string.concat(text, "\"materials\": [{\"pbrMetallicRoughness\": {\"baseColorTexture\": {\"index\": 0}, \"metallicFactor\": 0.0, \"roughnessFactor\": 0.5}, \"normalTexture\": {\"index\": 1}}],")
    text = string.concat(text, "\"textures\": [{\"source\": 0}, {\"source\": 1}],")
    text = string.concat(text, "\"images\": [{\"mimeType\": \"image/png\", \"bufferView\": 4}, {\"mimeType\": \"image/png\", \"bufferView\": 5}],")
    text = string.concat(text, "\"buffers\": [{\"byteLength\": ${g_size}}],")
    text = string.concat(text, "\"bufferViews\": [{\"buffer\": 0, \"byteOffset\": 0, \"byteLength\": 48}, {\"buffer\": 0, \"byteOffset\": ${normals_at}, \"byteLength\": 48},")
    text = string.concat(text, "{\"buffer\": 0, \"byteOffset\": ${uv_at}, \"byteLength\": 32}, {\"buffer\": 0, \"byteOffset\": ${triangles_at}, \"byteLength\": 12},")
    text = string.concat(text, "{\"buffer\": 0, \"byteOffset\": ${colour_at}, \"byteLength\": ${colour_size}}, {\"buffer\": 0, \"byteOffset\": ${normal_map_at}, \"byteLength\": ${normal_map_size}}],")
    text = string.concat(text, "\"accessors\": [{\"bufferView\": 0, \"componentType\": 5126, \"count\": 4, \"type\": \"VEC3\", \"min\": [-1, 0, 0], \"max\": [1, 2, 0]},")
    text = string.concat(text, "{\"bufferView\": 1, \"componentType\": 5126, \"count\": 4, \"type\": \"VEC3\"}, {\"bufferView\": 2, \"componentType\": 5126, \"count\": 4, \"type\": \"VEC2\"},")
    text = string.concat(text, "{\"bufferView\": 3, \"componentType\": 5123, \"count\": 6, \"type\": \"SCALAR\"}]}")
    json_size = string.length(text)
    json_padded = (json_size + 3) / 4 * 4
    total = 12 + 8 + json_padded + 8 + g_size
    head = malloc((28 + json_padded) as long)
    mem.set_uint32(head, 0, 1179937895 as long)         // "glTF"
    mem.set_uint32(head, 4, 2 as long)
    mem.set_uint32(head, 8, total as long)
    mem.set_uint32(head, 12, json_padded as long)
    mem.set_uint32(head, 16, 1313821514 as long)        // "JSON"
    i = 0
    while i < json_size { mem.set_uint8(head, 20 + i, string.char_at(text, i)); i = i + 1 }
    while i < json_padded { mem.set_uint8(head, 20 + i, 32); i = i + 1 }
    mem.set_uint32(head, 20 + json_padded, g_size as long)
    mem.set_uint32(head, 24 + json_padded, 5130562 as long)   // "BIN\0"
    f = fopen("${directory}/embedded.glb", "wb")
    if f == null {
        println("make_gltf_gaps_fixture: cannot write ${directory}/embedded.glb")
        os.exit(1)
    }
    fwrite(head, 1 as long, (28 + json_padded) as long, f)
    fwrite(g_blob, 1 as long, g_size as long, f)
    fclose(f)
    free(head)
    free(g_blob)
}

main() {
    directory = "tests/fixtures/gltf"
    if os.args_count() > 1 { directory = os.args_get(1) }
    write_sparse_gltf(directory, "sparse_data.gltf", false)
    write_sparse_gltf(directory, "sparse_bad.gltf", true)
    write_embedded_glb(directory)
    println("make_gltf_gaps_fixture: wrote sparse_data.gltf, sparse_bad.gltf and embedded.glb in ${directory}")
}
