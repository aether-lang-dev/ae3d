// A new game on ae3d, from nothing (#508): the folder, its manifest, a scene
// in a program, and one script.
//
//     ./build.sh tools/new_game.ae && ./build/new_game ../my_game "My Game"
//
// The game is a repository of its own with ae3d at ext/ae3d (a git submodule),
// as docs/building.md describes, so what is written is what that page says a
// game has:
//
//     my_game/aether.toml          ae3d and aephysics as dependencies, patched to ext/
//     my_game/main.ae              the program: a window, a sun, the ground, crates that
//                                  fall on it, and a lamp turning on its script
//     my_game/scripts/spinner.ae   the script: its struct says its fields (@derive(schema))
//     my_game/README.md            how to build it, run it, and give an object a script
//     my_game/.gitignore           build/
//
// It writes nothing over a file that is there: a folder that already holds a
// game is a mistake to say, not one to finish.

import std.fs
import std.os
import std.string

extern exit(code: int)

manifest(name: string) -> string {
    text = "# ${name}: a game on ae3d, which is checked out at ext/ae3d\n"
    text = string.concat(text, "# (git submodule add https://github.com/aether-lang-dev/ae3d ext/ae3d).\n")
    text = string.concat(text, "# What the two patches and the cflags are for: ext/ae3d/docs/building.md.\n\n")
    // The package's name is a word: the title lowercased, its spaces underscores.
    package = string.to_lower(string.replace_all(name, " ", "_"))
    text = string.concat(text, "[package]\nname = \"${package}\"\n\n")
    text = string.concat(text, "[dependencies]\n\"github.com/aether-lang-dev/ae3d\" = \"0.1.0\"\n\"github.com/aether-lang-dev/aephysics\" = \"0.1.0\"\n\n")
    text = string.concat(text, "[patch]\n\"github.com/aether-lang-dev/ae3d\" = \"ext/ae3d\"\n\"github.com/aether-lang-dev/aephysics\" = \"ext/ae3d/deps/aephysics\"\n\n")
    text = string.concat(text, "[build]\ncflags = \"-ffp-contract=off\"\n")
    return text
}

program(name: string) -> string {
    text = "// ${name}: the scene, built in code, and the scripts compiled in.\n//\n"
    text = string.concat(text, "// Each script in scripts/ is a component kind: its struct's schema gives the\n")
    text = string.concat(text, "// fields, and its phases are the functions it defines. The same file builds as a\n")
    text = string.concat(text, "// library the editor attaches and reloads (ext/ae3d/scripts/build_script.sh).\n\n")
    text = string.concat(text, "import ae3d.core\nimport ae3d.engine\nimport ae3d.behaviour\nimport ae3d.component\nimport ae3d.loader\nimport ae3d.physics\n")
    text = string.concat(text, "import scripts.spinner\n\n")
    text = string.concat(text, "// The camera is the window's, made as it opens: aimed once it is.\n")
    text = string.concat(text, "aim_camera(state: ptr, e: *Engine) {\n")
    text = string.concat(text, "    cam = engine.engine_camera(e)\n")
    text = string.concat(text, "    core.camera_set_position(cam, core.vec3(0.0, 8.0, 22.0))\n")
    text = string.concat(text, "    core.camera_look_at(cam, core.vec3(0.0, 1.0, 0.0))\n")
    text = string.concat(text, "}\n\n")
    text = string.concat(text, "main() {\n")
    text = string.concat(text, "    e = engine.engine_new()\n")
    text = string.concat(text, "    engine.engine_set_size(e, 1280, 720)\n")
    text = string.concat(text, "    engine.engine_set_title(e, \"${name}\")\n")
    text = string.concat(text, "    sun = core.light_sun(core.vec3(0.4, 0.8, 0.5))\n")
    text = string.concat(text, "    engine.engine_set_light(e, sun)\n")
    text = string.concat(text, "    physics.attach(e)\n")
    text = string.concat(text, "    camera = engine.behaviour_new(\"camera\", null)\n")
    text = string.concat(text, "    camera.start = aim_camera\n")
    text = string.concat(text, "    engine.engine_add_behaviour(e, camera)\n\n")
    text = string.concat(text, "    // The scripts, as kinds: what Add Component lists and a scene file names.\n")
    text = string.concat(text, "    spin = component.schema_kind(\"Spinner\", \"Gameplay\", spinner.Spinner_schema())\n")
    text = string.concat(text, "    component.phases(spin, null, spinner.update, null, null)\n\n")
    text = string.concat(text, "    stone = physics.material(0.7, 0.0)\n")
    text = string.concat(text, "    ground = engine.object(e, \"Ground\", loader.cube(1.0))\n")
    text = string.concat(text, "    core.model_set_scale(behaviour.object_model(ground), 40.0, 1.0, 40.0)\n")
    text = string.concat(text, "    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))\n")
    text = string.concat(text, "    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), stone)\n\n")
    text = string.concat(text, "    // Crates dropped on the ground, a sandbox's first things to knock over.\n")
    text = string.concat(text, "    i = 0\n    while i < 6 {\n")
    text = string.concat(text, "        crate = engine.object(e, \"Crate \${i}\", loader.cube(1.0))\n")
    text = string.concat(text, "        behaviour.object_set_position(crate, core.vec3(((i % 3) as float) * 1.5 - 1.5, 3.0 + (i as float) * 1.2, 0.0))\n")
    text = string.concat(text, "        physics.rigidbody(crate, physics.DYNAMIC)\n")
    text = string.concat(text, "        physics.box_collider(crate, core.vec3(0.5, 0.5, 0.5), stone)\n")
    text = string.concat(text, "        i = i + 1\n    }\n\n")
    text = string.concat(text, "    lamp = engine.object(e, \"Lamp\", loader.cube(1.0))\n")
    text = string.concat(text, "    behaviour.object_set_position(lamp, core.vec3(5.0, 1.0, 0.0))\n")
    text = string.concat(text, "    component.add(lamp, spin)\n\n")
    text = string.concat(text, "    engine.engine_run(e)\n")
    text = string.concat(text, "    core.light_free(sun)\n")
    text = string.concat(text, "    engine.engine_free(e)\n")
    text = string.concat(text, "}\n")
    return text
}

script() -> string {
    text = "// Turn about the up axis.\n//\n"
    text = string.concat(text, "// A script is a component: a Spinner for every object it is on, the fields its\n")
    text = string.concat(text, "// struct declares (shown in the inspector, saved with the scene), and the\n")
    text = string.concat(text, "// phases it defines, each optional: awake, on_enable, start, update,\n")
    text = string.concat(text, "// fixed_update, late_update, on_disable, on_destroy, on_collision_enter,\n")
    text = string.concat(text, "// _stay and _exit, on_trigger_enter, _stay and _exit, on_net_spawn.\n//\n")
    text = string.concat(text, "// The phase takes its state as a ptr so the file serves both a program that\n")
    text = string.concat(text, "// compiles it in and the editor that loads it; one only ever loaded may take\n")
    text = string.concat(text, "// it typed (update(s: *Spinner, ...)).\n\n")
    text = string.concat(text, "import ae3d.core\nimport ae3d.behaviour\nimport ae3d.component\n\n")
    text = string.concat(text, "exports (Spinner, Spinner_schema, update)\n\n")
    text = string.concat(text, "@derive(schema)\n")
    text = string.concat(text, "struct Spinner {\n")
    text = string.concat(text, "    speed: float @range(-360.0, 360.0) @default(45.0) @tooltip(\"Degrees a second; negative turns the other way.\")\n")
    text = string.concat(text, "}\n\n")
    text = string.concat(text, "update(p: ptr, go: *GameObject, delta: float) {\n")
    text = string.concat(text, "    s = p as *Spinner\n")
    text = string.concat(text, "    core.model_rotate(behaviour.object_model(go), 0.0, delta * s.speed, 0.0)\n")
    text = string.concat(text, "}\n")
    return text
}

readme(name: string) -> string {
    text = "# ${name}\n\nA game on [ae3d](https://github.com/aether-lang-dev/ae3d).\n\n"
    text = string.concat(text, "```bash\ngit init && git submodule add https://github.com/aether-lang-dev/ae3d ext/ae3d\n")
    text = string.concat(text, "git -C ext/ae3d submodule update --init     # aephysics\n")
    text = string.concat(text, "AE3D_ROOT=ext/ae3d ae run main.ae\n```\n\n")
    text = string.concat(text, "`scripts/` holds the game's scripts, one component a file, named for it\n")
    text = string.concat(text, "(`spinner.ae` declares `Spinner`). A new one is registered in `main.ae` as\n")
    text = string.concat(text, "`Spinner` is, or built as a library the editor attaches:\n\n")
    text = string.concat(text, "```bash\next/ae3d/scripts/build_script.sh scripts/spinner.ae    # -> build/scripts/spinner\n```\n\n")
    text = string.concat(text, "Writing scripts: `ext/ae3d/docs/scripting.md`.\n")
    return text
}

// The file at `path`, or a word on why not and false.
write_new(path: string, text: string) -> bool {
    if fs.exists(path) == 1 {
        println("new_game: ${path} is there already; nothing is written over it")
        return false
    }
    err = fs.write(path, text)
    if err != "" {
        println("new_game: ${path}: ${err}")
        return false
    }
    println("  wrote ${path}")
    return true
}

main() {
    if os.args_count() < 2 {
        println("usage: new_game <folder> [name]")
        exit(2)
    }
    dir = os.args_get(1)
    name = "game"
    if os.args_count() >= 3 { name = os.args_get(2) }
    made = fs.mkdir_p("${dir}/scripts")
    if made != "" {
        println("new_game: ${dir}/scripts: ${made}")
        exit(1)
    }
    ok = write_new("${dir}/aether.toml", manifest(name))
    ok = write_new("${dir}/main.ae", program(name)) && ok
    ok = write_new("${dir}/scripts/spinner.ae", script()) && ok
    ok = write_new("${dir}/README.md", readme(name)) && ok
    ok = write_new("${dir}/.gitignore", "build/\n") && ok
    if !ok { exit(1) }
    println("new_game: ${name} in ${dir}; see its README.md")
}
