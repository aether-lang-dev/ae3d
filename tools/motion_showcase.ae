// The motion showcase (#509, part of): ae3d.motion's reactions side by
// side, shoved again every CYCLE seconds, for a person -- or the agent loop
// -- to watch. Not a test and not an example: ci.sh never builds it.
//
//   ./build.sh tools/motion_showcase.ae && ./build/motion_showcase
//   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png AE3D_SNAPSHOT_BURST=m   (unattended, captured)
//   AE3D_TICK=60 (a frame a step, for a burst)   AE3D_VIEW=1 (from the side)
//   AE3D_WATCH=k (close on figure k, 0 to 4, from its right)
//   AE3D_FALL_SIDE=1 (the fall figure struck from its left, 3.0 m/s, as test_falls strikes)
//
// Five POWERED figures in a row, each shoved at the chest the same moment:
//
//   bracing    from behind, 2.4 m/s, toward a wall two strides ahead: a hand to it (#590)
//   side       from its left, 1.2 m/s: the far foot crosses, the near steps out (#481)
//   step back  from in front, 0.8 m/s: past what it stands, a step back (#578, #606)
//   stagger    from behind, 1.0 m/s: catch steps in a run (#414)
//   fall       from behind, 2.9 m/s: the protective fall, then up again (#479)
//
// The camera looks at the whole row from in front, left to right as above. Each cycle says, per figure,
// whether it stands at its end, how many steps it took in it, whether it
// braced, and whether it fell.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const FIGURES = 5
const SPACING = 3.0                  // metres between figures along x
const CYCLE = 8.0                    // seconds between shoves
const FIRST = 1.5                    // seconds before the first
const WALL_AHEAD = 1.6               // metres from the bracing figure to its wall
const PATH = "tests/fixtures/gltf/humanoid.glb"

struct Show {
    figures: ptr                     // *Motion[FIGURES]
    braced: ptr                      // int[FIGURES]: braced this cycle
    fell: ptr                        // int[FIGURES]: fell (or lay) this cycle
    steps_before: ptr                // int[FIGURES]: steps taken before this cycle
    seconds: float
    next: float                      // when the next shove lands
    cycle: int
}

x_of(k: int) -> float { return ((k as float) - 2.0) * SPACING }

name_of(k: int) -> string {
    if k == 0 { return "bracing" }
    if k == 1 { return "side" }
    if k == 2 { return "step back" }
    if k == 3 { return "stagger" }
    return "fall"
}

// Where a figure faces, level: its rest's forward turned as its pelvis is.
facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// Each figure's shove, as the speed it gives the whole body (#626): from
// behind, from its left, from in front.
shove_of(k: int, ahead: Vec3) -> Vec3 {
    if k == 0 { return core.v3_mul(ahead, 2.4) }
    if k == 1 { return core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead), 1.2) }
    if k == 2 { return core.v3_mul(ahead, 0.0 - 0.8) }
    if k == 3 { return core.v3_mul(ahead, 1.0) }
    return core.v3_mul(ahead, 2.9)
}

start(state: ptr, e: *Engine) {
    s = state as *Show
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(40.0, 1.0, 40.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    k = 0
    while k < FIGURES {
        o = figure.figure(e, name_of(k), PATH)
        if o == null {
            println("motion_showcase: ${PATH} would not load")
            return
        }
        behaviour.object_set_position(o, core.vec3(x_of(k), 0.0, 0.0))
        m = motion.on_figure(e, o)
        if m == null {
            println("motion_showcase: ${PATH} is no humanoid the engine knows")
            return
        }
        motion.set_mode(m, motion.POWERED)
        motion.set_get_up(m, 1.5)
        (s.figures as ptr[])[k] = m as ptr
        k = k + 1
    }
    // The wall ahead of the bracing figure, square to the way it faces.
    ahead = facing((s.figures as ptr[])[0] as *Motion)
    wall = engine.object(e, "Wall", loader.cube(1.0))
    behaviour.object_set_position(wall, core.vec3(x_of(0) + ahead.x * (WALL_AHEAD + 0.25), 1.25, ahead.z * (WALL_AHEAD + 0.25)))
    behaviour.object_set_scale(wall, core.vec3(2.4, 2.5, 0.5))
    physics.box_collider(wall, core.vec3(1.2, 1.25, 0.25), physics.material(0.8, 0.0))
    s.next = FIRST
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Show
    s.seconds = s.seconds + step
    figures = s.figures as ptr[]
    braced = s.braced as int[]
    fell = s.fell as int[]
    k = 0
    while k < FIGURES {
        fm = figures[k] as *Motion
        if motion.braced(fm) { braced[k] = 1 }
        if motion.falling(fm) || motion.lying(fm) || motion.getting_up(fm) { fell[k] = 1 }
        k = k + 1
    }
    if s.seconds < s.next { return }
    if s.cycle > 0 { report(s) }
    k = 0
    while k < FIGURES {
        m = figures[k] as *Motion
        if motion.mode(m) == motion.POWERED && !motion.falling(m) && !motion.lying(m) {
            if k == FIGURES - 1 && core.env_int("AE3D_FALL_SIDE", 0) == 1 {
                // The fall figure struck from its left, as tests/test_falls.ae
                // strikes its sideways fallers: a blow, at 3.0 m/s.
                side = core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), facing(m)), 3.0 * physics.ragdoll_mass(m.ragdoll))
                motion.hit(m, human.BONE_SPINE_03, behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03)), side)
            } else {
                motion.shove(m, human.BONE_SPINE_03, core.v3_mul(shove_of(k, facing(m)), physics.ragdoll_mass(m.ragdoll)))
            }
        }
        braced[k] = 0
        fell[k] = 0
        (s.steps_before as int[])[k] = motion.steps_taken(m)
        k = k + 1
    }
    s.cycle = s.cycle + 1
    s.next = s.next + CYCLE
}

// What the last cycle came to, per figure.
report(s: *Show) {
    figures = s.figures as ptr[]
    braced = s.braced as int[]
    fell = s.fell as int[]
    line = "motion_showcase: cycle ${s.cycle}:"
    k = 0
    while k < FIGURES {
        m = figures[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        stands = "down"
        if pelvis.y >= 0.8 { stands = "stands" }
        line = "${line} ${name_of(k)} ${stands} (${motion.steps_taken(m) - (s.steps_before as int[])[k]} steps"
        if braced[k] == 1 { line = "${line}, braced" }
        if fell[k] == 1 { line = "${line}, fell" }
        line = "${line});"
        k = k + 1
    }
    println(line)
}

update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    // The whole row from in front and a little above, still: left to right
    // as the list above.
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < FIGURES {
        // Close on one figure, from three metres off its right side, its
        // pelvis followed.
        m = (s.figures as ptr[])[watch] as *Motion
        if m != null {
            pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
            core.camera_set_position(cam, core.vec3(pelvis.x + 3.0, 1.2, pelvis.z + 0.6))
            core.camera_look_at(cam, core.vec3(pelvis.x, 0.6, pelvis.z))
            return
        }
    }
    if core.env_int("AE3D_VIEW", 0) == 1 {
        // From the right of the row, low: the falls and steps in profile.
        core.camera_set_position(cam, core.vec3(12.0, 1.4, 0.0 - 1.0))
        core.camera_look_at(cam, core.vec3(3.0, 0.7, 0.0 - 1.0))
        return
    }
    core.camera_set_position(cam, core.vec3(0.0, 3.2, 12.5))
    core.camera_look_at(cam, core.vec3(0.0, 0.8, 0.0 - 0.5))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - motion showcase")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    light = core.light_sun(core.vec3(0.4, 0.8, 0.3))
    engine.engine_set_light(e, light)
    figures_block = calloc(FIGURES, 8)
    braced_block = calloc(FIGURES, 8)
    fell_block = calloc(FIGURES, 8)
    before_block = calloc(FIGURES, 8)
    s = Show { figures: figures_block, braced: braced_block, fell: fell_block, steps_before: before_block, seconds: 0.0, next: 0.0, cycle: 0 }
    b = engine.behaviour_new("showcase", (&s) as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(&s)
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    free(figures_block)
    free(braced_block)
    free(fell_block)
    free(before_block)
    core.light_free(light)
    engine.engine_free(e)
}
