// The motion showcase (#509, part of): ae3d.motion's reactions side by
// side, shoved again every CYCLE seconds, for a person -- or the agent loop
// -- to watch. Not a test and not an example: ci.sh never builds it.
//
//   ./build.sh tools/motion_showcase.ae && ./build/motion_showcase
//   AE3D_FRAMES=n AE3D_SNAPSHOT=out.png AE3D_SNAPSHOT_BURST=m   (unattended, captured)
//   AE3D_TICK=60 (a frame a step, for a burst)   AE3D_VIEW=1 (from the side)
//   AE3D_WATCH=k (close on figure k, 0 to 4, from its right)
//   AE3D_FALL_SIDE=1 (the fall figure struck from its left, 3.0 m/s, as test_falls strikes)
//   AE3D_KERB=cm (a 0.2 m kerb that far ahead of the fall figure, #643)
//   AE3D_FALL_BACK=1 (the fall figure struck from in front, onto its back)
//   AE3D_CRAWL=1 (the fall figure, down on its front, crawls the way its head points, #625)
//
// Six POWERED figures in a row, each shoved at the chest the same moment,
// or struck:
//
//   bracing    from behind, 2.4 m/s, toward a wall two strides ahead: a hand to it (#590)
//   side       from its left, 1.2 m/s: the far foot crosses, the near steps out (#481)
//   step back  from in front, 0.8 m/s: past what it stands, a step back (#578, #606)
//   stagger    from behind, 1.0 m/s: catch steps in a run (#414)
//   fall       from behind, 2.9 m/s: the protective fall, then up again (#479)
//   hit        in the belly from in front, 25 N s taking 0.3 of its muscle, a
//              blow it stands: a hand to the wound, the trunk folding over it (#698)
//
// The shoves are aimed along the row, the way the figures faced at the
// start, not the way each faces now: a figure up again faces the way it
// lay. A figure found off its spot the way its shove would carry it is
// shoved the other way instead (from in front for behind, from its right
// for its left), so it stays about its spot and each reaction is seen
// both ways; the bracing figure is shoved toward its wall wherever it
// stands. Shoved one way, by the way it faced, the fall figure came down
// about 1.9 m further ahead each cycle and at the tenth walked off the
// edge of the 40 m ground, falling for good; and the bracing figure, up
// from a fall facing away from its wall, was shoved away from it every
// cycle after, 112 m off by the thirtieth.
//
// The camera looks at the whole row from in front, left to right as above. Each cycle says, per figure,
// whether it stands at its end, how many steps it took in it, whether it
// braced, whether a hand held a wound, whether it fell, which way it was
// shoved, and how far it is
// from its spot.
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import ae3d.figure
import ae3d.motion
import aephysics.human

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const FIGURES = 6
const FALL = 4                       // the fall figure
const HIT = 5                        // and the one struck in the belly
const SPACING = 3.0                  // metres between figures along x
const CYCLE = 8.0                    // seconds between shoves
const FIRST = 1.5                    // seconds before the first
const WALL_AHEAD = 1.6               // metres from the bracing figure to its wall
const PATH = "tests/fixtures/gltf/humanoid.glb"

struct Show {
    figures: ptr                     // *Motion[FIGURES]
    braced: ptr                      // int[FIGURES]: braced this cycle
    fell: ptr                        // int[FIGURES]: fell (or lay) this cycle
    steps_before: ptr                // int[FIGURES]: steps taken before this cycle
    turned: ptr                      // int[FIGURES]: 1 when this cycle's shove came the other way
    held: ptr                        // int[FIGURES]: a hand held a wound this cycle
    ahead: Vec3                      // the way the row faced at the start
    wall: Vec3                       // the bracing figure's wall
    seconds: float
    next: float                      // when the next shove lands
    cycle: int
}

x_of(k: int) -> float { return ((k as float) - 2.5) * SPACING }

name_of(k: int) -> string {
    if k == 0 { return "bracing" }
    if k == 1 { return "side" }
    if k == 2 { return "step back" }
    if k == 3 { return "stagger" }
    if k == FALL { return "fall" }
    return "hit"
}

// Where a figure faces, level: its rest's forward turned as its pelvis is.
facing(m: *Motion) -> Vec3 {
    r = m.ragdoll
    turned = core.quat_mul(physics.ragdoll_bone_rotation(r, human.BONE_PELVIS),
                           core.quat_conjugate(human.bone_at(physics.ragdoll_human(r), human.BONE_PELVIS).reference_frame.q))
    f = core.quat_apply(turned, physics.ragdoll_rest_forward(r))
    return core.v3_normalize(core.vec3(f.x, 0.0, f.z))
}

// Each figure's shove, as the speed it gives the whole body (#626): from
// behind, from its left, from in front.
shove_of(k: int, ahead: Vec3) -> Vec3 {
    if k == 0 { return core.v3_mul(ahead, 2.4) }
    if k == 1 { return core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), ahead), 1.2) }
    if k == 2 { return core.v3_mul(ahead, 0.0 - 0.8) }
    if k == 3 { return core.v3_mul(ahead, 1.0) }
    return core.v3_mul(ahead, 2.9)
}

start(state: ptr, e: *Engine) {
    s = state as *Show
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(40.0, 1.0, 40.0))
    physics.box_collider(ground, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    k = 0
    while k < FIGURES {
        o = figure.figure(e, name_of(k), PATH)
        if o == null {
            println("motion_showcase: ${PATH} would not load")
            return
        }
        behaviour.object_set_position(o, core.vec3(x_of(k), 0.0, 0.0))
        m = motion.on_figure(e, o)
        if m == null {
            println("motion_showcase: ${PATH} is no humanoid the engine knows")
            return
        }
        motion.set_mode(m, motion.POWERED)
        motion.set_get_up(m, 1.5)
        (s.figures as ptr[])[k] = m as ptr
        k = k + 1
    }
    // The wall ahead of the bracing figure, square to the way it faces.
    ahead = facing((s.figures as ptr[])[0] as *Motion)
    s.ahead = ahead
    s.wall = core.vec3(x_of(0) + ahead.x * (WALL_AHEAD + 0.25), 1.25, ahead.z * (WALL_AHEAD + 0.25))
    wall = engine.object(e, "Wall", loader.cube(1.0))
    behaviour.object_set_position(wall, s.wall)
    behaviour.object_set_scale(wall, core.vec3(2.4, 2.5, 0.5))
    physics.box_collider(wall, core.vec3(1.2, 1.25, 0.25), physics.material(0.8, 0.0))
    // AE3D_KERB=cm: a 0.2 m kerb that far ahead of the fall figure, 2 m
    // deep and wide, for its fall and its way up over it (#643).
    kerb_at = core.env_int("AE3D_KERB", 0 - 1)
    if kerb_at >= 0 {
        faller = facing((s.figures as ptr[])[FALL] as *Motion)
        reach = (kerb_at as float) / 100.0 + 1.0
        kerb = engine.object(e, "Kerb", loader.cube(1.0))
        behaviour.object_set_position(kerb, core.vec3(x_of(FALL) + faller.x * reach, 0.1, faller.z * reach))
        behaviour.object_set_scale(kerb, core.vec3(2.0, 0.2, 2.0))
        physics.box_collider(kerb, core.vec3(1.0, 0.1, 1.0), physics.material(0.8, 0.0))
    }
    s.next = FIRST
}

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Show
    s.seconds = s.seconds + step
    figures = s.figures as ptr[]
    braced = s.braced as int[]
    fell = s.fell as int[]
    k = 0
    while k < FIGURES {
        fm = figures[k] as *Motion
        if motion.braced(fm) { braced[k] = 1 }
        if motion.holding_wound(fm) { (s.held as int[])[k] = 1 }
        if motion.falling(fm) || motion.lying(fm) || motion.getting_up(fm) { fell[k] = 1 }
        k = k + 1
    }
    // AE3D_CRAWL=1: the faller, once it lies on its front, crawls the way
    // its head points (#625), and is not shoved again.
    crawler = figures[FALL] as *Motion
    if core.env_int("AE3D_CRAWL", 0) == 1 && motion.lying(crawler) && !motion.face_up(crawler) && !motion.crawling(crawler) {
        hips = behaviour.object_position(physics.ragdoll_bone(crawler.ragdoll, human.BONE_PELVIS))
        head = behaviour.object_position(physics.ragdoll_bone(crawler.ragdoll, human.BONE_NECK))
        motion.crawl(crawler, core.vec3(head.x - hips.x, 0.0, head.z - hips.z))
    }
    if s.seconds < s.next { return }
    if s.cycle > 0 { report(s) }
    turned = s.turned as int[]
    k = 0
    while k < FIGURES {
        m = figures[k] as *Motion
        turned[k] = 0
        if motion.mode(m) == motion.POWERED && !motion.falling(m) && !motion.lying(m) && !motion.crawling(m) {
            chest = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_03))
            if k == HIT {
                // A blow it stands, in the belly a little right of its
                // middle, from in front.
                ahead = facing(m)
                belly = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_SPINE_01))
                right = core.v3_cross(ahead, core.vec3(0.0, 1.0, 0.0))
                at = core.v3_add(belly, core.v3_add(core.v3_mul(ahead, 0.12), core.v3_mul(right, 0.05)))
                motion.hit(m, human.BONE_SPINE_01, at, core.v3_mul(ahead, 0.0 - 25.0), true, 0.3)
            } else if k == FALL && core.env_int("AE3D_FALL_BACK", 0) == 1 {
                // The fall figure struck from in front, onto its back: the
                // way up from there.
                motion.hit(m, human.BONE_SPINE_03, chest, homeward(s, k, core.v3_mul(s.ahead, 0.0 - 3.0 * physics.ragdoll_mass(m.ragdoll))))
            } else if k == FALL && core.env_int("AE3D_FALL_SIDE", 0) == 1 {
                // The fall figure struck from its left, as tests/test_falls.ae
                // strikes its sideways fallers: a blow, at 3.0 m/s.
                side = core.v3_mul(core.v3_cross(core.vec3(0.0, 1.0, 0.0), s.ahead), 3.0 * physics.ragdoll_mass(m.ragdoll))
                motion.hit(m, human.BONE_SPINE_03, chest, homeward(s, k, side))
            } else {
                motion.shove(m, human.BONE_SPINE_03, homeward(s, k, core.v3_mul(shove_of(k, s.ahead), physics.ragdoll_mass(m.ragdoll))))
            }
        }
        braced[k] = 0
        fell[k] = 0
        (s.held as int[])[k] = 0
        (s.steps_before as int[])[k] = motion.steps_taken(m)
        k = k + 1
    }
    s.cycle = s.cycle + 1
    s.next = s.next + CYCLE
}

// How far figure k's pelvis is from its spot, level.
off_spot(s: *Show, k: int) -> Vec3 {
    m = (s.figures as ptr[])[k] as *Motion
    pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
    return core.vec3(pelvis.x - x_of(k), 0.0, pelvis.z)
}

// A shove, turned the other way when figure k is already off its spot the
// way it would carry it; the bracing figure's, at its wall from wherever
// it stands.
homeward(s: *Show, k: int, shove: Vec3) -> Vec3 {
    if k == 0 {
        m = (s.figures as ptr[])[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        to_wall = core.vec3(s.wall.x - pelvis.x, 0.0, s.wall.z - pelvis.z)
        if core.v3_len(to_wall) < 0.01 { return shove }
        return core.v3_mul(core.v3_normalize(to_wall), core.v3_len(shove))
    }
    if core.v3_dot(off_spot(s, k), shove) <= 0.0 { return shove }
    (s.turned as int[])[k] = 1
    return core.v3_mul(shove, 0.0 - 1.0)
}

// What the last cycle came to, per figure.
report(s: *Show) {
    figures = s.figures as ptr[]
    braced = s.braced as int[]
    fell = s.fell as int[]
    line = "motion_showcase: cycle ${s.cycle}:"
    k = 0
    while k < FIGURES {
        m = figures[k] as *Motion
        pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
        stands = "down"
        if pelvis.y >= 0.8 { stands = "stands" }
        line = "${line} ${name_of(k)} ${stands} (${motion.steps_taken(m) - (s.steps_before as int[])[k]} steps"
        if braced[k] == 1 { line = "${line}, braced" }
        if (s.held as int[])[k] == 1 { line = "${line}, a hand on the wound" }
        if fell[k] == 1 { line = "${line}, fell" }
        if (s.turned as int[])[k] == 1 { line = "${line}, shoved the other way" }
        line = "${line}, ${core.v3_len(off_spot(s, k))} m off its spot);"
        k = k + 1
    }
    println(line)
}

update(state: ptr, e: *Engine, delta: float) {
    s = state as *Show
    // The whole row from in front and a little above, still: left to right
    // as the list above.
    cam = engine.engine_camera(e)
    watch = core.env_int("AE3D_WATCH", 0 - 1)
    if watch >= 0 && watch < FIGURES {
        // Close on one figure, from three metres off its right side, its
        // pelvis followed.
        m = (s.figures as ptr[])[watch] as *Motion
        if m != null {
            pelvis = behaviour.object_position(physics.ragdoll_bone(m.ragdoll, human.BONE_PELVIS))
            core.camera_set_position(cam, core.vec3(pelvis.x + 3.0, 1.2, pelvis.z + 0.6))
            core.camera_look_at(cam, core.vec3(pelvis.x, 0.6, pelvis.z))
            return
        }
    }
    if core.env_int("AE3D_VIEW", 0) == 1 {
        // From the right of the row, low: the falls and steps in profile.
        core.camera_set_position(cam, core.vec3(12.0, 1.4, 0.0 - 1.0))
        core.camera_look_at(cam, core.vec3(3.0, 0.7, 0.0 - 1.0))
        return
    }
    core.camera_set_position(cam, core.vec3(0.0, 3.2, 12.5))
    core.camera_look_at(cam, core.vec3(0.0, 0.8, 0.0 - 0.5))
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - motion showcase")
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    light = core.light_sun(core.vec3(0.4, 0.8, 0.3))
    engine.engine_set_light(e, light)
    figures_block = calloc(FIGURES, 8)
    braced_block = calloc(FIGURES, 8)
    fell_block = calloc(FIGURES, 8)
    before_block = calloc(FIGURES, 8)
    turned_block = calloc(FIGURES, 8)
    held_block = calloc(FIGURES, 8)
    s = Show { figures: figures_block, braced: braced_block, fell: fell_block, steps_before: before_block, turned: turned_block, held: held_block, ahead: core.vec3(0.0, 0.0, 1.0), wall: core.vec3(0.0, 0.0, 0.0), seconds: 0.0, next: 0.0, cycle: 0 }
    b = engine.behaviour_new("showcase", (&s) as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.update = update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(&s)
    motion.motions_free(e)
    physics.physics_free(physics.of(e))
    figure.figures_free(e)
    free(figures_block)
    free(braced_block)
    free(fell_block)
    free(before_block)
    free(turned_block)
    free(held_block)
    core.light_free(light)
    engine.engine_free(e)
}
