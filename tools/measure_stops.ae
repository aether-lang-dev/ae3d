// The stops in the people's take library, measured: each time a captured
// actor comes to a stand from walking or running, the speed it brakes from,
// the time and the way it takes to rest, and its deceleration (#1024).
//
//     ./build.sh tools/measure_stops.ae && ./build/measure_stops
//
// Each capture is read frame by frame and its pelvis followed over the
// ground. Its speed at a frame is its way over the SPAN about it (a stride's
// sway does not read as pace). A stop is where that speed falls under REST
// and stays under it for HELD seconds. Looking back from there (at most LOOK
// seconds, to where the actor last went slower than REST), the fastest it
// went is its peak; it brakes from the last moment it went BRAKE of that.
// From there to rest: the time, the way, the mean deceleration (the speed
// it brakes from over the time) and the peak (over DECEL_SPAN).
import ae3d.core
import ae3d.bvh
import ae3d.pose
import ae3d.clips

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const SPAN = 0.3
const DECEL_SPAN = 0.2
const REST = 0.1
const HELD = 0.3
const LOOK = 4.0
const BRAKE = 0.9

flat(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

// The capture at `path` measured, a line for each of its stops.
measure(path: string) {
    c = bvh.load(path, 0.0)
    if c == null {
        println("cannot load ${path}: ${bvh.error()}")
        return
    }
    r = bvh.rig(c)
    t = bvh.take(c, path, 0, 0 - 1)
    n = clips.frames(t)
    rate = clips.rate(t)
    w = pose.new(r)
    xs = calloc(n, 8) as float[]
    zs = calloc(n, 8) as float[]
    went = calloc(n, 8) as float[]
    fr = 0
    while fr < n {
        pose.world(r, clips.frame(t, fr), w)
        p = clips.ground_point(r, pose.translation(w, pose.human(r, pose.PELVIS)))
        xs[fr] = p.x
        zs[fr] = p.z
        if fr > 0 { went[fr] = went[fr - 1] + core.v3_len(flat(core.vec3(p.x - xs[fr - 1], 0.0, p.z - zs[fr - 1]))) }
        fr = fr + 1
    }
    half = (SPAN * 0.5 * rate) as int
    if half < 1 { half = 1 }
    speed = calloc(n, 8) as float[]
    fr = 0
    while fr < n {
        lo = fr - half
        hi = fr + half
        if lo < 0 { lo = 0 }
        if hi > n - 1 { hi = n - 1 }
        if hi > lo { speed[fr] = (went[hi] - went[lo]) * rate / ((hi - lo) as float) }
        fr = fr + 1
    }
    dhalf = (DECEL_SPAN * 0.5 * rate) as int
    if dhalf < 1 { dhalf = 1 }
    held = (HELD * rate) as int
    look = (LOOK * rate) as int
    println("${path}: ${n} frames at ${rate}/s")
    count = 0
    fr = 1
    while fr < n - held {
        if !(speed[fr] < REST && speed[fr - 1] >= REST) {
            fr = fr + 1
            continue
        }
        k = 0
        stays = true
        while k < held {
            if speed[fr + k] >= REST { stays = false }
            k = k + 1
        }
        if !stays {
            fr = fr + 1
            continue
        }
        // Back to where it last went slower than REST, LOOK at most.
        first = fr - 1
        while first > 0 && fr - first < look && speed[first - 1] >= REST { first = first - 1 }
        peak = 0.0
        peak_at = first
        k = first
        while k < fr {
            if speed[k] > peak {
                peak = speed[k]
                peak_at = k
            }
            k = k + 1
        }
        if peak < 0.3 {
            fr = fr + 1
            continue
        }
        from = peak_at
        k = peak_at
        while k < fr {
            if speed[k] >= BRAKE * peak { from = k }
            k = k + 1
        }
        secs = ((fr - from) as float) / rate
        way = went[fr] - went[from]
        worst = 0.0
        k = from
        while k < fr {
            lo = k - dhalf
            hi = k + dhalf
            if lo < 0 { lo = 0 }
            if hi > n - 1 { hi = n - 1 }
            d = (speed[lo] - speed[hi]) * rate / ((hi - lo) as float)
            if d > worst { worst = d }
            k = k + 1
        }
        v = speed[from]
        mean = 0.0
        if secs > 0.0 { mean = v / secs }
        print("  stop at ${(fr as float) / rate} s: peak ${peak} m/s, brakes from ${v} m/s, rest in ${secs} s and ${way} m")
        println(", deceleration mean ${mean} peak ${worst} m/s2, v2/2d ${v * v / (2.0 * way)} m/s2")
        count = count + 1
        fr = fr + held
    }
    println("  ${count} stops")
    free(xs as ptr)
    free(zs as ptr)
    free(went as ptr)
    free(speed as ptr)
    pose.release(w)
    clips.take_free(t)
    bvh.capture_free(c)
}

main() {
    files = [
        "tests/fixtures/people/100style/whole/Neutral_FR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_BR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_SR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_FW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_BW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_SW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_ID.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_TR1.bvh.gz",
        "tests/fixtures/people/100style/neutral_stop.bvh",
        "tests/fixtures/people/100style/neutral_arrive.bvh",
        "tests/fixtures/people/100style/lookup_stop.bvh"
    ]
    k = 0
    while k < 11 {
        measure(files[k])
        k = k + 1
    }
}
