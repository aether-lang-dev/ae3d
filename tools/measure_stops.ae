// The stops in the people's take library, measured: each time a captured
// actor comes to a stand from walking or running, the speed it brakes from,
// the time and the way it takes to rest, its deceleration, and where it
// rests against the way it went (#1024).
//
//     ./build.sh tools/measure_stops.ae && ./build/measure_stops
//
// The stops are found as the engine finds a stop capture's when its gaits
// load (clips.stop_path): its pelvis followed over the ground, its speed at
// a frame its way over the SPAN about it; a stop where that speed falls
// under REST and stays under it for HELD seconds, braking from the last
// moment it went BRAKE of its peak. From there to rest: the time, the way,
// the mean deceleration (the speed it brakes from over the time) and the
// peak (over DECEL_SPAN), and where it rests ahead and across and how far
// its hips turned.
import ae3d.core
import ae3d.bvh
import ae3d.pose
import ae3d.clips

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const SPAN = 0.3
const DECEL_SPAN = 0.2

flat(v: Vec3) -> Vec3 { return core.vec3(v.x, 0.0, v.z) }

// The capture at `path` measured, a line for each of its stops.
measure(path: string) {
    c = bvh.load(path, 0.0)
    if c == null {
        println("cannot load ${path}: ${bvh.error()}")
        return
    }
    r = bvh.rig(c)
    t = bvh.take(c, path, 0, 0 - 1)
    n = clips.frames(t)
    rate = clips.rate(t)
    w = pose.new(r)
    went = calloc(n, 8) as float[]
    px = 0.0
    pz = 0.0
    fr = 0
    while fr < n {
        pose.world(r, clips.frame(t, fr), w)
        p = clips.ground_point(r, pose.translation(w, pose.human(r, pose.PELVIS)))
        if fr > 0 { went[fr] = went[fr - 1] + core.v3_len(flat(core.vec3(p.x - px, 0.0, p.z - pz))) }
        px = p.x
        pz = p.z
        fr = fr + 1
    }
    half = (SPAN * 0.5 * rate) as int
    if half < 1 { half = 1 }
    speed = calloc(n, 8) as float[]
    fr = 0
    while fr < n {
        lo = fr - half
        hi = fr + half
        if lo < 0 { lo = 0 }
        if hi > n - 1 { hi = n - 1 }
        if hi > lo { speed[fr] = (went[hi] - went[lo]) * rate / ((hi - lo) as float) }
        fr = fr + 1
    }
    dhalf = (DECEL_SPAN * 0.5 * rate) as int
    if dhalf < 1 { dhalf = 1 }
    println("${path}: ${n} frames at ${rate}/s")
    count = 0
    rest, from, peak, ahead, across, turn = clips.stop_path(t, r, 0)
    while rest >= 0 {
        secs = ((rest - from) as float) / rate
        way = went[rest] - went[from]
        worst = 0.0
        k = from
        while k < rest {
            lo = k - dhalf
            hi = k + dhalf
            if lo < 0 { lo = 0 }
            if hi > n - 1 { hi = n - 1 }
            d = (speed[lo] - speed[hi]) * rate / ((hi - lo) as float)
            if d > worst { worst = d }
            k = k + 1
        }
        v = speed[from]
        mean = 0.0
        if secs > 0.0 { mean = v / secs }
        print("  stop at ${(rest as float) / rate} s: peak ${peak} m/s, brakes from ${v} m/s, rest in ${secs} s and ${way} m")
        println(", deceleration mean ${mean} peak ${worst} m/s2, v2/2d ${v * v / (2.0 * way)} m/s2")
        println("    rests ${ahead} m ahead and ${across} m across, hips turned ${turn} rad")
        count = count + 1
        rest, from, peak, ahead, across, turn = clips.stop_path(t, r, rest)
    }
    println("  ${count} stops")
    free(went as ptr)
    free(speed as ptr)
    pose.release(w)
    clips.take_free(t)
    bvh.capture_free(c)
}

main() {
    files = [
        "tests/fixtures/people/100style/whole/Neutral_FR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_BR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_SR.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_FW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_BW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_SW.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_ID.bvh.gz",
        "tests/fixtures/people/100style/whole/Neutral_TR1.bvh.gz",
        "tests/fixtures/people/100style/neutral_stop.bvh",
        "tests/fixtures/people/100style/neutral_arrive.bvh",
        "tests/fixtures/people/100style/lookup_stop.bvh"
    ]
    k = 0
    while k < 11 {
        measure(files[k])
        k = k + 1
    }
}
