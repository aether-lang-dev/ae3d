// Cut frames out of a BVH file, unedited: the skeleton as it is, then
// frames FIRST to LAST (counted from 0, inclusive) as the file has them,
// with the frame count that says so. How the 100STYLE takes in
// tests/fixtures/people/100style were cut from the dataset's files, whose
// takes run for minutes around a capture volume: each cut is a stretch the
// figure walks or runs straight, its source frames named in that folder's
// README.
//
//     ./build/bvh_cut <in.bvh> <out.bvh> <first> <last>

import std.fs
import std.os
import std.string

extern exit(code: int)

main() {
    if os.args_count() < 5 {
        println("usage: bvh_cut <in.bvh> <out.bvh> <first> <last>")
        exit(2)
    }
    source = os.args_get(1)
    target = os.args_get(2)
    first = string.string_get_int(os.args_get(3))
    last = string.string_get_int(os.args_get(4))
    content, err = fs.read(source)
    if err != "" {
        println("bvh_cut: cannot read ${source}: ${err}")
        exit(1)
    }
    lines = string.split(content, "\n")
    count = string.array_size(lines)
    // The skeleton, up to and with MOTION.
    motion = 0 - 1
    i = 0
    while i < count && motion < 0 {
        line = string.trim(string.array_get(lines, i))
        if line == "MOTION" { motion = i }
        i = i + 1
    }
    frames = 0
    if motion >= 0 { frames = count - motion - 3 }
    while frames > 0 && string.trim(string.array_get(lines, motion + 3 + frames - 1)) == "" { frames = frames - 1 }
    if motion < 0 || first < 0 || last < first || last >= frames {
        println("bvh_cut: ${source} has ${frames} frames; ${first} to ${last} is not a cut of them")
        exit(1)
    }
    out = ""
    i = 0
    while i <= motion {
        out = string.concat(out, string.concat(strip_cr(string.array_get(lines, i)), "\n"))
        i = i + 1
    }
    out = string.concat(out, "Frames: ${last - first + 1}\n")
    out = string.concat(out, string.concat(strip_cr(string.array_get(lines, motion + 2)), "\n"))
    f = first
    while f <= last {
        out = string.concat(out, string.concat(strip_cr(string.array_get(lines, motion + 3 + f)), "\n"))
        f = f + 1
    }
    written = fs.write(target, out)
    if written != "" {
        println("bvh_cut: cannot write ${target}: ${written}")
        exit(1)
    }
    println("bvh_cut: frames ${first} to ${last} of ${source} (${frames}) into ${target}")
    string.array_free(lines)
}

// A line without the carriage return a file written on Windows ends it with.
strip_cr(line: string) -> string {
    size = string.length(line)
    if size > 0 && string.char_at(line, size - 1) == 13 { return string.substring(line, 0, size - 1) }
    return line
}
