// Drive the editor through its own widgets and check what happens.
//
// Every other check on the editor reads the report it writes about
// itself, and that report is produced by calling the handlers directly.
// A button that is never hit-tested, a field whose callback is not
// wired, a row that cannot be clicked: all of them pass those checks,
// because none of them go anywhere near a widget.
//
// aether-ui's driver does. It answers /widgets with the live tree and
// takes clicks and keystrokes on any of it, so this presses the real
// buttons and types into the real fields, then asks the tree what
// changed.
//
//     ./build.sh tools/drive_editor.ae
//     ./build/drive_editor [--port N] [--binary build/ae3d_editor] [--backend opengl|vulkan]
//
// Exits non-zero with a line saying what failed. The editor's own output
// goes to the same stream as this program's, so a run that stops
// answering leaves its last words in the log.
import std.os
import std.file
import std.fs
import std.dir
import std.list
import std.string
import std.strbuilder
import std.json
import std.http

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const ACCENT = "#2e6eeb"
const SCENE_FILE = "build/editor_scene.json"
const SCRIPTS_DIR = "resources/scripts"

var g_port = 8791
var g_failures = 0
var g_editor = 0                    // the spawned editor's token

check(name: string, ok: bool) {
    if ok {
        println("   ok    ${name}")
    } else {
        println("   FAIL  ${name}")
        g_failures = g_failures + 1
    }
}

check_detail(name: string, ok: bool, detail: string) {
    if ok {
        println("   ok    ${name}")
    } else {
        println("   FAIL  ${name} (${detail})")
        g_failures = g_failures + 1
    }
}

// A check with a known gap on this platform: reported, never a failure.
// What it would fail on is tracked in the issue named, so the run says
// the gap is still there without hiding the checks around it behind one
// red line; the moment the gap closes the note reads as an ok and the
// call becomes a check again.
check_note(name: string, ok: bool, detail: string, issue: int) {
    if ok {
        println("   ok    ${name}")
    } else {
        println("   note  ${name} (${detail}; #${issue})")
    }
}

// --- the tree ------------------------------------------------------------------------------------------------

// One widget as the driver reports it.
struct Widget {
    id: int
    parent: int
    kind: string
    text: string                   // trimmed
    raw_text: string               // as reported
    x: float
    y: float
    w: float
    h: float
    visible: bool
    bg: string
    classes: string
    value: float
    active: bool
    border_width: float
    border_color: string
}

// The tree: the widgets in the order the driver listed them, and the
// JSON they came from, freed together.
struct Tree {
    widgets: ptr                   // list of *Widget
    root: ptr                      // the json array
}

field_text(node: ptr, key: string) -> string {
    v = json.json_object_get_raw(node, key)
    if v == null || json.json_type(v) != 3 { return "" }
    return json.json_get_string_raw(v)
}

field_number(node: ptr, key: string) -> float {
    v = json.json_object_get_raw(node, key)
    if v == null || json.json_type(v) != 2 { return 0.0 }
    return json.json_get_number(v)
}

field_flag(node: ptr, key: string) -> bool {
    v = json.json_object_get_raw(node, key)
    if v == null || json.json_type(v) != 1 { return false }
    return json.json_get_bool(v) != 0
}

widget_ptr(w: *Widget) -> ptr { return w }

tree_of(root: ptr) -> *Tree {
    t = calloc(1, sizeof(Tree)) as *Tree
    t.root = root
    t.widgets = list.new()
    count = json.json_array_size(root)
    i = 0
    while i < count {
        node = json.json_array_get_raw(root, i)
        w = calloc(1, sizeof(Widget)) as *Widget
        w.id = field_number(node, "id") as int
        w.parent = field_number(node, "parent") as int
        w.kind = field_text(node, "type")
        w.raw_text = field_text(node, "text")
        w.text = string.trim(w.raw_text)
        w.x = field_number(node, "x")
        w.y = field_number(node, "y")
        w.w = field_number(node, "w")
        w.h = field_number(node, "h")
        w.visible = field_flag(node, "visible")
        w.bg = field_text(node, "bg")
        w.classes = field_text(node, "classes")
        w.value = field_number(node, "value")
        w.active = field_flag(node, "active")
        w.border_width = field_number(node, "borderWidth")
        w.border_color = field_text(node, "borderColor")
        list.add_raw(t.widgets, widget_ptr(w))
        i = i + 1
    }
    return t
}

tree_free(t: *Tree) {
    if t == null { return }
    n = list.size(t.widgets)
    i = 0
    while i < n {
        w = list.get_raw(t.widgets, i) as *Widget
        string.free(w.text)
        free(list.get_raw(t.widgets, i))
        i = i + 1
    }
    list.free(t.widgets)
    json.json_free(t.root)
    free(t as ptr)
}

tree_count(t: *Tree) -> int { return list.size(t.widgets) }
tree_at(t: *Tree, i: int) -> *Widget { return list.get_raw(t.widgets, i) as *Widget }

// The widget with this id, or null.
widget(t: *Tree, id: int) -> *Widget {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.id == id { return w }
        i = i + 1
    }
    return null
}

widget_text(t: *Tree, id: int) -> string {
    w = widget(t, id)
    if w == null { return "" }
    return w.text
}

widget_value(t: *Tree, id: int) -> float {
    w = widget(t, id)
    if w == null { return 0.0 }
    return w.value
}

widget_active(t: *Tree, id: int) -> bool {
    w = widget(t, id)
    if w == null { return false }
    return w.active
}

widget_lit(t: *Tree, id: int) -> bool {
    w = widget(t, id)
    if w == null { return false }
    return w.bg == ACCENT
}

// --- the channel ---------------------------------------------------------------------------------------------

url(path: string) -> string { return "http://127.0.0.1:${g_port}${path}" }

// GET, parsed. The window takes a moment to exist, so the first answer is
// waited for; a channel that never answers ends the run with the reason.
get_json(path: string) -> ptr {
    tries = 0
    last = ""
    while tries < 40 {
        body, err = http.get_with_timeout(url(path), 3s)
        if err == "" {
            root, perr = json.parse(body)
            if perr == "" { return root }
            last = perr
        } else {
            last = err
        }
        sleep(500)
        tries = tries + 1
    }
    println("editor driver never answered ${path}: ${last}${editor_output()}")
    stop_editor()
    os.exit(1)
}

// What the editor is doing when it stops answering: still there, which
// is a blocked main thread rather than a crash (sampled on macOS, where
// there is a sampler), or already gone.
editor_output() -> string {
    if g_editor == 0 { return "" }
    status, timed_out, _err = os.wait_pid_timeout(g_editor, 0)
    if timed_out != 0 {
        note = "\n  the editor is still running"
        if os.platform() == "darwin" {
            argv = list.new()
            list.add(argv, "${g_editor}")
            list.add(argv, "1")
            list.add(argv, "-mayDie")
            out, _status, serr = os.run_capture("sample", argv, null)
            if serr == "" { note = "${note}\n${out}" }
        }
        return note
    }
    return "\n  the editor had already exited, status ${status}"
}

tree() -> *Tree { return tree_of(get_json("/widgets")) }

// POST to the driver. A route that answers 404 is a check that failed,
// not a run that ends: one unreachable route used to abort the script
// and take the twenty checks after it with it. `quiet` is for a probe
// that expects to miss. True when the route answered.
post_route(path: string, quiet: bool) -> bool {
    _body, err = http.post(url(path), "", "text/plain")
    if err != "" {
        if quiet == false { println("   note  ${path} answered ${err}") }
        return false
    }
    return true
}

post(path: string) -> bool { return post_route(path, false) }
click(id: int) -> bool { return post("/widget/${id}/click") }
toggle(id: int) -> bool { return post("/widget/${id}/toggle") }
set_text(id: int, text: string) -> bool { return post("/widget/${id}/set_text?v=${text}") }
set_value(id: int, value: string) -> bool { return post("/widget/${id}/set_value?v=${value}") }

// --- reading the tree ----------------------------------------------------------------------------------------

// The id of the widget of this kind with this text, or -1.
// The widget of this kind with this text that is showing, or the first
// such if none is: the inspector keeps the panels of the shapes it has
// shown, hidden, so a caption can be in the tree more than once.
find(t: *Tree, kind: string, text: string) -> int {
    n = tree_count(t)
    first = 0 - 1
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == kind && w.text == text {
            if on_screen(t, w) { return w.id }
            if first < 0 { first = w.id }
        }
        i = i + 1
    }
    return first
}

// The first widget of this kind with this text, or null.
find_widget(t: *Tree, kind: string, text: string) -> *Widget {
    id = find(t, kind, text)
    if id < 0 { return null }
    return widget(t, id)
}

// The widgets of this kind with this text that are showing.
count_shown(t: *Tree, kind: string, text: string) -> int {
    n = tree_count(t)
    found = 0
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == kind && w.text == text && on_screen(t, w) { found = found + 1 }
        i = i + 1
    }
    return found
}

count_named(t: *Tree, kind: string, text: string) -> int {
    n = tree_count(t)
    found = 0
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == kind && w.text == text { found = found + 1 }
        i = i + 1
    }
    return found
}

// The widgets under one, in the order listed.
rows_under(t: *Tree, parent: int) -> ptr {
    out = list.new()
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == parent { list.add_raw(out, widget_ptr(w)) }
        i = i + 1
    }
    return out
}

row_count(t: *Tree, parent: int) -> int {
    rows = rows_under(t, parent)
    n = list.size(rows)
    list.free(rows)
    return n
}

// The hierarchy's rows that are objects: every row under the list but the
// scene's own, which comes first and is the scene, not one of its objects.
object_rows(t: *Tree, scene: int) -> ptr {
    out = list.new()
    rows = rows_under(t, scene)
    i = 0
    while i < list.size(rows) {
        row = list.get_raw(rows, i) as *Widget
        name = row_name(t, row)
        if name != "Scene" { list.add_raw(out, row) }
        string.free(name)
        i = i + 1
    }
    list.free(rows)
    return out
}

object_count(t: *Tree, scene: int) -> int {
    rows = object_rows(t, scene)
    n = list.size(rows)
    list.free(rows)
    return n
}

// The hierarchy's row for the scene itself, or -1.
scene_row(t: *Tree, scene: int) -> int {
    row = row_named(t, scene, "Scene")
    if row == null { return 0 - 1 }
    return row.id
}

// The row named so selected, and the tree once the inspector has had a
// moment to show it.
select_named(scene: int, name: string) -> bool {
    t = tree()
    id = 0 - 1
    rows = rows_under(t, scene)
    k = 0
    while k < list.size(rows) && id < 0 {
        candidate = list.get_raw(rows, k) as *Widget
        rn = row_name(t, candidate)
        if string.equals(rn, name) == 1 { id = candidate.id }
        string.free(rn)
        k = k + 1
    }
    list.free(rows)
    tree_free(t)
    if id < 0 { return false }
    click(id)
    sleep(500)
    return true
}

// The widgets under one and everything under those, nearest first.
descendants(t: *Tree, parent: int) -> ptr {
    out = list.new()
    queue = rows_under(t, parent)
    head = 0
    while head < list.size(queue) {
        w = list.get_raw(queue, head) as *Widget
        list.add_raw(out, widget_ptr(w))
        kids = rows_under(t, w.id)
        k = 0
        while k < list.size(kids) {
            list.add_raw(queue, list.get_raw(kids, k))
            k = k + 1
        }
        list.free(kids)
        head = head + 1
    }
    list.free(queue)
    return out
}

// A shown component panel's body by its kind's name, or -1: the title sits
// in the header's strip, and the body is the first stack after the header
// (the actions row between them is a row).
component_body_id(t: *Tree, kind: string) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && w.text == kind && on_screen(t, w) {
            strip = widget(t, w.parent)
            header = null as *Widget
            if strip != null { header = widget(t, strip.parent) }
            if header != null && string.contains(header.classes, "heading") != 0 {
                body = null as *Widget
                j = 0
                while j < n {
                    b = tree_at(t, j)
                    if b.parent == header.parent && b.id > header.id && b.kind == "vstack" && (body == null || b.id < body.id) { body = b }
                    j = j + 1
                }
                if body != null { return body.id }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// The button named `text` under a widget, or -1.
button_under(t: *Tree, parent: int, text: string) -> int {
    found = 0 - 1
    below = descendants(t, parent)
    k = 0
    while k < list.size(below) && found < 0 {
        w = list.get_raw(below, k) as *Widget
        if w.kind == "button" && w.raw_text == text { found = w.id }
        k = k + 1
    }
    list.free(below)
    return found
}

// Whether the only one lit among `names` is `wanted`.
lit_among_is(t: *Tree, names: string, wanted: string) -> bool {
    lit = lit_among(t, names)
    same = lit == wanted
    string.free(lit)
    return same
}

// Whether, within `seconds`, the only one lit among `names` is `wanted`.
wait_lit(names: string, wanted: string, seconds: float) -> bool {
    waited = 0.0
    while waited < seconds {
        t = tree()
        lit = lit_among(t, names)
        tree_free(t)
        same = lit == wanted
        string.free(lit)
        if same { return true }
        sleep(200)
        waited = waited + 0.2
    }
    return false
}

// The button beside a shown component panel's title, by its text (the
// panel's menu, "⋮"), or -1.
panel_header_button(t: *Tree, kind: string, text: string) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && w.text == kind && on_screen(t, w) {
            j = 0
            while j < n {
                b = tree_at(t, j)
                if b.kind == "button" && b.parent == w.parent && b.raw_text == text { return b.id }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// The button showing `text` on screen, or -1.
shown_button(t: *Tree, text: string) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "button" && w.raw_text == text && on_screen(t, w) { return w.id }
        i = i + 1
    }
    return 0 - 1
}

// The widgets of this kind with this text under a widget.
count_under(t: *Tree, parent: int, kind: string, text: string) -> int {
    found = 0
    below = descendants(t, parent)
    k = 0
    while k < list.size(below) {
        w = list.get_raw(below, k) as *Widget
        if w.kind == kind && w.text == text { found = found + 1 }
        k = k + 1
    }
    list.free(below)
    return found
}

// The ancestor of a widget that sits directly in a panel's stack.
//
// A section caption is nested inside its bar, so it is not a sibling of
// the thing the section holds. Found by climbing rather than by depth,
// because the depth is a detail of how the bar is built.
in_panel(t: *Tree, w: *Widget) -> *Widget {
    at = w
    while at != null {
        parent = widget(t, at.parent)
        if parent == null { return null }
        if string.contains(parent.classes, "panel-body") != 0 { return at }
        at = parent
    }
    return null
}

// The SCENE section's body, or -1: what the hierarchy's list and its
// filter box are children of.
scene_body_id(t: *Tree) -> int { return section_body_id(t, "SCENE") }

// A section's body by its caption, or -1.
section_body_id(t: *Tree, caption: string) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && w.text == caption {
            bar = in_panel(t, w)
            if bar != null {
                body = null as *Widget
                j = 0
                while j < n {
                    s = tree_at(t, j)
                    if s.parent == bar.parent && s.id > bar.id && (body == null || s.id < body.id) { body = s }
                    j = j + 1
                }
                if body != null { return body.id }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// The list inside the SCENE section. Found by structure rather than by a
// fixed id, because ids move whenever the panel gains a widget, and by
// looking for the list itself rather than for whatever follows the bar:
// the section's body is a stack, so "the next container" is the body and
// the rows are a level further down.
scene_list_id(t: *Tree) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && w.text == "SCENE" {
            bar = in_panel(t, w)
            if bar != null {
                // The section's body: the first sibling past the bar, by id.
                body = null as *Widget
                j = 0
                while j < n {
                    s = tree_at(t, j)
                    if s.parent == bar.parent && s.id > bar.id && (body == null || s.id < body.id) { body = s }
                    j = j + 1
                }
                if body != null {
                    // The list is the first container in it. The toolkit
                    // reports a listbox as a stack, so this cannot ask for
                    // the type by name and has to take the first one.
                    best = null as *Widget
                    j = 0
                    while j < n {
                        k = tree_at(t, j)
                        if k.parent == body.id && (k.kind == "vstack" || k.kind == "listbox") && (best == null || k.id < best.id) { best = k }
                        j = j + 1
                    }
                    if best != null { return best.id }
                }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// The object's name, past the one-character kind marker the row carries.
//
// The list draws " ~  water" so the kind is readable before anything is
// selected. A check that compared the whole label against "water" was
// reading the presentation, and broke the moment the presentation
// improved.
row_name(t: *Tree, row: *Widget) -> string {
    kids = descendants(t, row.id)
    first = ""
    i = 0
    while i < list.size(kids) && first == "" {
        k = list.get_raw(kids, i) as *Widget
        // The disclosure of a row with children is a glyph before the
        // label, and a leaf's is a blank the same width: neither is the name.
        trimmed = string.trim(k.text)
        if trimmed != "" && k.text != "▸" && k.text != "▾" { first = k.text }
        string.free(trimmed)
        i = i + 1
    }
    list.free(kids)
    if first == "" { return "?" }
    // A one-character marker (one code point, however many bytes), spaces,
    // and the name.
    cut = string.string_index_of(first, " ")
    if cut > 0 && codepoints(first, cut) == 1 {
        rest = string.substring(first, cut, string.length(first))
        name = string.trim(rest)
        string.free(rest)
        return name
    }
    return string.copy(first)
}

// How many UTF-8 code points the first `bytes` bytes of a string hold.
codepoints(s: string, bytes: int) -> int {
    count = 0
    i = 0
    while i < bytes {
        c = string.char_at(s, i)
        if c < 128 || c >= 192 { count = count + 1 }
        i = i + 1
    }
    return count
}

// The row of the scene list named so, or null.
row_named(t: *Tree, scene: int, name: string) -> *Widget {
    rows = object_rows(t, scene)
    found = null as *Widget
    i = 0
    while i < list.size(rows) && found == null {
        row = list.get_raw(rows, i) as *Widget
        rn = row_name(t, row)
        if string.equals(rn, name) == 1 { found = row }
        string.free(rn)
        i = i + 1
    }
    list.free(rows)
    return found
}

// Whether the selection's inspector shows a Water panel: 1 or 0.
water_section_visible(t: *Tree) -> int {
    if count_shown(t, "text", "wave height") > 0 { return 1 }
    return 0
}

// The tree once a caption shows, within `seconds`: null if it never did.
wait_shown(text: string, seconds: float) -> *Tree {
    waited = 0.0
    while waited < seconds {
        t = tree()
        if count_shown(t, "text", text) > 0 { return t }
        tree_free(t)
        sleep(200)
        waited = waited + 0.2
    }
    return null
}

// Every row has to report its own kind, whatever happened before it.
//
// The model, the component saying what it is, and the script sit at the
// same index in three lists. When only some of them move, every object
// past that point answers for another one, and the way that shows is an
// object whose inspector belongs to something else. Selecting each row
// and asking whether the water section is open is the cheapest question
// that notices. Answers "" when every row is right.
audit_kinds(scene: int, step: string) -> string {
    t = tree()
    rows = object_rows(t, scene)
    i = 0
    while i < list.size(rows) {
        row = list.get_raw(rows, i) as *Widget
        name = row_name(t, row)
        click(row.id)
        sleep(450)
        now = tree()
        shown = water_section_visible(now)
        tree_free(now)
        wanted = 0
        if name == "water" { wanted = 1 }
        if shown != wanted {
            out = "after ${step}, the row '${name}' reports the water section as ${shown}"
            string.free(name)
            list.free(rows)
            tree_free(t)
            return out
        }
        string.free(name)
        i = i + 1
    }
    list.free(rows)
    tree_free(t)
    return ""
}

// Whether a widget and every container above it is showing.
on_screen(t: *Tree, w: *Widget) -> bool {
    at = w
    while at != null {
        if at.visible == false { return false }
        at = widget(t, at.parent)
    }
    return true
}

// The number box on an inspector row, given the row's caption: the first
// text field beside it, or null.
row_box(t: *Tree, caption: *Widget) -> *Widget {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == caption.parent && w.kind == "textfield" { return w }
        i = i + 1
    }
    return null
}

// The text of every box in the row a caption heads, in order, joined:
// "60.00,30.00,0.00" for a position. Empty where there is no such caption.
row_values(t: *Tree, caption_text: string) -> string {
    caption = find_widget(t, "text", caption_text)
    if caption == null { return "" }
    joined = ""
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == caption.parent && w.kind == "textfield" {
            joined = "${joined}${widget_text(t, w.id)},"
        }
        i = i + 1
    }
    return joined
}

// Where the selection stands, as its transform rows read.
transform_values(t: *Tree) -> string {
    return "${row_values(t, "position")}${row_values(t, "rotation")}${row_values(t, "scale")}"
}

// The inspector's transform once it holds still: read every fifth of a
// second until two reads agree, for up to five seconds. A panel being
// rebuilt reads half one object and half the next.
settled_transform() -> string {
    t = tree()
    last = transform_values(t)
    tree_free(t)
    tries = 0
    while tries < 25 {
        sleep(200)
        t = tree()
        now = transform_values(t)
        tree_free(t)
        if now == last && now != "" { return now }
        last = now
        tries = tries + 1
    }
    return last
}

// The slider beside a caption, or null.
row_slider(t: *Tree, caption: *Widget) -> *Widget {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == caption.parent && w.kind == "slider" { return w }
        i = i + 1
    }
    return null
}

// The toggle beside a caption, or null.
row_toggle(t: *Tree, caption: *Widget) -> *Widget {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == caption.parent && w.kind == "toggle" { return w }
        i = i + 1
    }
    return null
}

// The first slider listed after a widget, by id, or null.
slider_after(t: *Tree, id: int) -> *Widget {
    n = tree_count(t)
    best = null as *Widget
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "slider" && w.id > id && (best == null || w.id < best.id) { best = w }
        i = i + 1
    }
    return best
}

// Whether any text widget's text contains this.
any_text_contains(t: *Tree, needle: string) -> bool {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, needle) != 0 { return true }
        i = i + 1
    }
    return false
}

// Things a panel gets wrong that a person reads past.
//
// Both of these were found by measuring the tree by hand and neither by
// looking at screenshots, across several passes over the same panels.
// They are mechanical properties, so they are checked rather than
// remembered. Answers the faults, semicolon-separated, or "".
layout_faults(t: *Tree) -> string {
    faults = strbuilder.new(256)
    count = 0
    n = tree_count(t)
    // Every parent once.
    i = 0
    while i < n {
        parent_id = tree_at(t, i).parent
        seen = false
        j = 0
        while j < i {
            if tree_at(t, j).parent == parent_id { seen = true }
            j = j + 1
        }
        if seen == false {
            count = layout_faults_under(t, parent_id, faults, count)
        }
        i = i + 1
    }
    // A control with no size is a control nobody can use, and the tree is
    // the only place it shows.
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.visible && (w.kind == "button" || w.kind == "textfield") && (w.w <= 0.0 || w.h <= 0.0) {
            label = w.raw_text
            if string.length(label) > 20 { label = string.substring(w.raw_text, 0, 20) }
            count = add_fault(faults, count, "${w.kind} '${label}' has no size")
        }
        i = i + 1
    }
    // A frame inside a frame of the same colour, shorter than the one
    // around it, has its bottom edge somewhere in the middle: a line drawn
    // across the panel with nothing under it, and the column reads as a
    // card that stopped short of the window.
    i = 0
    while i < n {
        w = tree_at(t, i)
        parent = widget(t, w.parent)
        if parent != null && w.visible && w.border_width != 0.0 && w.border_color != "" &&
           parent.border_color == w.border_color && w.h < parent.h {
            count = add_fault(faults, count, "${w.kind} ${w.id} is framed inside its parent's frame and stops at y=${(w.y + w.h) as int}")
        }
        i = i + 1
    }
    return strbuilder.finish(faults)
}

add_fault(faults: ptr, count: int, text: string) -> int {
    if count > 0 { strbuilder.append(faults, "; ") }
    strbuilder.append(faults, text)
    return count + 1
}

// The faults among one parent's shown children, in order of y.
layout_faults_under(t: *Tree, parent_id: int, faults: ptr, count: int) -> int {
    shown = list.new()
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.parent == parent_id && w.visible && w.h > 0.0 {
            // Insertion by y.
            list.add_raw(shown, widget_ptr(w))
            k = list.size(shown) - 1
            while k > 0 && (list.get_raw(shown, k - 1) as *Widget).y > w.y {
                list.list_set(shown, k, list.get_raw(shown, k - 1))
                k = k - 1
            }
            list.list_set(shown, k, widget_ptr(w))
        }
        i = i + 1
    }
    // Two rules with nothing between them. A section that hides its
    // heading and its rows and keeps its rule leaves one stacked against
    // the next section's, which is what the water settings did.
    previous = null as *Widget
    i = 0
    while i < list.size(shown) {
        kid = list.get_raw(shown, i) as *Widget
        if previous != null && previous.kind == "divider" && kid.kind == "divider" {
            count = add_fault(faults, count, "two rules with nothing between them at y=${previous.y as int} and y=${kid.y as int}")
        }
        previous = kid
        i = i + 1
    }
    // Rows of buttons in one stack start at one x. A row that carries its
    // own inset over the panel's starts further in than the full-width
    // buttons above and below it: the same control with two edges.
    //
    // Only where the children are stacked vertically. Two buttons side by
    // side in a row have different left edges because that is what a row
    // is, and the first version of this check flagged every pair in the
    // panel for it.
    container = widget(t, parent_id)
    if container != null && container.kind == "vstack" {
        edges = calloc(list.size(shown) + 1, 8) as float[]
        edge_count = 0
        i = 0
        while i < list.size(shown) {
            kid = list.get_raw(shown, i) as *Widget
            start = 0.0
            found = false
            j = 0
            while j < n {
                b = tree_at(t, j)
                if b.kind == "button" && b.visible && b.w > 0.0 && (b.id == kid.id || b.parent == kid.id) {
                    if found == false || b.x < start { start = b.x }
                    found = true
                }
                j = j + 1
            }
            if found {
                known = false
                e = 0
                while e < edge_count {
                    if edges[e] == start { known = true }
                    e = e + 1
                }
                if known == false {
                    edges[edge_count] = start
                    edge_count = edge_count + 1
                }
            }
            i = i + 1
        }
        if edge_count > 1 {
            text = strbuilder.new(64)
            strbuilder.append(text, "button rows in one stack start at [")
            e = 0
            while e < edge_count {
                if e > 0 { strbuilder.append(text, ", ") }
                strbuilder.append(text, "${edges[e] as int}")
                e = e + 1
            }
            strbuilder.append(text, "]")
            line = strbuilder.finish(text)
            count = add_fault(faults, count, line)
            string.free(line)
        }
        free(edges)
    }
    list.free(shown)
    return count
}

// --- waiting -------------------------------------------------------------------------------------------------

// What a wait looks for: the predicate, and what it compares against.
// Every count in here is asserted after an action the editor performs in
// its own time. Sleeping first and asserting second passes on an idle
// machine and fails inside a full ci run, and the failure names the
// check rather than the machine, which is the worst way to learn about a
// timing assumption.
struct Want {
    pred: int                      // one of the WANT_ kinds
    id: int
    count: int
    text: string
    value: float
    flag: bool
}

const WANT_ROWS = 1                // the scene list `id` holds `count` rows
const WANT_TEXT = 2                // widget `id` spells `text`
const WANT_TEXT_NOT = 3            // widget `id` no longer spells `text`
const WANT_ON_SCREEN = 4           // widget `id` is on screen (`flag`) or off it
const WANT_CONTAINS = 5            // some text widget contains `text`
const WANT_VALUE = 6               // slider `id` is within 0.001 of `value`
const WANT_ACTIVE = 7              // toggle `id` is on (`flag`) or off
const WANT_LIT = 8                 // button `id` is lit (`flag`) or not
const WANT_COSTS = 9               // the stats bar shows the frame split
const WANT_TERRAIN = 10            // a Terrain component's panel is on screen
const WANT_TRIANGLES_ABOVE = 11    // the title's triangle count is above `count`
const WANT_TRIANGLES_NOT = 12      // the title's triangle count is not `count`
const WANT_SCULPTED = 13           // the console says columns were sculpted
const WANT_ONLY_LIT = 14           // among the buttons named in `text` (comma-separated), exactly the one at `id` is lit (`flag`) or none
const WANT_CHANNELS = 15           // the three sky channels are within 0.01 of `value`
const WANT_KINDS_LIT = 16          // among the weather kinds under parent `count`, only `text` is lit
const WANT_FILES = 17              // the scripts directory has more than `count` entries
const WANT_COLOUR = 18             // the material's three channels are within 0.02 of g_colour_want

var g_channels: ptr = null         // int[3], the sky's channel sliders
var g_material_channels: ptr = null  // int[3], the material's channel sliders
var g_colour_want: ptr = null      // float[3], the colour WANT_COLOUR waits for
var g_ok: ptr = null               // int[1], what the picker's waits report

holds(t: *Tree, want: *Want) -> bool {
    if want.pred == WANT_ROWS { return object_count(t, want.id) == want.count }
    if want.pred == WANT_TEXT { return widget_text(t, want.id) == want.text }
    if want.pred == WANT_TEXT_NOT { return widget_text(t, want.id) != want.text }
    if want.pred == WANT_ON_SCREEN {
        w = widget(t, want.id)
        if w == null { return want.flag == false }
        return on_screen(t, w) == want.flag
    }
    if want.pred == WANT_CONTAINS { return any_text_contains(t, want.text) }
    if want.pred == WANT_VALUE {
        d = widget_value(t, want.id) - want.value
        if d < 0.0 { d = 0.0 - d }
        return d < 0.001
    }
    if want.pred == WANT_ACTIVE { return widget_active(t, want.id) == want.flag }
    if want.pred == WANT_LIT { return widget_lit(t, want.id) == want.flag }
    if want.pred == WANT_COSTS { return costs(t) != "" }
    if want.pred == WANT_TERRAIN { return component_body_id(t, "Terrain") >= 0 }
    if want.pred == WANT_TRIANGLES_ABOVE { return triangles(t) > want.count }
    if want.pred == WANT_TRIANGLES_NOT { return triangles(t) != want.count }
    if want.pred == WANT_SCULPTED { return sculpted(t) > 0 }
    if want.pred == WANT_ONLY_LIT { return only_lit(t, want.text, want.id, want.flag) }
    if want.pred == WANT_CHANNELS {
        channels = g_channels as int[]
        c = 0
        while c < 3 {
            d = widget_value(t, channels[c]) - want.value
            if d < 0.0 { d = 0.0 - d }
            if d >= 0.01 { return false }
            c = c + 1
        }
        return true
    }
    if want.pred == WANT_KINDS_LIT { return kinds_lit(t, want.count) == want.text }
    if want.pred == WANT_FILES { return script_count() > want.count }
    if want.pred == WANT_COLOUR {
        // The colour the picker's hex box says, within five of each byte.
        channels = g_material_channels as int[]
        wanted = g_colour_want as float[]
        return hex_near(widget_text(t, channels[0]), (wanted[0] * 255.0 + 0.5) as int,
                        (wanted[1] * 255.0 + 0.5) as int, (wanted[2] * 255.0 + 0.5) as int, 5)
    }
    return false
}

// Poll the tree until the want holds, or give up: the tree as last read,
// and whether it held. A fixed sleep is a guess about how long the editor
// takes to build a water surface and lay the panel out again, and a
// guess that is usually right is the worst kind: the check passes on
// this machine and fails on a slower one for reasons that have nothing
// to do with the editor.
wait_for(want: *Want, seconds: float, ok_out: int[]) -> *Tree {
    deadline = os.now_monotonic_ms() + ((seconds * 1000.0) as long)
    t = tree()
    while os.now_monotonic_ms() < deadline {
        if holds(t, want) {
            ok_out[0] = 1
            return t
        }
        tree_free(t)
        sleep(250)
        t = tree()
    }
    if holds(t, want) { ok_out[0] = 1 } else { ok_out[0] = 0 }
    return t
}

want(pred: int) -> *Want {
    w = calloc(1, sizeof(Want)) as *Want
    w.pred = pred
    w.text = ""
    return w
}

// Wait for the scene list to hold `count` rows, then report what it holds.
// The viewport's pane: the inner splitter's first child, the stage the
// viewport fills whatever it is drawn through (a canvas over a readback on
// Windows and macOS, a GL area on GTK).
viewport_width(t: *Tree) -> float {
    // The size the editor renders the view at, off the stats bar ("... 3468
    // tris   868x620"): the viewport following its pane is the point, and it
    // is the same on every toolkit. A pane's own box is not -- GTK reports
    // the paned's children under wrappers of its own, where they read 0.
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, " tris ") != 0 {
            text = w.raw_text
            end = string.length(text)
            start = end
            while start > 0 && string.char_at(text, start - 1) != 32 { start = start - 1 }
            size = string.substring(text, start, end)
            cross = string.string_index_of(size, "x")
            width = 0.0
            if cross > 0 {
                digits = string.substring(size, 0, cross)
                width = string.get_double(digits)
                string.free(digits)
            }
            string.free(size)
            return width
        }
        i = i + 1
    }
    return 0.0
}

// The height the editor renders the view at, off the same stats bar.
viewport_height(t: *Tree) -> float {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, " tris ") != 0 {
            text = w.raw_text
            end = string.length(text)
            start = end
            while start > 0 && string.char_at(text, start - 1) != 32 { start = start - 1 }
            size = string.substring(text, start, end)
            cross = string.string_index_of(size, "x")
            height = 0.0
            if cross > 0 {
                digits = string.substring(size, cross + 1, string.length(size))
                height = string.get_double(digits)
                string.free(digits)
            }
            string.free(size)
            return height
        }
        i = i + 1
    }
    return 0.0
}

// The splitter inside the other one: the viewport against the inspector.
inner_splitter(t: *Tree) -> *Widget {
    n = list.size(t.widgets)
    i = 0
    while i < n {
        w = list.get_raw(t.widgets, i) as *Widget
        if w.kind == "splitview" {
            parent = widget_by_id(t, w.parent)
            if parent != null && parent.kind == "splitview" { return w }
        }
        i = i + 1
    }
    return null
}

widget_by_id(t: *Tree, id: int) -> *Widget {
    n = list.size(t.widgets)
    i = 0
    while i < n {
        w = list.get_raw(t.widgets, i) as *Widget
        if w.id == id { return w }
        i = i + 1
    }
    return null
}

// The panels are the user's to size: two splitters, the inner one dragged
// a hundred and twenty pixels toward the viewport, and the viewport's pane
// has to come out that much narrower, and back when the divider goes back.
check_splitters() {
    t = tree()
    inner = inner_splitter(t)
    check_detail("the viewport and the inspector share a splitter", inner != null, "no splitview inside a splitview")
    if inner == null {
        tree_free(t)
        return
    }
    inner_id = inner.id
    // The inspector beside the viewport, not over it: on win32 a layout the
    // editor's settle re-entered left the second pane where an older pass put
    // it, over the middle of the first (aether-ui#209). Where the toolkit
    // reports the panes' boxes (GTK does not, see viewport_width).
    first = null as *Widget
    second = null as *Widget
    i = 0
    while i < tree_count(t) {
        w = tree_at(t, i)
        if w.parent == inner_id {
            if first == null || w.id < first.id {
                second = first
                first = w
            } else if second == null || w.id < second.id {
                second = w
            }
        }
        i = i + 1
    }
    if first != null && second != null && first.w > 0.0 && second.w > 0.0 {
        check_detail("the inspector's pane starts where the viewport's ends", second.x >= first.x + first.w - 1.0,
                     "viewport ${first.x}+${first.w}, inspector at ${second.x}")
    }
    before = viewport_width(t)
    tree_free(t)
    // Where the divider stands now, read by the route that moves it.
    start = 0
    body, err = http.post(url("/widget/${inner_id}/split_position?px=-1"), "", "text/plain")
    if err == "" {
        answer, perr = json.parse(body)
        if perr == "" {
            start = field_number(answer, "position") as int
            json.json_free(answer)
        }
    }
    check_detail("the splitter says where its divider is", start > 0, "position ${start}")
    if start <= 0 { return }
    // Where the divider went, as the toolkit answers: short of where it was
    // sent means something in a pane would not shrink.
    moved = 0 - 1
    moved_body, moved_err = http.post(url("/widget/${inner_id}/split_position?px=${start - 120}"), "", "text/plain")
    if moved_err == "" {
        answer, perr = json.parse(moved_body)
        if perr == "" {
            moved = field_number(answer, "position") as int
            json.json_free(answer)
        }
    }
    after = before
    tries = 0
    while tries < 80 && after > before - 60.0 {
        sleep(50)
        t = tree()
        after = viewport_width(t)
        tree_free(t)
        tries = tries + 1
    }
    narrowed = after < before - 100.0 && after > before - 140.0
    // What is still wider than the divider now allows, when the viewport
    // did not follow: the widget whose width is holding the pane open.
    holding = ""
    if !narrowed {
        t = tree()
        i = 0
        while i < tree_count(t) {
            w = tree_at(t, i)
            if w.w > (moved as float) + 2.0 && w.w < before + 40.0 && w.kind != "splitview" {
                holding = "${holding} ${w.kind}#${w.id}(${w.w}, parent ${w.parent}, '${w.text}')"
            }
            // And the viewport's own widgets, whatever their width: what
            // the toolkit gave them against what the editor renders at.
            if w.kind == "canvas" || w.kind == "gpuview" || w.kind == "glarea" {
                holding = "${holding} [${w.kind}#${w.id} ${w.w}x${w.h}]"
            }
            i = i + 1
        }
        tree_free(t)
    }
    detail = "${before} before, ${after} after a 120 px drag; the divider went from ${start} to ${moved}; wider than it:${holding}"
    // On GTK the divider moves but neither the viewport's canvas nor its GL
    // area says it changed size, and both read 0 x 0 when asked, so the
    // editor cannot follow it there yet (#412, aether-ui#211): a note on
    // Linux, a check everywhere else.
    if os.platform() == "linux" {
        check_note("dragging the divider narrows the viewport by what the inspector took", narrowed, detail, 412)
    } else {
        check_detail("dragging the divider narrows the viewport by what the inspector took", narrowed, detail)
    }
    post("/widget/${inner_id}/split_position?px=${start}")
    back = after
    tries = 0
    while tries < 80 && back < before - 2.0 {
        sleep(50)
        t = tree()
        back = viewport_width(t)
        tree_free(t)
        tries = tries + 1
    }
    check_detail("and dragging it back gives the width back", back > before - 3.0 && back < before + 3.0, "${back} against ${before}")
}

// --- the colour picker (#407) ------------------------------------------------------
//
// The square and the strip under the material's chip, driven through the
// canvas routes the way a mouse drives them, and judged three ways: the
// sliders the colour has to reach, the hex beside the chip, and the pixels
// the picker painted.

// The picker's canvas handle. The canvas routes take a canvas's own handle,
// which counts from one in the order the canvases were made, and widget ids
// count up in the same order; so the handle is the picker's rank among the
// tree's canvases, the picker being the canvas in the MATERIAL section. (The
// canvases' own debug route reports 0 x 0 for all of them in a hidden run.)
picker_handle() -> int {
    t = tree()
    body = section_body_id(t, "COLOUR")
    picker = 0 - 1
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "canvas" && w.parent == body { picker = w.id }
        i = i + 1
    }
    rank = 0
    if picker >= 0 {
        i = 0
        while i < n {
            w = tree_at(t, i)
            if w.kind == "canvas" && w.id <= picker { rank = rank + 1 }
            i = i + 1
        }
    }
    tree_free(t)
    if picker < 0 { return 0 - 1 }
    return rank
}

// The COLOUR section's hex box into hex_out: what the picker writes and
// reads back, beside the Material panel's own colour row. False when it is
// missing.
material_colour_rows(t: *Tree, hex_out: int[]) -> bool {
    body = section_body_id(t, "COLOUR")
    if body < 0 { return false }
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && w.text == "colour" {
            row = widget(t, w.parent)
            if row != null && row.parent == body {
                box = row_box(t, w)
                if box != null { hex_out[0] = box.id }
            }
        }
        i = i + 1
    }
    return hex_out[0] > 0
}

// The picker canvas's width as laid out, off the tree.
picker_width(t: *Tree) -> float {
    body = section_body_id(t, "COLOUR")
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "canvas" && w.parent == body { return w.w }
        i = i + 1
    }
    return 0.0
}

// A press and a release at one point of the picker.
picker_click(handle: int, x: float, y: float) {
    xi = (x + 0.5) as int
    yi = (y + 0.5) as int
    post("/canvas/${handle}/click?x=${xi}&y=${yi}")
    post("/canvas/${handle}/release?x=${xi}&y=${yi}")
}

// Wait for the material's colour to read (r, g, b).
wait_colour(r: float, g: float, b: float) -> bool {
    wanted = g_colour_want as float[]
    wanted[0] = r
    wanted[1] = g
    wanted[2] = b
    wt = want(WANT_COLOUR)
    t = wait_for(wt, 8.0, g_ok as int[])
    free(wt as ptr)
    tree_free(t)
    ok = g_ok as int[]
    return ok[0] == 1
}

// One painted pixel of the picker as 0xRRGGBB, or -1. The route packs it
// 0xAARRGGBB into a signed int, so an opaque pixel arrives negative.
picker_pixel(handle: int, x: int, y: int, w: int) -> long {
    info = get_json("/canvas/${handle}/pixel?x=${x}&y=${y}&w=${w}&h=122")
    value = field_number(info, "pixel")
    json.json_free(info)
    if value == 0.0 - 1.0 { return 0 - 1 }
    packed = (value) as long
    if packed < 0 { packed = packed + 4294967296 }
    return packed % 16777216
}

// Whether a pixel is within `slack` of (r, g, b) in bytes.
pixel_near(pixel: long, r: int, g: int, b: int, slack: int) -> bool {
    if pixel < 0 { return false }
    pr = ((pixel / 65536) % 256) as int
    pg = ((pixel / 256) % 256) as int
    pb = (pixel % 256) as int
    return abs_int(pr - r) <= slack && abs_int(pg - g) <= slack && abs_int(pb - b) <= slack
}

// A hex digit's value, or -1.
hex_digit_at(text: string, at: int) -> int {
    c = string.char_at(text, at)
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return 0 - 1
}

// Whether "#RRGGBB" is within `slack` of (r, g, b) in bytes.
hex_near(text: string, r: int, g: int, b: int, slack: int) -> bool {
    if string.length(text) != 7 || string.char_at(text, 0) != 35 { return false }
    block = calloc(3, 4)
    wanted = block as int[]
    wanted[0] = r
    wanted[1] = g
    wanted[2] = b
    ok = true
    c = 0
    while c < 3 {
        high = hex_digit_at(text, 1 + c * 2)
        low = hex_digit_at(text, 2 + c * 2)
        if high < 0 || low < 0 || abs_int(high * 16 + low - wanted[c]) > slack { ok = false }
        c = c + 1
    }
    free(block)
    return ok
}

abs_int(v: int) -> int {
    if v < 0 { return 0 - v }
    return v
}

check_colour_picker() {
    handle = picker_handle()
    check_detail("the material has a colour picker", handle > 0, "no canvas in the COLOUR section")
    if handle <= 0 { return }
    if g_material_channels == null { g_material_channels = calloc(3, 4) }
    if g_colour_want == null { g_colour_want = calloc(3, 8) }
    if g_ok == null { g_ok = calloc(1, 4) }
    t = tree()
    hex_block = calloc(1, 4)
    hex_box = hex_block as int[]
    rows = material_colour_rows(t, hex_box)
    width = picker_width(t)
    tree_free(t)
    check_detail("beside a hex field", rows, "the COLOUR section's hex box is missing")
    if !rows {
        free(hex_block)
        return
    }
    hex = hex_box[0]
    channels = g_material_channels as int[]
    channels[0] = hex

    // The hex, typed: the sliders follow. Nothing here needs the picker's
    // size, so it holds everywhere.
    set_text(hex, "#FF0000")
    check("a colour typed into the hex field sets the material", wait_colour(1.0, 0.0, 0.0))

    // The rest is clicked by position, and GTK reports a canvas as 0 x 0
    // (#412, aether-ui#211): a note on Linux until it says the picker's
    // width, a check everywhere else.
    laid_out = width > 150.0
    if os.platform() == "linux" && !laid_out {
        check_note("and laid out across the panel", laid_out, "${width} points wide", 412)
        free(hex_block)
        return
    }
    check_detail("and laid out across the panel", laid_out, "${width} points wide")
    if !laid_out {
        free(hex_block)
        return
    }
    span = width - 1.0

    // The picker's hue followed the hex: the top right of the square, full
    // saturation and value, is red.
    top_right = picker_pixel(handle, (span - 2.0) as int, 2, (width) as int)
    check_detail("and the picker's square is painted at its hue", pixel_near(top_right, 253, 0, 0, 12),
                 "top right pixel ${top_right}")

    // The strip a third of the way along is green; the square's top right
    // corner is then the pure hue.
    picker_click(handle, span / 3.0, 116.0)
    picker_click(handle, span, 0.0)
    check("the strip picks the hue and the square the colour", wait_colour(0.0, 1.0, 0.0))

    // The middle of the square: half the saturation, half the value.
    picker_click(handle, span / 2.0, 51.5)
    check("the middle of the square is half saturation, half value", wait_colour(0.25, 0.5, 0.25))
    t = tree()
    hex_now = string.copy(widget_text(t, hex))
    tree_free(t)
    check_detail("and the hex beside the chip says so", hex_near(hex_now, 64, 128, 64, 4), "'${hex_now}'")
    string.free(hex_now)

    // A drag is one step: one Undo puts the colour back from before it.
    undo = find_in_tree("button", "Undo")
    if undo >= 0 {
        click(undo)
        check("one Undo takes a whole drag back", wait_colour(0.0, 1.0, 0.0))
    }
    free(hex_block)
}

// The id of the first widget of this kind with this text in a fresh tree.
find_in_tree(kind: string, text: string) -> int {
    t = tree()
    id = find(t, kind, text)
    tree_free(t)
    return id
}

wait_rows(scene: int, count: int) -> int {
    w = want(WANT_ROWS)
    w.id = scene
    w.count = count
    ok = calloc(1, 4) as int[]
    t = wait_for(w, 8.0, ok)
    rows = object_count(t, scene)
    tree_free(t)
    free(w as ptr)
    free(ok)
    return rows
}

// Wait until a widget spells this, and answer what it spells.
wait_text(id: int, wanted: string) -> string {
    w = want(WANT_TEXT)
    w.id = id
    w.text = wanted
    ok = calloc(1, 4) as int[]
    t = wait_for(w, 8.0, ok)
    spelled = string.copy(widget_text(t, id))
    tree_free(t)
    free(w as ptr)
    free(ok)
    return spelled
}

// Wait until the scene list stops changing size.
//
// A load rebuilds the list, and a row clicked while it is still being
// rebuilt is a row that is about to be replaced: the selection goes with
// it, and what follows asks the editor about whatever ended up selected
// instead.
wait_rows_settled(scene: int, seconds: float) -> int {
    deadline = os.now_monotonic_ms() + ((seconds * 1000.0) as long)
    count = 0 - 1
    while os.now_monotonic_ms() < deadline {
        t = tree()
        rows = object_count(t, scene)
        tree_free(t)
        if rows > 0 && rows == count { return rows }
        count = rows
        sleep(200)
    }
    return count
}

// Wait for a file to exist, or to have been written again since.
//
// Existence alone is not enough for a second save: the file is already
// there from the first one, so the wait returns at once and a Load that
// follows can read what was on disk before rather than what was just
// asked for. That is a race that passes almost every time and fails on a
// busy machine, which is the worst kind to have in a suite.
file_written(path: string, newer_than: long) -> bool {
    if file.file_exists(path) == 0 { return false }
    size, serr = file.size(path)
    if serr != "" || size <= (0 as long) { return false }
    if newer_than < (0 as long) { return true }
    m, merr = fs.mtime(path)
    if merr != "" { return false }
    return m > newer_than
}

wait_file(path: string, newer_than: long) -> bool {
    deadline = os.now_monotonic_ms() + (8000 as long)
    while os.now_monotonic_ms() < deadline {
        if file_written(path, newer_than) { return true }
        sleep(100)
    }
    return file_written(path, newer_than)
}

// The file's modification time, in seconds; and the clock let run past
// that second, so a write that follows is newer by the stamp, which is
// all the resolution the stamp has.
file_stamp(path: string) -> long {
    m, err = fs.mtime(path)
    if err != "" { return 0 - 1 as long }
    while os.now_unix_ms() / (1000 as long) <= m { sleep(50) }
    return m
}

// --- what the tree says --------------------------------------------------------------------------------------

// The stats bar's split of the frame by pass, or "".
costs(t: *Tree) -> string {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, "shadow ") != 0 && string.contains(w.raw_text, " ms") != 0 { return w.raw_text }
        i = i + 1
    }
    return ""
}

// The number after a word in a text, or -1.
number_after(text: string, word: string) -> float {
    at = string.string_index_of(text, word)
    if at < 0 { return 0.0 - 1.0 }
    start = at + string.length(word)
    while start < string.length(text) && string.char_at(text, start) == 32 { start = start + 1 }
    end = start
    while end < string.length(text) {
        c = string.char_at(text, end)
        if (c >= 48 && c <= 57) || c == 46 || c == 45 { end = end + 1 } else { break }
    }
    if end == start { return 0.0 - 1.0 }
    digits = string.substring(text, start, end)
    value = string.get_double(digits)
    string.free(digits)
    return value
}

// The title's triangle count: the number before "triangles".
triangles(t: *Tree) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, "triangles") != 0 {
            // The number is the word before "triangles".
            at = string.string_index_of(w.raw_text, "triangles")
            end = at
            while end > 0 && string.char_at(w.raw_text, end - 1) == 32 { end = end - 1 }
            start = end
            while start > 0 && string.char_at(w.raw_text, start - 1) >= 48 && string.char_at(w.raw_text, start - 1) <= 57 { start = start - 1 }
            if start < end {
                digits = string.substring(w.raw_text, start, end)
                value = string.get_int(digits)
                string.free(digits)
                return value
            }
            return 0
        }
        i = i + 1
    }
    return 0
}

// How many columns the console says the last stroke sculpted.
sculpted(t: *Tree) -> int {
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "text" && string.contains(w.raw_text, "sculpted ") != 0 {
            value = number_after(w.raw_text, "sculpted ")
            if value < 0.0 { return 0 }
            return value as int
        }
        i = i + 1
    }
    return 0
}

// Among the buttons whose text is one of `names` (comma-separated), the
// ones that are lit, comma-separated in tree order.
lit_among(t: *Tree, names: string) -> string {
    out = strbuilder.new(64)
    count = 0
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "button" && w.bg == ACCENT && named_in(w.raw_text, names) {
            if count > 0 { strbuilder.append(out, ",") }
            strbuilder.append(out, w.raw_text)
            count = count + 1
        }
        i = i + 1
    }
    return strbuilder.finish(out)
}

// Whether `name` is one of the comma-separated `names`.
named_in(name: string, names: string) -> bool {
    parts = string.split(names, ",")
    n = string.array_size(parts)
    found = false
    i = 0
    while i < n {
        if part_at(parts, i) == name { found = true }
        i = i + 1
    }
    string.array_free(parts)
    return found
}

part_at(parts: ptr, i: int) -> string { return string.string_array_get(parts, i) }

// Whether, among the named buttons, exactly the one at `id` is lit (or,
// with `flag` false, none of them).
only_lit(t: *Tree, names: string, id: int, flag: bool) -> bool {
    lit = lit_among(t, names)
    if flag == false {
        ok = lit == ""
        string.free(lit)
        return ok
    }
    w = widget(t, id)
    ok = w != null && lit == w.raw_text
    string.free(lit)
    return ok
}

// The lit weather kinds under the row `parent`, comma-separated.
// The lit buttons of a row of kinds (the weather's, the body's), by name.
kinds_lit(t: *Tree, parent: int) -> string {
    out = strbuilder.new(32)
    count = 0
    n = tree_count(t)
    i = 0
    while i < n {
        w = tree_at(t, i)
        if w.kind == "button" && w.parent == parent && w.bg == ACCENT {
            if count > 0 { strbuilder.append(out, ",") }
            strbuilder.append(out, w.text)
            count = count + 1
        }
        i = i + 1
    }
    return strbuilder.finish(out)
}

// The scripts in the project, by name, sorted: the .ae files in resources/scripts.
scripts_on_disk() -> ptr {
    names = list.new()
    l, err = dir.list(SCRIPTS_DIR)
    if err != "" { return names }
    n = dir.list_count(l)
    i = 0
    while i < n {
        entry = dir.list_get(l, i)
        if string.ends_with(entry, ".ae") != 0 {
            name = string.substring(entry, 0, string.length(entry) - 3)
            list.add(names, name)
            // Sorted by byte order.
            k = list.size(names) - 1
            added = list.get_raw(names, k)
            while k > 0 && string.compare(name_at(names, k - 1), name) > 0 {
                list.list_set(names, k, list.get_raw(names, k - 1))
                k = k - 1
            }
            list.list_set(names, k, added)
        }
        i = i + 1
    }
    return names
}

name_at(names: ptr, i: int) -> string { return list.get_raw(names, i) }

script_count() -> int {
    l, err = dir.list(SCRIPTS_DIR)
    if err != "" { return 0 }
    return dir.list_count(l)
}

// The scene file's view.rendering or view.weather object, or null; the
// caller frees the root through the second slot.
scene_section(section: string, root_out: ptr[]) -> ptr {
    text, err = file.read(SCENE_FILE)
    if err != "" { return null }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return null }
    root_out[0] = root
    view = json.json_object_get_raw(root, "view")
    if view == null { return null }
    return json.json_object_get_raw(view, section)
}

// How many of the scene file's lights are of this mode (0 point, 1
// directional, 2 spot).
// The scene file's lights of a kind, wherever they are: the scene's key
// light in the root array, and the light of every marker with the model
// it stands for.
scene_lights_of_kind(root_out: ptr[], mode: int) -> int {
    text, err = file.read(SCENE_FILE)
    if err != "" { return 0 }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return 0 }
    root_out[0] = root
    found = 0
    lights = json.json_object_get_raw(root, "lights")
    if lights != null {
        count = json.json_array_size(lights)
        i = 0
        while i < count {
            entry = json.json_array_get_raw(lights, i)
            if (field_number(entry, "mode")) as int == mode { found = found + 1 }
            i = i + 1
        }
    }
    models = json.json_object_get_raw(root, "models")
    if models != null {
        model_count = json.json_array_size(models)
        j = 0
        while j < model_count {
            beam = json.json_object_get_raw(json.json_array_get_raw(models, j), "light")
            if beam != null && (field_number(beam, "mode")) as int == mode { found = found + 1 }
            j = j + 1
        }
    }
    return found
}

// The cones of the file's spot lights, as the cosine of the outer angle:
// the widest of them, or 0 where the file has no spot. A cone the file
// does not carry reads zero here, which is a spot that lights nothing.
scene_widest_cone() -> float {
    text, err = file.read(SCENE_FILE)
    if err != "" { return 0.0 }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return 0.0 }
    widest = 0.0
    lights = json.json_object_get_raw(root, "lights")
    if lights != null {
        light_count = json.json_array_size(lights)
        i = 0
        while i < light_count {
            beam = json.json_array_get_raw(lights, i)
            if (field_number(beam, "mode")) as int == 2 {
                outer = field_number(beam, "cos_outer")
                if outer > widest { widest = outer }
            }
            i = i + 1
        }
    }
    models = json.json_object_get_raw(root, "models")
    if models != null {
        model_count = json.json_array_size(models)
        j = 0
        while j < model_count {
            beam = json.json_object_get_raw(json.json_array_get_raw(models, j), "light")
            if beam != null && (field_number(beam, "mode")) as int == 2 {
                outer = field_number(beam, "cos_outer")
                if outer > widest { widest = outer }
            }
            j = j + 1
        }
    }
    json.json_free(root)
    return widest
}

// Where the scene file's view puts the camera, into `out` (x, y, z).
// False where the file has no view.
scene_camera(out: float[]) -> bool {
    text, err = file.read(SCENE_FILE)
    if err != "" { return false }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return false }
    view = json.json_object_get_raw(root, "view")
    if view == null {
        json.json_free(root)
        return false
    }
    at = json.json_object_get_raw(view, "position")
    if at == null {
        json.json_free(root)
        return false
    }
    out[0] = json.json_get_number(json.json_array_get_raw(at, 0))
    out[1] = json.json_get_number(json.json_array_get_raw(at, 1))
    out[2] = json.json_get_number(json.json_array_get_raw(at, 2))
    json.json_free(root)
    return true
}

// Where the scene file's first group stands, into `out`. A group is a
// model with no mesh of its own.
scene_group_at(out: float[]) -> bool {
    text, err = file.read(SCENE_FILE)
    if err != "" { return false }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return false }
    models = json.json_object_get_raw(root, "models")
    found = false
    if models != null {
        count = json.json_array_size(models)
        i = 0
        while i < count && found == false {
            entry = json.json_array_get_raw(models, i)
            if json.json_object_get_raw(entry, "group") != null {
                place = json.json_object_get_raw(entry, "position")
                if place != null {
                    out[0] = json.json_get_number(json.json_array_get_raw(place, 0))
                    out[1] = json.json_get_number(json.json_array_get_raw(place, 1))
                    out[2] = json.json_get_number(json.json_array_get_raw(place, 2))
                    found = true
                }
            }
            i = i + 1
        }
    }
    json.json_free(root)
    return found
}

// How many models of the scene file are not visible.
scene_models_hidden(root_out: ptr[]) -> int {
    text, err = file.read(SCENE_FILE)
    if err != "" { return 0 }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return 0 }
    root_out[0] = root
    models = json.json_object_get_raw(root, "models")
    if models == null { return 0 }
    found = 0
    count = json.json_array_size(models)
    i = 0
    while i < count {
        entry = json.json_array_get_raw(models, i)
        shown = json.json_object_get_raw(entry, "visible")
        if shown != null && !field_flag(entry, "visible") { found = found + 1 }
        i = i + 1
    }
    return found
}

// How many models of the scene file name a parent.
scene_models_parented(root_out: ptr[]) -> int {
    text, err = file.read(SCENE_FILE)
    if err != "" { return 0 }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return 0 }
    root_out[0] = root
    models = json.json_object_get_raw(root, "models")
    if models == null { return 0 }
    found = 0
    count = json.json_array_size(models)
    i = 0
    while i < count {
        entry = json.json_array_get_raw(models, i)
        if json.json_object_get_raw(entry, "parent") != null { found = found + 1 }
        i = i + 1
    }
    return found
}

// How many models of the scene file carry a dynamic body's record.
scene_models_with_body(root_out: ptr[]) -> int {
    return scene_models_with_body_kind(root_out, "dynamic")
}

// The models the scene file records with a body of `kind`.
scene_models_with_body_kind(root_out: ptr[], kind: string) -> int {
    text, err = file.read(SCENE_FILE)
    if err != "" { return 0 }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return 0 }
    root_out[0] = root
    models = json.json_object_get_raw(root, "models")
    if models == null { return 0 }
    found = 0
    count = json.json_array_size(models)
    i = 0
    while i < count {
        entry = json.json_array_get_raw(models, i)
        body_record = json.json_object_get_raw(entry, "physics")
        if body_record != null && field_text(body_record, "body") == kind { found = found + 1 }
        i = i + 1
    }
    return found
}

json_text(node: ptr) -> string {
    if node == null { return "{}" }
    s, err = json.encode(node)
    if err != "" { return "{}" }
    return s
}

// --- the editor process --------------------------------------------------------------------------------------

// The built editor, whatever the platform calls it. Windows names the
// binary .exe, and will not take a relative path written with forward
// slashes, which fails as a file-not-found naming nothing useful.
editor_binary(path: string) -> string {
    if file.file_exists(path) != 0 { return absolute(path) }
    exe = string.concat(path, ".exe")
    if file.file_exists(exe) != 0 { return absolute(exe) }
    println("no editor at ${path}: build it with editor/build_editor.sh")
    os.exit(1)
}

absolute(path: string) -> string {
    if string.starts_with(path, "/") != 0 || (string.length(path) > 1 && string.char_at(path, 1) == 58) { return string.copy(path) }
    cwd = os.getcwd()
    joined = "${cwd}/${path}"
    if os.platform() == "windows" { return string.replace_all(joined, "/", "\\") }
    return joined
}

stop_editor() {
    if g_editor == 0 { return }
    os.kill(g_editor, 15)
    _status, timed_out, _err = os.wait_pid_timeout(g_editor, 5)
    if timed_out != 0 {
        os.kill(g_editor, 9)
        os.wait(g_editor)
    }
    g_editor = 0
}

// --- main ----------------------------------------------------------------------------------------------------

main() {
    binary = "build/ae3d_editor"
    backend = ""
    argc = os.args_count()
    i = 1
    while i + 1 < argc {
        flag = os.args_get(i)
        if flag == "--port" { g_port = string.get_int(os.args_get(i + 1)) }
        if flag == "--binary" { binary = os.args_get(i + 1) }
        if flag == "--backend" { backend = os.args_get(i + 1) }
        i = i + 2
    }

    os.io_setenv_raw("AETHER_UI_TEST_PORT", "${g_port}")
    // Never onto the desktop. The driver presses widgets over HTTP and
    // reads the tree back, none of which needs the window in front of
    // whoever is using the machine.
    if os.getenv("AETHER_UI_HEADLESS") == null || os.getenv("AETHER_UI_HEADLESS") == "" { os.io_setenv_raw("AETHER_UI_HEADLESS", "1") }
    if backend != "" { os.io_setenv_raw("AE3D_EDITOR_BACKEND", backend) }
    // Long enough that the run outlives this program; it is killed at the end.
    os.io_setenv_raw("AE3D_EDITOR_FRAMES", "100000")
    path = editor_binary(binary)
    argv = list.new()
    token, err = os.spawn_proc(path, argv, null)
    if err != "" {
        println("could not start ${path}: ${err}")
        os.exit(1)
    }
    g_editor = token

    run_checks()

    stop_editor()
    if g_failures > 0 {
        println("editor driver: ${g_failures} failure(s)")
        os.exit(1)
    }
    println("editor driver: all checks passed")
}

// Every check, in the order the editor is driven through them.
run_checks() {
    ok = calloc(1, 4) as int[]
    t = tree()
    scene = scene_list_id(t)
    if scene < 0 {
        println("could not find the scene list in the widget tree")
        stop_editor()
        os.exit(1)
    }
    tree_free(t)

    // Wait for the scene to be there before counting it. The GPU viewport
    // builds the renderer when aether-ui hands over its context, which is
    // after the window exists, and the scene is filled then: a count taken
    // the instant the tree first answers is a count of an editor still
    // starting up.
    wait_rows_settled(scene, 12.0)
    t = tree()
    before = object_count(t, scene)

    // A button, pressed where a person would press it.
    cube = find(t, "button", "Cube")
    check("the Cube button is in the tree", cube >= 0)
    if cube >= 0 {
        click(cube)
        after = wait_rows(scene, before + 1)
        tree_free(t)
        t = tree()
        check_detail("clicking Cube adds an object", after == before + 1, "${before} rows before, ${after} after")
    }

    // Undo, pressed rather than called. The report's own undo check calls
    // the editor's function from the top level; the button reaches it
    // through a closure built inside the ui.window block, which is a
    // different scope and was binding a different function entirely.
    undo = find(t, "button", "Undo")
    check("the Undo button is in the tree", undo >= 0)
    if undo >= 0 && cube >= 0 {
        click(undo)
        undone = wait_rows(scene, before)
        tree_free(t)
        t = tree()
        check_detail("clicking Undo takes the object back off", undone == before, "${undone} rows, expected ${before}")
    }

    // A number field, typed into: the cube's position, in its Transform.
    // The value has to reach the model, which is proved by selecting the
    // sphere -- an object of the same shape, so the inspector keeps its
    // panels and the same box now shows the sphere's -- and the cube again,
    // whose box then shows the model's own formatting of what was typed.
    fields = 0
    n = tree_count(t)
    i = 0
    while i < n {
        fw = tree_at(t, i)
        if fw.kind == "textfield" && on_screen(t, fw) && fw.parent != scene_body_id(t) && fw.parent != section_body_id(t, "INSPECTOR") {
            fields = fields + 1
        }
        i = i + 1
    }
    check("the inspector has number fields", fields >= 4)
    if select_named(scene, "cube") {
        now = tree()
        position = find_widget(now, "text", "position")
        x_field = 0 - 1
        if position != null {
            box = row_box(now, position)
            if box != null { x_field = box.id }
        }
        tree_free(now)
        check("the cube's transform has a position box", x_field >= 0)
        if x_field >= 0 {
            set_text(x_field, "-150.0")
            sleep(600)
            now = tree()
            typed = string.copy(widget_text(now, x_field))
            tree_free(now)
            check_detail("the field takes what is typed", typed == "-150.0", "'${typed}'")
            select_named(scene, "sphere")
            other_tree = tree()
            other = string.copy(widget_text(other_tree, x_field))
            tree_free(other_tree)
            check_detail("selecting another object of its shape keeps the box and shows the other's", other != "" && other != "-150.0", "'${other}'")
            select_named(scene, "cube")
            back_tree = tree()
            back = string.copy(widget_text(back_tree, x_field))
            tree_free(back_tree)
            // Two decimals are the inspector's; "-150.0" is what was typed.
            check_detail("what was typed reached the model", back == "-150.00", "'${back}'")
        }
    }

    // The menus. Attachment is not checked, though the name of this check
    // said so until it was sabotaged: /menus reports every menu that was
    // built, with no record of which ones reached the bar, so dropping the
    // menu_bar_add for a whole menu left it green. What it does catch is
    // an action going missing, which is the regression that happens when
    // one is added or renamed.
    menus = get_json("/menus")
    menu_count = json.json_array_size(menus)
    wanted_actions = "Save Scene,Load Scene,Undo,Redo,Duplicate,Delete,Cube,Sphere,Plane,Water,Light,Terrain,Move,Rotate,Scale,Frame Selection,Fast,Balanced,Quality"
    missing = strbuilder.new(64)
    missing_count = 0
    add_menu = 0 - 1
    parts = string.split(wanted_actions, ",")
    i = 0
    while i < string.array_size(parts) {
        action = part_at(parts, i)
        handle = menu_with(menus, action)
        if handle < 0 {
            if missing_count > 0 { strbuilder.append(missing, ", ") }
            if missing_count < 4 { strbuilder.append(missing, action) }
            missing_count = missing_count + 1
        }
        if action == "Cube" { add_menu = handle }
        i = i + 1
    }
    string.array_free(parts)
    missing_text = strbuilder.finish(missing)
    check_detail("every action the editor has is on a menu", menu_count == 4 && missing_count == 0, "${menu_count} menus, missing [${missing_text}]")
    string.free(missing_text)
    json.json_free(menus)

    // And a menu item does what its button does. The driver used to be
    // unable to press one: it ran the closure on its own HTTP thread
    // rather than the main queue, so an item that adds a model touched the
    // GL context off-thread and took the editor down. Fixed upstream, so
    // the menus are driven like everything else now.
    if add_menu >= 0 {
        now = tree()
        before_menu = object_count(now, scene)
        tree_free(now)
        post("/menu/${add_menu}/activate?label=Cube")
        after_menu = wait_rows(scene, before_menu + 1)
        check_detail("a menu item adds an object the way its button does", after_menu == before_menu + 1, "${before_menu} rows before, ${after_menu} after")
        // Put it back with the button rather than the Undo menu item: that
        // item's label carries its accelerator, and the driver matches a
        // menu item by its exact label without decoding what the query
        // escaped, so asking for it by name is a 404.
        now = tree()
        undo_now = find(now, "button", "Undo")
        tree_free(now)
        if undo_now >= 0 {
            click(undo_now)
            wait_rows(scene, before_menu)
        }
    }

    // A section folds when its bar is clicked. Read as the body going away
    // and the caret turning, not as one row disappearing: a hidden row's
    // own visible flag stays true, which is why on_screen walks upward.
    tree_free(t)
    t = tree()
    check("the inspector's sections have headers", count_named(t, "text", "COLOUR") == 1)
    material = find_widget(t, "text", "COLOUR")
    if material != null {
        strip = widget(t, material.parent)
        bar = widget(t, strip.parent)
        // The caret: the text before the caption in the strip.
        caret = null as *Widget
        carets = 0
        i = 0
        while i < tree_count(t) {
            cw = tree_at(t, i)
            if cw.parent == strip.id && cw.kind == "text" && cw.id < material.id { caret = cw; carets = carets + 1 }
            i = i + 1
        }
        red = find_widget(t, "text", "red")
        caret_text = "none"
        if caret != null { caret_text = "'${caret.text}'" }
        check_detail("and a caret that says which way the section is", carets == 1 && caret != null && caret.text == "▾", caret_text)
        if red != null && caret != null {
            red_id = red.id
            caret_id = caret.id
            click(bar.id)
            wt = want(WANT_ON_SCREEN)
            wt.id = red_id
            wt.flag = false
            folded = wait_for(wt, 8.0, ok)
            check("clicking a section header folds it away", ok[0] == 1)
            check_detail("and the caret turns with it", widget_text(folded, caret_id) == "▸", "'${widget_text(folded, caret_id)}'")
            tree_free(folded)
            click(bar.id)
            wt.flag = true
            shown = wait_for(wt, 8.0, ok)
            check("and clicking it again brings it back", ok[0] == 1)
            tree_free(shown)
            free(wt as ptr)
        }
    }

    // A component folds from anywhere on its header, as in Unity, not from
    // its caret alone (#521): the header is clicked, and the Transform's
    // rows go and come back.
    tree_free(t)
    t = tree()
    title = find_widget(t, "text", "Transform")
    position = find_widget(t, "text", "position")
    check("a component has a header with its name", title != null)
    if title != null && position != null {
        title_strip = widget(t, title.parent)
        header = widget(t, title_strip.parent)
        position_id = position.id
        click(header.id)
        wt = want(WANT_ON_SCREEN)
        wt.id = position_id
        wt.flag = false
        folded = wait_for(wt, 8.0, ok)
        check("clicking a component's header folds it, not only its caret", ok[0] == 1)
        tree_free(folded)
        click(header.id)
        wt.flag = true
        opened = wait_for(wt, 8.0, ok)
        check("and clicking it again opens it", ok[0] == 1)
        tree_free(opened)
        free(wt as ptr)
    }

    check_colour_picker()

    // The bar under the viewport says what the last frame cost on the
    // device, pass by pass: a rate says a scene is slow, the split says
    // which pass made it so. Read as numbers, not as the presence of a
    // label a bar could carry with nothing behind it.
    wt = want(WANT_COSTS)
    tree_free(t)
    t = wait_for(wt, 10.0, ok)
    free(wt as ptr)
    check("the stats bar splits the frame by pass", ok[0] == 1)
    if ok[0] == 1 {
        line = costs(t)
        scene_ms = number_after(line, "scene")
        check_detail("and the scene pass has a cost", scene_ms >= 0.0, line)
    }

    // The shading switches, pressed rather than called. The report's own
    // check flips them through set_shading; this is the half that proves
    // a switch on the screen is wired to that at all.
    tree_free(t)
    t = tree()
    features = "Clearcoat,Sheen,Volumetric light,Soft shadows"
    parts = string.split(features, ",")
    have = 0
    missing = strbuilder.new(64)
    i = 0
    while i < string.array_size(parts) {
        if count_named(t, "text", part_at(parts, i)) > 0 { have = have + 1 } else { strbuilder.append(missing, part_at(parts, i)); strbuilder.append(missing, " ") }
        i = i + 1
    }
    missing_text = strbuilder.finish(missing)
    check_detail("the shading section offers every feature the presets disagree on", have == string.array_size(parts), "missing ${missing_text}")
    string.free(missing_text)
    string.array_free(parts)
    clearcoat = find_widget(t, "text", "Clearcoat")
    if clearcoat != null {
        toggle_w = row_toggle(t, clearcoat)
        check("and each has a switch", toggle_w != null)
        if toggle_w != null {
            switch_id = toggle_w.id
            toggle(switch_id)
            wt = want(WANT_CONTAINS)
            wt.text = "clearcoat"
            heard = wait_for(wt, 8.0, ok)
            check("pressing one is heard by the editor", ok[0] == 1)
            tree_free(heard)
            free(wt as ptr)
            toggle(switch_id)
        }
    }

    // A terrain is one object whose shape is a property of it, rather than
    // five buttons in the panel that each add a different thing. The panel
    // says a terrain is a thing you can have; which shape it takes is
    // chosen on the object, the way Unreal and Unity both do it.
    tree_free(t)
    t = tree()
    add = find(t, "button", "Terrain")
    check("the panel offers a terrain, not a list of biomes", add >= 0)
    blocky = 0
    if add >= 0 {
        click(add)
        wt = want(WANT_TERRAIN)
        tree_free(t)
        t = wait_for(wt, 8.0, ok)
        free(wt as ptr)
        check("adding one shows its Terrain panel", ok[0] == 1)

        // What the terrain is -- its biome, its seed, its style -- is its
        // Terrain component: every shape it can build a choice on it, the
        // one it is lit, and choosing another fills the world again.
        panel = component_body_id(t, "Terrain")
        shapes = "plains,mountains,desert,islands,caves"
        shape_count = 0
        parts = string.split(shapes, ",")
        i = 0
        while i < string.array_size(parts) {
            if panel >= 0 && button_under(t, panel, part_at(parts, i)) >= 0 { shape_count = shape_count + 1 }
            i = i + 1
        }
        string.array_free(parts)
        check_detail("the Terrain panel offers every shape terrain can build", shape_count == 5, "${shape_count} of five")
        check("and has its seed", panel >= 0 && count_under(t, panel, "text", "seed") == 1)
        if shape_count == 5 {
            lit = lit_among(t, shapes)
            check_detail("and says which one this terrain is", lit == "plains", "lit: ${lit}")
            string.free(lit)
            // The console says what was built, so this reads that the world
            // was filled again rather than that a button lit up.
            click(button_under(t, panel, "desert"))
            wt = want(WANT_CONTAINS)
            wt.text = "desert "
            tree_free(t)
            t = wait_for(wt, 12.0, ok)
            free(wt as ptr)
            check("choosing a shape rebuilds the terrain", ok[0] == 1)
        }

        // Voxels are one way of drawing a terrain, not what a terrain is.
        // The same object, the same place in the scene, drawn as a surface
        // instead of a cube per cell.
        panel = component_body_id(t, "Terrain")
        blocks = 0 - 1
        smooth = 0 - 1
        if panel >= 0 {
            blocks = button_under(t, panel, "blocks")
            smooth = button_under(t, panel, "smooth")
        }
        check("a terrain can be blocks or smooth", blocks >= 0 && smooth >= 0)
        if blocks >= 0 && smooth >= 0 {
            lit = lit_among(t, "blocks,smooth")
            check_detail("and starts as blocks", lit == "blocks", "lit: ${lit}")
            string.free(lit)
            blocky = triangles(t)
            click(smooth)
            wt = want(WANT_TRIANGLES_ABOVE)
            wt.count = blocky * 10
            tree_free(t)
            t = wait_for(wt, 20.0, ok)
            free(wt as ptr)
            check_detail("smoothing one gives it a surface of its own", ok[0] == 1, "${blocky} triangles then ${triangles(t)}")
        }

        // The brush. Raise is pressed, the canvas is pressed where the
        // terrain stands after framing it, and the console says how many
        // columns moved: a stroke that reached the ground and not just a
        // button that lit.
        tree_free(t)
        t = tree()
        raise_btn = find(t, "button", "Raise")
        // The viewport's overlay canvas is the big one, and its size is
        // where the centre of the view is. The canvas routes take the
        // canvas's own handle, not its widget id: handles count from one
        // in the order the canvases were made, so the one with the
        // editor's hit-test closures is found by asking each in turn.
        canvas = null as *Widget
        i = 0
        while i < tree_count(t) {
            c = tree_at(t, i)
            if c.kind == "canvas" && (canvas == null || c.w * c.h > canvas.w * canvas.h) { canvas = c }
            i = i + 1
        }
        check("the terrain section offers a brush", raise_btn >= 0)
        handle = 0 - 1
        candidate = 1
        while candidate < 6 && handle < 0 {
            if post_route("/canvas/${candidate}/key?name=f", true) { handle = candidate }
            candidate = candidate + 1
        }
        check("the viewport takes keys over the channel", handle >= 0)
        if raise_btn >= 0 && canvas != null && handle >= 0 {
            click(raise_btn)
            // The centre of the view. GTK reports the viewport's canvas as
            // 0 x 0 (aether-ui#211), and a stroke at its "centre" was a
            // stroke at the corner, over no terrain at all (#353): the size
            // the editor renders at, off the stats bar, stands in for it.
            view_w = canvas.w
            view_h = canvas.h
            if view_w <= 0.0 || view_h <= 0.0 {
                view_w = viewport_width(t)
                view_h = viewport_height(t)
            }
            cx = (view_w / 2.0) as int
            cy = (view_h / 2.0) as int
            post("/canvas/${handle}/click?x=${cx}&y=${cy}")
            post("/canvas/${handle}/move?x=${cx + 12}&y=${cy + 4}")
            post("/canvas/${handle}/release?x=${cx + 12}&y=${cy + 4}")
            wt = want(WANT_SCULPTED)
            tree_free(t)
            t = wait_for(wt, 20.0, ok)
            free(wt as ptr)
            stroked = ok[0] == 1
            // Held on Linux too: the stroke sculpted nothing there only
            // because it was aimed at the centre of a canvas GTK reports as
            // 0 x 0, the view's corner (#353).
            check_detail("a stroke on the terrain moves its columns", stroked, "sculpted ${sculpted(t)}")
            // A stroke is one undo step from press to release, and undoing
            // it puts the ground back: the surface's triangle count after
            // the stroke is not the count before it, and after undo it is.
            raised = triangles(t)
            undo_btn = find(t, "button", "Undo")
            if undo_btn >= 0 && blocky > 0 && stroked {
                click(undo_btn)
                wt = want(WANT_TRIANGLES_NOT)
                wt.count = raised
                tree_free(t)
                t = wait_for(wt, 20.0, ok)
                free(wt as ptr)
                check_detail("undoing the stroke rebuilds the terrain as it was", ok[0] == 1, "${raised} triangles after the stroke, ${triangles(t)} after undo")
            }
            off_btn = find(t, "button", "Off")
            if off_btn >= 0 { click(off_btn) }
        }
    }

    // Two objects selected at once is checked by the editor's own report,
    // not here: the test server clicks without modifiers and
    // ui.modifiers() reads the real keyboard, so a shift-click cannot be
    // driven over HTTP. The report calls the selection routine directly
    // with the intent a modifier would have carried, and asserts an edit
    // reaches both.

    // A behaviour is a script the project has, not a case in the editor.
    // The buttons are the files in resources/scripts, so this reads the
    // names off disk rather than expecting any particular one: adding a
    // script is adding a file, and this check should not need editing
    // when someone does.
    // On the cube, chosen here and shown before anything is read: the
    // terrain section leaves its terrain selected, a script on a terrain is
    // not offered, and the inspector was read mid-change -- one run read
    // another object's transform and, 0.8 s later, the terrain's (#547).
    select_named(scene, "cube")
    settled_transform()
    on_disk = scripts_on_disk()
    tree_free(t)
    t = tree()
    missing = strbuilder.new(64)
    missing_count = 0
    listed = strbuilder.new(64)
    i = 0
    while i < list.size(on_disk) {
        if i > 0 { strbuilder.append(listed, ", ") }
        strbuilder.append(listed, name_at(on_disk, i))
        if find(t, "button", name_at(on_disk, i)) < 0 {
            if missing_count > 0 { strbuilder.append(missing, ", ") }
            strbuilder.append(missing, name_at(on_disk, i))
            missing_count = missing_count + 1
        }
        i = i + 1
    }
    listed_text = strbuilder.finish(listed)
    missing_text = strbuilder.finish(missing)
    check_detail("every script in the project has a button", missing_count == 0, "on disk [${listed_text}], missing [${missing_text}]")
    string.free(missing_text)

    // A row of choices says which one is on. Read as "the accent moved"
    // rather than "this button is blue", which is the stronger claim: a
    // fixed colour is a constant the editor could satisfy while the
    // highlight never follows the choice.
    choices = "None"
    if listed_text != "" { choices = string.replace_all("None, ${listed_text}", ", ", ",") }
    choice_count = 1 + list.size(on_disk)
    segments = 0
    parts = string.split(choices, ",")
    i = 0
    while i < string.array_size(parts) {
        if find(t, "button", part_at(parts, i)) >= 0 { segments = segments + 1 }
        i = i + 1
    }
    string.array_free(parts)
    check_detail("the behaviour row offers none and every script", segments == choice_count, "have ${segments}, want [${choices}]")
    if segments == choice_count && list.size(on_disk) > 0 {
        lit = lit_among(t, choices)
        check_detail("exactly one behaviour is lit, and it is the one in effect", lit == "None", "lit: ${lit}")
        string.free(lit)
        wanted_script = name_at(on_disk, 0)
        wanted_id = find(t, "button", wanted_script)
        click(wanted_id)
        wt = want(WANT_ONLY_LIT)
        wt.text = choices
        wt.id = wanted_id
        wt.flag = true
        moved_tree = wait_for(wt, 8.0, ok)
        lit_now = lit_among(moved_tree, choices)
        check_detail("choosing a behaviour moves the highlight to it", ok[0] == 1, "lit: ${lit_now}")
        string.free(lit_now)
        tree_free(moved_tree)

        // A script runs while the scene does, not while it is edited (#520):
        // attached, it leaves its object where it stands; Simulate runs it;
        // Stop gives the scene back as it was.
        at_rest = settled_transform()
        rest_tree = tree()
        simulate_id = find(rest_tree, "button", "Simulate")
        tree_free(rest_tree)
        sleep(800)
        edit_tree = tree()
        edited = transform_values(edit_tree)
        tree_free(edit_tree)
        check_detail("a script attached in edit mode does not run", at_rest != "" && edited == at_rest, "before '${at_rest}', 0.8 s later '${edited}'")
        check("the editor has a Simulate button", simulate_id >= 0)
        if simulate_id >= 0 {
            click(simulate_id)
            sleep(800)
            run_tree = tree()
            running = transform_values(run_tree)
            tree_free(run_tree)
            check_detail("Simulate runs it", running != at_rest, "before '${at_rest}', running '${running}'")
            click(simulate_id)
            sleep(600)
            back_tree = tree()
            restored = transform_values(back_tree)
            tree_free(back_tree)
            check_detail("Stop gives the scene back as it was", restored == at_rest, "before '${at_rest}', after Stop '${restored}'")
        }
        // That the script then moves the object is not checked here. The
        // inspector shows a position and a scale, and a script is free to
        // move neither: spin only turns. The editor's own report drives
        // every script it has and asserts the model ended up somewhere
        // else, which is the check that does not depend on what a
        // particular script happens to do.
        none_id = find(t, "button", "None")
        click(none_id)
        wt.id = none_id
        cleared = wait_for(wt, 8.0, ok)
        tree_free(cleared)
        free(wt as ptr)
    }
    string.free(listed_text)

    // A bounded row is two ways into one value. Typing an exact number is
    // the half a slider cannot do, and the slider beside it has to
    // follow, or the panel shows the same setting as two different
    // numbers.
    select_named(scene, "cube")
    tree_free(t)
    t = tree()
    check("the cube's Material shows its rows", count_shown(t, "text", "roughness") == 1)
    roughness = find_widget(t, "text", "roughness")
    if roughness != null {
        box = row_box(t, roughness)
        bar = row_slider(t, roughness)
        check("roughness has both a slider and a box", box != null && bar != null)
        if box != null && bar != null {
            box_id = box.id
            bar_id = bar.id
            set_text(box_id, "0.75")
            wt = want(WANT_VALUE)
            wt.id = bar_id
            wt.value = 0.75
            followed = wait_for(wt, 8.0, ok)
            check_detail("typing a value moves the slider beside it", ok[0] == 1, "slider at ${widget_value(followed, bar_id)}")
            tree_free(followed)
            free(wt as ptr)
            // And the other way: dragging writes the number in the box.
            set_value(bar_id, "0.20")
            wt = want(WANT_TEXT)
            wt.id = box_id
            wt.text = "0.20"
            wrote = wait_for(wt, 8.0, ok)
            check_detail("dragging the slider writes the box", ok[0] == 1, "'${widget_text(wrote, box_id)}'")
            tree_free(wrote)
            free(wt as ptr)
        }
    }

    // Reflectivity is a material row like roughness: what the wet road's
    // mirror is scaled by. It was settable over the channel and nowhere
    // in the panel, and a scene saved with one came back matte.
    tree_free(t)
    t = tree()
    check("the reflectivity row shows", count_shown(t, "text", "reflectivity") == 1)
    reflectivity = find_widget(t, "text", "reflectivity")
    if reflectivity != null {
        box = row_box(t, reflectivity)
        bar = row_slider(t, reflectivity)
        check("reflectivity has both a slider and a box", box != null && bar != null)
        if box != null && bar != null {
            box_id = box.id
            set_value(bar.id, "0.60")
            wt = want(WANT_TEXT)
            wt.id = box_id
            wt.text = "0.60"
            wrote = wait_for(wt, 8.0, ok)
            check_detail("the reflectivity slider writes the box", ok[0] == 1, "'${widget_text(wrote, box_id)}'")
            tree_free(wrote)
            free(wt as ptr)
        }
    }

    // The scene's own settings are the Scene's: selected, it shows its
    // Environment and Rendering, and each row reaches the engine the
    // viewport draws with.
    if select_named(scene, "Scene") {
        tree_free(t)
        t = tree()
        scene_rows = "sky,sun by time,time of day,clouds,overcast,fog,fxaa,bloom,shadows,reflections,ambient occlusion,occlusion radius"
        parts = string.split(scene_rows, ",")
        i = 0
        while i < string.array_size(parts) {
            row_caption = part_at(parts, i)
            check("the Scene shows its ${row_caption} row", count_shown(t, "text", row_caption) == 1)
            i = i + 1
        }
        string.array_free(parts)
        check("the Scene has no transform: it is not an object among the others", count_shown(t, "text", "position") == 0)
        radius = find_widget(t, "text", "occlusion radius")
        if radius != null {
            box = row_box(t, radius)
            bar = row_slider(t, radius)
            if box != null && bar != null {
                box_id = box.id
                set_value(bar.id, "7.50")
                wt = want(WANT_TEXT)
                wt.id = box_id
                wt.text = "7.50"
                wrote = wait_for(wt, 8.0, ok)
                check_detail("the occlusion radius slider writes the box", ok[0] == 1, "'${widget_text(wrote, box_id)}'")
                tree_free(wrote)
                free(wt as ptr)
            }
        }
        select_named(scene, "cube")
    }

    // A water surface's settings are its Water component: nothing shows
    // them while no water is selected, not even a caption left behind.
    tree_free(t)
    t = tree()
    check("with no water selected, no Water panel shows", count_shown(t, "text", "wave height") == 0)

    // Adding water selects it and shows its panel, every setting a row --
    // the wave scale and the shore were file-only knobs once -- with its
    // sliders reaching the simulation rather than only their own readouts.
    water = find(t, "button", "Water")
    if water >= 0 {
        click(water)
        tree_free(t)
        t = wait_shown("wave height", 8.0)
        check("adding water shows its Water panel", t != null)
        if t == null { t = tree() }
        panel = component_body_id(t, "Water")
        check("the water surface is a Water component", panel >= 0)
        captions = "wave height,wave speed,wave scale,opacity,foam intensity,shore fade,shore foam,reflection,caustics"
        parts = string.split(captions, ",")
        i = 0
        while i < string.array_size(parts) {
            row_caption = part_at(parts, i)
            check("the Water panel has its ${row_caption} row", panel >= 0 && count_under(t, panel, "text", row_caption) == 1)
            i = i + 1
        }
        string.array_free(parts)
        cap = find_widget(t, "text", "shore fade")
        if cap != null {
            box = row_box(t, cap)
            bar = row_slider(t, cap)
            if box != null && bar != null {
                box_id = box.id
                set_value(bar.id, "0.70")
                wt = want(WANT_TEXT)
                wt.id = box_id
                wt.text = "0.70"
                wrote = wait_for(wt, 8.0, ok)
                check_detail("the shore fade slider writes the box", ok[0] == 1, "'${widget_text(wrote, box_id)}'")
                tree_free(wrote)
                free(wt as ptr)
            }
        }
        caption = find_widget(t, "text", "wave height")
        check("the Water panel shows its wave height row", caption != null)
        if caption != null {
            readout = row_box(t, caption)
            later = row_slider(t, caption)
            check("and it is a slider with its box", readout != null && later != null)
            if readout != null && later != null {
                readout_id = readout.id
                set_value(later.id, "17.5")
                sleep(1000)
                // Away and back, so what is read comes from the simulation.
                now = tree()
                rows = object_rows(now, scene)
                first_row = lowest_id(rows)
                last_row = highest_id(rows)
                list.free(rows)
                tree_free(now)
                click(first_row)
                sleep(700)
                click(last_row)
                sleep(700)
                now = tree()
                back = widget_text(now, readout_id)
                check_detail("a water slider reaches the simulation", back == "17.50", "'${back}'")
                tree_free(now)
            }
        }
    }

    // The same operations interleaved. A check that passes on its own can
    // fail in sequence: adding water showed its section every time until
    // an Undo had happened earlier in the run, and that was three lists
    // going out of step rather than anything about water.
    tree_free(t)
    t = tree()
    mismatch = ""
    steps = "add cube,delete,undo the delete"
    buttons = "Cube,Delete,Undo"
    pauses = "1200,1200,1500"
    step_parts = string.split(steps, ",")
    button_parts = string.split(buttons, ",")
    pause_parts = string.split(pauses, ",")
    i = 0
    while i < 3 && mismatch == "" {
        click(find(t, "button", part_at(button_parts, i)))
        sleep(string.get_int(part_at(pause_parts, i)))
        mismatch = audit_kinds(scene, part_at(step_parts, i))
        i = i + 1
    }
    string.array_free(step_parts)
    string.array_free(button_parts)
    string.array_free(pause_parts)
    check_detail("every row reports its own kind through a mixed sequence", mismatch == "", mismatch)

    // Play's count of clients is a row like the link's below it: a
    // caption, a slider and a readout. The slider lands on whole counts:
    // moved to 3.3 it reads 3 and sits on 3, and back to 2 where it began.
    tree_free(t)
    t = tree()
    check("the play clients row is in the tree", count_named(t, "text", "clients") == 1)
    clients = find_widget(t, "text", "clients")
    if clients != null {
        bar = row_slider(t, clients)
        readout = null as *Widget
        n = tree_count(t)
        i = 0
        while i < n {
            w = tree_at(t, i)
            if w.parent == clients.parent && w.kind == "text" && w.id != clients.id { readout = w }
            i = i + 1
        }
        check("the clients row has a slider and a readout", bar != null && readout != null)
        if bar != null && readout != null {
            bar_id = bar.id
            readout_id = readout.id
            set_value(bar_id, "3.3")
            wt = want(WANT_TEXT)
            wt.id = readout_id
            wt.text = "3"
            wrote = wait_for(wt, 8.0, ok)
            check_detail("the clients slider sets a whole count", ok[0] == 1, "'${widget_text(wrote, readout_id)}'")
            tree_free(wrote)
            free(wt as ptr)
            wv = want(WANT_VALUE)
            wv.id = bar_id
            wv.value = 3.0
            held = wait_for(wv, 8.0, ok)
            check_detail("and sits on it", ok[0] == 1, "${widget_value(held, bar_id)}")
            tree_free(held)
            free(wv as ptr)
            set_value(bar_id, "2")
            wt = want(WANT_TEXT)
            wt.id = readout_id
            wt.text = "2"
            wrote = wait_for(wt, 8.0, ok)
            check_detail("and back to two", ok[0] == 1, "'${widget_text(wrote, readout_id)}'")
            tree_free(wrote)
            free(wt as ptr)
        }
    }

    tree_free(t)
    t = tree()
    faults = layout_faults(t)
    check_detail("the panels are laid out on one grid", faults == "", faults)
    string.free(faults)
    check_splitters()

    // Save, Load and Delete, pressed. A scene that never reaches disk and
    // a Load that brings back nothing both look like a working editor
    // from inside: the buttons return, the report is unchanged.
    if file.file_exists(SCENE_FILE) != 0 { file.delete(SCENE_FILE) }
    save = find(t, "button", "Save")
    load = find(t, "button", "Load")
    delete_btn = find(t, "button", "Delete")
    if save >= 0 && load >= 0 && delete_btn >= 0 {
        now = tree()
        saved_rows = object_count(now, scene)
        tree_free(now)
        click(save)
        check("Save writes a scene file", wait_file(SCENE_FILE, 0 - 1 as long))

        now = tree()
        click(find(now, "button", "Cube"))
        tree_free(now)
        grew = wait_rows(scene, saved_rows + 1)
        click(load)
        // Polled, not slept on. Reading a scene back off disk takes as long
        // as the machine takes, and a sleep that is long enough here is a
        // guess that fails on a busier one: this check passed alone and
        // failed inside a full ci run, which is exactly that.
        loaded = wait_rows(scene, saved_rows)
        check_detail("Load brings back what was saved", loaded == saved_rows && grew == saved_rows + 1, "${saved_rows} saved, ${grew} after adding, ${loaded} after loading")

        // A value has to survive the file, not just the row count. It is
        // changed after saving on purpose: left alone, it would come back
        // whatever load did, and the check would only be proving that
        // memory keeps its contents.
        now = tree()
        cap = find_widget(now, "text", "wave height")
        if cap != null {
            readout = row_box(now, cap)
            later = slider_after(now, cap.parent)
            if readout != null && later != null {
                readout_id = readout.id
                later_id = later.id
                // Select the water first. A water row applies to whichever
                // water is selected, and after a load the selection is
                // elsewhere: moving the slider then updates the readout
                // and reaches no simulation at all, which is exactly how
                // the first version of this check fooled itself.
                water_row = row_named(now, scene, "water")
                if water_row != null {
                    click(water_row.id)
                    sleep(800)
                }
                // Saved once the readout says the value arrived: saving
                // before it has is what left the file holding the number
                // the row started at.
                set_value(later_id, "9.25")
                showed = wait_text(readout_id, "9.25")
                check_detail("the wave height takes the value it was given", showed == "9.25", showed)
                stamped = file_stamp(SCENE_FILE)
                click(save)
                wait_file(SCENE_FILE, stamped)
                set_value(later_id, "3.0")
                moved = wait_text(readout_id, "3.00")
                click(load)
                wait_rows(scene, saved_rows)
                after_load = tree()
                water_row = row_named(after_load, scene, "water")
                if water_row != null { click(water_row.id) }
                tree_free(after_load)
                restored = wait_text(readout_id, "9.25")
                check_detail("a setting survives the scene file", moved == "3.00" && restored == "9.25", "changed to ${moved}, came back as ${restored}")
                string.free(showed)
                string.free(moved)
                string.free(restored)
            }
        }
        tree_free(now)
    }

    // New script writes a file that compiles. A template that does not is
    // worse than none: the first thing anyone does with it is build it,
    // and a first script is mostly a guess at what the two functions are
    // called.
    tree_free(t)
    t = tree()
    new_button = find(t, "button", "New script")
    check("the editor can write a new script", new_button >= 0)
    if new_button >= 0 {
        before_files = script_count()
        click(new_button)
        wt = want(WANT_FILES)
        wt.count = before_files
        written_tree = wait_for(wt, 8.0, ok)
        tree_free(written_tree)
        free(wt as ptr)
        made = newest_script(on_disk)
        check_detail("pressing it leaves a file to edit", made != "", made)
        if made != "" {
            // Through bash by name: Windows will not execute a shell script
            // as a program, and reports it as a file that is not a Win32
            // application, which is true and unhelpful.
            argv = list.new()
            list.add(argv, "scripts/build_script.sh")
            list.add(argv, "${SCRIPTS_DIR}/${made}")
            out, status, serr = os.run_capture("bash", argv, null)
            check_detail("and what it wrote compiles", serr == "" && status == 0, last_line(out))
            file.delete("${SCRIPTS_DIR}/${made}")
            stem = string.substring(made, 0, string.length(made) - 3)
            remove_built(stem)
        }
    }

    // A script rebuilt while the editor is open is picked up without
    // restarting it. The editor compiles nothing: the same step that
    // built the script builds it again, and the editor notices the
    // library.
    if list.size(on_disk) > 0 {
        target = "build/scripts/${name_at(on_disk, 0)}${library_suffix()}"
        if file.file_exists(target) != 0 {
            touch(target)
            wt = want(WANT_CONTAINS)
            wt.text = "reloaded"
            saw = wait_for(wt, 15.0, ok)
            tree_free(saw)
            free(wt as ptr)
            check("a rebuilt script is picked up while the editor runs", ok[0] == 1)
        }
    }

    // A scene remembers which script each object was given, by name. That
    // is what makes an assignment worth making: the editor knows nothing
    // about what the script does, so the name is the whole of what it can
    // record, and a project with the script still in it gets it back.
    tree_free(t)
    t = tree()
    if list.size(on_disk) > 0 && find(t, "button", name_at(on_disk, list.size(on_disk) - 1)) >= 0 && save >= 0 && load >= 0 {
        chosen = name_at(on_disk, list.size(on_disk) - 1)
        chosen_id = find(t, "button", chosen)
        // Which object is being given the script. A load puts the
        // selection back at the start, and the lit button is the selected
        // object's script, so without re-selecting this one afterwards the
        // check reads a different object and calls the assignment lost.
        carrier = ""
        rows = object_rows(t, scene)
        i = 0
        while i < list.size(rows) {
            row = list.get_raw(rows, i) as *Widget
            if string.contains(row.classes, "selected") != 0 { carrier = row_name(t, row) }
            i = i + 1
        }
        if carrier == "" && list.size(rows) > 0 {
            last_widget = widget(t, highest_id(rows))
            carrier = row_name(t, last_widget)
            click(last_widget.id)
        }
        list.free(rows)
        click(chosen_id)
        wt = want(WANT_LIT)
        wt.id = chosen_id
        wt.flag = true
        lit_tree = wait_for(wt, 8.0, ok)
        tree_free(lit_tree)
        stamped = file_stamp(SCENE_FILE)
        click(save)
        wait_file(SCENE_FILE, stamped)
        recorded = recorded_scripts()
        check_detail("the scene records the script by name", named_in(chosen, recorded), "recorded [${recorded}]")
        string.free(recorded)

        none_id = find(t, "button", "None")
        click(none_id)
        wt.id = none_id
        none_tree = wait_for(wt, 8.0, ok)
        tree_free(none_tree)
        click(load)
        wait_rows_settled(scene, 12.0)
        // Back to the object that was given the script, because the button
        // says what the selected object carries.
        after_load = tree()
        carrier_row = row_named(after_load, scene, carrier)
        if carrier_row != null { click(carrier_row.id) }
        tree_free(after_load)
        wt.id = chosen_id
        back_tree = wait_for(wt, 12.0, ok)
        tree_free(back_tree)
        free(wt as ptr)
        check_detail("and gives it back when the scene is loaded", ok[0] == 1, "on ${carrier}")
    }

    // The sky survives the file, and the renderer clears to it. The scene
    // format has always carried a sky and the editor had no control over
    // one, so every scene it saved recorded a colour nobody could choose.
    tree_free(t)
    t = tree()
    sky = find_widget(t, "text", "SKY")
    if sky != null && save >= 0 && load >= 0 {
        strip = widget(t, sky.parent)
        bar = widget(t, strip.parent)
        body = null as *Widget
        i = 0
        while i < tree_count(t) {
            s = tree_at(t, i)
            if s.parent == bar.parent && s.id > bar.id && (body == null || s.id < body.id) { body = s }
            i = i + 1
        }
        // The section also carries the hour's slider, under the sun by
        // time switch; the three colour channels are the rows above it.
        channels_block = calloc(4, 4)
        channels = channels_block as int[]
        channel_count = 0
        if body != null {
            i = 0
            while i < tree_count(t) {
                row = tree_at(t, i)
                if row.parent == body.id {
                    captioned = false
                    j = 0
                    while j < tree_count(t) {
                        c = tree_at(t, j)
                        if c.parent == row.id && c.kind == "text" && (c.text == "red" || c.text == "green" || c.text == "blue") { captioned = true }
                        j = j + 1
                    }
                    if captioned {
                        j = 0
                        while j < tree_count(t) {
                            s = tree_at(t, j)
                            if s.parent == row.id && s.kind == "slider" && channel_count < 3 {
                                channels[channel_count] = s.id
                                channel_count = channel_count + 1
                            }
                            j = j + 1
                        }
                    }
                }
                i = i + 1
            }
        }
        check_detail("the sky has a channel for each colour", channel_count == 3, "${channel_count}")
        if channel_count == 3 {
            g_channels = channels_block
            ch = 0
            while ch < 3 { set_value(channels[ch], "0.75"); ch = ch + 1 }
            wt = want(WANT_CHANNELS)
            wt.value = 0.75
            set_tree = wait_for(wt, 8.0, ok)
            tree_free(set_tree)
            check("setting the sky moves all three channels", ok[0] == 1)
            stamped = file_stamp(SCENE_FILE)
            click(save)
            wait_file(SCENE_FILE, stamped)
            ch = 0
            while ch < 3 { set_value(channels[ch], "0.10"); ch = ch + 1 }
            wt.value = 0.10
            low_tree = wait_for(wt, 8.0, ok)
            tree_free(low_tree)
            click(load)
            wt.value = 0.75
            back_tree = wait_for(wt, 8.0, ok)
            tree_free(back_tree)
            free(wt as ptr)
            check("and the sky comes back with the scene", ok[0] == 1)
        }
    }

    // The post chain survives the file. It is written into the scene by
    // the same record that carries the camera, and the editor filled none
    // of it: every scene it saved recorded the defaults, so a scene saved
    // with bloom on came back with it off.
    tree_free(t)
    t = tree()
    bloom = find_widget(t, "text", "Bloom")
    if bloom != null && save >= 0 && load >= 0 {
        toggle_w = row_toggle(t, bloom)
        if toggle_w != null {
            switch_id = toggle_w.id
            toggle(switch_id)
            wt = want(WANT_ACTIVE)
            wt.id = switch_id
            wt.flag = true
            on_tree = wait_for(wt, 8.0, ok)
            tree_free(on_tree)
            check("the bloom switch turns on", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written again", wait_file(SCENE_FILE, written))
            toggle(switch_id)
            wt.flag = false
            off_tree = wait_for(wt, 8.0, ok)
            tree_free(off_tree)
            click(load)
            wt.flag = true
            back_tree = wait_for(wt, 8.0, ok)
            tree_free(back_tree)
            free(wt as ptr)
            check("and the post chain comes back with the scene", ok[0] == 1)
        }
    }

    // Reflections the same way: the switch is a Vulkan feature and inert
    // on OpenGL, but the scene carries it on either backend, so a scene
    // authored with it on comes back with it on wherever it is opened.
    tree_free(t)
    t = tree()
    ssr = find_widget(t, "text", "Reflections")
    if ssr != null && save >= 0 && load >= 0 {
        toggle_w = row_toggle(t, ssr)
        if toggle_w != null {
            switch_id = toggle_w.id
            toggle(switch_id)
            wt = want(WANT_ACTIVE)
            wt.id = switch_id
            wt.flag = true
            on_tree = wait_for(wt, 8.0, ok)
            tree_free(on_tree)
            check("the reflections switch turns on", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written with reflections on", wait_file(SCENE_FILE, written))
            root_slot = calloc(1, 8) as ptr[]
            rendering = scene_section("rendering", root_slot)
            check_detail("and the file says so", rendering != null && field_flag(rendering, "ssr"), json_text(rendering))
            if root_slot[0] != null { json.json_free(root_slot[0]) }
            free(root_slot)
            toggle(switch_id)
            wt.flag = false
            off_tree = wait_for(wt, 8.0, ok)
            tree_free(off_tree)
            click(load)
            wt.flag = true
            back_tree = wait_for(wt, 8.0, ok)
            tree_free(back_tree)
            free(wt as ptr)
            check("and reflections come back with the scene", ok[0] == 1)
        }
    }

    // The sky is the Scene's Environment. The sun by the hour: switched
    // on, the key light -- the Scene's Light -- follows the hour, which is
    // read back as its intensity box changing when the hour is dragged
    // from noon to dusk.
    select_named(scene, "Scene")
    tree_free(t)
    t = tree()
    check("the Scene's Environment offers the sun by time", count_named(t, "text", "sun by time") == 1)
    sun = find_widget(t, "text", "sun by time")
    if sun != null {
        toggle_w = row_toggle(t, sun)
        hour = find_widget(t, "text", "time of day")
        if toggle_w != null && hour != null {
            switch_id = toggle_w.id
            toggle(switch_id)
            wt = want(WANT_ACTIVE)
            wt.id = switch_id
            wt.flag = true
            tree_free(t)
            t = wait_for(wt, 8.0, ok)
            check("the sun by time turns on", ok[0] == 1)
            hour = find_widget(t, "text", "time of day")
            bar = null as *Widget
            if hour != null { bar = row_slider(t, hour) }
            intensity = find_widget(t, "text", "intensity")
            if bar != null && intensity != null {
                box = row_box(t, intensity)
                if box != null {
                    box_id = box.id
                    set_value(bar.id, "12")
                    sleep(400)
                    noon_tree = tree()
                    noon = string.copy(widget_text(noon_tree, box_id))
                    tree_free(noon_tree)
                    set_value(bar.id, "18.5")
                    w2 = want(WANT_TEXT_NOT)
                    w2.id = box_id
                    w2.text = string.trim(noon)
                    dusk = wait_for(w2, 8.0, ok)
                    tree_free(dusk)
                    free(w2 as ptr)
                    check_detail("dragging the hour to dusk moves the key light's intensity", ok[0] == 1, "intensity stayed '${noon}'")
                    string.free(noon)
                }
            }
            toggle(switch_id)
            wt.flag = false
            off_tree = wait_for(wt, 8.0, ok)
            tree_free(off_tree)
            free(wt as ptr)
        }
    }

    // The clouds: the share of the sky they cover, a slider on the
    // Environment, written with the scene and read back with it.
    tree_free(t)
    t = tree()
    clouds = find_widget(t, "text", "clouds")
    check("the Environment has a clouds row", clouds != null)
    if clouds != null && save >= 0 && load >= 0 {
        bar = row_slider(t, clouds)
        box = row_box(t, clouds)
        if bar != null && box != null {
            bar_id = bar.id
            box_id = box.id
            set_value(bar_id, "0.70")
            wt = want(WANT_TEXT)
            wt.id = box_id
            wt.text = "0.70"
            clouds_on = wait_for(wt, 8.0, ok)
            tree_free(clouds_on)
            check("the clouds slider writes its box", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written with clouds", wait_file(SCENE_FILE, written))
            root_slot = calloc(1, 8) as ptr[]
            rendering = scene_section("rendering", root_slot)
            check_detail("and the file says so", rendering != null && field_flag(rendering, "clouds"), json_text(rendering))
            cover = 0.0
            if rendering != null { cover = field_number(rendering, "cloud_cover") }
            check_detail("with the cover the slider was left at", cover > 0.69 && cover < 0.71, json_text(rendering))
            if root_slot[0] != null { json.json_free(root_slot[0]) }
            free(root_slot)
            set_value(bar_id, "0")
            wt.text = "0.00"
            clouds_off = wait_for(wt, 8.0, ok)
            tree_free(clouds_off)
            click(load)
            select_named(scene, "Scene")
            env_tree = tree()
            again_caption = find_widget(env_tree, "text", "clouds")
            restored_text = ""
            if again_caption != null {
                again_box = row_box(env_tree, again_caption)
                if again_box != null { restored_text = string.copy(again_box.raw_text) }
            }
            tree_free(env_tree)
            free(wt as ptr)
            check_detail("and the clouds come back with the scene", restored_text == "0.70", "'${restored_text}'")
        }
    }

    // The sky the scene is drawn under: the Environment's sky, an asset
    // chosen from the engine's images (None, Desert, Dusk, Night) under its
    // "...". Chosen here, the file carries the image and the scene comes
    // back under it -- which is what a scene written by a program brings,
    // and what the editor used to drop on the way in.
    select_named(scene, "Scene")
    tree_free(t)
    t = tree()
    sky_caption = find_widget(t, "text", "sky")
    sky_box = null as *Widget
    sky_pick = null as *Widget
    if sky_caption != null {
        sky_box = row_box(t, sky_caption)
        kids = descendants(t, sky_caption.parent)
        i = 0
        while i < list.size(kids) {
            k = list.get_raw(kids, i) as *Widget
            if k.kind == "button" && k.text == "..." { sky_pick = k }
            i = i + 1
        }
        list.free(kids)
    }
    check("the sky row has a box and a picker", sky_box != null && sky_pick != null)
    if sky_box != null && sky_pick != null && save >= 0 && load >= 0 {
        sky_box_id = sky_box.id
        click(sky_pick.id)
        sleep(500)
        sky_list = tree()
        sky_count = 0
        dusk_id = 0 - 1
        none_id = 0 - 1
        choices_parent = 0 - 1
        i = 0
        while i < tree_count(sky_list) {
            b = tree_at(sky_list, i)
            if b.kind == "button" && b.text == "Browse..." && on_screen(sky_list, b) { choices_parent = b.parent }
            i = i + 1
        }
        i = 0
        while i < tree_count(sky_list) {
            b = tree_at(sky_list, i)
            if b.kind == "button" && b.parent == choices_parent && named_in(b.text, "None,Desert,Dusk,Night") {
                sky_count = sky_count + 1
                if b.text == "Dusk" { dusk_id = b.id }
                if b.text == "None" { none_id = b.id }
            }
            i = i + 1
        }
        tree_free(sky_list)
        check_detail("the picker offers the engine's skies", sky_count == 4, "${sky_count} of four")
        if dusk_id >= 0 {
            click(dusk_id)
            wt = want(WANT_TEXT)
            wt.id = sky_box_id
            wt.text = "resources/sky/dusk.png"
            sky_chosen = wait_for(wt, 8.0, ok)
            tree_free(sky_chosen)
            check("choosing Dusk writes its image into the sky row", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written under that sky", wait_file(SCENE_FILE, written))
            root_slot = calloc(1, 8) as ptr[]
            firmament = scene_section("skybox", root_slot)
            image = ""
            if firmament != null { image = field_text(firmament, "image") }
            check_detail("and the file names the image", image == "resources/sky/dusk.png", json_text(firmament))
            if root_slot[0] != null { json.json_free(root_slot[0]) }
            free(root_slot)
            set_text(sky_box_id, "")
            wt.text = ""
            sky_cleared = wait_for(wt, 8.0, ok)
            tree_free(sky_cleared)
            check("clearing the row puts the sky back to its colour", ok[0] == 1)
            click(load)
            select_named(scene, "Scene")
            env_tree = tree()
            again_caption = find_widget(env_tree, "text", "sky")
            restored_text = ""
            if again_caption != null {
                again_box = row_box(env_tree, again_caption)
                if again_box != null { restored_text = string.copy(again_box.raw_text) }
            }
            tree_free(env_tree)
            check_detail("and the sky comes back with the scene", restored_text == "resources/sky/dusk.png", "'${restored_text}'")
            free(wt as ptr)
        }
    }
    select_named(scene, "cube")

    // The weather, the same way: a kind is a button, lit when chosen; the
    // console says what came over the scene; the file carries the kind by
    // name and comes back with it. By the row the kinds share: the console
    // has a Clear button of its own, and clearing the console is not
    // clearing the sky.
    tree_free(t)
    t = tree()
    rain = find_widget(t, "button", "Rain")
    kind_count = 0
    kinds_parent = 0 - 1
    if rain != null {
        kinds_parent = rain.parent
        i = 0
        while i < tree_count(t) {
            b = tree_at(t, i)
            if b.kind == "button" && b.parent == kinds_parent && named_in(b.text, "Clear,Rain,Snow,Dust,Storm") { kind_count = kind_count + 1 }
            i = i + 1
        }
    }
    check_detail("the weather section offers every kind", kind_count == 5, "${kind_count} of five")
    if kind_count == 5 && save >= 0 && load >= 0 {
        lit = kinds_lit(t, kinds_parent)
        check_detail("and starts clear", lit == "Clear", "lit: ${lit}")
        string.free(lit)
        rain_id = rain.id
        clear_id = kind_button(t, kinds_parent, "Clear")
        click(rain_id)
        wt = want(WANT_CONTAINS)
        wt.text = "rain over the scene"
        came = wait_for(wt, 8.0, ok)
        tree_free(came)
        free(wt as ptr)
        check("choosing rain brings it over the scene", ok[0] == 1)
        now = tree()
        lit = kinds_lit(now, kinds_parent)
        tree_free(now)
        check_detail("and the button lights", lit == "Rain", "lit: ${lit}")
        string.free(lit)
        written = file_stamp(SCENE_FILE)
        click(save)
        check("the scene is written under rain", wait_file(SCENE_FILE, written))
        root_slot = calloc(1, 8) as ptr[]
        conditions = scene_section("weather", root_slot)
        kind_text = ""
        strength = 0.0
        if conditions != null {
            kind_text = field_text(conditions, "kind")
            strength = field_number(conditions, "intensity")
        }
        check_detail("and the file names the kind", kind_text == "rain", json_text(conditions))
        check_detail("with the strength the slider was left at", strength > 0.49 && strength < 0.51, json_text(conditions))
        if root_slot[0] != null { json.json_free(root_slot[0]) }
        free(root_slot)
        click(clear_id)
        wt = want(WANT_KINDS_LIT)
        wt.count = kinds_parent
        wt.text = "Clear"
        cleared = wait_for(wt, 8.0, ok)
        lit = kinds_lit(cleared, kinds_parent)
        check_detail("clearing it lights Clear", ok[0] == 1, "lit: ${lit}")
        string.free(lit)
        tree_free(cleared)
        click(load)
        wt.text = "Rain"
        back_tree = wait_for(wt, 8.0, ok)
        tree_free(back_tree)
        check("and the rain comes back with the scene", ok[0] == 1)
        click(clear_id)
        wt.text = "Clear"
        clear_tree = wait_for(wt, 8.0, ok)
        tree_free(clear_tree)
        free(wt as ptr)
    }

    // The body is the object's Physics Body component: Add Component gives
    // one, its body and collider are choices lit when chosen, the file
    // carries it on the model, and removing the component takes it away.
    select_named(scene, "cube")
    tree_free(t)
    t = tree()
    if component_body_id(t, "Physics Body") < 0 {
        adder = shown_button(t, "Add Component")
        check("the cube can be given a component", adder >= 0)
        if adder >= 0 {
            click(adder)
            sleep(500)
            tree_free(t)
            t = tree()
            entry = shown_button(t, "Physics / Physics Body")
            check("Add Component offers a Physics Body", entry >= 0)
            if entry >= 0 { click(entry) }
            tree_free(t)
            t = wait_shown("collider", 8.0)
            if t == null { t = tree() }
        }
    }
    panel = component_body_id(t, "Physics Body")
    check("the cube carries a Physics Body", panel >= 0)
    bodies = "static,kinematic,dynamic,character"
    body_count = 0
    parts = string.split(bodies, ",")
    i = 0
    while i < string.array_size(parts) {
        if panel >= 0 && button_under(t, panel, part_at(parts, i)) >= 0 { body_count = body_count + 1 }
        i = i + 1
    }
    string.array_free(parts)
    check_detail("the Physics Body offers every kind of body", body_count == 4, "${body_count} of four")
    check("and every collider", panel >= 0 && button_under(t, panel, "hull") >= 0 && button_under(t, panel, "mesh") >= 0)
    // And fits: the last of them inside the panel, not cut off at its edge
    // (where the toolkit reports boxes; GTK does not, see viewport_width).
    if panel >= 0 && body_count == 4 {
        last_kind = widget(t, button_under(t, panel, "character"))
        body = widget(t, panel)
        if last_kind != null && body != null && body.w > 0.0 && last_kind.w > 0.0 {
            check_detail("and they fit the panel's width", last_kind.x + last_kind.w <= body.x + body.w + 1.0,
                         "character ends at ${last_kind.x + last_kind.w}, the panel at ${body.x + body.w}")
        }
    }
    if body_count == 4 && save >= 0 {
        click(button_under(t, panel, "dynamic"))
        check("choosing a dynamic body lights it", wait_lit(bodies, "dynamic", 8.0))
        written = file_stamp(SCENE_FILE)
        click(save)
        check("the scene is written with the body", wait_file(SCENE_FILE, written))
        root_slot = calloc(1, 8) as ptr[]
        body_records = scene_models_with_body(root_slot)
        check_detail("and the file records a dynamic body on a model", body_records >= 1, "${body_records} recorded")
        if root_slot[0] != null { json.json_free(root_slot[0]) }
        tree_free(t)
        t = tree()
        click(button_under(t, panel, "character"))
        check("choosing a character lights it", wait_lit(bodies, "character", 8.0))
        tree_free(t)
        t = tree()
        check("and a character is a capsule", lit_among_is(t, "box,sphere,capsule,hull,mesh", "capsule"))
        written = file_stamp(SCENE_FILE)
        click(save)
        check("the scene is written with the character", wait_file(SCENE_FILE, written))
        root_slot[0] = null
        characters = scene_models_with_body_kind(root_slot, "character")
        check_detail("and the file records a character on the model", characters >= 1, "${characters} recorded")
        if root_slot[0] != null { json.json_free(root_slot[0]) }
        free(root_slot)
        // Taken away as any component is: its menu, Remove.
        menu = panel_header_button(t, "Physics Body", "⋮")
        check("the Physics Body has its menu", menu >= 0)
        if menu >= 0 {
            click(menu)
            sleep(400)
            tree_free(t)
            t = tree()
            remove = shown_button(t, "Remove")
            if remove >= 0 { click(remove) }
            sleep(700)
            tree_free(t)
            t = tree()
            check("removing it takes the body away", component_body_id(t, "Physics Body") < 0)
        }
    }

    // Sound on an object (#567): Add Component offers an Audio Source, its
    // section shows the bus as choices, and the scene file keeps it.
    tree_free(t)
    t = tree()
    if component_body_id(t, "Audio Source") < 0 {
        adder = shown_button(t, "Add Component")
        if adder >= 0 {
            click(adder)
            sleep(500)
            tree_free(t)
            t = tree()
            // The list runs past the panel's foot: the entry is found in
            // the tree and pressed where it is, scrolled out of sight or not.
            entry = find(t, "button", "Audio / Audio Source")
            check("Add Component offers an Audio Source", entry >= 0)
            if entry >= 0 { click(entry) }
            tree_free(t)
            t = wait_shown("effects", 8.0)
            if t == null { t = tree() }
        }
    }
    sound_panel = component_body_id(t, "Audio Source")
    check("the cube carries an Audio Source", sound_panel >= 0)
    if sound_panel >= 0 {
        buses = 0
        bus_names = string.split("music,effects,ambience,voice", ",")
        i = 0
        while i < string.array_size(bus_names) {
            if button_under(t, sound_panel, part_at(bus_names, i)) >= 0 { buses = buses + 1 }
            i = i + 1
        }
        string.array_free(bus_names)
        check_detail("the Audio Source offers every bus", buses == 4, "${buses} of four")
        if save >= 0 {
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written with the sound", wait_file(SCENE_FILE, written))
            content, err = fs.read(SCENE_FILE)
            kept = err == "" && string.contains(content, "\"Audio Source\"") == 1 && string.contains(content, "\"play on start\"") == 1
            check("and the file keeps the Audio Source with its fields", kept)
        }
    }

    // The hierarchy's filter: typing narrows the rows to the objects whose
    // names have the text, and clearing it brings every row back.
    if scene >= 0 {
        now = tree()
        filter_box = 0 - 1
        i = 0
        while i < tree_count(now) {
            fw = tree_at(now, i)
            if fw.kind == "textfield" && fw.parent == scene_body_id(now) { filter_box = fw.id }
            i = i + 1
        }
        all_rows = object_count(now, scene)
        tree_free(now)
        check("the hierarchy has a filter box", filter_box >= 0)
        if filter_box >= 0 && all_rows >= 2 {
            set_text(filter_box, "sphere")
            narrowed = wait_rows(scene, 1)
            check_detail("typing in the filter narrows the hierarchy to the matches", narrowed == 1, "${narrowed} rows for 'sphere' of ${all_rows}")
            set_text(filter_box, "")
            widened = wait_rows(scene, all_rows)
            check_detail("clearing the filter brings every row back", widened == all_rows, "${widened} rows, had ${all_rows}")
        }
    }

    // The light's kind: Spot lights the Spot button, shows the cone rows
    // and the file carries the kind; Point hides them again.
    tree_free(t)
    t = tree()
    spot_caption = find_widget(t, "button", "Spot")
    point_caption = find_widget(t, "button", "Point")
    if spot_caption != null && point_caption != null && save >= 0 {
        kinds_parent = spot_caption.parent
        lit = kinds_lit(t, kinds_parent)
        check_detail("a light kind is lit to begin with", lit != "", "lit: ${lit}")
        string.free(lit)
        cone_before = find_widget(t, "text", "cone") != null && on_screen(t, find_widget(t, "text", "cone"))
        click(spot_caption.id)
        wt = want(WANT_KINDS_LIT)
        wt.count = kinds_parent
        wt.text = "Spot"
        spot_tree = wait_for(wt, 8.0, ok)
        tree_free(spot_tree)
        check("choosing Spot lights it", ok[0] == 1)
        now = tree()
        cone = find_widget(now, "text", "cone")
        cone_shown = cone != null && on_screen(now, cone)
        tree_free(now)
        check_detail("a spot shows its cone rows", cone_shown, "cone visible before ${cone_before}, after ${cone_shown}")
        written = file_stamp(SCENE_FILE)
        click(save)
        check("the scene is written with the spot", wait_file(SCENE_FILE, written))
        root_slot = calloc(1, 8) as ptr[]
        spots = scene_lights_of_kind(root_slot, 2)
        check_detail("and the file says the light is a spot", spots >= 1, "${spots} spot lights")
        // The cone with it: a spot whose cone the file drops comes back
        // lighting everything around it.
        cone_cos = scene_widest_cone()
        check_detail("and carries the cone it was given", cone_cos > 0.1, "cos(outer) ${cone_cos}")
        if root_slot[0] != null { json.json_free(root_slot[0]) }
        free(root_slot)
        click(point_caption.id)
        wt.text = "Point"
        point_tree = wait_for(wt, 8.0, ok)
        tree_free(point_tree)
        free(wt as ptr)
        check("choosing Point lights it again", ok[0] == 1)
        now = tree()
        cone = find_widget(now, "text", "cone")
        cone_hidden = cone == null || !on_screen(now, cone)
        tree_free(now)
        check("a point hides the cone rows", cone_hidden)
    }

    // The object's switches: Visible off hides the selected object and the
    // file says so; undo shows it again.
    tree_free(t)
    t = tree()
    select_named(scene, "cube")
    tree_free(t)
    t = tree()
    visible_caption = find_widget(t, "text", "visible")
    check("the cube's Mesh Renderer has a visible switch", visible_caption != null)
    if visible_caption != null && save >= 0 && undo >= 0 && scene >= 0 {
        toggle_w = row_toggle(t, visible_caption)
        check("the inspector has a Visible switch", toggle_w != null)
        if toggle_w != null {
            switch_id = toggle_w.id
            toggle(switch_id)
            wt = want(WANT_ACTIVE)
            wt.id = switch_id
            wt.flag = false
            off_tree = wait_for(wt, 8.0, ok)
            tree_free(off_tree)
            check("Visible switches off", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the scene is written with the object hidden", wait_file(SCENE_FILE, written))
            root_slot = calloc(1, 8) as ptr[]
            hidden = scene_models_hidden(root_slot)
            check_detail("and the file says the object is not visible", hidden >= 1, "${hidden} hidden")
            if root_slot[0] != null { json.json_free(root_slot[0]) }
            free(root_slot)
            click(undo)
            wt.flag = true
            on_tree = wait_for(wt, 8.0, ok)
            tree_free(on_tree)
            free(wt as ptr)
            check("undo shows it again", ok[0] == 1)
        }
    }

    // Renaming: the inspector's name field renames the selected object; the
    // row follows, the file carries the name, undo brings the old one back.
    if scene >= 0 && undo >= 0 {
        now = tree()
        name_field = 0 - 1
        i = 0
        while i < tree_count(now) {
            fw = tree_at(now, i)
            if fw.kind == "textfield" && fw.parent == section_body_id(now, "INSPECTOR") { name_field = fw.id }
            i = i + 1
        }
        was_named = ""
        rows = object_rows(now, scene)
        i = 0
        while i < list.size(rows) {
            row = list.get_raw(rows, i) as *Widget
            if string.contains(row.classes, "selected") != 0 { was_named = row_name(now, row) }
            i = i + 1
        }
        list.free(rows)
        tree_free(now)
        check("the inspector has a name field", name_field >= 0)
        if name_field >= 0 {
            // The first row selected, so there is an object to rename.
            now = tree()
            rows = object_rows(now, scene)
            if list.size(rows) > 0 { click(lowest_id(rows)) ; sleep(400) }
            list.free(rows)
            tree_free(now)
            set_text(name_field, "renamed_thing")
            sleep(600)
            now = tree()
            renamed = row_named(now, scene, "renamed_thing") != null
            tree_free(now)
            check("typing a name renames the selected object", renamed)
            click(undo)
            sleep(600)
            now = tree()
            name_gone = row_named(now, scene, "renamed_thing") == null
            tree_free(now)
            check_detail("undo brings the old name back", name_gone, "was '${was_named}'")
        }
    }

    // Grouping: the selected object goes under a new group, where it was
    // in the world; the file records the parent; Ungroup and undo bring
    // it back out.
    group_btn = find(t, "button", "Group selection")
    ungroup_btn = find(t, "button", "Ungroup")
    check("the editor can group a selection", group_btn >= 0 && ungroup_btn >= 0)
    if group_btn >= 0 && ungroup_btn >= 0 && scene >= 0 && save >= 0 {
        now = tree()
        rows_before = object_count(now, scene)
        tree_free(now)
        click(group_btn)
        sleep(600)
        now = tree()
        grouped_rows = object_count(now, scene)
        grouped = row_named(now, scene, "group") != null
        tree_free(now)
        check_detail("grouping puts a group where the object was", grouped && grouped_rows == rows_before, "${grouped_rows} rows after, ${rows_before} before; group row ${grouped}")
        written = file_stamp(SCENE_FILE)
        click(save)
        check("the scene is written with the group", wait_file(SCENE_FILE, written))
        root_slot = calloc(1, 8) as ptr[]
        parented = scene_models_parented(root_slot)
        check_detail("and the file has the object under its group", parented >= 1, "${parented} with a parent")
        if root_slot[0] != null { json.json_free(root_slot[0]) }
        free(root_slot)
        // Framing a group frames what is under it. A group is a transform
        // with no mesh, so its own bounds are the origin with no reach:
        // framing one used to fly the camera to 0,0,0 and leave the group
        // where it was.
        frame_btn = find(t, "button", "Frame selection")
        check("the editor can frame the selection", frame_btn >= 0)
        if frame_btn >= 0 {
            before_at_block = calloc(3, 8)
            before_at = before_at_block as float[]
            after_at_block = calloc(3, 8)
            after_at = after_at_block as float[]
            group_at_block = calloc(3, 8)
            group_at = group_at_block as float[]
            had_before = scene_camera(before_at)
            click(frame_btn)
            wt = want(WANT_CONTAINS)
            wt.text = "under it"
            framed = wait_for(wt, 8.0, ok)
            tree_free(framed)
            free(wt as ptr)
            check("framing a group says what it framed with it", ok[0] == 1)
            written = file_stamp(SCENE_FILE)
            click(save)
            check("the framed view is written", wait_file(SCENE_FILE, written))
            had_after = scene_camera(after_at)
            had_group = scene_group_at(group_at)
            flew = 0.0
            if had_before && had_after {
                dx = after_at[0] - before_at[0]
                dy = after_at[1] - before_at[1]
                dz = after_at[2] - before_at[2]
                flew = dx * dx + dy * dy + dz * dz
            }
            check_detail("and the camera moved to it", flew > 1.0, "moved ${flew} squared units")
            near = 0.0
            if had_after && had_group {
                gx = after_at[0] - group_at[0]
                gy = after_at[1] - group_at[1]
                gz = after_at[2] - group_at[2]
                near = gx * gx + gy * gy + gz * gz
            }
            check_detail("and stands within sight of the group", had_group && near < 160000.0, "${near} squared units away")
            free(before_at_block)
            free(after_at_block)
            free(group_at_block)
        }

        click(ungroup_btn)
        sleep(600)
        now = tree()
        after_ungroup = object_count(now, scene)
        still_grouped = row_named(now, scene, "group") != null
        tree_free(now)
        check_detail("ungrouping takes the group away and leaves the object", !still_grouped && after_ungroup == rows_before, "${after_ungroup} rows, group row ${still_grouped}")
    }

    if delete_btn >= 0 && scene >= 0 {
        now = tree()
        before_delete = object_count(now, scene)
        tree_free(now)
        click(delete_btn)
        after_delete = wait_rows(scene, before_delete - 1)
        check_detail("Delete takes an object out", after_delete == before_delete - 1, "${after_delete} rows, expected ${before_delete - 1}")
    }
    tree_free(t)
    free(ok)
}

// The lowest and highest ids among a list of widgets.
lowest_id(rows: ptr) -> int {
    best = 0 - 1
    i = 0
    while i < list.size(rows) {
        w = list.get_raw(rows, i) as *Widget
        if best < 0 || w.id < best { best = w.id }
        i = i + 1
    }
    return best
}

highest_id(rows: ptr) -> int {
    best = 0 - 1
    i = 0
    while i < list.size(rows) {
        w = list.get_raw(rows, i) as *Widget
        if w.id > best { best = w.id }
        i = i + 1
    }
    return best
}

// The handle of the menu that lists this action, or -1. An item's label
// is the action and, after two spaces, its accelerator.
menu_with(menus: ptr, action: string) -> int {
    n = json.json_array_size(menus)
    i = 0
    while i < n {
        menu = json.json_array_get_raw(menus, i)
        items = json.json_object_get_raw(menu, "items")
        count = json.json_array_size(items)
        k = 0
        while k < count {
            label = json.json_get_string_raw(json.json_array_get_raw(items, k))
            cut = string.string_index_of(label, "  ")
            name = label
            if cut >= 0 { name = string.substring(label, 0, cut) }
            if name == action { return field_number(menu, "handle") as int }
            k = k + 1
        }
        i = i + 1
    }
    return 0 - 1
}

// The weather kind button named so under the kinds' row, or -1.
kind_button(t: *Tree, parent: int, name: string) -> int {
    i = 0
    while i < tree_count(t) {
        b = tree_at(t, i)
        if b.kind == "button" && b.parent == parent && b.text == name { return b.id }
        i = i + 1
    }
    return 0 - 1
}

// A script file in the scripts directory that was not there before, or "".
newest_script(before: ptr) -> string {
    l, err = dir.list(SCRIPTS_DIR)
    if err != "" { return "" }
    n = dir.list_count(l)
    i = 0
    while i < n {
        entry = dir.list_get(l, i)
        if string.ends_with(entry, ".ae") != 0 {
            stem = string.substring(entry, 0, string.length(entry) - 3)
            known = false
            k = 0
            while k < list.size(before) {
                if name_at(before, k) == stem { known = true }
                k = k + 1
            }
            string.free(stem)
            if known == false { return string.copy(entry) }
        }
        i = i + 1
    }
    return ""
}

// What a built script leaves in build/scripts, removed.
remove_built(stem: string) {
    l, err = dir.list("build/scripts")
    if err != "" { return }
    n = dir.list_count(l)
    i = 0
    while i < n {
        entry = dir.list_get(l, i)
        prefix = string.concat(stem, ".")
        if string.starts_with(entry, prefix) != 0 { file.delete("build/scripts/${entry}") }
        string.free(prefix)
        i = i + 1
    }
}

library_suffix() -> string {
    if os.platform() == "darwin" { return ".dylib" }
    if os.platform() == "windows" { return ".dll" }
    return ".so"
}

// The file's modification time brought up to now, which is what tells the
// editor a script was rebuilt. Through touch by name, as the scripts are
// built through bash: the library is open in the editor, and on Windows an
// open library cannot be rewritten, only re-dated.
touch(path: string) {
    argv = list.new()
    list.add(argv, path)
    os.run_capture("touch", argv, null)
}

// The scripts a saved scene names, comma-separated.
recorded_scripts() -> string {
    out = strbuilder.new(64)
    text, err = file.read(SCENE_FILE)
    if err != "" { return strbuilder.finish(out) }
    root, perr = json.parse(text)
    string.free(text)
    if perr != "" { return strbuilder.finish(out) }
    // A script is a component that owns its state, written in the file's
    // components by its kind's name with its fields beside it.
    carried = json.json_object_get_raw(root, "components")
    count = 0
    if carried != null {
        n = json.json_array_size(carried)
        i = 0
        while i < n {
            entry = json.json_array_get_raw(carried, i)
            script = field_text(entry, "kind")
            if script != "" {
                if count > 0 { strbuilder.append(out, ",") }
                strbuilder.append(out, script)
                count = count + 1
            }
            i = i + 1
        }
    }
    json.json_free(root)
    return strbuilder.finish(out)
}

last_line(text: string) -> string {
    parts = string.split(text, "\n")
    n = string.array_size(parts)
    last = ""
    i = n - 1
    while i >= 0 && last == "" {
        candidate = string.trim(part_at(parts, i))
        if candidate != "" { last = candidate } else { string.free(candidate) }
        i = i - 1
    }
    string.array_free(parts)
    return last
}
