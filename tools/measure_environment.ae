// What an environment map costs (#869), on each backend, for the map named:
//
//     ./build.sh tools/measure_environment.ae && ./build/measure_environment tests/fixtures/env/gradient.hdr
//
// Prints the milliseconds to read and decode the file, to make the half-float
// rows (the upload's input), to set it (upload, mip chain) and to draw the
// first frame with it (the capture, its mips, the irradiance and the
// prefilter, made once), then the mean of 200 frames with the map and of 200
// with none, so that a per-frame cost shows up as a difference. The scene is
// a sphere lit by the sky or the map, at 640 by 360.
import std.os
import std.time
import std.string
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader
import ae3d.envimage
import ae3d.hdrimage

extern free(p: ptr)

const WIDTH = 640
const HEIGHT = 360
const FRAMES = 200

var g_gl: ptr = null
var g_vk: ptr = null

set_env(api: int, path: string) -> bool {
    if api == 0 { return gl.renderer_set_environment(g_gl as *GLRenderer, path, 1.0) }
    return vulkan.renderer_set_environment(g_vk as *VKRenderer, path, 1.0)
}

mean_frame_ms(backend: *Backend, cam: *Camera, light: *Light) -> float {
    // Read the frame back each time, so the GPU's work is all counted.
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    t0 = time.now_ms()
    i = 0
    while i < FRAMES {
        core.backend_render(backend, cam, light)
        core.backend_frame_pixels(backend)
        i = i + 1
    }
    return ((time.now_ms() - t0) as float) / (FRAMES as float)
}

run(backend: *Backend, name: string, api: int, path: string) {
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 20.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    ball = loader.sphere(1.0, 48, 32)
    core.model_set_scale(ball, 8.0, 8.0, 8.0)
    core.model_plastic(ball, 0.8, 0.8, 0.8, 0.4)
    core.backend_add_model(backend, ball)
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    sky_ms = mean_frame_ms(backend, cam, light)

    t0 = time.now_ms()
    img = envimage.load(path)
    t1 = time.now_ms()
    if img == null {
        println("${name}: ${envimage.error()}")
        return
    }
    w = hdrimage.width(img)
    h = hdrimage.height(img)
    rows = envimage.half_rows(img)
    t2 = time.now_ms()
    free(rows)
    envimage.dispose(img)
    println("${name}: ${path} ${w} by ${h}: decode ${t1 - t0} ms, half rows ${t2 - t1} ms")
    t3 = time.now_ms()
    ok = set_env(api, path)
    t4 = time.now_ms()
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    t5 = time.now_ms()
    println("${name}: set_environment (decode, upload, mips) ${t4 - t3} ms (${ok}), first frame with it ${t5 - t4} ms")
    env_ms = mean_frame_ms(backend, cam, light)
    println("${name}: mean frame, sky ${sky_ms} ms, map ${env_ms} ms")
    _b = set_env(api, "")
    core.backend_remove_model(backend, ball)
    core.model_free(ball)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    path = "tests/fixtures/env/gradient.hdr"
    if os.args_count() > 1 { path = os.args_get(1) }
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    g_gl = renderer as ptr
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run(&gl_pass, "opengl", 0, path)
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)
    if !vulkan.available() {
        println("no Vulkan driver")
        return
    }
    vk_renderer = vulkan.renderer_new()
    g_vk = vk_renderer as ptr
    vk_pass = vulkan.backend(vk_renderer)
    if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
        println("Vulkan would not start (${vulkan.last_error()})")
        return
    }
    run(&vk_pass, "vulkan", 1, path)
    core.backend_cleanup(&vk_pass)
    vulkan.renderer_free(vk_renderer)
}
