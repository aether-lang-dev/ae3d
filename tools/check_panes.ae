// Look for window panes that face into their buildings (#478).
//
// A pane is one sheet of glass, drawn from its front alone: a pane that
// faces into the building it glazes is culled from the street, and the
// window is a hole onto the hollow shell behind it -- through which the
// frame shows whatever is behind the building, the sky. So every pane,
// placed where the export puts it, must face away from the middle of the
// shell it hangs from.
//
//     ./build.sh tools/check_panes.ae && ./build/check_panes resources/blender/zombie_street
//
// Every object named <shell>_Glass or <shell>_Lit whose parent is its shell
// is read back through the loader, each triangle placed by the transforms
// the manifest records, and its facing (its winding, which is what the
// renderer culls by) compared with the way to the shell's middle. Exits 0
// when every pane faces out, 1 naming the meshes with panes that face in
// and how many, 2 when the export cannot be read.
import std.os
import std.list
import std.string
import ae3d.core
import ae3d.assets

main() {
    if os.args_count() < 2 {
        println("usage: check_panes <exported directory>")
        os.exit(2)
    }
    directory = os.args_get(1)
    m = assets.manifest_load("${directory}/manifest.json")
    if m == null {
        println("check_panes: ${assets.last_error()}")
        os.exit(2)
    }
    models = assets.manifest_load_scene(m)
    count = assets.manifest_count(m)
    panes = 0
    inward = 0
    meshes = 0
    bad_meshes = 0
    i = 0
    while i < count {
        name = assets.entry_object(assets.manifest_entry(m, i))
        pane = list.get_raw(models, i) as *Model
        shell = core.model_parent(pane)
        glazing = string.ends_with(name, "_Glass") == 1 || string.ends_with(name, "_Lit") == 1
        if pane != null && shell != null && glazing && string.starts_with(name, core.text(shell.name)) == 1 {
            core.model_sync_transform(pane)
            core.model_sync_transform(shell)
            middle = shell_middle(shell)
            facing_in = 0
            triangles = core.mesh_index_count(pane.mesh) / 3
            t = 0
            while t < triangles {
                a = core.mat4_transform_point(pane.model_matrix, core.mesh_position(pane.mesh, core.mesh_index_at(pane.mesh, t * 3)))
                b = core.mat4_transform_point(pane.model_matrix, core.mesh_position(pane.mesh, core.mesh_index_at(pane.mesh, t * 3 + 1)))
                c = core.mat4_transform_point(pane.model_matrix, core.mesh_position(pane.mesh, core.mesh_index_at(pane.mesh, t * 3 + 2)))
                normal = core.v3_cross(core.v3_sub(b, a), core.v3_sub(c, a))
                centre = core.v3_mul(core.v3_add(core.v3_add(a, b), c), 1.0 / 3.0)
                if core.v3_dot(normal, core.v3_sub(middle, centre)) > 0.0 { facing_in = facing_in + 1 }
                t = t + 1
            }
            panes = panes + triangles
            inward = inward + facing_in
            meshes = meshes + 1
            if facing_in > 0 {
                bad_meshes = bad_meshes + 1
                println("  ${name}: ${facing_in} of ${triangles} pane triangles face into ${core.text(shell.name)}")
            }
        }
        i = i + 1
    }
    println("check_panes: ${inward} of ${panes} pane triangles in ${meshes} meshes face into their buildings (${bad_meshes} meshes)")
    assets.manifest_free(m)
    if meshes == 0 {
        println("check_panes: no panes found under ${directory}")
        os.exit(2)
    }
    if inward > 0 { os.exit(1) }
}

// The middle of a shell's box, where the model draws it.
shell_middle(shell: *Model) -> Vec3 {
    n = core.mesh_vertex_count(shell.mesh)
    lo = core.mat4_transform_point(shell.model_matrix, core.mesh_position(shell.mesh, 0))
    hi = lo
    k = 1
    while k < n {
        p = core.mat4_transform_point(shell.model_matrix, core.mesh_position(shell.mesh, k))
        if p.x < lo.x { lo = core.vec3(p.x, lo.y, lo.z) }
        if p.y < lo.y { lo = core.vec3(lo.x, p.y, lo.z) }
        if p.z < lo.z { lo = core.vec3(lo.x, lo.y, p.z) }
        if p.x > hi.x { hi = core.vec3(p.x, hi.y, hi.z) }
        if p.y > hi.y { hi = core.vec3(hi.x, p.y, hi.z) }
        if p.z > hi.z { hi = core.vec3(hi.x, hi.y, p.z) }
        k = k + 1
    }
    return core.v3_mul(core.v3_add(lo, hi), 0.5)
}
