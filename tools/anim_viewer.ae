// The animation viewer (#854): a clip on its own figure and the same clip
// retargeted onto another, side by side, each with its skeleton drawn over
// it and its ae3d.metrics meters on screen, for a person to scrub through
// a take frame by frame and see where a retarget or a clip goes wrong.
//
//   ./build.sh tools/anim_viewer.ae && ./build/anim_viewer
//   AE3D_TARGET=path (the figure retargeted onto; the UE5 mannequin,
//   tests/fixtures/people/mannequin.glb, unset)
//   AE3D_CLIP=n (the clip shown first, by its place in the list; Walk_Loop
//   unset)
//   AE3D_FRAMES=n AE3D_HIDDEN=1 AE3D_SNAPSHOT=out.png (unattended, captured)
//
// Keys: Up and Down the clip before and after in the list; Space plays and
// pauses; Left and Right, paused, a frame back and on.
//
// The source is UAL1's Rigify mannequin (tests/fixtures/people/ual1_rigify.glb)
// on its own clips, on the left; the target, on the right, plays each one
// as ae3d.retarget carries it across, feet kept. Each goes over the ground
// as its take carries it (an in-place take at its speed along its heading,
// a take whose root motion was taken out by that motion), so a planted foot
// stands still under it as it would in a game, and starts again where it
// began each time the clip does. Each figure's skeleton is drawn from
// pose.world, joint to parent, over the picture; under each, its meters:
// the worst a player would see over the clip so far (skating, a sole into
// the ground, the legs through each other, a knee bent out or in, the chest
// twisted off the hips, a forearm over-rolled, a foot over the middle, the
// fastest joint turn), red past its bound. As it ends it prints each
// figure's worst.

import std.os
import std.string
import ae3d.core
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.figure
import ae3d.pose
import ae3d.clips
import ae3d.retarget
import ae3d.ikrig
import ae3d.metrics
import ae3d.hud
import ae3d.input
import ae3d.platform

const SOURCE = "tests/fixtures/people/ual1_rigify.glb"
const TARGET = "tests/fixtures/people/mannequin.glb"
const FIRST = "Walk_Loop"
const APART = 0.8                    // metres either side of the middle each figure starts at
const LISTED = 24                    // clips the list shows at once
// The bounds a meter is red past, as the motion showcase flags them
// (tools/anim_showcase.ae): a toe skating or a sole sinking 5 mm, the legs
// closer than 8 cm, a knee 45 degrees out or in, the chest 50 degrees off
// the hips, a forearm rolled 120 degrees, a foot past the middle.
const SKATE_MOST = 0.005
const SINK_MOST = 0.005
const LEGS_TOUCH = 0.08
const KNEE_MOST = 0.7854
const TWIST_MOST = 0.8727
const ROLL_MOST = 2.0944

struct Viewer {
    source_o: ptr                    // *GameObject: the source figure
    target_o: ptr                    // and the one retargeted onto
    source: ptr                      // *Rig
    target: ptr
    file: ptr                        // *Figure: the source's, whose file holds the clips
    clips: int                       // how many
    clip: int                        // which is shown
    take_s: ptr                      // *Take: the clip on the source
    take_t: ptr                      // and retargeted
    pose_s: ptr                      // the poses drawn, local
    pose_t: ptr
    worlds_s: ptr                    // and in each rig's space
    worlds_t: ptr
    meter_s: ptr                     // *Meter
    meter_t: ptr
    time: float                      // seconds into the clip
    playing: bool
    ready: bool
}

// A number to `places` decimals, rounded.
fixed(v: float, places: int) -> string {
    scale = 1
    k = 0
    while k < places {
        scale = scale * 10
        k = k + 1
    }
    negative = v < 0.0
    a = v
    if negative { a = 0.0 - v }
    n = (a * (scale as float) + 0.5) as long
    whole = n / (scale as long)
    part = n % (scale as long)
    sign = ""
    if negative && n > (0 as long) { sign = "-" }
    if places == 0 { return "${sign}${whole}" }
    digits = "${part}"
    while string.length(digits) < places { digits = "0${digits}" }
    return "${sign}${whole}.${digits}"
}

target_path() -> string {
    asked = core.text(os.getenv("AE3D_TARGET"))
    if string.length(asked) > 0 { return asked }
    return TARGET
}

// The clip in the source's list by name, or 0.
clip_named(v: *Viewer, wanted: string) -> int {
    k = 0
    while k < v.clips {
        if string.equals(figure.clip_name(v.file as *Figure, k), wanted) == 1 { return k }
        k = k + 1
    }
    return 0
}

// The takes of clip `k` made, on the source and retargeted, and the meters
// begun again on them; the old ones freed.
show_clip(v: *Viewer, k: int) {
    free_takes(v)
    v.clip = k
    v.time = 0.0
    source = v.source as *pose.Rig
    target = v.target as *pose.Rig
    s = clips.from_scene(source, figure.scene(v.file as *Figure), figure.clip_name(v.file as *Figure, k), 0.0)
    if s == null { return }
    v.take_s = s as ptr
    t = retarget.retarget(source, s, target)
    if t == null { return }
    v.take_t = t as ptr
    metrics.meter_reset(v.meter_s as *Meter)
    metrics.meter_reset(v.meter_t as *Meter)
    metrics.meter_set_reference(v.meter_s as *Meter, metrics.take_fastest(s, source))
    metrics.meter_set_reference(v.meter_t as *Meter, metrics.take_fastest(t, target))
    put_figures(v)
    metrics.meter_moved(v.meter_s as *Meter)
    metrics.meter_moved(v.meter_t as *Meter)
}

free_takes(v: *Viewer) {
    if v.take_t != null { clips.take_free(v.take_t as *Take) }
    if v.take_s != null { clips.take_free(v.take_s as *Take) }
    v.take_t = null
    v.take_s = null
}

// Where a take has carried its figure over the ground `at` seconds in, from
// where it began: an in-place take at its speed along its heading, a take
// whose root motion was taken out by that motion (its turn left out).
carried(t: *Take, rig: *pose.Rig, at: float) -> Vec3 {
    if clips.has_root_motion(t) {
        went = clips.travel(t, at)
        return ikrig.dir_to_ground(rig, core.vec3(went.x, 0.0, went.y))
    }
    return core.v3_mul(clips.heading(t), clips.speed(t) * at)
}

// Both figures posed at the viewer's time and put where their takes carry
// them.
put_figures(v: *Viewer) {
    if v.take_s == null || v.take_t == null { return }
    take_s = v.take_s as *Take
    take_t = v.take_t as *Take
    source = v.source as *pose.Rig
    target = v.target as *pose.Rig
    behaviour.object_set_position(v.source_o as *GameObject, core.v3_add(core.vec3(0.0 - APART, 0.0, 0.0), carried(take_s, source, v.time)))
    behaviour.object_set_position(v.target_o as *GameObject, core.v3_add(core.vec3(APART, 0.0, 0.0), carried(take_t, target, v.time)))
    clips.sample(take_s, source, v.time, false, v.pose_s)
    clips.sample(take_t, target, v.time, false, v.pose_t)
    pose.apply(source, v.pose_s)
    pose.apply(target, v.pose_t)
    pose.world(source, v.pose_s, v.worlds_s)
    pose.world(target, v.pose_t, v.worlds_t)
}

start(state: ptr, e: *Engine) {
    v = state as *Viewer
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    behaviour.object_set_scale(ground, core.vec3(40.0, 1.0, 40.0))
    so = figure.figure(e, "Source", SOURCE)
    to = figure.figure(e, "Target", target_path())
    if so == null || to == null {
        println("anim_viewer: ${SOURCE} or ${target_path()} would not load")
        engine.engine_stop(e)
        return
    }
    v.source_o = so as ptr
    v.target_o = to as ptr
    v.file = figure.figure_of(so) as ptr
    source = pose.of_skeleton(figure.skeleton(figure.figure_of(so)))
    target = pose.of_skeleton(figure.skeleton(figure.figure_of(to)))
    v.source = source as ptr
    v.target = target as ptr
    if pose.human(source, pose.PELVIS) < 0 || pose.human(target, pose.PELVIS) < 0 {
        println("anim_viewer: ${target_path()} is no humanoid the engine knows")
        engine.engine_stop(e)
        return
    }
    v.pose_s = pose.new(source)
    v.pose_t = pose.new(target)
    v.worlds_s = pose.new(source)
    v.worlds_t = pose.new(target)
    v.meter_s = metrics.meter_new(source, so) as ptr
    v.meter_t = metrics.meter_new(target, to) as ptr
    v.clips = figure.clip_count(v.file as *Figure)
    keys = engine.engine_input(e)
    input.bind_key(keys, "clip_back", platform.KEY_UP)
    input.bind_key(keys, "clip_on", platform.KEY_DOWN)
    input.bind_key(keys, "frame_back", platform.KEY_LEFT)
    input.bind_key(keys, "frame_on", platform.KEY_RIGHT)
    input.bind_key(keys, "play", platform.KEY_SPACE)
    first = core.env_int("AE3D_CLIP", 0 - 1)
    if first < 0 || first >= v.clips { first = clip_named(v, FIRST) }
    v.ready = true
    println("anim_viewer: ${v.clips} clips on ${SOURCE}, retargeted onto ${target_path()} (${pose.count(target)} joints)")
    show_clip(v, first)
}

update(state: ptr, e: *Engine, delta: float) {
    v = state as *Viewer
    if !v.ready || v.clips == 0 { return }
    keys = engine.engine_input(e)
    if input.pressed(keys, "clip_back") { show_clip(v, (v.clip + v.clips - 1) % v.clips) }
    if input.pressed(keys, "clip_on") { show_clip(v, (v.clip + 1) % v.clips) }
    if input.pressed(keys, "play") { v.playing = !v.playing }
    if v.take_s == null || v.take_t == null {
        draw(v, e)
        return
    }
    take = v.take_s as *Take
    step = 0.0
    back = false
    if v.playing {
        step = delta
    } else if input.pressed(keys, "frame_on") {
        step = 1.0 / clips.rate(take)
    } else if input.pressed(keys, "frame_back") {
        step = 1.0 / clips.rate(take)
        back = true
    }
    if step > 0.0 {
        moved = back
        if back { v.time = v.time - step } else { v.time = v.time + step }
        // Round again from the start (or, stepped back past it, the end):
        // the figures are put back where they began, not slid there.
        length = clips.duration(take)
        if v.time > length {
            v.time = 0.0
            moved = true
        }
        if v.time < 0.0 {
            v.time = length
            moved = true
        }
        put_figures(v)
        if moved {
            metrics.meter_moved(v.meter_s as *Meter)
            metrics.meter_moved(v.meter_t as *Meter)
        }
        metrics.meter_take(v.meter_s as *Meter, step)
        metrics.meter_take(v.meter_t as *Meter, step)
    }
    // The two from in front and to the side, the camera on the middle of them.
    a = behaviour.object_position(v.source_o as *GameObject)
    b = behaviour.object_position(v.target_o as *GameObject)
    middle = core.vec3((a.x + b.x) * 0.5, 0.9, (a.z + b.z) * 0.5)
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.v3_add(middle, core.vec3(1.6, 0.5, 3.6)))
    core.camera_look_at(cam, core.v3_add(middle, core.vec3(0.0, 0.0 - 0.05, 0.0)))
    draw(v, e)
}

// --- on screen ------------------------------------------------------------------------------------

draw(v: *Viewer, e: *Engine) {
    h = engine.engine_hud(e)
    if h == null { return }
    white = hud.rgba(1.0, 1.0, 1.0, 1.0)
    grey = hud.rgba(0.7, 0.7, 0.7, 1.0)
    cyan = hud.rgba(0.3, 0.85, 1.0, 1.0)
    amber = hud.rgba(1.0, 0.7, 0.2, 1.0)
    width = hud.screen_width(h)
    height = hud.screen_height(h)
    hud.rect(h, 0.0, 0.0, 300.0, height, hud.rgba(0.0, 0.0, 0.0, 0.45))
    shadowed(h, 16.0, 12.0, 20.0, "anim viewer", white)
    if v.take_s != null && v.take_t != null {
        take = v.take_s as *Take
        frame = (v.time * clips.rate(take) + 0.5) as int
        state = "paused"
        if v.playing { state = "playing" }
        shadowed(h, 16.0, 40.0, 15.0, "${figure.clip_name(v.file as *Figure, v.clip)}  (${v.clip + 1} of ${v.clips})", white)
        shadowed(h, 16.0, 60.0, 15.0, "${fixed(v.time, 2)} of ${fixed(clips.duration(take), 2)} s, frame ${frame} of ${clips.frames(take) - 1}, ${state}", grey)
        shadowed(h, 16.0, 80.0, 15.0, "${fixed(clips.speed(take), 2)} m/s on the source, ${fixed(clips.speed(v.take_t as *Take), 2)} retargeted", grey)
        skeleton(h, v.source as *pose.Rig, v.worlds_s, e, cyan)
        skeleton(h, v.target as *pose.Rig, v.worlds_t, e, amber)
        meters(h, v.meter_s as *Meter, width - 300.0, 16.0, "source: UAL1 (Rigify)", cyan)
        meters(h, v.meter_t as *Meter, width - 300.0, 248.0, "retargeted, feet kept", amber)
    } else {
        shadowed(h, 16.0, 40.0, 15.0, "${figure.clip_name(v.file as *Figure, v.clip)}: no take", white)
    }
    clip_list(h, v, 112.0)
    shadowed(h, 16.0, height - 28.0, 13.0, "Up, Down: clip   Space: play   Left, Right: a frame", grey)
}

// Text with a dark shadow under it, to read over the scene.
shadowed(h: *Hud, x: float, y: float, size: float, s: string, colour: Vec4) {
    hud.text_shadowed(h, x, y, size, s, colour, hud.rgba(0.0, 0.0, 0.0, 0.8), 1.5)
}

// The source's clips, LISTED of them about the one shown, it highlighted.
clip_list(h: *Hud, v: *Viewer, top: float) {
    first = v.clip - LISTED / 2
    if first > v.clips - LISTED { first = v.clips - LISTED }
    if first < 0 { first = 0 }
    k = first
    y = top
    while k < v.clips && k < first + LISTED {
        colour = hud.rgba(0.75, 0.75, 0.75, 1.0)
        if k == v.clip {
            hud.rect(h, 10.0, y - 2.0, 280.0, 19.0, hud.rgba(0.3, 0.55, 0.9, 0.6))
            colour = hud.rgba(1.0, 1.0, 1.0, 1.0)
        }
        hud.text(h, 18.0, y, 14.0, figure.clip_name(v.file as *Figure, k), colour)
        y = y + 20.0
        k = k + 1
    }
}

// A rig's skeleton over the picture, each joint to its parent, from its
// rig-space pose `worlds` (pose.world's) put on the ground (ikrig.to_ground).
skeleton(h: *Hud, rig: *pose.Rig, worlds: ptr, e: *Engine, colour: Vec4) {
    cam = engine.engine_camera(e)
    w = hud.screen_width(h) as int
    ht = hud.screen_height(h) as int
    j = 0
    while j < pose.count(rig) {
        at = core.camera_world_to_screen(cam, ikrig.to_ground(rig, pose.translation(worlds, j)), w, ht)
        up = pose.parent(rig, j)
        if up >= 0 {
            from = core.camera_world_to_screen(cam, ikrig.to_ground(rig, pose.translation(worlds, up)), w, ht)
            line(h, from, at, colour)
        }
        if at.w > 0.0001 { hud.rect(h, at.x - 2.5, at.y - 2.5, 5.0, 5.0, colour) }
        j = j + 1
    }
}

// A line of dots two pixels apart from `a` to `b` (camera_world_to_screen's),
// none when either is behind the camera.
line(h: *Hud, a: Vec4, b: Vec4, colour: Vec4) {
    if a.w <= 0.0001 || b.w <= 0.0001 { return }
    dx = b.x - a.x
    dy = b.y - a.y
    steps = (core.sqrt_of(dx * dx + dy * dy) / 2.0) as int + 1
    if steps > 500 { steps = 500 }
    k = 0
    while k <= steps {
        u = (k as float) / (steps as float)
        hud.rect(h, a.x + dx * u - 1.0, a.y + dy * u - 1.0, 2.0, 2.0, colour)
        k = k + 1
    }
}

// One figure's meters: the worst over the clip so far, each against its
// bound, red past it.
meters(h: *Hud, m: *Meter, x: float, y: float, title: string, colour: Vec4) {
    hud.rect(h, x - 8.0, y - 8.0, 300.0, 218.0, hud.rgba(0.0, 0.0, 0.0, 0.5))
    hud.text(h, x, y, 15.0, title, colour)
    row(h, x, y + 24.0, "toe skating", metrics.meter_worst(m, metrics.SKATE) * 1000.0, SKATE_MOST * 1000.0, "mm", false)
    row(h, x, y + 44.0, "a sole into the ground", metrics.meter_worst(m, metrics.INTO_GROUND) * 1000.0, SINK_MOST * 1000.0, "mm", false)
    row(h, x, y + 64.0, "legs apart, closest", metrics.meter_worst(m, metrics.LEGS_APART) * 100.0, LEGS_TOUCH * 100.0, "cm", true)
    row(h, x, y + 84.0, "a knee out", metrics.meter_worst(m, metrics.KNEE_OUT) * 57.29578, KNEE_MOST * 57.29578, "deg", false)
    row(h, x, y + 104.0, "a knee in", metrics.meter_worst(m, metrics.KNEE_IN) * 57.29578, KNEE_MOST * 57.29578, "deg", false)
    row(h, x, y + 124.0, "chest off the hips", metrics.meter_worst(m, metrics.CHEST_TWIST) * 57.29578, TWIST_MOST * 57.29578, "deg", false)
    row(h, x, y + 144.0, "a forearm rolled", metrics.meter_worst(m, metrics.FOREARM_ROLL) * 57.29578, ROLL_MOST * 57.29578, "deg", false)
    row(h, x, y + 164.0, "a foot over the middle", metrics.meter_worst(m, metrics.FEET_CROSS) * 100.0, 0.0, "cm", false)
    row(h, x, y + 184.0, "fastest turn, past the take's", metrics.meter_pop(m) * 100.0, 0.0 - 1.0, "%", false)
}

// A meter's line: its name, its value and a bar against `bound` (the value
// at most, or at least when `least`), red past it; grey with no bar for a
// measure that has none (`bound` under 0).
row(h: *Hud, x: float, y: float, name: string, value: float, bound: float, unit: string, least: bool) {
    past = value > bound
    if least { past = value < bound }
    colour = hud.rgba(0.55, 0.85, 0.45, 1.0)
    if past { colour = hud.rgba(1.0, 0.35, 0.3, 1.0) }
    if bound < 0.0 {
        hud.text(h, x, y, 13.0, name, hud.rgba(0.85, 0.85, 0.85, 1.0))
        hud.text(h, x + 190.0, y, 13.0, "${fixed(value, 1)} ${unit}", hud.rgba(0.85, 0.85, 0.85, 1.0))
        return
    }
    hud.text(h, x, y, 13.0, name, hud.rgba(0.85, 0.85, 0.85, 1.0))
    hud.text(h, x + 190.0, y, 13.0, "${fixed(value, 1)} ${unit}", colour)
    share = 1.0
    if bound > 0.0 { share = core.clampf(value / bound, 0.0, 1.0) }
    if least && value > 0.0 { share = core.clampf(bound / value, 0.0, 1.0) }
    hud.rect(h, x, y + 15.0, 280.0 * share, 2.0, colour)
}

// What each figure came to over the clip shown last.
report(v: *Viewer) {
    if v.take_s == null || v.meter_s == null { return }
    names = ["the source", "retargeted"]
    meters_of = [v.meter_s, v.meter_t]
    k = 0
    while k < 2 {
        m = meters_of[k] as *Meter
        println("anim_viewer: ${figure.clip_name(v.file as *Figure, v.clip)}, ${names[k]}: a toe skated ${metrics.meter_worst(m, metrics.SKATE) * 1000.0} mm; a sole ${metrics.meter_worst(m, metrics.INTO_GROUND) * 1000.0} mm into the ground; legs ${metrics.meter_worst(m, metrics.LEGS_APART) * 100.0} cm apart at the closest; a knee ${metrics.meter_worst(m, metrics.KNEE_OUT) * 57.29578} degrees out and ${metrics.meter_worst(m, metrics.KNEE_IN) * 57.29578} in; the chest ${metrics.meter_worst(m, metrics.CHEST_TWIST) * 57.29578} degrees off the hips; over ${metrics.meter_frames(m)} frames")
        k = k + 1
    }
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - anim viewer")
    light = core.light_sun(core.vec3(0.4, 0.8, 0.3))
    engine.engine_set_light(e, light)
    engine.engine_set_clear_color(e, 0.36, 0.38, 0.42)
    v = Viewer { source_o: null, target_o: null, source: null, target: null, file: null, clips: 0, clip: 0,
                 take_s: null, take_t: null, pose_s: null, pose_t: null, worlds_s: null, worlds_t: null,
                 meter_s: null, meter_t: null, time: 0.0, playing: true, ready: false }
    b = engine.behaviour_new("anim_viewer", (&v) as ptr)
    b.start = start
    b.update = update
    engine.engine_add_behaviour(e, b)
    engine.engine_run(e)
    report(&v)
    free_takes(&v)
    if v.meter_s != null { metrics.meter_free(v.meter_s as *Meter) }
    if v.meter_t != null { metrics.meter_free(v.meter_t as *Meter) }
    if v.pose_s != null { pose.release(v.pose_s) }
    if v.pose_t != null { pose.release(v.pose_t) }
    if v.worlds_s != null { pose.release(v.worlds_s) }
    if v.worlds_t != null { pose.release(v.worlds_t) }
    if v.source != null { pose.rig_free(v.source as *pose.Rig) }
    if v.target != null { pose.rig_free(v.target as *pose.Rig) }
    figure.figures_free(e)
    core.light_free(light)
    engine.engine_free(e)
}
